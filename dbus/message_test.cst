// dbus/message_test.cst — building and parsing messages, and what parse refuses.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "wire.cst" as wire;
use "message.cst" as message;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is [1024]u8 as out with mut;
let is [256]u8 as body with mut;
let is [256]u8 as raw with mut;

fn o(i as i64) as i64 { return cast(i64, out[i]) & 255; }
fn u32_at(i as i64) as i64 { return cast(i64, *cast(*u32, cast(i64, &out) + i)) & 4294967295; }

fn put(i as i64, v as i64) as void { raw[i] = cast(u8, v); }
fn put_s(i as i64, s as *u8) as void {
    let is i64 as k with mut = 0;
    while (*cast(*u8, cast(i64, s) + k) != 0) {
        raw[i + k] = *cast(*u8, cast(i64, s) + k);
        k = k + 1;
    }
    raw[i + k] = 0;
}
// Big-endian u32.
fn put_be(i as i64, v as i64) as void {
    put(i, (v >> 24) & 255); put(i + 1, (v >> 16) & 255); put(i + 2, (v >> 8) & 255); put(i + 3, v & 255);
}

fn parse_n(n as i64, m as *message.Message) as i64 {
    return message.parse(cast(*u8, &out), n, cast(*i32, 0), 0, m);
}

fn main() as i32 {
    // --- Hello, byte for byte ---
    let is message.Message as hello = message.method_call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                                   "org.freedesktop.DBus", "Hello");
    let is i64 as n with mut = message.encode(&hello, 1, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024);
    check("Hello is 128 bytes", n == 128);
    check("little-endian, a call, version 1", o(0) == 108 && o(1) == 1 && o(2) == 0 && o(3) == 1);
    check("no body, serial 1", u32_at(4) == 0 && u32_at(8) == 1);
    check("109 bytes of fields", u32_at(12) == 109);
    check("the path field", o(16) == 1 && o(17) == 1 && o(18) == 111 && o(19) == 0 && u32_at(20) == 21
          && mem.memcmp(cast(*u8, cast(i64, &out) + 24), "/org/freedesktop/DBus", 22) == 0);
    check("the interface field on 8", o(48) == 2 && o(50) == 115 && u32_at(52) == 20);
    check("the member field", o(80) == 3 && u32_at(84) == 5 && mem.memcmp(cast(*u8, cast(i64, &out) + 88), "Hello", 6) == 0);
    check("the destination field", o(96) == 6 && u32_at(100) == 20);
    check("padded with zeros to 128", o(125) == 0 && o(126) == 0 && o(127) == 0);
    let is message.Message as back with mut = message.empty();
    check("parsed back whole", parse_n(n, &back) == 128);
    check("its fields", back.kind == message.METHOD_CALL && back.serial == 1
          && message.named(back.path, "/org/freedesktop/DBus") == 1
          && message.named(back.interface, "org.freedesktop.DBus") == 1
          && message.named(back.member, "Hello") == 1
          && message.named(back.destination, "org.freedesktop.DBus") == 1
          && cast(i64, back.sender) == 0 && cast(i64, back.signature) == 0 && back.body_len == 0);
    check("not all there yet", parse_n(127, &back) == 0 && parse_n(15, &back) == 0);
    check("length from 16 bytes", message.length(cast(*u8, &out), 16) == 128);
    check("not from 15", message.length(cast(*u8, &out), 15) == 0);
    out[125] = 1;
    check("padding after the fields that is not zero", parse_n(128, &back) == 0 - 1);
    out[125] = 0;
    out[0] = 120;
    check("a byte order that is neither", parse_n(128, &back) == 0 - 1);
    out[0] = 108;
    check("Hello again", parse_n(128, &back) == 128);
    // A field this version does not know, before the ones it does.
    let is wire.Writer as uf with mut = wire.writer(cast(*u8, &out), 1024);
    wire.put_byte(&uf, 108); wire.put_byte(&uf, 1); wire.put_byte(&uf, 0); wire.put_byte(&uf, 1);
    wire.put_u32(&uf, 0); wire.put_u32(&uf, 9);
    let is i64 as ufa = wire.put_array(&uf, 8);
    wire.put_struct(&uf); wire.put_byte(&uf, 42); wire.put_variant(&uf, "as");
    let is i64 as ufs = wire.put_array(&uf, 4);
    wire.put_string(&uf, "future");
    wire.put_array_end(&uf, ufs, 4);
    wire.put_struct(&uf); wire.put_byte(&uf, 1); wire.put_variant(&uf, "o"); wire.put_path(&uf, "/x");
    wire.put_struct(&uf); wire.put_byte(&uf, 3); wire.put_variant(&uf, "s"); wire.put_string(&uf, "M");
    wire.put_array_end(&uf, ufa, 8);
    wire.pad(&uf, 8);
    check("an unknown field is skipped", parse_n(uf.len, &back) == uf.len && back.serial == 9
          && message.named(back.path, "/x") == 1 && message.named(back.member, "M") == 1);

    // --- A body, a reply, descriptors ---
    let is wire.Writer as w with mut = wire.writer(cast(*u8, &body), 256);
    wire.put_string(&w, "org.freedesktop.appearance");
    wire.put_u32(&w, 7);
    wire.put_fd(&w, 5);
    let is message.Message as c with mut = message.method_call("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
                                                        "org.freedesktop.portal.Settings", "Read");
    c.signature = "suh";
    c.flags = message.NO_AUTO_START;
    n = message.encode(&c, 42, cast(*u8, &body), w.len, 1, cast(*u8, &out), 1024);
    check("encoded with a body", n > 0);
    let is [1]i32 as fds;
    fds[0] = 9;
    let is message.Message as m with mut = message.empty();
    check("parsed", message.parse(cast(*u8, &out), n, cast(*i32, &fds), 1, &m) == n);
    check("flags and serial", m.flags == message.NO_AUTO_START && m.serial == 42 && m.unix_fds == 1);
    check("the signature", message.named(m.signature, "suh") == 1);
    let is wire.Reader as r with mut = message.body(&m);
    let is i64 as len with mut = 0;
    let is *u8 as s = wire.get_string(&r, &len);
    check("the body", len == 26 && mem.memcmp(s, "org.freedesktop.appearance", 26) == 0 && wire.get_u32(&r) == 7 && wire.get_fd(&r) == 9 && r.err == 0);
    check("too few descriptors came with it", message.parse(cast(*u8, &out), n, cast(*i32, &fds), 0, &m) == 0 - 1);
    m.sender = ":1.5";
    let is message.Message as rep with mut = message.method_return(&m);
    check("a reply goes back", rep.reply_serial == 42 && message.named(rep.destination, ":1.5") == 1);
    rep.sender = "org.freedesktop.portal.Desktop";
    n = message.encode(&rep, 3, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024);
    let is message.Message as rb with mut = message.empty();
    check("a reply parsed", parse_n(n, &rb) == n && rb.kind == message.METHOD_RETURN && rb.reply_serial == 42
          && message.named(rb.sender, "org.freedesktop.portal.Desktop") == 1);
    let is message.Message as er with mut = message.error(&m, "org.freedesktop.DBus.Error.UnknownMethod");
    n = message.encode(&er, 4, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024);
    check("an error parsed", parse_n(n, &rb) == n && rb.kind == message.ERROR
          && message.named(rb.error_name, "org.freedesktop.DBus.Error.UnknownMethod") == 1);
    let is message.Message as sg = message.signal("/a", "a.b", "Changed");
    n = message.encode(&sg, 5, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024);
    check("a signal parsed", parse_n(n, &rb) == n && rb.kind == message.SIGNAL);

    // --- What encode refuses ---
    let is message.Message as badpath = message.method_call("x.y", "/a/", "x.y", "M");
    check("a path that is not one", message.encode(&badpath, 1, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024) == 0 - 1);
    let is message.Message as noserial with mut = message.error(&m, "x.Error");
    noserial.reply_serial = 0;
    check("an error in reply to nothing", message.encode(&noserial, 1, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024) == 0 - 1);
    check("a serial past 32 bits", message.encode(&hello, 4294967296, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024) == 0 - 1);
    let is i64 as whole = message.encode(&c, 1, cast(*u8, &body), w.len, 1, cast(*u8, &out), 1024);
    check("exactly enough room", message.encode(&c, 1, cast(*u8, &body), w.len, 1, cast(*u8, &out), whole) == whole);
    check("a byte short of it", message.encode(&c, 1, cast(*u8, &body), w.len, 1, cast(*u8, &out), whole - 1) == 0 - 1);
    c.signature = "su";
    check("a body that is not its signature", message.encode(&c, 1, cast(*u8, &body), w.len, 1, cast(*u8, &out), 1024) == 0 - 1);
    c.signature = "suh";
    check("serial 0", message.encode(&c, 0, cast(*u8, &body), w.len, 1, cast(*u8, &out), 1024) == 0 - 1);
    check("not enough room", message.encode(&c, 1, cast(*u8, &body), w.len, 1, cast(*u8, &out), 100) == 0 - 1);
    let is message.Message as nomember = message.method_call("x.y", "/", "x.y", cast(*u8, 0));
    check("a call without a member", message.encode(&nomember, 1, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024) == 0 - 1);
    let is message.Message as noiface = message.signal("/", cast(*u8, 0), "M");
    check("a signal without an interface", message.encode(&noiface, 1, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024) == 0 - 1);
    let is message.Message as noreply = message.empty();
    noreply.kind = message.METHOD_RETURN;
    check("a reply to nothing", message.encode(&noreply, 1, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024) == 0 - 1);
    noreply.kind = message.ERROR;
    noreply.reply_serial = 1;
    check("an error without a name", message.encode(&noreply, 1, cast(*u8, &body), 0, 0, cast(*u8, &out), 1024) == 0 - 1);

    // --- A big-endian signal, written by hand ---
    mem.memzero(cast(*u8, &raw), 256);
    put(0, 66); put(1, 4); put(2, 0); put(3, 1);
    put_be(4, 4); put_be(8, 7); put_be(12, 55);
    put(16, 1); put(17, 1); put(18, 111); put_be(20, 2); put_s(24, "/a");
    put(32, 2); put(33, 1); put(34, 115); put_be(36, 3); put_s(40, "a.b");
    put(48, 3); put(49, 1); put(50, 115); put_be(52, 1); put_s(56, "M");
    put(64, 8); put(65, 1); put(66, 103); put(68, 1); put(69, 117); put(70, 0);
    put_be(72, 258);
    let is message.Message as bm with mut = message.empty();
    check("big-endian parsed", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 76);
    check("big-endian fields", bm.kind == message.SIGNAL && bm.serial == 7 && message.named(bm.path, "/a") == 1
          && message.named(bm.interface, "a.b") == 1 && message.named(bm.member, "M") == 1
          && message.named(bm.signature, "u") == 1);
    let is wire.Reader as br with mut = message.body(&bm);
    check("big-endian body", wire.get_u32(&br) == 258);

    // --- What parse refuses ---
    put(0, 120);
    check("not a byte order", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 0 - 1);
    put(0, 66); put(3, 2);
    check("version 2", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 0 - 1);
    put(3, 1); put_be(8, 0);
    check("serial 0", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 0 - 1);
    put_be(8, 7); put(1, 0);
    check("type 0", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 0 - 1);
    put(1, 9);
    check("an unknown type is passed on", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 76 && bm.kind == 9);
    put(1, 4); put(18, 115);
    check("a path that is a string", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 0 - 1);
    put(18, 111); put(16, 99);
    check("an unknown field is skipped, and then the path is missing", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 0 - 1);
    put(16, 1); put(69, 115);
    check("a body that is not its signature", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 0 - 1);
    put(69, 117); put(71, 5);
    check("padding before the body that is not zero", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 0 - 1);
    put(71, 0); put_be(12, 54);
    check("fields that do not end where they say", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 0 - 1);
    put_be(12, 55); put_be(4, 200000000);
    check("longer than any message", message.length(cast(*u8, &raw), 76) == 0 - 1);
    put_be(4, 4);
    check("whole again", message.parse(cast(*u8, &raw), 76, cast(*i32, 0), 0, &bm) == 76);

    if (fails > 0) {
        io.printf("dbus message: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("dbus message: all checks passed\n");
    return 0;
}
