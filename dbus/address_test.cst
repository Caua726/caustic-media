// dbus/address_test.cst — bus addresses: entries, keys, escapes, the fallback.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "address.cst" as address;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn entry(s as *u8, i as i64, out as *address.Address) as i32 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return address.entry(s, n, i, out);
}

fn name_is(a as *address.Address, s as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    if (a.len != n || mem.memcmp(cast(*u8, &a.name), s, n) != 0 || a.name[n] != 0) { return 0; }
    return 1;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is address.Address as a;
    check("a path", entry("unix:path=/run/user/1000/bus", 0, &a) == 1 && a.kind == address.PATH
          && name_is(&a, "/run/user/1000/bus") == 1);
    check("an abstract name, with a guid after", entry("unix:abstract=/tmp/dbus-AbC,guid=0123", 0, &a) == 1
          && a.kind == address.ABSTRACT && name_is(&a, "/tmp/dbus-AbC") == 1);
    check("a guid before", entry("unix:guid=0123,path=/x", 0, &a) == 1 && name_is(&a, "/x") == 1);
    check("escapes", entry("unix:path=/tmp/a%20b%2c%2Fc", 0, &a) == 1 && name_is(&a, "/tmp/a b,/c") == 1);
    check("a bad escape", entry("unix:path=/tmp/%zz", 0, &a) == 0);
    check("a cut-off escape", entry("unix:path=/tmp/%2", 0, &a) == 0);
    check("tcp is not spoken", entry("tcp:host=localhost,port=1", 0, &a) == 0 && a.kind == 0);
    check("a server's address", entry("unix:runtime=yes", 0, &a) == 0 && entry("unix:dir=/tmp", 0, &a) == 0);
    check("no value", entry("unix:path=", 0, &a) == 0);
    check("no key", entry("unix:", 0, &a) == 0 && entry("unix:path", 0, &a) == 0);
    check("path and abstract both", entry("unix:path=/a,abstract=b", 0, &a) == 0);
    check("another transport's keys", entry("nope:path=/x", 0, &a) == 0 && entry("unixexec:path=/bin/x", 0, &a) == 0);
    check("a key with no value after", entry("unix:path=/x,guid", 0, &a) == 0);
    check("a key that only starts like one", entry("unix:pathx=/a", 0, &a) == 0);
    check("an escape cut off by the length", address.entry("unix:path=/a%41", 14, 0, &a) == 0
          && address.entry("unix:path=/a%41", 15, 0, &a) == 1 && name_is(&a, "/aA") == 1);
    let is *u8 as two = "tcp:host=x,port=1;unix:path=/second";
    check("two entries", address.count(two, 35) == 2);
    check("the second", entry(two, 1, &a) == 1 && name_is(&a, "/second") == 1);
    check("no third", entry(two, 2, &a) == 0);
    check("no entries in nothing", address.count("", 0) == 0);
    let is [120]u8 as long;
    mem.memcpy(cast(*u8, &long), "unix:path=/", 11);
    mem.memset(cast(*u8, cast(i64, &long) + 11), 97, 106);
    long[117] = 0;
    check("107 bytes, the longest a socket takes", entry(cast(*u8, &long), 0, &a) == 1 && a.len == 107);
    mem.memset(cast(*u8, cast(i64, &long) + 11), 97, 108);
    long[119] = 0;
    check("a path too long for a socket", entry(cast(*u8, &long), 0, &a) == 0);

    // The session's: the variable, or the runtime directory's bus.
    let is [512]u8 as buf;
    let is i64 as n with mut = address.session(cast(*u8, &buf), 512);
    let is *u8 as v = env.getenv("DBUS_SESSION_BUS_ADDRESS");
    if (cast(i64, v) != 0) {
        check("the variable's", n > 0 && mem.memcmp(cast(*u8, &buf), v, n + 1) == 0);
    } else {
        let is *u8 as run = env.getenv("XDG_RUNTIME_DIR");
        if (cast(i64, run) != 0) {
            check("the runtime directory's", n > 0 && mem.memcmp(cast(*u8, &buf), "unix:path=", 10) == 0);
        } else {
            check("none", n == 0);
        }
    }
    check("too small for it", address.session(cast(*u8, &buf), 4) == 0);
    n = address.session_from(cast(*u8, 0), "/run/user/1000", cast(*u8, &buf), 512);
    check("the runtime directory's bus", n == 28 && mem.memcmp(cast(*u8, &buf), "unix:path=/run/user/1000/bus", 29) == 0);
    check("the variable first", address.session_from("unix:path=/v", "/run/user/1000", cast(*u8, &buf), 512) == 12
          && mem.memcmp(cast(*u8, &buf), "unix:path=/v", 13) == 0);
    check("neither", address.session_from(cast(*u8, 0), cast(*u8, 0), cast(*u8, &buf), 512) == 0);
    check("an empty variable", address.session_from("", cast(*u8, 0), cast(*u8, &buf), 512) == 0);
    check("no room for the runtime directory's", address.session_from(cast(*u8, 0), "/run/user/1000", cast(*u8, &buf), 28) == 0);

    if (fails > 0) {
        io.printf("dbus address: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("dbus address: all checks passed\n");
    return 0;
}
