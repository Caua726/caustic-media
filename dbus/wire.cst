// dbus/wire.cst — the D-Bus wire format: values, alignment, signatures.
//
// Every value is aligned to its own size, counted from the start of the
// message; the body starts on an 8-byte boundary, so a Writer or Reader over a
// body counts from the body's start and gets the same answer. Arrays carry
// their length in bytes — not counting the padding before the first element,
// which is there even when the array is empty. A variant is a signature, then
// one value of the type it names.
//
// Writing is little-endian. Reading takes either order, as the specification
// requires of every peer, and checks everything: a length past the end, a
// padding byte that is not zero, a boolean that is not 0 or 1, a string
// without its terminating zero all set err and stop the Reader, which from
// then on reads nothing but zeros. A message is what another process sent;
// nothing in it is trusted.
use "std/mem.cst" as mem;

// The largest array the specification allows, and the deepest nesting.
let is i64 as MAX_ARRAY     with imut = 67108864;
let is i64 as MAX_DEPTH     with imut = 32;
let is i64 as MAX_SIGNATURE with imut = 255;

// --- Signatures ---

// The alignment of a value whose type starts with c.
fn align_of(c as u8) as i64 {
    if (c == 121 || c == 103 || c == 118) { return 1; }   // y g v
    if (c == 110 || c == 113) { return 2; }               // n q
    if (c == 120 || c == 116 || c == 100 || c == 40 || c == 123) { return 8; }   // x t d ( {
    return 4;                                             // b i u s o a h
}

fn _basic(c as u8) as i32 {
    // y b n q i u x t d s o g h
    if (c == 121 || c == 98 || c == 110 || c == 113 || c == 105 || c == 117 || c == 120
        || c == 116 || c == 100 || c == 115 || c == 111 || c == 103 || c == 104) { return 1; }
    return 0;
}

fn _at(s as *u8, i as i64) as u8 { return *cast(*u8, cast(i64, s) + i); }

// Where the single complete type starting at s[i] ends (one past it), or -1
// when there is none there. arrays and structs count the nesting so far.
fn _complete(s as *u8, len as i64, i as i64, arrays as i64, structs as i64) as i64 {
    if (i >= len) { return 0 - 1; }
    let is u8 as c = _at(s, i);
    if (_basic(c) == 1 || c == 118) { return i + 1; }
    if (c == 97) {   // a
        if (arrays + 1 > MAX_DEPTH) { return 0 - 1; }
        if (i + 1 < len && _at(s, i + 1) == 123) {   // a{
            // A dict entry: a basic key, one complete value, and nothing else.
            if (i + 2 >= len || _basic(_at(s, i + 2)) == 0) { return 0 - 1; }
            if (structs + 1 > MAX_DEPTH) { return 0 - 1; }
            let is i64 as v = _complete(s, len, i + 3, arrays + 1, structs + 1);
            if (v < 0 || v >= len || _at(s, v) != 125) { return 0 - 1; }
            return v + 1;
        }
        return _complete(s, len, i + 1, arrays + 1, structs);
    }
    if (c == 40) {   // (
        if (structs + 1 > MAX_DEPTH) { return 0 - 1; }
        let is i64 as j with mut = i + 1;
        if (j < len && _at(s, j) == 41) { return 0 - 1; }   // () is not a type
        while (j < len && _at(s, j) != 41) {
            j = _complete(s, len, j, arrays, structs + 1);
            if (j < 0) { return 0 - 1; }
        }
        if (j >= len) { return 0 - 1; }
        return j + 1;
    }
    return 0 - 1;   // ) } { alone, or a letter that is no type
}

// One past the end of the complete type at s[i], or -1.
fn next(s as *u8, len as i64, i as i64) as i64 { return _complete(s, len, i, 0, 0); }

// A whole signature: zero or more complete types, at most 255 bytes.
fn valid(s as *u8, len as i64) as i32 {
    if (len < 0 || len > MAX_SIGNATURE) { return 0; }
    let is i64 as i with mut = 0;
    while (i < len) {
        i = next(s, len, i);
        if (i < 0) { return 0; }
    }
    return 1;
}

// Exactly one complete type, as a variant carries.
fn single(s as *u8, len as i64) as i32 {
    if (len < 1 || valid(s, len) == 0) { return 0; }
    if (next(s, len, 0) == len) { return 1; }
    return 0;
}

fn cstr_len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (_at(s, n) != 0) { n = n + 1; }
    return n;
}

// --- Writing ---

struct Writer {
    buf  as *u8;
    cap  as i64;
    len  as i64;
    base as i64;   // the offset of buf[0] in the message, for alignment
    err  as i32;   // ran out of room, or was handed something invalid
    _pad0 as i32;
    fds  as [16]i32;   // descriptors to send with the message; values say indices
    nfds as i64;
}

fn writer(buf as *u8, cap as i64) as Writer {
    let is Writer as w;
    w.buf = buf;
    w.cap = cap;
    w.len = 0;
    w.base = 0;
    w.err = 0;
    w._pad0 = 0;
    w.nfds = 0;
    return w;
}

fn reset(w as *Writer) as void {
    w.len = 0;
    w.err = 0;
    w.nfds = 0;
}

fn _room(w as *Writer, n as i64) as i32 {
    if (w.err != 0) { return 0; }
    if (w.len + n > w.cap) {
        w.err = 1;
        return 0;
    }
    return 1;
}

fn _p(w as *Writer) as *u8 { return cast(*u8, cast(i64, w.buf) + w.len); }

fn pad(w as *Writer, a as i64) as void {
    while (((w.base + w.len) % a) != 0) {
        if (_room(w, 1) == 0) { return; }
        *_p(w) = 0;
        w.len = w.len + 1;
    }
}

fn put_byte(w as *Writer, v as i64) as void {
    if (_room(w, 1) == 0) { return; }
    *_p(w) = cast(u8, v & 255);
    w.len = w.len + 1;
}

fn put_u16(w as *Writer, v as i64) as void {
    pad(w, 2);
    if (_room(w, 2) == 0) { return; }
    *cast(*u16, _p(w)) = cast(u16, v & 65535);
    w.len = w.len + 2;
}

fn put_i16(w as *Writer, v as i64) as void { put_u16(w, v); }

fn put_u32(w as *Writer, v as i64) as void {
    pad(w, 4);
    if (_room(w, 4) == 0) { return; }
    *cast(*u32, _p(w)) = cast(u32, v & 4294967295);
    w.len = w.len + 4;
}

fn put_i32(w as *Writer, v as i64) as void { put_u32(w, v); }

fn put_bool(w as *Writer, v as i32) as void {
    if (v != 0) { put_u32(w, 1); } else { put_u32(w, 0); }
}

fn put_u64(w as *Writer, v as i64) as void {
    pad(w, 8);
    if (_room(w, 8) == 0) { return; }
    *cast(*i64, _p(w)) = v;
    w.len = w.len + 8;
}

fn put_i64(w as *Writer, v as i64) as void { put_u64(w, v); }

fn put_double(w as *Writer, v as f64) as void {
    pad(w, 8);
    if (_room(w, 8) == 0) { return; }
    *cast(*f64, _p(w)) = v;
    w.len = w.len + 8;
}

// A string of len bytes, which must not hold a zero.
fn put_string_n(w as *Writer, s as *u8, len as i64) as void {
    let is i64 as i with mut = 0;
    while (i < len) {
        if (_at(s, i) == 0) { w.err = 1; return; }
        i = i + 1;
    }
    put_u32(w, len);
    if (_room(w, len + 1) == 0) { return; }
    mem.memcpy(_p(w), s, len);
    *cast(*u8, cast(i64, w.buf) + w.len + len) = 0;
    w.len = w.len + len + 1;
}

fn put_string(w as *Writer, s as *u8) as void { put_string_n(w, s, cstr_len(s)); }

// An object path: '/', or '/'-separated elements of [A-Za-z0-9_], none empty
// and no trailing '/'.
fn path_valid(s as *u8, len as i64) as i32 {
    if (len < 1 || _at(s, 0) != 47) { return 0; }
    if (len == 1) { return 1; }
    if (_at(s, len - 1) == 47) { return 0; }
    let is i64 as i with mut = 1;
    while (i < len) {
        let is u8 as c = _at(s, i);
        if (c == 47) {
            if (_at(s, i - 1) == 47) { return 0; }
        } else if (!((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95)) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn put_path(w as *Writer, s as *u8) as void {
    let is i64 as n = cstr_len(s);
    if (path_valid(s, n) == 0) { w.err = 1; return; }
    put_string_n(w, s, n);
}

fn put_signature_n(w as *Writer, s as *u8, len as i64) as void {
    if (valid(s, len) == 0) { w.err = 1; return; }
    if (_room(w, len + 2) == 0) { return; }
    *_p(w) = cast(u8, len);
    mem.memcpy(cast(*u8, cast(i64, w.buf) + w.len + 1), s, len);
    *cast(*u8, cast(i64, w.buf) + w.len + 1 + len) = 0;
    w.len = w.len + len + 2;
}

fn put_signature(w as *Writer, s as *u8) as void { put_signature_n(w, s, cstr_len(s)); }

// A descriptor sent with the message; the body holds its index among them.
fn put_fd(w as *Writer, fd as i64) as void {
    if (w.nfds >= 16 || fd < 0) { w.err = 1; return; }
    w.fds[w.nfds] = cast(i32, fd);
    put_u32(w, w.nfds);
    w.nfds = w.nfds + 1;
}

// An array: begin returns where its length goes; write the elements, then end
// with the same position and the element's alignment.
fn put_array(w as *Writer, elem_align as i64) as i64 {
    put_u32(w, 0);
    let is i64 as at = w.len - 4;
    pad(w, elem_align);
    return at;
}

fn put_array_end(w as *Writer, at as i64, elem_align as i64) as void {
    if (w.err != 0) { return; }
    // The elements start after the length and the padding to their alignment.
    let is i64 as start with mut = at + 4;
    while (((w.base + start) % elem_align) != 0) { start = start + 1; }
    let is i64 as n = w.len - start;
    if (n > MAX_ARRAY) { w.err = 1; return; }
    *cast(*u32, cast(i64, w.buf) + at) = cast(u32, n);
}

// A struct or a dict entry starts on 8.
fn put_struct(w as *Writer) as void { pad(w, 8); }

// A variant: its signature, then the caller writes one value of that type.
fn put_variant(w as *Writer, sig as *u8) as void {
    let is i64 as n = cstr_len(sig);
    if (single(sig, n) == 0) { w.err = 1; return; }
    put_signature_n(w, sig, n);
}

// --- Reading ---

struct Reader {
    buf  as *u8;
    len  as i64;
    pos  as i64;
    base as i64;   // the offset of buf[0] in the message
    big  as i32;   // the message is big-endian
    err  as i32;
    fds  as *i32;  // the descriptors that came with the message
    nfds as i64;
}

fn reader(buf as *u8, len as i64, big as i32) as Reader {
    let is Reader as r;
    r.buf = buf;
    r.len = len;
    r.pos = 0;
    r.base = 0;
    r.big = big;
    r.err = 0;
    r.fds = cast(*i32, 0);
    r.nfds = 0;
    return r;
}

fn _fail(r as *Reader) as void {
    r.err = 1;
    r.pos = r.len;
}

fn _has(r as *Reader, n as i64) as i32 {
    if (r.err != 0) { return 0; }
    // n is a length off the wire, unsigned, or one more than one.
    if (r.pos + n > r.len) {
        _fail(r);
        return 0;
    }
    return 1;
}

fn _q(r as *Reader) as *u8 { return cast(*u8, cast(i64, r.buf) + r.pos); }

// Skips the padding to a, which must be zeros.
fn align(r as *Reader, a as i64) as void {
    while (r.err == 0 && ((r.base + r.pos) % a) != 0) {
        if (_has(r, 1) == 0) { return; }
        if (*_q(r) != 0) { _fail(r); return; }
        r.pos = r.pos + 1;
    }
}

fn _swap16(v as i64) as i64 { return ((v & 255) << 8) | ((v >> 8) & 255); }
fn _swap32(v as i64) as i64 {
    return ((v & 255) << 24) | (((v >> 8) & 255) << 16) | (((v >> 16) & 255) << 8) | ((v >> 24) & 255);
}

fn _u16(r as *Reader) as i64 {
    align(r, 2);
    if (_has(r, 2) == 0) { return 0; }
    let is i64 as v with mut = cast(i64, *cast(*u16, _q(r))) & 65535;
    if (r.big == 1) { v = _swap16(v); }
    r.pos = r.pos + 2;
    return v;
}

fn _u32(r as *Reader) as i64 {
    align(r, 4);
    if (_has(r, 4) == 0) { return 0; }
    let is i64 as v with mut = cast(i64, *cast(*u32, _q(r))) & 4294967295;
    if (r.big == 1) { v = _swap32(v); }
    r.pos = r.pos + 4;
    return v;
}

fn _u64(r as *Reader) as i64 {
    align(r, 8);
    if (_has(r, 8) == 0) { return 0; }
    let is i64 as v with mut = *cast(*i64, _q(r));
    if (r.big == 1) {
        let is i64 as lo = v & 4294967295;
        let is i64 as hi = (v >> 32) & 4294967295;
        v = (_swap32(lo) << 32) | _swap32(hi);
    }
    r.pos = r.pos + 8;
    return v;
}

fn get_byte(r as *Reader) as i64 {
    if (_has(r, 1) == 0) { return 0; }
    let is i64 as v = cast(i64, *_q(r)) & 255;
    r.pos = r.pos + 1;
    return v;
}

fn get_u16(r as *Reader) as i64 { return _u16(r); }

fn get_i16(r as *Reader) as i64 {
    let is i64 as v = _u16(r);
    if (v >= 32768) { return v - 65536; }
    return v;
}

fn get_u32(r as *Reader) as i64 { return _u32(r); }

fn get_i32(r as *Reader) as i64 {
    let is i64 as v = _u32(r);
    if (v >= 2147483648) { return v - 4294967296; }
    return v;
}

fn get_bool(r as *Reader) as i32 {
    let is i64 as v = _u32(r);
    if (v > 1) { _fail(r); return 0; }
    return cast(i32, v);
}

fn get_u64(r as *Reader) as i64 { return _u64(r); }
fn get_i64(r as *Reader) as i64 { return _u64(r); }

fn get_double(r as *Reader) as f64 {
    let is i64 as bits = _u64(r);
    return *cast(*f64, &bits);
}

// A string, as a pointer into the message — zero-terminated there — and its
// length in len. A string holding a zero, or missing its last one, is an error.
fn get_string(r as *Reader, len as *i64) as *u8 {
    let is i64 as n = _u32(r);
    *len = 0;
    if (_has(r, n + 1) == 0) { return cast(*u8, 0); }
    let is *u8 as s = _q(r);
    if (_at(s, n) != 0) { _fail(r); return cast(*u8, 0); }
    let is i64 as i with mut = 0;
    while (i < n) {
        if (_at(s, i) == 0) { _fail(r); return cast(*u8, 0); }
        i = i + 1;
    }
    r.pos = r.pos + n + 1;
    *len = n;
    return s;
}

fn get_path(r as *Reader, len as *i64) as *u8 {
    let is *u8 as s = get_string(r, len);
    if (r.err != 0) { return s; }
    if (path_valid(s, *len) == 0) { _fail(r); *len = 0; return cast(*u8, 0); }
    return s;
}

fn get_signature(r as *Reader, len as *i64) as *u8 {
    *len = 0;
    if (_has(r, 1) == 0) { return cast(*u8, 0); }
    let is i64 as n = cast(i64, *_q(r)) & 255;
    r.pos = r.pos + 1;
    if (_has(r, n + 1) == 0) { return cast(*u8, 0); }
    let is *u8 as s = _q(r);
    if (_at(s, n) != 0 || valid(s, n) == 0) { _fail(r); return cast(*u8, 0); }
    r.pos = r.pos + n + 1;
    *len = n;
    return s;
}

// The descriptor an index names, or -1 when no such one came.
fn get_fd(r as *Reader) as i64 {
    let is i64 as i = _u32(r);
    if (r.err != 0) { return 0 - 1; }
    if (i >= r.nfds) { _fail(r); return 0 - 1; }
    return cast(i64, *cast(*i32, cast(i64, r.fds) + i * 4));
}

// An array: returns where it ends. Read elements while r.pos < that.
fn get_array(r as *Reader, elem_align as i64) as i64 {
    let is i64 as n = _u32(r);
    align(r, elem_align);
    if (r.err != 0) { return r.pos; }
    if (n > MAX_ARRAY || r.pos + n > r.len) {
        _fail(r);
        return r.pos;
    }
    return r.pos + n;
}

fn get_struct(r as *Reader) as void { align(r, 8); }

// A variant's signature — a single complete type — with its length in len.
// The value follows.
fn get_variant(r as *Reader, len as *i64) as *u8 {
    let is *u8 as s = get_signature(r, len);
    if (r.err != 0) { return s; }
    if (single(s, *len) == 0) { _fail(r); *len = 0; return cast(*u8, 0); }
    return s;
}

// Skips one value of the complete type at sig[i]; returns where that type
// ends in sig. depth counts variants inside variants, which the signature does
// not show.
fn _skip(r as *Reader, sig as *u8, len as i64, i as i64, depth as i64) as i64 {
    if (r.err != 0) { return len; }
    if (depth > MAX_DEPTH) { _fail(r); return len; }
    let is i64 as end = next(sig, len, i);
    if (end < 0) { _fail(r); return len; }
    let is u8 as c = _at(sig, i);
    let is i64 as n with mut = 0;
    if (c == 121) { get_byte(r); }
    else if (c == 98) { get_bool(r); }
    else if (c == 110 || c == 113) { _u16(r); }
    else if (c == 105 || c == 117) { _u32(r); }
    else if (c == 104) { get_fd(r); }
    else if (c == 120 || c == 116 || c == 100) { _u64(r); }
    else if (c == 115) { get_string(r, &n); }
    else if (c == 111) { get_path(r, &n); }
    else if (c == 103) { get_signature(r, &n); }
    else if (c == 118) {
        let is *u8 as vs = get_variant(r, &n);
        if (r.err == 0) { _skip(r, vs, n, 0, depth + 1); }
    } else if (c == 97) {
        let is u8 as e = _at(sig, i + 1);
        let is i64 as at = get_array(r, align_of(e));
        // Every element takes at least a byte, so this ends.
        while (r.err == 0 && r.pos < at) {
            if (e == 123) {
                // A dict entry, {key value}: the key at i + 2, the value
                // after it, the closing brace at end - 1.
                get_struct(r);
                let is i64 as k = _skip(r, sig, end - 1, i + 2, depth);
                _skip(r, sig, end - 1, k, depth);
            } else {
                _skip(r, sig, end, i + 1, depth);
            }
        }
        if (r.err == 0 && r.pos != at) { _fail(r); }
    } else if (c == 40) {
        get_struct(r);
        let is i64 as j with mut = i + 1;
        while (r.err == 0 && j < end - 1) {
            j = _skip(r, sig, end - 1, j, depth);
        }
    }
    return end;
}

// Skips one value of type sig, a single complete type.
fn skip(r as *Reader, sig as *u8, len as i64) as void {
    if (single(sig, len) == 0) { _fail(r); return; }
    _skip(r, sig, len, 0, 0);
}

// Skips every value of a whole signature; 1 when it read exactly to the end.
fn skip_all(r as *Reader, sig as *u8, len as i64) as i32 {
    let is i64 as i with mut = 0;
    while (r.err == 0 && i < len) {
        i = _skip(r, sig, len, i, 0);
    }
    if (r.err == 0 && r.pos == r.len) { return 1; }
    return 0;
}
