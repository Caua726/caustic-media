// dbus/tools/busctl_peer.cst — an object for busctl_check.sh to talk to.
//
// Exports org.caustic.Serve at /org/caustic/Serve and answers until Quit is
// called, or ten seconds pass: busctl, which is sd-bus, calls it, reads and
// sets its properties, and parses its introspection — a third implementation
// of the protocol checking this one from the other side.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "../dbus.cst" as dbus;

let is i32 as quit with mut = 0;
let is [64]u8 as label with mut;
let is i64 as label_len with mut = 0;

fn m_add(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is i64 as a = dbus.wire.get_i32(&k.args);
    dbus.wire.put_i32(k.reply, a + dbus.wire.get_i32(&k.args));
}

fn m_echo(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is i64 as n with mut = 0;
    let is *u8 as s = dbus.wire.get_string(&k.args, &n);
    dbus.wire.put_string_n(k.reply, s, n);
}

fn m_fail(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    k.error_name = "org.caustic.Error.Nope";
    k.error_text = "it says no";
}

// a{sv} with one of each kind of value busctl prints.
fn m_values(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is *dbus.wire.Writer as w = k.reply;
    let is i64 as at = dbus.wire.put_array(w, 8);
    dbus.wire.put_struct(w);
    dbus.wire.put_string(w, "scheme");
    dbus.wire.put_variant(w, "u");
    dbus.wire.put_u32(w, 1);
    dbus.wire.put_struct(w);
    dbus.wire.put_string(w, "accent");
    dbus.wire.put_variant(w, "(ddd)");
    dbus.wire.put_struct(w);
    dbus.wire.put_double(w, 0.25);
    dbus.wire.put_double(w, 0.5);
    dbus.wire.put_double(w, 1.0);
    dbus.wire.put_struct(w);
    dbus.wire.put_string(w, "names");
    dbus.wire.put_variant(w, "as");
    let is i64 as names = dbus.wire.put_array(w, 4);
    dbus.wire.put_string(w, "one");
    dbus.wire.put_string(w, "two");
    dbus.wire.put_array_end(w, names, 4);
    dbus.wire.put_struct(w);
    dbus.wire.put_string(w, "big");
    dbus.wire.put_variant(w, "x");
    dbus.wire.put_i64(w, 0 - 9000000000);
    dbus.wire.put_array_end(w, at, 8);
}

fn m_quit(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { quit = 1; }

fn p_label(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    dbus.wire.put_string_n(w, cast(*u8, &label), label_len);
}

fn p_set_label(c as *dbus.conn.Conn, r as *dbus.wire.Reader, user as *u8) as i32 {
    let is i64 as n with mut = 0;
    let is *u8 as s = dbus.wire.get_string(r, &n);
    if (n >= 64) { return 0; }
    mem.memcpy(cast(*u8, &label), s, n + 1);
    label_len = n;
    return 1;
}

let is [5]dbus.conn.Method as methods with mut;
let is [1]dbus.conn.Property as props with mut;
let is [1]dbus.conn.Interface as ifaces with mut;

fn method(i as i64, name as *u8, ins as *u8, outs as *u8, h as dbus.conn.MethodFn) as void {
    methods[i].name = name;
    methods[i].in_sig = ins;
    methods[i].out_sig = outs;
    methods[i].handler = h;
    methods[i].in_names = cast(*u8, 0);
    methods[i].out_names = cast(*u8, 0);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    mem.memcpy(cast(*u8, &label), "first", 6);
    label_len = 5;
    method(0, "Add", "ii", "i", fn_ptr(m_add));
    method(1, "Echo", "s", "s", fn_ptr(m_echo));
    method(2, "Fail", "", "", fn_ptr(m_fail));
    method(3, "Values", "", "a{sv}", fn_ptr(m_values));
    method(4, "Quit", "", "", fn_ptr(m_quit));
    props[0].name = "Label";
    props[0].sig = "s";
    props[0].get = fn_ptr(p_label);
    props[0].set = fn_ptr(p_set_label);
    ifaces[0].name = "org.caustic.Serve";
    ifaces[0].methods = cast(*dbus.conn.Method, &methods);
    ifaces[0].nmethods = 5;
    ifaces[0].props = cast(*dbus.conn.Property, &props);
    ifaces[0].nprops = 1;
    ifaces[0].signals = cast(*dbus.conn.SignalDecl, 0);
    ifaces[0].nsignals = 0;
    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    let is dbus.conn.Conn as c with mut = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&c) == 0) { io.printf("busctl_peer: no bus\n"); return 1; }
    dbus.conn.export(&c, "/org/caustic/Serve", cast(*dbus.conn.Interface, &ifaces), 1, cast(*u8, 0));
    if (dbus.conn.request_name(&c, "org.caustic.Serve", 4) != 1) { io.printf("busctl_peer: no name\n"); return 1; }
    let is i64 as until = time.now_ms() + 10000;
    while (quit == 0 && time.now_ms() < until) {
        if (dbus.conn.dispatch(&c, 100) < 0) { io.printf("busctl_peer: the bus went away\n"); return 1; }
    }
    dbus.conn.close(&c);
    if (quit == 0) { io.printf("busctl_peer: nobody said quit\n"); return 1; }
    return 0;
}
