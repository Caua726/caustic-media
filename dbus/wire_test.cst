// dbus/wire_test.cst — the wire format, byte for byte, and what it refuses.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "wire.cst" as wire;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is [512]u8 as buf with mut;

fn b(i as i64) as i64 { return cast(i64, buf[i]) & 255; }

fn sig_ok(s as *u8) as i32 { return wire.valid(s, wire.cstr_len(s)); }

fn path_ok(s as *u8) as i32 { return wire.path_valid(s, wire.cstr_len(s)); }

// A reader over the first n bytes of buf.
fn over(n as i64) as wire.Reader { return wire.reader(cast(*u8, &buf), n, 0); }

fn main() as i32 {
    // --- Signatures ---
    check("basic types", sig_ok("ybnqiuxtdsogh") == 1);
    check("a variant", sig_ok("v") == 1);
    check("an empty signature", sig_ok("") == 1);
    check("a dict", sig_ok("a{sv}") == 1);
    check("arrays of dicts, structs with arrays", sig_ok("aa{sv}(a{sv}as)a(ddd)") == 1);
    check("a dict's key must be basic", sig_ok("a{vs}") == 0 && sig_ok("a{(i)s}") == 0);
    check("a dict entry holds two", sig_ok("a{s}") == 0 && sig_ok("a{sss}") == 0);
    check("a dict entry only in an array", sig_ok("{sv}") == 0);
    check("an empty struct is not a type", sig_ok("()") == 0);
    check("unclosed", sig_ok("(i") == 0 && sig_ok("a{sv") == 0);
    check("an array of nothing", sig_ok("a") == 0);
    check("a closing paren alone", sig_ok(")") == 0);
    check("no such type", sig_ok("z") == 0);
    let is [40]u8 as deep;
    let is i64 as k with mut = 0;
    while (k < 32) { deep[k] = 97; k = k + 1; }
    deep[32] = 121;
    check("32 arrays deep", wire.valid(cast(*u8, &deep), 33) == 1);
    deep[32] = 97;
    deep[33] = 121;
    check("33 arrays deep is too deep", wire.valid(cast(*u8, &deep), 34) == 0);
    check("longer than 255", wire.valid("y", 256) == 0);
    check("one complete type", wire.single("a{sv}", 5) == 1 && wire.single("ss", 2) == 0 && wire.single("", 0) == 0);
    check("next", wire.next("a{sv}u", 6, 0) == 5 && wire.next("(ii)u", 5, 0) == 4);
    check("a dict entry ends with its brace", wire.next("a{sss}", 6, 0) == 0 - 1);
    check("alignments", wire.align_of(121) == 1 && wire.align_of(103) == 1 && wire.align_of(118) == 1
          && wire.align_of(110) == 2 && wire.align_of(113) == 2 && wire.align_of(105) == 4 && wire.align_of(97) == 4
          && wire.align_of(120) == 8 && wire.align_of(100) == 8 && wire.align_of(40) == 8 && wire.align_of(123) == 8);
    let is [80]u8 as deeper;
    k = 0;
    while (k < 32) { deeper[k] = 40; deeper[32 + 1 + k] = 41; k = k + 1; }
    deeper[32] = 121;
    check("structs 32 deep", wire.valid(cast(*u8, &deeper), 65) == 1);
    k = 0;
    while (k < 33) { deeper[k] = 40; deeper[33 + 1 + k] = 41; k = k + 1; }
    deeper[33] = 121;
    check("33 deep is too deep", wire.valid(cast(*u8, &deeper), 67) == 0);
    let is [80]u8 as entries;
    k = 0;
    while (k < 32) { entries[k] = 40; k = k + 1; }
    entries[32] = 97; entries[33] = 123; entries[34] = 115; entries[35] = 121; entries[36] = 125;
    k = 37;
    while (k < 69) { entries[k] = 41; k = k + 1; }
    check("a dict entry counts as a struct deep down", wire.valid(cast(*u8, &entries), 69) == 0);
    let is [256]u8 as ys;
    mem.memset(cast(*u8, &ys), 121, 256);
    check("255 bytes", wire.valid(cast(*u8, &ys), 255) == 1 && wire.valid(cast(*u8, &ys), 256) == 0);

    // --- Object paths ---
    check("the root", path_ok("/") == 1);
    check("a path", path_ok("/org/freedesktop/portal/desktop") == 1 && path_ok("/a_1/B2") == 1);
    check("not empty", path_ok("") == 0);
    check("from the root", path_ok("a/b") == 0);
    check("no trailing slash", path_ok("/a/") == 0);
    check("no empty element", path_ok("/a//b") == 0);
    check("no other characters", path_ok("/a-b") == 0 && path_ok("/a.b") == 0);

    // --- Writing, byte for byte ---
    let is wire.Writer as w with mut = wire.writer(cast(*u8, &buf), 512);
    wire.put_byte(&w, 1);
    wire.put_u32(&w, 0x04030201);
    check("a u32 after a byte is padded to 4", w.len == 8 && b(0) == 1 && b(1) == 0 && b(2) == 0 && b(3) == 0
          && b(4) == 1 && b(5) == 2 && b(6) == 3 && b(7) == 4);
    wire.reset(&w);
    wire.put_byte(&w, 7);
    wire.put_u16(&w, 0x0201);
    wire.put_byte(&w, 9);
    wire.put_u64(&w, 0x0807060504030201);
    check("u16 on 2, u64 on 8", w.len == 16 && b(2) == 1 && b(3) == 2 && b(4) == 9 && b(8) == 1 && b(15) == 8);
    wire.reset(&w);
    mem.memset(cast(*u8, &buf), 255, 16);
    wire.put_string(&w, "hi");
    check("a string: length, bytes, zero", w.len == 7 && b(0) == 2 && b(3) == 0 && b(4) == 104 && b(5) == 105 && b(6) == 0);
    wire.reset(&w);
    wire.put_signature(&w, "a{sv}");
    check("a signature: one byte of length", w.len == 7 && b(0) == 5 && b(1) == 97 && b(6) == 0);
    wire.reset(&w);
    let is i64 as at = wire.put_array(&w, 8);
    wire.put_u64(&w, 5);
    wire.put_u64(&w, 6);
    wire.put_array_end(&w, at, 8);
    check("an array of u64: length without the padding", w.len == 24 && b(0) == 16 && b(4) == 0 && b(8) == 5 && b(16) == 6);
    wire.reset(&w);
    let is i64 as at2 = wire.put_array(&w, 8);
    wire.put_array_end(&w, at2, 8);
    check("an empty array still pads", w.len == 8 && b(0) == 0);
    wire.reset(&w);
    wire.put_byte(&w, 1);
    let is i64 as at3 = wire.put_array(&w, 4);
    wire.put_u32(&w, 9);
    wire.put_array_end(&w, at3, 4);
    check("an array's length counted from its first element", w.len == 12 && b(4) == 4 && b(8) == 9);
    wire.reset(&w);
    wire.put_byte(&w, 1);
    wire.put_struct(&w);
    wire.put_byte(&w, 2);
    check("a struct starts on 8", w.len == 9 && b(8) == 2);
    wire.reset(&w);
    wire.put_bool(&w, 5);
    check("a boolean is 1", w.len == 4 && b(0) == 1);
    wire.reset(&w);
    w.base = 4;
    wire.put_u64(&w, 1);
    check("alignment counts from the message, not the buffer", w.len == 12);
    w.base = 0;

    // --- Round trip ---
    wire.reset(&w);
    wire.put_byte(&w, 200);
    wire.put_bool(&w, 1);
    wire.put_i16(&w, 0 - 2);
    wire.put_u16(&w, 65000);
    wire.put_i32(&w, 0 - 100000);
    wire.put_u32(&w, 4000000000);
    wire.put_i64(&w, 0 - 5);
    wire.put_u64(&w, 1234567890123);
    wire.put_double(&w, 0.207843);
    wire.put_string(&w, "org.freedesktop.appearance");
    wire.put_path(&w, "/org/freedesktop/portal/desktop");
    wire.put_signature(&w, "(ddd)");
    let is i64 as dict = wire.put_array(&w, 8);
    wire.put_struct(&w);
    wire.put_string(&w, "color-scheme");
    wire.put_variant(&w, "u");
    wire.put_u32(&w, 1);
    wire.put_struct(&w);
    wire.put_string(&w, "accent-color");
    wire.put_variant(&w, "(ddd)");
    wire.put_struct(&w);
    wire.put_double(&w, 0.2);
    wire.put_double(&w, 0.5);
    wire.put_double(&w, 0.9);
    wire.put_array_end(&w, dict, 8);
    wire.put_fd(&w, 42);
    check("written without error", w.err == 0 && w.nfds == 1 && w.fds[0] == 42);
    let is wire.Reader as r with mut = over(w.len);
    let is [1]i32 as fds;
    fds[0] = 77;
    r.fds = cast(*i32, &fds);
    r.nfds = 1;
    check("byte", wire.get_byte(&r) == 200);
    check("boolean", wire.get_bool(&r) == 1);
    check("int16", wire.get_i16(&r) == 0 - 2);
    check("uint16", wire.get_u16(&r) == 65000);
    check("int32", wire.get_i32(&r) == 0 - 100000);
    check("uint32", wire.get_u32(&r) == 4000000000);
    check("int64", wire.get_i64(&r) == 0 - 5);
    check("uint64", wire.get_u64(&r) == 1234567890123);
    check("double", wire.get_double(&r) == 0.207843);
    let is i64 as n with mut = 0;
    let is *u8 as s with mut = wire.get_string(&r, &n);
    check("string", n == 26 && mem.memcmp(s, "org.freedesktop.appearance", 27) == 0);
    s = wire.get_path(&r, &n);
    check("object path", n == 31 && mem.memcmp(s, "/org/freedesktop/portal/desktop", 31) == 0);
    s = wire.get_signature(&r, &n);
    check("signature", n == 5 && mem.memcmp(s, "(ddd)", 5) == 0);
    let is i64 as end = wire.get_array(&r, 8);
    wire.get_struct(&r);
    s = wire.get_string(&r, &n);
    check("dict key", n == 12 && mem.memcmp(s, "color-scheme", 12) == 0);
    s = wire.get_variant(&r, &n);
    check("variant u", n == 1 && s[0] == 117 && wire.get_u32(&r) == 1);
    wire.get_struct(&r);
    s = wire.get_string(&r, &n);
    s = wire.get_variant(&r, &n);
    check("variant (ddd)", n == 5);
    wire.get_struct(&r);
    check("in the variant", wire.get_double(&r) == 0.2 && wire.get_double(&r) == 0.5 && wire.get_double(&r) == 0.9);
    check("the dict's end", r.pos == end);
    check("the descriptor by its index", wire.get_fd(&r) == 77);
    check("read without error, to the end", r.err == 0 && r.pos == r.len);

    // The same body skipped by its signature.
    let is wire.Reader as all with mut = over(w.len);
    all.fds = cast(*i32, &fds);
    all.nfds = 1;
    check("skipped whole", wire.skip_all(&all, "ybnqiuxtdsoga{sv}h", 18) == 1);
    let is wire.Reader as part with mut = over(w.len);
    part.fds = cast(*i32, &fds);
    part.nfds = 1;
    check("bytes left over are not the whole", wire.skip_all(&part, "ybnqiuxtdsog", 12) == 0 && part.err == 0);
    let is wire.Reader as nested with mut = over(w.len);
    check("skip one value", wire.get_byte(&nested) == 200);
    wire.skip(&nested, "b", 1);
    check("and go on after it", wire.get_i16(&nested) == 0 - 2);

    // Variants inside variants, past the depth any peer has to accept.
    let is wire.Writer as vv with mut = wire.writer(cast(*u8, &buf), 512);
    k = 0;
    while (k < 34) { wire.put_variant(&vv, "v"); k = k + 1; }
    wire.put_variant(&vv, "y");
    wire.put_byte(&vv, 1);
    let is wire.Reader as vr with mut = over(vv.len);
    wire.skip(&vr, "v", 1);
    check("variants nested too deep", vr.err == 1);
    let is wire.Reader as vr2 with mut = over(vv.len);
    vr2.pos = 6;   // two variants in: 33 levels left, still too many
    wire.skip(&vr2, "v", 1);
    check("and still too deep", vr2.err == 1);
    let is wire.Reader as vr3 with mut = over(vv.len);
    vr3.pos = 3 * 5;   // five in: thirty left
    wire.skip(&vr3, "v", 1);
    check("thirty deep is fine", vr3.err == 0 && vr3.pos == vv.len);
    // An array whose length cuts its last element in half.
    mem.memzero(cast(*u8, &buf), 32);
    buf[0] = 6;
    let is wire.Reader as cut with mut = over(16);
    wire.skip(&cut, "au", 2);
    check("an element past the array's end", cut.err == 1);
    let is wire.Writer as av with mut = wire.writer(cast(*u8, &buf), 512);
    let is i64 as avat = wire.put_array(&av, 1);
    wire.put_variant(&av, "y");
    wire.put_byte(&av, 3);
    wire.put_variant(&av, "y");
    wire.put_byte(&av, 4);
    wire.put_array_end(&av, avat, 1);
    let is wire.Reader as avr with mut = over(av.len);
    check("an array of variants", wire.skip_all(&avr, "av", 2) == 1 && av.len == 12 && b(0) == 8);

    // --- Big-endian ---
    mem.memzero(cast(*u8, &buf), 32);
    buf[0] = 1; buf[1] = 2; buf[2] = 3; buf[3] = 4;
    buf[4] = 1; buf[5] = 2;
    buf[8] = 1; buf[9] = 2; buf[10] = 3; buf[11] = 4; buf[12] = 5; buf[13] = 6; buf[14] = 7; buf[15] = 8;
    buf[16] = 0; buf[17] = 0; buf[18] = 0; buf[19] = 2; buf[20] = 104; buf[21] = 105; buf[22] = 0;
    let is wire.Reader as be with mut = wire.reader(cast(*u8, &buf), 23, 1);
    check("big-endian u32", wire.get_u32(&be) == 0x01020304);
    check("big-endian u16", wire.get_u16(&be) == 0x0102);
    check("big-endian u64", wire.get_u64(&be) == 0x0102030405060708);
    s = wire.get_string(&be, &n);
    check("big-endian string length", be.err == 0 && n == 2 && s[0] == 104);
    let is wire.Reader as neg with mut = wire.reader(cast(*u8, &buf), 4, 0);
    buf[0] = 255; buf[1] = 255; buf[2] = 255; buf[3] = 255;
    check("int32 sign", wire.get_i32(&neg) == 0 - 1);

    // --- What a Reader refuses ---
    mem.memzero(cast(*u8, &buf), 64);
    let is wire.Reader as t1 with mut = over(3);
    wire.get_u32(&t1);
    check("truncated", t1.err == 1);
    check("after an error, nothing", wire.get_byte(&t1) == 0 && t1.err == 1);
    buf[0] = 100;
    let is wire.Reader as t2 with mut = over(16);
    wire.get_string(&t2, &n);
    check("a string past the end", t2.err == 1);
    buf[0] = 2; buf[4] = 104; buf[5] = 105; buf[6] = 33;
    let is wire.Reader as t3 with mut = over(16);
    wire.get_string(&t3, &n);
    check("a string without its zero", t3.err == 1);
    buf[5] = 0; buf[6] = 0;
    let is wire.Reader as t4 with mut = over(16);
    wire.get_string(&t4, &n);
    check("a string holding a zero", t4.err == 1);
    mem.memzero(cast(*u8, &buf), 64);
    buf[0] = 1; buf[1] = 9;
    let is wire.Reader as t5 with mut = over(16);
    wire.get_byte(&t5);
    wire.get_u32(&t5);
    check("padding that is not zero", t5.err == 1);
    mem.memzero(cast(*u8, &buf), 64);
    buf[0] = 2;
    let is wire.Reader as t6 with mut = over(16);
    wire.get_bool(&t6);
    check("a boolean that is 2", t6.err == 1);
    buf[0] = 60;
    let is wire.Reader as t7 with mut = over(16);
    wire.get_array(&t7, 4);
    check("an array past the end", t7.err == 1);
    buf[0] = 2; buf[1] = 115; buf[2] = 115; buf[3] = 0;
    let is wire.Reader as t8 with mut = over(16);
    wire.get_variant(&t8, &n);
    check("a variant of two types", t8.err == 1);
    buf[0] = 1; buf[1] = 122; buf[2] = 0;
    let is wire.Reader as t9 with mut = over(16);
    wire.get_signature(&t9, &n);
    check("a signature of no type", t9.err == 1);
    mem.memzero(cast(*u8, &buf), 64);
    buf[0] = 1;
    let is wire.Reader as t10 with mut = over(16);
    wire.get_fd(&t10);
    check("a descriptor that did not come", t10.err == 1);
    mem.memzero(cast(*u8, &buf), 64);
    buf[0] = 2; buf[4] = 47; buf[5] = 47; buf[6] = 0;
    let is wire.Reader as t12 with mut = over(16);
    wire.get_path(&t12, &n);
    check("a path that is not one", t12.err == 1);
    let is wire.Reader as t13 with mut = over(16);
    wire.skip(&t13, "ss", 2);
    check("skip takes one type", t13.err == 1);

    // --- What a Writer refuses ---
    let is [8]u8 as small;
    let is wire.Writer as full with mut = wire.writer(cast(*u8, &small), 8);
    wire.put_u64(&full, 1);
    wire.put_byte(&full, 1);
    check("out of room", full.err == 1 && full.len == 8);
    let is wire.Writer as bad with mut = wire.writer(cast(*u8, &buf), 512);
    wire.put_string_n(&bad, "a\0b", 3);
    check("a string holding a zero", bad.err == 1);
    wire.reset(&bad);
    wire.put_variant(&bad, "ss");
    check("a variant of two types", bad.err == 1);
    wire.reset(&bad);
    wire.put_path(&bad, "/a/");
    check("a path that is not one", bad.err == 1);
    wire.reset(&bad);
    wire.put_signature(&bad, "a{vs}");
    check("a signature that is not one", bad.err == 1);
    wire.reset(&bad);
    let is i64 as f with mut = 0;
    while (f < 17) { wire.put_fd(&bad, 3); f = f + 1; }
    check("too many descriptors", bad.err == 1 && bad.nfds == 16);
    wire.reset(&bad);
    wire.put_fd(&bad, 0 - 1);
    check("no such descriptor", bad.err == 1);
    wire.reset(&bad);
    check("reset clears the error", bad.err == 0 && bad.len == 0 && bad.nfds == 0);

    if (fails > 0) {
        io.printf("dbus wire: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("dbus wire: all checks passed\n");
    return 0;
}
