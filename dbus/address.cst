// dbus/address.cst — where a bus is: unix:path=, unix:abstract=.
//
// An address is one or more entries separated by ';', each a transport and
// key=value pairs: "unix:path=/run/user/1000/bus" or
// "unix:abstract=/tmp/dbus-x,guid=...". A client tries them in order. Values
// escape any byte outside [-0-9A-Za-z_/.\*] as %XX. Only the unix transport
// with path or abstract is something a client connects to; tcp is not spoken
// here, and runtime=, dir= and tmpdir= are for servers listening.
use "std/env.cst" as env;
use "std/mem.cst" as mem;

let is i32 as PATH     with imut = 1;
let is i32 as ABSTRACT with imut = 2;

struct Address {
    kind  as i32;     // PATH or ABSTRACT; 0 when the entry is not one to connect to
    _pad0 as i32;
    name  as [108]u8; // the path or abstract name, unescaped, zero-terminated
    len   as i64;
}

fn _at(s as *u8, i as i64) as u8 { return *cast(*u8, cast(i64, s) + i); }

fn _hex(c as u8) as i64 {
    if (c >= 48 && c <= 57) { return cast(i64, c) - 48; }
    if (c >= 97 && c <= 102) { return cast(i64, c) - 87; }
    if (c >= 65 && c <= 70) { return cast(i64, c) - 55; }
    return 0 - 1;
}

fn _starts(s as *u8, n as i64, i as i64, p as *u8) as i32 {
    let is i64 as k with mut = 0;
    while (_at(p, k) != 0) {
        if (i + k >= n || _at(s, i + k) != _at(p, k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

// The entries in s, n bytes of it.
fn count(s as *u8, n as i64) as i64 {
    if (n == 0) { return 0; }
    let is i64 as c with mut = 1;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (_at(s, i) == 59) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// Entry index of s into out. 1 when it is one to connect to, 0 otherwise —
// another transport, a server's key, or a value that does not decode.
fn entry(s as *u8, n as i64, index as i64, out as *Address) as i32 {
    out.kind = 0;
    out._pad0 = 0;
    out.len = 0;
    out.name[0] = 0;
    let is i64 as i with mut = 0;
    let is i64 as k with mut = 0;
    // Past the last entry this stops at the end, where "unix:" is not.
    while (k < index && i < n) {
        if (_at(s, i) == 59) { k = k + 1; }
        i = i + 1;
    }
    let is i64 as end with mut = i;
    while (end < n && _at(s, end) != 59) { end = end + 1; }
    if (_starts(s, end, i, "unix:") == 0) { return 0; }
    i = i + 5;
    // key=value,key=value
    while (i < end) {
        let is i64 as key = i;
        while (i < end && _at(s, i) != 61) { i = i + 1; }
        if (i >= end) { return 0; }
        let is i32 as kind with mut = 0;
        if (i - key == 4 && _starts(s, end, key, "path") == 1) { kind = PATH; }
        if (i - key == 8 && _starts(s, end, key, "abstract") == 1) { kind = ABSTRACT; }
        i = i + 1;
        let is i64 as len with mut = 0;
        while (i < end && _at(s, i) != 44) {
            let is u8 as c = _at(s, i);
            let is i64 as v with mut = cast(i64, c);
            if (c == 37) {
                if (i + 2 >= end) { return 0; }
                let is i64 as hi = _hex(_at(s, i + 1));
                let is i64 as lo = _hex(_at(s, i + 2));
                if (hi < 0 || lo < 0) { return 0; }
                v = hi * 16 + lo;
                i = i + 2;
            }
            if (kind != 0) {
                if (len >= 107) { return 0; }
                out.name[len] = cast(u8, v);
                len = len + 1;
            }
            i = i + 1;
        }
        if (kind != 0) {
            if (out.kind != 0) { return 0; }   // path and abstract both
            out.kind = kind;
            out.len = len;
            out.name[len] = 0;
        }
        if (i < end) { i = i + 1; }   // the comma
    }
    if (out.kind == 0 || out.len == 0) {
        out.kind = 0;
        return 0;
    }
    return 1;
}

// The session bus's address: DBUS_SESSION_BUS_ADDRESS, or else the socket
// systemd and dbus-broker put in $XDG_RUNTIME_DIR. Copied into buf (cap
// bytes); its length, or 0 when there is none. The environment is std/env's,
// so the program must have called env.init.
fn session(buf as *u8, cap as i64) as i64 {
    return session_from(env.getenv("DBUS_SESSION_BUS_ADDRESS"), env.getenv("XDG_RUNTIME_DIR"), buf, cap);
}

// The same from the two variables' values, either null.
fn session_from(v as *u8, run as *u8, buf as *u8, cap as i64) as i64 {
    if (cast(i64, v) != 0) {
        let is i64 as n with mut = 0;
        while (_at(v, n) != 0) { n = n + 1; }
        if (n == 0 || n >= cap) { return 0; }
        mem.memcpy(buf, v, n + 1);
        return n;
    }
    if (cast(i64, run) == 0) { return 0; }
    let is i64 as rn with mut = 0;
    while (_at(run, rn) != 0) { rn = rn + 1; }
    if (rn == 0 || 10 + rn + 4 >= cap) { return 0; }
    mem.memcpy(buf, "unix:path=", 10);
    mem.memcpy(cast(*u8, cast(i64, buf) + 10), run, rn);
    mem.memcpy(cast(*u8, cast(i64, buf) + 10 + rn), "/bus", 5);
    return 10 + rn + 4;
}
