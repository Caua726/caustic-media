// ui/strings_test.cst — the toolkit's own words: every one in every
// language, alike in what they hold (mnemonics, places for what is filled
// in), chosen by the tree's language, filled in.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "tree.cst" as tree;
use "strings.cst" as strings;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn _len(s as *u8) as i64 {
    if (cast(i64, s) == 0) { return 0; }
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    if (n != _len(b)) { return 0; }
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

// How many times byte c is in s, n bytes; and how many "%" followed by d.
fn count(s as *u8, n as i64, c as u8) as i64 {
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (s[i] == c) { k = k + 1; }
        i = i + 1;
    }
    return k;
}

fn places(s as *u8, n as i64, d as u8) as i64 {
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    while (i + 1 < n) {
        if (s[i] == 37 && s[i + 1] == d) { k = k + 1; }
        i = i + 1;
    }
    return k;
}

// The letter after the underscore, lowered; 0 for none.
fn mnemonic(s as *u8, n as i64) as u8 {
    let is i64 as i with mut = 0;
    while (i + 1 < n) {
        if (s[i] == 95) {
            let is u8 as c = s[i + 1];
            if (c >= 65 && c <= 90) { return cast(u8, c + 32); }
            return c;
        }
        i = i + 1;
    }
    return 0;
}

fn text_is(lang as i32, id as i64, want as *u8) as i32 {
    let is i64 as n with mut = 0;
    let is *u8 as s = strings.text(lang, id, &n);
    return same(s, n, want);
}

// The mnemonics of a group of ids, all different, in a language.
fn apart(lang as i32, ids as *i64, k as i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < k) {
        let is i64 as n with mut = 0;
        let is *u8 as s = strings.text(lang, ids[i], &n);
        let is u8 as m = mnemonic(s, n);
        let is i64 as j with mut = i + 1;
        while (j < k) {
            let is i64 as n2 with mut = 0;
            let is *u8 as s2 = strings.text(lang, ids[j], &n2);
            if (m != 0 && m == mnemonic(s2, n2)) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

fn main() as i32 {
    // --- Every word, in every language, alike ---
    let is i32 as all with mut = 1;
    let is i32 as alike with mut = 1;
    let is i64 as id with mut = 1;
    while (id <= strings.LAST) {
        let is i64 as en with mut = 0;
        let is i64 as pt with mut = 0;
        let is *u8 as e = strings.text(strings.EN, id, &en);
        let is *u8 as p = strings.text(strings.PT_BR, id, &pt);
        if (en == 0 || pt == 0) {
            io.printf("  missing: %d\n", id);
            all = 0;
        }
        if (count(e, en, 95) != count(p, pt, 95) || places(e, en, 49) != places(p, pt, 49) || places(e, en, 50) != places(p, pt, 50)) {
            io.printf("  unlike: %d\n", id);
            alike = 0;
        }
        id = id + 1;
    }
    check("every word in both languages", all == 1);
    check("each holding what the other does: a mnemonic, places to fill", alike == 1);
    let is i64 as none with mut = 0;
    check("no such word: nothing", strings.text(strings.EN, 0, &none) != cast(*u8, 0) && none == 0 &&
          strings.text(strings.EN, strings.LAST + 1, &none) != cast(*u8, 0) && none == 0);
    check("some, as they are", text_is(strings.EN, strings.CANCEL, "_Cancel") == 1 && text_is(strings.PT_BR, strings.CANCEL, "_Cancelar") == 1 &&
          text_is(strings.PT_BR, strings.YES, "_Sim") == 1 && text_is(strings.PT_BR, strings.NO, "_Não") == 1);
    check("a language with none of its own: English", text_is(7, strings.CANCEL, "_Cancel") == 1);

    // --- A menu's mnemonics apart ---
    let is [7]i64 as edit;
    edit[0] = strings.UNDO;
    edit[1] = strings.REDO;
    edit[2] = strings.CUT;
    edit[3] = strings.COPY;
    edit[4] = strings.PASTE;
    edit[5] = strings.DELETE;
    edit[6] = strings.SELECT_ALL;
    check("the text menu's mnemonics apart", apart(strings.EN, cast(*i64, &edit), 7) == 1 &&
          apart(strings.PT_BR, cast(*i64, &edit), 7) == 1);
    let is [3]i64 as steps;
    steps[0] = strings.BACK;
    steps[1] = strings.NEXT;
    steps[2] = strings.CANCEL;
    check("an assistant's", apart(strings.EN, cast(*i64, &steps), 3) == 1 && apart(strings.PT_BR, cast(*i64, &steps), 3) == 1);
    let is [3]i64 as answers;
    answers[0] = strings.YES;
    answers[1] = strings.NO;
    answers[2] = strings.CANCEL;
    check("a question's", apart(strings.EN, cast(*i64, &answers), 3) == 1 && apart(strings.PT_BR, cast(*i64, &answers), 3) == 1);

    // --- A language from a tag ---
    check("Portuguese, any of it: Brazil's", strings.language_of("pt-BR", 5) == strings.PT_BR &&
          strings.language_of("pt", 2) == strings.PT_BR && strings.language_of("pt-PT", 5) == strings.PT_BR);
    check("the rest: English", strings.language_of("en-US", 5) == strings.EN && strings.language_of("", 0) == strings.EN &&
          strings.language_of("ptx", 3) == strings.EN && strings.language_of("fr-FR", 5) == strings.EN &&
          strings.language_of("p", 1) == strings.EN);

    // --- Numbers ---
    check("a decimal mark each", strings.decimal(strings.EN) == 46 && strings.decimal(strings.PT_BR) == 44 &&
          strings.decimal(9) == 46);

    // --- Filled in ---
    let is [64]u8 as out;
    let is i64 as n with mut = strings.fill(strings.EN, strings.ABOUT, "Notes", 5, "", 0, cast(*u8, &out), 64);
    check("one place", same(cast(*u8, &out), n, "About Notes") == 1);
    n = strings.fill(strings.PT_BR, strings.ABOUT, "Notes", 5, "", 0, cast(*u8, &out), 64);
    check("in its language's order", same(cast(*u8, &out), n, "Sobre Notes") == 1);
    n = strings.fill(strings.PT_BR, strings.LIGHT_COLOR, "Azul", 4, "", 0, cast(*u8, &out), 64);
    check("after what is filled in, where the language puts it", same(cast(*u8, &out), n, "Azul claro") == 1);
    n = strings.fill(strings.EN, strings.LIGHT_COLOR, "Blue", 4, "", 0, cast(*u8, &out), 64);
    check("before it in another", same(cast(*u8, &out), n, "Light Blue") == 1);
    n = strings.fill(strings.PT_BR, strings.SATURATION_VALUE_OF, "50%", 3, "20%", 3, cast(*u8, &out), 64);
    check("two places", same(cast(*u8, &out), n, "Saturação 50%, valor 20%") == 1);
    n = strings.fill(strings.EN, strings.ABOUT, "A very long name indeed", 23, "", 0, cast(*u8, &out), 12);
    check("held to the room there is, whole characters", n <= 11 && same(cast(*u8, &out), n, "About A ver") == 1);
    n = strings.fill(strings.PT_BR, strings.ABOUT, "Ãé", 4, "", 0, cast(*u8, &out), 9);
    check("never part of a character", same(cast(*u8, &out), n, "Sobre Ã") == 1);
    n = strings.fill(strings.PT_BR, strings.SATURATION_VALUE_OF, "1", 1, "2", 1, cast(*u8, &out), 10);
    check("nor of the word's", same(cast(*u8, &out), n, "Saturaç") == 1);
    n = strings.fill(strings.EN, strings.ABOUT, "", 0, "", 0, cast(*u8, &out), 1);
    check("room for the NUL alone", n == 0 && out[0] == 0);
    n = strings.fill(strings.PT_BR, strings.SATURATION_VALUE_OF, "", 0, "", 0, cast(*u8, &out), 64);
    check("places filled with nothing", same(cast(*u8, &out), n, "Saturação , valor ") == 1);
    n = strings.fill(strings.PT_BR, strings.SATURATION_VALUE_OF, "50%", 3, "20%", 3, cast(*u8, &out), 15);
    check("what is filled in, cut too", same(cast(*u8, &out), n, "Saturação 50") == 1);

    check("cut where a character starts", strings.fits("aé", 3, 2) == 1 && strings.fits("aé", 3, 3) == 3 &&
          strings.fits("aé", 3, 9) == 3 && strings.fits("ab", 2, 0) == 0 && strings.fits("ab", 2, -1) == 0 &&
          strings.fits("ab", 0 - 3, 5) == 0 && strings.fits("aé", 2, 2) == 2);
    let is [4]u8 as conts;
    conts[0] = cast(u8, 128);
    conts[1] = cast(u8, 128);
    conts[2] = cast(u8, 128);
    conts[3] = cast(u8, 0);
    check("no character starting: nothing", strings.fits(cast(*u8, &conts), 3, 2) == 0);

    // --- The tree's language ---
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    check("English at first", tree.language(&t) == strings.EN);
    let is i64 as k with mut = 0;
    let is *u8 as w with mut = strings.of(&t, strings.CANCEL, &k);
    check("its words in it", same(w, k, "_Cancel") == 1);
    tree.set_language(&t, strings.PT_BR);
    w = strings.of(&t, strings.CANCEL, &k);
    check("told another: its words in that", tree.language(&t) == strings.PT_BR && same(w, k, "_Cancelar") == 1);
    tree.close(&t);

    if (fails == 0) {
        io.printf("ui strings: all checks passed\n");
        return 0;
    }
    io.printf("ui strings: %d failures\n", fails);
    return 1;
}
