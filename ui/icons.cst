// ui/icons.cst — the toolkit's own icons, drawn from paths.
//
// What the toolkit shows of its own — a message box's sign, a chooser's
// places, a window's buttons, arrows, a check, a search — as symbolic icons:
// one colour, the shape's, so that each takes the colour of what it is drawn
// in, as text does. Each is a path on a 16 by 16 grid, y down, filled
// even-odd so that an outline drawn inside another is a hole; drawn at any
// size by the text service's rasterizer (text.fill_path), crisp at every
// scale, and turned into pixels for a window's icon (rasterize).
//
// The paths are written in a small language of their own: M x y, L x y,
// Q cx cy x y, C c1x c1y c2x c2y x y, Z — absolute, as SVG's upper-case
// commands — and O cx cy r for a whole circle. Ours, drawn for this; a
// desktop's icon theme (freedesktop's, PNG) can stand in for them where a
// program asks for its names (icon_theme.cst).
use "../text/outline/path.cst" as path;
use "../text/raster/raster.cst" as raster;
use "../render/draw2d.cst" as draw2d;
use "../math/math.cst" as math;
use "text.cst" as text;

let is i32 as DIALOG_INFO     with imut = 1;
let is i32 as DIALOG_WARNING  with imut = 2;
let is i32 as DIALOG_ERROR    with imut = 3;
let is i32 as DIALOG_QUESTION with imut = 4;
let is i32 as GO_UP           with imut = 5;
let is i32 as PAN_UP          with imut = 6;
let is i32 as PAN_DOWN        with imut = 7;
let is i32 as PAN_START       with imut = 8;   // left, in a language written left to right
let is i32 as PAN_END         with imut = 9;
let is i32 as WINDOW_CLOSE    with imut = 10;
let is i32 as WINDOW_MINIMIZE with imut = 11;
let is i32 as WINDOW_MAXIMIZE with imut = 12;
let is i32 as WINDOW_RESTORE  with imut = 13;
let is i32 as CHECK           with imut = 14;
let is i32 as SEARCH          with imut = 15;
let is i32 as OPEN_MENU       with imut = 16;
let is i32 as FOLDER          with imut = 17;
let is i32 as DOCUMENT        with imut = 18;
let is i32 as USER_HOME       with imut = 19;
let is i32 as USER_DESKTOP    with imut = 20;
let is i32 as DOWNLOAD        with imut = 21;
let is i32 as COMPUTER        with imut = 22;
let is i32 as LAST            with imut = 22;

// The grid every icon is drawn on.
let is f64 as GRID with imut = 16.0;

// Icon id's path, in the language above; "" for no such icon.
fn source(id as i32) as *u8 {
    if (id == DIALOG_INFO) { return "O 8 8 7 O 8 4.5 1.25 M7 6.5 L9 6.5 L9 12.5 L7 12.5 Z"; }
    if (id == DIALOG_WARNING) { return "M8 1 L15.5 14.5 L0.5 14.5 Z M7 5.5 L9 5.5 L8.6 10 L7.4 10 Z O 8 12.2 1"; }
    if (id == DIALOG_ERROR) {
        return "O 8 8 7 M4.8 6.2 L6.2 4.8 L8 6.6 L9.8 4.8 L11.2 6.2 L9.4 8 L11.2 9.8 L9.8 11.2 L8 9.4 L6.2 11.2 L4.8 9.8 L6.6 8 Z";
    }
    if (id == DIALOG_QUESTION) {
        return "O 8 8 7 M5.5 6 C5.5 4.3 6.6 3.5 8 3.5 C9.4 3.5 10.5 4.4 10.5 5.8 C10.5 7.1 9.6 7.6 9 8 C8.6 8.3 8.75 8.7 8.75 9.5 L7.25 9.5 C7.25 8.3 7.4 7.6 8.2 7 C8.8 6.6 9 6.3 9 5.8 C9 5.3 8.6 5 8 5 C7.4 5 7 5.4 7 6 Z O 8 11.75 1";
    }
    if (id == GO_UP) { return "M8 2 L13.5 7.5 L12.1 8.9 L9 5.8 L9 14 L7 14 L7 5.8 L3.9 8.9 L2.5 7.5 Z"; }
    if (id == PAN_UP) { return "M3.5 10.5 L12.5 10.5 L8 5.5 Z"; }
    if (id == PAN_DOWN) { return "M3.5 5.5 L12.5 5.5 L8 10.5 Z"; }
    if (id == PAN_START) { return "M10.5 3.5 L10.5 12.5 L5.5 8 Z"; }
    if (id == PAN_END) { return "M5.5 3.5 L5.5 12.5 L10.5 8 Z"; }
    if (id == WINDOW_CLOSE) {
        return "M3.5 4.9 L4.9 3.5 L8 6.6 L11.1 3.5 L12.5 4.9 L9.4 8 L12.5 11.1 L11.1 12.5 L8 9.4 L4.9 12.5 L3.5 11.1 L6.6 8 Z";
    }
    if (id == WINDOW_MINIMIZE) { return "M4 11 L12 11 L12 12.5 L4 12.5 Z"; }
    if (id == WINDOW_MAXIMIZE) { return "M3.5 3.5 L12.5 3.5 L12.5 12.5 L3.5 12.5 Z M5 5 L5 11 L11 11 L11 5 Z"; }
    if (id == WINDOW_RESTORE) {
        return "M5.5 2.5 L13.5 2.5 L13.5 10.5 L12 10.5 L12 4 L5.5 4 Z M2.5 5.5 L10.5 5.5 L10.5 13.5 L2.5 13.5 Z M4 7 L4 12 L9 12 L9 7 Z";
    }
    if (id == CHECK) { return "M2.5 8.5 L4 7 L6.5 9.5 L12 4 L13.5 5.5 L6.5 12.5 Z"; }
    if (id == SEARCH) { return "O 6.5 6.5 4.5 O 6.5 6.5 3 M9.6 10.7 L10.7 9.6 L14.5 13.4 L13.4 14.5 Z"; }
    if (id == OPEN_MENU) {
        return "M2.5 3.5 L13.5 3.5 L13.5 5 L2.5 5 Z M2.5 7.25 L13.5 7.25 L13.5 8.75 L2.5 8.75 Z M2.5 11 L13.5 11 L13.5 12.5 L2.5 12.5 Z";
    }
    if (id == FOLDER) { return "M1.5 3 L6 3 L7.5 4.5 L14.5 4.5 L14.5 13 L1.5 13 Z"; }
    if (id == DOCUMENT) { return "M3 1.5 L10 1.5 L13 4.5 L13 14.5 L3 14.5 Z M4.5 3 L4.5 13 L11.5 13 L11.5 5.5 L8.5 5.5 L8.5 3 Z"; }
    if (id == USER_HOME) {
        return "M8 1.5 L15 8 L13 8 L13 14.5 L9.5 14.5 L9.5 10 L6.5 10 L6.5 14.5 L3 14.5 L3 8 L1 8 Z";
    }
    if (id == USER_DESKTOP) {
        return "M1.5 2.5 L14.5 2.5 L14.5 11.5 L9 11.5 L9 13 L11 13 L11 14.5 L5 14.5 L5 13 L7 13 L7 11.5 L1.5 11.5 Z M3 4 L3 10 L13 10 L13 4 Z";
    }
    if (id == DOWNLOAD) {
        return "M7 1.5 L9 1.5 L9 7.5 L11.6 4.9 L13 6.3 L8 11.3 L3 6.3 L4.4 4.9 L7 7.5 Z M2 12.5 L14 12.5 L14 14.5 L2 14.5 Z";
    }
    if (id == COMPUTER) {
        return "M1.5 4 L14.5 4 L14.5 12 L1.5 12 Z M3 5.5 L3 10.5 L13 10.5 L13 5.5 Z M10 8.25 L12 8.25 L12 9.25 L10 9.25 Z";
    }
    return "";
}

// --- The language ---

fn _space(c as u8) as i32 { return cast(i32, c == 32 || c == 44 || c == 9 || c == 10); }

// The number at s[*i], *i past it.
fn _num(s as *u8, i as *i64) as f64 {
    let is i64 as k with mut = *i;
    while (_space(s[k]) == 1) { k = k + 1; }
    let is f64 as sign with mut = 1.0;
    if (s[k] == 45) {
        sign = 0.0 - 1.0;
        k = k + 1;
    }
    let is f64 as v with mut = 0.0;
    while (s[k] >= 48 && s[k] <= 57) {
        v = v * 10.0 + cast(f64, s[k] - 48);
        k = k + 1;
    }
    if (s[k] == 46) {
        k = k + 1;
        let is f64 as place with mut = 0.1;
        while (s[k] >= 48 && s[k] <= 57) {
            v = v + cast(f64, s[k] - 48) * place;
            place = place / 10.0;
            k = k + 1;
        }
    }
    *i = k;
    return sign * v;
}

// A circle at cx, cy of radius r, as four cubic arcs.
fn _circle(p as *path.Path, cx as f64, cy as f64, r as f64) as void {
    let is f64 as k = r * 0.5522847498;
    path.move_to(p, cx + r, cy);
    path.cubic_to(p, cx + r, cy + k, cx + k, cy + r, cx, cy + r);
    path.cubic_to(p, cx - k, cy + r, cx - r, cy + k, cx - r, cy);
    path.cubic_to(p, cx - r, cy - k, cx - k, cy - r, cx, cy - r);
    path.cubic_to(p, cx + k, cy - r, cx + r, cy - k, cx + r, cy);
    path.close_path(p);
}

// Icon id into p, cleared first, on the 16 grid: 1, or 0 for no such icon.
fn shape(id as i32, p as *path.Path) as i32 { return parse(source(id), p); }

// A path in the language above into p, cleared first: 1, or 0 for nothing.
fn parse(s as *u8, p as *path.Path) as i32 {
    path.clear(p);
    if (s[0] == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (s[i] != 0) {
        let is u8 as c = s[i];
        if (_space(c) == 1) {
            i = i + 1;
        } else {
            i = i + 1;
            if (c == 77) {
                let is f64 as x = _num(s, &i);
                let is f64 as y = _num(s, &i);
                path.move_to(p, x, y);
            } else if (c == 76) {
                let is f64 as x = _num(s, &i);
                let is f64 as y = _num(s, &i);
                path.line_to(p, x, y);
            } else if (c == 81) {
                let is f64 as qx = _num(s, &i);
                let is f64 as qy = _num(s, &i);
                let is f64 as x = _num(s, &i);
                let is f64 as y = _num(s, &i);
                path.quad_to(p, qx, qy, x, y);
            } else if (c == 67) {
                let is f64 as ax = _num(s, &i);
                let is f64 as ay = _num(s, &i);
                let is f64 as bx = _num(s, &i);
                let is f64 as by = _num(s, &i);
                let is f64 as x = _num(s, &i);
                let is f64 as y = _num(s, &i);
                path.cubic_to(p, ax, ay, bx, by, x, y);
            } else if (c == 79) {
                let is f64 as cx = _num(s, &i);
                let is f64 as cy = _num(s, &i);
                let is f64 as r = _num(s, &i);
                _circle(p, cx, cy, r);
            } else if (c == 90) {
                path.close_path(p);
            }
        }
    }
    return 1;
}

// --- Drawn ---

let is path.Path as _p with mut;
let is i32 as _ready with mut = 0;

fn _path() as *path.Path {
    if (_ready == 0) {
        _p = path.open(512);
        _ready = 1;
    }
    return &_p;
}

// Icon id drawn on c at x, y (logical), size by size, in col, through the
// text service svc — the one the window's text is drawn with. 1, or 0 for no
// such icon, or no room this frame.
fn draw(svc as *text.Service, c as *draw2d.Canvas, id as i32, x as f64, y as f64, size as f64, col as math.color.Color) as i32 {
    let is *path.Path as p = _path();
    if (shape(id, p) == 0) { return 0; }
    let is f64 as s = size / GRID;
    let is raster.flatten.Transform as t = raster.transform(s, 0.0, 0.0, s, x, y);
    return text.fill_path(svc, c, p, &t, raster.EVENODD, col);
}

// Icon id as pixels, size by size: how much of each pixel it covers, 0 to
// 255, a row of size bytes after another, into out (size * size bytes). 1,
// or 0 for no such icon or a size past 256.
fn coverage(id as i32, size as i64, out as *u8) as i32 {
    if (size <= 0 || size > 256) { return 0; }
    let is *path.Path as p = _path();
    if (shape(id, p) == 0) { return 0; }
    let is f64 as s = cast(f64, size) / GRID;
    let is raster.flatten.Transform as t = raster.transform(s, 0.0, 0.0, s, 0.0, 0.0);
    let is raster.Raster as r with mut = raster.open(size, size);
    let is raster.Box as b;
    b.left = 0;
    b.top = 0;
    b.w = size;
    b.h = size;
    // Every pixel of the box written, what it does not cover 0.
    let is i32 as drawn = raster.draw(&r, p, &t, &b, raster.EVENODD, out, size);
    raster.close(&r);
    return drawn;
}

// Icon id as a window's icon, size by size, in col: 0xAARRGGBB a pixel, as
// window.device.set_icon takes it, into out (size * size of them).
fn rasterize(id as i32, size as i64, col as math.color.Color, out as *u32) as i32 {
    let is *u8 as cov = cast(*u8, out);
    if (coverage(id, size, cov) == 0) { return 0; }
    // From the last, so the bytes read are never ones already written.
    let is i64 as rr = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as gg = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as bb = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as k with mut = size * size - 1;
    while (k >= 0) {
        let is i64 as a = cast(i64, cov[k]) * cast(i64, col.a * 255.0 + 0.5) / 255;
        out[k] = cast(u32, (a << 24) | (rr << 16) | (gg << 8) | bb);
        k = k - 1;
    }
    return 1;
}
