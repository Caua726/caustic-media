// ui/stack.cst — one page at a time, and children layered on each other.
//
// A stack shows one of its children — tabs, the steps of a wizard, the panes
// of a settings window — and is always as large as its largest page, shown or
// not. Switching pages therefore never resizes the stack, so nothing around it
// moves when the user clicks a tab.
//
// The pages that are not current are hidden through the tree, so painting and
// hit-testing skip them like any hidden widget; measuring reaches them anyway
// through layout.measure_hidden.
//
// An overlay lays every child over the same area, each aligned by its own
// alignment, later children above earlier ones: a badge on an icon, a spinner
// over content. It is the rule the tree's root follows.
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;

struct Data {
    current as i64;
}

let is tree.Kind as _stack with mut;
let is tree.Kind as _overlay with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _stack = widget.kind("stack", sizeof(Data));
    _stack.measure = fn_ptr(_stack_measure);
    _stack.arrange = fn_ptr(_stack_arrange);
    _overlay = widget.kind("overlay", 0);
    _overlay.measure = fn_ptr(_overlay_measure);
    _overlay.arrange = fn_ptr(_overlay_arrange);
    _ready = 1;
}

fn create(t as *tree.Tree, parent as i64) as i64 {
    _init();
    return tree.create(t, &_stack, parent);
}

fn create_overlay(t as *tree.Tree, parent as i64) as i64 {
    _init();
    return tree.create(t, &_overlay, parent);
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (cast(i64, tree.kind(t, w)) != cast(i64, &_stack)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

// Shows page and hides every other page. A widget that is not a child of the
// stack is ignored, and the current page stays.
fn set_current(t as *tree.Tree, s as i64, page as i64) as void {
    let is *Data as d = _data(t, s);
    if (cast(i64, d) == 0) { return; }
    if (tree.parent(t, page) != s) { return; }
    d.current = page;
    let is i64 as ch with mut = tree.first_child(t, s);
    while (ch != 0) {
        if (ch == page) { tree.set_visible(t, ch, 1); } else { tree.set_visible(t, ch, 0); }
        ch = tree.next_sibling(t, ch);
    }
}

// The current page, or 0 if none was set or it has been destroyed.
fn current(t as *tree.Tree, s as i64) as i64 {
    let is *Data as d = _data(t, s);
    if (cast(i64, d) == 0) { return 0; }
    if (tree.is_valid(t, d.current) == 0) { return 0; }
    return d.current;
}

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _stack_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    geom.size_zero(out);
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        let is geom.Size as s;
        layout.measure_hidden(t, ch, c, &s);
        out.min_w = _max(out.min_w, s.min_w);
        out.min_h = _max(out.min_h, s.min_h);
        out.pref_w = _max(out.pref_w, s.pref_w);
        out.pref_h = _max(out.pref_h, s.pref_h);
        ch = tree.next_sibling(t, ch);
    }
}

// Places the current page over the whole stack. With no current page — none
// set yet, or destroyed — the first visible child stands in, so a stack built
// without calling set_current still shows something.
fn _stack_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is i64 as page with mut = current(t, w);
    if (page == 0) {
        let is i64 as ch with mut = tree.first_child(t, w);
        while (ch != 0 && page == 0) {
            if (tree.is_visible(t, ch) == 1) { page = ch; }
            ch = tree.next_sibling(t, ch);
        }
    }
    if (page == 0) { return; }
    let is math.rect.Rect as all = math.rect.rect(0.0, 0.0, r.w, r.h);
    layout.place(t, page, &all);
}

fn _overlay_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn _overlay_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}
