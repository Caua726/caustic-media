// ui/painter.cst — what a widget's paint entry is handed.
//
// The canvas to draw on, the theme to draw with, where the widget is and what
// part of it is being repainted, and the state it is in — so a button draws
// itself pressed without asking the router, and a widget outside the region
// being repainted can skip what would be clipped anyway.
//
// Coordinates are the window's, in logical pixels: p.rect is the widget's
// rectangle, already on the physical pixel grid. The canvas clips everything
// to p.clip, which is the widget's own rectangle cut down by its ancestors'
// and by the region being repainted — a widget never draws outside itself.
//
// A widget that pushes a clip of its own pops it before returning. One that
// shows keyboard focus its own way — a list's current row, a splitter's
// handle — sets focus_drawn, and the painter draws no ring around it.
use "../math/math.cst" as math;
use "../render/draw2d.cst" as draw2d;
use "style.cst" as style;

let is i64 as S_HOVER         with imut = 1;    // the pointer is over it, or over a descendant
// It holds the pointer with a button down. Wherever the pointer is: while it
// is held nothing enters or leaves, so a button that looks pressed only while
// the pointer is over it tracks that from its own POINTER_MOVE.
let is i64 as S_PRESSED       with imut = 2;
let is i64 as S_FOCUSED       with imut = 4;
let is i64 as S_FOCUS_VISIBLE with imut = 8;    // focused, and focus last moved by keyboard
// The focus is it or a descendant. Repainted as focus moves only for widgets
// that set tree.F_FOCUS_WITHIN_LOOK.
let is i64 as S_FOCUS_WITHIN  with imut = 16;
let is i64 as S_DISABLED      with imut = 32;   // it or an ancestor
let is i64 as S_BACKDROP      with imut = 64;   // its window is not the active one
let is i64 as S_MNEMONICS     with imut = 128;  // Alt is held: underline the mnemonics' letters

struct Painter {
    canvas      as *draw2d.Canvas;
    theme       as *style.Theme;
    rect        as math.rect.Rect;   // the widget, window coordinates
    clip        as math.rect.Rect;   // what of it is being repainted
    state       as i64;              // S_* bits
    time        as i64;              // the frame's, milliseconds
    focus_drawn as i32;              // set by an entry that drew its own focus
    rtl         as i32;              // the widget's direction is right to left
}

fn has(p as *Painter, bit as i64) as i32 {
    if ((p.state & bit) != 0) { return 1; }
    return 0;
}

// Whether r (window coordinates) reaches the part being repainted — for a
// widget drawing many things, most of which may lie outside it.
fn visible(p as *Painter, r as math.rect.Rect) as i32 {
    return math.rect.rect_overlaps(r, p.clip);
}
