// ui/visual_test.cst — a widget moved and faded without laying anything out:
// translation and opacity, as painting, damage and hit-testing see them.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "../gpu/gpu.cst" as gpu;
use "../render/draw2d.cst" as draw2d;
use "../render/shapes2d.cst" as shapes;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "router.cst" as router;
use "damage.cst" as damage;
use "painter.cst" as painter;
use "style.cst" as style;
use "paint.cst" as paint;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is i64 as W with imut = 64;
let is i64 as H with imut = 48;
let is [3072]i32 as px with mut;

let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;

let is i64 as BG   with imut = 0x101010;
let is i64 as RED  with imut = 0xFF0000;
let is i64 as BLUE with imut = 0x0000FF;

struct Box {
    w      as f64;
    h      as f64;
    color  as i64;
    paints as i64;
}

fn box_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Box as b = cast(*Box, data);
    out.min_w = b.w;
    out.min_h = b.h;
    out.pref_w = b.w;
    out.pref_h = b.h;
    out.max_w = b.w;
    out.max_h = b.h;
}

fn box_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

fn box_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Box as b = cast(*Box, data);
    b.paints = b.paints + 1;
    shapes.fill_rect(p.canvas, p.rect.x, p.rect.y, p.rect.w, p.rect.h, style.hex(b.color));
}

let is tree.Kind as box_kind with mut;

fn data(t as *tree.Tree, w as i64) as *Box { return cast(*Box, tree.data(t, w)); }

fn box_at(t as *tree.Tree, parent as i64, x as f64, y as f64, w as f64, h as f64, color as i64) as i64 {
    let is i64 as b = tree.create(t, &box_kind, parent);
    data(t, b).w = w;
    data(t, b).h = h;
    data(t, b).color = color;
    layout.set_align(t, b, layout.START, layout.START);
    layout.set_margin(t, b, x, y, 0.0, 0.0);
    return b;
}

let is style.Theme as theme with mut;
let is paint.Stats as stats with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas, o as *paint.Options) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    paint.frame(t, c, o, &stats);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn pixel(x as i64, y as i64) as i64 { return cast(i64, px[y * W + x]) & 4294967295; }

fn as_px(hex as i64) as i64 {
    return 4278190080 | ((hex & 255) << 16) | (((hex >> 8) & 255) << 8) | ((hex >> 16) & 255);
}

// Each channel of the pixel at x, y within 1 of r, g, b.
fn near(x as i64, y as i64, r as i64, g as i64, b as i64) as i32 {
    let is i64 as v = pixel(x, y);
    let is i64 as pr = v & 255;
    let is i64 as pg = (v >> 8) & 255;
    let is i64 as pb = (v >> 16) & 255;
    if (pr - r > 1 || r - pr > 1 || pg - g > 1 || g - pg > 1 || pb - b > 1 || b - pb > 1) {
        io.printf("  pixel %d,%d is %d %d %d, want %d %d %d\n", x, y, pr, pg, pb, r, g, b);
        return 0;
    }
    return 1;
}

fn covers(t as *tree.Tree, x as f64, y as f64) as i32 {
    let is i64 as n = tree.damage_count(t);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is math.rect.Rect as d = tree.damage_at(t, i);
        if (x >= d.x && x < d.x + d.w && y >= d.y && y < d.y + d.h) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() as i32 {
    box_kind = widget.kind("box", sizeof(Box));
    box_kind.measure = fn_ptr(box_measure);
    box_kind.arrange = fn_ptr(box_arrange);
    box_kind.paint = fn_ptr(box_paint);
    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as dl = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &dl);
    let is paint.Cache as cc = paint.cache_open(&dv, &dl);
    theme = style.light();
    theme.palette.window_bg = style.hex(BG);
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is paint.Options as o = paint.options(&theme);
    o.cache = &cc;

    let is i64 as card = box_at(&t, root, 4.0, 4.0, 12.0, 12.0, RED);
    let is i64 as dot = box_at(&t, card, 2.0, 2.0, 4.0, 4.0, BLUE);
    frame(&t, &c, &o);
    check("where it is laid out", pixel(10, 10) == as_px(RED) && pixel(7, 7) == as_px(BLUE));

    // --- Translation ---
    check("none at first", tree.translation_x(&t, card) == 0.0 && tree.translation_y(&t, card) == 0.0);
    tree.set_translation(&t, card, 20.0, 10.0);
    check("no layout for it", tree.needs_layout(&t, card) == 0 && tree.needs_layout(&t, root) == 0);
    check("a frame for it", tree.paint_wanted(&t) == 1);
    check("kept", tree.translation_x(&t, card) == 20.0 && tree.translation_y(&t, card) == 10.0);
    check("its rectangle in the window, moved", layout.window_rect(&t, card).x == 24.0 && layout.window_rect(&t, card).y == 14.0);
    check("its children with it", layout.window_rect(&t, dot).x == 26.0 && layout.window_rect(&t, dot).y == 16.0);
    check("its layout rectangle not", layout.rect(&t, card).x == 4.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    damage.collect(&t);
    check("both places repainted", covers(&t, 10.0, 10.0) == 1 && covers(&t, 30.0, 20.0) == 1);
    tree.damage_clear(&t);
    let is math.rect.Rect as all = math.rect.rect(0.0, 0.0, cast(f64, W), cast(f64, H));
    tree.damage_add(&t, &all);
    frame(&t, &c, &o);
    check("drawn where it went", pixel(30, 20) == as_px(RED) && pixel(27, 17) == as_px(BLUE));
    check("not where it was", pixel(10, 10) == as_px(BG));
    check("hit where it is drawn", router.hit(&t, 30.0, 20.0) == card && router.hit(&t, 27.0, 17.0) == dot);
    check("not where it was laid out", router.hit(&t, 10.0, 10.0) == root);
    tree.set_translation(&t, card, 20.0, 10.0);
    check("the same again is no change", tree.paint_wanted(&t) == 0);
    tree.set_translation(&t, card, 20.0, 12.0);
    check("one way only is a change", tree.paint_wanted(&t) == 1 && layout.window_rect(&t, card).y == 16.0);
    tree.set_translation(&t, card, 22.0, 12.0);
    check("the other way only too", tree.translation_x(&t, card) == 22.0);
    tree.set_translation(&t, card, 0.0, 0.0);
    frame(&t, &c, &o);
    check("back", pixel(10, 10) == as_px(RED) && pixel(30, 20) == as_px(BG));
    // On a layer of its own, the same.
    let is i64 as pop = box_at(&t, root, 40.0, 30.0, 8.0, 8.0, BLUE);
    tree.set_layer(&t, pop, 1);
    tree.set_translation(&t, pop, 0.0 - 30.0, 0.0 - 20.0);
    frame(&t, &c, &o);
    check("layered: drawn where it went", pixel(12, 12) == as_px(BLUE) && pixel(44, 34) == as_px(BG));
    check("layered: hit there", router.hit(&t, 12.0, 12.0) == pop && router.hit(&t, 44.0, 34.0) == root);
    tree.destroy(&t, pop);
    frame(&t, &c, &o);

    // --- Opacity ---
    check("opaque at first", tree.opacity(&t, card) == 1.0);
    tree.set_opacity(&t, card, 0.5);
    check("a frame for it", tree.paint_wanted(&t) == 1);
    check("no layout", tree.needs_layout(&t, card) == 0);
    frame(&t, &c, &o);
    // Half red over 0x101010: 255 * 0.5 + 16 * 0.5, and 16 * 0.5 for the rest.
    check("half seen", near(10, 10, 136, 8, 8) == 1);
    check("its children with it, as one", near(7, 7, 8, 8, 136) == 1);
    check("through a texture", stats.cache_renders == 1 && stats.cache_blits == 1);
    tree.set_opacity(&t, card, 0.25);
    frame(&t, &c, &o);
    check("a quarter", near(10, 10, 76, 12, 12) == 1);
    check("the texture put back, not painted again", stats.cache_renders == 0 && stats.cache_blits == 1);
    tree.set_opacity(&t, card, 0.25);
    check("the same again is no change", tree.paint_wanted(&t) == 0);
    tree.set_opacity(&t, card, 0.0);
    data(&t, card).paints = 0;
    frame(&t, &c, &o);
    check("not seen at all", pixel(10, 10) == as_px(BG) && pixel(7, 7) == as_px(BG));
    check("nor painted", data(&t, card).paints == 0 && stats.cache_blits == 0);
    check("still hit", router.hit(&t, 10.0, 10.0) == card);
    tree.set_opacity(&t, card, 1.0);
    frame(&t, &c, &o);
    check("opaque again, directly", pixel(10, 10) == as_px(RED) && stats.cache_blits == 0);
    check("its texture let go", paint.cache_used(&cc, &t) == 0);
    // Changed while opaque, then faded again: not the texture it had before.
    data(&t, card).color = BLUE;
    tree.invalidate_paint(&t, card);
    frame(&t, &c, &o);
    tree.set_opacity(&t, card, 0.5);
    frame(&t, &c, &o);
    check("faded again: as it is now", near(10, 10, 8, 8, 136) == 1);
    data(&t, card).color = RED;
    tree.invalidate_paint(&t, card);
    tree.set_opacity(&t, card, 1.0);
    frame(&t, &c, &o);
    // Off screen, nothing to repaint.
    tree.set_visible(&t, card, 0);
    frame(&t, &c, &o);
    tree.set_opacity(&t, card, 0.5);
    check("hidden: no frame for it", tree.paint_wanted(&t) == 0);
    tree.set_visible(&t, card, 1);
    frame(&t, &c, &o);
    check("shown: faded", near(10, 10, 136, 8, 8) == 1);
    tree.set_opacity(&t, card, 1.0);
    frame(&t, &c, &o);
    tree.set_opacity(&t, card, 2.0);
    check("not above 1", tree.opacity(&t, card) == 1.0);
    tree.set_opacity(&t, card, 0.0 - 1.0);
    check("not below 0", tree.opacity(&t, card) == 0.0);

    // Moving a translucent widget moves its texture.
    tree.set_opacity(&t, card, 0.5);
    frame(&t, &c, &o);
    tree.set_translation(&t, card, 30.0, 20.0);
    frame(&t, &c, &o);
    check("moved, faded", near(40, 30, 136, 8, 8) == 1 && pixel(10, 10) == as_px(BG));
    check("moving is not painting again", stats.cache_renders == 0);
    tree.set_translation(&t, card, 0.0, 0.0);
    frame(&t, &c, &o);

    // Translucent inside translucent: the inner one faded into the outer's
    // picture, and that faded again.
    tree.set_opacity(&t, dot, 0.5);
    frame(&t, &c, &o);
    // Half blue over red is 127.5, 0, 127.5; half of that over 0x101010.
    check("nested: faded twice", near(7, 7, 72, 8, 72) == 1);
    check("nested: the outer's own colour once", near(10, 10, 136, 8, 8) == 1);
    check("nested: two textures", stats.cache_renders == 2 && stats.cache_blits == 2);
    tree.set_opacity(&t, dot, 0.25);
    frame(&t, &c, &o);
    // A quarter blue over red: 191.25, 0, 63.75.
    check("nested, the inner fading", near(7, 7, 104, 8, 40) == 1);
    check("nested, the inner fading: the outer painted again, the inner put back",
          stats.cache_renders == 1 && stats.cache_blits == 2);
    tree.set_opacity(&t, dot, 1.0);
    frame(&t, &c, &o);
    check("nested, the inner opaque again", near(7, 7, 8, 8, 136) == 1 && stats.cache_blits == 1);
    // Inside a widget cached and opaque, the same.
    tree.set_opacity(&t, card, 1.0);
    tree.set_flag(&t, card, tree.F_CACHE, 1);
    tree.set_opacity(&t, dot, 0.5);
    frame(&t, &c, &o);
    check("in a cached one", near(7, 7, 128, 0, 128) == 1 && near(10, 10, 255, 0, 0) == 1);
    tree.set_opacity(&t, dot, 0.0);
    frame(&t, &c, &o);
    check("in a cached one, gone", pixel(7, 7) == as_px(RED));
    tree.set_opacity(&t, dot, 1.0);
    tree.set_flag(&t, card, tree.F_CACHE, 0);
    frame(&t, &c, &o);
    check("back", pixel(7, 7) == as_px(BLUE));
    tree.set_opacity(&t, card, 0.5);
    frame(&t, &c, &o);

    // With no cache to composite through: drawn as it is, or not at all.
    o.cache = cast(*paint.Cache, 0);
    let is math.rect.Rect as all2 = math.rect.rect(0.0, 0.0, cast(f64, W), cast(f64, H));
    tree.damage_add(&t, &all2);
    frame(&t, &c, &o);
    check("no cache: opaque", pixel(10, 10) == as_px(RED));
    tree.set_opacity(&t, card, 0.0);
    frame(&t, &c, &o);
    check("no cache, none: not drawn", pixel(10, 10) == as_px(BG));
    tree.set_opacity(&t, card, 1.0);
    frame(&t, &c, &o);

    // A destroyed widget's values do not pass to the next in its slot.
    tree.set_translation(&t, card, 5.0, 5.0);
    tree.set_opacity(&t, card, 0.5);
    tree.destroy(&t, card);
    let is i64 as fresh = box_at(&t, root, 4.0, 4.0, 12.0, 12.0, RED);
    check("a new widget: in place, opaque", tree.translation_x(&t, fresh) == 0.0 && tree.opacity(&t, fresh) == 1.0);
    check("a stale handle", tree.opacity(&t, card) == 0.0 && tree.translation_x(&t, card) == 0.0
          && tree.translation_y(&t, card) == 0.0);
    tree.set_opacity(&t, card, 0.5);
    tree.set_translation(&t, card, 1.0, 1.0);

    paint.cache_close(&cc);
    draw2d.close(&c);
    tree.close(&t);
    if (fails > 0) {
        io.printf("visual: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("visual: all checks passed\n");
    return 0;
}
