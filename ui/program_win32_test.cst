// ui/program_win32_test.cst — a program of the toolkit's, started in one
// call on Windows (here: an isolated Wine, the test fonts standing in for the
// system's):
//   sh window/win32/tools/run_native.sh build/program_win32_test.exe
// Run from the repository's root. There is no session bus: the program runs
// all the same. Its window is observed as another program would see it — its
// title, the pixels painted in it — and driven by the messages a click, typed
// text and the close button send.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/thread.cst" as thread;
use "../window/device.cst" as device;
use "../window/win32/bind/types.cst" as t;
use "../window/win32/bind/user32.cst" as u;
use "../window/win32/bind/gdi32.cst" as g;
use "../window/win32/bind/kernel32.cst" as k;
use "../window/win32/bind/imm32.cst" as ime;
use "../text/fonts/chain.cst" as chain;
use "tree.cst" as tree;
use "layout.cst" as layout;
use "box.cst" as box;
use "app.cst" as app;
use "host.cst" as host;
use "system_fonts.cst" as system_fonts;
use "program.cst" as program;
use "timer.cst" as timer;
use "widgets/label.cst" as label;
use "widgets/entry.cst" as entry;
use "widgets/decoration.cst" as decoration;
use "../math/math.cst" as math;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn pixel(v as f64, scale as f64) as i64 { return cast(i64, v * scale + 0.5); }

fn same_pixels(a as *math.rect.Rect, b as *math.rect.Rect, scale as f64) as i32 {
    return cast(i32, pixel(a.x, scale) == pixel(b.x, scale) &&
        pixel(a.y, scale) == pixel(b.y, scale) &&
        pixel(a.x + a.w, scale) == pixel(b.x + b.w, scale) &&
        pixel(a.y + a.h, scale) == pixel(b.y + b.h, scale));
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as m with mut = 0;
    while (b[m] != 0) { m = m + 1; }
    return cast(i32, n == m && mem.memcmp(a, b, n) == 0);
}

// The window's title as the system holds it, against UTF-8 want.
fn title_is(hwnd as i64, want as *u8) as i32 {
    let is [64]u16 as got;
    let is [64]u16 as expected;
    let is i32 as n = u.GetWindowTextW(hwnd, &got[0], 64);
    let is i32 as m = k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, want), cast(i32, 0 - 1), &expected[0], 64);
    if (m <= 0 || n != m - 1) { return 0; }
    return cast(i32, mem.memcmp(cast(*u8, &got[0]), cast(*u8, &expected[0]), cast(i64, n) * 2) == 0);
}

// Pixels of r (logical) in the window that differ from its first one, as
// the screen shows them.
fn inked(hwnd as i64, r as *math.rect.Rect, scale as f64) as i64 {
    let is i64 as dc = u.GetDC(hwnd);
    let is i64 as x0 = pixel(r.x, scale);
    let is i64 as y0 = pixel(r.y, scale);
    let is i64 as x1 = pixel(r.x + r.w, scale);
    let is i64 as y1 = pixel(r.y + r.h, scale);
    let is u32 as back = g.GetPixel(dc, cast(i32, x0), cast(i32, y0));
    let is i64 as n with mut = 0;
    let is i64 as y with mut = y0;
    while (y < y1) {
        let is i64 as x with mut = x0;
        while (x < x1) {
            if (g.GetPixel(dc, cast(i32, x), cast(i32, y)) != back) { n = n + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    u.ReleaseDC(hwnd, dc);
    return n;
}

fn steps(hs as *host.Host, n as i64) as void {
    let is i64 as k with mut = 0;
    while (k < n) {
        host.step(hs, 30);
        k = k + 1;
    }
}

// The process's CPU time, kernel and user, in milliseconds.
fn cpu_ms() as i64 {
    let is t.FILETIME as created;
    let is t.FILETIME as ended;
    let is t.FILETIME as kernel;
    let is t.FILETIME as user;
    if (k.GetProcessTimes(k.GetCurrentProcess(), &created, &ended, &kernel, &user) == 0) { return 0 - 1; }
    let is i64 as kt = (cast(i64, kernel.dwHighDateTime) << 32) | cast(i64, kernel.dwLowDateTime);
    let is i64 as ut = (cast(i64, user.dwHighDateTime) << 32) | cast(i64, user.dwLowDateTime);
    return (kt + ut) / 10000;
}

let is i64 as timer_at with mut = 0;
let is i64 as posted_at with mut = 0;
let is *host.Host as loop with mut;

fn on_timer(user as *u8) as void { timer_at = time.now_ms(); }
fn on_post(user as *u8) as void { posted_at = time.now_ms(); }

// Another thread: a little later, something posted to the loop.
fn poster(arg as i64) as i64 {
    time.sleep_ms(100);
    host.post(loop, fn_ptr(on_post), cast(*u8, 0));
    return 0;
}

let is program.Program as p with mut;
let is program.Program as bare with mut;

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    check("no fonts: not started", program.open(&bare, "text\\testdata\\nowhere") == 0);
    program.close(&bare);

    check("started", program.open(&p, "text\\testdata\\fonts") == 1);
    let is chain.Prefs as fp with mut = chain.defaults();
    fp.ui = "Caustic Test Sans";
    fp.sans = "Caustic Test Sans";
    system_fonts.set_prefs(program.fonts(&p), &fp);
    let is *app.App as a = program.app(&p);
    let is *host.Host as hs = program.host(&p);
    check("no session bus on Windows: none, and nothing watched", cast(i64, program.conn(&p)) == 0 && host.watched(hs) == 0);

    let is i64 as win = app.window_open(a, 240.0, 180.0);
    app.set_title(a, win, "Programa", 8);
    let is *tree.Tree as tr = app.tree(a, win);
    let is i64 as col = box.create(tr, tree.root(tr), box.COLUMN);
    let is i64 as l = label.create(tr, col, "Hello", 5);
    layout.set_min_size(tr, l, 210.0, 60.0);
    let is i64 as e = entry.create(tr, col);
    steps(hs, 6);
    check("on the screen", host.shown(hs) == 1);
    let is *device.Window as native_window = host.native(hs, win);
    check("a native window", cast(i64, native_window) != 0 && native_window.backend == device.WIN32);
    if (cast(i64, native_window) == 0) { return 1; }
    let is i64 as hwnd = native_window.win32_win.hwnd;
    check("visible, titled as the program asked", u.IsWindowVisible(hwnd) == 1 && title_is(hwnd, "Programa") == 1);
    check("laid out at the window's scale", tr.scale == cast(f64, device.scale_120(native_window)) / 120.0);
    check("its text in the system's fonts", system_fonts.count(program.fonts(&p)) >= 1 && layout.window_rect(tr, l).w > 10.0);
    let is math.rect.Rect as at = layout.window_rect(tr, l);
    check("its client the size asked, at that scale", device.width(native_window) == pixel(240.0, tr.scale) &&
          device.height(native_window) == pixel(180.0, tr.scale));
    check("its text painted where it was laid out", inked(hwnd, &at, tr.scale) > 20);
    let is i64 as frame = app.decoration(a, win);
    let is math.rect.Rect as room with mut = layout.rect(tr, tree.root(tr));
    if (frame != 0) { room = layout.window_rect(tr, decoration.content_of(tr, frame)); }
    let is math.rect.Rect as filled = layout.window_rect(tr, col);
    check("its content fills the usable window", same_pixels(&filled, &room, tr.scale) == 1);
    let is math.rect.Rect as bounds with mut = layout.rect(tr, tree.root(tr));
    if (frame != 0) { bounds = layout.window_rect(tr, frame); }
    check("the content fits the native buffer", pixel(bounds.x + bounds.w, tr.scale) <= device.width(native_window) &&
          pixel(bounds.y + bounds.h, tr.scale) <= device.height(native_window));
    check("the system's settings, with no bus", host.settings(hs).double_click_ms == cast(i64, u.GetDoubleClickTime()));

    // --- Asleep when idle; woken by its timer, and by another thread ---
    steps(hs, 3);
    let is i64 as cpu0 = cpu_ms();
    let is i64 as t0 with mut = time.now_ms();
    host.step(hs, 400);
    let is i64 as idle = time.now_ms() - t0;
    let is i64 as spent = cpu_ms() - cpu0;
    check("idle: asleep for its time", idle >= 350 && idle < 2000);
    check("and taking no time meanwhile", cpu0 >= 0 && spent < 60);
    t0 = time.now_ms();
    timer.add(app.timers(a), t0, 150, 0, fn_ptr(on_timer), cast(*u8, 0));
    while (timer_at == 0 && time.now_ms() - t0 < 3000) { host.step(hs, 5000); }
    check("woken by its timer, at its time", timer_at - t0 >= 140 && timer_at - t0 < 1000);
    loop = hs;
    let is thread.Thread as th;
    t0 = time.now_ms();
    thread.spawn(&th, cast(*u8, fn_ptr(poster)), 0);
    while (posted_at == 0 && time.now_ms() - t0 < 3000) { host.step(hs, 5000); }
    thread.join(&th);
    check("woken by what another thread posted", posted_at - t0 >= 80 && posted_at - t0 < 1000);

    // Nothing with the keyboard takes text yet: the window has no input
    // context, the input method none of its keys.
    check("no text field focused: no input method", ime.ImmGetContext(hwnd) == 0);
    // A click into the entry, then text typed: the messages a user's would be.
    let is math.rect.Rect as er = layout.window_rect(tr, e);
    let is i64 as cx = pixel(er.x + er.w / 2.0, tr.scale);
    let is i64 as cy = pixel(er.y + er.h / 2.0, tr.scale);
    u.SendMessageW(hwnd, cast(u32, t.WM_MOUSEMOVE), 0, cx | (cy << 16));
    u.SendMessageW(hwnd, cast(u32, t.WM_LBUTTONDOWN), 1, cx | (cy << 16));
    u.SendMessageW(hwnd, cast(u32, t.WM_LBUTTONUP), 0, cx | (cy << 16));
    steps(hs, 3);
    u.SendMessageW(hwnd, cast(u32, t.WM_CHAR), 233, 1);
    u.SendMessageW(hwnd, cast(u32, t.WM_CHAR), 120, 1);
    steps(hs, 3);
    check("the text typed into the entry clicked", same(entry.text(tr, e), entry.length(tr, e), "éx") == 1);
    let is math.rect.Rect as typed = layout.window_rect(tr, e);
    check("and painted", inked(hwnd, &typed, tr.scale) > 0);

    // The entry has the keyboard: the input method too, told where its caret
    // is and, asked, what it holds around the caret.
    let is i64 as himc = ime.ImmGetContext(hwnd);
    let is t.CANDIDATEFORM as cand;
    mem.memzero(cast(*u8, &cand), sizeof(t.CANDIDATEFORM));
    let is math.rect.Rect as caret = tree.text_area_rect(tr);
    check("the entry focused: the input method, its candidates under the entry's caret",
          himc != 0 && ime.ImmGetCandidateWindow(himc, 0, &cand) != 0 &&
          cast(i64, cand.ptCurrentPos.x) == cast(i64, caret.x * tr.scale + 0.5) &&
          cast(i64, cand.rcArea.top) == cast(i64, caret.y * tr.scale + 0.5));
    let is [256]u8 as feed;
    mem.memzero(&feed[0], 256);
    let is *t.RECONVERTSTRING as rs = cast(*t.RECONVERTSTRING, &feed[0]);
    rs.dwSize = cast(u32, 256);
    let is i64 as head = cast(i64, sizeof(t.RECONVERTSTRING));
    let is *u16 as doc = cast(*u16, cast(i64, rs) + head);
    check("asked, the entry's text, the caret at its end",
          u.SendMessageW(hwnd, cast(u32, t.WM_IME_REQUEST), cast(u64, t.IMR_DOCUMENTFEED), cast(i64, rs)) > 0 &&
          rs.dwStrLen == 2 && doc[0] == cast(u16, 233) && doc[1] == cast(u16, 120) && rs.dwCompStrOffset == 4);
    // Composed by the method (as its keys would): shown in the entry, then
    // committed into it.
    ime.ImmSetOpenStatus(himc, 1);
    let is [3]u16 as kana;
    kana[0] = cast(u16, 12363); kana[1] = cast(u16, 12394); kana[2] = cast(u16, 0);
    ime.ImmSetCompositionStringW(himc, cast(u32, t.SCS_SETSTR), cast(*u8, &kana[0]), 4, cast(*u8, 0), 0);
    steps(hs, 3);
    let is i64 as ca with mut = 0;
    let is i64 as cb with mut = 0;
    check("composing: shown in the entry, not its text yet",
          entry.composition(tr, e, &ca, &cb) == 6 && same(entry.text(tr, e), entry.length(tr, e), "éx") == 1);
    ime.ImmNotifyIME(himc, cast(u32, t.NI_COMPOSITIONSTR), cast(u32, t.CPS_COMPLETE), 0);
    steps(hs, 3);
    check("committed: the entry's text", same(entry.text(tr, e), entry.length(tr, e), "éxかな") == 1 &&
          entry.composition(tr, e, &ca, &cb) == 0);
    ime.ImmReleaseContext(hwnd, himc);

    // Moved to a monitor of half again its DPI, as Windows tells it: laid
    // out again at that scale, the window's size in logical pixels what the
    // system made its client, and painted at it.
    let is f64 as scale0 = tr.scale;
    let is i64 as dpi1 = cast(i64, scale0 * 144.0 + 0.5);
    let is t.RECT as was;
    u.GetWindowRect(hwnd, &was);
    let is t.RECT as suggested;
    suggested.left = was.left;
    suggested.top = was.top;
    suggested.right = was.left + (was.right - was.left) * 3 / 2;
    suggested.bottom = was.top + (was.bottom - was.top) * 3 / 2;
    u.SendMessageW(hwnd, cast(u32, t.WM_DPICHANGED), cast(u64, dpi1 | (dpi1 << 16)), cast(i64, &suggested));
    steps(hs, 6);
    check("laid out at the new monitor's scale", tr.scale == scale0 * 1.5 && app.scale(a, win) == scale0 * 1.5);
    check("its logical size its client's at that scale",
          pixel(app.width(a, win), tr.scale) == device.width(native_window) &&
          pixel(app.height(a, win), tr.scale) == device.height(native_window));
    let is math.rect.Rect as at2 = layout.window_rect(tr, l);
    check("its text painted where it is laid out now", inked(hwnd, &at2, tr.scale) > 20);

    // The close button's message: the window closed, the loop over.
    u.PostMessageW(hwnd, cast(u32, t.WM_CLOSE), 0, 0);
    t0 = time.now_ms();
    program.run(&p);
    check("closed by the system: run is over", host.shown(hs) == 0 && time.now_ms() - t0 < 3000 && u.IsWindow(hwnd) == 0);
    program.close(&p);
    check("closed: no fonts kept", system_fonts.count(program.fonts(&p)) == 0);
    program.close(&p);

    if (fails == 0) {
        io.printf("ui program win32: all checks passed\n");
        return 0;
    }
    io.printf("ui program win32: %d failures\n", fails);
    return 1;
}
