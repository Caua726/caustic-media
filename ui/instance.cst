// ui/instance.cst — one instance of the application.
//
// Started again — a file opened from the file manager, the launcher clicked
// twice — a program should not open a second copy of itself: the first to
// own its id on the session bus (a reverse-DNS name, "org.example.Notes")
// is the application; a later start finds it there, hands over what it was
// asked — to come forward, to open these files, to do this action — and
// leaves. What is handed over goes through org.freedesktop.Application,
// the interface desktops call on applications they start over D-Bus, on the
// object the specification names: the id with its dots slashes and its
// dashes underscores ("/org/example/Notes").
//
// The connection is the program's, dispatched by its loop (session.cst).
//
// A start the desktop launched carries a token to come forward with —
// XDG_ACTIVATION_TOKEN on Wayland, DESKTOP_STARTUP_ID on X11 — which it
// hands over in platform_data as "activation-token" and
// "desktop-startup-id", taken from its environment, as GLib does; the
// instance keeps what each call came with (token), for its window to come
// forward with (host.present_with) rather than be refused as a window
// stealing the keyboard.
//
// Windows has no session bus: there the id is a named mutex
// ("Local\CausticMediaInstance.<id>"), whose first creator is the
// instance, and the instance a message-only window named the id, which a
// later start finds (FindWindowExW under HWND_MESSAGE) and hands what it was
// asked with WM_COPYDATA — 1 to come forward, 2 the uris back to back, 3 an
// action's name. Before it does, it lets the instance take the foreground
// (AllowSetForegroundWindow), Windows' way of a start's token; the
// connection is not used and token is always empty there. The window's
// messages come through the program's loop, as its other windows' do.
use "std/os.cst" as os;
use "std/mem.cst" as mem;
use "../dbus/dbus.cst" as dbus;
use "../window/linux/launch.cst" as launch;
use "../window/win32/abi.cst" as abi;
use "../window/win32/bind/types.cst" as t;
use "../window/win32/bind/kernel32.cst" as k32;
use "../window/win32/bind/user32.cst" as u;

let is *u8 as IFACE with imut = "org.freedesktop.Application";

// Asked to come forward: cb(user).
type ActivateFn = fn(*u8) as void;
// Asked to open uris: cb(user, s, n, count) — count of them back to back,
// each zero-terminated, n bytes in all.
type OpenFn = fn(*u8, *u8, i64, i64) as void;
// Asked to do an action: cb(user, name, n).
type ActionFn = fn(*u8, *u8, i64) as void;

let is i64 as _DO_NOT_QUEUE  with imut = 4;
let is i64 as _PRIMARY_OWNER with imut = 1;

// The longest token kept.
let is i64 as MAX_TOKEN with imut = 255;

struct Instance {
    c        as *dbus.conn.Conn;
    primary  as i32;
    _pad     as i32;
    id       as [256]u8;
    path     as [258]u8;
    path_n   as i64;
    activate as ActivateFn;
    open     as OpenFn;
    action   as ActionFn;
    user     as *u8;
    methods  as [3]dbus.conn.Method;
    iface    as dbus.conn.Interface;
    uris     as [8192]u8;
    token    as [256]u8;     // the current call's, zero-terminated
    token_n  as i64;
    mutex    as i64;         // Windows: the id's mutex, and the window it is reached at
    hwnd     as i64;
}

// The object path of id, n bytes, into out (n + 2 bytes): its length.
fn _path_of(id as *u8, n as i64, out as *u8) as i64 {
    out[0] = cast(u8, 47);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u8 as c with mut = id[i];
        if (c == 46) { c = cast(u8, 47); }
        if (c == 45) { c = cast(u8, 95); }
        out[i + 1] = c;
        i = i + 1;
    }
    out[n + 1] = cast(u8, 0);
    return n + 1;
}

// The call's platform_data (a{sv}) read from r: its "activation-token", or
// without one its "desktop-startup-id", kept as the token; none kept when it
// has neither, or is malformed.
fn _platform_data(inst as *Instance, r as *dbus.wire.Reader) as void {
    inst.token_n = 0;
    inst.token[0] = cast(u8, 0);
    let is i32 as from_activation with mut = 0;
    let is i64 as n with mut = 0;
    let is i64 as end = dbus.wire.get_array(r, 8);
    while (r.err == 0 && r.pos < end) {
        dbus.wire.get_struct(r);
        let is *u8 as key = dbus.wire.get_string(r, &n);
        let is i64 as sn with mut = 0;
        let is *u8 as sig = dbus.wire.get_variant(r, &sn);
        if (r.err != 0) { break; }
        let is i32 as activation = dbus.message.named(key, "activation-token");
        let is i32 as startup = dbus.message.named(key, "desktop-startup-id");
        if ((activation == 1 || (startup == 1 && from_activation == 0)) && dbus.message.named(sig, "s") == 1) {
            let is i64 as tn with mut = 0;
            let is *u8 as t = dbus.wire.get_string(r, &tn);
            if (r.err == 0 && tn > 0 && tn <= MAX_TOKEN) {
                mem.memcpy(cast(*u8, &inst.token), t, tn);
                inst.token[tn] = cast(u8, 0);
                inst.token_n = tn;
                from_activation = activation;
            }
        } else {
            dbus.wire.skip(r, sig, sn);
        }
    }
    if (r.err != 0) {
        inst.token_n = 0;
        inst.token[0] = cast(u8, 0);
    }
}

fn _activate(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is *Instance as inst = cast(*Instance, user);
    _platform_data(inst, &k.args);
    if (cast(i64, inst.activate) != 0) { call(inst.activate, inst.user); }
}

fn _open(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is *Instance as inst = cast(*Instance, user);
    let is i64 as end = dbus.wire.get_array(&k.args, 4);
    let is i64 as n with mut = 0;
    let is i64 as count with mut = 0;
    while (k.args.err == 0 && k.args.pos < end) {
        let is i64 as len with mut = 0;
        let is *u8 as s = dbus.wire.get_string(&k.args, &len);
        if (k.args.err == 0 && n + len + 1 <= 8192) {
            mem.memcpy(cast(*u8, cast(i64, &inst.uris) + n), s, len);
            inst.uris[n + len] = cast(u8, 0);
            n = n + len + 1;
            count = count + 1;
        }
    }
    // Back to back, the last one's zero not counted.
    if (n > 0) { n = n - 1; }
    _platform_data(inst, &k.args);
    if (cast(i64, inst.open) != 0) { call(inst.open, inst.user, cast(*u8, &inst.uris), n, count); }
}

fn _action(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is *Instance as inst = cast(*Instance, user);
    let is i64 as len with mut = 0;
    let is *u8 as name = dbus.wire.get_string(&k.args, &len);
    if (k.args.err != 0) { return; }
    dbus.wire.skip(&k.args, "av", 2);
    _platform_data(inst, &k.args);
    if (cast(i64, inst.action) != 0) { call(inst.action, inst.user, name, len); }
}

fn _method(m as *dbus.conn.Method, name as *u8, ins as *u8, h as dbus.conn.MethodFn, names as *u8) as void {
    m.name = name;
    m.in_sig = ins;
    m.out_sig = "";
    m.handler = h;
    m.in_names = names;
    m.out_names = cast(*u8, 0);
}

// The application id, n bytes, claimed on c: 1 when this is the instance,
// what it is asked handed to the callbacks (any null) as c is dispatched;
// 0 when another is — hand it what this start was asked (*_remote) and
// leave.
fn claim(inst as *Instance, c as *dbus.conn.Conn, id as *u8, n as i64, on_activate as ActivateFn, on_open as OpenFn,
         on_action as ActionFn, user as *u8) as i32 {
    inst.c = c;
    inst.primary = 0;
    inst.activate = on_activate;
    inst.open = on_open;
    inst.action = on_action;
    inst.user = user;
    inst.token_n = 0;
    inst.token[0] = cast(u8, 0);
    inst.mutex = 0;
    inst.hwnd = 0;
    if (n <= 0 || n > 255) { return 0; }
    mem.memcpy(cast(*u8, &inst.id), id, n);
    inst.id[n] = cast(u8, 0);
    inst.path_n = _path_of(id, n, cast(*u8, &inst.path));
    if (os.current() == os.OS_WINDOWS) { return _claim_windows(inst); }
    if (os.current() == os.OS_LINUX) { return _claim_bus(inst, c); }
    return 0;
}

fn _claim_bus(inst as *Instance, c as *dbus.conn.Conn) as i32 {
    if (dbus.conn.request_name(c, cast(*u8, &inst.id), _DO_NOT_QUEUE) != _PRIMARY_OWNER) { return 0; }
    _method(&inst.methods[0], "Activate", "a{sv}", fn_ptr(_activate), "platform_data");
    _method(&inst.methods[1], "Open", "asa{sv}", fn_ptr(_open), "uris,platform_data");
    _method(&inst.methods[2], "ActivateAction", "sava{sv}", fn_ptr(_action), "action_name,parameter,platform_data");
    inst.iface.name = IFACE;
    inst.iface.methods = cast(*dbus.conn.Method, &inst.methods);
    inst.iface.nmethods = 3;
    inst.iface.props = cast(*dbus.conn.Property, 0);
    inst.iface.nprops = 0;
    inst.iface.signals = cast(*dbus.conn.SignalDecl, 0);
    inst.iface.nsignals = 0;
    dbus.conn.export(c, cast(*u8, &inst.path), &inst.iface, 1, cast(*u8, inst));
    inst.primary = 1;
    return 1;
}

fn is_primary(inst as *Instance) as i32 { return inst.primary; }

fn path(inst as *Instance) as *u8 { return cast(*u8, &inst.path); }

fn path_length(inst as *Instance) as i64 { return inst.path_n; }

// No longer the instance: the name and the object let go.
fn release(inst as *Instance) as void {
    if (inst.primary == 0) { return; }
    if (os.current() == os.OS_WINDOWS) {
        u.SetWindowLongPtrW(inst.hwnd, cast(i32, t.GWLP_USERDATA), 0);
        u.DestroyWindow(inst.hwnd);
        k32.CloseHandle(inst.mutex);
        inst.hwnd = 0;
        inst.mutex = 0;
        inst.primary = 0;
        return;
    }
    dbus.conn.unexport(inst.c, cast(*u8, &inst.path));
    dbus.conn.release_name(inst.c, cast(*u8, &inst.id));
    inst.primary = 0;
}

fn _message(id as *u8, n as i64, member as *u8, sig as *u8, name as *u8, p as *u8) as dbus.message.Message {
    mem.memcpy(name, id, n);
    name[n] = cast(u8, 0);
    _path_of(id, n, p);
    let is dbus.message.Message as m with mut = dbus.message.method_call(name, p, IFACE, member);
    m.signature = sig;
    return m;
}

fn _token_entry(w as *dbus.wire.Writer, key as *u8, value as *u8, n as i64) as void {
    dbus.wire.put_struct(w);
    dbus.wire.put_string(w, key);
    dbus.wire.put_variant(w, "s");
    dbus.wire.put_string_n(w, value, n);
}

// platform_data: the token this start came with, taken from its environment
// — each kind under its name — so the instance comes forward with it.
fn _platform_data_out(w as *dbus.wire.Writer) as void {
    let is [256]u8 as token;
    let is i64 as at = dbus.wire.put_array(w, 8);
    let is i64 as tn = launch.take("XDG_ACTIVATION_TOKEN", &token[0], 256);
    if (tn > 0) { _token_entry(w, "activation-token", &token[0], tn); }
    let is i64 as sn = launch.take("DESKTOP_STARTUP_ID", &token[0], 256);
    if (sn > 0) { _token_entry(w, "desktop-startup-id", &token[0], sn); }
    dbus.wire.put_array_end(w, at, 8);
}

// The token the current call came with (activation-token, else
// desktop-startup-id), zero-terminated; token_length 0 for none. Read in
// the callback: the next call replaces it.
fn token(inst as *Instance) as *u8 { return cast(*u8, &inst.token); }
fn token_length(inst as *Instance) as i64 { return inst.token_n; }

fn _call(c as *dbus.conn.Conn, m as *dbus.message.Message) as i32 {
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    return cast(i32, dbus.conn.call_method(c, m, 2000, &rep) == dbus.conn.OK);
}

// The instance of id, n bytes, asked to come forward: 1 when it answered.
fn activate_remote(c as *dbus.conn.Conn, id as *u8, n as i64) as i32 {
    if (n <= 0 || n > 255) { return 0; }
    if (os.current() == os.OS_WINDOWS) { return _send(id, n, _ACTIVATE, cast(*u8, 0), 0); }
    let is [256]u8 as name;
    let is [258]u8 as p;
    let is dbus.message.Message as m with mut = _message(id, n, "Activate", "a{sv}", cast(*u8, &name), cast(*u8, &p));
    _platform_data_out(dbus.conn.body(c));
    return _call(c, &m);
}

// The instance of id asked to open count uris, back to back at s, each
// zero-terminated, n bytes in all: 1 when it answered.
fn open_remote(c as *dbus.conn.Conn, id as *u8, n as i64, s as *u8, sn as i64, count as i64) as i32 {
    if (n <= 0 || n > 255) { return 0; }
    if (os.current() == os.OS_WINDOWS) {
        // The first count of them, each with its zero.
        let is i64 as i with mut = 0;
        let is i64 as k with mut = 0;
        while (k < count && i < sn) {
            while (i < sn && s[i] != 0) { i = i + 1; }
            i = i + 1;
            k = k + 1;
        }
        if (i > sn) { i = sn; }
        return _send(id, n, _OPEN, s, i);
    }
    let is [256]u8 as name;
    let is [258]u8 as p;
    let is dbus.message.Message as m with mut = _message(id, n, "Open", "asa{sv}", cast(*u8, &name), cast(*u8, &p));
    let is *dbus.wire.Writer as w = dbus.conn.body(c);
    let is i64 as at = dbus.wire.put_array(w, 4);
    let is i64 as i with mut = 0;
    let is i64 as k with mut = 0;
    while (k < count && i < sn) {
        let is i64 as e with mut = i;
        while (e < sn && s[e] != 0) { e = e + 1; }
        dbus.wire.put_string_n(w, cast(*u8, cast(i64, s) + i), e - i);
        i = e + 1;
        k = k + 1;
    }
    dbus.wire.put_array_end(w, at, 4);
    _platform_data_out(w);
    return _call(c, &m);
}

// The instance of id asked to do the action name (an), with no parameter:
// 1 when it answered.
fn action_remote(c as *dbus.conn.Conn, id as *u8, n as i64, action as *u8, an as i64) as i32 {
    if (n <= 0 || n > 255) { return 0; }
    if (os.current() == os.OS_WINDOWS) { return _send(id, n, _ACTION, action, an); }
    let is [256]u8 as name;
    let is [258]u8 as p;
    let is dbus.message.Message as m with mut = _message(id, n, "ActivateAction", "sava{sv}", cast(*u8, &name), cast(*u8, &p));
    let is *dbus.wire.Writer as w = dbus.conn.body(c);
    dbus.wire.put_string_n(w, action, an);
    // No parameter: an empty array of variants, which align to a byte.
    let is i64 as at = dbus.wire.put_array(w, 1);
    dbus.wire.put_array_end(w, at, 1);
    _platform_data_out(w);
    return _call(c, &m);
}

// --- Windows ---

let is u64 as _ACTIVATE with imut = 1;
let is u64 as _OPEN     with imut = 2;
let is u64 as _ACTION   with imut = 3;

let is abi.Callbacks as _callbacks with mut;
let is i32 as _class_ready with mut = 0;
let is [32]u16 as _class with mut;

// s, n bytes of UTF-8, after prefix into out (cap units) as UTF-16 with its
// zero: 1, or 0 when it does not fit.
fn _wide(prefix as *u8, s as *u8, n as i64, out as *u16, cap as i32) as i32 {
    let is i32 as p = k32.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, prefix), cast(i32, 0 - 1), out, cap);
    if (p <= 0) { return 0; }
    let is i32 as at = p - 1;
    let is i32 as m = k32.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, s), cast(i32, n), cast(*u16, cast(i64, out) + cast(i64, at) * 2),
                                              cap - at - 1);
    if (m <= 0 && n > 0) { return 0; }
    *cast(*u16, cast(i64, out) + cast(i64, at + m) * 2) = cast(u16, 0);
    return 1;
}

// A start's message to the instance's window: what it asked handed to its
// callbacks; TRUE that it was heard.
fn _proc(ctx as *u8, args as *u64) as i64 {
    let is i64 as hwnd = cast(i64, args[0]);
    let is u32 as msg = cast(u32, args[1]);
    let is u64 as wp = args[2];
    let is i64 as lp = cast(i64, args[3]);
    if (cast(i64, msg) != t.WM_COPYDATA) { return u.DefWindowProcW(hwnd, msg, wp, lp); }
    let is *Instance as inst = cast(*Instance, u.GetWindowLongPtrW(hwnd, cast(i32, t.GWLP_USERDATA)));
    if (cast(i64, inst) == 0) { return 0; }
    let is *t.COPYDATASTRUCT as cd = cast(*t.COPYDATASTRUCT, lp);
    let is i64 as n with mut = cast(i64, cd.cbData);
    inst.token_n = 0;
    inst.token[0] = cast(u8, 0);
    if (cd.dwData == _ACTIVATE) {
        if (cast(i64, inst.activate) != 0) { call(inst.activate, inst.user); }
        return 1;
    }
    if (cd.dwData == _OPEN) {
        if (n > 8192) { n = 8192; }
        mem.memcpy(cast(*u8, &inst.uris), cd.lpData, n);
        // Counted by their zeros; the last one's not counted, as on the bus.
        let is i64 as count with mut = 0;
        let is i64 as i with mut = 0;
        while (i < n) {
            if (inst.uris[i] == 0) { count = count + 1; }
            i = i + 1;
        }
        if (n > 0 && inst.uris[n - 1] == 0) { n = n - 1; }
        if (cast(i64, inst.open) != 0) { call(inst.open, inst.user, cast(*u8, &inst.uris), n, count); }
        return 1;
    }
    if (cd.dwData == _ACTION) {
        if (n > 255) { n = 255; }
        let is [256]u8 as name;
        mem.memcpy(cast(*u8, &name), cd.lpData, n);
        if (cast(i64, inst.action) != 0) { call(inst.action, inst.user, cast(*u8, &name), n); }
        return 1;
    }
    return 0;
}

fn _ensure_class() as i32 {
    if (_class_ready == 1) { return 1; }
    k32.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, "CausticMediaInstance"), cast(i32, 0 - 1), &_class[0], 32);
    // The class's procedure: made once, kept as long as the program runs.
    _callbacks = abi.open(1);
    if (cast(i64, _callbacks.code) == 0) { return 0; }
    if (abi.put(&_callbacks, 0, fn_ptr(_proc), cast(*u8, 0), 4, 0) == 0 || abi.seal(&_callbacks) == 0) {
        abi.close(&_callbacks);
        return 0;
    }
    let is t.WNDCLASSEXW as wc;
    mem.memzero(cast(*u8, &wc), sizeof(t.WNDCLASSEXW));
    wc.cbSize = cast(u32, sizeof(t.WNDCLASSEXW));
    wc.lpfnWndProc = abi.address(&_callbacks, 0);
    wc.hInstance = k32.GetModuleHandleW(cast(*u16, 0));
    wc.lpszClassName = &_class[0];
    if (u.RegisterClassExW(&wc) == 0) {
        abi.close(&_callbacks);
        return 0;
    }
    _class_ready = 1;
    return 1;
}

fn _claim_windows(inst as *Instance) as i32 {
    let is [300]u16 as name;
    let is i64 as n with mut = 0;
    while (inst.id[n] != 0) { n = n + 1; }
    if (_wide("Local\\CausticMediaInstance.", cast(*u8, &inst.id), n, &name[0], 300) == 0) { return 0; }
    let is i64 as m = k32.CreateMutexW(cast(*u8, 0), 0, &name[0]);
    if (m == 0) { return 0; }
    if (cast(i64, k32.GetLastError()) == t.ERROR_ALREADY_EXISTS) {
        k32.CloseHandle(m);
        return 0;
    }
    let is [260]u16 as title;
    if (_ensure_class() == 0 || _wide("", cast(*u8, &inst.id), n, &title[0], 260) == 0) {
        k32.CloseHandle(m);
        return 0;
    }
    let is i64 as hwnd = u.CreateWindowExW(0, &_class[0], &title[0], 0, 0, 0, 0, 0, t.HWND_MESSAGE, 0,
                                           k32.GetModuleHandleW(cast(*u16, 0)), cast(*u8, 0));
    if (hwnd == 0) {
        k32.CloseHandle(m);
        return 0;
    }
    u.SetWindowLongPtrW(hwnd, cast(i32, t.GWLP_USERDATA), cast(i64, inst));
    inst.mutex = m;
    inst.hwnd = hwnd;
    inst.primary = 1;
    return 1;
}

// What kind asks — with the n bytes at s — sent to the instance of id (in
// bytes): 1 when it heard it, 0 when there is none.
fn _send(id as *u8, idn as i64, kind as u64, s as *u8, n as i64) as i32 {
    if (_ensure_class() == 0) { return 0; }
    let is [260]u16 as title;
    if (_wide("", id, idn, &title[0], 260) == 0) { return 0; }
    let is i64 as hwnd = u.FindWindowExW(t.HWND_MESSAGE, 0, &_class[0], &title[0]);
    if (hwnd == 0) { return 0; }
    // Its windows may come forward: this start's leave to, handed over.
    let is u32 as pid with mut = cast(u32, 0);
    u.GetWindowThreadProcessId(hwnd, &pid);
    if (pid != cast(u32, 0)) { u.AllowSetForegroundWindow(pid); }
    let is t.COPYDATASTRUCT as cd;
    mem.memzero(cast(*u8, &cd), sizeof(t.COPYDATASTRUCT));
    cd.dwData = kind;
    cd.cbData = cast(u32, n);
    cd.lpData = s;
    return cast(i32, u.SendMessageW(hwnd, cast(u32, t.WM_COPYDATA), cast(u64, 0), cast(i64, &cd)) == 1);
}
