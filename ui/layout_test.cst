// ui/layout_test.cst — the layout protocol: measure, place, and the pass.
//
// Containers come later and are tested on their own. This file checks what
// every container relies on: that layout.measure reports a widget's outer size
// (margins and overrides applied), that layout.place puts a widget inside the
// rectangle it is offered according to its alignment, and that the pass skips
// whatever did not change.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

// Compares in hundredths, which is finer than any layout here produces and
// coarse enough that f64 rounding never decides a test.
fn near(name as *u8, got as f64, want as f64) as void {
    let is i64 as g = cast(i64, got * 100.0 + 0.5);
    let is i64 as w = cast(i64, want * 100.0 + 0.5);
    if (g != w) {
        io.printf("FAIL: %s: got %d/100, want %d/100\n", name, cast(i32, g), cast(i32, w));
        fails = fails + 1;
    }
}

// --- A leaf with a preferred size, and optionally text that wraps ---
//
// With wrap > 0 the leaf behaves like a paragraph of `wrap` square units of
// text, 10 units tall per line: the narrower it is offered, the taller it
// gets. That is height-for-width, the case a single measure cannot answer.
struct Leaf {
    pref_w   as f64;
    pref_h   as f64;
    wrap     as f64;
    arranged as i64;
}

fn leaf_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Leaf as d = cast(*Leaf, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = d.pref_w;
    out.pref_h = d.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
    if (d.wrap > 0.0) {
        let is f64 as width with mut = d.pref_w;
        if (c.w < width) { width = c.w; }
        if (width < 1.0) { width = 1.0; }
        let is f64 as lines with mut = 1.0;
        while (lines * width < d.wrap) { lines = lines + 1.0; }
        out.pref_h = lines * 10.0;
        out.min_h = out.pref_h;
    }
}

fn leaf_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Leaf as d = cast(*Leaf, data);
    d.arranged = d.arranged + 1;
}

// --- A container that hands its one child its whole area ---
struct Frame {
    arranged as i64;
}

fn frame_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is i64 as child = tree.first_child(t, w);
    if (child == 0) { geom.size_zero(out); return; }
    layout.measure(t, child, c, out);
}

fn frame_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Frame as d = cast(*Frame, data);
    d.arranged = d.arranged + 1;
    let is i64 as child = tree.first_child(t, w);
    if (child == 0) { return; }
    let is math.rect.Rect as area = math.rect.rect(0.0, 0.0, r.w, r.h);
    layout.place(t, child, &area);
}

let is tree.Kind as leaf_kind with mut;
let is tree.Kind as frame_kind with mut;

fn leaf(t as *tree.Tree, parent as i64, pw as f64, ph as f64) as i64 {
    let is i64 as w = tree.create(t, &leaf_kind, parent);
    let is *Leaf as d = cast(*Leaf, tree.data(t, w));
    d.pref_w = pw;
    d.pref_h = ph;
    return w;
}

fn arranged(t as *tree.Tree, w as i64) as i64 {
    return (cast(*Leaf, tree.data(t, w))).arranged;
}

fn rect_of(t as *tree.Tree, w as i64) as math.rect.Rect {
    return layout.rect(t, w);
}

fn main() as i32 {
    leaf_kind = widget.kind("leaf", sizeof(Leaf));
    leaf_kind.measure = fn_ptr(leaf_measure);
    leaf_kind.arrange = fn_ptr(leaf_arrange);
    frame_kind = widget.kind("frame", sizeof(Frame));
    frame_kind.measure = fn_ptr(frame_measure);
    frame_kind.arrange = fn_ptr(frame_arrange);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);

    // --- FILL is the default: the whole area, minus margins ---
    let is i64 as a = leaf(&t, root, 20.0, 10.0);
    layout.set_margin(&t, a, 1.0, 2.0, 3.0, 4.0);
    layout.run(&t, 100.0, 50.0);
    let is math.rect.Rect as ra with mut = rect_of(&t, a);
    near("fill x", ra.x, 1.0);
    near("fill y", ra.y, 2.0);
    near("fill w", ra.w, 96.0);
    near("fill h", ra.h, 44.0);
    near("root w", rect_of(&t, root).w, 100.0);

    // --- Measuring reports the outer size: content plus margins ---
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as sa;
    layout.measure(&t, a, &free, &sa);
    near("measure pref w has margins", sa.pref_w, 24.0);
    near("measure pref h has margins", sa.pref_h, 16.0);
    near("measure min w has margins", sa.min_w, 4.0);

    // The same question after a change must not get the cached answer.
    layout.set_margin(&t, a, 5.0, 2.0, 3.0, 4.0);
    layout.measure(&t, a, &free, &sa);
    near("measure after a change is fresh", sa.pref_w, 28.0);

    // --- Alignment places the preferred size inside the area ---
    layout.set_margin(&t, a, 0.0, 0.0, 0.0, 0.0);
    layout.set_align(&t, a, layout.CENTER, layout.END);
    layout.run(&t, 100.0, 50.0);
    ra = rect_of(&t, a);
    near("center x", ra.x, 40.0);
    near("end y", ra.y, 40.0);
    near("aligned w is pref", ra.w, 20.0);
    near("aligned h is pref", ra.h, 10.0);

    layout.set_align(&t, a, layout.START, layout.START);
    layout.run(&t, 100.0, 50.0);
    near("start x ltr", rect_of(&t, a).x, 0.0);

    // Right-to-left mirrors start and end horizontally, never vertically.
    layout.set_direction(&t, root, layout.RTL);
    layout.run(&t, 100.0, 50.0);
    near("start x rtl", rect_of(&t, a).x, 80.0);
    near("start y rtl", rect_of(&t, a).y, 0.0);
    check("direction inherited", layout.direction(&t, a) == layout.RTL);
    layout.set_direction(&t, root, layout.LTR);

    // --- Overrides clamp the size ---
    layout.set_align(&t, a, layout.FILL, layout.FILL);
    layout.set_max_size(&t, a, 30.0, layout.UNBOUNDED);
    layout.run(&t, 100.0, 50.0);
    near("max clamps fill", rect_of(&t, a).w, 30.0);
    layout.set_max_size(&t, a, layout.UNBOUNDED, layout.UNBOUNDED);
    layout.set_min_size(&t, a, 0.0, 70.0);
    layout.run(&t, 100.0, 50.0);
    near("min beats a small area", rect_of(&t, a).h, 70.0);
    layout.set_min_size(&t, a, 0.0, 0.0);

    // --- Hidden widgets take no room and are not measured ---
    tree.set_visible(&t, a, 0);
    layout.measure(&t, a, &free, &sa);
    near("hidden pref w", sa.pref_w, 0.0);
    near("hidden min h", sa.min_h, 0.0);
    tree.set_visible(&t, a, 1);

    // --- The pass skips what did not change ---
    layout.run(&t, 100.0, 50.0);
    let is i64 as before with mut = arranged(&t, a);
    layout.run(&t, 100.0, 50.0);
    check("clean widget not arranged again", arranged(&t, a) == before);
    layout.invalidate(&t, a);
    layout.run(&t, 100.0, 50.0);
    check("invalidated widget arranged again", arranged(&t, a) == before + 1);

    // Moving without resizing only updates the position: rectangles are
    // relative to the parent, so nothing below has to be laid out again.
    layout.set_align(&t, a, layout.CENTER, layout.CENTER);
    layout.run(&t, 100.0, 50.0);
    before = arranged(&t, a);
    layout.run(&t, 120.0, 50.0);
    near("moved", rect_of(&t, a).x, 50.0);
    check("moved, not re-arranged", arranged(&t, a) == before);
    layout.run(&t, 120.0, 60.0);
    check("still same size, still not re-arranged", arranged(&t, a) == before);

    // --- Height for width: the final width decides the height ---
    tree.destroy(&t, a);
    let is i64 as para = leaf(&t, root, 100.0, 10.0);
    (cast(*Leaf, tree.data(&t, para))).wrap = 100.0;
    layout.set_align(&t, para, layout.FILL, layout.START);
    layout.run(&t, 50.0, 200.0);
    near("wrapped to two lines", rect_of(&t, para).h, 20.0);
    layout.run(&t, 25.0, 200.0);
    near("wrapped to four lines", rect_of(&t, para).h, 40.0);
    // Narrower than its area: the height has to come from its own width.
    layout.set_max_size(&t, para, 25.0, layout.UNBOUNDED);
    layout.run(&t, 50.0, 200.0);
    near("wrapped at its own width, not the area's", rect_of(&t, para).h, 40.0);

    // --- Nested: window coordinates add up the parents' offsets ---
    tree.destroy(&t, para);
    let is i64 as f = tree.create(&t, &frame_kind, root);
    layout.set_margin(&t, f, 10.0, 5.0, 0.0, 0.0);
    let is i64 as inner = leaf(&t, f, 8.0, 8.0);
    layout.set_margin(&t, inner, 2.0, 3.0, 0.0, 0.0);
    layout.run(&t, 100.0, 50.0);
    near("inner relative x", rect_of(&t, inner).x, 2.0);
    let is math.rect.Rect as wi = layout.window_rect(&t, inner);
    near("inner window x", wi.x, 12.0);
    near("inner window y", wi.y, 8.0);

    // --- The smallest window the content fits in ---
    layout.set_min_size(&t, inner, 30.0, 20.0);
    let is geom.Size as ms;
    layout.min_size(&t, &ms);
    near("min window w", ms.min_w, 42.0);
    near("min window h", ms.min_h, 28.0);

    tree.close(&t);
    if (fails != 0) { return 1; }
    io.printf("ui layout: all checks passed\n");
    return 0;
}
