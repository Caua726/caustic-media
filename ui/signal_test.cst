// ui/signal_test.cst — connecting callbacks to what widgets emit.
use "std/io.cst" as io;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "signal.cst" as signal;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL: %s: got %d, want %d\n", name, cast(i32, got), cast(i32, want));
        fails = fails + 1;
    }
}

// Each callback appends its tag (the user pointer's value) to a log, and
// remembers the argument it was given.
let is [64]i64 as log with mut;
let is i64 as logged with mut = 0;
let is i64 as last_arg with mut = 0;

fn reset() as void { logged = 0; }

fn record(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    if (logged < 64) { log[logged] = cast(i64, user); logged = logged + 1; }
    last_arg = cast(i64, arg);
}

// Callbacks that change things in the middle of an emission.
let is i64 as victim with mut = 0;      // a connection to disconnect
let is i64 as late with mut = 0;        // a connection made during emission

fn disconnects(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    record(t, w, arg, user);
    signal.disconnect(t, victim);
}

fn connects(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    record(t, w, arg, user);
    late = signal.connect(t, w, signal.CLICKED, fn_ptr(record), cast(*u8, 99));
}

fn destroys(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    record(t, w, arg, user);
    tree.destroy(t, w);
}

fn main() as i32 {
    let is widget.Kind as k = widget.kind("plain", 0);
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is i64 as b = tree.create(&t, &k, root);
    let is i64 as other = tree.create(&t, &k, root);

    // --- Every connection, in the order made, with the argument ---
    let is i64 as c1 = signal.connect(&t, b, signal.CLICKED, fn_ptr(record), cast(*u8, 1));
    let is i64 as c2 = signal.connect(&t, b, signal.CLICKED, fn_ptr(record), cast(*u8, 2));
    signal.connect(&t, b, signal.CHANGED, fn_ptr(record), cast(*u8, 3));
    signal.connect(&t, other, signal.CLICKED, fn_ptr(record), cast(*u8, 4));
    check("connected", c1 != 0 && c2 != 0 && c1 != c2);
    reset();
    eq("two called", signal.emit(&t, b, signal.CLICKED, cast(*u8, 77)), 2);
    eq("first first", log[0], 1);
    eq("then second", log[1], 2);
    eq("argument passed", last_arg, 77);

    // Only that widget's, only that signal's.
    reset();
    signal.emit(&t, b, signal.CHANGED, cast(*u8, 0));
    check("other signal, own callback", logged == 1 && log[0] == 3);

    // --- Disconnecting ---
    signal.disconnect(&t, c1);
    reset();
    signal.emit(&t, b, signal.CLICKED, cast(*u8, 0));
    check("disconnected not called", logged == 1 && log[0] == 2);
    signal.disconnect(&t, c1);   // twice is harmless
    signal.disconnect(&t, c2);

    // --- Changes made during an emission ---
    //
    // Disconnecting a later connection: it is not called.
    let is i64 as b2 = tree.create(&t, &k, root);
    signal.connect(&t, b2, signal.CLICKED, fn_ptr(disconnects), cast(*u8, 10));
    victim = signal.connect(&t, b2, signal.CLICKED, fn_ptr(record), cast(*u8, 11));
    reset();
    signal.emit(&t, b2, signal.CLICKED, cast(*u8, 0));
    check("disconnected mid-emission: not called", logged == 1 && log[0] == 10);

    // Connecting: the new one waits for the next emission.
    let is i64 as b3 = tree.create(&t, &k, root);
    signal.connect(&t, b3, signal.CLICKED, fn_ptr(connects), cast(*u8, 20));
    reset();
    signal.emit(&t, b3, signal.CLICKED, cast(*u8, 0));
    check("connected mid-emission: not called yet", logged == 1 && log[0] == 20);
    reset();
    signal.emit(&t, b3, signal.CLICKED, cast(*u8, 0));
    check("next emission calls it", logged == 2 && log[1] == 99);

    // Destroying the widget: the emission stops there.
    let is i64 as b4 = tree.create(&t, &k, root);
    signal.connect(&t, b4, signal.CLICKED, fn_ptr(destroys), cast(*u8, 30));
    signal.connect(&t, b4, signal.CLICKED, fn_ptr(record), cast(*u8, 31));
    reset();
    signal.emit(&t, b4, signal.CLICKED, cast(*u8, 0));
    check("destroyed mid-emission: rest not called", logged == 1 && log[0] == 30);
    eq("emitting on a destroyed widget calls nothing", signal.emit(&t, b4, signal.CLICKED, cast(*u8, 0)), 0);

    // --- A destroyed widget's connections come back when room runs out ---
    let is tree.Limits as small = tree.limits_default();
    small.connections = 4;
    let is tree.Tree as s = tree.open(&small);
    let is i64 as w1 = tree.create(&s, &k, tree.root(&s));
    let is i64 as n with mut = 0;
    while (n < 4) {
        signal.connect(&s, w1, signal.CLICKED, fn_ptr(record), cast(*u8, 50));
        n = n + 1;
    }
    eq("full", signal.connect(&s, w1, signal.CLICKED, fn_ptr(record), cast(*u8, 50)), 0);
    eq("full error", cast(i64, tree.last_error(&s)), cast(i64, tree.FULL));
    tree.clear_error(&s);
    tree.destroy(&s, w1);
    let is i64 as w2 = tree.create(&s, &k, tree.root(&s));
    let is i64 as again = signal.connect(&s, w2, signal.CLICKED, fn_ptr(record), cast(*u8, 60));
    check("room reclaimed from the destroyed widget", again != 0);
    reset();
    signal.emit(&s, w2, signal.CLICKED, cast(*u8, 0));
    check("and it works", logged == 1 && log[0] == 60);
    tree.close(&s);

    tree.close(&t);
    if (fails != 0) { return 1; }
    io.printf("ui signals: all checks passed\n");
    return 0;
}
