// ui/snap_test.cst — rectangles land on physical pixels, at any scale.
//
// Layout works in logical pixels, but a screen has whole physical ones: an
// edge at 33.33 is drawn blurred across two of them. So every rectangle is
// placed with its edges on the physical grid of the window's scale — its
// edges, not its size, so neighbours that share an edge share a pixel and
// nothing leaves a gap or overlaps.
use "std/io.cst" as io;
use "std/math.cst" as fm;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "box.cst" as box;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn near(name as *u8, got as f64, want as f64) as void {
    let is f64 as d = got - want;
    if (d > 0.000001 || d < 0.0 - 0.000001) {
        io.printf("FAIL: %s: got %d/1000, want %d/1000\n", name,
                  cast(i64, got * 1000.0), cast(i64, want * 1000.0));
        fails = fails + 1;
    }
}

// Whether v logical pixels at scale s is a whole number of physical ones.
fn on_grid(v as f64, s as f64) as i32 {
    let is f64 as p = v * s;
    let is f64 as d = p - fm.floor(p + 0.5);
    if (d < 0.000001 && d > 0.0 - 0.000001) { return 1; }
    return 0;
}

// Every edge of w, in window coordinates, on the grid.
fn snapped(t as *tree.Tree, w as i64, s as f64) as i32 {
    let is math.rect.Rect as r = layout.window_rect(t, w);
    if (on_grid(r.x, s) == 0 || on_grid(r.y, s) == 0) { return 0; }
    if (on_grid(r.x + r.w, s) == 0 || on_grid(r.y + r.h, s) == 0) { return 0; }
    return 1;
}

struct Leaf {
    w as f64;
    h as f64;
}

fn leaf_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Leaf as d = cast(*Leaf, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = d.w;
    out.pref_h = d.h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn leaf_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as leaf_kind with mut;

fn leaf(t as *tree.Tree, parent as i64, w as f64, h as f64) as i64 {
    let is i64 as k = tree.create(t, &leaf_kind, parent);
    let is *Leaf as d = cast(*Leaf, tree.data(t, k));
    d.w = w;
    d.h = h;
    return k;
}

fn main() as i32 {
    leaf_kind = widget.kind("leaf", sizeof(Leaf));
    leaf_kind.measure = fn_ptr(leaf_measure);
    leaf_kind.arrange = fn_ptr(leaf_arrange);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    near("the scale starts at 1", layout.scale(&t), 1.0);

    // --- Thirds of 100 at scale 1: 33, 34, 33, edge to edge ---
    let is i64 as row = box.create(&t, root, box.ROW);
    layout.set_align(&t, row, layout.START, layout.START);
    layout.set_min_size(&t, row, 100.0, 10.0);
    layout.set_max_size(&t, row, 100.0, 10.0);
    let is i64 as a = leaf(&t, row, 10.0, 10.0);
    let is i64 as b = leaf(&t, row, 10.0, 10.0);
    let is i64 as c = leaf(&t, row, 10.0, 10.0);
    layout.set_stretch(&t, a, 1.0, 0.0);
    layout.set_stretch(&t, b, 1.0, 0.0);
    layout.set_stretch(&t, c, 1.0, 0.0);
    layout.run(&t, 400.0, 300.0);
    let is math.rect.Rect as ra = layout.rect(&t, a);
    let is math.rect.Rect as rb = layout.rect(&t, b);
    let is math.rect.Rect as rc = layout.rect(&t, c);
    near("thirds: a starts at 0", ra.x, 0.0);
    near("thirds: a ends where 33.33 rounds", ra.x + ra.w, 33.0);
    near("thirds: b starts where a ends", rb.x, ra.x + ra.w);
    near("thirds: b ends where 66.67 rounds", rb.x + rb.w, 67.0);
    near("thirds: c starts where b ends", rc.x, rb.x + rb.w);
    near("thirds: c ends at 100", rc.x + rc.w, 100.0);

    // The same down a column.
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.END, layout.START);
    layout.set_min_size(&t, col, 10.0, 100.0);
    layout.set_max_size(&t, col, 10.0, 100.0);
    let is i64 as va = leaf(&t, col, 10.0, 10.0);
    let is i64 as vb = leaf(&t, col, 10.0, 10.0);
    let is i64 as vc = leaf(&t, col, 10.0, 10.0);
    layout.set_stretch(&t, va, 0.0, 1.0);
    layout.set_stretch(&t, vb, 0.0, 1.0);
    layout.set_stretch(&t, vc, 0.0, 1.0);
    layout.run(&t, 400.0, 300.0);
    near("column: a ends where 33.33 rounds", layout.rect(&t, va).y + layout.rect(&t, va).h, 33.0);
    near("column: b starts where a ends", layout.rect(&t, vb).y, 33.0);
    near("column: b ends where 66.67 rounds", layout.rect(&t, vb).y + layout.rect(&t, vb).h, 67.0);
    near("column: c ends at 100", layout.rect(&t, vc).y + layout.rect(&t, vc).h, 100.0);

    // --- At 1.5, the same row is 150 physical pixels: 50 each, exactly ---
    layout.set_scale(&t, 1.5);
    check("a new scale lays out again", tree.needs_layout(&t, root));
    check("a new scale repaints", tree.paint_wanted(&t));
    layout.run(&t, 400.0, 300.0);
    check("1.5: a on the grid", snapped(&t, a, 1.5));
    check("1.5: b on the grid", snapped(&t, b, 1.5));
    check("1.5: c on the grid", snapped(&t, c, 1.5));
    near("1.5: b is 50 physical pixels", layout.rect(&t, b).w * 1.5, 50.0);

    // --- Nested, at fractional positions: every edge still on the grid ---
    let is i64 as outer = leaf(&t, root, 41.3, 20.7);
    layout.set_align(&t, outer, layout.START, layout.START);
    layout.set_margin(&t, outer, 10.3, 50.45, 0.0, 0.0);
    let is i64 as inner = leaf(&t, outer, 7.1, 5.3);
    layout.set_align(&t, inner, layout.CENTER, layout.CENTER);
    let is [4]f64 as scales;
    scales[0] = 1.0;
    scales[1] = 1.25;
    scales[2] = 1.5;
    scales[3] = 2.0;
    let is i64 as k with mut = 0;
    while (k < 4) {
        let is f64 as sc = scales[k];
        layout.set_scale(&t, sc);
        layout.run(&t, 400.0, 300.0);
        check("nested: outer on the grid", snapped(&t, outer, sc));
        check("nested: inner on the grid", snapped(&t, inner, sc));
        check("nested: thirds on the grid", snapped(&t, b, sc));
        k = k + 1;
    }

    // At 2, a margin of 10.3 is 20.6 physical pixels and lands on 21.
    layout.set_scale(&t, 2.0);
    layout.run(&t, 400.0, 300.0);
    near("2: the margin rounds to the nearest half", layout.rect(&t, outer).x, 10.5);
    near("2: the far edge too", layout.rect(&t, outer).x + layout.rect(&t, outer).w, 51.5);

    // Centred with an odd pixel to spare: the edges round, the size stays.
    layout.set_scale(&t, 1.0);
    layout.run(&t, 400.0, 300.0);
    let is i64 as odd_box = leaf(&t, root, 20.0, 20.0);
    layout.set_align(&t, odd_box, layout.START, layout.START);
    layout.set_min_size(&t, odd_box, 20.0, 20.0);
    layout.set_max_size(&t, odd_box, 20.0, 20.0);
    let is i64 as odd = leaf(&t, odd_box, 11.0, 11.0);
    layout.set_align(&t, odd, layout.CENTER, layout.CENTER);
    layout.run(&t, 400.0, 300.0);
    near("centred: 4.5 rounds to 5", layout.rect(&t, odd).x, 5.0);
    near("centred: still 11 wide", layout.rect(&t, odd).w, 11.0);

    // --- A scale that is not positive is refused ---
    layout.set_scale(&t, 0.0);
    near("zero: refused", layout.scale(&t), 1.0);
    layout.set_scale(&t, 0.0 - 2.0);
    near("negative: refused", layout.scale(&t), 1.0);

    // --- Setting the same scale again changes nothing ---
    layout.run(&t, 400.0, 300.0);
    tree.damage_clear(&t);
    layout.set_scale(&t, 1.0);
    check("same scale: no layout", 1 - tree.needs_layout(&t, root));
    check("same scale: no repaint", 1 - tree.paint_wanted(&t));

    tree.close(&t);
    if (fails > 0) {
        io.printf("snap: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("snap: all checks passed\n");
    return 0;
}
