// ui/complex_text_test.cst — writing systems that join and reorder, in the
// widgets: Arabic's letters take their joining forms and read right to left;
// Devanagari's left vowel draws before the consonant it follows; in a label, an
// entry and a text view the caret and a selection go by whole clusters, a line
// breaks only where words end, and offsets in a cluster are its start.
//
// Run from the repository's root, where text/testdata is; the fonts are
// text/tools/script_reference.py's.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../math/math.cst" as math;
use "../gpu/gpu.cst" as gpu;
use "../input/keys.cst" as keys;
use "../text/sfnt/sfnt.cst" as sfnt;
use "../text/sfnt/table.cst" as table;
use "../text/sfnt/cmap.cst" as cmap;
use "../text/layout/font.cst" as font;
use "tree.cst" as tree;
use "layout.cst" as layout;
use "style.cst" as style;
use "router.cst" as router;
use "text.cst" as text;
use "widgets/label.cst" as label;
use "widgets/entry.cst" as entry;
use "widgets/textview.cst" as textview;

let is i64 as W with imut = 480;
let is i64 as H with imut = 300;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size);
    let is i64 as got with mut = 0;
    while (got < size) {
        let is i64 as k = linux.read(fd, cast(*u8, cast(i64, p) + got), size - got);
        if (k <= 0) { got = size; } else { got = got + k; }
    }
    linux.close(fd);
    loaded = size;
    return p;
}

let is [2]table.Face as faces with mut;
let is font.List as list with mut;
let is font.Font as both with mut;
let is style.Theme as theme with mut;
let is *text.Service as svc with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &both; }

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    text.lend(&t, svc);
    return t;
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

// Arabic: س ل ا م, salaam. Sin initial, lam medial, alef final, then a final
// mim's neighbour starts again: mim isolated.
let is *u8 as SALAM with imut = "\xd8\xb3\xd9\x84\xd8\xa7\xd9\x85";
let is i64 as SALAM_N with imut = 8;
// Devanagari: क ि, ki: the vowel written after, drawn before.
let is *u8 as KI with imut = "\xe0\xa4\x95\xe0\xa4\xbf";
// क ् ष, one conjunct; then म.
let is *u8 as KSHA_MA with imut = "\xe0\xa4\x95\xe0\xa5\x8d\xe0\xa4\xb7\xe0\xa4\xae";
// Two words of it, for lines to break between.
let is *u8 as WORDS with imut = "\xe0\xa4\x95\xe0\xa5\x8d\xe0\xa4\xb7\xe0\xa4\xae \xe0\xa4\x95\xe0\xa5\x8d\xe0\xa4\xb7\xe0\xa4\xae \xe0\xa4\x95\xe0\xa5\x8d\xe0\xa4\xb7\xe0\xa4\xae \xe0\xa4\x95\xe0\xa5\x8d\xe0\xa4\xb7\xe0\xa4\xae";
let is i64 as WORD_BYTES with imut = 12;

fn labels() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as lb = label.create(&t, tree.root(&t), SALAM, SALAM_N);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is *text.Run as run = label.run(&t, lb);
    check("arabic: a glyph for each letter", text.glyph_count(run) == 3 || text.glyph_count(run) == 4);
    // Drawn left to right: the last letter first, the first letter last.
    let is i64 as last = text.glyph_count(run) - 1;
    check("arabic: right to left, the first letter drawn last", text.glyph(run, last).cluster == 0 && text.glyph(run, 0).cluster > 0);
    let is i64 as sin = cmap.glyph(&faces[0], 1587);
    check("arabic: sin in its initial form, not as it stands alone", text.glyph(run, last).id != sin);
    let is i64 as mim = cmap.glyph(&faces[0], 1605);
    check("arabic: the mim after alef alone, as it stands", text.glyph(run, 0).id == mim || text.glyph(run, 0).id != sin);

    let is i64 as d = label.create(&t, tree.root(&t), KI, 6);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is *text.Run as dr = label.run(&t, d);
    check("devanagari: the vowel and the consonant", text.glyph_count(dr) == 2);
    check("devanagari: one cluster", text.glyph(dr, 0).cluster == 0 && text.glyph(dr, 1).cluster == 0);
    check("devanagari: the vowel drawn first", text.glyph(dr, 0).id != cmap.glyph(&faces[1], 2325) && text.glyph(dr, 1).id == cmap.glyph(&faces[1], 2325));

    let is i64 as k = label.create(&t, tree.root(&t), KSHA_MA, 12);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is *text.Run as kr = label.run(&t, k);
    check("devanagari: the conjunct one glyph, and the next", text.glyph_count(kr) == 2);
    check("devanagari: its cluster the first, the next the next", text.glyph(kr, 0).cluster == 0 && text.glyph(kr, 1).cluster == 9);
    tree.close(&t);
}

fn entries() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as e = entry.create(&t, tree.root(&t));
    layout.set_min_size(&t, e, 300.0, 0.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, e, 0);
    entry.set_text(&t, e, KSHA_MA, 12);
    layout.run(&t, cast(f64, W), cast(f64, H));
    entry.select(&t, e, 0, 0);
    key(&t, &r, keys.RIGHT, 0, 10);
    check("devanagari: the caret over a conjunct whole", entry.caret(&t, e) == 9);
    key(&t, &r, keys.RIGHT, 0, 20);
    check("devanagari: and the next", entry.caret(&t, e) == 12);
    key(&t, &r, keys.LEFT, 0, 30);
    check("devanagari: back the same way", entry.caret(&t, e) == 9);
    key(&t, &r, keys.BACKSPACE, 0, 40);
    check("devanagari: backspace takes the conjunct whole, as the arrows go", entry.caret(&t, e) == 0 && entry.length(&t, e) == 3);

    entry.set_text(&t, e, SALAM, SALAM_N);
    layout.run(&t, cast(f64, W), cast(f64, H));
    entry.select(&t, e, 0, 0);
    let is f64 as at_start = entry.caret_x(&t, e);
    entry.select(&t, e, SALAM_N, SALAM_N);
    let is f64 as at_end = entry.caret_x(&t, e);
    check("arabic: the caret starts on the right and ends on the left", at_end < at_start);
    entry.select(&t, e, 0, 0);
    key(&t, &r, keys.END, 0, 50);
    check("arabic: its end", entry.caret(&t, e) == SALAM_N);
    let is i64 as a with mut = 0;
    let is i64 as b with mut = 0;
    key(&t, &r, keys.A, keys.MOD_CONTROL, 60);
    check("arabic: all selected", entry.selection(&t, e, &a, &b) == 1 && a == 0 && b == SALAM_N);
    tree.close(&t);
}

fn views() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as tv = textview.create(&t, tree.root(&t));
    layout.set_min_size(&t, tv, 120.0, 200.0);
    layout.set_max_size(&t, tv, 120.0, 200.0);
    layout.set_align(&t, tv, layout.START, layout.START);
    textview.set_text(&t, tv, WORDS, WORD_BYTES * 4 + 3);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, tv, 0);
    let is f64 as y0 = textview.rect_of(&t, tv, 0).y;
    let is f64 as y3 = textview.rect_of(&t, tv, (WORD_BYTES + 1) * 3).y;
    check("devanagari: wrapped in the view", y3 > y0);
    // Every word starts a line or follows a space: never broken inside one.
    let is i64 as w with mut = 0;
    while (w < 4) {
        let is i64 as at = (WORD_BYTES + 1) * w;
        check("devanagari: the conjunct and what follows on one line", textview.rect_of(&t, tv, at).y == textview.rect_of(&t, tv, at + 9).y);
        w = w + 1;
    }
    // From where a cluster is, an offset only at its start or end.
    let is math.rect.Rect as first = textview.rect_of(&t, tv, 0);
    let is f64 as x with mut = first.x;
    let is f64 as end_x = first.x + first.w;
    let is i32 as whole with mut = 1;
    while (x < end_x) {
        let is i64 as off = textview.offset_at(&t, tv, x, first.y + first.h / 2.0);
        if (off != 0 && off != 9) { whole = 0; }
        x = x + 1.0;
    }
    check("devanagari: a point in a conjunct gives its start or end", whole);
    textview.select(&t, tv, 0, 0);
    key(&t, &r, keys.RIGHT, 0, 10);
    check("devanagari: the caret over it whole", textview.caret(&t, tv) == 9);

    textview.set_text(&t, tv, SALAM, SALAM_N);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("arabic: its first letter right of its last", textview.rect_of(&t, tv, 0).x > textview.rect_of(&t, tv, 6).x);
    textview.select(&t, tv, 0, SALAM_N);
    let is i64 as a with mut = 0;
    let is i64 as b with mut = 0;
    check("arabic: selected", textview.selection(&t, tv, &a, &b) == 1 && a == 0 && b == SALAM_N);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as ar = load("text/testdata/scripts/NotoSansArabic-Regular.ttf");
    let is i64 as ar_n = loaded;
    let is *u8 as de = load("text/testdata/scripts/NotoSansDevanagari-Regular.ttf");
    let is i64 as de_n = loaded;
    if (cast(i64, ar) == 0 || cast(i64, de) == 0) {
        io.printf("FAIL: cannot read the test fonts\n");
        return 1;
    }
    faces[0] = sfnt.open(ar, ar_n, 0);
    faces[1] = sfnt.open(de, de_n, 0);
    list.faces = cast(*table.Face, &faces);
    list.n = 2;
    both = font.of_list(&list);
    theme = style.light();
    theme.fonts.body.size = 20.0;
    let is gpu.device.Device as dv with mut = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);
    labels();
    entries();
    views();
    if (fails == 0) {
        io.printf("complex text: %d checks passed\n", checks);
        return 0;
    }
    io.printf("complex text: %d of %d checks failed\n", fails, checks);
    return 1;
}
