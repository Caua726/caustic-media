// ui/atspi/names_test.cst — the toolkit's roles, states and actions in
// AT-SPI's numbers and names.
use "std/io.cst" as io;
use "../access.cst" as access;
use "names.cst" as names;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn same(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, a[i] == 0);
}

fn has(set as i64, bit as i64) as i32 { return cast(i32, (set & (1 << bit)) != 0); }

fn main() as i32 {
    // --- Roles: every access role, its AT-SPI number and name ---
    check("a window: a frame", names.role(access.ROLE_WINDOW) == 23 && same(names.role_name(23), "frame") == 1);
    check("a button: a push button", names.role(access.ROLE_BUTTON) == 43 && same(names.role_name(43), "button") == 1);
    check("an entry", names.role(access.ROLE_ENTRY) == 79 && same(names.role_name(79), "entry") == 1);
    check("a password", names.role(access.ROLE_PASSWORD) == 40 && same(names.role_name(40), "password text") == 1);
    check("a switch", names.role(access.ROLE_SWITCH) == 130 && same(names.role_name(130), "switch") == 1);
    check("nothing to say: a filler", names.role(access.ROLE_NONE) == 20 && same(names.role_name(20), "filler") == 1);
    check("the application", same(names.role_name(names.R_APPLICATION), "application") == 1);
    check("a number that is none: invalid", same(names.role_name(9999), "invalid") == 1);
    // Every role has a name of its own, never "invalid".
    let is i64 as r with mut = 1;
    let is i32 as named with mut = 1;
    while (r <= access.ROLE_LAST) {
        if (same(names.role_name(names.role(r)), "invalid") == 1 || names.role(r) == names.R_FILLER) { named = 0; }
        r = r + 1;
    }
    check("every role but none: a role of its own, named", named == 1);
    let is [46]i64 as want;
    want[1] = 23; want[2] = 16; want[3] = 2; want[4] = 39; want[5] = 29; want[6] = 43; want[7] = 62; want[8] = 88;
    want[9] = 7; want[10] = 44; want[11] = 130; want[12] = 51; want[13] = 52; want[14] = 42; want[15] = 50; want[16] = 27;
    want[17] = 99; want[18] = 64; want[19] = 79; want[20] = 40; want[21] = 61; want[22] = 49; want[23] = 48; want[24] = 53;
    want[25] = 38; want[26] = 37; want[27] = 31; want[28] = 32; want[29] = 65; want[30] = 91; want[31] = 55; want[32] = 56;
    want[33] = 10; want[34] = 11; want[35] = 34; want[36] = 33; want[37] = 35; want[38] = 8; want[39] = 45; want[40] = 63;
    want[41] = 54; want[42] = 104; want[43] = 90; want[44] = 9; want[45] = 22;
    let is i32 as right with mut = 1;
    r = 1;
    while (r <= access.ROLE_LAST) {
        if (names.role(r) != want[r]) {
            io.printf("  role %d: %d, want %d\n", r, names.role(r), want[r]);
            right = 0;
        }
        r = r + 1;
    }
    check("each its AT-SPI number", right == 1);

    // --- States ---
    let is i64 as s = names.states(access.VISIBLE | access.SHOWING | access.ENABLED | access.FOCUSABLE | access.FOCUSED, 0, 0);
    check("the tree's states", has(s, names.S_VISIBLE) == 1 && has(s, names.S_SHOWING) == 1 && has(s, names.S_ENABLED) == 1 &&
          has(s, names.S_SENSITIVE) == 1 && has(s, names.S_FOCUSABLE) == 1 && has(s, names.S_FOCUSED) == 1 &&
          has(s, names.S_CHECKED) == 0);
    check("nothing: nothing", names.states(0, 0, 0) == 0);
    check("checked, mixed, pressed", names.states(access.CHECKABLE | access.CHECKED, 0, 0) ==
          ((1 << names.S_CHECKABLE) | (1 << names.S_CHECKED)) &&
          names.states(access.MIXED, 0, 0) == (1 << names.S_INDETERMINATE) &&
          names.states(access.PRESSED, 0, 0) == (1 << names.S_PRESSED));
    check("expandable, not expanded: collapsed", names.states(access.EXPANDABLE, 0, 0) ==
          ((1 << names.S_EXPANDABLE) | (1 << names.S_COLLAPSED)));
    check("expanded: not collapsed", names.states(access.EXPANDABLE | access.EXPANDED, 0, 0) ==
          ((1 << names.S_EXPANDABLE) | (1 << names.S_EXPANDED)));
    check("selectable, selected, multiselectable", names.states(access.SELECTABLE | access.SELECTED | access.MULTISELECTABLE, 0, 0) ==
          ((1 << names.S_SELECTABLE) | (1 << names.S_SELECTED) | (1 << names.S_MULTISELECTABLE)));
    check("editable, read-only, required, busy", names.states(access.EDITABLE, 0, 0) == (1 << names.S_EDITABLE) &&
          names.states(access.READ_ONLY, 0, 0) == (1 << names.S_READ_ONLY) &&
          names.states(access.REQUIRED, 0, 0) == (1 << names.S_REQUIRED) &&
          names.states(access.BUSY, 0, 0) == (1 << names.S_BUSY));
    check("lines and directions", names.states(access.MULTI_LINE, 0, 1) == (1 << names.S_MULTI_LINE) &&
          names.states(0, 0, 1) == (1 << names.S_SINGLE_LINE) &&
          names.states(access.HORIZONTAL, 0, 0) == (1 << names.S_HORIZONTAL) &&
          names.states(access.VERTICAL, 0, 0) == (1 << names.S_VERTICAL));
    check("default, visited, modal, invalid", names.states(access.DEFAULT, 0, 0) == (1 << names.S_IS_DEFAULT) &&
          names.states(access.VISITED, 0, 0) == (1 << names.S_VISITED) &&
          names.states(access.MODAL, 0, 0) == (1 << names.S_MODAL) &&
          names.states(access.INVALID, 0, 0) == (1 << names.S_INVALID_ENTRY));
    check("bits past 31 kept", has(names.states(access.MIXED, 0, 0), 32) == 1 && has(names.states(access.READ_ONLY, 0, 0), 43) == 1);
    check("state names", same(names.state_name(names.S_FOCUSED), "focused") == 1 &&
          same(names.state_name(names.S_CHECKED), "checked") == 1 &&
          same(names.state_name(names.S_INDETERMINATE), "indeterminate") == 1 &&
          same(names.state_name(names.S_READ_ONLY), "read-only") == 1 &&
          cast(i64, names.state_name(63)) == 0);
    let is i64 as bit with mut = 0;
    let is i64 as all = names.states(0 - 1, 0, 1) | (1 << names.S_ACTIVE) | (1 << names.S_SINGLE_LINE);
    let is i32 as told with mut = 1;
    while (bit < 64) {
        if ((all & (1 << bit)) != 0 && cast(i64, names.state_name(bit)) == 0) {
            io.printf("  state %d: no name\n", bit);
            told = 0;
        }
        bit = bit + 1;
    }
    check("every state set: named", told == 1);

    // --- Actions ---
    let is i64 as acts = access.PRESS | access.INCREMENT | access.SHOW_MENU;
    check("three actions", names.action_count(acts) == 3);
    check("in order", names.nth_action(acts, 0) == access.PRESS && names.nth_action(acts, 1) == access.INCREMENT &&
          names.nth_action(acts, 2) == access.SHOW_MENU && names.nth_action(acts, 3) == 0);
    check("named", same(names.action_name(access.PRESS), "click") == 1 && same(names.action_name(access.TOGGLE), "toggle") == 1 &&
          same(names.action_name(access.INCREMENT), "increment") == 1 && same(names.action_name(access.DECREMENT), "decrement") == 1 &&
          same(names.action_name(access.EXPAND), "expand") == 1 && same(names.action_name(access.COLLAPSE), "collapse") == 1 &&
          same(names.action_name(access.SELECT), "select") == 1 && same(names.action_name(access.SHOW_MENU), "menu") == 1 &&
          same(names.action_name(access.SET_VALUE), "") == 1);
    let is i64 as every = access.PRESS | access.TOGGLE | access.INCREMENT | access.DECREMENT | access.EXPAND | access.COLLAPSE |
                          access.SELECT | access.SHOW_MENU;
    check("all of them", names.action_count(every) == 8 && names.nth_action(every, 7) == access.SHOW_MENU &&
          names.nth_action(every, 4) == access.EXPAND && names.nth_action(every, 0 - 1) == 0);
    check("setting a value is no action", names.action_count(access.SET_VALUE) == 0);

    if (fails == 0) {
        io.printf("atspi names: all checks passed\n");
        return 0;
    }
    io.printf("atspi names: %d failures\n", fails);
    return 1;
}
