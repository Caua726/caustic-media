// ui/atspi/object.cst — the object a call is answered for, and references
// to objects.
//
// Every handler finds what it answers for from the path it was called at
// (dbus.conn.current_path): the application's root, or a widget told. An
// interface that does not apply to the object — Value on a button — answers
// UnknownInterface, and GetInterfaces says which do.
use "std/mem.cst" as mem;
use "../../dbus/dbus.cst" as dbus;
use "../tree.cst" as tree;
use "../router.cst" as router;
use "../app.cst" as app;
use "../access.cst" as access;
use "bridge.cst" as bridge;
use "names.cst" as names;

let is *u8 as I_ACCESSIBLE  with imut = "org.a11y.atspi.Accessible";
let is *u8 as I_APPLICATION with imut = "org.a11y.atspi.Application";
let is *u8 as I_COMPONENT   with imut = "org.a11y.atspi.Component";
let is *u8 as I_ACTION      with imut = "org.a11y.atspi.Action";
let is *u8 as I_VALUE       with imut = "org.a11y.atspi.Value";
let is *u8 as I_TEXT        with imut = "org.a11y.atspi.Text";
let is *u8 as I_EDITABLE    with imut = "org.a11y.atspi.EditableText";
let is *u8 as I_SELECTION   with imut = "org.a11y.atspi.Selection";
let is *u8 as I_TABLE       with imut = "org.a11y.atspi.Table";

// --- The object asked about ---

// What the call being answered is at: the root (win 0), or a widget told.
struct Obj {
    win  as i64;
    t    as *tree.Tree;
    w    as i64;
    r    as *router.Router;
    q    as tree.Access;   // what access.describe says of it
}

fn _bridge(user as *u8) as *bridge.Bridge { return cast(*bridge.Bridge, user); }

// Widget w of window win, as told: 1, or 0 for one not told — its window
// not shown, the widget gone, hidden or with no role. One still there is
// described all the same.
fn describe(b as *bridge.Bridge, win as i64, w as i64, o as *Obj) as i32 {
    o.win = win;
    o.t = bridge.tree_of(b, win);
    o.w = w;
    o.r = cast(*router.Router, 0);
    mem.memset(cast(*u8, &o.q), 0, sizeof(tree.Access));
    if (cast(i64, o.t) == 0 || tree.is_valid(o.t, w) == 0) { return 0; }
    o.r = app.router(b.a, win);
    access.describe(o.t, o.r, w, &o.q);
    // A window's root is a frame, or a dialog for a dialog's window, named by
    // its title.
    if (w == tree.root(o.t)) {
        if (app.is_dialog(b.a, win) == 1) { o.q.role = access.ROLE_DIALOG; }
        if (o.q.name_len == 0) {
            o.q.name = app.title(b.a, win);
            o.q.name_len = app.title_length(b.a, win);
        }
    }
    return bridge.exposed(o.t, w);
}

// The object at the path being answered: 1, or 0 when it is gone.
fn find(c as *dbus.conn.Conn, b as *bridge.Bridge, o as *Obj) as i32 {
    o.win = 0;
    o.t = cast(*tree.Tree, 0);
    o.w = 0;
    o.r = cast(*router.Router, 0);
    mem.memset(cast(*u8, &o.q), 0, sizeof(tree.Access));
    let is *u8 as p = dbus.conn.current_path(c);
    if (cast(i64, p) == 0) { return 0; }
    if (dbus.message.named(p, bridge.ROOT_PATH) == 1) { return 1; }
    let is i64 as win with mut = 0;
    let is i64 as w with mut = 0;
    if (bridge.parse(p, dbus.wire.cstr_len(p), &win, &w) == 0) { return 0; }
    return describe(b, win, w, o);
}

// Its states, as AT-SPI has them.
fn states(b as *bridge.Bridge, o as *Obj) as i64 {
    if (o.win == 0) { return 0; }
    let is tree.TextQuery as tq;
    let is i32 as text = cast(i32, access.text_info(o.t, o.w, &tq) == 1 && tq.editable == 1);
    let is i64 as s with mut = names.states(o.q.states, o.q.role, text);
    // A window the platform has the keyboard in is the active one.
    if (o.w == tree.root(o.t) && app.is_active(b.a, o.win) == 1) { s = s | (1 << names.S_ACTIVE); }
    return s;
}

fn gone(k as *dbus.conn.Call) as void {
    k.error_name = dbus.conn.E_UNKNOWN_OBJECT;
    k.error_text = "no such accessible";
}

fn not_here(k as *dbus.conn.Call) as void {
    k.error_name = dbus.conn.E_UNKNOWN_INTERFACE;
    k.error_text = "not an interface of this accessible";
}

// A reference: the bridge's bus name and win/w's path; the root's for win 0.
fn put_ref(b as *bridge.Bridge, w as *dbus.wire.Writer, win as i64, wid as i64) as void {
    dbus.wire.put_struct(w);
    dbus.wire.put_string(w, dbus.conn.unique_name(&b.bus));
    dbus.wire.put_path(w, bridge.path_of(b, win, wid));
}

// The reference to nothing.
fn put_null(b as *bridge.Bridge, w as *dbus.wire.Writer) as void {
    dbus.wire.put_struct(w);
    dbus.wire.put_string(w, dbus.conn.unique_name(&b.bus));
    dbus.wire.put_path(w, bridge.NULL_PATH);
}

// --- What applies to an object ---

let is i64 as F_ACCESSIBLE  with imut = 1;
let is i64 as F_APPLICATION with imut = 2;
let is i64 as F_COMPONENT   with imut = 4;
let is i64 as F_ACTION      with imut = 8;
let is i64 as F_VALUE       with imut = 16;
let is i64 as F_TEXT        with imut = 32;
let is i64 as F_EDITABLE    with imut = 64;
let is i64 as F_SELECTION   with imut = 128;
let is i64 as F_TABLE       with imut = 256;

// Whether a role's children are chosen among: a list's, a tree's, a
// table's, a tab list's.
fn selects(role as i64) as i32 {
    return cast(i32, role == access.ROLE_LIST || role == access.ROLE_TREE || role == access.ROLE_TABLE ||
                     role == access.ROLE_TAB_LIST);
}

fn interfaces(o as *Obj) as i64 {
    if (o.win == 0) { return F_ACCESSIBLE | F_APPLICATION; }
    let is i64 as f with mut = F_ACCESSIBLE | F_COMPONENT;
    if (names.action_count(o.q.actions) > 0) { f = f | F_ACTION; }
    if (o.q.has_value == 1) { f = f | F_VALUE; }
    let is tree.TextQuery as tq;
    if (access.text_info(o.t, o.w, &tq) == 1) {
        f = f | F_TEXT;
        if (tq.editable == 1) { f = f | F_EDITABLE; }
    }
    if (selects(o.q.role) == 1) { f = f | F_SELECTION; }
    if (o.q.role == access.ROLE_TABLE) { f = f | F_TABLE; }
    return f;
}

// The object asked about, with interface f: 1, or 0 with the error set.
fn called(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8, f as i64, o as *Obj) as i32 {
    if (find(c, _bridge(user), o) == 0) {
        gone(k);
        return 0;
    }
    if ((interfaces(o) & f) == 0) {
        not_here(k);
        return 0;
    }
    return 1;
}

