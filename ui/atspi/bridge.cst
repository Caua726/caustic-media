// ui/atspi/bridge.cst — the bridge's state, and the objects it tells of.
//
// Every widget told is named by a path made of its window's handle and its
// own: /org/a11y/atspi/accessible/<window>_<widget>. The application is
// /org/a11y/atspi/accessible/root. What is told — exposed — is a window's
// root, and below it every widget showing that has a role (access.role);
// one with none, a box that only arranges, is passed through, its children
// told as its nearest exposed ancestor's.
use "std/mem.cst" as mem;
use "../../math/math.cst" as math;
use "../../dbus/dbus.cst" as dbus;
use "../tree.cst" as tree;
use "../layout.cst" as layout;
use "../app.cst" as app;
use "../access.cst" as access;

// Where the bridge is in its conversation (atspi.md).
let is i32 as OFF       with imut = 0;   // not opened
let is i32 as ASKING    with imut = 1;   // is anyone listening?
let is i32 as ADDRESS   with imut = 2;   // where is the accessibility bus?
let is i32 as EMBEDDING with imut = 3;   // here we are
let is i32 as ON        with imut = 4;
let is i32 as NOBODY    with imut = 5;   // nobody listening; waiting to be asked for
let is i32 as FAILED    with imut = 6;   // no session bus, or it would not have us

let is *u8 as ROOT_PATH with imut = "/org/a11y/atspi/accessible/root";
let is *u8 as PREFIX    with imut = "/org/a11y/atspi/accessible";
let is *u8 as NULL_PATH with imut = "/org/a11y/atspi/null";

// A change to tell, queued by the trees' watch and told in pump.
struct Change {
    win    as i64;
    w      as i64;
    what   as i32;    // tree.WATCH_*
    _pad0  as i32;
    parent as i64;    // REMOVED: the parent told it was under (0: it was not told), and where
    index  as i64;
    how    as i64;    // TEXT: tree.TEXT_INSERTED or TEXT_DELETED, at character `at`, chars of them
    at     as i64;
    chars  as i64;
    text   as i64;    // what went in or out: where in the bridge's change texts, len bytes of it kept
    len    as i64;
}

// What was last told of a widget, so only changes are told again.
struct Seen {
    win      as i64;   // 0 for a free slot
    w        as i64;
    states   as i64;   // AT-SPI's set
    name     as i64;   // a hash of its name
    desc     as i64;
    value    as f64;
    caret    as i64;   // characters; -1 for none
    sel_a    as i64;
    sel_b    as i64;
    text     as i64;   // its text: where in the bridge's texts, -1 for none kept
    text_len as i64;
}

let is i64 as MAX_CHANGES with imut = 256;
let is i64 as CHANGE_TEXTS with imut = 262144;   // bytes of texts changed kept between pumps
let is i64 as CHANGE_KEEP  with imut = 65536;    // of one change: an event a bus carries
let is i64 as BUS_BUFFER   with imut = 16777216; // the largest message to or from the accessibility bus
let is i64 as TEXT_REPLY   with imut = 8388608;  // the most of a text one reply holds
let is i64 as MAX_SEEN    with imut = 1024;
let is i64 as MAX_WINDOWS with imut = 16;

struct Bridge {
    a            as *app.App;
    stage        as i32;
    id           as i32;          // Application.Id, as the registry sets it
    name         as [64]u8;       // the application's
    name_len     as i64;
    session      as dbus.conn.Conn;
    bus          as dbus.conn.Conn;
    has_session  as i32;
    has_bus      as i32;
    status_match as i64;
    desktop_name as [256]u8;      // our root's parent, as Embed answered
    desktop_path as [256]u8;
    path         as [96]u8;       // a path being written
    changes      as *Change;      // MAX_CHANGES of them while on
    nchanges     as i64;
    ctexts       as *u8;          // CHANGE_TEXTS bytes while on: the texts of the changes queued
    ctexts_len   as i64;
    overflow     as i32;          // more changes came than were kept: everything seen compared again
    _pad0        as i32;
    seen         as *Seen;        // MAX_SEEN of them while on
    clock        as i64;          // the slot taken next when every one is
    texts        as *u8;          // the texts seen, one after another
    texts_len    as i64;
    texts_cap    as i64;
    texts_live   as i64;          // bytes of them some Seen still holds
    wins         as [16]i64;      // the windows watched, and how they were last told
    win_shown    as [16]i32;
    win_active   as [16]i32;
    win_root     as [16]i64;      // its tree's root, for when the tree is gone
    nwins        as i64;
    focus_win    as i64;          // the widget told focused last
    focus_w      as i64;
    cps          as *i32;         // a text in code points, for its words
    cps_cap      as i64;
}

// --- Paths ---

fn _digits(v as i64, out as *u8) as i64 {
    let is [24]u8 as tmp;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    if (x == 0) {
        tmp[0] = 48;
        n = 1;
    }
    while (x > 0) {
        tmp[n] = cast(u8, 48 + x % 10);
        n = n + 1;
        x = x / 10;
    }
    let is i64 as k with mut = 0;
    while (k < n) {
        out[k] = tmp[n - 1 - k];
        k = k + 1;
    }
    return n;
}

// The path of widget w of window win, into b.path: the root's for win 0.
fn path_of(b as *Bridge, win as i64, w as i64) as *u8 {
    let is *u8 as p = cast(*u8, &b.path);
    if (win == 0) {
        let is i64 as n = dbus.wire.cstr_len(ROOT_PATH);
        mem.memcpy(p, ROOT_PATH, n + 1);
        return p;
    }
    let is i64 as n with mut = dbus.wire.cstr_len(PREFIX);
    mem.memcpy(p, PREFIX, n);
    p[n] = 47;
    n = n + 1;
    n = n + _digits(win, cast(*u8, cast(i64, p) + n));
    p[n] = 95;
    n = n + 1;
    n = n + _digits(w, cast(*u8, cast(i64, p) + n));
    p[n] = 0;
    return p;
}

// The window and widget a path names: 1, or 0 for one of no widget's shape
// (the root's included). Nothing is checked to be there.
fn parse(path as *u8, n as i64, win as *i64, w as *i64) as i32 {
    let is i64 as k = dbus.wire.cstr_len(PREFIX);
    if (n <= k + 3 || mem.memcmp(path, PREFIX, k) != 0 || path[k] != 47) { return 0; }
    let is i64 as i with mut = k + 1;
    let is i64 as a with mut = 0;
    let is i64 as digits with mut = 0;
    while (i < n && path[i] >= 48 && path[i] <= 57 && digits < 19) {
        a = a * 10 + cast(i64, path[i]) - 48;
        i = i + 1;
        digits = digits + 1;
    }
    if (digits == 0 || i >= n || path[i] != 95) { return 0; }
    i = i + 1;
    let is i64 as c with mut = 0;
    digits = 0;
    while (i < n && path[i] >= 48 && path[i] <= 57 && digits < 19) {
        c = c * 10 + cast(i64, path[i]) - 48;
        i = i + 1;
        digits = digits + 1;
    }
    if (digits == 0 || i != n) { return 0; }
    *win = a;
    *w = c;
    return 1;
}

// --- What is told ---

// A shown window's tree; null for a window not open or not shown.
fn tree_of(b as *Bridge, win as i64) as *tree.Tree {
    if (app.is_shown(b.a, win) == 0) { return cast(*tree.Tree, 0); }
    return app.tree(b.a, win);
}

// Whether w is told: its tree's root, or a widget showing that says it has
// a role.
fn exposed(t as *tree.Tree, w as i64) as i32 {
    if (tree.is_valid(t, w) == 0) { return 0; }
    if (w == tree.root(t)) { return 1; }
    if (tree.is_visible(t, w) == 0) { return 0; }
    return cast(i32, access.role(t, w) != access.ROLE_NONE);
}

// Whether the path names something told: 1, with its window and widget.
fn resolve(b as *Bridge, path as *u8, n as i64, win as *i64, w as *i64) as i32 {
    if (parse(path, n, win, w) == 0) { return 0; }
    let is *tree.Tree as t = tree_of(b, *win);
    if (cast(i64, t) == 0) { return 0; }
    return exposed(t, *w);
}

// The children of w told, in order, through those not told: how many there
// are, and the index-th of them into *at (0 when there are fewer).
fn _children(t as *tree.Tree, w as i64, index as i64, count as *i64, at as *i64) as void {
    let is i64 as c with mut = tree.first_child(t, w);
    while (c != 0) {
        if (tree.is_hidden_here(t, c) == 0) {
            if (access.role(t, c) != access.ROLE_NONE) {
                if (*count == index) { *at = c; }
                *count = *count + 1;
            } else {
                _children(t, c, index, count, at);
            }
        }
        c = tree.next_sibling(t, c);
    }
}

fn child_count(t as *tree.Tree, w as i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as at with mut = 0;
    _children(t, w, 0 - 1, &n, &at);
    return n;
}

// The index-th child told, 0 for none.
fn child_at(t as *tree.Tree, w as i64, index as i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as at with mut = 0;
    if (index < 0) { return 0; }
    _children(t, w, index, &n, &at);
    return at;
}

// The widget w is told under: its nearest ancestor told; 0 for the root.
fn parent_of(t as *tree.Tree, w as i64) as i64 {
    if (w == tree.root(t)) { return 0; }
    let is i64 as p with mut = tree.parent(t, w);
    while (p != 0 && exposed(t, p) == 0) { p = tree.parent(t, p); }
    return p;
}

// Where w is among its parent's children told; -1 when it is not there.
fn index_of(t as *tree.Tree, w as i64) as i64 {
    let is i64 as p = parent_of(t, w);
    if (p == 0) { return 0 - 1; }
    let is i64 as n = child_count(t, p);
    let is i64 as i with mut = 0;
    while (i < n) {
        if (child_at(t, p, i) == w) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// --- The application's windows told ---

// How many shown windows the application has, and the index-th of them.
fn window_count(b as *Bridge) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as h with mut = app.next_window(b.a, 0);
    while (h != 0) {
        if (app.is_shown(b.a, h) == 1) { n = n + 1; }
        h = app.next_window(b.a, h);
    }
    return n;
}

fn window_at(b as *Bridge, index as i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as h with mut = app.next_window(b.a, 0);
    while (h != 0) {
        if (app.is_shown(b.a, h) == 1) {
            if (n == index) { return h; }
            n = n + 1;
        }
        h = app.next_window(b.a, h);
    }
    return 0;
}

fn window_index(b as *Bridge, win as i64) as i64 {
    let is i64 as n = window_count(b);
    let is i64 as i with mut = 0;
    while (i < n) {
        if (window_at(b, i) == win) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// --- Where things are ---

// AtspiCoordType.
let is i64 as COORD_SCREEN with imut = 0;
let is i64 as COORD_WINDOW with imut = 1;
let is i64 as COORD_PARENT with imut = 2;

// Where the origin of coord's kind is, in the window: the window's own, the
// screen's (from where the platform says the window is), or w's parent's.
fn origin(b as *Bridge, win as i64, t as *tree.Tree, w as i64, coord as i64, ox as *f64, oy as *f64) as void {
    *ox = 0.0;
    *oy = 0.0;
    if (coord == COORD_SCREEN) {
        let is f64 as sx with mut = 0.0;
        let is f64 as sy with mut = 0.0;
        app.position(b.a, win, &sx, &sy);
        *ox = 0.0 - sx;
        *oy = 0.0 - sy;
    }
    if (coord == COORD_PARENT) {
        let is i64 as p = parent_of(t, w);
        if (p != 0) {
            let is math.rect.Rect as pr = layout.window_rect(t, p);
            *ox = pr.x;
            *oy = pr.y;
        }
    }
}

// w's rectangle in coord's coordinates.
fn extents(b as *Bridge, win as i64, t as *tree.Tree, w as i64, coord as i64) as math.rect.Rect {
    let is math.rect.Rect as r with mut = layout.window_rect(t, w);
    let is f64 as ox with mut = 0.0;
    let is f64 as oy with mut = 0.0;
    origin(b, win, t, w, coord, &ox, &oy);
    r.x = r.x - ox;
    r.y = r.y - oy;
    return r;
}
