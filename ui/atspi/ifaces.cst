// ui/atspi/ifaces.cst — the D-Bus interfaces the bridge's objects answer.
//
// One set of tables for every widget (a dbus subtree) and one for the
// application's root: Accessible, Application, Component, Action and Value
// here; Text and EditableText in text.cst, Selection in selection.cst,
// Table in table.cst.
use "std/mem.cst" as mem;
use "../../math/math.cst" as math;
use "../../dbus/dbus.cst" as dbus;
use "../tree.cst" as tree;
use "../layout.cst" as layout;
use "../router.cst" as router;
use "../app.cst" as app;
use "../access.cst" as access;
use "../strings.cst" as strings;
use "bridge.cst" as bridge;
use "names.cst" as names;
use "object.cst" as obj;
use "text.cst" as atext;
use "selection.cst" as selection;
use "table.cst" as table;

fn _bridge(user as *u8) as *bridge.Bridge { return cast(*bridge.Bridge, user); }

// Whether a subtree path names a widget told: dbus asks before every call.
fn exists(user as *u8, p as *u8, n as i64) as i32 {
    let is i64 as win with mut = 0;
    let is i64 as w with mut = 0;
    return bridge.resolve(_bridge(user), p, n, &win, &w);
}

// --- Accessible ---

fn _role(b as *bridge.Bridge, o as *obj.Obj) as i64 {
    if (o.win == 0) { return names.R_APPLICATION; }
    return names.role(o.q.role);
}

fn child_count_of(b as *bridge.Bridge, o as *obj.Obj) as i64 {
    if (o.win == 0) { return bridge.window_count(b); }
    return bridge.child_count(o.t, o.w);
}

fn put_child(b as *bridge.Bridge, w as *dbus.wire.Writer, o as *obj.Obj, i as i64) as void {
    if (o.win == 0) {
        let is i64 as h = bridge.window_at(b, i);
        if (h == 0) {
            obj.put_null(b, w);
            return;
        }
        obj.put_ref(b, w, h, tree.root(app.tree(b.a, h)));
        return;
    }
    let is i64 as ch = bridge.child_at(o.t, o.w, i);
    if (ch == 0) {
        obj.put_null(b, w);
        return;
    }
    obj.put_ref(b, w, o.win, ch);
}

fn m_child_at(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    put_child(_bridge(user), k.reply, &o, dbus.wire.get_i32(&k.args));
}

fn m_children(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    let is *bridge.Bridge as b = _bridge(user);
    let is i64 as n = child_count_of(b, &o);
    let is i64 as at = dbus.wire.put_array(k.reply, 8);
    let is i64 as i with mut = 0;
    while (i < n) {
        put_child(b, k.reply, &o, i);
        i = i + 1;
    }
    dbus.wire.put_array_end(k.reply, at, 8);
}

fn m_index(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    let is i64 as i with mut = 0 - 1;
    if (o.win != 0) {
        if (o.w == tree.root(o.t)) {
            i = bridge.window_index(_bridge(user), o.win);
        } else {
            i = bridge.index_of(o.t, o.w);
        }
    }
    dbus.wire.put_i32(k.reply, i);
}

// Relations: what labels it, and what it labels.
let is i64 as RELATION_LABEL_FOR   with imut = 1;
let is i64 as RELATION_LABELLED_BY with imut = 2;

// The widgets under w that l labels, put as references; how many.
fn _labelled(b as *bridge.Bridge, out as *dbus.wire.Writer, win as i64, t as *tree.Tree, w as i64, l as i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        if (ch != l && tree.labelled_by(t, ch) == l && bridge.exposed(t, ch) == 1) {
            if (cast(i64, out) != 0) { obj.put_ref(b, out, win, ch); }
            n = n + 1;
        }
        n = n + _labelled(b, out, win, t, ch, l);
        ch = tree.next_sibling(t, ch);
    }
    return n;
}

fn m_relations(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    let is *bridge.Bridge as b = _bridge(user);
    let is i64 as at = dbus.wire.put_array(k.reply, 8);
    if (o.win != 0) {
        let is i64 as l = tree.labelled_by(o.t, o.w);
        if (l != 0 && l != o.w && bridge.exposed(o.t, l) == 1) {
            dbus.wire.put_struct(k.reply);
            dbus.wire.put_u32(k.reply, RELATION_LABELLED_BY);
            let is i64 as inner = dbus.wire.put_array(k.reply, 8);
            obj.put_ref(b, k.reply, o.win, l);
            dbus.wire.put_array_end(k.reply, inner, 8);
        }
        let is i64 as root = tree.root(o.t);
        if (_labelled(b, cast(*dbus.wire.Writer, 0), o.win, o.t, root, o.w) > 0) {
            dbus.wire.put_struct(k.reply);
            dbus.wire.put_u32(k.reply, RELATION_LABEL_FOR);
            let is i64 as inner2 = dbus.wire.put_array(k.reply, 8);
            _labelled(b, k.reply, o.win, o.t, root, o.w);
            dbus.wire.put_array_end(k.reply, inner2, 8);
        }
    }
    dbus.wire.put_array_end(k.reply, at, 8);
}

fn m_role(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    dbus.wire.put_u32(k.reply, _role(_bridge(user), &o));
}

fn m_role_name(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    dbus.wire.put_string(k.reply, names.role_name(_role(_bridge(user), &o)));
}

// A word for people in the application's language.
fn _put_word(b as *bridge.Bridge, w as *dbus.wire.Writer, word as i64) as void {
    let is i64 as n with mut = 0;
    let is *u8 as s = strings.text(app.language(b.a), word, &n);
    dbus.wire.put_string_n(w, s, n);
}

fn m_localized_role_name(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    _put_word(_bridge(user), k.reply, names.role_word(_role(_bridge(user), &o)));
}

fn m_state(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    let is i64 as s = obj.states(_bridge(user), &o);
    let is i64 as at = dbus.wire.put_array(k.reply, 4);
    dbus.wire.put_u32(k.reply, s & 4294967295);
    dbus.wire.put_u32(k.reply, (s >> 32) & 4294967295);
    dbus.wire.put_array_end(k.reply, at, 4);
}

fn m_attributes(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    let is i64 as at = dbus.wire.put_array(k.reply, 8);
    dbus.wire.put_struct(k.reply);
    dbus.wire.put_string(k.reply, "toolkit");
    dbus.wire.put_string(k.reply, "caustic");
    dbus.wire.put_array_end(k.reply, at, 8);
}

fn m_application(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    obj.put_ref(_bridge(user), k.reply, 0, 0);
}

fn m_interfaces(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACCESSIBLE, &o) == 0) { return; }
    let is i64 as f = obj.interfaces(&o);
    let is i64 as at = dbus.wire.put_array(k.reply, 4);
    if ((f & obj.F_ACCESSIBLE) != 0) { dbus.wire.put_string(k.reply, obj.I_ACCESSIBLE); }
    if ((f & obj.F_APPLICATION) != 0) { dbus.wire.put_string(k.reply, obj.I_APPLICATION); }
    if ((f & obj.F_COMPONENT) != 0) { dbus.wire.put_string(k.reply, obj.I_COMPONENT); }
    if ((f & obj.F_ACTION) != 0) { dbus.wire.put_string(k.reply, obj.I_ACTION); }
    if ((f & obj.F_VALUE) != 0) { dbus.wire.put_string(k.reply, obj.I_VALUE); }
    if ((f & obj.F_TEXT) != 0) { dbus.wire.put_string(k.reply, obj.I_TEXT); }
    if ((f & obj.F_EDITABLE) != 0) { dbus.wire.put_string(k.reply, obj.I_EDITABLE); }
    if ((f & obj.F_SELECTION) != 0) { dbus.wire.put_string(k.reply, obj.I_SELECTION); }
    if ((f & obj.F_TABLE) != 0) { dbus.wire.put_string(k.reply, obj.I_TABLE); }
    dbus.wire.put_array_end(k.reply, at, 4);
}

// Properties: the object is the path's; one gone reads as nothing.

fn p_name(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is *bridge.Bridge as b = _bridge(user);
    let is obj.Obj as o;
    if (obj.find(c, b, &o) == 0) {
        dbus.wire.put_string(w, "");
        return;
    }
    if (o.win == 0) {
        dbus.wire.put_string_n(w, cast(*u8, &b.name), b.name_len);
        return;
    }
    dbus.wire.put_string_n(w, o.q.name, o.q.name_len);
}

fn p_description(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.find(c, _bridge(user), &o) == 0 || o.win == 0) {
        dbus.wire.put_string(w, "");
        return;
    }
    dbus.wire.put_string_n(w, o.q.description, o.q.description_len);
}

fn p_parent(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is *bridge.Bridge as b = _bridge(user);
    let is obj.Obj as o;
    if (obj.find(c, b, &o) == 0) {
        obj.put_null(b, w);
        return;
    }
    if (o.win == 0) {
        // The desktop, as the registry embedded us.
        dbus.wire.put_struct(w);
        dbus.wire.put_string(w, cast(*u8, &b.desktop_name));
        dbus.wire.put_path(w, cast(*u8, &b.desktop_path));
        return;
    }
    let is i64 as p = bridge.parent_of(o.t, o.w);
    if (p == 0) {
        obj.put_ref(b, w, 0, 0);
        return;
    }
    obj.put_ref(b, w, o.win, p);
}

fn p_child_count(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.find(c, _bridge(user), &o) == 0) {
        dbus.wire.put_i32(w, 0);
        return;
    }
    dbus.wire.put_i32(w, child_count_of(_bridge(user), &o));
}

// The application's locale as POSIX names it: "pt_BR" for pt-BR; "C" for
// none.
fn _put_locale(b as *bridge.Bridge, w as *dbus.wire.Writer) as void {
    let is [32]u8 as tag;
    let is i64 as n = app.locale(b.a, cast(*u8, &tag), 32);
    if (n == 0) {
        dbus.wire.put_string(w, "C");
        return;
    }
    let is i64 as i with mut = 0;
    while (i < n) {
        if (tag[i] == 45) { tag[i] = cast(u8, 95); }
        i = i + 1;
    }
    dbus.wire.put_string_n(w, cast(*u8, &tag), n);
}

fn p_locale(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { _put_locale(_bridge(user), w); }

fn p_empty(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { dbus.wire.put_string(w, ""); }

fn p_version(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { dbus.wire.put_u32(w, 1); }

// --- Application ---

fn p_toolkit(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { dbus.wire.put_string(w, "caustic"); }

fn p_toolkit_version(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { dbus.wire.put_string(w, "0.1"); }

fn p_atspi_version(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { dbus.wire.put_string(w, "2.1"); }

fn p_id(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { dbus.wire.put_i32(w, _bridge(user).id); }

fn p_set_id(c as *dbus.conn.Conn, r as *dbus.wire.Reader, user as *u8) as i32 {
    _bridge(user).id = cast(i32, dbus.wire.get_i32(r));
    return 1;
}

fn m_locale(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { _put_locale(_bridge(user), k.reply); }

fn m_bus_address(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { dbus.wire.put_string(k.reply, ""); }

// --- Component ---

fn _xy(k as *dbus.conn.Call, x as *f64, y as *f64, coord as *i64) as void {
    *x = cast(f64, dbus.wire.get_i32(&k.args));
    *y = cast(f64, dbus.wire.get_i32(&k.args));
    *coord = dbus.wire.get_u32(&k.args);
}

fn m_contains(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    let is f64 as x with mut = 0.0;
    let is f64 as y with mut = 0.0;
    let is i64 as coord with mut = 0;
    _xy(k, &x, &y, &coord);
    let is math.rect.Rect as r = bridge.extents(_bridge(user), o.win, o.t, o.w, coord);
    dbus.wire.put_bool(k.reply, cast(i32, x >= r.x && y >= r.y && x < r.x + r.w && y < r.y + r.h));
}

// The deepest widget told at a point of the window inside w — w itself when
// nothing inside it is — or 0 for a point outside it.
fn _at_point(t as *tree.Tree, w as i64, x as f64, y as f64) as i64 {
    let is i64 as h with mut = router.hit(t, x, y);
    while (h != 0 && bridge.exposed(t, h) == 0) { h = tree.parent(t, h); }
    // Inside w, or no answer here.
    let is i64 as up with mut = h;
    while (up != 0 && up != w) { up = tree.parent(t, up); }
    if (up == 0) { return 0; }
    return h;
}

fn m_at_point(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    let is f64 as x with mut = 0.0;
    let is f64 as y with mut = 0.0;
    let is i64 as coord with mut = 0;
    _xy(k, &x, &y, &coord);
    let is f64 as ox with mut = 0.0;
    let is f64 as oy with mut = 0.0;
    bridge.origin(_bridge(user), o.win, o.t, o.w, coord, &ox, &oy);
    let is i64 as h = _at_point(o.t, o.w, x + ox, y + oy);
    if (h == 0) {
        obj.put_null(_bridge(user), k.reply);
        return;
    }
    obj.put_ref(_bridge(user), k.reply, o.win, h);
}

fn m_extents(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    let is math.rect.Rect as r = bridge.extents(_bridge(user), o.win, o.t, o.w, dbus.wire.get_u32(&k.args));
    dbus.wire.put_struct(k.reply);
    dbus.wire.put_i32(k.reply, cast(i64, r.x));
    dbus.wire.put_i32(k.reply, cast(i64, r.y));
    dbus.wire.put_i32(k.reply, cast(i64, r.w));
    dbus.wire.put_i32(k.reply, cast(i64, r.h));
}

fn m_position(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    let is math.rect.Rect as r = bridge.extents(_bridge(user), o.win, o.t, o.w, dbus.wire.get_u32(&k.args));
    dbus.wire.put_i32(k.reply, cast(i64, r.x));
    dbus.wire.put_i32(k.reply, cast(i64, r.y));
}

fn m_size(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    let is math.rect.Rect as r = layout.window_rect(o.t, o.w);
    dbus.wire.put_i32(k.reply, cast(i64, r.w));
    dbus.wire.put_i32(k.reply, cast(i64, r.h));
}

// AtspiComponentLayer: a window's, or a widget's.
fn m_layer(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    let is i64 as layer with mut = 3;
    if (o.w == tree.root(o.t)) { layer = 7; }
    dbus.wire.put_u32(k.reply, layer);
}

fn m_zorder(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    dbus.wire.put_i16(k.reply, 0);
}

fn m_grab_focus(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    dbus.wire.put_bool(k.reply, router.focus(o.t, o.r, o.w, 1));
}

fn m_alpha(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    dbus.wire.put_double(k.reply, 1.0);
}

// Moving or resizing a widget is the layout's to decide: refused.
fn m_refuse(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    dbus.wire.put_bool(k.reply, 0);
}

fn m_scroll_to(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_COMPONENT, &o) == 0) { return; }
    router.reveal(o.t, o.w);
    dbus.wire.put_bool(k.reply, 1);
}

// --- Action ---

fn p_nactions(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.find(c, _bridge(user), &o) == 0 || o.win == 0) {
        dbus.wire.put_i32(w, 0);
        return;
    }
    dbus.wire.put_i32(w, names.action_count(o.q.actions));
}

// The i-th action's name; "" past the last.
fn m_action_name(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACTION, &o) == 0) { return; }
    dbus.wire.put_string(k.reply, names.action_name(names.nth_action(o.q.actions, dbus.wire.get_i32(&k.args))));
}

// Its name for people, and its description: in the application's language.
fn m_action_word(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACTION, &o) == 0) { return; }
    _put_word(_bridge(user), k.reply, names.action_word(names.nth_action(o.q.actions, dbus.wire.get_i32(&k.args))));
}

fn m_key_binding(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACTION, &o) == 0) { return; }
    dbus.wire.put_string(k.reply, "");
}

fn m_actions(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACTION, &o) == 0) { return; }
    let is i64 as n = names.action_count(o.q.actions);
    let is i64 as at = dbus.wire.put_array(k.reply, 8);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as bit = names.nth_action(o.q.actions, i);
        dbus.wire.put_struct(k.reply);
        dbus.wire.put_string(k.reply, names.action_name(bit));
        _put_word(_bridge(user), k.reply, names.action_word(bit));
        dbus.wire.put_string(k.reply, "");
        i = i + 1;
    }
    dbus.wire.put_array_end(k.reply, at, 8);
}

fn m_do_action(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_ACTION, &o) == 0) { return; }
    let is i64 as bit = names.nth_action(o.q.actions, dbus.wire.get_i32(&k.args));
    if (bit == 0) {
        dbus.wire.put_bool(k.reply, 0);
        return;
    }
    dbus.wire.put_bool(k.reply, access.act(o.t, o.w, bit, 0.0));
}

// --- Value ---

fn _value_obj(c as *dbus.conn.Conn, user as *u8, o as *obj.Obj) as i32 {
    if (obj.find(c, _bridge(user), o) == 0 || o.win == 0 || o.q.has_value == 0) { return 0; }
    return 1;
}

fn p_min(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (_value_obj(c, user, &o) == 0) {
        dbus.wire.put_double(w, 0.0);
        return;
    }
    dbus.wire.put_double(w, o.q.min);
}

fn p_max(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (_value_obj(c, user, &o) == 0) {
        dbus.wire.put_double(w, 0.0);
        return;
    }
    dbus.wire.put_double(w, o.q.max);
}

fn p_step(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (_value_obj(c, user, &o) == 0) {
        dbus.wire.put_double(w, 0.0);
        return;
    }
    dbus.wire.put_double(w, o.q.step);
}

fn p_current(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (_value_obj(c, user, &o) == 0) {
        dbus.wire.put_double(w, 0.0);
        return;
    }
    dbus.wire.put_double(w, o.q.value);
}

fn p_set_current(c as *dbus.conn.Conn, r as *dbus.wire.Reader, user as *u8) as i32 {
    let is obj.Obj as o;
    if (_value_obj(c, user, &o) == 0) { return 0; }
    return access.act(o.t, o.w, access.SET_VALUE, dbus.wire.get_double(r));
}

// --- The tables ---

let is [11]dbus.conn.Method as acc_methods with mut;
let is [8]dbus.conn.Property as acc_props with mut;
let is [2]dbus.conn.Method as app_methods with mut;
let is [6]dbus.conn.Property as app_props with mut;
let is [14]dbus.conn.Method as comp_methods with mut;
let is [1]dbus.conn.Property as comp_props with mut;
let is [6]dbus.conn.Method as action_methods with mut;
let is [2]dbus.conn.Property as action_props with mut;
let is [6]dbus.conn.Property as value_props with mut;
let is [8]dbus.conn.Interface as widget_ifaces with mut;
let is [2]dbus.conn.Interface as root_ifaces with mut;
let is i32 as _ready with mut = 0;

fn _m(m as *dbus.conn.Method, name as *u8, ins as *u8, outs as *u8, h as dbus.conn.MethodFn) as void {
    m.name = name;
    m.in_sig = ins;
    m.out_sig = outs;
    m.handler = h;
    m.in_names = cast(*u8, 0);
    m.out_names = cast(*u8, 0);
}

fn _p(p as *dbus.conn.Property, name as *u8, sig as *u8, g as dbus.conn.GetFn, s as dbus.conn.SetFn) as void {
    p.name = name;
    p.sig = sig;
    p.get = g;
    p.set = s;
}

fn _i(f as *dbus.conn.Interface, name as *u8, ms as *dbus.conn.Method, nm as i64, ps as *dbus.conn.Property, np as i64) as void {
    f.name = name;
    f.methods = ms;
    f.nmethods = nm;
    f.props = ps;
    f.nprops = np;
    f.signals = cast(*dbus.conn.SignalDecl, 0);
    f.nsignals = 0;
}

let is dbus.conn.SetFn as _ro with mut;

fn _init() as void {
    if (_ready == 1) { return; }
    _ro = cast(dbus.conn.SetFn, 0);
    _m(&acc_methods[0], "GetChildAtIndex", "i", "(so)", fn_ptr(m_child_at));
    _m(&acc_methods[1], "GetChildren", "", "a(so)", fn_ptr(m_children));
    _m(&acc_methods[2], "GetIndexInParent", "", "i", fn_ptr(m_index));
    _m(&acc_methods[3], "GetRelationSet", "", "a(ua(so))", fn_ptr(m_relations));
    _m(&acc_methods[4], "GetRole", "", "u", fn_ptr(m_role));
    _m(&acc_methods[5], "GetRoleName", "", "s", fn_ptr(m_role_name));
    _m(&acc_methods[6], "GetLocalizedRoleName", "", "s", fn_ptr(m_localized_role_name));
    _m(&acc_methods[7], "GetState", "", "au", fn_ptr(m_state));
    _m(&acc_methods[8], "GetAttributes", "", "a{ss}", fn_ptr(m_attributes));
    _m(&acc_methods[9], "GetApplication", "", "(so)", fn_ptr(m_application));
    _m(&acc_methods[10], "GetInterfaces", "", "as", fn_ptr(m_interfaces));
    _p(&acc_props[0], "Name", "s", fn_ptr(p_name), _ro);
    _p(&acc_props[1], "Description", "s", fn_ptr(p_description), _ro);
    _p(&acc_props[2], "Parent", "(so)", fn_ptr(p_parent), _ro);
    _p(&acc_props[3], "ChildCount", "i", fn_ptr(p_child_count), _ro);
    _p(&acc_props[4], "Locale", "s", fn_ptr(p_locale), _ro);
    _p(&acc_props[5], "AccessibleId", "s", fn_ptr(p_empty), _ro);
    _p(&acc_props[6], "HelpText", "s", fn_ptr(p_empty), _ro);
    _p(&acc_props[7], "version", "u", fn_ptr(p_version), _ro);
    _m(&app_methods[0], "GetLocale", "u", "s", fn_ptr(m_locale));
    _m(&app_methods[1], "GetApplicationBusAddress", "", "s", fn_ptr(m_bus_address));
    _p(&app_props[0], "ToolkitName", "s", fn_ptr(p_toolkit), _ro);
    _p(&app_props[1], "ToolkitVersion", "s", fn_ptr(p_toolkit_version), _ro);
    _p(&app_props[2], "AtspiVersion", "s", fn_ptr(p_atspi_version), _ro);
    _p(&app_props[3], "InterfaceVersion", "u", fn_ptr(p_version), _ro);
    _p(&app_props[4], "Id", "i", fn_ptr(p_id), fn_ptr(p_set_id));
    _p(&app_props[5], "Version", "s", fn_ptr(p_toolkit_version), _ro);
    _m(&comp_methods[0], "Contains", "iiu", "b", fn_ptr(m_contains));
    _m(&comp_methods[1], "GetAccessibleAtPoint", "iiu", "(so)", fn_ptr(m_at_point));
    _m(&comp_methods[2], "GetExtents", "u", "(iiii)", fn_ptr(m_extents));
    _m(&comp_methods[3], "GetPosition", "u", "ii", fn_ptr(m_position));
    _m(&comp_methods[4], "GetSize", "", "ii", fn_ptr(m_size));
    _m(&comp_methods[5], "GetLayer", "", "u", fn_ptr(m_layer));
    _m(&comp_methods[6], "GetMDIZOrder", "", "n", fn_ptr(m_zorder));
    _m(&comp_methods[7], "GrabFocus", "", "b", fn_ptr(m_grab_focus));
    _m(&comp_methods[8], "GetAlpha", "", "d", fn_ptr(m_alpha));
    _m(&comp_methods[9], "SetExtents", "iiiiu", "b", fn_ptr(m_refuse));
    _m(&comp_methods[10], "SetPosition", "iiu", "b", fn_ptr(m_refuse));
    _m(&comp_methods[11], "SetSize", "ii", "b", fn_ptr(m_refuse));
    _m(&comp_methods[12], "ScrollTo", "u", "b", fn_ptr(m_scroll_to));
    _m(&comp_methods[13], "ScrollToPoint", "uii", "b", fn_ptr(m_refuse));
    _m(&action_methods[0], "GetDescription", "i", "s", fn_ptr(m_action_word));
    _m(&action_methods[1], "GetName", "i", "s", fn_ptr(m_action_name));
    _m(&action_methods[2], "GetLocalizedName", "i", "s", fn_ptr(m_action_word));
    _m(&action_methods[3], "GetKeyBinding", "i", "s", fn_ptr(m_key_binding));
    _m(&action_methods[4], "GetActions", "", "a(sss)", fn_ptr(m_actions));
    _m(&action_methods[5], "DoAction", "i", "b", fn_ptr(m_do_action));
    _p(&action_props[0], "NActions", "i", fn_ptr(p_nactions), _ro);
    _p(&action_props[1], "version", "u", fn_ptr(p_version), _ro);
    _p(&value_props[0], "MinimumValue", "d", fn_ptr(p_min), _ro);
    _p(&value_props[1], "MaximumValue", "d", fn_ptr(p_max), _ro);
    _p(&value_props[2], "MinimumIncrement", "d", fn_ptr(p_step), _ro);
    _p(&value_props[3], "CurrentValue", "d", fn_ptr(p_current), fn_ptr(p_set_current));
    _p(&value_props[4], "Text", "s", fn_ptr(p_empty), _ro);
    _p(&value_props[5], "version", "u", fn_ptr(p_version), _ro);
    _p(&comp_props[0], "version", "u", fn_ptr(p_version), _ro);
    _i(&widget_ifaces[0], obj.I_ACCESSIBLE, cast(*dbus.conn.Method, &acc_methods), 11, cast(*dbus.conn.Property, &acc_props), 8);
    _i(&widget_ifaces[1], obj.I_COMPONENT, cast(*dbus.conn.Method, &comp_methods), 14, cast(*dbus.conn.Property, &comp_props), 1);
    _i(&widget_ifaces[2], obj.I_ACTION, cast(*dbus.conn.Method, &action_methods), 6, cast(*dbus.conn.Property, &action_props), 2);
    _i(&widget_ifaces[3], obj.I_VALUE, cast(*dbus.conn.Method, 0), 0, cast(*dbus.conn.Property, &value_props), 6);
    atext.tables(&widget_ifaces[4], &widget_ifaces[5]);
    selection.table(&widget_ifaces[6]);
    table.table(&widget_ifaces[7]);
    _i(&root_ifaces[0], obj.I_ACCESSIBLE, cast(*dbus.conn.Method, &acc_methods), 11, cast(*dbus.conn.Property, &acc_props), 8);
    _i(&root_ifaces[1], obj.I_APPLICATION, cast(*dbus.conn.Method, &app_methods), 2, cast(*dbus.conn.Property, &app_props), 6);
    _ready = 1;
}

// The tables for a widget told, and how many; for the application's root.
fn widget_tables(n as *i64) as *dbus.conn.Interface {
    _init();
    *n = 8;
    return cast(*dbus.conn.Interface, &widget_ifaces);
}

fn root_tables(n as *i64) as *dbus.conn.Interface {
    _init();
    *n = 2;
    return cast(*dbus.conn.Interface, &root_ifaces);
}
