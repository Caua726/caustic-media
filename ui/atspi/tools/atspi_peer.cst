// ui/atspi/tools/atspi_peer.cst — an application for atspi_check.py to read.
//
// A window of a few widgets, its bridge opened and pumped until the Quit
// button is pressed — by the checker, through AT-SPI — or twenty seconds
// pass. The checker is libatspi, the library Orca reads programs through,
// talking to the desktop's own accessibility bus and registry: a second
// implementation of the protocol checking this one from the other side.
// The OK button counts its clicks into the label, for the checker to read.
//
// Run from the repository's root (the test font) by atspi_check.sh.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/env.cst" as env;
use "std/time.cst" as time;
use "std/os/linux.cst" as linux;
use "../../../gpu/gpu.cst" as gpu;
use "../../../text/sfnt/sfnt.cst" as sfnt;
use "../../../text/sfnt/table.cst" as table;
use "../../../text/layout/font.cst" as font;
use "../../tree.cst" as tree;
use "../../layout.cst" as layout;
use "../../box.cst" as box;
use "../../style.cst" as style;
use "../../signal.cst" as signal;
use "../../text.cst" as text;
use "../../app.cst" as app;
use "../../widgets/label.cst" as label;
use "../../widgets/button.cst" as button;
use "../../widgets/check.cst" as check;
use "../../widgets/slider.cst" as slider;
use "../../widgets/entry.cst" as entry;
use "../bridge.cst" as bridge;
use "../atspi.cst" as atspi;

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is gpu.device.Device as dv with mut;
let is app.App as a with mut;
let is bridge.Bridge as b with mut;
let is i64 as clicks with mut = 0;
let is i64 as said with mut = 0;
let is i32 as quit with mut = 0;
let is [32]u8 as line with mut;

fn on_ok(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    clicks = clicks + 1;
    let is *u8 as p = cast(*u8, &line);
    mem.memcpy(p, "clicked ", 8);
    p[8] = cast(u8, 48 + clicks % 10);
    label.set_text(t, said, p, 9);
}

fn on_quit(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { quit = 1; }

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("atspi peer: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    theme = style.light();
    theme.fonts.body.size = 16.0;
    dv = gpu.open_headless(64, 64, gpu.SOFTWARE);
    let is text.Limits as lim = text.limits_default();
    let is *text.Service as svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    let is app.Limits as al = app.limits_default();
    a = app.open(&al);
    app.set_theme(&a, &theme);
    app.set_text_service(&a, cast(*u8, svc));
    let is i64 as win = app.window_open(&a, 400.0, 300.0);
    app.set_title(&a, win, "Peer window", 11);
    let is *tree.Tree as t = app.tree(&a, win);
    let is i64 as col = box.create(t, tree.root(t), box.COLUMN);
    layout.set_align(t, col, layout.START, layout.START);
    let is i64 as ok = button.create(t, col, "OK", 2);
    signal.connect(t, ok, signal.CLICKED, fn_ptr(on_ok), cast(*u8, 0));
    check.create(t, col, "Remember", 8);
    slider.create(t, col, 0.0, 10.0, 1.0);
    let is i64 as e = entry.create(t, col);
    entry.set_text(t, e, "hello", 5);
    said = label.create(t, col, "ready", 5);
    let is i64 as q = button.create(t, col, "Quit", 4);
    signal.connect(t, q, signal.CLICKED, fn_ptr(on_quit), cast(*u8, 0));
    app.frame(&a, win);

    if (atspi.open(&b, &a, "caustic-peer", 12) == 0) {
        io.printf("atspi peer: no session bus\n");
        return 1;
    }
    let is i64 as deadline = time.now_ms() + 20000;
    while (quit == 0 && time.now_ms() < deadline) {
        atspi.pump(&b);
        if (app.needs_frame(&a, win) == 1) { app.frame(&a, win); }
        time.sleep_ms(2);
    }
    atspi.close(&b);
    app.close(&a);
    if (quit == 0) {
        io.printf("atspi peer: never asked to quit\n");
        return 1;
    }
    return 0;
}
