// ui/atspi/selection.cst — Selection: which children of a list, a tree, a
// table or a tab list are chosen, and choosing them.
//
// The children are those told (bridge.child_at) — a list's rows as laid
// out, not every row of its model — each chosen by its SELECT action and
// let go of by its DESELECT, as access.cst has them.
use "../../dbus/dbus.cst" as dbus;
use "../tree.cst" as tree;
use "../router.cst" as router;
use "../access.cst" as access;
use "bridge.cst" as bridge;
use "object.cst" as obj;

fn _bridge(user as *u8) as *bridge.Bridge { return cast(*bridge.Bridge, user); }

fn _states(t as *tree.Tree, w as i64) as i64 {
    let is tree.Access as q;
    access.describe(t, cast(*router.Router, 0), w, &q);
    return q.states;
}

fn _chosen(t as *tree.Tree, w as i64) as i32 { return cast(i32, (_states(t, w) & access.SELECTED) != 0); }

// How many children told are chosen, and the index-th of them into *at (0
// when there are fewer).
fn _count(o as *obj.Obj, index as i64, at as *i64) as i64 {
    *at = 0;
    let is i64 as k with mut = 0;
    let is i64 as n = bridge.child_count(o.t, o.w);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as ch = bridge.child_at(o.t, o.w, i);
        if (_chosen(o.t, ch) == 1) {
            if (k == index) { *at = ch; }
            k = k + 1;
        }
        i = i + 1;
    }
    return k;
}

fn p_count(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    let is i64 as at with mut = 0;
    if (obj.find(c, _bridge(user), &o) == 0 || o.win == 0) {
        dbus.wire.put_i32(w, 0);
        return;
    }
    dbus.wire.put_i32(w, _count(&o, 0 - 1, &at));
}

fn p_version(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { dbus.wire.put_u32(w, 1); }

fn m_selected_child(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_SELECTION, &o) == 0) { return; }
    let is i64 as at with mut = 0;
    let is i64 as i = dbus.wire.get_i32(&k.args);
    _count(&o, i, &at);
    if (i < 0 || at == 0) {
        obj.put_null(_bridge(user), k.reply);
        return;
    }
    obj.put_ref(_bridge(user), k.reply, o.win, at);
}

// The child told at index, asked to do action: 1 when it did.
fn _act(o as *obj.Obj, index as i64, action as i64) as i32 {
    let is i64 as ch = bridge.child_at(o.t, o.w, index);
    if (ch == 0) { return 0; }
    return access.act(o.t, ch, action, 0.0);
}

fn m_select_child(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_SELECTION, &o) == 0) { return; }
    dbus.wire.put_bool(k.reply, _act(&o, dbus.wire.get_i32(&k.args), access.SELECT));
}

fn m_deselect_selected_child(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_SELECTION, &o) == 0) { return; }
    let is i64 as at with mut = 0;
    let is i64 as i = dbus.wire.get_i32(&k.args);
    _count(&o, i, &at);
    if (i < 0 || at == 0) {
        dbus.wire.put_bool(k.reply, 0);
        return;
    }
    dbus.wire.put_bool(k.reply, access.act(o.t, at, access.DESELECT, 0.0));
}

// A child not chosen is not let go of.
fn m_deselect_child(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_SELECTION, &o) == 0) { return; }
    let is i64 as ch = bridge.child_at(o.t, o.w, dbus.wire.get_i32(&k.args));
    if (ch == 0 || _chosen(o.t, ch) == 0) {
        dbus.wire.put_bool(k.reply, 0);
        return;
    }
    dbus.wire.put_bool(k.reply, access.act(o.t, ch, access.DESELECT, 0.0));
}

fn m_is_child_selected(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_SELECTION, &o) == 0) { return; }
    let is i64 as ch = bridge.child_at(o.t, o.w, dbus.wire.get_i32(&k.args));
    dbus.wire.put_bool(k.reply, cast(i32, ch != 0 && _chosen(o.t, ch) == 1));
}

// Every child told chosen, where more than one can be: 1 when each was.
fn m_select_all(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_SELECTION, &o) == 0) { return; }
    if ((o.q.states & access.MULTISELECTABLE) == 0) {
        dbus.wire.put_bool(k.reply, 0);
        return;
    }
    let is i32 as all with mut = 1;
    let is i64 as n = bridge.child_count(o.t, o.w);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as ch = bridge.child_at(o.t, o.w, i);
        if (_chosen(o.t, ch) == 0 && access.act(o.t, ch, access.SELECT, 0.0) == 0) { all = 0; }
        i = i + 1;
    }
    dbus.wire.put_bool(k.reply, all);
}

// Every child chosen let go of: 1 when each was.
fn m_clear(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_SELECTION, &o) == 0) { return; }
    let is i32 as all with mut = 1;
    let is i64 as n = bridge.child_count(o.t, o.w);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as ch = bridge.child_at(o.t, o.w, i);
        if (_chosen(o.t, ch) == 1 && access.act(o.t, ch, access.DESELECT, 0.0) == 0) { all = 0; }
        i = i + 1;
    }
    dbus.wire.put_bool(k.reply, all);
}

// --- The table ---

let is [7]dbus.conn.Method as methods with mut;
let is [2]dbus.conn.Property as props with mut;

fn _m(m as *dbus.conn.Method, name as *u8, ins as *u8, outs as *u8, h as dbus.conn.MethodFn) as void {
    m.name = name;
    m.in_sig = ins;
    m.out_sig = outs;
    m.handler = h;
    m.in_names = cast(*u8, 0);
    m.out_names = cast(*u8, 0);
}

fn table(f as *dbus.conn.Interface) as void {
    _m(&methods[0], "GetSelectedChild", "i", "(so)", fn_ptr(m_selected_child));
    _m(&methods[1], "SelectChild", "i", "b", fn_ptr(m_select_child));
    _m(&methods[2], "DeselectSelectedChild", "i", "b", fn_ptr(m_deselect_selected_child));
    _m(&methods[3], "IsChildSelected", "i", "b", fn_ptr(m_is_child_selected));
    _m(&methods[4], "SelectAll", "", "b", fn_ptr(m_select_all));
    _m(&methods[5], "ClearSelection", "", "b", fn_ptr(m_clear));
    _m(&methods[6], "DeselectChild", "i", "b", fn_ptr(m_deselect_child));
    props[0].name = "NSelectedChildren";
    props[0].sig = "i";
    props[0].get = fn_ptr(p_count);
    props[0].set = cast(dbus.conn.SetFn, 0);
    props[1].name = "version";
    props[1].sig = "u";
    props[1].get = fn_ptr(p_version);
    props[1].set = cast(dbus.conn.SetFn, 0);
    f.name = obj.I_SELECTION;
    f.methods = cast(*dbus.conn.Method, &methods);
    f.nmethods = 7;
    f.props = cast(*dbus.conn.Property, &props);
    f.nprops = 2;
    f.signals = cast(*dbus.conn.SignalDecl, 0);
    f.nsignals = 0;
}
