// ui/atspi/events_test.cst — what the bridge says as things change: the
// focus moving, states, names, values and text changing, widgets and
// windows coming and going; and nothing when nothing changed.
//
// Run from the repository's root inside dbus/tools/run_dbus.sh.
use "std/env.cst" as env;
use "../tree.cst" as tree;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../router.cst" as router;
use "../app.cst" as app;
use "../widgets/label.cst" as label;
use "../widgets/button.cst" as button;
use "../widgets/check.cst" as check;
use "../widgets/slider.cst" as slider;
use "../widgets/entry.cst" as entry;
use "../widgets/textview.cst" as textview;
use "../../math/math.cst" as math;
use "std/mem.cst" as mem;
use "bridge.cst" as bridge;
use "atspi.cst" as atspi;
use "testing.cst" as tk;

// What was heard from p: whether it is there.
fn said(p as *u8, member as *u8, detail as *u8) as i32 {
    return cast(i32, cast(i64, tk.heard_from(p, member, detail)) != 0);
}

// A TextChanged of detail heard from p: whether it says at, n characters of s.
fn text_said(p as *u8, detail as *u8, at as i64, n as i64, s as *u8) as i32 {
    let is *tk.Heard as h = tk.heard_from(p, "TextChanged", detail);
    return cast(i32, cast(i64, h) != 0 && h.d1 == at && h.d2 == n && tk.same(cast(*u8, &h.s), h.n, s) == 1);
}

fn state_said(p as *u8, name as *u8, on as i64) as i32 {
    let is *tk.Heard as h = tk.heard_from(p, "StateChanged", name);
    return cast(i32, cast(i64, h) != 0 && h.d1 == on);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (tk.setup() == 0) { return 1; }
    let is *app.App as a = &tk.a;
    let is *bridge.Bridge as b = &tk.b;
    let is i64 as win = app.window_open(a, 400.0, 300.0);
    app.set_title(a, win, "Main", 4);
    let is *tree.Tree as t = app.tree(a, win);
    let is *router.Router as r = app.router(a, win);
    let is i64 as root = tree.root(t);
    let is i64 as col = box.create(t, root, box.COLUMN);
    layout.set_align(t, col, layout.START, layout.START);
    let is i64 as ok = button.create(t, col, "OK", 2);
    let is i64 as cb = check.create(t, col, "Remember", 8);
    let is i64 as sl = slider.create(t, col, 0.0, 10.0, 1.0);
    let is i64 as lb = label.create(t, col, "Hello", 5);
    let is i64 as e = entry.create(t, col);
    entry.set_text(t, e, "ab", 2);
    // Hidden as the bridge comes on: nothing seen of it yet.
    let is i64 as late = check.create(t, col, "Later", 5);
    tree.set_visible(t, late, 0);
    app.frame(a, win);

    // --- Off: nothing said ---
    router.focus(t, r, ok, 1);
    tk.check("on", tk.turn_on() == 1);
    tk.listen();
    tk.forget();

    let is [96]u8 as okb;
    let is *u8 as OK = tk.path(win, ok, cast(*u8, &okb));
    let is [96]u8 as cbb;
    let is *u8 as CB = tk.path(win, cb, cast(*u8, &cbb));
    let is [96]u8 as slb;
    let is *u8 as SL = tk.path(win, sl, cast(*u8, &slb));
    let is [96]u8 as lbb;
    let is *u8 as LB = tk.path(win, lb, cast(*u8, &lbb));
    let is [96]u8 as eb;
    let is *u8 as E = tk.path(win, e, cast(*u8, &eb));
    let is [96]u8 as wb;
    let is *u8 as WIN = tk.path(win, root, cast(*u8, &wb));

    // --- Nothing changed: nothing said ---
    tree.invalidate_paint(t, ok);
    tree.invalidate_paint(t, ok);
    app.frame(a, win);
    tk.settle(50);
    tk.check("repainted, nothing else: nothing said", tk.nheard == 0);

    // --- The focus ---
    router.focus(t, r, cb, 1);
    tk.settle(50);
    let is *tk.Heard as f = tk.heard_from(CB, "Focus", cast(*u8, 0));
    tk.check("the focus come: said", cast(i64, f) != 0);
    tk.check("focused, said by its state", state_said(CB, "focused", 1) == 1);
    tk.check("the one it left: no longer", state_said(OK, "focused", 0) == 1);
    tk.check("from the window's interface for focus", cast(i64, f) != 0 && tk.named(cast(*u8, &f.iface), "Focus") == 1);
    tk.forget();

    // --- States, values, names ---
    check.set_state(t, cb, check.ON);
    tk.settle(50);
    tk.check("checked: said", state_said(CB, "checked", 1) == 1);
    tk.check("only what changed", tk.heard_count("StateChanged") == 1);
    tk.forget();
    slider.set_value(t, sl, 6.0);
    tk.settle(50);
    let is *tk.Heard as v = tk.heard_from(SL, "PropertyChange", "accessible-value");
    tk.check("a value changed: said, with it", cast(i64, v) != 0 && v.kind == 100 && v.d == 6.0);
    tk.forget();
    tree.set_enabled(t, ok, 0);
    tk.settle(50);
    tk.check("disabled: said", state_said(OK, "enabled", 0) == 1 && state_said(OK, "sensitive", 0) == 1);
    tk.forget();
    tree.set_enabled(t, ok, 1);
    tk.settle(50);
    tk.forget();

    // --- Text ---
    label.set_text(t, lb, "Hello world", 11);
    tk.settle(50);
    let is *tk.Heard as nm = tk.heard_from(LB, "PropertyChange", "accessible-name");
    tk.check("a label's name changed with its text", cast(i64, nm) != 0 && nm.kind == 115 && tk.same(cast(*u8, &nm.s), nm.n, "Hello world") == 1);
    let is *tk.Heard as ins = tk.heard_from(LB, "TextChanged", "insert");
    tk.check("its text: what was inserted, where", cast(i64, ins) != 0 && ins.d1 == 5 && ins.d2 == 6 &&
             tk.same(cast(*u8, &ins.s), ins.n, " world") == 1);
    tk.check("nothing deleted", said(LB, "TextChanged", "delete") == 0);
    tk.forget();
    label.set_text(t, lb, "Help", 4);
    tk.settle(50);
    let is *tk.Heard as del = tk.heard_from(LB, "TextChanged", "delete");
    let is *tk.Heard as ins2 = tk.heard_from(LB, "TextChanged", "insert");
    tk.check("replaced: what was deleted", cast(i64, del) != 0 && del.d1 == 3 && del.d2 == 8 &&
             tk.same(cast(*u8, &del.s), del.n, "lo world") == 1);
    tk.check("and what was inserted", cast(i64, ins2) != 0 && ins2.d1 == 3 && ins2.d2 == 1 && tk.same(cast(*u8, &ins2.s), ins2.n, "p") == 1);
    tk.forget();
    router.focus(t, r, e, 1);
    tk.settle(30);
    tk.forget();
    entry.select(t, e, 2, 2);
    router.text(t, r, "é", 2, 100);
    tk.settle(50);
    let is *tk.Heard as typed = tk.heard_from(E, "TextChanged", "insert");
    tk.check("typed: counted in characters", cast(i64, typed) != 0 && typed.d1 == 2 && typed.d2 == 1 &&
             tk.same(cast(*u8, &typed.s), typed.n, "é") == 1);
    let is *tk.Heard as moved = tk.heard_from(E, "TextCaretMoved", cast(*u8, 0));
    tk.check("the caret moved: said where", cast(i64, moved) != 0 && moved.d1 == 3);
    tk.forget();
    entry.select(t, e, 0, 2);
    tk.settle(50);
    tk.check("text chosen: said", said(E, "TextSelectionChanged", cast(*u8, 0)) == 1);
    tk.forget();

    // --- A text view larger than any text kept: told by the view itself ---
    let is i64 as line_n = 25;
    let is i64 as lines = 48000;
    let is *u8 as big_text = mem.core.mmap_anon(line_n * lines);
    let is i64 as li with mut = 0;
    while (li < lines) {
        mem.memcpy(cast(*u8, cast(i64, big_text) + li * line_n), "line of a large document\n", line_n);
        li = li + 1;
    }
    let is i64 as tv = textview.create(t, col);
    layout.set_min_size(t, tv, 200.0, 60.0);
    textview.set_text(t, tv, big_text, line_n * lines);
    app.frame(a, win);
    tk.settle(50);
    let is [96]u8 as tvb;
    let is *u8 as TV = tk.path(win, tv, cast(*u8, &tvb));
    router.focus(t, r, tv, 1);
    textview.select(t, tv, line_n + 4, line_n + 4);
    tk.settle(30);
    tk.forget();
    router.text(t, r, "ü", 2, 200);
    app.frame(a, win);
    tk.settle(50);
    let is *tk.Heard as vin = tk.heard_from(TV, "TextChanged", "insert");
    tk.check("typed in a large text: told, in characters", cast(i64, vin) != 0 && vin.d1 == line_n + 4 && vin.d2 == 1 &&
             tk.same(cast(*u8, &vin.s), vin.n, "ü") == 1);
    let is *tk.Heard as vcar = tk.heard_from(TV, "TextCaretMoved", cast(*u8, 0));
    tk.check("and the caret after it", cast(i64, vcar) != 0 && vcar.d1 == line_n + 5);
    tk.forget();
    textview.select(t, tv, 0, 4);
    router.text(t, r, "L", 1, 210);
    app.frame(a, win);
    tk.settle(50);
    let is *tk.Heard as vdel = tk.heard_from(TV, "TextChanged", "delete");
    let is *tk.Heard as vput = tk.heard_from(TV, "TextChanged", "insert");
    tk.check("typed over a selection: what went", cast(i64, vdel) != 0 && vdel.d1 == 0 && vdel.d2 == 4 &&
             tk.same(cast(*u8, &vdel.s), vdel.n, "line") == 1);
    tk.check("then what came", cast(i64, vput) != 0 && vput.d1 == 0 && vput.d2 == 1 && tk.same(cast(*u8, &vput.s), vput.n, "L") == 1);
    tree.destroy(t, tv);
    app.frame(a, win);
    tk.settle(50);
    tk.forget();

    // --- Children ---
    let is i64 as more = button.create(t, col, "More", 4);
    app.frame(a, win);
    tk.settle(50);
    let is *tk.Heard as add = tk.heard_from(WIN, "ChildrenChanged", "add");
    let is [96]u8 as mbuf;
    let is *u8 as MORE = tk.path(win, more, cast(*u8, &mbuf));
    tk.check("a widget made: said by its parent told", cast(i64, add) != 0 && add.d1 == 5 && add.kind == 40 &&
             tk.named(cast(*u8, &add.s), MORE) == 1);
    tk.forget();
    tree.destroy(t, more);
    app.frame(a, win);
    tk.settle(50);
    let is *tk.Heard as rem = tk.heard_from(WIN, "ChildrenChanged", "remove");
    tk.check("destroyed: said", cast(i64, rem) != 0 && rem.d1 == 5 && tk.named(cast(*u8, &rem.s), MORE) == 1);
    tk.forget();
    tree.set_visible(t, sl, 0);
    tk.settle(50);
    tk.check("hidden: no longer showing", state_said(SL, "showing", 0) == 1);
    let is *tk.Heard as rmv = tk.heard_from(WIN, "ChildrenChanged", "remove");
    tk.check("hidden: gone from what is told", cast(i64, rmv) != 0 && rmv.d1 == 0 - 1 && tk.named(cast(*u8, &rmv.s), SL) == 1);
    tk.forget();
    tree.set_visible(t, sl, 1);
    tk.settle(50);
    let is *tk.Heard as addv = tk.heard_from(WIN, "ChildrenChanged", "add");
    tk.check("shown again: back", cast(i64, addv) != 0 && addv.d1 == 2 && tk.named(cast(*u8, &addv.s), SL) == 1);
    tk.forget();

    // --- Changes at once ---
    check.set_state(t, cb, check.OFF);
    slider.set_value(t, sl, 3.0);
    tk.settle(50);
    tk.check("two widgets changed at once: both said", state_said(CB, "checked", 0) == 1 &&
             cast(i64, tk.heard_from(SL, "PropertyChange", "accessible-value")) != 0);
    tk.forget();
    // Everything under what says nothing: its children said.
    tree.set_enabled(t, col, 0);
    tk.settle(50);
    tk.check("a column disabled: what is in it said", state_said(OK, "enabled", 0) == 1 && state_said(CB, "enabled", 0) == 1);
    tk.forget();
    tree.set_enabled(t, col, 1);
    tk.settle(50);
    tk.check("and enabled", state_said(OK, "enabled", 1) == 1);
    tk.forget();
    // Shown after the bridge came on: told then, and its changes after.
    tree.set_visible(t, late, 1);
    app.frame(a, win);
    tk.settle(50);
    let is [96]u8 as lateb;
    let is *u8 as LATE = tk.path(win, late, cast(*u8, &lateb));
    let is *tk.Heard as came = tk.heard_from(WIN, "ChildrenChanged", "add");
    tk.check("shown: said by its parent told", cast(i64, came) != 0 && came.d1 == 5 && tk.named(cast(*u8, &came.s), LATE) == 1);
    tk.forget();
    check.set_state(t, late, check.ON);
    tk.settle(50);
    tk.check("then its changes", state_said(LATE, "checked", 1) == 1);
    tree.set_visible(t, late, 0);
    app.frame(a, win);
    tk.settle(50);
    tk.forget();

    // --- Texts compared: what changed, its edges in whole characters ---
    label.set_text(t, lb, "Hulp", 4);
    tk.settle(50);
    let is *tk.Heard as nm2 = tk.heard_from(LB, "PropertyChange", "accessible-name");
    tk.check("a name changed in one letter: said", cast(i64, nm2) != 0 && tk.same(cast(*u8, &nm2.s), nm2.n, "Hulp") == 1);
    tk.check("as long as before: what went, what came", text_said(LB, "delete", 1, 1, "e") == 1 && text_said(LB, "insert", 1, 1, "u") == 1);
    tk.forget();
    label.set_text(t, lb, "Hulps", 5);
    tk.settle(50);
    tk.check("and after it, from what it became", text_said(LB, "insert", 4, 1, "s") == 1 && said(LB, "TextChanged", "delete") == 0);
    tk.forget();
    label.set_text(t, lb, "a\xc3\xa9", 3);
    tk.settle(50);
    tk.forget();
    label.set_text(t, lb, "a\xc3\xa8", 3);
    tk.settle(50);
    tk.check("two characters alike in their first byte: the whole character", text_said(LB, "delete", 1, 1, "\xc3\xa9") == 1 &&
             text_said(LB, "insert", 1, 1, "\xc3\xa8") == 1);
    tk.forget();
    label.set_text(t, lb, "\xc3\xa9b", 3);
    tk.settle(50);
    tk.forget();
    label.set_text(t, lb, "\xc4\xa9b", 3);
    tk.settle(50);
    tk.check("alike in their last byte: the whole character", text_said(LB, "delete", 0, 1, "\xc3\xa9") == 1 &&
             text_said(LB, "insert", 0, 1, "\xc4\xa9") == 1);
    tk.forget();
    label.set_text(t, lb, "abc", 3);
    tk.settle(50);
    tk.forget();
    label.set_text(t, lb, "abXc", 4);
    tk.settle(50);
    tk.check("put in the middle: only that", text_said(LB, "insert", 2, 1, "X") == 1 && said(LB, "TextChanged", "delete") == 0);
    tk.forget();
    label.set_text(t, lb, "abc", 3);
    tk.settle(50);
    tk.check("taken out of the middle: only that", text_said(LB, "delete", 2, 1, "X") == 1 && said(LB, "TextChanged", "insert") == 0);
    tk.forget();
    label.set_text(t, lb, "abc", 3);
    tk.settle(50);
    tk.check("the same again: nothing", said(LB, "TextChanged", cast(*u8, 0)) == 0);
    tk.forget();
    // Texts kept through many changes: what is kept moved, still right.
    let is i64 as filler = label.create(t, col, "", 0);
    let is [400]u8 as fill;
    let is i64 as fi with mut = 0;
    while (fi < 400) {
        fill[fi] = cast(u8, 97 + fi % 26);
        fi = fi + 1;
    }
    let is i64 as round with mut = 0;
    while (round < 24) {
        label.set_text(t, filler, cast(*u8, &fill), 300 + round * 4);
        tk.settle(5);
        round = round + 1;
    }
    tk.forget();
    label.set_text(t, lb, "abcd", 4);
    tk.settle(50);
    tk.check("after many: still compared with what it was", text_said(LB, "insert", 3, 1, "d") == 1 &&
             said(LB, "TextChanged", "delete") == 0);
    // The texts kept first, moved too: the button's, the check box's.
    let is i64 as okl = button.content(t, ok);
    let is i64 as cbl = check.content(t, cb);
    let is [96]u8 as oklb;
    let is *u8 as OKL = tk.path(win, okl, cast(*u8, &oklb));
    let is [96]u8 as cblb;
    let is *u8 as CBL = tk.path(win, cbl, cast(*u8, &cblb));
    label.set_text(t, okl, "OKAY", 4);
    label.set_text(t, cbl, "Remember me", 11);
    entry.set_text(t, e, "abé!", 5);
    tk.settle(50);
    tk.check("and an entry's", text_said(E, "insert", 3, 1, "!") == 1);
    tk.check("the first texts kept, after many: right", text_said(OKL, "insert", 2, 2, "AY") == 1 &&
             said(OKL, "TextChanged", "delete") == 0 && text_said(CBL, "insert", 8, 3, " me") == 1);
    tree.destroy(t, filler);
    app.frame(a, win);
    tk.settle(50);
    tk.forget();

    // --- The caret and the selection, by their ends ---
    entry.select(t, e, 0, 2);
    tk.settle(50);
    tk.forget();
    entry.select(t, e, 1, 2);
    tk.settle(50);
    tk.check("the selection's start moved: said", said(E, "TextSelectionChanged", cast(*u8, 0)) == 1);
    tk.forget();
    entry.select(t, e, 1, 4);
    tk.settle(50);
    tk.check("its end moved: said", said(E, "TextSelectionChanged", cast(*u8, 0)) == 1);
    tk.forget();
    entry.select(t, e, 0, 0);
    tk.settle(50);
    let is *tk.Heard as home = tk.heard_from(E, "TextCaretMoved", cast(*u8, 0));
    tk.check("the caret to the start: said", cast(i64, home) != 0 && home.d1 == 0);
    tk.forget();

    // --- A text view's changes, many in one turn ---
    let is i64 as tv2 = textview.create(t, col);
    layout.set_min_size(t, tv2, 200.0, 60.0);
    textview.set_text(t, tv2, "start", 5);
    app.frame(a, win);
    tk.settle(50);
    let is [96]u8 as tv2b;
    let is *u8 as TV2 = tk.path(win, tv2, cast(*u8, &tv2b));
    router.focus(t, r, tv2, 1);
    textview.select(t, tv2, 5, 5);
    tk.settle(50);
    tk.forget();
    router.text(t, r, "x", 1, 300);
    router.text(t, r, "y", 1, 301);
    check.set_state(t, cb, check.ON);
    tk.settle(50);
    let is i64 as inserts with mut = 0;
    let is i64 as hi with mut = 0;
    let is i32 as both with mut = 0;
    while (hi < tk.nheard) {
        let is *tk.Heard as h = &tk.heard[hi];
        if (tk.named(cast(*u8, &h.path), TV2) == 1 && tk.named(cast(*u8, &h.member), "TextChanged") == 1) {
            inserts = inserts + 1;
            if (h.d1 == 6 && tk.same(cast(*u8, &h.s), h.n, "y") == 1) { both = 1; }
        }
        hi = hi + 1;
    }
    tk.check("two keys in one turn: each told", inserts == 2 && both == 1 && text_said(TV2, "insert", 5, 1, "x") == 1);
    tk.check("with another widget's change", state_said(CB, "checked", 1) == 1);
    tree.destroy(t, tv2);
    app.frame(a, win);
    tk.settle(50);
    tk.forget();

    // --- More changes at once than are queued ---
    let is i64 as heap = box.create(t, col, box.COLUMN);
    let is i64 as hk with mut = 0;
    while (hk < 300) {
        label.create(t, heap, "x", 1);
        hk = hk + 1;
    }
    check.set_state(t, cb, check.OFF);
    tk.settle(80);
    tk.check("too many at once: what changed still said", state_said(CB, "checked", 0) == 1);
    tree.destroy(t, heap);
    app.frame(a, win);
    tk.settle(80);
    tk.forget();

    // --- Windows ---
    app.set_title(a, win, "Main window", 11);
    tk.settle(50);
    let is *tk.Heard as title = tk.heard_from(WIN, "PropertyChange", "accessible-name");
    tk.check("a window's title: its name", cast(i64, title) != 0 && tk.same(cast(*u8, &title.s), title.n, "Main window") == 1);
    tk.forget();
    let is i64 as w2 = app.window_open(a, 200.0, 100.0);
    app.set_title(a, w2, "Other", 5);
    let is *tree.Tree as t2 = app.tree(a, w2);
    label.create(t2, tree.root(t2), "There", 5);
    app.frame(a, w2);
    tk.settle(50);
    let is [96]u8 as w2b;
    let is *u8 as W2 = tk.path(w2, tree.root(t2), cast(*u8, &w2b));
    let is *tk.Heard as made = tk.heard_from(bridge.ROOT_PATH, "ChildrenChanged", "add");
    tk.check("a window shown: said by the application", cast(i64, made) != 0 && made.d1 == 1 && tk.named(cast(*u8, &made.s), W2) == 1);
    tk.check("and by the window", said(W2, "Create", cast(*u8, 0)) == 1);
    tk.forget();
    app.set_active(a, w2, 1);
    tk.settle(50);
    tk.check("active: said", said(W2, "Activate", cast(*u8, 0)) == 1 && state_said(W2, "active", 1) == 1);
    tk.forget();
    app.set_active(a, w2, 0);
    tk.settle(50);
    tk.check("no longer", said(W2, "Deactivate", cast(*u8, 0)) == 1);
    tk.forget();
    // A third, after it: still told when the second is closed.
    let is i64 as w3 = app.window_open(a, 200.0, 100.0);
    app.set_title(a, w3, "Third", 5);
    let is *tree.Tree as t3 = app.tree(a, w3);
    let is i64 as w3c = check.create(t3, tree.root(t3), "Three", 5);
    app.frame(a, w3);
    tk.settle(50);
    let is [96]u8 as w3b;
    let is *u8 as W3 = tk.path(w3, tree.root(t3), cast(*u8, &w3b));
    let is [96]u8 as w3cb;
    let is *u8 as W3C = tk.path(w3, w3c, cast(*u8, &w3cb));
    tk.forget();
    router.focus(t, r, ok, 1);
    tk.settle(50);
    tk.forget();
    app.window_close(a, w2);
    tk.settle(50);
    tk.check("closed: said", said(W2, "Destroy", cast(*u8, 0)) == 1 && said(bridge.ROOT_PATH, "ChildrenChanged", "remove") == 1);
    let is *tk.Heard as gone_w = tk.heard_from(bridge.ROOT_PATH, "ChildrenChanged", "remove");
    tk.check("from no place it can say", cast(i64, gone_w) != 0 && gone_w.d1 == 0 - 1);
    tk.check("the window after it: not told again", said(W3, "Create", cast(*u8, 0)) == 0 && tk.heard_count("Create") == 0);
    tk.forget();
    router.focus(t, r, cb, 1);
    tk.settle(50);
    tk.check("the focus in the first, after: told as it moves", state_said(OK, "focused", 0) == 1 && state_said(CB, "focused", 1) == 1);
    tk.forget();
    app.set_active(a, w3, 1);
    check.set_state(t3, w3c, check.ON);
    tk.settle(50);
    tk.check("the window after it: still told", said(W3, "Activate", cast(*u8, 0)) == 1 && state_said(W3C, "checked", 1) == 1);
    check.set_state(t, cb, check.ON);
    tk.settle(50);
    tk.check("and the first", state_said(CB, "checked", 1) == 1);
    tk.forget();
    app.hide(a, w3);
    tk.settle(50);
    let is *tk.Heard as hid = tk.heard_from(bridge.ROOT_PATH, "ChildrenChanged", "remove");
    tk.check("hidden: told as gone", said(W3, "Destroy", cast(*u8, 0)) == 1 && cast(i64, hid) != 0 && hid.d1 == 0 - 1);
    tk.forget();
    app.show(a, w3);
    tk.settle(50);
    tk.check("shown again: told as come", said(W3, "Create", cast(*u8, 0)) == 1);
    tk.forget();
    router.focus(t3, app.router(a, w3), w3c, 1);
    tk.settle(50);
    tk.forget();
    app.window_close(a, w3);
    tk.settle(50);
    tk.forget();
    router.focus(t, r, ok, 1);
    tk.settle(50);
    tk.check("the focus after its window closed: told as it comes", state_said(OK, "focused", 1) == 1 &&
             said(W3C, "StateChanged", "focused") == 0);
    tk.forget();

    // --- A large insertion: said in part, counted whole ---
    let is i64 as bigv = textview.create(t, col);
    layout.set_min_size(t, bigv, 200.0, 60.0);
    app.frame(a, win);
    tk.settle(50);
    let is [96]u8 as bigb;
    let is *u8 as BIGV = tk.path(win, bigv, cast(*u8, &bigb));
    let is i64 as euros = 100000;
    let is *u8 as eu = mem.core.mmap_anon(euros * 3);
    let is i64 as ei with mut = 0;
    while (ei < euros) {
        mem.memcpy(cast(*u8, cast(i64, eu) + ei * 3), "\xe2\x82\xac", 3);
        ei = ei + 1;
    }
    tk.forget();
    textview.set_text(t, bigv, eu, euros * 3);
    app.frame(a, win);
    tk.settle(80);
    let is *tk.Heard as huge = tk.heard_from(BIGV, "TextChanged", "insert");
    tk.check("its length whole, what it is cut at a character", cast(i64, huge) != 0 && huge.d1 == 0 && huge.d2 == euros &&
             huge.n == 65535);
    tree.destroy(t, bigv);
    app.frame(a, win);
    tk.settle(50);
    tk.forget();

    // --- Off again: nothing said ---
    atspi.close(b);
    check.set_state(t, cb, check.OFF);
    router.focus(t, r, ok, 1);
    tk.settle(50);
    tk.check("closed: nothing said", tk.nheard == 0);
    tk.check("its trees no longer watched", cast(i64, t.watch_fn) == 0);

    return tk.finish("atspi events");
}
