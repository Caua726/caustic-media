// ui/atspi/hosted.cst — the bridge in the application's loop (ui/host.cst).
//
// The bridge talks over one connection, then two: the session bus it asks
// where the accessibility bus is, and that bus once it knows. Attached, the
// loop watches whichever it has — pumping the bridge when one is readable —
// and pumps it once every round too, after the widgets' events, so what
// changed is told; each round the descriptors watched follow the
// connections the bridge has. Apart from both, so that the loop needs no
// D-Bus and the bridge no window system.
use "../host.cst" as host;
use "bridge.cst" as bridge;
use "atspi.cst" as atspi;

struct Hosted {
    hs  as *host.Host;
    b   as *bridge.Bridge;
    fds as [2]i64;
    n   as i64;
    on  as i32;
    _pad as i32;
}

fn _readable(user as *u8, fd as i64) as void { atspi.pump(cast(*Hosted, user).b); }

// The loop no longer watching what it watched.
fn _let_go(h as *Hosted) as void {
    if (h.fds[0] >= 0) { host.unwatch(h.hs, h.fds[0]); }
    if (h.fds[1] >= 0) { host.unwatch(h.hs, h.fds[1]); }
    h.fds[0] = 0 - 1;
    h.fds[1] = 0 - 1;
    h.n = 0;
}

// The descriptors watched as the bridge's connections are — two at most:
// the session bus's, the accessibility bus's.
fn _follow(h as *Hosted) as void {
    let is [2]i64 as now;
    now[0] = 0 - 1;
    now[1] = 0 - 1;
    let is i64 as k = atspi.fds(h.b, cast(*i64, &now));
    if (now[0] == h.fds[0] && now[1] == h.fds[1]) { return; }
    _let_go(h);
    if (now[0] >= 0) { host.watch(h.hs, now[0], fn_ptr(_readable), cast(*u8, h)); }
    if (now[1] >= 0) { host.watch(h.hs, now[1], fn_ptr(_readable), cast(*u8, h)); }
    h.fds[0] = now[0];
    h.fds[1] = now[1];
    h.n = k;
}

fn _round(user as *u8) as void {
    let is *Hosted as h = cast(*Hosted, user);
    if (h.on == 0) { return; }
    atspi.pump(h.b);
    _follow(h);
}

// b, opened, run by the loop hs from now on: h, where the program keeps it,
// stays where it is while attached.
fn attach(h as *Hosted, hs as *host.Host, b as *bridge.Bridge) as void {
    h.hs = hs;
    h.b = b;
    h.n = 0;
    h.fds[0] = 0 - 1;
    h.fds[1] = 0 - 1;
    h.on = 1;
    _follow(h);
    host.every_round(hs, fn_ptr(_round), cast(*u8, h));
}

// The loop no longer watching it, before the bridge is closed.
fn detach(h as *Hosted) as void {
    _let_go(h);
    h.on = 0;
}

// How many of its descriptors the loop watches.
fn watched(h as *Hosted) as i64 { return h.n; }
