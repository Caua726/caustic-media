// ui/atspi/bridge_test.cst — the bridge's paths: written for a window and a
// widget, read back, and every other shape refused; and the bridge opened
// with no session bus to ask on.
//
// Run with DBUS_SESSION_BUS_ADDRESS naming a bus that is not there (as the
// Causticfile does): it never opens the bridge on a real one.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/env.cst" as env;
use "../../dbus/dbus.cst" as dbus;
use "../app.cst" as app;
use "bridge.cst" as bridge;
use "atspi.cst" as atspi;
use "text.cst" as atext;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is bridge.Bridge as b with mut;
let is bridge.Bridge as none with mut;
let is *u8 as NOWHERE with imut = "unix:path=/nonexistent/caustic-media-test-bus";

// Whether path reads as win and w.
fn reads(path as *u8, win as i64, w as i64) as i32 {
    let is i64 as a with mut = 0 - 1;
    let is i64 as c with mut = 0 - 1;
    let is i32 as ok = bridge.parse(path, dbus.wire.cstr_len(path), &a, &c);
    return cast(i32, ok == 1 && a == win && c == w);
}

fn refused(path as *u8) as i32 {
    let is i64 as a with mut = 7;
    let is i64 as c with mut = 7;
    let is i32 as ok = bridge.parse(path, dbus.wire.cstr_len(path), &a, &c);
    return cast(i32, ok == 0 && a == 7 && c == 7);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    check("a widget's path", dbus.message.named(bridge.path_of(&b, 12, 34), "/org/a11y/atspi/accessible/12_34") == 1);
    check("a long one", dbus.message.named(bridge.path_of(&b, 123456789012, 987654321098765),
                                           "/org/a11y/atspi/accessible/123456789012_987654321098765") == 1);
    check("the root's after it, whole", dbus.message.named(bridge.path_of(&b, 0, 0), bridge.ROOT_PATH) == 1);
    check("a zero in it", dbus.message.named(bridge.path_of(&b, 10, 0), "/org/a11y/atspi/accessible/10_0") == 1);
    check("read back", reads("/org/a11y/atspi/accessible/12_34", 12, 34) == 1);
    check("every digit", reads("/org/a11y/atspi/accessible/1234567890_9087654321", 1234567890, 9087654321) == 1);
    check("eighteen digits", reads("/org/a11y/atspi/accessible/123456789012345678_1", 123456789012345678, 1) == 1 &&
          reads("/org/a11y/atspi/accessible/1_123456789012345678", 1, 123456789012345678) == 1);
    let is [96]u8 as kept;
    let is *u8 as p = bridge.path_of(&b, 4294967297, 8589934593);
    mem.memcpy(cast(*u8, &kept), p, dbus.wire.cstr_len(p) + 1);
    check("written and read", reads(cast(*u8, &kept), 4294967297, 8589934593) == 1);
    check("the root's: no widget's", refused(bridge.ROOT_PATH) == 1);
    check("the prefix alone", refused("/org/a11y/atspi/accessible") == 1 && refused("/org/a11y/atspi/accessible/") == 1);
    check("too short to be one", refused("/org/a11y/atspi/accessible/1_") == 1 && refused("/org/a11y/atspi/accessible/_2") == 1);
    check("another prefix", refused("/org/a11y/atspi/accessiblX/12_34") == 1 && refused("/org/a11y/atspi/accessible_12_34") == 1);
    check("no widget", refused("/org/a11y/atspi/accessible/1234") == 1 && refused("/org/a11y/atspi/accessible/12-34") == 1);
    check("more after it", refused("/org/a11y/atspi/accessible/12_34x") == 1 && refused("/org/a11y/atspi/accessible/12_34_5") == 1);
    check("not digits", refused("/org/a11y/atspi/accessible/ab_34") == 1 && refused("/org/a11y/atspi/accessible/12_cd") == 1);
    check("twenty digits: too many", refused("/org/a11y/atspi/accessible/12345678901234567890_1") == 1 &&
          refused("/org/a11y/atspi/accessible/1_12345678901234567890") == 1);
    check("nineteen", reads("/org/a11y/atspi/accessible/1234567890123456789_1", 1234567890123456789, 1) == 1);
    check("the null path", refused(bridge.NULL_PATH) == 1);

    // --- UTF-8, counted and decoded ---
    check("characters counted", atext.chars("h\xc3\xa9llo", 6) == 5 && atext.chars("", 0) == 0 &&
          atext.chars("ab", 1) == 1 && atext.chars("\xc3\xa9", 1) == 1 && atext.chars("\xa9a", 2) == 1);
    let is [8]i32 as cp;
    check("one byte", atext.decode("a", 1, cast(*i32, &cp)) == 1 && cp[0] == 97);
    check("only n of them", atext.decode("ab", 1, cast(*i32, &cp)) == 1 && cp[0] == 97);
    check("two", atext.decode("\xc3\xa9", 2, cast(*i32, &cp)) == 1 && cp[0] == 233);
    check("two, the least of them", atext.decode("\xc2\x80", 2, cast(*i32, &cp)) == 1 && cp[0] == 128);
    check("three, the least of them", atext.decode("\xe0\xa0\x80", 3, cast(*i32, &cp)) == 1 && cp[0] == 2048);
    check("three", atext.decode("\xe2\x82\xac", 3, cast(*i32, &cp)) == 1 && cp[0] == 8364);
    check("four, the least of them", atext.decode("\xf0\x90\x80\x80", 4, cast(*i32, &cp)) == 1 && cp[0] == 65536);
    check("four, the last there is", atext.decode("\xf4\x8f\xbf\xbf", 4, cast(*i32, &cp)) == 1 && cp[0] == 1114111);
    check("past the last: not UTF-8", atext.decode("\xf4\x90\x80\x80", 4, cast(*i32, &cp)) == 1 && cp[0] == 65533);
    check("cut short", atext.decode("\xe2\x82", 2, cast(*i32, &cp)) == 1 && cp[0] == 65533 &&
          atext.decode("\xc3\xa9", 1, cast(*i32, &cp)) == 1 && cp[0] == 65533);
    check("too many after it", atext.decode("\xc3\xa9\xa9", 3, cast(*i32, &cp)) == 1 && cp[0] == 65533);
    check("continuing nothing: left out", atext.decode("\x80a", 2, cast(*i32, &cp)) == 1 && cp[0] == 97 &&
          atext.decode("\x80\x80a", 3, cast(*i32, &cp)) == 1 && cp[0] == 97);
    check("longer than it needs: not UTF-8", atext.decode("\xc0\x80", 2, cast(*i32, &cp)) == 1 && cp[0] == 65533 &&
          atext.decode("\xe0\x9f\xbf", 3, cast(*i32, &cp)) == 1 && cp[0] == 65533 &&
          atext.decode("\xf0\x8f\xbf\xbf", 4, cast(*i32, &cp)) == 1 && cp[0] == 65533);
    check("a surrogate: not UTF-8", atext.decode("\xed\xa0\x80", 3, cast(*i32, &cp)) == 1 && cp[0] == 65533 &&
          atext.decode("\xed\xbf\xbf", 3, cast(*i32, &cp)) == 1 && cp[0] == 65533);
    check("past the surrogates: UTF-8", atext.decode("\xee\x80\x80", 3, cast(*i32, &cp)) == 1 && cp[0] == 57344);
    check("several", atext.decode("a\xc3\xa9\xe2\x82\xacb", 7, cast(*i32, &cp)) == 4 && cp[1] == 233 && cp[2] == 8364 &&
          cp[3] == 98);

    // --- No session bus ---
    let is *u8 as addr = env.getenv("DBUS_SESSION_BUS_ADDRESS");
    if (cast(i64, addr) == 0 || dbus.message.named(addr, NOWHERE) == 0) {
        io.printf("FAIL: run with DBUS_SESSION_BUS_ADDRESS=%s\n", NOWHERE);
        return 1;
    }
    let is app.Limits as al = app.limits_default();
    let is app.App as a with mut = app.open(&al);
    let is [80]u8 as long;
    let is i64 as i with mut = 0;
    while (i < 70) {
        long[i] = 120;
        i = i + 1;
    }
    check("no bus to ask on: not opened", atspi.open(&none, &a, cast(*u8, &long), 70) == 0 &&
          atspi.stage(&none) == bridge.FAILED && atspi.is_on(&none) == 0);
    check("its name kept, cut to fit", none.name_len == 63 && none.name[62] == 120 && none.name[63] == 0);
    atspi.open(&none, &a, cast(*u8, &long), 64);
    check("one byte too long: cut too", none.name_len == 63 && none.name[63] == 0);
    atspi.open(&none, &a, cast(*u8, &long), 63);
    check("as long as fits: whole", none.name_len == 63 && none.name[63] == 0);
    let is [2]i64 as fds;
    check("no descriptors", atspi.fds(&none, cast(*i64, &fds)) == 0);
    atspi.close(&none);
    check("closed", atspi.stage(&none) == bridge.OFF);
    app.close(&a);
    if (fails == 0) {
        io.printf("atspi bridge: all checks passed\n");
        return 0;
    }
    io.printf("atspi bridge: %d failures\n", fails);
    return 1;
}
