// ui/atspi/select_test.cst — Selection and Table through the bridge: rows
// and tabs chosen and let go of, a table's cells and headers found by row
// and column, its rows chosen.
//
// Run from the repository's root inside dbus/tools/run_dbus.sh.
use "std/env.cst" as env;
use "../../math/math.cst" as math;
use "../../dbus/dbus.cst" as dbus;
use "../tree.cst" as tree;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../model.cst" as model;
use "../app.cst" as app;
use "../widgets/listview.cst" as listview;
use "../widgets/tableview.cst" as tableview;
use "../widgets/tabs.cst" as tabs;
use "../widgets/label.cst" as label;
use "testing.cst" as tk;

let is *u8 as SEL with imut = "org.a11y.atspi.Selection";
let is *u8 as TABLE with imut = "org.a11y.atspi.Table";

// Models of n rows: row i's id i + 1, its name and its size.
let is [5]i64 as counts with mut;

fn name_of(id as i64) as *u8 {
    let is i64 as k = (id - 1) % 5;
    if (k == 0) { return "alpha"; }
    if (k == 1) { return "beta"; }
    if (k == 2) { return "gamma"; }
    if (k == 3) { return "delta"; }
    return "omega";
}

fn rows_count(self as *u8, parent as i64) as i64 {
    if (parent != 0) { return 0; }
    return *cast(*i64, self);
}

fn rows_id(self as *u8, parent as i64, index as i64) as i64 {
    if (parent != 0 || index < 0 || index >= *cast(*i64, self)) { return 0; }
    return index + 1;
}

fn rows_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    if (role != model.TEXT) { return 0; }
    if (column == 0) {
        let is *u8 as s = name_of(id);
        *out = model.text(s, dbus.wire.cstr_len(s));
        return 1;
    }
    if (column == 1) {
        *out = model.integer(id * 10);
        return 1;
    }
    return 0;
}

let is model.Model as m5 with mut;
let is model.Model as m3 with mut;
let is model.Model as m4 with mut;
let is model.Model as m100 with mut;

fn made(m as *model.Model, slot as i64, n as i64) as void {
    counts[slot] = n;
    *m = model.make(cast(*u8, &counts[slot]), fn_ptr(rows_count), fn_ptr(rows_id), fn_ptr(rows_cell));
}

fn n_selected(p as *u8) as i64 { return tk.prop_int(p, SEL, "NSelectedChildren"); }

fn int_of(r as dbus.wire.Reader) as i64 {
    let is dbus.wire.Reader as q with mut = r;
    let is i64 as v = dbus.wire.get_i32(&q);
    if (q.err != 0) { return 0 - 999; }
    return v;
}

// Whether a reply is a boolean false — an answer, not an error.
fn no(r as dbus.wire.Reader) as i32 {
    let is dbus.wire.Reader as q with mut = r;
    return cast(i32, dbus.wire.get_bool(&q) == 0 && q.err == 0);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (tk.setup() == 0) { return 1; }
    let is *app.App as a = &tk.a;
    made(&m5, 0, 5);
    made(&m3, 1, 3);
    made(&m4, 2, 4);
    made(&m100, 3, 100);
    let is i64 as win = app.window_open(a, 600.0, 900.0);
    let is *tree.Tree as t = app.tree(a, win);
    let is i64 as root = tree.root(t);
    let is i64 as col = box.create(t, root, box.COLUMN);
    let is i64 as many = listview.create(t, col, &m5);
    listview.set_selection_mode(t, many, listview.MULTIPLE);
    layout.set_min_size(t, many, 200.0, 160.0);
    let is i64 as one = listview.create(t, col, &m3);
    layout.set_min_size(t, one, 200.0, 100.0);
    let is i64 as tb = tabs.create(t, col);
    tabs.add(t, tb, "First", 5);
    tabs.add(t, tb, "Second", 6);
    let is i64 as table = tableview.create(t, col, &m4);
    tableview.add_column(t, table, "Name", 4, 120.0);
    tableview.add_column(t, table, "Size", 4, 80.0);
    layout.set_min_size(t, table, 300.0, 160.0);
    let is i64 as tl = tableview.list(t, table);
    listview.set_selection_mode(t, tl, listview.MULTIPLE);
    let is i64 as long = tableview.create(t, col, &m100);
    tableview.add_column(t, long, "Name", 4, 120.0);
    layout.set_max_size(t, long, 300.0, 120.0);
    let is i64 as ll = tableview.list(t, long);
    app.frame(a, win);
    listview.scroll_to_row(t, ll, 80);
    app.frame(a, win);
    tk.check("on", tk.turn_on() == 1);

    let is [96]u8 as mb;
    let is *u8 as MANY = tk.path(win, many, cast(*u8, &mb));
    let is [96]u8 as ob;
    let is *u8 as ONE = tk.path(win, one, cast(*u8, &ob));
    let is [96]u8 as sb;
    let is *u8 as STRIP = tk.path(win, tabs.strip(t, tb), cast(*u8, &sb));
    let is [96]u8 as tbb;
    let is *u8 as TB = tk.path(win, tl, cast(*u8, &tbb));
    let is [96]u8 as lb;
    let is *u8 as LONG = tk.path(win, ll, cast(*u8, &lb));

    // --- A list where many are chosen ---
    tk.check("a list, choosing among its rows", tk.role_of(MANY) == 31 && tk.has_iface(MANY, SEL) == 1 &&
             tk.has_iface(MANY, TABLE) == 0);
    tk.check("its rows told", tk.prop_int(MANY, tk.ACC, "ChildCount") == 5);
    tk.check("none chosen", n_selected(MANY) == 0);
    tk.check("one chosen", tk.yes(tk.call_i(MANY, SEL, "SelectChild", 1)) == 1 && listview.is_selected(t, many, 1) == 1);
    tk.check("another added", tk.yes(tk.call_i(MANY, SEL, "SelectChild", 3)) == 1 && listview.selected_count(t, many) == 2);
    tk.check("so many", n_selected(MANY) == 2);
    let is dbus.wire.Reader as gs with mut = tk.call_i(MANY, SEL, "GetSelectedChild", 1);
    tk.check("the second of them", tk.ref_is(&gs, win, listview.row_widget(t, many, 3)) == 1);
    gs = tk.call_i(MANY, SEL, "GetSelectedChild", 0);
    tk.check("the first", tk.ref_is(&gs, win, listview.row_widget(t, many, 1)) == 1);
    tk.check("not a table: no rows told as one", tk.prop_int(MANY, TABLE, "NRows") == 0);
    tk.check("which are chosen", tk.yes(tk.call_i(MANY, SEL, "IsChildSelected", 3)) == 1 &&
             tk.yes(tk.call_i(MANY, SEL, "IsChildSelected", 0)) == 0);
    tk.check("the first of them let go of", tk.yes(tk.call_i(MANY, SEL, "DeselectSelectedChild", 0)) == 1 &&
             listview.is_selected(t, many, 1) == 0 && listview.is_selected(t, many, 3) == 1);
    tk.check("a child let go of", tk.yes(tk.call_i(MANY, SEL, "DeselectChild", 3)) == 1 && listview.selected_count(t, many) == 0);
    tk.check("all chosen", tk.yes(tk.call0(MANY, SEL, "SelectAll")) == 1 && listview.selected_count(t, many) == 5);
    tk.check("none again", tk.yes(tk.call0(MANY, SEL, "ClearSelection")) == 1 && listview.selected_count(t, many) == 0);
    tk.check("no such child: nothing", tk.yes(tk.call_i(MANY, SEL, "SelectChild", 9)) == 0 &&
             tk.yes(tk.call_i(MANY, SEL, "DeselectChild", 0)) == 0);
    let is dbus.wire.Reader as none with mut = tk.call_i(MANY, SEL, "GetSelectedChild", 0);
    tk.check("no chosen child: the null one", tk.is_null(&none) == 1);

    // Where a row is, from where its list is.
    let is i64 as row0 = listview.row_widget(t, one, 0);
    let is [96]u8 as r0b;
    let is *u8 as ROW0 = tk.path(win, row0, cast(*u8, &r0b));
    let is dbus.message.Message as ext with mut = tk.msg(ROW0, "org.a11y.atspi.Component", "GetExtents");
    ext.signature = "u";
    dbus.wire.put_u32(dbus.conn.body(&tk.at), 2);
    let is dbus.wire.Reader as er with mut = tk.reply_of(&ext);
    dbus.wire.get_struct(&er);
    let is math.rect.Rect as lr = layout.window_rect(t, one);
    let is math.rect.Rect as rr0 = layout.window_rect(t, row0);
    tk.check("a list's row, from the list", lr.y > 0.0 && dbus.wire.get_i32(&er) == cast(i64, rr0.x - lr.x) &&
             dbus.wire.get_i32(&er) == cast(i64, rr0.y - lr.y));

    // --- One at a time ---
    tk.call_i(ONE, SEL, "SelectChild", 0);
    tk.check("one at a time: the last chosen alone", tk.yes(tk.call_i(ONE, SEL, "SelectChild", 2)) == 1 &&
             listview.selected_count(t, one) == 1 && listview.is_selected(t, one, 2) == 1);
    tk.check("not all", tk.yes(tk.call0(ONE, SEL, "SelectAll")) == 0 && listview.selected_count(t, one) == 1);

    // --- Tabs ---
    tk.check("a tab list, choosing its tab", tk.role_of(STRIP) == 38 && tk.has_iface(STRIP, SEL) == 1 &&
             tk.yes(tk.call_i(STRIP, SEL, "IsChildSelected", 0)) == 1);
    tk.check("another chosen", tk.yes(tk.call_i(STRIP, SEL, "SelectChild", 1)) == 1 && tabs.current(t, tb) == 1);
    tk.check("but never none", tk.yes(tk.call_i(STRIP, SEL, "DeselectChild", 1)) == 0 && tabs.current(t, tb) == 1);

    // --- A table ---
    tk.check("a table", tk.role_of(TB) == 55 && tk.has_iface(TB, TABLE) == 1 && tk.has_iface(TB, SEL) == 1);
    tk.check("of rows and columns", tk.prop_int(TB, TABLE, "NRows") == 4 && tk.prop_int(TB, TABLE, "NColumns") == 2);
    let is i64 as row1 = listview.row_widget(t, tl, 1);
    let is dbus.wire.Reader as cell with mut = tk.call_ii(TB, TABLE, "GetAccessibleAt", 1, 1);
    tk.check("a cell by row and column", tk.ref_is(&cell, win, tableview.cell_label(t, row1, 1)) == 1);
    let is dbus.wire.Reader as gone with mut = tk.call_ii(TB, TABLE, "GetAccessibleAt", 9, 0);
    tk.check("past its rows: the null one", tk.is_null(&gone) == 1);
    let is dbus.wire.Reader as ix with mut = tk.call_ii(TB, TABLE, "GetIndexAt", 1, 1);
    tk.check("its index", dbus.wire.get_i32(&ix) == 3);
    tk.check("no index outside it", int_of(tk.call_ii(TB, TABLE, "GetIndexAt", 0 - 1, 0)) == 0 - 1 &&
             int_of(tk.call_ii(TB, TABLE, "GetIndexAt", 4, 0)) == 0 - 1 &&
             int_of(tk.call_ii(TB, TABLE, "GetIndexAt", 0, 0 - 1)) == 0 - 1 &&
             int_of(tk.call_ii(TB, TABLE, "GetIndexAt", 0, 2)) == 0 - 1);
    tk.check("the first and the last", int_of(tk.call_ii(TB, TABLE, "GetIndexAt", 0, 0)) == 0 &&
             int_of(tk.call_ii(TB, TABLE, "GetIndexAt", 3, 1)) == 7);
    tk.check("no row or column of an index outside", int_of(tk.call_i(TB, TABLE, "GetRowAtIndex", 0 - 1)) == 0 - 1 &&
             int_of(tk.call_i(TB, TABLE, "GetRowAtIndex", 8)) == 0 - 1 &&
             int_of(tk.call_i(TB, TABLE, "GetColumnAtIndex", 8)) == 0 - 1 &&
             int_of(tk.call_i(TB, TABLE, "GetColumnAtIndex", 7)) == 1 && int_of(tk.call_i(TB, TABLE, "GetRowAtIndex", 0)) == 0);
    let is dbus.wire.Reader as nocol with mut = tk.call_ii(TB, TABLE, "GetAccessibleAt", 1, 0 - 1);
    tk.check("no cell before the first column", tk.is_null(&nocol) == 1);
    nocol = tk.call_ii(TB, TABLE, "GetAccessibleAt", 1, 2);
    tk.check("nor past the last", tk.is_null(&nocol) == 1);
    let is dbus.wire.Reader as nohead with mut = tk.call_i(TB, TABLE, "GetColumnHeader", 0 - 1);
    tk.check("no header before the first", tk.is_null(&nohead) == 1);
    nohead = tk.call_i(TB, TABLE, "GetColumnHeader", 2);
    tk.check("nor past the last", tk.is_null(&nohead) == 1);
    let is dbus.wire.Reader as rd with mut = tk.call_i(TB, TABLE, "GetRowDescription", 0);
    let is i64 as rdn with mut = 0;
    tk.check("rows not described", tk.same(dbus.wire.get_string(&rd, &rdn), rdn, "") == 1 && rd.err == 0);
    tk.check("the first cell spans one", int_of(tk.call_ii(TB, TABLE, "GetRowExtentAt", 0, 0)) == 1 &&
             int_of(tk.call_ii(TB, TABLE, "GetColumnExtentAt", 0, 0)) == 1);
    tk.check("no span outside it", int_of(tk.call_ii(TB, TABLE, "GetRowExtentAt", 0 - 1, 0)) == 0 &&
             int_of(tk.call_ii(TB, TABLE, "GetRowExtentAt", 4, 0)) == 0 &&
             int_of(tk.call_ii(TB, TABLE, "GetColumnExtentAt", 0, 0 - 1)) == 0 &&
             int_of(tk.call_ii(TB, TABLE, "GetColumnExtentAt", 0, 2)) == 0);
    let is dbus.wire.Reader as ri with mut = tk.call_i(TB, TABLE, "GetRowAtIndex", 3);
    tk.check("the row of an index", dbus.wire.get_i32(&ri) == 1);
    let is dbus.wire.Reader as ci with mut = tk.call_i(TB, TABLE, "GetColumnAtIndex", 3);
    tk.check("the column of an index", dbus.wire.get_i32(&ci) == 1);
    let is dbus.wire.Reader as ch with mut = tk.call_i(TB, TABLE, "GetColumnHeader", 1);
    tk.check("a column's header", tk.ref_is(&ch, win, tableview.header_cell(t, table, 1)) == 1);
    let is dbus.wire.Reader as cd with mut = tk.call_i(TB, TABLE, "GetColumnDescription", 0);
    let is i64 as n with mut = 0;
    tk.check("described by its header", tk.same(dbus.wire.get_string(&cd, &n), n, "Name") == 1);
    let is dbus.wire.Reader as rh with mut = tk.call_i(TB, TABLE, "GetRowHeader", 0);
    tk.check("rows have no headers", tk.is_null(&rh) == 1);
    let is dbus.wire.Reader as extent_reader with mut = tk.call_ii(TB, TABLE, "GetRowExtentAt", 1, 1);
    tk.check("a cell spans one row", dbus.wire.get_i32(&extent_reader) == 1);
    extent_reader = tk.call_ii(TB, TABLE, "GetColumnExtentAt", 1, 1);
    tk.check("and one column", dbus.wire.get_i32(&extent_reader) == 1);
    listview.select(t, tl, 1);
    tk.check("a row chosen", tk.yes(tk.call_i(TB, TABLE, "IsRowSelected", 1)) == 1 &&
             tk.yes(tk.call_ii(TB, TABLE, "IsSelected", 1, 0)) == 1 && tk.prop_int(TB, TABLE, "NSelectedRows") == 1);
    let is dbus.wire.Reader as sr with mut = tk.call0(TB, TABLE, "GetSelectedRows");
    let is i64 as end = dbus.wire.get_array(&sr, 4);
    tk.check("the rows chosen", dbus.wire.get_i32(&sr) == 1 && sr.pos == end);
    tk.check("another added", tk.yes(tk.call_i(TB, TABLE, "AddRowSelection", 2)) == 1 && listview.is_selected(t, tl, 2) == 1 &&
             listview.is_selected(t, tl, 1) == 1);
    tk.check("one let go of", tk.yes(tk.call_i(TB, TABLE, "RemoveRowSelection", 1)) == 1 && listview.is_selected(t, tl, 1) == 0);
    tk.check("columns are not chosen", tk.prop_int(TB, TABLE, "NSelectedColumns") == 0 &&
             no(tk.call_i(TB, TABLE, "AddColumnSelection", 0)) == 1 &&
             no(tk.call_i(TB, TABLE, "RemoveColumnSelection", 0)) == 1 &&
             no(tk.call_i(TB, TABLE, "IsColumnSelected", 0)) == 1);
    let is dbus.wire.Reader as sc with mut = tk.call0(TB, TABLE, "GetSelectedColumns");
    let is i64 as sc_end = dbus.wire.get_array(&sc, 4);
    tk.check("none of them", sc.pos == sc_end && sc.err == 0);
    tk.check("a cell past the columns: not chosen", no(tk.call_ii(TB, TABLE, "IsSelected", 2, 2)) == 1 &&
             no(tk.call_ii(TB, TABLE, "IsSelected", 2, 0 - 1)) == 1 && tk.yes(tk.call_ii(TB, TABLE, "IsSelected", 2, 1)) == 1);
    let is dbus.wire.Reader as rc0 with mut = tk.call_i(TB, TABLE, "GetRowColumnExtentsAtIndex", 0);
    tk.check("the first index's place", dbus.wire.get_bool(&rc0) == 1 && dbus.wire.get_i32(&rc0) == 0 && dbus.wire.get_i32(&rc0) == 0);
    let is dbus.wire.Reader as rc with mut = tk.call_i(TB, TABLE, "GetRowColumnExtentsAtIndex", 5);
    let is i32 as found = dbus.wire.get_bool(&rc);
    let is i64 as rr = dbus.wire.get_i32(&rc);
    let is i64 as cc = dbus.wire.get_i32(&rc);
    let is i64 as rs = dbus.wire.get_i32(&rc);
    let is i64 as cs = dbus.wire.get_i32(&rc);
    let is i32 as chosen = dbus.wire.get_bool(&rc);
    tk.check("an index's place", found == 1 && rr == 2 && cc == 1 && rs == 1 && cs == 1 && chosen == 1 && rc.err == 0);

    // --- A long table, scrolled ---
    tk.check("all its rows counted", tk.prop_int(LONG, TABLE, "NRows") == 100);
    let is dbus.wire.Reader as far with mut = tk.call_ii(LONG, TABLE, "GetAccessibleAt", 80, 0);
    tk.check("a row far down, shown: found", tk.ref_is(&far, win, tableview.cell_label(t, listview.row_widget(t, ll, 80), 0)) == 1);
    let is dbus.wire.Reader as top with mut = tk.call_ii(LONG, TABLE, "GetAccessibleAt", 0, 0);
    tk.check("the first, scrolled away: not there to give", tk.is_null(&top) == 1);

    return tk.finish("atspi select");
}
