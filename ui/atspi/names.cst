// ui/atspi/names.cst — the toolkit's accessibility words in AT-SPI's numbers.
//
// access.cst's roles, states and actions are close to AT-SPI's but not its:
// here each is given the number AT-SPI has for it (AtspiRole, AtspiStateType)
// and the name its clients print.
use "../access.cst" as access;

// --- Roles (AtspiRole) ---

let is i64 as R_INVALID         with imut = 0;
let is i64 as R_ALERT           with imut = 2;
let is i64 as R_CHECK_BOX       with imut = 7;
let is i64 as R_CHECK_MENU_ITEM with imut = 8;
let is i64 as R_COLOR_CHOOSER   with imut = 9;
let is i64 as R_COLUMN_HEADER   with imut = 10;
let is i64 as R_COMBO_BOX       with imut = 11;
let is i64 as R_DIALOG          with imut = 16;
let is i64 as R_FILLER          with imut = 20;
let is i64 as R_FONT_CHOOSER    with imut = 22;
let is i64 as R_FRAME           with imut = 23;
let is i64 as R_IMAGE           with imut = 27;
let is i64 as R_LABEL           with imut = 29;
let is i64 as R_LIST            with imut = 31;
let is i64 as R_LIST_ITEM       with imut = 32;
let is i64 as R_MENU            with imut = 33;
let is i64 as R_MENU_BAR        with imut = 34;
let is i64 as R_MENU_ITEM       with imut = 35;
let is i64 as R_PAGE_TAB        with imut = 37;
let is i64 as R_PAGE_TAB_LIST   with imut = 38;
let is i64 as R_PANEL           with imut = 39;
let is i64 as R_PASSWORD_TEXT   with imut = 40;
let is i64 as R_PROGRESS_BAR    with imut = 42;
let is i64 as R_BUTTON          with imut = 43;
let is i64 as R_RADIO_BUTTON    with imut = 44;
let is i64 as R_RADIO_MENU_ITEM with imut = 45;
let is i64 as R_SCROLL_BAR      with imut = 48;
let is i64 as R_SCROLL_PANE     with imut = 49;
let is i64 as R_SEPARATOR       with imut = 50;
let is i64 as R_SLIDER          with imut = 51;
let is i64 as R_SPIN_BUTTON     with imut = 52;
let is i64 as R_SPLIT_PANE      with imut = 53;
let is i64 as R_STATUS_BAR      with imut = 54;
let is i64 as R_TABLE           with imut = 55;
let is i64 as R_TABLE_CELL      with imut = 56;
let is i64 as R_TEXT            with imut = 61;
let is i64 as R_TOGGLE_BUTTON   with imut = 62;
let is i64 as R_TOOL_BAR        with imut = 63;
let is i64 as R_TOOL_TIP        with imut = 64;
let is i64 as R_TREE            with imut = 65;
let is i64 as R_APPLICATION     with imut = 75;
let is i64 as R_ENTRY           with imut = 79;
let is i64 as R_LINK            with imut = 88;
let is i64 as R_TABLE_ROW       with imut = 90;
let is i64 as R_TREE_ITEM       with imut = 91;
let is i64 as R_GROUPING        with imut = 99;
let is i64 as R_TITLE_BAR       with imut = 104;
let is i64 as R_SWITCH          with imut = 130;

// The AT-SPI role of an access role. A window is a frame; a container with
// nothing to say a filler (it is not told at all, but a role it has).
fn role(r as i64) as i64 {
    if (r == access.ROLE_WINDOW) { return R_FRAME; }
    if (r == access.ROLE_DIALOG) { return R_DIALOG; }
    if (r == access.ROLE_ALERT) { return R_ALERT; }
    if (r == access.ROLE_PANEL) { return R_PANEL; }
    if (r == access.ROLE_LABEL) { return R_LABEL; }
    if (r == access.ROLE_BUTTON) { return R_BUTTON; }
    if (r == access.ROLE_TOGGLE_BUTTON) { return R_TOGGLE_BUTTON; }
    if (r == access.ROLE_LINK) { return R_LINK; }
    if (r == access.ROLE_CHECK_BOX) { return R_CHECK_BOX; }
    if (r == access.ROLE_RADIO_BUTTON) { return R_RADIO_BUTTON; }
    if (r == access.ROLE_SWITCH) { return R_SWITCH; }
    if (r == access.ROLE_SLIDER) { return R_SLIDER; }
    if (r == access.ROLE_SPIN_BUTTON) { return R_SPIN_BUTTON; }
    if (r == access.ROLE_PROGRESS_BAR) { return R_PROGRESS_BAR; }
    if (r == access.ROLE_SEPARATOR) { return R_SEPARATOR; }
    if (r == access.ROLE_IMAGE) { return R_IMAGE; }
    if (r == access.ROLE_GROUP) { return R_GROUPING; }
    if (r == access.ROLE_TOOLTIP) { return R_TOOL_TIP; }
    if (r == access.ROLE_ENTRY) { return R_ENTRY; }
    if (r == access.ROLE_PASSWORD) { return R_PASSWORD_TEXT; }
    if (r == access.ROLE_TEXT) { return R_TEXT; }
    if (r == access.ROLE_SCROLL_PANE) { return R_SCROLL_PANE; }
    if (r == access.ROLE_SCROLL_BAR) { return R_SCROLL_BAR; }
    if (r == access.ROLE_SPLIT_PANE) { return R_SPLIT_PANE; }
    if (r == access.ROLE_TAB_LIST) { return R_PAGE_TAB_LIST; }
    if (r == access.ROLE_TAB) { return R_PAGE_TAB; }
    if (r == access.ROLE_LIST) { return R_LIST; }
    if (r == access.ROLE_LIST_ITEM) { return R_LIST_ITEM; }
    if (r == access.ROLE_TREE) { return R_TREE; }
    if (r == access.ROLE_TREE_ITEM) { return R_TREE_ITEM; }
    if (r == access.ROLE_TABLE) { return R_TABLE; }
    if (r == access.ROLE_CELL) { return R_TABLE_CELL; }
    if (r == access.ROLE_COLUMN_HEADER) { return R_COLUMN_HEADER; }
    if (r == access.ROLE_COMBO_BOX) { return R_COMBO_BOX; }
    if (r == access.ROLE_MENU_BAR) { return R_MENU_BAR; }
    if (r == access.ROLE_MENU) { return R_MENU; }
    if (r == access.ROLE_MENU_ITEM) { return R_MENU_ITEM; }
    if (r == access.ROLE_CHECK_MENU_ITEM) { return R_CHECK_MENU_ITEM; }
    if (r == access.ROLE_RADIO_MENU_ITEM) { return R_RADIO_MENU_ITEM; }
    if (r == access.ROLE_TOOL_BAR) { return R_TOOL_BAR; }
    if (r == access.ROLE_STATUS_BAR) { return R_STATUS_BAR; }
    if (r == access.ROLE_TITLE_BAR) { return R_TITLE_BAR; }
    if (r == access.ROLE_TABLE_ROW) { return R_TABLE_ROW; }
    if (r == access.ROLE_COLOR_CHOOSER) { return R_COLOR_CHOOSER; }
    if (r == access.ROLE_FONT_CHOOSER) { return R_FONT_CHOOSER; }
    return R_FILLER;
}

// The name an AT-SPI client prints for an AT-SPI role, as AT-SPI spells it.
fn role_name(r as i64) as *u8 {
    if (r == R_ALERT) { return "alert"; }
    if (r == R_CHECK_BOX) { return "check box"; }
    if (r == R_CHECK_MENU_ITEM) { return "check menu item"; }
    if (r == R_COLOR_CHOOSER) { return "color chooser"; }
    if (r == R_COLUMN_HEADER) { return "column header"; }
    if (r == R_COMBO_BOX) { return "combo box"; }
    if (r == R_DIALOG) { return "dialog"; }
    if (r == R_FILLER) { return "filler"; }
    if (r == R_FONT_CHOOSER) { return "font chooser"; }
    if (r == R_FRAME) { return "frame"; }
    if (r == R_IMAGE) { return "image"; }
    if (r == R_LABEL) { return "label"; }
    if (r == R_LIST) { return "list"; }
    if (r == R_LIST_ITEM) { return "list item"; }
    if (r == R_MENU) { return "menu"; }
    if (r == R_MENU_BAR) { return "menu bar"; }
    if (r == R_MENU_ITEM) { return "menu item"; }
    if (r == R_PAGE_TAB) { return "page tab"; }
    if (r == R_PAGE_TAB_LIST) { return "page tab list"; }
    if (r == R_PANEL) { return "panel"; }
    if (r == R_PASSWORD_TEXT) { return "password text"; }
    if (r == R_PROGRESS_BAR) { return "progress bar"; }
    if (r == R_BUTTON) { return "button"; }
    if (r == R_RADIO_BUTTON) { return "radio button"; }
    if (r == R_RADIO_MENU_ITEM) { return "radio menu item"; }
    if (r == R_SCROLL_BAR) { return "scroll bar"; }
    if (r == R_SCROLL_PANE) { return "scroll pane"; }
    if (r == R_SEPARATOR) { return "separator"; }
    if (r == R_SLIDER) { return "slider"; }
    if (r == R_SPIN_BUTTON) { return "spin button"; }
    if (r == R_SPLIT_PANE) { return "split pane"; }
    if (r == R_STATUS_BAR) { return "status bar"; }
    if (r == R_TABLE) { return "table"; }
    if (r == R_TABLE_CELL) { return "table cell"; }
    if (r == R_TEXT) { return "text"; }
    if (r == R_TOGGLE_BUTTON) { return "toggle button"; }
    if (r == R_TOOL_BAR) { return "tool bar"; }
    if (r == R_TOOL_TIP) { return "tool tip"; }
    if (r == R_TREE) { return "tree"; }
    if (r == R_APPLICATION) { return "application"; }
    if (r == R_ENTRY) { return "entry"; }
    if (r == R_LINK) { return "link"; }
    if (r == R_TABLE_ROW) { return "table row"; }
    if (r == R_TREE_ITEM) { return "tree item"; }
    if (r == R_GROUPING) { return "grouping"; }
    if (r == R_TITLE_BAR) { return "title bar"; }
    if (r == R_SWITCH) { return "switch"; }
    return "invalid";
}

// --- States (AtspiStateType): bit numbers of a two-word set ---

let is i64 as S_ACTIVE          with imut = 1;
let is i64 as S_BUSY            with imut = 3;
let is i64 as S_CHECKED         with imut = 4;
let is i64 as S_COLLAPSED       with imut = 5;
let is i64 as S_EDITABLE        with imut = 7;
let is i64 as S_ENABLED         with imut = 8;
let is i64 as S_EXPANDABLE      with imut = 9;
let is i64 as S_EXPANDED        with imut = 10;
let is i64 as S_FOCUSABLE       with imut = 11;
let is i64 as S_FOCUSED         with imut = 12;
let is i64 as S_HORIZONTAL      with imut = 14;
let is i64 as S_MODAL           with imut = 16;
let is i64 as S_MULTI_LINE      with imut = 17;
let is i64 as S_MULTISELECTABLE with imut = 18;
let is i64 as S_PRESSED         with imut = 20;
let is i64 as S_SELECTABLE      with imut = 22;
let is i64 as S_SELECTED        with imut = 23;
let is i64 as S_SENSITIVE       with imut = 24;
let is i64 as S_SHOWING         with imut = 25;
let is i64 as S_SINGLE_LINE     with imut = 26;
let is i64 as S_VERTICAL        with imut = 29;
let is i64 as S_VISIBLE         with imut = 30;
let is i64 as S_INDETERMINATE   with imut = 32;
let is i64 as S_REQUIRED        with imut = 33;
let is i64 as S_INVALID_ENTRY   with imut = 36;
let is i64 as S_IS_DEFAULT      with imut = 39;
let is i64 as S_VISITED         with imut = 40;
let is i64 as S_CHECKABLE       with imut = 41;
let is i64 as S_READ_ONLY       with imut = 43;

// A state set as AT-SPI sends it: two 32-bit words, bit n of the set bit
// n % 32 of word n / 32. Here one i64, bit n.
fn states(s as i64, role as i64, text as i32) as i64 {
    let is i64 as out with mut = 0;
    if ((s & access.VISIBLE) != 0) { out = out | (1 << S_VISIBLE); }
    if ((s & access.SHOWING) != 0) { out = out | (1 << S_SHOWING); }
    if ((s & access.ENABLED) != 0) { out = out | (1 << S_ENABLED) | (1 << S_SENSITIVE); }
    if ((s & access.FOCUSABLE) != 0) { out = out | (1 << S_FOCUSABLE); }
    if ((s & access.FOCUSED) != 0) { out = out | (1 << S_FOCUSED); }
    if ((s & access.CHECKABLE) != 0) { out = out | (1 << S_CHECKABLE); }
    if ((s & access.CHECKED) != 0) { out = out | (1 << S_CHECKED); }
    if ((s & access.MIXED) != 0) { out = out | (1 << S_INDETERMINATE); }
    if ((s & access.PRESSED) != 0) { out = out | (1 << S_PRESSED); }
    if ((s & access.EXPANDABLE) != 0) {
        out = out | (1 << S_EXPANDABLE);
        if ((s & access.EXPANDED) == 0) { out = out | (1 << S_COLLAPSED); }
    }
    if ((s & access.EXPANDED) != 0) { out = out | (1 << S_EXPANDED); }
    if ((s & access.SELECTABLE) != 0) { out = out | (1 << S_SELECTABLE); }
    if ((s & access.SELECTED) != 0) { out = out | (1 << S_SELECTED); }
    if ((s & access.EDITABLE) != 0) { out = out | (1 << S_EDITABLE); }
    if ((s & access.READ_ONLY) != 0) { out = out | (1 << S_READ_ONLY); }
    if ((s & access.REQUIRED) != 0) { out = out | (1 << S_REQUIRED); }
    if ((s & access.BUSY) != 0) { out = out | (1 << S_BUSY); }
    if ((s & access.MULTI_LINE) != 0) { out = out | (1 << S_MULTI_LINE); }
    // Text of one line says so: an entry, a password.
    if (text == 1 && (s & access.MULTI_LINE) == 0) { out = out | (1 << S_SINGLE_LINE); }
    if ((s & access.HORIZONTAL) != 0) { out = out | (1 << S_HORIZONTAL); }
    if ((s & access.VERTICAL) != 0) { out = out | (1 << S_VERTICAL); }
    if ((s & access.DEFAULT) != 0) { out = out | (1 << S_IS_DEFAULT); }
    if ((s & access.VISITED) != 0) { out = out | (1 << S_VISITED); }
    if ((s & access.MODAL) != 0) { out = out | (1 << S_MODAL); }
    if ((s & access.INVALID) != 0) { out = out | (1 << S_INVALID_ENTRY); }
    if ((s & access.MULTISELECTABLE) != 0) { out = out | (1 << S_MULTISELECTABLE); }
    return out;
}

// The name of a state bit, as an Object:StateChanged event's detail spells
// it; null for one never told.
fn state_name(bit as i64) as *u8 {
    if (bit == S_ACTIVE) { return "active"; }
    if (bit == S_BUSY) { return "busy"; }
    if (bit == S_CHECKED) { return "checked"; }
    if (bit == S_COLLAPSED) { return "collapsed"; }
    if (bit == S_EDITABLE) { return "editable"; }
    if (bit == S_ENABLED) { return "enabled"; }
    if (bit == S_EXPANDABLE) { return "expandable"; }
    if (bit == S_EXPANDED) { return "expanded"; }
    if (bit == S_FOCUSABLE) { return "focusable"; }
    if (bit == S_FOCUSED) { return "focused"; }
    if (bit == S_HORIZONTAL) { return "horizontal"; }
    if (bit == S_MODAL) { return "modal"; }
    if (bit == S_MULTI_LINE) { return "multi-line"; }
    if (bit == S_MULTISELECTABLE) { return "multiselectable"; }
    if (bit == S_PRESSED) { return "pressed"; }
    if (bit == S_SELECTABLE) { return "selectable"; }
    if (bit == S_SELECTED) { return "selected"; }
    if (bit == S_SENSITIVE) { return "sensitive"; }
    if (bit == S_SHOWING) { return "showing"; }
    if (bit == S_SINGLE_LINE) { return "single-line"; }
    if (bit == S_VERTICAL) { return "vertical"; }
    if (bit == S_VISIBLE) { return "visible"; }
    if (bit == S_INDETERMINATE) { return "indeterminate"; }
    if (bit == S_REQUIRED) { return "required"; }
    if (bit == S_INVALID_ENTRY) { return "invalid-entry"; }
    if (bit == S_IS_DEFAULT) { return "is-default"; }
    if (bit == S_VISITED) { return "visited"; }
    if (bit == S_CHECKABLE) { return "checkable"; }
    if (bit == S_READ_ONLY) { return "read-only"; }
    return cast(*u8, 0);
}

// --- Actions ---
//
// What access.cst says a widget answers to, in a fixed order, each with the
// name AT-SPI clients look for.
let is i64 as NACTIONS with imut = 8;

fn action_bit(i as i64) as i64 {
    if (i == 0) { return access.PRESS; }
    if (i == 1) { return access.TOGGLE; }
    if (i == 2) { return access.INCREMENT; }
    if (i == 3) { return access.DECREMENT; }
    if (i == 4) { return access.EXPAND; }
    if (i == 5) { return access.COLLAPSE; }
    if (i == 6) { return access.SELECT; }
    if (i == 7) { return access.SHOW_MENU; }
    return 0;
}

fn action_name(bit as i64) as *u8 {
    if (bit == access.PRESS) { return "click"; }
    if (bit == access.TOGGLE) { return "toggle"; }
    if (bit == access.INCREMENT) { return "increment"; }
    if (bit == access.DECREMENT) { return "decrement"; }
    if (bit == access.EXPAND) { return "expand"; }
    if (bit == access.COLLAPSE) { return "collapse"; }
    if (bit == access.SELECT) { return "select"; }
    if (bit == access.SHOW_MENU) { return "menu"; }
    return "";
}

// The i-th of the actions bits holds, in that order: its bit, 0 for none.
fn nth_action(bits as i64, i as i64) as i64 {
    let is i64 as seen with mut = 0;
    let is i64 as k with mut = 0;
    while (k < NACTIONS) {
        let is i64 as b = action_bit(k);
        if ((bits & b) != 0) {
            if (seen == i) { return b; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    return 0;
}

// How many actions bits holds.
fn action_count(bits as i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as k with mut = 0;
    while (k < NACTIONS) {
        if ((bits & action_bit(k)) != 0) { n = n + 1; }
        k = k + 1;
    }
    return n;
}
