// ui/atspi/hosted_test.cst — the bridge in the application's loop: its
// connections watched by the loop, pumped when they are readable and after
// every round, with nothing pumping it by hand. On a private bus and Xvfb:
//   sh dbus/tools/run_dbus.sh sh window/x11/tools/run_headless.sh ./build/atspi_hosted_test
// The desktop is played here too, on a connection the loop watches as if it
// were another program.
use "std/time.cst" as time;
use "std/env.cst" as env;
use "../../dbus/dbus.cst" as dbus;
use "../tree.cst" as tree;
use "../box.cst" as box;
use "../app.cst" as app;
use "../host.cst" as host;
use "../widgets/button.cst" as button;
use "atspi.cst" as atspi;
use "hosted.cst" as hosted;
use "testing.cst" as tk;

fn desktop(user as *u8, fd as i64) as void { dbus.conn.dispatch(&tk.fake, 0); }

let is hosted.Hosted as hb with mut;

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (tk.setup() == 0) { return 1; }
    let is *app.App as a = &tk.a;
    let is i64 as win = app.window_open(a, 300.0, 200.0);
    app.set_title(a, win, "Hosted", 6);
    let is *tree.Tree as t = app.tree(a, win);
    let is i64 as col = box.create(t, tree.root(t), box.COLUMN);
    button.create(t, col, "OK", 2);
    let is *host.Host as hs = host.open(a, &tk.dv, cast(*u8, tk.svc));
    host.watch(hs, dbus.conn.fd(&tk.fake), fn_ptr(desktop), cast(*u8, 0));

    tk.enabled = 1;
    tk.check("the bridge opened", atspi.open(&tk.b, a, "Caustic hosted", 14) == 1);
    hosted.attach(&hb, hs, &tk.b);
    tk.check("asking the session bus: its connection watched", hosted.watched(&hb) == 1 && host.watched(hs) == 2);
    let is i64 as deadline with mut = time.now_ms() + 3000;
    while (time.now_ms() < deadline && atspi.is_on(&tk.b) == 0) { host.step(hs, 200); }
    tk.check("on, pumped by the loop alone", atspi.is_on(&tk.b) == 1);
    tk.check("both its connections watched", hosted.watched(&hb) == 2 && host.watched(hs) == 3);

    // Asked by an assistive technology: answered while the loop runs.
    let is dbus.message.Message as m = tk.msg("/org/a11y/atspi/accessible/root", tk.ACC, "GetRole");
    dbus.conn.body(&tk.at);
    let is i64 as serial = dbus.conn.send(&tk.at, &m);
    let is i32 as got with mut = dbus.conn.TIMEOUT;
    deadline = time.now_ms() + 3000;
    while (time.now_ms() < deadline && got == dbus.conn.TIMEOUT) {
        host.step(hs, 50);
        got = dbus.conn.wait_reply(&tk.at, serial, 1, &tk.rep);
    }
    tk.check("asked, answered while the loop runs", got == dbus.conn.OK);

    // Closed: its connections no longer watched, once a round says so.
    atspi.close(&tk.b);
    host.step(hs, 0);
    tk.check("closed: nothing watched", hosted.watched(&hb) == 0 && host.watched(hs) == 1);
    atspi.open(&tk.b, a, "Caustic hosted", 14);
    host.step(hs, 0);
    tk.check("opened again: watched again", hosted.watched(&hb) >= 1 && host.watched(hs) == 1 + hosted.watched(&hb));
    hosted.detach(&hb);
    tk.check("let go: nothing watched", hosted.watched(&hb) == 0 && host.watched(hs) == 1);
    host.step(hs, 0);
    tk.check("nor watched again by a round", hosted.watched(&hb) == 0 && host.watched(hs) == 1);
    host.close(hs);
    return tk.finish("atspi hosted");
}
