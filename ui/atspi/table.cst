// ui/atspi/table.cst — Table: a table's cells by row and column.
//
// A table's rows are its children told, each saying its place among all of
// the table's rows (access: row, rows) — a scrolled table lays out only
// some, and a cell of a row not laid out is not there to give. A row's
// cells are its children told, in column order; the table says how many
// columns it has, and which widget's children head them. A row is chosen
// by its SELECT action and let go of by its DESELECT; columns are not
// chosen.
use "../../dbus/dbus.cst" as dbus;
use "../tree.cst" as tree;
use "../router.cst" as router;
use "../access.cst" as access;
use "bridge.cst" as bridge;
use "object.cst" as obj;

fn _bridge(user as *u8) as *bridge.Bridge { return cast(*bridge.Bridge, user); }

fn _describe(t as *tree.Tree, w as i64, q as *tree.Access) as void {
    access.describe(t, cast(*router.Router, 0), w, q);
}

// How many rows: all the table says it has, or its children told.
fn rows(o as *obj.Obj) as i64 {
    if (o.q.rows > 0) { return o.q.rows; }
    return bridge.child_count(o.t, o.w);
}

// How many columns: as the table says, or as many cells as its widest row.
fn columns(o as *obj.Obj) as i64 {
    if (o.q.columns > 0) { return o.q.columns; }
    let is i64 as most with mut = 0;
    let is i64 as n = bridge.child_count(o.t, o.w);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as k = bridge.child_count(o.t, bridge.child_at(o.t, o.w, i));
        if (k > most) { most = k; }
        i = i + 1;
    }
    return most;
}

// The row widget told at row r; 0 when it is not laid out.
fn row_widget(o as *obj.Obj, r as i64) as i64 {
    let is i64 as n = bridge.child_count(o.t, o.w);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as ch = bridge.child_at(o.t, o.w, i);
        let is tree.Access as q;
        _describe(o.t, ch, &q);
        let is i64 as at with mut = i;
        if (q.rows > 0) { at = q.row; }
        if (at == r) { return ch; }
        i = i + 1;
    }
    return 0;
}

fn _chosen(t as *tree.Tree, w as i64) as i32 {
    let is tree.Access as q;
    _describe(t, w, &q);
    return cast(i32, (q.states & access.SELECTED) != 0);
}

fn _row_chosen(o as *obj.Obj, r as i64) as i32 {
    let is i64 as rw = row_widget(o, r);
    return cast(i32, rw != 0 && _chosen(o.t, rw) == 1);
}

// The cell at r, c; 0 when it is not there.
fn cell(o as *obj.Obj, r as i64, c as i64) as i64 {
    if (c < 0 || c >= columns(o)) { return 0; }
    let is i64 as rw = row_widget(o, r);
    if (rw == 0) { return 0; }
    return bridge.child_at(o.t, rw, c);
}

// Column c's header; 0 for none.
fn header(o as *obj.Obj, c as i64) as i64 {
    if (o.q.headers == 0 || c < 0 || tree.is_valid(o.t, o.q.headers) == 0) { return 0; }
    return bridge.child_at(o.t, o.q.headers, c);
}

// The rows chosen among those laid out: how many, each put when w is not
// null.
fn _chosen_rows(o as *obj.Obj, w as *dbus.wire.Writer) as i64 {
    let is i64 as k with mut = 0;
    let is i64 as n = bridge.child_count(o.t, o.w);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as ch = bridge.child_at(o.t, o.w, i);
        let is tree.Access as q;
        _describe(o.t, ch, &q);
        if ((q.states & access.SELECTED) != 0) {
            let is i64 as at with mut = i;
            if (q.rows > 0) { at = q.row; }
            if (cast(i64, w) != 0) { dbus.wire.put_i32(w, at); }
            k = k + 1;
        }
        i = i + 1;
    }
    return k;
}

// --- Properties ---

fn _prop_obj(c as *dbus.conn.Conn, user as *u8, o as *obj.Obj) as i32 {
    if (obj.find(c, _bridge(user), o) == 0 || o.win == 0 || o.q.role != access.ROLE_TABLE) { return 0; }
    return 1;
}

fn p_rows(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (_prop_obj(c, user, &o) == 0) {
        dbus.wire.put_i32(w, 0);
        return;
    }
    dbus.wire.put_i32(w, rows(&o));
}

fn p_columns(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (_prop_obj(c, user, &o) == 0) {
        dbus.wire.put_i32(w, 0);
        return;
    }
    dbus.wire.put_i32(w, columns(&o));
}

fn p_selected_rows(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void {
    let is obj.Obj as o;
    if (_prop_obj(c, user, &o) == 0) {
        dbus.wire.put_i32(w, 0);
        return;
    }
    dbus.wire.put_i32(w, _chosen_rows(&o, cast(*dbus.wire.Writer, 0)));
}

fn p_zero(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { dbus.wire.put_i32(w, 0); }

fn p_none(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { obj.put_null(_bridge(user), w); }

fn p_version(c as *dbus.conn.Conn, w as *dbus.wire.Writer, user as *u8) as void { dbus.wire.put_u32(w, 1); }

// --- Methods ---

fn _put_cell(b as *bridge.Bridge, w as *dbus.wire.Writer, o as *obj.Obj, x as i64) as void {
    if (x == 0) {
        obj.put_null(b, w);
        return;
    }
    obj.put_ref(b, w, o.win, x);
}

fn m_at(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    let is i64 as r = dbus.wire.get_i32(&k.args);
    let is i64 as col = dbus.wire.get_i32(&k.args);
    _put_cell(_bridge(user), k.reply, &o, cell(&o, r, col));
}

fn m_index_at(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    let is i64 as r = dbus.wire.get_i32(&k.args);
    let is i64 as col = dbus.wire.get_i32(&k.args);
    let is i64 as nc = columns(&o);
    if (r < 0 || r >= rows(&o) || col < 0 || col >= nc) {
        dbus.wire.put_i32(k.reply, 0 - 1);
        return;
    }
    dbus.wire.put_i32(k.reply, r * nc + col);
}

// The row, or column, of index i; -1 past the cells.
fn _of_index(o as *obj.Obj, i as i64, want_row as i32) as i64 {
    let is i64 as nc = columns(o);
    if (nc <= 0 || i < 0 || i >= rows(o) * nc) { return 0 - 1; }
    if (want_row == 1) { return i / nc; }
    return i % nc;
}

fn m_row_at_index(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    dbus.wire.put_i32(k.reply, _of_index(&o, dbus.wire.get_i32(&k.args), 1));
}

fn m_column_at_index(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    dbus.wire.put_i32(k.reply, _of_index(&o, dbus.wire.get_i32(&k.args), 0));
}

fn m_row_description(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    dbus.wire.put_string(k.reply, "");
}

// A column described by its header's name.
fn m_column_description(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    let is i64 as h = header(&o, dbus.wire.get_i32(&k.args));
    if (h == 0) {
        dbus.wire.put_string(k.reply, "");
        return;
    }
    let is tree.Access as q;
    _describe(o.t, h, &q);
    dbus.wire.put_string_n(k.reply, q.name, q.name_len);
}

// Every cell spans one row and one column.
fn m_extent(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    let is i64 as r = dbus.wire.get_i32(&k.args);
    let is i64 as col = dbus.wire.get_i32(&k.args);
    dbus.wire.put_i32(k.reply, cast(i64, r >= 0 && r < rows(&o) && col >= 0 && col < columns(&o)));
}

fn m_row_header(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    obj.put_null(_bridge(user), k.reply);
}

fn m_column_header(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    _put_cell(_bridge(user), k.reply, &o, header(&o, dbus.wire.get_i32(&k.args)));
}

fn m_selected_rows(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    let is i64 as at = dbus.wire.put_array(k.reply, 4);
    _chosen_rows(&o, k.reply);
    dbus.wire.put_array_end(k.reply, at, 4);
}

fn m_selected_columns(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    let is i64 as at = dbus.wire.put_array(k.reply, 4);
    dbus.wire.put_array_end(k.reply, at, 4);
}

fn m_is_row_selected(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    dbus.wire.put_bool(k.reply, _row_chosen(&o, dbus.wire.get_i32(&k.args)));
}

fn m_no(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    dbus.wire.put_bool(k.reply, 0);
}

// A cell is chosen with its row.
fn m_is_selected(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    let is i64 as r = dbus.wire.get_i32(&k.args);
    let is i64 as col = dbus.wire.get_i32(&k.args);
    dbus.wire.put_bool(k.reply, cast(i32, col >= 0 && col < columns(&o) && _row_chosen(&o, r) == 1));
}

fn _row_act(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8, action as i64) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    let is i64 as rw = row_widget(&o, dbus.wire.get_i32(&k.args));
    if (rw == 0) {
        dbus.wire.put_bool(k.reply, 0);
        return;
    }
    dbus.wire.put_bool(k.reply, access.act(o.t, rw, action, 0.0));
}

fn m_add_row(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { _row_act(c, k, user, access.SELECT); }

fn m_remove_row(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { _row_act(c, k, user, access.DESELECT); }

fn m_extents_at_index(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is obj.Obj as o;
    if (obj.called(c, k, user, obj.F_TABLE, &o) == 0) { return; }
    let is i64 as i = dbus.wire.get_i32(&k.args);
    let is i64 as r = _of_index(&o, i, 1);
    let is i64 as col = _of_index(&o, i, 0);
    let is i32 as found = cast(i32, r >= 0);
    dbus.wire.put_bool(k.reply, found);
    dbus.wire.put_i32(k.reply, r);
    dbus.wire.put_i32(k.reply, col);
    dbus.wire.put_i32(k.reply, cast(i64, found));
    dbus.wire.put_i32(k.reply, cast(i64, found));
    dbus.wire.put_bool(k.reply, cast(i32, found == 1 && _row_chosen(&o, r) == 1));
}

// --- The table ---

let is [20]dbus.conn.Method as methods with mut;
let is [7]dbus.conn.Property as props with mut;

fn _m(m as *dbus.conn.Method, name as *u8, ins as *u8, outs as *u8, h as dbus.conn.MethodFn) as void {
    m.name = name;
    m.in_sig = ins;
    m.out_sig = outs;
    m.handler = h;
    m.in_names = cast(*u8, 0);
    m.out_names = cast(*u8, 0);
}

fn _p(p as *dbus.conn.Property, name as *u8, sig as *u8, g as dbus.conn.GetFn) as void {
    p.name = name;
    p.sig = sig;
    p.get = g;
    p.set = cast(dbus.conn.SetFn, 0);
}

fn table(f as *dbus.conn.Interface) as void {
    _m(&methods[0], "GetAccessibleAt", "ii", "(so)", fn_ptr(m_at));
    _m(&methods[1], "GetIndexAt", "ii", "i", fn_ptr(m_index_at));
    _m(&methods[2], "GetRowAtIndex", "i", "i", fn_ptr(m_row_at_index));
    _m(&methods[3], "GetColumnAtIndex", "i", "i", fn_ptr(m_column_at_index));
    _m(&methods[4], "GetRowDescription", "i", "s", fn_ptr(m_row_description));
    _m(&methods[5], "GetColumnDescription", "i", "s", fn_ptr(m_column_description));
    _m(&methods[6], "GetRowExtentAt", "ii", "i", fn_ptr(m_extent));
    _m(&methods[7], "GetColumnExtentAt", "ii", "i", fn_ptr(m_extent));
    _m(&methods[8], "GetRowHeader", "i", "(so)", fn_ptr(m_row_header));
    _m(&methods[9], "GetColumnHeader", "i", "(so)", fn_ptr(m_column_header));
    _m(&methods[10], "GetSelectedRows", "", "ai", fn_ptr(m_selected_rows));
    _m(&methods[11], "GetSelectedColumns", "", "ai", fn_ptr(m_selected_columns));
    _m(&methods[12], "IsRowSelected", "i", "b", fn_ptr(m_is_row_selected));
    _m(&methods[13], "IsColumnSelected", "i", "b", fn_ptr(m_no));
    _m(&methods[14], "IsSelected", "ii", "b", fn_ptr(m_is_selected));
    _m(&methods[15], "AddRowSelection", "i", "b", fn_ptr(m_add_row));
    _m(&methods[16], "AddColumnSelection", "i", "b", fn_ptr(m_no));
    _m(&methods[17], "RemoveRowSelection", "i", "b", fn_ptr(m_remove_row));
    _m(&methods[18], "RemoveColumnSelection", "i", "b", fn_ptr(m_no));
    _m(&methods[19], "GetRowColumnExtentsAtIndex", "i", "biiiib", fn_ptr(m_extents_at_index));
    _p(&props[0], "NRows", "i", fn_ptr(p_rows));
    _p(&props[1], "NColumns", "i", fn_ptr(p_columns));
    _p(&props[2], "Caption", "(so)", fn_ptr(p_none));
    _p(&props[3], "Summary", "(so)", fn_ptr(p_none));
    _p(&props[4], "NSelectedRows", "i", fn_ptr(p_selected_rows));
    _p(&props[5], "NSelectedColumns", "i", fn_ptr(p_zero));
    _p(&props[6], "version", "u", fn_ptr(p_version));
    f.name = obj.I_TABLE;
    f.methods = cast(*dbus.conn.Method, &methods);
    f.nmethods = 20;
    f.props = cast(*dbus.conn.Property, &props);
    f.nprops = 7;
    f.signals = cast(*dbus.conn.SignalDecl, 0);
    f.nsignals = 0;
}
