// ui/ime_wayland_test.cst — a combo box typed into on Wayland, its list
// shown in a popup of its own (xdg_popup) that takes no grab, on a KWin of
// its own — the compositor that offers text-input-v3 (Weston has only v1) —
// its keys from KWin's fake input (kwin_input.cst):
//   sh window/wayland/tools/run_kwin.sh ./build/ime_wayland_test
//   env KWIN_INPUT_METHOD=window/wayland/tools/kwin_fcitx.sh FCITX_LOG=build/kwin_fcitx_combo.log \
//       sh window/wayland/tools/run_kwin.sh ./build/ime_wayland_test method
// Run from the repository's root (the test font). While the list is shown
// the text-input focus stays on the window, its entry the field told the
// compositor — and the installed Fcitx5, in method mode, told what it holds
// around the caret — and what is typed goes into the entry.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/env.cst" as env;
use "std/os/linux.cst" as linux;
use "../math/math.cst" as math;
use "../gpu/gpu.cst" as gpu;
use "../window/device.cst" as device;
use "../window/wayland/kwin_input.cst" as kwin_input;
use "../text/sfnt/sfnt.cst" as sfnt;
use "../text/sfnt/table.cst" as table;
use "../text/layout/font.cst" as font;
use "tree.cst" as tree;
use "layout.cst" as layout;
use "box.cst" as box;
use "style.cst" as style;
use "router.cst" as router;
use "text.cst" as text;
use "model.cst" as model;
use "app.cst" as app;
use "host.cst" as host;
use "widgets/entry.cst" as entry;
use "widgets/combo.cst" as combo;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as k with mut = 0;
    while (b[k] != 0) { k = k + 1; }
    if (n != k) { return 0; }
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is gpu.device.Device as dv with mut;
let is app.App as a with mut;
let is *host.Host as hs with mut;

let is [8]u8 as rowbuf with mut;
fn rows_count(self as *u8, parent as i64) as i64 { if (parent != 0) { return 0; } return 10; }
fn rows_id(self as *u8, parent as i64, index as i64) as i64 {
    if (parent != 0 || index < 0 || index >= 10) { return 0; }
    return index + 1;
}
fn rows_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    if (role != model.TEXT || column != 0) { return 0; }
    rowbuf[0] = cast(u8, 114); rowbuf[1] = cast(u8, 111); rowbuf[2] = cast(u8, 119); rowbuf[3] = cast(u8, 32);
    rowbuf[4] = cast(u8, 47 + id);
    *out = model.text(cast(*u8, &rowbuf), 5);
    return 1;
}

fn rounds(ms as i64) as void {
    let is i64 as until = time.now_ms() + ms;
    while (time.now_ms() < until) { host.step(hs, 10); }
}

fn typing(keysym as i64) as void {
    kwin_input.key_sym(keysym, 1);
    kwin_input.key_sym(keysym, 0);
    rounds(250);
}

// What the input method was told, as its log has the protocol (method mode:
// FCITX_LOG): 1 when s is in it.
let is *u8 as log with mut;
let is i64 as nlog with mut = 0;
let is i64 as LOG_MAX with imut = 16777216;

fn reread() as void {
    nlog = 0;
    let is *u8 as path = env.getenv("FCITX_LOG");
    if (cast(i64, path) == 0) { return; }
    if (cast(i64, log) == 0) { log = mem.core.mmap_anon(LOG_MAX); }
    let is i64 as fd = linux.open(path, 0, 0);
    if (fd < 0) { return; }
    while (nlog < LOG_MAX) {
        let is i64 as r = linux.read(fd, cast(*u8, cast(i64, log) + nlog), LOG_MAX - nlog);
        if (r <= 0) { break; }
        nlog = nlog + r;
    }
    linux.close(fd);
}

fn told(s as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    let is i64 as i with mut = 0;
    while (i + n <= nlog) {
        if (log[i] == s[0] && mem.memcmp(cast(*u8, cast(i64, log) + i), s, n) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i32 as method = cast(i32, env.argc() > 1 && same(env.argv(1), 6, "method") == 1);
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    theme = style.light();
    theme.fonts.body.size = 16.0;
    dv = gpu.open_headless(64, 64, gpu.SOFTWARE);
    let is text.Limits as lim = text.limits_default();
    let is *text.Service as svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    let is app.Limits as al = app.limits_default();
    a = app.open(&al);
    app.set_theme(&a, &theme);
    app.set_text_service(&a, cast(*u8, svc));
    let is i64 as w = app.window_open(&a, 320.0, 160.0);
    let is *tree.Tree as t = app.tree(&a, w);
    let is *router.Router as r = app.router(&a, w);
    let is i64 as col = box.create(t, tree.root(t), box.COLUMN);
    layout.set_align(t, col, layout.START, layout.START);
    let is model.Model as rows = model.make(cast(*u8, 0), fn_ptr(rows_count), fn_ptr(rows_id), fn_ptr(rows_cell));
    let is i64 as cb = combo.create_entry(t, col, &rows);
    layout.set_min_size(t, cb, 200.0, 0.0);
    let is i64 as ce = combo.entry_of(t, cb);
    hs = host.open(&a, &dv, cast(*u8, svc));
    rounds(400);
    let is *device.Window as nw = host.native(hs, w);
    check("a Wayland window", cast(i64, nw) != 0 && nw.backend == device.WAYLAND);
    if (cast(i64, nw) == 0) { return 1; }
    if (kwin_input.open() == 0) { io.printf("FAIL: no fake input of KWin's to send input through\n"); return 1; }
    // The keys go where the pointer is: KWin's window, the whole screen.
    kwin_input.move(640.0, 512.0);
    rounds(300);
    router.focus(t, r, ce, 1);
    let is i64 as until with mut = time.now_ms() + 3000;
    while (device.text_input_active(nw) == 0 && time.now_ms() < until) { rounds(20); }
    check("its entry: the text-input focus the window's", device.text_input_active(nw) == 1 && tree.text_area(t) == ce);

    // --- Typed into: its list shown, the keys and text input its entry's ---
    typing(114);
    until = time.now_ms() + 2000;
    while (combo.is_open(t, cb) == 0 && time.now_ms() < until) { rounds(20); }
    let is i64 as lp = combo.popup_of(t, cb);
    let is i64 as ls = tree.surface_index(t, lp);
    check("typed into: its list shown, in a popup of its own", combo.is_open(t, cb) == 1 && ls >= 0);
    check("which takes no grab", ls >= 0 && tree.surface_grab(t, ls) == 0);
    check("the text-input focus still the window's, its entry the field", device.text_input_active(nw) == 1 &&
          tree.text_area(t) == ce);
    typing(111);
    check("what is typed next its entry's, the list shown", same(entry.text(t, ce), entry.length(t, ce), "ro") == 1 &&
          combo.is_open(t, cb) == 1);
    if (method == 1) {
        rounds(300);
        reread();
        check("the method told what its entry holds round the caret", told("surrounding_text(\"ro\", 2, 2)") == 1);
    }

    host.close(hs);
    if (fails == 0) {
        io.printf("ime wayland: all checks passed\n");
        return 0;
    }
    io.printf("ime wayland: %d failures\n", fails);
    return 1;
}
