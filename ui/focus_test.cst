// ui/focus_test.cst — keyboard focus: Tab order, clicks, keys, modal scope.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "../window/keys.cst" as keys;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "box.cst" as box;
use "event.cst" as event;
use "router.cst" as router;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL: %s: got %d, want %d\n", name, cast(i32, got), cast(i32, want));
        fails = fails + 1;
    }
}

// The probe from router_test: sized like a leaf, frames one child, logs every
// delivery as tag * 1000 + kind * 10 + phase, handles the kinds in its mask.
struct Probe {
    pref_w  as f64;
    pref_h  as f64;
    tag     as i64;
    handles as i64;
    related as i64;   // related of the last FOCUS_IN or FOCUS_OUT
    text    as i64;   // first byte of the last TEXT
    asks    as i64;   // the widget it asks the focus for on a key or a press; 0 none
}

let is [256]i64 as log with mut;
let is i64 as logged with mut = 0;

fn reset() as void { logged = 0; }

fn probe_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Probe as d = cast(*Probe, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = d.pref_w;
    out.pref_h = d.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn probe_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is i64 as child = tree.first_child(t, w);
    if (child == 0) { return; }
    let is math.rect.Rect as all = math.rect.rect(0.0, 0.0, r.w, r.h);
    layout.place(t, child, &all);
}

fn probe_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Probe as d = cast(*Probe, data);
    if (logged < 256) {
        log[logged] = d.tag * 1000 + cast(i64, e.kind) * 10 + cast(i64, e.phase);
        logged = logged + 1;
    }
    if (e.kind == event.FOCUS_IN || e.kind == event.FOCUS_OUT) { d.related = e.related; }
    if (e.kind == event.TEXT && e.text_len > 0) { d.text = cast(i64, e.text[0]); }
    if (d.asks != 0 && (e.kind == event.KEY_DOWN || e.kind == event.POINTER_DOWN)) { tree.request_focus(t, d.asks); }
    if ((d.handles & (1 << cast(i64, e.kind))) != 0) { return 1; }
    return 0;
}

let is tree.Kind as probe_kind with mut;

fn probe(t as *tree.Tree, parent as i64, tag as i64, h as f64) as i64 {
    let is i64 as w = tree.create(t, &probe_kind, parent);
    let is *Probe as d = cast(*Probe, tree.data(t, w));
    d.pref_w = 100.0;
    d.pref_h = h;
    d.tag = tag;
    return w;
}

fn handles(t as *tree.Tree, w as i64, kind as i32) as void {
    let is *Probe as d = cast(*Probe, tree.data(t, w));
    d.handles = d.handles | (1 << cast(i64, kind));
}

fn pd(t as *tree.Tree, w as i64) as *Probe { return cast(*Probe, tree.data(t, w)); }

fn entry(tag as i64, kind as i32, phase as i32) as i64 {
    return tag * 1000 + cast(i64, kind) * 10 + cast(i64, phase);
}

fn has(want as i64) as i32 {
    let is i64 as k with mut = 0;
    while (k < logged) {
        if (log[k] == want) { return 1; }
        k = k + 1;
    }
    return 0;
}

fn tab(t as *tree.Tree, r as *router.Router, shift as i32, time as i64) as void {
    let is i32 as mods with mut = 0;
    if (shift == 1) { mods = keys.MOD_SHIFT; }
    router.key(t, r, keys.TAB, mods, 1, 0, time);
    router.key(t, r, keys.TAB, mods, 0, 0, time + 5);
}

fn main() as i32 {
    probe_kind = widget.kind("probe", sizeof(Probe));
    probe_kind.measure = fn_ptr(probe_measure);
    probe_kind.arrange = fn_ptr(probe_arrange);
    probe_kind.event = fn_ptr(probe_event);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);

    //   column, each 20 tall:
    //   e1 (focusable)  y 0..20
    //   e2 (not)        y 20..40
    //   e3 (focusable)  y 40..60
    //   panel           y 60..80
    //   └─ e4 (focusable)
    //      └─ e5 (not focusable, fills e4)
    let is i64 as col = box.create(&t, root, box.COLUMN);
    let is i64 as e1 = probe(&t, col, 1, 20.0);
    probe(&t, col, 2, 20.0);
    let is i64 as e3 = probe(&t, col, 3, 20.0);
    let is i64 as panel = probe(&t, col, 9, 20.0);
    let is i64 as e4 = probe(&t, panel, 4, 20.0);
    probe(&t, e4, 5, 20.0);
    tree.set_focusable(&t, e1, 1);
    tree.set_focusable(&t, e3, 1);
    tree.set_focusable(&t, e4, 1);
    layout.run(&t, 100.0, 200.0);

    let is router.Router as r = router.init(router.settings_default());
    eq("nothing focused at first", router.focused(&t, &r), 0);

    // --- Tab walks the focusable widgets in tree order, and wraps ---
    tab(&t, &r, 0, 100);
    eq("tab to the first", router.focused(&t, &r), e1);
    check("tab shows the focus ring", router.focus_visible(&r));
    tab(&t, &r, 0, 110);
    eq("tab skips what cannot take focus", router.focused(&t, &r), e3);
    tab(&t, &r, 0, 120);
    eq("tab goes into nested widgets", router.focused(&t, &r), e4);
    tab(&t, &r, 0, 130);
    eq("tab wraps around", router.focused(&t, &r), e1);
    tab(&t, &r, 1, 140);
    eq("shift+tab goes back, wrapping", router.focused(&t, &r), e4);

    // --- Focus moving is announced to both sides ---
    reset();
    tab(&t, &r, 0, 150);
    check("old one hears it is losing focus", has(entry(4, event.FOCUS_OUT, event.TARGET)));
    check("new one hears it gained it", has(entry(1, event.FOCUS_IN, event.TARGET)));
    eq("focus in names where it came from", pd(&t, e1).related, e4);

    // --- Hidden and disabled widgets are skipped ---
    tree.set_visible(&t, e3, 0);
    tab(&t, &r, 0, 160);
    eq("hidden skipped", router.focused(&t, &r), e4);
    tree.set_visible(&t, e3, 1);
    layout.run(&t, 100.0, 200.0);
    tree.set_enabled(&t, e1, 0);
    tab(&t, &r, 0, 170);
    eq("disabled skipped", router.focused(&t, &r), e3);
    tree.set_enabled(&t, e1, 1);

    // --- A click focuses the nearest focusable widget under the pointer ---
    router.pointer_button(&t, &r, 1, 1, 10.0, 70.0, 200);
    router.pointer_button(&t, &r, 1, 0, 10.0, 70.0, 210);
    eq("click inside e4 focuses e4", router.focused(&t, &r), e4);
    check("a click hides the focus ring", router.focus_visible(&r) == 0);
    router.pointer_button(&t, &r, 1, 1, 10.0, 30.0, 220);
    router.pointer_button(&t, &r, 1, 0, 10.0, 30.0, 230);
    eq("clicking what cannot take focus keeps it", router.focused(&t, &r), e4);
    // Even a click that moves no focus means the mouse is in use: the ring goes.
    tab(&t, &r, 0, 240);
    check("ring back after tab", router.focus_visible(&r));
    router.pointer_button(&t, &r, 1, 1, 10.0, 30.0, 250);
    router.pointer_button(&t, &r, 1, 0, 10.0, 30.0, 260);
    check("any click hides the ring", router.focus_visible(&r) == 0);
    router.focus(&t, &r, e4, 0);

    // --- Keys go to the focused widget and bubble ---
    handles(&t, panel, event.KEY_DOWN);
    reset();
    let is i32 as handled = router.key(&t, &r, keys.A, 0, 1, 0, 300);
    check("key reaches the focused widget", has(entry(4, event.KEY_DOWN, event.TARGET)));
    check("and bubbles to its parent", has(entry(9, event.KEY_DOWN, event.BUBBLE)));
    check("reported handled", handled == 1);
    router.key(&t, &r, keys.A, 0, 0, 0, 305);

    // A widget that wants Tab — a text editor indenting — gets it, and focus
    // stays put.
    handles(&t, e4, event.KEY_DOWN);
    tab(&t, &r, 0, 310);
    eq("handled tab does not move focus", router.focused(&t, &r), e4);

    // --- Text goes to the focused widget ---
    router.text(&t, &r, "x", 1, 320);
    eq("text delivered", pd(&t, e4).text, 120);

    // --- The keyboard's context menu: the Menu key, or Shift+F10 ---
    reset();
    router.key(&t, &r, keys.MENU, 0, 1, 0, 330);
    router.key(&t, &r, keys.MENU, 0, 0, 0, 335);
    check("menu key asks the focused widget", has(entry(4, event.CONTEXT_MENU, event.TARGET)));
    reset();
    router.key(&t, &r, keys.F10, keys.MOD_SHIFT, 1, 0, 340);
    router.key(&t, &r, keys.F10, keys.MOD_SHIFT, 0, 0, 345);
    check("shift+f10 too", has(entry(4, event.CONTEXT_MENU, event.TARGET)));

    // --- Focus a widget asks for, given once the event is delivered ---
    router.focus(&t, &r, e1, 0);
    pd(&t, e1).asks = e3;
    router.key(&t, &r, keys.DOWN, 0, 1, 0, 350);
    router.key(&t, &r, keys.DOWN, 0, 0, 0, 355);
    eq("asked for on a key: given", router.focused(&t, &r), e3);
    check("by keyboard: the ring shown", router.focus_visible(&r));
    pd(&t, e1).asks = 0;
    pd(&t, e3).asks = e1;
    router.pointer_button(&t, &r, 1, 1, 10.0, 50.0, 360);
    router.pointer_button(&t, &r, 1, 0, 10.0, 50.0, 365);
    eq("asked for on a press: given", router.focused(&t, &r), e1);
    check("by the pointer: no ring", router.focus_visible(&r) == 0);
    pd(&t, e3).asks = 0;
    pd(&t, e1).asks = 0;
    router.focus(&t, &r, e1, 1);
    tree.request_focus(&t, e3);
    tree.request_focus(&t, 0);
    router.key(&t, &r, keys.DOWN, 0, 1, 0, 370);
    router.key(&t, &r, keys.DOWN, 0, 0, 0, 375);
    eq("asked for and taken back: nothing", router.focused(&t, &r), e1);
    pd(&t, e1).asks = e1 + 1000000;
    router.key(&t, &r, keys.DOWN, 0, 1, 0, 380);
    router.key(&t, &r, keys.DOWN, 0, 0, 0, 385);
    eq("asked for what is not there: nothing", router.focused(&t, &r), e1);
    pd(&t, e1).asks = 0;
    router.focus(&t, &r, e4, 1);

    // --- Focus lost to a disabled or destroyed widget reads as none ---
    tree.set_enabled(&t, e4, 0);
    eq("disabled focus is no focus", router.focused(&t, &r), 0);
    tree.set_enabled(&t, e4, 1);

    // --- A modal scope: focus and pointer stay inside it ---
    let is *Probe as p4 = pd(&t, e4);
    p4.handles = 0;
    router.set_scope(&t, &r, panel);
    eq("scope pulls focus inside", router.focused(&t, &r), e4);
    tab(&t, &r, 0, 400);
    eq("tab stays inside the scope", router.focused(&t, &r), e4);
    check("focusing outside is refused", router.focus(&t, &r, e1, 1) == 0);
    reset();
    router.pointer_button(&t, &r, 1, 1, 10.0, 10.0, 410);
    router.pointer_button(&t, &r, 1, 0, 10.0, 10.0, 420);
    eq("click outside the scope is dropped", logged, 0);
    eq("and does not take focus", router.focused(&t, &r), e4);
    router.set_scope(&t, &r, 0);
    check("outside focusable again", router.focus(&t, &r, e1, 1) == 1);

    tree.close(&t);
    if (fails != 0) { return 1; }
    io.printf("ui focus: all checks passed\n");
    return 0;
}
