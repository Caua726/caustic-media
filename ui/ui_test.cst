// ui/ui_test.cst — widgets draw inside the target, whatever rect they are given.
//
// tgt.put is unchecked by design: the rasterizer clips before it gets there. A
// widget that calls it directly has to clip against the TARGET, not just its
// own rect, because a program places widgets wherever it likes — half off the
// right edge while a panel slides in, or past the bottom of a short window.
//
// The target here is a view over the first H rows of a larger block, so a
// write past its end lands in guard rows this test can read instead of in
// memory nothing checks.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "../gpu/software/target.cst" as tgt;
use "ui.cst" as ui;

let is i64 as W     with imut = 64;
let is i64 as H     with imut = 32;
let is i64 as GUARD with imut = 64;   // rows after the target
let is i32 as SENTINEL with imut = 0x11111111;

let is [6144]i32 as mem with mut;     // W * (H + GUARD)
let is [64]i16 as wave with mut;
let is [64]i16 as low  with mut;

let is i32 as fails with mut = 0;

fn reset() as void {
    let is i64 as i with mut = 0;
    while (i < W * (H + GUARD)) { mem[i] = SENTINEL; i = i + 1; }
}

fn guard_untouched() as i32 {
    let is i64 as i with mut = W * H;
    while (i < W * (H + GUARD)) {
        if (mem[i] != SENTINEL) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Pixels left of column x0 in every row: a write past the right edge of a row
// wraps to the start of the next one.
fn left_of_has(x0 as i64, packed as i64) as i32 {
    let is i64 as y with mut = 0;
    while (y < H) {
        let is i64 as x with mut = 0;
        while (x < x0) {
            if ((cast(i64, mem[y * W + x]) & 4294967295) == packed) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn main() as i32 {
    // A full-scale square wave, so the trace spans the widget's height, and a
    // buffer pinned at the negative extreme, so the trace sits at its bottom.
    let is i64 as i with mut = 0;
    while (i < 64) {
        if (i % 2 == 0) { wave[i] = 32767; } else { wave[i] = cast(i16, 0 - 32768); }
        low[i] = cast(i16, 0 - 32768);
        i = i + 1;
    }

    let is tgt.Target as t = tgt.target(cast(*u8, &mem), cast(*u8, 0), W, H);
    let is ui.Context as ctx = ui.context_default();
    let is math.color.Color as col = math.color.from_hex(0xFF00FF);
    let is i64 as packed = math.color.pack_rgba8(col);

    // Past the right edge: 32 of the 48 columns are outside the target.
    reset();
    ui.begin_frame(&ctx, &t, 0, 0, 0);
    ui.waveform_display(&ctx, W - 16, 4, 48, 24, cast(*i16, &wave), 64, col);
    check("waveform past the right edge wraps into the next row", 1 - left_of_has(W - 16, packed));

    // Past the bottom: the widget's centre line is below the last row, and the
    // trace below that.
    reset();
    ui.begin_frame(&ctx, &t, 0, 0, 0);
    ui.waveform_display(&ctx, 4, H - 8, 32, 40, cast(*i16, &low), 64, col);
    check("waveform past the bottom writes past the target", guard_untouched());

    if (fails != 0) { return 1; }
    io.printf("ui layer: all checks passed\n");
    return 0;
}
