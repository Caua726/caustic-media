// ui/ui_test.cst — the hub: its modules reached through it, and the forms
// that take words without their length.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "../input/keys.cst" as keys;
use "ui.cst" as ui;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    if (n != ui.len(b)) { return 0; }
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

let is i64 as clicks with mut = 0;
fn on_click(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void { clicks = clicks + 1; }

fn alt(t as *ui.tree.Tree, r as *ui.router.Router, k as i32, time as i64) as void {
    ui.router.key(t, r, k, keys.MOD_ALT, 1, 0, time);
    ui.router.key(t, r, k, keys.MOD_ALT, 0, 0, time + 1);
    ui.router.key(t, r, keys.ALT_L, 0, 0, 0, time + 2);
}

fn main() as i32 {
    check("a length", ui.len("Português") == 10 && ui.len("") == 0 && ui.len(cast(*u8, 0)) == 0);

    let is ui.tree.Limits as l = ui.tree.limits_default();
    let is ui.tree.Tree as t = ui.tree.open(&l);
    let is ui.router.Router as r = ui.router.init(ui.router.settings_default());
    ui.tree.set_router(&t, cast(*u8, &r));
    let is i64 as col = ui.box.create(&t, ui.tree.root(&t), ui.box.COLUMN);

    let is i64 as plain = ui.label(&t, col, "A_B");
    check("a label: its words as they are", same(ui.label.text(&t, plain), ui.label.text_length(&t, plain), "A_B") == 1 &&
          ui.label.mnemonic(&t, plain) == 0);

    let is i64 as save = ui.button(&t, col, "_Save");
    let is i64 as c = ui.button.content(&t, save);
    check("a button: its words, its mnemonic", same(ui.label.text(&t, c), ui.label.text_length(&t, c), "Save") == 1 &&
          ui.label.mnemonic(&t, c) == 83);
    ui.on(&t, save, ui.signal.CLICKED, fn_ptr(on_click));
    alt(&t, &r, keys.S, 10);
    check("connected with on, its mnemonic bound by itself", clicks == 1);

    let is i64 as name = ui.entry.create(&t, col);
    let is i64 as nl = ui.label_for(&t, col, "_Name", name);
    check("a label for an entry", ui.label.target(&t, nl) == name && ui.tree.labelled_by(&t, name) == nl);
    alt(&t, &r, keys.N, 20);
    check("its mnemonic to the entry", ui.router.focused(&t, &r) == name);
    check("a placeholder", ui.placeholder(&t, name, "ana@example.org") == 1);

    let is i64 as one = ui.radio(&t, col, "_One", 0);
    let is i64 as two = ui.radio(&t, col, "_Two", one);
    let is i64 as box = ui.check(&t, col, "_Box");
    check("radio buttons in a group, a check box", one != 0 && two != 0 && box != 0 &&
          ui.check.state(&t, one) == ui.check.ON && ui.check.state(&t, two) == ui.check.OFF);
    check("a group box, an expander, a menu button", ui.group(&t, col, "_Look") != 0 &&
          ui.expander(&t, col, "_More") != 0 && ui.menubutton(&t, col, "_Pick") != 0);

    // set_text, by kind.
    check("set_text: a label", ui.set_text(&t, plain, "x_y") == 1 &&
          same(ui.label.text(&t, plain), ui.label.text_length(&t, plain), "x_y") == 1);
    check("set_text: an entry", ui.set_text(&t, name, "ana") == 1 &&
          same(ui.entry.text(&t, name), ui.entry.length(&t, name), "ana") == 1);
    check("set_text: a button, its mnemonic again", ui.set_text(&t, save, "_Keep") == 1 &&
          same(ui.label.text(&t, c), ui.label.text_length(&t, c), "Keep") == 1);
    alt(&t, &r, keys.K, 30);
    check("and bound again", clicks == 2);
    check("set_text: a check box", ui.set_text(&t, box, "_Other") == 1 &&
          same(ui.label.text(&t, ui.check.content(&t, box)), ui.label.text_length(&t, ui.check.content(&t, box)), "Other") == 1);
    ui.tree.clear_error(&t);
    check("set_text: a box is none of them", ui.set_text(&t, col, "x") == 0 && ui.tree.last_error(&t) == ui.tree.WRONG_KIND);

    // Menus and the rest that add.
    let is i64 as m = ui.menu.create(&t);
    let is i64 as it = ui.menu_item(&t, m, "_Open", 7);
    check("a menu item, its letter left to the menu", it != 0 &&
          ui.label.mnemonic(&t, ui.menu.item_label(&t, it)) == 79);
    check("a check item, a submenu", ui.menu_check(&t, m, "_Wrap", 8, 1) != 0 && ui.submenu(&t, m, "_Recent") != 0);
    let is ui.model.Value as v = ui.cell_text("cell");
    check("a cell's text", v.len == 4);

    ui.tree.close(&t);
    if (fails == 0) {
        io.printf("ui: %d checks passed\n", checks);
        return 0;
    }
    io.printf("ui: %d of %d checks failed\n", fails, checks);
    return 1;
}
