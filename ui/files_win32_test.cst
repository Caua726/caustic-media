// ui/files_win32_test.cst — the toolkit's files on Windows (under Wine in
// test-win32): the user's known folders, a folder read and climbed to its
// drive's top, a window's state kept under the local application data, and
// the file chooser's places — the profile, those of its folders there, the
// drive — each as Windows names it, with '/' between the parts.
use "std/io.cst" as io;
use "std/os.cst" as os;
use "std/mem.cst" as mem;
use "std/env.cst" as env;
use "../sys/file.cst" as file;
use "../window/win32/known_folders.cst" as known;
use "../gpu/gpu.cst" as gpu;
use "../text/sfnt/sfnt.cst" as sfnt;
use "../text/sfnt/table.cst" as table;
use "../text/layout/font.cst" as font;
use "tree.cst" as tree;
use "style.cst" as style;
use "text.cst" as text;
use "model.cst" as model;
use "dirmodel.cst" as dirmodel;
use "winstate.cst" as winstate;
use "icons.cst" as icons;
use "widgets/listview.cst" as listview;
use "widgets/filechooser.cst" as filechooser;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    return cast(i32, n == _len(b) && mem.memcmp(a, b, n) == 0);
}

// No '\' in the n bytes at s, and a lettered drive's top first.
fn windows_path(s as *u8, n as i64) as i32 {
    if (n < 3 || s[1] != cast(u8, 58) || s[2] != cast(u8, 47)) { return 0; }
    let is i64 as i with mut = 0;
    while (i < n) {
        if (s[i] == cast(u8, 92)) { return 0; }
        i = i + 1;
    }
    return 1;
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);

    // --- Known folders ---
    let is [1024]u8 as profile;
    let is i64 as pn = known.path(known.PROFILE, cast(*u8, &profile), 1024);
    check("the profile, on a drive, with '/'", pn > 3 && windows_path(cast(*u8, &profile), pn) == 1);
    let is [1024]u8 as docs;
    let is i64 as dn = known.path(known.DOCUMENTS, cast(*u8, &docs), 1024);
    check("documents, on a drive, with '/'", dn > 3 && windows_path(cast(*u8, &docs), dn) == 1);
    let is [1024]u8 as local;
    let is i64 as ln = known.path(known.LOCAL_DATA, cast(*u8, &local), 1024);
    check("the local application data", ln > 3 && windows_path(cast(*u8, &local), ln) == 1);
    let is [1024]u8 as roaming;
    let is i64 as rn = known.path(known.ROAMING_DATA, cast(*u8, &roaming), 1024);
    check("the roaming application data, apart from the local", rn > 3 && windows_path(cast(*u8, &roaming), rn) == 1 &&
          (rn != ln || mem.memcmp(cast(*u8, &roaming), cast(*u8, &local), rn) != 0));
    check("too little room: none", known.path(known.PROFILE, cast(*u8, &docs), 4) == 0);
    let is [8]u8 as drive;
    check("the profile's drive's top", known.system_drive(cast(*u8, &drive), 8) == 3 && drive[0] == profile[0] &&
          same(cast(*u8, cast(i64, &drive) + 1), 2, ":/") == 1);

    // --- A folder read, and climbed to its drive's top ---
    let is *dirmodel.Dir as d = dirmodel.open(cast(*u8, &profile), pn);
    check("the profile read", cast(i64, d) != 0 && same(dirmodel.path(d), dirmodel.path_length(d), cast(*u8, &profile)) == 1);
    if (cast(i64, d) != 0) {
        check("up: its parent, still on the drive", dirmodel.up(d) == 1 && windows_path(dirmodel.path(d), dirmodel.path_length(d)) == 1 &&
              dirmodel.path_length(d) < pn);
        while (dirmodel.path_length(d) > 3 && dirmodel.up(d) == 1) { }
        check("up to the drive's top, kept as \"C:/\"", same(dirmodel.path(d), dirmodel.path_length(d), cast(*u8, &drive)) == 1);
        check("no further up than the top", dirmodel.up(d) == 0);
        check("the top read, its folders listed", dirmodel.count(d) > 0);
        let is i64 as at = dirmodel.index_of_name(d, cast(*u8, cast(i64, &profile) + 3), 0);
        check("a name not there: -1", at == 0 - 1);
        let is [1024]u8 as full;
        let is i64 as fn_ = dirmodel.full_path(d, 0, cast(*u8, &full), 1024);
        check("an entry's path: the top and its name, one '/'", fn_ > 3 && full[3] != cast(u8, 47) &&
              windows_path(cast(*u8, &full), fn_) == 1);
        dirmodel.close(d);
    }

    // --- A window's state kept between runs ---
    let is winstate.State as st = winstate.state(640.0, 480.5);
    st.maximized = 1;
    let is [32]u8 as app;
    let is i64 as an = io.sprintf(cast(*u8, &app), 32, "files_win32_test.%d", os.pid());
    check("kept", winstate.save(cast(*u8, &app), an, "main", 4, &st) == 1);
    let is [1200]u8 as kept;
    let is i64 as kn = io.sprintf(cast(*u8, &kept), 1200, "%s/%s/main.window", cast(*u8, &local), cast(*u8, &app));
    let is file.Info as info;
    check("kept under the local application data", kn > 0 && file.stat(cast(*u8, &kept), &info) == 1 && info.kind == file.FILE);
    let is winstate.State as back = winstate.state(0.0, 0.0);
    check("read back as kept", winstate.load(cast(*u8, &app), an, "main", 4, &back) == 1 && back.width == 640.0 &&
          back.height == 480.5 && back.maximized == 1 && back.fullscreen == 0);
    file.remove(cast(*u8, &kept));
    let is [1100]u8 as folder;
    io.sprintf(cast(*u8, &folder), 1100, "%s/%s", cast(*u8, &local), cast(*u8, &app));
    check("its folder made, and empty again removed", file.remove(cast(*u8, &folder)) == 1);

    // --- The file chooser's places ---
    let is *u8 as fb = mem.core.mmap_anon(1048576);
    let is i64 as fsz = file.read("text/testdata/shape-plain.ttf", fb, 1048576);
    if (fsz <= 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(fb, fsz, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    let is style.Theme as theme = style.light();
    let is gpu.device.Device as dv = gpu.open_headless(640, 480, gpu.SOFTWARE);
    let is text.Limits as lim = text.limits_default();
    let is *text.Service as svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);
    let is tree.Limits as tl = tree.limits_default();
    let is tree.Tree as t = tree.open(&tl);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    let is i64 as fc = filechooser.create(&t, filechooser.OPEN, "Open", 4);
    check("a chooser", fc != 0);
    check("it shows the profile first", same(filechooser.folder(&t, fc), filechooser.folder_length(&t, fc), cast(*u8, &profile)) == 1);
    let is *model.Model as pm = listview.model_of(&t, filechooser.places(&t, fc));
    let is i64 as np = model.count(pm, 0);
    let is model.Value as v;
    model.cell(pm, model.row_id(pm, 0, 0), 0, model.TEXT, &v);
    let is i32 as home_first = same(v.p, v.len, "Home");
    model.cell(pm, model.row_id(pm, 0, np - 1), 0, model.TEXT, &v);
    check("places: home first, the computer last", np >= 2 && home_first == 1 && same(v.p, v.len, "Computer") == 1);
    let is i32 as has_docs with mut = 0;
    let is i64 as i with mut = 0;
    while (i < np) {
        model.cell(pm, model.row_id(pm, 0, i), 0, model.TEXT, &v);
        if (same(v.p, v.len, "Documents") == 1) { has_docs = 1; }
        i = i + 1;
    }
    let is i32 as docs_there = cast(i32, file.stat(cast(*u8, &docs), &info) == 1 && info.kind == file.DIR);
    check("documents a place when Windows has it there", has_docs == docs_there);
    // The computer opens the drive's top.
    filechooser.set_folder(&t, fc, cast(*u8, &drive), 3);
    check("the drive's top shown", same(filechooser.folder(&t, fc), filechooser.folder_length(&t, fc), cast(*u8, &drive)) == 1);
    tree.close(&t);

    if (fails != 0) {
        io.printf("files win32: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("files win32: all checks passed\n");
    return 0;
}
