// ui/style.cst — the theme: what every widget's look is made of.
//
// One struct, as ui.md decides — not CSS. A window paints with one theme, and
// a widget reads what it needs from the painter's.
//
// Colours are sRGB, as written: 0x3584E4 is the blue a designer picked, and it
// is what lands in the pixel. Blending happens between those values too — the
// way browsers and the platform toolkits blend — so a theme's colours come out
// exactly as specified. (math.color.from_hex converts to linear light for
// lighting maths; a theme must not go through it, or every colour is drawn
// darker than it was chosen.)
use "../math/math.cst" as math;

struct Theme {
    window_bg    as math.color.Color;   // behind everything
    focus_color  as math.color.Color;   // the keyboard focus ring
    focus_width  as f64;
    focus_offset as f64;                // the ring's distance inside the widget's edge
    focus_radius as f64;
}

// 0xRRGGBB as written, opaque.
fn hex(v as i64) as math.color.Color {
    return math.color.rgba(cast(f64, (v >> 16) & 255) / 255.0,
                           cast(f64, (v >> 8) & 255) / 255.0,
                           cast(f64, v & 255) / 255.0, 1.0);
}

// The same with an alpha, 0 to 255.
fn hexa(v as i64, alpha as i64) as math.color.Color {
    let is math.color.Color as c with mut = hex(v);
    c.a = cast(f64, alpha) / 255.0;
    return c;
}

fn light() as Theme {
    let is Theme as th;
    th.window_bg = hex(16448250);      // 0xFAFAFA
    th.focus_color = hex(3507428);     // 0x3584E4
    th.focus_width = 2.0;
    th.focus_offset = 1.0;
    th.focus_radius = 4.0;
    return th;
}
