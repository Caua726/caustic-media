// ui/access.cst — what assistive technology is told about a widget, and what
// it may ask one to do.
//
// A screen reader needs, for every widget, what it is, what it is called and
// what state it is in; a switch control needs to press, toggle and set
// values without a pointer. Those are per widget and come from the first
// widget on, because adding them afterwards means touching every kind. The
// bridges that hand them to the platform — AT-SPI over D-Bus, UI Automation —
// read them through describe and act here, never from a kind directly.
//
// A kind says what it is with its role and answers the rest through its
// access entry (widget.cst): asked, it fills in a tree.Access with its name
// and description — pointers into its own data, valid until it next changes —
// its states, its value in a range where it has one, and the actions it
// answers to; asked to act, it does. What the tree knows — visible, showing,
// enabled, focusable — and the router — focused — is laid over whatever the
// kind said. A widget with no name of its own takes its label's
// (tree.set_labelled_by).
use "std/mem.cst" as mem;
use "tree.cst" as tree;
use "router.cst" as router;

// --- Roles ---
//
// Close to AT-SPI's and UI Automation's, which a bridge maps them onto.
let is i64 as ROLE_NONE            with imut = 0;    // a container with nothing to say
let is i64 as ROLE_WINDOW          with imut = 1;    // a tree's root
let is i64 as ROLE_DIALOG          with imut = 2;
let is i64 as ROLE_ALERT           with imut = 3;
let is i64 as ROLE_PANEL           with imut = 4;    // a container seen as one thing
let is i64 as ROLE_LABEL           with imut = 5;
let is i64 as ROLE_BUTTON          with imut = 6;
let is i64 as ROLE_TOGGLE_BUTTON   with imut = 7;
let is i64 as ROLE_LINK            with imut = 8;
let is i64 as ROLE_CHECK_BOX       with imut = 9;
let is i64 as ROLE_RADIO_BUTTON    with imut = 10;
let is i64 as ROLE_SWITCH          with imut = 11;
let is i64 as ROLE_SLIDER          with imut = 12;
let is i64 as ROLE_SPIN_BUTTON     with imut = 13;
let is i64 as ROLE_PROGRESS_BAR    with imut = 14;
let is i64 as ROLE_SEPARATOR       with imut = 15;
let is i64 as ROLE_IMAGE           with imut = 16;
let is i64 as ROLE_GROUP           with imut = 17;   // a group box: a frame with a title
let is i64 as ROLE_TOOLTIP         with imut = 18;
let is i64 as ROLE_ENTRY           with imut = 19;
let is i64 as ROLE_PASSWORD        with imut = 20;
let is i64 as ROLE_TEXT            with imut = 21;   // text of many lines
let is i64 as ROLE_SCROLL_PANE     with imut = 22;
let is i64 as ROLE_SCROLL_BAR      with imut = 23;
let is i64 as ROLE_SPLIT_PANE      with imut = 24;
let is i64 as ROLE_TAB_LIST        with imut = 25;
let is i64 as ROLE_TAB             with imut = 26;
let is i64 as ROLE_LIST            with imut = 27;
let is i64 as ROLE_LIST_ITEM       with imut = 28;
let is i64 as ROLE_TREE            with imut = 29;
let is i64 as ROLE_TREE_ITEM       with imut = 30;
let is i64 as ROLE_TABLE           with imut = 31;
let is i64 as ROLE_CELL            with imut = 32;
let is i64 as ROLE_COLUMN_HEADER   with imut = 33;
let is i64 as ROLE_COMBO_BOX       with imut = 34;
let is i64 as ROLE_MENU_BAR        with imut = 35;
let is i64 as ROLE_MENU            with imut = 36;
let is i64 as ROLE_MENU_ITEM       with imut = 37;
let is i64 as ROLE_CHECK_MENU_ITEM with imut = 38;
let is i64 as ROLE_RADIO_MENU_ITEM with imut = 39;
let is i64 as ROLE_TOOL_BAR        with imut = 40;
let is i64 as ROLE_STATUS_BAR      with imut = 41;
let is i64 as ROLE_TITLE_BAR       with imut = 42;   // a header bar
let is i64 as ROLE_TABLE_ROW       with imut = 43;
let is i64 as ROLE_COLOR_CHOOSER   with imut = 44;
let is i64 as ROLE_FONT_CHOOSER    with imut = 45;
let is i64 as ROLE_LAST            with imut = 45;

// A role's name, as a bridge or a test prints it; "unknown" for a number that
// is none.
fn role_name(r as i64) as *u8 {
    if (r == ROLE_NONE) { return "none"; }
    if (r == ROLE_WINDOW) { return "window"; }
    if (r == ROLE_DIALOG) { return "dialog"; }
    if (r == ROLE_ALERT) { return "alert"; }
    if (r == ROLE_PANEL) { return "panel"; }
    if (r == ROLE_LABEL) { return "label"; }
    if (r == ROLE_BUTTON) { return "button"; }
    if (r == ROLE_TOGGLE_BUTTON) { return "toggle button"; }
    if (r == ROLE_LINK) { return "link"; }
    if (r == ROLE_CHECK_BOX) { return "check box"; }
    if (r == ROLE_RADIO_BUTTON) { return "radio button"; }
    if (r == ROLE_SWITCH) { return "switch"; }
    if (r == ROLE_SLIDER) { return "slider"; }
    if (r == ROLE_SPIN_BUTTON) { return "spin button"; }
    if (r == ROLE_PROGRESS_BAR) { return "progress bar"; }
    if (r == ROLE_SEPARATOR) { return "separator"; }
    if (r == ROLE_IMAGE) { return "image"; }
    if (r == ROLE_GROUP) { return "group"; }
    if (r == ROLE_TOOLTIP) { return "tooltip"; }
    if (r == ROLE_ENTRY) { return "entry"; }
    if (r == ROLE_PASSWORD) { return "password text"; }
    if (r == ROLE_TEXT) { return "text"; }
    if (r == ROLE_SCROLL_PANE) { return "scroll pane"; }
    if (r == ROLE_SCROLL_BAR) { return "scroll bar"; }
    if (r == ROLE_SPLIT_PANE) { return "split pane"; }
    if (r == ROLE_TAB_LIST) { return "page tab list"; }
    if (r == ROLE_TAB) { return "page tab"; }
    if (r == ROLE_LIST) { return "list"; }
    if (r == ROLE_LIST_ITEM) { return "list item"; }
    if (r == ROLE_TREE) { return "tree"; }
    if (r == ROLE_TREE_ITEM) { return "tree item"; }
    if (r == ROLE_TABLE) { return "table"; }
    if (r == ROLE_CELL) { return "table cell"; }
    if (r == ROLE_COLUMN_HEADER) { return "column header"; }
    if (r == ROLE_COMBO_BOX) { return "combo box"; }
    if (r == ROLE_MENU_BAR) { return "menu bar"; }
    if (r == ROLE_MENU) { return "menu"; }
    if (r == ROLE_MENU_ITEM) { return "menu item"; }
    if (r == ROLE_CHECK_MENU_ITEM) { return "check menu item"; }
    if (r == ROLE_RADIO_MENU_ITEM) { return "radio menu item"; }
    if (r == ROLE_TOOL_BAR) { return "tool bar"; }
    if (r == ROLE_STATUS_BAR) { return "status bar"; }
    if (r == ROLE_TITLE_BAR) { return "title bar"; }
    if (r == ROLE_TABLE_ROW) { return "table row"; }
    if (r == ROLE_COLOR_CHOOSER) { return "color chooser"; }
    if (r == ROLE_FONT_CHOOSER) { return "font chooser"; }
    return "unknown";
}

// --- States ---
//
// The first five are the tree's and the router's, set by describe whatever
// the kind said; the rest are the kind's to say.
let is i64 as VISIBLE    with imut = 1;         // not hidden itself
let is i64 as SHOWING    with imut = 2;         // nor any ancestor
let is i64 as ENABLED    with imut = 4;
let is i64 as FOCUSABLE  with imut = 8;
let is i64 as FOCUSED    with imut = 16;
let is i64 as CHECKABLE  with imut = 32;
let is i64 as CHECKED    with imut = 64;
let is i64 as MIXED      with imut = 128;       // neither checked nor not
let is i64 as PRESSED    with imut = 256;       // a toggle button down
let is i64 as EXPANDABLE with imut = 512;
let is i64 as EXPANDED   with imut = 1024;
let is i64 as SELECTABLE with imut = 2048;
let is i64 as SELECTED   with imut = 4096;
let is i64 as EDITABLE   with imut = 8192;
let is i64 as READ_ONLY  with imut = 16384;
let is i64 as REQUIRED   with imut = 32768;
let is i64 as BUSY       with imut = 65536;
let is i64 as MULTI_LINE with imut = 131072;
let is i64 as HORIZONTAL with imut = 262144;
let is i64 as VERTICAL   with imut = 524288;
let is i64 as DEFAULT    with imut = 1048576;   // the button Enter presses
let is i64 as VISITED    with imut = 2097152;   // a link followed
let is i64 as MODAL      with imut = 4194304;
let is i64 as INVALID    with imut = 8388608;   // what it holds is refused
let is i64 as MULTISELECTABLE with imut = 16777216;   // a list where more than one can be chosen

let is i64 as TREE_STATES with imut = 31;

// --- Actions ---
//
// What a kind answers to, a bit each; ASK is the question, no action.
let is i64 as ASK       with imut = 0;
let is i64 as PRESS     with imut = 1;     // click, activate
let is i64 as TOGGLE    with imut = 2;
let is i64 as INCREMENT with imut = 4;     // a step up
let is i64 as DECREMENT with imut = 8;
let is i64 as SET_VALUE with imut = 16;    // to q.arg
let is i64 as EXPAND    with imut = 32;
let is i64 as COLLAPSE  with imut = 64;
let is i64 as SELECT    with imut = 128;
let is i64 as SHOW_MENU with imut = 256;   // the context menu
let is i64 as DESELECT  with imut = 512;   // chosen no longer

// --- For a kind's entry ---

// text, n bytes of UTF-8 the kind keeps: its name.
fn set_name(q as *tree.Access, text as *u8, n as i64) as void {
    q.name = text;
    q.name_len = n;
}

fn set_description(q as *tree.Access, text as *u8, n as i64) as void {
    q.description = text;
    q.description_len = n;
}

// A value in a range, moved by step.
fn set_range(q as *tree.Access, value as f64, min as f64, max as f64, step as f64) as void {
    q.has_value = 1;
    q.value = value;
    q.min = min;
    q.max = max;
    q.step = step;
}

// --- Asking ---

// What w's kind says of it, and nothing else.
fn _ask(t as *tree.Tree, w as i64, out as *tree.Access) as void {
    let is *tree.Kind as k = tree.kind(t, w);
    out.role = k.role;
    if (cast(i64, k.access) != 0) { call(k.access, t, w, tree.data(t, w), out); }
}

// The role w is told as: its kind's, or the one its entry says instead; a
// window for a tree's root with none; none for a widget gone.
fn role(t as *tree.Tree, w as i64) as i64 {
    if (tree.is_valid(t, w) == 0) { return ROLE_NONE; }
    let is tree.Access as q;
    mem.memset(cast(*u8, &q), 0, sizeof(tree.Access));
    _ask(t, w, &q);
    if (w == tree.root(t) && q.role == ROLE_NONE) { return ROLE_WINDOW; }
    return q.role;
}

// What w is, into *out: 1, or 0 — and nothing, every field zero — for a
// widget that is gone. r is the window's router, null to say nothing of
// focus.
fn describe(t as *tree.Tree, r as *router.Router, w as i64, out as *tree.Access) as i32 {
    mem.memset(cast(*u8, out), 0, sizeof(tree.Access));
    if (tree.is_valid(t, w) == 0) { return 0; }
    _ask(t, w, out);
    // The root is the window, whatever kind stands for it.
    if (w == tree.root(t) && out.role == ROLE_NONE) { out.role = ROLE_WINDOW; }
    // No name of its own: its label's text.
    let is i64 as l = tree.labelled_by(t, w);
    if (out.name_len == 0 && l != 0 && l != w) {
        let is tree.Access as named;
        mem.memset(cast(*u8, &named), 0, sizeof(tree.Access));
        _ask(t, l, &named);
        out.name = named.name;
        out.name_len = named.name_len;
    }
    out.action = ASK;
    out.arg = 0.0;
    let is i64 as st with mut = out.states & (0 - 1 - TREE_STATES);
    if (tree.is_hidden_here(t, w) == 0) { st = st | VISIBLE; }
    if (tree.is_visible(t, w) == 1) { st = st | SHOWING; }
    if (tree.is_enabled(t, w) == 1) { st = st | ENABLED; }
    if (tree.is_focusable(t, w) == 1) { st = st | FOCUSABLE; }
    if (cast(i64, r) != 0 && router.focused(t, r) == w) { st = st | FOCUSED; }
    out.states = st;
    return 1;
}

// --- Acting ---

// Asks w to do action — one of its kind's — with arg for SET_VALUE: 1 when
// it did. A widget that is gone or disabled, or whose kind does not say it
// answers to the action, is not asked.
fn act(t as *tree.Tree, w as i64, action as i64, arg as f64) as i32 {
    if (action == ASK || tree.is_valid(t, w) == 0 || tree.is_enabled(t, w) == 0) { return 0; }
    let is *tree.Kind as k = tree.kind(t, w);
    if (cast(i64, k.access) == 0) { return 0; }
    let is tree.Access as q;
    describe(t, cast(*router.Router, 0), w, &q);
    if ((q.actions & action) == 0) { return 0; }
    q.action = action;
    q.arg = arg;
    if (call(k.access, t, w, tree.data(t, w), &q) != 0) { return 1; }
    return 0;
}

// --- Text ---
//
// A widget with text — a label, an entry, a text view — tells it through its
// kind's text entry: what it is, where the caret and the selection are, where
// a character is drawn and which is at a point, and, editable, has it
// replaced, cut, copied and pasted. Offsets are UTF-8 bytes; a bridge counts
// characters, and converts.

// w's text, caret, selection and whether it can be edited, into q: 1, or 0
// for a widget with none.
fn text_of(t as *tree.Tree, w as i64, q as *tree.TextQuery) as i32 {
    mem.memset(cast(*u8, q), 0, sizeof(tree.TextQuery));
    q.caret = 0 - 1;
    if (tree.is_valid(t, w) == 0) { return 0; }
    let is *tree.Kind as k = tree.kind(t, w);
    if (cast(i64, k.text) == 0) { return 0; }
    q.op = tree.TEXT_GET;
    return cast(i32, call(k.text, t, w, tree.data(t, w), q) != 0);
}

// q.op done to w's text, or asked of it: 1 when it was. A widget disabled,
// gone, or with no text does nothing.
fn text_do(t as *tree.Tree, w as i64, q as *tree.TextQuery) as i32 {
    if (q.op == tree.TEXT_GET) { return text_of(t, w, q); }
    if (tree.is_valid(t, w) == 0) { return 0; }
    let is *tree.Kind as k = tree.kind(t, w);
    if (cast(i64, k.text) == 0) { return 0; }
    // Asking is fine anyway; changing it, not disabled.
    if (_changes(q.op) == 1 && tree.is_enabled(t, w) == 0) { return 0; }
    return cast(i32, call(k.text, t, w, tree.data(t, w), q) != 0);
}

fn _changes(op as i64) as i32 {
    return cast(i32, op == tree.TEXT_SET_CARET || op == tree.TEXT_SELECT || op == tree.TEXT_REPLACE ||
                     op == tree.TEXT_COPY || op == tree.TEXT_CUT || op == tree.TEXT_PASTE);
}

// Whether w's kind answered q itself — op set, the rest as the op says.
fn _asked(t as *tree.Tree, w as i64, q as *tree.TextQuery, op as i64) as i32 {
    q.op = op;
    if (tree.is_valid(t, w) == 0) { return 0; }
    let is *tree.Kind as k = tree.kind(t, w);
    if (cast(i64, k.text) == 0) { return 0; }
    return cast(i32, call(k.text, t, w, tree.data(t, w), q) != 0);
}

fn _starts(c as u8) as i32 { return cast(i32, (c & 192) != 128); }

// The whole text, for a question the kind does not answer.
fn _whole(t as *tree.Tree, w as i64, q as *tree.TextQuery) as i32 { return text_of(t, w, q); }

// What w's text is but the text: text_len, chars, caret, selection, whether
// it can be edited, whether it tells its changes — 1, or 0 for a widget with
// none. A kind that does not answer is read whole and counted.
fn text_info(t as *tree.Tree, w as i64, q as *tree.TextQuery) as i32 {
    mem.memset(cast(*u8, q), 0, sizeof(tree.TextQuery));
    q.caret = 0 - 1;
    if (_asked(t, w, q, tree.TEXT_INFO) == 1) { return 1; }
    if (_whole(t, w, q) == 0) { return 0; }
    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    while (i < q.text_len) {
        if (_starts(q.text[i]) == 1) { n = n + 1; }
        i = i + 1;
    }
    q.chars = n;
    q.tells = 0;
    return 1;
}

// Bytes a to b of w's text, held to it, in one piece: into q.text and
// q.text_len, until it next changes. 1, or 0 for a widget with none.
fn text_span(t as *tree.Tree, w as i64, a as i64, b as i64, q as *tree.TextQuery) as i32 {
    let is tree.TextQuery as all;
    if (text_info(t, w, &all) == 0) { return 0; }
    let is i64 as x with mut = a;
    let is i64 as y with mut = b;
    if (x < 0) { x = 0; }
    if (y > all.text_len) { y = all.text_len; }
    if (y < x) { y = x; }
    mem.memset(cast(*u8, q), 0, sizeof(tree.TextQuery));
    q.a = x;
    q.b = y;
    if (_asked(t, w, q, tree.TEXT_SPAN) == 1) { return 1; }
    if (_whole(t, w, q) == 0) { return 0; }
    q.text = cast(*u8, cast(i64, q.text) + x);
    q.text_len = y - x;
    return 1;
}

// The characters before byte at of w's text; all of them past its end.
fn text_char_of(t as *tree.Tree, w as i64, at as i64) as i64 {
    if (at <= 0) { return 0; }
    let is tree.TextQuery as q;
    mem.memset(cast(*u8, &q), 0, sizeof(tree.TextQuery));
    q.at = at;
    if (_asked(t, w, &q, tree.TEXT_CHAR_OF) == 1) { return q.a; }
    if (_whole(t, w, &q) == 0) { return 0; }
    let is i64 as end with mut = at;
    if (end > q.text_len) { end = q.text_len; }
    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    while (i < end) {
        if (_starts(q.text[i]) == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// Where character k of w's text starts, in bytes; its end past the last.
fn text_byte_of(t as *tree.Tree, w as i64, k as i64) as i64 {
    if (k <= 0) { return 0; }
    let is tree.TextQuery as q;
    mem.memset(cast(*u8, &q), 0, sizeof(tree.TextQuery));
    q.at = k;
    if (_asked(t, w, &q, tree.TEXT_BYTE_OF) == 1) { return q.a; }
    if (_whole(t, w, &q) == 0) { return 0; }
    let is i64 as c with mut = 0;
    let is i64 as i with mut = 0;
    while (i < q.text_len) {
        if (_starts(q.text[i]) == 1) {
            if (c == k) { return i; }
            c = c + 1;
        }
        i = i + 1;
    }
    return q.text_len;
}

// The paragraph byte at of w's text is in, from *a to *b, its line feed in
// it: 1, or 0 for a widget with none.
fn text_paragraph(t as *tree.Tree, w as i64, at as i64, a as *i64, b as *i64) as i32 {
    let is tree.TextQuery as q;
    mem.memset(cast(*u8, &q), 0, sizeof(tree.TextQuery));
    q.at = at;
    if (_asked(t, w, &q, tree.TEXT_PARAGRAPH) == 1) {
        *a = q.a;
        *b = q.b;
        return 1;
    }
    if (_whole(t, w, &q) == 0) { return 0; }
    let is i64 as n = q.text_len;
    let is i64 as x with mut = at;
    if (x > n) { x = n; }
    if (x < 0) { x = 0; }
    let is i64 as s with mut = x;
    while (s > 0 && q.text[s - 1] != 10) { s = s - 1; }
    let is i64 as e with mut = s;
    while (e < n && q.text[e] != 10) { e = e + 1; }
    if (e < n) { e = e + 1; }
    *a = s;
    *b = e;
    return 1;
}

// Bytes a UTF-8 sequence led by c takes.
fn _seq(c as u8) as i64 {
    let is i64 as b = cast(i64, c);
    if ((b & 224) == 192) { return 2; }
    if ((b & 240) == 224) { return 3; }
    if ((b & 248) == 240) { return 4; }
    return 1;
}

// w's text around its caret, for an input method to compose against: at
// most max bytes of whole characters, within the caret's paragraph (its line
// feed left out), the selection in it as far as it fits — into q.text and
// q.text_len, with q.caret and q.a (the selection's other end, the caret
// with none) offsets into that text. 1, or 0 for a widget with no text or
// no caret.
fn text_around(t as *tree.Tree, w as i64, max as i64, q as *tree.TextQuery) as i32 {
    let is tree.TextQuery as info;
    if (text_info(t, w, &info) == 0 || info.caret < 0 || max <= 0) { return 0; }
    let is i64 as caret = info.caret;
    let is i64 as anchor with mut = info.a;
    if (caret == info.a) { anchor = info.b; }
    let is i64 as pa with mut = 0;
    let is i64 as pb with mut = info.text_len;
    if (text_paragraph(t, w, caret, &pa, &pb) == 0) {
        pa = 0;
        pb = info.text_len;
    }
    if (anchor < pa) { anchor = pa; }
    if (anchor > pb) { anchor = pb; }
    let is i64 as lo with mut = caret;
    let is i64 as hi with mut = anchor;
    if (anchor < caret) {
        lo = anchor;
        hi = caret;
    }
    // The window: the whole paragraph; or the selection centred in it; or,
    // the selection longer still, the caret centred.
    let is i64 as s with mut = pa;
    let is i64 as e with mut = pb;
    if (pb - pa > max) {
        if (hi - lo <= max) { s = lo - (max - (hi - lo)) / 2; }
        else { s = caret - max / 2; }
        if (s < pa) { s = pa; }
        e = s + max;
        if (e > pb) {
            e = pb;
            s = e - max;
        }
    }
    let is tree.TextQuery as span;
    if (text_span(t, w, s, e, &span) == 0) { return 0; }
    let is *u8 as b = span.text;
    let is i64 as n = span.text_len;
    let is i64 as at = caret - s;
    // A character cut at either end left out; never past the caret, which
    // is between two.
    let is i64 as first with mut = 0;
    while (first < at && first < n && (cast(i64, b[first]) & 192) == 128) { first = first + 1; }
    let is i64 as last with mut = n;
    if (n > at) {
        let is i64 as lead with mut = n - 1;
        while (lead > at && (cast(i64, b[lead]) & 192) == 128) { lead = lead - 1; }
        if (lead + _seq(b[lead]) > n) { last = lead; }
    }
    if (e == pb && last > at && b[last - 1] == cast(u8, 10)) { last = last - 1; }
    mem.memset(cast(*u8, q), 0, sizeof(tree.TextQuery));
    q.text = cast(*u8, cast(i64, b) + first);
    q.text_len = last - first;
    q.caret = at - first;
    let is i64 as other with mut = anchor - s - first;
    if (other < 0) { other = 0; }
    if (other > q.text_len) { other = q.text_len; }
    q.a = other;
    return 1;
}
