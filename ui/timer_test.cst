// ui/timer_test.cst — timers on an explicit clock.
//
// Time is passed in, never read, so every case here is exact: a timer due at
// 150 fires at 150 and not at 149.
use "std/io.cst" as io;
use "timer.cst" as timer;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL: %s: got %d, want %d\n", name, cast(i32, got), cast(i32, want));
        fails = fails + 1;
    }
}

fn bump(user as *u8) as void {
    let is *i64 as n = cast(*i64, user);
    *n = *n + 1;
}

// A callback that schedules another timer from inside fire().
let is *timer.Timers as chain_to with mut;
let is i64 as chained with mut = 0;

fn add_another(user as *u8) as void {
    timer.add(chain_to, 1000, 0, 0, fn_ptr(bump), cast(*u8, &chained));
}

fn main() as i32 {
    let is timer.Timers as ts = timer.init();
    eq("nothing due", timer.next_due(&ts), 0 - 1);

    // --- Once: fires at its time, not before, not again ---
    let is i64 as once with mut = 0;
    let is i64 as id = timer.add(&ts, 100, 50, 0, fn_ptr(bump), cast(*u8, &once));
    check("added", id != 0);
    eq("due at 150", timer.next_due(&ts), 150);
    eq("not yet at 149", timer.fire(&ts, 149), 0);
    eq("fires at 150", timer.fire(&ts, 150), 1);
    eq("callback ran", once, 1);
    timer.fire(&ts, 500);
    eq("once means once", once, 1);
    eq("nothing due after", timer.next_due(&ts), 0 - 1);

    // --- Repeating: every interval ---
    let is i64 as blinks with mut = 0;
    let is i64 as caret = timer.add(&ts, 1000, 500, 500, fn_ptr(bump), cast(*u8, &blinks));
    timer.fire(&ts, 1500);
    timer.fire(&ts, 2000);
    timer.fire(&ts, 2499);
    eq("twice by 2499", blinks, 2);
    eq("next at 2500", timer.next_due(&ts), 2500);

    // A long stall fires once and starts again from now, rather than firing
    // every interval it missed in a burst.
    eq("after a stall, one firing", timer.fire(&ts, 10000), 1);
    eq("rescheduled from now", timer.next_due(&ts), 10500);

    // --- Cancelling ---
    timer.cancel(&ts, caret);
    timer.fire(&ts, 20000);
    eq("cancelled does not fire", blinks, 3);

    // A cancelled id stays dead even after its slot is reused.
    let is i64 as other with mut = 0;
    let is i64 as first = timer.add(&ts, 30000, 10, 0, fn_ptr(bump), cast(*u8, &other));
    timer.cancel(&ts, first);
    let is i64 as reused = timer.add(&ts, 30000, 10, 0, fn_ptr(bump), cast(*u8, &other));
    check("same slot", (reused & 4294967295) == (first & 4294967295));
    check("ids differ", reused != first);
    timer.cancel(&ts, first);
    timer.fire(&ts, 30010);
    eq("stale id did not cancel the new timer", other, 1);

    // --- A callback can schedule; the new timer waits for the next pass ---
    //
    // Even one already due: otherwise a callback that schedules more work for
    // "now" would keep fire() from ever returning.
    chain_to = &ts;
    let is i64 as ran with mut = 0;
    timer.add(&ts, 1000, 0, 0, fn_ptr(add_another), cast(*u8, &ran));
    timer.fire(&ts, 1000);
    eq("chained timer not fired in the same pass", chained, 0);
    timer.fire(&ts, 1000);
    eq("chained timer fires on the next pass", chained, 1);

    // --- The earliest of several ---
    let is i64 as x with mut = 0;
    let is i64 as late = timer.add(&ts, 0, 900, 0, fn_ptr(bump), cast(*u8, &x));
    timer.add(&ts, 0, 300, 0, fn_ptr(bump), cast(*u8, &x));
    eq("earliest wins", timer.next_due(&ts), 300);
    timer.fire(&ts, 300);
    eq("then the next", timer.next_due(&ts), 900);
    timer.cancel(&ts, late);

    // --- The table is bounded and says so ---
    let is i64 as n with mut = 0;
    let is i64 as got with mut = 1;
    while (got != 0 && n < 1000) {
        got = timer.add(&ts, 0, 1000000, 0, fn_ptr(bump), cast(*u8, &x));
        n = n + 1;
    }
    eq("full returns 0", got, 0);
    eq("holds MAX_TIMERS", n - 1, timer.MAX_TIMERS);

    if (fails != 0) { return 1; }
    io.printf("ui timers: all checks passed\n");
    return 0;
}
