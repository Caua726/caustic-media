// ui/widget.cst — the table of functions every kind of widget fills in.
//
// Caustic has no classes, so a kind of widget is a value: a name, how many
// bytes of data each widget of the kind carries, and the functions that give
// it behaviour. A button and a slider differ only in which table they point
// at. A program defines a kind exactly as this library does — that is the
// extension point ui.md asks for, and one a toolkit cannot grow later.
//
// The table grows with the toolkit: measure and arrange arrive with layout,
// paint with painting, event with routing. A null entry means there is
// nothing to do, so a kind fills in only what it needs.
//
//   destroy(tree *Tree, w i64, data *u8)
//       Release whatever data points at. Called children-first, while w and
//       its data are still valid, and before the slot is reused.
//
//   measure(tree *Tree, w i64, data *u8, c *geom.Constraint, out *geom.Size)
//       Report the content's minimum, preferred and maximum size for the room
//       in c — margins already taken off, overrides applied afterwards by
//       layout. A container measures its children through layout.measure.
//       Null: zero, growing without limit.
//
//   arrange(tree *Tree, w i64, data *u8, r *math.rect.Rect)
//       The widget has been given r (relative to its parent). A container
//       places each child with layout.place, in its own coordinates — 0,0 is
//       its top-left — so r.w and r.h are what it divides. Null: nothing to
//       place.
//
// Every argument is an integer or a pointer, never an f64: entries are called
// through call(), and sizes travel in structs so the calling convention of a
// float argument never enters into it.

struct Kind {
    name       as *u8;
    data_bytes as i64;   // zeroed for each new widget, owned by the tree
    destroy    as *u8;
    measure    as *u8;
    arrange    as *u8;
}

// A kind with no behaviour yet; the caller sets the entries it needs.
fn kind(name as *u8, data_bytes as i64) as Kind {
    let is Kind as k;
    k.name = name;
    k.data_bytes = data_bytes;
    k.destroy = cast(*u8, 0);
    k.measure = cast(*u8, 0);
    k.arrange = cast(*u8, 0);
    return k;
}
