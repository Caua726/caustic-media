// ui/widget.cst — the table of functions every kind of widget fills in.
//
// Caustic has no classes, so a kind of widget is a value — tree.Kind: a name,
// how many bytes of data each widget of the kind carries, and the functions
// that give it behaviour. A button and a slider differ only in which table
// they point at. A program defines a kind exactly as this library does — that
// is the extension point ui.md asks for, and one a toolkit cannot grow later.
//
// The struct is declared in tree.cst, because every node points at one and
// its entries' types name the Tree; this file makes an empty one and says
// what each entry means. A null entry means there is nothing to do, so a kind
// fills in only what it needs.
//
//   destroy(tree *Tree, w i64, data *u8)                       tree.DestroyFn
//       Release whatever data points at. Called children-first, while w and
//       its data are still valid, and before the slot is reused.
//
//   measure(tree *Tree, w i64, data *u8, c *geom.Constraint, out *geom.Size)
//                                                              tree.MeasureFn
//       Report the content's minimum, preferred and maximum size for the room
//       in c — margins already taken off, overrides applied afterwards by
//       layout. A container measures its children through layout.measure.
//       Null: zero, growing without limit.
//
//   arrange(tree *Tree, w i64, data *u8, r *math.rect.Rect)    tree.ArrangeFn
//       The widget has been given r (relative to its parent). A container
//       places each child with layout.place, in its own coordinates — 0,0 is
//       its top-left — so r.w and r.h are what it divides. Null: nothing to
//       place.
//
//   event(tree *Tree, w i64, data *u8, e *event.Event) -> i64  tree.EventFn
//       Handle e and return 1, or return 0 to let it travel on — up to the
//       parent, for the events that bubble. Null: nothing handled. See
//       router.cst for which events go where.
//
//   paint(tree *Tree, w i64, data *u8, p *painter.Painter)     tree.PaintFn
//       Draw the widget on p.canvas, inside p.rect, with p.theme, in the state
//       p.state says. Called parent first, so children draw over it; the
//       keyboard focus ring is drawn after the children unless the entry sets
//       p.focus_drawn. See painter.cst. Null: nothing of its own to draw.
//
//   hit(tree *Tree, w i64, data *u8, p *math.vec.Vec2) -> i32  tree.HitFn
//       Whether the point p — in w's coordinates, and inside its rectangle —
//       is w's own rather than a child's: a scroll area's bars drawn over its
//       content. 1 stops hit-testing at w, so the event goes to w. Null: a
//       point goes to whichever child is under it.
//
//   access(tree *Tree, w i64, data *u8, q *tree.Access) -> i64 tree.AccessFn
//       Asked (q.action is access.ASK): fill in what the kind knows — name,
//       description, states, value, the actions it answers to — and return
//       1. Asked to act: do q.action, with q.arg for SET_VALUE, and return 1,
//       or 0 when it could not. See access.cst. Null: nothing but the role.
//
// And role, what the kind is to assistive technology: access.ROLE_BUTTON and
// the rest; 0, ROLE_NONE, for a container with nothing of its own to say.
//
// Every argument is an integer or a pointer, never an f64: sizes travel in
// structs, so the calling convention of a float argument never enters into it.
use "tree.cst" as tree;
use "style.cst" as style;

// --- What a setter changed ---
//
// A setter that changes how big a widget wants to be says CHANGED_LAYOUT; one
// that changes how it looks says CHANGED_PAINT; most say both. Layout then
// measures it again on the next pass, and the next frame repaints it — where
// it was and, if it moved, where it is.
let is i32 as CHANGED_LAYOUT with imut = 1;
let is i32 as CHANGED_PAINT  with imut = 2;

fn changed(t as *tree.Tree, w as i64, what as i32) as void {
    if ((what & CHANGED_LAYOUT) != 0) { tree.invalidate_layout(t, w); }
    if ((what & CHANGED_PAINT) != 0) { tree.invalidate_paint(t, w); }
}

// A kind with no behaviour yet; the caller sets the entries it needs.
fn kind(name as *u8, data_bytes as i64) as tree.Kind {
    let is tree.Kind as k;
    k.name = name;
    k.data_bytes = data_bytes;
    k.destroy = cast(tree.DestroyFn, 0);
    k.measure = cast(tree.MeasureFn, 0);
    k.arrange = cast(tree.ArrangeFn, 0);
    k.event = cast(tree.EventFn, 0);
    k.hit = cast(tree.HitFn, 0);
    k.paint = cast(tree.PaintFn, 0);
    k.role = 0;
    k.access = cast(tree.AccessFn, 0);
    k.shape = cast(tree.ShapeFn, 0);
    k.paint_over = cast(tree.PaintFn, 0);
    k.text = cast(tree.TextFn, 0);
    k.caret = cast(tree.CaretFn, 0);
    return k;
}

// The theme that applies to w: its tree's, with every override from the root
// down to w laid on in that order, the nearest last. Painting resolves the
// same thing on its way down; this is for measuring, which needs the sizes.
fn theme(t as *tree.Tree, w as i64, out as *style.Theme) as void {
    if (tree.is_valid(t, w) == 0) {
        *out = *tree.theme(t);
        return;
    }
    theme(t, tree.parent(t, w), out);
    let is *style.Overrides as o = tree.overrides(t, w);
    if (cast(i64, o) != 0) { style.apply(out, o); }
}
