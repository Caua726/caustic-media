// ui/widget.cst — the table of functions every kind of widget fills in.
//
// Caustic has no classes, so a kind of widget is a value — tree.Kind: a name,
// how many bytes of data each widget of the kind carries, and the functions
// that give it behaviour. A button and a slider differ only in which table
// they point at. A program defines a kind exactly as this library does — that
// is the extension point ui.md asks for, and one a toolkit cannot grow later.
//
// The struct is declared in tree.cst, because every node points at one and
// its entries' types name the Tree; this file makes an empty one and says
// what each entry means. A null entry means there is nothing to do, so a kind
// fills in only what it needs.
//
//   destroy(tree *Tree, w i64, data *u8)                       tree.DestroyFn
//       Release whatever data points at. Called children-first, while w and
//       its data are still valid, and before the slot is reused.
//
//   measure(tree *Tree, w i64, data *u8, c *geom.Constraint, out *geom.Size)
//                                                              tree.MeasureFn
//       Report the content's minimum, preferred and maximum size for the room
//       in c — margins already taken off, overrides applied afterwards by
//       layout. A container measures its children through layout.measure.
//       Null: zero, growing without limit.
//
//   arrange(tree *Tree, w i64, data *u8, r *math.rect.Rect)    tree.ArrangeFn
//       The widget has been given r (relative to its parent). A container
//       places each child with layout.place, in its own coordinates — 0,0 is
//       its top-left — so r.w and r.h are what it divides. Null: nothing to
//       place.
//
//   event(tree *Tree, w i64, data *u8, e *event.Event) -> i64  tree.EventFn
//       Handle e and return 1, or return 0 to let it travel on — up to the
//       parent, for the events that bubble. Null: nothing handled. See
//       router.cst for which events go where.
//
// Every argument is an integer or a pointer, never an f64: sizes travel in
// structs, so the calling convention of a float argument never enters into it.
use "tree.cst" as tree;

// A kind with no behaviour yet; the caller sets the entries it needs.
fn kind(name as *u8, data_bytes as i64) as tree.Kind {
    let is tree.Kind as k;
    k.name = name;
    k.data_bytes = data_bytes;
    k.destroy = cast(tree.DestroyFn, 0);
    k.measure = cast(tree.MeasureFn, 0);
    k.arrange = cast(tree.ArrangeFn, 0);
    k.event = cast(tree.EventFn, 0);
    return k;
}
