// ui/style_test.cst — the theme: tokens, states, themes, preferences, overrides.
//
// Colours are checked the way people read them: by WCAG contrast, text on
// its background at least 4.5 to 1 (7 in high contrast), the focus ring and
// borders at least 3 — so a theme that drifts into grey on grey fails here,
// not in front of someone who cannot see it.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "../gpu/gpu.cst" as gpu;
use "../render/draw2d.cst" as draw2d;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "damage.cst" as damage;
use "painter.cst" as painter;
use "paint.cst" as paint;
use "style.cst" as style;
use "app.cst" as app;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn at_least(name as *u8, got as f64, want as f64) as void {
    if (got < want) {
        io.printf("FAIL: %s: %d/100, want at least %d/100\n", name,
                  cast(i64, got * 100.0), cast(i64, want * 100.0));
        fails = fails + 1;
    }
}

// a == b, false for NaN. Compared with >= both ways: the compiler's == and <=
// come out true for NaN (caustic 0.1.12-dev.8), and >= does not.
fn exactly(a as f64, b as f64) as i32 {
    if (a >= b && b >= a) { return 1; }
    return 0;
}

// Leaves the stack below the caller full of ones, so a struct a function
// forgets to initialise there is not quietly zero.
fn dirty_stack() as void {
    let is [512]i64 as junk with mut;
    let is i64 as i with mut = 0;
    while (i < 512) {
        junk[i] = 1;
        i = i + 1;
    }
}

fn fresh_overrides() as style.Overrides {
    dirty_stack();
    return style.overrides();
}

fn same(a as math.color.Color, b as math.color.Color) as i32 {
    if (math.color.pack_rgba8(a) == math.color.pack_rgba8(b)) { return 1; }
    return 0;
}

// What every theme owes the people reading it.
fn readable(name as *u8, th as *style.Theme, text as f64, ui as f64) as void {
    let is *style.Palette as p = &th.palette;
    let is i32 as before = fails;
    at_least("text on the window", style.contrast(p.fg, p.window_bg), text);
    at_least("text on a view", style.contrast(p.fg, p.view_bg), text);
    at_least("text on a card", style.contrast(p.fg, p.card_bg), text);
    at_least("dim text on the window", style.contrast(p.fg_dim, p.window_bg), ui + 1.0);
    at_least("text on the accent", style.contrast(p.accent_fg, p.accent), ui);
    at_least("selected text", style.contrast(p.selection_fg, p.selection_bg), text);
    at_least("text on destructive", style.contrast(p.destructive_fg, p.destructive), ui);
    at_least("the focus ring against the window", style.contrast(p.focus, p.window_bg), ui);
    at_least("the focus ring against a view", style.contrast(p.focus, p.view_bg), ui);
    at_least("a tooltip", style.contrast(p.tooltip_fg, p.tooltip_bg), text);
    at_least("a link", style.contrast(p.link, p.view_bg), text);
    at_least("a link on the window", style.contrast(p.link, p.window_bg), text);
    if (fails != before) { io.printf("  ... in the theme '%s'\n", name); }
}

// Every text style of b is k times a's.
fn scaled(name as *u8, a as *style.Fonts, b as *style.Fonts, k as f64) as void {
    if (b.caption.size != a.caption.size * k || b.body.size != a.body.size * k
        || b.body_strong.size != a.body_strong.size * k || b.heading.size != a.heading.size * k
        || b.title.size != a.title.size * k || b.large_title.size != a.large_title.size * k
        || b.mono_body.size != a.mono_body.size * k) {
        io.printf("FAIL: %s: not every text style scaled\n", name);
        fails = fails + 1;
    }
}

// Hover and press both show, and differently.
fn reacts(name as *u8, v as *style.Variants) as void {
    let is style.Look as rest = style.pick(v, 0, 0);
    let is style.Look as over = style.pick(v, painter.S_HOVER, 0);
    let is style.Look as down = style.pick(v, painter.S_PRESSED, 0);
    if (same(rest.bg, over.bg) == 1 || same(over.bg, down.bg) == 1) {
        io.printf("FAIL: %s: hover and press do not show\n", name);
        fails = fails + 1;
    }
}

struct Probe {
    seen as math.color.Color;
    size as f64;
}

fn probe_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Probe as d = cast(*Probe, data);
    d.seen = p.theme.palette.accent;
    d.size = p.theme.fonts.body.size;
}

fn probe_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = 10.0;
    out.pref_h = 10.0;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// Children laid over the whole of it, so the nested probe has a rectangle to
// be painted in.
fn probe_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as probe_kind with mut;

fn main() as i32 {
    // --- Colours as written ---
    check("hex: as written", math.color.pack_rgba8(math.color.hex(3507428)) == 4293166133);   // 0x3584E4, packed ABGR
    check("hex with alpha", ((math.color.pack_rgba8(style.hexa(3507428, 128)) >> 24) & 255) == 128);
    check("contrast: black on white is 21", style.contrast(math.color.hex(0), math.color.hex(16777215)) > 20.99);
    let is f64 as grey = style.contrast(math.color.hex(7829367), math.color.hex(16777215));   // #777
    check("contrast: #777 on white just under 4.5", grey > 4.47 && grey < 4.49);
    check("contrast is symmetric", style.contrast(math.color.hex(0), math.color.hex(16777215))
          == style.contrast(math.color.hex(16777215), math.color.hex(0)));
    check("mix halfway", same(style.mix(math.color.hex(0), math.color.hex(16777215), 0.5), math.color.hex(8421504)));
    check("mix: alpha too", style.mix(style.hexa(0, 0), style.hex(0), 0.5).a == 0.5);
    let is math.color.Color as nothing = style.over(style.hexa(0, 0), style.hexa(0, 0));
    check("over: nothing over nothing is nothing", exactly(nothing.a, 0.0) == 1 && exactly(nothing.r, 0.0) == 1);

    // --- The themes, readable ---
    let is style.Theme as light = style.light();
    let is style.Theme as dark = style.dark();
    let is style.Theme as hc = style.high_contrast(0);
    let is style.Theme as hcd = style.high_contrast(1);
    readable("light", &light, 4.5, 3.0);
    readable("dark", &dark, 4.5, 3.0);
    readable("high contrast", &hc, 7.0, 4.5);
    readable("high contrast, dark", &hcd, 7.0, 4.5);
    check("light is light", light.dark == 0 && style.luminance(light.palette.window_bg) > 0.5);
    check("dark is dark", dark.dark == 1 && style.luminance(dark.palette.window_bg) < 0.1);
    check("high contrast says so", hc.high_contrast == 1 && hcd.high_contrast == 1 && hcd.dark == 1);
    at_least("high contrast: borders", style.contrast(hc.palette.border, hc.palette.window_bg), 4.5);

    // --- Tokens ---
    check("spacing grows", light.metrics.space_xs < light.metrics.space_s && light.metrics.space_s < light.metrics.space_m
          && light.metrics.space_m < light.metrics.space_l && light.metrics.space_l < light.metrics.space_xl);
    check("radii grow", light.metrics.radius_s < light.metrics.radius_m && light.metrics.radius_m < light.metrics.radius_l);
    check("a type scale", light.fonts.caption.size < light.fonts.body.size && light.fonts.body.size < light.fonts.heading.size
          && light.fonts.heading.size < light.fonts.title.size && light.fonts.title.size < light.fonts.large_title.size);
    check("strong is heavier", light.fonts.body_strong.weight > light.fonts.body.weight);
    check("a font family", cast(i64, light.fonts.family) != 0 && cast(i64, light.fonts.mono) != 0);
    check("shadows grow", light.metrics.shadow_s.blur < light.metrics.shadow_m.blur
          && light.metrics.shadow_m.blur < light.metrics.shadow_l.blur);
    check("durations grow", light.motion.fast < light.motion.normal && light.motion.normal < light.motion.slow);
    check("eased as CSS eases", light.motion.ease == math.curve.EASE_CSS);
    check("controls are tall enough to hit", light.metrics.control_height >= 24.0);

    // --- States ---
    let is style.Look as rest = style.pick(&light.control, 0, 0);
    let is style.Look as over = style.pick(&light.control, painter.S_HOVER, 0);
    let is style.Look as down = style.pick(&light.control, painter.S_HOVER | painter.S_PRESSED, 0);
    let is style.Look as off = style.pick(&light.control, painter.S_DISABLED | painter.S_HOVER, 0);
    let is style.Look as on = style.pick(&light.control, 0, 1);
    let is style.Look as away = style.pick(&light.control, painter.S_BACKDROP, 0);
    check("hover differs from rest", same(rest.bg, over.bg) == 0);
    check("pressed differs from hover", same(over.bg, down.bg) == 0);
    check("light: hover darkens", style.luminance(over.bg) < style.luminance(rest.bg));
    check("light: pressed darkens more", style.luminance(down.bg) < style.luminance(over.bg));
    check("disabled wins over hover, and fades", off.fg.a < rest.fg.a && same(off.bg, over.bg) == 0);
    check("checked has its own look", same(on.bg, rest.bg) == 0);
    check("backdrop: text quieter", style.contrast(away.fg, light.palette.window_bg)
          < style.contrast(rest.fg, light.palette.window_bg));
    let is style.Look as dover = style.pick(&dark.control, painter.S_HOVER, 0);
    check("dark: hover lightens", style.luminance(dover.bg) > style.luminance(style.pick(&dark.control, 0, 0).bg));
    check("suggested is the accent", same(style.pick(&light.suggested, 0, 0).bg, light.palette.accent));
    check("destructive is its colour", same(style.pick(&light.destructive, 0, 0).bg, light.palette.destructive));
    check("a selected row is the selection", same(style.pick(&light.row, 0, 1).bg, light.palette.selection_bg));
    let is style.Look as off_rest = style.pick(&light.control, painter.S_DISABLED, 0);
    check("disabled: hover changes nothing", same(off.bg, off_rest.bg));
    check("disabled: the background fades too", off.bg.a < rest.bg.a);
    check("disabled: the border fades too", style.pick(&light.field, painter.S_DISABLED, 0).border.a
          < style.pick(&light.field, 0, 0).border.a);
    let is style.Look as row_rest = style.pick(&light.row, 0, 0);
    let is style.Look as row_away = style.pick(&light.row, painter.S_BACKDROP, 0);
    check("a row has no background of its own", row_rest.bg.a == 0.0);
    check("backdrop on no background: fainter, the same colour", row_away.fg.a < row_rest.fg.a
          && row_away.fg.r == row_rest.fg.r);
    check("a control stands out from the window", same(rest.bg, light.palette.window_bg) == 0);
    check("a focused field's border is the ring's colour", same(style.pick(&light.field, 0, 1).border, light.palette.focus));
    check("an indicator that is on is the accent", same(style.pick(&light.indicator, 0, 1).bg, light.palette.accent));
    check("a track's filled part is the accent", same(style.pick(&light.track, 0, 1).bg, light.palette.accent));
    check("a track stands out from the window", same(style.pick(&light.track, 0, 0).bg, light.palette.window_bg) == 0);
    reacts("control", &light.control);
    reacts("suggested", &light.suggested);
    reacts("destructive", &light.destructive);
    reacts("row", &light.row);
    reacts("indicator", &light.indicator);
    reacts("track", &light.track);
    let is style.Look as hc_rest = style.pick(&hc.control, 0, 0);
    check("high contrast: controls have borders", hc_rest.border.a == 1.0
          && style.contrast(hc_rest.border, hc.palette.window_bg) >= 4.5);
    check("high contrast: a thicker ring", hc.metrics.focus_width > light.metrics.focus_width);

    // --- A palette of the program's own, finished: readable whatever it asked for ---
    let is style.Theme as mine with mut = style.light();
    mine.palette.window_bg = style.hex(0xD0D0D0);
    mine.palette.fg = style.hex(0x777777);
    mine.palette.fg_dim = style.hex(0x999999);
    style.finish(&mine);
    readable("a program's, with a darker window", &mine, 4.5, 3.0);
    mine = style.light();
    mine.palette.card_bg = style.hex(0xD0D0D0);
    mine.palette.fg = style.hex(0x777777);
    style.finish(&mine);
    readable("a program's, with darker cards", &mine, 4.5, 3.0);
    check("a colour made readable keeps its hue", dark.palette.link.b > dark.palette.link.r + 0.1);
    // On mid grey white reaches 4.48 and black 4.68: the text has to go black.
    mine = style.light();
    mine.palette.window_bg = style.hex(0x777777);
    mine.palette.view_bg = style.hex(0x777777);
    mine.palette.card_bg = style.hex(0x777777);
    mine.palette.fg = style.hex(0xFFFFFF);
    style.finish(&mine);
    at_least("text on mid grey: towards whichever reads", style.contrast(mine.palette.fg, mine.palette.window_bg), 4.5);

    // --- Following preferences: dark, contrast, accent, font, text scale, motion ---
    let is style.Prefs as pf with mut = style.prefs_default();
    let is style.Theme as by with mut = style.for_prefs(&pf);
    check("prefs: light by default", by.dark == 0 && by.high_contrast == 0);
    check("prefs: the theme's font by default", by.fonts.family == light.fonts.family
          && by.fonts.body.size == light.fonts.body.size);
    pf.dark = 1;
    by = style.for_prefs(&pf);
    check("prefs: dark", by.dark == 1);
    pf.high_contrast = 1;
    by = style.for_prefs(&pf);
    check("prefs: high contrast, dark", by.high_contrast == 1 && by.dark == 1);
    pf = style.prefs_default();
    pf.has_accent = 1;
    pf.accent = math.color.hex(15027200);   // 0xE54C00, an orange
    by = style.for_prefs(&pf);
    check("accent: taken", same(by.palette.accent, pf.accent));
    check("accent: the ring is it, where it can be seen", same(by.palette.focus, pf.accent));
    check("accent: suggested follows it", same(style.pick(&by.suggested, 0, 0).bg, pf.accent));
    readable("accented", &by, 4.5, 3.0);
    pf.accent = math.color.hex(16776960);   // yellow: white text would be unreadable on it
    by = style.for_prefs(&pf);
    at_least("a light accent gets dark text", style.contrast(by.palette.accent_fg, by.palette.accent), 3.0);
    pf.accent = style.hex(0x8000A0);   // dark: white text
    by = style.for_prefs(&pf);
    check("accent: its text follows it", same(by.palette.accent_fg, style.hex(0xFFFFFF)));
    pf.has_accent = 0;
    by = style.for_prefs(&pf);
    check("accent: only when there is one", same(by.palette.accent, light.palette.accent));
    pf.has_accent = 1;
    pf.accent = style.hexa(0xE54C00, 128);
    by = style.for_prefs(&pf);
    check("accent: opaque, whatever it came with", by.palette.accent.a == 1.0);
    pf.high_contrast = 1;
    by = style.for_prefs(&pf);
    check("high contrast keeps its own accent", same(by.palette.accent, hc.palette.accent));
    pf = style.prefs_default();
    pf.font_family = "Inter";
    pf.mono_family = "Fira Mono";
    pf.font_size = 15.0;
    pf.text_scale = 1.5;
    by = style.for_prefs(&pf);
    check("font: the family", by.fonts.family == pf.font_family && by.fonts.mono == pf.mono_family);
    check("font: body at the size, scaled", by.fonts.body.size == 22.5);
    check("font: the rest in proportion", by.fonts.heading.size > by.fonts.body.size
          && by.fonts.heading.size / by.fonts.body.size == light.fonts.heading.size / light.fonts.body.size);
    pf = style.prefs_default();
    pf.reduce_motion = 1;
    by = style.for_prefs(&pf);
    check("reduced motion: nothing animates", by.motion.reduced == 1 && by.motion.fast == 0
          && by.motion.normal == 0 && by.motion.slow == 0);
    pf = style.prefs_default();
    pf.text_scale = 0.0;
    by = style.for_prefs(&pf);
    check("text scale 0 is none", by.fonts.body.size == light.fonts.body.size);
    pf.text_scale = 1.25;
    by = style.for_prefs(&pf);
    scaled("text scale", &light.fonts, &by.fonts, 1.25);
    let is style.Theme as unsized with mut = style.light();
    unsized.fonts.body.size = 0.0;
    style.with_font(&unsized, cast(*u8, 0), 15.0);
    check("a font size on a theme with none", exactly(unsized.fonts.body.size, 0.0));

    // --- Themes that look like the platforms' ---
    let is style.Theme as adw = style.adwaita(0);
    let is style.Theme as adwd = style.adwaita(1);
    let is style.Theme as brz = style.breeze(0);
    let is style.Theme as brzd = style.breeze(1);
    let is style.Theme as w11 = style.windows11(0);
    let is style.Theme as w11d = style.windows11(1);
    check("adwaita: its blue", same(adw.palette.accent, math.color.hex(3507428)));
    check("adwaita: its window", same(adw.palette.window_bg, math.color.hex(16448250)));
    check("adwaita dark: its window", same(adwd.palette.window_bg, math.color.hex(2368548)));
    check("adwaita: rounded buttons", adw.metrics.radius_m == 6.0);
    check("adwaita: eased out cubically, as libadwaita", adw.motion.ease == math.curve.EASE_OUT_CUBIC);
    check("breeze: in and out quadratically, as Kirigami", brz.motion.ease == math.curve.EASE_IN_OUT_QUAD);
    check("windows 11: Fluent's point to point", w11.motion.ease == math.curve.EASE_FLUENT_POINT);
    check("breeze: its highlight", same(brz.palette.accent, math.color.hex(4042473)));
    check("breeze: its window", same(brz.palette.window_bg, math.color.hex(15724785)));
    check("breeze: noto sans", brz.fonts.family[0] == 78);
    check("windows 11: its accent", same(w11.palette.accent, math.color.hex(24504)));
    check("windows 11 dark: its accent", same(w11d.palette.accent, math.color.hex(6344191)));
    check("windows 11: segoe", w11.fonts.family[0] == 83);
    check("windows 11: four-pixel corners", w11.metrics.radius_m == 4.0);
    check("adwaita: 11 points", adw.fonts.body.size > 14.6 && adw.fonts.body.size < 14.7);
    check("breeze: 10 points", brz.fonts.body.size > 13.3 && brz.fonts.body.size < 13.4);
    readable("adwaita", &adw, 4.5, 3.0);
    readable("adwaita dark", &adwd, 4.5, 3.0);
    readable("breeze", &brz, 4.5, 3.0);
    readable("breeze dark", &brzd, 4.5, 3.0);
    readable("windows 11", &w11, 4.5, 3.0);
    readable("windows 11 dark", &w11d, 4.5, 3.0);

    // --- Overrides: by role, with what depends on them derived again ---
    let is style.Overrides as ov with mut = style.overrides();
    style.override_color(&ov, style.ROLE_ACCENT, math.color.hex(10494192));   // 0xA020F0
    style.override_radius(&ov, 12.0);
    style.override_text_scale(&ov, 2.0);
    let is style.Theme as ot with mut = light;
    style.apply(&ot, &ov);
    check("override: the accent", same(ot.palette.accent, math.color.hex(10494192)));
    check("override: suggested follows", same(style.pick(&ot.suggested, 0, 0).bg, math.color.hex(10494192)));
    check("override: radius", ot.metrics.radius_m == 12.0);
    check("override: text", ot.fonts.body.size == light.fonts.body.size * 2.0);
    check("override: the rest untouched", same(ot.palette.window_bg, light.palette.window_bg));
    check("override: the accent's text follows", same(ot.palette.accent_fg, style.text_on(ot.palette.accent)));
    check("override: the ring follows", same(ot.palette.focus, math.color.hex(10494192)));
    check("override: the other radii in proportion", ot.metrics.radius_s == light.metrics.radius_s * 2.0
          && ot.metrics.radius_l == light.metrics.radius_l * 2.0 && ot.metrics.focus_radius == 12.0);
    scaled("override: text", &light.fonts, &ot.fonts, 2.0);
    let is style.Overrides as ov3 with mut = style.overrides();
    check("override: a role", style.override_color(&ov3, style.ROLE_ACCENT, style.hex(0xFF0000)) == 1);
    style.override_color(&ov3, style.ROLE_ACCENT, style.hex(0x008000));
    check("override: no such role", style.override_color(&ov3, 99, style.hex(0)) == 0
          && style.override_color(&ov3, 0 - 1, style.hex(0)) == 0);
    style.override_color(&ov3, style.ROLE_DESTRUCTIVE, style.hex(0xFFFF00));
    style.override_radius(&ov3, 0.0);
    ot = light;
    style.apply(&ot, &ov3);
    check("override: set twice, the later", same(ot.palette.accent, style.hex(0x008000)));
    at_least("override: destructive's text follows", style.contrast(ot.palette.destructive_fg, ot.palette.destructive), 3.0);
    check("override: destructive buttons follow", same(style.pick(&ot.destructive, 0, 0).bg, style.hex(0xFFFF00)));
    check("override: square corners", ot.metrics.radius_m == 0.0 && ot.metrics.radius_s == 0.0);
    check("override: text untouched", ot.fonts.body.size == light.fonts.body.size);
    // A fresh set of overrides changes nothing, whatever was on the stack.
    let is style.Overrides as none = fresh_overrides();
    ot = light;
    style.apply(&ot, &none);
    check("no overrides, no change", same(ot.palette.window_bg, light.palette.window_bg)
          && same(ot.palette.accent, light.palette.accent) && ot.metrics.radius_m == light.metrics.radius_m);
    // Every role reaches its colour.
    let is style.Overrides as every with mut = style.overrides();
    let is i32 as role with mut = 0;
    while (role < style.ROLE_COUNT) {
        style.override_color(&every, role, style.hex(cast(i64, role + 1) * 0x0A0B0C));
        role = role + 1;
    }
    ot = light;
    style.apply(&ot, &every);
    let is style.Palette as ep = ot.palette;
    check("override: every role", same(ep.window_bg, style.hex(1 * 0x0A0B0C)) && same(ep.view_bg, style.hex(2 * 0x0A0B0C))
          && same(ep.card_bg, style.hex(3 * 0x0A0B0C)) && same(ep.fg, style.hex(4 * 0x0A0B0C))
          && same(ep.fg_dim, style.hex(5 * 0x0A0B0C)) && same(ep.border, style.hex(6 * 0x0A0B0C))
          && same(ep.accent, style.hex(7 * 0x0A0B0C)) && same(ep.destructive, style.hex(8 * 0x0A0B0C))
          && same(ep.success, style.hex(9 * 0x0A0B0C)) && same(ep.warning, style.hex(10 * 0x0A0B0C))
          && same(ep.error, style.hex(11 * 0x0A0B0C)));
    ot = light;
    ot.metrics.radius_m = 0.0;
    let is style.Overrides as ov4 with mut = style.overrides();
    style.override_radius(&ov4, 4.0);
    style.apply(&ot, &ov4);
    check("override: radius from none", ot.metrics.radius_m == 4.0 && ot.metrics.radius_s == light.metrics.radius_s);
    let is style.Overrides as grey_accent with mut = style.overrides();
    style.override_color(&grey_accent, style.ROLE_ACCENT, style.hex(0x808080));
    ot = hc;
    style.apply(&ot, &grey_accent);
    at_least("high contrast, any accent: the selection", style.contrast(ot.palette.selection_fg, ot.palette.selection_bg), 7.0);
    at_least("high contrast, any accent: the ring", style.contrast(ot.palette.focus, ot.palette.window_bg), 4.5);
    check("a selected row is the selection, even moved", same(style.pick(&ot.row, 0, 1).bg, ot.palette.selection_bg));
    // A selection is moved as little as it takes: a darkish accent darker, a
    // lightish one lighter, and neither all the way to black or white.
    style.override_color(&grey_accent, style.ROLE_ACCENT, style.hex(0x666666));
    ot = hc;
    style.apply(&ot, &grey_accent);
    let is f64 as sel_l = style.luminance(ot.palette.selection_bg);
    at_least("a darkish accent: the selection", style.contrast(ot.palette.selection_fg, ot.palette.selection_bg), 7.0);
    check("a darkish accent: selected darker, not black", sel_l < style.luminance(style.hex(0x666666)) && sel_l > 0.05);
    style.override_color(&grey_accent, style.ROLE_ACCENT, style.hex(0x8A8A8A));
    ot = hc;
    style.apply(&ot, &grey_accent);
    let is f64 as sel_l2 = style.luminance(ot.palette.selection_bg);
    at_least("a lightish accent: the selection", style.contrast(ot.palette.selection_fg, ot.palette.selection_bg), 7.0);
    check("a lightish accent: selected lighter, not white", sel_l2 > style.luminance(style.hex(0x8A8A8A)) && sel_l2 < 0.9);

    // --- In the tree: one theme per window, overrides on a subtree ---
    probe_kind = widget.kind("probe", sizeof(Probe));
    probe_kind.paint = fn_ptr(probe_paint);
    probe_kind.measure = fn_ptr(probe_measure);
    probe_kind.arrange = fn_ptr(probe_arrange);
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is i64 as box = tree.create(&t, &probe_kind, root);
    let is i64 as inner = tree.create(&t, &probe_kind, box);
    let is i64 as other = tree.create(&t, &probe_kind, root);
    let is style.Theme as resolved with mut;
    widget.theme(&t, inner, &resolved);
    check("no theme set: the default", same(resolved.palette.accent, style.light().palette.accent));
    layout.run(&t, 32.0, 32.0);
    tree.set_theme(&t, &dark);
    check("a new theme lays out again", tree.needs_layout(&t, inner));
    check("a new theme repaints", tree.needs_paint(&t, inner));
    widget.theme(&t, inner, &resolved);
    check("the tree's theme", resolved.dark == 1);
    layout.run(&t, 32.0, 32.0);
    damage.collect(&t);
    tree.damage_clear(&t);
    tree.set_overrides(&t, box, &ov);
    check("an override lays its subtree out again", tree.needs_layout(&t, inner));
    check("an override repaints its subtree", tree.needs_paint(&t, inner));
    widget.theme(&t, inner, &resolved);
    check("an override reaches the subtree", same(resolved.palette.accent, math.color.hex(10494192)));
    widget.theme(&t, other, &resolved);
    check("and not beyond it", same(resolved.palette.accent, dark.palette.accent));
    let is style.Overrides as ov2 with mut = style.overrides();
    style.override_color(&ov2, style.ROLE_ACCENT, math.color.hex(65280));
    tree.set_overrides(&t, inner, &ov2);
    widget.theme(&t, inner, &resolved);
    check("the nearest override wins", same(resolved.palette.accent, math.color.hex(65280)));
    check("an outer override still applies under it", resolved.metrics.radius_m == 12.0
          && resolved.fonts.body.size == dark.fonts.body.size * 2.0);

    // Painting hands each widget its own resolved theme.
    let is gpu.device.Device as dv = gpu.open_headless(32, 32, gpu.SOFTWARE);
    let is draw2d.Limits as dl = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &dl);
    layout.run(&t, 32.0, 32.0);
    damage.collect(&t);
    draw2d.begin(&c, 32.0, 32.0, 1.0);
    let is paint.Options as o = paint.options(cast(*style.Theme, 0));
    paint.frame(&t, &c, &o, cast(*paint.Stats, 0));
    tree.damage_clear(&t);
    check("painted: the override", same(cast(*Probe, tree.data(&t, box)).seen, math.color.hex(10494192)));
    check("painted: the nearer override", same(cast(*Probe, tree.data(&t, inner)).seen, math.color.hex(65280)));
    check("painted: the outer override under it", cast(*Probe, tree.data(&t, inner)).size == dark.fonts.body.size * 2.0);
    check("painted: the window's theme", same(cast(*Probe, tree.data(&t, other)).seen, dark.palette.accent));
    // Painted into a cache, the override is laid on once, not twice.
    let is paint.Cache as cc = paint.cache_open(&dv, &dl);
    o.cache = &cc;
    tree.set_flag(&t, box, tree.F_CACHE, 1);
    tree.invalidate_paint_subtree(&t, root);
    cast(*Probe, tree.data(&t, box)).size = 0.0;
    layout.run(&t, 32.0, 32.0);
    damage.collect(&t);
    draw2d.begin(&c, 32.0, 32.0, 1.0);
    let is paint.Stats as pst;
    paint.frame(&t, &c, &o, &pst);
    tree.damage_clear(&t);
    check("cached: painted through the cache", pst.cache_renders == 1);
    check("cached: the override once", cast(*Probe, tree.data(&t, box)).size == dark.fonts.body.size * 2.0);
    paint.cache_close(&cc);
    draw2d.close(&c);
    gpu.close(&dv);
    tree.close(&t);

    // A widget made in a destroyed one's slot has none of its overrides.
    let is tree.Limits as small with mut = tree.limits_default();
    small.widgets = 2;
    let is tree.Tree as t2 = tree.open(&small);
    let is i64 as gone = tree.create(&t2, &probe_kind, tree.root(&t2));
    tree.set_overrides(&t2, gone, &ov2);
    tree.destroy(&t2, gone);
    let is i64 as fresh = tree.create(&t2, &probe_kind, tree.root(&t2));
    check("a slot used again", fresh != 0);
    check("a new widget: no overrides", cast(i64, tree.overrides(&t2, fresh)) == 0);
    tree.close(&t2);

    // --- The application: one theme, every window, switched at run time ---
    let is app.Limits as al = app.limits_default();
    let is app.App as a = app.open(&al);
    check("app: starts light", same(app.theme(&a).palette.window_bg, light.palette.window_bg));
    let is i64 as w1 = app.window_open(&a, 100.0, 100.0);
    let is i64 as w2 = app.window_open(&a, 100.0, 100.0);
    check("app: windows start with its theme", same(tree.theme(app.tree(&a, w1)).palette.window_bg,
                                                   app.theme(&a).palette.window_bg));
    app.frame(&a, w1);
    app.frame(&a, w2);
    tree.damage_clear(app.tree(&a, w1));
    tree.damage_clear(app.tree(&a, w2));
    app.set_theme(&a, &hcd);
    check("app: switched in every window", tree.theme(app.tree(&a, w1)).high_contrast == 1
          && tree.theme(app.tree(&a, w2)).high_contrast == 1);
    check("app: every window repaints", app.needs_frame(&a, w1) == 1 && app.needs_frame(&a, w2) == 1);
    app.frame(&a, w1);
    tree.damage_clear(app.tree(&a, w1));
    pf = style.prefs_default();
    pf.dark = 1;
    app.set_prefs(&a, &pf);
    check("app: preferences repaint", app.needs_frame(&a, w1) == 1);
    check("app: from preferences", app.theme(&a).dark == 1 && app.theme(&a).high_contrast == 0);
    let is i64 as w3 = app.window_open(&a, 100.0, 100.0);
    check("app: a later window takes it too", tree.theme(app.tree(&a, w3)).dark == 1);
    app.close(&a);
    app.set_theme(&a, &dark);
    app.set_prefs(&a, &pf);
    check("app: closed, no theme", cast(i64, app.theme(&a)) == 0);

    if (fails > 0) {
        io.printf("style: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("style: all checks passed\n");
    return 0;
}
