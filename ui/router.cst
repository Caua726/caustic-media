// ui/router.cst — where each event goes.
//
// input/ (or a test) calls in with what the platform reported — the pointer
// moved, a button went down, a key — and the router turns it into events for
// widgets. One router per window, beside its tree.
//
// Pointer events are aimed at the deepest visible widget under the pointer and
// BUBBLE: the target gets the event first, then its parent, and so on up until
// one handles it. Whoever handles a press CAPTURES the pointer until the last
// button is released: every motion and the release go to the captor alone,
// wherever the pointer is, so a slider dragged off its track keeps following,
// and nothing enters or leaves meanwhile. A press nobody handles captures
// nothing.
//
// Entering and leaving are per widget, not per target: moving from a child to
// its parent leaves the child and does not leave the parent. The router keeps
// the chain of widgets under the pointer, root first, and compares chains —
// which also keeps working when a widget in the chain is destroyed, since its
// ancestors are still in the chain to compare against.
//
// A disabled widget swallows what is aimed at it: nothing reaches it, and
// nothing bubbles past it to a container that might react instead.
//
// Times are the platform's, in milliseconds; distances are logical pixels.
// Double-click time and distance and the drag threshold come from Settings,
// which the window fills from the system's own values.
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "layout.cst" as layout;
use "event.cst" as event;
use "signal.cst" as signal;
use "dnd.cst" as dnd;
use "../window/keys.cst" as keys;

// Deepest tree the hover chain follows. Past it, the innermost widgets are
// still hit and still receive events; they just do not get ENTER and LEAVE.
let is i64 as MAX_DEPTH with imut = 128;

// The window's shortcuts and the widgets' mnemonics are fixed tables, sized
// here: a window rarely has a few dozen of either, and a table that grows on
// its own is the hidden allocation the philosophy forbids. Adding past the end
// returns 0.
let is i64 as MAX_SHORTCUTS with imut = 64;
let is i64 as MAX_MNEMONICS with imut = 128;

// What a shortcut runs: cb(user), synchronously.
type ShortcutFn = fn(*u8) as void;

// A key combination and what to run for it.
struct Shortcut {
    key   as i32;   // lowercase for letters; 0 for a free slot
    mods  as i32;
    cb    as ShortcutFn;
    user  as *u8;
    owner as i64;   // the widget it is for; 0 for the window's
}

// What the pointer is, as the platform says; input/ sets it before each event.
let is i32 as MOUSE with imut = 0;
let is i32 as TOUCH with imut = 1;
let is i32 as PEN   with imut = 2;

struct Settings {
    double_click_ms       as i64;
    double_click_distance as f64;
    drag_threshold        as f64;
    // Windows opens a context menu when the right button comes up; GTK and Qt
    // on X11 and Wayland, when it goes down.
    context_on_release    as i32;
    // A long press opens it on a touch screen and with a pen; with a mouse only
    // when this is 1 — desktops have a right button for it.
    long_press_mouse      as i32;
    long_press_ms         as i64;   // how long a press is held still; 0 is never
    // One whole on-and-off cycle of a text caret's blink; 0 for a caret that
    // does not blink. Kept here with the other timings the desktop sets.
    caret_blink_ms        as i64;
    // How long after the last input it goes on blinking before it stays on,
    // as GTK's does; 0 for ever.
    caret_blink_timeout_ms as i64;
    tooltip_ms            as i64;   // the pointer held over a widget this long shows its tip
}

fn settings_default() as Settings {
    let is Settings as s;
    s.double_click_ms = 400;
    s.double_click_distance = 4.0;
    s.drag_threshold = 8.0;
    s.context_on_release = 0;
    s.long_press_mouse = 0;
    s.long_press_ms = 500;
    s.caret_blink_ms = 1200;
    s.caret_blink_timeout_ms = 10000;
    s.tooltip_ms = 500;
    return s;
}

struct Router {
    settings        as Settings;
    chain           as [128]i64;   // under the pointer, root first
    chain_n         as i64;
    capture         as i64;
    buttons         as i32;        // held, one bit per button
    dragging        as i32;
    mods            as i32;        // as of the last key event
    pointer_in      as i32;
    pointer_x       as f64;
    pointer_y       as f64;
    press_x         as f64;
    press_y         as f64;
    clicks          as i32;
    last_button     as i32;
    last_click_time as i64;
    last_click_x    as f64;
    last_click_y    as f64;
    focus           as i64;
    focus_visible   as i32;        // focus last moved by keyboard
    _pad1           as i32;
    scope           as i64;        // modal subtree, 0 for none
    scope_also      as i64;        // a subtree outside it let through too, 0 for none
    source          as i32;        // MOUSE, TOUCH or PEN: what the pointer is
    lp_armed        as i32;        // a long press is pending
    lp_due          as i64;
    lp_x            as f64;
    lp_y            as f64;
    swallow         as i32;        // the next release follows a long press: no click
    _pad2           as i32;
    inputs          as i64;        // presses and key presses so far
    now             as i64;        // the time of the last event or tick
    blink_from      as i64;        // the caret's blink started again then
    blinking        as i32;        // something takes typing: tree.text_area
    spent           as i32;        // the press held landed outside the scope: no menu from it
    shortcuts       as [64]Shortcut;
    mnemonic_w      as [128]i64;   // widget, 0 for a free slot
    mnemonic_key    as [128]i32;
    // A drag over the window (see Dragging): one a widget here began, run from
    // the pointer, or one from outside, told by the platform's loop.
    drag            as dnd.Payload;
    drag_on         as i32;
    drag_own        as i32;        // begun here, by drag_src
    drag_src        as i64;
    drag_to         as i64;        // what takes it where it is, 0 for nothing
    drag_takes      as i32;        // what drag_to takes of what it offers
    drag_by_table   as i32;        // drag_to took it as a drop target of the program's
    drag_x          as f64;
    drag_y          as f64;
    drop_w          as [16]i64;    // the program's drop targets; 0 for a free slot
    drop_offers     as [16]i32;
}

let is i64 as MAX_DROP_TARGETS with imut = 16;

fn init(s as Settings) as Router {
    let is Router as r;
    r.settings = s;
    r.chain_n = 0;
    r.capture = 0;
    r.buttons = 0;
    r.dragging = 0;
    r.mods = 0;
    r.pointer_in = 0;
    r.pointer_x = 0.0;
    r.pointer_y = 0.0;
    r.press_x = 0.0;
    r.press_y = 0.0;
    r.clicks = 0;
    r.last_button = 0;
    r.last_click_time = 0 - 1000000000;
    r.last_click_x = 0.0;
    r.last_click_y = 0.0;
    r.focus = 0;
    r.focus_visible = 0;
    r._pad1 = 0;
    r.scope = 0;
    r.scope_also = 0;
    r.source = MOUSE;
    r.lp_armed = 0;
    r.lp_due = 0;
    r.lp_x = 0.0;
    r.lp_y = 0.0;
    r.swallow = 0;
    r._pad2 = 0;
    r.inputs = 0;
    r.now = 0;
    r.blink_from = 0;
    r.blinking = 0;
    r.spent = 0;
    let is i64 as i with mut = 0;
    while (i < MAX_SHORTCUTS) {
        r.shortcuts[i].key = 0;
        r.shortcuts[i].mods = 0;
        r.shortcuts[i].cb = cast(ShortcutFn, 0);
        r.shortcuts[i].user = cast(*u8, 0);
        i = i + 1;
    }
    i = 0;
    while (i < MAX_MNEMONICS) {
        r.mnemonic_w[i] = 0;
        r.mnemonic_key[i] = 0;
        i = i + 1;
    }
    r.drag = dnd.text(cast(*u8, 0), 0, 0);
    r.drag.offers = 0;
    r.drag_on = 0;
    r.drag_own = 0;
    r.drag_src = 0;
    r.drag_to = 0;
    r.drag_takes = 0;
    r.drag_by_table = 0;
    r.drag_x = 0.0;
    r.drag_y = 0.0;
    i = 0;
    while (i < MAX_DROP_TARGETS) {
        r.drop_w[i] = 0;
        r.drop_offers[i] = 0;
        i = i + 1;
    }
    return r;
}

// --- Hit-testing ---

// The deepest visible widget containing the point, searching children last to
// first because later children are drawn above earlier ones. A child is only
// searched inside its parent, so what a container clips away cannot be hit,
// and a widget whose kind claims the point (its hit entry) keeps it from its
// children. A widget on a higher layer is drawn above the rest and outside its
// parent's clip, so it is looked for first. 0 outside the window.
fn hit(t as *tree.Tree, x as f64, y as f64) as i64 {
    let is i64 as root = tree.root(t);
    let is math.rect.Rect as rr = layout.rect(t, root);
    if (x < 0.0 || y < 0.0 || x >= rr.w || y >= rr.h) { return 0; }
    if (tree.layered_count(t) > 0) {
        let is Layered as best;
        best.w = 0;
        best.layer = 0;
        _find_layered(t, root, 0.0, 0.0, 0, x, y, &best);
        if (best.w != 0) { return _descend(t, best.w, best.ox, best.oy, x, y); }
    }
    return _descend(t, root, 0.0, 0.0, x, y);
}

// The topmost layered widget under the point: the highest layer, and of
// those the last in tree order, which is the last drawn.
struct Layered {
    w     as i64;
    layer as i64;
    ox    as f64;
    oy    as f64;
}

fn _find_layered(t as *tree.Tree, w as i64, ox as f64, oy as f64, eff as i64,
                 x as f64, y as f64, best as *Layered) as void {
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        if (tree.is_hidden_here(t, ch) == 0) {
            let is math.rect.Rect as cr = layout.visual_rect(t, ch);
            let is f64 as cx = ox + cr.x;
            let is f64 as cy = oy + cr.y;
            let is i64 as cl = tree.layer(t, ch);
            let is i64 as ce with mut = eff;
            if (cl > eff) {
                ce = cl;
                if (x >= cx && x < cx + cr.w && y >= cy && y < cy + cr.h && cl >= best.layer) {
                    best.w = ch;
                    best.layer = cl;
                    best.ox = cx;
                    best.oy = cy;
                }
            }
            _find_layered(t, ch, cx, cy, ce, x, y, best);
        }
        ch = tree.next_sibling(t, ch);
    }
}

// Down from top, at window position ox0, oy0, to the deepest widget under the
// point. A layered child it passes through cannot be under the point: the
// layered search would have found it, or one above it, first.
fn _descend(t as *tree.Tree, top as i64, ox0 as f64, oy0 as f64, x as f64, y as f64) as i64 {
    let is i64 as root = tree.root(t);
    let is i64 as cur with mut = top;
    let is f64 as ox with mut = ox0;
    let is f64 as oy with mut = oy0;
    while (1 == 1) {
        if (cur != root) {
            let is *tree.Kind as k = tree.kind(t, cur);
            if (cast(i64, k.hit) != 0) {
                let is math.vec.Vec2 as p = math.vec.v2(x - ox, y - oy);
                if (call(k.hit, t, cur, tree.data(t, cur), &p) == 1) { return cur; }
            }
        }
        let is i64 as found with mut = 0;
        let is i64 as ch with mut = tree.last_child(t, cur);
        while (ch != 0 && found == 0) {
            if (tree.is_visible(t, ch) == 1) {
                let is math.rect.Rect as cr = layout.visual_rect(t, ch);
                let is f64 as cx = ox + cr.x;
                let is f64 as cy = oy + cr.y;
                if (x >= cx && x < cx + cr.w && y >= cy && y < cy + cr.h) {
                    found = ch;
                    ox = cx;
                    oy = cy;
                }
            }
            ch = tree.prev_sibling(t, ch);
        }
        if (found == 0) { return cur; }
        cur = found;
    }
    return cur;
}

// --- Delivering ---

// Hands e to one widget, in that widget's coordinates. 1 if it handled it.
// The root belongs to the tree and has no behaviour; a widget without an
// event entry handles nothing.
fn _deliver(t as *tree.Tree, w as i64, e as *event.Event) as i64 {
    if (w == 0 || w == tree.root(t) || tree.is_valid(t, w) == 0) { return 0; }
    let is *tree.Kind as k = tree.kind(t, w);
    if (cast(i64, k.event) == 0) { return 0; }
    let is math.rect.Rect as wr = layout.window_rect(t, w);
    e.local_x = e.x - wr.x;
    e.local_y = e.y - wr.y;
    return call(k.event, t, w, tree.data(t, w), e);
}

// To one widget only, at TARGET — entering, leaving, the captor's events.
fn _direct(t as *tree.Tree, w as i64, e as *event.Event) as i64 {
    if (tree.is_valid(t, w) == 0 || tree.is_enabled(t, w) == 0) { return 0; }
    e.target = w;
    e.phase = event.TARGET;
    return _deliver(t, w, e);
}

// Up the tree from start until someone handles e. Returns who did, or 0.
fn _dispatch(t as *tree.Tree, e as *event.Event, start as i64) as i64 {
    if (start == 0 || tree.is_valid(t, start) == 0) { return 0; }
    if (tree.is_enabled(t, start) == 0) { return 0; }
    e.target = start;
    let is i64 as cur with mut = start;
    while (cur != 0) {
        e.phase = event.BUBBLE;
        if (cur == start) { e.phase = event.TARGET; }
        if (_deliver(t, cur, e) == 1) { return cur; }
        cur = tree.parent(t, cur);
    }
    return 0;
}

// --- Hover ---

fn _in(list as *i64, n as i64, w as i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (list[i] == w) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Leaves what is no longer under the pointer, innermost first; enters what
// newly is, outermost first. w is the new deepest widget, 0 for none.
fn _update_hover(t as *tree.Tree, r as *Router, w as i64, time as i64) as void {
    let is [128]i64 as next;
    let is i64 as n with mut = 0;
    if (w != 0) {
        // The chain from w up, then reversed so the root comes first.
        let is [128]i64 as up;
        let is i64 as a with mut = w;
        while (a != 0) {
            if (n < MAX_DEPTH) { up[n] = a; n = n + 1; }
            a = tree.parent(t, a);
        }
        let is i64 as i with mut = 0;
        while (i < n) { next[i] = up[n - 1 - i]; i = i + 1; }
    }

    let is i64 as old_deepest with mut = 0;
    if (r.chain_n > 0) { old_deepest = r.chain[r.chain_n - 1]; }
    let is i64 as k with mut = r.chain_n - 1;
    while (k >= 0) {
        let is i64 as h = r.chain[k];
        if (_in(cast(*i64, &next), n, h) == 0) {
            tree.invalidate_paint(t, h);
            let is event.Event as e = event.make(event.POINTER_LEAVE, time);
            e.x = r.pointer_x;
            e.y = r.pointer_y;
            e.related = w;
            _direct(t, h, &e);
        }
        k = k - 1;
    }
    k = 0;
    while (k < n) {
        let is i64 as h = next[k];
        if (_in(cast(*i64, &r.chain), r.chain_n, h) == 0) {
            tree.invalidate_paint(t, h);
            let is event.Event as e = event.make(event.POINTER_ENTER, time);
            e.x = r.pointer_x;
            e.y = r.pointer_y;
            e.related = old_deepest;
            _direct(t, h, &e);
        }
        k = k + 1;
    }
    k = 0;
    while (k < n) { r.chain[k] = next[k]; k = k + 1; }
    r.chain_n = n;
}

// How many presses and key presses have come so far: what changes when the
// user does something, for a tooltip to go away on.
fn inputs(r as *Router) as i64 { return r.inputs; }

// The deepest widget under the pointer, 0 for none.
fn hover(r as *Router) as i64 {
    if (r.chain_n == 0) { return 0; }
    return r.chain[r.chain_n - 1];
}

// Whether w is under the pointer — itself or through a descendant.
fn hovered(t as *tree.Tree, r as *Router, w as i64) as i32 {
    if (w == 0 || tree.is_valid(t, w) == 0) { return 0; }
    return _in(cast(*i64, &r.chain), r.chain_n, w);
}

// The widget holding the pointer, 0 for none.
fn capture(r as *Router) as i64 { return r.capture; }

// For when widgets moved under a pointer that did not: after a layout pass, a
// scroll, a widget shown or hidden.
fn refresh_hover(t as *tree.Tree, r as *Router, time as i64) as void {
    if (r.pointer_in == 0 || r.capture != 0) { return; }
    _update_hover(t, r, _hit_scoped(t, r, r.pointer_x, r.pointer_y), time);
}

fn _captor(t as *tree.Tree, r as *Router) as i64 {
    if (r.capture != 0 && tree.is_valid(t, r.capture) == 0) {
        // Destroyed mid-gesture: the gesture is over.
        r.capture = 0;
        r.dragging = 0;
    }
    return r.capture;
}

// --- From the platform ---

// The focus a widget asked for while an event was delivered
// (tree.request_focus), given now — by keyboard or by pointer as the event
// was — when it can be taken.
fn _requested(t as *tree.Tree, r as *Router, by_keyboard as i32) as void {
    let is i64 as w = tree.take_focus_request(t);
    if (w != 0) { focus(t, r, w, by_keyboard); }
}

fn pointer_move(t as *tree.Tree, r as *Router, x as f64, y as f64, time as i64) as void {
    r.now = time;
    _pointer_move(t, r, x, y, time);
    _requested(t, r, 0);
}

fn _pointer_move(t as *tree.Tree, r as *Router, x as f64, y as f64, time as i64) as void {
    r.pointer_x = x;
    r.pointer_y = y;
    r.pointer_in = 1;
    if (r.lp_armed == 1) {
        let is f64 as lx = x - r.lp_x;
        let is f64 as ly = y - r.lp_y;
        let is f64 as th = r.settings.drag_threshold;
        if (lx * lx + ly * ly > th * th) { r.lp_armed = 0; }
    }
    // A drag begun here goes where the pointer goes.
    if (r.drag_on == 1 && r.drag_own == 1) {
        r.drag_x = x;
        r.drag_y = y;
        _drag_over(t, r, time);
        return;
    }
    let is i64 as captor = _captor(t, r);
    if (captor != 0) {
        if (r.buttons != 0 && r.dragging == 0) {
            let is f64 as ddx = x - r.press_x;
            let is f64 as ddy = y - r.press_y;
            let is f64 as th = r.settings.drag_threshold;
            if (ddx * ddx + ddy * ddy > th * th) {
                r.dragging = 1;
                let is event.Event as ds = event.make(event.DRAG_START, time);
                ds.x = x;
                ds.y = y;
                ds.mods = r.mods;
                _direct(t, captor, &ds);
                // It began a drag: the pointer is the drag's from here.
                if (r.drag_on == 1 && r.drag_own == 1) { return; }
            }
        }
        let is event.Event as e = event.make(event.POINTER_MOVE, time);
        e.x = x;
        e.y = y;
        e.mods = r.mods;
        _direct(t, captor, &e);
        return;
    }
    _update_hover(t, r, _hit_scoped(t, r, x, y), time);
    let is event.Event as e = event.make(event.POINTER_MOVE, time);
    e.x = x;
    e.y = y;
    e.mods = r.mods;
    if (r.scope != 0 && hover(r) == 0) {
        // Outside a modal scope: only the scope hears of it — a menu bar's
        // open menu, for the pointer reaching another of its titles.
        e.kind = event.MOVE_OUTSIDE;
        _direct(t, r.scope, &e);
        return;
    }
    _dispatch(t, &e, hover(r));
}

// The pointer's shape where it is, for the window to show: asked of the
// widget holding a press, wherever the pointer went, or else of the deepest
// one under it, then up the tree until one has a shape of its own. What is
// disabled has none — a shape says what can be done there. The default
// outside the window and outside a modal scope.
fn pointer_shape(t as *tree.Tree, r as *Router) as i32 {
    // Dragging from here: whether it can be let go here, and as what.
    if (r.drag_on == 1 && r.drag_own == 1) {
        if (r.drag_to == 0) { return tree.SHAPE_NO_DROP; }
        if (_action(r) == dnd.COPY) { return tree.SHAPE_COPY; }
        return tree.SHAPE_MOVE;
    }
    if (r.pointer_in == 0) { return tree.SHAPE_DEFAULT; }
    let is i64 as w with mut = _captor(t, r);
    if (w == 0) { w = _hit_scoped(t, r, r.pointer_x, r.pointer_y); }
    while (w != 0) {
        let is *tree.Kind as k = tree.kind(t, w);
        if (cast(i64, k.shape) != 0 && tree.is_enabled(t, w) == 1) {
            let is math.rect.Rect as wr = layout.window_rect(t, w);
            let is math.vec.Vec2 as p = math.vec.v2(r.pointer_x - wr.x, r.pointer_y - wr.y);
            let is i32 as s = call(k.shape, t, w, tree.data(t, w), &p);
            if (s != tree.SHAPE_INHERIT) { return s; }
        }
        w = tree.parent(t, w);
    }
    return tree.SHAPE_DEFAULT;
}

// The pointer left the window. While a button is held the captor keeps the
// pointer — the platform goes on reporting motion outside — so nothing leaves
// until the release.
fn pointer_leave(t as *tree.Tree, r as *Router, time as i64) as void {
    r.pointer_in = 0;
    if (_captor(t, r) != 0) { return; }
    _update_hover(t, r, 0, time);
}

fn _context(t as *tree.Tree, r as *Router, x as f64, y as f64, time as i64) as void {
    let is event.Event as e = event.make(event.CONTEXT_MENU, time);
    e.x = x;
    e.y = y;
    e.button = 3;
    e.mods = r.mods;
    _dispatch(t, &e, _hit_scoped(t, r, x, y));
}

// button is 1 left, 2 middle, 3 right; pressed is 1 down, 0 up.
fn pointer_button(t as *tree.Tree, r as *Router, button as i32, pressed as i32,
                  x as f64, y as f64, time as i64) as void {
    r.now = time;
    _pointer_button(t, r, button, pressed, x, y, time);
    _requested(t, r, 0);
    if (pressed == 1) { _awake(t, r, time); }
}

fn _pointer_button(t as *tree.Tree, r as *Router, button as i32, pressed as i32,
                   x as f64, y as f64, time as i64) as void {
    if (pressed == 1) { r.inputs = r.inputs + 1; }
    r.pointer_x = x;
    r.pointer_y = y;
    r.pointer_in = 1;
    let is i32 as bit = 1 << cast(i32, button - 1);

    if (pressed == 1) {
        // Another click of the same button, soon enough and close enough to
        // the last, counts up to three; a fourth starts again at one.
        let is f64 as ddx = x - r.last_click_x;
        let is f64 as ddy = y - r.last_click_y;
        let is f64 as near = r.settings.double_click_distance;
        if (button == r.last_button && time - r.last_click_time <= r.settings.double_click_ms
            && ddx * ddx + ddy * ddy <= near * near && r.clicks < 3) {
            r.clicks = r.clicks + 1;
        } else {
            r.clicks = 1;
        }
        r.last_button = button;
        r.last_click_time = time;
        r.last_click_x = x;
        r.last_click_y = y;

        // The primary button held still is a long press — from a finger or a
        // pen, or a mouse when the settings ask. Any other press disarms it.
        r.lp_armed = 0;
        if (button == 1 && r.settings.long_press_ms > 0
            && (r.source != MOUSE || r.settings.long_press_mouse == 1)) {
            r.lp_armed = 1;
            r.lp_due = time + r.settings.long_press_ms;
            r.lp_x = x;
            r.lp_y = y;
        }

        let is event.Event as e = event.make(event.POINTER_DOWN, time);
        e.x = x;
        e.y = y;
        e.button = button;
        e.clicks = r.clicks;
        e.mods = r.mods;
        let is i64 as captor = _captor(t, r);
        if (captor != 0) {
            _direct(t, captor, &e);
        } else {
            let is i64 as target = _hit_scoped(t, r, x, y);
            r.spent = 0;
            if (r.scope != 0 && target == 0) {
                // Outside a modal scope the press goes nowhere, but the
                // scope hears of it — a popup closes, as GTK's do, the
                // press spent on closing it, opening no menu either.
                r.spent = 1;
                let is event.Event as out = event.make(event.PRESS_OUTSIDE, time);
                out.x = x;
                out.y = y;
                out.button = button;
                out.mods = r.mods;
                _direct(t, r.scope, &out);
            }
            _update_hover(t, r, target, time);
            // A click moves focus to the nearest widget that can take it, and
            // hides the focus ring: it is for whoever is using the keyboard.
            r.focus_visible = 0;
            let is i64 as f = _focusable_from(t, r, target);
            if (f != 0) { focus(t, r, f, 0); }
            r.capture = _dispatch(t, &e, target);
            tree.invalidate_paint(t, r.capture);
            r.press_x = x;
            r.press_y = y;
            r.dragging = 0;
        }
        r.buttons = r.buttons | bit;
        if (button == 3 && r.settings.context_on_release == 0 && r.spent == 0) { _context(t, r, x, y, time); }
        return;
    }

    r.buttons = (r.buttons | bit) - bit;
    r.lp_armed = 0;
    // Let go: a drag begun here is dropped where it is.
    if (r.drag_on == 1 && r.drag_own == 1 && r.buttons == 0) {
        r.drag_x = x;
        r.drag_y = y;
        _drag_over(t, r, time);
        _end(t, r, _drop(t, r, time), time);
        r.capture = 0;
        r.dragging = 0;
        r.spent = 0;
        if (r.pointer_in == 1) { _update_hover(t, r, _hit_scoped(t, r, x, y), time); }
        return;
    }
    if (r.swallow == 1 && button == 1) {
        // The long press already answered this press with a menu.
        r.swallow = 0;
        if (r.buttons == 0) {
            r.capture = 0;
            r.dragging = 0;
            if (r.pointer_in == 1) { _update_hover(t, r, _hit_scoped(t, r, x, y), time); }
        }
        return;
    }
    let is event.Event as e = event.make(event.POINTER_UP, time);
    e.x = x;
    e.y = y;
    e.button = button;
    e.mods = r.mods;
    let is i64 as captor = _captor(t, r);
    if (captor != 0) {
        _direct(t, captor, &e);
    } else {
        _dispatch(t, &e, _hit_scoped(t, r, x, y));
    }
    if (r.buttons == 0) {
        tree.invalidate_paint(t, r.capture);
        r.capture = 0;
        r.dragging = 0;
        // The hover catches up with wherever the pointer went meanwhile.
        if (r.pointer_in == 1) { _update_hover(t, r, _hit_scoped(t, r, x, y), time); }
    }
    if (button == 3 && r.settings.context_on_release == 1 && r.spent == 0) { _context(t, r, x, y, time); }
    if (r.buttons == 0) { r.spent = 0; }
}

// dx, dy: how far, in logical pixels, or in notches when discrete is 1.
// To the widget under the pointer, bubbling, so an inner scroll area that is
// already at its end can leave the rest to an outer one. Unlike a press, it
// goes on past a disabled widget to what holds it, as GTK has it: a disabled
// control inside a scrolled view must not stop the view.
fn scroll(t as *tree.Tree, r as *Router, x as f64, y as f64, dx as f64, dy as f64,
          discrete as i32, time as i64) as void {
    r.now = time;
    r.pointer_x = x;
    r.pointer_y = y;
    r.pointer_in = 1;
    let is i64 as target = _hit_scoped(t, r, x, y);
    if (_captor(t, r) == 0) { _update_hover(t, r, target, time); }
    let is i64 as start with mut = target;
    while (start != 0 && tree.is_enabled(t, start) == 0) { start = tree.parent(t, start); }
    let is event.Event as e = event.make(event.SCROLL, time);
    e.x = x;
    e.y = y;
    e.dx = dx;
    e.dy = dy;
    e.discrete = discrete;
    e.mods = r.mods;
    _dispatch(t, &e, start);
}

// The fingers that were scrolling lifted — Wayland's axis_stop. Where they
// were, bubbling and past what is disabled as a scroll is, for whatever was
// scrolling to carry on with the speed it had: a fling.
fn scroll_end(t as *tree.Tree, r as *Router, x as f64, y as f64, time as i64) as void {
    r.now = time;
    let is i64 as start with mut = _hit_scoped(t, r, x, y);
    while (start != 0 && tree.is_enabled(t, start) == 0) { start = tree.parent(t, start); }
    let is event.Event as e = event.make(event.SCROLL_END, time);
    e.x = x;
    e.y = y;
    e.mods = r.mods;
    _dispatch(t, &e, start);
}

// What a held pointer is over moved, the pointer did not — a scroll area
// following a drag past its edge: the widget holding it hears a move where
// the pointer is, as if it had moved there.
fn repeat_move(t as *tree.Tree, r as *Router, time as i64) as void {
    if (_captor(t, r) == 0 || r.buttons == 0) { return; }
    _pointer_move(t, r, r.pointer_x, r.pointer_y, time);
}

// --- Long press ---

fn set_source(r as *Router, source as i32) as void { r.source = source; }

// When a pending long press is due, or -1 — for the loop to wake by, since
// nothing arrives while a finger is held still.
fn next_due(r as *Router) as i64 {
    let is i64 as best with mut = 0 - 1;
    if (r.lp_armed == 1) { best = r.lp_due; }
    let is i64 as b = _blink_due(r);
    if (b >= 0 && (best < 0 || b < best)) { best = b; }
    return best;
}

// Fires a long press due by now: the widget that captured the press hears
// POINTER_CANCEL and loses the pointer, since what it was pressed for is not
// happening, and CONTEXT_MENU goes where the press was, bubbling, with button
// 1. The release that follows is eaten. Returns 1 if it fired.
fn tick(t as *tree.Tree, r as *Router, now as i64) as i32 {
    let is i32 as ran with mut = 0;
    let is i64 as due = _blink_due(r);
    r.now = now;
    if (due >= 0 && now >= due) {
        tree.invalidate_paint(t, tree.text_area(t));
        ran = 1;
    }
    r.blinking = cast(i32, tree.text_area(t) != 0);
    return ran | _long_press(t, r, now);
}

fn _long_press(t as *tree.Tree, r as *Router, now as i64) as i32 {
    if (r.lp_armed == 0 || now < r.lp_due) { return 0; }
    r.lp_armed = 0;
    r.swallow = 1;
    let is i64 as captor = _captor(t, r);
    if (captor != 0) {
        let is event.Event as c = event.make(event.POINTER_CANCEL, now);
        c.x = r.lp_x;
        c.y = r.lp_y;
        _direct(t, captor, &c);
        r.capture = 0;
        r.dragging = 0;
    }
    let is event.Event as e = event.make(event.CONTEXT_MENU, now);
    e.x = r.lp_x;
    e.y = r.lp_y;
    e.button = 1;
    e.mods = r.mods;
    _dispatch(t, &e, _hit_scoped(t, r, r.lp_x, r.lp_y));
    return 1;
}

// --- The caret's blink ---
//
// A text caret is on for two thirds of the desktop's cycle and off for the
// rest, as GTK draws it, counted from the last input — each key, text,
// composition, paste and press, and each change of focus, starts it again
// on. A while after the last (caret_blink_timeout_ms) it stays on: a caret
// blinking in a window nobody types into would keep the machine awake. The
// router says when it next changes (next_due) and, ticked then, asks for
// the widget typed into (tree.text_area) to be drawn again; painting asks
// caret_off for the frame's time, and widgets hear it as S_CARET_OFF.

fn _awake(t as *tree.Tree, r as *Router, time as i64) as void {
    r.blink_from = time;
    r.blinking = cast(i32, tree.text_area(t) != 0);
}

// Whether a caret is off at time now.
fn caret_off(r as *Router, now as i64) as i32 {
    let is i64 as p = r.settings.caret_blink_ms;
    if (p <= 0 || r.blinking == 0) { return 0; }
    let is i64 as el = now - r.blink_from;
    let is i64 as limit = r.settings.caret_blink_timeout_ms;
    if (el < 0 || (limit > 0 && el >= limit)) { return 0; }
    return cast(i32, el % p >= p * 2 / 3);
}

// When the caret next goes off or on after the time last known; -1 for
// never.
fn _blink_due(r as *Router) as i64 {
    let is i64 as p = r.settings.caret_blink_ms;
    if (p <= 0 || r.blinking == 0) { return 0 - 1; }
    let is i64 as el = r.now - r.blink_from;
    let is i64 as limit = r.settings.caret_blink_timeout_ms;
    if (el < 0 || (limit > 0 && el >= limit)) { return 0 - 1; }
    let is i64 as on = p * 2 / 3;
    let is i64 as c = el % p;
    let is i64 as next with mut = el - c + on;
    if (c >= on) { next = el - c + p; }
    if (limit > 0 && next >= limit) {
        // Off at the end: on then, for good.
        if (c >= on) { return r.blink_from + limit; }
        return 0 - 1;
    }
    return r.blink_from + next;
}

// --- Modal scope ---
//
// While a scope is set — a dialog drawn inside the window — only its subtree
// reacts: the pointer reaches nothing outside it, focus cannot leave it, and
// Tab cycles within it. Setting one takes focus inside if it was outside and
// drops the hover from everything behind. One subtree outside it may be let
// through as well (set_scope_also): an entry typed in while what it suggests
// is shown keeps the focus, and presses on it are its own.

fn _in_scope(t as *tree.Tree, r as *Router, w as i64) as i32 {
    // A scope destroyed while set is none: the window is not left shut.
    if (r.scope == 0 || tree.is_valid(t, r.scope) == 0) { return 1; }
    let is i64 as a with mut = w;
    while (a != 0) {
        if (a == r.scope || a == r.scope_also) { return 1; }
        a = tree.parent(t, a);
    }
    return 0;
}

fn _hit_scoped(t as *tree.Tree, r as *Router, x as f64, y as f64) as i64 {
    let is i64 as h = hit(t, x, y);
    if (h != 0 && _in_scope(t, r, h) == 0) { return 0; }
    return h;
}

fn set_scope(t as *tree.Tree, r as *Router, w as i64) as void {
    _set_scope(t, r, w);
    if (focused(t, r) == 0) { focus_next(t, r, 1); }
    _rehover(t, r);
}

// A scope set, with also's subtree let through.
fn set_scope_also(t as *tree.Tree, r as *Router, w as i64, also as i64) as void {
    _set_scope(t, r, w);
    r.scope_also = also;
    if (focused(t, r) == 0) { focus_next(t, r, 1); }
    _rehover(t, r);
}

fn _set_scope(t as *tree.Tree, r as *Router, w as i64) as void {
    r.scope = w;
    r.scope_also = 0;
    if (r.scope != 0 && tree.is_valid(t, r.scope) == 0) { r.scope = 0; }
    if (r.capture != 0 && _in_scope(t, r, r.capture) == 0) {
        r.capture = 0;
        r.dragging = 0;
    }
}

fn _rehover(t as *tree.Tree, r as *Router) as void {
    if (r.pointer_in == 1 && r.capture == 0) {
        _update_hover(t, r, _hit_scoped(t, r, r.pointer_x, r.pointer_y), 0);
    }
}

// A popup ending: the scope as it was before it — scope, 0 for none — and
// the focus given back to w, as give_back gives it, in one step, so that
// nothing else is focused on the way — as set_scope would, finding the
// focus on the popup gone. When w can no longer take it, the first that
// can, as set_scope.
fn restore(t as *tree.Tree, r as *Router, scope as i64, w as i64, ring as i32) as void {
    _set_scope(t, r, scope);
    if (w == 0 || give_back(t, r, w, ring) == 0) {
        if (focused(t, r) == 0) { focus_next(t, r, 1); }
    }
    _rehover(t, r);
}

fn scope(r as *Router) as i64 { return r.scope; }

// --- Focus ---

fn _can_focus(t as *tree.Tree, r as *Router, w as i64) as i32 {
    if (w == 0 || tree.is_valid(t, w) == 0) { return 0; }
    if (tree.is_focusable(t, w) == 0) { return 0; }
    if (tree.is_visible(t, w) == 0 || tree.is_enabled(t, w) == 0) { return 0; }
    return _in_scope(t, r, w);
}

// The nearest widget at or above w that can take focus, 0 for none.
fn _focusable_from(t as *tree.Tree, r as *Router, w as i64) as i64 {
    let is i64 as a with mut = w;
    while (a != 0) {
        if (_can_focus(t, r, a) == 1) { return a; }
        a = tree.parent(t, a);
    }
    return 0;
}

// The focused widget, or 0 — also when the one that had focus has since been
// destroyed, hidden or disabled, or is outside the scope.
fn focused(t as *tree.Tree, r as *Router) as i64 {
    if (_can_focus(t, r, r.focus) == 0) { return 0; }
    return r.focus;
}

// Whether to draw the focus ring: focus last moved by keyboard.
fn focus_visible(r as *Router) as i32 { return r.focus_visible; }

// Gives w the keyboard focus; 0 clears it. Returns 0 when w cannot take it.
// The widget losing focus hears FOCUS_OUT, the one gaining it FOCUS_IN, each
// naming the other.
fn focus(t as *tree.Tree, r as *Router, w as i64, by_keyboard as i32) as i32 {
    if (w != 0 && _can_focus(t, r, w) == 0) { return 0; }
    _focus(t, r, w, by_keyboard, by_keyboard);
    // Whoever is on the keyboard has to see where focus went; a click was
    // aimed at something already in view.
    if (w != 0 && by_keyboard == 1) { reveal(t, w); }
    return 1;
}

// The focus given back to w — a popup closing, to what had it before — its
// ring shown as ring says, as it was then; no move by keyboard, so the
// widget hears FOCUS_IN as from the pointer, and an entry does not select
// all of itself. 0 when w cannot take it.
fn give_back(t as *tree.Tree, r as *Router, w as i64, ring as i32) as i32 {
    if (w != 0 && _can_focus(t, r, w) == 0) { return 0; }
    _focus(t, r, w, 0, ring);
    return 1;
}

fn _focus(t as *tree.Tree, r as *Router, w as i64, by_keyboard as i32, ring as i32) as void {
    let is i64 as old = focused(t, r);
    // Focus and its ring change how both widgets look.
    if (old != w || r.focus_visible != ring) {
        tree.invalidate_paint(t, old);
        tree.invalidate_paint(t, w);
        _repaint_within(t, old);
        _repaint_within(t, w);
    }
    r.focus_visible = ring;
    if (old != w) {
        r.focus = w;
        if (old != 0) {
            let is event.Event as out = event.make(event.FOCUS_OUT, 0);
            out.related = w;
            _direct(t, old, &out);
        }
        _leave_within(t, old, w);
        if (w != 0) { _enter_within(t, tree.parent(t, w), old); }
        if (w != 0) {
            let is event.Event as in = event.make(event.FOCUS_IN, 0);
            in.related = old;
            in.which = by_keyboard;
            _direct(t, w, &in);
        }
        tree.notify(t, w, tree.WATCH_FOCUS);
    }
    _awake(t, r, r.now);
}

// Whether w is a or inside it.
fn _holds(t as *tree.Tree, a as i64, w as i64) as i32 {
    let is i64 as cur with mut = w;
    while (cur != 0) {
        if (cur == a) { return 1; }
        cur = tree.parent(t, cur);
    }
    return 0;
}

// What held the focus at from and does not hold it at to hears FOCUS_LEAVE,
// innermost first — a composite learning that its parts lost the focus, as
// a spin box commits what was typed into its entry.
fn _leave_within(t as *tree.Tree, from as i64, to as i64) as void {
    if (from == 0) { return; }
    let is i64 as a with mut = tree.parent(t, from);
    while (a != 0) {
        if (_holds(t, a, to) == 0) {
            let is event.Event as e = event.make(event.FOCUS_LEAVE, 0);
            e.related = to;
            _direct(t, a, &e);
        }
        a = tree.parent(t, a);
    }
}

// And what holds it now and did not, from a up, hears FOCUS_ENTER,
// outermost first.
fn _enter_within(t as *tree.Tree, a as i64, from as i64) as void {
    if (a == 0) { return; }
    _enter_within(t, tree.parent(t, a), from);
    if (_holds(t, a, from) == 1) { return; }
    let is event.Event as e = event.make(event.FOCUS_ENTER, 0);
    e.related = from;
    _direct(t, a, &e);
}

// The ancestors of w that look different with the focus inside them — those
// that asked, with tree.F_FOCUS_WITHIN_LOOK. Repainting every ancestor would
// repaint the whole window on every Tab.
fn _repaint_within(t as *tree.Tree, w as i64) as void {
    if (w == 0) { return; }
    let is i64 as a with mut = tree.parent(t, w);
    while (a != 0) {
        if (tree.has_flag(t, a, tree.F_FOCUS_WITHIN_LOOK) == 1) { tree.invalidate_paint(t, a); }
        a = tree.parent(t, a);
    }
}

// --- Bringing into view ---
//
// Asks every ancestor of w to bring the rectangle r (window coordinates) into
// view — a scroll area moves its content until it shows. Each ancestor hears
// it whether or not one below acted, because nested areas each have to; one
// that moves its content moves the rectangle in the event with it, so the
// next one up sees where it now is. Widgets call it for a part of themselves:
// a list for its current row, an entry for its caret.
fn reveal_rect(t as *tree.Tree, w as i64, r as *math.rect.Rect) as void {
    if (tree.is_valid(t, w) == 0) { return; }
    let is event.Event as e = event.make(event.REVEAL, 0);
    e.x = r.x;
    e.y = r.y;
    e.width = r.w;
    e.height = r.h;
    e.target = w;
    e.phase = event.BUBBLE;
    let is i64 as a with mut = tree.parent(t, w);
    while (a != 0) {
        _deliver(t, a, &e);
        a = tree.parent(t, a);
    }
}

fn reveal(t as *tree.Tree, w as i64) as void {
    let is math.rect.Rect as r = layout.window_rect(t, w);
    reveal_rect(t, w, &r);
}

// The next widget in tree order after w within top, without descending into
// hidden widgets — nothing under them can take focus.
fn _next_in_order(t as *tree.Tree, w as i64, top as i64) as i64 {
    if (tree.is_visible(t, w) == 1 || w == top) {
        let is i64 as c = tree.first_child(t, w);
        if (c != 0) { return c; }
    }
    let is i64 as cur with mut = w;
    while (cur != top && cur != 0) {
        let is i64 as s = tree.next_sibling(t, cur);
        if (s != 0) { return s; }
        cur = tree.parent(t, cur);
    }
    return 0;
}

// Moves focus to the next (dir 1) or previous (dir -1) widget that can take
// it, in tree order within the scope, wrapping. With nothing focused, Tab
// starts at the first and Shift+Tab at the last. A Tab group whose stop
// cannot take the focus is reached at the first of it that could, which
// becomes its stop (tree.set_tab_group). Returns 0 if nothing in scope can
// take focus.
fn focus_next(t as *tree.Tree, r as *Router, dir as i32) as i32 {
    let is i64 as top with mut = r.scope;
    if (top == 0) { top = tree.root(t); }
    let is i64 as mark = tree.scratch_mark(t);
    let is i64 as live = tree.live_count(t);
    let is *i64 as list = cast(*i64, tree.scratch_alloc(t, live * 8));
    // The Tab groups whose stop can take the focus, and those given a
    // stand-in: at most one entry each per widget.
    let is *i64 as held = cast(*i64, tree.scratch_alloc(t, live * 8));
    let is *i64 as stood = cast(*i64, tree.scratch_alloc(t, live * 8));
    if (cast(i64, list) == 0 || cast(i64, held) == 0 || cast(i64, stood) == 0) { tree.scratch_release(t, mark); return 0; }
    let is i64 as nheld with mut = 0;
    let is i64 as w with mut = top;
    while (w != 0) {
        let is i64 as g = tree.tab_group(t, w);
        if (g != 0 && _can_focus(t, r, w) == 1) {
            held[nheld] = g;
            nheld = nheld + 1;
        }
        w = _next_in_order(t, w, top);
    }
    let is i64 as nstood with mut = 0;
    let is i64 as n with mut = 0;
    w = top;
    while (w != 0) {
        if (_can_focus(t, r, w) == 1) {
            list[n] = w;
            n = n + 1;
        } else if (_stands_in(t, r, w, held, nheld, stood, nstood) == 1) {
            stood[nstood] = tree.tab_group(t, w);
            nstood = nstood + 1;
            list[n] = w;
            n = n + 1;
        }
        w = _next_in_order(t, w, top);
    }
    if (n == 0) { tree.scratch_release(t, mark); return 0; }

    let is i64 as cur = focused(t, r);
    let is i64 as at with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (list[i] == cur) { at = i; }
        i = i + 1;
    }
    let is i64 as pick with mut = 0;
    if (at < 0) {
        if (dir < 0) { pick = n - 1; }
    } else if (dir < 0) {
        pick = (at + n - 1) % n;
    } else {
        pick = (at + 1) % n;
    }
    let is i64 as chosen = list[pick];
    tree.scratch_release(t, mark);
    let is i64 as g = tree.tab_group(t, chosen);
    if (g != 0 && tree.is_focusable(t, chosen) == 0) { _move_stop(t, top, g, chosen); }
    focus(t, r, chosen, 1);
    return 1;
}

// Whether w stands in for its Tab group's stop: the group's stop cannot take
// the focus, nor has another of it stood in, and w could but for not being
// the stop.
fn _stands_in(t as *tree.Tree, r as *Router, w as i64, held as *i64, nheld as i64, stood as *i64, nstood as i64) as i32 {
    let is i64 as g = tree.tab_group(t, w);
    if (g == 0 || _in(held, nheld, g) == 1 || _in(stood, nstood, g) == 1) { return 0; }
    if (tree.is_visible(t, w) == 0 || tree.is_enabled(t, w) == 0) { return 0; }
    return _in_scope(t, r, w);
}

// Tab group g's stop moved to w: the only one of it focusable.
fn _move_stop(t as *tree.Tree, top as i64, g as i64, w as i64) as void {
    let is i64 as v with mut = top;
    while (v != 0) {
        if (tree.tab_group(t, v) == g) { tree.set_focusable(t, v, cast(i32, v == w)); }
        v = _next_in_order(t, v, top);
    }
}

// --- Keys and text ---

fn _plain(mods as i32) as i32 { return (mods | keys.MOD_LOCK) - keys.MOD_LOCK; }

// key from window/keys.cst; pressed 1 down, 0 up; repeat 1 when the platform
// generated it from a held key. Returns 1 if something handled it.
//
// A key press goes, in order:
//   1. to the focused widget as SHORTCUT_OVERRIDE, bubbling — a widget that
//      wants the key itself (an entry wanting Ctrl+A), or one holding it
//      that wants it for it, claims it there, and the focused widget gets
//      it as KEY_DOWN, bubbling;
//   2. to the window's shortcuts and mnemonics;
//   3. as CONTEXT_MENU, for the Menu key and Shift+F10;
//   4. to the focused widget as KEY_DOWN, bubbling;
//   5. if nobody took it, Tab and Shift+Tab move focus.
fn key(t as *tree.Tree, r as *Router, k as i32, mods as i32, pressed as i32,
       repeat as i32, time as i64) as i32 {
    r.now = time;
    let is i32 as done = _key(t, r, k, mods, pressed, repeat, time);
    _requested(t, r, 1);
    if (pressed == 1) { _awake(t, r, time); }
    return done;
}

fn _key(t as *tree.Tree, r as *Router, k as i32, mods as i32, pressed as i32,
        repeat as i32, time as i64) as i32 {
    if (pressed == 1) { r.inputs = r.inputs + 1; }
    // Alt going down or up shows or hides every mnemonic's underline.
    if (((r.mods ^ mods) & keys.MOD_ALT) != 0) { tree.invalidate_paint_subtree(t, tree.root(t)); }
    r.mods = mods;
    // Escape calls off a drag begun here; the release after it does nothing.
    if (pressed == 1 && k == keys.ESCAPE && r.drag_on == 1 && r.drag_own == 1) {
        _drag_target(t, r, 0, 0, 0, time);
        _end(t, r, 0, time);
        r.capture = 0;
        r.dragging = 0;
        r.swallow = 1;
        return 1;
    }
    let is i64 as f = focused(t, r);
    let is event.Event as e = event.make(event.KEY_DOWN, time);
    e.key = k;
    e.mods = mods;
    e.repeat = repeat;
    e.x = r.pointer_x;
    e.y = r.pointer_y;
    if (pressed == 0) {
        e.kind = event.KEY_UP;
        if (f != 0 && _dispatch(t, &e, f) != 0) { return 1; }
        return 0;
    }

    if (f != 0) {
        // Bubbling: what holds the focused widget may keep a key for it —
        // a spin box Enter for the entry inside it.
        let is event.Event as o = e;
        o.kind = event.SHORTCUT_OVERRIDE;
        if (_dispatch(t, &o, f) != 0) {
            _dispatch(t, &e, f);
            return 1;
        }
    }

    let is i32 as plain = _plain(mods);
    if (_run_shortcut(t, r, k, mods) == 1) { return 1; }
    if (plain == keys.MOD_ALT && _run_mnemonic(t, r, k, time) == 1) { return 1; }
    if ((k == keys.MENU && plain == 0) || (k == keys.F10 && plain == keys.MOD_SHIFT)) {
        if (f != 0) {
            // Where a pointer would have been: the middle of the widget.
            let is math.rect.Rect as fr = layout.window_rect(t, f);
            let is event.Event as c = event.make(event.CONTEXT_MENU, time);
            c.x = fr.x + fr.w * 0.5;
            c.y = fr.y + fr.h * 0.5;
            c.mods = mods;
            if (_dispatch(t, &c, f) != 0) { return 1; }
        }
    }

    if (f != 0 && _dispatch(t, &e, f) != 0) { return 1; }

    if (k == keys.TAB && (plain == 0 || plain == keys.MOD_SHIFT)) {
        let is i32 as dir with mut = 1;
        if (plain == keys.MOD_SHIFT) { dir = 0 - 1; }
        focus_next(t, r, dir);
        return 1;
    }
    return 0;
}

// Text the user typed, UTF-8 and already composed — dead keys and input
// methods have done their work below. To the focused widget, bubbling.
fn text(t as *tree.Tree, r as *Router, s as *u8, len as i64, time as i64) as i32 {
    r.now = time;
    _awake(t, r, time);
    let is i64 as f = focused(t, r);
    if (f == 0) { return 0; }
    let is event.Event as e = event.make(event.TEXT, time);
    e.text = s;
    e.text_len = len;
    e.mods = r.mods;
    if (_dispatch(t, &e, f) != 0) { return 1; }
    return 0;
}

// The platform asked the window to close: CLOSE_REQUEST to the focused
// widget, bubbling, then to each widget of the window until one takes it —
// a dialog, which answers as Escape. 1 when taken; untaken, the program
// closes the window.
fn close_request(t as *tree.Tree, r as *Router, time as i64) as i32 {
    r.now = time;
    let is event.Event as e = event.make(event.CLOSE_REQUEST, time);
    e.mods = r.mods;
    if (_dispatch(t, &e, focused(t, r)) != 0) { return 1; }
    // Every widget, outermost first.
    let is i64 as w with mut = tree.root(t);
    while (w != 0) {
        let is event.Event as each = event.make(event.CLOSE_REQUEST, time);
        if (_direct(t, w, &each) != 0) { return 1; }
        let is i64 as next with mut = tree.first_child(t, w);
        let is i64 as up with mut = w;
        while (next == 0 && up != 0) {
            next = tree.next_sibling(t, up);
            up = tree.parent(t, up);
        }
        w = next;
    }
    return 0;
}

// Text asked of the clipboard (tree.request_paste) for widget w, given to
// it as PASTE when it is still there. which is tree.CLIPBOARD or PRIMARY.
fn paste(t as *tree.Tree, r as *Router, w as i64, which as i32, s as *u8, len as i64, time as i64) as i32 {
    r.now = time;
    _awake(t, r, time);
    if (tree.is_valid(t, w) == 0) { return 0; }
    let is event.Event as e = event.make(event.PASTE, time);
    e.text = s;
    e.text_len = len;
    e.which = which;
    e.mods = r.mods;
    if (_direct(t, w, &e) != 0) { return 1; }
    return 0;
}

// The input method's composition — s, len bytes, its caret cursor bytes in;
// empty when it is over — to the focused widget as PREEDIT. What it
// commits comes as text().
fn preedit(t as *tree.Tree, r as *Router, s as *u8, len as i64, cursor as i64, time as i64) as i32 {
    r.now = time;
    _awake(t, r, time);
    let is i64 as f = focused(t, r);
    if (f == 0) { return 0; }
    let is event.Event as e = event.make(event.PREEDIT, time);
    e.text = s;
    e.text_len = len;
    e.cursor = cursor;
    e.mods = r.mods;
    if (_direct(t, f, &e) != 0) { return 1; }
    return 0;
}

// --- Shortcuts ---
//
// Letters match regardless of case and Caps Lock; the other modifiers must
// match exactly, so Ctrl+Shift+S is not Ctrl+S. A shortcut a widget owns — a
// default button's Enter — runs only while the widget is shown, enabled and
// inside the modal scope, and is passed over otherwise for the next that
// matches; the window's own wait while a scope is set, as they would were the
// scope a window of its own.

fn _norm_key(k as i32) as i32 {
    if (k >= 65 && k <= 90) { return k + 32; }
    return k;
}

// Returns an id for remove_shortcut, or 0 when the table is full.
fn add_shortcut(r as *Router, k as i32, mods as i32, cb as ShortcutFn, user as *u8) as i64 {
    return add_shortcut_for(r, 0, k, mods, cb, user);
}

// One widget w owns: see above.
fn add_shortcut_for(r as *Router, w as i64, k as i32, mods as i32, cb as ShortcutFn, user as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (i < MAX_SHORTCUTS) {
        if (r.shortcuts[i].key == 0) {
            r.shortcuts[i].key = _norm_key(k);
            r.shortcuts[i].mods = _plain(mods);
            r.shortcuts[i].cb = cb;
            r.shortcuts[i].user = user;
            r.shortcuts[i].owner = w;
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn remove_shortcut(r as *Router, id as i64) as void {
    if (id < 1 || id > MAX_SHORTCUTS) { return; }
    r.shortcuts[id - 1].key = 0;
}

// Whether shortcut i may run now.
fn _live(t as *tree.Tree, r as *Router, i as i64) as i32 {
    let is i64 as w = r.shortcuts[i].owner;
    if (w == 0) { return cast(i32, r.scope == 0 || tree.is_valid(t, r.scope) == 0); }
    return cast(i32, tree.is_valid(t, w) == 1 && tree.is_visible(t, w) == 1 && tree.is_enabled(t, w) == 1 &&
                _in_scope(t, r, w) == 1);
}

fn _run_shortcut(t as *tree.Tree, r as *Router, k as i32, mods as i32) as i32 {
    let is i32 as nk = _norm_key(k);
    let is i32 as pm = _plain(mods);
    let is i64 as i with mut = 0;
    while (i < MAX_SHORTCUTS) {
        if (r.shortcuts[i].key == nk && r.shortcuts[i].mods == pm && _live(t, r, i) == 1) {
            call(r.shortcuts[i].cb, r.shortcuts[i].user);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// --- Mnemonics ---
//
// Alt and a letter activate the widget that registered the letter — the
// underlined letter of a button or menu: it takes the focus if it can, then
// receives ACTIVATE and decides what that means. Hidden, disabled and
// out-of-scope widgets are passed over. Alt going down or up repaints the
// window, whose painter state then says whether to underline.

// Returns 1, or 0 when w is stale or the table is full.
fn add_mnemonic(t as *tree.Tree, r as *Router, w as i64, letter as i32) as i32 {
    if (tree.is_valid(t, w) == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (i < MAX_MNEMONICS) {
        if (r.mnemonic_w[i] == 0 || tree.is_valid(t, r.mnemonic_w[i]) == 0) {
            r.mnemonic_w[i] = w;
            r.mnemonic_key[i] = _norm_key(letter);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn remove_mnemonics(r as *Router, w as i64) as void {
    let is i64 as i with mut = 0;
    while (i < MAX_MNEMONICS) {
        if (r.mnemonic_w[i] == w) { r.mnemonic_w[i] = 0; }
        i = i + 1;
    }
}

fn _run_mnemonic(t as *tree.Tree, r as *Router, k as i32, time as i64) as i32 {
    let is i32 as nk = _norm_key(k);
    let is i64 as i with mut = 0;
    while (i < MAX_MNEMONICS) {
        let is i64 as w = r.mnemonic_w[i];
        if (w != 0 && r.mnemonic_key[i] == nk && tree.is_valid(t, w) == 1
            && tree.is_visible(t, w) == 1 && tree.is_enabled(t, w) == 1 && _in_scope(t, r, w) == 1) {
            // It takes the focus when it can, as Tab would give it: an entry
            // a label's mnemonic names is then typed in.
            if (_can_focus(t, r, w) == 1) { focus(t, r, w, 1); }
            let is event.Event as e = event.make(event.ACTIVATE, time);
            e.key = k;
            e.mods = r.mods;
            _direct(t, w, &e);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Whether to draw the mnemonic underlines: while Alt is held. mods passed to
// key() are the modifiers in effect after that key event.
fn mnemonics_visible(r as *Router) as i32 {
    if ((r.mods & keys.MOD_ALT) != 0) { return 1; }
    return 0;
}

// --- Dragging ---
//
// A drag is over the window in one of two ways. A widget here began it — on
// DRAG_START, as the widget holding the pointer — with begin_drag: from then
// the pointer is the drag's, moving it over the window, until the button is
// let go, dropping it, or Escape calls it off; the widget hears DRAG_END with
// what was done (a move is its to finish, removing what moved). Or it comes
// from outside — another program, another window of this one — and the
// platform's loop tells it with drag_enter, drag_move, drag_leave and
// drag_drop, answering the platform with what they return.
//
// Either way, the widget under the pointer is asked with DRAG_OVER, bubbling,
// and the first to return some of what is offered takes it there; the one that
// took it hears DRAG_LEAVE when it no longer does, and DROP when it is let go
// over it. A widget may also be taken as a drop target by the program,
// add_drop_target: it takes what it is said to, and a drop on it is said with
// signal.DROPPED.

// Begins a drag of p from w, which holds the pointer — a widget does on
// DRAG_START. p is copied; what it points at is w's until DRAG_END. 1 when
// begun; 0 with one already going or nothing offered.
fn begin_drag(t as *tree.Tree, r as *Router, w as i64, p as *dnd.Payload) as i32 {
    if (r.drag_on == 1 || p.offers == 0) { return 0; }
    r.drag = *p;
    r.drag_on = 1;
    r.drag_own = 1;
    r.drag_src = w;
    r.drag_to = 0;
    r.drag_takes = 0;
    r.drag_x = r.pointer_x;
    r.drag_y = r.pointer_y;
    _drag_over(t, r, r.now);
    return 1;
}

// A drag from outside came over the window at x, y: what is taken there, dnd
// bits, 0 for nothing — the platform's answer. p is copied; what it points at
// stays the caller's until drag_leave or drag_drop.
fn drag_enter(t as *tree.Tree, r as *Router, p as *dnd.Payload, x as f64, y as f64, time as i64) as i32 {
    if (r.drag_on == 1 && r.drag_own == 1) { return 0; }
    _drag_target(t, r, 0, 0, 0, time);
    r.drag = *p;
    r.drag_on = 1;
    r.drag_own = 0;
    r.drag_src = 0;
    r.drag_x = x;
    r.drag_y = y;
    _drag_over(t, r, time);
    return r.drag_takes;
}

// It moved to x, y: what is taken there.
fn drag_move(t as *tree.Tree, r as *Router, x as f64, y as f64, time as i64) as i32 {
    if (r.drag_on == 0 || r.drag_own == 1) { return 0; }
    r.drag_x = x;
    r.drag_y = y;
    _drag_over(t, r, time);
    return r.drag_takes;
}

// It left, or was let go somewhere it was not taken.
fn drag_leave(t as *tree.Tree, r as *Router, time as i64) as void {
    if (r.drag_on == 0 || r.drag_own == 1) { return; }
    _drag_target(t, r, 0, 0, 0, time);
    r.drag_on = 0;
}

// It was let go at x, y, what it offers now there to be had: what was done
// with it, dnd.COPY or MOVE, 0 for nothing.
fn drag_drop(t as *tree.Tree, r as *Router, x as f64, y as f64, time as i64) as i32 {
    if (r.drag_on == 0 || r.drag_own == 1) { return 0; }
    r.drag_x = x;
    r.drag_y = y;
    _drag_over(t, r, time);
    let is i32 as done = _drop(t, r, time);
    r.drag_on = 0;
    return done;
}

// A drag from outside has what it offers now — the platform has it only once
// it is let go: p's data in place of what it said at drag_enter, its offers
// and actions as they were. 1, or 0 with no drag from outside.
fn drag_update(r as *Router, p as *dnd.Payload) as i32 {
    if (r.drag_on == 0 || r.drag_own == 1) { return 0; }
    r.drag.text = p.text;
    r.drag.text_len = p.text_len;
    r.drag.files = p.files;
    r.drag.files_n = p.files_n;
    return 1;
}

// --- A drag begun here, over another window of the program's ---
//
// The platform's loop sees the pointer leave this window for another of the
// program's while a drag begun here goes on: it asks that window's router
// to take what this one carries (drag_payload, then drag_enter there), tells
// this one it is elsewhere, and once it is let go there, what was done.

// What a drag begun here carries; null for none.
fn drag_payload(r as *Router) as *dnd.Payload {
    if (r.drag_on == 0 || r.drag_own == 0) { return cast(*dnd.Payload, 0); }
    return &r.drag;
}

// The drag begun here went over another window: what took it here left.
// Back over this one, the pointer runs it here again.
fn drag_elsewhere(t as *tree.Tree, r as *Router, time as i64) as void {
    if (r.drag_on == 0 || r.drag_own == 0) { return; }
    _drag_target(t, r, 0, 0, 0, time);
}

// It was let go over another window, which did done with it (dnd bits, 0
// for nothing): over here as if let go here, its source told. 1, or 0 with
// no drag begun here.
fn drag_finish(t as *tree.Tree, r as *Router, done as i32, time as i64) as i32 {
    if (r.drag_on == 0 || r.drag_own == 0) { return 0; }
    r.now = time;
    _drag_target(t, r, 0, 0, 0, time);
    _end(t, r, done, time);
    r.capture = 0;
    r.dragging = 0;
    r.spent = 0;
    // The release that ended it, there, is spent: nothing here hears it.
    r.swallow = 1;
    return 1;
}

fn drag_active(r as *Router) as i32 { return r.drag_on; }

// The widget a drag over the window began from, 0 for one from outside.
fn drag_source(r as *Router) as i64 {
    if (r.drag_on == 0) { return 0; }
    return r.drag_src;
}

// What takes it where it is, 0 for nothing; and what of it.
fn drag_target(r as *Router) as i64 { return r.drag_to; }
fn drag_takes(r as *Router) as i32 { return r.drag_takes; }

// w taken as a drop target of the program's, of what offers says: a drag
// offering some of it is taken there, and a drop on it said with
// signal.DROPPED. 1, or 0 with the table full.
fn add_drop_target(r as *Router, w as i64, offers as i32) as i32 {
    let is i64 as free with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < MAX_DROP_TARGETS) {
        if (r.drop_w[i] == w) {
            r.drop_offers[i] = offers;
            return 1;
        }
        if (r.drop_w[i] == 0 && free < 0) { free = i; }
        i = i + 1;
    }
    if (free < 0) { return 0; }
    r.drop_w[free] = w;
    r.drop_offers[free] = offers;
    return 1;
}

fn remove_drop_target(r as *Router, w as i64) as void {
    let is i64 as i with mut = 0;
    while (i < MAX_DROP_TARGETS) {
        if (r.drop_w[i] == w) {
            r.drop_w[i] = 0;
            r.drop_offers[i] = 0;
        }
        i = i + 1;
    }
}

fn _registered(r as *Router, w as i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < MAX_DROP_TARGETS) {
        if (r.drop_w[i] == w) { return r.drop_offers[i]; }
        i = i + 1;
    }
    return 0;
}

// What a drop would do: a move when one may be and Control is not held, a
// copy otherwise.
fn _action(r as *Router) as i32 {
    if ((r.drag.actions & dnd.MOVE) != 0 && (r.mods & keys.MOD_CONTROL) == 0) { return dnd.MOVE; }
    if ((r.drag.actions & dnd.COPY) != 0) { return dnd.COPY; }
    return dnd.MOVE;
}

// Who takes the drag where it is: the widget under it asked, then what holds
// it, until one takes some of what is offered.
fn _drag_over(t as *tree.Tree, r as *Router, time as i64) as void {
    let is i64 as w = _hit_scoped(t, r, r.drag_x, r.drag_y);
    let is i64 as got with mut = 0;
    let is i32 as takes with mut = 0;
    let is i32 as by_table with mut = 0;
    let is i64 as cur with mut = w;
    while (cur != 0 && got == 0) {
        if (tree.is_enabled(t, cur) == 1) {
            let is event.Event as e = event.make(event.DRAG_OVER, time);
            e.x = r.drag_x;
            e.y = r.drag_y;
            e.mods = r.mods;
            e.which = r.drag.offers;
            e.drag = cast(*u8, &r.drag);
            e.target = w;
            e.phase = event.BUBBLE;
            if (cur == w) { e.phase = event.TARGET; }
            let is i32 as k with mut = cast(i32, _deliver(t, cur, &e)) & r.drag.offers;
            if (k == 0) {
                k = _registered(r, cur) & r.drag.offers;
                if (k != 0) { by_table = 1; }
            }
            if (k != 0) {
                got = cur;
                takes = k;
            }
        }
        cur = tree.parent(t, cur);
    }
    _drag_target(t, r, got, takes, by_table, time);
}

// w takes it now: the one that did before hears it does not.
fn _drag_target(t as *tree.Tree, r as *Router, w as i64, takes as i32, by_table as i32, time as i64) as void {
    if (r.drag_to != 0 && r.drag_to != w) {
        let is event.Event as e = event.make(event.DRAG_LEAVE, time);
        e.x = r.drag_x;
        e.y = r.drag_y;
        _direct(t, r.drag_to, &e);
    }
    r.drag_to = w;
    r.drag_takes = takes;
    r.drag_by_table = by_table;
}

// Let go where it is: DROP to what takes it there — said with
// signal.DROPPED for a drop target of the program's. What was done.
fn _drop(t as *tree.Tree, r as *Router, time as i64) as i32 {
    let is i64 as w = r.drag_to;
    let is i32 as by_table = r.drag_by_table;
    r.drag_to = 0;
    r.drag_takes = 0;
    r.drag_by_table = 0;
    if (w == 0 || tree.is_valid(t, w) == 0) { return 0; }
    let is i32 as action = _action(r);
    if (by_table == 1) {
        signal.emit(t, w, signal.DROPPED, cast(*u8, &r.drag));
        return action;
    }
    let is event.Event as e = event.make(event.DROP, time);
    e.x = r.drag_x;
    e.y = r.drag_y;
    e.mods = r.mods;
    e.which = action;
    e.drag = cast(*u8, &r.drag);
    return cast(i32, _direct(t, w, &e)) & action;
}

// A drag begun here is over: its source told what was done.
fn _end(t as *tree.Tree, r as *Router, done as i32, time as i64) as void {
    let is i64 as src = r.drag_src;
    r.drag_on = 0;
    r.drag_own = 0;
    r.drag_src = 0;
    let is event.Event as e = event.make(event.DRAG_END, time);
    e.x = r.drag_x;
    e.y = r.drag_y;
    e.which = done;
    _direct(t, src, &e);
}
