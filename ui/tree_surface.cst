// ui/tree_surface.cst — the widgets shown in platform windows of their own:
// the table of surfaces, what the host is asked, and which surface a widget
// is drawn in. What it means to the rest — laid out where the platform put
// it, damaged and painted on its own, its input translated — is layout's,
// damage's, paint's and the host's; tree.cst wraps these and marks what has
// to be laid out and painted again.
//
// The table also keeps the widgets placed against a rectangle that stay
// inside the window (no host, or the host could not open them): not
// surfaces to anyone, but what they are anchored to is known, so
// ui/surface.cst can place them again when it moves (the placed_* calls).
use "../math/math.cst" as math;
use "../window/positioner.cst" as positioner;
use "tree_state.cst" as tst;

fn set_surfaces(t as *tst.Tree, cb as tst.SurfaceFn, user as *u8) as void {
    t.surf_fn = cb;
    t.surf_user = user;
}

fn has_surfaces(t as *tst.Tree) as i32 {
    return cast(i32, t.ok == 1 && cast(i64, t.surf_fn) != 0);
}

// The entry w has, shown by the host or not; -1 for none.
fn entry(t as *tst.Tree, w as i64) as i64 {
    if (t.ok == 0 || w == 0) { return 0 - 1; }
    let is i64 as s with mut = 0;
    while (s < tst.MAX_SURFACES) {
        if (tst._surface(t, s).w == w) { return s; }
        s = s + 1;
    }
    return 0 - 1;
}

// The surface w is the widget of — shown by the host — -1 for none.
fn index(t as *tst.Tree, w as i64) as i64 {
    let is i64 as s = entry(t, w);
    if (s < 0 || tst._surface(t, s).is_native == 0) { return 0 - 1; }
    return s;
}

// The surface w is drawn in — its own, or its nearest ancestor's: a
// submenu in a window of its own is drawn there, not in its menu's — or -1
// for the window.
fn surface_of(t as *tst.Tree, w as i64) as i64 {
    let is i64 as i with mut = tst._index(t, w);
    while (i >= 0 && i != t.root) {
        // Only what is on a layer can be a surface: the rest is passed by.
        if (tst._node(t, i).layer > 0) {
            let is i64 as s = index(t, tst._handle(t, i));
            if (s >= 0) { return s; }
        }
        i = tst._node(t, i).parent;
    }
    return 0 - 1;
}

// The same for a node's slot: what tree.cst has in hand when it damages.
fn surface_of_slot(t as *tst.Tree, i as i64) as i64 {
    if (t.ok == 0 || i < 0 || i == t.root) { return 0 - 1; }
    return surface_of(t, tst._handle(t, i));
}

// Where a widget's own coordinates start in the window: its rectangle and
// every ancestor's, moved by their translations, as layout.window_rect adds
// them; 0, 0 for none.
fn _origin(t as *tst.Tree, w as i64, x as *f64, y as *f64) as void {
    *x = 0.0;
    *y = 0.0;
    let is i64 as i with mut = tst._index(t, w);
    while (i >= 0) {
        let is *tst.Node as n = tst._node(t, i);
        *x = *x + n.item.rect.x + n.tx;
        *y = *y + n.item.rect.y + n.ty;
        i = n.parent;
    }
}

fn _free(e as *tst.Surface) as void {
    e.w = 0;
    e.kind = 0;
    e.grab = 0;
    e.owner = 0 - 1;
    e.from = 0;
    e.rel = math.rect.rect_zero();
    e.is_native = 0;
    e.at = math.rect.rect_zero();
    e.damage_n = 0;
    e.native = 0;
    e.see_through = 0;
    e.input_set = 0;
    e.input = math.rect.rect_zero();
}

// w — a widget on a layer — shown in a window of its own, of kind and
// grabbing as said, against place's anchor rectangle (window coordinates,
// logical pixels) of the widget from (the window for 0), place's size the
// widget's. Its entry, or -1 when there is no host, w is on no layer, or the
// host could not open it — then it stays in the window,
// its entry kept, when one is free, for placing it again. Opened already, it
// is placed again.
fn open(t as *tst.Tree, w as i64, kind as i32, grab as i32, from as i64, place as *positioner.Positioner) as i64 {
    let is i64 as i = tst._index(t, w);
    if (i < 0 || i == t.root || tst._node(t, i).layer <= 0) { return 0 - 1; }
    let is f64 as fx with mut = 0.0;
    let is f64 as fy with mut = 0.0;
    let is i64 as anchor_w with mut = from;
    if (tst._index(t, from) < 0) { anchor_w = 0; }
    _origin(t, anchor_w, &fx, &fy);
    let is math.rect.Rect as rel = math.rect.rect(place.anchor_rect.x - fx, place.anchor_rect.y - fy,
                                                  place.anchor_rect.w, place.anchor_rect.h);
    let is i64 as s with mut = entry(t, w);
    if (s >= 0 && tst._surface(t, s).is_native == 1) {
        let is *tst.Surface as e = tst._surface(t, s);
        e.place = *place;
        e.from = anchor_w;
        e.rel = rel;
        call(t.surf_fn, t.surf_user, t, tst.SURFACE_MOVE, s);
        return s;
    }
    if (s < 0) {
        s = 0;
        while (s < tst.MAX_SURFACES && tst._surface(t, s).w != 0) { s = s + 1; }
        if (s == tst.MAX_SURFACES) { return 0 - 1; }
    }
    let is *tst.Surface as e = tst._surface(t, s);
    _free(e);
    e.w = w;
    e.kind = kind;
    e.grab = grab;
    e.from = anchor_w;
    e.rel = rel;
    e.place = *place;
    e.at = math.rect.rect(place.anchor_rect.x, place.anchor_rect.y + place.anchor_rect.h, place.w, place.h);
    if (anchor_w != 0) {
        let is i64 as o = surface_of(t, anchor_w);
        // Never itself: what it is opened against is outside it.
        if (o != s) { e.owner = o; }
    }
    if (has_surfaces(t) == 0) { return 0 - 1; }
    // Native while the host is asked, so what it asks back of the entry
    // answers; refused, it stays in the window.
    e.is_native = 1;
    if (call(t.surf_fn, t.surf_user, t, tst.SURFACE_OPEN, s) == 0) {
        e.is_native = 0;
        e.owner = 0 - 1;
        e.at = math.rect.rect_zero();
        return 0 - 1;
    }
    return s;
}

// w's entry freed, its window put away when it had one: 2 when it had,
// 1 for an entry inside the window, 0 for none. What it opened against it —
// a submenu — is the caller's to close first.
fn close(t as *tst.Tree, w as i64) as i32 {
    let is i64 as s = entry(t, w);
    if (s < 0) { return 0; }
    let is *tst.Surface as e = tst._surface(t, s);
    let is i32 as was = 1 + e.is_native;
    if (e.is_native == 1 && has_surfaces(t) == 1) { call(t.surf_fn, t.surf_user, t, tst.SURFACE_CLOSE, s); }
    _free(e);
    return was;
}

// --- What the host reads: surfaces it shows, -1 and 0 for anything else ---

fn _shown(t as *tst.Tree, s as i64) as *tst.Surface {
    if (t.ok == 0 || s < 0 || s >= tst.MAX_SURFACES) { return cast(*tst.Surface, 0); }
    let is *tst.Surface as e = tst._surface(t, s);
    if (e.w == 0 || e.is_native == 0) { return cast(*tst.Surface, 0); }
    return e;
}

fn widget(t as *tst.Tree, s as i64) as i64 {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.w;
}
fn kind(t as *tst.Tree, s as i64) as i32 {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.kind;
}
fn grab(t as *tst.Tree, s as i64) as i32 {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.grab;
}
fn owner(t as *tst.Tree, s as i64) as i64 {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return 0 - 1; }
    return e.owner;
}
// Its positioner as it was last placed: the anchor rectangle in window
// coordinates.
fn place(t as *tst.Tree, s as i64) as positioner.Positioner {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return positioner.make(0.0, 0.0, math.rect.rect_zero()); }
    return e.place;
}
fn rect(t as *tst.Tree, s as i64) as math.rect.Rect {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return math.rect.rect_zero(); }
    return e.at;
}
// Where the platform put it, in window coordinates: 1 when that is new.
fn set_rect(t as *tst.Tree, s as i64, r as math.rect.Rect) as i32 {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return 0; }
    if (e.at.x == r.x && e.at.y == r.y && e.at.w == r.w && e.at.h == r.h) { return 0; }
    e.at = r;
    return 1;
}
fn native(t as *tst.Tree, s as i64) as i64 {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.native;
}
fn set_native(t as *tst.Tree, s as i64, n as i64) as void {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return; }
    e.native = n;
}
fn see_through(t as *tst.Tree, s as i64) as i32 {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.see_through;
}
fn set_see_through(t as *tst.Tree, s as i64, on as i32) as void {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return; }
    e.see_through = on;
}

// --- What ui/surface.cst reads: every entry, shown by the host or not ---

fn _any(t as *tst.Tree, s as i64) as *tst.Surface {
    if (t.ok == 0 || s < 0 || s >= tst.MAX_SURFACES) { return cast(*tst.Surface, 0); }
    let is *tst.Surface as e = tst._surface(t, s);
    if (e.w == 0) { return cast(*tst.Surface, 0); }
    return e;
}

fn placed_widget(t as *tst.Tree, s as i64) as i64 {
    let is *tst.Surface as e = _any(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.w;
}
fn placed_native(t as *tst.Tree, s as i64) as i32 {
    let is *tst.Surface as e = _any(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.is_native;
}
// The positioner as it was last placed, its anchor rectangle in window
// coordinates.
fn placed_place(t as *tst.Tree, s as i64) as positioner.Positioner {
    let is *tst.Surface as e = _any(t, s);
    if (cast(i64, e) == 0) { return positioner.make(0.0, 0.0, math.rect.rect_zero()); }
    return e.place;
}
// The anchor rectangle where it is now, in window coordinates: what it is
// anchored to moved with it.
fn placed_anchor(t as *tst.Tree, s as i64) as math.rect.Rect {
    let is *tst.Surface as e = _any(t, s);
    if (cast(i64, e) == 0) { return math.rect.rect_zero(); }
    let is i64 as from with mut = e.from;
    // What it was anchored to is gone: where it was stays.
    if (from != 0 && tst._index(t, from) < 0) { return e.place.anchor_rect; }
    let is f64 as fx with mut = 0.0;
    let is f64 as fy with mut = 0.0;
    _origin(t, from, &fx, &fy);
    return math.rect.rect(fx + e.rel.x, fy + e.rel.y, e.rel.w, e.rel.h);
}
fn placed_from(t as *tst.Tree, s as i64) as i64 {
    let is *tst.Surface as e = _any(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.from;
}
fn placed_kind(t as *tst.Tree, s as i64) as i32 {
    let is *tst.Surface as e = _any(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.kind;
}
fn placed_grab(t as *tst.Tree, s as i64) as i32 {
    let is *tst.Surface as e = _any(t, s);
    if (cast(i64, e) == 0) { return 0; }
    return e.grab;
}
// Where an entry inside the window was put, window coordinates; a surface's
// is the host's (rect).
fn placed_rect(t as *tst.Tree, s as i64) as math.rect.Rect {
    let is *tst.Surface as e = _any(t, s);
    if (cast(i64, e) == 0) { return math.rect.rect_zero(); }
    return e.at;
}
fn placed_set_rect(t as *tst.Tree, s as i64, r as math.rect.Rect) as void {
    let is *tst.Surface as e = _any(t, s);
    if (cast(i64, e) == 0 || e.is_native == 1) { return; }
    e.at = r;
}

// Where the widget of surface s takes the pointer, window coordinates — its
// frame, not the shadow round it: what the host gives its window as its
// input region. 1 when that is new.
fn set_input(t as *tst.Tree, s as i64, r as math.rect.Rect) as i32 {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return 0; }
    if (e.input_set == 1 && e.input.x == r.x && e.input.y == r.y && e.input.w == r.w && e.input.h == r.h) { return 0; }
    e.input_set = 1;
    e.input = r;
    return 1;
}
// 1 and *r when the widget said where it takes the pointer; 0 for all of it.
fn input(t as *tst.Tree, s as i64, r as *math.rect.Rect) as i32 {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0 || e.input_set == 0) { return 0; }
    *r = e.input;
    return 1;
}

// Whether it holds a grab, as its window turned out: the host opened it
// without one where the platform refused it.
fn set_grab(t as *tst.Tree, s as i64, on as i32) as void {
    let is *tst.Surface as e = _shown(t, s);
    if (cast(i64, e) == 0) { return; }
    e.grab = on;
}
