// ui/signal.cst — what widgets tell the program: clicked, changed, toggled.
//
// A widget emits a signal; the program connects a callback to it — a function
// pointer and a user pointer — and is called synchronously, in the order the
// connections were made:
//
//     cb(tree *Tree, w i64, arg *u8, user *u8)
//
// arg is the signal's own payload, documented with the widget that emits it
// (a slider's new value, a list's selection), or null.
//
// Signals are numbers, not strings: no lookup by name, no generated code.
// The common ones are below; a widget kind defining its own numbers them from
// USER up.
//
// What happens when an emission changes things is decided, not left to the
// order of a loop:
//   - a connection made during an emission is not called by it;
//   - a connection disconnected during an emission is not called after;
//   - if a callback destroys the widget, the emission stops there.
//
// Connections live in the tree (see tree.Connection), in a table sized when
// the tree is opened. Those of a destroyed widget are reclaimed the next time
// the table runs out of room.
use "tree.cst" as tree;

let is i32 as CLICKED           with imut = 1;
let is i32 as CHANGED           with imut = 2;
let is i32 as ACTIVATED         with imut = 3;
let is i32 as TOGGLED           with imut = 4;
let is i32 as VALUE_CHANGED     with imut = 5;
let is i32 as SELECTION_CHANGED with imut = 6;
let is i32 as CLOSED            with imut = 7;
let is i32 as USER              with imut = 1000;

// Drops what can no longer be called — disconnected, or belonging to a
// destroyed widget — keeping the rest in order. Never during an emission,
// which is walking the same table.
fn _compact(t as *tree.Tree) as void {
    let is i64 as j with mut = 0;
    let is i64 as i with mut = 0;
    while (i < t.conn_used) {
        let is *tree.Connection as c = tree.connection_at(t, i);
        if (cast(i64, c.cb) != 0 && tree.is_valid(t, c.widget) == 1) {
            if (j != i) { *tree.connection_at(t, j) = *c; }
            j = j + 1;
        }
        i = i + 1;
    }
    t.conn_used = j;
}

// Connects cb to signal sig of widget w. Returns the connection's id for
// disconnect, or 0 with the tree's last_error set: INVALID_HANDLE for a stale
// widget, FULL when the table has no room even after reclaiming.
fn connect(t as *tree.Tree, w as i64, sig as i32, cb as tree.SignalFn, user as *u8) as i64 {
    if (tree.is_valid(t, w) == 0) { t.err = tree.INVALID_HANDLE; return 0; }
    if (t.conn_used >= t.conn_cap && t.emitting == 0) { _compact(t); }
    if (t.conn_used >= t.conn_cap) { t.err = tree.FULL; return 0; }
    let is *tree.Connection as c = tree.connection_at(t, t.conn_used);
    t.conn_seq = t.conn_seq + 1;
    c.widget = w;
    c.seq = t.conn_seq;
    c.made = t.emit_serial;
    c.cb = cb;
    c.user = user;
    c.signal = sig;
    c._pad0 = 0;
    t.conn_used = t.conn_used + 1;
    return c.seq;
}

// Disconnects by id. An id already disconnected, or never made, is ignored.
fn disconnect(t as *tree.Tree, id as i64) as void {
    if (id == 0) { return; }
    let is i64 as i with mut = 0;
    while (i < t.conn_used) {
        let is *tree.Connection as c = tree.connection_at(t, i);
        if (c.seq == id) {
            c.cb = cast(tree.SignalFn, 0);
            return;
        }
        i = i + 1;
    }
}

// Calls every callback connected to signal sig of w, in connection order.
// Returns how many were called.
fn emit(t as *tree.Tree, w as i64, sig as i32, arg as *u8) as i64 {
    if (tree.is_valid(t, w) == 0) { return 0; }
    t.emit_serial = t.emit_serial + 1;
    let is i64 as serial = t.emit_serial;
    t.emitting = t.emitting + 1;
    let is i64 as called with mut = 0;
    let is i64 as i with mut = 0;
    while (i < t.conn_used) {
        let is *tree.Connection as c = tree.connection_at(t, i);
        if (cast(i64, c.cb) != 0 && c.widget == w && c.signal == sig && c.made < serial) {
            call(c.cb, t, w, arg, c.user);
            called = called + 1;
            if (tree.is_valid(t, w) == 0) {
                t.emitting = t.emitting - 1;
                return called;
            }
        }
        i = i + 1;
    }
    t.emitting = t.emitting - 1;
    return called;
}
