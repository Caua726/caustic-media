// ui/event.cst — what the toolkit delivers to a widget.
//
// The toolkit's own event, not input/'s. input/ reports what the platform said
// — a key went down, the pointer is here. This adds what only the toolkit
// knows: which widget the event is aimed at, where it is in that widget's
// coordinates, whether it is on its way up the tree, how many clicks this
// press makes. router.cst builds these from the calls input/ makes into it.
//
// A widget kind receives them through its `event` entry and returns 1 when it
// handled one, which stops it travelling further.

// --- Kinds ---
let is i32 as POINTER_MOVE      with imut = 1;
let is i32 as POINTER_DOWN      with imut = 2;
let is i32 as POINTER_UP        with imut = 3;
let is i32 as POINTER_ENTER     with imut = 4;   // to each widget newly under the pointer
let is i32 as POINTER_LEAVE     with imut = 5;
let is i32 as SCROLL            with imut = 6;
let is i32 as DRAG_START        with imut = 7;   // the captor's press moved past the threshold
let is i32 as KEY_DOWN          with imut = 8;
let is i32 as KEY_UP            with imut = 9;
let is i32 as TEXT              with imut = 10;
let is i32 as FOCUS_IN          with imut = 11;
let is i32 as FOCUS_OUT         with imut = 12;
let is i32 as CONTEXT_MENU      with imut = 13;  // button 3: a right click; 1: a long press; 0: a key
let is i32 as ACTIVATE          with imut = 14;  // a mnemonic chose this widget
let is i32 as SHORTCUT_OVERRIDE with imut = 15;  // "do you want this key before the window's shortcuts?"
let is i32 as REVEAL            with imut = 16;  // bring x, y, width, height into view; every ancestor hears it
let is i32 as POINTER_CANCEL    with imut = 17;  // to the captor: the press ended without a click
let is i32 as PASTE             with imut = 18;  // text asked of the clipboard (which), to what asked
let is i32 as PREEDIT           with imut = 19;  // the input method's composition, its caret at cursor; empty: over
let is i32 as FOCUS_ENTER       with imut = 20;  // the focus came to something inside it, from related
let is i32 as FOCUS_LEAVE       with imut = 21;  // the focus left everything inside it, for related

// --- Phases ---
//
// TARGET is the widget the event was aimed at; BUBBLE is each ancestor it
// reaches after nobody below handled it. Events that are about one widget —
// entering, leaving, focus — only ever arrive at TARGET.
let is i32 as TARGET with imut = 0;
let is i32 as BUBBLE with imut = 1;

struct Event {
    kind     as i32;
    phase    as i32;
    button   as i32;   // 1 left, 2 middle, 3 right
    clicks   as i32;   // POINTER_DOWN: 1, 2, 3 for single, double, triple
    mods     as i32;   // window/keys.cst MOD_* bits
    key      as i32;   // window/keys.cst key
    repeat   as i32;   // KEY_DOWN generated by holding the key
    discrete as i32;   // SCROLL in notches rather than continuous
    x        as f64;   // window coordinates, logical pixels
    y        as f64;
    local_x  as f64;   // relative to the widget receiving it
    local_y  as f64;
    dx       as f64;   // SCROLL amounts
    dy       as f64;
    width    as f64;   // REVEAL: the rectangle at x, y
    height   as f64;
    time     as i64;   // milliseconds, from the platform's clock
    target   as i64;   // the widget it was aimed at
    related  as i64;   // ENTER/LEAVE, FOCUS_IN/OUT: the widget on the other side
    text     as *u8;   // TEXT, PASTE, PREEDIT: UTF-8, not terminated
    text_len as i64;
    cursor   as i64;   // PREEDIT: the composition's caret, a byte offset in it
    which    as i32;   // PASTE: tree.CLIPBOARD or tree.PRIMARY; FOCUS_IN: 1 when by keyboard
    _pad0    as i32;
}

fn make(kind as i32, time as i64) as Event {
    let is Event as e;
    e.kind = kind;
    e.phase = TARGET;
    e.button = 0;
    e.clicks = 0;
    e.mods = 0;
    e.key = 0;
    e.repeat = 0;
    e.discrete = 0;
    e.x = 0.0;
    e.y = 0.0;
    e.local_x = 0.0;
    e.local_y = 0.0;
    e.dx = 0.0;
    e.dy = 0.0;
    e.width = 0.0;
    e.height = 0.0;
    e.time = time;
    e.target = 0;
    e.related = 0;
    e.text = cast(*u8, 0);
    e.text_len = 0;
    e.cursor = 0;
    e.which = 0;
    e._pad0 = 0;
    return e;
}
