// ui/dirmodel_test.cst — a folder's entries as a flat model: folders first,
// then by name with case aside; their size and when they changed; hidden ones
// and those a filter leaves out; read again on another path.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "model.cst" as model;
use "dirmodel.cst" as dirmodel;
use "strings.cst" as strings;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

// --- A scratch folder: /tmp/caustic-dir-<pid> ---

let is [256]u8 as root with mut;
let is [512]u8 as path with mut;

fn at(rel as *u8) as *u8 {
    let is i64 as n = len(cast(*u8, &root));
    mem.memcpy(cast(*u8, &path), cast(*u8, &root), n);
    path[n] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &path) + n + 1), rel, len(rel) + 1);
    return cast(*u8, &path);
}

fn file(rel as *u8, size as i64) as void {
    let is i64 as fd = linux.open(at(rel), 577, 420);   // O_WRONLY|O_CREAT|O_TRUNC, 0644
    let is [4096]u8 as zeros;
    mem.memset(cast(*u8, &zeros), 120, 4096);
    let is i64 as left with mut = size;
    while (left > 0) {
        let is i64 as k with mut = left;
        if (k > 4096) { k = 4096; }
        linux.write(fd, cast(*u8, &zeros), k);
        left = left - k;
    }
    linux.close(fd);
}

fn digits(v as i64, out as *u8) as i64 {
    let is [24]u8 as tmp;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    while (x > 0) {
        tmp[n] = cast(u8, 48 + x % 10);
        n = n + 1;
        x = x / 10;
    }
    let is i64 as k with mut = 0;
    while (n > 0) {
        n = n - 1;
        out[k] = tmp[n];
        k = k + 1;
    }
    return k;
}

//   sub/            zdir/
//   A.md   2000     b.txt  3     c.TXT  0     .hidden 1
fn made() as void {
    let is *u8 as base = "/tmp/caustic-dir-";
    let is i64 as bn = len(base);
    mem.memcpy(cast(*u8, &root), base, bn);
    let is i64 as k = digits(linux.getpid(), cast(*u8, cast(i64, &root) + bn));
    root[bn + k] = cast(u8, 0);
    linux.mkdir(cast(*u8, &root), 493);
    linux.mkdir(at("sub"), 493);
    linux.mkdir(at("zdir"), 493);
    file("A.md", 2000);
    file("b.txt", 3);
    file("c.TXT", 0);
    file(".hidden", 1);
    file("big.bin", 1500000);
}

fn unmade() as void {
    linux.unlink(at("A.md"));
    linux.unlink(at("b.txt"));
    linux.unlink(at("c.TXT"));
    linux.unlink(at(".hidden"));
    linux.unlink(at("big.bin"));
    linux.rmdir(at("sub"));
    linux.rmdir(at("zdir"));
    linux.rmdir(cast(*u8, &root));
}

// The names in order, joined by spaces, as one text.
let is [512]u8 as names with mut;

fn listed(d as *dirmodel.Dir) as *u8 {
    let is *model.Model as m = dirmodel.model_of(d);
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    while (i < model.count(m, 0)) {
        let is model.Value as v;
        model.cell(m, model.row_id(m, 0, i), 0, model.TEXT, &v);
        if (i > 0) {
            names[k] = cast(u8, 32);
            k = k + 1;
        }
        mem.memcpy(cast(*u8, cast(i64, &names) + k), v.p, v.len);
        k = k + v.len;
        i = i + 1;
    }
    names[k] = cast(u8, 0);
    return cast(*u8, &names);
}

fn says(d as *dirmodel.Dir, s as *u8) as i32 {
    let is *u8 as got = listed(d);
    return same(got, len(got), s);
}

let is i64 as resets with mut = 0;

fn on_change(user as *u8, c as *model.Change) as void {
    if (c.kind == model.RESET) { resets = resets + 1; }
}

fn cell_is(d as *dirmodel.Dir, index as i64, column as i64, s as *u8) as i32 {
    let is *model.Model as m = dirmodel.model_of(d);
    let is model.Value as v;
    model.cell(m, model.row_id(m, 0, index), column, model.TEXT, &v);
    return cast(i32, v.kind == model.V_TEXT && same(v.p, v.len, s) == 1);
}

fn sort_of(d as *dirmodel.Dir, index as i64, column as i64) as i64 {
    let is *model.Model as m = dirmodel.model_of(d);
    let is model.Value as v;
    model.cell(m, model.row_id(m, 0, index), column, model.SORT, &v);
    return v.i;
}

fn listing() as void {
    let is *dirmodel.Dir as d = dirmodel.open(cast(*u8, &root), len(cast(*u8, &root)));
    let is *model.Model as m = dirmodel.model_of(d);
    model.observe(m, fn_ptr(on_change), cast(*u8, 0));
    check("folders first, then by name, case aside; hidden ones not", says(d, "sub zdir A.md b.txt big.bin c.TXT") == 1 &&
          model.columns(m) == 3);
    check("which are folders", dirmodel.is_dir(d, 0) == 1 && dirmodel.is_dir(d, 1) == 1 && dirmodel.is_dir(d, 2) == 0 &&
          dirmodel.is_dir(d, 9) == 0);
    check("their sizes", cell_is(d, 3, 1, "3 bytes") == 1 && cell_is(d, 2, 1, "2.0 kB") == 1 && cell_is(d, 4, 1, "1.5 MB") == 1 &&
          cell_is(d, 5, 1, "0 bytes") == 1 && cell_is(d, 0, 1, "") == 1);
    dirmodel.set_language(d, strings.PT_BR);
    check("in the language set", cell_is(d, 2, 1, "2,0 kB") == 1 && cell_is(d, 4, 1, "1,5 MB") == 1);
    dirmodel.set_language(d, strings.EN);
    check("sorted by their bytes", sort_of(d, 2, 1) == 2000 && sort_of(d, 3, 1) == 3 && sort_of(d, 0, 1) == 0 - 1);
    let is model.Value as when;
    model.cell(m, model.row_id(m, 0, 2), 2, model.TEXT, &when);
    check("when they changed: a date and a time", when.kind == model.V_TEXT && when.len == 16 && when.p[4] == cast(u8, 45) &&
          when.p[10] == cast(u8, 32) && when.p[13] == cast(u8, 58) && sort_of(d, 2, 2) > 1700000000);
    check("no such column: nothing", model.cell(m, model.row_id(m, 0, 2), 3, model.TEXT, &when) == 0);
    // Icons, once the program says which.
    let is model.Value as icon;
    check("no icons at first", model.cell(m, model.row_id(m, 0, 0), 0, model.ICON, &icon) == 0);
    dirmodel.set_icons(d, 17, 18);
    model.cell(m, model.row_id(m, 0, 0), 0, model.ICON, &icon);
    check("a folder's icon by its name", icon.kind == model.V_INT && icon.i == 17);
    model.cell(m, model.row_id(m, 0, 2), 0, model.ICON, &icon);
    check("a file's", icon.kind == model.V_INT && icon.i == 18);
    check("by its name only", model.cell(m, model.row_id(m, 0, 2), 1, model.ICON, &icon) == 0 &&
          model.cell(m, model.row_id(m, 0, 2), 2, model.ICON, &icon) == 0);
    dirmodel.set_icons(d, 0, 0);
    check("none again", model.cell(m, model.row_id(m, 0, 0), 0, model.ICON, &icon) == 0);
    // A whole path, and a name's place.
    let is [512]u8 as full;
    let is i64 as fn_ = dirmodel.full_path(d, 3, cast(*u8, &full), 512);
    check("a row's whole path", same(cast(*u8, &full), fn_, at("b.txt")) == 1);
    let is i64 as first = dirmodel.full_path(d, 0, cast(*u8, &full), 512);
    check("the first row's, and none past the last", same(cast(*u8, &full), first, at("sub")) == 1 &&
          dirmodel.full_path(d, 6, cast(*u8, &full), 512) == 0);
    check("a name's place", dirmodel.index_of_name(d, "c.TXT", 5) == 5 && dirmodel.index_of_name(d, "nope", 4) == 0 - 1 &&
          dirmodel.index_of_name(d, "", 0) == 0 - 1);
    // Hidden ones shown.
    resets = 0;
    dirmodel.set_hidden(d, 1);
    check("hidden ones too, said", says(d, "sub zdir .hidden A.md b.txt big.bin c.TXT") == 1 && resets == 1);
    dirmodel.set_hidden(d, 0);
    // A filter: folders always, files that match, case aside.
    dirmodel.set_filter(d, "*.txt", 5);
    check("filtered", says(d, "sub zdir b.txt c.TXT") == 1);
    dirmodel.set_filter(d, "*.md;*.bin", 10);
    check("two patterns", says(d, "sub zdir A.md big.bin") == 1);
    dirmodel.set_filter(d, "b*", 2);
    check("a pattern starting so", says(d, "sub zdir b.txt big.bin") == 1);
    dirmodel.set_filter(d, "", 0);
    check("no filter: all", says(d, "sub zdir A.md b.txt big.bin c.TXT") == 1);
    dirmodel.set_folders_only(d, 1);
    check("folders only", says(d, "sub zdir") == 1);
    dirmodel.set_folders_only(d, 0);
    check("and files again", says(d, "sub zdir A.md b.txt big.bin c.TXT") == 1);
    // Another path; up; one there is not.
    check("into a folder: empty", dirmodel.set_path(d, at("sub"), len(at("sub"))) == 1 && model.count(m, 0) == 0);
    check("its path", same(dirmodel.path(d), dirmodel.path_length(d), at("sub")) == 1);
    check("up again", dirmodel.up(d) == 1 && says(d, "sub zdir A.md b.txt big.bin c.TXT") == 1 &&
          same(dirmodel.path(d), dirmodel.path_length(d), cast(*u8, &root)) == 1);
    resets = 0;
    check("one there is not: as it was, nothing said", dirmodel.set_path(d, "/no/such/place", 14) == 0 &&
          model.count(m, 0) == 6 && resets == 0);
    dirmodel.set_path(d, "/", 1);
    check("the top: up goes nowhere", dirmodel.up(d) == 0 && same(dirmodel.path(d), 1, "/") == 1);
    dirmodel.set_path(d, cast(*u8, &root), len(cast(*u8, &root)));
    check("read again", dirmodel.reload(d) == 1 && model.count(m, 0) == 6);
    dirmodel.close(d);
    check("not one there: nothing", cast(i64, dirmodel.open("/no/such/place", 14)) == 0);
}

fn text_is(out as *u8, n as i64, s as *u8) as i32 { return same(out, n, s); }

// Sizes and dates as a person reads them.
fn texts() as void {
    let is [32]u8 as b;
    let is *u8 as o = cast(*u8, &b);
    check("no bytes", text_is(o, dirmodel.size_text(0, strings.EN, o), "0 bytes") == 1);
    check("a byte", text_is(o, dirmodel.size_text(1, strings.EN, o), "1 byte") == 1);
    check("999 bytes", text_is(o, dirmodel.size_text(999, strings.EN, o), "999 bytes") == 1);
    check("a thousand: a kB", text_is(o, dirmodel.size_text(1000, strings.EN, o), "1.0 kB") == 1);
    check("rounded to a tenth", text_is(o, dirmodel.size_text(1049, strings.EN, o), "1.0 kB") == 1 && text_is(o, dirmodel.size_text(1050, strings.EN, o), "1.1 kB") == 1);
    check("12.3 kB", text_is(o, dirmodel.size_text(12345, strings.EN, o), "12.3 kB") == 1);
    check("a million: an MB", text_is(o, dirmodel.size_text(1000000, strings.EN, o), "1.0 MB") == 1);
    check("a thousand million: a GB", text_is(o, dirmodel.size_text(1000000000, strings.EN, o), "1.0 GB") == 1 &&
          text_is(o, dirmodel.size_text(25600000000, strings.EN, o), "25.6 GB") == 1);
    check("in Portuguese: its decimal mark", text_is(o, dirmodel.size_text(1500, strings.PT_BR, o), "1,5 kB") == 1 &&
          text_is(o, dirmodel.size_text(3, strings.PT_BR, o), "3 bytes") == 1 &&
          text_is(o, dirmodel.size_text(1, strings.PT_BR, o), "1 byte") == 1);
    check("the start of 1970", text_is(o, dirmodel.date_text(0, o), "1970-01-01 00:00") == 1);
    check("a leap day", text_is(o, dirmodel.date_text(951782400 + 3600 * 13 + 60 * 7, o), "2000-02-29 13:07") == 1);
    check("the last minute of a year", text_is(o, dirmodel.date_text(1704067140, o), "2023-12-31 23:59") == 1);
    check("the first of March after a leap day", text_is(o, dirmodel.date_text(1709251200, o), "2024-03-01 00:00") == 1);
    check("before 1970", text_is(o, dirmodel.date_text(0 - 60, o), "1969-12-31 23:59") == 1);
    check("in 2100, no leap day that year", text_is(o, dirmodel.date_text(4102444800, o), "2100-01-01 00:00") == 1 &&
          text_is(o, dirmodel.date_text(4107542400, o), "2100-03-01 00:00") == 1);
    check("the first of January", text_is(o, dirmodel.date_text(1735689600, o), "2025-01-01 00:00") == 1);
}

// Patterns, orders, many entries, paths at the top.
fn edges() as void {
    let is *dirmodel.Dir as d = dirmodel.open(cast(*u8, &root), len(cast(*u8, &root)));
    dirmodel.set_filter(d, "b?t.*", 5);
    check("one of any letter", says(d, "sub zdir") == 1);
    dirmodel.set_filter(d, "b?g.*", 5);
    check("one of any letter, matching", says(d, "sub zdir big.bin") == 1);
    dirmodel.set_filter(d, "*.*n", 4);
    check("a star, then more: tried along", says(d, "sub zdir big.bin") == 1);
    dirmodel.set_filter(d, "*b*", 3);
    check("stars at both ends", says(d, "sub zdir b.txt big.bin") == 1);
    dirmodel.set_filter(d, "a*d", 3);
    check("a star between", says(d, "sub zdir A.md") == 1);
    dirmodel.set_filter(d, "*.md;;  *.TXT", 13);
    check("empty patterns between the separators: nothing for them", says(d, "sub zdir A.md b.txt c.TXT") == 1);
    dirmodel.set_filter(d, "*.TXT*", 6);
    check("a star at the end, after the whole name", says(d, "sub zdir b.txt c.TXT") == 1);
    dirmodel.set_filter(d, "*t*", 3);
    dirmodel.set_filter(d, "*t", 2);
    check("only its own bytes: not a star left after them", says(d, "sub zdir b.txt c.TXT") == 1);
    dirmodel.set_filter(d, "*x", 2);
    check("a star, and a letter not at the end", says(d, "sub zdir") == 1);
    dirmodel.set_filter(d, "**", 2);
    check("two stars: all", says(d, "sub zdir A.md b.txt big.bin c.TXT") == 1);
    dirmodel.set_filter(d, "b**", 3);
    check("stars left at the pattern's end", says(d, "sub zdir b.txt big.bin") == 1);
    file("zz.Z", 0);
    dirmodel.set_filter(d, "*.z", 3);
    check("Z, case aside", says(d, "sub zdir zz.Z") == 1);
    linux.unlink(at("zz.Z"));
    dirmodel.set_filter(d, "", 0);
    check("names, accessors past the end", dirmodel.count(d) == 6 && dirmodel.name_length(d, 2) == 4 &&
          dirmodel.name_length(d, 0) == 3 &&
          same(dirmodel.name(d, 2), 4, "A.md") == 1 && cast(i64, dirmodel.name(d, 6)) == 0 && dirmodel.name_length(d, 0 - 1) == 0 &&
          dirmodel.is_dir(d, 0 - 1) == 0 && dirmodel.index_of_name(d, "A.m", 3) == 0 - 1);
    let is [8]u8 as tiny;
    check("a whole path that does not fit: none", dirmodel.full_path(d, 3, cast(*u8, &tiny), 8) == 0 &&
          dirmodel.full_path(d, 9, cast(*u8, &tiny), 8) == 0 && dirmodel.full_path(d, dirmodel.count(d), cast(*u8, &tiny), 8) == 0);
    let is [512]u8 as exact;
    let is i64 as want = len(cast(*u8, &root)) + 1 + 5;
    check("one that just fits", dirmodel.full_path(d, 3, cast(*u8, &exact), want) == want &&
          dirmodel.full_path(d, 3, cast(*u8, &exact), want - 1) == 0);
    let is *model.Model as m = dirmodel.model_of(d);
    let is model.Value as v;
    check("no row there: nothing", model.cell(m, 0, 0, model.TEXT, &v) == 0 && model.cell(m, 7, 0, model.TEXT, &v) == 0 &&
          model.row_id(m, 0, 6) == 0 && model.row_id(m, 0, 0 - 1) == 0 && model.row_id(m, 1, 0) == 0 && model.count(m, 1) == 0 &&
          model.index_of(m, 3) == 2 && model.index_of(m, 0) == 0 - 1 && model.index_of(m, 7) == 0 - 1 &&
          model.index_of(m, 1) == 0 && model.index_of(m, 6) == 5);
    check("other roles: nothing", model.cell(m, 3, 0, model.SORT, &v) == 0 && model.cell(m, 3, 1, model.ICON, &v) == 0 &&
          model.cell(m, 3, 2, model.ICON, &v) == 0);
    // Trailing slashes, and the top.
    let is [512]u8 as slashed;
    let is i64 as rn = len(cast(*u8, &root));
    mem.memcpy(cast(*u8, &slashed), cast(*u8, &root), rn);
    slashed[rn] = cast(u8, 47);
    slashed[rn + 1] = cast(u8, 47);
    slashed[rn + 2] = cast(u8, 47);
    check("slashes at its end: left off", dirmodel.set_path(d, cast(*u8, &slashed), rn + 3) == 1 &&
          same(dirmodel.path(d), dirmodel.path_length(d), cast(*u8, &root)) == 1);
    dirmodel.set_path(d, "/tmp", 4);
    let is [512]u8 as full;
    let is i64 as k = dirmodel.index_of_name(d, cast(*u8, cast(i64, &root) + 5), rn - 5);
    let is i64 as fl = dirmodel.full_path(d, k, cast(*u8, &full), 512);
    check("one under /tmp", k >= 0 && same(cast(*u8, &full), fl, cast(*u8, &root)) == 1);
    check("up from /tmp: the top", dirmodel.up(d) == 1 && same(dirmodel.path(d), dirmodel.path_length(d), "/") == 1);
    let is i64 as ti = dirmodel.index_of_name(d, "tmp", 3);
    let is i64 as tl = dirmodel.full_path(d, ti, cast(*u8, &full), 512);
    check("at the top, a whole path with one slash", same(cast(*u8, &full), tl, "/tmp") == 1);
    dirmodel.close(d);
    dirmodel.close(cast(*dirmodel.Dir, 0));
    check("no path: none", cast(i64, dirmodel.open("/", 0)) == 0);
}

// Many entries, and names that tie but for their case or length.
fn many() as void {
    let is [256]u8 as name;
    let is i64 as j with mut = 0;
    while (j < 80) {
        // Made out of order, so that sorting has both halves left over.
        let is i64 as i = (j * 37) % 80;
        let is *u8 as p = cast(*u8, &name);
        p[0] = cast(u8, 102);   // f
        p[1] = cast(u8, 48 + i / 10);
        p[2] = cast(u8, 48 + i % 10);
        // Long names, past the first room for them.
        let is i64 as k with mut = 3;
        while (k < 60) {
            p[k] = cast(u8, 120);
            k = k + 1;
        }
        p[60] = cast(u8, 0);
        file(cast(*u8, &name), 0);
        j = j + 1;
    }
    file("ab", 0);
    file("Ab", 0);
    file("abc", 0);
    file("ab0", 0);
    // The other way round as well: which of the two the merge holds first
    // follows the order they were made in.
    file("cd0", 0);
    file("cd", 0);
    let is *dirmodel.Dir as d = dirmodel.open(cast(*u8, &root), len(cast(*u8, &root)));
    let is i64 as i with mut = 0;
    check("ninety, all kept", dirmodel.count(d) == 92);
    // "ab" against "ab0": the shorter first, whatever follows its bytes.
    check("case aside, then its bytes; shorter first", same(dirmodel.name(d, 3), 2, "Ab") == 1 && same(dirmodel.name(d, 4), 2, "ab") == 1 &&
          same(dirmodel.name(d, 5), 3, "ab0") == 1 && same(dirmodel.name(d, 6), 3, "abc") == 1 &&
          same(dirmodel.name(d, 10), 2, "cd") == 1 && same(dirmodel.name(d, 11), 3, "cd0") == 1);
    let is i32 as ordered with mut = 1;
    i = 0;
    while (i < 80) {
        let is *u8 as n = dirmodel.name(d, 12 + i);
        if (n[1] != cast(u8, 48 + i / 10) || n[2] != cast(u8, 48 + i % 10)) { ordered = 0; }
        i = i + 1;
    }
    check("the eighty in order", ordered == 1);
    dirmodel.close(d);
    i = 0;
    while (i < 80) {
        let is *u8 as p = cast(*u8, &name);
        p[1] = cast(u8, 48 + i / 10);
        p[2] = cast(u8, 48 + i % 10);
        linux.unlink(at(cast(*u8, &name)));
        i = i + 1;
    }
    linux.unlink(at("ab"));
    linux.unlink(at("Ab"));
    linux.unlink(at("abc"));
    linux.unlink(at("ab0"));
    linux.unlink(at("cd0"));
    linux.unlink(at("cd"));
}

// A copy of at(rel), its length.
fn kept(rel as *u8, out as *u8) as i64 {
    let is *u8 as p = at(rel);
    let is i64 as n = len(p);
    mem.memcpy(out, p, n + 1);
    return n;
}

// The folder q under the root, as a path total bytes long: slashes before it.
fn padded(total as i64, out as *u8) as i64 {
    let is *u8 as p = at("q");
    let is i64 as n = len(p);
    mem.memset(out, 47, total - n);
    mem.memcpy(cast(*u8, cast(i64, out) + total - n), p, n);
    return total;
}

// A folder one letter long, names longer than a record's first byte counts,
// a folder that can be read but not searched, paths near the longest, and up
// from a path shorter than the one before.
fn more() as void {
    linux.mkdir(at("q"), 493);
    file("q/f", 3);
    let is [256]u8 as long;
    long[0] = cast(u8, 76);
    let is i64 as i with mut = 1;
    while (i < 250) {
        long[i] = cast(u8, 121);
        i = i + 1;
    }
    long[250] = cast(u8, 0);
    let is [300]u8 as rel;
    rel[0] = cast(u8, 113);
    rel[1] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &rel) + 2), cast(*u8, &long), 251);
    file(cast(*u8, &rel), 0);
    linux.mkdir(at("qq"), 493);
    linux.mkdir(at("qq/r"), 493);
    linux.mkdir(at("lk"), 493);
    linux.mkdir(at("lk/inner"), 493);
    file("lk/f", 0);
    let is [512]u8 as q;
    let is i64 as qn = kept("q", cast(*u8, &q));
    let is *dirmodel.Dir as d = dirmodel.open(cast(*u8, &q), qn);
    check("in a folder one letter long: what stat says", dirmodel.count(d) == 2 && cell_is(d, 0, 1, "3 bytes") == 1);
    check("a name past 237 bytes: its record over 255", dirmodel.name_length(d, 1) == 250 &&
          same(dirmodel.name(d, 1), 250, cast(*u8, &long)) == 1);
    // Up from a path shorter than the one before: only its own bytes.
    let is [512]u8 as qr;
    let is i64 as qrn = kept("qq/r", cast(*u8, &qr));
    dirmodel.set_path(d, cast(*u8, &qr), qrn);
    dirmodel.set_path(d, cast(*u8, &q), qn);
    check("up from it", dirmodel.up(d) == 1 && same(dirmodel.path(d), dirmodel.path_length(d), cast(*u8, &root)) == 1);
    // Read, not searched: stat says nothing, the entries' types still tell.
    let is [512]u8 as lk;
    let is i64 as lkn = kept("lk", cast(*u8, &lk));
    linux.chmod(cast(*u8, &lk), 292);
    check("not searched: folders first all the same", dirmodel.set_path(d, cast(*u8, &lk), lkn) == 1 &&
          says(d, "inner f") == 1 && dirmodel.is_dir(d, 0) == 1 && dirmodel.is_dir(d, 1) == 0);
    linux.chmod(cast(*u8, &lk), 493);
    // Paths near the longest: an entry's whole path has to fit as well.
    let is [4200]u8 as big;
    check("a path of 4093 bytes, and its entry", dirmodel.set_path(d, cast(*u8, &big), padded(4093, cast(*u8, &big))) == 1 &&
          says(d, "f") == 1);
    check("4094: its entries' paths would not fit", dirmodel.set_path(d, cast(*u8, &big), padded(4094, cast(*u8, &big))) == 1 &&
          dirmodel.count(d) == 0);
    check("4095: not read", dirmodel.set_path(d, cast(*u8, &big), padded(4095, cast(*u8, &big))) == 0);
    dirmodel.close(d);
    linux.unlink(at("lk/f"));
    linux.rmdir(at("lk/inner"));
    linux.rmdir(at("lk"));
    linux.rmdir(at("qq/r"));
    linux.rmdir(at("qq"));
    linux.unlink(at(cast(*u8, &rel)));
    linux.unlink(at("q/f"));
    linux.rmdir(at("q"));
}

fn main() as i32 {
    made();
    listing();
    texts();
    edges();
    many();
    more();
    unmade();

    if (fails == 0) {
        io.printf("dirmodel: %d checks passed\n", checks);
        return 0;
    }
    io.printf("dirmodel: %d of %d checks failed\n", fails, checks);
    return 1;
}
