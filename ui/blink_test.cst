// ui/blink_test.cst — a text caret blinks while something takes typing.
//
// The router keeps the blink: restarted by each key, text, composition,
// paste, press and change of focus; on for two thirds of the desktop's
// cycle and off for the rest, as GTK draws it; due to change at a time the
// loop wakes for, when the router asks for the widget typed into to be
// drawn again. A while after the last input it stays on: a caret blinking
// in a window nobody types into would keep the machine awake.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "event.cst" as event;
use "router.cst" as router;
use "box.cst" as box;
use "damage.cst" as damage;
use "../input/keys.cst" as keys;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn probe_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = 100.0;
    out.pref_h = 40.0;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// Takes typing while it has the focus: says so through the text area.
fn typed_into(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.kind == event.FOCUS_IN) { tree.set_text_area(t, w, math.rect.rect(1.0, 2.0, 1.0, 10.0)); }
    if (e.kind == event.FOCUS_OUT) { tree.set_text_area(t, 0, math.rect.rect_zero()); }
    if (e.kind == event.POINTER_DOWN) { return 1; }
    return 0;
}

// Where its caret is, as a text widget's kind says: what to draw again.
fn caret_at(t as *tree.Tree, w as i64, data as *u8, out as *math.rect.Rect) as i32 {
    *out = math.rect.rect(5.0, 3.0, 4.0, 12.0);
    return 1;
}

fn main() as i32 {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is tree.Kind as typing = widget.kind("typing", 8);
    typing.measure = fn_ptr(probe_measure);
    typing.event = fn_ptr(typed_into);
    let is tree.Kind as plain = widget.kind("plain", 8);
    plain.measure = fn_ptr(probe_measure);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    let is i64 as w = tree.create(&t, &typing, col);
    let is i64 as other = tree.create(&t, &plain, col);
    tree.set_focusable(&t, w, 1);
    tree.set_focusable(&t, other, 1);
    layout.run(&t, 300.0, 200.0);
    let is router.Router as r = router.init(router.settings_default());
    check("the desktop's cycle; a while to stop after",
          r.settings.caret_blink_ms == 1200 && r.settings.caret_blink_timeout_ms == 10000);
    router.key(&t, &r, keys.A, 0, 1, 0, 100);
    check("nothing typed into: never off, nothing due", router.caret_off(&r, 1000) == 0 && router.next_due(&r) == 0 - 1);

    // Focused: on for two thirds of the cycle, off for the third.
    router.focus(&t, &r, w, 1);
    check("on at first", router.caret_off(&r, 100) == 0 && router.caret_off(&r, 899) == 0);
    check("off for the last third", router.caret_off(&r, 900) == 1 && router.caret_off(&r, 1299) == 1);
    check("on again", router.caret_off(&r, 1300) == 0 && router.caret_off(&r, 2099) == 0 &&
          router.caret_off(&r, 2100) == 1);
    check("never before it started", router.caret_off(&r, 50) == 0);
    check("due when it goes off", router.next_due(&r) == 900);
    damage.collect(&t);
    tree.damage_clear(&t);
    check("not yet", router.tick(&t, &r, 899) == 0 && tree.blinked(&t) == 0);
    check("then: drawn again", router.tick(&t, &r, 900) == 1 && tree.blinked(&t) == w);
    check("due when it comes on", router.next_due(&r) == 1300);
    // What is drawn again: the widget, its kind saying nothing of its caret.
    damage.collect(&t);
    let is math.rect.Rect as all = layout.window_rect(&t, w);
    let is math.rect.Rect as d0 = tree.damage_at(&t, 0);
    check("the widget drawn again, all of it", tree.damage_count(&t) == 1 && d0.x == all.x && d0.y == all.y &&
          d0.w == all.w && d0.h == all.h);
    tree.damage_clear(&t);
    check("drawn: no blink owed", tree.blinked(&t) == 0);
    check("woken late: drawn, the next from then", router.tick(&t, &r, 1350) == 1 && tree.blinked(&t) == w &&
          router.next_due(&r) == 2100);
    // Its kind saying where its caret is: only that.
    typing.caret = fn_ptr(caret_at);
    damage.collect(&t);
    let is math.rect.Rect as d1 = tree.damage_at(&t, 0);
    check("only its caret drawn again", tree.damage_count(&t) == 1 && d1.x == 5.0 && d1.y == 3.0 && d1.w == 4.0 &&
          d1.h == 12.0);
    tree.damage_clear(&t);
    typing.caret = cast(tree.CaretFn, 0);

    // Each input starts it again, on.
    router.key(&t, &r, keys.A, 0, 1, 0, 2200);
    check("a key: on, from then", router.caret_off(&r, 2200) == 0 && router.next_due(&r) == 3000);
    router.key(&t, &r, keys.A, 0, 0, 0, 2300);
    check("its release: not", router.next_due(&r) == 3000);
    router.text(&t, &r, "x", 1, 2400);
    check("text", router.next_due(&r) == 3200);
    router.preedit(&t, &r, "x", 1, 1, 2500);
    check("a composition", router.next_due(&r) == 3300);
    router.paste(&t, &r, w, tree.CLIPBOARD, "x", 1, 2600);
    check("a paste", router.next_due(&r) == 3400);
    router.pointer_move(&t, &r, 10.0, 10.0, 2700);
    check("a move: not", router.next_due(&r) == 3400);
    router.pointer_button(&t, &r, 1, 1, 10.0, 10.0, 2800);
    router.pointer_button(&t, &r, 1, 0, 10.0, 10.0, 2810);
    check("a press", router.next_due(&r) == 3600);

    // Left alone, it stops — on.
    let is i64 as now with mut = 2800;
    let is i64 as ticks with mut = 0;
    while (router.next_due(&r) >= 0 && ticks < 100) {
        now = router.next_due(&r);
        router.tick(&t, &r, now);
        ticks = ticks + 1;
    }
    check("eight times off and on, then still", ticks == 16 && now == 2800 + 9600);
    check("on for good", router.caret_off(&r, now) == 0 && router.caret_off(&r, 2800 + 10000 + 900) == 0);
    // Stopped off: the end is due, to come on.
    r.settings.caret_blink_timeout_ms = 9400;
    router.key(&t, &r, keys.A, 0, 1, 0, 20000);
    now = 20000;
    ticks = 0;
    while (router.next_due(&r) >= 0 && ticks < 100) {
        now = router.next_due(&r);
        router.tick(&t, &r, now);
        ticks = ticks + 1;
    }
    check("ending off: on at the end", now == 29400 && router.caret_off(&r, now) == 0 && router.caret_off(&r, 29300) == 1);
    check("and only once more", ticks == 16);
    // Ending just as it would go off: it does not.
    r.settings.caret_blink_timeout_ms = 9200;
    router.key(&t, &r, keys.A, 0, 1, 0, 60000);
    now = 60000;
    ticks = 0;
    while (router.next_due(&r) >= 0 && ticks < 100) {
        now = router.next_due(&r);
        router.tick(&t, &r, now);
        ticks = ticks + 1;
    }
    check("ending as it would go off: not woken for it", ticks == 14 && now == 60000 + 8400);
    r.settings.caret_blink_timeout_ms = 0;
    router.key(&t, &r, keys.A, 0, 1, 0, 30000);
    check("no end: it goes on", router.caret_off(&r, 30000 + 120900) == 1 && router.next_due(&r) == 30800);
    r.settings.caret_blink_timeout_ms = 10000;

    // The focus elsewhere: nothing to blink.
    router.focus(&t, &r, other, 1);
    check("the focus on what takes no typing: nothing due", router.next_due(&r) == 0 - 1 &&
          router.caret_off(&r, 30900) == 0);
    router.focus(&t, &r, w, 1);
    check("back: from the time last known", router.next_due(&r) == 30800);
    // Nothing typed into any more, though focused: the tick finds out.
    tree.set_text_area(&t, 0, math.rect.rect_zero());
    router.tick(&t, &r, 30800);
    check("its text area given up: stopped", router.next_due(&r) == 0 - 1);
    tree.set_text_area(&t, w, math.rect.rect(1.0, 2.0, 1.0, 10.0));

    // A long press sooner: due first.
    router.set_source(&r, router.TOUCH);
    router.pointer_button(&t, &r, 1, 1, 10.0, 10.0, 40000);
    check("a long press first", router.next_due(&r) == 40500);
    router.pointer_button(&t, &r, 1, 0, 10.0, 10.0, 40010);
    check("then the caret", router.next_due(&r) == 40800);
    router.set_source(&r, router.MOUSE);

    // No blinking.
    r.settings.caret_blink_ms = 0;
    router.key(&t, &r, keys.A, 0, 1, 0, 50000);
    check("a caret that does not blink: never off, never due", router.caret_off(&r, 50900) == 0 &&
          router.next_due(&r) == 0 - 1);
    tree.close(&t);
    if (fails == 0) {
        io.printf("caret blink: all checks passed\n");
        return 0;
    }
    return 1;
}
