// ui/app_test.cst — the application, its windows, and what they share.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "router.cst" as router;
use "timer.cst" as timer;
use "anim.cst" as anim;
use "painter.cst" as painter;
use "paint.cst" as paint;
use "style.cst" as style;
use "app.cst" as app;
use "../gpu/gpu.cst" as gpu;
use "../render/draw2d.cst" as draw2d;
use "../render/shapes2d.cst" as shapes;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is i64 as destroyed with mut = 0;

fn counted_destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    destroyed = destroyed + 1;
}

let is tree.Kind as counted with mut;

fn filled_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    shapes.fill_rect(p.canvas, p.rect.x, p.rect.y, p.rect.w, p.rect.h, style.hex(0xFF0000));
}

let is tree.Kind as filled with mut;

let is i64 as fired with mut = 0;

fn on_timer(user as *u8) as void { fired = fired + 1; }

fn beam(t as *tree.Tree, w as i64, data as *u8, p as *math.vec.Vec2) as i32 { return tree.SHAPE_TEXT; }

fn same(a as math.rect.Rect, x as f64, y as f64, w as f64, h as f64) as i32 {
    if (a.x == x && a.y == y && a.w == w && a.h == h) { return 1; }
    return 0;
}

// Windows belonging to others: dialogs, modal, titled, asked for through a
// tree. An application of its own, with room for them.
fn test_dialogs() as void {
    let is app.Limits as l with mut = app.limits_default();
    l.windows = 8;
    let is app.App as a = app.open(&l);
    // The first slot freed, for the first dialog: a window there is named too.
    let is i64 as w0 = app.window_open(&a, 300.0, 200.0);
    let is i64 as w1 = app.window_open(&a, 300.0, 200.0);
    let is i64 as w2 = app.window_open(&a, 300.0, 200.0);
    let is i64 as w3 = app.window_open(&a, 300.0, 200.0);
    app.window_close(&a, w2);
    app.window_close(&a, w0);
    check("the first slot's window closed", app.window_valid(&a, w0) == 0);

    // --- Dialogs: windows belonging to another ---
    let is i64 as dw = app.dialog_open(&a, w1, 200.0, 100.0);
    check("a dialog window: open, belonging to its owner", dw != 0 && app.owner(&a, dw) == w1 &&
          app.is_dialog(&a, dw) == 1);
    check("a window of its own: no owner, not a dialog, shown", app.owner(&a, w1) == 0 && app.is_dialog(&a, w1) == 0 &&
          app.is_shown(&a, w1) == 1);
    check("a dialog: hidden until shown, not modal", app.is_shown(&a, dw) == 0 && app.is_modal(&a, dw) == 0);
    check("a dialog's size", app.window_state(&a, dw).width == 200.0 && app.window_state(&a, dw).height == 100.0);
    check("a stale owner: none", app.dialog_open(&a, w2, 10.0, 10.0) == 0 && app.last_error(&a) == app.INVALID_HANDLE);
    check("its tree's window", app.window_of(&a, app.tree(&a, dw)) == dw && app.window_of(&a, app.tree(&a, w1)) == w1);
    let is tree.Tree as loose = tree.open(&l.tree);
    check("a tree of no window", app.window_of(&a, &loose) == 0);
    tree.close(&loose);
    app.set_modal(&a, dw, 1);
    check("modal, hidden: its owner goes on", app.is_modal(&a, dw) == 1 && app.blocked(&a, w1) == 0);
    app.show(&a, dw);
    check("shown modal: its owner's input waits", app.is_shown(&a, dw) == 1 && app.blocked(&a, w1) == 1 &&
          app.blocked(&a, dw) == 0);
    check("another window goes on", app.blocked(&a, w3) == 0);
    let is i64 as dw2 = app.dialog_open(&a, dw, 100.0, 50.0);
    app.set_modal(&a, dw2, 1);
    app.show(&a, dw2);
    check("a dialog's modal dialog: both under it wait", app.blocked(&a, dw) == 1 && app.blocked(&a, w1) == 1 &&
          app.blocked(&a, dw2) == 0);
    app.hide(&a, dw2);
    check("hidden: back to the first", app.blocked(&a, dw) == 0 && app.blocked(&a, w1) == 1);
    app.set_modal(&a, dw, 0);
    check("not modal: its owner goes on", app.blocked(&a, w1) == 0);
    app.set_modal(&a, dw, 1);
    app.hide(&a, dw);
    check("hidden: its owner goes on", app.blocked(&a, w1) == 0 && app.is_shown(&a, dw) == 0);
    app.hide(&a, w3);
    check("any window can be hidden", app.is_shown(&a, w3) == 0);
    app.show(&a, w3);
    check("and shown", app.is_shown(&a, w3) == 1);
    check("a stale handle: nothing", app.owner(&a, w2) == 0 && app.is_dialog(&a, w2) == 0 && app.is_modal(&a, w2) == 0 &&
          app.is_shown(&a, w2) == 0 && app.blocked(&a, w2) == 0 && app.title_length(&a, w2) == 0);

    // --- A window's title, copied ---
    check("no title yet", app.title_length(&a, dw) == 0);
    let is [4]u8 as pick;
    pick[0] = 80; pick[1] = 105; pick[2] = 99; pick[3] = 107;
    app.set_title(&a, dw, cast(*u8, &pick), 4);
    pick[0] = 0;
    check("its title, copied", app.title_length(&a, dw) == 4 && app.title(&a, dw)[0] == 80 && app.title(&a, dw)[3] == 107);
    let is [300]u8 as long;
    let is i64 as k with mut = 0;
    while (k < 300) {
        long[k] = 97;
        k = k + 1;
    }
    // A two-byte character across the limit is not cut in half.
    long[app.MAX_TITLE - 1] = 195;
    long[app.MAX_TITLE] = 169;
    app.set_title(&a, dw, cast(*u8, &long), 300);
    check("a long title: cut before the character the limit falls in", app.title_length(&a, dw) == app.MAX_TITLE - 1);
    long[app.MAX_TITLE - 1] = 97;
    long[app.MAX_TITLE] = 97;
    app.set_title(&a, dw, cast(*u8, &long), 300);
    check("a long title: cut at the limit", app.title_length(&a, dw) == app.MAX_TITLE);
    long[app.MAX_TITLE] = 169;
    app.set_title(&a, dw, cast(*u8, &long), app.MAX_TITLE);
    check("a title as long as the limit: whole, whatever follows it", app.title_length(&a, dw) == app.MAX_TITLE);

    // --- What a dialog asks through its tree ---
    let is *tree.Tree as dt = app.tree(&a, dw);
    check("a dialog's tree knows it", tree.ask_host(dt, tree.HOST_IS_DIALOG, 0) == 1 &&
          tree.ask_host(app.tree(&a, w1), tree.HOST_IS_DIALOG, 0) == 0);
    check("shown through its tree: done", tree.ask_host(dt, tree.HOST_SHOW, 1) == 1);
    check("shown through its tree, modal", app.is_shown(&a, dw) == 1 && app.is_modal(&a, dw) == 1 && app.blocked(&a, w1) == 1);
    check("hidden through its tree: done", tree.ask_host(dt, tree.HOST_HIDE, 0) == 1);
    check("hidden through its tree", app.is_shown(&a, dw) == 0);
    tree.ask_host(dt, tree.HOST_SHOW, 0);
    check("shown not modal", app.is_shown(&a, dw) == 1 && app.is_modal(&a, dw) == 0 && app.blocked(&a, w1) == 0);
    tree.ask_host(dt, tree.HOST_HIDE, 0);
    let is tree.HostText as ht;
    ht.s = "Colour";
    ht.n = 6;
    check("titled: done", tree.ask_host(dt, tree.HOST_TITLE, cast(i64, &ht)) == 1);
    check("titled through its tree", app.title_length(&a, dw) == 6 && app.title(&a, dw)[0] == 67);
    let is math.vec.Vec2 as want = math.vec.v2(320.0, 240.0);
    check("sized: done", tree.ask_host(dt, tree.HOST_SIZE, cast(i64, &want)) == 1);
    check("nothing else asked", tree.ask_host(dt, 99, 0) == 0);
    check("a tree names its window", tree.host_id(dt) == dw && tree.host_id(app.tree(&a, w1)) == w1);
    check("sized through its tree", app.window_state(&a, dw).width == 320.0 && app.window_state(&a, dw).height == 240.0);
    let is i64 as asked = tree.ask_host(app.tree(&a, w3), tree.HOST_DIALOG, 0);
    let is i64 as dw3 = app.window_of(&a, cast(*tree.Tree, asked));
    check("a dialog window asked for by a tree: one belonging to its window, hidden", asked != 0 && dw3 != 0 &&
          app.owner(&a, dw3) == w3 && app.is_dialog(&a, dw3) == 1 && app.is_shown(&a, dw3) == 0);
    // One more, a slot further on.
    let is i64 as dw5 = app.dialog_open(&a, w3, 10.0, 10.0);
    app.set_modal(&a, dw5, 1);
    app.show(&a, dw5);
    check("a modal window anywhere in the table blocks", app.blocked(&a, w3) == 1);
    app.hide(&a, dw5);
    let is i64 as gone = app.window_of(&a, cast(*tree.Tree, tree.ask_host(app.tree(&a, w3), tree.HOST_DIALOG, 0)));
    check("closed through its tree: done", tree.ask_host(app.tree(&a, gone), tree.HOST_CLOSE, 0) == 1);
    check("closed through its tree", app.window_valid(&a, gone) == 0 && app.window_valid(&a, w3) == 1);
    // Full: none to give.
    let is i64 as fill with mut = 1;
    while (fill != 0) { fill = app.window_open(&a, 10.0, 10.0); }
    check("full: no dialog window", app.dialog_open(&a, w1, 10.0, 10.0) == 0 && app.last_error(&a) == app.FULL);
    check("full: no tree asked for", tree.ask_host(app.tree(&a, w1), tree.HOST_DIALOG, 0) == 0);
    let is tree.Tree as bare = tree.open(&l.tree);
    check("a tree no application keeps: nothing asked, 0 said", tree.ask_host(&bare, tree.HOST_DIALOG, 0) == 0 &&
          tree.ask_host(&bare, tree.HOST_IS_DIALOG, 0) == 0 && tree.host_id(&bare) == 0);
    tree.close(&bare);

    // --- Closing a window closes what belongs to it ---
    app.show(&a, dw2);
    app.window_close(&a, w1);
    check("closed with its owner, and theirs", app.window_valid(&a, dw) == 0 && app.window_valid(&a, dw2) == 0 &&
          app.window_valid(&a, dw3) == 1);
    let is *tree.Tree as t3 = app.tree(&a, w3);
    app.window_close(&a, w3);
    check("and that one with its own", app.window_valid(&a, dw3) == 0 && app.window_valid(&a, dw5) == 0);
    check("a closed window's tree names none", tree.host_id(t3) == 0);
    let is *tree.Tree as last = app.tree(&a, app.next_window(&a, 0));
    app.close(&a);
    check("a closed application: no dialog window, no window for a tree", app.dialog_open(&a, w1, 10.0, 10.0) == 0 &&
          app.window_of(&a, last) == 0);
}

fn main() as i32 {
    counted = widget.kind("counted", 0);
    counted.destroy = fn_ptr(counted_destroy);
    counted.shape = fn_ptr(beam);
    filled = widget.kind("filled", 0);
    filled.paint = fn_ptr(filled_paint);

    let is app.Limits as l = app.limits_default();
    l.windows = 2;
    let is app.App as a = app.open(&l);
    check("open", app.is_open(&a));
    // A handle for a slot nothing was ever opened in is not a window, even
    // with the era such a slot starts at.
    check("never opened: not a window", app.window_valid(&a, (1 << 32) | 1) == 0);
    check("never opened: no tree", cast(i64, app.tree(&a, (1 << 32) | 1)) == 0);

    // --- Each window has its own tree and its own router ---
    let is i64 as w1 = app.window_open(&a, 400.0, 300.0);
    let is i64 as w2 = app.window_open(&a, 200.0, 100.0);
    check("two windows", w1 != 0 && w2 != 0 && w1 != w2);
    check("counted", app.window_count(&a) == 2);
    let is *tree.Tree as t1 = app.tree(&a, w1);
    let is *tree.Tree as t2 = app.tree(&a, w2);
    check("two trees", cast(i64, t1) != cast(i64, t2));
    check("each tree lent the application's timers", cast(i64, tree.timers(t1)) == cast(i64, app.timers(&a)) &&
          cast(i64, tree.timers(t2)) == cast(i64, app.timers(&a)));
    check("and its own window's router", cast(i64, tree.router(t1)) == cast(i64, app.router(&a, w1)) &&
          cast(i64, tree.router(t2)) == cast(i64, app.router(&a, w2)));
    let is i64 as k1 = tree.create(t1, &counted, tree.root(t1));
    tree.set_focusable(t1, k1, 1);
    check("a widget in the first", tree.child_count(t1, tree.root(t1)) == 1);
    check("is not in the second", tree.child_count(t2, tree.root(t2)) == 0);
    router.focus(t1, app.router(&a, w1), k1, 0);
    check("focus in the first", router.focused(t1, app.router(&a, w1)) == k1);
    check("is not focus in the second", router.focused(t2, app.router(&a, w2)) == 0);

    // --- A bounded table: full is said, not grown ---
    check("full", app.window_open(&a, 10.0, 10.0) == 0);
    check("full: the error says so", app.last_error(&a) == app.FULL);

    // --- Frames: layout at the window's size, then what to repaint ---
    check("a new window wants a frame", app.needs_frame(&a, w1));
    check("first frame: one rectangle", app.frame(&a, w1) == 1);
    check("first frame: the whole window", same(tree.damage_at(t1, 0), 0.0, 0.0, 400.0, 300.0));
    check("the root has the window's size", same(layout.rect(t1, tree.root(t1)), 0.0, 0.0, 400.0, 300.0));
    tree.damage_clear(t1);
    check("presented: no frame wanted", 1 - app.needs_frame(&a, w1));
    app.resize(&a, w1, 500.0, 320.0);
    check("resized: a frame wanted", app.needs_frame(&a, w1));
    app.frame(&a, w1);
    check("resized: the new size", same(tree.damage_at(t1, 0), 0.0, 0.0, 500.0, 320.0));
    tree.damage_clear(t1);
    check("the other window untouched", app.needs_frame(&a, w2));

    // --- The pointer's shape, for the platform's loop to show ---
    router.pointer_move(t1, app.router(&a, w1), 10.0, 10.0, 50);
    check("over a widget with a shape: its", app.pointer_shape(&a, w1) == tree.SHAPE_TEXT);
    check("the other window's: its own", app.pointer_shape(&a, w2) == tree.SHAPE_DEFAULT);
    check("no window: the default", app.pointer_shape(&a, w1 + (5 << 32)) == tree.SHAPE_DEFAULT);

    // --- The scale is per window ---
    app.set_scale(&a, w2, 2.0);
    check("scale: the second", layout.scale(t2) == 2.0);
    check("scale: not the first", layout.scale(t1) == 1.0);
    check("scale: read back", app.scale(&a, w2) == 2.0);

    // --- Active or not changes how everything looks ---
    check("windows start inactive", app.is_active(&a, w1) == 0);
    app.set_active(&a, w1, 1);
    check("activated", app.is_active(&a, w1) == 1);
    check("activated: everything repaints", app.frame(&a, w1) == 1
          && same(tree.damage_at(t1, 0), 0.0, 0.0, 500.0, 320.0));
    tree.damage_clear(t1);
    app.set_active(&a, w1, 1);
    check("active again: nothing to repaint", 1 - app.needs_frame(&a, w1));

    // --- Painting, through the window's cache when it has one ---
    let is gpu.device.Device as dv = gpu.open_headless(64, 48, gpu.SOFTWARE);
    let is draw2d.Limits as dl = draw2d.limits_default();
    let is draw2d.Canvas as cv = draw2d.open(&dv, &dl);
    let is paint.Cache as cc = paint.cache_open(&dv, &dl);
    let is i64 as faded = tree.create(t1, &filled, tree.root(t1));
    tree.set_opacity(t1, faded, 0.5);
    let is paint.Stats as ps;
    app.frame(&a, w1);
    draw2d.begin(&cv, 64.0, 48.0, 1.0);
    app.paint(&a, w1, &cv, cast(*style.Theme, 0), 0, &ps);
    tree.damage_clear(t1);
    check("no cache at first", cast(i64, app.cache(&a, w1)) == 0);
    check("no cache: painted directly", ps.cache_blits == 0 && ps.painted == 1);
    app.set_cache(&a, w1, &cc);
    check("its cache", cast(i64, app.cache(&a, w1)) == cast(i64, &cc));
    check("not the other window's", cast(i64, app.cache(&a, w2)) == 0);
    tree.invalidate_paint(t1, faded);
    app.frame(&a, w1);
    draw2d.begin(&cv, 64.0, 48.0, 1.0);
    app.paint(&a, w1, &cv, cast(*style.Theme, 0), 0, &ps);
    tree.damage_clear(t1);
    check("through its cache", ps.cache_renders == 1 && ps.cache_blits == 1);
    app.set_cache(&a, w2, &cc);
    app.set_cache(&a, 0, cast(*paint.Cache, 0));
    check("a stale handle: no cache, and none set", cast(i64, app.cache(&a, 0)) == 0
          && cast(i64, app.cache(&a, w1)) == cast(i64, &cc));
    tree.destroy(t1, faded);
    app.frame(&a, w1);
    tree.damage_clear(t1);

    // --- Settings are the application's, in every window's router ---
    let is router.Settings as s = router.settings_default();
    s.double_click_ms = 650;
    app.set_settings(&a, s);
    check("settings: the first window", app.router(&a, w1).settings.double_click_ms == 650);
    check("settings: the second window", app.router(&a, w2).settings.double_click_ms == 650);
    check("settings: read back", app.settings(&a).double_click_ms == 650);

    // --- Timers are the application's: one clock, one loop ---
    timer.add(app.timers(&a), 1000, 50, 0, fn_ptr(on_timer), cast(*u8, 0));
    check("next due", app.next_due(&a) == 1050);
    app.tick(&a, 1049);
    check("not yet", fired == 0);
    app.tick(&a, 1050);
    check("fired", fired == 1);

    // --- Animations: each window its own clock, run by the application's loop ---
    let is *anim.Animator as an1 = app.animator(&a, w1);
    check("an animator per window", cast(i64, an1) != 0 && cast(i64, an1) != cast(i64, app.animator(&a, w2)));
    check("a stale handle: none", cast(i64, app.animator(&a, 0)) == 0);
    check("nothing animating: nothing due", app.next_due(&a) == 0 - 1);
    tree.damage_clear(t1);
    let is i64 as fading = anim.fade(an1, k1, 0.0, 100, math.curve.EASE_LINEAR);
    check("a tween in the first window's tree", fading != 0);
    check("due at once", app.next_due(&a) == 1050);
    check("the tick runs it", app.tick(&a, 2000) == 1);
    check("then a frame later", app.next_due(&a) == 2016);
    app.tick(&a, 2050);
    check("half way", tree.opacity(t1, k1) == 0.5 && app.needs_frame(&a, w1) == 1);
    timer.add(app.timers(&a), 2050, 5, 0, fn_ptr(on_timer), cast(*u8, 0));
    check("the earlier of a timer and a frame", app.next_due(&a) == 2055);
    app.tick(&a, 2055);
    check("both ran", fired == 2 && anim.running(an1, fading) == 1);
    app.tick(&a, 2100);
    check("there", tree.opacity(t1, k1) == 0.0 && anim.running(an1, fading) == 0);
    check("over: nothing due", app.next_due(&a) == 0 - 1);
    tree.set_opacity(t1, k1, 1.0);
    // The other window's runs on the same tick.
    let is i64 as k2w = tree.create(t2, &filled, tree.root(t2));
    anim.fade(app.animator(&a, w2), k2w, 0.5, 100, math.curve.EASE_LINEAR);
    app.tick(&a, 3000);
    app.tick(&a, 3100);
    check("the second window's too", tree.opacity(t2, k2w) == 0.5);
    tree.destroy(t2, k2w);
    // Still running when its window closes: gone with it.
    anim.fade(app.animator(&a, w2), tree.root(t2), 0.5, 100, math.curve.EASE_LINEAR);

    // --- The program's own pointer, per window ---
    let is i64 as mine = 42;
    app.set_user(&a, w2, cast(*u8, &mine));
    check("user data", cast(i64, app.user(&a, w2)) == cast(i64, &mine));

    // --- Closing a window: its widgets destroyed, its handle stale ---
    tree.create(t2, &counted, tree.root(t2));
    tree.create(t2, &counted, tree.root(t2));
    let is [4]u8 as service;
    app.set_text_service(&a, cast(*u8, &service));
    check("the text service lent to every window", cast(i64, tree.text_service(app.tree(&a, w1))) ==
          cast(i64, &service) && cast(i64, tree.text_service(t2)) == cast(i64, &service));
    app.window_close(&a, w2);
    check("closed: its widgets destroyed", destroyed == 2);
    check("closed: the handle is stale", app.window_valid(&a, w2) == 0);
    check("closed: no tree", cast(i64, app.tree(&a, w2)) == 0);
    check("closed: counted", app.window_count(&a) == 1);
    app.window_close(&a, w2);
    check("closed twice: harmless", app.window_count(&a) == 1);
    let is i64 as w3 = app.window_open(&a, 50.0, 50.0);
    check("the slot is reused", w3 != 0);
    check("a reused slot is another handle", w3 != w2 && app.window_valid(&a, w2) == 0);
    check("a reused slot starts clean", app.scale(&a, w3) == 1.0 && cast(i64, app.user(&a, w3)) == 0
          && cast(i64, app.cache(&a, w3)) == 0);
    check("new windows take the settings", app.router(&a, w3).settings.double_click_ms == 650);
    check("a reused slot: nothing animating", anim.active(app.animator(&a, w3)) == 0 && app.next_due(&a) == 0 - 1);
    check("its animator on its own tree", app.animator(&a, w3).t == app.tree(&a, w3));
    check("and the text service", cast(i64, tree.text_service(app.tree(&a, w3))) == cast(i64, &service));
    check("its animator lent to its tree", cast(i64, tree.animator(app.tree(&a, w3))) ==
          cast(i64, app.animator(&a, w3)));

    // --- Walking the windows ---
    let is i64 as seen with mut = 0;
    let is i64 as h with mut = app.next_window(&a, 0);
    while (h != 0) {
        seen = seen + 1;
        h = app.next_window(&a, h);
    }
    check("walked every window", seen == 2);

    // --- Closing the application closes every window ---
    app.close(&a);
    check("closed: every widget destroyed", destroyed == 3);
    check("closed: not open", 1 - app.is_open(&a));
    paint.cache_close(&cc);
    draw2d.close(&cv);

    test_dialogs();

    if (fails > 0) {
        io.printf("app: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("app: all checks passed\n");
    return 0;
}
