// ui/app_test.cst — the application, its windows, and what they share.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "router.cst" as router;
use "timer.cst" as timer;
use "app.cst" as app;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is i64 as destroyed with mut = 0;

fn counted_destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    destroyed = destroyed + 1;
}

let is tree.Kind as counted with mut;

let is i64 as fired with mut = 0;

fn on_timer(user as *u8) as void { fired = fired + 1; }

fn same(a as math.rect.Rect, x as f64, y as f64, w as f64, h as f64) as i32 {
    if (a.x == x && a.y == y && a.w == w && a.h == h) { return 1; }
    return 0;
}

fn main() as i32 {
    counted = widget.kind("counted", 0);
    counted.destroy = fn_ptr(counted_destroy);

    let is app.Limits as l = app.limits_default();
    l.windows = 2;
    let is app.App as a = app.open(&l);
    check("open", app.is_open(&a));
    // A handle for a slot nothing was ever opened in is not a window, even
    // with the era such a slot starts at.
    check("never opened: not a window", app.window_valid(&a, (1 << 32) | 1) == 0);
    check("never opened: no tree", cast(i64, app.tree(&a, (1 << 32) | 1)) == 0);

    // --- Each window has its own tree and its own router ---
    let is i64 as w1 = app.window_open(&a, 400.0, 300.0);
    let is i64 as w2 = app.window_open(&a, 200.0, 100.0);
    check("two windows", w1 != 0 && w2 != 0 && w1 != w2);
    check("counted", app.window_count(&a) == 2);
    let is *tree.Tree as t1 = app.tree(&a, w1);
    let is *tree.Tree as t2 = app.tree(&a, w2);
    check("two trees", cast(i64, t1) != cast(i64, t2));
    let is i64 as k1 = tree.create(t1, &counted, tree.root(t1));
    tree.set_focusable(t1, k1, 1);
    check("a widget in the first", tree.child_count(t1, tree.root(t1)) == 1);
    check("is not in the second", tree.child_count(t2, tree.root(t2)) == 0);
    router.focus(t1, app.router(&a, w1), k1, 0);
    check("focus in the first", router.focused(t1, app.router(&a, w1)) == k1);
    check("is not focus in the second", router.focused(t2, app.router(&a, w2)) == 0);

    // --- A bounded table: full is said, not grown ---
    check("full", app.window_open(&a, 10.0, 10.0) == 0);
    check("full: the error says so", app.last_error(&a) == app.FULL);

    // --- Frames: layout at the window's size, then what to repaint ---
    check("a new window wants a frame", app.needs_frame(&a, w1));
    check("first frame: one rectangle", app.frame(&a, w1) == 1);
    check("first frame: the whole window", same(tree.damage_at(t1, 0), 0.0, 0.0, 400.0, 300.0));
    check("the root has the window's size", same(layout.rect(t1, tree.root(t1)), 0.0, 0.0, 400.0, 300.0));
    tree.damage_clear(t1);
    check("presented: no frame wanted", 1 - app.needs_frame(&a, w1));
    app.resize(&a, w1, 500.0, 320.0);
    check("resized: a frame wanted", app.needs_frame(&a, w1));
    app.frame(&a, w1);
    check("resized: the new size", same(tree.damage_at(t1, 0), 0.0, 0.0, 500.0, 320.0));
    tree.damage_clear(t1);
    check("the other window untouched", app.needs_frame(&a, w2));

    // --- The scale is per window ---
    app.set_scale(&a, w2, 2.0);
    check("scale: the second", layout.scale(t2) == 2.0);
    check("scale: not the first", layout.scale(t1) == 1.0);
    check("scale: read back", app.scale(&a, w2) == 2.0);

    // --- Active or not changes how everything looks ---
    check("windows start inactive", app.is_active(&a, w1) == 0);
    app.set_active(&a, w1, 1);
    check("activated", app.is_active(&a, w1) == 1);
    check("activated: everything repaints", app.frame(&a, w1) == 1
          && same(tree.damage_at(t1, 0), 0.0, 0.0, 500.0, 320.0));
    tree.damage_clear(t1);
    app.set_active(&a, w1, 1);
    check("active again: nothing to repaint", 1 - app.needs_frame(&a, w1));

    // --- Settings are the application's, in every window's router ---
    let is router.Settings as s = router.settings_default();
    s.double_click_ms = 650;
    app.set_settings(&a, s);
    check("settings: the first window", app.router(&a, w1).settings.double_click_ms == 650);
    check("settings: the second window", app.router(&a, w2).settings.double_click_ms == 650);
    check("settings: read back", app.settings(&a).double_click_ms == 650);

    // --- Timers are the application's: one clock, one loop ---
    timer.add(app.timers(&a), 1000, 50, 0, fn_ptr(on_timer), cast(*u8, 0));
    check("next due", app.next_due(&a) == 1050);
    app.tick(&a, 1049);
    check("not yet", fired == 0);
    app.tick(&a, 1050);
    check("fired", fired == 1);

    // --- The program's own pointer, per window ---
    let is i64 as mine = 42;
    app.set_user(&a, w2, cast(*u8, &mine));
    check("user data", cast(i64, app.user(&a, w2)) == cast(i64, &mine));

    // --- Closing a window: its widgets destroyed, its handle stale ---
    tree.create(t2, &counted, tree.root(t2));
    tree.create(t2, &counted, tree.root(t2));
    app.window_close(&a, w2);
    check("closed: its widgets destroyed", destroyed == 2);
    check("closed: the handle is stale", app.window_valid(&a, w2) == 0);
    check("closed: no tree", cast(i64, app.tree(&a, w2)) == 0);
    check("closed: counted", app.window_count(&a) == 1);
    app.window_close(&a, w2);
    check("closed twice: harmless", app.window_count(&a) == 1);
    let is i64 as w3 = app.window_open(&a, 50.0, 50.0);
    check("the slot is reused", w3 != 0);
    check("a reused slot is another handle", w3 != w2 && app.window_valid(&a, w2) == 0);
    check("a reused slot starts clean", app.scale(&a, w3) == 1.0 && cast(i64, app.user(&a, w3)) == 0);
    check("new windows take the settings", app.router(&a, w3).settings.double_click_ms == 650);

    // --- Walking the windows ---
    let is i64 as seen with mut = 0;
    let is i64 as h with mut = app.next_window(&a, 0);
    while (h != 0) {
        seen = seen + 1;
        h = app.next_window(&a, h);
    }
    check("walked every window", seen == 2);

    // --- Closing the application closes every window ---
    app.close(&a);
    check("closed: every widget destroyed", destroyed == 3);
    check("closed: not open", 1 - app.is_open(&a));

    if (fails > 0) {
        io.printf("app: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("app: all checks passed\n");
    return 0;
}
