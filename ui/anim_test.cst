// ui/anim_test.cst — tweens stepped by a clock the test holds: fading,
// moving, colours and numbers, easing, replacing, repeating, and reduced
// motion.
use "std/io.cst" as io;
use "std/os/linux.cst" as linux;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "style.cst" as style;
use "anim.cst" as anim;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

// Within a millionth — written with >= alone, which a NaN fails (the
// compiler's < and == do not, yet).
fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    if (d >= 0.0 - 0.000001 && 0.000001 >= d) { return 1; }
    io.printf("  %d millionths, want %d\n", cast(i64, a * 1000000.0), cast(i64, b * 1000000.0));
    return 0;
}

let is i64 as steps with mut = 0;
let is i64 as dones with mut = 0;
let is i64 as done_user with mut = 0;

let is i64 as step_user with mut = 0;

fn on_step(user as *u8) as void {
    steps = steps + 1;
    step_user = cast(i64, user);
}
fn on_done(user as *u8) as void {
    dones = dones + 1;
    done_user = cast(i64, user);
}

// A done that starts the next tween: the way back after the way out.
let is *anim.Animator as chain_an with mut;
let is i64 as chain_w with mut = 0;
fn chain_back(user as *u8) as void {
    anim.fade(chain_an, chain_w, 1.0, 100, math.curve.EASE_LINEAR);
}

let is tree.Kind as box_kind with mut;

fn main() as i32 {
    box_kind = widget.kind("box", 0);
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is i64 as w = tree.create(&t, &box_kind, root);
    let is anim.Animator as an = anim.init(&t);

    // --- Ids, and a clock that has not ticked ---
    let is anim.Animator as an0 = anim.init(&t);
    check("an id never given", anim.running(&an0, (1 << 32) | 1) == 0 && anim.running(&an0, 0) == 0);
    let is i64 as first = anim.fade(&an0, w, 0.5, 100, math.curve.EASE_LINEAR);
    check("never ticked: due at once", anim.next_due(&an0) == 0);
    anim.cancel(&an0, first);
    // One past the last slot is read nowhere: the animator ends where the
    // memory does.
    let is *u8 as mapped = linux.mmap(cast(*u8, 0), 16384, 3, 34, 0 - 1, 0);   // read, write; private, anonymous
    linux.mprotect(cast(*u8, cast(i64, mapped) + 12288), 4096, 0);
    let is *anim.Animator as edge = cast(*anim.Animator, cast(i64, mapped) + 12288 - sizeof(anim.Animator));
    *edge = anim.init(&t);
    check("an id past the slots", anim.running(edge, (1 << 32) | (anim.MAX_TWEENS + 1)) == 0);
    anim.cancel(edge, (1 << 32) | (anim.MAX_TWEENS + 1));
    // And nothing before the first is written: one that begins where the
    // memory does, given a stale id.
    let is *u8 as mapped2 = linux.mmap(cast(*u8, 0), 16384, 3, 34, 0 - 1, 0);
    linux.mprotect(mapped2, 4096, 0);
    let is *anim.Animator as front = cast(*anim.Animator, cast(i64, mapped2) + 4096);
    *front = anim.init(&t);
    anim.on_step(front, 0, fn_ptr(on_step), cast(*u8, 0));
    anim.on_done(front, 0, fn_ptr(on_done), cast(*u8, 0));
    anim.set_repeat(front, 0, 3, 1);
    anim.finish(front, 0);
    check("stale ids write nothing", anim.active(front) == 0);

    // --- Idle ---
    check("idle: nothing due", anim.next_due(&an) == 0 - 1 && anim.active(&an) == 0);
    check("idle: a tick runs nothing", anim.tick(&an, 500) == 0);

    // --- A fade, linear ---
    let is i64 as id = anim.fade(&an, w, 0.0, 100, math.curve.EASE_LINEAR);
    check("a tween", id != 0 && anim.running(&an, id) == 1 && anim.active(&an) == 1);
    check("not before the first tick", tree.opacity(&t, w) == 1.0);
    check("due at once", anim.next_due(&an) == 500);
    check("a tick runs it", anim.tick(&an, 1000) == 1);
    check("started at that tick, from where it was", tree.opacity(&t, w) == 1.0);
    check("the next frame due", anim.next_due(&an) == 1016);
    anim.tick(&an, 1025);
    check("a quarter of the way", near(tree.opacity(&t, w), 0.75));
    anim.tick(&an, 1050);
    check("half way", near(tree.opacity(&t, w), 0.5));
    anim.tick(&an, 1100);
    check("there", tree.opacity(&t, w) == 0.0);
    check("ended", anim.running(&an, id) == 0 && anim.active(&an) == 0 && anim.next_due(&an) == 0 - 1);
    check("ended: a tick runs nothing", anim.tick(&an, 1116) == 0);

    // --- Easing ---
    anim.fade(&an, w, 1.0, 100, math.curve.EASE_IN_QUAD);
    anim.tick(&an, 2000);
    anim.tick(&an, 2050);
    check("eased: a quarter at half time", near(tree.opacity(&t, w), 0.25));
    anim.tick(&an, 2100);
    // The theme's curve, read as it runs.
    let is style.Theme as th = style.light();
    th.motion.ease = math.curve.EASE_OUT_QUAD;
    tree.set_theme(&t, &th);
    anim.fade(&an, w, 0.0, 100, anim.THEME_EASE);
    anim.tick(&an, 3000);
    anim.tick(&an, 3050);
    check("the theme's curve", near(tree.opacity(&t, w), 0.25));
    anim.tick(&an, 3100);
    check("the theme's curve: there", tree.opacity(&t, w) == 0.0);
    th.motion.ease = math.curve.EASE_CSS;
    tree.set_opacity(&t, w, 1.0);
    // Two widgets, each its own fade.
    let is i64 as w2 = tree.create(&t, &box_kind, root);
    anim.fade(&an, w, 0.0, 100, math.curve.EASE_LINEAR);
    anim.fade(&an, w2, 0.0, 100, math.curve.EASE_LINEAR);
    check("two widgets", anim.active(&an) == 2);
    anim.tick(&an, 3200);
    anim.tick(&an, 3300);
    check("both faded", tree.opacity(&t, w) == 0.0 && tree.opacity(&t, w2) == 0.0);
    tree.destroy(&t, w2);
    tree.set_opacity(&t, w, 1.0);

    // --- Moving ---
    tree.set_translation(&t, w, 4.0, 0.0);
    let is i64 as mv = anim.move(&an, w, 14.0, 20.0, 200, math.curve.EASE_LINEAR);
    anim.tick(&an, 4000);
    anim.tick(&an, 4100);
    check("moving: half way on both", near(tree.translation_x(&t, w), 9.0) && near(tree.translation_y(&t, w), 10.0));
    // A fade beside it: each its own.
    let is i64 as fd = anim.fade(&an, w, 0.5, 100, math.curve.EASE_LINEAR);
    check("two on one widget", anim.active(&an) == 2 && anim.running(&an, mv) == 1);
    anim.tick(&an, 4150);
    anim.tick(&an, 4200);
    check("moved", tree.translation_x(&t, w) == 14.0 && tree.translation_y(&t, w) == 20.0);
    check("fading still", near(tree.opacity(&t, w), 0.75) && anim.running(&an, fd) == 1);
    anim.tick(&an, 4250);
    check("faded", tree.opacity(&t, w) == 0.5 && anim.active(&an) == 0);

    // --- Replacing: from where it is, toward the new target ---
    let is i64 as out = anim.fade(&an, w, 0.0, 100, math.curve.EASE_LINEAR);
    anim.tick(&an, 5000);
    anim.tick(&an, 5050);
    check("on the way out", near(tree.opacity(&t, w), 0.25));
    anim.on_done(&an, out, fn_ptr(on_done), cast(*u8, 0));
    let is i64 as back = anim.fade(&an, w, 1.0, 100, math.curve.EASE_LINEAR);
    check("replaced", anim.running(&an, out) == 0 && anim.running(&an, back) == 1 && anim.active(&an) == 1);
    anim.tick(&an, 5060);
    check("not jumping", near(tree.opacity(&t, w), 0.25));
    anim.tick(&an, 5110);
    check("from there", near(tree.opacity(&t, w), 0.625));
    anim.tick(&an, 5160);
    check("back", tree.opacity(&t, w) == 1.0);
    check("the replaced one is not done", dones == 0);

    // --- A colour ---
    let is math.color.Color as col with mut = math.color.rgba(1.0, 0.0, 0.0, 1.0);
    let is i64 as cid = anim.color(&an, w, &col, math.color.rgba(0.0, 0.0, 1.0, 1.0), 100, math.curve.EASE_LINEAR);
    anim.tick(&an, 6000);
    tree.clear_paint(&t, w);
    anim.tick(&an, 6050);
    check("a colour, half way", near(col.r, 0.5) && near(col.g, 0.0) && near(col.b, 0.5) && near(col.a, 1.0));
    check("its widget repainted", tree.needs_paint(&t, w) == 1);
    anim.tick(&an, 6100);
    check("a colour, there", col.r == 0.0 && col.b == 1.0 && anim.running(&an, cid) == 0);
    // To transparent: premultiplied, so it fades without turning toward the
    // transparent colour's.
    anim.color(&an, w, &col, math.color.rgba(1.0, 1.0, 0.0, 0.0), 100, math.curve.EASE_LINEAR);
    anim.tick(&an, 6200);
    anim.tick(&an, 6250);
    check("fading out keeps its colour", near(col.r, 0.0) && near(col.g, 0.0) && near(col.b, 1.0) && near(col.a, 0.5));
    anim.tick(&an, 6300);
    check("gone", col.a == 0.0);
    // And in again from nothing: the new colour's from the start.
    anim.color(&an, w, &col, math.color.rgba(0.0, 1.0, 0.0, 1.0), 100, math.curve.EASE_LINEAR);
    anim.tick(&an, 6400);
    check("at the first tick, as it was", col.r == 1.0 && col.g == 1.0 && col.b == 0.0 && col.a == 0.0);
    anim.tick(&an, 6425);
    check("fading in: its own colour", near(col.r, 0.0) && near(col.g, 1.0) && near(col.b, 0.0) && near(col.a, 0.25));
    anim.tick(&an, 6500);
    // Both ends exactly, whatever premultiplying would round.
    col = math.color.rgba(0.1, 0.7, 0.3, 0.3);
    anim.color(&an, w, &col, math.color.rgba(0.9, 0.2, 0.6, 0.3), 100, math.curve.EASE_LINEAR);
    anim.tick(&an, 6600);
    check("exactly as it was", col.r == 0.1 && col.g == 0.7 && col.b == 0.3 && col.a == 0.3);
    anim.tick(&an, 6700);
    check("exactly there", col.r == 0.9 && col.g == 0.2 && col.b == 0.6 && col.a == 0.3);
    // Transparent to transparent: nothing shows on the way, and nothing
    // divides by it.
    col = math.color.rgba(0.0, 0.0, 0.0, 0.0);
    anim.color(&an, w, &col, math.color.rgba(1.0, 0.0, 0.0, 0.0), 100, math.curve.EASE_LINEAR);
    anim.tick(&an, 6800);
    anim.tick(&an, 6850);
    check("unseen on the way: the colour it goes to", near(col.r, 1.0) && near(col.g, 0.0) && near(col.a, 0.0));
    anim.tick(&an, 6900);

    // --- A number ---
    let is f64 as knob with mut = 0.0;
    let is i64 as nid = anim.number(&an, w, &knob, 10.0, 100, math.curve.EASE_LINEAR);
    anim.on_step(&an, nid, fn_ptr(on_step), cast(*u8, 55));
    anim.on_done(&an, nid, fn_ptr(on_done), cast(*u8, 77));
    anim.tick(&an, 7000);
    tree.clear_paint(&t, w);
    anim.tick(&an, 7030);
    check("a number", near(knob, 3.0) && tree.needs_paint(&t, w) == 1);
    check("stepped each tick, with its user", steps == 2 && dones == 0 && step_user == 55);
    anim.tick(&an, 7100);
    check("a number, there", knob == 10.0);
    check("done once, with its user", steps == 3 && dones == 1 && done_user == 77);
    anim.tick(&an, 7200);
    check("not again", steps == 3 && dones == 1);
    // Quiet: the number changes, its widget not repainted for it — what it
    // moves is its step's to draw.
    let is f64 as hush with mut = 0.0;
    let is i64 as qid = anim.number(&an, w, &hush, 10.0, 100, math.curve.EASE_LINEAR);
    anim.set_quiet(&an, qid);
    anim.tick(&an, 7300);
    tree.clear_paint(&t, w);
    anim.tick(&an, 7350);
    check("quiet: stepped, nothing repainted", near(hush, 5.0) && tree.needs_paint(&t, w) == 0);
    anim.tick(&an, 7400);
    check("quiet to the end", hush == 10.0 && tree.needs_paint(&t, w) == 0);
    anim.set_quiet(&an, qid);
    // Two numbers are two tweens.
    let is f64 as other with mut = 5.0;
    anim.number(&an, w, &knob, 0.0, 100, math.curve.EASE_LINEAR);
    anim.number(&an, w, &other, 0.0, 100, math.curve.EASE_LINEAR);
    check("two numbers", anim.active(&an) == 2);
    anim.tick(&an, 7300);
    anim.tick(&an, 7400);
    check("both there", knob == 0.0 && other == 0.0);

    // --- Cancelling and finishing ---
    let is i64 as c1 = anim.number(&an, w, &knob, 10.0, 100, math.curve.EASE_LINEAR);
    anim.on_done(&an, c1, fn_ptr(on_done), cast(*u8, 0));
    anim.tick(&an, 8000);
    anim.tick(&an, 8050);
    anim.cancel(&an, c1);
    check("cancelled: where it was", knob == 5.0 && anim.running(&an, c1) == 0 && anim.active(&an) == 0);
    check("cancelled: not done", dones == 1);
    anim.tick(&an, 8100);
    check("cancelled: left there", knob == 5.0);
    let is i64 as f1 = anim.number(&an, w, &knob, 8.0, 100, math.curve.EASE_LINEAR);
    anim.on_done(&an, f1, fn_ptr(on_done), cast(*u8, 0));
    anim.tick(&an, 8200);
    anim.finish(&an, f1);
    check("finished: at its end", knob == 8.0 && anim.running(&an, f1) == 0);
    check("finished: done", dones == 2);
    // Finished before it started, too.
    let is i64 as f2 = anim.number(&an, w, &knob, 2.0, 100, math.curve.EASE_LINEAR);
    anim.finish(&an, f2);
    check("finished before a tick", knob == 2.0 && anim.active(&an) == 0);
    // Stale ids do nothing.
    anim.cancel(&an, f1);
    anim.finish(&an, f1);
    anim.cancel(&an, 0);
    anim.on_done(&an, f1, fn_ptr(on_done), cast(*u8, 0));
    check("stale ids", anim.running(&an, f1) == 0 && anim.running(&an, 0) == 0 && dones == 2);

    // --- Its widget destroyed: dropped, nothing written ---
    let is i64 as gone = tree.create(&t, &box_kind, root);
    knob = 1.0;
    let is i64 as g1 = anim.number(&an, gone, &knob, 9.0, 100, math.curve.EASE_LINEAR);
    anim.on_done(&an, g1, fn_ptr(on_done), cast(*u8, 0));
    anim.on_step(&an, g1, fn_ptr(on_step), cast(*u8, 0));
    let is i64 as g2 = anim.fade(&an, gone, 0.0, 100, math.curve.EASE_LINEAR);
    anim.tick(&an, 9000);
    let is i64 as steps_before = steps;
    tree.destroy(&t, gone);
    check("destroyed: still counted until a tick", anim.active(&an) == 2);
    check("destroyed: a tick runs nothing", anim.tick(&an, 9050) == 0);
    check("destroyed: dropped", anim.active(&an) == 0 && anim.running(&an, g1) == 0 && anim.running(&an, g2) == 0);
    check("destroyed: nothing written, nothing called", knob == 1.0 && steps == steps_before && dones == 2);
    check("a stale widget: no tween", anim.fade(&an, gone, 0.5, 100, math.curve.EASE_LINEAR) == 0
          && anim.last_error(&an) == anim.INVALID_HANDLE);
    check("nor a free-standing one", anim.number(&an, 0, &knob, 0.5, 100, math.curve.EASE_LINEAR) == 0);

    // --- Repeating ---
    knob = 0.0;
    let is i64 as r1 = anim.number(&an, w, &knob, 1.0, 100, math.curve.EASE_LINEAR);
    anim.set_repeat(&an, r1, 3, 0);
    anim.on_done(&an, r1, fn_ptr(on_done), cast(*u8, 0));
    anim.tick(&an, 10000);
    anim.tick(&an, 10150);
    check("repeating: the second run, half way", near(knob, 0.5));
    anim.tick(&an, 10290);
    check("repeating: the third", near(knob, 0.9) && anim.running(&an, r1) == 1);
    anim.tick(&an, 10300);
    check("repeating: ended at the end", knob == 1.0 && anim.running(&an, r1) == 0 && dones == 3);
    // Back and forth, for ever.
    knob = 0.0;
    let is i64 as r2 = anim.number(&an, w, &knob, 1.0, 100, math.curve.EASE_LINEAR);
    anim.set_repeat(&an, r2, 0, 1);
    anim.tick(&an, 11000);
    anim.tick(&an, 11025);
    check("alternating: out", near(knob, 0.25));
    anim.tick(&an, 11125);
    check("alternating: back", near(knob, 0.75));
    anim.tick(&an, 11000 + 100000);
    check("for ever", anim.running(&an, r2) == 1);
    anim.tick(&an, 111025);
    check("still alternating, a thousand runs on", near(knob, 0.25));
    anim.finish(&an, r2);
    check("for ever, finished: at the end", knob == 1.0 && anim.running(&an, r2) == 0);
    // An even number of runs back and forth ends where it began.
    knob = 0.0;
    let is i64 as r3 = anim.number(&an, w, &knob, 1.0, 100, math.curve.EASE_LINEAR);
    anim.set_repeat(&an, r3, 2, 1);
    anim.tick(&an, 12000);
    anim.tick(&an, 12500);
    check("back where it began", knob == 0.0 && anim.running(&an, r3) == 0);
    let is i64 as r4 = anim.number(&an, w, &knob, 1.0, 100, math.curve.EASE_LINEAR);
    anim.set_repeat(&an, r4, 2, 1);
    anim.tick(&an, 12600);
    anim.finish(&an, r4);
    check("finished back and forth: where its last run ends", knob == 0.0);
    knob = 3.0;
    let is i64 as r5 = anim.number(&an, w, &knob, 7.0, 100, math.curve.EASE_LINEAR);
    anim.set_repeat(&an, r5, 2, 1);
    anim.finish(&an, r5);
    check("finished before it began, back and forth: where it began", knob == 3.0);
    knob = 0.0;
    let is i64 as r6 = anim.number(&an, w, &knob, 1.0, 100, math.curve.EASE_LINEAR);
    anim.set_repeat(&an, r6, 0 - 1, 1);
    anim.tick(&an, 12700);
    anim.tick(&an, 12850);
    check("less than none is for ever too", near(knob, 0.5) && anim.running(&an, r6) == 1);
    anim.finish(&an, r6);
    check("finished on a run back: at its end, where it began", knob == 0.0);
    anim.set_repeat(&an, r4, 2, 1);
    check("a stale id repeats nothing", anim.active(&an) == 0);

    // --- A done starting the next ---
    chain_an = &an;
    chain_w = w;
    tree.set_opacity(&t, w, 1.0);
    let is i64 as away = anim.fade(&an, w, 0.0, 100, math.curve.EASE_LINEAR);
    anim.on_done(&an, away, fn_ptr(chain_back), cast(*u8, 0));
    anim.tick(&an, 13000);
    anim.tick(&an, 13100);
    check("chained: out, and the next waiting", tree.opacity(&t, w) == 0.0 && anim.active(&an) == 1);
    check("chained: due at once", anim.next_due(&an) == 13100);
    anim.tick(&an, 13116);
    anim.tick(&an, 13166);
    check("chained: back", near(tree.opacity(&t, w), 0.5));
    anim.tick(&an, 13216);

    // --- The frame interval ---
    anim.set_interval(&an, 7);
    anim.fade(&an, w, 0.5, 100, math.curve.EASE_LINEAR);
    anim.tick(&an, 14000);
    check("frames every 7 ms", anim.next_due(&an) == 14007);
    anim.set_interval(&an, 0);
    check("at least a millisecond", anim.next_due(&an) == 14001);
    anim.set_interval(&an, 16);
    anim.tick(&an, 14100);

    // --- No duration, or reduced motion: there at once, done at the next tick ---
    let is i64 as z = anim.fade(&an, w, 0.2, 0, math.curve.EASE_LINEAR);
    check("no duration: there at once", tree.opacity(&t, w) == 0.2);
    anim.on_done(&an, z, fn_ptr(on_done), cast(*u8, 0));
    anim.tick(&an, 15000);
    check("no duration: done at the tick", dones == 4 && anim.active(&an) == 0);
    tree.set_opacity(&t, w, 1.0);
    let is i64 as long = anim.fade(&an, w, 0.0, 1000, math.curve.EASE_LINEAR);
    anim.on_done(&an, long, fn_ptr(on_done), cast(*u8, 0));
    anim.tick(&an, 16000);
    anim.tick(&an, 16100);
    let is style.Theme as still = style.light();
    style.with_reduced_motion(&still, 1);
    tree.set_theme(&t, &still);
    anim.tick(&an, 16116);
    check("reduced while running: there at the next tick", tree.opacity(&t, w) == 0.0 && dones == 5);
    knob = 0.0;
    let is i64 as rq = anim.number(&an, w, &knob, 4.0, 300, math.curve.EASE_LINEAR);
    check("reduced: there at once", knob == 4.0 && rq != 0);
    anim.on_done(&an, rq, fn_ptr(on_done), cast(*u8, 0));
    anim.tick(&an, 17000);
    check("reduced: done at the next tick", dones == 6);
    // Reduced when made, not by the tick: there at once all the same, and
    // done at that tick rather than its whole duration later.
    let is i64 as rr = anim.number(&an, w, &knob, 6.0, 300, math.curve.EASE_LINEAR);
    tree.set_theme(&t, &th);
    anim.tick(&an, 17010);
    check("reduced when made: over at the tick", knob == 6.0 && anim.running(&an, rr) == 0);
    tree.set_theme(&t, &still);
    let is i64 as rf = anim.number(&an, w, &knob, 1.0, 100, math.curve.EASE_LINEAR);
    anim.set_repeat(&an, rf, 0, 0);
    anim.tick(&an, 17100);
    check("reduced: for ever is over at once", knob == 1.0 && anim.running(&an, rf) == 0);
    tree.set_theme(&t, &th);

    // --- Full: there at once, and said ---
    let is [80]f64 as many;
    let is i64 as k with mut = 0;
    while (k < anim.MAX_TWEENS) {
        many[k] = 0.0;
        anim.number(&an, w, &many[k], 1.0, 100, math.curve.EASE_LINEAR);
        k = k + 1;
    }
    many[k] = 0.0;
    check("full: no tween", anim.number(&an, w, &many[k], 3.0, 100, math.curve.EASE_LINEAR) == 0
          && anim.last_error(&an) == anim.FULL);
    check("full: there at once", many[k] == 3.0 && anim.active(&an) == anim.MAX_TWEENS);
    anim.tick(&an, 18000);
    anim.tick(&an, 18100);
    check("full: the rest ran", many[0] == 1.0 && many[anim.MAX_TWEENS - 1] == 1.0 && anim.active(&an) == 0);
    let is i64 as ok_again = anim.number(&an, w, &knob, 0.0, 100, math.curve.EASE_LINEAR);
    check("room again", ok_again != 0 && anim.last_error(&an) == anim.OK);
    anim.cancel(&an, ok_again);

    tree.close(&t);
    if (fails > 0) {
        io.printf("anim: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("anim: all checks passed\n");
    return 0;
}
