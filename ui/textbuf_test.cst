// ui/textbuf_test.cst — the text an entry or a text view edits: a gap
// buffer read back whole and in spans wherever the gap is; paragraphs
// indexed through every edit; line ends made line feeds; undo and redo in
// the groups a person would undo by; a large text.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "textbuf.cst" as textbuf;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

let is [4096]u8 as got with mut;

// Whether the buffer holds s, read whole.
fn holds(b as *textbuf.Buf, s as *u8) as i32 {
    let is i64 as n = len(s);
    if (textbuf.length(b) != n) { return 0; }
    textbuf.read(b, 0, n, cast(*u8, &got));
    let is i64 as i with mut = 0;
    while (i < n) {
        if (got[i] != s[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

fn edits() as void {
    let is textbuf.Buf as b = textbuf.open();
    check("empty", textbuf.length(&b) == 0 && textbuf.paragraphs(&b) == 1 && holds(&b, "") == 1);
    check("inserted", textbuf.insert(&b, 0, "hello", 5) == 1 && holds(&b, "hello") == 1 && textbuf.added(&b) == 5);
    textbuf.insert(&b, 5, " world", 6);
    check("at the end", holds(&b, "hello world") == 1);
    textbuf.insert(&b, 0, ">", 1);
    check("at the start", holds(&b, ">hello world") == 1);
    textbuf.insert(&b, 6, ",", 1);
    check("in the middle", holds(&b, ">hello, world") == 1);
    check("deleted", textbuf.delete(&b, 0, 1) == 1 && holds(&b, "hello, world") == 1);
    textbuf.delete(&b, 5, 1);
    check("in the middle", holds(&b, "hello world") == 1);
    textbuf.delete(&b, 6, 5);
    check("at the end", holds(&b, "hello ") == 1);
    check("past the end: refused", textbuf.delete(&b, 3, 10) == 0 && textbuf.insert(&b, 7, "x", 1) == 0 &&
          textbuf.delete(&b, 0 - 1, 1) == 0 && textbuf.insert(&b, 0 - 1, "x", 1) == 0 && holds(&b, "hello ") == 1);
    check("replaced", textbuf.replace(&b, 0, 5, "goodbye", 7) == 1 && holds(&b, "goodbye ") == 1);
    check("a byte", textbuf.byte_at(&b, 4) == 98 && textbuf.byte_at(&b, 8) == 0 - 1);
    // Read in parts, the gap anywhere.
    textbuf.insert(&b, 4, "-", 1);
    let is [8]u8 as part;
    textbuf.read(&b, 2, 5, cast(*u8, &part));
    check("a part across the gap", part[0] == 111 && part[1] == 100 && part[2] == 45 && part[3] == 98 && part[4] == 121);
    let is *u8 as sp = textbuf.span(&b, 1, 6);
    check("a span, in one piece", sp[0] == 111 && sp[2] == 100 && sp[3] == 45 && sp[5] == 121);
    check("its text whole, in one piece", same(textbuf.span(&b, 0, textbuf.length(&b)), 9, "good-bye ") == 1);
    textbuf.insert(&b, 0, "<", 1);
    let is *u8 as after = textbuf.span(&b, 3, 3);
    check("a span after the gap", after[0] == 111 && after[1] == 100 && after[2] == 45);
    let is *u8 as at_gap = textbuf.span(&b, 1, 2);
    check("a span starting at the gap", at_gap[0] == 103 && at_gap[1] == 111);
    check("nothing inserted: done", textbuf.insert(&b, 0, "x", 0) == 1 && textbuf.added(&b) == 0 &&
          holds(&b, "<good-bye ") == 1);
    check("replaced past the end: refused", textbuf.replace(&b, 8, 5, "x", 1) == 0 && holds(&b, "<good-bye ") == 1);
    textbuf.close(&b);
    check("closed: empty", textbuf.length(&b) == 0);

    // Grown with text after the gap: both sides kept.
    let is textbuf.Buf as g = textbuf.open();
    textbuf.insert(&g, 0, "head-tail", 9);
    let is [600]u8 as big;
    let is i64 as i with mut = 0;
    while (i < 600) {
        big[i] = cast(u8, 48 + i % 10);
        i = i + 1;
    }
    textbuf.insert(&g, 5, "-", 1);
    textbuf.insert(&g, 6, cast(*u8, &big), 600);
    let is *u8 as all = textbuf.span(&g, 0, textbuf.length(&g));
    check("grown in the middle: the head, the new, the tail", textbuf.length(&g) == 610 && all[0] == 104 &&
          all[5] == 45 && all[6] == 48 && all[605] == 57 && all[606] == 116 && all[609] == 108);
    textbuf.close(&g);
}

fn paragraphs() as void {
    let is textbuf.Buf as b = textbuf.open();
    textbuf.insert(&b, 0, "one\ntwo\nthree", 13);
    check("three paragraphs", textbuf.paragraphs(&b) == 3 && textbuf.para_start(&b, 0) == 0 &&
          textbuf.para_start(&b, 1) == 4 && textbuf.para_start(&b, 2) == 8);
    check("their ends, the line feed left out", textbuf.para_end(&b, 0) == 3 && textbuf.para_end(&b, 1) == 7 &&
          textbuf.para_end(&b, 2) == 13);
    check("which holds an offset", textbuf.para_of(&b, 0) == 0 && textbuf.para_of(&b, 3) == 0 &&
          textbuf.para_of(&b, 4) == 1 && textbuf.para_of(&b, 12) == 2 && textbuf.para_of(&b, 13) == 2);
    textbuf.insert(&b, 5, "w", 1);
    check("text in one: those after it moved", textbuf.para_start(&b, 2) == 9 && textbuf.para_end(&b, 1) == 8);
    textbuf.insert(&b, 1, "\nx\n", 3);
    check("line feeds in it: paragraphs made", textbuf.paragraphs(&b) == 5 && textbuf.para_start(&b, 1) == 2 &&
          textbuf.para_start(&b, 2) == 4 && textbuf.para_start(&b, 3) == 7 && holds(&b, "o\nx\nne\ntwwo\nthree") == 1);
    textbuf.delete(&b, 1, 3);
    check("taken out: paragraphs joined", textbuf.paragraphs(&b) == 3 && holds(&b, "one\ntwwo\nthree") == 1 &&
          textbuf.para_start(&b, 1) == 4 && textbuf.para_start(&b, 2) == 9);
    textbuf.delete(&b, 3, 7);
    check("across several: one left of them", textbuf.paragraphs(&b) == 1 && holds(&b, "onehree") == 1);
    textbuf.insert(&b, 3, "\nab", 3);
    textbuf.delete(&b, 4, 1);
    check("deleted from a paragraph's start: it stays", textbuf.paragraphs(&b) == 2 && textbuf.para_start(&b, 1) == 4 &&
          holds(&b, "one\nbhree") == 1);
    textbuf.delete(&b, 3, 2);
    check("its line feed and first: joined", textbuf.paragraphs(&b) == 1 && holds(&b, "onehree") == 1);
    textbuf.insert(&b, 0, "a\nb\nc\n", 6);
    textbuf.delete(&b, 1, 1);
    check("one line feed of three taken: the rest kept", textbuf.paragraphs(&b) == 3 &&
          textbuf.para_start(&b, 1) == 3 && textbuf.para_start(&b, 2) == 5 && holds(&b, "ab\nc\nonehree") == 1);
    textbuf.delete(&b, 0, 5);
    textbuf.insert(&b, 7, "\n", 1);
    check("a line feed last: an empty paragraph after it", textbuf.paragraphs(&b) == 2 &&
          textbuf.para_start(&b, 1) == 8 && textbuf.para_end(&b, 1) == 8);
    // Line ends as Windows and old Macs write them: line feeds.
    textbuf.insert(&b, 8, "a\r\nb\rc", 6);
    check("CR LF and CR: line feeds", holds(&b, "onehree\na\nb\nc") == 1 && textbuf.paragraphs(&b) == 4 &&
          textbuf.added(&b) == 5);
    let is *u8 as cr = "x\r";
    textbuf.insert(&b, 0, cr, 2);
    textbuf.insert(&b, 2, "\ny", 2);
    check("a CR then an LF apart: two", textbuf.paragraphs(&b) == 6);
    textbuf.close(&b);
}

fn undone() as void {
    let is textbuf.Buf as b = textbuf.open();
    // Typing: letter by letter, one step; a word's start breaks it.
    textbuf.type_in(&b, 0, "h", 1);
    textbuf.type_in(&b, 1, "i", 1);
    textbuf.type_in(&b, 2, " ", 1);
    textbuf.type_in(&b, 3, "y", 1);
    textbuf.type_in(&b, 4, "o", 1);
    check("typed", holds(&b, "hi yo") == 1 && textbuf.can_undo(&b) == 1 && textbuf.can_redo(&b) == 0);
    check("undone: the last word", textbuf.undo(&b) == 1 && holds(&b, "hi ") == 1 && textbuf.caret(&b) == 3);
    check("again: the first", textbuf.undo(&b) == 1 && holds(&b, "") == 1 && textbuf.caret(&b) == 0);
    check("nothing more", textbuf.undo(&b) == 0 && textbuf.can_undo(&b) == 0 && textbuf.can_redo(&b) == 1);
    check("redone", textbuf.redo(&b) == 1 && holds(&b, "hi ") == 1 && textbuf.caret(&b) == 3);
    check("again", textbuf.redo(&b) == 1 && holds(&b, "hi yo") == 1 && textbuf.caret(&b) == 5);
    check("nothing more to redo", textbuf.redo(&b) == 0);
    textbuf.break_group(&b);
    textbuf.type_in(&b, 5, "w", 1);
    textbuf.undo(&b);
    check("one letter redone: the caret after it", textbuf.redo(&b) == 1 && textbuf.caret(&b) == 6 &&
          holds(&b, "hi yow") == 1);
    textbuf.undo(&b);
    // Elsewhere: a step of its own; the caret moved: a step of its own.
    textbuf.type_in(&b, 0, "o", 1);
    textbuf.type_in(&b, 1, "h", 1);
    check("typed elsewhere", holds(&b, "ohhi yo") == 1);
    textbuf.undo(&b);
    check("undone on its own", holds(&b, "hi yo") == 1);
    textbuf.type_in(&b, 5, "u", 1);
    textbuf.break_group(&b);
    textbuf.type_in(&b, 6, "r", 1);
    textbuf.undo(&b);
    check("a break between: two steps", holds(&b, "hi you") == 1);
    textbuf.undo(&b);
    check("then the other", holds(&b, "hi yo") == 1);
    // A new edit drops what could be redone.
    check("something to redo", textbuf.can_redo(&b) == 1);
    textbuf.type_in(&b, 5, "!", 1);
    check("an edit: nothing to redo", textbuf.can_redo(&b) == 0);
    // Deleting: backspaces in a run, one step; deletes forward, one.
    textbuf.erase(&b, 5, 1);
    textbuf.erase(&b, 4, 1);
    textbuf.erase(&b, 3, 1);
    check("backspaced", holds(&b, "hi ") == 1);
    textbuf.undo(&b);
    check("undone: all of them, the caret after", holds(&b, "hi yo!") == 1 && textbuf.caret(&b) == 6);
    textbuf.break_group(&b);
    textbuf.erase(&b, 0, 1);
    textbuf.erase(&b, 0, 1);
    check("deleted forward", holds(&b, " yo!") == 1);
    textbuf.undo(&b);
    check("undone: both, the caret where it was", holds(&b, "hi yo!") == 1 && textbuf.caret(&b) == 0);
    check("redone: both", textbuf.redo(&b) == 1 && holds(&b, " yo!") == 1 && textbuf.caret(&b) == 0);
    textbuf.undo(&b);
    textbuf.break_group(&b);
    textbuf.erase(&b, 0, 1);
    textbuf.erase(&b, 0, 1);
    textbuf.erase(&b, 0, 1);
    check("three deletes", holds(&b, "yo!") == 1);
    textbuf.undo(&b);
    check("undone as one", holds(&b, "hi yo!") == 1);
    textbuf.break_group(&b);
    textbuf.erase(&b, 4, 1);
    textbuf.erase(&b, 3, 1);
    textbuf.erase(&b, 3, 1);
    check("backspaces then a delete", holds(&b, "hi ") == 1);
    textbuf.undo(&b);
    check("the delete undone alone", holds(&b, "hi !") == 1);
    textbuf.undo(&b);
    check("then the backspaces", holds(&b, "hi yo!") == 1 && textbuf.caret(&b) == 5);
    check("the backspaces redone, each of them", textbuf.redo(&b) == 1 && holds(&b, "hi !") == 1 &&
          textbuf.caret(&b) == 3);
    textbuf.undo(&b);
    // Deletes known to be forward — the Delete key's: never joined to a
    // backspace, the caret going back where it was.
    textbuf.break_group(&b);
    textbuf.erase(&b, 4, 1);
    check("deleted ahead", textbuf.erase_ahead(&b, 4, 1) == 1 && holds(&b, "hi y") == 1);
    textbuf.undo(&b);
    check("a backspace, then a delete: the delete alone", holds(&b, "hi y!") == 1 && textbuf.caret(&b) == 4);
    textbuf.undo(&b);
    check("then the backspace", holds(&b, "hi yo!") == 1 && textbuf.caret(&b) == 5);
    textbuf.break_group(&b);
    textbuf.erase_ahead(&b, 0, 1);
    textbuf.undo(&b);
    check("one delete undone: the caret where it was", holds(&b, "hi yo!") == 1 && textbuf.caret(&b) == 0);
    textbuf.break_group(&b);
    textbuf.erase_ahead(&b, 1, 1);
    textbuf.erase_ahead(&b, 1, 1);
    textbuf.erase(&b, 0, 1);
    check("deletes ahead, then a backspace", holds(&b, "yo!") == 1);
    textbuf.undo(&b);
    check("the backspace alone", holds(&b, "hyo!") == 1 && textbuf.caret(&b) == 1);
    textbuf.undo(&b);
    check("the deletes as one", holds(&b, "hi yo!") == 1 && textbuf.caret(&b) == 1);
    check("deleted ahead past the end: refused", textbuf.erase_ahead(&b, 6, 1) == 0 &&
          textbuf.erase_ahead(&b, 0 - 1, 1) == 0 && textbuf.erase_ahead(&b, 2, 0) == 0 && holds(&b, "hi yo!") == 1);
    // Text moved — dragged — a step of its own.
    check("moved after", textbuf.move(&b, 0, 2, 5) == 1 && holds(&b, " yohi!") == 1 && textbuf.can_undo(&b) == 1);
    textbuf.undo(&b);
    check("undone as one: the caret at its old end", holds(&b, "hi yo!") == 1 && textbuf.caret(&b) == 2);
    textbuf.redo(&b);
    check("redone: the caret after it where it went", holds(&b, " yohi!") == 1 && textbuf.caret(&b) == 5);
    textbuf.undo(&b);
    check("moved before", textbuf.move(&b, 3, 3, 0) == 1 && holds(&b, "yo!hi ") == 1);
    textbuf.undo(&b);
    check("into itself, or past the end: refused", textbuf.move(&b, 1, 3, 2) == 0 && textbuf.move(&b, 1, 3, 4) == 0 &&
          textbuf.move(&b, 4, 3, 0) == 0 && textbuf.move(&b, 0, 1, 7) == 0 && textbuf.move(&b, 0, 0, 3) == 0 &&
          holds(&b, "hi yo!") == 1);
    check("to its own edges: nothing to do, refused", textbuf.move(&b, 1, 2, 1) == 0 && textbuf.move(&b, 1, 2, 3) == 0);
    check("nothing erased: refused",textbuf.erase(&b, 1, 0) == 0 && textbuf.erase(&b, 6, 1) == 0 &&
          textbuf.erase(&b, 0 - 1, 1) == 0);
    check("the last byte erased", textbuf.erase(&b, 5, 1) == 1 && holds(&b, "hi yo") == 1);
    textbuf.undo(&b);
    check("changed past the end: refused", textbuf.change(&b, 4, 5, "x", 1) == 0 &&
          textbuf.change(&b, 0 - 1, 1, "x", 1) == 0 && holds(&b, "hi yo!") == 1);
    // A paste, and a replacement: each a step.
    textbuf.paste_in(&b, 2, " there", 6);
    textbuf.paste_in(&b, 8, ",", 1);
    textbuf.undo(&b);
    check("pastes: one at a time", holds(&b, "hi there yo!") == 1);
    textbuf.change(&b, 0, 2, "HI", 2);
    check("a replacement", holds(&b, "HI there yo!") == 1);
    textbuf.undo(&b);
    check("undone whole", holds(&b, "hi there yo!") == 1 && textbuf.caret(&b) == 2);
    textbuf.redo(&b);
    check("redone whole", holds(&b, "HI there yo!") == 1 && textbuf.caret(&b) == 2);
    // Typing after a replacement: a step of its own.
    textbuf.type_in(&b, 2, "!", 1);
    textbuf.undo(&b);
    check("typing after a replacement apart", holds(&b, "HI there yo!") == 1);
    // A plain edit — the program setting text — forgets what could be
    // undone, whose places it has moved; so does forgetting.
    check("something to undo", textbuf.can_undo(&b) == 1);
    textbuf.insert(&b, 0, "_", 1);
    check("a plain edit: nothing to undo", textbuf.can_undo(&b) == 0 && textbuf.undo(&b) == 0 &&
          holds(&b, "_HI there yo!") == 1);
    textbuf.type_in(&b, 0, "a", 1);
    textbuf.delete(&b, 0, 1);
    check("a plain deletion: the same", textbuf.can_undo(&b) == 0);
    textbuf.type_in(&b, 0, "a", 1);
    textbuf.replace(&b, 0, 1, "b", 1);
    check("a plain replacement: the same", textbuf.can_undo(&b) == 0 && holds(&b, "b_HI there yo!") == 1);
    textbuf.type_in(&b, 0, "a", 1);
    textbuf.undo(&b);
    textbuf.forget(&b);
    check("forgotten: nothing to undo or redo", textbuf.can_undo(&b) == 0 && textbuf.can_redo(&b) == 0);
    // The first step of all: an erase, a change.
    check("an erase first", textbuf.erase(&b, 0, 1) == 1 && textbuf.undo(&b) == 1 && holds(&b, "b_HI there yo!") == 1);
    let is textbuf.Buf as fresh with mut = textbuf.open();
    check("a paste first of all", textbuf.paste_in(&fresh, 0, "x", 1) == 1 && textbuf.length(&fresh) == 1 &&
          textbuf.undo(&fresh) == 1 && textbuf.length(&fresh) == 0);
    textbuf.close(&fresh);
    fresh = textbuf.open();
    textbuf.insert(&fresh, 0, "abc", 3);
    check("a delete first of all", textbuf.erase_ahead(&fresh, 0, 1) == 1 && textbuf.length(&fresh) == 2 &&
          textbuf.undo(&fresh) == 1 && textbuf.length(&fresh) == 3);
    textbuf.close(&fresh);
    fresh = textbuf.open();
    textbuf.insert(&fresh, 0, "abc", 3);
    check("a move first of all", textbuf.move(&fresh, 0, 1, 3) == 1 && textbuf.byte_at(&fresh, 2) == 97 &&
          textbuf.undo(&fresh) == 1 && textbuf.byte_at(&fresh, 0) == 97);
    textbuf.close(&fresh);
    textbuf.forget(&b);
    check("a change first, to the end", textbuf.change(&b, 11, 3, "you", 3) == 1 && holds(&b, "b_HI there you") == 1 &&
          textbuf.undo(&b) == 1 && holds(&b, "b_HI there yo!") == 1);
    textbuf.close(&b);
}

fn large() as void {
    let is textbuf.Buf as b = textbuf.open();
    let is [100]u8 as line;
    let is i64 as i with mut = 0;
    while (i < 99) {
        line[i] = cast(u8, 97 + i % 26);
        i = i + 1;
    }
    line[99] = 10;
    i = 0;
    while (i < 20000) {
        textbuf.insert(&b, textbuf.length(&b), cast(*u8, &line), 100);
        i = i + 1;
    }
    check("two megabytes", textbuf.length(&b) == 2000000 && textbuf.paragraphs(&b) == 20001);
    check("paragraph 12345 found", textbuf.para_of(&b, 1234567) == 12345 && textbuf.para_start(&b, 12345) == 1234500);
    // Edits near the start of a large text: the index kept.
    i = 0;
    while (i < 1000) {
        textbuf.type_in(&b, 50 + i, "x", 1);
        i = i + 1;
    }
    check("typed near its start", textbuf.length(&b) == 2001000 && textbuf.para_start(&b, 1) == 1100 &&
          textbuf.para_start(&b, 20000) == 2001000);
    textbuf.undo(&b);
    check("undone", textbuf.length(&b) == 2000000 && textbuf.para_start(&b, 1) == 100);
    textbuf.close(&b);
}

fn main() as i32 {
    edits();
    paragraphs();
    undone();
    large();
    if (fails == 0) {
        io.printf("textbuf: %d checks passed\n", checks);
        return 0;
    }
    io.printf("textbuf: %d of %d checks failed\n", fails, checks);
    return 1;
}
