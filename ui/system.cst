// ui/system.cst — the desktop's settings, as the toolkit uses them.
//
// window/ reads them (window/settings.cst: GTK's files, XSETTINGS, the
// portal); this turns them into the theme's preferences — dark, high
// contrast, the accent, the fonts and their size, text scaling, less motion —
// and into the input timings the router keeps: double-click time and
// distance, the drag threshold, the caret's blink. app.set_system does both
// for every window.
//
// The desktop gives font sizes in points; the toolkit lays out in logical
// pixels, 96 to the inch, so a point is 96/72 of one. The DPI is not a theme
// matter: it is the window's scale, which window/ reports per monitor.
use "../math/math.cst" as math;
use "../window/settings.cst" as wsettings;
use "style.cst" as style;
use "router.cst" as router;

// The theme's preferences from s. The font names point into s, which has to
// outlive the theme built from them — app.set_system keeps its own copy.
fn prefs(s as *wsettings.Settings) as style.Prefs {
    let is style.Prefs as p with mut = style.prefs_default();
    p.dark = s.dark;
    p.high_contrast = s.high_contrast;
    if (s.animations == 0) { p.reduce_motion = 1; }
    if ((s.known & wsettings.K_ACCENT) != 0) {
        p.has_accent = 1;
        p.accent = math.color.rgba(s.accent_r, s.accent_g, s.accent_b, 1.0);
    }
    if (s.font[0] != 0) {
        p.font_family = cast(*u8, &s.font);
        p.font_size = s.font_size * 96.0 / 72.0;
    }
    if (s.mono[0] != 0) { p.mono_family = cast(*u8, &s.mono); }
    p.text_scale = s.text_scale;
    return p;
}

// base with the timings s has: the rest of base — long press, which button
// opens a context menu — is the platform's, not the user's, and kept.
fn input(s as *wsettings.Settings, base as router.Settings) as router.Settings {
    let is router.Settings as t with mut = base;
    t.double_click_ms = s.double_click_ms;
    t.double_click_distance = cast(f64, s.double_click_px);
    t.drag_threshold = cast(f64, s.drag_px);
    t.caret_blink_ms = 0;
    if (s.blink == 1) { t.caret_blink_ms = s.blink_ms; }
    return t;
}
