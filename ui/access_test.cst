// ui/access_test.cst — what assistive technology is told about a widget:
// its kind's role, what its access entry says — name, description, states,
// value, actions — and what the tree and the router add; actions done through
// the same entry, and refused when the widget cannot do them.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "router.cst" as router;
use "access.cst" as access;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

// A toggle with a name, and a value in a range when ranged.
struct Probe {
    pressed as i64;
    presses as i64;
    asked   as i64;   // how many times its entry was called
    ranged  as i64;
    value   as f64;
    claims  as i64;   // says the tree's states itself, wrongly
}

fn probe_access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Probe as p = cast(*Probe, data);
    p.asked = p.asked + 1;
    if (q.action == access.ASK) {
        access.set_name(q, "Save", 4);
        access.set_description(q, "Saves the file", 14);
        q.actions = access.PRESS | access.TOGGLE;
        q.states = access.CHECKABLE;
        if (p.pressed == 1) { q.states = q.states | access.PRESSED; }
        if (p.claims == 1) { q.states = q.states | access.TREE_STATES; }
        if (p.ranged == 1) {
            access.set_range(q, p.value, 0.0, 10.0, 0.5);
            q.actions = q.actions | access.SET_VALUE;
        }
        return 1;
    }
    if (q.action == access.PRESS) {
        p.presses = p.presses + 1;
        return 1;
    }
    if (q.action == access.TOGGLE) {
        p.pressed = 1 - p.pressed;
        return 1;
    }
    if (q.action == access.SET_VALUE) {
        if (q.arg > 10.0) { return 0; }
        p.value = q.arg;
        return 1;
    }
    return 0;
}

fn probe_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    out.min_w = 10.0;
    out.min_h = 10.0;
    out.pref_w = 10.0;
    out.pref_h = 10.0;
    out.max_w = 10.0;
    out.max_h = 10.0;
}

let is tree.Kind as probe_kind with mut;
let is tree.Kind as plain_kind with mut;

fn main() as i32 {
    plain_kind = widget.kind("plain", 0);
    check("a new kind: no role, no entry",
          plain_kind.role == access.ROLE_NONE && cast(i64, plain_kind.access) == 0);
    probe_kind = widget.kind("probe", sizeof(Probe));
    probe_kind.role = access.ROLE_TOGGLE_BUTTON;
    probe_kind.access = fn_ptr(probe_access);
    probe_kind.measure = fn_ptr(probe_measure);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is i64 as box = tree.create(&t, &plain_kind, root);
    let is i64 as w = tree.create(&t, &probe_kind, box);
    let is *Probe as p = cast(*Probe, tree.data(&t, w));
    layout.run(&t, 100.0, 100.0);
    let is router.Router as r = router.init(router.settings_default());

    let is tree.Access as q;
    check("the root: a window", access.describe(&t, &r, root, &q) == 1 && q.role == access.ROLE_WINDOW);
    check("a kind with nothing to say: its role, no name, no actions, the tree's states",
          access.describe(&t, &r, box, &q) == 1 && q.role == access.ROLE_NONE && cast(i64, q.name) == 0 &&
          q.name_len == 0 && cast(i64, q.description) == 0 && q.actions == 0 && q.has_value == 0 &&
          q.states == (access.VISIBLE | access.SHOWING | access.ENABLED));

    check("described", access.describe(&t, &r, w, &q) == 1);
    check("the kind's role", q.role == access.ROLE_TOGGLE_BUTTON);
    check("its name and description", same(q.name, q.name_len, "Save") == 1 &&
          same(q.description, q.description_len, "Saves the file") == 1);
    check("its actions", q.actions == (access.PRESS | access.TOGGLE));
    check("its states with the tree's", q.states == (access.CHECKABLE | access.VISIBLE | access.SHOWING |
                                                     access.ENABLED));
    check("no value", q.has_value == 0);

    p.pressed = 1;
    access.describe(&t, &r, w, &q);
    check("a state of the kind's", (q.states & access.PRESSED) != 0);

    tree.set_focusable(&t, w, 1);
    access.describe(&t, &r, w, &q);
    check("focusable", (q.states & access.FOCUSABLE) != 0 && (q.states & access.FOCUSED) == 0);
    router.focus(&t, &r, w, 1);
    access.describe(&t, &r, w, &q);
    check("focused, by the router", (q.states & access.FOCUSED) != 0);
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("no router: nothing said of focus", (q.states & access.FOCUSED) == 0 &&
          (q.states & access.FOCUSABLE) != 0);

    tree.set_visible(&t, box, 0);
    access.describe(&t, &r, w, &q);
    check("its parent hidden: visible, not showing",
          (q.states & access.VISIBLE) != 0 && (q.states & access.SHOWING) == 0);
    tree.set_visible(&t, w, 0);
    access.describe(&t, &r, w, &q);
    check("hidden itself: neither", (q.states & (access.VISIBLE | access.SHOWING)) == 0);
    p.claims = 1;
    tree.set_visible(&t, box, 0);
    router.focus(&t, &r, 0, 1);
    access.describe(&t, &r, w, &q);
    check("the tree's states the tree's alone, whatever the kind says",
          (q.states & access.TREE_STATES) == (access.FOCUSABLE | access.ENABLED) &&
          (q.states & access.CHECKABLE) != 0);
    p.claims = 0;
    tree.set_visible(&t, box, 1);
    tree.set_visible(&t, w, 1);

    // --- Actions ---
    let is i64 as asked = p.asked;
    check("an action it answers to: done", access.act(&t, w, access.PRESS, 0.0) == 1 && p.presses == 1);
    check("toggled", access.act(&t, w, access.TOGGLE, 0.0) == 1 && p.pressed == 0);
    let is i64 as before with mut = p.asked;
    check("one it does not: refused, never passed on", access.act(&t, w, access.INCREMENT, 0.0) == 0 &&
          p.asked == before + 1);
    check("asking is not acting", p.presses == 1 && asked > 0);
    check("a kind with no entry does nothing", access.act(&t, box, access.PRESS, 0.0) == 0);
    tree.set_enabled(&t, box, 0);
    access.describe(&t, &r, w, &q);
    check("disabled by its parent: not enabled", (q.states & access.ENABLED) == 0);
    before = p.asked;
    check("disabled: refused without asking", access.act(&t, w, access.PRESS, 0.0) == 0 && p.presses == 1 &&
          p.asked == before);
    tree.set_enabled(&t, box, 1);

    // --- A value ---
    p.ranged = 1;
    p.value = 2.5;
    access.describe(&t, &r, w, &q);
    check("a value in a range", q.has_value == 1 && q.value == 2.5 && q.min == 0.0 && q.max == 10.0 &&
          q.step == 0.5 && (q.actions & access.SET_VALUE) != 0);
    check("set through the entry", access.act(&t, w, access.SET_VALUE, 7.0) == 1 && p.value == 7.0);
    check("one it answers to but could not do: said", access.act(&t, w, access.SET_VALUE, 11.0) == 0 &&
          p.value == 7.0);

    // --- Named by a label ---
    let is i64 as other = tree.create(&t, &plain_kind, box);
    tree.set_labelled_by(&t, other, w);
    access.describe(&t, &r, other, &q);
    check("no name of its own: its label's", same(q.name, q.name_len, "Save") == 1 && cast(i64, q.description) == 0 &&
          q.role == access.ROLE_NONE);
    let is i64 as w2 = tree.create(&t, &probe_kind, box);
    tree.set_labelled_by(&t, w2, other);
    access.describe(&t, &r, w2, &q);
    check("a name of its own kept", same(q.name, q.name_len, "Save") == 1);
    tree.set_labelled_by(&t, other, other);
    access.describe(&t, &r, other, &q);
    check("labelled by itself: no name, and no loop", cast(i64, q.name) == 0 && q.name_len == 0);
    tree.set_labelled_by(&t, other, w);

    // --- Gone ---
    tree.destroy(&t, w);
    check("a destroyed widget: nothing to say", access.describe(&t, &r, w, &q) == 0 && q.role == access.ROLE_NONE &&
          q.states == 0);
    check("nor to do", access.act(&t, w, access.PRESS, 0.0) == 0);
    access.describe(&t, &r, other, &q);
    check("its label gone: no name", cast(i64, q.name) == 0 && q.name_len == 0);

    // --- Names a bridge maps ---
    check("role names", same(access.role_name(access.ROLE_BUTTON), 6, "button") == 1 &&
          same(access.role_name(access.ROLE_CHECK_BOX), 9, "check box") == 1 &&
          same(access.role_name(access.ROLE_NONE), 4, "none") == 1 &&
          same(access.role_name(access.ROLE_LAST + 1), 7, "unknown") == 1 &&
          same(access.role_name(0 - 1), 7, "unknown") == 1);
    let is i64 as k with mut = 0;
    let is i32 as named with mut = 1;
    while (k <= access.ROLE_LAST) {
        if (same(access.role_name(k), 7, "unknown") == 1) { named = 0; }
        k = k + 1;
    }
    check("every role named", named);

    tree.close(&t);
    if (fails == 0) {
        io.printf("access: %d checks passed\n", checks);
        return 0;
    }
    io.printf("access: %d of %d checks failed\n", fails, checks);
    return 1;
}
