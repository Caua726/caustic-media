// ui/session.cst — a session bus connection run by the application's loop.
//
// What the toolkit says to the desktop over D-Bus — that this is the
// application's one instance (instance.cst), notifications (notify.cst), its
// tray icon (tray.cst), a link to open (open_uri.cst) — goes over one
// session connection of the program's, dispatched by its loop whenever it
// is readable, so the desktop's calls and signals are answered as they come.
use "../dbus/dbus.cst" as dbus;
use "host.cst" as host;

struct Session {
    c  as dbus.conn.Conn;
    hs as *host.Host;
    on as i32;
    _pad as i32;
}

fn _readable(user as *u8, fd as i64) as void { dbus.conn.dispatch(&cast(*Session, user).c, 0); }

// A session connection, dispatched by hs from now on — s where the program
// keeps it: 1, or 0 with no session bus.
fn open(s as *Session, hs as *host.Host) as i32 {
    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    s.c = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&s.c) == 0) { return 0; }
    s.hs = hs;
    host.watch(hs, dbus.conn.fd(&s.c), fn_ptr(_readable), cast(*u8, s));
    s.on = 1;
    return 1;
}

fn conn(s as *Session) as *dbus.conn.Conn { return &s.c; }

fn close(s as *Session) as void {
    if (s.on == 0) { return; }
    host.unwatch(s.hs, dbus.conn.fd(&s.c));
    dbus.conn.close(&s.c);
    s.on = 0;
}
