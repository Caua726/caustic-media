// ui/popup.cst — something shown over the window until it is dismissed.
//
// A popup holds what is made with it as parent — a list to choose from, a
// popover's controls — framed in the popover colour, out of sight until opened
// against a rectangle of the window: placed by the positioner from an anchor
// point of it, growing as a gravity says, flipped from an edge it would cross,
// slid back inside, cut to the room there is (surface.cst). Where the host
// lends the tree its windows it is shown in a platform popup of its own,
// reaching past the window's edges, cut to the screen; elsewhere it is drawn
// inside the window, on a layer above it, cut to the window.
//
// In a window of its own that shows what is behind it, a shadow lies round
// its frame and its corners are rounded, the shadow taking no input; where it
// does not — X11 or Windows with no compositor — it is flat, square, as the
// window it is in. Opened against a widget (open_from), it follows that
// widget as it moves.
//
// While it is open the window's input is its own: it is the router's modal
// scope, so Tab goes round what it holds; a press outside closes it, spent on
// that, and so does Escape from anywhere in it — and so does the window
// system taking its window down. Opened, the focus goes to the first of what
// it holds that takes it, or to the popup itself — or stays where it is,
// what has it let through the scope, as an entry typed in while what it
// suggests is shown; then it takes no grab, the keyboard staying with the
// entry and its input method. Closed, the focus goes back where it was.
// CLOSED says it closed, by whatever. Told as a panel.
//
// With an arrow (set_arrow) it is a popover: an ARROW-long point on the side
// facing what it was opened against, pointing at that rectangle's middle — or
// as near as its rounded corners let it — and moving to the other side when
// the popup is flipped.
use "../math/math.cst" as math;
use "../input/keys.cst" as keys;
use "../render/shapes2d.cst" as shapes;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "event.cst" as event;
use "painter.cst" as painter;
use "style.cst" as style;
use "access.cst" as access;
use "router.cst" as router;
use "signal.cst" as signal;
use "../window/positioner.cst" as positioner;
use "surface.cst" as surface;

let is i64 as LAYER with imut = 900;   // under menus, which a popup's controls may open
let is f64 as ARROW with imut = 8.0;   // how far a popover's arrow reaches out

// Where the focus goes as it opens: to the popup, to the first of what it
// holds, or left where it is — an entry typed in while what it suggests is
// shown.
let is i32 as FOCUS_SELF  with imut = 0;
let is i32 as FOCUS_FIRST with imut = 1;
let is i32 as KEEP_FOCUS  with imut = 2;

struct Data {
    r          as *router.Router;   // while it is open
    prev_scope as i64;
    prev_focus as i64;
    prev_ring  as i32;
    open       as i32;
    at         as math.rect.Rect;   // where it is, in the window: its frame, its arrow, no shadow
    to         as math.rect.Rect;   // what it was opened against
    arrow      as i32;              // a popover's
    across     as i32;              // its arrow at its left or right, opened beside
    side       as i32;              // where its arrow is: positioner.TOP, BOTTOM, LEFT, RIGHT; NONE
    kind       as i32;              // its window's: surface.MENU, or LIST for a list dropping down
    shadow     as f64;              // how far its shadow reaches round it; 0 for none
    flat       as i32;              // in a window that shows nothing behind it: square, no shadow
    _pad0      as i32;
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("popup", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.paint = fn_ptr(_paint);
    _kind.event = fn_ptr(_event);
    _kind.destroy = fn_ptr(_destroy);
    _kind.role = access.ROLE_PANEL;
    _ready = 1;
}

// A new popup, closed, as the last child of the tree's root. Its handle, or 0.
fn create(t as *tree.Tree) as i64 {
    _init();
    let is i64 as p = tree.create(t, &_kind, tree.root(t));
    if (p == 0) { return 0; }
    tree.set_visible(t, p, 0);
    tree.set_focusable(t, p, 1);
    tree.set_layer(t, p, LAYER);
    layout.set_align(t, p, layout.START, layout.START);
    _data(t, p).kind = surface.MENU;
    return p;
}

// What its window is to the platform: surface.MENU, as a popup starts, or
// surface.LIST for a list dropping down from a control.
fn set_kind(t as *tree.Tree, p as i64, kind as i32) as void {
    let is *Data as d = _data(t, p);
    if (cast(i64, d) == 0) { return; }
    d.kind = kind;
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    return cast(*Data, tree.data_of(t, w, &_kind));
}

// What it holds: its first child.
fn content(t as *tree.Tree, p as i64) as i64 {
    if (cast(i64, _data(t, p)) == 0) { return 0; }
    return tree.first_child(t, p);
}

fn is_open(t as *tree.Tree, p as i64) as i32 {
    let is *Data as d = _data(t, p);
    if (cast(i64, d) == 0) { return 0; }
    return d.open;
}

// An arrow pointing at what it is opened against (1), or none (0, at first).
fn set_arrow(t as *tree.Tree, p as i64, on as i32) as void {
    let is *Data as d = _data(t, p);
    if (cast(i64, d) == 0) { return; }
    d.arrow = on;
    widget.changed(t, p, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
}

// Which side its arrow is on, positioner.NONE for none.
fn arrow_side(t as *tree.Tree, p as i64) as i32 {
    let is *Data as d = _data(t, p);
    if (cast(i64, d) == 0 || d.arrow == 0) { return positioner.NONE; }
    return d.side;
}

fn _clamp(v as f64, lo as f64, hi as f64) as f64 {
    if (lo > hi) { return (lo + hi) / 2.0; }
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

// Its arrow's box, in the window: empty for none.
fn arrow_rect(t as *tree.Tree, p as i64) as math.rect.Rect {
    let is *Data as d = _data(t, p);
    if (cast(i64, d) == 0 || d.arrow == 0 || d.side == positioner.NONE) { return math.rect.rect_zero(); }
    let is style.Theme as th;
    widget.theme(t, p, &th);
    let is f64 as k = th.metrics.radius_m + ARROW;
    let is math.rect.Rect as a = d.at;
    if (d.side == positioner.TOP || d.side == positioner.BOTTOM) {
        let is f64 as x = _clamp(d.to.x + d.to.w / 2.0, a.x + k, a.x + a.w - k);
        let is f64 as y with mut = a.y;
        if (d.side == positioner.BOTTOM) { y = a.y + a.h - ARROW; }
        return math.rect.rect(x - ARROW, y, 2.0 * ARROW, ARROW);
    }
    let is f64 as cy = _clamp(d.to.y + d.to.h / 2.0, a.y + k, a.y + a.h - k);
    let is f64 as x with mut = a.x;
    if (d.side == positioner.RIGHT) { x = a.x + a.w - ARROW; }
    return math.rect.rect(x, cy - ARROW, ARROW, 2.0 * ARROW);
}

// Where it was put, in the window.
fn placed(t as *tree.Tree, p as i64) as math.rect.Rect {
    let is *Data as d = _data(t, p);
    if (cast(i64, d) == 0) { return math.rect.rect_zero(); }
    return d.at;
}

// Opened against rect — the window's coordinates — from its anchor point,
// growing as gravity says, kept inside the room there is; the focus as focus
// says (FOCUS_SELF, FOCUS_FIRST or KEEP_FOCUS). Opened again, it moves. 1, or
// 0 for no popup.
fn open_at(t as *tree.Tree, r as *router.Router, p as i64, rect as math.rect.Rect, anchor as i32, gravity as i32,
           focus as i32) as i32 {
    return open_from(t, r, p, 0, rect, anchor, gravity, focus);
}

// The same, rect what of widget from it is opened against — and placed again
// when from moves.
fn open_from(t as *tree.Tree, r as *router.Router, p as i64, from as i64, rect as math.rect.Rect, anchor as i32,
             gravity as i32, focus as i32) as i32 {
    let is *Data as d = _data(t, p);
    if (cast(i64, d) == 0) { return 0; }
    if (d.open == 0) {
        d.prev_scope = router.scope(r);
        d.prev_focus = router.focused(t, r);
        d.prev_ring = router.focus_visible(r);
    }
    d.to = rect;
    d.across = cast(i32, gravity == positioner.LEFT || gravity == positioner.RIGHT);
    let is i64 as kept = router.focused(t, r);
    d.r = r;
    d.open = 1;
    tree.set_visible(t, p, 1);
    _place(t, p, d, from, rect, anchor, gravity, cast(i32, focus != KEEP_FOCUS));
    layout.run(t, layout.rect(t, tree.root(t)).w, layout.rect(t, tree.root(t)).h);
    // Keeping the focus, what has it is let through the scope.
    if (focus == KEEP_FOCUS) { router.set_scope_also(t, r, p, kept); } else { router.set_scope(t, r, p); }
    // What the hover asked for as the scope moved is not what is chosen.
    tree.take_focus_request(t);
    // It holds the focus itself only when nothing it holds takes it — or when
    // asked to: otherwise it would be a stop for Tab among them.
    if (focus == KEEP_FOCUS) {
        tree.set_focusable(t, p, 0);
        return 1;
    }
    tree.set_focusable(t, p, 1);
    router.focus(t, r, p, 0);
    if (focus == FOCUS_FIRST) {
        router.focus_next(t, r, 1);
        if (router.focused(t, r) != p) { tree.set_focusable(t, p, 0); }
    }
    return 1;
}

// How the positioner moves it so that its frame, not its shadow, meets what
// it is opened against: back by the shadow along the way it grows.
fn _toward(g as i32, along as i32) as f64 {
    if (along == 0) {
        if (g == positioner.LEFT || g == positioner.TOP_LEFT || g == positioner.BOTTOM_LEFT) { return 0.0 - 1.0; }
        if (g == positioner.RIGHT || g == positioner.TOP_RIGHT || g == positioner.BOTTOM_RIGHT) { return 1.0; }
        return 0.0;
    }
    if (g == positioner.TOP || g == positioner.TOP_LEFT || g == positioner.TOP_RIGHT) { return 0.0 - 1.0; }
    if (g == positioner.BOTTOM || g == positioner.BOTTOM_LEFT || g == positioner.BOTTOM_RIGHT) { return 1.0; }
    return 0.0;
}

fn _shadow_reach(th as *style.Theme) as f64 {
    let is style.Shadow as sh = th.metrics.shadow_m;
    let is f64 as off with mut = sh.y;
    if (off < 0.0) { off = 0.0 - off; }
    if (sh.x > off) { off = sh.x; }
    if (0.0 - sh.x > off) { off = 0.0 - sh.x; }
    return sh.blur + off;
}

// Placed through surface.cst — in a window of its own, or inside this one —
// a shadow round it when its window shows what is behind it.
fn _place(t as *tree.Tree, p as i64, d as *Data, from as i64, rect as math.rect.Rect, anchor as i32, gravity as i32,
          grab as i32) as void {
    let is style.Theme as th;
    widget.theme(t, p, &th);
    let is i32 as adjust = positioner.FLIP_X | positioner.FLIP_Y | positioner.SLIDE_X | positioner.SLIDE_Y | positioner.RESIZE_Y;
    let is i32 as tries with mut = 0;
    while (tries < 2) {
        // A shadow where its window will show one: as the host says, then
        // as its window turned out.
        if (tries == 0) {
            d.shadow = 0.0;
            if (surface.clear(t) == 1) { d.shadow = _shadow_reach(&th); }
        }
        let is f64 as m = d.shadow;
        surface.open_offset(t, p, d.kind, grab, from, rect, anchor, gravity, adjust,
                            0.0 - m * _toward(gravity, 0), 0.0 - m * _toward(gravity, 1));
        let is i32 as native = surface.is_native(t, p);
        let is i32 as clear = cast(i32, native == 1 && tree.surface_see_through(t, tree.surface_index(t, p)) == 1);
        d.flat = cast(i32, native == 1 && clear == 0);
        let is i32 as want_shadow = clear;
        if ((want_shadow == 1) == (d.shadow > 0.0)) { tries = 2; } else {
            d.shadow = 0.0;
            if (want_shadow == 1) { d.shadow = _shadow_reach(&th); }
            tries = tries + 1;
        }
    }
    _sides(t, p, d, rect);
    widget.changed(t, p, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    widget.changed(t, tree.root(t), widget.CHANGED_LAYOUT);
}

// Where its frame is now, window coordinates, and which side its arrow is on.
fn _sides(t as *tree.Tree, p as i64, d as *Data, rect as math.rect.Rect) as void {
    let is math.rect.Rect as all = surface.rect(t, p);
    let is f64 as m = d.shadow;
    d.at = math.rect.rect(all.x + m, all.y + m, all.w - 2.0 * m, all.h - 2.0 * m);
    d.side = positioner.NONE;
    if (d.across == 0 && d.at.y >= rect.y + rect.h - 0.5) { d.side = positioner.TOP; }
    if (d.across == 0 && d.at.y + d.at.h <= rect.y + 0.5) { d.side = positioner.BOTTOM; }
    if (d.across == 1 && d.at.x >= rect.x + rect.w - 0.5) { d.side = positioner.LEFT; }
    if (d.across == 1 && d.at.x + d.at.w <= rect.x + 0.5) { d.side = positioner.RIGHT; }
    // Its window takes the pointer over its frame, not over its shadow.
    surface.set_input(t, p, d.at);
}

// Closed: the window's input and the focus given back as they were; CLOSED.
fn close(t as *tree.Tree, p as i64) as void {
    let is *Data as d = _data(t, p);
    if (cast(i64, d) == 0 || d.open == 0) { return; }
    d.open = 0;
    tree.set_visible(t, p, 0);
    surface.close(t, p);
    let is *router.Router as r = d.r;
    d.r = cast(*router.Router, 0);
    router.restore(t, r, d.prev_scope, d.prev_focus, d.prev_ring);
    signal.emit(t, p, signal.CLOSED, cast(*u8, 0));
}

// Destroyed open, its scope must not outlive it.
fn _destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Data as d = cast(*Data, data);
    if (d.open == 1 && cast(i64, d.r) != 0) { router.set_scope(t, d.r, d.prev_scope); }
}

fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Data as d = cast(*Data, data);
    if (d.open == 0) { return 0; }
    if (e.kind == event.PRESS_OUTSIDE) {
        close(t, w);
        return 1;
    }
    if (e.kind == event.KEY_DOWN && e.key == keys.ESCAPE && e.mods == 0) {
        close(t, w);
        return 1;
    }
    return 0;
}

// --- Measured, arranged, drawn ---

fn _pad(th as *style.Theme) as f64 { return th.metrics.space_xs + th.metrics.border_width; }

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as pad = _pad(&th);
    geom.size_zero(out);
    let is i64 as ch = tree.first_child(t, w);
    if (ch != 0) {
        let is geom.Constraint as free = geom.unbounded();
        layout.measure(t, ch, &free, out);
    }
    // Room for an arrow on the side that will face what it is opened against.
    let is f64 as ax with mut = 0.0;
    let is f64 as ay with mut = 0.0;
    if (d.arrow == 1 && d.across == 1) { ax = ARROW; }
    if (d.arrow == 1 && d.across == 0) { ay = ARROW; }
    // And its shadow's, round all of it.
    let is f64 as m = 2.0 * d.shadow;
    out.pref_w = out.pref_w + 2.0 * pad + ax + m;
    out.pref_h = out.pref_h + 2.0 * pad + ay + m;
    out.min_w = out.min_w + 2.0 * pad + ax + m;
    out.min_h = 2.0 * pad + ay + m;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// Its frame: all of it but where its arrow is.
fn _frame(d as *Data, r as math.rect.Rect) as math.rect.Rect {
    let is math.rect.Rect as f with mut = r;
    if (d.arrow == 0) { return f; }
    if (d.side == positioner.TOP) {
        f.y = f.y + ARROW;
        f.h = f.h - ARROW;
    } else if (d.side == positioner.BOTTOM || (d.side == positioner.NONE && d.across == 0)) {
        f.h = f.h - ARROW;
    } else if (d.side == positioner.LEFT) {
        f.x = f.x + ARROW;
        f.w = f.w - ARROW;
    } else {
        f.w = f.w - ARROW;
    }
    return f;
}

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as pad = _pad(&th);
    // Placed again — what it is anchored to moved — its frame where it is now.
    if (d.open == 1) {
        d.to = surface.anchor_rect(t, w);
        _sides(t, w, d, d.to);
    }
    let is i64 as ch = tree.first_child(t, w);
    if (ch == 0) { return; }
    let is f64 as m = d.shadow;
    let is math.rect.Rect as f = _frame(d, math.rect.rect(m, m, r.w - 2.0 * m, r.h - 2.0 * m));
    let is math.rect.Rect as at = math.rect.rect(f.x + pad, f.y + pad, f.w - 2.0 * pad, f.h - 2.0 * pad);
    layout.place(t, ch, &at);
}

// A rounded frame in the popover colour, bordered; a popover's arrow out
// of it, its border along the arrow's two edges.
fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Data as d = cast(*Data, data);
    let is *style.Theme as th = p.theme;
    let is f64 as m = d.shadow;
    let is math.rect.Rect as rc = _frame(d, math.rect.rect(p.rect.x + m, p.rect.y + m, p.rect.w - 2.0 * m, p.rect.h - 2.0 * m));
    let is f64 as rad with mut = th.metrics.radius_m;
    // In a window that shows nothing behind it: square, as that window is.
    if (d.flat == 1) { rad = 0.0; }
    let is f64 as bw = th.metrics.border_width;
    if (m > 0.0) {
        let is style.Shadow as sh = th.metrics.shadow_m;
        shapes.shadow(p.canvas, rc.x + sh.x, rc.y + sh.y, rc.w, rc.h, rad, sh.blur, sh.color);
    }
    shapes.fill_rounded(p.canvas, rc.x, rc.y, rc.w, rc.h, rad, rad, rad, rad, th.palette.popover_bg);
    if (bw > 0.0) {
        shapes.stroke_rounded(p.canvas, rc.x, rc.y, rc.w, rc.h, rad, rad, rad, rad, bw, th.palette.border);
    }
    p.fg = th.palette.fg;
    let is math.rect.Rect as ar = arrow_rect(t, w);
    if (ar.w <= 0.0) { return; }
    // The window's arrow box, in this paint's coordinates.
    let is math.rect.Rect as wr = layout.window_rect(t, w);
    let is f64 as ox = p.rect.x - wr.x;
    let is f64 as oy = p.rect.y - wr.y;
    let is [3]f64 as xs;
    let is [3]f64 as ys;
    let is f64 as x0 = ar.x + ox;
    let is f64 as y0 = ar.y + oy;
    if (d.side == positioner.TOP) {
        xs[0] = x0;            ys[0] = y0 + ar.h + bw;
        xs[1] = x0 + ar.w;     ys[1] = y0 + ar.h + bw;
        xs[2] = x0 + ar.w / 2.0; ys[2] = y0;
    } else if (d.side == positioner.BOTTOM) {
        xs[0] = x0;            ys[0] = y0 - bw;
        xs[1] = x0 + ar.w;     ys[1] = y0 - bw;
        xs[2] = x0 + ar.w / 2.0; ys[2] = y0 + ar.h;
    } else if (d.side == positioner.LEFT) {
        xs[0] = x0 + ar.w + bw; ys[0] = y0;
        xs[1] = x0 + ar.w + bw; ys[1] = y0 + ar.h;
        xs[2] = x0;            ys[2] = y0 + ar.h / 2.0;
    } else {
        xs[0] = x0 - bw;       ys[0] = y0;
        xs[1] = x0 - bw;       ys[1] = y0 + ar.h;
        xs[2] = x0 + ar.w;     ys[2] = y0 + ar.h / 2.0;
    }
    shapes.fill_convex(p.canvas, cast(*f64, &xs), cast(*f64, &ys), 3, th.palette.popover_bg);
    if (bw > 0.0) {
        shapes.line(p.canvas, xs[0], ys[0], xs[2], ys[2], bw, th.palette.border);
        shapes.line(p.canvas, xs[1], ys[1], xs[2], ys[2], bw, th.palette.border);
    }
}
