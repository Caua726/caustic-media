// ui/winstate_test.cst — a window's size and state kept between runs: where
// the file goes, written and read back, refused when it is not what was
// written, and what the application knows of a window to keep.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "std/env.cst" as env;
use "app.cst" as app;
use "winstate.cst" as winstate;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

fn digits(v as i64, out as *u8) as i64 {
    let is [24]u8 as tmp;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    while (x > 0) {
        tmp[n] = cast(u8, 48 + x % 10);
        n = n + 1;
        x = x / 10;
    }
    let is i64 as k with mut = 0;
    while (n > 0) {
        n = n - 1;
        out[k] = tmp[n];
        k = k + 1;
    }
    return k;
}

let is [256]u8 as root with mut;
let is i64 as rn with mut = 0;

fn put_file(p as *u8, s as *u8) as void {
    let is i64 as fd = linux.open(p, 577, 420);
    linux.write(fd, s, len(s));
    linux.close(fd);
}

fn read_file(p as *u8, out as *u8, cap as i64) as i64 {
    let is i64 as fd = linux.open(p, 0, 0);
    if (fd < 0) { return 0 - 1; }
    let is i64 as n = linux.read(fd, out, cap);
    linux.close(fd);
    return n;
}

fn paths() as void {
    let is [512]u8 as b;
    let is i64 as n with mut = winstate.path_in("/home/u", "", "org.example.Demo", 16, "main", 4, cast(*u8, &b), 512);
    check("under ~/.local/state, a folder for the program", same(cast(*u8, &b), n, "/home/u/.local/state/org.example.Demo/main.window") == 1);
    n = winstate.path_in("/home/u", "/var/st", "org.example.Demo", 16, "main", 4, cast(*u8, &b), 512);
    check("under XDG_STATE_HOME when it is set", same(cast(*u8, &b), n, "/var/st/org.example.Demo/main.window") == 1);
    n = winstate.path_in("/home/u", "relative/st", "Demo", 4, "w", 1, cast(*u8, &b), 512);
    check("a relative XDG_STATE_HOME: not taken", same(cast(*u8, &b), n, "/home/u/.local/state/Demo/w.window") == 1);
    check("no home and no XDG_STATE_HOME: nowhere", winstate.path_in("", "", "Demo", 4, "w", 1, cast(*u8, &b), 512) == 0);
    n = winstate.path_in("/home/u", cast(*u8, 0), "Demo", 4, "w", 1, cast(*u8, &b), 512);
    check("XDG_STATE_HOME unset", same(cast(*u8, &b), n, "/home/u/.local/state/Demo/w.window") == 1 &&
          winstate.path_in(cast(*u8, 0), cast(*u8, 0), "Demo", 4, "w", 1, cast(*u8, &b), 512) == 0);
    n = winstate.path_in("/home/u", "", "ab", 2, "..", 2, cast(*u8, &b), 512);
    check("two letters fine, \"..\" not", same(cast(*u8, &b), winstate.path_in("/home/u", "", "ab", 2, "w", 1, cast(*u8, &b), 512),
          "/home/u/.local/state/ab/w.window") == 1 && n == 0);
    check("a name with a slash: refused", winstate.path_in("/home/u", "", "a/b", 3, "w", 1, cast(*u8, &b), 512) == 0 &&
          winstate.path_in("/home/u", "", "Demo", 4, "../w", 4, cast(*u8, &b), 512) == 0 &&
          winstate.path_in("/home/u", "", "", 0, "w", 1, cast(*u8, &b), 512) == 0 &&
          winstate.path_in("/home/u", "", "Demo", 4, "", 0, cast(*u8, &b), 512) == 0 &&
          winstate.path_in("/home/u", "", ".", 1, "w", 1, cast(*u8, &b), 512) == 0);
    check("not fitting: nothing", winstate.path_in("/home/u", "", "Demo", 4, "w", 1, cast(*u8, &b), 20) == 0);
    let is i64 as exact = len("/home/u/.local/state/Demo/w.window");
    check("one that just fits", winstate.path_in("/home/u", "", "Demo", 4, "w", 1, cast(*u8, &b), exact) == exact &&
          winstate.path_in("/home/u", "", "Demo", 4, "w", 1, cast(*u8, &b), exact - 1) == 0);
}

fn kept() as void {
    // A state home of the test's own.
    let is [512]u8 as p;
    let is i64 as n with mut = winstate.path_in("/nowhere", cast(*u8, &root), "Demo", 4, "main", 4, cast(*u8, &p), 511);
    p[n] = cast(u8, 0);
    let is winstate.State as st with mut = winstate.state(800.0, 600.0);
    st.maximized = 1;
    check("written, its folders made", winstate.write(cast(*u8, &p), n, &st) == 1);
    let is [256]u8 as text;
    let is i64 as tn with mut = read_file(cast(*u8, &p), cast(*u8, &text), 256);
    check("as lines of key and value", tn > 0 && same(cast(*u8, &text), tn, "width=800\nheight=600\nmaximized=1\nfullscreen=0\n") == 1);
    let is winstate.State as back with mut = winstate.state(1.0, 1.0);
    check("read back", winstate.read(cast(*u8, &p), n, &back) == 1 && back.width == 800.0 && back.height == 600.0 &&
          back.maximized == 1 && back.fullscreen == 0);
    // A fractional size, to a tenth.
    st = winstate.state(1024.5, 700.25);
    st.fullscreen = 1;
    winstate.write(cast(*u8, &p), n, &st);
    tn = read_file(cast(*u8, &p), cast(*u8, &text), 256);
    check("a size to a tenth", same(cast(*u8, &text), tn, "width=1024.5\nheight=700.3\nmaximized=0\nfullscreen=1\n") == 1);
    check("and read so", winstate.read(cast(*u8, &p), n, &back) == 1 && back.width == 1024.5 && back.height == 700.3 &&
          back.fullscreen == 1 && back.maximized == 0);
    // No temporary file left behind.
    let is [520]u8 as tmp;
    mem.memcpy(cast(*u8, &tmp), cast(*u8, &p), n);
    mem.memcpy(cast(*u8, cast(i64, &tmp) + n), ".new", 5);
    let is [144]u8 as sb;
    check("written whole, by another name moved over it", linux.stat(cast(*u8, &tmp), cast(*u8, &sb)) != 0);
    // What is not as written: refused, the state as it was.
    put_file(cast(*u8, &p), "width=0\nheight=600\n");
    back = winstate.state(5.0, 6.0);
    check("no width: refused, untouched", winstate.read(cast(*u8, &p), n, &back) == 0 && back.width == 5.0 && back.height == 6.0);
    put_file(cast(*u8, &p), "width=40000\nheight=600\n");
    check("too large: refused", winstate.read(cast(*u8, &p), n, &back) == 0);
    put_file(cast(*u8, &p), "width=abc\nheight=600\n");
    check("not a number: refused", winstate.read(cast(*u8, &p), n, &back) == 0);
    put_file(cast(*u8, &p), "height=600\nwidth=640\nsomething=else\nmaximized=1\n");
    check("in any order, keys it does not know passed over", winstate.read(cast(*u8, &p), n, &back) == 1 && back.width == 640.0 &&
          back.height == 600.0 && back.maximized == 1 && back.fullscreen == 0);
    put_file(cast(*u8, &p), "width=640\nheight=480\nmaximized=2\n");
    check("a flag neither 0 nor 1: refused", winstate.read(cast(*u8, &p), n, &back) == 0);
    put_file(cast(*u8, &p), "width=640\n");
    check("no height: refused", winstate.read(cast(*u8, &p), n, &back) == 0);
    put_file(cast(*u8, &p), "width=640.\nheight=480.12\n");
    check("a point with no tenth, or more than one: refused", winstate.read(cast(*u8, &p), n, &back) == 0);
    put_file(cast(*u8, &p), "width=640\nheight=480");
    check("the last line without its end: still read", winstate.read(cast(*u8, &p), n, &back) == 1 && back.height == 480.0);
    put_file(cast(*u8, &p), "width=1920.9\nheight=1080.0\n");
    check("nines and noughts", winstate.read(cast(*u8, &p), n, &back) == 1 && back.width == 1920.9 && back.height == 1080.0);
    put_file(cast(*u8, &p), "width=\nheight=600\n");
    check("an empty value: refused", winstate.read(cast(*u8, &p), n, &back) == 0);
    put_file(cast(*u8, &p), "height=600\n");
    check("no width: refused", winstate.read(cast(*u8, &p), n, &back) == 0);
    put_file(cast(*u8, &p), "width=640\nheight=480\nwidth\n");
    check("a line with no '=': passed over", winstate.read(cast(*u8, &p), n, &back) == 1 && back.width == 640.0);
    put_file(cast(*u8, &p), "width=640\nheight=480\nfullscreen=2\n");
    check("full screen neither 0 nor 1: refused", winstate.read(cast(*u8, &p), n, &back) == 0);
    put_file(cast(*u8, &p), "width=1\nheight=32768\n");
    check("the least and the most: read", winstate.read(cast(*u8, &p), n, &back) == 1 && back.width == 1.0 && back.height == 32768.0);
    put_file(cast(*u8, &p), "width=32768\nheight=1\n");
    check("the other way round", winstate.read(cast(*u8, &p), n, &back) == 1 && back.width == 32768.0 && back.height == 1.0);
    put_file(cast(*u8, &p), "");
    check("an empty file: refused", winstate.read(cast(*u8, &p), n, &back) == 0);
    check("no path: nothing", winstate.read(cast(*u8, &p), 0, &back) == 0 && winstate.write(cast(*u8, &p), 0, &st) == 0);
    check("where nothing can be written: not", winstate.write("/dev/null/a/b.window", 20, &st) == 0);
    // A folder where the file goes: not moved over it, nothing left behind.
    linux.unlink(cast(*u8, &p));
    linux.mkdir(cast(*u8, &p), 448);
    check("a folder in its way: not written", winstate.write(cast(*u8, &p), n, &st) == 0 &&
          linux.stat(cast(*u8, &tmp), cast(*u8, &sb)) != 0);
    linux.rmdir(cast(*u8, &p));
    linux.unlink(cast(*u8, &p));
    check("no file: nothing", winstate.read(cast(*u8, &p), n, &back) == 0);
    // Through the environment: HOME and XDG_STATE_HOME as the process has them.
    check("not kept with no program's name", winstate.save("", 0, "main", 4, &st) == 0 && winstate.load("", 0, "main", 4, &back) == 0);
    environed();
    // Clean up: the file, the program's folder, the state home.
    let is [512]u8 as dir;
    mem.memcpy(cast(*u8, &dir), cast(*u8, &root), rn);
    mem.memcpy(cast(*u8, cast(i64, &dir) + rn), "/Demo", 6);
    linux.rmdir(cast(*u8, &dir));
    linux.rmdir(cast(*u8, &root));
}

// Kept and read back through XDG_STATE_HOME, when the test runs with one of
// its own (the Causticfile's script gives it one under /tmp).
fn environed() as void {
    let is *u8 as xdg = env.getenv("XDG_STATE_HOME");
    let is *u8 as mine = "/tmp/caustic-winstate-env";
    if (cast(i64, xdg) == 0 || same(xdg, len(mine), mine) == 0 || xdg[len(mine)] != 0) { return; }
    // A program's name of this process's own, so runs side by side do not meet.
    let is [64]u8 as app;
    mem.memcpy(cast(*u8, &app), "Demo-", 5);
    let is i64 as an = 5 + digits(linux.getpid(), cast(*u8, cast(i64, &app) + 5));
    let is winstate.State as st with mut = winstate.state(900.0, 700.0);
    st.fullscreen = 1;
    let is winstate.State as back with mut = winstate.state(1.0, 1.0);
    check("kept through the environment", winstate.save(cast(*u8, &app), an, "main", 4, &st) == 1 &&
          winstate.load(cast(*u8, &app), an, "main", 4, &back) == 1 && back.width == 900.0 && back.fullscreen == 1);
    let is [512]u8 as p;
    let is i64 as n = winstate.path_in("", xdg, cast(*u8, &app), an, "main", 4, cast(*u8, &p), 511);
    p[n] = cast(u8, 0);
    linux.unlink(cast(*u8, &p));
    let is [512]u8 as dir;
    let is i64 as xn = len(xdg);
    mem.memcpy(cast(*u8, &dir), xdg, xn);
    dir[xn] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &dir) + xn + 1), cast(*u8, &app), an);
    dir[xn + 1 + an] = cast(u8, 0);
    linux.rmdir(cast(*u8, &dir));
    linux.rmdir(xdg);
}

fn known() as void {
    let is app.Limits as l = app.limits_default();
    let is app.App as a with mut = app.open(&l);
    let is i64 as h = app.window_open(&a, 640.0, 480.0);
    let is winstate.State as st with mut = app.window_state(&a, h);
    check("a window's size", st.width == 640.0 && st.height == 480.0 && st.maximized == 0 && st.fullscreen == 0);
    app.resize(&a, h, 800.0, 500.0);
    app.set_maximized(&a, h, 1);
    app.set_fullscreen(&a, h, 1);
    st = app.window_state(&a, h);
    check("resized, maximized, full screen: as the platform said", st.width == 800.0 && st.height == 500.0 && st.maximized == 1 &&
          st.fullscreen == 1 && app.is_maximized(&a, h) == 1 && app.is_fullscreen(&a, h) == 1);
    app.window_close(&a, h);
    st = app.window_state(&a, h);
    check("a closed window: nothing", st.width == 0.0 && app.is_maximized(&a, h) == 0 && app.is_fullscreen(&a, h) == 0);
    app.set_maximized(&a, h, 1);
    app.close(&a);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is *u8 as base = "/tmp/caustic-winstate-";
    let is i64 as bn = len(base);
    mem.memcpy(cast(*u8, &root), base, bn);
    rn = bn + digits(linux.getpid(), cast(*u8, cast(i64, &root) + bn));
    root[rn] = cast(u8, 0);
    paths();
    kept();
    known();
    if (fails == 0) {
        io.printf("winstate: %d checks passed\n", checks);
        return 0;
    }
    io.printf("winstate: %d of %d checks failed\n", fails, checks);
    return 1;
}
