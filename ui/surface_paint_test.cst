// ui/surface_paint_test.cst — a widget in a window of its own painted on its
// own canvas, pixel for pixel what it is painted inside the window at the
// same place, at scale 1 and 2; the window painted without it, as if it
// were not there; what it leaves unpainted nothing where its window is seen
// through and the window's colour where not; a change inside it repainted
// alone, the same as painted whole; and a cached widget and a faded one
// inside it as they are in the window. On a headless software device.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "../gpu/gpu.cst" as gpu;
use "../render/draw2d.cst" as draw2d;
use "../render/shapes2d.cst" as shapes;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "damage.cst" as damage;
use "painter.cst" as painter;
use "style.cst" as style;
use "paint.cst" as paint;
use "surface.cst" as surface;
use "../window/positioner.cst" as positioner;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is i64 as W with imut = 120;
let is i64 as H with imut = 100;
// The popup's place inside the window, and its size.
let is f64 as PX with imut = 20.0;
let is f64 as PY with imut = 30.0;
let is i64 as PW with imut = 60;
let is i64 as PH with imut = 50;

// --- Blocks: a colour filling them, or filling all but an inset ---

struct Block {
    w     as f64;
    h     as f64;
    color as i64;
    inset as f64;
}

fn block_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Block as b = cast(*Block, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = b.w;
    out.pref_h = b.h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn block_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is f64 as y with mut = 6.0;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        let is math.rect.Rect as area = math.rect.rect(6.0, y, r.w - 12.0, 12.0);
        layout.place(t, ch, &area);
        y = y + 14.0;
        ch = tree.next_sibling(t, ch);
    }
}

fn block_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Block as b = cast(*Block, data);
    let is f64 as i = b.inset;
    shapes.fill_rounded(p.canvas, p.rect.x + i, p.rect.y + i, p.rect.w - 2.0 * i, p.rect.h - 2.0 * i, 3.5, 3.5, 3.5, 3.5,
                        style.hex(b.color));
}

let is tree.Kind as block_kind with mut;

fn block(t as *tree.Tree, parent as i64, w as f64, h as f64, color as i64, inset as f64) as i64 {
    let is i64 as b = tree.create(t, &block_kind, parent);
    let is *Block as d = cast(*Block, tree.data(t, b));
    d.w = w;
    d.h = h;
    d.color = color;
    d.inset = inset;
    return b;
}

// --- The stand-in host: the popup put where the positioner puts it in the
// window, so the two can be compared ---

fn host(user as *u8, t as *tree.Tree, op as i32, s as i64) as i32 {
    if (op == tree.SURFACE_CLOSE) { return 1; }
    let is positioner.Positioner as p with mut = tree.surface_place(t, s);
    tree.surface_set_rect(t, s, positioner.place(&p, math.rect.rect(0.0, 0.0, cast(f64, W), cast(f64, H))));
    return 1;
}

// --- The device and what is read back ---

let is gpu.device.Device as dv with mut;
let is i64 as cmd with mut = 0;
let is draw2d.Canvas as cv with mut;
let is style.Theme as theme with mut;
let is paint.Options as opts with mut;
let is [48000]i32 as win_px with mut;    // the window, at scale 2 at most
let is [48000]i32 as plain_px with mut;
let is [12000]i32 as pop_px with mut;
let is [12000]i32 as again_px with mut;

fn submit_to(tex as i64, out as *i32, n as i64, clear as i32) as void {
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps with mut = gpu.command.pass_load(tex, 0);
    if (clear == 1) { ps = gpu.command.pass(tex, 0, math.color.rgba(0.5, 0.25, 0.75, 1.0)); }
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(&cv, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, tex, cast(*u8, out), n * 4);
}

fn texture(w as i64, h as i64) as i64 {
    let is gpu.texture.Desc as td = gpu.texture.desc(w, h, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    return gpu.texture.create(&dv, &td);
}

fn collect(t as *tree.Tree) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    surface.follow(t);
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
}

// The whole window painted at scale sc into tex, read into out.
fn paint_window(t as *tree.Tree, tex as i64, sc as f64, out as *i32) as void {
    tree.invalidate_paint_subtree(t, tree.root(t));
    collect(t);
    draw2d.begin(&cv, cast(f64, W) * sc, cast(f64, H) * sc, sc);
    paint.frame(t, &cv, &opts, cast(*paint.Stats, 0));
    submit_to(tex, out, cast(i64, cast(f64, W * H) * sc * sc), 1);
    tree.damage_clear(t);
}

// The surface painted at scale sc into tex — whole, or only what was
// damaged onto what tex holds — read into out.
fn paint_surface(t as *tree.Tree, s as i64, tex as i64, sc as f64, whole as i32, out as *i32) as void {
    if (whole == 1) { tree.invalidate_paint_subtree(t, tree.root(t)); }
    collect(t);
    draw2d.begin(&cv, cast(f64, PW) * sc, cast(f64, PH) * sc, sc);
    paint.frame_surface(t, s, &cv, &opts, cast(*paint.Stats, 0));
    submit_to(tex, out, cast(i64, cast(f64, PW * PH) * sc * sc), whole);
    tree.damage_clear(t);
}

// Whether the surface's pixels are the window's at the popup's place.
fn same_as_window(sc as f64) as i32 {
    let is i64 as ww = cast(i64, cast(f64, W) * sc);
    let is i64 as pw = cast(i64, cast(f64, PW) * sc);
    let is i64 as ph = cast(i64, cast(f64, PH) * sc);
    let is i64 as ox = cast(i64, PX * sc);
    let is i64 as oy = cast(i64, PY * sc);
    let is i64 as n with mut = 0;
    let is i64 as y with mut = 0;
    while (y < ph) {
        let is i64 as x with mut = 0;
        while (x < pw) {
            if (pop_px[y * pw + x] != win_px[(oy + y) * ww + ox + x]) {
                if (n == 0) { io.printf("  first difference at %d,%d of the popup\n", cast(i32, x), cast(i32, y)); }
                n = n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return cast(i32, n == 0);
}

fn main() as i32 {
    block_kind = widget.kind("block", sizeof(Block));
    block_kind.measure = fn_ptr(block_measure);
    block_kind.arrange = fn_ptr(block_arrange);
    block_kind.paint = fn_ptr(block_paint);

    dv = gpu.open_headless(W * 2, H * 2, gpu.SOFTWARE);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as dl = draw2d.limits_default();
    cv = draw2d.open(&dv, &dl);
    theme = style.light();
    opts = paint.options(&theme);
    let is i64 as win1 = texture(W, H);
    let is i64 as win2 = texture(W * 2, H * 2);
    let is i64 as pop1 = texture(PW, PH);
    let is i64 as pop2 = texture(PW * 2, PH * 2);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    let is i64 as root = tree.root(&t);
    let is i64 as back = block(&t, root, cast(f64, W), cast(f64, H), 3381759, 0.0);
    let is i64 as pop = block(&t, root, cast(f64, PW), cast(f64, PH), 16766720, 2.0);
    tree.set_layer(&t, pop, 900);
    let is i64 as first = block(&t, pop, 40.0, 12.0, 13369344, 0.0);
    let is i64 as second = block(&t, pop, 40.0, 12.0, 52275, 1.0);
    let is math.rect.Rect as anchor = math.rect.rect(PX, PY - 10.0, 10.0, 10.0);

    // --- Inside the window: the reference, over nothing but the window's
    // colour, as a window of its own has under it ---
    surface.open(&t, pop, surface.MENU, 0, 0, anchor, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    check("inside the window where it is to be compared", tree.surface_index(&t, pop) < 0);
    tree.set_visible(&t, back, 0);
    paint_window(&t, win1, 1.0, cast(*i32, &win_px));
    tree.set_visible(&t, back, 1);

    // The window with nothing over it: the popup hidden.
    tree.set_visible(&t, pop, 0);
    paint_window(&t, win1, 1.0, cast(*i32, &plain_px));
    tree.set_visible(&t, pop, 1);

    // --- In a window of its own ---
    tree.set_surfaces(&t, fn_ptr(host), cast(*u8, 0));
    surface.close(&t, pop);
    surface.open(&t, pop, surface.MENU, 0, 0, anchor, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    let is i64 as s with mut = tree.surface_index(&t, pop);
    check("in a window of its own, at the same place", s >= 0 &&
          tree.surface_rect(&t, s).x == PX && tree.surface_rect(&t, s).y == PY);
    paint_surface(&t, s, pop1, 1.0, 1, cast(*i32, &pop_px));
    check("its own canvas: the pixels it has in the window", same_as_window(1.0) == 1);

    // The window painted now has nothing of it.
    paint_window(&t, win1, 1.0, cast(*i32, &again_px));
    let is i64 as diff with mut = 0;
    let is i64 as i with mut = 0;
    while (i < W * H) { if (again_px[i] != plain_px[i]) { diff = diff + 1; } i = i + 1; }
    check("the window painted without it", diff == 0);

    // A change inside it: repainted alone, onto what its canvas holds, the
    // same as painted whole.
    let is *Block as fd = cast(*Block, tree.data(&t, first));
    fd.color = 255;
    tree.invalidate_paint(&t, first);
    paint_surface(&t, s, pop1, 1.0, 0, cast(*i32, &again_px));
    paint_surface(&t, s, pop1, 1.0, 1, cast(*i32, &pop_px));
    diff = 0;
    i = 0;
    while (i < PW * PH) { if (again_px[i] != pop_px[i]) { diff = diff + 1; } i = i + 1; }
    check("a change repainted alone: the same as whole", diff == 0);
    fd.color = 13369344;
    tree.invalidate_paint(&t, first);

    // Cached and faded inside it: one widget drawn once into a texture of its
    // own, one at half opacity — on its canvas as they are in the window —
    // and a change in the cached one repainted alone, the same as whole.
    let is paint.Cache as cc with mut = paint.cache_open(&dv, &dl);
    opts.cache = &cc;
    tree.set_flag(&t, second, tree.F_CACHE, 1);
    tree.set_opacity(&t, first, 0.5);
    surface.close(&t, pop);
    tree.set_surfaces(&t, cast(tree.SurfaceFn, 0), cast(*u8, 0));
    surface.open(&t, pop, surface.MENU, 0, 0, anchor, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    tree.set_visible(&t, back, 0);
    paint_window(&t, win1, 1.0, cast(*i32, &win_px));
    tree.set_visible(&t, back, 1);
    tree.set_surfaces(&t, fn_ptr(host), cast(*u8, 0));
    surface.close(&t, pop);
    surface.open(&t, pop, surface.MENU, 0, 0, anchor, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    s = tree.surface_index(&t, pop);
    paint_surface(&t, s, pop1, 1.0, 1, cast(*i32, &pop_px));
    check("cached and faded inside it: the pixels they have in the window", same_as_window(1.0) == 1);
    check("through textures of their own", paint.cache_used(&cc, &t) == 2);
    let is *Block as sd = cast(*Block, tree.data(&t, second));
    sd.color = 16711680;
    tree.invalidate_paint(&t, second);
    paint_surface(&t, s, pop1, 1.0, 0, cast(*i32, &again_px));
    paint_surface(&t, s, pop1, 1.0, 1, cast(*i32, &pop_px));
    diff = 0;
    i = 0;
    while (i < PW * PH) { if (again_px[i] != pop_px[i]) { diff = diff + 1; } i = i + 1; }
    check("a change in the cached one repainted alone: the same as whole", diff == 0);
    sd.color = 52275;
    tree.invalidate_paint(&t, second);
    tree.set_flag(&t, second, tree.F_CACHE, 0);
    tree.set_opacity(&t, first, 1.0);
    opts.cache = cast(*paint.Cache, 0);
    paint.cache_close(&cc);

    // Seen through: what it leaves unpainted is nothing.
    tree.surface_set_see_through(&t, s, 1);
    paint_surface(&t, s, pop1, 1.0, 1, cast(*i32, &pop_px));
    check("seen through: its corner nothing", pop_px[0] == 0 && pop_px[PW - 1] == 0);
    check("what it paints there all the same", pop_px[(PH / 2) * PW + PW / 2] != 0);
    tree.surface_set_see_through(&t, s, 0);
    paint_surface(&t, s, pop1, 1.0, 1, cast(*i32, &pop_px));
    check("not seen through: its corner the window's colour", pop_px[0] == win_px[cast(i64, PY) * W + cast(i64, PX)]);

    // --- At scale 2 ---
    surface.close(&t, pop);
    tree.set_surfaces(&t, cast(tree.SurfaceFn, 0), cast(*u8, 0));
    surface.open(&t, pop, surface.MENU, 0, 0, anchor, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    tree.set_visible(&t, back, 0);
    paint_window(&t, win2, 2.0, cast(*i32, &win_px));
    tree.set_visible(&t, back, 1);
    tree.set_surfaces(&t, fn_ptr(host), cast(*u8, 0));
    surface.close(&t, pop);
    surface.open(&t, pop, surface.MENU, 0, 0, anchor, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    s = tree.surface_index(&t, pop);
    paint_surface(&t, s, pop2, 2.0, 1, cast(*i32, &pop_px));
    check("at scale 2: the pixels it has in the window", same_as_window(2.0) == 1);

    check("no surface: nothing painted", paint.frame_surface(&t, 7, &cv, &opts, cast(*paint.Stats, 0)) == 0);

    // A surface inside it — a submenu — is painted in its own, not in its
    // parent's: the parent's pixels are those it has without it.
    paint_surface(&t, s, pop2, 2.0, 1, cast(*i32, &again_px));
    let is i64 as inner = block(&t, pop, 20.0, 20.0, 16711935, 0.0);
    tree.set_layer(&t, inner, 950);
    surface.open(&t, inner, surface.MENU, 0, first, layout.window_rect(&t, first), positioner.TOP_LEFT,
                 positioner.BOTTOM_RIGHT, 0);
    check("a surface inside it", tree.surface_index(&t, inner) >= 0 && tree.surface_of(&t, inner) != s);
    paint_surface(&t, s, pop2, 2.0, 1, cast(*i32, &pop_px));
    diff = 0;
    i = 0;
    while (i < PW * PH * 4) { if (again_px[i] != pop_px[i]) { diff = diff + 1; } i = i + 1; }
    check("its parent painted without it", diff == 0);

    if (back == 0 || second == 0) { return 1; }
    tree.close(&t);
    if (fails == 0) {
        io.printf("ui surface paint: all checks passed\n");
        return 0;
    }
    io.printf("ui surface paint: %d failures\n", fails);
    return 1;
}
