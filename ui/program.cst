// ui/program.cst — a program of the toolkit's, started.
//
// What every program does before its first window: a device to draw on —
// the software one, as the toolkit never needs a GPU — the system's fonts
// for its text (system_fonts.cst), the application, and the loop that puts
// its windows on the screen (host.cst), following the desktop's settings —
// the window system's, and the settings portal's (desktop.cst) — with a
// session bus connection in it for what the program says to the desktop:
// that it is the one instance, notifications, its tray icon, links
// (session.cst). Without a session bus the program runs all the same, its
// connection null.
//
// open does all of it; the program opens its windows on app(p), and runs.
// The program is kept where the program puts it, which must not move while
// it is open.
use "../gpu/gpu.cst" as gpu;
use "../dbus/dbus.cst" as dbus;
use "app.cst" as app;
use "text.cst" as text;
use "host.cst" as host;
use "session.cst" as session;
use "desktop.cst" as desktop;
use "system_fonts.cst" as system_fonts;

struct Program {
    dv   as gpu.device.Device;
    sf   as system_fonts.Fonts;
    svc  as *text.Service;
    a    as app.App;
    hs   as *host.Host;
    ses  as session.Session;
    desk as desktop.Desktop;
    app_on as i32;
    bus  as i32;
}

// Started, with the system's fonts — or only those under fonts_dir, when it
// is not null: a program shipping its own. 1, or 0 when there are no fonts
// or no memory, and nothing is left open. Closed with close either way.
fn open(p as *Program, fonts_dir as *u8) as i32 {
    p.app_on = 0;
    p.bus = 0;
    p.svc = cast(*text.Service, 0);
    p.hs = cast(*host.Host, 0);
    let is i32 as found with mut = 0;
    if (cast(i64, fonts_dir) != 0) {
        found = system_fonts.open_dir(&p.sf, fonts_dir);
    } else {
        found = system_fonts.open(&p.sf);
    }
    if (found == 0) { return 0; }
    p.dv = gpu.open_headless(64, 64, gpu.SOFTWARE);
    let is text.Limits as tl = text.limits_default();
    p.svc = text.open(&p.dv, &tl, fn_ptr(system_fonts.resolve), cast(*u8, &p.sf), cast(*u8, 0));
    if (cast(i64, p.svc) == 0) {
        gpu.close(&p.dv);
        close(p);
        return 0;
    }
    let is app.Limits as al = app.limits_default();
    p.a = app.open(&al);
    p.app_on = app.is_open(&p.a);
    if (p.app_on == 0) {
        close(p);
        return 0;
    }
    app.set_text_service(&p.a, cast(*u8, p.svc));
    p.hs = host.open(&p.a, &p.dv, cast(*u8, p.svc));
    if (cast(i64, p.hs) == 0) {
        close(p);
        return 0;
    }
    p.bus = session.open(&p.ses, p.hs);
    if (p.bus == 1) { desktop.follow(&p.desk, p.hs); }
    return 1;
}

fn app(p as *Program) as *app.App { return &p.a; }

fn host(p as *Program) as *host.Host { return p.hs; }

fn fonts(p as *Program) as *system_fonts.Fonts { return &p.sf; }

// The session bus connection the loop dispatches; null with no session bus.
fn conn(p as *Program) as *dbus.conn.Conn {
    if (p.bus == 0) { return cast(*dbus.conn.Conn, 0); }
    return session.conn(&p.ses);
}

// Rounds until no window is left on the screen and nothing holds the loop,
// or host.quit is asked.
fn run(p as *Program) as void { host.run(p.hs); }

// Everything closed, its windows put away; nothing more a second time.
fn close(p as *Program) as void {
    if (p.bus == 1) {
        desktop.stop(&p.desk);
        session.close(&p.ses);
    }
    p.bus = 0;
    if (cast(i64, p.hs) != 0) { host.close(p.hs); }
    p.hs = cast(*host.Host, 0);
    if (p.app_on == 1) { app.close(&p.a); }
    p.app_on = 0;
    if (cast(i64, p.svc) != 0) {
        text.close(p.svc);
        gpu.close(&p.dv);
    }
    p.svc = cast(*text.Service, 0);
    system_fonts.close(&p.sf);
}
