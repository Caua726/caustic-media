// The language a BCP 47 tag of n bytes reads in: Portuguese, of any country,
// Brazil's; anything else English.
fn language_of(tag as *u8, n as i64) as i32 {
    if (n >= 2 && tag[0] == 112 && tag[1] == 116 && (n == 2 || tag[2] == 45)) { return PT_BR; }
    return EN;
}

// The mark between a number's whole and its fraction.
fn decimal(lang as i32) as u8 {
    if (lang == PT_BR) { return 44; }
    return 46;
}

