// ui/strings.cst — the toolkit's own words, in the languages it has them in.
//
// A widget that says something of its own — a dialog's buttons, a text's
// context menu, a chooser's labels, the names an assistive technology reads
// — takes it from here in its tree's language (tree.set_language; English
// unless told). The application sets the language from the user's
// (window/locale.cst, through app.set_system), so it is set before the
// widgets that speak it are made: words already shown stay as they were.
//
// Every word is in every language here, holding what the English holds: a
// mnemonic where it has one, and the same places to fill in — %1 and %2 —
// in whatever order the language puts them: "Light %1" is "%1 claro". A
// language not here reads English. Numbers take the language's decimal mark.
use "std/mem.cst" as mem;
use "tree.cst" as tree;

// The languages.
let is i32 as EN    with imut = 0;
let is i32 as PT_BR with imut = 1;

// The words.
let is i64 as OK                  with imut = 1;
let is i64 as CANCEL              with imut = 2;
let is i64 as YES                 with imut = 3;
let is i64 as NO                  with imut = 4;
