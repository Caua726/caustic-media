}

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

// Word id in lang, *n bytes of UTF-8 kept for good: "" for no such word.
fn text(lang as i32, id as i64, n as *i64) as *u8 {
    let is *u8 as s with mut = _en(id);
    if (lang == PT_BR) { s = _pt_br(id); }
    *n = _len(s);
    return s;
}

// Word id in the tree's language.
fn of(t as *tree.Tree, id as i64, n as *i64) as *u8 { return text(tree.language(t), id, n); }

// The bytes of s, n of UTF-8, that fit in room, cut where a character
// starts: never part of one.
fn fits(s as *u8, n as i64, room as i64) as i64 {
    if (n <= 0) { return 0; }
    if (n <= room) { return n; }
    let is i64 as k with mut = room;
    if (k < 0) { k = 0; }
    while (k > 0 && (s[k] & 192) == 128) { k = k - 1; }
    return k;
}

// Word id in lang with %1 and %2 filled by a (an bytes) and b (bn), into out,
// cap bytes with the NUL; how many bytes, what does not fit left out whole
// characters at a time.
fn fill(lang as i32, id as i64, a as *u8, an as i64, b as *u8, bn as i64, out as *u8, cap as i64) as i64 {
    let is i64 as n with mut = 0;
    let is *u8 as s = text(lang, id, &n);
    let is i64 as o with mut = 0;
    let is i64 as room = cap - 1;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is *u8 as piece with mut = cast(*u8, cast(i64, s) + i);
        let is i64 as pn with mut = 1;
        // A word is a literal, its NUL after it: s[i + 1] is there.
        if (s[i] == 37 && (s[i + 1] == 49 || s[i + 1] == 50)) {
            piece = a;
            pn = an;
            if (s[i + 1] == 50) {
                piece = b;
                pn = bn;
            }
            i = i + 2;
        } else {
            // The word up to its next place.
            while (i + pn < n && s[i + pn] != 37) { pn = pn + 1; }
            i = i + pn;
        }
        let is i64 as k = fits(piece, pn, room - o);
        mem.memcpy(cast(*u8, cast(i64, out) + o), piece, k);
        o = o + k;
        // What did not fit ends it.
        if (k < pn) { i = n; }
    }
    out[o] = 0;
    return o;
}
