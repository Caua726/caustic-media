// ui/tree.cst — widgets as nodes in a window's tree, and the handles to them.
//
// A program never holds a pointer to a widget. It holds a handle — the same
// (era << 32) | (index + 1) that gpu/device.cst gives its resources — so a
// widget that has been destroyed fails a check instead of pointing into a slot
// some other widget now occupies. Zero is never a valid handle.
//
// The tree is sized when it is opened and never grows on its own: one mapping
// holds every node and every widget's data. Running out is reported as FULL,
// because a table that grows behind the program's back is the hidden
// allocation the philosophy forbids.
//
// Errors follow gpu/'s split. The setup path — create, reparent — reports
// through last_error(). Queries on a stale handle quietly answer 0 or null,
// because by the time a frame walks the tree a dead handle is ordinary.
use "std/mem.cst" as mem;
use "../math/math.cst" as math;
use "geom.cst" as geom;
use "style.cst" as style;
use "tree_state.cst" as tst;
use "tree_draw.cst" as tdraw;
use "tree_lent.cst" as tlent;

// What the parts declare, under the names it always had here.
let is i32 as OK with imut = tst.OK;
let is i32 as FULL with imut = tst.FULL;
let is i32 as INVALID_HANDLE with imut = tst.INVALID_HANDLE;
let is i32 as BAD_ARGUMENT with imut = tst.BAD_ARGUMENT;
let is i32 as DATA_TOO_BIG with imut = tst.DATA_TOO_BIG;
let is i32 as OUT_OF_MEMORY with imut = tst.OUT_OF_MEMORY;
let is i32 as LAYOUT_TOO_LARGE with imut = tst.LAYOUT_TOO_LARGE;
let is i32 as WRONG_KIND with imut = tst.WRONG_KIND;
let is i64 as F_HIDDEN with imut = tst.F_HIDDEN;
let is i64 as F_DISABLED with imut = tst.F_DISABLED;
let is i64 as F_NEEDS_LAYOUT with imut = tst.F_NEEDS_LAYOUT;
let is i64 as F_FOCUSABLE with imut = tst.F_FOCUSABLE;
let is i64 as F_NEEDS_PAINT with imut = tst.F_NEEDS_PAINT;
let is i64 as F_FOCUS_WITHIN_LOOK with imut = tst.F_FOCUS_WITHIN_LOOK;
let is i64 as F_CACHE with imut = tst.F_CACHE;
let is i64 as F_CACHE_DIRTY with imut = tst.F_CACHE_DIRTY;
let is i64 as MAX_DAMAGE with imut = tst.MAX_DAMAGE;
