// ui/tree.cst — widgets as nodes in a window's tree, and the handles to them.
//
// A program never holds a pointer to a widget. It holds a handle — the same
// (era << 32) | (index + 1) that gpu/device.cst gives its resources — so a
// widget that has been destroyed fails a check instead of pointing into a slot
// some other widget now occupies. Zero is never a valid handle.
//
// The tree is sized when it is opened and never grows on its own: one mapping
// holds every node and every widget's data. Running out is reported as FULL,
// because a table that grows behind the program's back is the hidden
// allocation the philosophy forbids.
//
// Errors follow gpu/'s split. The setup path — create, reparent — reports
// through last_error(). Queries on a stale handle quietly answer 0 or null,
// because by the time a frame walks the tree a dead handle is ordinary.
use "std/mem.cst" as mem;
use "../math/math.cst" as math;
use "geom.cst" as geom;
use "event.cst" as event;
use "painter.cst" as painter;
use "style.cst" as style;

// --- Errors ---

let is i32 as OK             with imut = 0;
let is i32 as FULL           with imut = 1;
let is i32 as INVALID_HANDLE with imut = 2;
let is i32 as BAD_ARGUMENT   with imut = 3;
let is i32 as DATA_TOO_BIG   with imut = 4;
let is i32 as OUT_OF_MEMORY  with imut = 5;
let is i32 as LAYOUT_TOO_LARGE with imut = 6;   // a container needed more scratch than there is

// --- Flags ---
//
// Hidden and disabled rather than visible and enabled, so a zeroed node is the
// default state and nothing has to remember to switch a widget on.
let is i64 as F_HIDDEN       with imut = 1;
let is i64 as F_DISABLED     with imut = 2;
let is i64 as F_NEEDS_LAYOUT with imut = 4;
let is i64 as F_FOCUSABLE    with imut = 8;
let is i64 as F_NEEDS_PAINT  with imut = 16;
// Repaint when the focus enters or leaves the subtree — a frame that lights up
// while a field inside it has focus. Opt-in, so a Tab does not repaint every
// ancestor up to the window.
let is i64 as F_FOCUS_WITHIN_LOOK with imut = 32;
// Paint the subtree once into a texture of its own and, while nothing in it
// changes, put that back instead of painting it again — for something that
// moves as a whole: a card being dragged, a panel sliding in. See paint.Cache.
let is i64 as F_CACHE        with imut = 64;
// Something inside a cached subtree changed since its texture was painted.
let is i64 as F_CACHE_DIRTY  with imut = 128;

// --- Damage ---
//
// What has to be repainted, as a few rectangles in window coordinates. Kept in
// the tree because a widget whose look changes only has the tree in hand, and
// bounded because a frame never needs more: a rectangle that would not fit is
// merged into the one it grows least, so the region can cover more than
// changed but never less. damage.cst brings it up to date with the tree; the
// painter reads it; whoever presented the frame clears it.
let is i64 as MAX_DAMAGE with imut = 16;

// --- How much a tree may hold ---

struct Limits {
    widgets     as i64;   // alive at once, the root included
    data_bytes  as i64;   // the largest per-widget data any kind may ask for
    connections as i64;   // signal connections, see signal.cst
}

fn limits_default() as Limits {
    let is Limits as l;
    l.widgets = 4096;
    l.data_bytes = 256;
    l.connections = 4096;
    return l;
}

// --- Signal connections ---
//
// Stored here because a widget that emits only has the tree in hand; what
// connecting and emitting mean is signal.cst's. Kept in the order they were
// made — a connection is appended, and the table is compacted when it fills —
// so emitting calls them in that order.
struct Connection {
    widget as i64;
    seq    as i64;   // its id, and its place in connection order
    made   as i64;   // the emission count when it was made
    cb     as SignalFn;   // null once disconnected
    user   as *u8;
    signal as i32;
    _pad0  as i32;
}

// --- Kinds of widget ---
//
// Caustic has no classes, so a kind of widget is a value: a name, how many
// bytes of data each widget of the kind carries, and the functions that give
// it behaviour. widget.cst documents each entry and makes an empty Kind; it
// lives here because the tree stores a pointer to one in every node, and the
// entries' types name the Tree.
//
// Every entry has a function-pointer type rather than a bare *u8, so the
// compiler checks both ends: a function stored in a Kind must have the entry's
// signature, and call() through it must pass arguments of the entry's types.
// Every kind a program defines is checked the same way this library's are.
type DestroyFn = fn(*Tree, i64, *u8) as void;
type MeasureFn = fn(*Tree, i64, *u8, *geom.Constraint, *geom.Size) as void;
type ArrangeFn = fn(*Tree, i64, *u8, *math.rect.Rect) as void;
type EventFn   = fn(*Tree, i64, *u8, *event.Event) as i64;
type HitFn     = fn(*Tree, i64, *u8, *math.vec.Vec2) as i32;
type PaintFn   = fn(*Tree, i64, *u8, *painter.Painter) as void;

// What assistive technology is told about a widget, and what it asks of
// one. access.cst fills it and says what each field means; it is declared
// here because a kind's access entry takes one.
struct Access {
    action          as i64;   // access.ASK, or the action asked for
    arg             as f64;   // SET_VALUE's value
    role            as i64;
    name            as *u8;   // UTF-8, name_len bytes; null for none
    name_len        as i64;
    description     as *u8;
    description_len as i64;
    states          as i64;   // a bit each
    actions         as i64;   // what it answers to, a bit each
    value           as f64;
    min             as f64;
    max             as f64;
    step            as f64;
    has_value       as i32;
    _pad0           as i32;
}

type AccessFn  = fn(*Tree, i64, *u8, *Access) as i64;

struct Kind {
    name       as *u8;
    data_bytes as i64;   // zeroed for each new widget, owned by the tree
    destroy    as DestroyFn;
    measure    as MeasureFn;
    arrange    as ArrangeFn;
    event      as EventFn;
    hit        as HitFn;
    paint      as PaintFn;
    role       as i64;   // access.ROLE_*: what it is to assistive technology
    access     as AccessFn;
}

// Text handed to the platform: cb(user, which, text, n). See set_clipboard.
type ClipboardFn = fn(*u8, i32, *u8, i64) as void;

// A signal callback: cb(tree, widget, arg, user). See signal.cst.
type SignalFn = fn(*Tree, i64, *u8, *u8) as void;

// --- Nodes ---
//
// Links are slot indices, -1 for none: inside the tree an index is enough,
// and handles are only made at the boundary.
struct Node {
    era    as i32;
    used   as i32;
    kind   as *Kind;
    parent as i64;
    first  as i64;
    last   as i64;
    next   as i64;
    prev   as i64;
    count  as i64;
    flags  as i64;
    item   as geom.Item;   // layout's, see geom.cst
    // What of it was last painted, in window coordinates: its rectangle clipped
    // by its ancestors', since a child never draws outside its parent. Empty
    // while it has never been on screen or is hidden. The place it leaves is
    // repainted from this.
    painted as math.rect.Rect;
    // Where it was laid out then — the same, unclipped by its ancestors. A
    // change here is what says it moved.
    placed  as math.rect.Rect;
    layer   as i64;   // 0, or above everything at lower layers; see set_layer
    labelled_by as i64;   // the widget that names it; see set_labelled_by
    overrides as *style.Overrides;   // the program's; null for none. See set_overrides
    // Where it is drawn, moved from where it is laid out, and how much of it
    // shows: see set_translation and set_opacity.
    tx      as f64;
    ty      as f64;
    opacity as f64;
}

struct Tree {
    nodes       as *u8;   // cap * sizeof(Node)
    data        as *u8;   // cap * stride
    stride      as i64;
    cap         as i64;
    live        as i64;
    next_free   as i64;   // where the next search for a free slot starts
    root        as i64;   // slot index of the root
    block       as *u8;
    block_bytes as i64;
    scratch       as *u8;   // see scratch_alloc
    scratch_bytes as i64;
    scratch_used  as i64;
    conns         as *u8;   // conn_cap Connections
    conn_cap      as i64;
    conn_used     as i64;
    conn_seq      as i64;
    emit_serial   as i64;
    emitting      as i64;   // emissions in progress, nested
    damage        as [16]math.rect.Rect;
    damage_n      as i64;
    paint_wanted  as i64;   // anything changed since damage_clear
    scale         as f64;   // physical pixels per logical one; layout.set_scale
    layered       as i64;   // widgets with a layer above 0
    theme         as *style.Theme;   // the program's; null for the default. See set_theme
    text          as *u8;            // the application's text service; see set_text_service
    clip_fn       as ClipboardFn;    // the program's, null for none; see set_clipboard
    clip_user     as *u8;
    err         as i32;
    ok          as i32;
}

// --- Scratch ---
//
// Room containers work in while they measure and arrange — the sizes of their
// children, the widths of a grid's columns — taken in stack order and given
// back before they return. It is part of the tree's one mapping, sized from
// the capacity, so laying out allocates nothing.
//
// Two entries per widget is enough for any tree: the containers active at once
// form a path from the root, and the children of different containers on one
// path are different widgets. A grid is the exception — its tracks run to the
// highest row and column named, which a sparse grid can push past that — and a
// grid that needs more says so with LAYOUT_TOO_LARGE rather than dropping cells.
let is i64 as SCRATCH_ENTRY_BYTES with imut = 48;

// The root's kind. Module scope rather than inside the Tree, because a Tree
// is returned by value and a pointer into it would not survive the copy.
let is Kind as _root_kind with mut;

fn _node(t as *Tree, i as i64) as *Node {
    return cast(*Node, cast(i64, t.nodes) + i * sizeof(Node));
}

fn _data_at(t as *Tree, i as i64) as *u8 {
    return cast(*u8, cast(i64, t.data) + i * t.stride);
}

fn _handle(t as *Tree, i as i64) as i64 {
    if (i < 0) { return 0; }
    return (cast(i64, _node(t, i).era) << 32) | (i + 1);
}

// The slot a handle names, or -1 when it names nothing alive.
fn _index(t as *Tree, h as i64) as i64 {
    if (t.ok == 0 || h == 0) { return 0 - 1; }
    let is i64 as i = (h & 4294967295) - 1;
    if (i < 0 || i >= t.cap) { return 0 - 1; }
    let is *Node as n = _node(t, i);
    if (n.used == 0) { return 0 - 1; }
    if (n.era != cast(i32, (h >> 32) & 4294967295)) { return 0 - 1; }
    return i;
}

fn _set(flags as i64, bit as i64, on as i32) as i64 {
    if (on == 1) { return flags | bit; }
    return (flags | bit) - bit;
}

// --- Opening and closing ---

fn open(l as *Limits) as Tree {
    let is Tree as t;
    t.nodes = cast(*u8, 0);
    t.data = cast(*u8, 0);
    t.block = cast(*u8, 0);
    t.block_bytes = 0;
    t.scratch = cast(*u8, 0);
    t.scratch_bytes = 0;
    t.scratch_used = 0;
    t.conns = cast(*u8, 0);
    t.conn_cap = 0;
    t.conn_used = 0;
    t.conn_seq = 0;
    t.emit_serial = 0;
    t.emitting = 0;
    t.damage_n = 0;
    t.paint_wanted = 0;
    t.scale = 1.0;
    t.layered = 0;
    t.theme = cast(*style.Theme, 0);
    t.text = cast(*u8, 0);
    t.clip_fn = cast(ClipboardFn, 0);
    t.clip_user = cast(*u8, 0);
    t.cap = 0;
    t.live = 0;
    t.next_free = 0;
    t.root = 0 - 1;
    t.ok = 0;
    t.err = OK;
    if (l.widgets < 1 || l.data_bytes < 0) { t.err = BAD_ARGUMENT; return t; }

    // Data rounded up to 8 bytes, so every widget's data is aligned for
    // whatever struct the kind keeps in it.
    t.stride = (l.data_bytes + 7) / 8 * 8;
    t.cap = l.widgets;
    let is i64 as node_bytes = t.cap * sizeof(Node);
    let is i64 as data_bytes = t.cap * t.stride;
    t.scratch_bytes = (2 * t.cap + 64) * SCRATCH_ENTRY_BYTES;
    t.scratch_used = 0;
    if (l.connections < 0) { t.err = BAD_ARGUMENT; return t; }
    t.conn_cap = l.connections;
    let is i64 as conn_bytes = t.conn_cap * sizeof(Connection);
    let is i64 as total = node_bytes + data_bytes + t.scratch_bytes + conn_bytes;
    let is *u8 as block = mem.core.mmap_anon(total);
    if (cast(i64, block) == 0) { t.err = OUT_OF_MEMORY; return t; }
    mem.core.memzero(block, total);
    t.block = block;
    t.block_bytes = total;
    t.nodes = block;
    t.data = cast(*u8, cast(i64, block) + node_bytes);
    t.scratch = cast(*u8, cast(i64, block) + node_bytes + data_bytes);
    t.conns = cast(*u8, cast(i64, t.scratch) + t.scratch_bytes);

    // Eras start at 1 so the null handle can never match slot 0.
    let is i64 as i with mut = 0;
    while (i < t.cap) {
        _node(&t, i).era = 1;
        i = i + 1;
    }
    t.ok = 1;

    _root_kind.name = "root";
    _root_kind.data_bytes = 0;
    _root_kind.destroy = cast(DestroyFn, 0);
    _root_kind.measure = cast(MeasureFn, 0);
    _root_kind.arrange = cast(ArrangeFn, 0);
    _root_kind.event = cast(EventFn, 0);
    _root_kind.hit = cast(HitFn, 0);
    _root_kind.paint = cast(PaintFn, 0);
    _root_kind.role = 0;
    _root_kind.access = cast(AccessFn, 0);
    _default_theme = style.light();
    t.root = _claim(&t, &_root_kind);
    return t;
}

// Destroys every widget still alive, children first, then releases the
// mapping. Their destroy entries run, so a kind that owns memory outside the
// tree gets it back even from a program that forgot to destroy its widgets.
fn close(t as *Tree) as void {
    if (t.ok == 0) { return; }
    _release_subtree(t, t.root);
    mem.core.munmap(t.block, t.block_bytes);
    t.block = cast(*u8, 0);
    t.nodes = cast(*u8, 0);
    t.data = cast(*u8, 0);
    t.ok = 0;
}

fn is_open(t as *Tree) as i32 { return t.ok; }

fn connection_at(t as *Tree, i as i64) as *Connection {
    return cast(*Connection, cast(i64, t.conns) + i * sizeof(Connection));
}

// Where the scratch stack stands now, to hand back to scratch_release.
fn scratch_mark(t as *Tree) as i64 { return t.scratch_used; }

// bytes of scratch, 8-aligned, or null with LAYOUT_TOO_LARGE when there is not
// enough left. Not zeroed.
fn scratch_alloc(t as *Tree, bytes as i64) as *u8 {
    let is i64 as n = (bytes + 7) / 8 * 8;
    if (n < 0 || t.scratch_used + n > t.scratch_bytes) {
        t.err = LAYOUT_TOO_LARGE;
        return cast(*u8, 0);
    }
    let is *u8 as p = cast(*u8, cast(i64, t.scratch) + t.scratch_used);
    t.scratch_used = t.scratch_used + n;
    return p;
}

// Gives back everything taken since mark.
fn scratch_release(t as *Tree, mark as i64) as void {
    if (mark >= 0 && mark <= t.scratch_used) { t.scratch_used = mark; }
}
fn root(t as *Tree) as i64 { return _handle(t, t.root); }
fn live_count(t as *Tree) as i64 { return t.live; }
fn capacity(t as *Tree) as i64 { return t.cap; }
fn last_error(t as *Tree) as i32 { return t.err; }
fn clear_error(t as *Tree) as void { t.err = OK; }

// --- Slots ---

// Claims a free slot for a widget of kind k, or returns -1. The search starts
// where the last one ended, so creating and destroying in a loop does not
// rescan the whole table each time.
fn _claim(t as *Tree, k as *Kind) as i64 {
    let is i64 as scanned with mut = 0;
    let is i64 as i with mut = t.next_free;
    while (scanned < t.cap) {
        if (i >= t.cap) { i = 0; }
        let is *Node as n = _node(t, i);
        if (n.used == 0) {
            n.used = 1;
            n.kind = k;
            n.parent = 0 - 1;
            n.first = 0 - 1;
            n.last = 0 - 1;
            n.next = 0 - 1;
            n.prev = 0 - 1;
            n.count = 0;
            // A widget nobody has measured yet needs layout by definition.
            n.flags = F_NEEDS_LAYOUT;
            n.item = geom.item_default();
            n.painted = math.rect.rect_zero();
            n.placed = math.rect.rect_zero();
            n.layer = 0;
            n.labelled_by = 0;
            n.overrides = cast(*style.Overrides, 0);
            n.tx = 0.0;
            n.ty = 0.0;
            n.opacity = 1.0;
            if (t.stride > 0) { mem.core.memzero(_data_at(t, i), t.stride); }
            t.live = t.live + 1;
            t.next_free = i + 1;
            return i;
        }
        i = i + 1;
        scanned = scanned + 1;
    }
    return 0 - 1;
}

// Runs the kind's destroy, then frees the slot. Bumping the era is what makes
// every handle to it stale.
fn _release(t as *Tree, i as i64) as void {
    let is *Node as n = _node(t, i);
    // Where it was is uncovered now. Every node of a destroyed subtree adds its
    // own: a child is normally inside its parent and adds nothing, but not
    // always.
    damage_add(t, &n.painted);
    if (n.layer > 0) { t.layered = t.layered - 1; }
    n.layer = 0;
    if (cast(i64, n.kind) != 0 && cast(i64, n.kind.destroy) != 0) {
        call(n.kind.destroy, t, _handle(t, i), _data_at(t, i));
    }
    n.used = 0;
    n.kind = cast(*Kind, 0);
    n.era = n.era + 1;
    if (n.era == 0) { n.era = 1; }
    t.live = t.live - 1;
}

// Releases i and everything under it, children before parents. Iterative,
// descending through first children and peeling leaves off the front, so a
// deep tree costs no stack and every destroy entry sees its parent alive.
fn _release_subtree(t as *Tree, top as i64) as void {
    let is i64 as cur with mut = top;
    while (1 == 1) {
        while (_node(t, cur).first != 0 - 1) { cur = _node(t, cur).first; }
        if (cur == top) {
            _release(t, cur);
            return;
        }
        let is i64 as leaf = cur;
        let is i64 as par = _node(t, leaf).parent;
        let is i64 as nxt = _node(t, leaf).next;
        let is *Node as pn = _node(t, par);
        pn.first = nxt;
        pn.count = pn.count - 1;
        if (nxt == 0 - 1) {
            pn.last = 0 - 1;
            cur = par;
        } else {
            _node(t, nxt).prev = 0 - 1;
            cur = nxt;
        }
        _release(t, leaf);
    }
}

// --- Links ---

fn _link_last(t as *Tree, p as i64, i as i64) as void {
    let is *Node as n = _node(t, i);
    let is *Node as pn = _node(t, p);
    n.parent = p;
    n.prev = pn.last;
    n.next = 0 - 1;
    if (pn.last != 0 - 1) {
        _node(t, pn.last).next = i;
    } else {
        pn.first = i;
    }
    pn.last = i;
    pn.count = pn.count + 1;
}

// Links i under p just before its child b; b of -1 is the end.
fn _link_before(t as *Tree, p as i64, i as i64, b as i64) as void {
    if (b == 0 - 1) { _link_last(t, p, i); return; }
    let is *Node as n = _node(t, i);
    let is *Node as pn = _node(t, p);
    let is *Node as bn = _node(t, b);
    n.parent = p;
    n.next = b;
    n.prev = bn.prev;
    if (bn.prev != 0 - 1) { _node(t, bn.prev).next = i; } else { pn.first = i; }
    bn.prev = i;
    pn.count = pn.count + 1;
}

fn _unlink(t as *Tree, i as i64) as void {
    let is *Node as n = _node(t, i);
    let is i64 as p = n.parent;
    if (p == 0 - 1) { return; }
    let is *Node as pn = _node(t, p);
    if (n.prev != 0 - 1) { _node(t, n.prev).next = n.next; } else { pn.first = n.next; }
    if (n.next != 0 - 1) { _node(t, n.next).prev = n.prev; } else { pn.last = n.prev; }
    pn.count = pn.count - 1;
    n.parent = 0 - 1;
    n.prev = 0 - 1;
    n.next = 0 - 1;
}

// --- Building the tree ---

// Adds a widget of kind k as the last child of parent. Returns its handle, or
// 0 with last_error() set.
fn create(t as *Tree, k as *Kind, parent as i64) as i64 {
    return create_before(t, k, parent, 0);
}

// The slot of `before` when it is one of p's children, -1 for 0 (the end), and
// -2 — with BAD_ARGUMENT or INVALID_HANDLE set — for anything else.
fn _place_of(t as *Tree, p as i64, before as i64) as i64 {
    if (before == 0) { return 0 - 1; }
    let is i64 as b = _index(t, before);
    if (b < 0) { t.err = INVALID_HANDLE; return 0 - 2; }
    if (_node(t, b).parent != p) { t.err = BAD_ARGUMENT; return 0 - 2; }
    return b;
}

// The same, just before `before`, one of parent's children; 0 is the end.
// Lists that insert a row, tabs that open beside the current one.
fn create_before(t as *Tree, k as *Kind, parent as i64, before as i64) as i64 {
    if (t.ok == 0) { t.err = BAD_ARGUMENT; return 0; }
    let is i64 as p = _index(t, parent);
    if (p < 0) { t.err = INVALID_HANDLE; return 0; }
    let is i64 as b = _place_of(t, p, before);
    if (b == 0 - 2) { return 0; }
    if (k.data_bytes > t.stride) { t.err = DATA_TOO_BIG; return 0; }
    let is i64 as i = _claim(t, k);
    if (i < 0) { t.err = FULL; return 0; }
    _link_before(t, p, i, b);
    _invalidate_from(t, p);
    return _handle(t, i);
}

// Destroys w and everything under it. The root belongs to the tree and is
// refused; a stale handle is ignored, since destroying twice is harmless.
fn destroy(t as *Tree, w as i64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    if (i == t.root) { t.err = BAD_ARGUMENT; return; }
    let is i64 as p = _node(t, i).parent;
    // The textures around it still show what is about to go.
    if (p != 0 - 1) { _stale_from(t, p); }
    _unlink(t, i);
    if (p != 0 - 1) { _invalidate_from(t, p); }
    _release_subtree(t, i);
}

// Moves w, with its subtree, to the end of new_parent's children. Refuses to
// move the root, and to move a widget under itself or its own descendant,
// which would detach the subtree into a cycle nothing could reach.
fn reparent(t as *Tree, w as i64, new_parent as i64) as i32 {
    return insert(t, w, new_parent, 0);
}

// Moves w, with its subtree, under parent just before `before` — one of
// parent's children, or 0 for the end. Refused like reparent, and for a
// `before` that is not parent's. Before itself is where it already is.
fn insert(t as *Tree, w as i64, parent as i64, before as i64) as i32 {
    let is i64 as i = _index(t, w);
    let is i64 as p = _index(t, parent);
    if (i < 0 || p < 0) { t.err = INVALID_HANDLE; return 0; }
    if (i == t.root) { t.err = BAD_ARGUMENT; return 0; }
    let is i64 as a with mut = p;
    while (a != 0 - 1) {
        if (a == i) { t.err = BAD_ARGUMENT; return 0; }
        a = _node(t, a).parent;
    }
    let is i64 as b = _place_of(t, p, before);
    if (b == 0 - 2) { return 0; }
    if (b == i) { return 1; }
    let is i64 as old = _node(t, i).parent;
    _unlink(t, i);
    _link_before(t, p, i, b);
    if (old != 0 - 1) { _invalidate_from(t, old); }
    _invalidate_from(t, i);
    return 1;
}

// Moves w among its siblings, just before `before`; 0 is the end. Reordering
// a list, dragging a tab.
fn move_before(t as *Tree, w as i64, before as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { t.err = INVALID_HANDLE; return 0; }
    let is i64 as p = _node(t, i).parent;
    if (p == 0 - 1) { t.err = BAD_ARGUMENT; return 0; }
    return insert(t, w, _handle(t, p), before);
}

// --- Walking the tree ---

fn is_valid(t as *Tree, w as i64) as i32 {
    if (_index(t, w) < 0) { return 0; }
    return 1;
}

fn _link(t as *Tree, w as i64, which as i32) as i64 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    let is *Node as n = _node(t, i);
    let is i64 as j with mut = n.parent;
    if (which == 1) { j = n.first; }
    if (which == 2) { j = n.last; }
    if (which == 3) { j = n.next; }
    if (which == 4) { j = n.prev; }
    if (j == 0 - 1) { return 0; }
    return _handle(t, j);
}

fn parent(t as *Tree, w as i64) as i64       { return _link(t, w, 0); }
fn first_child(t as *Tree, w as i64) as i64  { return _link(t, w, 1); }
fn last_child(t as *Tree, w as i64) as i64   { return _link(t, w, 2); }
fn next_sibling(t as *Tree, w as i64) as i64 { return _link(t, w, 3); }
fn prev_sibling(t as *Tree, w as i64) as i64 { return _link(t, w, 4); }

// Where w is among its siblings, from 0; -1 for the root or a stale handle.
fn index_of(t as *Tree, w as i64) as i64 {
    let is i64 as i = _index(t, w);
    if (i < 0 || i == t.root) { return 0 - 1; }
    let is i64 as k with mut = 0;
    let is i64 as c with mut = _node(t, i).prev;
    while (c != 0 - 1) {
        k = k + 1;
        c = _node(t, c).prev;
    }
    return k;
}

// The child of w at index i, 0 when there is none.
fn child_at(t as *Tree, w as i64, i as i64) as i64 {
    let is i64 as p = _index(t, w);
    if (p < 0 || i < 0) { return 0; }
    let is i64 as c with mut = _node(t, p).first;
    let is i64 as k with mut = 0;
    while (c != 0 - 1 && k < i) {
        c = _node(t, c).next;
        k = k + 1;
    }
    return _handle(t, c);
}

fn child_count(t as *Tree, w as i64) as i64 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    return _node(t, i).count;
}

fn kind(t as *Tree, w as i64) as *Kind {
    let is i64 as i = _index(t, w);
    if (i < 0) { return cast(*Kind, 0); }
    return _node(t, i).kind;
}

// The widget's data, zeroed at creation; null for a stale handle or a kind
// that asked for none.
fn data(t as *Tree, w as i64) as *u8 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return cast(*u8, 0); }
    if (_node(t, i).kind.data_bytes == 0) { return cast(*u8, 0); }
    return _data_at(t, i);
}

// --- Visibility and enablement ---
//
// A widget is shown only if it and every ancestor are; the same for enabled.
// Hiding changes how much room the parent hands out, so it invalidates
// layout; disabling changes only how the widget looks and answers.

fn _any_up(t as *Tree, i as i64, bit as i64) as i32 {
    let is i64 as a with mut = i;
    while (a != 0 - 1) {
        if ((_node(t, a).flags & bit) != 0) { return 1; }
        a = _node(t, a).parent;
    }
    return 0;
}

fn set_visible(t as *Tree, w as i64, on as i32) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    let is *Node as n = _node(t, i);
    n.flags = _set(n.flags, F_HIDDEN, 1 - on);
    _invalidate_from(t, i);
}

fn is_visible(t as *Tree, w as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    return 1 - _any_up(t, i, F_HIDDEN);
}

fn set_enabled(t as *Tree, w as i64, on as i32) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    let is *Node as n = _node(t, i);
    n.flags = _set(n.flags, F_DISABLED, 1 - on);
    // Disabled is inherited, so the whole subtree looks different now.
    invalidate_paint_subtree(t, w);
}

fn is_enabled(t as *Tree, w as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    return 1 - _any_up(t, i, F_DISABLED);
}

// --- Focus ---
//
// Whether w can take keyboard focus at all. Its own flag only: being hidden,
// disabled or outside a modal scope is the router's business at the moment
// focus moves.
fn set_focusable(t as *Tree, w as i64, on as i32) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    let is *Node as n = _node(t, i);
    n.flags = _set(n.flags, F_FOCUSABLE, on);
}

// The flags a program sets itself — F_FOCUS_WITHIN_LOOK and F_CACHE — and
// F_CACHE_DIRTY, which damage.cst and paint.cst keep.
fn set_flag(t as *Tree, w as i64, bit as i64, on as i32) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    if (bit != F_FOCUS_WITHIN_LOOK && bit != F_CACHE && bit != F_CACHE_DIRTY) { return; }
    let is *Node as n = _node(t, i);
    n.flags = _set(n.flags, bit, on);
    if (bit == F_CACHE) {
        n.flags = _set(n.flags, F_CACHE_DIRTY, 1);
        _mark_paint(t, i);
    }
}

// Whether node i is painted through a texture of its own: F_CACHE, or
// partly transparent, which needs its subtree composited as one.
fn _textured(t as *Tree, i as i64) as i32 {
    let is *Node as n = _node(t, i);
    if ((n.flags & F_CACHE) != 0 || n.opacity < 1.0) { return 1; }
    return 0;
}

fn is_textured(t as *Tree, w as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    return _textured(t, i);
}

// Every texture at or above slot i is stale: each holds the picture of the
// ones inside it.
fn _stale_from(t as *Tree, i as i64) as void {
    let is i64 as a with mut = i;
    while (a != 0 - 1) {
        let is *Node as n = _node(t, a);
        if (_textured(t, a) == 1) { n.flags = n.flags | F_CACHE_DIRTY; }
        a = n.parent;
    }
}

// w's texture, if it has one, and every one around it, are to be painted
// again — damage.cst's, when something inside changed.
fn stale_textures(t as *Tree, w as i64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    _stale_from(t, i);
}

fn has_flag(t as *Tree, w as i64, bit as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    if ((_node(t, i).flags & bit) != 0) { return 1; }
    return 0;
}

fn is_focusable(t as *Tree, w as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    if ((_node(t, i).flags & F_FOCUSABLE) != 0) { return 1; }
    return 0;
}

// --- Layout's per-widget record ---

// The Item layout keeps for w, or null for a stale handle. layout.cst is the
// one that reads and writes it; the tree only stores it.
fn item(t as *Tree, w as i64) as *geom.Item {
    let is i64 as i = _index(t, w);
    if (i < 0) { return cast(*geom.Item, 0); }
    let is *Node as n = _node(t, i);
    return &n.item;
}

// --- Layout invalidation ---
//
// A widget that changes size can change every ancestor's, so the mark climbs
// to the root. It does not stop at an ancestor already marked: a layout pass
// that clears top-down may have left a marked node under a cleared one, and
// stopping early there would leave the root believing nothing changed.

// Whatever is marked also loses its cached measure: the cache answered for a
// widget that has since changed, or whose descendants have.
fn _invalidate_from(t as *Tree, i as i64) as void {
    // A layout pass may move anything, and damage.cst finds what moved.
    t.paint_wanted = 1;
    let is i64 as a with mut = i;
    while (a != 0 - 1) {
        let is *Node as n = _node(t, a);
        n.flags = n.flags | F_NEEDS_LAYOUT;
        n.item.cache_ok = 0;
        a = n.parent;
    }
}

// Marks w, every descendant and every ancestor. For a change that alters how
// a whole subtree lays out — the writing direction — rather than one widget's
// size: a descendant left clean would keep its old arrangement.
fn invalidate_subtree(t as *Tree, w as i64) as void {
    let is i64 as top = _index(t, w);
    if (top < 0) { return; }
    _invalidate_from(t, top);
    let is i64 as cur with mut = _node(t, top).first;
    while (cur != 0 - 1) {
        let is *Node as n = _node(t, cur);
        n.flags = n.flags | F_NEEDS_LAYOUT;
        n.item.cache_ok = 0;
        // Depth-first without a stack: down to the first child, else across,
        // else back up until an ancestor below top has a next sibling.
        if (n.first != 0 - 1) {
            cur = n.first;
        } else {
            let is i64 as up with mut = cur;
            cur = 0 - 1;
            while (up != top && cur == 0 - 1) {
                if (_node(t, up).next != 0 - 1) {
                    cur = _node(t, up).next;
                } else {
                    up = _node(t, up).parent;
                }
            }
        }
    }
}

fn invalidate_layout(t as *Tree, w as i64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    _invalidate_from(t, i);
}

fn needs_layout(t as *Tree, w as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    if ((_node(t, i).flags & F_NEEDS_LAYOUT) != 0) { return 1; }
    return 0;
}

fn clear_layout(t as *Tree, w as i64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    let is *Node as n = _node(t, i);
    n.flags = _set(n.flags, F_NEEDS_LAYOUT, 0);
}

// --- Paint invalidation ---
//
// Marking a widget repaints it when damage.cst next collects — which is after
// layout, so a widget that both changed and moved repaints both places. A widget that only moved, or was
// hidden, shown or reparented, needs no mark: collecting compares every
// rectangle with where it was painted, and invalidating its layout already
// said there is something to collect. Destroying is the exception, done in
// _release: once the node is gone there is nothing left to compare.

fn _mark_paint(t as *Tree, i as i64) as void {
    let is *Node as n = _node(t, i);
    n.flags = n.flags | F_NEEDS_PAINT;
    t.paint_wanted = 1;
}

fn invalidate_paint(t as *Tree, w as i64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    _mark_paint(t, i);
}

// w and everything under it — for a change every descendant shows, such as
// being disabled.
fn invalidate_paint_subtree(t as *Tree, w as i64) as void {
    let is i64 as top = _index(t, w);
    if (top < 0) { return; }
    _mark_paint(t, top);
    let is i64 as cur with mut = _node(t, top).first;
    while (cur != 0 - 1) {
        _mark_paint(t, cur);
        let is *Node as n = _node(t, cur);
        if (n.first != 0 - 1) {
            cur = n.first;
        } else {
            let is i64 as up with mut = cur;
            cur = 0 - 1;
            while (up != top && cur == 0 - 1) {
                if (_node(t, up).next != 0 - 1) {
                    cur = _node(t, up).next;
                } else {
                    up = _node(t, up).parent;
                }
            }
        }
    }
}

fn needs_paint(t as *Tree, w as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    if ((_node(t, i).flags & F_NEEDS_PAINT) != 0) { return 1; }
    return 0;
}

fn clear_paint(t as *Tree, w as i64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    let is *Node as n = _node(t, i);
    n.flags = _set(n.flags, F_NEEDS_PAINT, 0);
}

// Its own disabled flag, ancestors aside; painting walks down and carries
// theirs.
fn is_enabled_here(t as *Tree, w as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    if ((_node(t, i).flags & F_DISABLED) != 0) { return 0; }
    return 1;
}

// Its own hidden flag, ancestors aside; damage.cst walks down and carries
// theirs.
fn is_hidden_here(t as *Tree, w as i64) as i32 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 1; }
    if ((_node(t, i).flags & F_HIDDEN) != 0) { return 1; }
    return 0;
}

fn painted(t as *Tree, w as i64) as math.rect.Rect {
    let is i64 as i = _index(t, w);
    if (i < 0) { return math.rect.rect_zero(); }
    return _node(t, i).painted;
}

fn placed(t as *Tree, w as i64) as math.rect.Rect {
    let is i64 as i = _index(t, w);
    if (i < 0) { return math.rect.rect_zero(); }
    return _node(t, i).placed;
}

// Where w was laid out, and the part of that on screen.
fn set_painted(t as *Tree, w as i64, at as math.rect.Rect, shown as math.rect.Rect) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    _node(t, i).placed = at;
    _node(t, i).painted = shown;
}

// --- The damage region ---

fn _area(r as math.rect.Rect) as f64 { return r.w * r.h; }

// Whether two rectangles overlap or share a stretch of edge — merging those
// costs nothing extra. Touching at a corner only does not count: the box
// around two such rectangles is twice what they cover.
fn _joinable(a as math.rect.Rect, b as math.rect.Rect) as i32 {
    let is f64 as ox = _minf(a.x + a.w, b.x + b.w) - _maxf(a.x, b.x);
    let is f64 as oy = _minf(a.y + a.h, b.y + b.h) - _maxf(a.y, b.y);
    if (ox < 0.0 || oy < 0.0) { return 0; }
    if (ox > 0.0 || oy > 0.0) { return 1; }
    return 0;
}

fn _minf(a as f64, b as f64) as f64 { if (a < b) { return a; } return b; }
fn _maxf(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _take(t as *Tree, i as i64) as math.rect.Rect {
    let is math.rect.Rect as r = t.damage[i];
    t.damage_n = t.damage_n - 1;
    t.damage[i] = t.damage[t.damage_n];
    return r;
}

// Adds r to what has to be repainted. One that overlaps or borders another is
// merged with it — a rectangle already covered merges into the one covering
// it, unchanged — and the merge repeated while the result reaches others;
// when the region is full, it goes into whichever rectangle it enlarges
// least.
fn damage_add(t as *Tree, r as *math.rect.Rect) as void {
    if (t.ok == 0 || r.w <= 0.0 || r.h <= 0.0) { return; }
    t.paint_wanted = 1;
    let is math.rect.Rect as cur with mut = *r;
    while (1 == 1) {
        let is i64 as hit with mut = 0 - 1;
        let is i64 as i with mut = 0;
        while (i < t.damage_n && hit < 0) {
            if (_joinable(t.damage[i], cur) == 1) { hit = i; }
            i = i + 1;
        }
        if (hit < 0 && t.damage_n < MAX_DAMAGE) {
            t.damage[t.damage_n] = cur;
            t.damage_n = t.damage_n + 1;
            return;
        }
        if (hit < 0) {
            let is f64 as best with mut = 0.0;
            i = 0;
            while (i < t.damage_n) {
                let is f64 as grow = _area(math.rect.rect_union(t.damage[i], cur)) - _area(t.damage[i]);
                if (hit < 0 || grow < best) { hit = i; best = grow; }
                i = i + 1;
            }
        }
        cur = math.rect.rect_union(_take(t, hit), cur);
    }
}

// Keeps only what lies inside r — the window, at collection.
fn damage_clip(t as *Tree, r as math.rect.Rect) as void {
    let is i64 as i with mut = 0;
    while (i < t.damage_n) {
        let is math.rect.Rect as c = math.rect.rect_intersect(t.damage[i], r);
        if (math.rect.rect_is_empty(c) == 1) {
            _take(t, i);
        } else {
            t.damage[i] = c;
            i = i + 1;
        }
    }
}

fn damage_count(t as *Tree) as i64 { return t.damage_n; }

fn damage_at(t as *Tree, i as i64) as math.rect.Rect {
    if (i < 0 || i >= t.damage_n) { return math.rect.rect_zero(); }
    return t.damage[i];
}

// Whether anything may need repainting: damage added, a widget marked, a
// layout invalidated, a widget destroyed. Painting an idle window is skipped
// on this.
fn paint_wanted(t as *Tree) as i32 {
    if (t.paint_wanted != 0) { return 1; }
    return 0;
}

// For a change the tree cannot see: layout moved something, a scale changed.
fn want_paint(t as *Tree) as void { t.paint_wanted = 1; }

// After the frame is presented: nothing is owed any more.
fn damage_clear(t as *Tree) as void {
    t.damage_n = 0;
    t.paint_wanted = 0;
}

// --- Layers ---
//
// A widget on a layer above 0 — a popup drawn inside the window, a drag's
// image, a toast — is drawn above everything on lower layers wherever it sits
// in the tree, and is not clipped by its ancestors: it may reach past its
// parent's edge, as a dropdown below its button does. Hit-testing looks at it
// first. Its subtree is on its layer, or a higher one of its own.

fn set_layer(t as *Tree, w as i64, layer as i64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0 || i == t.root || layer < 0) { return; }
    let is *Node as n = _node(t, i);
    if (n.layer == layer) { return; }
    if (n.layer > 0) { t.layered = t.layered - 1; }
    if (layer > 0) { t.layered = t.layered + 1; }
    n.layer = layer;
    // Where it was drawn under the old clip, and the whole of it under the new.
    damage_add(t, &n.painted);
    _mark_paint(t, i);
    n.placed = math.rect.rect_zero();
}

fn layer(t as *Tree, w as i64) as i64 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    return _node(t, i).layer;
}

// How many widgets are on a layer above 0; with none, painting and
// hit-testing skip looking for them.
fn layered_count(t as *Tree) as i64 { return t.layered; }

// --- The theme ---
//
// One per tree, which is one per window: the program's, pointed at rather
// than copied, so an application switches every window by changing the one
// theme and telling each tree (app.set_theme does both). A widget can lay
// overrides on its subtree; widget.theme resolves what applies to it, and
// painting hands each paint entry its resolved theme.
//
// Changing either lays out again — text sizes and paddings are in the theme —
// and repaints what it reaches.

// The theme with no program's set: light. Module scope, filled when a tree
// opens, because a Tree is returned by value.
let is style.Theme as _default_theme with mut;

// --- What the application lends ---
//
// The text service (ui/text.cst) every widget that shows text lays it out
// with: one per application, so a form of fifty labels holds one shaper.
// Kept as a bare pointer so that the tree, which every widget imports, does
// not bring the text stack into programs that show none; a widget casts it
// to *text.Service. Setting it measures every widget again.
fn set_text_service(t as *Tree, s as *u8) as void {
    if (t.ok == 0) { return; }
    t.text = s;
    invalidate_subtree(t, root(t));
    invalidate_paint_subtree(t, root(t));
}

fn text_service(t as *Tree) as *u8 { return t.text; }

// Text copied by a widget goes to the platform through the program: to the
// clipboard Ctrl+C fills, or to the primary selection a mouse selection
// fills on X11 and Wayland. The tree only passes it on.
let is i32 as CLIPBOARD with imut = 0;
let is i32 as PRIMARY   with imut = 1;

fn set_clipboard(t as *Tree, cb as ClipboardFn, user as *u8) as void {
    t.clip_fn = cb;
    t.clip_user = user;
}

// n bytes of UTF-8 at text to which, CLIPBOARD or PRIMARY; the program
// copies them before it returns. Nothing without a function set.
fn copy(t as *Tree, which as i32, text as *u8, n as i64) as void {
    if (cast(i64, t.clip_fn) == 0) { return; }
    call(t.clip_fn, t.clip_user, which, text, n);
}

// --- Which widget names which ---
//
// A widget with no text of its own — an entry, a slider — is named by the
// label beside it: assistive technology reads the label's text as its name
// (access.cst), and the label's mnemonic moves focus to it.

// label names w from now on; 0 for none.
fn set_labelled_by(t as *Tree, w as i64, label as i64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    _node(t, i).labelled_by = label;
}

// The widget that names w, or 0 — also once that widget is gone.
fn labelled_by(t as *Tree, w as i64) as i64 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0; }
    let is i64 as l = _node(t, i).labelled_by;
    if (is_valid(t, l) == 0) { return 0; }
    return l;
}

fn theme(t as *Tree) as *style.Theme {
    if (cast(i64, t.theme) != 0) { return t.theme; }
    return &_default_theme;
}

// th must outlive the tree, or be replaced first; null goes back to the
// default. Setting the same pointer again says its contents changed.
fn set_theme(t as *Tree, th as *style.Theme) as void {
    if (t.ok == 0) { return; }
    t.theme = th;
    invalidate_subtree(t, root(t));
    invalidate_paint_subtree(t, root(t));
}

// Lays o over the theme for w and everything under it; null removes it. The
// program owns o and keeps it alive while it is set; setting the same pointer
// again says its contents changed. The nearest override to a widget is applied
// last, over those further up.
fn set_overrides(t as *Tree, w as i64, o as *style.Overrides) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    _node(t, i).overrides = o;
    invalidate_subtree(t, w);
    invalidate_paint_subtree(t, w);
}

fn overrides(t as *Tree, w as i64) as *style.Overrides {
    let is i64 as i = _index(t, w);
    if (i < 0) { return cast(*style.Overrides, 0); }
    return _node(t, i).overrides;
}

// --- Where a widget is drawn, and how much of it ---
//
// Translation moves a widget and everything under it from where layout put
// it: painted there, hit there, its rectangle in the window there — and laid
// out exactly as before, which is what lets an animation slide something
// without measuring anything again. Opacity fades the widget and its subtree
// as one picture, composited through a texture of its own (paint.cst's
// cache): a translucent subtree is not each widget translucent, which would
// show the widgets behind one another through it. At 0 nothing of it is
// drawn; it is still there, and still hit.

fn set_translation(t as *Tree, w as i64, x as f64, y as f64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    let is *Node as n = _node(t, i);
    if (n.tx == x && n.ty == y) { return; }
    n.tx = x;
    n.ty = y;
    // Nothing to lay out; damage.cst sees it move.
    t.paint_wanted = 1;
}

fn translation_x(t as *Tree, w as i64) as f64 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0.0; }
    return _node(t, i).tx;
}

fn translation_y(t as *Tree, w as i64) as f64 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0.0; }
    return _node(t, i).ty;
}

// From 0, not drawn, to 1, opaque; outside that, the nearer end.
fn set_opacity(t as *Tree, w as i64, a as f64) as void {
    let is i64 as i = _index(t, w);
    if (i < 0) { return; }
    let is f64 as v with mut = a;
    if (v < 0.0) { v = 0.0; }
    if (v > 1.0) { v = 1.0; }
    let is *Node as n = _node(t, i);
    if (n.opacity == v) { return; }
    // Becoming translucent needs its subtree painted into a texture first;
    // after that a fade only changes how the texture is put back, so the
    // place is repainted without marking anything in it changed. The
    // textures around it show it, though. Where nothing of it is on screen
    // there is nothing to repaint, and no frame asked for.
    if (n.opacity >= 1.0) { n.flags = n.flags | F_CACHE_DIRTY; }
    n.opacity = v;
    if (n.parent != 0 - 1) { _stale_from(t, n.parent); }
    damage_add(t, &n.painted);
}

fn opacity(t as *Tree, w as i64) as f64 {
    let is i64 as i = _index(t, w);
    if (i < 0) { return 0.0; }
    return _node(t, i).opacity;
}
