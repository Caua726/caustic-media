type Kind = tst.Kind;
type TextQuery = tst.TextQuery;
let is i64 as TEXT_GET with imut = tst.TEXT_GET;
let is i64 as TEXT_EXTENTS with imut = tst.TEXT_EXTENTS;
let is i64 as TEXT_OFFSET_AT with imut = tst.TEXT_OFFSET_AT;
let is i64 as TEXT_SET_CARET with imut = tst.TEXT_SET_CARET;
let is i64 as TEXT_SELECT with imut = tst.TEXT_SELECT;
let is i64 as TEXT_REPLACE with imut = tst.TEXT_REPLACE;
let is i64 as TEXT_COPY with imut = tst.TEXT_COPY;
let is i64 as TEXT_CUT with imut = tst.TEXT_CUT;
let is i64 as TEXT_PASTE with imut = tst.TEXT_PASTE;
let is i64 as TEXT_INFO with imut = tst.TEXT_INFO;
let is i64 as TEXT_SPAN with imut = tst.TEXT_SPAN;
let is i64 as TEXT_CHAR_OF with imut = tst.TEXT_CHAR_OF;
let is i64 as TEXT_BYTE_OF with imut = tst.TEXT_BYTE_OF;
