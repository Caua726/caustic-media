let is i32 as SHAPE_INHERIT with imut = tst.SHAPE_INHERIT;
let is i32 as SHAPE_DEFAULT with imut = tst.SHAPE_DEFAULT;
let is i32 as SHAPE_CONTEXT_MENU with imut = tst.SHAPE_CONTEXT_MENU;
let is i32 as SHAPE_HELP with imut = tst.SHAPE_HELP;
let is i32 as SHAPE_POINTER with imut = tst.SHAPE_POINTER;
let is i32 as SHAPE_PROGRESS with imut = tst.SHAPE_PROGRESS;
let is i32 as SHAPE_WAIT with imut = tst.SHAPE_WAIT;
let is i32 as SHAPE_CELL with imut = tst.SHAPE_CELL;
let is i32 as SHAPE_CROSSHAIR with imut = tst.SHAPE_CROSSHAIR;
let is i32 as SHAPE_TEXT with imut = tst.SHAPE_TEXT;
let is i32 as SHAPE_VERTICAL_TEXT with imut = tst.SHAPE_VERTICAL_TEXT;
let is i32 as SHAPE_ALIAS with imut = tst.SHAPE_ALIAS;
let is i32 as SHAPE_COPY with imut = tst.SHAPE_COPY;
let is i32 as SHAPE_MOVE with imut = tst.SHAPE_MOVE;
let is i32 as SHAPE_NO_DROP with imut = tst.SHAPE_NO_DROP;
let is i32 as SHAPE_NOT_ALLOWED with imut = tst.SHAPE_NOT_ALLOWED;
let is i32 as SHAPE_GRAB with imut = tst.SHAPE_GRAB;
let is i32 as SHAPE_GRABBING with imut = tst.SHAPE_GRABBING;
let is i32 as SHAPE_E_RESIZE with imut = tst.SHAPE_E_RESIZE;
let is i32 as SHAPE_N_RESIZE with imut = tst.SHAPE_N_RESIZE;
let is i32 as SHAPE_NE_RESIZE with imut = tst.SHAPE_NE_RESIZE;
let is i32 as SHAPE_NW_RESIZE with imut = tst.SHAPE_NW_RESIZE;
let is i32 as SHAPE_S_RESIZE with imut = tst.SHAPE_S_RESIZE;
let is i32 as SHAPE_SE_RESIZE with imut = tst.SHAPE_SE_RESIZE;
let is i32 as SHAPE_SW_RESIZE with imut = tst.SHAPE_SW_RESIZE;
let is i32 as SHAPE_W_RESIZE with imut = tst.SHAPE_W_RESIZE;
let is i32 as SHAPE_EW_RESIZE with imut = tst.SHAPE_EW_RESIZE;
let is i32 as SHAPE_NS_RESIZE with imut = tst.SHAPE_NS_RESIZE;
let is i32 as SHAPE_NESW_RESIZE with imut = tst.SHAPE_NESW_RESIZE;
let is i32 as SHAPE_NWSE_RESIZE with imut = tst.SHAPE_NWSE_RESIZE;
let is i32 as SHAPE_COL_RESIZE with imut = tst.SHAPE_COL_RESIZE;
let is i32 as SHAPE_ROW_RESIZE with imut = tst.SHAPE_ROW_RESIZE;
let is i32 as SHAPE_ALL_SCROLL with imut = tst.SHAPE_ALL_SCROLL;
let is i32 as SHAPE_ZOOM_IN with imut = tst.SHAPE_ZOOM_IN;
