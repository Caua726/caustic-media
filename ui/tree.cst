type TextFn = tst.TextFn;
type ClipboardFn = tst.ClipboardFn;
type PasteFn = tst.PasteFn;
type WindowOpFn = tst.WindowOpFn;
let is i32 as WIN_MOVE with imut = tst.WIN_MOVE;
let is i32 as WIN_MINIMIZE with imut = tst.WIN_MINIMIZE;
let is i32 as WIN_MAXIMIZE with imut = tst.WIN_MAXIMIZE;
let is i32 as WIN_CLOSE with imut = tst.WIN_CLOSE;
let is i32 as WIN_MENU with imut = tst.WIN_MENU;
let is i32 as WIN_RESIZE_N with imut = tst.WIN_RESIZE_N;
let is i32 as WIN_RESIZE_NE with imut = tst.WIN_RESIZE_NE;
let is i32 as WIN_RESIZE_E with imut = tst.WIN_RESIZE_E;
let is i32 as WIN_RESIZE_SE with imut = tst.WIN_RESIZE_SE;
let is i32 as WIN_RESIZE_S with imut = tst.WIN_RESIZE_S;
let is i32 as WIN_RESIZE_SW with imut = tst.WIN_RESIZE_SW;
let is i32 as WIN_RESIZE_W with imut = tst.WIN_RESIZE_W;
let is i32 as WIN_RESIZE_NW with imut = tst.WIN_RESIZE_NW;
type HostFn = tst.HostFn;
let is i32 as HOST_DIALOG with imut = tst.HOST_DIALOG;
let is i32 as HOST_IS_DIALOG with imut = tst.HOST_IS_DIALOG;
let is i32 as HOST_SHOW with imut = tst.HOST_SHOW;
let is i32 as HOST_HIDE with imut = tst.HOST_HIDE;
let is i32 as HOST_TITLE with imut = tst.HOST_TITLE;
let is i32 as HOST_SIZE with imut = tst.HOST_SIZE;
let is i32 as HOST_CLOSE with imut = tst.HOST_CLOSE;
type HostText = tst.HostText;
type WatchFn = tst.WatchFn;
let is i32 as WATCH_ADDED with imut = tst.WATCH_ADDED;
let is i32 as WATCH_REMOVED with imut = tst.WATCH_REMOVED;
let is i32 as WATCH_CHANGED with imut = tst.WATCH_CHANGED;
let is i32 as WATCH_FOCUS with imut = tst.WATCH_FOCUS;
let is i32 as WATCH_TEXT with imut = tst.WATCH_TEXT;
let is i32 as WATCH_STATE with imut = tst.WATCH_STATE;
let is i64 as TEXT_INSERTED with imut = tst.TEXT_INSERTED;
let is i64 as TEXT_DELETED with imut = tst.TEXT_DELETED;
type TextChange = tst.TextChange;
type ImeResetFn = tst.ImeResetFn;
type SignalFn = tst.SignalFn;
type Node = tst.Node;
type Tree = tst.Tree;
let is i64 as SCRATCH_ENTRY_BYTES with imut = tst.SCRATCH_ENTRY_BYTES;
let is i32 as CLIPBOARD with imut = tst.CLIPBOARD;
let is i32 as PRIMARY with imut = tst.PRIMARY;

fn limits_default() as tst.Limits {
    let is tst.Limits as l;
    l.widgets = 4096;
    l.data_bytes = 256;
    l.connections = 4096;
    return l;
}

// --- Opening and closing ---

fn open(l as *tst.Limits) as tst.Tree {
    let is tst.Tree as t;
    t.nodes = cast(*u8, 0);
    t.data = cast(*u8, 0);
    t.block = cast(*u8, 0);
    t.block_bytes = 0;
    t.scratch = cast(*u8, 0);
    t.scratch_bytes = 0;
    t.scratch_used = 0;
    t.conns = cast(*u8, 0);
    t.conn_cap = 0;
    t.conn_used = 0;
    t.conn_seq = 0;
    t.emit_serial = 0;
    t.emitting = 0;
    t.damage_n = 0;
    t.paint_wanted = 0;
    tdraw._shift_reset(&t);
    t.blink_w = 0;
    t.moves = 0;
    t.scale = 1.0;
    t.layered = 0;
    t.theme = cast(*style.Theme, 0);
    t.text = cast(*u8, 0);
    t.animator = cast(*u8, 0);
    t.timers = cast(*u8, 0);
    t.router = cast(*u8, 0);
    t.want_focus = 0;
    t.clip_fn = cast(tst.ClipboardFn, 0);
    t.clip_user = cast(*u8, 0);
    t.paste_fn = cast(tst.PasteFn, 0);
    t.paste_user = cast(*u8, 0);
    t.area_w = 0;
    t.area = math.rect.rect_zero();
    t.ime_fn = cast(tst.ImeResetFn, 0);
    t.ime_user = cast(*u8, 0);
    t.win_fn = cast(tst.WindowOpFn, 0);
    t.win_user = cast(*u8, 0);
    t.host_fn = cast(tst.HostFn, 0);
    t.host_user = cast(*u8, 0);
    t.host_window = 0;
    t.watch_fn = cast(tst.WatchFn, 0);
    t.watch_user = cast(*u8, 0);
    t.text_change = cast(*tst.TextChange, 0);
    t.language = 0;
    t.cap = 0;
    t.live = 0;
    t.next_free = 0;
    t.root = 0 - 1;
    t.ok = 0;
    t.err = OK;
    if (l.widgets < 1 || l.data_bytes < 0) { t.err = BAD_ARGUMENT; return t; }

    // Data rounded up to 8 bytes, so every widget's data is aligned for
    // whatever struct the kind keeps in it.
    t.stride = (l.data_bytes + 7) / 8 * 8;
    t.cap = l.widgets;
    let is i64 as node_bytes = t.cap * sizeof(tst.Node);
    let is i64 as data_bytes = t.cap * t.stride;
    t.scratch_bytes = (2 * t.cap + 64) * SCRATCH_ENTRY_BYTES;
    t.scratch_used = 0;
    if (l.connections < 0) { t.err = BAD_ARGUMENT; return t; }
    t.conn_cap = l.connections;
    let is i64 as conn_bytes = t.conn_cap * sizeof(tst.Connection);
    let is i64 as total = node_bytes + data_bytes + t.scratch_bytes + conn_bytes;
    let is *u8 as block = mem.core.mmap_anon(total);
    if (cast(i64, block) == 0) { t.err = OUT_OF_MEMORY; return t; }
    mem.core.memzero(block, total);
    t.block = block;
    t.block_bytes = total;
    t.nodes = block;
    t.data = cast(*u8, cast(i64, block) + node_bytes);
    t.scratch = cast(*u8, cast(i64, block) + node_bytes + data_bytes);
    t.conns = cast(*u8, cast(i64, t.scratch) + t.scratch_bytes);

    // Eras start at 1 so the null handle can never match slot 0.
    let is i64 as i with mut = 0;
    while (i < t.cap) {
        tst._node(&t, i).era = 1;
        i = i + 1;
    }
    t.ok = 1;

    tst._root_kind.name = "root";
    tst._root_kind.data_bytes = 0;
    tst._root_kind.destroy = cast(tst.DestroyFn, 0);
    tst._root_kind.measure = cast(tst.MeasureFn, 0);
    tst._root_kind.arrange = cast(tst.ArrangeFn, 0);
    tst._root_kind.event = cast(tst.EventFn, 0);
    tst._root_kind.hit = cast(tst.HitFn, 0);
    tst._root_kind.paint = cast(tst.PaintFn, 0);
    tst._root_kind.role = 0;
    tst._root_kind.access = cast(tst.AccessFn, 0);
    tst._root_kind.shape = cast(tst.ShapeFn, 0);
    tst._root_kind.paint_over = cast(tst.PaintFn, 0);
    tst._root_kind.caret = cast(tst.CaretFn, 0);
    tst._default_theme = style.light();
    t.root = _claim(&t, &tst._root_kind);
    return t;
}

// Destroys every widget still alive, children first, then releases the
// mapping. Their destroy entries run, so a kind that owns memory outside the
// tree gets it back even from a program that forgot to destroy its widgets.
fn close(t as *tst.Tree) as void {
    if (t.ok == 0) { return; }
    _release_subtree(t, t.root);
    mem.core.munmap(t.block, t.block_bytes);
    t.block = cast(*u8, 0);
    t.nodes = cast(*u8, 0);
    t.data = cast(*u8, 0);
    t.ok = 0;
}

fn is_open(t as *tst.Tree) as i32 { return t.ok; }

fn connection_at(t as *tst.Tree, i as i64) as *tst.Connection {
    return cast(*tst.Connection, cast(i64, t.conns) + i * sizeof(tst.Connection));
}

// Where the scratch stack stands now, to hand back to scratch_release.
fn scratch_mark(t as *tst.Tree) as i64 { return t.scratch_used; }

// bytes of scratch, 8-aligned, or null with LAYOUT_TOO_LARGE when there is not
// enough left. Not zeroed.
fn scratch_alloc(t as *tst.Tree, bytes as i64) as *u8 {
    let is i64 as n = (bytes + 7) / 8 * 8;
    if (n < 0 || t.scratch_used + n > t.scratch_bytes) {
        t.err = LAYOUT_TOO_LARGE;
        return cast(*u8, 0);
    }
    let is *u8 as p = cast(*u8, cast(i64, t.scratch) + t.scratch_used);
    t.scratch_used = t.scratch_used + n;
    return p;
}

// Gives back everything taken since mark.
fn scratch_release(t as *tst.Tree, mark as i64) as void {
    if (mark >= 0 && mark <= t.scratch_used) { t.scratch_used = mark; }
}
fn root(t as *tst.Tree) as i64 { return tst._handle(t, t.root); }
fn live_count(t as *tst.Tree) as i64 { return t.live; }
fn capacity(t as *tst.Tree) as i64 { return t.cap; }
fn last_error(t as *tst.Tree) as i32 { return t.err; }
fn clear_error(t as *tst.Tree) as void { t.err = OK; }

// --- Slots ---

// Claims a free slot for a widget of kind k, or returns -1. The search starts
// where the last one ended, so creating and destroying in a loop does not
// rescan the whole table each time.
fn _claim(t as *tst.Tree, k as *tst.Kind) as i64 {
    let is i64 as scanned with mut = 0;
    let is i64 as i with mut = t.next_free;
    while (scanned < t.cap) {
        if (i >= t.cap) { i = 0; }
        let is *tst.Node as n = tst._node(t, i);
        if (n.used == 0) {
            n.used = 1;
            n.kind = k;
            n.parent = 0 - 1;
            n.first = 0 - 1;
            n.last = 0 - 1;
            n.next = 0 - 1;
            n.prev = 0 - 1;
            n.count = 0;
            // A widget nobody has measured yet needs layout by definition.
            n.flags = F_NEEDS_LAYOUT;
            n.item = geom.item_default();
            n.painted = math.rect.rect_zero();
            n.placed = math.rect.rect_zero();
            n.layer = 0;
            n.labelled_by = 0;
            n.group = 0;
            n.overrides = cast(*style.Overrides, 0);
            n.tx = 0.0;
            n.ty = 0.0;
            n.opacity = 1.0;
            if (t.stride > 0) { mem.core.memzero(tst._data_at(t, i), t.stride); }
            t.live = t.live + 1;
            t.next_free = i + 1;
            return i;
        }
        i = i + 1;
        scanned = scanned + 1;
    }
    return 0 - 1;
}

// Runs the kind's destroy, then frees the slot. Bumping the era is what makes
// every handle to it stale.
fn _release(t as *tst.Tree, i as i64) as void {
    let is *tst.Node as n = tst._node(t, i);
    // Where it was is uncovered now. Every node of a destroyed subtree adds its
    // own: a child is normally inside its parent and adds nothing, but not
    // always.
    tdraw.damage_add(t, &n.painted);
    if (n.layer > 0) { t.layered = t.layered - 1; }
    n.layer = 0;
    if (cast(i64, n.kind) != 0 && cast(i64, n.kind.destroy) != 0) {
        call(n.kind.destroy, t, tst._handle(t, i), tst._data_at(t, i));
    }
    n.used = 0;
    n.kind = cast(*tst.Kind, 0);
    n.era = n.era + 1;
    if (n.era == 0) { n.era = 1; }
    t.live = t.live - 1;
}

// Releases i and everything under it, children before parents. Iterative,
// descending through first children and peeling leaves off the front, so a
// deep tree costs no stack and every destroy entry sees its parent alive.
// Children first. Each release starts again from the top: a destroy entry may
// destroy another widget — a text view its menu — which may be the very one
// the walk would have gone on to.
fn _release_subtree(t as *tst.Tree, top as i64) as void {
    while (1 == 1) {
        let is i64 as cur with mut = top;
        while (tst._node(t, cur).first != 0 - 1) { cur = tst._node(t, cur).first; }
        if (cur == top) {
            _release(t, cur);
            return;
        }
        let is i64 as leaf = cur;
        let is i64 as par = tst._node(t, leaf).parent;
        let is i64 as nxt = tst._node(t, leaf).next;
        let is *tst.Node as pn = tst._node(t, par);
        pn.first = nxt;
        pn.count = pn.count - 1;
        if (nxt == 0 - 1) {
            pn.last = 0 - 1;
        } else {
            tst._node(t, nxt).prev = 0 - 1;
        }
        _release(t, leaf);
    }
}

// --- Links ---

fn _link_last(t as *tst.Tree, p as i64, i as i64) as void {
    let is *tst.Node as n = tst._node(t, i);
    let is *tst.Node as pn = tst._node(t, p);
    n.parent = p;
    n.prev = pn.last;
    n.next = 0 - 1;
    if (pn.last != 0 - 1) {
        tst._node(t, pn.last).next = i;
    } else {
        pn.first = i;
    }
    pn.last = i;
    pn.count = pn.count + 1;
}

// Links i under p just before its child b; b of -1 is the end.
fn _link_before(t as *tst.Tree, p as i64, i as i64, b as i64) as void {
    if (b == 0 - 1) { _link_last(t, p, i); return; }
    let is *tst.Node as n = tst._node(t, i);
    let is *tst.Node as pn = tst._node(t, p);
    let is *tst.Node as bn = tst._node(t, b);
    n.parent = p;
    n.next = b;
    n.prev = bn.prev;
    if (bn.prev != 0 - 1) { tst._node(t, bn.prev).next = i; } else { pn.first = i; }
    bn.prev = i;
    pn.count = pn.count + 1;
}

fn _unlink(t as *tst.Tree, i as i64) as void {
    let is *tst.Node as n = tst._node(t, i);
    let is i64 as p = n.parent;
    if (p == 0 - 1) { return; }
    let is *tst.Node as pn = tst._node(t, p);
    if (n.prev != 0 - 1) { tst._node(t, n.prev).next = n.next; } else { pn.first = n.next; }
    if (n.next != 0 - 1) { tst._node(t, n.next).prev = n.prev; } else { pn.last = n.prev; }
    pn.count = pn.count - 1;
    n.parent = 0 - 1;
    n.prev = 0 - 1;
    n.next = 0 - 1;
}

// --- Building the tree ---

// Adds a widget of kind k as the last child of parent. Returns its handle, or
// 0 with last_error() set.
fn create(t as *tst.Tree, k as *tst.Kind, parent as i64) as i64 {
    return create_before(t, k, parent, 0);
}

// The slot of `before` when it is one of p's children, -1 for 0 (the end), and
// -2 — with BAD_ARGUMENT or INVALID_HANDLE set — for anything else.
fn _place_of(t as *tst.Tree, p as i64, before as i64) as i64 {
    if (before == 0) { return 0 - 1; }
    let is i64 as b = tst._index(t, before);
    if (b < 0) { t.err = INVALID_HANDLE; return 0 - 2; }
    if (tst._node(t, b).parent != p) { t.err = BAD_ARGUMENT; return 0 - 2; }
    return b;
}

// The same, just before `before`, one of parent's children; 0 is the end.
// Lists that insert a row, tabs that open beside the current one.
fn create_before(t as *tst.Tree, k as *tst.Kind, parent as i64, before as i64) as i64 {
    if (t.ok == 0) { t.err = BAD_ARGUMENT; return 0; }
    let is i64 as p = tst._index(t, parent);
    if (p < 0) { t.err = INVALID_HANDLE; return 0; }
    let is i64 as b = _place_of(t, p, before);
    if (b == 0 - 2) { return 0; }
    if (k.data_bytes > t.stride) { t.err = DATA_TOO_BIG; return 0; }
    let is i64 as i = _claim(t, k);
    if (i < 0) { t.err = FULL; return 0; }
    _link_before(t, p, i, b);
    _invalidate_from(t, p);
    tlent.notify(t, tst._handle(t, i), WATCH_ADDED);
    return tst._handle(t, i);
}

// Destroys w and everything under it. The root belongs to the tree and is
// refused; a stale handle is ignored, since destroying twice is harmless.
fn destroy(t as *tst.Tree, w as i64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    if (i == t.root) { t.err = BAD_ARGUMENT; return; }
    tlent.notify(t, w, WATCH_REMOVED);
    let is i64 as p = tst._node(t, i).parent;
    // The textures around it still show what is about to go.
    if (p != 0 - 1) { _stale_from(t, p); }
    _unlink(t, i);
    if (p != 0 - 1) { _invalidate_from(t, p); }
    _release_subtree(t, i);
}

// Moves w, with its subtree, to the end of new_parent's children. Refuses to
// move the root, and to move a widget under itself or its own descendant,
// which would detach the subtree into a cycle nothing could reach.
fn reparent(t as *tst.Tree, w as i64, new_parent as i64) as i32 {
    return insert(t, w, new_parent, 0);
}

// Moves w, with its subtree, under parent just before `before` — one of
// parent's children, or 0 for the end. Refused like reparent, and for a
// `before` that is not parent's. Before itself is where it already is.
fn insert(t as *tst.Tree, w as i64, parent as i64, before as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    let is i64 as p = tst._index(t, parent);
    if (i < 0 || p < 0) { t.err = INVALID_HANDLE; return 0; }
    if (i == t.root) { t.err = BAD_ARGUMENT; return 0; }
    let is i64 as a with mut = p;
    while (a != 0 - 1) {
        if (a == i) { t.err = BAD_ARGUMENT; return 0; }
        a = tst._node(t, a).parent;
    }
    let is i64 as b = _place_of(t, p, before);
    if (b == 0 - 2) { return 0; }
    if (b == i) { return 1; }
    let is i64 as old = tst._node(t, i).parent;
    tlent.notify(t, w, WATCH_REMOVED);
    _unlink(t, i);
    _link_before(t, p, i, b);
    if (old != 0 - 1) { _invalidate_from(t, old); }
    _invalidate_from(t, i);
    tlent.notify(t, w, WATCH_ADDED);
    return 1;
}

// Moves w among its siblings, just before `before`; 0 is the end. Reordering
// a list, dragging a tab.
fn move_before(t as *tst.Tree, w as i64, before as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { t.err = INVALID_HANDLE; return 0; }
    let is i64 as p = tst._node(t, i).parent;
    if (p == 0 - 1) { t.err = BAD_ARGUMENT; return 0; }
    return insert(t, w, tst._handle(t, p), before);
}

fn _link(t as *tst.Tree, w as i64, which as i32) as i64 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    let is *tst.Node as n = tst._node(t, i);
    let is i64 as j with mut = n.parent;
    if (which == 1) { j = n.first; }
    if (which == 2) { j = n.last; }
    if (which == 3) { j = n.next; }
    if (which == 4) { j = n.prev; }
    if (j == 0 - 1) { return 0; }
    return tst._handle(t, j);
}

fn parent(t as *tst.Tree, w as i64) as i64       { return _link(t, w, 0); }
fn first_child(t as *tst.Tree, w as i64) as i64  { return _link(t, w, 1); }
fn last_child(t as *tst.Tree, w as i64) as i64   { return _link(t, w, 2); }
fn next_sibling(t as *tst.Tree, w as i64) as i64 { return _link(t, w, 3); }
fn prev_sibling(t as *tst.Tree, w as i64) as i64 { return _link(t, w, 4); }

// Where w is among its siblings, from 0; -1 for the root or a stale handle.
fn index_of(t as *tst.Tree, w as i64) as i64 {
    let is i64 as i = tst._index(t, w);
    if (i < 0 || i == t.root) { return 0 - 1; }
    let is i64 as k with mut = 0;
    let is i64 as c with mut = tst._node(t, i).prev;
    while (c != 0 - 1) {
        k = k + 1;
        c = tst._node(t, c).prev;
    }
    return k;
}

// The child of w at index i, 0 when there is none.
fn child_at(t as *tst.Tree, w as i64, i as i64) as i64 {
    let is i64 as p = tst._index(t, w);
    if (p < 0 || i < 0) { return 0; }
    let is i64 as c with mut = tst._node(t, p).first;
    let is i64 as k with mut = 0;
    while (c != 0 - 1 && k < i) {
        c = tst._node(t, c).next;
        k = k + 1;
    }
    return tst._handle(t, c);
}

fn child_count(t as *tst.Tree, w as i64) as i64 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    return tst._node(t, i).count;
}

fn kind(t as *tst.Tree, w as i64) as *tst.Kind {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return cast(*tst.Kind, 0); }
    return tst._node(t, i).kind;
}

// The widget's data, zeroed at creation; null for a stale handle or a kind
// that asked for none.
fn data(t as *tst.Tree, w as i64) as *u8 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return cast(*u8, 0); }
    if (tst._node(t, i).kind.data_bytes == 0) { return cast(*u8, 0); }
    return tst._data_at(t, i);
}

// The data of w when it is of kind k — what a kind's own functions start
// from. Null for a stale handle; null with last_error WRONG_KIND for a live
// widget of another kind, so that slider.value on a check box says what went
// wrong instead of answering 0 in silence.
fn data_of(t as *tst.Tree, w as i64, k as *tst.Kind) as *u8 {
    return data_of2(t, w, k, k);
}

// The same for a module that makes two kinds sharing one data struct — a
// button and a link, a check box and a radio button.
fn data_of2(t as *tst.Tree, w as i64, k as *tst.Kind, k2 as *tst.Kind) as *u8 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return cast(*u8, 0); }
    let is i64 as have = cast(i64, tst._node(t, i).kind);
    if (have != cast(i64, k) && have != cast(i64, k2)) {
        t.err = WRONG_KIND;
        return cast(*u8, 0);
    }
    if (tst._node(t, i).kind.data_bytes == 0) { return cast(*u8, 0); }
    return tst._data_at(t, i);
}

// --- Visibility and enablement ---
//
// A widget is shown only if it and every ancestor are; the same for enabled.
// Hiding changes how much room the parent hands out, so it invalidates
// layout; disabling changes only how the widget looks and answers.

fn _any_up(t as *tst.Tree, i as i64, bit as i64) as i32 {
    let is i64 as a with mut = i;
    while (a != 0 - 1) {
        if ((tst._node(t, a).flags & bit) != 0) { return 1; }
        a = tst._node(t, a).parent;
    }
    return 0;
}

fn set_visible(t as *tst.Tree, w as i64, on as i32) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    let is *tst.Node as n = tst._node(t, i);
    n.flags = tst._set(n.flags, F_HIDDEN, 1 - on);
    _invalidate_from(t, i);
    tlent.notify(t, w, WATCH_STATE);
}

fn is_visible(t as *tst.Tree, w as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    return 1 - _any_up(t, i, F_HIDDEN);
}

fn set_enabled(t as *tst.Tree, w as i64, on as i32) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    let is *tst.Node as n = tst._node(t, i);
    n.flags = tst._set(n.flags, F_DISABLED, 1 - on);
    // Disabled is inherited, so the whole subtree looks different now.
    invalidate_paint_subtree(t, w);
    tlent.notify(t, w, WATCH_STATE);
}

fn is_enabled(t as *tst.Tree, w as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    return 1 - _any_up(t, i, F_DISABLED);
}

// --- Focus ---
//
// Whether w can take keyboard focus at all. Its own flag only: being hidden,
// disabled or outside a modal scope is the router's business at the moment
// focus moves.
fn set_focusable(t as *tst.Tree, w as i64, on as i32) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    let is *tst.Node as n = tst._node(t, i);
    n.flags = tst._set(n.flags, F_FOCUSABLE, on);
}

// The flags a program sets itself — F_FOCUS_WITHIN_LOOK and F_CACHE — and
// F_CACHE_DIRTY, which damage.cst and paint.cst keep.
fn set_flag(t as *tst.Tree, w as i64, bit as i64, on as i32) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    if (bit != F_FOCUS_WITHIN_LOOK && bit != F_CACHE && bit != F_CACHE_DIRTY) { return; }
    let is *tst.Node as n = tst._node(t, i);
    n.flags = tst._set(n.flags, bit, on);
    if (bit == F_CACHE) {
        n.flags = tst._set(n.flags, F_CACHE_DIRTY, 1);
        _mark_paint(t, i);
    }
}

// Whether node i is painted through a texture of its own: F_CACHE, or
// partly transparent, which needs its subtree composited as one.
fn _textured(t as *tst.Tree, i as i64) as i32 {
    let is *tst.Node as n = tst._node(t, i);
    if ((n.flags & F_CACHE) != 0 || n.opacity < 1.0) { return 1; }
    return 0;
}

fn is_textured(t as *tst.Tree, w as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    return _textured(t, i);
}

// Every texture at or above slot i is stale: each holds the picture of the
// ones inside it.
fn _stale_from(t as *tst.Tree, i as i64) as void {
    let is i64 as a with mut = i;
    while (a != 0 - 1) {
        let is *tst.Node as n = tst._node(t, a);
        if (_textured(t, a) == 1) { n.flags = n.flags | F_CACHE_DIRTY; }
        a = n.parent;
    }
}

// w's texture, if it has one, and every one around it, are to be painted
// again — damage.cst's, when something inside changed.
fn stale_textures(t as *tst.Tree, w as i64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    _stale_from(t, i);
}

fn has_flag(t as *tst.Tree, w as i64, bit as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    if ((tst._node(t, i).flags & bit) != 0) { return 1; }
    return 0;
}

fn is_focusable(t as *tst.Tree, w as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    if ((tst._node(t, i).flags & F_FOCUSABLE) != 0) { return 1; }
    return 0;
}

// --- Layout's per-widget record ---

// The Item layout keeps for w, or null for a stale handle. layout.cst is the
// one that reads and writes it; the tree only stores it.
fn item(t as *tst.Tree, w as i64) as *geom.Item {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return cast(*geom.Item, 0); }
    let is *tst.Node as n = tst._node(t, i);
    return &n.item;
}

// --- Layout invalidation ---
//
// A widget that changes size can change every ancestor's, so the mark climbs
// to the root. It does not stop at an ancestor already marked: a layout pass
// that clears top-down may have left a marked node under a cleared one, and
// stopping early there would leave the root believing nothing changed.

// Whatever is marked also loses its cached measure: the cache answered for a
// widget that has since changed, or whose descendants have.
fn _invalidate_from(t as *tst.Tree, i as i64) as void {
    // A layout pass may move anything, and damage.cst finds what moved.
    t.paint_wanted = 1;
    let is i64 as a with mut = i;
    while (a != 0 - 1) {
        let is *tst.Node as n = tst._node(t, a);
        n.flags = n.flags | F_NEEDS_LAYOUT;
        n.item.cache_ok = 0;
        a = n.parent;
    }
}

// Marks w, every descendant and every ancestor. For a change that alters how
// a whole subtree lays out — the writing direction — rather than one widget's
// size: a descendant left clean would keep its old arrangement.
fn invalidate_subtree(t as *tst.Tree, w as i64) as void {
    let is i64 as top = tst._index(t, w);
    if (top < 0) { return; }
    _invalidate_from(t, top);
    let is i64 as cur with mut = tst._node(t, top).first;
    while (cur != 0 - 1) {
        let is *tst.Node as n = tst._node(t, cur);
        n.flags = n.flags | F_NEEDS_LAYOUT;
        n.item.cache_ok = 0;
        // Depth-first without a stack: down to the first child, else across,
        // else back up until an ancestor below top has a next sibling.
        if (n.first != 0 - 1) {
            cur = n.first;
        } else {
            let is i64 as up with mut = cur;
            cur = 0 - 1;
            while (up != top && cur == 0 - 1) {
                if (tst._node(t, up).next != 0 - 1) {
                    cur = tst._node(t, up).next;
                } else {
                    up = tst._node(t, up).parent;
                }
            }
        }
    }
}

fn invalidate_layout(t as *tst.Tree, w as i64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    _invalidate_from(t, i);
    tlent.notify(t, w, WATCH_CHANGED);
}

fn needs_layout(t as *tst.Tree, w as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    if ((tst._node(t, i).flags & F_NEEDS_LAYOUT) != 0) { return 1; }
    return 0;
}

fn clear_layout(t as *tst.Tree, w as i64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    let is *tst.Node as n = tst._node(t, i);
    n.flags = tst._set(n.flags, F_NEEDS_LAYOUT, 0);
}

// --- Paint invalidation ---
//
// Marking a widget repaints it when damage.cst next collects — which is after
// layout, so a widget that both changed and moved repaints both places. A widget that only moved, or was
// hidden, shown or reparented, needs no mark: collecting compares every
// rectangle with where it was painted, and invalidating its layout already
// said there is something to collect. Destroying is the exception, done in
// _release: once the node is gone there is nothing left to compare.

fn _mark_paint(t as *tst.Tree, i as i64) as void {
    let is *tst.Node as n = tst._node(t, i);
    n.flags = n.flags | F_NEEDS_PAINT;
    t.paint_wanted = 1;
}

fn invalidate_paint(t as *tst.Tree, w as i64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    _mark_paint(t, i);
    tlent.notify(t, w, WATCH_CHANGED);
}

// w and everything under it — for a change every descendant shows, such as
// being disabled.
fn invalidate_paint_subtree(t as *tst.Tree, w as i64) as void {
    let is i64 as top = tst._index(t, w);
    if (top < 0) { return; }
    _mark_paint(t, top);
    let is i64 as cur with mut = tst._node(t, top).first;
    while (cur != 0 - 1) {
        _mark_paint(t, cur);
        let is *tst.Node as n = tst._node(t, cur);
        if (n.first != 0 - 1) {
            cur = n.first;
        } else {
            let is i64 as up with mut = cur;
            cur = 0 - 1;
            while (up != top && cur == 0 - 1) {
                if (tst._node(t, up).next != 0 - 1) {
                    cur = tst._node(t, up).next;
                } else {
                    up = tst._node(t, up).parent;
                }
            }
        }
    }
}

fn needs_paint(t as *tst.Tree, w as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    if ((tst._node(t, i).flags & F_NEEDS_PAINT) != 0) { return 1; }
    return 0;
}

fn clear_paint(t as *tst.Tree, w as i64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    let is *tst.Node as n = tst._node(t, i);
    n.flags = tst._set(n.flags, F_NEEDS_PAINT, 0);
}

// Its own disabled flag, ancestors aside; painting walks down and carries
// theirs.
fn is_enabled_here(t as *tst.Tree, w as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    if ((tst._node(t, i).flags & F_DISABLED) != 0) { return 0; }
    return 1;
}

// Its own hidden flag, ancestors aside; damage.cst walks down and carries
// theirs.
fn is_hidden_here(t as *tst.Tree, w as i64) as i32 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 1; }
    if ((tst._node(t, i).flags & F_HIDDEN) != 0) { return 1; }
    return 0;
}

fn painted(t as *tst.Tree, w as i64) as math.rect.Rect {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return math.rect.rect_zero(); }
    return tst._node(t, i).painted;
}

fn placed(t as *tst.Tree, w as i64) as math.rect.Rect {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return math.rect.rect_zero(); }
    return tst._node(t, i).placed;
}

// Where w was laid out, and the part of that on screen.
fn set_painted(t as *tst.Tree, w as i64, at as math.rect.Rect, shown as math.rect.Rect) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    tst._node(t, i).placed = at;
    tst._node(t, i).painted = shown;
}

// --- Layers ---
//
// A widget on a layer above 0 — a popup drawn inside the window, a drag's
// image, a toast — is drawn above everything on lower layers wherever it sits
// in the tree, and is not clipped by its ancestors: it may reach past its
// parent's edge, as a dropdown below its button does. Hit-testing looks at it
// first. Its subtree is on its layer, or a higher one of its own.

fn set_layer(t as *tst.Tree, w as i64, layer as i64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0 || i == t.root || layer < 0) { return; }
    let is *tst.Node as n = tst._node(t, i);
    if (n.layer == layer) { return; }
    if (n.layer > 0) { t.layered = t.layered - 1; }
    if (layer > 0) { t.layered = t.layered + 1; }
    n.layer = layer;
    // Where it was drawn under the old clip, and the whole of it under the new.
    tdraw.damage_add(t, &n.painted);
    _mark_paint(t, i);
    n.placed = math.rect.rect_zero();
    // On a layer it floats: what holds it measures without it.
    invalidate_layout(t, w);
}

// --- What the application lends ---
//
// The text service (ui/text.cst) every widget that shows text lays it out
// with: one per application, so a form of fifty labels holds one shaper.
// Kept as a bare pointer so that the tree, which every widget imports, does
// not bring the text stack into programs that show none; a widget has it
// typed from text.of, and lends it with text.lend. Setting it measures
// every widget again.
fn set_text_service(t as *tst.Tree, s as *u8) as void {
    if (t.ok == 0) { return; }
    t.text = s;
    invalidate_subtree(t, root(t));
    invalidate_paint_subtree(t, root(t));
}

// th must outlive the tree, or be replaced first; null goes back to the
// default. Setting the same pointer again says its contents changed.
fn set_theme(t as *tst.Tree, th as *style.Theme) as void {
    if (t.ok == 0) { return; }
    t.theme = th;
    invalidate_subtree(t, root(t));
    invalidate_paint_subtree(t, root(t));
}

// Lays o over the theme for w and everything under it; null removes it. The
// program owns o and keeps it alive while it is set; setting the same pointer
// again says its contents changed. The nearest override to a widget is applied
// last, over those further up.
fn set_overrides(t as *tst.Tree, w as i64, o as *style.Overrides) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    tst._node(t, i).overrides = o;
    invalidate_subtree(t, w);
    invalidate_paint_subtree(t, w);
}

// From 0, not drawn, to 1, opaque; outside that, the nearer end.
fn set_opacity(t as *tst.Tree, w as i64, a as f64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    let is f64 as v with mut = a;
    if (v < 0.0) { v = 0.0; }
    if (v > 1.0) { v = 1.0; }
    let is *tst.Node as n = tst._node(t, i);
    if (n.opacity == v) { return; }
    // Becoming translucent needs its subtree painted into a texture first;
    // after that a fade only changes how the texture is put back, so the
    // place is repainted without marking anything in it changed. The
    // textures around it show it, though. Where nothing of it is on screen
    // there is nothing to repaint, and no frame asked for.
    if (n.opacity >= 1.0) { n.flags = n.flags | F_CACHE_DIRTY; }
    n.opacity = v;
    if (n.parent != 0 - 1) { _stale_from(t, n.parent); }
    tdraw.damage_add(t, &n.painted);
}

// --- Walking the tree ---
fn is_valid(t as *Tree, w as i64) as i32 { return tst.is_valid(t, w); }

// Adds r to what has to be repainted. One that overlaps or borders another is
// merged with it — a rectangle already covered merges into the one covering
// it, unchanged — and the merge repeated while the result reaches others;
// when the region is full, it goes into whichever rectangle it enlarges
// least.
fn damage_add(t as *Tree, r as *math.rect.Rect) as void { tdraw.damage_add(t, r); }

// Keeps only what lies inside r — the window, at collection.
fn damage_clip(t as *Tree, r as math.rect.Rect) as void { tdraw.damage_clip(t, r); }
fn damage_count(t as *Tree) as i64 { return tdraw.damage_count(t); }
fn damage_at(t as *Tree, i as i64) as math.rect.Rect { return tdraw.damage_at(t, i); }

// Whether anything may need repainting: damage added, a widget marked, a
// layout invalidated, a widget destroyed. Painting an idle window is skipped
// on this.
fn paint_wanted(t as *Tree) as i32 { return tdraw.paint_wanted(t); }

// For a change the tree cannot see: layout moved something, a scale changed.
fn want_paint(t as *Tree) as void { tdraw.want_paint(t); }

// After the frame is presented: nothing is owed any more.
fn damage_clear(t as *Tree) as void { tdraw.damage_clear(t); }

// The caret of w — the widget text is typed into — blinked: drawn again
// where it is when the frame is collected, as w's kind says (Kind.caret), or
// all of w when it says nothing. A blink costs its caret, not its text.
fn blink(t as *Tree, w as i64) as void { tdraw.blink(t, w); }

// The widget whose caret blinked since the last frame; 0 for none.
fn blinked(t as *Tree) as i64 { return tdraw.blinked(t); }

// Whether the window the tree is drawn in moves pixels as shift says before
// painting the damage over them — as ui/host.cst does. Off, as a tree
// starts: a scroll area's ask is never taken, and what moved is painted.
fn set_moves(t as *Tree, on as i32) as void { tdraw.set_moves(t, on); }
fn moves(t as *Tree) as i32 { return tdraw.moves(t); }

// Widget w's content moved dx, dy, logical pixels: the pixels of keep — in
// w's own coordinates, what of it shows the content, not its bars — may be
// moved rather than painted again. Asked again by w before the frame, the
// moves add up; asked by another, neither is moved.
fn shift_request(t as *Tree, w as i64, dx as f64, dy as f64, keep as *math.rect.Rect) as void { tdraw.shift_request(t, w, dx, dy, keep); }

// The widget whose ask damage.collect is to weigh, with how far and what
// may move; 0 when none asked, or more than one did.
fn shift_asked(t as *Tree, dx as *f64, dy as *f64, keep as *math.rect.Rect) as i64 { return tdraw.shift_asked(t, dx, dy, keep); }

// damage.collect's answer: the window's rectangle at to be moved, or none.
fn set_shifted(t as *Tree, ok as i32, at as math.rect.Rect) as void { tdraw.set_shifted(t, ok, at); }

// After collect: 1 when the pixels of *r — window coordinates, logical
// pixels — are to be moved dx, dy before the damage is painted over them.
fn shift(t as *Tree, r as *math.rect.Rect, dx as *f64, dy as *f64) as i32 { return tdraw.shift(t, r, dx, dy); }

// Whether any widget is on a layer above 0, shown or not.
fn has_layered(t as *Tree) as i32 { return tdraw.has_layered(t); }
fn layer(t as *Tree, w as i64) as i64 { return tdraw.layer(t, w); }

// How many widgets are on a layer above 0; with none, painting and
// hit-testing skip looking for them.
fn layered_count(t as *Tree) as i64 { return tdraw.layered_count(t); }
fn text_service(t as *Tree) as *u8 { return tlent.text_service(t); }

// The window's animator (anim.cst), for widgets that move on their own — a
// switch's knob sliding, a progress bar's pulse. A bare pointer for the same
// reason as the text service: anim.cst imports the tree. Typed through
// anim.of and anim.lend.
fn set_animator(t as *Tree, a as *u8) as void { tlent.set_animator(t, a); }
fn animator(t as *Tree) as *u8 { return tlent.animator(t); }

// The application's timers (timer.cst), for widgets that act after a pause —
// a menu opening a submenu the pointer rests on. A bare pointer like the
// animator, typed through timer.of and timer.lend. Null: no pause, act at
// once.
fn set_timers(t as *Tree, ts as *u8) as void { tlent.set_timers(t, ts); }
fn timers(t as *Tree) as *u8 { return tlent.timers(t); }

// The window's router (router.cst), for a widget that opens a popup of its
// own — an entry its context menu — which takes the window's input while it
// is open. A bare pointer: the router imports the tree. Typed through
// router.of and router.lend. Null: no popups.
fn set_router(t as *Tree, r as *u8) as void { tlent.set_router(t, r); }
fn router(t as *Tree) as *u8 { return tlent.router(t); }

// --- The focus a widget asks for ---
//
// A widget's event entry gets the tree, not the router, yet some must move
// the focus: arrows within a group of radio buttons. It asks here, and the
// router gives the focus once the event is delivered, by keyboard or by
// pointer as the event was, when the widget can take it. The last asked for
// wins; 0 takes the request back.
fn request_focus(t as *Tree, w as i64) as void { tlent.request_focus(t, w); }
fn focus_request(t as *Tree) as i64 { return tlent.focus_request(t); }

// The focus asked for, and no longer.
fn take_focus_request(t as *Tree) as i64 { return tlent.take_focus_request(t); }
fn set_clipboard(t as *Tree, cb as ClipboardFn, user as *u8) as void { tlent.set_clipboard(t, cb, user); }

// n bytes of UTF-8 at text to which, CLIPBOARD or PRIMARY; the program
// copies them before it returns. Nothing without a function set.
fn copy(t as *Tree, which as i32, text as *u8, n as i64) as void { tlent.copy(t, which, text, n); }

// Text a widget wants pasted is asked of the program, which fetches it —
// a clipboard answers when it answers — and hands it to the router
// (router.paste), which gives it to the widget as PASTE.
fn set_paste(t as *Tree, cb as PasteFn, user as *u8) as void { tlent.set_paste(t, cb, user); }

// w wants the text of which, CLIPBOARD or PRIMARY. Nothing without a
// function set.
fn request_paste(t as *Tree, which as i32, w as i64) as void { tlent.request_paste(t, which, w); }

// --- Where text is typed ---
//
// The widget text is being typed into says where its caret is, in the
// window: the input method puts its candidates there (an X input method's
// spot, text-input-v3's cursor rectangle, IMM32's composition window), and
// knows text input is on. The widget says 0 when it no longer takes text.
fn set_text_area(t as *Tree, w as i64, r as math.rect.Rect) as void { tlent.set_text_area(t, w, r); }

// The widget text is typed into, 0 for none — also once it is gone.
fn text_area(t as *Tree) as i64 { return tlent.text_area(t); }
fn text_area_rect(t as *Tree) as math.rect.Rect { return tlent.text_area_rect(t); }

// A widget whose caret left the input method's composition — a click, a
// key, its text set — gives the composition up, and the input method has
// to as well: what it committed next would be what was given up. The
// program passes it on to the platform (XmbResetIC, text-input-v3's state
// committed again, ImmNotifyIME's CPS_CANCEL).
fn set_ime_reset(t as *Tree, cb as ImeResetFn, user as *u8) as void { tlent.set_ime_reset(t, cb, user); }

// w gave its composition up. Nothing without a function set.
fn reset_ime(t as *Tree, w as i64) as void { tlent.reset_ime(t, w); }

// What the window does when a widget asks — moved, maximized, its menu —
// the program passing it on to the platform (_NET_WM_MOVERESIZE,
// xdg_toplevel.move, WM_NCLBUTTONDOWN...).
fn set_window_ops(t as *Tree, cb as WindowOpFn, user as *u8) as void { tlent.set_window_ops(t, cb, user); }

// A widget asks the window for op, at window x, y. 1 if someone was there
// to ask.
fn window_op(t as *Tree, op as i32, x as f64, y as f64) as i32 { return tlent.window_op(t, op, x, y); }

// Who keeps the window this tree is in — the application — and how it names
// the window, for what a widget asks of it: a window of its own for a dialog,
// shown or hidden (HOST_*).
// Who watches the tree change: told of every widget made, moved, destroyed,
// changed or focused (WATCH_*). Null, as a tree starts: nobody, nothing told.
fn set_watch(t as *Tree, cb as WatchFn, user as *u8) as void { tlent.set_watch(t, cb, user); }

// Whoever watches told what happened to w.
fn notify(t as *Tree, w as i64, what as i32) as void { tlent.notify(t, w, what); }

// Whoever watches told w's text changed: n bytes of s in at at, or out —
// TEXT_INSERTED or TEXT_DELETED. A widget that tells this of every change
// says so (TextQuery.tells), and its watcher need not read its text again.
fn notify_text(t as *Tree, w as i64, what as i64, at as i64, s as *u8, n as i64) as void { tlent.notify_text(t, w, what, at, s, n); }

// The language its widgets speak their own words in: a language of
// ui/strings.cst. Set before the widgets are made: what they already say
// stays as it was.
fn set_language(t as *Tree, lang as i32) as void { tlent.set_language(t, lang); }
fn language(t as *Tree) as i32 { return tlent.language(t); }

// The change being told, while WATCH_TEXT is; null otherwise.
fn text_change(t as *Tree) as *TextChange { return tlent.text_change(t); }
fn set_host(t as *Tree, cb as HostFn, user as *u8, window as i64) as void { tlent.set_host(t, cb, user, window); }

// How the application names this tree's window, 0 for none: a window closed
// and its slot taken again is named anew, so a widget holding on to another
// tree can tell it is still the one it knew.
fn host_id(t as *Tree) as i64 { return tlent.host_id(t); }

// A widget asks op of the application, with arg: its answer, or 0 with no one
// there to ask.
fn ask_host(t as *Tree, op as i32, arg as i64) as i64 { return tlent.ask_host(t, op, arg); }

// --- Which widget names which ---
//
// A widget with no text of its own — an entry, a slider — is named by the
// label beside it: assistive technology reads the label's text as its name
// (access.cst), and the label's mnemonic moves focus to it.

// label names w from now on; 0 for none.
fn set_labelled_by(t as *Tree, w as i64, label as i64) as void { tlent.set_labelled_by(t, w, label); }

// w one of the widgets of Tab group g — any number but 0, the same for all
// of them; 0 for none. A group is one stop for Tab: a radio group, a
// toolbar's buttons. Its widgets keep one of them focusable, the stop; when
// that one cannot take the focus — disabled — Tab gives it to the first of
// the group that can, and the stop moves there (router.focus_next).
fn set_tab_group(t as *Tree, w as i64, g as i64) as void { tlent.set_tab_group(t, w, g); }
fn tab_group(t as *Tree, w as i64) as i64 { return tlent.tab_group(t, w); }

// The widget that names w, or 0 — also once that widget is gone.
fn labelled_by(t as *Tree, w as i64) as i64 { return tlent.labelled_by(t, w); }
fn theme(t as *Tree) as *style.Theme { return tlent.theme(t); }
fn overrides(t as *Tree, w as i64) as *style.Overrides { return tlent.overrides(t, w); }

// --- Where a widget is drawn, and how much of it ---
//
// Translation moves a widget and everything under it from where layout put
// it: painted there, hit there, its rectangle in the window there — and laid
// out exactly as before, which is what lets an animation slide something
// without measuring anything again. Opacity fades the widget and its subtree
// as one picture, composited through a texture of its own (paint.cst's
// cache): a translucent subtree is not each widget translucent, which would
// show the widgets behind one another through it. At 0 nothing of it is
// drawn; it is still there, and still hit.
fn set_translation(t as *Tree, w as i64, x as f64, y as f64) as void { tdraw.set_translation(t, w, x, y); }
fn translation_x(t as *Tree, w as i64) as f64 { return tdraw.translation_x(t, w); }
fn translation_y(t as *Tree, w as i64) as f64 { return tdraw.translation_y(t, w); }
fn opacity(t as *Tree, w as i64) as f64 { return tdraw.opacity(t, w); }
