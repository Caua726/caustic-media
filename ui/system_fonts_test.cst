// ui/system_fonts_test.cst — the text service's fonts from an index of
// font files: a chain for each family, weight and style asked, kept. Over
// the test fonts in text/testdata/fonts rather than this machine's; run from
// the repository's root.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "../text/fonts/chain.cst" as chain;
use "../text/fonts/index.cst" as index;
use "../text/layout/font.cst" as font;
use "system_fonts.cst" as system_fonts;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn ends(a as *u8, b as *u8) as i32 {
    let is i64 as na = _len(a);
    let is i64 as nb = _len(b);
    if (na < nb) { return 0; }
    return cast(i32, mem.memcmp(cast(*u8, cast(i64, a) + na - nb), b, nb) == 0);
}

let is system_fonts.Fonts as sf with mut;

// Whether f draws cp from the file whose name ends with tail.
fn draws(f as *font.Font, cp as i64, tail as *u8) as i32 {
    if (cast(i64, f) == 0) { return 0; }
    let is i64 as m = font.find(f, cp);
    if (m < 0) { return 0; }
    let is *chain.Chain as ch = cast(*chain.Chain, f.user);
    let is *u8 as path = index.path_of(system_fonts.index_of(&sf), chain.member(ch, m).face);
    if (ends(path, tail) == 0) {
        io.printf("  U+%x from %s\n", cp, path);
        return 0;
    }
    return 1;
}

fn main() as i32 {
    check("nothing there: no fonts", system_fonts.open_dir(&sf, "text/testdata/nowhere") == 0 &&
          cast(i64, system_fonts.resolve(cast(*u8, &sf), "Caustic Test Sans", 400, 0)) == 0);
    system_fonts.close(&sf);

    check("the test fonts", system_fonts.open_dir(&sf, "text/testdata/fonts") == 1);
    let is chain.Prefs as p with mut = chain.defaults();
    p.sans = "Caustic Test Sans";
    p.mono = "Caustic Test Mono";
    p.ui = "Caustic Test Sans";
    system_fonts.set_prefs(&sf, &p);
    let is *u8 as u = cast(*u8, &sf);

    let is *font.Font as regular = system_fonts.resolve(u, "Caustic Test Sans", 400, 0);
    check("a family: its regular face", draws(regular, 65, "TestSans-Regular.ttf") == 1);
    check("asked again: the same, nothing opened", system_fonts.resolve(u, "Caustic Test Sans", 400, 0) == regular &&
          system_fonts.count(&sf) == 1);
    let is *font.Font as bold = system_fonts.resolve(u, "Caustic Test Sans", 700, 0);
    check("bold: another, its bold face", bold != regular && draws(bold, 65, "TestSans-Bold.TTF") == 1 && system_fonts.count(&sf) == 2);
    let is *font.Font as italic = system_fonts.resolve(u, "Caustic Test Sans", 400, 1);
    check("italic: another, its italic face", italic != regular && italic != bold && draws(italic, 65, "TestSans-Italic.ttf") == 1);
    let is *font.Font as both = system_fonts.resolve(u, "Caustic Test Sans", 700, 1);
    check("bold italic", draws(both, 65, "TestSans-BoldItalic.ttf") == 1 && system_fonts.count(&sf) == 4);
    let is *font.Font as ui = system_fonts.resolve(u, cast(*u8, 0), 400, 0);
    check("no family: the interface's, as preferred", draws(ui, 65, "TestSans-Regular.ttf") == 1 && ui != regular);
    check("no family again: the same", system_fonts.resolve(u, cast(*u8, 0), 400, 0) == ui);
    let is *font.Font as list = system_fonts.resolve(u, "Caustic Test Nothing, monospace", 400, 0);
    check("a list: the first that is there", draws(list, 65, "TestMono.ttf") == 1);
    let is *font.Font as other = system_fonts.resolve(u, "Caustic Test Sans ", 400, 0);
    check("a name told apart to its last byte", other != regular);
    check("one that begins another kept: its own", system_fonts.resolve(u, "Caustic Test Nothing", 400, 0) != list);
    let is i64 as before0 = system_fonts.count(&sf);
    check("a weight of 0: a chain of its own", cast(i64, system_fonts.resolve(u, cast(*u8, 0), 0, 0)) != 0 &&
          system_fonts.count(&sf) == before0 + 1);
    // A name as long as is kept: its own.
    let is [128]u8 as longest;
    mem.memset(cast(*u8, &longest), 121, 127);
    longest[127] = cast(u8, 0);
    let is i64 as before127 = system_fonts.count(&sf);
    check("a name of 127 bytes: kept as it is", system_fonts.resolve(u, cast(*u8, &longest), 400, 0) != ui &&
          system_fonts.count(&sf) == before127 + 1);

    // A name longer than kept: the interface's.
    let is [300]u8 as long;
    let is i64 as i with mut = 0;
    while (i < 299) {
        long[i] = cast(u8, 120);
        i = i + 1;
    }
    long[299] = cast(u8, 0);
    let is i64 as before = system_fonts.count(&sf);
    check("a name too long: the interface's", system_fonts.resolve(u, cast(*u8, &long), 400, 0) == ui &&
          system_fonts.count(&sf) == before);

    // Full: what is asked after is the first one's.
    let is i64 as w with mut = 100;
    while (system_fonts.count(&sf) < system_fonts.MAX_CHAINS && w < 100 + system_fonts.MAX_CHAINS * 10) {
        system_fonts.resolve(u, "Caustic Test Sans", w, 0);
        w = w + 10;
    }
    check("filled", system_fonts.count(&sf) == system_fonts.MAX_CHAINS);
    check("full: the first", system_fonts.resolve(u, "Caustic Test Mono", 900, 1) == regular &&
          system_fonts.count(&sf) == system_fonts.MAX_CHAINS);
    check("full: one already there still itself", system_fonts.resolve(u, "Caustic Test Sans", 700, 0) == bold);
    system_fonts.close(&sf);
    check("closed: none", system_fonts.count(&sf) == 0);

    if (fails == 0) {
        io.printf("ui system fonts: all checks passed\n");
        return 0;
    }
    io.printf("ui system fonts: %d failures\n", fails);
    return 1;
}
