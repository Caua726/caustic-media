// ui/ui.cst — hub for the toolkit.
//
//   use "caustic-media/ui/ui.cst" as ui;
//
//   let is i64 as save = ui.button(t, row, "_Save");
//   ui.on(t, save, ui.signal.CLICKED, fn_ptr(on_save));
//   ui.button.set_default(t, r, save);
//
// One use for the whole toolkit: every module is reached through it by its
// own name — ui.tree.Tree, ui.box.create, ui.entry.text — and the widgets a
// program makes from words have a form here that takes the words alone, a
// zero-terminated string, where the module's own takes them with their length
// in bytes. The module's form stays the one for text that is not a literal: a
// slice of a buffer, what an entry holds.
//
// A form here and the module share a name where the form is the module's
// usual constructor (ui.button makes a button, ui.button.link a link); the
// rest are named for what they add (ui.menu_item, ui.tab, ui.column).
//
// Immediate mode is not here: it is the other model (immediate/immediate.md),
// and a program takes one or the other.
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "box.cst" as box;
use "grid.cst" as grid;
use "stack.cst" as stack;
use "scroll.cst" as scroll;
use "splitter.cst" as splitter;
use "popup.cst" as popup;
use "event.cst" as event;
use "router.cst" as router;
use "timer.cst" as timer;
use "signal.cst" as signal;
use "model.cst" as model;
use "flatten.cst" as flatten;
use "sortmodel.cst" as sortmodel;
use "dirmodel.cst" as dirmodel;
use "damage.cst" as damage;
use "paint.cst" as paint;
use "painter.cst" as painter;
use "style.cst" as style;
use "system.cst" as system;
use "text.cst" as text;
use "textbuf.cst" as textbuf;
use "access.cst" as access;
use "anim.cst" as anim;
use "dnd.cst" as dnd;
use "strings.cst" as strings;
use "icons.cst" as icons;
use "icon_theme.cst" as icon_theme;
use "app.cst" as app;
use "host.cst" as host;
use "program.cst" as program;
use "session.cst" as session;
use "desktop.cst" as desktop;
use "system_fonts.cst" as system_fonts;
use "instance.cst" as instance;
use "notify.cst" as notify;
use "tray.cst" as tray;
use "open_uri.cst" as open_uri;
use "winstate.cst" as winstate;
use "widgets/label.cst" as label;
use "widgets/image.cst" as image;
use "widgets/button.cst" as button;
use "widgets/check.cst" as check;
use "widgets/switch.cst" as switch;
use "widgets/slider.cst" as slider;
use "widgets/progress.cst" as progress;
use "widgets/spin.cst" as spin;
use "widgets/separator.cst" as separator;
use "widgets/group.cst" as group;
use "widgets/expander.cst" as expander;
use "widgets/tooltip.cst" as tooltip;
use "widgets/entry.cst" as entry;
use "widgets/textedit.cst" as textedit;
use "widgets/textview.cst" as textview;
use "widgets/menu.cst" as menu;
use "widgets/menubar.cst" as menubar;
use "widgets/menubutton.cst" as menubutton;
use "widgets/tabs.cst" as tabs;
use "widgets/toolbar.cst" as toolbar;
use "widgets/statusbar.cst" as statusbar;
use "widgets/titlebar.cst" as titlebar;
use "widgets/decoration.cst" as decoration;
use "widgets/assistant.cst" as assistant;
use "widgets/listview.cst" as listview;
use "widgets/treeview.cst" as treeview;
use "widgets/tableview.cst" as tableview;
use "widgets/combo.cst" as combo;
use "widgets/dialog.cst" as dialog;
