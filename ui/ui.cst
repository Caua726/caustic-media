use "widgets/colorpicker.cst" as colorpicker;
use "widgets/fontpicker.cst" as fontpicker;
use "widgets/about.cst" as about;

// The length in bytes of a zero-terminated string; 0 for null.
fn len(s as *u8) as i64 {
    if (cast(i64, s) == 0) { return 0; }
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

// connect with no user pointer.
fn on(t as *tree.Tree, w as i64, sig as i32, cb as tree.SignalFn) as i64 {
    return signal.on(t, w, sig, cb);
}

// --- Words ---
//
// Each as its module's form with the length taken; a mnemonic's underscore
// wherever the module's form takes one, bound by itself (label.cst).

// A label of plain text: an underscore in it is shown.
fn label(t as *tree.Tree, parent as i64, s as *u8) as i64 {
    return label.create(t, parent, s, len(s));
}

// A label naming another widget, its mnemonic going to it: "_Name" before
// an entry.
fn label_for(t as *tree.Tree, parent as i64, s as *u8, target as i64) as i64 {
    let is i64 as l = label.create(t, parent, "", 0);
    if (l == 0) { return 0; }
    label.set_text_mnemonic(t, l, s, len(s));
    label.set_target(t, l, target);
    return l;
}

fn button(t as *tree.Tree, parent as i64, s as *u8) as i64 {
    return button.create(t, parent, s, len(s));
}

fn link(t as *tree.Tree, parent as i64, s as *u8, uri as *u8) as i64 {
    return button.link(t, parent, s, len(s), uri);
}

fn check(t as *tree.Tree, parent as i64, s as *u8) as i64 {
    return check.create(t, parent, s, len(s));
}

// A radio button: in the group of the radio button group, or the first of a
// new one when group is 0.
fn radio(t as *tree.Tree, parent as i64, s as *u8, group as i64) as i64 {
    return check.radio(t, parent, s, len(s), group);
}

fn group(t as *tree.Tree, parent as i64, s as *u8) as i64 {
    return group.create(t, parent, s, len(s));
}

fn expander(t as *tree.Tree, parent as i64, s as *u8) as i64 {
    return expander.create(t, parent, s, len(s));
}

fn menubutton(t as *tree.Tree, parent as i64, s as *u8) as i64 {
    return menubutton.create(t, parent, s, len(s));
}

// A page of tabs w, titled s: the widget to put the page's content in.
fn tab(t as *tree.Tree, w as i64, s as *u8) as i64 {
    return tabs.add(t, w, s, len(s));
}

fn menu_item(t as *tree.Tree, m as i64, s as *u8, id as i64) as i64 {
    return menu.add_item(t, m, s, len(s), id);
}

fn menu_check(t as *tree.Tree, m as i64, s as *u8, id as i64, on as i32) as i64 {
    return menu.add_check(t, m, s, len(s), id, on);
}

fn menu_radio(t as *tree.Tree, m as i64, s as *u8, id as i64, group as i64, on as i32) as i64 {
    return menu.add_radio(t, m, s, len(s), id, group, on);
}

fn submenu(t as *tree.Tree, m as i64, s as *u8) as i64 {
    return menu.add_submenu(t, m, s, len(s));
}

// Menu m on the menu bar, titled s.
fn menu_title(t as *tree.Tree, bar as i64, s as *u8, m as i64) as i64 {
    return menubar.add(t, bar, s, len(s), m);
}

fn tool_button(t as *tree.Tree, bar as i64, s as *u8) as i64 {
    return toolbar.add_button(t, bar, s, len(s));
}

fn tool_toggle(t as *tree.Tree, bar as i64, s as *u8) as i64 {
    return toolbar.add_toggle(t, bar, s, len(s));
}

fn column(t as *tree.Tree, table as i64, s as *u8, width as f64) as i64 {
    return tableview.add_column(t, table, s, len(s), width);
}

fn dialog(t as *tree.Tree, title as *u8) as i64 {
    return dialog.create(t, title, len(title));
}

fn dialog_button(t as *tree.Tree, d as i64, s as *u8, response as i64) as i64 {
    return dialog.add_button(t, d, s, len(s), response);
}

// A message box: kind dialog.INFO, QUESTION, WARNING or ERROR; buttons
// dialog.OK_ONLY and the rest.
fn message(t as *tree.Tree, kind as i32, title as *u8, say as *u8, buttons as i32) as i64 {
    return dialog.message(t, kind, title, len(title), say, len(say), buttons);
}

fn file_chooser(t as *tree.Tree, mode as i32, title as *u8) as i64 {
    return filechooser.create(t, mode, title, len(title));
}

// A filter of the file chooser named s, its patterns parted by semicolons —
// "*.txt;*.md" — where the module's add_filter takes them parted by zeros.
fn file_filter(t as *tree.Tree, fc as i64, s as *u8, patterns as *u8) as i64 {
    let is [256]u8 as p with mut;
    let is i64 as n = len(patterns);
    if (n > 255) { return 0 - 1; }
    let is i64 as i with mut = 0;
    while (i < n) {
        p[i] = patterns[i];
        if (patterns[i] == 59) { p[i] = cast(u8, 0); }
        i = i + 1;
    }
    return filechooser.add_filter(t, fc, s, len(s), cast(*u8, &p), n);
}

fn placeholder(t as *tree.Tree, w as i64, s as *u8) as i32 {
    return entry.set_placeholder(t, w, s, len(s));
}

fn tip(tt as *tooltip.Tooltips, w as i64, s as *u8) as i32 {
    return tooltip.set(tt, w, s, len(s));
}

// A cell's text, from a model's cell function.
fn cell_text(s as *u8) as model.Value {
    return model.text(s, len(s));
}

// What w shows: a label's text, plain; an entry's or a text view's, as if
// set by the program; a button's, a check box's or a radio button's words,
// a mnemonic's underscore marked. 1, or 0 for a widget of another kind —
// with the tree's last error WRONG_KIND — or no room.
fn set_text(t as *tree.Tree, w as i64, s as *u8) as i32 {
    let is *tree.Kind as k = tree.kind(t, w);
    if (cast(i64, k) == 0) { return 0; }
    let is i64 as n = len(s);
    if (_named(k, "label") == 1) { return label.set_text(t, w, s, n); }
    if (_named(k, "entry") == 1) { return entry.set_text(t, w, s, n); }
    if (_named(k, "textview") == 1) { return textview.set_text(t, w, s, n); }
    let is i64 as c with mut = 0;
    if (_named(k, "button") == 1 || _named(k, "link") == 1) { c = button.content(t, w); }
    if (_named(k, "check") == 1 || _named(k, "radio") == 1) { c = check.content(t, w); }
    if (c != 0 && cast(i64, tree.kind(t, c)) == cast(i64, label.kind())) {
        return label.set_text_mnemonic(t, c, s, n);
    }
    t.err = tree.WRONG_KIND;
    return 0;
}

fn _named(k as *tree.Kind, name as *u8) as i32 {
    let is *u8 as a = k.name;
    if (cast(i64, a) == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (a[i] != 0 && a[i] == name[i]) { i = i + 1; }
    return cast(i32, a[i] == name[i]);
}
