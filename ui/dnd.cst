// ui/dnd.cst — what a drag carries.
//
// A drag offers one or more things — files, text, an item of a widget of
// this program's — and says what may be done with them: copied, moved. The
// router runs it (router.begin_drag, drag_enter and the rest): which widget
// under the pointer takes what, and what was done once it is let go.
//
// The bytes are the drag's maker's: a widget beginning one keeps what it
// points at until it hears DRAG_END; the platform's loop keeps a drop from
// outside until the router is done with it. Nothing here copies them.
use "tree.cst" as tree;

// What a drag offers, what a widget takes: bits.
let is i32 as FILES with imut = 1;   // paths: files from a file manager
let is i32 as TEXT  with imut = 2;   // UTF-8
let is i32 as ITEM  with imut = 4;   // an item of a widget here: a list's row

// What may be done, what was: bits.
let is i32 as COPY with imut = 1;
let is i32 as MOVE with imut = 2;

struct Payload {
    offers   as i32;
    actions  as i32;
    text     as *u8;          // TEXT: not terminated, text_len bytes
    text_len as i64;
    files    as *u8;          // FILES: files_n paths back to back, each zero-terminated
    files_n  as i64;
    tree     as *tree.Tree;   // ITEM: the widget it is of, and which
    widget   as i64;
    item     as i64;
}

fn _empty(actions as i32) as Payload {
    let is Payload as p;
    p.offers = 0;
    p.actions = actions;
    p.text = cast(*u8, 0);
    p.text_len = 0;
    p.files = cast(*u8, 0);
    p.files_n = 0;
    p.tree = cast(*tree.Tree, 0);
    p.widget = 0;
    p.item = 0;
    return p;
}

// Text, n bytes of s, to be done with as actions says.
fn text(s as *u8, n as i64, actions as i32) as Payload {
    let is Payload as p = _empty(actions);
    p.offers = TEXT;
    p.text = s;
    p.text_len = n;
    return p;
}

// n paths, back to back at s, each zero-terminated: files from outside, which
// are only ever copied.
fn files(s as *u8, n as i64) as Payload {
    let is Payload as p = _empty(COPY);
    p.offers = FILES;
    p.files = s;
    p.files_n = n;
    return p;
}

// Item i of widget w in t — a row of a list — to be done with as actions says.
fn item(t as *tree.Tree, w as i64, i as i64, actions as i32) as Payload {
    let is Payload as p = _empty(actions);
    p.offers = ITEM;
    p.tree = t;
    p.widget = w;
    p.item = i;
    return p;
}

// The i-th path, zero-terminated; null for none.
fn file_at(p as *Payload, i as i64) as *u8 {
    if (i < 0 || i >= p.files_n) { return cast(*u8, 0); }
    let is i64 as at with mut = 0;
    let is i64 as k with mut = 0;
    while (k < i) {
        while (p.files[at] != cast(u8, 0)) { at = at + 1; }
        at = at + 1;
        k = k + 1;
    }
    return cast(*u8, cast(i64, p.files) + at);
}
