// ui/desktop.cst — the desktop's settings, followed in the application's
// loop.
//
// What the window system says of them the host reads itself (window/: GTK's
// files, XSETTINGS — told again when they change — the language). The
// settings portal, which every modern desktop answers and Wayland has no
// other, is over D-Bus: followed here on a session connection the loop
// watches — read at first, and again whenever the portal says a setting
// changed — and laid over the rest (host.set_settings), so the theme, the
// fonts, the timings and the scale follow it.
use "../dbus/dbus.cst" as dbus;
use "../window/settings.cst" as wsettings;
use "../window/linux/portal.cst" as portal;
use "host.cst" as host;

struct Desktop {
    hs      as *host.Host;
    c       as dbus.conn.Conn;
    changed as i32;   // the portal said a setting changed
    on      as i32;
}

fn _read(d as *Desktop) as void {
    let is wsettings.Settings as s with mut = wsettings.defaults();
    if (portal.read(&d.c, portal.DESKTOP, &s) == 1) { host.set_settings(d.hs, &s); }
}

fn _readable(user as *u8, fd as i64) as void {
    let is *Desktop as d = cast(*Desktop, user);
    dbus.conn.dispatch(&d.c, 0);
    if (d.changed == 1) {
        d.changed = 0;
        _read(d);
    }
}

// The portal's settings read and followed by hs from now on — d where the
// program keeps it while followed: 1, or 0 with no session bus. A desktop
// with no portal leaves the rest as they were.
fn follow(d as *Desktop, hs as *host.Host) as i32 {
    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    d.c = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&d.c) == 0) { return 0; }
    d.hs = hs;
    d.changed = 0;
    portal.watch(&d.c, portal.DESKTOP, &d.changed);
    _read(d);
    host.watch(hs, dbus.conn.fd(&d.c), fn_ptr(_readable), cast(*u8, d));
    d.on = 1;
    return 1;
}

// No longer followed.
fn stop(d as *Desktop) as void {
    if (d.on == 0) { return; }
    host.unwatch(d.hs, dbus.conn.fd(&d.c));
    dbus.conn.close(&d.c);
    d.on = 0;
}
