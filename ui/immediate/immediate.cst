// ui/immediate/immediate.cst — the immediate-mode option: widgets drawn and hit-tested per call.
//
// Not the toolkit ../ui.md describes; this is the lightweight path beside it, for
// HUDs, debug panels and tools. Its design and its gaps are in immediate.md.

use "../../math/math.cst" as math;
use "../../gpu/software/target.cst" as tgt;
use "draw.cst" as draw;

struct Context {
    target           as *tgt.Target;
    mouse_x          as i64;
    mouse_y          as i64;
    mouse_down       as i32;
    mouse_clicked    as i32;
    prev_mouse_down  as i32;

    // Theme palette
    bg_dark          as math.color.Color;
    bg_sidebar       as math.color.Color;
    bg_panel         as math.color.Color;
    bg_button        as math.color.Color;
    bg_button_hover  as math.color.Color;
    bg_button_active as math.color.Color;
    border_color     as math.color.Color;
    border_active    as math.color.Color;
    text_primary     as math.color.Color;
    text_muted       as math.color.Color;
    accent_blue      as math.color.Color;
    accent_green     as math.color.Color;
    accent_red       as math.color.Color;
}

fn context_default() as Context {
    let is Context as c;
    c.target = cast(*tgt.Target, 0);
    c.mouse_x = 0;
    c.mouse_y = 0;
    c.mouse_down = 0;
    c.mouse_clicked = 0;
    c.prev_mouse_down = 0;

    c.bg_dark          = math.color.hex(0x121418); // Modern deep dark
    c.bg_sidebar       = math.color.hex(0x181B20); // Sidebar dark
    c.bg_panel         = math.color.hex(0x20242B); // Card / panel
    c.bg_button        = math.color.hex(0x2A303A); // Button normal
    c.bg_button_hover  = math.color.hex(0x38414F); // Button hover
    c.bg_button_active = math.color.hex(0x1F242C); // Button pressed
    c.border_color     = math.color.hex(0x323844); // Subtle outline
    c.border_active    = math.color.hex(0x4F80E2); // Accent outline
    c.text_primary     = math.color.hex(0xEDEFEF); // Crisp white/grey
    c.text_muted       = math.color.hex(0x828B99); // Subtitle grey
    c.accent_blue      = math.color.hex(0x3B82F6); // Electric blue
    c.accent_green     = math.color.hex(0x10B981); // Emerald green
    c.accent_red       = math.color.hex(0xEF4444); // Crimson red
    return c;
}

fn begin_frame(ctx as *Context, t as *tgt.Target, mx as i64, my as i64, btn_down as i32) as void {
    ctx.target = t;
    ctx.mouse_x = mx;
    ctx.mouse_y = my;
    ctx.mouse_down = btn_down;
    if (btn_down == 1 && ctx.prev_mouse_down == 0) {
        ctx.mouse_clicked = 1;
    } else {
        ctx.mouse_clicked = 0;
    }
    ctx.prev_mouse_down = btn_down;

    // Fill screen background
    draw.fill_rect(t, 0, 0, t.width, t.height, ctx.bg_dark);
}

fn point_in_rect(px as i64, py as i64, x as i64, y as i64, w as i64, h as i64) as i32 {
    if (px >= x && px < x + w && py >= y && py < y + h) { return 1; }
    return 0;
}

// Immediate-mode button: returns 1 when clicked.
fn button(ctx as *Context, label as *u8, x as i64, y as i64, w as i64, h as i64) as i32 {
    let is i32 as hover = point_in_rect(ctx.mouse_x, ctx.mouse_y, x, y, w, h);
    let is i32 as clicked with mut = 0;

    let is math.color.Color as bg with mut = ctx.bg_button;
    let is math.color.Color as bdr with mut = ctx.border_color;
    let is math.color.Color as txt_col with mut = ctx.text_primary;

    if (hover == 1) {
        if (ctx.mouse_down == 1) {
            bg = ctx.bg_button_active;
            bdr = ctx.accent_blue;
        } else {
            bg = ctx.bg_button_hover;
            bdr = ctx.border_active;
        }
        if (ctx.mouse_clicked == 1) {
            clicked = 1;
        }
    }

    draw.fill_rect(ctx.target, x, y, w, h, bg);
    draw.stroke_rect(ctx.target, x, y, w, h, 1, bdr);

    let is i64 as tw = draw.text_width(label, 1);
    let is i64 as th = draw.text_height(1);
    let is i64 as tx = x + (w - tw) / 2;
    let is i64 as ty = y + (h - th) / 2;
    draw.draw_text(ctx.target, label, tx, ty, txt_col, 1);

    return clicked;
}

// Sidebar tab button with active state indicator.
fn tab_button(ctx as *Context, label as *u8, active as i32, x as i64, y as i64, w as i64, h as i64) as i32 {
    let is i32 as hover = point_in_rect(ctx.mouse_x, ctx.mouse_y, x, y, w, h);
    let is i32 as clicked with mut = 0;

    let is math.color.Color as bg with mut = ctx.bg_sidebar;
    let is math.color.Color as txt_col with mut = ctx.text_muted;

    if (active == 1) {
        bg = ctx.bg_panel;
        txt_col = ctx.text_primary;
    } else if (hover == 1) {
        bg = ctx.bg_button;
        txt_col = ctx.text_primary;
        if (ctx.mouse_clicked == 1) { clicked = 1; }
    }

    draw.fill_rect(ctx.target, x, y, w, h, bg);

    if (active == 1) {
        // Active tab left indicator pill
        draw.fill_rect(ctx.target, x, y, 3, h, ctx.accent_blue);
    }

    draw.draw_text(ctx.target, label, x + 16, y + (h - 16) / 2, txt_col, 1);
    return clicked;
}

// Render a content card / panel.
fn panel(ctx as *Context, x as i64, y as i64, w as i64, h as i64, title as *u8) as void {
    draw.fill_rect(ctx.target, x, y, w, h, ctx.bg_panel);
    draw.stroke_rect(ctx.target, x, y, w, h, 1, ctx.border_color);

    if (title[0] != 0) {
        draw.draw_text(ctx.target, title, x + 16, y + 16, ctx.text_primary, 1);
        draw.fill_rect(ctx.target, x + 16, y + 38, w - 32, 1, ctx.border_color);
    }
}

// Simple text label.
fn label(ctx as *Context, text as *u8, x as i64, y as i64, c as math.color.Color, scale as i64) as void {
    draw.draw_text(ctx.target, text, x, y, c, scale);
}

// Status indicator badge (pill).
fn status_badge(ctx as *Context, text as *u8, active as i32, x as i64, y as i64) as void {
    let is math.color.Color as col with mut = ctx.accent_red;
    if (active == 1) { col = ctx.accent_green; }
    let is i64 as tw = draw.text_width(text, 1);
    let is i64 as pw = tw + 24;
    let is i64 as ph = 24;

    draw.fill_rect(ctx.target, x, y, pw, ph, ctx.bg_button);
    draw.stroke_rect(ctx.target, x, y, pw, ph, 1, ctx.border_color);

    // Glowing dot
    draw.fill_rect(ctx.target, x + 8, y + 9, 6, 6, col);
    draw.draw_text(ctx.target, text, x + 18, y + 4, ctx.text_primary, 1);
}

// Horizontal slider control.
fn slider(ctx as *Context, label_str as *u8, x as i64, y as i64, w as i64, h as i64,
          val as *f64, min_v as f64, max_v as f64) as i32 {
    let is i32 as changed with mut = 0;
    let is i64 as bar_y = y + 20;
    let is i64 as bar_h = 8;
    let is i64 as bar_w = w;

    if (point_in_rect(ctx.mouse_x, ctx.mouse_y, x, bar_y - 6, w, bar_h + 12) == 1) {
        if (ctx.mouse_down == 1) {
            let is f64 as pct with mut = cast(f64, ctx.mouse_x - x) / cast(f64, w);
            if (pct < 0.0) { pct = 0.0; }
            if (pct > 1.0) { pct = 1.0; }
            *val = min_v + pct * (max_v - min_v);
            changed = 1;
        }
    }

    draw.draw_text(ctx.target, label_str, x, y, ctx.text_muted, 1);

    // Slider track
    draw.fill_rect(ctx.target, x, bar_y, bar_w, bar_h, ctx.bg_button);
    draw.stroke_rect(ctx.target, x, bar_y, bar_w, bar_h, 1, ctx.border_color);

    // Filled portion
    let is f64 as cur_pct with mut = (*val - min_v) / (max_v - min_v);
    if (cur_pct < 0.0) { cur_pct = 0.0; }
    if (cur_pct > 1.0) { cur_pct = 1.0; }
    let is i64 as fill_w = cast(i64, cur_pct * cast(f64, bar_w));
    if (fill_w > 0) {
        draw.fill_rect(ctx.target, x, bar_y, fill_w, bar_h, ctx.accent_blue);
    }

    // Slider thumb / handle
    let is i64 as thumb_x = x + fill_w - 4;
    draw.fill_rect(ctx.target, thumb_x, bar_y - 4, 8, bar_h + 8, ctx.text_primary);

    return changed;
}

// Waveform visualizer widget: plots an audio PCM buffer.
fn waveform_display(ctx as *Context, x as i64, y as i64, w as i64, h as i64,
                     buf as *i16, count as i64, col as math.color.Color) as void {
    draw.fill_rect(ctx.target, x, y, w, h, ctx.bg_dark);
    draw.stroke_rect(ctx.target, x, y, w, h, 1, ctx.border_color);

    let is i64 as mid_y = y + h / 2;
    // Center zero-line
    draw.fill_rect(ctx.target, x, mid_y, w, 1, ctx.border_color);

    if (count <= 1) { return; }

    let is i64 as packed = math.color.pack_rgba8(col);
    let is i64 as px with mut = 0;
    while (px < w) {
        let is i64 as s_idx = (px * count) / w;
        let is f64 as amp = cast(f64, buf[s_idx]) / 32768.0;
        let is i64 as py = mid_y - cast(i64, amp * cast(f64, h / 2 - 4));
        _plot(ctx.target, x + px, py, y, h, packed);
        _plot(ctx.target, x + px, py + 1, y, h, packed);
        px = px + 1;
    }
}

// One pixel of a widget's trace. tgt.put is unchecked, and a widget may be
// given a rect that leaves the target, so the pixel has to be inside both: the
// widget's rows [y, y + h) and the target itself.
fn _plot(t as *tgt.Target, px as i64, py as i64, y as i64, h as i64, packed as i64) as void {
    if (py < y || py >= y + h) { return; }
    if (px < 0 || py < 0 || px >= t.width || py >= t.height) { return; }
    tgt.put(t, px, py, packed);
}
