fn glyph_row(c as i32, row as i32) as u8 {
    if (c < 32 || c > 126) { return 0; }
    if (row < 0 || row >= 12) { return 0; }
    let is i64 as idx = cast(i64, c - 32) * 12 + cast(i64, row);
    return FONT_BYTES[idx];
}

fn draw_char(t as *tgt.Target, c as i32, x0 as i64, y0 as i64, col as math.color.Color, scale as i64) as void {
    if (c < 32 || c > 126) { return; }
    let is i64 as packed = math.color.pack_rgba8(col);
    let is i64 as r with mut = 0;
    while (r < 12) {
        let is u8 as byte = glyph_row(c, cast(i32, r));
        let is i64 as bit with mut = 0;
        while (bit < 8) {
            let is u8 as mask = cast(u8, 1 << cast(u32, 7 - bit));
            if ((byte & mask) != 0) {
                let is i64 as sy with mut = 0;
                while (sy < scale) {
                    let is i64 as sx with mut = 0;
                    while (sx < scale) {
                        let is i64 as px = x0 + bit * scale + sx;
                        let is i64 as py = y0 + r * scale + sy;
                        if (px >= 0 && py >= 0 && px < t.width && py < t.height) {
                            tgt.put(t, px, py, packed);
                        }
                        sx = sx + 1;
                    }
                    sy = sy + 1;
                }
            }
            bit = bit + 1;
        }
        r = r + 1;
    }
}

fn draw_text(t as *tgt.Target, str as *u8, x0 as i64, y0 as i64, col as math.color.Color, scale as i64) as void {
    let is i64 as cur_x with mut = x0;
    let is i64 as cur_y with mut = y0;
    let is i64 as i with mut = 0;
    while (str[i] != 0) {
        if (str[i] == 10) { // newline
            cur_x = x0;
            cur_y = cur_y + 14 * scale;
        } else {
            draw_char(t, cast(i32, str[i]), cur_x, cur_y, col, scale);
            cur_x = cur_x + 8 * scale;
        }
        i = i + 1;
    }
}

fn text_width(str as *u8, scale as i64) as i64 {
    let is i64 as max_w with mut = 0;
    let is i64 as cur_w with mut = 0;
    let is i64 as i with mut = 0;
    while (str[i] != 0) {
        if (str[i] == 10) {
            if (cur_w > max_w) { max_w = cur_w; }
            cur_w = 0;
        } else {
            cur_w = cur_w + 8 * scale;
        }
        i = i + 1;
    }
    if (cur_w > max_w) { max_w = cur_w; }
    return max_w;
}

fn text_height(str as *u8, scale as i64) as i64 {
    let is i64 as lines with mut = 1;
    let is i64 as i with mut = 0;
    while (str[i] != 0) {
        if (str[i] == 10) { lines = lines + 1; }
        i = i + 1;
    }
    return lines * 14 * scale;
}
