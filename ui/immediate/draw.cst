// ui/immediate/draw.cst — 2D software drawing primitives for UI.

use "../../math/math.cst" as math;
use "../../gpu/software/target.cst" as tgt;
use "std/causticos/font.cst" as font;

fn fill_rect(t as *tgt.Target, x0 as i64, y0 as i64, w as i64, h as i64, c as math.color.Color) as void {
    let is i64 as packed = math.color.pack_rgba8(c);
    let is i64 as x_start with mut = x0;
    if (x_start < 0) { x_start = 0; }
    let is i64 as y_start with mut = y0;
    if (y_start < 0) { y_start = 0; }
    let is i64 as x_end with mut = x0 + w;
    if (x_end > t.width) { x_end = t.width; }
    let is i64 as y_end with mut = y0 + h;
    if (y_end > t.height) { y_end = t.height; }

    let is i64 as y with mut = y_start;
    while (y < y_end) {
        let is i64 as x with mut = x_start;
        while (x < x_end) {
            tgt.put(t, x, y, packed);
            x = x + 1;
        }
        y = y + 1;
    }
}

fn stroke_rect(t as *tgt.Target, x as i64, y as i64, w as i64, h as i64, thickness as i64, c as math.color.Color) as void {
    // Top
    fill_rect(t, x, y, w, thickness, c);
    // Bottom
    fill_rect(t, x, y + h - thickness, w, thickness, c);
    // Left
    fill_rect(t, x, y, thickness, h, c);
    // Right
    fill_rect(t, x + w - thickness, y, thickness, h, c);
}

fn draw_char(t as *tgt.Target, ch as i32, x0 as i64, y0 as i64, c as math.color.Color, scale as i64) as void {
    let is *u8 as g = font.glyph(cast(i64, ch));
    let is i64 as packed = math.color.pack_rgba8(c);

    let is i64 as row with mut = 0;
    while (row < 16) {
        let is u8 as byte = g[row];
        let is i64 as col with mut = 0;
        while (col < 8) {
            let is u8 as mask = cast(u8, 1 << cast(u32, 7 - col));
            if ((byte & mask) != 0) {
                let is i64 as sy with mut = 0;
                while (sy < scale) {
                    let is i64 as sx with mut = 0;
                    while (sx < scale) {
                        let is i64 as px = x0 + col * scale + sx;
                        let is i64 as py = y0 + row * scale + sy;
                        if (px >= 0 && py >= 0 && px < t.width && py < t.height) {
                            tgt.put(t, px, py, packed);
                        }
                        sx = sx + 1;
                    }
                    sy = sy + 1;
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

fn draw_text(t as *tgt.Target, str as *u8, x0 as i64, y0 as i64, c as math.color.Color, scale as i64) as void {
    let is i64 as cx with mut = x0;
    let is i64 as cy with mut = y0;
    let is i64 as i with mut = 0;
    while (str[i] != 0) {
        if (str[i] == 10) { // '\n'
            cx = x0;
            cy = cy + 18 * scale;
        } else {
            draw_char(t, cast(i32, str[i]), cx, cy, c, scale);
            cx = cx + 8 * scale;
        }
        i = i + 1;
    }
}

fn text_width(str as *u8, scale as i64) as i64 {
    let is i64 as max_w with mut = 0;
    let is i64 as cur_w with mut = 0;
    let is i64 as i with mut = 0;
    while (str[i] != 0) {
        if (str[i] == 10) {
            if (cur_w > max_w) { max_w = cur_w; }
            cur_w = 0;
        } else {
            cur_w = cur_w + 8 * scale;
        }
        i = i + 1;
    }
    if (cur_w > max_w) { max_w = cur_w; }
    return max_w;
}

fn text_height(scale as i64) as i64 {
    return 16 * scale;
}
