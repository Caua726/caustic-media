// ui/dnd_test.cst — drag and drop through the router: a drag begun by a
// widget, run from the pointer until it is let go or Escape calls it off, and
// one coming from outside the window, told by the platform's loop; who takes
// what where, the drop, the end told the source.
//
// Synthetic events through the router, as router_test drives it.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "box.cst" as box;
use "event.cst" as event;
use "router.cst" as router;
use "signal.cst" as signal;
use "dnd.cst" as dnd;
use "../input/keys.cst" as keys;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    if (cast(i64, a) == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == cast(u8, 0) || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == cast(u8, 0));
}

// --- A probe: a 100 by 100 leaf that frames its one child in its top left
// quarter, takes what `takes` says of a drag, and counts what it hears ---
struct Probe {
    takes   as i64;   // dnd bits it takes; a source when begins is 1
    begins  as i64;
    overs   as i64;
    leaves  as i64;
    drops   as i64;
    ends    as i64;
    ups     as i64;
    end_as  as i64;   // DRAG_END: what was done
    drop_as as i64;   // DROP: what was proposed
    over_x  as f64;   // DRAG_OVER: where, in its own coordinates
    got     as *u8;   // DROP: the drag
    moves   as i64;   // POINTER_MOVE
    phase   as i64;   // DRAG_OVER: the last one's
}

let is tree.Kind as probe_kind with mut;
let is dnd.Payload as moving with mut;   // what a source begins

fn probe_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    geom.size_zero(out);
    out.pref_w = 100.0;
    out.pref_h = 100.0;
    out.max_w = 100.0;
    out.max_h = 100.0;
}

fn probe_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is i64 as child = tree.first_child(t, w);
    if (child == 0) { return; }
    let is math.rect.Rect as q = math.rect.rect(0.0, 0.0, 50.0, 50.0);
    layout.place(t, child, &q);
}

fn probe_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Probe as d = cast(*Probe, data);
    if (e.kind == event.POINTER_DOWN) { return cast(i64, d.begins == 1); }
    if (e.kind == event.POINTER_UP) { d.ups = d.ups + 1; }
    if (e.kind == event.POINTER_MOVE) { d.moves = d.moves + 1; }
    if (e.kind == event.DRAG_START && d.begins == 1) {
        router.begin_drag(t, cast(*router.Router, tree.router(t)), w, &moving);
        return 1;
    }
    if (e.kind == event.DRAG_OVER) {
        d.overs = d.overs + 1;
        d.over_x = e.local_x;
        d.phase = cast(i64, e.phase);
        return d.takes & cast(i64, e.which);
    }
    if (e.kind == event.DRAG_LEAVE) { d.leaves = d.leaves + 1; }
    if (e.kind == event.DROP) {
        d.drops = d.drops + 1;
        d.drop_as = cast(i64, e.which);
        d.got = e.drag;
        return cast(i64, e.which);
    }
    if (e.kind == event.DRAG_END) {
        d.ends = d.ends + 1;
        d.end_as = cast(i64, e.which);
    }
    return 0;
}

fn probe(t as *tree.Tree, parent as i64, takes as i64) as i64 {
    let is i64 as w = tree.create(t, &probe_kind, parent);
    pd(t, w).takes = takes;
    return w;
}

fn pd(t as *tree.Tree, w as i64) as *Probe { return cast(*Probe, tree.data(t, w)); }

// Everything a probe heard, forgotten.
fn quiet(t as *tree.Tree, w as i64) as void {
    let is *Probe as d = pd(t, w);
    d.overs = 0;
    d.leaves = 0;
    d.drops = 0;
    d.ends = 0;
    d.ups = 0;
    d.end_as = 0 - 1;
    d.drop_as = 0 - 1;
    d.got = cast(*u8, 0);
}

let is i64 as dropped_signals with mut = 0;
let is *u8 as dropped_drag with mut;

fn on_dropped(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    dropped_signals = dropped_signals + 1;
    dropped_drag = arg;
}

// A press on the source, moved past the threshold: the drag begun.
fn start(t as *tree.Tree, r as *router.Router, time as i64) as void {
    router.pointer_move(t, r, 50.0, 50.0, time);
    router.pointer_button(t, r, 1, 1, 50.0, 50.0, time);
    router.pointer_move(t, r, 70.0, 50.0, time + 1);
}

fn main() as i32 {
    probe_kind = widget.kind("probe", sizeof(Probe));
    probe_kind.measure = fn_ptr(probe_measure);
    probe_kind.arrange = fn_ptr(probe_arrange);
    probe_kind.event = fn_ptr(probe_event);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as row = box.create(&t, tree.root(&t), box.ROW);
    layout.set_align(&t, row, layout.START, layout.START);
    // At x 0, 100, 200, 300: the source, a text target holding a plain child,
    // a files target, a widget the program takes files on.
    let is i64 as src = probe(&t, row, 0);
    pd(&t, src).begins = 1;
    let is i64 as txt = probe(&t, row, cast(i64, dnd.TEXT));
    let is i64 as inner = probe(&t, txt, 0);
    let is i64 as fil = probe(&t, row, cast(i64, dnd.FILES));
    let is i64 as prog = probe(&t, row, 0);
    layout.run(&t, 600.0, 200.0);
    quiet(&t, src);
    quiet(&t, txt);
    quiet(&t, fil);

    moving = dnd.text("moved", 5, dnd.COPY | dnd.MOVE);
    check("text: offered, its bytes", moving.offers == dnd.TEXT && moving.actions == (dnd.COPY | dnd.MOVE) &&
          same(moving.text, moving.text_len, "moved") == 1);

    // --- Nothing dragged ---
    check("no drag", router.drag_active(&r) == 0 && router.drag_target(&r) == 0 && router.drag_takes(&r) == 0);

    // --- Begun by a widget: the pointer runs it ---
    router.pointer_move(&t, &r, 50.0, 50.0, 99);
    let is i64 as moved_before = pd(&t, src).moves;
    start(&t, &r, 100);
    check("begun", router.drag_active(&r) == 1 && router.drag_source(&r) == src);
    check("begun: its source hears no more of the pointer", pd(&t, src).moves - moved_before == 1);
    check("begun: no second one, nor one of nothing", router.begin_drag(&t, &r, src, &moving) == 0);
    check("from outside meanwhile: nothing", router.drag_enter(&t, &r, &moving, 150.0, 50.0, 105) == 0 &&
          router.drag_source(&r) == src && router.drag_target(&r) == 0);
    check("over its source, nothing takes it: no drop here", router.drag_target(&r) == 0 &&
          router.pointer_shape(&t, &r) == tree.SHAPE_NO_DROP);
    router.pointer_move(&t, &r, 150.0, 70.0, 110);
    check("over a text target: taken there", router.drag_target(&r) == txt && router.drag_takes(&r) == dnd.TEXT &&
          pd(&t, txt).overs == 1 && pd(&t, txt).over_x == 50.0);
    check("moved, as it would be without Control", router.pointer_shape(&t, &r) == tree.SHAPE_MOVE);
    router.pointer_move(&t, &r, 120.0, 20.0, 120);
    check("over what it holds: its holder still, asked again, not left", router.drag_target(&r) == txt &&
          pd(&t, txt).overs == 2 && pd(&t, txt).leaves == 0 && pd(&t, inner).overs == 1);
    check("asked as what it was over, then as what holds it", pd(&t, inner).phase == event.TARGET &&
          pd(&t, txt).phase == event.BUBBLE);
    router.key(&t, &r, keys.CONTROL_L, keys.MOD_CONTROL, 1, 0, 125);
    check("with Control: copied", router.pointer_shape(&t, &r) == tree.SHAPE_COPY);
    router.key(&t, &r, keys.CONTROL_L, 0, 0, 0, 126);
    router.pointer_move(&t, &r, 250.0, 50.0, 130);
    check("over files only: left, not taken", pd(&t, txt).leaves == 1 && router.drag_target(&r) == 0 &&
          pd(&t, fil).overs == 1 && router.pointer_shape(&t, &r) == tree.SHAPE_NO_DROP);
    router.pointer_move(&t, &r, 150.0, 50.0, 140);
    router.pointer_button(&t, &r, 1, 0, 150.0, 50.0, 150);
    check("let go over it: dropped there, moved", pd(&t, txt).drops == 1 && pd(&t, txt).drop_as == dnd.MOVE);
    let is *dnd.Payload as got with mut = cast(*dnd.Payload, pd(&t, txt).got);
    check("what it got: the text", cast(i64, got) != 0 && same(got.text, got.text_len, "moved") == 1);
    check("its source told: moved", pd(&t, src).ends == 1 && pd(&t, src).end_as == dnd.MOVE);
    check("over: no drag, no press held, no release to the source", router.drag_active(&r) == 0 &&
          router.capture(&r) == 0 && pd(&t, src).ups == 0 && router.drag_target(&r) == 0);
    check("over: the pointer as it was", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    check("over: no source, the hover where it is", router.drag_source(&r) == 0 && router.hover(&r) == txt);

    // --- Called off with Escape ---
    quiet(&t, src);
    quiet(&t, txt);
    start(&t, &r, 1000);
    router.pointer_move(&t, &r, 150.0, 50.0, 1010);
    check("Escape: taken", router.key(&t, &r, keys.ESCAPE, 0, 1, 0, 1020) == 1);
    check("Escape: left, its source told nothing was done", pd(&t, txt).leaves == 1 && pd(&t, src).ends == 1 &&
          pd(&t, src).end_as == 0 && router.drag_active(&r) == 0);
    router.pointer_move(&t, &r, 160.0, 50.0, 1030);
    router.pointer_button(&t, &r, 1, 0, 160.0, 50.0, 1040);
    check("Escape: the release after it, nothing", pd(&t, txt).drops == 0 && pd(&t, txt).overs == 1 &&
          pd(&t, src).ups == 0 && router.capture(&r) == 0);

    // --- Begun with no press: called off the same way ---
    let is dnd.Payload as none = moving;
    none.offers = 0;
    check("nothing offered: not begun", router.begin_drag(&t, &r, src, &none) == 0 && router.drag_active(&r) == 0);
    check("begun by hand", router.begin_drag(&t, &r, src, &moving) == 1 && router.drag_active(&r) == 1);
    router.key(&t, &r, keys.ESCAPE, 0, 1, 0, 1500);
    check("and called off", router.drag_active(&r) == 0);
    router.pointer_button(&t, &r, 1, 0, 160.0, 50.0, 1510);

    // --- Gone over another window, dropped there ---
    // The platform's loop has the other window's router do the taking; this
    // one is told the drag is elsewhere, then what was done there.
    quiet(&t, src);
    quiet(&t, txt);
    check("no drag: nothing to carry", cast(i64, router.drag_payload(&r)) == 0);
    start(&t, &r, 1600);
    router.pointer_move(&t, &r, 150.0, 50.0, 1610);
    let is *dnd.Payload as carried = router.drag_payload(&r);
    check("what it carries, for another window", cast(i64, carried) != 0 && same(carried.text, carried.text_len, "moved") == 1);
    router.drag_elsewhere(&t, &r, 1620);
    check("elsewhere: what took it here left", pd(&t, txt).leaves == 1 && router.drag_target(&r) == 0 &&
          router.drag_active(&r) == 1);
    check("done there: finished", router.drag_finish(&t, &r, dnd.MOVE, 1630) == 1);
    check("done there: its source told, over here", pd(&t, src).ends == 1 && pd(&t, src).end_as == dnd.MOVE &&
          router.drag_active(&r) == 0 && router.capture(&r) == 0 && pd(&t, txt).drops == 0);
    router.pointer_button(&t, &r, 1, 0, 700.0, 50.0, 1640);
    check("the release after it: nothing", pd(&t, src).ups == 0 && pd(&t, txt).drops == 0);
    check("no drag: nothing finished", router.drag_finish(&t, &r, dnd.COPY, 1650) == 0 && pd(&t, src).ends == 1);
    start(&t, &r, 1700);
    router.pointer_move(&t, &r, 150.0, 50.0, 1710);
    router.drag_elsewhere(&t, &r, 1720);
    router.pointer_move(&t, &r, 150.0, 50.0, 1730);
    check("back over this window: taken here again", router.drag_target(&r) == txt);
    router.pointer_button(&t, &r, 1, 0, 150.0, 50.0, 1740);
    quiet(&t, src);
    quiet(&t, txt);

    // --- Let go where nothing takes it ---
    quiet(&t, src);
    start(&t, &r, 2000);
    router.pointer_move(&t, &r, 250.0, 50.0, 2010);
    router.pointer_button(&t, &r, 1, 0, 250.0, 50.0, 2020);
    check("let go over nothing taking it: nothing done", pd(&t, src).ends == 1 && pd(&t, src).end_as == 0 &&
          pd(&t, fil).drops == 0);

    // --- Copy only ---
    moving = dnd.text("kept", 4, dnd.COPY);
    quiet(&t, src);
    quiet(&t, txt);
    start(&t, &r, 3000);
    router.pointer_move(&t, &r, 150.0, 50.0, 3010);
    check("copy only: copied", router.pointer_shape(&t, &r) == tree.SHAPE_COPY);
    router.pointer_button(&t, &r, 1, 0, 150.0, 50.0, 3020);
    check("copy only: dropped as a copy", pd(&t, txt).drop_as == dnd.COPY && pd(&t, src).end_as == dnd.COPY);

    // --- From outside: told by the platform's loop ---
    let is [32]u8 as paths;
    let is i64 as k with mut = 0;
    while (k < 32) {
        paths[k] = cast(u8, 0);
        k = k + 1;
    }
    paths[0] = 47; paths[1] = 97;                  // "/a"
    paths[3] = 47; paths[4] = 98; paths[5] = 99;   // "/bc"
    let is dnd.Payload as files = dnd.files(cast(*u8, &paths), 2);
    check("files: offered, copied only", files.offers == dnd.FILES && files.actions == dnd.COPY);
    let is [16]u8 as odd;
    k = 0;
    while (k < 16) {
        odd[k] = cast(u8, 0);
        k = k + 1;
    }
    odd[0] = 47; odd[1] = 97; odd[2] = 98;   // "/ab"
    odd[4] = 47; odd[5] = 99;                // "/c"
    odd[7] = 47; odd[8] = 100; odd[9] = 101; // "/de"
    let is dnd.Payload as three = dnd.files(cast(*u8, &odd), 3);
    check("files of odd lengths: each", same(dnd.file_at(&three, 1), 2, "/c") == 1 && same(dnd.file_at(&three, 2), 3, "/de") == 1);
    check("files: each", same(dnd.file_at(&files, 0), 2, "/a") == 1 && same(dnd.file_at(&files, 1), 3, "/bc") == 1 &&
          cast(i64, dnd.file_at(&files, 2)) == 0 && cast(i64, dnd.file_at(&files, 0 - 1)) == 0);
    quiet(&t, fil);
    quiet(&t, txt);
    check("entered over the files target: taken", router.drag_enter(&t, &r, &files, 250.0, 50.0, 4000) == dnd.FILES &&
          router.drag_active(&r) == 1 && router.drag_source(&r) == 0 && router.drag_target(&r) == fil);
    check("moved over text only: not taken", router.drag_move(&t, &r, 150.0, 50.0, 4010) == 0 && pd(&t, fil).leaves == 1);
    check("back: taken", router.drag_move(&t, &r, 260.0, 50.0, 4020) == dnd.FILES);
    check("dropped: copied", router.drag_drop(&t, &r, 260.0, 50.0, 4030) == dnd.COPY && pd(&t, fil).drops == 1 &&
          pd(&t, fil).drop_as == dnd.COPY && router.drag_active(&r) == 0);
    got = cast(*dnd.Payload, pd(&t, fil).got);
    check("what it got: the files", cast(i64, got) != 0 && got.files_n == 2);
    // From outside, what is offered is known on entering and had on the drop:
    // what it is updated then, what it offers kept.
    quiet(&t, fil);
    let is dnd.Payload as offered = dnd.files(cast(*u8, 0), 0);
    router.drag_enter(&t, &r, &offered, 250.0, 50.0, 4040);
    check("the data, had on the drop", router.drag_update(&r, &three) == 1 &&
          router.drag_drop(&t, &r, 260.0, 50.0, 4050) == dnd.COPY);
    got = cast(*dnd.Payload, pd(&t, fil).got);
    check("the widget given it", cast(i64, got) != 0 && got.files_n == 3 && same(dnd.file_at(got, 2), 3, "/de") == 1);
    check("no drag from outside: nothing updated", router.drag_update(&r, &three) == 0);
    quiet(&t, fil);
    router.drag_enter(&t, &r, &files, 250.0, 50.0, 4100);
    router.drag_leave(&t, &r, 4110);
    check("left: told, over", pd(&t, fil).leaves == 1 && router.drag_active(&r) == 0 && router.drag_target(&r) == 0);
    check("dropped where nothing takes it: nothing done", router.drag_enter(&t, &r, &files, 150.0, 50.0, 4200) == 0 &&
          router.drag_drop(&t, &r, 150.0, 50.0, 4210) == 0 && pd(&t, txt).drops == 0 && router.drag_active(&r) == 0);
    let is i64 as overs_before = pd(&t, fil).overs;
    check("no drag: nothing moved or dropped", router.drag_move(&t, &r, 250.0, 50.0, 4300) == 0 &&
          router.drag_drop(&t, &r, 250.0, 50.0, 4310) == 0 && pd(&t, fil).overs == overs_before);

    // --- Where the program takes a drop on any widget ---
    signal.connect(&t, prog, signal.DROPPED, fn_ptr(on_dropped), cast(*u8, 0));
    check("not yet: not taken", router.drag_enter(&t, &r, &files, 350.0, 50.0, 5000) == 0);
    router.drag_leave(&t, &r, 5005);
    check("one before it in the table", router.add_drop_target(&r, 9999, dnd.FILES) == 1);
    check("taken there by the program", router.add_drop_target(&r, prog, dnd.FILES) == 1);
    check("now: taken", router.drag_enter(&t, &r, &files, 350.0, 50.0, 5010) == dnd.FILES &&
          router.drag_target(&r) == prog);
    check("dropped: said, with the drag", router.drag_drop(&t, &r, 350.0, 50.0, 5020) == dnd.COPY && dropped_signals == 1 &&
          cast(i64, dropped_drag) != 0 && cast(*dnd.Payload, dropped_drag).files_n == 2);
    check("text: not what it takes", router.drag_enter(&t, &r, &moving, 350.0, 50.0, 5030) == 0);
    router.drag_leave(&t, &r, 5035);
    router.remove_drop_target(&r, prog);
    router.remove_drop_target(&r, 9999);
    check("no more", router.drag_enter(&t, &r, &files, 350.0, 50.0, 5040) == 0);
    router.drag_leave(&t, &r, 5045);
    let is i64 as n with mut = 0;
    while (n < 40 && router.add_drop_target(&r, 1000 + n, dnd.FILES) == 1) { n = n + 1; }
    check("a table of its size: full is said", n == router.MAX_DROP_TARGETS);
    check("one already there: changed, not added", router.add_drop_target(&r, 1000, dnd.TEXT) == 1);
    router.remove_drop_target(&r, 1003);
    check("one taken off: room again", router.add_drop_target(&r, 2000, dnd.FILES) == 1 &&
          router.add_drop_target(&r, 2001, dnd.FILES) == 0);
    n = 0;
    while (n < 40) {
        router.remove_drop_target(&r, 1000 + n);
        n = n + 1;
    }
    router.remove_drop_target(&r, 2000);

    // --- Disabled, gone, scoped out ---
    tree.set_enabled(&t, fil, 0);
    check("disabled: not taken", router.drag_enter(&t, &r, &files, 250.0, 50.0, 6000) == 0);
    router.drag_leave(&t, &r, 6005);
    tree.set_enabled(&t, fil, 1);
    router.drag_enter(&t, &r, &files, 250.0, 50.0, 6010);
    tree.destroy(&t, fil);
    check("its target gone: dropped on nothing", router.drag_drop(&t, &r, 250.0, 50.0, 6020) == 0 &&
          router.drag_active(&r) == 0);
    router.set_scope(&t, &r, src);
    check("outside a modal scope: not taken", router.drag_enter(&t, &r, &moving, 150.0, 50.0, 6030) == 0);
    router.drag_leave(&t, &r, 6035);
    router.set_scope(&t, &r, 0);
    quiet(&t, src);
    start(&t, &r, 7000);
    tree.destroy(&t, src);
    router.pointer_move(&t, &r, 150.0, 50.0, 7010);
    router.pointer_button(&t, &r, 1, 0, 150.0, 50.0, 7020);
    check("its source gone: dropped all the same, nothing more to tell", router.drag_active(&r) == 0 &&
          router.capture(&r) == 0);

    tree.close(&t);
    if (fails > 0) {
        io.printf("dnd: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("dnd: all checks passed\n");
    return 0;
}
