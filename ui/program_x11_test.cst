// ui/program_x11_test.cst — a program of the toolkit's, started in one
// call: fonts, the application, the loop, the desktop followed. Under Xvfb
// on a private bus that starts none of the desktop's services, the test
// fonts standing in for the system's:
//   sh dbus/tools/run_dbus_bare.sh sh window/x11/tools/run_headless.sh ./build/program_x11_test
// and with no session bus:
//   env DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent sh window/x11/tools/run_headless.sh ./build/program_x11_test none
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/time.cst" as time;
use "../dbus/dbus.cst" as dbus;
use "../text/fonts/chain.cst" as chain;
use "tree.cst" as tree;
use "layout.cst" as layout;
use "app.cst" as app;
use "host.cst" as host;
use "timer.cst" as timer;
use "system_fonts.cst" as system_fonts;
use "program.cst" as program;
use "widgets/label.cst" as label;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is program.Program as p with mut;
let is program.Program as bare with mut;
let is i64 as win with mut = 0;

fn close_it(user as *u8) as void { app.window_close(program.app(&p), win); }

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i32 as no_bus = cast(i32, env.argc() > 1);
    check("no fonts: not started", program.open(&bare, "text/testdata/nowhere") == 0);
    program.close(&bare);

    check("started", program.open(&p, "text/testdata/fonts") == 1);
    let is chain.Prefs as fp with mut = chain.defaults();
    fp.ui = "Caustic Test Sans";
    fp.sans = "Caustic Test Sans";
    system_fonts.set_prefs(program.fonts(&p), &fp);
    let is *app.App as a = program.app(&p);
    let is *host.Host as hs = program.host(&p);
    if (no_bus == 1) {
        check("no bus: no connection", cast(i64, program.conn(&p)) == 0 && host.watched(hs) == 0);
    } else {
        check("its session connection", cast(i64, program.conn(&p)) != 0 && dbus.conn.is_open(program.conn(&p)) == 1);
        check("both connections watched: its own, the portal's", host.watched(hs) == 2);
    }

    win = app.window_open(a, 240.0, 80.0);
    app.set_title(a, win, "Program", 7);
    let is *tree.Tree as t = app.tree(a, win);
    let is i64 as l = label.create(t, tree.root(t), "Hello", 5);
    let is i64 as k with mut = 0;
    while (k < 6) {
        host.step(hs, 30);
        k = k + 1;
    }
    check("on the screen", host.shown(hs) == 1);
    check("its text in the system's fonts", system_fonts.count(program.fonts(&p)) >= 1 && layout.window_rect(t, l).w > 10.0);

    // Run until the window is closed.
    timer.add(app.timers(a), time.now_ms(), 50, 0, fn_ptr(close_it), cast(*u8, 0));
    let is i64 as t0 = time.now_ms();
    program.run(&p);
    check("run: until no window is left", host.shown(hs) == 0 && time.now_ms() - t0 < 3000);
    program.close(&p);
    check("closed: no fonts kept", system_fonts.count(program.fonts(&p)) == 0 && cast(i64, program.conn(&p)) == 0);
    program.close(&p);

    if (fails == 0) {
        io.printf("ui program: all checks passed\n");
        return 0;
    }
    io.printf("ui program: %d failures\n", fails);
    return 1;
}
