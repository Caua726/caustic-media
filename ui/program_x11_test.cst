// ui/program_x11_test.cst — a program of the toolkit's, started in one
// call: fonts, the application, the loop, the desktop followed. Under Xvfb
// on a private bus that starts none of the desktop's services, the test
// fonts standing in for the system's:
//   sh dbus/tools/run_dbus_bare.sh sh window/x11/tools/run_headless.sh ./build/program_x11_test
// and with no session bus:
//   env DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent sh window/x11/tools/run_headless.sh ./build/program_x11_test none
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/time.cst" as time;
use "../dbus/dbus.cst" as dbus;
use "../window/device.cst" as device;
use "../text/fonts/chain.cst" as chain;
use "tree.cst" as tree;
use "layout.cst" as layout;
use "box.cst" as box;
use "app.cst" as app;
use "host.cst" as host;
use "timer.cst" as timer;
use "system_fonts.cst" as system_fonts;
use "program.cst" as program;
use "widgets/label.cst" as label;
use "widgets/dialog.cst" as dialog;
use "widgets/entry.cst" as entry;
use "widgets/decoration.cst" as decoration;
use "../math/math.cst" as math;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}
fn pixel(v as f64, scale as f64) as i64 { return cast(i64, v * scale + 0.5); }

fn same_pixels(a as *math.rect.Rect, b as *math.rect.Rect, scale as f64) as i32 {
    return cast(i32, pixel(a.x, scale) == pixel(b.x, scale) &&
        pixel(a.y, scale) == pixel(b.y, scale) &&
        pixel(a.x + a.w, scale) == pixel(b.x + b.w, scale) &&
        pixel(a.y + a.h, scale) == pixel(b.y + b.h, scale));
}

let is program.Program as p with mut;
let is program.Program as bare with mut;
let is i64 as win with mut = 0;

fn close_it(user as *u8) as void { app.window_close(program.app(&p), win); }

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i32 as no_bus = cast(i32, env.argc() > 1);
    check("no fonts: not started", program.open(&bare, "text/testdata/nowhere") == 0);
    program.close(&bare);

    check("started", program.open(&p, "text/testdata/fonts") == 1);
    let is chain.Prefs as fp with mut = chain.defaults();
    fp.ui = "Caustic Test Sans";
    fp.sans = "Caustic Test Sans";
    system_fonts.set_prefs(program.fonts(&p), &fp);
    let is *app.App as a = program.app(&p);
    let is *host.Host as hs = program.host(&p);
    if (no_bus == 1) {
        check("no bus: no connection", cast(i64, program.conn(&p)) == 0 && host.watched(hs) == 0);
    } else {
        check("its session connection", cast(i64, program.conn(&p)) != 0 && dbus.conn.is_open(program.conn(&p)) == 1);
        check("both connections watched: its own, the portal's", host.watched(hs) == 2);
    }

    win = app.window_open(a, 240.0, 180.0);
    app.set_title(a, win, "Program", 7);
    let is *tree.Tree as t = app.tree(a, win);
    let is i64 as col = box.create(t, tree.root(t), box.COLUMN);
    let is i64 as l = label.create(t, col, "Hello", 5);
    layout.set_min_size(t, l, 210.0, 150.0);
    let is i64 as k with mut = 0;
    while (k < 6) {
        host.step(hs, 30);
        k = k + 1;
    }
    check("on the screen", host.shown(hs) == 1);
    check("its text in the system's fonts", system_fonts.count(program.fonts(&p)) >= 1 && layout.window_rect(t, l).w > 10.0);
    let is i64 as frame = app.decoration(a, win);
    let is math.rect.Rect as room with mut = layout.rect(t, tree.root(t));
    if (frame != 0) { room = layout.window_rect(t, decoration.content_of(t, frame)); }
    let is math.rect.Rect as filled = layout.window_rect(t, col);
    check("original root content fills the usable window below its frame",
          same_pixels(&filled, &room, t.scale) == 1);
    let is math.rect.Rect as window_bounds with mut = layout.rect(t, tree.root(t));
    if (frame != 0) { window_bounds = layout.window_rect(t, frame); }
    let is *device.Window as native_window = host.native(hs, win);
    check("minimum content and its frame fit the native buffer",
          pixel(window_bounds.x + window_bounds.w, t.scale) <= device.width(native_window) &&
          pixel(window_bounds.y + window_bounds.h, t.scale) <= device.height(native_window));

    let is *tree.Tree as dt = dialog.window_tree(t);
    let is i64 as dg = dialog.create(dt, "Native dialog", 13);
    entry.create(dt, dialog.content(dt, dg));
    dialog.add_button(dt, dg, "_Close", 6, dialog.CLOSE);
    dialog.show(dt, app.router(a, app.window_of(a, dt)), dg, 1);
    k = 0;
    while (k < 6) { host.step(hs, 30); k = k + 1; }
    let is i64 as dw = app.window_of(a, dt);
    let is i64 as dialog_frame = app.decoration(a, dw);
    let is math.rect.Rect as dialog_room with mut = layout.rect(dt, tree.root(dt));
    if (dialog_frame != 0) { dialog_room = layout.window_rect(dt, decoration.content_of(dt, dialog_frame)); }
    let is math.rect.Rect as dialog_at = layout.window_rect(dt, dg);
    check("native dialog content stays below its header and fills the frame",
          same_pixels(&dialog_at, &dialog_room, dt.scale) == 1);
    let is math.rect.Rect as dialog_bounds with mut = dialog_at;
    if (dialog_frame != 0) { dialog_bounds = layout.window_rect(dt, dialog_frame); }
    let is *device.Window as native_dialog = host.native(hs, dw);
    check("the native buffer contains the whole dialog and its frame",
          cast(i64, native_dialog) != 0 &&
          pixel(dialog_bounds.x, dt.scale) >= 0 && pixel(dialog_bounds.y, dt.scale) >= 0 &&
          pixel(dialog_bounds.x + dialog_bounds.w, dt.scale) <= device.width(native_dialog) &&
          pixel(dialog_bounds.y + dialog_bounds.h, dt.scale) <= device.height(native_dialog));
    dialog.hide(dt, dg);
    host.step(hs, 0);
    check("closing the native dialog leaves its owner on screen", host.shown(hs) == 1);

    // Run until the window is closed.
    timer.add(app.timers(a), time.now_ms(), 50, 0, fn_ptr(close_it), cast(*u8, 0));
    let is i64 as t0 = time.now_ms();
    program.run(&p);
    check("run: until no window is left", host.shown(hs) == 0 && time.now_ms() - t0 < 3000);
    program.close(&p);
    check("closed: no fonts kept", system_fonts.count(program.fonts(&p)) == 0 && cast(i64, program.conn(&p)) == 0);
    program.close(&p);

    if (fails == 0) {
        io.printf("ui program: all checks passed\n");
        return 0;
    }
    io.printf("ui program: %d failures\n", fails);
    return 1;
}
