// ui/widgets/progress_test.cst — the progress bar: a fraction filled from its
// start, or a pulse going back and forth through the window's animator when
// there is none; the separator, a line across or up and down; told.
use "std/io.cst" as io;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../anim.cst" as anim;
use "../signal.cst" as signal;
use "../../window/keys.cst" as keys;
use "progress.cst" as progress;
use "separator.cst" as separator;

let is i64 as W with imut = 200;
let is i64 as H with imut = 40;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [8000]i32 as px with mut;
let is style.Theme as theme with mut;

let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

fn measure(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.0001 && d > 0.0 - 0.0001);
}

fn main() as i32 {
    theme = style.light();
    frame_router = cast(*router.Router, 0);
    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    let is i64 as root = tree.root(&t);
    let is i64 as w = progress.create(&t, root);
    let is f64 as k = theme.metrics.indicator;
    check("a progress bar, empty, not focusable", w != 0 && tree.kind(&t, w).role == access.ROLE_PROGRESS_BAR &&
          progress.fraction(&t, w) == 0.0 && tree.is_focusable(&t, w) == 0 && progress.pulsing(&t, w) == 0);
    let is geom.Size as s with mut = measure(&t, w);
    check("a third of a knob thick, room to fill", s.min_h == k / 3.0 && s.pref_h == k / 3.0 &&
          s.min_w == 3.0 * k && s.pref_w == 10.0 * k && s.max_w >= layout.UNBOUNDED);

    // A fraction, held to 0 .. 1.
    check("set", progress.set_fraction(&t, w, 0.25) == 1 && progress.fraction(&t, w) == 0.25);
    progress.set_fraction(&t, w, 3.0);
    check("held to 1", progress.fraction(&t, w) == 1.0);
    progress.set_fraction(&t, w, 0.0 - 1.0);
    check("and 0", progress.fraction(&t, w) == 0.0);
    progress.set_fraction(&t, w, 0.4);
    progress.set_fraction(&t, w, 0.25);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("told: its fraction of 0 .. 1", q.has_value == 1 && q.value == 0.25 && q.min == 0.0 && q.max == 1.0 &&
          (q.states & access.BUSY) == 0 && q.actions == 0);

    // Drawn: filled to its fraction, in the middle of its height.
    layout.run(&t, cast(f64, W), cast(f64, H));
    frame(&t, &c);
    let is math.rect.Rect as tr = progress.bar(&t, w);
    let is math.rect.Rect as wr = layout.window_rect(&t, w);
    check("its bar across all of it, centred down", tr.x == wr.x && tr.w == wr.w && tr.h == k / 3.0 &&
          tr.y == wr.y + (wr.h - k / 3.0) / 2.0);
    let is i64 as y = cast(i64, tr.y + tr.h / 2.0);
    check("filled to a quarter", is8(cast(i64, tr.x + tr.w * 0.2), y, theme.track.checked.bg, 1) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.3), y, style.over(theme.track.normal.bg, theme.palette.window_bg), 1) == 1);
    layout.set_direction(&t, w, layout.RTL);
    frame(&t, &c);
    check("right to left: from the right", is8(cast(i64, tr.x + tr.w * 0.8), y, theme.track.checked.bg, 1) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.7), y, style.over(theme.track.normal.bg, theme.palette.window_bg), 1) == 1);
    layout.set_direction(&t, w, layout.INHERIT);

    // A pulse: a quarter of the bar going back and forth.
    let is anim.Animator as an = anim.init(&t);
    tree.set_animator(&t, cast(*u8, &an));
    check("pulsing", progress.pulse(&t, w) == 1 && progress.pulsing(&t, w) == 1);
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("told: busy, no value", q.has_value == 0 && (q.states & access.BUSY) != 0);
    anim.tick(&an, 0);
    check("at the start at first", progress.pulse_at(&t, w) == 0.0);
    anim.tick(&an, theme.motion.slow * 2);
    check("then going", progress.pulse_at(&t, w) > 0.0 && progress.pulse_at(&t, w) < 1.0);
    anim.tick(&an, theme.motion.slow * 4);
    check("at the far end", near(progress.pulse_at(&t, w), 1.0) == 1);
    anim.tick(&an, theme.motion.slow * 6);
    check("and back", progress.pulse_at(&t, w) > 0.0 && progress.pulse_at(&t, w) < 1.0);
    anim.tick(&an, theme.motion.slow * 8);
    check("for ever", near(progress.pulse_at(&t, w), 0.0) == 1 && anim.active(&an) == 1);
    frame(&t, &c);
    check("drawn: a quarter at its place", is8(cast(i64, tr.x + tr.w * 0.1), y, theme.track.checked.bg, 1) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.4), y, style.over(theme.track.normal.bg, theme.palette.window_bg), 1) == 1);
    anim.tick(&an, theme.motion.slow * 12);
    frame(&t, &c);
    check("at the far end: the last quarter", is8(cast(i64, tr.x + tr.w * 0.9), y, theme.track.checked.bg, 1) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.6), y, style.over(theme.track.normal.bg, theme.palette.window_bg), 1) == 1);
    layout.set_direction(&t, w, layout.RTL);
    frame(&t, &c);
    check("right to left: the first quarter", is8(cast(i64, tr.x + tr.w * 0.1), y, theme.track.checked.bg, 1) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.4), y, style.over(theme.track.normal.bg, theme.palette.window_bg), 1) == 1);
    layout.set_direction(&t, w, layout.INHERIT);
    progress.set_fraction(&t, w, 0.5);
    check("a fraction again: no pulse", progress.pulsing(&t, w) == 0 && anim.active(&an) == 0);
    tree.set_animator(&t, cast(*u8, 0));
    progress.pulse(&t, w);
    check("no animator: still, at the start", progress.pulsing(&t, w) == 1 && progress.pulse_at(&t, w) == 0.0);
    progress.set_fraction(&t, w, 0.4);
    frame(&t, &c);
    check("not a quarter: to its fraction", is8(cast(i64, tr.x + tr.w * 0.35), y, theme.track.checked.bg, 1) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.45), y, style.over(theme.track.normal.bg, theme.palette.window_bg), 1) == 1);
    progress.set_fraction(&t, w, 0.5);
    tree.set_enabled(&t, w, 0);
    frame(&t, &c);
    let is style.Look as faded = style.pick(&theme.track, painter.S_DISABLED, 1);
    let is style.Look as faded_empty = style.pick(&theme.track, painter.S_DISABLED, 0);
    check("disabled: faded, over the track faded too", is8(cast(i64, tr.x + tr.w * 0.2), y,
          style.over(faded.bg, style.over(faded_empty.bg, theme.palette.window_bg)), 2) == 1);
    tree.set_enabled(&t, w, 1);
    check("not a bar: nothing", progress.set_fraction(&t, root, 0.5) == 0 && progress.fraction(&t, root) == 0.0 &&
          progress.pulse(&t, root) == 0 && progress.pulsing(&t, root) == 0 && progress.pulse_at(&t, root) == 0.0);
    tree.destroy(&t, w);

    // --- Separators ---
    let is i64 as across = separator.create(&t, root, 0);
    check("a separator", tree.kind(&t, across).role == access.ROLE_SEPARATOR && tree.is_focusable(&t, across) == 0);
    s = measure(&t, across);
    let is f64 as bw = theme.metrics.border_width;
    check("across: a border thick, as long as it is given", s.min_h == bw && s.pref_h == bw && s.min_w == 0.0 &&
          s.max_w >= layout.UNBOUNDED);
    layout.set_align(&t, across, layout.FILL, layout.CENTER);
    layout.run(&t, cast(f64, W), cast(f64, H));
    frame(&t, &c);
    let is math.rect.Rect as sr with mut = layout.window_rect(&t, across);
    check("drawn across, in the separator colour", is8(10, cast(i64, sr.y), theme.palette.separator, 2) == 1 &&
          is8(190, cast(i64, sr.y), theme.palette.separator, 2) == 1 &&
          is8(10, cast(i64, sr.y) - 2, theme.palette.window_bg, 1) == 1);
    access.describe(&t, cast(*router.Router, 0), across, &q);
    check("told: across", (q.states & access.HORIZONTAL) != 0);
    check("set up and down", separator.set_vertical(&t, across, 1) == 1);
    s = measure(&t, across);
    check("up and down: a border wide", s.min_w == bw && s.pref_w == bw && s.min_h == 0.0);
    layout.set_align(&t, across, layout.CENTER, layout.FILL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    frame(&t, &c);
    sr = layout.window_rect(&t, across);
    check("drawn up and down", is8(cast(i64, sr.x), 5, theme.palette.separator, 2) == 1 &&
          is8(cast(i64, sr.x), 35, theme.palette.separator, 2) == 1 &&
          is8(cast(i64, sr.x) + 2, 20, theme.palette.window_bg, 1) == 1);
    access.describe(&t, cast(*router.Router, 0), across, &q);
    check("told: up and down", (q.states & access.VERTICAL) != 0);
    // Given more room than its line: in the middle of it.
    layout.set_align(&t, across, layout.FILL, layout.FILL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    frame(&t, &c);
    sr = layout.window_rect(&t, across);
    let is i64 as mx = cast(i64, sr.x + (sr.w - bw) / 2.0);
    check("up and down, in the middle across", is8(mx, 20, theme.palette.separator, 2) == 1 &&
          is8(mx + 1, 20, theme.palette.window_bg, 1) == 1 && is8(mx - 1, 20, theme.palette.window_bg, 1) == 1);
    separator.set_vertical(&t, across, 0);
    frame(&t, &c);
    let is i64 as my = cast(i64, sr.y + (sr.h - bw) / 2.0);
    check("across, in the middle down", is8(50, my, theme.palette.separator, 2) == 1 &&
          is8(50, my + 1, theme.palette.window_bg, 1) == 1 && is8(50, my - 1, theme.palette.window_bg, 1) == 1);
    check("not a separator: nothing", separator.set_vertical(&t, root, 1) == 0);

    let is tree.Limits as tl = tree.limits_default();
    tl.widgets = 1;
    let is tree.Tree as full = tree.open(&tl);
    check("no room: none", progress.create(&full, tree.root(&full)) == 0 &&
          separator.create(&full, tree.root(&full), 0) == 0);
    tree.close(&full);
    tree.close(&t);
    if (fails == 0) {
        io.printf("progress: %d checks passed\n", checks);
        return 0;
    }
    io.printf("progress: %d of %d checks failed\n", fails, checks);
    return 1;
}
