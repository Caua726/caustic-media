// ui/widgets/tableview.cst — a model's rows in columns, under a header.
//
// A table view is a list view (listview.cst) whose rows show one cell per
// column — the model's TEXT in that column, a number in its digits — under
// a header of the columns' titles. Columns are as wide as the program says,
// side by side from the start edge, and the last reaches the view's end when
// they are narrower than it; wider, the rows scroll across and the header
// with them. Everything mirrors in right to left.
//
// A column's edge in the header — its end, within GRIP — is dragged to
// resize it, never below MIN_WIDTH, unless the program says it may not be.
// A sortable column's header clicked asks for the rows sorted by it, up, and
// again the other way: the program's sort hook is called (sortmodel.hook
// sorts a sort model) and the header shows an arrow, up or down. Rows are
// chosen, typed to and activated as in any list, and the table says
// SELECTION_CHANGED and ACTIVATED too. Told as a table of table rows under
// column headers named by their titles, a sortable one pressed to sort.
use "std/mem.cst" as mem;
use "../../math/math.cst" as math;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../signal.cst" as signal;
use "../scroll.cst" as scroll;
use "../model.cst" as model;
use "../sortmodel.cst" as sortmodel;
use "label.cst" as label;
use "listview.cst" as listview;

let is i64 as MAX_COLUMNS with imut = 32;
let is f64 as MIN_WIDTH   with imut = 24.0;
let is f64 as GRIP        with imut = 4.0;   // how far into a column its edge reaches

// The rows sorted by column, order sortmodel.ASCENDING or DESCENDING:
// sort(user, column, order).
type SortFn = fn(*u8, i64, i32) as void;

struct Col {
    width     as f64;
    cell      as i64;   // its header cell
    resizable as i32;
    sortable  as i32;
}

struct Cols {
    n  as i64;
    at as [32]Col;
}

struct Data {
    t         as *tree.Tree;
    self      as i64;
    list      as i64;
    header    as i64;
    cols      as *Cols;
    sort_col  as i64;
    sort_order as i32;
    _pad0     as i32;
    hook      as SortFn;
    hook_user as *u8;
}

// A row's cells, one label per column.
struct Cells {
    owner as i64;
}

struct Head {
    owner as i64;
}

struct HCell {
    owner   as i64;
    col     as i64;
    drag    as i32;   // its edge held
    pressed as i32;
    from_x  as f64;
    from_w  as f64;
}

let is tree.Kind as _kind with mut;
let is tree.Kind as _head_kind with mut;
let is tree.Kind as _hcell_kind with mut;
let is tree.Kind as _cells_kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("table view", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.destroy = fn_ptr(_destroy);
    _head_kind = widget.kind("table header", sizeof(Head));
    _head_kind.measure = fn_ptr(_head_measure);
    _head_kind.arrange = fn_ptr(_head_arrange);
    _head_kind.paint = fn_ptr(_head_paint);
    _hcell_kind = widget.kind("column header", sizeof(HCell));
    _hcell_kind.measure = fn_ptr(_hcell_measure);
    _hcell_kind.arrange = fn_ptr(_hcell_arrange);
    _hcell_kind.paint = fn_ptr(_hcell_paint);
    _hcell_kind.event = fn_ptr(_hcell_event);
    _hcell_kind.shape = fn_ptr(_hcell_shape);
    _hcell_kind.role = access.ROLE_COLUMN_HEADER;
    _hcell_kind.access = fn_ptr(_hcell_access);
    _cells_kind = widget.kind("table cells", sizeof(Cells));
    _cells_kind.measure = fn_ptr(_cells_measure);
    _cells_kind.arrange = fn_ptr(_cells_arrange);
    _ready = 1;
}

// A new table view of m's rows, with no columns yet, as the last child of
// parent. m stays where it is while the table has it. Its handle, or 0.
fn create(t as *tree.Tree, parent as i64, m as *model.Model) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.t = t;
    d.self = w;
    d.sort_col = 0 - 1;
    d.sort_order = sortmodel.NONE;
    let is *u8 as p = mem.core.mmap_anon(sizeof(Cols));
    if (cast(i64, p) <= 0) {
        tree.destroy(t, w);
        return 0;
    }
    d.cols = cast(*Cols, p);
    d.header = tree.create(t, &_head_kind, w);
    d.list = listview.create(t, w, m);
    if (d.header == 0 || d.list == 0) {
        tree.destroy(t, w);
        return 0;
    }
    cast(*Head, tree.data(t, d.header)).owner = w;
    listview.set_horizontal(t, d.list, 1);
    listview.set_roles(t, d.list, access.ROLE_TABLE, access.ROLE_TABLE_ROW);
    listview.set_table(t, d.list, 0, d.header);
    listview.set_factory(t, d.list, fn_ptr(_setup), fn_ptr(_bind), cast(*u8, d));
    signal.connect(t, listview.area(t, d.list), signal.VALUE_CHANGED, fn_ptr(_scrolled), cast(*u8, d));
    signal.connect(t, d.list, signal.SELECTION_CHANGED, fn_ptr(_pass), cast(*u8, d));
    signal.connect(t, d.list, signal.ACTIVATED, fn_ptr(_pass_activated), cast(*u8, d));
    return w;
}

fn _destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Data as d = cast(*Data, data);
    if (cast(i64, d.cols) != 0) { mem.core.munmap(cast(*u8, d.cols), sizeof(Cols)); }
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

fn _pass(t as *tree.Tree, l as i64, arg as *u8, user as *u8) as void {
    signal.emit(t, cast(*Data, user).self, signal.SELECTION_CHANGED, arg);
}

fn _pass_activated(t as *tree.Tree, l as i64, arg as *u8, user as *u8) as void {
    signal.emit(t, cast(*Data, user).self, signal.ACTIVATED, arg);
}

// The list view its rows are in: its selection, its cursor, its rows.
fn list(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.list;
}

// --- Columns ---

// A column titled s, n bytes, width wide, at the end; its index, or -1.
fn add_column(t as *tree.Tree, w as i64, s as *u8, n as i64, width as f64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || d.cols.n >= MAX_COLUMNS) { return 0 - 1; }
    let is i64 as k = d.cols.n;
    let is i64 as cell = tree.create(t, &_hcell_kind, d.header);
    if (cell == 0) { return 0 - 1; }
    let is *HCell as hd = cast(*HCell, tree.data(t, cell));
    hd.owner = w;
    hd.col = k;
    let is i64 as l = label.create(t, cell, s, n);
    label.set_lines(t, l, 1, 1);
    tree.set_labelled_by(t, cell, l);
    d.cols.at[k].width = _clamp(width);
    d.cols.at[k].cell = cell;
    d.cols.at[k].resizable = 1;
    d.cols.at[k].sortable = 0;
    d.cols.n = k + 1;
    listview.set_table(t, d.list, d.cols.n, d.header);
    // The rows made again, a cell for each column.
    listview.set_factory(t, d.list, fn_ptr(_setup), fn_ptr(_bind), cast(*u8, d));
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    return k;
}

fn column_count(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.cols.n;
}

fn _col(t as *tree.Tree, w as i64, col as i64) as *Col {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || col < 0 || col >= d.cols.n) { return cast(*Col, 0); }
    return &d.cols.at[col];
}

fn _clamp(width as f64) as f64 {
    if (width < MIN_WIDTH) { return MIN_WIDTH; }
    return width;
}

fn column_width(t as *tree.Tree, w as i64, col as i64) as f64 {
    let is *Col as c = _col(t, w, col);
    if (cast(i64, c) == 0) { return 0.0; }
    return c.width;
}

// Column col width wide, or MIN_WIDTH when that is less.
fn set_column_width(t as *tree.Tree, w as i64, col as i64, width as f64) as void {
    let is *Col as c = _col(t, w, col);
    if (cast(i64, c) == 0) { return; }
    c.width = _clamp(width);
    _relayout(t, _data(t, w));
}

fn set_resizable(t as *tree.Tree, w as i64, col as i64, on as i32) as void {
    let is *Col as c = _col(t, w, col);
    if (cast(i64, c) == 0) { return; }
    c.resizable = on;
}

fn set_sortable(t as *tree.Tree, w as i64, col as i64, on as i32) as void {
    let is *Col as c = _col(t, w, col);
    if (cast(i64, c) == 0) { return; }
    c.sortable = on;
}

// Column col's header cell, and its title's label.
fn header_cell(t as *tree.Tree, w as i64, col as i64) as i64 {
    let is *Col as c = _col(t, w, col);
    if (cast(i64, c) == 0) { return 0; }
    return c.cell;
}

fn header_label(t as *tree.Tree, w as i64, col as i64) as i64 { return tree.first_child(t, header_cell(t, w, col)); }

// The label showing column col in row widget row; 0 for none.
fn cell_label(t as *tree.Tree, row as i64, col as i64) as i64 {
    let is i64 as ch with mut = tree.first_child(t, tree.first_child(t, row));
    let is i64 as k with mut = 0;
    while (ch != 0 && k < col) {
        ch = tree.next_sibling(t, ch);
        k = k + 1;
    }
    return ch;
}

// Every row's cells and the header laid out again.
fn _relayout(t as *tree.Tree, d as *Data) as void {
    let is i64 as body = scroll.content(t, listview.area(t, d.list));
    let is i64 as rw with mut = tree.first_child(t, body);
    while (rw != 0) {
        let is i64 as cells = tree.first_child(t, rw);
        if (cells != 0) { widget.changed(t, cells, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT); }
        rw = tree.next_sibling(t, rw);
    }
    widget.changed(t, body, widget.CHANGED_LAYOUT);
    widget.changed(t, d.header, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
}

// --- Sorting ---

fn sort_column(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0 - 1; }
    return d.sort_col;
}

fn sort_order(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return sortmodel.NONE; }
    return d.sort_order;
}

fn set_sort_hook(t as *tree.Tree, w as i64, cb as SortFn, user as *u8) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.hook = cb;
    d.hook_user = user;
}

// Sorted by col, order: shown in the header, asked of the hook.
fn set_sort(t as *tree.Tree, w as i64, col as i64, order as i32) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.sort_col = col;
    d.sort_order = order;
    // Each title's room depends on whether its column is the one sorted by.
    let is i64 as k with mut = 0;
    while (k < d.cols.n) {
        widget.changed(t, d.cols.at[k].cell, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
        k = k + 1;
    }
    if (cast(i64, d.hook) != 0) { call(d.hook, d.hook_user, col, order); }
}

// A sortable header clicked: up by it, or the other way when it was.
fn _clicked(t as *tree.Tree, d as *Data, col as i64) as void {
    let is i32 as order with mut = sortmodel.ASCENDING;
    if (d.sort_col == col && d.sort_order == sortmodel.ASCENDING) { order = sortmodel.DESCENDING; }
    set_sort(t, d.self, col, order);
}

// --- Rows ---

fn _setup(user as *u8, t as *tree.Tree, row as i64) as void {
    let is *Data as d = cast(*Data, user);
    let is i64 as cells = tree.create(t, &_cells_kind, row);
    if (cells == 0) { return; }
    cast(*Cells, tree.data(t, cells)).owner = d.self;
    let is i64 as k with mut = 0;
    while (k < d.cols.n) {
        let is i64 as l = label.create(t, cells, "", 0);
        label.set_lines(t, l, 1, 1);
        if (k == 0) { tree.set_labelled_by(t, row, l); }
        k = k + 1;
    }
}

fn _bind(user as *u8, t as *tree.Tree, row as i64, id as i64, index as i64) as void {
    let is *Data as d = cast(*Data, user);
    let is *model.Model as m = listview.model_of(t, d.list);
    let is i64 as l with mut = tree.first_child(t, tree.first_child(t, row));
    let is i64 as k with mut = 0;
    while (l != 0) {
        listview.show_text(t, l, m, id, k);
        l = tree.next_sibling(t, l);
        k = k + 1;
    }
}

// --- Measuring and arranging ---

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _rtl(t as *tree.Tree, w as i64) as i32 { return cast(i32, layout.direction(t, w) == layout.RTL); }

fn _pref(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &free, &s);
    return s;
}

fn _all(d as *Data) as f64 {
    let is f64 as x with mut = 0.0;
    let is i64 as k with mut = 0;
    while (k < d.cols.n) {
        x = x + d.cols.at[k].width;
        k = k + 1;
    }
    return x;
}

// Where column k starts across the cells, and how wide it is when the cells
// are across wide: the last reaches their end.
fn _start(d as *Data, k as i64) as f64 {
    let is f64 as x with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < k) {
        x = x + d.cols.at[i].width;
        i = i + 1;
    }
    return x;
}

fn _width(d as *Data, k as i64, across as f64) as f64 {
    if (k == d.cols.n - 1) { return _max(d.cols.at[k].width, across - _start(d, k)); }
    return d.cols.at[k].width;
}

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    let is geom.Size as hs = _pref(t, d.header);
    let is geom.Size as ls;
    layout.measure(t, d.list, c, &ls);
    geom.size_zero(out);
    out.pref_w = _max(hs.pref_w, ls.pref_w);
    out.pref_h = hs.pref_h + ls.pref_h;
    out.min_w = ls.min_w;
    out.min_h = hs.pref_h + ls.min_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is f64 as hh = _pref(t, d.header).pref_h;
    let is math.rect.Rect as hr = math.rect.rect(0.0, 0.0, r.w, hh);
    let is math.rect.Rect as lr = math.rect.rect(0.0, hh, r.w, _max(0.0, r.h - hh));
    layout.place(t, d.list, &lr);
    layout.place(t, d.header, &hr);
    _head_arrange(t, d.header, tree.data(t, d.header), &hr);
}

fn _head_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, tree.data(t, cast(*Head, data).owner));
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as h with mut = 0.0;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        h = _max(h, _pref(t, ch).pref_h);
        ch = tree.next_sibling(t, ch);
    }
    geom.size_zero(out);
    out.pref_w = 2.0 * th.metrics.control_pad_x + _all(d);
    out.pref_h = h;
    out.min_h = h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = h;
}

// Each header cell over its column, where the rows' cells are now — moved
// across with them as they scroll.
fn _head_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, tree.data(t, cast(*Head, data).owner));
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as px = th.metrics.control_pad_x;
    let is i64 as area = listview.area(t, d.list);
    let is math.rect.Rect as v = scroll.view_rect(t, area);
    let is f64 as ox = scroll.offset_x(t, area);
    let is f64 as bw with mut = layout.rect(t, scroll.content(t, area)).w;
    if (bw <= 0.0) { bw = r.w; }
    let is f64 as across = _max(0.0, bw - 2.0 * px);
    let is i32 as rtl = _rtl(t, d.self);
    let is i64 as k with mut = 0;
    while (k < d.cols.n) {
        let is f64 as cx = _start(d, k);
        let is f64 as cw = _width(d, k, across);
        let is math.rect.Rect as at with mut = math.rect.rect(v.x + px + cx - ox, 0.0, cw, r.h);
        if (rtl == 1) { at.x = v.x + v.w + ox - px - cx - cw; }
        layout.place(t, d.cols.at[k].cell, &at);
        k = k + 1;
    }
}

fn _scrolled(t as *tree.Tree, a as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    let is math.rect.Rect as hr = layout.rect(t, d.header);
    _head_arrange(t, d.header, tree.data(t, d.header), &hr);
    tree.invalidate_paint(t, d.header);
}

fn _arrow(th as *style.Theme) as f64 { return th.metrics.indicator * 0.75; }

fn _hcell_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is geom.Size as ls = _pref(t, tree.first_child(t, w));
    geom.size_zero(out);
    out.pref_w = ls.pref_w + 2.0 * th.metrics.control_pad_x;
    out.pref_h = ls.pref_h + 2.0 * th.metrics.space_xs;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// Its title from its start, leaving room for the arrow when sorted by it.
fn _hcell_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *HCell as hd = cast(*HCell, data);
    let is *Data as d = cast(*Data, tree.data(t, hd.owner));
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as px = th.metrics.control_pad_x;
    let is i64 as l = tree.first_child(t, w);
    let is geom.Size as ls = _pref(t, l);
    let is f64 as room with mut = r.w - 2.0 * px;
    if (d.sort_col == hd.col) { room = room - _arrow(&th) - th.metrics.space_xs; }
    let is math.rect.Rect as at with mut = math.rect.rect(px, (r.h - ls.pref_h) / 2.0, _max(0.0, room), ls.pref_h);
    if (_rtl(t, w) == 1) { at.x = r.w - px - at.w; }
    layout.place(t, l, &at);
}

fn _cells_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, tree.data(t, cast(*Cells, data).owner));
    let is f64 as h with mut = 0.0;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        h = _max(h, _pref(t, ch).pref_h);
        ch = tree.next_sibling(t, ch);
    }
    geom.size_zero(out);
    out.pref_w = _all(d);
    out.min_w = out.pref_w;
    out.pref_h = h;
    out.min_h = h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// Each cell in its column, padded within it.
fn _cells_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, tree.data(t, cast(*Cells, data).owner));
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as px = th.metrics.control_pad_x;
    let is i32 as rtl = _rtl(t, w);
    let is i64 as l with mut = tree.first_child(t, w);
    let is i64 as k with mut = 0;
    while (l != 0) {
        let is geom.Size as ls = _pref(t, l);
        let is f64 as cx = _start(d, k);
        let is f64 as cw = _width(d, k, r.w);
        let is math.rect.Rect as at with mut = math.rect.rect(cx + px, (r.h - ls.pref_h) / 2.0, _max(0.0, cw - 2.0 * px), ls.pref_h);
        if (rtl == 1) { at.x = r.w - cx - cw + px; }
        layout.place(t, l, &at);
        l = tree.next_sibling(t, l);
        k = k + 1;
    }
}

// --- The header's cells: resized, sorted ---

// Whether local x is at the cell's end edge — the left in right to left.
fn _at_edge(t as *tree.Tree, w as i64, x as f64) as i32 {
    let is math.rect.Rect as r = layout.rect(t, w);
    if (_rtl(t, w) == 1) { return cast(i32, x >= 0.0 && x < GRIP); }
    return cast(i32, x <= r.w && x > r.w - GRIP);
}

fn _hcell_shape(t as *tree.Tree, w as i64, data as *u8, p as *math.vec.Vec2) as i32 {
    let is *HCell as hd = cast(*HCell, data);
    let is *Data as d = cast(*Data, tree.data(t, hd.owner));
    if (hd.drag == 1 || (d.cols.at[hd.col].resizable == 1 && _at_edge(t, w, p.x) == 1)) { return tree.SHAPE_COL_RESIZE; }
    return tree.SHAPE_INHERIT;
}

fn _hcell_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *HCell as hd = cast(*HCell, data);
    let is *Data as d = cast(*Data, tree.data(t, hd.owner));
    let is *Col as c = &d.cols.at[hd.col];
    if (e.kind == event.POINTER_DOWN && e.button == 1) {
        let is math.rect.Rect as wr = layout.window_rect(t, w);
        if (c.resizable == 1 && _at_edge(t, w, e.x - wr.x) == 1) {
            hd.drag = 1;
            hd.from_x = e.x;
            hd.from_w = c.width;
        } else {
            hd.pressed = 1;
        }
        return 1;
    }
    if (e.kind == event.POINTER_MOVE && hd.drag == 1) {
        let is f64 as by with mut = e.x - hd.from_x;
        if (_rtl(t, w) == 1) { by = 0.0 - by; }
        set_column_width(t, hd.owner, hd.col, hd.from_w + by);
        return 1;
    }
    if (e.kind == event.POINTER_UP && e.button == 1) {
        let is math.rect.Rect as wr = layout.window_rect(t, w);
        let is i32 as inside = cast(i32, e.x >= wr.x && e.x < wr.x + wr.w && e.y >= wr.y && e.y < wr.y + wr.h);
        if (hd.pressed == 1 && inside == 1 && c.sortable == 1) { _clicked(t, d, hd.col); }
        hd.drag = 0;
        hd.pressed = 0;
        return 1;
    }
    return 0;
}

// --- Drawn ---

// A line under it.
fn _head_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *style.Theme as th = p.theme;
    let is f64 as bw = th.metrics.border_width;
    shapes.fill_rect(p.canvas, p.rect.x, p.rect.y + p.rect.h - bw, p.rect.w, bw, th.palette.separator);
}

// The arrow's place in column col's header cell, in the window; empty when
// the rows are not sorted by it.
fn arrow_rect(t as *tree.Tree, w as i64, col as i64) as math.rect.Rect {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || col != d.sort_col || col < 0 || col >= d.cols.n) { return math.rect.rect_zero(); }
    let is i64 as cell = d.cols.at[col].cell;
    let is style.Theme as th;
    widget.theme(t, cell, &th);
    let is math.rect.Rect as wr = layout.window_rect(t, cell);
    let is f64 as k = _arrow(&th);
    let is f64 as x with mut = wr.x + wr.w - th.metrics.control_pad_x - k;
    if (_rtl(t, cell) == 1) { x = wr.x + th.metrics.control_pad_x; }
    return math.rect.rect(x, wr.y + (wr.h - k) / 2.0, k, k);
}

// A line at its end; the arrow, up or down, when sorted by it.
fn _hcell_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *HCell as hd = cast(*HCell, data);
    let is *Data as d = cast(*Data, tree.data(t, hd.owner));
    let is *style.Theme as th = p.theme;
    let is math.rect.Rect as r = p.rect;
    let is f64 as bw = th.metrics.border_width;
    let is f64 as lx with mut = r.x + r.w - bw;
    if (_rtl(t, w) == 1) { lx = r.x; }
    shapes.fill_rect(p.canvas, lx, r.y + th.metrics.space_xs, bw, r.h - 2.0 * th.metrics.space_xs, th.palette.separator);
    p.fg = th.palette.fg;
    if (d.sort_col != hd.col || d.sort_order == sortmodel.NONE) { return; }
    let is math.rect.Rect as ar = arrow_rect(t, hd.owner, hd.col);
    let is f64 as cx = ar.x + ar.w / 2.0;
    let is f64 as cy = ar.y + ar.h / 2.0;
    let is f64 as a = ar.w * 0.4;
    let is [3]f64 as xs;
    let is [3]f64 as ys;
    if (d.sort_order == sortmodel.ASCENDING) {
        xs[0] = cx - a; ys[0] = cy + a * 0.5;
        xs[1] = cx + a; ys[1] = cy + a * 0.5;
        xs[2] = cx;     ys[2] = cy - a * 0.5;
    } else {
        xs[0] = cx - a; ys[0] = cy - a * 0.5;
        xs[1] = cx + a; ys[1] = cy - a * 0.5;
        xs[2] = cx;     ys[2] = cy + a * 0.5;
    }
    shapes.fill_convex(p.canvas, cast(*f64, &xs), cast(*f64, &ys), 3, th.palette.fg);
}

// --- Told ---

fn _hcell_access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *HCell as hd = cast(*HCell, data);
    let is *Data as d = cast(*Data, tree.data(t, hd.owner));
    if (q.action == access.ASK) {
        if (d.cols.at[hd.col].sortable == 1) { q.actions = access.PRESS; }
        return 1;
    }
    if (q.action == access.PRESS) { _clicked(t, d, hd.col); }
    return 1;
}
