// ui/widgets/menu_test.cst — the popup menu: items with mnemonics and the
// accelerators they show, separators, check and radio items, submenus;
// placed against a rectangle or the pointer, flipped and slid inside the
// window; moved through and chosen by keys and pointer, a press dragged to
// an item and let go; closed by Escape, a choice or a press outside, the
// focus put back; a submenu opened after a pause; too tall, cut and
// scrolled; drawn; told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../event.cst" as event;
use "../timer.cst" as timer;
use "../positioner.cst" as positioner;
use "../text.cst" as text;
use "label.cst" as label;
use "button.cst" as button;
use "menu.cst" as menu;

let is i64 as W with imut = 480;
let is i64 as H with imut = 400;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [192000]i32 as px with mut;
let is *router.Router as frame_router with mut;
let is i64 as frame_time with mut = 0;
let is i32 as frame_active with mut = 1;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    o.time = frame_time;
    o.active = frame_active;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}


fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn measure(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

// What a menu asks for, its margins — where the root puts it — left out.
fn content(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Size as s with mut = measure(t, w);
    let is *geom.Item as it = tree.item(t, w);
    s.pref_w = s.pref_w - it.margin_l - it.margin_r;
    s.pref_h = s.pref_h - it.margin_t - it.margin_b;
    return s;
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

// --- Signals ---

let is i64 as chosen with mut = 0;
let is i64 as choices with mut = 0;
let is i64 as closings with mut = 0;

fn on_choose(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    chosen = *cast(*i64, arg);
    choices = choices + 1;
}

fn on_closed(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { closings = closings + 1; }

fn bump(user as *u8) as void {
    let is *i64 as n = cast(*i64, user);
    *n = *n + 1;
}

// --- The menu the tests share ---

let is i64 as m with mut = 0;
let is i64 as undo with mut = 0;
let is i64 as redo with mut = 0;
let is i64 as sep with mut = 0;
let is i64 as cut with mut = 0;
let is i64 as copy with mut = 0;
let is i64 as wrap with mut = 0;
let is i64 as side_a with mut = 0;
let is i64 as side_b with mut = 0;
let is i64 as more with mut = 0;
let is i64 as close with mut = 0;
let is i64 as sub with mut = 0;
let is i64 as xray with mut = 0;
let is i64 as yes with mut = 0;

fn build(t as *tree.Tree) as void {
    m = menu.create(t);
    undo = menu.add_item(t, m, "_Undo", 5, 1);
    redo = menu.add_item(t, m, "_Redo", 5, 2);
    sep = menu.add_separator(t, m);
    cut = menu.add_item(t, m, "Cu_t", 4, 3);
    copy = menu.add_item(t, m, "_Copy", 5, 4);
    wrap = menu.add_check(t, m, "_Wrap", 5, 5, 1);
    side_a = menu.add_radio(t, m, "_A side", 7, 6, 1, 1);
    side_b = menu.add_radio(t, m, "_B side", 7, 7, 1, 0);
    sub = menu.add_submenu(t, m, "_More", 5);
    more = menu.item_of(t, sub);
    close = menu.add_item(t, m, "_Close", 6, 10);
    xray = menu.add_item(t, sub, "_X ray", 6, 8);
    yes = menu.add_item(t, sub, "_Yes", 4, 9);
    menu.set_accel(t, undo, keys.Z, keys.MOD_CONTROL);
    menu.set_accel(t, redo, keys.Z, keys.MOD_CONTROL | keys.MOD_SHIFT);
    menu.set_accel(t, copy, keys.C, keys.MOD_CONTROL);
    tree.set_enabled(t, redo, 0);
    tree.set_enabled(t, cut, 0);
    signal.connect(t, m, signal.ACTIVATED, fn_ptr(on_choose), cast(*u8, 0));
    signal.connect(t, m, signal.CLOSED, fn_ptr(on_closed), cast(*u8, 0));
}

fn accel_is(t as *tree.Tree, item as i64, s as *u8) as i32 {
    let is i64 as l = menu.accel_label(t, item);
    return same(label.text(t, l), label.text_length(t, l), s);
}

// --- Made ---

fn built() as void {
    let is tree.Tree as t = tree_for();
    build(&t);
    check("a menu, closed: under the root, hidden", m != 0 && tree.parent(&t, m) == tree.root(&t) &&
          tree.is_visible(&t, m) == 0 && menu.is_open(&t, m) == 0 && tree.kind(&t, m).role == access.ROLE_MENU);
    check("its items in it", tree.parent(&t, undo) == m && tree.parent(&t, close) == m && menu.id_of(&t, copy) == 4 &&
          menu.id_of(&t, xray) == 8);
    check("each kind told as it is", tree.kind(&t, undo).role == access.ROLE_MENU_ITEM &&
          tree.kind(&t, wrap).role == access.ROLE_CHECK_MENU_ITEM && tree.kind(&t, side_a).role == access.ROLE_RADIO_MENU_ITEM &&
          tree.kind(&t, sep).role == access.ROLE_SEPARATOR);
    check("its labels with their mnemonics", label.mnemonic(&t, menu.item_label(&t, cut)) == 116 &&
          same(label.text(&t, menu.item_label(&t, cut)), label.text_length(&t, menu.item_label(&t, cut)), "Cut") == 1);
    check("accelerators shown", accel_is(&t, undo, "Ctrl+Z") == 1 && accel_is(&t, redo, "Ctrl+Shift+Z") == 1 &&
          menu.accel_label(&t, wrap) == 0);
    menu.set_accel(&t, close, keys.F4, keys.MOD_ALT);
    check("alt and a function key", accel_is(&t, close, "Alt+F4") == 1);
    menu.set_accel(&t, close, keys.DELETE, 0);
    check("delete", accel_is(&t, close, "Delete") == 1);
    menu.set_accel(&t, close, keys.RETURN, keys.MOD_SUPER);
    check("super and enter", accel_is(&t, close, "Super+Enter") == 1);
    menu.set_accel(&t, close, keys.PAGE_UP, 0);
    check("page up", accel_is(&t, close, "Page Up") == 1);
    menu.set_accel(&t, close, keys.ESCAPE, 0);
    check("escape", accel_is(&t, close, "Esc") == 1);
    menu.set_accel(&t, close, keys.BACKSPACE, 0);
    check("backspace", accel_is(&t, close, "Backspace") == 1);
    menu.set_accel(&t, close, keys.SPACE, 0);
    check("space", accel_is(&t, close, "Space") == 1);
    menu.set_accel(&t, close, keys.NUM_1, keys.MOD_CONTROL);
    check("a digit", accel_is(&t, close, "Ctrl+1") == 1);
    menu.set_accel(&t, close, keys.COMMA, keys.MOD_CONTROL);
    check("punctuation", accel_is(&t, close, "Ctrl+,") == 1);
    menu.set_accel(&t, close, keys.F12, 0);
    check("f12", accel_is(&t, close, "F12") == 1);
    menu.set_accel(&t, close, keys.LEFT, keys.MOD_ALT);
    check("an arrow", accel_is(&t, close, "Alt+Left") == 1);
    menu.set_accel(&t, close, keys.HOME, 0);
    check("home", accel_is(&t, close, "Home") == 1);
    menu.set_accel(&t, close, keys.INSERT, keys.MOD_SHIFT);
    check("insert", accel_is(&t, close, "Shift+Insert") == 1);
    check("f1, said done", menu.set_accel(&t, close, keys.F1, 0) == 1 && accel_is(&t, close, "F1") == 1);
    menu.set_accel(&t, close, keys.F10, 0);
    check("f10", accel_is(&t, close, "F10") == 1);
    menu.set_accel(&t, close, keys.A, keys.MOD_CONTROL);
    check("a small letter: its capital", accel_is(&t, close, "Ctrl+A") == 1);
    menu.set_accel(&t, close, 33, 0);
    check("the first sign", accel_is(&t, close, "!") == 1);
    menu.set_accel(&t, close, 126, 0);
    check("the last", accel_is(&t, close, "~") == 1);
    // In the tree's language: the keys a language names, named in it.
    tree.set_language(&t, strings.PT_BR);
    menu.set_accel(&t, close, keys.SPACE, keys.MOD_CONTROL);
    check("in the tree's language", accel_is(&t, close, "Ctrl+Espaço") == 1);
    menu.set_accel(&t, close, keys.LEFT, keys.MOD_ALT);
    check("an arrow in it", accel_is(&t, close, "Alt+Esquerda") == 1);
    menu.set_accel(&t, close, keys.RIGHT, 0);
    check("each arrow", accel_is(&t, close, "Direita") == 1);
    menu.set_accel(&t, close, keys.UP, 0);
    check("up", accel_is(&t, close, "Cima") == 1);
    menu.set_accel(&t, close, keys.DOWN, keys.MOD_SHIFT);
    check("down", accel_is(&t, close, "Shift+Baixo") == 1);
    menu.set_accel(&t, close, keys.DELETE, keys.MOD_SUPER);
    check("a key named alike: alike", accel_is(&t, close, "Super+Delete") == 1);
    tree.set_language(&t, strings.EN);
    check("none again", menu.set_accel(&t, close, 0, 0) == 1 && menu.accel_label(&t, close) == 0);
    check("checked as made", menu.checked(&t, wrap) == 1 && menu.checked(&t, side_a) == 1 && menu.checked(&t, side_b) == 0);
    check("a radio checked: the rest of its group not", menu.set_checked(&t, side_b, 1) == 1 &&
          menu.checked(&t, side_a) == 0 && menu.checked(&t, side_b) == 1);
    menu.set_checked(&t, side_a, 1);
    check("a check unchecked", menu.set_checked(&t, wrap, 0) == 1 && menu.checked(&t, wrap) == 0);
    menu.set_checked(&t, wrap, 1);
    check("a submenu: inside its menu, behind its item", tree.parent(&t, sub) == m && menu.submenu_of(&t, more) == sub &&
          menu.item_of(&t, sub) == more && tree.is_visible(&t, sub) == 0);
    check("an item no submenu opens: none", menu.submenu_of(&t, copy) == 0 && menu.item_of(&t, m) == 0 &&
          menu.item_of(&t, copy) == 0);
    tree.close(&t);
}

// --- Opened and closed ---

fn opened() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as before = button.create(&t, col, "Before", 6);
    build(&t);
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, before, 1);
    router.pointer_move(&t, &r, 50.0, 40.0, 10);
    closings = 0;
    check("at the pointer", menu.popup_at_pointer(&t, &r, m) == 1 && menu.is_open(&t, m) == 1 && tree.is_visible(&t, m) == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is geom.Size as s = content(&t, m);
    let is math.rect.Rect as mr with mut = layout.window_rect(&t, m);
    check("its corner there, as big as it asks", mr.x == 50.0 && mr.y == 40.0 && mr.w == s.pref_w && mr.h == s.pref_h);
    check("above everything", tree.layer(&t, m) >= 1000);
    check("the window's input its own", router.scope(&r) == m);
    check("opened by the pointer: nothing chosen yet", router.focused(&t, &r) == m && menu.current(&t, m) == 0);
    let is geom.Size as acc = measure(&t, menu.accel_label(&t, redo));
    let is f64 as widest with mut = 0.0;
    let is i64 as ch with mut = tree.first_child(&t, m);
    while (ch != 0) {
        if (menu.item_label(&t, ch) != 0) {
            let is geom.Size as ls = measure(&t, menu.item_label(&t, ch));
            if (ls.pref_w > widest) { widest = ls.pref_w; }
        }
        ch = tree.next_sibling(&t, ch);
    }
    let is f64 as gap = theme.metrics.space_m;
    check("as wide as its columns: mark, label, keys, arrow, the padding",
          near(mr.w, 2.0 * theme.metrics.control_pad_x + theme.metrics.indicator + theme.metrics.space_s + widest + gap + acc.pref_w +
               gap + theme.fonts.body.size * 0.5 + 2.0 * theme.metrics.border_width) == 1);
    menu.close(&t, m);
    check("closed: hidden, the scope and the focus as they were", menu.is_open(&t, m) == 0 && tree.is_visible(&t, m) == 0 &&
          router.scope(&r) == 0 && router.focused(&t, &r) == before && router.focus_visible(&r) == 1 && closings == 1);
    menu.close(&t, m);
    check("closed again: nothing", closings == 1);
    router.pointer_move(&t, &r, 240.0, 40.0, 15);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("room either side: to the right", near(layout.window_rect(&t, m).x, 240.0) == 1);
    menu.close(&t, m);
    // Kept inside the window: flipped from its edges.
    router.pointer_move(&t, &r, cast(f64, W) - 10.0, 40.0, 20);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    mr = layout.window_rect(&t, m);
    check("near the right edge: to the left of the pointer", near(mr.x, cast(f64, W) - 10.0 - s.pref_w) == 1);
    menu.close(&t, m);
    router.pointer_move(&t, &r, 50.0, cast(f64, H) - 10.0, 30);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    mr = layout.window_rect(&t, m);
    check("near the bottom: above it", near(mr.y, cast(f64, H) - 10.0 - s.pref_h) == 1);
    menu.close(&t, m);
    // Against a rectangle, the first item chosen: as by the keyboard.
    check("against a rectangle", menu.popup_at(&t, &r, m, math.rect.rect(100.0, 100.0, 40.0, 20.0), positioner.BOTTOM_LEFT,
          positioner.BOTTOM_RIGHT, 1) == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    mr = layout.window_rect(&t, m);
    check("below it", mr.x == 100.0 && mr.y == 120.0);
    check("its first item chosen", menu.current(&t, m) == undo && router.focused(&t, &r) == undo && router.focus_visible(&r) == 1);
    check("opened again where it is: moved", menu.popup_at(&t, &r, m, math.rect.rect(10.0, 10.0, 4.0, 4.0), positioner.BOTTOM_LEFT,
          positioner.BOTTOM_RIGHT, 0) == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("there", layout.window_rect(&t, m).x == 10.0 && router.scope(&r) == m);
    menu.close(&t, m);
    check("and the scope and focus from before the first", router.scope(&r) == 0 && router.focused(&t, &r) == before);
    // Inside a scope of the program's: given back.
    router.set_scope(&t, &r, col);
    menu.popup_at_pointer(&t, &r, m);
    check("a scope inside a scope", router.scope(&r) == m);
    menu.close(&t, m);
    check("the program's given back", router.scope(&r) == col);
    router.set_scope(&t, &r, 0);
    check("a submenu is not popped up", menu.popup_at(&t, &r, sub, math.rect.rect(10.0, 10.0, 4.0, 4.0), positioner.BOTTOM_LEFT,
          positioner.BOTTOM_RIGHT, 0) == 0);
    // Right to left: growing leftwards from the pointer.
    layout.set_direction(&t, root, layout.RTL);
    router.pointer_move(&t, &r, 300.0, 50.0, 40);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("right to left: to the pointer's left", near(layout.window_rect(&t, m).x + layout.window_rect(&t, m).w, 300.0) == 1);
    menu.close(&t, m);
    layout.set_direction(&t, root, layout.LTR);
    // Destroyed while open: the scope given back.
    menu.popup_at_pointer(&t, &r, m);
    tree.destroy(&t, m);
    check("destroyed open: no scope left behind", router.scope(&r) == 0);
    tree.close(&t);
}

// --- Keys ---

let is i64 as saves with mut = 0;

fn keyed() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as before = button.create(&t, root, "Before", 6);
    build(&t);
    let is router.Router as r = router.init(router.settings_default());
    router.add_shortcut(&r, keys.S, keys.MOD_CONTROL, fn_ptr(bump), cast(*u8, &saves));
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, before, 1);
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 20.0, 10.0, 10.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    key(&t, &r, keys.DOWN, 0, 10);
    check("down: past what is disabled and the separator", menu.current(&t, m) == copy);
    key(&t, &r, keys.DOWN, 0, 20);
    check("down again", menu.current(&t, m) == wrap);
    key(&t, &r, keys.UP, 0, 30);
    check("up", menu.current(&t, m) == copy);
    key(&t, &r, keys.END, 0, 40);
    check("end: the last", menu.current(&t, m) == close);
    key(&t, &r, keys.DOWN, 0, 50);
    check("down from the last: the first", menu.current(&t, m) == undo);
    key(&t, &r, keys.UP, 0, 60);
    check("up from the first: the last", menu.current(&t, m) == close);
    key(&t, &r, keys.HOME, 0, 70);
    check("home: the first", menu.current(&t, m) == undo);
    saves = 0;
    key(&t, &r, keys.S, keys.MOD_CONTROL, 80);
    check("the window's shortcuts: not while it is open", saves == 0 && menu.is_open(&t, m) == 1);
    // Mnemonics, no Alt needed: one item, chosen; several, gone through.
    key(&t, &r, keys.C, 0, 90);
    check("a letter two items share: to the next", menu.current(&t, m) == copy && menu.is_open(&t, m) == 1);
    key(&t, &r, keys.C, 0, 100);
    check("and the next", menu.current(&t, m) == close);
    key(&t, &r, keys.C, 0, 110);
    check("round again", menu.current(&t, m) == copy);
    choices = 0;
    closings = 0;
    key(&t, &r, keys.W, 0, 120);
    check("a letter one item has: chosen", choices == 1 && chosen == 5 && menu.checked(&t, wrap) == 0 &&
          menu.is_open(&t, m) == 0 && closings == 1);
    check("closed: the focus back", router.focused(&t, &r) == before && router.scope(&r) == 0);
    key(&t, &r, keys.S, keys.MOD_CONTROL, 130);
    check("closed: the window's shortcuts again", saves == 1);
    // Enter and space choose; a radio its group.
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 20.0, 10.0, 10.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    key(&t, &r, keys.B, keys.MOD_ALT, 140);
    check("alt and a letter: the same", chosen == 7 && menu.checked(&t, side_b) == 1 && menu.checked(&t, side_a) == 0);
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 20.0, 10.0, 10.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    key(&t, &r, keys.DOWN, 0, 150);
    key(&t, &r, keys.RETURN, 0, 160);
    check("enter: chosen", chosen == 4 && menu.is_open(&t, m) == 0);
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 20.0, 10.0, 10.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    key(&t, &r, keys.SPACE, 0, 170);
    check("space: chosen", chosen == 1 && menu.is_open(&t, m) == 0);
    // Escape: closed, nothing chosen.
    choices = 0;
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 20.0, 10.0, 10.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    key(&t, &r, keys.ESCAPE, 0, 180);
    check("escape: closed, nothing chosen", menu.is_open(&t, m) == 0 && choices == 0);
    // A submenu: right opens it, its first item chosen; left closes it.
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 20.0, 10.0, 10.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    key(&t, &r, keys.M, 0, 190);
    check("its item's letter: its submenu opened, its first chosen", menu.is_open(&t, sub) == 1 && menu.current(&t, sub) == xray &&
          router.focused(&t, &r) == xray && choices == 0);
    check("in its menu, its item still the one chosen", menu.current(&t, m) == more);
    key(&t, &r, keys.DOWN, 0, 191);
    key(&t, &r, keys.RIGHT, 0, 192);
    check("towards the end on what opens nothing: nothing", menu.is_open(&t, sub) == 1 && router.focused(&t, &r) == yes);
    key(&t, &r, keys.C, 0, 193);
    check("a letter it has nothing for: nothing, not its menu's", menu.is_open(&t, sub) == 1 && router.focused(&t, &r) == yes &&
          choices == 0);
    key(&t, &r, keys.UP, 0, 194);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as mr = layout.window_rect(&t, m);
    let is math.rect.Rect as sr = layout.window_rect(&t, sub);
    let is math.rect.Rect as ir = layout.window_rect(&t, more);
    check("beside its item, its first item level with it", near(sr.x, ir.x + ir.w) == 1 &&
          near(layout.window_rect(&t, xray).y, ir.y) == 1 && tree.layer(&t, sub) > tree.layer(&t, m));
    key(&t, &r, keys.LEFT, 0, 200);
    check("left: closed, back on its item", menu.is_open(&t, sub) == 0 && menu.is_open(&t, m) == 1 &&
          router.focused(&t, &r) == more);
    key(&t, &r, keys.RIGHT, 0, 210);
    check("right: opened", menu.is_open(&t, sub) == 1 && router.focused(&t, &r) == xray);
    key(&t, &r, keys.ESCAPE, 0, 220);
    check("escape in it: it alone closed", menu.is_open(&t, sub) == 0 && menu.is_open(&t, m) == 1 &&
          router.focused(&t, &r) == more);
    key(&t, &r, keys.RETURN, 0, 230);
    key(&t, &r, keys.DOWN, 0, 240);
    key(&t, &r, keys.RETURN, 0, 250);
    check("chosen in it: its id, all of it closed", chosen == 9 && menu.is_open(&t, sub) == 0 && menu.is_open(&t, m) == 0 &&
          router.focused(&t, &r) == before);
    // Right to left: the other way.
    layout.set_direction(&t, root, layout.RTL);
    menu.popup_at(&t, &r, m, math.rect.rect(337.0, 20.0, 0.0, 10.0), positioner.BOTTOM_RIGHT, positioner.BOTTOM_LEFT, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    key(&t, &r, keys.END, 0, 260);
    key(&t, &r, keys.UP, 0, 270);
    key(&t, &r, keys.LEFT, 0, 280);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("right to left, room either side: left opens it, on the left", menu.is_open(&t, sub) == 1 &&
          near(layout.window_rect(&t, sub).x + layout.window_rect(&t, sub).w, layout.window_rect(&t, more).x) == 1);
    key(&t, &r, keys.RIGHT, 0, 290);
    check("right closes it", menu.is_open(&t, sub) == 0);
    menu.close(&t, m);
    layout.set_direction(&t, root, layout.LTR);
    tree.close(&t);
}

// --- The pointer ---

fn pointed() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as before = button.create(&t, root, "Before", 6);
    layout.set_align(&t, before, layout.START, layout.START);
    build(&t);
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, before, 0);
    router.pointer_move(&t, &r, 20.0, 60.0, 10);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.pointer_move(&t, &r, mid_x(&t, copy), mid_y(&t, copy), 20);
    check("hovered: chosen, no ring", menu.current(&t, m) == copy && router.focus_visible(&r) == 0);
    router.pointer_move(&t, &r, mid_x(&t, cut), mid_y(&t, cut), 30);
    check("over what is disabled: the choice kept", menu.current(&t, m) == copy);
    choices = 0;
    click(&t, &r, mid_x(&t, cut), mid_y(&t, cut), 40);
    click(&t, &r, mid_x(&t, sep), mid_y(&t, sep), 1000);
    check("a click on what is disabled, or a separator: nothing", choices == 0 && menu.is_open(&t, m) == 1);
    click(&t, &r, mid_x(&t, copy), mid_y(&t, copy), 2000);
    check("a click: chosen, closed", choices == 1 && chosen == 4 && menu.is_open(&t, m) == 0 &&
          router.focused(&t, &r) == before);
    // A press outside: closed, spent.
    router.pointer_move(&t, &r, 20.0, 60.0, 3000);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    closings = 0;
    choices = 0;
    click(&t, &r, cast(f64, W) - 5.0, cast(f64, H) - 5.0, 4000);
    check("a press outside: closed, nothing chosen", menu.is_open(&t, m) == 0 && closings == 1 && choices == 0);
    // Pressed, opened, dragged to an item, let go: chosen.
    router.pointer_move(&t, &r, 20.0, 60.0, 5000);
    router.pointer_button(&t, &r, 3, 1, 20.0, 60.0, 5000);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.pointer_move(&t, &r, mid_x(&t, copy), mid_y(&t, copy), 5100);
    router.pointer_button(&t, &r, 3, 0, mid_x(&t, copy), mid_y(&t, copy), 5200);
    check("pressed, dragged, let go: chosen", choices == 1 && chosen == 4 && menu.is_open(&t, m) == 0);
    // Dragged straight down onto an item: chosen.
    router.pointer_move(&t, &r, 20.0, 60.0, 5500);
    router.pointer_button(&t, &r, 3, 1, 20.0, 60.0, 5500);
    menu.popup_at(&t, &r, m, math.rect.rect(10.0, 50.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    choices = 0;
    router.pointer_move(&t, &r, 20.0, mid_y(&t, copy), 5550);
    router.pointer_button(&t, &r, 3, 0, 20.0, mid_y(&t, copy), 5600);
    check("dragged straight down, let go: chosen", choices == 1 && chosen == 4);
    // Let go at once, where it was pressed: it stays.
    router.pointer_move(&t, &r, 20.0, 60.0, 6000);
    router.pointer_button(&t, &r, 3, 1, 20.0, 60.0, 6000);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.pointer_button(&t, &r, 3, 0, 20.0, 60.0, 6050);
    check("let go at once: it stays open", menu.is_open(&t, m) == 1);
    click(&t, &r, mid_x(&t, undo), mid_y(&t, undo), 7000);
    check("and is chosen from as ever", chosen == 1 && menu.is_open(&t, m) == 0);
    // Let go without a press of its own: nothing.
    router.pointer_move(&t, &r, 20.0, 60.0, 7100);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    choices = 0;
    router.pointer_move(&t, &r, mid_x(&t, copy), mid_y(&t, copy), 7200);
    router.pointer_button(&t, &r, 1, 0, mid_x(&t, copy), mid_y(&t, copy), 7300);
    check("a release from nowhere: nothing", choices == 0 && menu.is_open(&t, m) == 1);
    // Pressed on one item, let go on another: that one.
    router.pointer_button(&t, &r, 1, 1, mid_x(&t, copy), mid_y(&t, copy), 7400);
    router.pointer_move(&t, &r, mid_x(&t, wrap), mid_y(&t, wrap), 7410);
    router.pointer_button(&t, &r, 1, 0, mid_x(&t, wrap), mid_y(&t, wrap), 7420);
    check("pressed on one, let go on another: that one", choices == 1 && chosen == 5);
    menu.set_checked(&t, wrap, 1);
    // Opened under the pointer onto an item, let go at once: nothing; held
    // a while: chosen.
    router.pointer_move(&t, &r, 100.0, 100.0, 7500);
    router.pointer_button(&t, &r, 3, 1, 100.0, 100.0, 7500);
    menu.popup_at(&t, &r, m, math.rect.rect(90.0, 80.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as under = router.hit(&t, 100.0, 100.0);
    check("an item under the pointer", menu.id_of(&t, under) != 0 || menu.id_of(&t, tree.parent(&t, under)) != 0);
    choices = 0;
    router.pointer_button(&t, &r, 3, 0, 100.0, 100.0, 7550);
    check("let go at once on it: nothing", choices == 0 && menu.is_open(&t, m) == 1);
    menu.close(&t, m);
    router.pointer_button(&t, &r, 3, 1, 100.0, 100.0, 8000);
    menu.popup_at(&t, &r, m, math.rect.rect(90.0, 80.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.pointer_button(&t, &r, 3, 0, 100.0, 100.0, 8700);
    check("held a while on it, let go: chosen", choices == 1 && menu.is_open(&t, m) == 0);
    // A submenu: no timers lent, opened as the pointer comes.
    router.pointer_move(&t, &r, 20.0, 60.0, 8000);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.pointer_move(&t, &r, mid_x(&t, more), mid_y(&t, more), 8100);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("over its item: opened, the choice still its item", menu.is_open(&t, sub) == 1 && menu.current(&t, m) == more &&
          router.focused(&t, &r) == more);
    router.pointer_move(&t, &r, mid_x(&t, yes), mid_y(&t, yes), 8200);
    check("into it: chosen there", menu.current(&t, sub) == yes);
    click(&t, &r, mid_x(&t, yes), mid_y(&t, yes), 8300);
    check("clicked there: its id, all closed", chosen == 9 && menu.is_open(&t, m) == 0 && menu.is_open(&t, sub) == 0);
    // With timers: after a pause.
    let is timer.Timers as ts = timer.init();
    tree.set_timers(&t, cast(*u8, &ts));
    router.pointer_move(&t, &r, 20.0, 60.0, 9000);
    menu.popup_at_pointer(&t, &r, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.pointer_move(&t, &r, mid_x(&t, more), mid_y(&t, more), 9100);
    check("timers lent: not yet", menu.is_open(&t, sub) == 0 && menu.current(&t, m) == more);
    timer.fire(&ts, 9100 + menu.DELAY_MS - 1);
    check("not before the pause", menu.is_open(&t, sub) == 0);
    timer.fire(&ts, 9100 + menu.DELAY_MS);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("after it: opened", menu.is_open(&t, sub) == 1);
    router.pointer_move(&t, &r, mid_x(&t, copy), mid_y(&t, copy), 9500);
    check("another item: still open a while", menu.is_open(&t, sub) == 1 && menu.current(&t, m) == copy);
    router.pointer_move(&t, &r, mid_x(&t, copy) + 1.0, mid_y(&t, copy), 9600);
    timer.fire(&ts, 9500 + menu.DELAY_MS);
    check("then closed, the pause counted from the first move", menu.is_open(&t, sub) == 0);
    check("the choice where the pointer is", menu.current(&t, m) == copy && router.focused(&t, &r) == copy);
    router.pointer_move(&t, &r, mid_x(&t, more), mid_y(&t, more), 10000);
    timer.fire(&ts, 10000 + menu.DELAY_MS);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.pointer_move(&t, &r, mid_x(&t, close), mid_y(&t, close), 10500);
    router.pointer_move(&t, &r, mid_x(&t, xray), mid_y(&t, xray), 10600);
    timer.fire(&ts, 10500 + menu.DELAY_MS);
    check("passing over another on the way into it: kept open", menu.is_open(&t, sub) == 1 && menu.current(&t, sub) == xray);
    menu.close(&t, m);
    check("closed with a pause pending: nothing left due", timer.next_due(&ts) == 0 - 1);
    tree.set_timers(&t, cast(*u8, 0));
    tree.close(&t);
}

// --- A plain menu's measures ---

fn measured() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as pm = menu.create(&t);
    let is i64 as one = menu.add_item(&t, pm, "_One", 4, 1);
    let is i64 as sp = menu.add_separator(&t, pm);
    let is i64 as two = menu.add_item(&t, pm, "_Two words", 10, 2);
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    menu.popup_at(&t, &r, pm, math.rect.rect(20.0, 20.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is f64 as px = theme.metrics.control_pad_x;
    let is f64 as bw = theme.metrics.border_width;
    let is geom.Size as ls = measure(&t, menu.item_label(&t, two));
    let is math.rect.Rect as mr = layout.window_rect(&t, pm);
    check("nothing checked, no submenu, no keys: as wide as its widest label and the padding",
          near(mr.w, 2.0 * px + ls.pref_w + 2.0 * bw) == 1);
    let is math.rect.Rect as ir = layout.window_rect(&t, one);
    let is math.rect.Rect as lr = layout.window_rect(&t, menu.item_label(&t, one));
    check("a label in the padding, in the middle down", near(lr.x, ir.x + px) == 1 && near(lr.y + lr.h / 2.0, ir.y + ir.h / 2.0) == 1);
    check("a separator a line and its space tall", near(layout.window_rect(&t, sp).h, 2.0 * theme.metrics.space_xs + 1.0) == 1);
    menu.close(&t, pm);
    // Right to left: the label at the far side, the keys at the near.
    menu.set_accel(&t, two, keys.T, keys.MOD_CONTROL);
    layout.set_direction(&t, tree.root(&t), layout.RTL);
    menu.popup_at(&t, &r, pm, math.rect.rect(300.0, 20.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_LEFT, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ir2 = layout.window_rect(&t, two);
    let is math.rect.Rect as lr2 = layout.window_rect(&t, menu.item_label(&t, two));
    let is math.rect.Rect as ar2 = layout.window_rect(&t, menu.accel_label(&t, two));
    check("right to left: the label at the right, the keys at the left", near(lr2.x + lr2.w, ir2.x + ir2.w - px) == 1 &&
          near(ar2.x, ir2.x + px) == 1);
    check("the keys in the middle down", near(ar2.y + ar2.h / 2.0, ir2.y + ir2.h / 2.0) == 1);
    menu.close(&t, pm);
    layout.set_direction(&t, tree.root(&t), layout.LTR);
    let is i64 as ck = menu.add_check(&t, pm, "_Check", 6, 3, 0);
    menu.popup_at(&t, &r, pm, math.rect.rect(20.0, 20.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("a check item among them: every label after a mark's room",
          near(layout.window_rect(&t, menu.item_label(&t, one)).x, layout.window_rect(&t, one).x + px + theme.metrics.indicator +
               theme.metrics.space_s) == 1 && ck != 0);
    menu.close(&t, pm);
    tree.close(&t);
}

// --- Letters shared, digits, submenus inside submenus ---

fn many() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as q = menu.create(&t);
    let is i64 as alpha = menu.add_item(&t, q, "_Alpha", 6, 1);
    let is i64 as atlas = menu.add_item(&t, q, "A_tlas", 6, 2);
    menu.add_item(&t, q, "_Atlas", 6, 2);
    let is i64 as amber = menu.add_item(&t, q, "_Amber", 6, 3);
    menu.add_item(&t, q, "_0 zero", 7, 4);
    menu.add_item(&t, q, "_9 nine", 7, 5);
    menu.add_item(&t, q, "_Zed", 4, 6);
    let is i64 as f = menu.add_submenu(&t, q, "_First", 6);
    let is i64 as first = menu.item_of(&t, f);
    let is i64 as sec = menu.add_submenu(&t, q, "_Second", 7);
    let is i64 as second = menu.item_of(&t, sec);
    let is i64 as fi = menu.add_submenu(&t, f, "_Inner", 6);
    let is i64 as fine = menu.add_item(&t, f, "F_ine", 5, 8);
    menu.add_item(&t, fi, "_Deep", 5, 7);
    menu.add_item(&t, sec, "_Sole", 5, 9);
    signal.connect(&t, q, signal.ACTIVATED, fn_ptr(on_choose), cast(*u8, 0));
    let is i64 as atlas2 = tree.next_sibling(&t, atlas);
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    menu.popup_at(&t, &r, q, math.rect.rect(20.0, 20.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    key(&t, &r, keys.A, 0, 10);
    check("three share a letter: on to the second", menu.current(&t, q) == atlas2);
    key(&t, &r, keys.A, 0, 20);
    check("the third", menu.current(&t, q) == amber);
    key(&t, &r, 65, 0, 30);
    check("a capital, the same: round to the first", menu.current(&t, q) == alpha);
    choices = 0;
    key(&t, &r, keys.NUM_0, 0, 40);
    check("a digit: chosen", chosen == 4 && menu.is_open(&t, q) == 0);
    menu.popup_at(&t, &r, q, math.rect.rect(20.0, 20.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 1);
    key(&t, &r, keys.NUM_9, 0, 50);
    check("the last digit", chosen == 5);
    menu.popup_at(&t, &r, q, math.rect.rect(20.0, 20.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 1);
    key(&t, &r, 90, 0, 60);
    check("the last letter, a capital", chosen == 6);
    // Submenus inside submenus.
    menu.popup_at(&t, &r, q, math.rect.rect(20.0, 20.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    key(&t, &r, keys.F, 0, 70);
    key(&t, &r, keys.RIGHT, 0, 80);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("one inside another", menu.is_open(&t, f) == 1 && menu.is_open(&t, fi) == 1 && tree.layer(&t, fi) > tree.layer(&t, f));
    key(&t, &r, keys.ESCAPE, 0, 90);
    check("escape: the inner one alone", menu.is_open(&t, fi) == 0 && menu.is_open(&t, f) == 1 &&
          menu.current(&t, f) == menu.item_of(&t, fi));
    key(&t, &r, keys.RIGHT, 0, 100);
    key(&t, &r, keys.LEFT, 0, 101);
    check("left in the inner one: it alone closed", menu.is_open(&t, fi) == 0 && menu.is_open(&t, f) == 1);
    key(&t, &r, keys.RIGHT, 0, 102);
    layout.run(&t, cast(f64, W), cast(f64, H));
    // Another submenu of its menu opened by the pointer: the first closed,
    // the one inside it with it.
    router.pointer_move(&t, &r, mid_x(&t, second), mid_y(&t, second), 110);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the pointer on another's item: that one open, the other closed with what it had open",
          menu.is_open(&t, sec) == 1 && menu.is_open(&t, f) == 0 && menu.is_open(&t, fi) == 0 && tree.is_visible(&t, fi) == 0);
    key(&t, &r, keys.DOWN, 0, 120);
    check("a key moving on: the open one closed", menu.is_open(&t, sec) == 0);
    router.pointer_move(&t, &r, mid_x(&t, first), mid_y(&t, first), 130);
    check("open again", menu.is_open(&t, f) == 1);
    key(&t, &r, keys.A, 0, 140);
    check("a letter several share: the open one closed", menu.is_open(&t, f) == 0 && menu.current(&t, q) == alpha);
    router.pointer_move(&t, &r, mid_x(&t, first), mid_y(&t, first), 150);
    check("open once more", menu.is_open(&t, f) == 1);
    menu.popup_at(&t, &r, q, math.rect.rect(30.0, 30.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_RIGHT, 0);
    check("popped up again: what it had open closed", menu.is_open(&t, f) == 0 && menu.is_open(&t, q) == 1);
    menu.close(&t, q);
    check("an item letter it marks nowhere", fine != 0);
    tree.close(&t);
}

// --- Drawn ---

// Pixels in x0 .. x1, y0 .. y1 that are col.
fn matching(x0 as i64, x1 as i64, y0 as i64, y1 as i64, col as math.color.Color) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as y with mut = y0;
    while (y < y1) {
        let is i64 as x with mut = x0;
        while (x < x1) {
            if (is8(x, y, col, 24) == 1) { n = n + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

// Pixels in x0 .. x1, y0 .. y1 that are not col.
fn inked(x0 as i64, x1 as i64, y0 as i64, y1 as i64, col as math.color.Color) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as y with mut = y0;
    while (y < y1) {
        let is i64 as x with mut = x0;
        while (x < x1) {
            if (is8(x, y, col, 8) == 0) { n = n + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    build(&t);
    let is router.Router as r = router.init(router.settings_default());
    frame_router = &r;
    layout.run(&t, cast(f64, W), cast(f64, H));
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 20.0, 1.0, 1.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    key(&t, &r, keys.DOWN, 0, 10);
    frame(&t, c);
    let is math.rect.Rect as mr = layout.window_rect(&t, m);
    let is math.color.Color as bg = style.over(theme.palette.popover_bg, theme.palette.window_bg);
    check("a popover's background", is8(cast(i64, mr.x + mr.w / 2.0), cast(i64, mr.y + 2.0), bg, 2) == 1);
    let is math.rect.Rect as cr = layout.window_rect(&t, copy);
    let is math.color.Color as hi = style.over(theme.row.checked.bg, bg);
    check("the item chosen: a row's chosen look", is8(cast(i64, cr.x + 2.0), cast(i64, cr.y + 2.0), hi, 3) == 1);
    let is math.rect.Rect as ur = layout.window_rect(&t, undo);
    check("the rest: not", is8(cast(i64, ur.x + 2.0), cast(i64, ur.y + 2.0), bg, 3) == 1);
    let is math.rect.Rect as al = layout.window_rect(&t, menu.accel_label(&t, undo));
    let is math.rect.Rect as wide = layout.window_rect(&t, menu.item_label(&t, side_a));
    check("its keys past the widest label", al.x > wide.x + wide.w);
    check("its accelerator at the end, drawn", al.x + al.w > ur.x + ur.w * 0.6 &&
          inked(cast(i64, al.x), cast(i64, al.x + al.w), cast(i64, al.y), cast(i64, al.y + al.h), bg) > 0);
    let is math.rect.Rect as ll = layout.window_rect(&t, menu.item_label(&t, undo));
    let is i64 as ind_x0 = cast(i64, ur.x + 3.0);
    let is i64 as ind_x1 = cast(i64, ll.x - 1.0);
    let is math.rect.Rect as wr = layout.window_rect(&t, wrap);
    check("a check mark before what is checked", inked(ind_x0, ind_x1, cast(i64, wr.y), cast(i64, wr.y + wr.h), bg) > 0);
    check("none before a plain item", inked(ind_x0, ind_x1, cast(i64, ur.y), cast(i64, ur.y + ur.h), bg) == 0);
    let is math.rect.Rect as ar = layout.window_rect(&t, side_a);
    let is math.rect.Rect as br = layout.window_rect(&t, side_b);
    check("a dot before the radio on, none before the one off",
          inked(ind_x0, ind_x1, cast(i64, ar.y), cast(i64, ar.y + ar.h), bg) > 0 &&
          inked(ind_x0, ind_x1, cast(i64, br.y), cast(i64, br.y + br.h), bg) == 0);
    let is math.rect.Rect as mo = layout.window_rect(&t, more);
    check("an arrow at a submenu's item's end", inked(cast(i64, mo.x + mo.w - 20.0), cast(i64, mo.x + mo.w - 2.0),
          cast(i64, mo.y), cast(i64, mo.y + mo.h), bg) > 0 &&
          inked(cast(i64, ur.x + ur.w - 20.0), cast(i64, ur.x + ur.w - 2.0), cast(i64, ur.y), cast(i64, ur.y + ur.h), bg) == 0);
    let is math.rect.Rect as sr = layout.window_rect(&t, sep);
    let is f64 as ss = theme.metrics.space_s;
    check("a separator's line, in from the sides", inked(cast(i64, sr.x + ss + 1.0), cast(i64, sr.x + sr.w - ss - 1.0),
          cast(i64, sr.y), cast(i64, sr.y + sr.h), bg) > 0 &&
          inked(cast(i64, sr.x + 1.0), cast(i64, sr.x + ss - 1.0), cast(i64, sr.y), cast(i64, sr.y + sr.h), bg) == 0 &&
          inked(cast(i64, sr.x + sr.w - ss + 1.0), cast(i64, sr.x + sr.w - 1.0), cast(i64, sr.y), cast(i64, sr.y + sr.h), bg) == 0);
    // Its text: the chosen row's in its colour, a disabled one faded.
    let is math.rect.Rect as cl = layout.window_rect(&t, menu.item_label(&t, copy));
    check("the chosen row's text in its colour", matching(cast(i64, cl.x), cast(i64, cl.x + cl.w), cast(i64, cl.y),
          cast(i64, cl.y + cl.h), style.over(theme.row.checked.fg, hi)) > 0 &&
          matching(cast(i64, cl.x), cast(i64, cl.x + cl.w), cast(i64, cl.y), cast(i64, cl.y + cl.h), theme.palette.fg) == 0);
    let is math.rect.Rect as kl = layout.window_rect(&t, menu.item_label(&t, cut));
    check("a disabled item's faded", inked(cast(i64, kl.x), cast(i64, kl.x + kl.w), cast(i64, kl.y), cast(i64, kl.y + kl.h), bg) > 0 &&
          matching(cast(i64, kl.x), cast(i64, kl.x + kl.w), cast(i64, kl.y), cast(i64, kl.y + kl.h), theme.palette.fg) == 0);
    let is math.rect.Rect as ul = layout.window_rect(&t, menu.item_label(&t, undo));
    check("the rest in the text colour", matching(cast(i64, ul.x), cast(i64, ul.x + ul.w), cast(i64, ul.y), cast(i64, ul.y + ul.h),
          theme.palette.fg) > 0);
    // Its submenu open, the focus in it: its item still lit.
    key(&t, &r, keys.M, 0, 20);
    frame(&t, c);
    check("the item of the submenu open: lit", is8(cast(i64, mo.x + 2.0), cast(i64, mo.y + 2.0), hi, 3) == 1);
    key(&t, &r, keys.ESCAPE, 0, 30);
    menu.close(&t, m);
    frame(&t, c);
    check("closed: gone", is8(cast(i64, mr.x + mr.w / 2.0), cast(i64, mr.y + 2.0), theme.palette.window_bg, 2) == 1);
    // Right to left: the check mark at the right, the arrow at the left.
    layout.set_direction(&t, tree.root(&t), layout.RTL);
    menu.popup_at(&t, &r, m, math.rect.rect(400.0, 20.0, 0.0, 0.0), positioner.TOP_LEFT, positioner.BOTTOM_LEFT, 0);
    frame(&t, c);
    let is math.rect.Rect as wr2 = layout.window_rect(&t, wrap);
    let is math.rect.Rect as wl2 = layout.window_rect(&t, menu.item_label(&t, wrap));
    check("right to left: the mark after the label", inked(cast(i64, wl2.x + wl2.w + 1.0), cast(i64, wr2.x + wr2.w - 3.0),
          cast(i64, wr2.y), cast(i64, wr2.y + wr2.h), bg) > 0);
    let is math.rect.Rect as mo2 = layout.window_rect(&t, more);
    check("its arrow at the left", inked(cast(i64, mo2.x + 2.0), cast(i64, mo2.x + 20.0), cast(i64, mo2.y),
          cast(i64, mo2.y + mo2.h), bg) > 0);
    menu.close(&t, m);
    layout.set_direction(&t, tree.root(&t), layout.LTR);
    frame_router = cast(*router.Router, 0);
    tree.close(&t);
}

// --- Too tall ---

fn tall() as void {
    let is tree.Tree as t = tree_for();
    build(&t);
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), 120.0);
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 10.0, 1.0, 1.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    layout.run(&t, cast(f64, W), 120.0);
    layout.set_max_size(&t, m, layout.UNBOUNDED, layout.UNBOUNDED);
    let is f64 as whole = content(&t, m).pref_h;
    layout.set_max_size(&t, m, layout.window_rect(&t, m).w, layout.window_rect(&t, m).h);
    let is math.rect.Rect as mr = layout.window_rect(&t, m);
    check("taller than the window: cut to it", mr.y >= 0.0 && mr.y + mr.h <= 120.0 && mr.h < whole);
    check("its first item at its top", menu.scroll(&t, m) == 0.0);
    key(&t, &r, keys.END, 0, 10);
    layout.run(&t, cast(f64, W), 120.0);
    let is math.rect.Rect as cl = layout.window_rect(&t, close);
    check("the last chosen: scrolled into view", menu.scroll(&t, m) > 0.0 && cl.y + cl.h <= mr.y + mr.h + 0.01 &&
          cl.y >= mr.y);
    let is f64 as at_end = menu.scroll(&t, m);
    key(&t, &r, keys.UP, 0, 15);
    layout.run(&t, cast(f64, W), 120.0);
    check("up to what shows: not moved", near(menu.scroll(&t, m), at_end) == 1);
    key(&t, &r, keys.HOME, 0, 20);
    layout.run(&t, cast(f64, W), 120.0);
    check("the first: back", menu.scroll(&t, m) == 0.0);
    let is f64 as pad = theme.metrics.space_xs + theme.metrics.border_width;
    key(&t, &r, keys.DOWN, 0, 21);
    key(&t, &r, keys.DOWN, 0, 22);
    key(&t, &r, keys.DOWN, 0, 23);
    key(&t, &r, keys.DOWN, 0, 24);
    layout.run(&t, cast(f64, W), 120.0);
    let is i64 as cur = menu.current(&t, m);
    let is math.rect.Rect as cr = layout.window_rect(&t, cur);
    check("down out of view: just into it", menu.scroll(&t, m) > 0.0 && near(cr.y + cr.h, mr.y + mr.h - pad) == 1);
    key(&t, &r, keys.HOME, 0, 25);
    layout.run(&t, cast(f64, W), 120.0);
    router.scroll(&t, &r, mr.x + 10.0, mr.y + 20.0, 0.0, 2.0, 1, 30);
    layout.run(&t, cast(f64, W), 120.0);
    let is f64 as down = menu.scroll(&t, m);
    check("the wheel: scrolled", down > 0.0);
    router.scroll(&t, &r, mr.x + 10.0, mr.y + 20.0, 0.0, 0.0 - 50.0, 1, 40);
    check("not past its start", menu.scroll(&t, m) == 0.0);
    router.scroll(&t, &r, mr.x + 10.0, mr.y + 20.0, 0.0, 50.0, 1, 50);
    check("nor its end", near(menu.scroll(&t, m), whole - mr.h) == 1);
    menu.close(&t, m);
    tree.close(&t);
}

// --- Told; not a menu ---

// --- Beside others: a menu bar's ---

let is i64 as sideways with mut = 0;
let is f64 as out_x with mut = 0.0;
let is i64 as outs with mut = 0;

fn on_side(user as *u8, dir as i32) as void { sideways = sideways * 10 + cast(i64, dir + 2); }
fn on_out(user as *u8, x as f64, y as f64) as void {
    outs = outs + 1;
    out_x = x;
}

fn beside() as void {
    let is tree.Tree as t = tree_for();
    build(&t);
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    menu.set_sideways(&t, m, fn_ptr(on_side), cast(*u8, 0));
    menu.set_outside(&t, m, fn_ptr(on_out), cast(*u8, 0));
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 20.0, 10.0, 10.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    sideways = 0;
    key(&t, &r, keys.RIGHT, 0, 10);
    check("right on an item with nothing to open: on to the next menu", sideways == 3 && menu.is_open(&t, m) == 1);
    key(&t, &r, keys.LEFT, 0, 20);
    check("left at the top: back to the one before", sideways == 31);
    // Its submenu: right opens it, left closes it, neither goes sideways.
    key(&t, &r, keys.END, 0, 30);
    key(&t, &r, keys.UP, 0, 31);
    sideways = 0;
    key(&t, &r, keys.RIGHT, 0, 40);
    check("right on a submenu's item: it opens", menu.is_open(&t, sub) == 1 && sideways == 0);
    key(&t, &r, keys.RIGHT, 0, 50);
    check("right inside the submenu, nothing to open: on to the next menu", sideways == 3);
    key(&t, &r, keys.LEFT, 0, 60);
    check("left inside it: it closes, nothing sideways", menu.is_open(&t, sub) == 0 && sideways == 3);
    // The pointer outside it: told where.
    let is math.rect.Rect as mr = layout.window_rect(&t, m);
    router.pointer_move(&t, &r, mr.x + mr.w + 30.0, mr.y + 5.0, 70);
    router.pointer_move(&t, &r, mr.x + mr.w + 40.0, mr.y + 5.0, 80);
    check("the pointer outside it: told where", outs >= 1 && out_x == mr.x + mr.w + 40.0);
    key(&t, &r, keys.ESCAPE, 0, 90);
    // Right to left: left is on.
    layout.set_direction(&t, m, layout.RTL);
    menu.popup_at(&t, &r, m, math.rect.rect(200.0, 20.0, 10.0, 10.0), positioner.BOTTOM_RIGHT, positioner.BOTTOM_LEFT, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    sideways = 0;
    key(&t, &r, keys.LEFT, 0, 100);
    key(&t, &r, keys.RIGHT, 0, 110);
    check("right to left: left on, right back", sideways == 31);
    key(&t, &r, keys.ESCAPE, 0, 120);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    build(&t);
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is tree.Access as q;
    access.describe(&t, &r, wrap, &q);
    check("a check item: checkable, checked, named", (q.states & access.CHECKABLE) != 0 && (q.states & access.CHECKED) != 0 &&
          same(q.name, q.name_len, "Wrap") == 1 && (q.actions & access.PRESS) != 0);
    access.describe(&t, &r, side_b, &q);
    check("a radio off: checkable, not checked", (q.states & access.CHECKABLE) != 0 && (q.states & access.CHECKED) == 0);
    access.describe(&t, &r, undo, &q);
    check("a plain item: neither", (q.states & access.CHECKABLE) == 0);
    access.describe(&t, &r, more, &q);
    check("a submenu's item: expandable, not expanded", (q.states & access.EXPANDABLE) != 0 && (q.states & access.EXPANDED) == 0);
    menu.popup_at(&t, &r, m, math.rect.rect(20.0, 20.0, 1.0, 1.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    key(&t, &r, keys.M, 0, 10);
    access.describe(&t, &r, more, &q);
    check("its submenu open: expanded", (q.states & access.EXPANDED) != 0);
    choices = 0;
    check("chosen by assistive technology", access.act(&t, xray, access.PRESS, 0.0) == 1 && choices == 1 && chosen == 8 &&
          menu.is_open(&t, m) == 0);
    check("not a menu: nothing", menu.add_item(&t, xray, "x", 1, 1) == 0 && menu.add_separator(&t, xray) == 0 &&
          menu.add_check(&t, xray, "x", 1, 1, 0) == 0 && menu.add_radio(&t, xray, "x", 1, 1, 1, 0) == 0 &&
          menu.add_submenu(&t, xray, "x", 1) == 0 && menu.popup_at_pointer(&t, &r, xray) == 0 &&
          menu.is_open(&t, xray) == 0 && menu.current(&t, xray) == 0 && menu.scroll(&t, xray) == 0.0);
    check("not an item: nothing", menu.set_accel(&t, m, keys.A, 0) == 0 && menu.accel_label(&t, m) == 0 &&
          menu.item_label(&t, m) == 0 && menu.set_checked(&t, m, 1) == 0 && menu.checked(&t, m) == 0 &&
          menu.id_of(&t, m) == 0 && menu.submenu_of(&t, m) == 0);
    menu.close(&t, xray);
    tree.close(&t);
    let is tree.Limits as tiny = tree.limits_default();
    tiny.widgets = 1;
    let is tree.Tree as full = tree.open(&tiny);
    check("no room: no menu", menu.create(&full) == 0);
    tree.close(&full);
    tiny.widgets = 3;
    let is tree.Tree as tight = tree.open(&tiny);
    let is i64 as tm = menu.create(&tight);
    check("no room for an item's parts: none", tm != 0 && menu.add_item(&tight, tm, "x", 1, 1) == 0 &&
          tree.live_count(&tight) == 2);
    tree.close(&tight);
    tiny.widgets = 2;
    let is tree.Tree as tighter = tree.open(&tiny);
    let is i64 as tm2 = menu.create(&tighter);
    check("no room for an item: none", tm2 != 0 && menu.add_item(&tighter, tm2, "x", 1, 1) == 0 &&
          menu.add_check(&tighter, tm2, "x", 1, 1, 1) == 0 && menu.add_radio(&tighter, tm2, "x", 1, 1, 1, 1) == 0 &&
          menu.add_separator(&tighter, tm2) == 0);
    tree.close(&tighter);
    tiny.widgets = 4;
    let is tree.Tree as tight4 = tree.open(&tiny);
    let is i64 as tm3 = menu.create(&tight4);
    check("no room for a submenu: no item for it", tm3 != 0 && menu.add_submenu(&tight4, tm3, "x", 1) == 0 &&
          tree.live_count(&tight4) == 2);
    tree.close(&tight4);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 20.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    built();
    opened();
    keyed();
    pointed();
    measured();
    many();
    drawn(&c);
    tall();
    told();
    beside();

    if (fails == 0) {
        io.printf("menu: %d checks passed\n", checks);
        return 0;
    }
    io.printf("menu: %d of %d checks failed\n", fails, checks);
    return 1;
}
