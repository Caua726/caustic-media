// ui/widgets/progress.cst — how far something has gone.
//
// A bar across all of what it is given, a third of the theme's indicator
// thick, filled from its start — from the right, right to left — to a
// fraction. When there is no fraction to show, a pulse: a quarter of the bar
// going back and forth for as long as it is pulsing, one way in four of the
// theme's slow durations, through the window's animator (still, at the
// start, with none lent). Assistive technology hears the fraction, or that it
// is busy.
use "../../math/math.cst" as math;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../anim.cst" as anim;

struct Data {
    fraction as f64;
    pos      as f64;   // the pulse: 0 at the start, 1 at the end
    tween    as i64;   // the pulse's, 0 for none
    pulsing  as i32;
    _pad0    as i32;
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("progress", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.paint = fn_ptr(_paint);
    _kind.role = access.ROLE_PROGRESS_BAR;
    _kind.access = fn_ptr(_access);
    _ready = 1;
}

// A new progress bar, empty, as the last child of parent. Its handle, or 0
// with the tree's last_error set.
fn create(t as *tree.Tree, parent as i64) as i64 {
    _init();
    return tree.create(t, &_kind, parent);
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

fn _stop(t as *tree.Tree, d as *Data) as void {
    let is *anim.Animator as an = cast(*anim.Animator, tree.animator(t));
    if (d.tween != 0 && cast(i64, an) != 0) { anim.cancel(an, d.tween); }
    d.tween = 0;
    d.pulsing = 0;
}

// Filled to f, held to 0 .. 1, pulsing no more. Each returns 1, or 0 for a
// widget that is no progress bar.
fn set_fraction(t as *tree.Tree, w as i64, f as f64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    _stop(t, d);
    let is f64 as x with mut = f;
    if (x > 1.0) { x = 1.0; }
    if (x < 0.0) { x = 0.0; }
    d.fraction = x;
    widget.changed(t, w, widget.CHANGED_PAINT);
    return 1;
}

fn fraction(t as *tree.Tree, w as i64) as f64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0.0; }
    return d.fraction;
}

// No fraction to show: the pulse, until a fraction is set.
fn pulse(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    _stop(t, d);
    d.pulsing = 1;
    d.pos = 0.0;
    let is *anim.Animator as an = cast(*anim.Animator, tree.animator(t));
    if (cast(i64, an) != 0) {
        d.tween = anim.number(an, w, &d.pos, 1.0, tree.theme(t).motion.slow * 4, anim.THEME_EASE);
        anim.set_repeat(an, d.tween, 0, 1);
    }
    widget.changed(t, w, widget.CHANGED_PAINT);
    return 1;
}

fn pulsing(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.pulsing;
}

// Where the pulse is: 0 at the start, 1 at the end.
fn pulse_at(t as *tree.Tree, w as i64) as f64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0.0; }
    return d.pos;
}

fn _bar_in(rc as math.rect.Rect, th as *style.Theme) as math.rect.Rect {
    let is f64 as h = th.metrics.indicator / 3.0;
    return math.rect.rect(rc.x, rc.y + (rc.h - h) / 2.0, rc.w, h);
}

// Its bar, in the window; nothing for a widget that is no progress bar.
fn bar(t as *tree.Tree, w as i64) as math.rect.Rect {
    if (cast(i64, _data(t, w)) == 0) { return math.rect.rect_zero(); }
    let is style.Theme as th;
    widget.theme(t, w, &th);
    return _bar_in(layout.window_rect(t, w), &th);
}

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as k = th.metrics.indicator;
    out.min_w = 3.0 * k;
    out.pref_w = 10.0 * k;
    out.min_h = k / 3.0;
    out.pref_h = k / 3.0;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Data as d = cast(*Data, data);
    let is math.rect.Rect as b = _bar_in(p.rect, p.theme);
    let is style.Look as empty = style.pick(&p.theme.track, p.state, 0);
    let is style.Look as full = style.pick(&p.theme.track, p.state, 1);
    let is f64 as rad = b.h / 2.0;
    shapes.fill_rounded(p.canvas, b.x, b.y, b.w, b.h, rad, rad, rad, rad, empty.bg);
    let is f64 as from with mut = 0.0;
    let is f64 as len with mut = b.w * d.fraction;
    if (d.pulsing == 1) {
        len = b.w / 4.0;
        from = d.pos * (b.w - len);
    }
    if (p.rtl == 1) { from = b.w - from - len; }
    if (len > 0.0) { shapes.fill_rounded(p.canvas, b.x + from, b.y, len, b.h, rad, rad, rad, rad, full.bg); }
}

fn _access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Data as d = cast(*Data, data);
    if (q.action != access.ASK) { return 0; }
    if (d.pulsing == 1) {
        q.states = q.states | access.BUSY;
    } else {
        access.set_range(q, d.fraction, 0.0, 1.0, 0.0);
    }
    return 1;
}
