// ui/widgets/expander.cst — a title that shows or hides what is under it.
//
// A chevron and a title along the top — the chevron at the start, so at the
// right in right to left — and under them, while expanded, what it holds: an
// overlay the program fills (content()). Closed, it is only as tall as its
// title, and what it holds is hidden through the tree.
//
// Turned by a press on its title, by Space or Enter while it has the focus,
// by Alt and its title's mnemonic, by assistive technology; each turn says
// TOGGLED. The chevron points along the line when closed — the way the line
// reads — and down when open, a small triangle. Told as a button that expands, named by its
// title.
use "../../math/math.cst" as math;
use "../../window/keys.cst" as keys;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../stack.cst" as stack;
use "label.cst" as label;

struct Data {
    title    as i64;
    content  as i64;
    expanded as i32;
    _pad0    as i32;
    head     as f64;   // the title's row's height, as last measured
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("expander", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.paint = fn_ptr(_paint);
    _kind.event = fn_ptr(_event);
    _kind.role = access.ROLE_BUTTON;
    _kind.access = fn_ptr(_access);
    _ready = 1;
}

// A new, closed expander titled s — n bytes, an underscore before its
// mnemonic — as the last child of parent. Its handle, or 0.
fn create(t as *tree.Tree, parent as i64, s as *u8, n as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.title = label.create(t, w, "", 0);
    d.content = stack.create_overlay(t, w);
    if (d.title == 0 || d.content == 0) {
        tree.destroy(t, w);
        return 0;
    }
    label.set_text_mnemonic(t, d.title, s, n);
    label.set_target(t, d.title, w);
    tree.set_labelled_by(t, w, d.title);
    tree.set_visible(t, d.content, 0);
    tree.set_focusable(t, w, 1);
    return w;
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

// Where what it holds goes: an overlay, each child aligned on its own.
fn content(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.content;
}

// Its title: a label.
fn title(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.title;
}

fn expanded(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.expanded;
}

// Open (1) or closed (0). 1 if it turned.
fn set_expanded(t as *tree.Tree, w as i64, on as i32) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || on == d.expanded) { return 0; }
    d.expanded = on;
    tree.set_visible(t, d.content, on);
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    signal.emit(t, w, signal.TOGGLED, cast(*u8, 0));
    return 1;
}

// Alt and its title's mnemonic turn it, from now on.
fn bind_mnemonic(t as *tree.Tree, r as *router.Router, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return label.bind_mnemonic(t, r, d.title);
}

// --- Measuring and arranging ---

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _chevron(th as *style.Theme) as f64 { return th.metrics.indicator; }

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    layout.measure(t, d.title, &free, &ls);
    let is f64 as head = _max(th.metrics.control_height, ls.pref_h);
    let is f64 as across = _chevron(&th) + th.metrics.space_s + ls.pref_w;
    d.head = head;
    geom.size_zero(out);
    out.min_w = across;
    out.pref_w = across;
    out.min_h = head;
    out.pref_h = head;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
    if (d.expanded == 1) {
        let is geom.Constraint as rest = geom.constraint(c.w, layout.UNBOUNDED);
        let is geom.Size as cs;
        layout.measure(t, d.content, &rest, &cs);
        out.min_w = _max(out.min_w, cs.min_w);
        out.pref_w = _max(out.pref_w, cs.pref_w);
        out.min_h = head + cs.min_h;
        out.pref_h = head + cs.pref_h;
    }
}

fn _rtl(t as *tree.Tree, w as i64) as i32 { return cast(i32, layout.direction(t, w) == layout.RTL); }

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    layout.measure(t, d.title, &free, &ls);
    let is f64 as head = _max(th.metrics.control_height, ls.pref_h);
    d.head = head;
    let is f64 as lx = _chevron(&th) + th.metrics.space_s;
    let is math.rect.Rect as lr with mut = math.rect.rect(lx, (head - ls.pref_h) / 2.0, ls.pref_w, ls.pref_h);
    if (_rtl(t, w) == 1) { lr.x = r.w - lx - ls.pref_w; }
    layout.place(t, d.title, &lr);
    if (d.expanded == 1) {
        let is math.rect.Rect as cr = math.rect.rect(0.0, head, r.w, _max(0.0, r.h - head));
        layout.place(t, d.content, &cr);
    }
}

// The chevron's square, in the widget: at the start of the title's row.
fn _chevron_at(t as *tree.Tree, w as i64, d as *Data, th as *style.Theme) as math.rect.Rect {
    let is f64 as k = _chevron(th);
    let is math.rect.Rect as r = layout.rect(t, w);
    let is math.rect.Rect as at with mut = math.rect.rect(0.0, (d.head - k) / 2.0, k, k);
    if (_rtl(t, w) == 1) { at.x = r.w - k; }
    return at;
}

// The chevron's square, in the window.
fn chevron_rect(t as *tree.Tree, w as i64) as math.rect.Rect {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return math.rect.rect_zero(); }
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is math.rect.Rect as c = _chevron_at(t, w, d, &th);
    let is math.rect.Rect as wr = layout.window_rect(t, w);
    return math.rect.rect(wr.x + c.x, wr.y + c.y, c.w, c.h);
}

// --- Turned ---

fn _turn(t as *tree.Tree, w as i64, d as *Data) as void { set_expanded(t, w, 1 - d.expanded); }

fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Data as d = cast(*Data, data);
    if (e.kind == event.POINTER_DOWN && e.button == 1) {
        // Presses in what it holds are not its own.
        if (e.local_y >= d.head) { return 0; }
        _turn(t, w, d);
        return 1;
    }
    if (e.kind == event.ACTIVATE) {
        _turn(t, w, d);
        let is *router.Router as r = cast(*router.Router, tree.router(t));
        if (cast(i64, r) != 0) { router.focus(t, r, w, 1); }
        return 1;
    }
    if (e.kind == event.KEY_DOWN && e.phase == event.TARGET && e.mods == 0 &&
        (e.key == keys.SPACE || e.key == keys.RETURN)) {
        _turn(t, w, d);
        return 1;
    }
    return 0;
}

// --- Drawn ---

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Data as d = cast(*Data, data);
    let is *style.Theme as th = p.theme;
    let is math.rect.Rect as c = _chevron_at(t, w, d, th);
    let is f64 as x = p.rect.x + c.x + c.w / 2.0;
    let is f64 as y = p.rect.y + c.y + c.h / 2.0;
    let is f64 as a = c.w * 0.3;
    let is [3]f64 as xs;
    let is [3]f64 as ys;
    if (d.expanded == 1) {
        xs[0] = x - a; ys[0] = y - a * 0.5;
        xs[1] = x + a; ys[1] = y - a * 0.5;
        xs[2] = x;     ys[2] = y + a * 0.5;
    } else {
        let is f64 as dir with mut = 1.0;
        if (_rtl(t, w) == 1) { dir = 0.0 - 1.0; }
        xs[0] = x - dir * a * 0.5; ys[0] = y - a;
        xs[1] = x + dir * a * 0.5; ys[1] = y;
        xs[2] = x - dir * a * 0.5; ys[2] = y + a;
    }
    let is math.color.Color as ink with mut = p.fg;
    if (ink.a <= 0.0) { ink = th.palette.fg; }
    shapes.fill_convex(p.canvas, cast(*f64, &xs), cast(*f64, &ys), 3, ink);
    // The focus ring round the title's row, not what it holds.
    if ((p.state & painter.S_FOCUS_VISIBLE) != 0) {
        let is f64 as rad = th.metrics.focus_radius;
        shapes.stroke_rounded(p.canvas, p.rect.x, p.rect.y, p.rect.w, d.head, rad, rad, rad, rad,
                              th.metrics.focus_width, th.palette.focus);
        p.focus_drawn = 1;
    }
}

// --- Told ---

fn _access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Data as d = cast(*Data, data);
    if (q.action == access.ASK) {
        q.states = q.states | access.EXPANDABLE;
        q.actions = access.PRESS | access.EXPAND;
        if (d.expanded == 1) {
            q.states = q.states | access.EXPANDED;
            q.actions = access.PRESS | access.COLLAPSE;
        }
        return 1;
    }
    if (q.action == access.PRESS) { _turn(t, w, d); }
    if (q.action == access.EXPAND) { set_expanded(t, w, 1); }
    if (q.action == access.COLLAPSE) { set_expanded(t, w, 0); }
    return 1;
}
