// ui/widgets/listview_test.cst — a list view: a model's rows, only those seen
// made; chosen by pointer and keys; found by typing; following the model's
// changes; drawn; told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "label.cst" as label;
use "../event.cst" as event;
use "../scroll.cst" as scroll;
use "../model.cst" as model;
use "listview.cst" as listview;
use "image.cst" as image;
use "../icons.cst" as icons;
use "../dnd.cst" as dnd;

let is i64 as W with imut = 400;
let is i64 as H with imut = 240;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}


// --- A model: rows by id, inserted and removed at will ---
//
// Ids under 100 are fruits by name; from 1000 up, "Row k" for id 1000 + k;
// from 5000 up the number id - 6000.
struct Items {
    n   as i64;
    ids as [4096]i64;
}

let is Items as items with mut;
let is model.Model as m with mut;
let is [32]u8 as namebuf with mut;

fn fruit(id as i64) as *u8 {
    if (id == 1) { return "apple"; }
    if (id == 2) { return "apricot"; }
    if (id == 3) { return "banana"; }
    if (id == 4) { return "blueberry"; }
    if (id == 5) { return "cherry"; }
    if (id == 6) { return "date"; }
    if (id == 7) { return "Bilberry"; }
    if (id == 9) { return "dab"; }
    return "zucchini";
}

fn length(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn items_count(self as *u8, parent as i64) as i64 {
    if (parent != 0) { return 0; }
    return items.n;
}

fn items_row_id(self as *u8, parent as i64, index as i64) as i64 {
    if (parent != 0 || index < 0 || index >= items.n) { return 0; }
    return items.ids[index];
}

// Icons, when on: apple's (one of the toolkit's), blueberry's (a texture of
// the program's); no other fruit has one.
let is i32 as icons_on with mut = 0;
let is i64 as apple_icon with mut = 0;

fn items_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    if (role == model.ICON && column == 0 && icons_on == 1) {
        if (id == 1 && apple_icon != 0) {
            *out = model.integer(apple_icon);
            return 1;
        }
        if (id == 4) {
            *out = model.handle(77);
            return 1;
        }
        // Apricot's is the integer 0: no icon at all.
        if (id == 2) {
            *out = model.integer(0);
            return 1;
        }
        return 0;
    }
    if (role != model.TEXT || column != 0) { return 0; }
    if (id < 100) {
        *out = model.text(fruit(id), length(fruit(id)));
        return 1;
    }
    if (id >= 5000) {
        *out = model.integer(id - 6000);
        return 1;
    }
    let is i64 as k = id - 1000;
    let is *u8 as p = cast(*u8, &namebuf);
    p[0] = cast(u8, 82);
    p[1] = cast(u8, 111);
    p[2] = cast(u8, 119);
    p[3] = cast(u8, 32);
    let is [8]u8 as dg;
    let is i64 as nd with mut = 0;
    let is i64 as x with mut = k;
    if (x == 0) {
        dg[0] = cast(u8, 48);
        nd = 1;
    }
    while (x > 0) {
        dg[nd] = cast(u8, 48 + x % 10);
        nd = nd + 1;
        x = x / 10;
    }
    let is i64 as i with mut = 0;
    while (i < nd) {
        p[4 + i] = dg[nd - 1 - i];
        i = i + 1;
    }
    *out = model.text(p, 4 + nd);
    return 1;
}

// Eight fruits, a number, and one more.
fn fruits() as void {
    items.n = 10;
    let is i64 as i with mut = 0;
    while (i < 8) {
        items.ids[i] = i + 1;
        i = i + 1;
    }
    items.ids[8] = 6007;
    items.ids[9] = 9;
}

fn rows(n as i64) as void {
    items.n = n;
    let is i64 as i with mut = 0;
    while (i < n) {
        items.ids[i] = 1000 + i;
        i = i + 1;
    }
}

// count new rows, ids from id on, at first.
fn insert(first as i64, count as i64, id as i64) as void {
    let is i64 as i with mut = items.n - 1;
    while (i >= first) {
        items.ids[i + count] = items.ids[i];
        i = i - 1;
    }
    i = 0;
    while (i < count) {
        items.ids[first + i] = id + i;
        i = i + 1;
    }
    items.n = items.n + count;
    model.inserted(&m, 0, first, count);
}

fn remove(first as i64, count as i64) as void {
    let is i64 as i with mut = first;
    while (i + count < items.n) {
        items.ids[i] = items.ids[i + count];
        i = i + 1;
    }
    items.n = items.n - count;
    model.removed(&m, 0, first, count);
}

let is i64 as changes with mut = 0;
let is i64 as activated with mut = 0;
let is i64 as activations with mut = 0;

fn on_change(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { changes = changes + 1; }

let is i64 as defaults with mut = 0;
fn on_default(user as *u8) as void { defaults = defaults + 1; }

fn on_activate(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    activated = *cast(*i64, arg);
    activations = activations + 1;
}

// The text row index shows, as its row widget has it.
fn shows(t as *tree.Tree, lv as i64, index as i64, s as *u8) as i32 {
    let is i64 as rw = listview.row_widget(t, lv, index);
    if (rw == 0) { return 0; }
    let is i64 as l = tree.first_child(t, rw);
    return same(label.text(t, l), label.text_length(t, l), s);
}

// The model's icons at the start of their rows, the text after them; a row
// with none shows none.
fn iconed() as void {
    let is tree.Tree as t = tree_for();
    fruits();
    icons_on = 1;
    apple_icon = cast(i64, icons.DOCUMENT);
    let is i64 as lv = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is f64 as pad = theme.metrics.control_pad_x;
    let is i64 as r0 = listview.row_widget(&t, lv, 0);
    let is i64 as r1 = listview.row_widget(&t, lv, 1);
    let is i64 as i0 = listview.row_icon(&t, r0);
    let is math.rect.Rect as rr = layout.window_rect(&t, r0);
    let is math.rect.Rect as ir = layout.window_rect(&t, i0);
    let is math.rect.Rect as lr = layout.window_rect(&t, tree.first_child(&t, r0));
    check("the model's icon at its row's start, in its middle", i0 != 0 && image.icon(&t, i0) == icons.DOCUMENT &&
          tree.is_hidden_here(&t, i0) == 0 && near(ir.x, rr.x + pad) == 1 && near(ir.w, listview.ICON_SIZE) == 1 &&
          near(ir.h, listview.ICON_SIZE) == 1 && near(ir.y + ir.h / 2.0, rr.y + rr.h / 2.0) == 1);
    check("its text after it", shows(&t, lv, 0, "apple") == 1 && near(lr.x, ir.x + ir.w + theme.metrics.space_m) == 1 &&
          near(lr.x + lr.w, rr.x + rr.w - pad) == 1);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as rs;
    layout.measure(&t, r0, &free, &rs);
    let is geom.Size as ls;
    layout.measure(&t, tree.first_child(&t, r0), &free, &ls);
    check("as wide as its icon and text would like, padded",
          near(rs.pref_w, ls.pref_w + listview.ICON_SIZE + theme.metrics.space_m + 2.0 * pad) == 1);
    let is i64 as i1 = listview.row_icon(&t, r1);
    let is math.rect.Rect as l1 = layout.window_rect(&t, tree.first_child(&t, r1));
    check("none: none shown, its text at the start", i1 != 0 && tree.is_hidden_here(&t, i1) == 1 &&
          near(l1.x, layout.window_rect(&t, r1).x + pad) == 1);
    let is i64 as i3 = listview.row_icon(&t, listview.row_widget(&t, lv, 3));
    check("a texture of the program's", image.icon(&t, i3) == 0 && image.texture(&t, i3) == 77 && tree.is_hidden_here(&t, i3) == 0);
    // The model's icon changed, then gone.
    apple_icon = cast(i64, icons.FOLDER);
    model.changed(&m, 0, 0, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as j0 with mut = listview.row_icon(&t, listview.row_widget(&t, lv, 0));
    check("its icon changed: the new one", image.icon(&t, j0) == icons.FOLDER && tree.is_hidden_here(&t, j0) == 0);
    apple_icon = 0;
    model.changed(&m, 0, 0, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    j0 = listview.row_icon(&t, listview.row_widget(&t, lv, 0));
    check("its icon gone: hidden", tree.is_hidden_here(&t, j0) == 1);
    // Right to left: the icon at the right, the text before it.
    apple_icon = cast(i64, icons.DOCUMENT);
    model.changed(&m, 0, 0, 1);
    layout.set_direction(&t, lv, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as q0 = listview.row_widget(&t, lv, 0);
    let is math.rect.Rect as qr = layout.window_rect(&t, q0);
    let is math.rect.Rect as qi = layout.window_rect(&t, listview.row_icon(&t, q0));
    let is math.rect.Rect as ql = layout.window_rect(&t, tree.first_child(&t, q0));
    check("right to left: the icon at the right, the text before it", near(qi.x + qi.w, qr.x + qr.w - pad) == 1 &&
          near(ql.x + ql.w, qi.x - theme.metrics.space_m) == 1 && near(ql.x, qr.x + pad) == 1);
    // Rows of the program's making have no icon of the list's.
    check("not a row: no icon", listview.row_icon(&t, lv) == 0);
    icons_on = 0;
    tree.close(&t);
}

fn made(t as *tree.Tree) as i64 {
    let is i64 as lv = listview.create(t, tree.root(t), &m);
    signal.connect(t, lv, signal.SELECTION_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    signal.connect(t, lv, signal.ACTIVATED, fn_ptr(on_activate), cast(*u8, 0));
    return lv;
}

// The middle of row index, in the window.
fn row_y(t as *tree.Tree, lv as i64, index as i64) as f64 {
    let is i64 as rw = listview.row_widget(t, lv, index);
    let is math.rect.Rect as r = layout.window_rect(t, rw);
    return r.y + r.h / 2.0;
}

fn row_x(t as *tree.Tree, lv as i64) as f64 { return layout.window_rect(t, lv).x + 20.0; }

fn press(t as *tree.Tree, r as *router.Router, x as f64, y as f64, mods as i32, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    if ((mods & keys.MOD_CONTROL) != 0) { router.key(t, r, keys.CONTROL_L, mods, 1, 0, time); }
    if ((mods & keys.MOD_SHIFT) != 0) { router.key(t, r, keys.SHIFT_L, mods, 1, 0, time); }
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
    if ((mods & keys.MOD_CONTROL) != 0) { router.key(t, r, keys.CONTROL_L, 0, 0, 0, time + 2); }
    if ((mods & keys.MOD_SHIFT) != 0) { router.key(t, r, keys.SHIFT_L, 0, 0, 0, time + 2); }
}

// What gets past it, to its parent.
let is i64 as caught with mut = 0;
let is i64 as menus with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase == event.BUBBLE && (e.kind == event.KEY_DOWN || e.kind == event.POINTER_DOWN)) {
        caught = caught + 1;
        return 1;
    }
    if (e.phase == event.BUBBLE && e.kind == event.CONTEXT_MENU) {
        menus = menus + 1;
        return 1;
    }
    return 0;
}

fn catch_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catch_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as catcher with mut;

fn held(t as *tree.Tree) as i64 {
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(t, &catcher, tree.root(t));
    let is i64 as lv = listview.create(t, holder, &m);
    signal.connect(t, lv, signal.SELECTION_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    signal.connect(t, lv, signal.ACTIVATED, fn_ptr(on_activate), cast(*u8, 0));
    return lv;
}

// A key pressed: whether something took it.
fn took(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as i32 {
    let is i32 as done = router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
    return done;
}

fn button_at(t as *tree.Tree, r as *router.Router, b as i32, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, b, 1, x, y, time);
    router.pointer_button(t, r, b, 0, x, y, time + 1);
}

// --- Only the rows seen made ---

fn shown() as void {
    let is tree.Tree as t = tree_for();
    rows(2000);
    let is i64 as lv = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as body = scroll.content(&t, tree.first_child(&t, lv));
    let is f64 as rh = listview.row_height(&t, lv);
    check("two thousand rows, a few widgets", listview.count(&t, lv) == 2000 && rh > 0.0 && tree.child_count(&t, body) < 20 &&
          tree.child_count(&t, body) >= cast(i64, cast(f64, H) / rh));
    check("the first rows, in order, one under another", shows(&t, lv, 0, "Row 0") == 1 && shows(&t, lv, 1, "Row 1") == 1 &&
          near(row_y(&t, lv, 1) - row_y(&t, lv, 0), rh) == 1);
    check("the whole list as tall as its rows", near(layout.rect(&t, body).h, 2000.0 * rh) == 1);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    layout.measure(&t, lv, &free, &ls);
    let is geom.Size as cs;
    layout.measure(&t, tree.first_child(&t, listview.row_widget(&t, lv, 0)), &free, &cs);
    check("as wide as a row would like", near(ls.pref_w, cs.pref_w + 2.0 * theme.metrics.control_pad_x) == 1);
    listview.scroll_to_row(&t, lv, 1000);
    let is tree.Access as fq;
    access.describe(&t, cast(*router.Router, 0), listview.row_widget(&t, lv, 1000), &fq);
    check("a row far down: told its own place among all", fq.row == 1000 && fq.rows == 2000);
    check("scrolled: those in view now", shows(&t, lv, 1000, "Row 1000") == 1 && shows(&t, lv, 1001, "Row 1001") == 1 &&
          listview.row_widget(&t, lv, 0) == 0 && near(row_y(&t, lv, 1000), rh / 2.0) == 1);
    let is i64 as w1001 = listview.row_widget(&t, lv, 1001);
    scroll.scroll_by(&t, tree.first_child(&t, lv), 0.0, rh);
    check("a row further: the rest kept where they were", listview.row_widget(&t, lv, 1001) == w1001 &&
          shows(&t, lv, 1001, "Row 1001") == 1 && listview.row_widget(&t, lv, 1000) == 0 && tree.child_count(&t, body) < 20);
    check("the row at a point", listview.row_at(&t, lv, row_x(&t, lv), row_y(&t, lv, 1003)) == 1003 &&
          listview.row_at(&t, lv, 0.0 - 5.0, 10.0) == 0 - 1 && listview.index_of_row(&t, w1001) == 1001 &&
          listview.id_at(&t, lv, 3) == 1003 && listview.id_at(&t, lv, 2000) == 0);
    // Half a row past a row: every row seen has its widget.
    let is i64 as area = tree.first_child(&t, lv);
    scroll.set_offset(&t, area, 0.0, 500.5 * rh);
    let is i64 as top = 500;
    let is i64 as bottom = cast(i64, (500.5 * rh + scroll.view_rect(&t, area).h) / rh);
    let is i32 as all with mut = 1;
    let is i64 as i with mut = top;
    while (i <= bottom) {
        if (listview.row_widget(&t, lv, i) == 0) { all = 0; }
        i = i + 1;
    }
    check("half a row in: every row seen made", all == 1 && bottom > top + 5);
    // Numbers shown as numbers.
    items.ids[0] = 6042;
    items.ids[1] = 6000;
    items.ids[2] = 6000 - 42;
    model.changed(&m, 0, 0, 3);
    listview.scroll_to_row(&t, lv, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("a number in its decimal digits", shows(&t, lv, 0, "42") == 1 && shows(&t, lv, 1, "0") == 1 &&
          shows(&t, lv, 2, "-42") == 1);
    let is math.rect.Rect as rr = layout.window_rect(&t, listview.row_widget(&t, lv, 0));
    let is math.rect.Rect as cr = layout.window_rect(&t, tree.first_child(&t, listview.row_widget(&t, lv, 0)));
    check("its text across its middle, padded", near(cr.y + cr.h / 2.0, rr.y + rr.h / 2.0) == 1 &&
          near(cr.x, rr.x + theme.metrics.control_pad_x) == 1);
    // At the view's very edges.
    let is math.rect.Rect as v = layout.window_rect(&t, area);
    check("the view's first column and row: the first row", listview.row_at(&t, lv, v.x, v.y) == 0 &&
          listview.row_at(&t, lv, v.x + v.w, v.y + 1.0) == 0 - 1 && listview.row_at(&t, lv, v.x + 1.0, v.y + v.h) == 0 - 1 &&
          listview.row_at(&t, lv, v.x + 1.0, v.y - 0.5) == 0 - 1 && listview.row_at(&t, lv, v.x - 0.5, v.y + 1.0) == 0 - 1);
    // A taller window: more rows made, all kept.
    layout.run(&t, cast(f64, W), 2000.0);
    check("a taller view: more rows, each right", shows(&t, lv, 50, "Row 50") == 1 && shows(&t, lv, 3, "Row 3") == 1 &&
          shows(&t, lv, 70, "Row 70") == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    // Its rows made again for the program's: the old ones gone.
    let is i64 as old0 = listview.row_widget(&t, lv, 0);
    let is i64 as old1 = listview.row_widget(&t, lv, 1);
    let is i64 as old2 = listview.row_widget(&t, lv, 2);
    listview.set_factory(&t, lv, fn_ptr(own_setup), fn_ptr(own_bind), cast(*u8, 0));
    check("rows of the program's: the old ones gone", tree.is_valid(&t, old0) == 0 && tree.is_valid(&t, old1) == 0 &&
          tree.is_valid(&t, old2) == 0);
    tree.close(&t);
    // The keyboard placed before it was ever laid out: there once it is.
    let is tree.Tree as t2 = tree_for();
    rows(2000);
    let is i64 as lv2 = made(&t2);
    listview.set_cursor(&t2, lv2, 600);
    layout.run(&t2, cast(f64, W), cast(f64, H));
    check("placed before laid out: in view", listview.cursor(&t2, lv2) == 600 && listview.row_widget(&t2, lv2, 600) != 0);
    listview.set_cursor(&t2, lv2, 0);
    check("on the first", listview.cursor(&t2, lv2) == 0);
    listview.set_cursor(&t2, lv2, 2000);
    check("past the last: where it was", listview.cursor(&t2, lv2) == 0 && listview.id_at(&t2, lv2, 0) == 1000);
    tree.close(&t2);
}

// --- Chosen ---

fn chosen() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    rows(100);
    let is i64 as lv = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("one at a time unless told, none yet", listview.selection_mode(&t, lv) == listview.SINGLE &&
          listview.selected_count(&t, lv) == 0 && listview.cursor(&t, lv) == 0 - 1);
    changes = 0;
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 2), 0, 10);
    check("clicked: chosen, the keyboard there, focused", listview.is_selected(&t, lv, 2) == 1 && listview.cursor(&t, lv) == 2 &&
          changes == 1 && router.focused(&t, &r) == lv);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 4), keys.MOD_CONTROL, 20);
    check("one at a time: another instead", listview.is_selected(&t, lv, 2) == 0 && listview.is_selected(&t, lv, 4) == 1 &&
          listview.selected_count(&t, lv) == 1);
    key(&t, &r, keys.DOWN, 0, 30);
    check("down: the next, alone", listview.cursor(&t, lv) == 5 && listview.is_selected(&t, lv, 5) == 1 &&
          listview.selected_count(&t, lv) == 1);
    key(&t, &r, keys.UP, keys.MOD_SHIFT, 40);
    check("one at a time, shift: still alone", listview.cursor(&t, lv) == 4 && listview.selected_count(&t, lv) == 1);
    let is i64 as area = tree.first_child(&t, lv);
    let is f64 as rh = listview.row_height(&t, lv);
    let is f64 as vh = scroll.view_rect(&t, area).h;
    let is i64 as whole = cast(i64, vh / rh);
    listview.set_cursor(&t, lv, whole - 1);
    key(&t, &r, keys.DOWN, 0, 45);
    check("down past the view: scrolled just far enough", near(scroll.offset_y(&t, area), cast(f64, whole + 1) * rh - vh) == 1);
    key(&t, &r, keys.END, 0, 50);
    check("end: the last, scrolled to", listview.cursor(&t, lv) == 99 && listview.is_selected(&t, lv, 99) == 1 &&
          listview.row_widget(&t, lv, 99) != 0 && near(scroll.offset_y(&t, area), 100.0 * rh - vh) == 1);
    key(&t, &r, keys.DOWN, 0, 60);
    check("down at the last: there still", listview.cursor(&t, lv) == 99);
    key(&t, &r, keys.HOME, 0, 70);
    check("home: the first", listview.cursor(&t, lv) == 0 && listview.is_selected(&t, lv, 0) == 1);
    key(&t, &r, keys.UP, 0, 80);
    check("up at the first: there still", listview.cursor(&t, lv) == 0);
    let is i64 as page = cast(i64, scroll.view_rect(&t, tree.first_child(&t, lv)).h / listview.row_height(&t, lv));
    key(&t, &r, keys.PAGE_DOWN, 0, 90);
    check("page down: a view's rows on", listview.cursor(&t, lv) == page && listview.row_widget(&t, lv, page) != 0);
    key(&t, &r, keys.PAGE_UP, 0, 100);
    check("page up: back", listview.cursor(&t, lv) == 0);
    activations = 0;
    key(&t, &r, keys.RETURN, 0, 110);
    check("enter: the row activated", activations == 1 && activated == 1000);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 3), 0, 1000);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 3), 0, 1100);
    check("double clicked: activated", activations == 2 && activated == 1003);
    listview.set_single_click(&t, lv, 1);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 4), 0, 1500);
    check("activated on one click when asked", activations == 3 && activated == 1004 && listview.is_selected(&t, lv, 4) == 1);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 2), keys.MOD_SHIFT, 1600);
    check("but not with shift", activations == 3);
    listview.set_single_click(&t, lv, 0);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 5), 0, 1900);
    check("and on two again when not", activations == 3);
    // Many at a time.
    listview.set_selection_mode(&t, lv, listview.MULTIPLE);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 1), 0, 2000);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 4), keys.MOD_SHIFT, 3000);
    check("shift clicked: all from the anchor", listview.selected_count(&t, lv) == 4 && listview.is_selected(&t, lv, 1) == 1 &&
          listview.is_selected(&t, lv, 4) == 1 && listview.is_selected(&t, lv, 5) == 0);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 2), keys.MOD_CONTROL, 4000);
    check("control clicked: that one turned over", listview.selected_count(&t, lv) == 3 && listview.is_selected(&t, lv, 2) == 0);
    press(&t, &r, row_x(&t, lv), row_y(&t, lv, 7), keys.MOD_CONTROL, 5000);
    check("and another added", listview.selected_count(&t, lv) == 4 && listview.is_selected(&t, lv, 7) == 1 &&
          listview.next_selected(&t, lv, 0) == 1 && listview.next_selected(&t, lv, 2) == 3 &&
          listview.next_selected(&t, lv, 5) == 7 && listview.next_selected(&t, lv, 8) == 0 - 1);
    key(&t, &r, keys.DOWN, keys.MOD_SHIFT, 6000);
    key(&t, &r, keys.DOWN, keys.MOD_SHIFT, 6010);
    check("shift down: from the anchor to it", listview.selected_count(&t, lv) == 3 && listview.is_selected(&t, lv, 9) == 1 &&
          listview.is_selected(&t, lv, 7) == 1 && listview.is_selected(&t, lv, 1) == 0);
    key(&t, &r, keys.DOWN, keys.MOD_CONTROL, 6020);
    key(&t, &r, keys.DOWN, keys.MOD_CONTROL, 6030);
    check("control down: the keyboard on, the choice kept", listview.cursor(&t, lv) == 11 && listview.selected_count(&t, lv) == 3);
    key(&t, &r, keys.SPACE, keys.MOD_CONTROL, 6040);
    check("control space: turned over", listview.is_selected(&t, lv, 11) == 1 && listview.selected_count(&t, lv) == 4);
    key(&t, &r, keys.SPACE, keys.MOD_CONTROL, 6050);
    check("and back", listview.is_selected(&t, lv, 11) == 0);
    key(&t, &r, keys.SPACE, 0, 6060);
    check("space: chosen", listview.is_selected(&t, lv, 11) == 1);
    key(&t, &r, keys.A, keys.MOD_CONTROL, 6070);
    check("control A: all", listview.selected_count(&t, lv) == 100);
    key(&t, &r, keys.A, keys.MOD_CONTROL | keys.MOD_SHIFT, 6080);
    check("shift control A: none", listview.selected_count(&t, lv) == 0);
    // By the program.
    listview.select_range(&t, lv, 10, 20);
    listview.unselect(&t, lv, 15);
    check("ranges chosen by the program, one taken out", listview.selected_count(&t, lv) == 9 &&
          listview.is_selected(&t, lv, 15) == 0 && listview.is_selected(&t, lv, 16) == 1);
    listview.select_range(&t, lv, 14, 17);
    check("filled in again: one range", listview.selected_count(&t, lv) == 10);
    listview.set_cursor(&t, lv, 50);
    check("the cursor set: there, in view", listview.cursor(&t, lv) == 50 && listview.row_widget(&t, lv, 50) != 0);
    listview.set_selection_mode(&t, lv, listview.SINGLE);
    check("one at a time again: only the first kept", listview.selected_count(&t, lv) == 1 && listview.is_selected(&t, lv, 10) == 1);
    listview.set_selection_mode(&t, lv, listview.NONE);
    key(&t, &r, keys.DOWN, 0, 7000);
    check("none: nothing chosen, the keyboard still moves", listview.selected_count(&t, lv) == 0 && listview.cursor(&t, lv) == 51);
    listview.select(&t, lv, 3);
    check("none: not even by the program", listview.selected_count(&t, lv) == 0);
    // Keys it has no use for.
    check("keys it has no use for: not taken", router.key(&t, &r, keys.LEFT, 0, 1, 0, 8000) == 0 &&
          router.key(&t, &r, keys.DOWN, keys.MOD_ALT, 1, 0, 8010) == 0 && listview.cursor(&t, lv) == 51);
    tree.close(&t);
}

// --- What it takes, and what goes on ---

fn taken() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    fruits();
    let is i64 as lv = held(&t);
    listview.set_selection_mode(&t, lv, listview.MULTIPLE);
    layout.run(&t, cast(f64, W), cast(f64, H));
    caught = 0;
    activations = 0;
    changes = 0;
    button_at(&t, &r, 1, row_x(&t, lv), row_y(&t, lv, 0), 10);
    check("the first row clicked: chosen, its own, not activated", listview.is_selected(&t, lv, 0) == 1 && caught == 0 &&
          activations == 0 && changes == 1);
    button_at(&t, &r, 1, row_x(&t, lv), row_y(&t, lv, 0), 2000);
    check("clicked again: nothing new to say", changes == 1);
    let is math.rect.Rect as last = layout.window_rect(&t, listview.row_widget(&t, lv, 9));
    button_at(&t, &r, 1, row_x(&t, lv), last.y + last.h + 5.0, 4000);
    check("below the last row: no row, on up", caught == 1 && listview.cursor(&t, lv) == 0 &&
          listview.row_at(&t, lv, row_x(&t, lv), last.y + last.h + 5.0) == 0 - 1);
    caught = 0;
    button_at(&t, &r, 2, row_x(&t, lv), row_y(&t, lv, 3), 6000);
    check("the middle button: nothing chosen", listview.is_selected(&t, lv, 3) == 0 && listview.cursor(&t, lv) == 0);
    caught = 0;
    button_at(&t, &r, 3, row_x(&t, lv), row_y(&t, lv, 3), 8000);
    check("the right button on a row not chosen: it alone, the press on up", listview.is_selected(&t, lv, 3) == 1 &&
          listview.selected_count(&t, lv) == 1 && caught == 1);
    listview.select_range(&t, lv, 2, 6);
    button_at(&t, &r, 3, row_x(&t, lv), row_y(&t, lv, 4), 10000);
    check("on one among those chosen: all kept", listview.selected_count(&t, lv) == 4);
    // Each key it uses, taken; the rest go on.
    router.focus(&t, &r, lv, 1);
    caught = 0;
    check("down, up, home, end, page down and up: taken", took(&t, &r, keys.DOWN, 0, 12000) == 1 &&
          took(&t, &r, keys.UP, 0, 12010) == 1 && took(&t, &r, keys.END, 0, 12020) == 1 && took(&t, &r, keys.HOME, 0, 12030) == 1 &&
          took(&t, &r, keys.PAGE_DOWN, 0, 12040) == 1 && took(&t, &r, keys.PAGE_UP, 0, 12050) == 1 && caught == 0);
    check("space, control space, enter, control A, shift control A: taken", took(&t, &r, keys.SPACE, 0, 12060) == 1 &&
          took(&t, &r, keys.SPACE, keys.MOD_CONTROL, 12070) == 1 && took(&t, &r, keys.RETURN, 0, 12080) == 1 &&
          took(&t, &r, keys.A, keys.MOD_CONTROL, 12090) == 1 && took(&t, &r, keys.A, keys.MOD_CONTROL | keys.MOD_SHIFT, 12100) == 1 &&
          caught == 0);
    took(&t, &r, keys.LEFT, 0, 12110);
    took(&t, &r, keys.A, 0, 12120);
    took(&t, &r, keys.A, keys.MOD_ALT, 12130);
    check("keys it has no use for: on up", caught == 3);
    // Enter on a row is the list's, ahead of the window's default button.
    let is i64 as sc = router.add_shortcut(&r, keys.RETURN, 0, fn_ptr(on_default), cast(*u8, 0));
    defaults = 0;
    activations = 0;
    check("enter on a row: the list's, not the default button's", took(&t, &r, keys.RETURN, 0, 12140) == 1 && activations == 1 &&
          defaults == 0);
    check("typing taken", router.text(&t, &r, "c", 1, 13000) == 1 && listview.cursor(&t, lv) == 4);
    // The first row, by the keys.
    took(&t, &r, keys.HOME, 0, 14000);
    took(&t, &r, keys.DOWN, keys.MOD_SHIFT, 14010);
    check("shift down from the first: both", listview.selected_count(&t, lv) == 2 && listview.is_selected(&t, lv, 0) == 1);
    took(&t, &r, keys.HOME, keys.MOD_CONTROL, 14020);
    took(&t, &r, keys.SPACE, keys.MOD_CONTROL, 14030);
    check("control space on the first: turned over", listview.is_selected(&t, lv, 0) == 0 && listview.selected_count(&t, lv) == 1);
    took(&t, &r, keys.SPACE, keys.MOD_CONTROL, 14040);
    took(&t, &r, keys.SPACE, keys.MOD_CONTROL, 14050);
    check("and back, the rest kept", listview.is_selected(&t, lv, 0) == 0 && listview.selected_count(&t, lv) == 1 &&
          listview.is_selected(&t, lv, 1) == 1);
    took(&t, &r, keys.SPACE, 0, 14060);
    check("space on the first: chosen", listview.is_selected(&t, lv, 0) == 1 && listview.selected_count(&t, lv) == 2);
    // One at a time: space on a row the keyboard went to without choosing.
    listview.set_selection_mode(&t, lv, listview.SINGLE);
    listview.set_cursor(&t, lv, 6);
    took(&t, &r, keys.SPACE, 0, 15000);
    check("one at a time, space: that one alone", listview.selected_count(&t, lv) == 1 && listview.is_selected(&t, lv, 6) == 1);
    // A list with nothing in it: typing not taken.
    items.n = 0;
    model.reset(&m);
    check("nothing to find: typing not taken", router.text(&t, &r, "a", 1, 16000) == 0);
    took(&t, &r, keys.RETURN, 0, 16010);
    check("no row: enter the default button's", defaults == 1);
    router.remove_shortcut(&r, sc);
    tree.close(&t);
}

// --- The selection's ranges, through what the program can see ---

fn ranges() as void {
    let is tree.Tree as t = tree_for();
    rows(100);
    let is i64 as lv = made(&t);
    listview.set_selection_mode(&t, lv, listview.MULTIPLE);
    listview.select_range(&t, lv, 10, 20);
    listview.select_range(&t, lv, 30, 40);
    listview.select_range(&t, lv, 20, 30);
    check("ranges joined", listview.selected_count(&t, lv) == 30 && listview.next_selected(&t, lv, 0) == 10 &&
          listview.next_selected(&t, lv, 40) == 0 - 1);
    listview.select_range(&t, lv, 5, 12);
    check("one overlapping from before", listview.selected_count(&t, lv) == 35 && listview.is_selected(&t, lv, 5) == 1 &&
          listview.is_selected(&t, lv, 4) == 0);
    listview.select_range(&t, lv, 38, 45);
    check("and from after", listview.selected_count(&t, lv) == 40 && listview.is_selected(&t, lv, 44) == 1 &&
          listview.is_selected(&t, lv, 45) == 0);
    listview.unselect_range(&t, lv, 0, 7);
    check("cut at its start", listview.selected_count(&t, lv) == 38 && listview.is_selected(&t, lv, 7) == 1 &&
          listview.is_selected(&t, lv, 6) == 0);
    listview.unselect_range(&t, lv, 43, 50);
    check("cut at its end", listview.selected_count(&t, lv) == 36 && listview.is_selected(&t, lv, 42) == 1 &&
          listview.is_selected(&t, lv, 43) == 0);
    listview.unselect_range(&t, lv, 20, 22);
    check("cut in two", listview.selected_count(&t, lv) == 34 && listview.is_selected(&t, lv, 19) == 1 &&
          listview.is_selected(&t, lv, 20) == 0 && listview.is_selected(&t, lv, 21) == 0 && listview.is_selected(&t, lv, 22) == 1 &&
          listview.next_selected(&t, lv, 20) == 22);
    listview.unselect_all(&t, lv);
    // Many apart: more ranges than first had room for.
    let is i64 as i with mut = 0;
    while (i < 40) {
        listview.select(&t, lv, i);
        i = i + 2;
    }
    check("twenty apart", listview.selected_count(&t, lv) == 20 && listview.is_selected(&t, lv, 38) == 1 &&
          listview.is_selected(&t, lv, 0) == 1 && listview.is_selected(&t, lv, 1) == 0);
    listview.unselect(&t, lv, 20);
    check("one of them out, the rest where they were", listview.selected_count(&t, lv) == 19 &&
          listview.next_selected(&t, lv, 19) == 22 && listview.is_selected(&t, lv, 36) == 1 && listview.is_selected(&t, lv, 18) == 1 &&
          listview.next_selected(&t, lv, 37) == 38);
    listview.select(&t, lv, 21);
    check("one put between two", listview.selected_count(&t, lv) == 20 && listview.next_selected(&t, lv, 19) == 21 &&
          listview.next_selected(&t, lv, 22) == 22 && listview.is_selected(&t, lv, 38) == 1 && listview.is_selected(&t, lv, 0) == 1);
    // What is said, and when.
    listview.unselect_all(&t, lv);
    listview.select(&t, lv, 5);
    listview.select(&t, lv, 9);
    listview.unselect(&t, lv, 9);
    check("past the last range: none", listview.next_selected(&t, lv, 6) == 0 - 1);
    changes = 0;
    listview.select_range(&t, lv, 50, 50);
    listview.unselect(&t, lv, 60);
    check("nothing chosen or not: nothing said", changes == 0);
    listview.select(&t, lv, 3);
    check("one: one", listview.selected_count(&t, lv) == 2 && listview.is_selected(&t, lv, 4) == 0 && changes == 1);
    listview.unselect(&t, lv, 3);
    check("taken out: said", changes == 2);
    listview.unselect_all(&t, lv);
    changes = 0;
    listview.set_selection_mode(&t, lv, listview.NONE);
    listview.set_selection_mode(&t, lv, listview.SINGLE);
    listview.select(&t, lv, 2);
    changes = 0;
    listview.set_selection_mode(&t, lv, listview.SINGLE);
    check("modes kept or set with nothing to drop: nothing said", changes == 0);
    listview.select_range(&t, lv, 10, 20);
    check("one at a time, a range: only its first", listview.selected_count(&t, lv) == 1 && listview.is_selected(&t, lv, 10) == 1);
    listview.unselect_all(&t, lv);
    changes = 0;
    listview.set_selection_mode(&t, lv, listview.NONE);
    check("none, with nothing chosen: nothing said", changes == 0);
    listview.set_selection_mode(&t, lv, listview.MULTIPLE);
    check("not a list view: nothing", listview.is_selected(&t, tree.root(&t), 0) == 0 &&
          listview.next_selected(&t, tree.root(&t), 0) == 0 - 1 && listview.id_at(&t, lv, 0) == 1000 &&
          listview.id_at(&t, lv, 0 - 1) == 0);
    tree.close(&t);
}

// --- The ranges as rows come and go ---

fn shifted() as void {
    let is tree.Tree as t = tree_for();
    rows(100);
    let is i64 as lv = made(&t);
    listview.set_selection_mode(&t, lv, listview.MULTIPLE);
    // Inserted at a range's first row: all of it moves.
    listview.select_range(&t, lv, 10, 20);
    insert(10, 2, 3000);
    check("inserted at a range's start: all of it on", listview.next_selected(&t, lv, 0) == 12 &&
          listview.selected_count(&t, lv) == 10);
    insert(22, 2, 3010);
    check("inserted at its end: none of it on", listview.next_selected(&t, lv, 22) == 0 - 1 &&
          listview.selected_count(&t, lv) == 10);
    // Split, with more ranges after it.
    listview.unselect_all(&t, lv);
    rows(100);
    model.reset(&m);
    listview.select_range(&t, lv, 10, 20);
    listview.select_range(&t, lv, 30, 40);
    listview.select_range(&t, lv, 50, 60);
    insert(15, 2, 3020);
    check("split, those after moved", listview.selected_count(&t, lv) == 30 && listview.is_selected(&t, lv, 15) == 0 &&
          listview.is_selected(&t, lv, 17) == 1 && listview.is_selected(&t, lv, 32) == 1 && listview.is_selected(&t, lv, 31) == 0 &&
          listview.is_selected(&t, lv, 52) == 1 && listview.is_selected(&t, lv, 61) == 1 && listview.is_selected(&t, lv, 62) == 0);
    // Apart, staying apart when a row before them goes.
    listview.unselect_all(&t, lv);
    listview.select_range(&t, lv, 5, 8);
    listview.select_range(&t, lv, 20, 23);
    remove(0, 1);
    check("apart, a row before them gone: still apart", listview.selected_count(&t, lv) == 6 && listview.is_selected(&t, lv, 4) == 1 &&
          listview.is_selected(&t, lv, 10) == 0 && listview.is_selected(&t, lv, 19) == 1);
    // A range taken out, then rows inserted or removed where it was.
    listview.unselect_all(&t, lv);
    listview.select_range(&t, lv, 10, 20);
    listview.select_range(&t, lv, 30, 40);
    listview.unselect_range(&t, lv, 30, 40);
    insert(35, 1, 3030);
    check("where a range was, inserted into: nothing chosen there", listview.selected_count(&t, lv) == 10);
    listview.unselect_all(&t, lv);
    listview.select_range(&t, lv, 10, 15);
    listview.select_range(&t, lv, 20, 25);
    listview.unselect_range(&t, lv, 20, 25);
    remove(15, 5);
    check("rows gone up to where a range was: what is chosen kept", listview.selected_count(&t, lv) == 5 &&
          listview.next_selected(&t, lv, 0) == 10);
    tree.close(&t);
}

// --- Laid out when it must be, before scrolling ---

fn settled() as void {
    let is tree.Tree as t = tree_for();
    rows(100);
    let is i64 as lv = made(&t);
    let is i64 as area = tree.first_child(&t, lv);
    check("not laid out: no row anywhere", listview.row_at(&t, lv, 10.0, 10.0) == 0 - 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is f64 as rh = listview.row_height(&t, lv);
    layout.set_align(&t, lv, layout.FILL, layout.START);
    layout.set_max_size(&t, lv, cast(f64, W), 3.0 * rh);
    listview.set_cursor(&t, lv, 5);
    check("made shorter, the keyboard sent past it: laid out first, scrolled", scroll.offset_y(&t, area) > 0.0 &&
          scroll.view_rect(&t, area).h < 3.0 * rh + 0.01);
    layout.set_max_size(&t, lv, layout.UNBOUNDED, layout.UNBOUNDED);
    layout.set_align(&t, lv, layout.FILL, layout.FILL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    insert(100, 50, 4000);
    listview.set_cursor(&t, lv, 149);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("rows added at the end, the keyboard on the last: in view", listview.row_widget(&t, lv, 149) != 0 &&
          near(scroll.offset_y(&t, area), 150.0 * rh - scroll.view_rect(&t, area).h) == 1);
    key_less_up(&t, lv);
    // Reset with nothing chosen: nothing said, the view where it was.
    listview.scroll_to_row(&t, lv, 50);
    let is f64 as oy = scroll.offset_y(&t, area);
    listview.unselect_all(&t, lv);
    changes = 0;
    let is i64 as i with mut = 0;
    while (i < items.n) {
        items.ids[i] = 1010 + i;
        i = i + 1;
    }
    model.reset(&m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("reset, nothing chosen: nothing said, the view kept", changes == 0 && near(scroll.offset_y(&t, area), oy) == 1);
    check("every row shown read again", shows(&t, lv, 50, "Row 60") == 1 && shows(&t, lv, 51, "Row 61") == 1 &&
          shows(&t, lv, 52, "Row 62") == 1 && shows(&t, lv, 53, "Row 63") == 1);
    let is math.rect.Rect as rr = layout.window_rect(&t, listview.row_widget(&t, lv, 50));
    let is math.rect.Rect as cr = layout.window_rect(&t, tree.first_child(&t, listview.row_widget(&t, lv, 50)));
    check("its text as wide as the row, less its padding", near(cr.w, rr.w - 2.0 * theme.metrics.control_pad_x) == 1);
    tree.close(&t);
}

// The keyboard one row up from the last with the view at the end: no scroll.
fn key_less_up(t as *tree.Tree, lv as i64) as void {
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(t, cast(*u8, &r));
    router.focus(t, &r, lv, 1);
    let is i64 as area = tree.first_child(t, lv);
    let is f64 as before = scroll.offset_y(t, area);
    key(t, &r, keys.UP, 0, 10);
    check("up from the last, in view: no scroll", near(scroll.offset_y(t, area), before) == 1);
    tree.set_router(t, cast(*u8, 0));
}

// --- Hooks for those built on it ---

let is i64 as asked_index with mut = 0;
let is i64 as expanded with mut = 0;

fn row_says(user as *u8, t as *tree.Tree, rw as i64, index as i64, q as *tree.Access) as i64 {
    if (q.action == access.ASK) {
        q.states = q.states | access.EXPANDABLE;
        q.actions = q.actions | access.EXPAND;
        asked_index = index;
        return 1;
    }
    if (q.action == access.EXPAND) {
        expanded = index;
        return 1;
    }
    return 0;
}

fn hooked() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    fruits();
    let is i64 as lv = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    listview.set_roles(&t, lv, access.ROLE_TREE, access.ROLE_TREE_ITEM);
    listview.set_row_access(&t, lv, fn_ptr(row_says), cast(*u8, 0));
    let is tree.Access as q;
    access.describe(&t, &r, lv, &q);
    check("told as it is told to be", q.role == access.ROLE_TREE);
    let is i64 as rw = listview.row_widget(&t, lv, 2);
    access.describe(&t, &r, rw, &q);
    check("its rows too, with what the hook adds", q.role == access.ROLE_TREE_ITEM && (q.states & access.EXPANDABLE) != 0 &&
          (q.states & access.SELECTABLE) != 0 && asked_index == 2);
    check("an action of the hook's: the hook's", access.act(&t, rw, access.EXPAND, 0.0) == 1 && expanded == 2);
    activations = 0;
    check("pressing and choosing still the list's", access.act(&t, rw, access.PRESS, 0.0) == 1 && activations == 1 &&
          access.act(&t, rw, access.SELECT, 0.0) == 1 && listview.is_selected(&t, lv, 2) == 1);
    listview.go_to(&t, lv, 0);
    check("gone to the first: there, alone chosen", listview.cursor(&t, lv) == 0 && listview.is_selected(&t, lv, 0) == 1 &&
          listview.selected_count(&t, lv) == 1);
    listview.go_to(&t, lv, 10);
    listview.go_to(&t, lv, 0 - 1);
    check("gone past the ends: nowhere", listview.cursor(&t, lv) == 0);
    // Rows wider than the view: scrolled across when asked.
    let is i64 as area = listview.area(&t, lv);
    check("its scroll area", area == tree.first_child(&t, lv) && listview.area(&t, tree.root(&t)) == 0);
    listview.set_factory(&t, lv, fn_ptr(wide_setup), fn_ptr(own_bind), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("cut to the view at first", scroll.bar_shown(&t, area, scroll.X) == 0);
    listview.set_horizontal(&t, lv, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("scrolled across when asked", scroll.bar_shown(&t, area, scroll.X) == 1);
    listview.set_horizontal(&t, lv, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("and cut again", scroll.bar_shown(&t, area, scroll.X) == 0);
    listview.set_horizontal(&t, tree.root(&t), 1);
    listview.set_roles(&t, tree.root(&t), access.ROLE_TREE, 0);
    listview.set_row_access(&t, tree.root(&t), fn_ptr(row_says), cast(*u8, 0));
    listview.go_to(&t, tree.root(&t), 0);
    tree.close(&t);
}

// --- The model changing ---

fn followed() as void {
    let is tree.Tree as t = tree_for();
    rows(50);
    let is i64 as lv = made(&t);
    listview.set_selection_mode(&t, lv, listview.MULTIPLE);
    layout.run(&t, cast(f64, W), cast(f64, H));
    listview.select_range(&t, lv, 3, 6);
    listview.set_cursor(&t, lv, 4);
    changes = 0;
    insert(1, 2, 3000);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("rows inserted above: the choice and the keyboard move with their rows", listview.count(&t, lv) == 52 &&
          listview.is_selected(&t, lv, 5) == 1 && listview.is_selected(&t, lv, 7) == 1 && listview.is_selected(&t, lv, 3) == 0 &&
          listview.cursor(&t, lv) == 6 && changes == 0 && listview.id_at(&t, lv, 1) == 3000);
    check("shown as they now are", shows(&t, lv, 3, "Row 1") == 1 && shows(&t, lv, 1, "Row 2000") == 1 &&
          shows(&t, lv, 2, "Row 2001") == 1 && shows(&t, lv, 0, "Row 0") == 1);
    insert(6, 1, 3100);
    check("one inserted among the chosen: not chosen, the rest split round it", listview.selected_count(&t, lv) == 3 &&
          listview.is_selected(&t, lv, 6) == 0 && listview.is_selected(&t, lv, 5) == 1 && listview.is_selected(&t, lv, 7) == 1 &&
          listview.is_selected(&t, lv, 8) == 1);
    remove(6, 1);
    check("taken out again: one range again", listview.selected_count(&t, lv) == 3 && listview.next_selected(&t, lv, 0) == 5);
    remove(4, 3);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("chosen rows gone: said, the rest kept", changes == 1 && listview.selected_count(&t, lv) == 1 &&
          listview.is_selected(&t, lv, 4) == 1 && listview.count(&t, lv) == 49);
    check("the keyboard's row gone: on the row now there", listview.cursor(&t, lv) == 4);
    listview.set_cursor(&t, lv, 48);
    remove(47, 2);
    check("the last ones gone: the keyboard on the new last", listview.cursor(&t, lv) == 46);
    items.ids[0] = 7;
    model.changed(&m, 0, 0, 1);
    listview.scroll_to_row(&t, lv, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("a row changed: shown again", shows(&t, lv, 0, "Bilberry") == 1);
    // Rows changed in view: those said, and only those, shown again.
    items.ids[2] = 1;
    items.ids[3] = 2;
    items.ids[4] = 3;
    model.changed(&m, 0, 2, 2);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("changed in view: those shown again, no others", shows(&t, lv, 2, "apple") == 1 && shows(&t, lv, 3, "apricot") == 1 &&
          shows(&t, lv, 4, "banana") == 0 && shows(&t, lv, 1, "Row 2000") == 1);
    model.changed(&m, 0, 4, 1);
    // Rows inserted at the keyboard's row and before the anchor: both move.
    listview.set_cursor(&t, lv, 5);
    insert(5, 1, 3200);
    check("inserted at the keyboard's row: it moves on", listview.cursor(&t, lv) == 6);
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    router.focus(&t, &r, lv, 1);
    listview.unselect_all(&t, lv);
    key(&t, &r, keys.DOWN, keys.MOD_SHIFT, 100);
    check("the anchor moved with it", listview.selected_count(&t, lv) == 2 && listview.is_selected(&t, lv, 6) == 1 &&
          listview.is_selected(&t, lv, 7) == 1);
    listview.set_cursor(&t, lv, 20);
    insert(10, 2, 3300);
    key(&t, &r, keys.DOWN, keys.MOD_SHIFT, 200);
    check("rows before it: the anchor moved too", listview.cursor(&t, lv) == 23 && listview.selected_count(&t, lv) == 2 &&
          listview.is_selected(&t, lv, 22) == 1);
    changes = 0;
    remove(30, 2);
    check("rows not chosen removed: nothing said", changes == 0);
    router.focus(&t, &r, 0, 0);
    model.removed(&m, 5, 0, 1);
    check("a change under another parent: nothing", listview.count(&t, lv) == 48);
    changes = 0;
    rows(5);
    model.reset(&m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("reset: read again, nothing chosen, said", listview.count(&t, lv) == 5 && listview.selected_count(&t, lv) == 0 &&
          listview.cursor(&t, lv) == 0 - 1 && changes == 1 && shows(&t, lv, 4, "Row 4") == 1 && shows(&t, lv, 0, "Row 0") == 1 &&
          shows(&t, lv, 1, "Row 1") == 1 && shows(&t, lv, 3, "Row 3") == 1 && shows(&t, lv, 2, "Row 2") == 1);
    listview.set_cursor(&t, lv, 2);
    remove(0, 5);
    check("all removed: no keyboard row", listview.cursor(&t, lv) == 0 - 1 && listview.count(&t, lv) == 0);
    rows(5);
    model.reset(&m);
    // After a reset, shift with no anchor: only the row clicked.
    let is router.Router as r2 = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r2));
    layout.run(&t, cast(f64, W), cast(f64, H));
    press(&t, &r2, row_x(&t, lv), row_y(&t, lv, 3), keys.MOD_SHIFT, 300);
    check("shift with no anchor: only the row clicked", listview.selected_count(&t, lv) == 1 && listview.is_selected(&t, lv, 3) == 1);
    // Another model, then none.
    let is model.Model as other = model.make(cast(*u8, 0), fn_ptr(items_count), fn_ptr(items_row_id), fn_ptr(items_cell));
    listview.select(&t, lv, 1);
    listview.set_model(&t, lv, &other);
    check("another model: its rows, nothing chosen", listview.model_of(&t, lv) == &other && listview.selected_count(&t, lv) == 0);
    listview.set_model(&t, lv, cast(*model.Model, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("no model: no rows", listview.count(&t, lv) == 0 && listview.row_widget(&t, lv, 0) == 0);
    rows(3);
    model.inserted(&m, 0, 0, 3);
    check("the old model no longer heard", listview.count(&t, lv) == 0);
    listview.set_model(&t, lv, &m);
    tree.destroy(&t, lv);
    model.inserted(&m, 0, 0, 0);
    check("destroyed: no longer heard", 1 == 1);
    tree.close(&t);
}

// --- Found by typing ---

fn typed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    fruits();
    let is i64 as lv = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, lv, 1);
    router.text(&t, &r, "b", 1, 100);
    check("b: the first starting so", listview.cursor(&t, lv) == 2 && listview.is_selected(&t, lv, 2) == 1);
    router.text(&t, &r, "l", 1, 200);
    check("bl: the first starting so", listview.cursor(&t, lv) == 3);
    router.text(&t, &r, "b", 1, 2000);
    check("a while later, b: a new search, the next b on", listview.cursor(&t, lv) == 6);
    router.text(&t, &r, "b", 1, 2100);
    check("b again: the next b, round from the end", listview.cursor(&t, lv) == 2);
    router.text(&t, &r, "q", 1, 5000);
    check("nothing starting so: where it was", listview.cursor(&t, lv) == 2);
    router.text(&t, &r, "C", 1, 8000);
    check("either case", listview.cursor(&t, lv) == 4);
    router.text(&t, &r, "d", 1, 10000);
    router.text(&t, &r, "a", 1, 11000);
    router.text(&t, &r, "t", 1, 11500);
    router.text(&t, &r, "e", 1, 12400);
    check("typed in full, each within a second: found", listview.cursor(&t, lv) == 5);
    router.text(&t, &r, "Z", 1, 20000);
    check("the last letter, in capitals", listview.cursor(&t, lv) == 7);
    listview.set_cursor(&t, lv, 0);
    router.text(&t, &r, "A", 1, 30000);
    check("the first letter on a row it starts: the next it starts", listview.cursor(&t, lv) == 1);
    listview.set_cursor(&t, lv, 2);
    router.text(&t, &r, "b", 1, 40000);
    router.text(&t, &r, "b", 1, 40100);
    check("the same letter twice from one it starts: two on", listview.cursor(&t, lv) == 6);
    listview.set_cursor(&t, lv, 2);
    router.text(&t, &r, "b", 1, 50000);
    router.text(&t, &r, "b", 1, 50100);
    router.text(&t, &r, "a", 1, 50200);
    check("the same letter, then another: searched as typed", listview.cursor(&t, lv) == 6);
    listview.set_cursor(&t, lv, 6);
    router.text(&t, &r, "7", 1, 60000);
    check("a number's row not found by its text", listview.cursor(&t, lv) == 6);
    listview.set_cursor(&t, lv, 0);
    router.text(&t, &r, "d", 1, 70000);
    router.text(&t, &r, "a", 1, 70100);
    router.text(&t, &r, "b", 1, 70200);
    check("a row's whole text typed: that row", listview.cursor(&t, lv) == 9);
    check("nothing found: still taken", router.text(&t, &r, "q", 1, 80000) == 1);
    tree.close(&t);
}

// --- Rows of the program's ---

let is i64 as setups with mut = 0;
let is i64 as last_bound with mut = 0;
let is i64 as last_index with mut = 0;

fn own_setup(user as *u8, t as *tree.Tree, rw as i64) as void {
    setups = setups + 1;
    label.create(t, rw, "", 0);
}

fn own_bind(user as *u8, t as *tree.Tree, rw as i64, id as i64, index as i64) as void {
    last_bound = id;
    last_index = index;
    let is model.Value as v;
    model.cell(&m, id, 0, model.TEXT, &v);
    let is [40]u8 as buf;
    let is *u8 as p = cast(*u8, &buf);
    p[0] = cast(u8, 62);
    mem.memcpy(cast(*u8, cast(i64, p) + 1), v.p, v.len);
    label.set_text(t, tree.first_child(t, rw), p, v.len + 1);
}

// A row wider than any window.
fn wide_setup(user as *u8, t as *tree.Tree, rw as i64) as void {
    let is i64 as l = label.create(t, rw, "", 0);
    layout.set_min_size(t, l, 2000.0, 0.0);
}

fn factory() as void {
    let is tree.Tree as t = tree_for();
    fruits();
    let is i64 as lv = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    setups = 0;
    listview.set_factory(&t, lv, fn_ptr(own_setup), fn_ptr(own_bind), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("rows of its own: made by it, shown by it", setups > 0 && shows(&t, lv, 0, ">apple") == 1 &&
          shows(&t, lv, 7, ">zucchini") == 1);
    tree.close(&t);
}

// --- Drawn ---

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    frame_router = &r;
    fruits();
    let is i64 as lv = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, lv, 1);
    key(&t, &r, keys.DOWN, 0, 10);
    key(&t, &r, keys.DOWN, 0, 20);
    frame(&t, c);
    let is i64 as rw = listview.row_widget(&t, lv, 1);
    let is math.rect.Rect as rr = layout.window_rect(&t, rw);
    let is i64 as l = tree.first_child(&t, rw);
    check("the chosen row in the selection's colour", is8(cast(i64, rr.x + rr.w - 30.0), cast(i64, rr.y + rr.h / 2.0),
          theme.palette.selection_bg, 2) == 1);
    check("its text in the selection's text colour", is8(ink_x(&t, l), ink_y(&t, l), theme.palette.selection_fg, 60) == 1);
    let is i64 as l0 = tree.first_child(&t, listview.row_widget(&t, lv, 0));
    check("another row as any text", is8(ink_x(&t, l0), ink_y(&t, l0), theme.palette.fg, 60) == 1);
    // The keyboard on a row not chosen: that row ringed, no other, nor the list.
    listview.set_selection_mode(&t, lv, listview.MULTIPLE);
    key(&t, &r, keys.DOWN, keys.MOD_CONTROL, 30);
    frame(&t, c);
    let is math.rect.Rect as r2 = layout.window_rect(&t, listview.row_widget(&t, lv, 2));
    let is math.rect.Rect as r0 = layout.window_rect(&t, listview.row_widget(&t, lv, 0));
    let is i64 as mx = cast(i64, r2.x + r2.w / 2.0);
    check("the keyboard's row ringed", is8(mx, cast(i64, r2.y), theme.palette.focus, 40) == 1 &&
          is8(mx, cast(i64, r2.y + r2.h - 1.0), theme.palette.focus, 40) == 1);
    check("no other row, nor the list", is8(mx, cast(i64, r0.y), theme.palette.focus, 40) == 0 &&
          is8(2, cast(i64, r0.y + r0.h / 2.0), theme.palette.focus, 40) == 0);
    key(&t, &r, keys.HOME, keys.MOD_CONTROL, 40);
    frame(&t, c);
    check("on the first row: no ring round the list", is8(1, cast(i64, r2.y + r2.h / 2.0), theme.palette.focus, 40) == 0 &&
          is8(mx, cast(i64, r0.y), theme.palette.focus, 40) == 1);
    key(&t, &r, keys.DOWN, keys.MOD_CONTROL, 50);
    key(&t, &r, keys.DOWN, keys.MOD_CONTROL, 60);
    router.focus(&t, &r, lv, 0);
    frame(&t, c);
    check("focused but not by keyboard: no ring", is8(mx, cast(i64, r2.y), theme.palette.focus, 40) == 0);
    router.focus(&t, &r, lv, 1);
    router.focus(&t, &r, 0, 1);
    frame(&t, c);
    check("not focused: no ring", is8(mx, cast(i64, r2.y), theme.palette.focus, 40) == 0);
    frame_router = cast(*router.Router, 0);
    tree.close(&t);
}

// --- Rows dragged to another place ---

let is i64 as moved_from with mut = 0;
let is i64 as moved_to with mut = 0;
let is i64 as moves with mut = 0;

fn on_moved(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    let is *listview.Moved as mv = cast(*listview.Moved, arg);
    moved_from = mv.from;
    moved_to = mv.to;
    moves = moves + 1;
}

// Pressed on row from and dragged, past the threshold, to window y.
fn drag_row(t as *tree.Tree, r as *router.Router, lv as i64, from as i64, y as f64, time as i64) as void {
    let is f64 as x = row_x(t, lv);
    router.pointer_move(t, r, x, row_y(t, lv, from), time);
    router.pointer_button(t, r, 1, 1, x, row_y(t, lv, from), time);
    router.pointer_move(t, r, x, row_y(t, lv, from) + 20.0, time + 1);
    router.pointer_move(t, r, x, y, time + 2);
}

fn reordered(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    frame_router = &r;
    rows(6);
    let is i64 as lv = made(&t);
    signal.connect(&t, lv, signal.MOVED, fn_ptr(on_moved), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is f64 as rh = listview.row_height(&t, lv);
    let is f64 as x = row_x(&t, lv);

    // Not reorderable, as a list starts: a drag is no drag.
    check("not reorderable at first", listview.reorderable(&t, lv) == 0);
    drag_row(&t, &r, lv, 0, row_y(&t, lv, 3), 10);
    check("not reorderable: nothing dragged", router.drag_active(&r) == 0 && listview.drop_at(&t, lv) == 0 - 1);
    router.pointer_button(&t, &r, 1, 0, x, row_y(&t, lv, 3), 20);

    listview.set_reorderable(&t, lv, 1);
    check("reorderable", listview.reorderable(&t, lv) == 1);
    drag_row(&t, &r, lv, 0, row_y(&t, lv, 3) + rh / 4.0, 1000);
    check("dragged: from the list, a row of its own", router.drag_active(&r) == 1 && router.drag_source(&r) == lv &&
          router.drag_target(&r) == lv && router.drag_takes(&r) == dnd.ITEM);
    check("over the lower half of a row: after it", listview.drop_at(&t, lv) == 4);
    router.pointer_move(&t, &r, x, row_y(&t, lv, 3) - rh / 4.0, 1010);
    check("over its upper half: before it", listview.drop_at(&t, lv) == 3);
    frame(&t, c);
    let is math.rect.Rect as r3 = layout.window_rect(&t, listview.row_widget(&t, lv, 3));
    let is i64 as mx = cast(i64, r3.x + r3.w / 2.0);
    check("where it would go: a line in the accent", is8(mx, cast(i64, r3.y), theme.palette.accent, 40) == 1 &&
          is8(mx, cast(i64, r3.y + r3.h / 2.0), theme.palette.accent, 40) == 0);
    let is math.rect.Rect as r5 = layout.window_rect(&t, listview.row_widget(&t, lv, 5));
    router.pointer_move(&t, &r, x, r5.y + r5.h + rh * 2.0, 1020);
    check("past the last row: at the end", listview.drop_at(&t, lv) == 6);
    frame(&t, c);
    check("at the end: the line under the last row", is8(mx, cast(i64, r5.y + r5.h - 1.0), theme.palette.accent, 40) == 1);
    router.pointer_move(&t, &r, x, row_y(&t, lv, 3) - rh / 4.0, 1030);
    router.pointer_button(&t, &r, 1, 0, x, row_y(&t, lv, 3) - rh / 4.0, 1040);
    check("let go: the move said, from where, to before which", moves == 1 && moved_from == 0 && moved_to == 3);
    check("over: no line", listview.drop_at(&t, lv) == 0 - 1 && router.drag_active(&r) == 0);
    frame(&t, c);
    check("over: no line drawn", is8(mx, cast(i64, r3.y), theme.palette.accent, 40) == 0);
    // The program moves the row in its model: the list follows.
    remove(0, 1);
    insert(2, 1, 1000);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the program moved it: shown there", shows(&t, lv, 2, "Row 0") == 1 && shows(&t, lv, 0, "Row 1") == 1);

    // Onto its own place, either side: nothing to do.
    drag_row(&t, &r, lv, 2, row_y(&t, lv, 2) + rh / 4.0, 2000);
    check("over itself: where it is", listview.drop_at(&t, lv) == 3);
    router.pointer_button(&t, &r, 1, 0, x, row_y(&t, lv, 2) + rh / 4.0, 2010);
    drag_row(&t, &r, lv, 2, row_y(&t, lv, 2) - rh / 4.0, 3000);
    router.pointer_button(&t, &r, 1, 0, x, row_y(&t, lv, 2) - rh / 4.0, 3010);
    check("let go where it was: nothing said", moves == 1);

    // Called off.
    drag_row(&t, &r, lv, 1, row_y(&t, lv, 4), 4000);
    key(&t, &r, keys.ESCAPE, 0, 4010);
    check("Escape: no line, nothing said", listview.drop_at(&t, lv) == 0 - 1 && moves == 1);
    router.pointer_button(&t, &r, 1, 0, x, row_y(&t, lv, 4), 4020);

    // A move down: told as before which row it goes.
    drag_row(&t, &r, lv, 1, row_y(&t, lv, 4) + rh / 4.0, 5000);
    router.pointer_button(&t, &r, 1, 0, x, row_y(&t, lv, 4) + rh / 4.0, 5010);
    check("a move down: from 1 to before 5", moves == 2 && moved_from == 1 && moved_to == 5);

    // What is not one of its own rows: not taken.
    let is dnd.Payload as words = dnd.text("x", 1, dnd.COPY);
    check("text: not taken", router.drag_enter(&t, &r, &words, x, row_y(&t, lv, 2), 6000) == 0 &&
          listview.drop_at(&t, lv) == 0 - 1);
    router.drag_leave(&t, &r, 6010);
    let is dnd.Payload as other = dnd.item(&t, tree.root(&t), 0, dnd.MOVE);
    check("another widget's item: not taken", router.drag_enter(&t, &r, &other, x, row_y(&t, lv, 2), 6020) == 0);
    router.drag_leave(&t, &r, 6030);
    let is dnd.Payload as mine = dnd.item(&t, lv, 0, dnd.MOVE);
    listview.set_reorderable(&t, lv, 0);
    check("no longer reorderable: not taken", router.drag_enter(&t, &r, &mine, x, row_y(&t, lv, 2), 6040) == 0);
    router.drag_leave(&t, &r, 6050);
    listview.set_reorderable(&t, lv, 1);
    check("its own, from outside the router's own drag: taken", router.drag_enter(&t, &r, &mine, x, row_y(&t, lv, 2) - rh / 4.0,
          6060) == dnd.ITEM && listview.drop_at(&t, lv) == 2);
    router.drag_leave(&t, &r, 6070);
    check("left: no line", listview.drop_at(&t, lv) == 0 - 1);
    check("not a list: nothing", listview.reorderable(&t, tree.root(&t)) == 0 && listview.drop_at(&t, tree.root(&t)) == 0 - 1);
    listview.set_reorderable(&t, tree.root(&t), 1);
    let is [8]u8 as path;
    path[0] = 47; path[1] = 97; path[2] = 0;
    let is dnd.Payload as files = dnd.files(cast(*u8, &path), 1);
    check("files: not taken", router.drag_enter(&t, &r, &files, x, row_y(&t, lv, 2), 6080) == 0);
    router.drag_leave(&t, &r, 6090);
    // To the very start.
    drag_row(&t, &r, lv, 3, row_y(&t, lv, 0) - rh / 4.0, 7000);
    router.pointer_button(&t, &r, 1, 0, x, row_y(&t, lv, 0) - rh / 4.0, 7010);
    check("to the start: before the first", moves == 3 && moved_from == 3 && moved_to == 0);
    frame_router = cast(*router.Router, 0);
    tree.close(&t);

    // Below something else, and scrolled: before the row under the pointer all the same.
    let is tree.Tree as t2 = tree_for();
    let is router.Router as r2 = router.init(router.settings_default());
    tree.set_router(&t2, cast(*u8, &r2));
    rows(40);
    let is i64 as col = box.create(&t2, tree.root(&t2), box.COLUMN);
    label.create(&t2, col, "Above", 5);
    let is i64 as lv2 = listview.create(&t2, col, &m);
    listview.set_reorderable(&t2, lv2, 1);
    signal.connect(&t2, lv2, signal.MOVED, fn_ptr(on_moved), cast(*u8, 0));
    layout.run(&t2, cast(f64, W), cast(f64, H));
    listview.scroll_to_row(&t2, lv2, 25);
    layout.run(&t2, cast(f64, W), cast(f64, H));
    let is f64 as x2 = row_x(&t2, lv2);
    drag_row(&t2, &r2, lv2, 27, row_y(&t2, lv2, 26) - rh / 4.0, 100);
    check("below something, scrolled: before the row under it", listview.drop_at(&t2, lv2) == 26);
    router.pointer_button(&t2, &r2, 1, 0, x2, row_y(&t2, lv2, 26) - rh / 4.0, 110);
    check("and so said", moves == 4 && moved_from == 27 && moved_to == 26);
    tree.close(&t2);

    // What it does not take goes on past it: a menu asked for on a row.
    let is tree.Tree as t3 = tree_for();
    let is router.Router as menu_router = router.init(router.settings_default());
    tree.set_router(&t3, cast(*u8, &menu_router));
    rows(5);
    let is i64 as lv3 = held(&t3);
    listview.set_reorderable(&t3, lv3, 1);
    layout.run(&t3, cast(f64, W), cast(f64, H));
    menus = 0;
    button_at(&t3, &menu_router, 3, row_x(&t3, lv3), row_y(&t3, lv3, 1), 200);
    check("a menu asked for on a row: past the list", menus == 1);
    tree.close(&t3);
}

// --- Told ---

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    fruits();
    let is i64 as lv = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is tree.Access as q;
    access.describe(&t, &r, lv, &q);
    check("told: a list", q.role == access.ROLE_LIST && (q.states & access.MULTISELECTABLE) == 0);
    check("all its rows counted, no columns", q.rows == 10 && q.columns == 0 && q.headers == 0);
    check("its rows told as its own, not its scroll area's", access.role(&t, listview.area(&t, lv)) == access.ROLE_NONE);
    listview.set_selection_mode(&t, lv, listview.MULTIPLE);
    access.describe(&t, &r, lv, &q);
    check("many chosen: so told", (q.states & access.MULTISELECTABLE) != 0);
    let is i64 as rw = listview.row_widget(&t, lv, 0);
    access.describe(&t, &r, rw, &q);
    check("its rows list items, named, selectable", q.role == access.ROLE_LIST_ITEM && same(q.name, q.name_len, "apple") == 1 &&
          (q.states & access.SELECTABLE) != 0 && (q.states & access.SELECTED) == 0);
    check("a row: where it is among them", q.row == 0 && q.rows == 10 && (q.actions & access.DESELECT) != 0);
    check("chosen by assistive technology", access.act(&t, rw, access.SELECT, 0.0) == 1 && listview.is_selected(&t, lv, 0) == 1);
    access.describe(&t, &r, rw, &q);
    check("then so told", (q.states & access.SELECTED) != 0);
    access.act(&t, listview.row_widget(&t, lv, 1), access.SELECT, 0.0);
    check("many at a time: another added", listview.selected_count(&t, lv) == 2 && listview.is_selected(&t, lv, 0) == 1);
    check("let go of by assistive technology", access.act(&t, rw, access.DESELECT, 0.0) == 1 &&
          listview.is_selected(&t, lv, 0) == 0 && listview.selected_count(&t, lv) == 1);
    listview.set_selection_mode(&t, lv, listview.SINGLE);
    access.act(&t, listview.row_widget(&t, lv, 2), access.SELECT, 0.0);
    check("one at a time: it instead", listview.selected_count(&t, lv) == 1 && listview.is_selected(&t, lv, 2) == 1);
    listview.set_selection_mode(&t, lv, listview.MULTIPLE);
    activations = 0;
    check("activated by it", access.act(&t, rw, access.PRESS, 0.0) == 1 && activations == 1 && activated == 1);
    check("not a list view: nothing", listview.count(&t, tree.root(&t)) == 0 && listview.cursor(&t, tree.root(&t)) == 0 - 1 &&
          listview.row_widget(&t, tree.root(&t), 0) == 0 && listview.selected_count(&t, tree.root(&t)) == 0 &&
          listview.index_of_row(&t, lv) == 0 - 1);
    tree.close(&t);
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;
    m = model.make(cast(*u8, 0), fn_ptr(items_count), fn_ptr(items_row_id), fn_ptr(items_cell));

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    shown();
    chosen();
    taken();
    ranges();
    shifted();
    settled();
    hooked();
    followed();
    typed();
    factory();
    iconed();
    drawn(&c);
    reordered(&c);
    told();

    if (fails == 0) {
        io.printf("listview: %d checks passed\n", checks);
        return 0;
    }
    io.printf("listview: %d of %d checks failed\n", fails, checks);
    return 1;
}
