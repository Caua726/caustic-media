// ui/widgets/treeview.cst — a tree model's rows, branches opened and closed.
//
// A tree view is a list view (listview.cst) over the rows of a tree that
// show (flatten.cst): the top level, and under each open row its children,
// each row its name after an expander, one indent further in for each level
// down. The expander opens and closes its row's branch, as do Right and Left
// — the other way round right to left: Right on a closed row opens it and on
// an open one goes to its first child; Left on an open row closes it and on
// another goes to its parent. A branch's children are read only when it
// opens. Rows are chosen, typed to and activated as in any list, and the
// tree view says SELECTION_CHANGED and ACTIVATED too. Told as a tree of tree
// items, those with children expandable, expanded while open.
use "../../math/math.cst" as math;
use "../../input/keys.cst" as keys;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../signal.cst" as signal;
use "../model.cst" as model;
use "../flatten.cst" as flatten;
use "label.cst" as label;
use "listview.cst" as listview;

struct Data {
    t      as *tree.Tree;
    self   as i64;
    list   as i64;
    flat   as *flatten.Flat;
    indent as f64;   // 0 for the theme's
}

// A row's content: its expander and its name, depth indents in.
struct Cell {
    owner as i64;
    depth as i64;
}

struct Exp {
    owner as i64;
}

let is tree.Kind as _kind with mut;
let is tree.Kind as _cell_kind with mut;
let is tree.Kind as _exp_kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("tree view", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.event = fn_ptr(_event);
    _kind.destroy = fn_ptr(_destroy);
    _cell_kind = widget.kind("tree cell", sizeof(Cell));
    _cell_kind.measure = fn_ptr(_cell_measure);
    _cell_kind.arrange = fn_ptr(_cell_arrange);
    _exp_kind = widget.kind("tree expander", sizeof(Exp));
    _exp_kind.measure = fn_ptr(_exp_measure);
    _exp_kind.paint = fn_ptr(_exp_paint);
    _exp_kind.event = fn_ptr(_exp_event);
    _ready = 1;
}

// A new tree view of src's rows — src stays where it is while the tree view
// has it — as the last child of parent, its top level shown. Its handle, or
// 0.
fn create(t as *tree.Tree, parent as i64, src as *model.Model) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.t = t;
    d.self = w;
    d.flat = flatten.open(src);
    if (cast(i64, d.flat) == 0) {
        tree.destroy(t, w);
        return 0;
    }
    d.list = listview.create(t, w, flatten.model_of(d.flat));
    if (d.list == 0) {
        tree.destroy(t, w);
        return 0;
    }
    listview.set_factory(t, d.list, fn_ptr(_setup), fn_ptr(_bind), cast(*u8, d));
    listview.set_roles(t, d.list, access.ROLE_TREE, access.ROLE_TREE_ITEM);
    listview.set_row_access(t, d.list, fn_ptr(_row_access), cast(*u8, d));
    signal.connect(t, d.list, signal.SELECTION_CHANGED, fn_ptr(_pass), cast(*u8, d));
    signal.connect(t, d.list, signal.ACTIVATED, fn_ptr(_pass_activated), cast(*u8, d));
    return w;
}

// The list's children go first, so the flat model has no one left
// observing it when it closes.
fn _destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    flatten.close(cast(*Data, data).flat);
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

// The list view it shows its rows in: its selection, its cursor, its rows.
fn list(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.list;
}

// The rows shown, as flatten.cst keeps them.
fn flat(t as *tree.Tree, w as i64) as *flatten.Flat {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return cast(*flatten.Flat, 0); }
    return d.flat;
}

fn is_expanded(t as *tree.Tree, w as i64, index as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return flatten.is_expanded(d.flat, index);
}

fn expand(t as *tree.Tree, w as i64, index as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return flatten.expand(d.flat, index);
}

fn collapse(t as *tree.Tree, w as i64, index as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return flatten.collapse(d.flat, index);
}

// How much further in each level is.
fn indent(t as *tree.Tree, w as i64) as f64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0.0; }
    if (d.indent > 0.0) { return d.indent; }
    let is style.Theme as th;
    widget.theme(t, w, &th);
    return th.metrics.indicator + th.metrics.space_xs;
}

fn set_indent(t as *tree.Tree, w as i64, px as f64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.indent = px;
    widget.changed(t, d.list, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
}

// A row widget's name label and its expander.
fn row_label(t as *tree.Tree, row as i64) as i64 { return tree.next_sibling(t, row_expander(t, row)); }

fn row_expander(t as *tree.Tree, row as i64) as i64 { return tree.first_child(t, tree.first_child(t, row)); }

// --- Its rows ---

fn _setup(user as *u8, t as *tree.Tree, row as i64) as void {
    let is *Data as d = cast(*Data, user);
    let is i64 as cell = tree.create(t, &_cell_kind, row);
    if (cell == 0) { return; }
    cast(*Cell, tree.data(t, cell)).owner = d.self;
    let is i64 as exp = tree.create(t, &_exp_kind, cell);
    if (exp != 0) { cast(*Exp, tree.data(t, exp)).owner = d.self; }
    let is i64 as l = label.create(t, cell, "", 0);
    label.set_lines(t, l, 1, 1);
    tree.set_labelled_by(t, row, l);
}

fn _bind(user as *u8, t as *tree.Tree, row as i64, id as i64, index as i64) as void {
    let is *Data as d = cast(*Data, user);
    let is i64 as cell = tree.first_child(t, row);
    let is *Cell as cd = cast(*Cell, tree.data(t, cell));
    cd.depth = cast(i64, flatten.depth(d.flat, index));
    widget.changed(t, cell, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    listview.show_text(t, row_label(t, row), flatten.model_of(d.flat), id, 0);
}

// The row an expander is in: its index, -1 for none.
fn _index_of(t as *tree.Tree, exp as i64) as i64 {
    return listview.index_of_row(t, tree.parent(t, tree.parent(t, exp)));
}

fn _pass(t as *tree.Tree, l as i64, arg as *u8, user as *u8) as void {
    signal.emit(t, cast(*Data, user).self, signal.SELECTION_CHANGED, arg);
}

fn _pass_activated(t as *tree.Tree, l as i64, arg as *u8, user as *u8) as void {
    signal.emit(t, cast(*Data, user).self, signal.ACTIVATED, arg);
}

// --- Measuring and arranging ---

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.measure(t, cast(*Data, data).list, c, out);
}

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is math.rect.Rect as all = math.rect.rect(0.0, 0.0, r.w, r.h);
    layout.place(t, cast(*Data, data).list, &all);
}

fn _gap(th as *style.Theme) as f64 { return th.metrics.space_xs; }

fn _cell_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Cell as cd = cast(*Cell, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as k = th.metrics.indicator;
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    layout.measure(t, tree.last_child(t, w), &free, &ls);
    geom.size_zero(out);
    out.pref_w = cast(f64, cd.depth) * indent(t, cd.owner) + k + _gap(&th) + ls.pref_w;
    out.pref_h = _max(k, ls.pref_h);
    out.min_h = out.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// depth indents in from the start edge, the expander, then the name in what
// is left.
fn _cell_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Cell as cd = cast(*Cell, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as k = th.metrics.indicator;
    let is f64 as x0 = cast(f64, cd.depth) * indent(t, cd.owner);
    let is i64 as l = tree.last_child(t, w);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    layout.measure(t, l, &free, &ls);
    let is f64 as lx = x0 + k + _gap(&th);
    let is math.rect.Rect as er with mut = math.rect.rect(x0, (r.h - k) / 2.0, k, k);
    let is math.rect.Rect as lr with mut = math.rect.rect(lx, (r.h - ls.pref_h) / 2.0, _max(0.0, r.w - lx), ls.pref_h);
    if (layout.direction(t, w) == layout.RTL) {
        er.x = r.w - x0 - k;
        lr.x = r.w - lx - lr.w;
    }
    layout.place(t, tree.first_child(t, w), &er);
    layout.place(t, l, &lr);
}

fn _exp_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is style.Theme as th;
    widget.theme(t, w, &th);
    geom.size_zero(out);
    out.pref_w = th.metrics.indicator;
    out.pref_h = th.metrics.indicator;
    out.min_w = out.pref_w;
    out.min_h = out.pref_h;
    out.max_w = out.pref_w;
    out.max_h = out.pref_h;
}

// --- Opening and closing ---

fn _exp_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.kind != event.POINTER_DOWN || e.button != 1) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, cast(*Exp, data).owner));
    let is i64 as i = _index_of(t, w);
    if (flatten.expandable(d.flat, i) == 0) { return 0; }
    flatten.toggle(d.flat, i);
    return 1;
}

// Right and Left — the other way right to left — that the list has no use
// for.
fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Data as d = cast(*Data, data);
    if (e.kind != event.KEY_DOWN || e.mods != 0) { return 0; }
    let is i32 as on with mut = keys.RIGHT;
    let is i32 as back with mut = keys.LEFT;
    if (layout.direction(t, w) == layout.RTL) {
        on = keys.LEFT;
        back = keys.RIGHT;
    }
    if (e.key != on && e.key != back) { return 0; }
    let is i64 as c = listview.cursor(t, d.list);
    if (c < 0) { return 1; }
    let is *flatten.Flat as f = d.flat;
    if (e.key == on) {
        if (flatten.is_expanded(f, c) == 1) {
            if (flatten.depth(f, c + 1) > flatten.depth(f, c)) { listview.go_to(t, d.list, c + 1); }
        } else {
            flatten.expand(f, c);
        }
        return 1;
    }
    if (flatten.is_expanded(f, c) == 1) {
        flatten.collapse(f, c);
    } else {
        let is i64 as up = flatten.parent_index(f, c);
        if (up >= 0) { listview.go_to(t, d.list, up); }
    }
    return 1;
}

// --- Drawn ---

// A triangle along the line when closed, down when open; nothing for a row
// with no children.
fn _exp_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Data as d = cast(*Data, tree.data(t, cast(*Exp, data).owner));
    let is i64 as i = _index_of(t, w);
    if (flatten.expandable(d.flat, i) == 0) { return; }
    let is f64 as x = p.rect.x + p.rect.w / 2.0;
    let is f64 as y = p.rect.y + p.rect.h / 2.0;
    let is f64 as a = p.rect.w * 0.3;
    let is [3]f64 as xs;
    let is [3]f64 as ys;
    if (flatten.is_expanded(d.flat, i) == 1) {
        xs[0] = x - a; ys[0] = y - a * 0.5;
        xs[1] = x + a; ys[1] = y - a * 0.5;
        xs[2] = x;     ys[2] = y + a * 0.5;
    } else {
        let is f64 as dir with mut = 1.0;
        if (layout.direction(t, w) == layout.RTL) { dir = 0.0 - 1.0; }
        xs[0] = x - dir * a * 0.5; ys[0] = y - a;
        xs[1] = x + dir * a * 0.5; ys[1] = y;
        xs[2] = x - dir * a * 0.5; ys[2] = y + a;
    }
    let is math.color.Color as ink with mut = p.fg;
    if (ink.a <= 0.0) { ink = p.theme.palette.fg; }
    shapes.fill_convex(p.canvas, cast(*f64, &xs), cast(*f64, &ys), 3, ink);
}

// --- Told ---

fn _row_access(user as *u8, t as *tree.Tree, row as i64, index as i64, q as *tree.Access) as i64 {
    let is *Data as d = cast(*Data, user);
    if (q.action == access.ASK) {
        if (flatten.expandable(d.flat, index) == 1) {
            q.states = q.states | access.EXPANDABLE;
            if (flatten.is_expanded(d.flat, index) == 1) {
                q.states = q.states | access.EXPANDED;
                q.actions = q.actions | access.COLLAPSE;
            } else {
                q.actions = q.actions | access.EXPAND;
            }
        }
        return 1;
    }
    if (q.action == access.EXPAND) { return cast(i64, flatten.expand(d.flat, index)); }
    if (q.action == access.COLLAPSE) { return cast(i64, flatten.collapse(d.flat, index)); }
    return 0;
}
