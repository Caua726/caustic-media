// ui/widgets/menubutton_test.cst — a menu button: a menu or a popover opened
// under it by pointer and keys, drawn and told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../input/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "label.cst" as label;
use "../event.cst" as event;
use "../scroll.cst" as scroll;
use "../model.cst" as model;
use "menu.cst" as menu;
use "menubutton.cst" as menubutton;
use "../popup.cst" as popup;
use "../../window/positioner.cst" as positioner;
use "button.cst" as button;

let is i64 as W with imut = 400;
let is i64 as H with imut = 240;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}



fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

// Placed on whole pixels: a middle can be half of one off.
fn within1(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d <= 1.0 && d >= 0.0 - 1.0);
}

fn mx(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).x + layout.window_rect(t, w).w / 2.0; }
fn my(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).y + layout.window_rect(t, w).h / 2.0; }

let is i64 as chosen with mut = 0;
fn on_choose(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { chosen = *cast(*i64, arg); }

fn says(t as *tree.Tree, l as i64, s as *u8) as i32 { return same(label.text(t, l), label.text_length(t, l), s); }

fn made(t as *tree.Tree) as i64 {
    let is i64 as mb = menubutton.create(t, tree.root(t), "_Options", 8);
    layout.set_align(t, mb, layout.START, layout.START);
    layout.set_margin(t, mb, 100.0, 10.0, 0.0, 0.0);
    return mb;
}

fn menus() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as mb = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("titled, its mnemonic taken out", says(&t, menubutton.label_of(&t, mb), "Options") == 1 && menubutton.is_open(&t, mb) == 0);
    click(&t, &r, mx(&t, mb), my(&t, mb), 10);
    check("nothing to open: nothing", menubutton.is_open(&t, mb) == 0);
    let is i64 as m = menu.create(&t);
    let is i64 as first = menu.add_item(&t, m, "_First", 6, 1);
    menu.add_item(&t, m, "_Second", 7, 2);
    signal.connect(&t, m, signal.ACTIVATED, fn_ptr(on_choose), cast(*u8, 0));
    menubutton.set_menu(&t, mb, m);
    check("its menu", menubutton.menu_of(&t, mb) == m);
    let is math.rect.Rect as br = layout.window_rect(&t, mb);
    router.pointer_move(&t, &r, mx(&t, mb), my(&t, mb), 100);
    router.pointer_button(&t, &r, 1, 1, mx(&t, mb), my(&t, mb), 100);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as mr = layout.window_rect(&t, m);
    check("pressed: its menu under it, flush with its start", menubutton.is_open(&t, mb) == 1 && menu.is_open(&t, m) == 1 &&
          near(mr.y, br.y + br.h) == 1 && near(mr.x, br.x) == 1);
    router.pointer_button(&t, &r, 1, 0, mx(&t, mb), my(&t, mb), 101);
    check("let go where pressed: still open", menu.is_open(&t, m) == 1);
    key(&t, &r, keys.ESCAPE, 0, 110);
    check("escape: closed", menubutton.is_open(&t, mb) == 0);
    router.focus(&t, &r, mb, 1);
    key(&t, &r, keys.SPACE, 0, 200);
    check("space: open, its first item chosen", menu.is_open(&t, m) == 1 && menu.current(&t, m) == first);
    key(&t, &r, keys.RETURN, 0, 210);
    check("an item chosen: said by the menu, closed, the focus back", chosen == 1 && menu.is_open(&t, m) == 0 &&
          router.focused(&t, &r) == mb);
    key(&t, &r, keys.DOWN, 0, 300);
    check("down: open", menu.is_open(&t, m) == 1);
    key(&t, &r, keys.ESCAPE, 0, 310);
    key(&t, &r, keys.RETURN, 0, 320);
    check("enter: open", menu.is_open(&t, m) == 1);
    key(&t, &r, keys.ESCAPE, 0, 330);
    check("keys it has no use for: not taken", router.key(&t, &r, keys.LEFT, 0, 1, 0, 340) == 0);
    router.key(&t, &r, keys.LEFT, 0, 0, 0, 341);
    // Its mnemonic.
    menubutton.bind_mnemonic(&t, &r, mb);
    key(&t, &r, keys.O, keys.MOD_ALT, 400);
    check("alt and its letter: open", menu.is_open(&t, m) == 1);
    key(&t, &r, keys.ESCAPE, 0, 410);
    // Right to left: flush with its right.
    layout.set_direction(&t, mb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as br2 = layout.window_rect(&t, mb);
    menubutton.open(&t, mb);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as mr2 = layout.window_rect(&t, m);
    check("right to left: flush with its right", near(mr2.x + mr2.w, br2.x + br2.w) == 1);
    key(&t, &r, keys.ESCAPE, 0, 500);
    let is math.rect.Rect as lr2 = layout.window_rect(&t, menubutton.label_of(&t, mb));
    let is math.rect.Rect as ar2 = menubutton.arrow_rect(&t, mb);
    let is f64 as px = theme.metrics.control_pad_x;
    check("right to left: its title from the right, its arrow at the left", near(lr2.x + lr2.w, br2.x + br2.w - px) == 1 &&
          near(ar2.x, br2.x + px) == 1);
    check("not a menu button: nothing", menubutton.is_open(&t, tree.root(&t)) == 0 && menubutton.menu_of(&t, tree.root(&t)) == 0 &&
          menubutton.label_of(&t, tree.root(&t)) == 0 && menubutton.popover_of(&t, tree.root(&t)) == 0);
    tree.close(&t);
}

fn popovers() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as mb = made(&t);
    let is i64 as pv = popup.create(&t);
    popup.set_arrow(&t, pv, 1);
    let is i64 as inside = button.create(&t, pv, "Inside", 6);
    menubutton.set_popover(&t, mb, pv);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as br = layout.window_rect(&t, mb);
    click(&t, &r, mx(&t, mb), my(&t, mb), 10);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as pr = layout.window_rect(&t, pv);
    check("clicked: its popover under it, its middle under its middle, the focus inside", menubutton.is_open(&t, mb) == 1 &&
          menubutton.popover_of(&t, mb) == pv && near(pr.y, br.y + br.h) == 1 && within1(pr.x + pr.w / 2.0, br.x + br.w / 2.0) == 1 &&
          router.focused(&t, &r) == inside && popup.arrow_side(&t, pv) == positioner.TOP);
    key(&t, &r, keys.ESCAPE, 0, 100);
    check("escape: closed, the focus back", menubutton.is_open(&t, mb) == 0 && router.focused(&t, &r) == mb);
    key(&t, &r, keys.SPACE, 0, 200);
    check("space: open", popup.is_open(&t, pv) == 1);
    click(&t, &r, mx(&t, mb), my(&t, mb), 300);
    check("pressed on it again: closed, not opened again", popup.is_open(&t, pv) == 0);
    check("opened by assistive technology", access.act(&t, mb, access.EXPAND, 0.0) == 1 && popup.is_open(&t, pv) == 1);
    check("and closed", access.act(&t, mb, access.COLLAPSE, 0.0) == 1 && popup.is_open(&t, pv) == 0);
    tree.close(&t);
}

// What it passes on.
let is i64 as caught with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase == event.BUBBLE && (e.kind == event.POINTER_DOWN || e.kind == event.KEY_DOWN)) {
        caught = caught + 1;
        return 1;
    }
    return 0;
}

fn catch_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catch_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as catcher with mut;

fn passed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t, &catcher, tree.root(&t));
    let is i64 as mb = menubutton.create(&t, holder, "Go", 2);
    layout.set_align(&t, mb, layout.START, layout.START);
    let is i64 as m = menu.create(&t);
    menu.add_item(&t, m, "One", 3, 1);
    menubutton.set_menu(&t, mb, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    caught = 0;
    router.pointer_move(&t, &r, mx(&t, mb), my(&t, mb), 10);
    router.pointer_button(&t, &r, 1, 1, mx(&t, mb), my(&t, mb), 10);
    check("pressed: its own", caught == 0 && menu.is_open(&t, m) == 1);
    router.pointer_button(&t, &r, 1, 0, mx(&t, mb), my(&t, mb), 11);
    key(&t, &r, keys.ESCAPE, 0, 20);
    router.focus(&t, &r, mb, 1);
    caught = 0;
    router.key(&t, &r, keys.SPACE, 0, 1, 0, 30);
    check("space: its own", caught == 0 && menu.is_open(&t, m) == 1);
    router.key(&t, &r, keys.SPACE, 0, 0, 0, 31);
    key(&t, &r, keys.ESCAPE, 0, 40);
    caught = 0;
    router.pointer_button(&t, &r, 3, 1, mx(&t, mb), my(&t, mb), 50);
    router.pointer_button(&t, &r, 3, 0, mx(&t, mb), my(&t, mb), 51);
    check("the right button: on up", caught == 1 && menu.is_open(&t, m) == 0);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ms;
    let is geom.Size as ls;
    layout.measure(&t, mb, &free, &ms);
    layout.measure(&t, menubutton.label_of(&t, mb), &free, &ls);
    check("as wide as its title and arrow", near(ms.pref_w, 2.0 * theme.metrics.control_pad_x + ls.pref_w + theme.metrics.space_s +
          theme.metrics.indicator) == 1);
    let is math.rect.Rect as ar = menubutton.arrow_rect(&t, mb);
    let is math.rect.Rect as br = layout.window_rect(&t, mb);
    check("its arrow across its middle", near(ar.y + ar.h / 2.0, br.y + br.h / 2.0) == 1);
    tree.close(&t);
}

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is i64 as mb = made(&t);
    frame(&t, c);
    let is math.rect.Rect as br = layout.window_rect(&t, mb);
    let is style.Look as look = style.pick(&theme.control, 0, 0);
    check("a control", is8(cast(i64, br.x + 4.0), cast(i64, br.y + br.h / 2.0), bg_of(look), 3) == 1);
    let is math.rect.Rect as ar = menubutton.arrow_rect(&t, mb);
    check("an arrow at its end, pointing down", near(ar.x + ar.w, br.x + br.w - theme.metrics.control_pad_x) == 1 &&
          is8(cast(i64, ar.x + ar.w / 2.0), cast(i64, ar.y + ar.h / 2.0), look.fg, 90) == 1 &&
          is8(cast(i64, ar.x + ar.w / 2.0), cast(i64, ar.y + ar.h * 0.8), look.fg, 90) == 0);
    let is math.rect.Rect as lr = layout.window_rect(&t, menubutton.label_of(&t, mb));
    check("its title before it", near(lr.x, br.x + theme.metrics.control_pad_x) == 1 && lr.x + lr.w <= ar.x &&
          near(lr.y + lr.h / 2.0, br.y + br.h / 2.0) == 1 && near(br.h, theme.metrics.control_height) == 1);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as mb = made(&t);
    let is i64 as m = menu.create(&t);
    menu.add_item(&t, m, "One", 3, 1);
    menubutton.set_menu(&t, mb, m);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is tree.Access as q;
    access.describe(&t, &r, mb, &q);
    check("told: a button that opens, named, closed", q.role == access.ROLE_BUTTON && same(q.name, q.name_len, "Options") == 1 &&
          (q.states & access.EXPANDABLE) != 0 && (q.states & access.EXPANDED) == 0 && (q.actions & access.PRESS) != 0);
    check("pressed by assistive technology: open", access.act(&t, mb, access.PRESS, 0.0) == 1 && menu.is_open(&t, m) == 1);
    access.describe(&t, &r, mb, &q);
    check("then told open", (q.states & access.EXPANDED) != 0 && (q.actions & access.COLLAPSE) != 0);
    check("closed by it", access.act(&t, mb, access.COLLAPSE, 0.0) == 1 && menu.is_open(&t, m) == 0);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    menus();
    popovers();
    passed();
    drawn(&c);
    told();

    if (fails == 0) {
        io.printf("menubutton: %d checks passed\n", checks);
        return 0;
    }
    io.printf("menubutton: %d of %d checks failed\n", fails, checks);
    return 1;
}
