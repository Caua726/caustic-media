// ui/widgets/slider_test.cst — the slider: a value in a range, held to its
// step; jumped to by a click on its track and dragged by its knob; moved by
// the arrows, Page Up and Down, Home and End and the wheel; across or up and
// down, mirrored right to left; marks; drawn in the track variants; told.
use "std/io.cst" as io;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../../input/keys.cst" as keys;
use "slider.cst" as slider;

let is i64 as W with imut = 200;
let is i64 as H with imut = 100;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [20000]i32 as px with mut;
let is style.Theme as theme with mut;

let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

fn measure(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

let is i64 as changes with mut = 0;
let is f64 as said with mut = 0.0;

fn on_change(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    changes = changes + 1;
    said = *cast(*f64, arg);
}

fn bump(user as *u8) as void {
    let is *i64 as n = cast(*i64, user);
    *n = *n + 1;
}

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.0001 && d > 0.0 - 0.0001);
}

fn main() as i32 {
    theme = style.light();
    frame_router = cast(*router.Router, 0);
    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    let is i64 as root = tree.root(&t);
    let is i64 as w = slider.create(&t, root, 0.0, 100.0, 5.0);
    check("a slider at its least, focusable", w != 0 && tree.kind(&t, w).role == access.ROLE_SLIDER &&
          slider.value(&t, w) == 0.0 && tree.is_focusable(&t, w) == 1);
    let is f64 as k = theme.metrics.indicator;
    let is geom.Size as s with mut = measure(&t, w);
    check("across: a knob tall, room to move in", s.min_h == k && s.pref_h == k && s.min_w == 3.0 * k &&
          s.pref_w == 10.0 * k && s.max_w >= layout.UNBOUNDED);
    signal.connect(&t, w, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));

    // Set: held to the range and the step, said with the value.
    check("set", slider.set_value(&t, w, 42.0) == 1 && slider.value(&t, w) == 40.0 && changes == 1 && said == 40.0);
    slider.set_value(&t, w, 43.0);
    check("to the nearest step", slider.value(&t, w) == 45.0 && changes == 2);
    slider.set_value(&t, w, 45.0);
    check("as it is: nothing said", changes == 2);
    slider.set_value(&t, w, 500.0);
    check("held to the most", slider.value(&t, w) == 100.0);
    slider.set_value(&t, w, 0.0 - 7.0);
    check("and the least", slider.value(&t, w) == 0.0);
    check("a new range: the value held to it", slider.set_range(&t, w, 10.0, 20.0, 1.0) == 1 &&
          slider.value(&t, w) == 10.0);
    slider.set_range(&t, w, 0.0, 100.0, 5.0);
    check("no step: any value", slider.set_range(&t, w, 0.0, 100.0, 0.0) == 1 && slider.set_value(&t, w, 42.5) == 1 &&
          slider.value(&t, w) == 42.5);
    slider.set_range(&t, w, 0.0, 100.0, 5.0);
    check("a range the wrong way round: refused", slider.set_range(&t, w, 5.0, 1.0, 1.0) == 0);
    check("a range of one value", slider.set_range(&t, w, 5.0, 5.0, 1.0) == 1 && slider.value(&t, w) == 5.0);
    slider.set_range(&t, w, 0.0, 100.0, 5.0);
    check("its page, its direction, its marks: set", slider.set_page(&t, w, 0.0) == 1 &&
          slider.set_vertical(&t, w, 0) == 1 && slider.set_marks(&t, w, cast(*f64, 0), 0) == 1);

    // By keyboard.
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, w, 1);
    slider.set_value(&t, w, 50.0);
    key(&t, &r, keys.RIGHT, 0, 10);
    check("right: a step up", slider.value(&t, w) == 55.0);
    key(&t, &r, keys.UP, 0, 20);
    check("up: a step up", slider.value(&t, w) == 60.0);
    key(&t, &r, keys.LEFT, 0, 30);
    key(&t, &r, keys.DOWN, 0, 40);
    check("left and down: a step down each", slider.value(&t, w) == 50.0);
    key(&t, &r, keys.PAGE_UP, 0, 50);
    check("page up: a page, ten steps", slider.value(&t, w) == 100.0);
    key(&t, &r, keys.PAGE_DOWN, 0, 60);
    check("page down", slider.value(&t, w) == 50.0);
    slider.set_page(&t, w, 20.0);
    key(&t, &r, keys.PAGE_UP, 0, 65);
    check("a page of its own", slider.value(&t, w) == 70.0);
    key(&t, &r, keys.HOME, 0, 70);
    check("home: the least", slider.value(&t, w) == 0.0);
    key(&t, &r, keys.END, 0, 80);
    check("end: the most", slider.value(&t, w) == 100.0);
    key(&t, &r, keys.B, 0, 90);
    key(&t, &r, keys.TAB, 0, 95);
    check("other keys: not its", slider.value(&t, w) == 100.0);
    let is i64 as next = slider.create(&t, root, 0.0, 1.0, 0.0);
    tree.set_visible(&t, next, 0);
    tree.set_visible(&t, next, 1);
    router.focus(&t, &r, w, 1);
    key(&t, &r, keys.TAB, 0, 96);
    check("tab: on to the next", router.focused(&t, &r) == next);
    tree.destroy(&t, next);
    router.focus(&t, &r, w, 1);
    layout.set_direction(&t, w, layout.RTL);
    slider.set_value(&t, w, 50.0);
    key(&t, &r, keys.RIGHT, 0, 100);
    check("right to left, right: down", slider.value(&t, w) == 45.0);
    layout.set_direction(&t, w, layout.INHERIT);

    // The wheel: up, a step up.
    let is math.rect.Rect as tr with mut = slider.track(&t, w);
    router.scroll(&t, &r, tr.x + 10.0, tr.y + tr.h / 2.0, 0.0, 0.0 - 1.0, 1, 110);
    check("the wheel up: a step up", slider.value(&t, w) == 50.0);
    router.scroll(&t, &r, tr.x + 10.0, tr.y + tr.h / 2.0, 0.0, 2.0, 1, 120);
    check("down two notches: two steps down", slider.value(&t, w) == 40.0);
    router.scroll(&t, &r, tr.x + 10.0, tr.y + tr.h / 2.0, 1.0, 0.0, 1, 125);
    check("right a notch: a step up", slider.value(&t, w) == 45.0);
    router.scroll(&t, &r, tr.x + 10.0, tr.y + tr.h / 2.0, 0.0, 0.0 - 10.0, 0, 127);
    check("smoothly up ten pixels: a step up", slider.value(&t, w) == 50.0);
    slider.set_value(&t, w, 40.0);

    // The pointer: a click on the track jumps there; the knob dragged.
    layout.run(&t, cast(f64, W), cast(f64, H));
    tr = slider.track(&t, w);
    let is math.rect.Rect as wr0 = layout.window_rect(&t, w);
    check("its track: a knob's half in from each end, in the middle of the knob's row",
          tr.x == wr0.x + k / 2.0 && tr.w == wr0.w - k && tr.h == k / 4.0 && tr.y == wr0.y + (k - k / 4.0) / 2.0);
    let is f64 as y = tr.y + tr.h / 2.0;
    click(&t, &r, tr.x + tr.w * 0.8, y, 200);
    check("clicked on its track: there", slider.value(&t, w) == 80.0 && changes > 0);
    let is math.rect.Rect as kr with mut = slider.knob(&t, w);
    check("the knob where the value is", near(kr.x + kr.w / 2.0, tr.x + tr.w * 0.8) == 1 && kr.w == k &&
          kr.h == k && near(kr.y + k / 2.0, tr.y + tr.h / 2.0) == 1);
    router.pointer_move(&t, &r, kr.x + kr.w / 2.0 + 6.0, y, 300);
    router.pointer_button(&t, &r, 1, 1, kr.x + kr.w / 2.0 + 6.0, y, 300);
    check("the knob pressed: where it was", slider.value(&t, w) == 80.0);
    router.pointer_move(&t, &r, tr.x + tr.w * 0.3 + 6.0, y, 310);
    check("dragged: with it, as held", slider.value(&t, w) == 30.0);
    router.pointer_move(&t, &r, tr.x - 50.0, y, 320);
    check("dragged past its start: the least", slider.value(&t, w) == 0.0);
    router.pointer_button(&t, &r, 1, 0, tr.x - 50.0, y, 330);
    router.pointer_move(&t, &r, tr.x + tr.w * 0.5, y, 340);
    check("released: no more", slider.value(&t, w) == 0.0);
    router.key(&t, &r, keys.SHIFT_L, keys.MOD_SHIFT, 1, 0, 340);
    click(&t, &r, tr.x + tr.w * 0.9, y, 342);
    check("shift and a click past the knob: a page towards it", slider.value(&t, w) == 20.0);
    click(&t, &r, tr.x + tr.w * 0.1, y, 344);
    check("before it: a page back", slider.value(&t, w) == 0.0);
    router.key(&t, &r, keys.SHIFT_L, 0, 0, 0, 346);
    router.pointer_button(&t, &r, 3, 1, tr.x + tr.w * 0.5, y, 350);
    check("another button: not its", slider.value(&t, w) == 0.0 && router.capture(&r) != w);
    router.pointer_button(&t, &r, 3, 0, tr.x + tr.w * 0.5, y, 360);

    // Up and down: the least at the bottom.
    slider.set_vertical(&t, w, 1);
    s = measure(&t, w);
    check("up and down: a knob wide", s.min_w == k && s.pref_w == k && s.min_h == 3.0 * k && s.pref_h == 10.0 * k);
    layout.run(&t, cast(f64, W), cast(f64, H));
    tr = slider.track(&t, w);
    click(&t, &r, tr.x + tr.w / 2.0, tr.y + tr.h * 0.25, 400);
    check("clicked near the top: near the most", slider.value(&t, w) == 75.0);
    let is math.rect.Rect as wv with mut = layout.window_rect(&t, w);
    check("up and down: the track a knob's half in at each end, in the middle of its column",
          tr.y == wv.y + k / 2.0 && tr.h == wv.h - k && tr.w == k / 4.0 && tr.x == wv.x + (k - k / 4.0) / 2.0);
    kr = slider.knob(&t, w);
    check("the knob a quarter down", near(kr.y + k / 2.0, tr.y + tr.h * 0.25) == 1 &&
          near(kr.x + k / 2.0, tr.x + tr.w / 2.0) == 1);
    router.pointer_move(&t, &r, tr.x + tr.w / 2.0, kr.y + k / 2.0 + 6.0, 405);
    router.pointer_button(&t, &r, 1, 1, tr.x + tr.w / 2.0, kr.y + k / 2.0 + 6.0, 405);
    router.pointer_move(&t, &r, tr.x + tr.w / 2.0, tr.y + tr.h * 0.5 + 6.0, 406);
    router.pointer_button(&t, &r, 1, 0, tr.x + tr.w / 2.0, tr.y + tr.h * 0.5 + 6.0, 407);
    check("dragged by its knob, as held", slider.value(&t, w) == 50.0);
    slider.set_value(&t, w, 75.0);
    key(&t, &r, keys.UP, 0, 410);
    check("up: up", slider.value(&t, w) == 80.0);
    frame(&t, &c);
    let is i64 as vx = cast(i64, tr.x + tr.w / 2.0);
    check("filled from the bottom, no further", is8(vx, cast(i64, tr.y + tr.h + 3.0), theme.palette.window_bg, 1) == 1);
    check("filled from the bottom", is8(vx, cast(i64, tr.y + tr.h * 0.95), theme.track.checked.bg, 1) == 1 &&
          is8(vx, cast(i64, tr.y + tr.h * 0.08), style.over(theme.track.normal.bg, theme.palette.window_bg), 1) == 1);
    let is [1]f64 as vm;
    vm[0] = 50.0;
    slider.set_marks(&t, w, cast(*f64, &vm), 1);
    frame(&t, &c);
    wv = layout.window_rect(&t, w);
    tr = slider.track(&t, w);
    let is i64 as my = cast(i64, tr.y + tr.h * 0.5);
    check("a mark beside the track", is8(cast(i64, wv.x + k + 3.0), my, theme.palette.fg_dim, 2) == 1 &&
          is8(cast(i64, wv.x + k - 1.0), my, theme.palette.window_bg, 1) == 1 &&
          is8(cast(i64, wv.x + k * 1.5 + 1.0), my, theme.palette.window_bg, 1) == 1 &&
          is8(cast(i64, wv.x + k + 3.0), my + 3, theme.palette.window_bg, 1) == 1);
    slider.set_marks(&t, w, cast(*f64, 0), 0);
    slider.set_vertical(&t, w, 0);

    // Right to left: from the right.
    layout.set_direction(&t, w, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    tr = slider.track(&t, w);
    slider.set_value(&t, w, 25.0);
    kr = slider.knob(&t, w);
    check("right to left: the knob from the right", near(kr.x + k / 2.0, tr.x + tr.w * 0.75) == 1);
    frame(&t, &c);
    let is i64 as hy = cast(i64, tr.y + tr.h / 2.0);
    check("filled from the right, no further", is8(cast(i64, tr.x + tr.w + 3.0), hy, theme.palette.window_bg, 1) == 1);
    check("filled from the right", is8(cast(i64, tr.x + tr.w * 0.95), hy, theme.track.checked.bg, 1) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.3), hy, style.over(theme.track.normal.bg, theme.palette.window_bg), 1) == 1);
    click(&t, &r, tr.x + tr.w * 0.1, tr.y + tr.h / 2.0, 420);
    check("clicked near the left: near the most", slider.value(&t, w) == 90.0);
    layout.set_direction(&t, w, layout.INHERIT);

    // A range not from 0.
    slider.set_range(&t, w, 10.0, 20.0, 1.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    tr = slider.track(&t, w);
    click(&t, &r, tr.x + tr.w * 0.3, tr.y + tr.h / 2.0, 430);
    check("from 10 to 20: a third of the way, 13", slider.value(&t, w) == 13.0);
    kr = slider.knob(&t, w);
    check("its knob there", near(kr.x + k / 2.0, tr.x + tr.w * 0.3) == 1);
    slider.set_range(&t, w, 0.0, 100.0, 5.0);

    // Drawn: filled to the knob, empty after; the knob in the control's look.
    layout.run(&t, cast(f64, W), cast(f64, H));
    slider.set_value(&t, w, 50.0);
    frame(&t, &c);
    tr = slider.track(&t, w);
    kr = slider.knob(&t, w);
    let is i64 as ty = cast(i64, tr.y + tr.h / 2.0);
    check("filled to the knob", is8(cast(i64, tr.x + tr.w * 0.25), ty, theme.track.checked.bg, 1) == 1);
    check("and no further", is8(cast(i64, kr.x + k + 4.0), ty, style.over(theme.track.normal.bg,
          theme.palette.window_bg), 1) == 1);
    check("empty after it", is8(cast(i64, tr.x + tr.w * 0.75), ty, style.over(theme.track.normal.bg,
          theme.palette.window_bg), 1) == 1);
    check("the knob in the control's background", is8(cast(i64, kr.x + kr.w / 2.0), ty,
          style.over(theme.control.normal.bg, theme.palette.window_bg), 2) == 1);
    let is [3]f64 as marks;
    marks[0] = 0.0;
    marks[1] = 25.0;
    marks[2] = 100.0;
    slider.set_marks(&t, w, cast(*f64, &marks), 3);
    s = measure(&t, w);
    check("marks: taller, room for them", s.pref_h > k);
    frame(&t, &c);
    tr = slider.track(&t, w);
    let is math.rect.Rect as wr = layout.window_rect(&t, w);
    check("a mark below the track where its value is", is8(cast(i64, tr.x + tr.w * 0.25),
          cast(i64, wr.y + k + 3.0), theme.palette.fg_dim, 2) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.6), cast(i64, wr.y + k + 3.0), theme.palette.window_bg, 1) == 1);
    check("from just below the knob's row to half a knob down", is8(cast(i64, tr.x + tr.w * 0.25),
          cast(i64, wr.y + k - 1.0), theme.palette.window_bg, 1) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.25), cast(i64, wr.y + k * 1.5 + 1.0), theme.palette.window_bg, 1) == 1 &&
          is8(cast(i64, tr.x + tr.w * 0.25) + 2, cast(i64, wr.y + k + 3.0), theme.palette.window_bg, 1) == 1);
    slider.set_marks(&t, w, cast(*f64, 0), 0);

    // Told; moved by assistive technology.
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("told: its value in its range, by its step", q.has_value == 1 && q.value == 50.0 && q.min == 0.0 &&
          q.max == 100.0 && q.step == 5.0 && (q.states & access.HORIZONTAL) != 0 &&
          (q.actions & access.SET_VALUE) != 0 && (q.actions & access.INCREMENT) != 0);
    check("set by it", access.act(&t, w, access.SET_VALUE, 62.0) == 1 && slider.value(&t, w) == 60.0);
    check("a step up by it", access.act(&t, w, access.INCREMENT, 0.0) == 1 && slider.value(&t, w) == 65.0);
    check("a step down", access.act(&t, w, access.DECREMENT, 0.0) == 1 && slider.value(&t, w) == 60.0);
    slider.set_vertical(&t, w, 1);
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("told: up and down", (q.states & access.VERTICAL) != 0 && (q.states & access.HORIZONTAL) == 0);
    slider.set_vertical(&t, w, 0);
    tree.set_enabled(&t, w, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    click(&t, &r, tr.x + tr.w * 0.1, y, 500);
    check("disabled: not moved", slider.value(&t, w) == 60.0);

    check("not a slider: nothing", slider.set_value(&t, root, 1.0) == 0 && slider.value(&t, root) == 0.0 &&
          slider.set_range(&t, root, 0.0, 1.0, 0.0) == 0 && slider.set_page(&t, root, 1.0) == 0 &&
          slider.set_vertical(&t, root, 1) == 0 && slider.set_marks(&t, root, cast(*f64, 0), 0) == 0);
    let is tree.Limits as tl = tree.limits_default();
    tl.widgets = 1;
    let is tree.Tree as full = tree.open(&tl);
    check("no room: no slider", slider.create(&full, tree.root(&full), 0.0, 1.0, 0.0) == 0);
    tree.close(&full);
    tree.close(&t);
    if (fails == 0) {
        io.printf("slider: %d checks passed\n", checks);
        return 0;
    }
    io.printf("slider: %d of %d checks failed\n", fails, checks);
    return 1;
}
