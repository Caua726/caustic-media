// ui/widgets/expander_test.cst — an expander: a title that shows or hides
// what is under it; turned by the pointer, Space, Enter, its mnemonic and
// assistive technology; its chevron pointing the way; told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../input/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../event.cst" as event;
use "../text.cst" as text;
use "label.cst" as label;
use "button.cst" as button;
use "../scroll.cst" as scroll;
use "expander.cst" as expander;

let is i64 as W with imut = 300;
let is i64 as H with imut = 200;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

let is i64 as toggles with mut = 0;
fn on_toggle(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { toggles = toggles + 1; }

fn measure(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

// Something 100 by 80 inside it.
fn filled(t as *tree.Tree, e as i64) as i64 {
    let is i64 as b = button.create(t, expander.content(t, e), "Inside", 6);
    layout.set_min_size(t, b, 100.0, 80.0);
    return b;
}

// What bubbles out of it: presses and keys it does not take.
let is i64 as caught with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase == event.BUBBLE && (e.kind == event.KEY_DOWN || e.kind == event.POINTER_DOWN)) {
        caught = caught + 1;
        return 1;
    }
    return 0;
}

fn catch_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catch_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as catcher with mut;

fn made() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as e = expander.create(&t, tree.root(&t), "_More", 5);
    layout.set_align(&t, e, layout.START, layout.START);
    let is i64 as inside = filled(&t, e);
    signal.connect(&t, e, signal.TOGGLED, fn_ptr(on_toggle), cast(*u8, 0));
    check("an expander: closed, its content hidden, taking the focus", e != 0 && expander.expanded(&t, e) == 0 &&
          tree.is_visible(&t, expander.content(&t, e)) == 0 && tree.is_focusable(&t, e) == 1 &&
          label.text_length(&t, expander.title(&t, e)) == 4);
    let is geom.Size as closed = measure(&t, e);
    let is geom.Size as ts = measure(&t, expander.title(&t, e));
    check("closed: only its title", closed.pref_h >= theme.metrics.control_height && closed.pref_h < 80.0 &&
          near(closed.pref_w, theme.metrics.indicator + theme.metrics.space_s + ts.pref_w) == 1);
    toggles = 0;
    check("opened", expander.set_expanded(&t, e, 1) == 1 && expander.expanded(&t, e) == 1 && toggles == 1 &&
          tree.is_visible(&t, expander.content(&t, e)) == 1);
    check("again: nothing", expander.set_expanded(&t, e, 1) == 0 && toggles == 1);
    let is geom.Size as open = measure(&t, e);
    check("open: its title and under it what it holds", near(open.pref_h, closed.pref_h + 80.0) == 1 &&
          near(open.min_h, closed.pref_h + 80.0) == 1 && open.pref_w >= 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ir = layout.window_rect(&t, inside);
    let is math.rect.Rect as er = layout.window_rect(&t, e);
    let is math.rect.Rect as tr = layout.window_rect(&t, expander.title(&t, e));
    let is math.rect.Rect as cr = layout.window_rect(&t, expander.content(&t, e));
    let is math.rect.Rect as chv = expander.chevron_rect(&t, e);
    check("what it holds under the title, the rest of it", near(ir.y, closed.pref_h) == 1 &&
          near(cr.y, er.y + closed.pref_h) == 1 && near(cr.h, er.h - closed.pref_h) == 1);
    check("its title after the triangle, both in the middle of the row",
          near(tr.x, er.x + theme.metrics.indicator + theme.metrics.space_s) == 1 &&
          near(tr.y + tr.h / 2.0, er.y + closed.pref_h / 2.0) == 1 && near(chv.y + chv.h / 2.0, er.y + closed.pref_h / 2.0) == 1);
    layout.set_direction(&t, e, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as er2 = layout.window_rect(&t, e);
    let is math.rect.Rect as tr2 = layout.window_rect(&t, expander.title(&t, e));
    check("right to left: its title before the triangle on the right",
          near(tr2.x + tr2.w, er2.x + er2.w - theme.metrics.indicator - theme.metrics.space_s) == 1);
    layout.set_direction(&t, e, layout.LTR);
    // What it holds smaller at least than it would like: both told.
    let is i64 as e2 = expander.create(&t, tree.root(&t), "Two", 3);
    let is i64 as sa = scroll.create(&t, expander.content(&t, e2));
    let is i64 as big = button.create(&t, sa, "Big", 3);
    layout.set_min_size(&t, big, 100.0, 80.0);
    expander.set_expanded(&t, e2, 1);
    let is geom.Size as s2 = measure(&t, e2);
    check("what it holds would like more than it needs: so would it", near(s2.min_h, closed.pref_h) == 1 &&
          near(s2.pref_h, closed.pref_h + 80.0) == 1);
    tree.destroy(&t, e2);
    expander.set_expanded(&t, e, 0);
    check("closed again", expander.expanded(&t, e) == 0 && toggles == 2 && tree.is_visible(&t, expander.content(&t, e)) == 0);
    let is router.Router as r0 = router.init(router.settings_default());
    check("not an expander: nothing", expander.set_expanded(&t, tree.root(&t), 1) == 0 &&
          expander.expanded(&t, tree.root(&t)) == 0 && expander.content(&t, tree.root(&t)) == 0 &&
          expander.title(&t, tree.root(&t)) == 0 && expander.bind_mnemonic(&t, &r0, tree.root(&t)) == 0 &&
          expander.chevron_rect(&t, tree.root(&t)).w == 0.0);
    tree.close(&t);
}

fn turned() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as e = expander.create(&t, tree.root(&t), "_More", 5);
    layout.set_align(&t, e, layout.START, layout.START);
    filled(&t, e);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as er = layout.window_rect(&t, e);
    click(&t, &r, er.x + 10.0, er.y + 5.0, 10);
    check("its title clicked: open", expander.expanded(&t, e) == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    click(&t, &r, er.x + 10.0, er.y + 5.0, 1000);
    check("again: closed", expander.expanded(&t, e) == 0);
    router.focus(&t, &r, e, 1);
    key(&t, &r, keys.SPACE, 0, 2000);
    check("space: open", expander.expanded(&t, e) == 1);
    key(&t, &r, keys.RETURN, 0, 2010);
    check("enter: closed", expander.expanded(&t, e) == 0);
    router.focus(&t, &r, 0, 0);
    expander.bind_mnemonic(&t, &r, e);
    key(&t, &r, keys.M, keys.MOD_ALT, 2020);
    check("its mnemonic: open, and focused", expander.expanded(&t, e) == 1 && router.focused(&t, &r) == e);
    // Opened, what it holds takes presses as ever.
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as inside = tree.first_child(&t, expander.content(&t, e));
    let is math.rect.Rect as ir = layout.window_rect(&t, inside);
    click(&t, &r, ir.x + 10.0, ir.y + 10.0, 3000);
    check("a press inside what it holds: not the expander's", expander.expanded(&t, e) == 1);
    tree.close(&t);
    // Inside something that catches what it does not take.
    let is tree.Tree as t2 = tree_for();
    let is router.Router as r2 = router.init(router.settings_default());
    tree.set_router(&t2, cast(*u8, &r2));
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t2, &catcher, tree.root(&t2));
    let is i64 as e2 = expander.create(&t2, holder, "_More", 5);
    layout.set_align(&t2, e2, layout.START, layout.START);
    let is i64 as plain = label.create(&t2, expander.content(&t2, e2), "Plain words", 11);
    expander.set_expanded(&t2, e2, 1);
    layout.run(&t2, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as er2 = layout.window_rect(&t2, e2);
    caught = 0;
    router.pointer_button(&t2, &r2, 3, 1, er2.x + 10.0, er2.y + 5.0, 10);
    router.pointer_button(&t2, &r2, 3, 0, er2.x + 10.0, er2.y + 5.0, 11);
    check("the right button on its title: not turned, passed on", expander.expanded(&t2, e2) == 1 && caught >= 1);
    caught = 0;
    router.pointer_button(&t2, &r2, 1, 1, er2.x + 10.0, er2.y + 5.0, 20);
    check("pressed, not yet let go: turned, and its own", expander.expanded(&t2, e2) == 0 && caught == 0);
    router.pointer_button(&t2, &r2, 1, 0, er2.x + 10.0, er2.y + 5.0, 21);
    check("let go: still", expander.expanded(&t2, e2) == 0);
    expander.set_expanded(&t2, e2, 1);
    layout.run(&t2, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as pr = layout.window_rect(&t2, plain);
    caught = 0;
    click(&t2, &r2, pr.x + 3.0, pr.y + 3.0, 1000);
    check("a press in what it holds that nothing takes: passed on", caught == 1 && expander.expanded(&t2, e2) == 1);
    router.focus(&t2, &r2, e2, 1);
    caught = 0;
    key(&t2, &r2, keys.SPACE, 0, 2000);
    check("space: its own", caught == 0 && expander.expanded(&t2, e2) == 0);
    key(&t2, &r2, keys.F5, 0, 2010);
    check("a key it has no use for: passed on", caught == 1);
    tree.close(&t2);
}

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    frame_router = &r;
    let is i64 as e = expander.create(&t, tree.root(&t), "More", 4);
    layout.set_align(&t, e, layout.START, layout.START);
    frame(&t, c);
    let is math.rect.Rect as ch = expander.chevron_rect(&t, e);
    // Closed: pointing along the line, its ink on the side it points to.
    let is i64 as right_ink with mut = 0;
    let is i64 as left_ink with mut = 0;
    let is i64 as y with mut = cast(i64, ch.y);
    while (y < cast(i64, ch.y + ch.h)) {
        if (is8(cast(i64, ch.x + ch.w * 0.58), y, theme.palette.fg, 80) == 1) { right_ink = right_ink + 1; }
        if (is8(cast(i64, ch.x + ch.w * 0.42), y, theme.palette.fg, 80) == 1) { left_ink = left_ink + 1; }
        y = y + 1;
    }
    check("closed: the chevron points along the line", right_ink < left_ink);
    expander.set_expanded(&t, e, 1);
    frame(&t, c);
    let is i64 as top_ink with mut = 0;
    let is i64 as bottom_ink with mut = 0;
    let is i64 as x with mut = cast(i64, ch.x);
    while (x < cast(i64, ch.x + ch.w)) {
        if (is8(x, cast(i64, ch.y + ch.h * 0.42), theme.palette.fg, 80) == 1) { top_ink = top_ink + 1; }
        if (is8(x, cast(i64, ch.y + ch.h * 0.58), theme.palette.fg, 80) == 1) { bottom_ink = bottom_ink + 1; }
        x = x + 1;
    }
    check("open: down", bottom_ink < top_ink);
    // Right to left: the chevron at the right, closed pointing left.
    expander.set_expanded(&t, e, 0);
    layout.set_direction(&t, e, layout.RTL);
    frame(&t, c);
    let is math.rect.Rect as ch2 = expander.chevron_rect(&t, e);
    let is math.rect.Rect as er = layout.window_rect(&t, e);
    right_ink = 0;
    left_ink = 0;
    y = cast(i64, ch2.y);
    while (y < cast(i64, ch2.y + ch2.h)) {
        if (is8(cast(i64, ch2.x + ch2.w * 0.58), y, theme.palette.fg, 80) == 1) { right_ink = right_ink + 1; }
        if (is8(cast(i64, ch2.x + ch2.w * 0.42), y, theme.palette.fg, 80) == 1) { left_ink = left_ink + 1; }
        y = y + 1;
    }
    check("right to left: at the right, pointing left", ch2.x + ch2.w > er.x + er.w / 2.0 && left_ink < right_ink);
    frame_router = cast(*router.Router, 0);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as e = expander.create(&t, tree.root(&t), "_More", 5);
    filled(&t, e);
    let is tree.Access as q;
    access.describe(&t, &r, e, &q);
    check("told: a button that expands, named by its title", q.role == access.ROLE_BUTTON &&
          (q.states & access.EXPANDABLE) != 0 && (q.states & access.EXPANDED) == 0 && q.name_len == 4 &&
          (q.actions & access.EXPAND) != 0 && (q.actions & access.PRESS) != 0);
    check("expanded by assistive technology", access.act(&t, e, access.EXPAND, 0.0) == 1 && expander.expanded(&t, e) == 1);
    access.describe(&t, &r, e, &q);
    check("then told so, collapsing offered", (q.states & access.EXPANDED) != 0 && (q.actions & access.COLLAPSE) != 0 &&
          (q.actions & access.EXPAND) == 0);
    access.act(&t, e, access.COLLAPSE, 0.0);
    check("collapsed", expander.expanded(&t, e) == 0);
    access.act(&t, e, access.PRESS, 0.0);
    check("pressed: turned", expander.expanded(&t, e) == 1);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    made();
    turned();
    drawn(&c);
    told();

    if (fails == 0) {
        io.printf("expander: %d checks passed\n", checks);
        return 0;
    }
    io.printf("expander: %d of %d checks failed\n", fails, checks);
    return 1;
}
