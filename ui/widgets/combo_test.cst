// ui/widgets/combo_test.cst — a combo box: one of a model's rows chosen from
// a list that drops down, by pointer and keys, following the model, drawn and
// told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "label.cst" as label;
use "../event.cst" as event;
use "../scroll.cst" as scroll;
use "../model.cst" as model;
use "listview.cst" as listview;
use "combo.cst" as combo;
use "../popup.cst" as popup;
use "button.cst" as button;
use "entry.cst" as entry;

let is i64 as W with imut = 400;
let is i64 as H with imut = 240;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}



// --- Rows: "Row k" for id 100 + k ---
struct Items {
    n   as i64;
    ids as [64]i64;
}

let is Items as items with mut;
let is model.Model as m with mut;
let is [16]u8 as namebuf with mut;

fn items_count(self as *u8, parent as i64) as i64 {
    if (parent != 0) { return 0; }
    return items.n;
}

fn items_row_id(self as *u8, parent as i64, index as i64) as i64 {
    if (parent != 0 || index < 0 || index >= items.n) { return 0; }
    return items.ids[index];
}

fn items_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    if (role != model.TEXT || column != 0) { return 0; }
    if (id == 200) {
        *out = model.text("Apple", 5);
        return 1;
    }
    if (id == 201) {
        *out = model.text("Zebra", 5);
        return 1;
    }
    if (id == 202) {
        *out = model.text("Row longer one", 14);
        return 1;
    }
    if (id >= 6000) {
        *out = model.integer(id - 6000);
        return 1;
    }
    let is i64 as k = id - 100;
    let is *u8 as p = cast(*u8, &namebuf);
    p[0] = cast(u8, 82);
    p[1] = cast(u8, 111);
    p[2] = cast(u8, 119);
    p[3] = cast(u8, 32);
    if (k >= 10) {
        p[4] = cast(u8, 48 + k / 10);
        p[5] = cast(u8, 48 + k % 10);
        *out = model.text(p, 6);
        return 1;
    }
    p[4] = cast(u8, 48 + k);
    *out = model.text(p, 5);
    return 1;
}

fn rows(n as i64) as void {
    items.n = n;
    let is i64 as i with mut = 0;
    while (i < n) {
        items.ids[i] = 100 + i;
        i = i + 1;
    }
}

let is i64 as changes with mut = 0;
let is i64 as last_index with mut = 0;

fn on_change(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    changes = changes + 1;
    last_index = *cast(*i64, arg);
}

fn says(t as *tree.Tree, cb as i64, s as *u8) as i32 {
    let is i64 as l = combo.text_label(t, cb);
    return same(label.text(t, l), label.text_length(t, l), s);
}

fn made(t as *tree.Tree) as i64 {
    rows(20);
    let is i64 as cb = combo.create(t, tree.root(t), &m);
    layout.set_align(t, cb, layout.START, layout.START);
    layout.set_margin(t, cb, 40.0, 0.0, 0.0, 0.0);
    signal.connect(t, cb, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    return cb;
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn mx(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).x + layout.window_rect(t, w).w / 2.0; }
fn my(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).y + layout.window_rect(t, w).h / 2.0; }

fn chosen() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as cb = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("nothing chosen yet", combo.selected(&t, cb) == 0 - 1 && combo.selected_id(&t, cb) == 0 &&
          label.text_length(&t, combo.text_label(&t, cb)) == 0 && combo.is_open(&t, cb) == 0);
    changes = 0;
    combo.set_selected(&t, cb, 3);
    check("chosen by the program: shown, said", combo.selected(&t, cb) == 3 && combo.selected_id(&t, cb) == 103 &&
          says(&t, cb, "Row 3") == 1 && changes == 1 && last_index == 3);
    combo.set_selected(&t, cb, 3);
    check("the same again: nothing said", changes == 1);
    combo.set_selected(&t, cb, 20);
    combo.set_selected(&t, cb, 0 - 2);
    check("no such row: as it was", combo.selected(&t, cb) == 3);
    combo.set_selected(&t, cb, 0);
    check("the first", combo.selected_id(&t, cb) == 100 && says(&t, cb, "Row 0") == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    combo.open(&t, cb);
    check("opened on the first: the first chosen there", listview.is_selected(&t, combo.list_of(&t, cb), 0) == 1 &&
          listview.cursor(&t, combo.list_of(&t, cb)) == 0);
    popup.close(&t, combo.popup_of(&t, cb));
    combo.set_selected(&t, cb, 3);
    layout.set_min_size(&t, cb, 150.0, 0.0);
    // Opened by the pointer.
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as cr = layout.window_rect(&t, cb);
    click(&t, &r, mx(&t, cb), my(&t, cb), 10);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as pp = combo.popup_of(&t, cb);
    let is i64 as lv = combo.list_of(&t, cb);
    let is math.rect.Rect as pr = layout.window_rect(&t, pp);
    check("clicked: its list drops down under it, as wide", combo.is_open(&t, cb) == 1 && popup.is_open(&t, pp) == 1 &&
          near(pr.y, cr.y + cr.h) == 1 && near(pr.x, cr.x) == 1 && near(pr.w, cr.w) == 1);
    check("the chosen row chosen there, the keyboard on it", listview.is_selected(&t, lv, 3) == 1 && listview.cursor(&t, lv) == 3 &&
          router.focused(&t, &r) == lv);
    check("no more than ten rows tall", pr.h <= 10.0 * listview.row_height(&t, lv) + 20.0 && pr.h > 9.0 * listview.row_height(&t, lv));
    // A row clicked: chosen, closed, the focus back.
    let is i64 as rw = listview.row_widget(&t, lv, 5);
    click(&t, &r, mx(&t, rw), my(&t, rw), 1000);
    check("a row clicked: chosen, closed, said", combo.selected(&t, cb) == 5 && combo.is_open(&t, cb) == 0 && changes == 4 &&
          says(&t, cb, "Row 5") == 1 && router.focused(&t, &r) == cb);
    // By the keys.
    key(&t, &r, keys.SPACE, 0, 2000);
    check("space: open", combo.is_open(&t, cb) == 1);
    key(&t, &r, keys.DOWN, 0, 2010);
    key(&t, &r, keys.DOWN, 0, 2020);
    check("down in it: not chosen yet", combo.selected(&t, cb) == 5);
    key(&t, &r, keys.RETURN, 0, 2030);
    check("enter: that one", combo.selected(&t, cb) == 7 && combo.is_open(&t, cb) == 0);
    key(&t, &r, keys.DOWN, keys.MOD_ALT, 2100);
    check("alt down: open", combo.is_open(&t, cb) == 1);
    key(&t, &r, keys.DOWN, 0, 2110);
    key(&t, &r, keys.ESCAPE, 0, 2120);
    check("escape: closed, as it was", combo.is_open(&t, cb) == 0 && combo.selected(&t, cb) == 7 && router.focused(&t, &r) == cb);
    key(&t, &r, keys.F4, 0, 2200);
    check("F4: open", combo.is_open(&t, cb) == 1);
    key(&t, &r, keys.F4, 0, 2210);
    key(&t, &r, keys.ESCAPE, 0, 2220);
    key(&t, &r, keys.RETURN, 0, 2300);
    check("enter: open", combo.is_open(&t, cb) == 1);
    key(&t, &r, keys.ESCAPE, 0, 2310);
    // Closed: the arrows choose at once.
    changes = 0;
    key(&t, &r, keys.DOWN, 0, 3000);
    check("closed, down: the next, at once", combo.selected(&t, cb) == 8 && changes == 1 && combo.is_open(&t, cb) == 0);
    key(&t, &r, keys.UP, 0, 3010);
    key(&t, &r, keys.UP, 0, 3020);
    check("up: back", combo.selected(&t, cb) == 6);
    key(&t, &r, keys.END, 0, 3030);
    check("end: the last", combo.selected(&t, cb) == 19);
    key(&t, &r, keys.DOWN, 0, 3040);
    check("down at the last: there still, nothing said", combo.selected(&t, cb) == 19 && changes == 4);
    key(&t, &r, keys.HOME, 0, 3050);
    check("home: the first", combo.selected(&t, cb) == 0);
    key(&t, &r, keys.UP, 0, 3060);
    check("up at the first: there still", combo.selected(&t, cb) == 0);
    check("keys it has no use for: not taken", router.key(&t, &r, keys.LEFT, 0, 1, 0, 3070) == 0);
    router.key(&t, &r, keys.LEFT, 0, 0, 0, 3071);
    // Opened by the program; pressed outside: closed.
    combo.open(&t, cb);
    check("opened by the program", combo.is_open(&t, cb) == 1);
    click(&t, &r, 390.0, 230.0, 4000);
    check("pressed outside: closed, as it was", combo.is_open(&t, cb) == 0 && combo.selected(&t, cb) == 0);
    tree.close(&t);
}

fn followed() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as cb = made(&t);
    combo.set_selected(&t, cb, 5);
    changes = 0;
    let is i64 as i with mut = items.n;
    while (i > 0) {
        items.ids[i] = items.ids[i - 1];
        i = i - 1;
    }
    items.ids[0] = 150;
    items.n = items.n + 1;
    model.inserted(&m, 0, 0, 1);
    check("a row inserted before it: the same row chosen", combo.selected(&t, cb) == 6 && combo.selected_id(&t, cb) == 105 &&
          changes == 0);
    model.inserted(&m, 0, 10, 0);
    i = 6;
    while (i + 1 < items.n) {
        items.ids[i] = items.ids[i + 1];
        i = i + 1;
    }
    items.n = items.n - 1;
    model.removed(&m, 0, 6, 1);
    check("its row removed: none chosen, said", combo.selected(&t, cb) == 0 - 1 && changes == 1 &&
          label.text_length(&t, combo.text_label(&t, cb)) == 0);
    combo.set_selected(&t, cb, 2);
    items.ids[2] = 111;
    model.changed(&m, 0, 2, 1);
    check("its row changed: shown again", says(&t, cb, "Row 11") == 1);
    model.removed(&m, 0, 10, 1);
    items.n = items.n - 1;
    check("a row after it removed: the same chosen", combo.selected(&t, cb) == 2);
    model.inserted(&m, 0, 2, 1);
    items.n = items.n + 1;
    check("inserted at its place: it moves on", combo.selected(&t, cb) == 3);
    model.removed(&m, 0, 0, 1);
    items.n = items.n - 1;
    check("a row before it removed: it moves back", combo.selected(&t, cb) == 2);
    model.removed(&m, 0, 0, 2);
    items.n = items.n - 2;
    check("the rows just before it removed: it moves back to the first", combo.selected(&t, cb) == 0);
    model.inserted(&m, 0, 0, 1);
    items.n = items.n + 1;
    check("the first, a row inserted before it: on", combo.selected(&t, cb) == 1);
    model.removed(&m, 0, 0, 1);
    items.n = items.n - 1;
    changes = 0;
    model.removed(&m, 0, 0, 1);
    items.n = items.n - 1;
    check("the first removed: none, said so", combo.selected(&t, cb) == 0 - 1 && changes == 1 && last_index == 0 - 1);
    combo.set_selected(&t, cb, 0);
    model.reset(&m);
    check("the first, reset: none", combo.selected(&t, cb) == 0 - 1);
    combo.set_selected(&t, cb, 2);
    changes = 0;
    model.reset(&m);
    check("reset: none chosen, said", combo.selected(&t, cb) == 0 - 1 && changes == 1);
    model.reset(&m);
    check("reset with none chosen: nothing said", changes == 1);
    tree.destroy(&t, cb);
    model.reset(&m);
    check("destroyed: no longer heard", changes == 1);
    tree.close(&t);
}

fn laid() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as cb = made(&t);
    combo.set_selected(&t, cb, 12);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as cr = layout.window_rect(&t, cb);
    let is math.rect.Rect as lr = layout.window_rect(&t, combo.text_label(&t, cb));
    let is f64 as px = theme.metrics.control_pad_x;
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    layout.measure(&t, combo.text_label(&t, cb), &free, &ls);
    check("as tall as a control, as wide as its text and arrow", near(cr.h, theme.metrics.control_height) == 1 &&
          near(cr.w, 2.0 * px + ls.pref_w + theme.metrics.space_s + theme.metrics.indicator) == 1);
    check("its text from the start, across its middle", near(lr.x, cr.x + px) == 1 && near(lr.y + lr.h / 2.0, cr.y + cr.h / 2.0) == 1 &&
          near(lr.w, cr.w - 2.0 * px - theme.metrics.space_s - theme.metrics.indicator) == 1);
    let is math.rect.Rect as ar = combo.arrow_rect(&t, cb);
    check("its arrow at the end", near(ar.x + ar.w, cr.x + cr.w - px) == 1 && near(ar.y + ar.h / 2.0, cr.y + cr.h / 2.0) == 1);
    layout.set_direction(&t, cb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as cr2 = layout.window_rect(&t, cb);
    let is math.rect.Rect as lr2 = layout.window_rect(&t, combo.text_label(&t, cb));
    let is math.rect.Rect as ar2 = combo.arrow_rect(&t, cb);
    check("right to left: its text from the right, its arrow at the left", near(lr2.x + lr2.w, cr2.x + cr2.w - px) == 1 &&
          near(ar2.x, cr2.x + px) == 1);
    layout.set_max_size(&t, cb, 60.0, 100.0);
    layout.set_margin(&t, cb, 40.0, 0.0, 100.0, 0.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as cr3 = layout.window_rect(&t, cb);
    combo.open(&t, cb);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as pr = layout.window_rect(&t, combo.popup_of(&t, cb));
    check("right to left: its list, wider than it, flush with its right", pr.w > cr3.w + 1.0 && near(pr.x + pr.w, cr3.x + cr3.w) == 1);
    tree.close(&t);
}

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is i64 as cb = made(&t);
    combo.set_selected(&t, cb, 1);
    frame(&t, c);
    let is math.rect.Rect as cr = layout.window_rect(&t, cb);
    let is style.Look as look = style.pick(&theme.control, 0, 0);
    check("in a control's colours", is8(cast(i64, cr.x + 4.0), cast(i64, cr.y + cr.h / 2.0), bg_of(look), 3) == 1);
    let is math.rect.Rect as ar = combo.arrow_rect(&t, cb);
    let is i64 as ax = cast(i64, ar.x + ar.w / 2.0);
    let is i64 as ay = cast(i64, ar.y + ar.h / 2.0);
    check("its arrow pointing down", is8(ax, ay, theme.palette.fg, 90) == 1 && is8(ax, cast(i64, ar.y + ar.h * 0.8), theme.palette.fg, 90) == 0);
    let is i64 as l = combo.text_label(&t, cb);
    check("its text in the text colour", is8(ink_x(&t, l), ink_y(&t, l), look.fg, 60) == 1);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as cb = made(&t);
    combo.set_selected(&t, cb, 4);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is tree.Access as q;
    access.describe(&t, &r, cb, &q);
    check("told: a combo box, what is chosen its value, closed", q.role == access.ROLE_COMBO_BOX &&
          same(q.description, q.description_len, "Row 4") == 1 && (q.states & access.EXPANDABLE) != 0 &&
          (q.states & access.EXPANDED) == 0 && (q.actions & access.EXPAND) != 0);
    check("opened by assistive technology", access.act(&t, cb, access.EXPAND, 0.0) == 1 && combo.is_open(&t, cb) == 1);
    access.describe(&t, &r, cb, &q);
    check("then told open", (q.states & access.EXPANDED) != 0 && (q.actions & access.COLLAPSE) != 0);
    check("closed by it", access.act(&t, cb, access.COLLAPSE, 0.0) == 1 && combo.is_open(&t, cb) == 0);
    check("pressed by it: opened", access.act(&t, cb, access.PRESS, 0.0) == 1 && combo.is_open(&t, cb) == 1);
    access.act(&t, cb, access.COLLAPSE, 0.0);
    check("not a combo box: nothing", combo.selected(&t, tree.root(&t)) == 0 - 1 && combo.is_open(&t, tree.root(&t)) == 0 &&
          combo.text_label(&t, tree.root(&t)) == 0 && combo.list_of(&t, tree.root(&t)) == 0 &&
          combo.button_of(&t, tree.root(&t)) == 0 && combo.popup_of(&t, tree.root(&t)) == 0);
    let is i64 as pp = combo.popup_of(&t, cb);
    tree.destroy(&t, cb);
    check("destroyed: its list with it", tree.is_valid(&t, pp) == 0);
    tree.close(&t);
}

// --- Typed in, with suggestions ---

fn typed_text(t as *tree.Tree, cb as i64, s as *u8) as i32 {
    let is i64 as e = combo.entry_of(t, cb);
    return same(entry.text(t, e), entry.length(t, e), s);
}

fn typed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    rows(20);
    let is i64 as cb = combo.create_entry(&t, tree.root(&t), &m);
    layout.set_align(&t, cb, layout.START, layout.START);
    layout.set_min_size(&t, cb, 200.0, 0.0);
    signal.connect(&t, cb, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    let is i64 as other = button.create(&t, tree.root(&t), "Other", 5);
    layout.set_align(&t, other, layout.END, layout.END);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as e = combo.entry_of(&t, cb);
    check("an entry, nothing in it, nothing chosen", e != 0 && entry.length(&t, e) == 0 && combo.selected(&t, cb) == 0 - 1 &&
          combo.is_open(&t, cb) == 0);
    router.focus(&t, &r, e, 1);
    router.text(&t, &r, "Row 1", 5, 10);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as lv = combo.list_of(&t, cb);
    check("typed: the rows it starts, under it, the focus kept", combo.is_open(&t, cb) == 1 && combo.suggestions(&t, cb) == 11 &&
          listview.count(&t, lv) == 11 && router.focused(&t, &r) == e && typed_text(&t, cb, "Row 1") == 1);
    let is math.rect.Rect as cr = layout.window_rect(&t, cb);
    let is math.rect.Rect as pr = layout.window_rect(&t, combo.popup_of(&t, cb));
    check("under it, as wide", near(pr.y, cr.y + cr.h) == 1 && near(pr.w, cr.w) == 1);
    router.text(&t, &r, "x", 1, 20);
    check("typed so nothing starts it: gone", combo.is_open(&t, cb) == 0 && router.focused(&t, &r) == e);
    key(&t, &r, keys.BACKSPACE, 0, 30);
    check("back: there again", combo.is_open(&t, cb) == 1 && combo.suggestions(&t, cb) == 11);
    // The arrows move through them from the entry; Enter takes one.
    key(&t, &r, keys.DOWN, 0, 40);
    key(&t, &r, keys.DOWN, 0, 50);
    check("down, down: the second", listview.cursor(&t, lv) == 1 && router.focused(&t, &r) == e);
    key(&t, &r, keys.UP, 0, 60);
    key(&t, &r, keys.DOWN, 0, 70);
    changes = 0;
    key(&t, &r, keys.RETURN, 0, 80);
    check("enter: taken, its text in the entry, said", typed_text(&t, cb, "Row 10") == 1 && combo.is_open(&t, cb) == 0 &&
          changes == 1 && last_index == 10 && combo.selected(&t, cb) == 10 && router.focused(&t, &r) == e);
    check("the caret at its end", entry.caret(&t, e) == 6);
    // Edited: no row chosen any more.
    router.text(&t, &r, "z", 1, 90);
    check("edited: none chosen, nothing it starts", combo.selected(&t, cb) == 0 - 1 && combo.is_open(&t, cb) == 0);
    // The first row taken, then edited: said none.
    entry.set_text(&t, e, "", 0);
    router.text(&t, &r, "Row 0", 5, 92);
    key(&t, &r, keys.DOWN, 0, 94);
    key(&t, &r, keys.RETURN, 0, 96);
    changes = 0;
    router.text(&t, &r, "x", 1, 98);
    check("the first taken, then edited: none, said", combo.selected(&t, cb) == 0 - 1 && changes == 1);
    // Escape closes them, the text kept.
    entry.set_text(&t, e, "", 0);
    router.text(&t, &r, "Row", 3, 100);
    check("all twenty start so", combo.suggestions(&t, cb) == 20);
    key(&t, &r, keys.ESCAPE, 0, 110);
    check("escape: closed, the text kept", combo.is_open(&t, cb) == 0 && typed_text(&t, cb, "Row") == 1 && router.focused(&t, &r) == e);
    // Tab closes them, and goes on.
    router.text(&t, &r, " 2", 2, 120);
    check("one starts so", combo.suggestions(&t, cb) == 1 && combo.is_open(&t, cb) == 1);
    key(&t, &r, keys.TAB, 0, 130);
    check("tab: closed, the focus on", combo.is_open(&t, cb) == 0 && router.focused(&t, &r) == other);
    // Clicked.
    router.focus(&t, &r, e, 1);
    entry.set_text(&t, e, "", 0);
    router.text(&t, &r, "Row 1", 5, 200);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as rw = listview.row_widget(&t, lv, 2);
    click(&t, &r, mx(&t, rw), my(&t, rw), 300);
    check("one clicked: taken", typed_text(&t, cb, "Row 11") == 1 && combo.is_open(&t, cb) == 0 && combo.selected(&t, cb) == 11);
    // Set by the program, unfocused: nothing offered.
    router.focus(&t, &r, 0, 0);
    entry.set_text(&t, e, "Row", 3);
    check("set by the program: nothing offered", combo.is_open(&t, cb) == 0);
    // Its button: all of them, the focus in the list.
    let is i64 as b = combo.button_of(&t, cb);
    click(&t, &r, mx(&t, b), my(&t, b), 400);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("its button: all of them, the keyboard in them", combo.is_open(&t, cb) == 1 && listview.count(&t, lv) == 20 &&
          router.focused(&t, &r) == lv);
    key(&t, &r, keys.END, 0, 410);
    key(&t, &r, keys.RETURN, 0, 420);
    check("one chosen there: its text, the focus back", typed_text(&t, cb, "Row 19") == 1 && combo.selected(&t, cb) == 19 &&
          router.focused(&t, &r) == e);
    key(&t, &r, keys.DOWN, keys.MOD_ALT, 500);
    check("alt down in the entry: all of them", combo.is_open(&t, cb) == 1 && listview.count(&t, lv) == 20);
    key(&t, &r, keys.ESCAPE, 0, 510);
    check("escape: closed, the focus back", combo.is_open(&t, cb) == 0 && router.focused(&t, &r) == e);
    // Laid out: the entry, then its button, square.
    let is math.rect.Rect as er = layout.window_rect(&t, e);
    let is math.rect.Rect as br = layout.window_rect(&t, b);
    check("the entry, its button at the end, square", near(er.x, cr.x) == 1 && near(br.x + br.w, cr.x + cr.w) == 1 &&
          near(br.w, br.h) == 1 && near(er.x + er.w, br.x) == 1 && near(br.h, cr.h) == 1);
    layout.set_direction(&t, cb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("right to left: its button at the left", near(layout.window_rect(&t, b).x, layout.window_rect(&t, cb).x) == 1 &&
          layout.window_rect(&t, e).x > layout.window_rect(&t, b).x);
    let is tree.Access as q;
    access.describe(&t, &r, cb, &q);
    check("told: a combo box one can type in", q.role == access.ROLE_COMBO_BOX && (q.states & access.EDITABLE) != 0);
    access.describe(&t, &r, b, &q);
    check("its button told", q.role == access.ROLE_BUTTON && q.name_len > 0 && (q.actions & access.PRESS) != 0);
    check("pressed by assistive technology: all of them", access.act(&t, b, access.PRESS, 0.0) == 1 && combo.is_open(&t, cb) == 1);
    check("not one to type in: no entry", combo.entry_of(&t, tree.root(&t)) == 0 && combo.suggestions(&t, tree.root(&t)) == 0);
    tree.close(&t);
}

// What it passes on to what holds it.
let is i64 as caught with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase == event.BUBBLE && (e.kind == event.POINTER_DOWN || e.kind == event.KEY_DOWN)) {
        caught = caught + 1;
        return 1;
    }
    return 0;
}

fn catch_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catch_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as catcher with mut;

fn took(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as i32 {
    let is i32 as done = router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
    return done;
}

fn passed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t, &catcher, tree.root(&t));
    rows(20);
    let is i64 as cb = combo.create(&t, holder, &m);
    layout.set_align(&t, cb, layout.START, layout.START);
    let is i64 as ce = combo.create_entry(&t, holder, &m);
    layout.set_align(&t, ce, layout.END, layout.END);
    layout.run(&t, cast(f64, W), cast(f64, H));
    caught = 0;
    router.pointer_move(&t, &r, mx(&t, cb), my(&t, cb), 10);
    router.pointer_button(&t, &r, 1, 1, mx(&t, cb), my(&t, cb), 10);
    check("pressed: open as it goes down, its own", combo.is_open(&t, cb) == 1 && caught == 0);
    router.pointer_button(&t, &r, 1, 0, mx(&t, cb), my(&t, cb), 11);
    key(&t, &r, keys.ESCAPE, 0, 20);
    router.pointer_button(&t, &r, 3, 1, mx(&t, cb), my(&t, cb), 30);
    router.pointer_button(&t, &r, 3, 0, mx(&t, cb), my(&t, cb), 31);
    check("the right button: on up, not opened", caught == 1 && combo.is_open(&t, cb) == 0);
    router.focus(&t, &r, cb, 1);
    caught = 0;
    check("its keys taken", took(&t, &r, keys.DOWN, 0, 40) == 1 && took(&t, &r, keys.UP, 0, 50) == 1 &&
          took(&t, &r, keys.END, 0, 60) == 1 && took(&t, &r, keys.HOME, 0, 70) == 1 && caught == 0);
    check("space: taken", took(&t, &r, keys.SPACE, 0, 80) == 1 && combo.is_open(&t, cb) == 1 && caught == 0);
    key(&t, &r, keys.ESCAPE, 0, 90);
    check("alt down: taken", took(&t, &r, keys.DOWN, keys.MOD_ALT, 100) == 1 && combo.is_open(&t, cb) == 1 && caught == 0);
    key(&t, &r, keys.ESCAPE, 0, 110);
    caught = 0;
    took(&t, &r, keys.DOWN, keys.MOD_CONTROL, 120);
    took(&t, &r, keys.LEFT, 0, 130);
    check("others: on up", caught == 2);
    // The one typed in: its button pressed, its keys.
    let is i64 as b = combo.button_of(&t, ce);
    caught = 0;
    router.pointer_move(&t, &r, mx(&t, b), my(&t, b), 200);
    router.pointer_button(&t, &r, 1, 1, mx(&t, b), my(&t, b), 200);
    check("its button pressed: open as it goes down, its own", combo.is_open(&t, ce) == 1 && caught == 0);
    router.pointer_button(&t, &r, 1, 0, mx(&t, b), my(&t, b), 201);
    key(&t, &r, keys.ESCAPE, 0, 210);
    router.pointer_button(&t, &r, 3, 1, mx(&t, b), my(&t, b), 220);
    router.pointer_button(&t, &r, 3, 0, mx(&t, b), my(&t, b), 221);
    check("the right button on it: on up", caught == 1 && combo.is_open(&t, ce) == 0);
    let is i64 as e = combo.entry_of(&t, ce);
    router.focus(&t, &r, e, 1);
    caught = 0;
    check("F4 in the entry: taken, all of them", took(&t, &r, keys.F4, 0, 300) == 1 && combo.is_open(&t, ce) == 1 && caught == 0);
    key(&t, &r, keys.ESCAPE, 0, 310);
    router.focus(&t, &r, e, 1);
    caught = 0;
    took(&t, &r, keys.DOWN, 0, 320);
    check("down with nothing shown: on up", caught == 1);
    router.text(&t, &r, "R", 1, 330);
    caught = 0;
    check("with them shown: down, up and escape taken", took(&t, &r, keys.DOWN, 0, 340) == 1 && took(&t, &r, keys.UP, 0, 350) == 1 &&
          caught == 0);
    took(&t, &r, keys.DOWN, keys.MOD_CONTROL, 360);
    took(&t, &r, keys.PAGE_DOWN, 0, 370);
    check("others: on up", caught == 2);
    caught = 0;
    check("escape: taken", took(&t, &r, keys.ESCAPE, 0, 380) == 1 && combo.is_open(&t, ce) == 0 && caught == 0);
    tree.close(&t);
}

fn suggested() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    rows(20);
    items.ids[18] = 200;
    items.ids[19] = 201;
    items.ids[17] = 6042;
    let is i64 as cb = combo.create_entry(&t, tree.root(&t), &m);
    layout.set_align(&t, cb, layout.START, layout.START);
    layout.set_min_size(&t, cb, 150.0, 0.0);
    signal.connect(&t, cb, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as e = combo.entry_of(&t, cb);
    router.focus(&t, &r, e, 1);
    router.text(&t, &r, "row", 3, 10);
    check("its case aside", combo.suggestions(&t, cb) == 17);
    entry.set_text(&t, e, "", 0);
    router.text(&t, &r, "a", 1, 20);
    check("a: Apple", combo.suggestions(&t, cb) == 1);
    entry.set_text(&t, e, "", 0);
    router.text(&t, &r, "z", 1, 30);
    check("z: Zebra", combo.suggestions(&t, cb) == 1);
    key(&t, &r, keys.BACKSPACE, 0, 40);
    check("emptied: none shown", combo.is_open(&t, cb) == 0);
    // The first taken by Enter.
    router.text(&t, &r, "Row 1", 5, 50);
    key(&t, &r, keys.DOWN, 0, 60);
    changes = 0;
    key(&t, &r, keys.RETURN, 0, 70);
    check("the first taken", typed_text(&t, cb, "Row 1") == 1 && combo.selected(&t, cb) == 1 && changes == 1);
    router.text(&t, &r, "0", 1, 80);
    check("edited: none chosen, said so", combo.selected(&t, cb) == 0 - 1 && changes == 2 && last_index == 0 - 1);
    // A number's row, from all of them: its digits.
    key(&t, &r, keys.DOWN, keys.MOD_ALT, 82);
    key(&t, &r, keys.END, 0, 84);
    key(&t, &r, keys.UP, 0, 86);
    key(&t, &r, keys.UP, 0, 88);
    key(&t, &r, keys.RETURN, 0, 89);
    check("a number's digits", typed_text(&t, cb, "42") == 1 && combo.selected(&t, cb) == 17);
    // The first clicked.
    entry.set_text(&t, e, "", 0);
    router.text(&t, &r, "Row 1", 5, 90);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as lv = combo.list_of(&t, cb);
    let is i64 as rw0 = listview.row_widget(&t, lv, 0);
    click(&t, &r, mx(&t, rw0), my(&t, rw0), 100);
    check("the first clicked: taken", typed_text(&t, cb, "Row 1") == 1 && combo.selected(&t, cb) == 1);
    // All of them, then typed: what is typed suggests again.
    key(&t, &r, keys.DOWN, keys.MOD_ALT, 200);
    key(&t, &r, keys.ESCAPE, 0, 210);
    router.focus(&t, &r, e, 1);
    entry.set_text(&t, e, "", 0);
    router.text(&t, &r, "Row 1", 5, 220);
    check("after all of them, typed: the suggestions", listview.count(&t, lv) == 8 && combo.suggestions(&t, cb) == 8);
    // The model changing while they show.
    items.ids[items.n] = 115;
    items.n = items.n + 1;
    model.inserted(&m, 0, items.n - 1, 1);
    check("a row inserted that it starts: suggested", combo.suggestions(&t, cb) == 9);
    key(&t, &r, keys.ESCAPE, 0, 230);
    // Sized: the entry, then its button.
    layout.set_min_size(&t, cb, 0.0, 0.0);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as cs;
    let is geom.Size as es;
    layout.measure(&t, cb, &free, &cs);
    layout.measure(&t, e, &free, &es);
    check("as wide as its entry and its button", near(cs.pref_w, es.pref_w + theme.metrics.control_height) == 1 &&
          near(cs.min_w, es.min_w + theme.metrics.control_height) == 1);
    // Right to left: its list flush with its right, wider than it.
    layout.set_min_size(&t, cb, 0.0, 0.0);
    layout.set_max_size(&t, cb, 60.0, 100.0);
    layout.set_margin(&t, cb, 0.0, 0.0, 150.0, 0.0);
    layout.set_direction(&t, cb, layout.RTL);
    items.ids[0] = 202;
    model.changed(&m, 0, 0, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as cr = layout.window_rect(&t, cb);
    router.focus(&t, &r, e, 1);
    entry.set_text(&t, e, "", 0);
    router.text(&t, &r, "Row", 3, 300);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as pr = layout.window_rect(&t, combo.popup_of(&t, cb));
    check("right to left: what it suggests flush with its right", pr.w > cr.w + 1.0 && near(pr.x + pr.w, cr.x + cr.w) == 1);
    // Told.
    let is tree.Access as q;
    access.describe(&t, &r, cb, &q);
    check("told open", (q.states & access.EXPANDED) != 0 && (q.actions & access.COLLAPSE) != 0);
    check("closed by assistive technology", access.act(&t, cb, access.COLLAPSE, 0.0) == 1 && combo.is_open(&t, cb) == 0);
    check("opened by it: all of them", access.act(&t, cb, access.EXPAND, 0.0) == 1 && combo.is_open(&t, cb) == 1 &&
          listview.count(&t, lv) == items.n);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;
    m = model.make(cast(*u8, 0), fn_ptr(items_count), fn_ptr(items_row_id), fn_ptr(items_cell));

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    chosen();
    followed();
    laid();
    drawn(&c);
    told();
    typed();
    passed();
    suggested();

    if (fails == 0) {
        io.printf("combo: %d checks passed\n", checks);
        return 0;
    }
    io.printf("combo: %d of %d checks failed\n", fails, checks);
    return 1;
}
