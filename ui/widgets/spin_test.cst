// ui/widgets/spin_test.cst — the spin box: a number held to its range and
// step, shown with as many decimals as its step has, in an entry; its
// buttons, the arrows, pages, Control and pages for the ends, the wheel;
// typed in, committed by Enter or the focus leaving and cancelled by Escape;
// drawn as one field; told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/math.cst" as fm;
use "../../text/layout/model.cst" as model;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../input/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "../event.cst" as event;
use "button.cst" as button;
use "entry.cst" as entry;
use "spin.cst" as spin;

let is i64 as W with imut = 240;
let is i64 as H with imut = 200;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [48000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of an entry's text.
fn ink_x(t as *tree.Tree, e as i64) as i64 {
    let is *text.Glyph as g = text.glyph(entry.run(t, e), 0);
    return cast(i64, entry.x_of(t, e, 0) + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, e as i64) as i64 {
    let is *text.Glyph as g = text.glyph(entry.run(t, e), 0);
    return cast(i64, entry.text_top(t, e) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }

// --- Signals ---

let is i64 as changes with mut = 0;
let is f64 as said with mut = 0.0;

fn on_change(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    changes = changes + 1;
    said = *cast(*f64, arg);
}

fn shows(t as *tree.Tree, w as i64, s as *u8) as i32 {
    let is i64 as e = spin.text_entry(t, w);
    return same(entry.text(t, e), entry.length(t, e), s);
}

let is f64 as want_w with mut = 0.0;
let is text.Run as scratch with mut;

// The width of s in the body style.
fn expect_w(s as *u8, n as i64) as void {
    let is text.Style as st = text.style_of(theme.fonts.body);
    st.family = theme.fonts.family;
    let is model.Params as pp = model.params();
    text.lay_plain(svc, &scratch, s, n, &st, &pp);
    want_w = scratch.width;
}

fn bump(user as *u8) as void {
    let is *i64 as n = cast(*i64, user);
    *n = *n + 1;
}

fn typed(t as *tree.Tree, r as *router.Router, s as *u8, n as i64, time as i64) as void {
    router.text(t, r, s, n, time);
}

// Typed over all of it.
fn retyped(t as *tree.Tree, r as *router.Router, s as *u8, n as i64, time as i64) as void {
    router.key(t, r, keys.A, keys.MOD_CONTROL, 1, 0, time);
    router.key(t, r, keys.A, keys.MOD_CONTROL, 0, 0, time);
    router.key(t, r, keys.CONTROL_L, 0, 0, 0, time);
    router.text(t, r, s, n, time);
}

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn measure(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

// What bubbles out of the spin box: whatever it did not take.
let is tree.Kind as catcher with mut;
let is i64 as caught with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase != event.BUBBLE) { return 0; }
    if (e.kind == event.KEY_DOWN || e.kind == event.SCROLL || e.kind == event.POINTER_MOVE) {
        caught = caught + 1;
        return 1;
    }
    return 0;
}

fn passed_on() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as model_box = box.create(&t, root, box.COLUMN);
    catcher = *tree.kind(&t, model_box);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t, &catcher, root);
    layout.set_align(&t, holder, layout.START, layout.START);
    let is i64 as w = spin.create(&t, holder, 0.0, 100.0, 1.0);
    let is i64 as te = spin.text_entry(&t, w);
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, te, 0);
    spin.set_value(&t, w, 50.0);
    caught = 0;
    key(&t, &r, keys.UP, 0, 10);
    key(&t, &r, keys.DOWN, 0, 20);
    key(&t, &r, keys.PAGE_UP, 0, 30);
    key(&t, &r, keys.PAGE_DOWN, 0, 40);
    key(&t, &r, keys.PAGE_UP, keys.MOD_CONTROL, 50);
    key(&t, &r, keys.PAGE_DOWN, keys.MOD_CONTROL, 60);
    retyped(&t, &r, "3", 1, 70);
    key(&t, &r, keys.ESCAPE, 0, 80);
    check("its keys taken", caught == 0 && spin.value(&t, w) == 0.0 && shows(&t, w, "0") == 1);
    key(&t, &r, keys.ESCAPE, 0, 90);
    key(&t, &r, keys.F5, 0, 100);
    check("the rest passed on: escape with nothing typed, others", caught == 2);
    caught = 0;
    check("at its least: its minus disabled", tree.is_enabled(&t, spin.minus(&t, w)) == 0);
    router.scroll(&t, &r, mid_x(&t, spin.minus(&t, w)), mid_y(&t, w), 0.0, 0.0 - 1.0, 1, 200);
    check("the wheel over it all the same: taken", caught == 0 && spin.value(&t, w) == 1.0);
    router.scroll(&t, &r, mid_x(&t, w), mid_y(&t, w), 1.0, 0.0, 1, 210);
    check("sideways: passed on", caught == 1);
    caught = 0;
    router.pointer_move(&t, &r, mid_x(&t, te), mid_y(&t, te), 300);
    check("a hover passed on", caught == 1);
    tree.close(&t);
}

// In the tree's language: its decimal mark shown, either read.
fn spoken() as void {
    let is tree.Tree as t = tree_for();
    tree.set_language(&t, strings.PT_BR);
    let is i64 as w = spin.create(&t, tree.root(&t), 0.0, 10.0, 0.5);
    spin.set_value(&t, w, 2.5);
    check("its decimal mark", shows(&t, w, "2,5") == 1);
    let is i64 as te = spin.text_entry(&t, w);
    entry.set_text(&t, te, "3.5", 3);
    spin.set_value(&t, w, spin.value(&t, w));
    tree.set_language(&t, strings.EN);
    spin.set_value(&t, w, 7.5);
    check("another language, its own", shows(&t, w, "7.5") == 1);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 20.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);
    scratch = text.run();

    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as w = spin.create(&t, col, 0.0, 100.0, 1.0);
    let is i64 as other = button.create(&t, col, "Other", 5);
    let is i64 as te = spin.text_entry(&t, w);
    check("a spin box at its least, its entry taking the focus", w != 0 &&
          tree.kind(&t, w).role == access.ROLE_SPIN_BUTTON && spin.value(&t, w) == 0.0 && tree.is_focusable(&t, w) == 0 &&
          te != 0 && tree.parent(&t, te) == w && tree.is_focusable(&t, te) == 1 && shows(&t, w, "0") == 1);
    let is i64 as minus = spin.minus(&t, w);
    let is i64 as plus = spin.plus(&t, w);
    check("its buttons, not taking Tab", tree.parent(&t, minus) == w && tree.parent(&t, plus) == w &&
          tree.is_focusable(&t, minus) == 0 && tree.is_focusable(&t, plus) == 0);
    check("at its least: its minus can do nothing", tree.is_enabled(&t, minus) == 0 && tree.is_enabled(&t, plus) == 1);
    signal.connect(&t, w, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));

    // Measured: room for its widest value, at least a control tall.
    let is geom.Size as s with mut = measure(&t, w);
    check("a control tall at least", s.pref_h >= theme.metrics.control_height && s.min_h == s.pref_h);
    let is f64 as before = s.pref_w;
    spin.set_value(&t, w, 100.0);
    check("as wide whatever its value", measure(&t, w).pref_w == before);
    spin.set_range(&t, w, 0.0, 100000.0, 1.0);
    check("wider for a wider range", measure(&t, w).pref_w > before);
    spin.set_range(&t, w, 0.0, 100.0, 1.0);

    // Set: held to range and step, shown, said.
    changes = 0;
    check("set", spin.set_value(&t, w, 42.4) == 1 && spin.value(&t, w) == 42.0 && shows(&t, w, "42") == 1 &&
          changes == 1 && said == 42.0);
    spin.set_value(&t, w, 42.0);
    check("as it is: nothing said", changes == 1);
    spin.set_value(&t, w, 500.0);
    check("held to the most: its plus can do nothing", spin.value(&t, w) == 100.0 && tree.is_enabled(&t, plus) == 0 &&
          tree.is_enabled(&t, minus) == 1);
    check("a step of a half: one decimal", spin.set_range(&t, w, 0.0 - 10.0, 10.0, 0.5) == 1 &&
          spin.value(&t, w) == 10.0 && shows(&t, w, "10.0") == 1);
    spin.set_value(&t, w, 0.0 - 2.75);
    check("below 0: its sign", spin.value(&t, w) == 0.0 - 2.5 && shows(&t, w, "-2.5") == 1);
    spin.set_range(&t, w, 0.0, 1.0, 0.25);
    spin.set_value(&t, w, 0.5);
    check("a step of a quarter: two decimals", shows(&t, w, "0.50") == 1);
    check("decimals of its own", spin.set_digits(&t, w, 3) == 1 && shows(&t, w, "0.500") == 1);
    check("none of its own", spin.set_digits(&t, w, 0) == 1 && shows(&t, w, "1") == 1);
    spin.set_range(&t, w, 0.0, 100.0, 1.0);
    check("below 0: the step's decimals again", spin.set_digits(&t, w, 0 - 1) == 1 && shows(&t, w, "1") == 1);
    check("a range the wrong way round: refused", spin.set_range(&t, w, 5.0, 1.0, 1.0) == 0);
    check("a range of one value", spin.set_range(&t, w, 5.0, 5.0, 1.0) == 1 && spin.value(&t, w) == 5.0 &&
          tree.is_enabled(&t, minus) == 0 && tree.is_enabled(&t, plus) == 0);
    spin.set_range(&t, w, 0.0, 1.0, 0.0000001);
    check("at most six decimals", shows(&t, w, "1.000000") == 1);
    spin.set_range(&t, w, 0.0, 100.0, 1.0);
    spin.set_value(&t, w, 50.0);

    // Its buttons.
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    click(&t, &r, mid_x(&t, plus), mid_y(&t, plus), 10);
    check("plus: a step up", spin.value(&t, w) == 51.0 && shows(&t, w, "51") == 1);
    click(&t, &r, mid_x(&t, minus), mid_y(&t, minus), 1000);
    click(&t, &r, mid_x(&t, minus), mid_y(&t, minus), 2000);
    check("minus twice: two steps down", spin.value(&t, w) == 49.0);
    check("clicked: the focus on its entry", router.focused(&t, &r) == te);

    // By keyboard.
    router.key(&t, &r, keys.UP, 0, 1, 0, 3000);
    check("up: a step up as it goes down", spin.value(&t, w) == 50.0);
    router.key(&t, &r, keys.UP, 0, 0, 0, 3001);
    check("not again as it comes up", spin.value(&t, w) == 50.0);
    key(&t, &r, keys.DOWN, 0, 3010);
    check("down: a step down", spin.value(&t, w) == 49.0);
    key(&t, &r, keys.PAGE_UP, 0, 3020);
    check("page up: ten steps", spin.value(&t, w) == 59.0);
    key(&t, &r, keys.PAGE_DOWN, 0, 3030);
    check("page down", spin.value(&t, w) == 49.0);
    key(&t, &r, keys.PAGE_UP, keys.MOD_CONTROL, 3040);
    check("control and page up: the most", spin.value(&t, w) == 100.0);
    key(&t, &r, keys.PAGE_DOWN, keys.MOD_CONTROL, 3050);
    check("control and page down: the least", spin.value(&t, w) == 0.0);
    spin.set_value(&t, w, 49.0);
    router.scroll(&t, &r, mid_x(&t, w), mid_y(&t, w), 0.0, 0.0 - 1.0, 1, 3060);
    check("the wheel up: a step up", spin.value(&t, w) == 50.0);
    router.scroll(&t, &r, mid_x(&t, w), mid_y(&t, w), 0.0, 2.0, 1, 3070);
    check("down two notches", spin.value(&t, w) == 48.0);
    router.scroll(&t, &r, mid_x(&t, w), mid_y(&t, w), 0.0, 0.0 - 0.5, 0, 3080);
    check("smoothly up: a step up", spin.value(&t, w) == 49.0);
    router.scroll(&t, &r, mid_x(&t, w), mid_y(&t, w), 0.0, 0.3, 0, 3090);
    check("smoothly down: a step down", spin.value(&t, w) == 48.0);
    router.scroll(&t, &r, mid_x(&t, w), mid_y(&t, w), 1.0, 0.0, 1, 3095);
    check("across: nothing", spin.value(&t, w) == 48.0);

    // Typed in: focused by the keyboard, all of it selected, typed over.
    router.focus(&t, &r, other, 1);
    router.focus(&t, &r, te, 1);
    changes = 0;
    typed(&t, &r, "7", 1, 4000);
    check("typed: what is typed takes the place of what was", shows(&t, w, "7") == 1 && spin.value(&t, w) == 48.0 &&
          spin.editing(&t, w) == 1 && changes == 0);
    typed(&t, &r, "5", 1, 4010);
    check("and goes on after it", shows(&t, w, "75") == 1);
    typed(&t, &r, "x", 1, 4020);
    check("what is no number: not taken", shows(&t, w, "75") == 1);
    key(&t, &r, keys.RETURN, 0, 4030);
    check("enter: the value", spin.value(&t, w) == 75.0 && shows(&t, w, "75") == 1 && spin.editing(&t, w) == 0 &&
          changes == 1);
    retyped(&t, &r, "150", 3, 4040);
    key(&t, &r, keys.RETURN, 0, 4050);
    check("too much: held to the most", spin.value(&t, w) == 100.0 && shows(&t, w, "100") == 1);
    retyped(&t, &r, "-5", 2, 4060);
    key(&t, &r, keys.RETURN, 0, 4070);
    check("too little: the least", spin.value(&t, w) == 0.0);
    retyped(&t, &r, "1.5", 3, 4080);
    key(&t, &r, keys.RETURN, 0, 4090);
    check("between steps: the nearest", spin.value(&t, w) == 2.0);
    retyped(&t, &r, "3,5", 3, 4100);
    key(&t, &r, keys.RETURN, 0, 4110);
    check("a comma for the point", spin.value(&t, w) == 4.0);
    retyped(&t, &r, "99", 2, 4111);
    key(&t, &r, keys.RETURN, 0, 4112);
    check("nines", spin.value(&t, w) == 99.0);
    retyped(&t, &r, "1-2", 3, 4113);
    key(&t, &r, keys.RETURN, 0, 4114);
    check("a sign inside: no number, as it was", spin.value(&t, w) == 99.0 && shows(&t, w, "99") == 1);
    retyped(&t, &r, "1111111111222222222233333333334444444444", 40, 4115);
    check("no more than thirty-two typed", entry.length(&t, te) == 32 &&
          same(entry.text(&t, te), 32, "11111111112222222222333333333344") == 1);
    key(&t, &r, keys.ESCAPE, 0, 4116);
    spin.set_range(&t, w, 0.0 - 10.0, 10.0, 1.0);
    retyped(&t, &r, "-5", 2, 4117);
    key(&t, &r, keys.RETURN, 0, 4118);
    check("below 0 typed", spin.value(&t, w) == 0.0 - 5.0);
    spin.set_range(&t, w, 0.0, 100.0, 1.0);
    spin.set_value(&t, w, 4.0);
    retyped(&t, &r, "33", 2, 4120);
    key(&t, &r, keys.BACKSPACE, 0, 4130);
    check("backspace: the last taken away", shows(&t, w, "3") == 1);
    key(&t, &r, keys.ESCAPE, 0, 4140);
    check("escape: as it was", shows(&t, w, "4") == 1 && spin.value(&t, w) == 4.0 && spin.editing(&t, w) == 0);
    key(&t, &r, keys.END, 0, 4145);
    key(&t, &r, keys.BACKSPACE, 0, 4150);
    check("backspace on its value: the value less its last", shows(&t, w, "") == 1 && spin.editing(&t, w) == 1);
    key(&t, &r, keys.RETURN, 0, 4160);
    check("nothing entered: as it was", spin.value(&t, w) == 4.0 && shows(&t, w, "4") == 1);
    retyped(&t, &r, "-", 1, 4170);
    key(&t, &r, keys.RETURN, 0, 4180);
    check("no digits: as it was", spin.value(&t, w) == 4.0);
    retyped(&t, &r, "12", 2, 4190);
    key(&t, &r, keys.UP, 0, 4200);
    check("typed, then up: from what was typed", spin.value(&t, w) == 13.0 && spin.editing(&t, w) == 0);
    retyped(&t, &r, "20", 2, 4210);
    router.focus(&t, &r, other, 1);
    check("left: taken", spin.value(&t, w) == 20.0 && shows(&t, w, "20") == 1 && spin.editing(&t, w) == 0);
    router.focus(&t, &r, te, 1);
    key(&t, &r, keys.TAB, 0, 4220);
    check("tab: on to the next", router.focused(&t, &r) == other);
    router.focus(&t, &r, te, 1);
    retyped(&t, &r, "21", 2, 4221);
    changes = 0;
    spin.set_value(&t, w, 22.0);
    check("set while typed: what was typed dropped", spin.value(&t, w) == 22.0 && shows(&t, w, "22") == 1 &&
          spin.editing(&t, w) == 0 && changes == 1);
    retyped(&t, &r, "23", 2, 4222);
    click(&t, &r, mid_x(&t, plus), mid_y(&t, plus), 4300);
    check("typed, then plus: from what was typed", spin.value(&t, w) == 24.0 && router.focused(&t, &r) == te);

    // The window's Enter and Escape: its own while something is typed.
    let is i64 as enters with mut = 0;
    let is i64 as escapes with mut = 0;
    router.add_shortcut(&r, keys.RETURN, 0, fn_ptr(bump), cast(*u8, &enters));
    router.add_shortcut(&r, keys.ESCAPE, 0, fn_ptr(bump), cast(*u8, &escapes));
    router.focus(&t, &r, te, 1);
    retyped(&t, &r, "30", 2, 4230);
    key(&t, &r, keys.RETURN, 0, 4240);
    check("typed, enter: taken, not the window's", spin.value(&t, w) == 30.0 && enters == 0);
    key(&t, &r, keys.RETURN, 0, 4250);
    check("nothing typed, enter: the window's", enters == 1);
    retyped(&t, &r, "31", 2, 4260);
    key(&t, &r, keys.ESCAPE, 0, 4270);
    check("typed, escape: put back, not the window's", spin.value(&t, w) == 30.0 && escapes == 0 &&
          spin.editing(&t, w) == 0);
    key(&t, &r, keys.ESCAPE, 0, 4280);
    check("nothing typed, escape: the window's", escapes == 1);
    router.remove_shortcut(&r, 1);
    router.remove_shortcut(&r, 2);
    spin.set_value(&t, w, 20.0);

    // Drawn as one field around its text and buttons: focused while its
    // entry is.
    frame_router = &r;
    router.focus(&t, &r, 0, 0);
    router.pointer_move(&t, &r, 230.0, 195.0, 4400);
    frame(&t, &c);
    let is math.rect.Rect as rw = layout.window_rect(&t, w);
    let is i64 as mid = cast(i64, rw.y + rw.h / 2.0);
    check("a field's background", is8(cast(i64, rw.x + 3.0), mid,
          style.over(theme.field.normal.bg, theme.palette.window_bg), 2) == 1);
    check("behind its buttons too", is8(cast(i64, layout.window_rect(&t, plus).x + 2.0),
          cast(i64, layout.window_rect(&t, plus).y + 2.0), style.over(theme.field.normal.bg, theme.palette.window_bg), 2) == 1);
    check("its text in the field's text colour", is8(ink_x(&t, te), ink_y(&t, te), theme.field.normal.fg, 2) == 1);
    let is i64 as cx = cast(i64, entry.caret_x(&t, te));
    check("no caret without the focus", is8(cx, mid, theme.field.checked.fg, 2) == 0);
    router.focus(&t, &r, te, 0);
    frame(&t, &c);
    check("focused: the field's focused look", is8(cast(i64, rw.x + 3.0), mid,
          style.over(theme.field.checked.bg, theme.palette.window_bg), 2) == 1);
    check("a caret with it", is8(cast(i64, entry.caret_x(&t, te)), mid, theme.field.checked.fg, 2) == 1);
    router.focus(&t, &r, other, 1);
    frame(&t, &c);
    check("the focus gone: its look as before", is8(cast(i64, rw.x + 3.0), mid,
          style.over(theme.field.normal.bg, theme.palette.window_bg), 2) == 1);
    // Sizes exactly: the widest value and the padding, the buttons square.
    let is f64 as bh = theme.metrics.control_height;
    let is f64 as px = theme.metrics.control_pad_x;
    expect_w("100", 3);
    let is f64 as widest = fm.ceil(want_w - 0.000000001);
    s = measure(&t, w);
    check("as wide as its widest value, the padding and two square buttons", s.pref_w == widest + 2.0 * px + 2.0 * bh &&
          s.min_w == s.pref_w);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as rr = layout.rect(&t, w);
    check("its entry, then its buttons at the end", layout.rect(&t, te).x == 0.0 &&
          layout.rect(&t, te).w == rr.w - 2.0 * bh && layout.rect(&t, minus).x == rr.w - 2.0 * bh &&
          layout.rect(&t, plus).x == rr.w - bh && layout.rect(&t, plus).w == bh);
    check("its text in the padding", entry.x_of(&t, te, 0) == layout.window_rect(&t, w).x + px);
    layout.set_direction(&t, w, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("right to left: its buttons first, mirrored", layout.rect(&t, plus).x == 0.0 &&
          layout.rect(&t, minus).x == bh && layout.rect(&t, te).x == 2.0 * bh);
    layout.set_direction(&t, w, layout.INHERIT);
    let is style.Theme as low = theme;
    low.metrics.control_height = 0.0;
    tree.set_theme(&t, &low);
    s = measure(&t, w);
    let is geom.Size as ls = measure(&t, te);
    check("no least height: its entry's", s.min_h == ls.pref_h);
    tree.set_theme(&t, &theme);
    frame_router = cast(*router.Router, 0);

    // Told; moved by assistive technology.
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("told: its value, range and step, editable", q.has_value == 1 && q.value == 20.0 && q.min == 0.0 &&
          q.max == 100.0 && q.step == 1.0 && (q.states & access.EDITABLE) != 0 &&
          (q.actions & access.SET_VALUE) != 0 && q.name_len == 0);
    check("set by it", access.act(&t, w, access.SET_VALUE, 33.0) == 1 && spin.value(&t, w) == 33.0);
    check("up by it", access.act(&t, w, access.INCREMENT, 0.0) == 1 && spin.value(&t, w) == 34.0);
    check("down", access.act(&t, w, access.DECREMENT, 0.0) == 1 && spin.value(&t, w) == 33.0);
    check("not a spin box: nothing", spin.set_value(&t, col, 1.0) == 0 && spin.value(&t, col) == 0.0 &&
          spin.set_range(&t, col, 0.0, 1.0, 1.0) == 0 && spin.set_digits(&t, col, 1) == 0 &&
          spin.minus(&t, col) == 0 && spin.plus(&t, col) == 0 && spin.text_entry(&t, col) == 0 &&
          spin.editing(&t, col) == 0);
    tree.close(&t);

    passed_on();
    spoken();

    let is tree.Limits as tl2 = tree.limits_default();
    tl2.widgets = 3;
    let is tree.Tree as tight = tree.open(&tl2);
    check("no room for its parts: none", spin.create(&tight, tree.root(&tight), 0.0, 1.0, 1.0) == 0 &&
          tree.live_count(&tight) == 1);
    tree.close(&tight);
    tl2.widgets = 1;
    let is tree.Tree as full = tree.open(&tl2);
    check("no room at all: none", spin.create(&full, tree.root(&full), 0.0, 1.0, 1.0) == 0);
    tree.close(&full);

    if (fails == 0) {
        io.printf("spin: %d checks passed\n", checks);
        return 0;
    }
    io.printf("spin: %d of %d checks failed\n", fails, checks);
    return 1;
}
