// ui/widgets/filechooser.cst — a file, a name to save to, or a folder, chosen.
//
// A file chooser is a dialog (dialog.cst) holding, on one side, the places a
// person starts from — home, its desktop, documents and downloads when they
// are there (where user-dirs.dirs says: "Área de trabalho" for a person
// reading Portuguese), the computer's top, each with its icon — and on the
// other the current folder: a button up and where it is, in an entry to type
// another, its entries in a table (dirmodel.cst: folders first, a folder's
// icon or a file's; the name, taking the room, size, when changed) and, when
// filters were added, a combo box of them. Choosing a file to save to, a name
// to type is above them, a file chosen in the table giving its name. Our own;
// the desktop's own is the XDG portal's, window/linux/filechooser.cst;
// Windows' comes with its backend.
//
// A place clicked opens it; a folder activated — a double click, Enter —
// opens it, as Up, Backspace and Alt+Up go up; Control+H shows the hidden
// ones or not. Where it is, typed and Enter: a folder is opened; a file is
// taken as if chosen in the table — opened, or saved to, a name in a folder
// there too — whether shown there or not; "~" is home, a name without a "/"
// first is in the folder shown, "." and ".." are taken. What is not there
// stays typed. Control+L goes there, all of it chosen.
// Its answer: OPEN takes the file chosen, a folder chosen opening instead;
// SAVE the name typed, in the folder shown, asking first before replacing a
// file that is there; FOLDER the folder chosen, or the one shown. Until one
// is right, Open, Save or Select keeps the dialog shown. Then the dialog
// says ACTIVATED with OK, and chosen() is the whole path; or CANCEL.
use "std/mem.cst" as mem;
use "std/env.cst" as env;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../input/keys.cst" as keys;
use "../../window/linux/user_dirs.cst" as user_dirs;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../style.cst" as style;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../model.cst" as model;
use "../dirmodel.cst" as dirmodel;
use "label.cst" as label;
use "button.cst" as button;
use "entry.cst" as entry;
use "image.cst" as image;
use "../icons.cst" as icons;
use "listview.cst" as listview;
use "tableview.cst" as tableview;
use "combo.cst" as combo;
use "dialog.cst" as dialog;

// What it chooses.
let is i32 as OPEN   with imut = 0;
let is i32 as SAVE   with imut = 1;
let is i32 as FOLDER with imut = 2;

let is i64 as MAX_PLACES  with imut = 6;
let is i64 as MAX_FILTERS with imut = 8;
let is f64 as PLACES_W    with imut = 180.0;

// Where home is: HOME, unless the program says (set_home).
let is [1024]u8 as _home with mut;
let is i64 as _home_len with mut = 0;
// Where user-dirs.dirs is: XDG_CONFIG_HOME or home's .config, unless the
// program says (set_config_home).
let is [1024]u8 as _config with mut;
let is i64 as _config_len with mut = 0;

// What does not fit a widget's data.
struct Side {
    places     as model.Model;
    np         as i64;
    pname      as [6]*u8;
    pname_len  as [6]i64;
    picon      as [6]i64;
    ppath      as [6][1024]u8;
    ppath_len  as [6]i64;
    filters    as model.Model;
    nf         as i64;
    fname      as [8][64]u8;
    fname_len  as [8]i64;
    fpat       as [8][256]u8;
    fpat_len   as [8]i64;
    chosen     as [4096]u8;
    chosen_len as i64;
    up_name    as [64]u8;   // what the up button is called, without its mnemonic's mark
}

struct Data {
    t         as *tree.Tree;
    self      as i64;
    dlg       as i64;
    mode      as i32;
    hidden    as i32;
    confirmed as i32;   // replacing was agreed to
    typed     as i32;   // what is chosen was typed where it is, not chosen in the table
    dir       as *dirmodel.Dir;
    side      as *Side;
    table     as i64;
    places    as i64;
    up        as i64;
    loc       as i64;   // where it is, typed
    name      as i64;   // save only
    filter    as i64;   // its combo box, shown once a filter is added
    confirm   as dialog.Ref;   // the question before replacing, made the first time; in a window of its own where there can be one
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("file chooser", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.event = fn_ptr(_event);
    _kind.destroy = fn_ptr(_destroy);
    _ready = 1;
}

// Home from now on: s, n bytes.
fn set_home(s as *u8, n as i64) as void {
    let is i64 as k with mut = n;
    if (k > 1023) { k = 1023; }
    mem.memcpy(cast(*u8, &_home), s, k);
    _home[k] = cast(u8, 0);
    _home_len = k;
}

// Where the user's settings are from now on — the folder of user-dirs.dirs,
// naming home's folders — s, n bytes; none (n 0): XDG_CONFIG_HOME, or home's
// .config.
fn set_config_home(s as *u8, n as i64) as void {
    let is i64 as k with mut = n;
    if (k > 1023) { k = 1023; }
    mem.memcpy(cast(*u8, &_config), s, k);
    _config[k] = cast(u8, 0);
    _config_len = k;
}

fn _home_path() as i64 {
    if (_home_len > 0) { return _home_len; }
    let is *u8 as h = env.getenv("HOME");
    if (cast(i64, h) == 0) { return 0; }
    let is i64 as n with mut = 0;
    while (h[n] != 0) { n = n + 1; }
    set_home(h, n);
    return _home_len;
}

// Whether the n bytes at p name a folder.
fn _is_folder(p as *u8, n as i64) as i32 {
    if (n <= 0 || n >= 4095) { return 0; }
    let is [4096]u8 as z;
    mem.memcpy(cast(*u8, &z), p, n);
    z[n] = cast(u8, 0);
    let is [144]u8 as st;
    if (linux.stat(cast(*u8, &z), cast(*u8, &st)) != 0) { return 0; }
    let is i64 as mode = cast(i64, *cast(*u32, cast(i64, &st) + 24));
    return cast(i32, (mode & 61440) == 16384);
}

fn _exists(p as *u8, n as i64) as i32 {
    if (n <= 0 || n >= 4095) { return 0; }
    let is [4096]u8 as z;
    mem.memcpy(cast(*u8, &z), p, n);
    z[n] = cast(u8, 0);
    let is [144]u8 as st;
    return cast(i32, linux.stat(cast(*u8, &z), cast(*u8, &st)) == 0);
}

// A place named word, in the tree's language, shown with icon, at path p,
// under 1024 bytes, when it is a folder. There are five at most: MAX_PLACES
// has room.
fn _place(t as *tree.Tree, g as *Side, word as i64, icon as i32, p as *u8, pn as i64) as void {
    if (_is_folder(p, pn) == 0) { return; }
    mem.memcpy(cast(*u8, &g.ppath[g.np]), p, pn);
    g.pname[g.np] = strings.of(t, word, &g.pname_len[g.np]);
    g.ppath_len[g.np] = pn;
    g.picon[g.np] = cast(i64, icon);
    g.np = g.np + 1;
}

// The folder of user-dirs.dirs into out (1024 bytes): the program's, or
// XDG_CONFIG_HOME, or home's .config; its length, 0 for none.
fn _config_path(out as *u8, hn as i64) as i64 {
    if (_config_len > 0) {
        mem.memcpy(out, cast(*u8, &_config), _config_len);
        return _config_len;
    }
    return user_dirs.config_folder(env.getenv("XDG_CONFIG_HOME"), cast(*u8, &_home), hn, out, 1024);
}

// Home's folder named XDG_<key>_DIR in user-dirs.dirs — fallback, its English
// name, when not said — as a place named word, shown with icon.
fn _user_place(t as *tree.Tree, g as *Side, cfg as *u8, cn as i64, hn as i64, key as *u8, fallback as *u8, word as i64,
               icon as i32) as void {
    let is [1024]u8 as p;
    let is i64 as kn with mut = 0;
    while (key[kn] != 0) { kn = kn + 1; }
    let is i64 as fn_ with mut = 0;
    while (fallback[fn_] != 0) { fn_ = fn_ + 1; }
    let is i64 as n = user_dirs.lookup(cfg, cn, key, kn, fallback, fn_, cast(*u8, &_home), hn, cast(*u8, &p), 1024);
    // None (0): turned off, never a place.
    _place(t, g, word, icon, cast(*u8, &p), n);
}

// s, n bytes, without the underscores marking a mnemonic ("__" is one), into
// out, cap bytes; its length.
fn _plain(s as *u8, n as i64, out as *u8, cap as i64) as i64 {
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n && k < cap) {
        if (s[i] == cast(u8, 95) && i + 1 < n) { i = i + 1; }
        out[k] = s[i];
        k = k + 1;
        i = i + 1;
    }
    return k;
}

fn _answer(t as *tree.Tree, dlg as i64, word as i64, response as i64) as void {
    let is i64 as n with mut = 0;
    let is *u8 as s = strings.of(t, word, &n);
    dialog.add_button(t, dlg, s, n, response);
}

fn _column(t as *tree.Tree, table as i64, word as i64, width as f64) as void {
    let is i64 as n with mut = 0;
    let is *u8 as s = strings.of(t, word, &n);
    tableview.add_column(t, table, s, n, width);
}

// How wide the text s, n bytes, would like to be under parent.
fn _text_w(t as *tree.Tree, parent as i64, s as *u8, n as i64) as f64 {
    let is i64 as l = label.create(t, parent, s, n);
    if (l == 0) { return 0.0; }
    let is geom.Size as z = _pref(t, l);
    tree.destroy(t, l);
    return z.pref_w;
}

// Column col of table as wide as its title, or sample, n bytes — what it
// shows at its widest — whichever is wider, padded, and least wide at least.
fn _fit(t as *tree.Tree, table as i64, col as i64, sample as *u8, n as i64, least as f64) as void {
    let is style.Theme as th;
    widget.theme(t, table, &th);
    let is f64 as title = _pref(t, tableview.header_label(t, table, col)).pref_w;
    let is f64 as w = _max(title, _text_w(t, table, sample, n)) + 2.0 * th.metrics.control_pad_x + th.metrics.space_m;
    tableview.set_column_width(t, table, col, _max(least, w));
}

// A new chooser of mode — OPEN, SAVE or FOLDER — titled s, n bytes: a
// dialog, hidden, showing home. Its handle (the dialog's), or 0.
fn create(t as *tree.Tree, mode as i32, s as *u8, n as i64) as i64 {
    _init();
    let is i64 as dlg = dialog.create(t, s, n);
    if (dlg == 0) { return 0; }
    let is i64 as w = tree.create(t, &_kind, dialog.content(t, dlg));
    let is *u8 as p = mem.core.mmap_anon(sizeof(Side));
    if (w == 0 || cast(i64, p) <= 0) {
        tree.destroy(t, dlg);
        return 0;
    }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.t = t;
    d.self = w;
    d.dlg = dlg;
    d.mode = mode;
    d.side = cast(*Side, p);
    let is *Side as g = d.side;
    g.places = model.make(p, fn_ptr(_places_count), fn_ptr(_places_row_id), fn_ptr(_places_cell));
    g.filters = model.make(p, fn_ptr(_filters_count), fn_ptr(_filters_row_id), fn_ptr(_filters_cell));
    let is i64 as hn = _home_path();
    if (hn > 0) {
        let is [1024]u8 as cfg;
        let is i64 as cn = _config_path(cast(*u8, &cfg), hn);
        _place(t, g, strings.HOME, icons.USER_HOME, cast(*u8, &_home), hn);
        _user_place(t, g, cast(*u8, &cfg), cn, hn, "DESKTOP", "Desktop", strings.DESKTOP, icons.USER_DESKTOP);
        _user_place(t, g, cast(*u8, &cfg), cn, hn, "DOCUMENTS", "Documents", strings.DOCUMENTS, icons.DOCUMENT);
        _user_place(t, g, cast(*u8, &cfg), cn, hn, "DOWNLOAD", "Downloads", strings.DOWNLOADS, icons.DOWNLOAD);
    }
    _place(t, g, strings.COMPUTER, icons.COMPUTER, "/", 1);
    // A name to type, first in the tree so the focus starts there.
    if (mode == SAVE) {
        d.name = entry.create(t, w);
        entry.set_activates_default(t, d.name, 1);
    }
    d.places = listview.create(t, w, &g.places);
    listview.set_single_click(t, d.places, 1);
    signal.connect(t, d.places, signal.ACTIVATED, fn_ptr(_place_chosen), cast(*u8, d));
    // Up: an arrow, named for those who hear it.
    d.up = button.create_holding(t, w);
    let is i64 as arrow = image.create_icon(t, d.up, icons.GO_UP, listview.ICON_SIZE);
    let is i64 as un with mut = 0;
    let is *u8 as us = strings.of(t, strings.UP, &un);
    image.set_description(t, arrow, cast(*u8, &g.up_name), _plain(us, un, cast(*u8, &g.up_name), 64));
    button.set_content(t, d.up, arrow);
    signal.connect(t, d.up, signal.CLICKED, fn_ptr(_up_clicked), cast(*u8, d));
    d.loc = entry.create(t, w);
    signal.connect(t, d.loc, signal.ACTIVATED, fn_ptr(_typed), cast(*u8, d));
    if (hn > 0) {
        d.dir = dirmodel.open(cast(*u8, &_home), hn);
    }
    if (cast(i64, d.dir) == 0) { d.dir = dirmodel.open("/", 1); }
    if (cast(i64, d.dir) == 0) {
        tree.destroy(t, dlg);
        return 0;
    }
    if (mode == FOLDER) { dirmodel.set_folders_only(d.dir, 1); }
    dirmodel.set_language(d.dir, tree.language(t));
    dirmodel.set_icons(d.dir, cast(i64, icons.FOLDER), cast(i64, icons.DOCUMENT));
    d.table = tableview.create(t, w, dirmodel.model_of(d.dir));
    _column(t, d.table, strings.NAME, 240.0);
    _column(t, d.table, strings.SIZE, 80.0);
    _column(t, d.table, strings.MODIFIED, 140.0);
    tableview.set_stretch(t, d.table, 0);
    _fit(t, d.table, 1, "999.9 MB", 8, 80.0);
    _fit(t, d.table, 2, "0000-00-00 00:00", 16, 140.0);
    let is i64 as lv = tableview.list(t, d.table);
    signal.connect(t, lv, signal.ACTIVATED, fn_ptr(_entry_activated), cast(*u8, d));
    signal.connect(t, lv, signal.SELECTION_CHANGED, fn_ptr(_selected), cast(*u8, d));
    d.filter = combo.create(t, w, &g.filters);
    tree.set_visible(t, d.filter, 0);
    signal.connect(t, d.filter, signal.VALUE_CHANGED, fn_ptr(_filter_chosen), cast(*u8, d));
    _show_path(t, d);
    _answer(t, dlg, strings.CANCEL, dialog.CANCEL);
    if (mode == SAVE) {
        _answer(t, dlg, strings.SAVE, dialog.OK);
    } else if (mode == FOLDER) {
        _answer(t, dlg, strings.SELECT, dialog.OK);
    } else {
        _answer(t, dlg, strings.OPEN, dialog.OK);
    }
    dialog.set_default_response(t, dlg, dialog.OK);
    dialog.set_check(t, dlg, fn_ptr(_check), cast(*u8, d));
    return dlg;
}

fn _destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Data as d = cast(*Data, data);
    dialog.dispose(&d.confirm);
    dirmodel.close(d.dir);
    mem.core.munmap(cast(*u8, d.side), sizeof(Side));
}

// The chooser in dialog fc.
fn _data(t as *tree.Tree, fc as i64) as *Data {
    let is i64 as w = tree.first_child(t, dialog.content(t, fc));
    if (w == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

// --- Where it is ---

fn _show_path(t as *tree.Tree, d as *Data) as void {
    entry.set_text(t, d.loc, dirmodel.path(d.dir), dirmodel.path_length(d.dir));
}

// p, n bytes, with "." and empty names left out and ".." taking the name
// before it away, from the top, into out, cap bytes; its length, 0 when it
// does not fit.
fn _normal(p as *u8, n as i64, out as *u8, cap as i64) as i64 {
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        while (i < n && p[i] == cast(u8, 47)) { i = i + 1; }
        let is i64 as a = i;
        while (i < n && p[i] != cast(u8, 47)) { i = i + 1; }
        let is i64 as m = i - a;
        let is i32 as dot = cast(i32, m == 1 && p[a] == cast(u8, 46));
        let is i32 as dots = cast(i32, m == 2 && p[a] == cast(u8, 46) && p[a + 1] == cast(u8, 46));
        if (dots == 1) {
            while (k > 0 && out[k - 1] != cast(u8, 47)) { k = k - 1; }
            if (k > 0) { k = k - 1; }
        } else if (m > 0 && dot == 0) {
            if (k + 1 + m > cap) { return 0; }
            out[k] = cast(u8, 47);
            mem.memcpy(cast(*u8, cast(i64, out) + k + 1), cast(*u8, cast(i64, p) + a), m);
            k = k + 1 + m;
        }
    }
    if (k == 0) {
        if (cap < 1) { return 0; }
        out[0] = cast(u8, 47);
        k = 1;
    }
    return k;
}

// What was typed where it is, s, n bytes, as a whole path into out (4096
// bytes): "~" home, a name without a "/" first in the folder shown. Its
// length; 0 for nothing typed, or a path that does not fit.
fn _whole(d as *Data, s as *u8, n as i64, out as *u8) as i64 {
    if (n <= 0) { return 0; }
    let is [8192]u8 as raw;
    let is i64 as k with mut = 0;
    let is i64 as from with mut = 0;
    if (s[0] == cast(u8, 126) && (n == 1 || s[1] == cast(u8, 47))) {
        let is i64 as hn = _home_path();
        if (hn == 0) { return 0; }
        mem.memcpy(cast(*u8, &raw), cast(*u8, &_home), hn);
        k = hn;
        from = 1;
    } else if (s[0] != cast(u8, 47)) {
        let is i64 as pl = dirmodel.path_length(d.dir);
        mem.memcpy(cast(*u8, &raw), dirmodel.path(d.dir), pl);
        k = pl;
    }
    if (k + 1 + n - from > 8192) { return 0; }
    raw[k] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &raw) + k + 1), cast(*u8, cast(i64, s) + from), n - from);
    return _normal(cast(*u8, &raw), k + 1 + n - from, out, 4096);
}

// Enter where it is: a folder there opened; a file, or a name in a folder
// there to save to, taken as the table's would be.
fn _typed(t as *tree.Tree, e as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    let is [4096]u8 as p;
    let is i64 as n = _whole(d, entry.text(t, d.loc), entry.length(t, d.loc), cast(*u8, &p));
    if (n == 0) { return; }
    if (_is_folder(cast(*u8, &p), n) == 1) {
        _go(t, d, cast(*u8, &p), n);
        return;
    }
    if (d.mode == FOLDER) { return; }
    // Its folder: before the last "/", the top for one right under it.
    let is i64 as slash with mut = n - 1;
    while (slash > 0 && p[slash] != cast(u8, 47)) { slash = slash - 1; }
    let is i64 as dn with mut = slash;
    if (dn == 0) { dn = 1; }
    if (_is_folder(cast(*u8, &p), dn) == 0) { return; }
    if (d.mode == OPEN) {
        if (_exists(cast(*u8, &p), n) == 0) { return; }
        _go(t, d, cast(*u8, &p), dn);
        mem.memcpy(cast(*u8, &d.side.chosen), cast(*u8, &p), n);
        d.side.chosen_len = n;
        d.typed = 1;
        dialog.respond(t, d.dlg, dialog.OK);
        d.typed = 0;
        return;
    }
    _go(t, d, cast(*u8, &p), dn);
    entry.set_text(t, d.name, cast(*u8, cast(i64, &p) + slash + 1), n - slash - 1);
    dialog.respond(t, d.dlg, dialog.OK);
}

// The folder at p, n bytes, shown: 1, or 0 when it cannot be read.
fn set_folder(t as *tree.Tree, fc as i64, p as *u8, n as i64) as i32 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return 0; }
    return _go(t, d, p, n);
}

fn _go(t as *tree.Tree, d as *Data, p as *u8, n as i64) as i32 {
    if (dirmodel.set_path(d.dir, p, n) == 0) { return 0; }
    _show_path(t, d);
    return 1;
}

fn folder(t as *tree.Tree, fc as i64) as *u8 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return cast(*u8, 0); }
    return dirmodel.path(d.dir);
}

fn folder_length(t as *tree.Tree, fc as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return 0; }
    return dirmodel.path_length(d.dir);
}

fn _up(t as *tree.Tree, d as *Data) as void {
    if (dirmodel.up(d.dir) == 1) { _show_path(t, d); }
}

fn _up_clicked(t as *tree.Tree, b as i64, arg as *u8, user as *u8) as void { _up(t, cast(*Data, user)); }

fn _place_chosen(t as *tree.Tree, l as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    let is i64 as i = listview.cursor(t, d.places);
    if (i < 0 || i >= d.side.np) { return; }
    _go(t, d, cast(*u8, &d.side.ppath[i]), d.side.ppath_len[i]);
}

// --- What is chosen ---

// The path chosen, into out, cap bytes; how many — 0 before an answer.
fn chosen(t as *tree.Tree, fc as i64, out as *u8, cap as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0 || d.side.chosen_len > cap) { return 0; }
    mem.memcpy(out, cast(*u8, &d.side.chosen), d.side.chosen_len);
    return d.side.chosen_len;
}

// The name to save to, s, n bytes.
fn set_name(t as *tree.Tree, fc as i64, s as *u8, n as i64) as void {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0 || d.name == 0) { return; }
    entry.set_text(t, d.name, s, n);
}

fn _choose_row(d as *Data, i as i64) as void {
    d.side.chosen_len = dirmodel.full_path(d.dir, i, cast(*u8, &d.side.chosen), 4096);
}

// The folder shown, and "/" and n bytes at s, as what is chosen.
fn _choose_named(d as *Data, s as *u8, n as i64) as i32 {
    let is *u8 as out = cast(*u8, &d.side.chosen);
    let is i64 as pl = dirmodel.path_length(d.dir);
    let is i64 as slash = cast(i64, pl > 0 && dirmodel.path(d.dir)[pl - 1] != cast(u8, 47));
    if (pl + slash + n > 4096) { return 0; }
    mem.memcpy(out, dirmodel.path(d.dir), pl);
    if (slash == 1) { out[pl] = cast(u8, 47); }
    mem.memcpy(cast(*u8, cast(i64, out) + pl + slash), s, n);
    d.side.chosen_len = pl + slash + n;
    return 1;
}

// An entry activated in the table: a folder opened; a file taken.
fn _entry_activated(t as *tree.Tree, l as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    let is i64 as i = listview.cursor(t, l);
    if (i < 0) { return; }
    if (dirmodel.is_dir(d.dir, i) == 1) {
        let is [4096]u8 as p;
        let is i64 as n = dirmodel.full_path(d.dir, i, cast(*u8, &p), 4096);
        _go(t, d, cast(*u8, &p), n);
        return;
    }
    if (d.mode == SAVE) { entry.set_text(t, d.name, dirmodel.name(d.dir, i), dirmodel.name_length(d.dir, i)); }
    dialog.respond(t, d.dlg, dialog.OK);
}

// A file chosen in the table of one saving: its name to save to.
fn _selected(t as *tree.Tree, l as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    if (d.mode != SAVE) { return; }
    let is i64 as i = listview.cursor(t, l);
    if (i < 0 || dirmodel.is_dir(d.dir, i) == 1) { return; }
    entry.set_text(t, d.name, dirmodel.name(d.dir, i), dirmodel.name_length(d.dir, i));
}

// Replacing agreed to, or not.
// The question answered, in its own tree qt; the chooser is in d.t.
fn _replace(qt as *tree.Tree, c as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    if (*cast(*i64, arg) != dialog.YES) { return; }
    d.confirmed = 1;
    dialog.respond(d.t, d.dlg, dialog.OK);
}

// The question before replacing a file, made the first time; 0 before. It is
// in confirm_dialog_tree, a window of its own belonging to the chooser's
// where the application can open one.
fn confirm_dialog(t as *tree.Tree, fc as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0 || dialog.ref_valid(&d.confirm) == 0) { return 0; }
    return d.confirm.w;
}

fn confirm_dialog_tree(t as *tree.Tree, fc as i64) as *tree.Tree {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0 || dialog.ref_valid(&d.confirm) == 0) { return cast(*tree.Tree, 0); }
    return d.confirm.t;
}

fn _ask(t as *tree.Tree, d as *Data) as void {
    if (dialog.ref_valid(&d.confirm) == 0) {
        let is *tree.Tree as qt = dialog.window_tree(t);
        let is i64 as hn with mut = 0;
        let is i64 as bn with mut = 0;
        let is *u8 as head = strings.of(t, strings.REPLACE_FILE, &hn);
        let is *u8 as body = strings.of(t, strings.FILE_EXISTS, &bn);
        let is i64 as q = dialog.message(qt, dialog.QUESTION, head, hn, body, bn, dialog.YES_NO);
        if (q == 0) { return; }
        signal.connect(qt, q, signal.ACTIVATED, fn_ptr(_replace), cast(*u8, d));
        d.confirm = dialog.ref(qt, q);
    }
    let is *tree.Tree as qt = d.confirm.t;
    let is *router.Router as r = cast(*router.Router, tree.router(qt));
    if (cast(i64, r) != 0) { dialog.show(qt, r, d.confirm.w, 1); }
}

// An answer looked at before it is given.
fn _check(user as *u8, response as i64) as i32 {
    let is *Data as d = cast(*Data, user);
    let is *tree.Tree as t = d.t;
    if (response != dialog.OK || d.typed == 1) { return 1; }
    let is i64 as i = listview.cursor(t, tableview.list(t, d.table));
    if (d.mode == OPEN) {
        if (i < 0) { return 0; }
        if (dirmodel.is_dir(d.dir, i) == 1) {
            _entry_activated(t, tableview.list(t, d.table), cast(*u8, 0), user);
            return 0;
        }
        _choose_row(d, i);
        return 1;
    }
    if (d.mode == FOLDER) {
        if (i >= 0 && dirmodel.is_dir(d.dir, i) == 1) {
            _choose_row(d, i);
        } else {
            mem.memcpy(cast(*u8, &d.side.chosen), dirmodel.path(d.dir), dirmodel.path_length(d.dir));
            d.side.chosen_len = dirmodel.path_length(d.dir);
        }
        return 1;
    }
    let is i64 as n = entry.length(t, d.name);
    if (n == 0 || _choose_named(d, entry.text(t, d.name), n) == 0) { return 0; }
    if (d.confirmed == 0 && _exists(cast(*u8, &d.side.chosen), d.side.chosen_len) == 1) {
        _ask(t, d);
        return 0;
    }
    d.confirmed = 0;
    return 1;
}

// --- Filters ---

// A filter named s showing the files patterns match ("*.txt;*.md", "" for
// all), at the end of its combo box; the first added is the one used. Its
// index, or -1.
fn add_filter(t as *tree.Tree, fc as i64, s as *u8, n as i64, patterns as *u8, pn as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0 || d.side.nf >= MAX_FILTERS || n > 63 || pn > 255) { return 0 - 1; }
    let is *Side as g = d.side;
    let is i64 as k = g.nf;
    mem.memcpy(cast(*u8, &g.fname[k]), s, n);
    g.fname_len[k] = n;
    mem.memcpy(cast(*u8, &g.fpat[k]), patterns, pn);
    g.fpat_len[k] = pn;
    g.nf = k + 1;
    model.inserted(&g.filters, 0, k, 1);
    tree.set_visible(t, d.filter, 1);
    if (k == 0) { combo.set_selected(t, d.filter, 0); }
    widget.changed(t, d.self, widget.CHANGED_LAYOUT);
    return k;
}

// Filter i the one used.
fn set_filter(t as *tree.Tree, fc as i64, i as i64) as void {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return; }
    combo.set_selected(t, d.filter, i);
}

fn _filter_chosen(t as *tree.Tree, c as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    let is i64 as i = *cast(*i64, arg);
    if (i < 0 || i >= d.side.nf) { return; }
    dirmodel.set_filter(d.dir, cast(*u8, &d.side.fpat[i]), d.side.fpat_len[i]);
}

// --- Its parts, for the program and its tests ---

fn table(t as *tree.Tree, fc as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return 0; }
    return d.table;
}

fn places(t as *tree.Tree, fc as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return 0; }
    return d.places;
}

fn up_button(t as *tree.Tree, fc as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return 0; }
    return d.up;
}

// The entry saying where it is, to type another place in.
fn location(t as *tree.Tree, fc as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return 0; }
    return d.loc;
}

fn name_entry(t as *tree.Tree, fc as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return 0; }
    return d.name;
}

fn filter_combo(t as *tree.Tree, fc as i64) as i64 {
    let is *Data as d = _data(t, fc);
    if (cast(i64, d) == 0) { return 0; }
    return d.filter;
}

// --- Keys: up, hidden ones, where it is ---

fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Data as d = cast(*Data, data);
    if (e.kind != event.KEY_DOWN) { return 0; }
    if (e.key == keys.L && e.mods == keys.MOD_CONTROL) {
        let is *router.Router as r = cast(*router.Router, tree.router(t));
        if (cast(i64, r) == 0) { return 0; }
        // As the keyboard focuses an entry: all of it chosen.
        router.focus(t, r, d.loc, 1);
        return 1;
    }
    if (e.key == keys.H && e.mods == keys.MOD_CONTROL) {
        d.hidden = 1 - d.hidden;
        dirmodel.set_hidden(d.dir, d.hidden);
        return 1;
    }
    if ((e.key == keys.BACKSPACE && e.mods == 0) || (e.key == keys.UP && e.mods == keys.MOD_ALT)) {
        _up(t, d);
        return 1;
    }
    return 0;
}

// --- Measured and arranged ---

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _pref(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &free, &s);
    return s;
}

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    geom.size_zero(out);
    out.pref_w = PLACES_W + 600.0;
    out.pref_h = 460.0;
    out.min_w = PLACES_W + 200.0;
    out.min_h = 200.0;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// The places down the start; past them, from the top: the name to save to,
// up and where it is, the table, and its filters at the end of the foot.
fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as gap = th.metrics.space_m;
    let is i32 as rtl = cast(i32, layout.direction(t, w) == layout.RTL);
    let is f64 as x0 = PLACES_W + th.metrics.space_l;
    let is f64 as rw = _max(0.0, r.w - x0);
    _put(t, d.places, 0.0, 0.0, PLACES_W, r.h, r.w, rtl);
    let is f64 as y with mut = 0.0;
    if (d.name != 0) {
        let is geom.Size as ns = _pref(t, d.name);
        _put(t, d.name, x0, y, rw, ns.pref_h, r.w, rtl);
        y = y + ns.pref_h + gap;
    }
    let is geom.Size as us = _pref(t, d.up);
    let is geom.Size as ps = _pref(t, d.loc);
    let is f64 as bar = _max(us.pref_h, ps.pref_h);
    // Up as tall as where it is beside it, square.
    _put(t, d.up, x0, y, _max(us.pref_w, bar), bar, r.w, rtl);
    let is f64 as uw = _max(us.pref_w, bar);
    _put(t, d.loc, x0 + uw + gap, y + (bar - ps.pref_h) / 2.0, _max(0.0, rw - uw - gap), ps.pref_h, r.w, rtl);
    y = y + bar + gap;
    let is f64 as bottom with mut = r.h;
    if (tree.is_hidden_here(t, d.filter) == 0) {
        let is geom.Size as fs = _pref(t, d.filter);
        let is f64 as fw = _max(fs.pref_w, 160.0);
        bottom = r.h - fs.pref_h;
        _put(t, d.filter, r.w - fw, bottom, fw, fs.pref_h, r.w, rtl);
        bottom = bottom - gap;
    }
    _put(t, d.table, x0, y, rw, _max(0.0, bottom - y), r.w, rtl);
}

fn _put(t as *tree.Tree, ch as i64, x as f64, y as f64, w as f64, h as f64, across as f64, rtl as i32) as void {
    let is math.rect.Rect as at with mut = math.rect.rect(x, y, w, h);
    if (rtl == 1) { at.x = across - x - w; }
    layout.place(t, ch, &at);
}

// --- The places' and the filters' models ---

fn _places_count(self as *u8, parent as i64) as i64 {
    if (parent != 0) { return 0; }
    return cast(*Side, self).np;
}

fn _places_row_id(self as *u8, parent as i64, index as i64) as i64 {
    let is *Side as g = cast(*Side, self);
    if (parent != 0 || index < 0 || index >= g.np) { return 0; }
    return index + 1;
}

fn _places_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    let is *Side as g = cast(*Side, self);
    let is i64 as i = id - 1;
    if (i < 0 || i >= g.np || column != 0) { return 0; }
    if (role == model.ICON) {
        *out = model.integer(g.picon[i]);
        return 1;
    }
    if (role != model.TEXT) { return 0; }
    *out = model.text(g.pname[i], g.pname_len[i]);
    return 1;
}

fn _filters_count(self as *u8, parent as i64) as i64 {
    if (parent != 0) { return 0; }
    return cast(*Side, self).nf;
}

fn _filters_row_id(self as *u8, parent as i64, index as i64) as i64 {
    let is *Side as g = cast(*Side, self);
    if (parent != 0 || index < 0 || index >= g.nf) { return 0; }
    return index + 1;
}

fn _filters_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    let is *Side as g = cast(*Side, self);
    let is i64 as i = id - 1;
    if (i < 0 || i >= g.nf || column != 0 || role != model.TEXT) { return 0; }
    *out = model.text(cast(*u8, &g.fname[i]), g.fname_len[i]);
    return 1;
}
