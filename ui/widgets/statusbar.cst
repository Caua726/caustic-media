// ui/widgets/statusbar.cst — what is going on, along a window's foot.
//
// A message, the newest of those pushed, in the dimmer text colour along the
// start, and at the end a row for what the program keeps there — a zoom, a
// position — drawn under a line. Messages are pushed under a context, a number
// the program picks for each part of itself that speaks, and popped by it —
// its newest — or taken away by the id push gave; one flashed goes by itself
// after a while, through the window's timers. Told as a status bar named by
// its message.
use "std/mem.cst" as mem;
use "../../math/math.cst" as math;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../box.cst" as box;
use "../timer.cst" as timer;
use "label.cst" as label;

let is i64 as MAX_MESSAGES with imut = 32;
let is i64 as MAX_TEXT     with imut = 240;   // bytes of a message kept
let is i64 as FLASH        with imut = 0 - 1; // the context a flashed message is under

struct Message {
    id  as i64;
    ctx as i64;
    len as i64;
    text as [240]u8;
}

// The messages, oldest first; made the first time one is pushed.
struct Book {
    n       as i64;
    next_id as i64;
    at      as [32]Message;
}

struct Data {
    t        as *tree.Tree;
    self     as i64;
    label    as i64;
    kept     as i64;   // the row at the end
    book     as *Book;
    flash_id as i64;   // the message flashed, 0 for none
    timer_id as i64;   // and the timer that takes it away
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("status bar", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.paint = fn_ptr(_paint);
    _kind.destroy = fn_ptr(_destroy);
    _kind.role = access.ROLE_STATUS_BAR;
    _ready = 1;
}

// A new status bar, saying nothing, as the last child of parent. Its handle,
// or 0.
fn create(t as *tree.Tree, parent as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.t = t;
    d.self = w;
    d.label = label.create(t, w, "", 0);
    d.kept = box.create(t, w, box.ROW);
    if (d.label == 0 || d.kept == 0) {
        tree.destroy(t, w);
        return 0;
    }
    label.set_lines(t, d.label, 1, 1);
    tree.set_labelled_by(t, w, d.label);
    return w;
}

fn _destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Data as d = cast(*Data, data);
    let is *timer.Timers as ts = cast(*timer.Timers, tree.timers(t));
    if (cast(i64, ts) != 0) { timer.cancel(ts, d.timer_id); }
    if (cast(i64, d.book) != 0) { mem.core.munmap(cast(*u8, d.book), sizeof(Book)); }
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

// The row at its end, for what the program keeps there.
fn permanent(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.kept;
}

// The label its message is shown in.
fn label_of(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.label;
}

// What it says now; null and 0 when nothing.
fn message(t as *tree.Tree, w as i64) as *u8 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return cast(*u8, 0); }
    return label.text(t, d.label);
}

fn message_length(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return label.text_length(t, d.label);
}

// The newest message shown, or nothing.
fn _show(t as *tree.Tree, d as *Data) as void {
    let is *Book as b = d.book;
    if (cast(i64, b) == 0 || b.n == 0) {
        label.set_text(t, d.label, "", 0);
        return;
    }
    let is *Message as m = &b.at[b.n - 1];
    label.set_text(t, d.label, cast(*u8, &m.text), m.len);
}

// Message i gone, those after it moved down.
fn _drop(d as *Data, i as i64) as void {
    let is *Book as b = d.book;
    let is i64 as k with mut = i;
    while (k + 1 < b.n) {
        b.at[k] = b.at[k + 1];
        k = k + 1;
    }
    b.n = b.n - 1;
}

// s, n bytes — the first MAX_TEXT kept, whole characters — said under context ctx, over what
// was said. Its id, or 0. When MAX_MESSAGES are kept, the oldest goes.
fn push(t as *tree.Tree, w as i64, ctx as i64, s as *u8, n as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    if (cast(i64, d.book) == 0) {
        let is *u8 as p = mem.core.mmap_anon(sizeof(Book));
        if (cast(i64, p) <= 0) { return 0; }
        d.book = cast(*Book, p);
    }
    let is *Book as b = d.book;
    if (b.n == MAX_MESSAGES) { _drop(d, 0); }
    let is *Message as m = &b.at[b.n];
    b.next_id = b.next_id + 1;
    m.id = b.next_id;
    m.ctx = ctx;
    m.len = strings.fits(s, n, MAX_TEXT);
    mem.memcpy(cast(*u8, &m.text), s, m.len);
    b.n = b.n + 1;
    _show(t, d);
    return m.id;
}

// The newest message under ctx gone. 1 if there was one.
fn pop(t as *tree.Tree, w as i64, ctx as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || cast(i64, d.book) == 0) { return 0; }
    let is i64 as i with mut = d.book.n - 1;
    while (i >= 0) {
        if (d.book.at[i].ctx == ctx) {
            _drop(d, i);
            _show(t, d);
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

// Message id gone, whatever its context. 1 if it was there.
fn remove(t as *tree.Tree, w as i64, id as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || cast(i64, d.book) == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (i < d.book.n) {
        if (d.book.at[i].id == id) {
            _drop(d, i);
            _show(t, d);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn _flash_due(user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    d.timer_id = 0;
    remove(d.t, d.self, d.flash_id);
    d.flash_id = 0;
}

// s said for ms milliseconds from now, then taken away — over another one
// flashed, which goes at once. Its id, or 0. With no timers lent, it stays
// until removed.
fn flash(t as *tree.Tree, w as i64, s as *u8, n as i64, ms as i64, now as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    let is *timer.Timers as ts = cast(*timer.Timers, tree.timers(t));
    if (d.flash_id != 0) {
        remove(t, w, d.flash_id);
        if (cast(i64, ts) != 0) { timer.cancel(ts, d.timer_id); }
    }
    d.flash_id = push(t, w, FLASH, s, n);
    if (d.flash_id != 0 && cast(i64, ts) != 0) {
        d.timer_id = timer.add(ts, now, ms, 0, fn_ptr(_flash_due), cast(*u8, d));
    }
    return d.flash_id;
}

// --- Measuring and arranging ---

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    let is geom.Size as ks;
    layout.measure(t, d.label, &free, &ls);
    layout.measure(t, d.kept, &free, &ks);
    let is f64 as px = th.metrics.space_s;
    let is f64 as py = th.metrics.space_xs;
    geom.size_zero(out);
    out.pref_w = 2.0 * px + ls.pref_w + px + ks.pref_w;
    out.min_w = 2.0 * px + ks.min_w;
    out.pref_h = 2.0 * py + _max(ls.pref_h, ks.pref_h);
    out.min_h = out.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = out.pref_h;
}

// What is kept at the end, as wide as it likes; the message in the rest.
fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    let is geom.Size as ks;
    layout.measure(t, d.label, &free, &ls);
    layout.measure(t, d.kept, &free, &ks);
    let is f64 as px = th.metrics.space_s;
    let is f64 as kw = ks.pref_w;
    let is f64 as lw = _max(0.0, r.w - 3.0 * px - kw);
    let is math.rect.Rect as kr with mut = math.rect.rect(r.w - px - kw, (r.h - ks.pref_h) / 2.0, kw, ks.pref_h);
    let is math.rect.Rect as lr with mut = math.rect.rect(px, (r.h - ls.pref_h) / 2.0, lw, ls.pref_h);
    if (layout.direction(t, w) == layout.RTL) {
        kr.x = px;
        lr.x = r.w - px - lw;
    }
    layout.place(t, d.kept, &kr);
    layout.place(t, d.label, &lr);
}

// --- Drawn ---

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *style.Theme as th = p.theme;
    shapes.fill_rect(p.canvas, p.rect.x, p.rect.y, p.rect.w, th.metrics.border_width, th.palette.separator);
    p.fg = th.palette.fg_dim;
}
