// ui/widgets/switch_test.cst — the switch: on or off, its knob sliding over
// the theme's duration through the window's animator, at once with reduced
// motion or none; clicked, toggled by Space and Enter and by assistive
// technology; drawn in the theme's track variants.
use "std/io.cst" as io;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../anim.cst" as anim;
use "../signal.cst" as signal;
use "../../window/keys.cst" as keys;
use "switch.cst" as switch;

let is i64 as W with imut = 100;
let is i64 as H with imut = 40;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [4000]i32 as px with mut;
let is style.Theme as theme with mut;

let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

fn measure(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

let is i64 as toggles with mut = 0;

fn on_toggle(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { toggles = toggles + 1; }

fn bump(user as *u8) as void {
    let is *i64 as n = cast(*i64, user);
    *n = *n + 1;
}

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn main() as i32 {
    theme = style.light();
    frame_router = cast(*router.Router, 0);
    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as dl = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &dl);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    let is i64 as root = tree.root(&t);
    let is i64 as w = switch.create(&t, root);
    let is i64 as other = switch.create(&t, root);
    tree.set_visible(&t, other, 0);
    check("a switch, off, focusable", w != 0 && tree.kind(&t, w).role == access.ROLE_SWITCH &&
          switch.is_active(&t, w) == 0 && switch.knob(&t, w) == 0.0 && tree.is_focusable(&t, w) == 1);
    let is geom.Size as s = measure(&t, w);
    let is f64 as sw = theme.metrics.switch_w;
    let is f64 as sh = theme.metrics.switch_h;
    check("as big as the theme says", s.min_w == sw && s.min_h == sh && s.pref_w == sw && s.pref_h == sh);
    signal.connect(&t, w, signal.TOGGLED, fn_ptr(on_toggle), cast(*u8, 0));

    // No animator: the knob where it goes at once.
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as tr = switch.track(&t, w);
    let is math.rect.Rect as wr with mut = layout.window_rect(&t, w);
    check("the track at its start, centred down", tr.x == wr.x && tr.w == sw && tr.h == sh &&
          tr.y == wr.y + (wr.h - sh) / 2.0);
    click(&t, &r, tr.x + 4.0, tr.y + 4.0, 10);
    check("clicked: on, said, the knob over at once", switch.is_active(&t, w) == 1 && toggles == 1 &&
          switch.knob(&t, w) == 1.0 && router.focused(&t, &r) == w);
    router.pointer_move(&t, &r, tr.x + 4.0, tr.y + 4.0, 100);
    router.pointer_button(&t, &r, 1, 1, tr.x + 4.0, tr.y + 4.0, 100);
    router.pointer_move(&t, &r, 99.0, 99.0, 110);
    router.pointer_button(&t, &r, 1, 0, 99.0, 99.0, 120);
    check("released elsewhere: nothing", switch.is_active(&t, w) == 1 && toggles == 1);
    router.pointer_move(&t, &r, tr.x + 4.0, tr.y + 4.0, 122);
    router.pointer_button(&t, &r, 1, 1, tr.x + 4.0, tr.y + 4.0, 122);
    router.pointer_move(&t, &r, tr.x + 6.0, tr.y + 5.0, 124);
    check("pressed and moved within: down", switch.is_down(&t, w) == 1);
    router.pointer_move(&t, &r, 99.0, 99.0, 126);
    check("moved off: up", switch.is_down(&t, w) == 0);
    router.pointer_button(&t, &r, 1, 0, 99.0, 99.0, 128);
    click(&t, &r, tr.x + 4.0, tr.y + 4.0, 129);
    check("clicked when on: off", switch.is_active(&t, w) == 0 && toggles == 2);
    click(&t, &r, tr.x + 4.0, tr.y + 4.0, 129);
    toggles = 1;
    router.pointer_button(&t, &r, 3, 1, tr.x + 4.0, tr.y + 4.0, 130);
    check("another button: not taken", router.capture(&r) != w);
    router.pointer_button(&t, &r, 3, 0, tr.x + 4.0, tr.y + 4.0, 140);
    router.focus(&t, &r, w, 1);
    router.key(&t, &r, keys.SPACE, 0, 1, 0, 200);
    check("space down: not yet", switch.is_active(&t, w) == 1 && switch.is_down(&t, w) == 1);
    router.key(&t, &r, keys.SPACE, 0, 0, 0, 210);
    check("space up: off", switch.is_active(&t, w) == 0 && toggles == 2 && switch.is_down(&t, w) == 0);
    let is i64 as shortcuts with mut = 0;
    router.add_shortcut(&r, keys.RETURN, 0, fn_ptr(bump), cast(*u8, &shortcuts));
    key(&t, &r, keys.RETURN, 0, 220);
    check("enter: on, ahead of the window's", switch.is_active(&t, w) == 1 && toggles == 3 && shortcuts == 0);
    key(&t, &r, keys.RETURN, 0, 222);
    check("enter when on: off", switch.is_active(&t, w) == 0);
    key(&t, &r, keys.RETURN, 0, 224);
    router.key(&t, &r, keys.SPACE, 0, 1, 0, 226);
    router.focus(&t, &r, 0, 0);
    router.key(&t, &r, keys.SPACE, 0, 0, 0, 228);
    check("space held, the focus gone: nothing", switch.is_active(&t, w) == 1 && switch.is_down(&t, w) == 0);
    router.focus(&t, &r, w, 1);
    router.add_mnemonic(&t, &r, w, keys.S);
    key(&t, &r, keys.S, keys.MOD_ALT, 229);
    router.key(&t, &r, keys.ALT_L, 0, 0, 0, 229);
    check("its mnemonic when on: off", switch.is_active(&t, w) == 0);
    key(&t, &r, keys.S, keys.MOD_ALT, 229);
    router.key(&t, &r, keys.ALT_L, 0, 0, 0, 229);
    toggles = 3;
    key(&t, &r, keys.B, 0, 230);
    check("other keys: nothing", switch.is_active(&t, w) == 1);
    check("set: said", switch.set_active(&t, w, 0) == 1 && toggles == 4 && switch.knob(&t, w) == 0.0);
    check("set as it is: nothing said", switch.set_active(&t, w, 0) == 1 && toggles == 4);

    // Told; toggled by assistive technology.
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("told: off", (q.states & access.CHECKABLE) != 0 && (q.states & access.CHECKED) == 0 &&
          (q.actions & access.TOGGLE) != 0);
    check("toggled by it", access.act(&t, w, access.TOGGLE, 0.0) == 1 && switch.is_active(&t, w) == 1);
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("told: on", (q.states & access.CHECKED) != 0);
    check("toggled by it when on: off", access.act(&t, w, access.PRESS, 0.0) == 1 && switch.is_active(&t, w) == 0);
    access.act(&t, w, access.PRESS, 0.0);

    // The window's animator: the knob slides over the theme's duration.
    let is anim.Animator as an = anim.init(&t);
    tree.set_animator(&t, cast(*u8, &an));
    switch.set_active(&t, w, 0);
    check("the knob where it was until the animator ticks", switch.knob(&t, w) == 1.0);
    anim.tick(&an, 1000);
    anim.tick(&an, 1000 + theme.motion.fast / 2);
    check("half way through: on its way", switch.knob(&t, w) > 0.0 && switch.knob(&t, w) < 1.0);
    anim.tick(&an, 1000 + theme.motion.fast);
    check("then there", switch.knob(&t, w) == 0.0);
    theme.motion.reduced = 1;
    tree.set_theme(&t, &theme);
    switch.set_active(&t, w, 1);
    anim.tick(&an, 2000);
    check("reduced motion: there at the first tick", switch.knob(&t, w) == 1.0);
    theme.motion.reduced = 0;
    tree.set_theme(&t, &theme);
    tree.set_animator(&t, cast(*u8, 0));

    // Drawn: the track's variants, the knob at its end.
    frame(&t, &c);
    let is i64 as left = cast(i64, tr.x + sh / 2.0);
    let is i64 as right = cast(i64, tr.x + sw - sh / 2.0);
    let is i64 as mid = cast(i64, tr.y + sh / 2.0);
    check("on: the filled track, the knob at the end", is8(left, mid, theme.track.checked.bg, 1) == 1 &&
          is8(right, mid, theme.indicator.checked.fg, 1) == 1);
    switch.set_active(&t, w, 0);
    frame(&t, &c);
    check("off: the empty track, the knob at the start", is8(right, mid, style.over(theme.track.normal.bg,
          theme.palette.window_bg), 1) == 1 && is8(left, mid, theme.indicator.checked.fg, 1) == 1);
    check("round ends: its corner the window's", is8(cast(i64, tr.x), cast(i64, tr.y), theme.palette.window_bg, 2) == 1);
    check("the knob inside the track's end", is8(cast(i64, tr.x + 1.0), mid, style.over(theme.track.normal.bg,
          theme.palette.window_bg), 2) == 1);
    // Pressed, then pressed and left.
    router.pointer_move(&t, &r, cast(f64, right), cast(f64, mid), 2500);
    router.pointer_button(&t, &r, 1, 1, cast(f64, right), cast(f64, mid), 2500);
    frame_router = &r;
    frame(&t, &c);
    let is style.Look as pl = style.pick(&theme.track, painter.S_HOVER | painter.S_PRESSED, 0);
    check("pressed: the press's overlay", is8(right, mid, style.over(pl.bg, theme.palette.window_bg), 2) == 1);
    router.pointer_move(&t, &r, 99.0, 99.0, 2510);
    frame(&t, &c);
    check("pressed and left: at rest", is8(right, mid, style.over(theme.track.normal.bg, theme.palette.window_bg), 2) == 1);
    router.pointer_button(&t, &r, 1, 0, 99.0, 99.0, 2520);
    frame_router = cast(*router.Router, 0);
    // Right to left: the track at the end, the knob mirrored.
    layout.set_direction(&t, w, layout.RTL);
    frame(&t, &c);
    let is math.rect.Rect as rt = switch.track(&t, w);
    wr = layout.window_rect(&t, w);
    check("right to left: the track at the end", rt.x == wr.x + wr.w - sw);
    check("off, right to left: the knob at the right", is8(cast(i64, rt.x + sw - sh / 2.0), mid,
          theme.indicator.checked.fg, 1) == 1);
    switch.set_active(&t, w, 1);
    frame(&t, &c);
    check("on, right to left: the knob at the left", is8(cast(i64, rt.x + sh / 2.0), mid,
          theme.indicator.checked.fg, 1) == 1 && is8(cast(i64, rt.x + sw - sh / 2.0), mid, theme.track.checked.bg, 1) == 1);
    switch.set_active(&t, w, 0);
    layout.set_direction(&t, w, layout.INHERIT);
    tree.set_enabled(&t, w, 0);
    frame(&t, &c);
    let is style.Look as faded = style.pick(&theme.track, painter.S_DISABLED, 0);
    check("disabled: faded", is8(right, mid, style.over(faded.bg, theme.palette.window_bg), 2) == 1);
    click(&t, &r, tr.x + 4.0, tr.y + 4.0, 3000);
    check("disabled: not clicked", switch.is_active(&t, w) == 0);
    tree.set_enabled(&t, w, 1);

    check("not a switch: nothing", switch.set_active(&t, root, 1) == 0 && switch.is_active(&t, root) == 0 &&
          switch.knob(&t, root) == 0.0 && switch.is_down(&t, root) == 0);
    let is tree.Limits as tl = tree.limits_default();
    tl.widgets = 1;
    let is tree.Tree as full = tree.open(&tl);
    check("no room: no switch", switch.create(&full, tree.root(&full)) == 0);
    tree.close(&full);
    tree.close(&t);
    if (fails == 0) {
        io.printf("switch: %d checks passed\n", checks);
        return 0;
    }
    io.printf("switch: %d of %d checks failed\n", fails, checks);
    return 1;
}
