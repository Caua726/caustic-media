// ui/widgets/label.cst — text that says what something is.
//
// A label keeps its text in a run of its own (ui/text.cst) — the text copied
// in and how it was last laid out, one block — and lays it out through the
// application's text service (tree.text_service), in the theme's text style
// for its role: the family, size and weight the theme of its part of the
// window gives that role, so a theme change or an override's text scale sets
// it again. Spans of other styles lie over it, each style's empty fields the
// label's.
//
// Measured, it is as wide as its text would like and as tall as its text at
// the width it is offered: one line per paragraph unless it wraps; wrapping,
// no narrower than its widest word; cut to a number of lines with an ellipsis
// on request, and then, not wrapping, no narrower than the ellipsis. The
// width it is finally given is the one it is laid out at for drawing.
//
// Drawn in the theme's colour for its tone — text, secondary text, the
// accent, an error — faded when disabled, quieter in a window in the
// backdrop; in its normal tone, in the colour what holds it gives instead (a
// button's text colour, painter.fg); aligned in its rectangle across, centred down. It tells
// assistive technology its text, and is the name of the widget it labels
// (set_target).
//
// Selectable on request: it then keeps a text/layout Layout of its own beside
// its run — the cursor's questions need everything a layout found — and its
// text is selected by dragging, by words after a double click and by
// paragraphs after a triple, extended with Shift, and by keyboard once it
// has the focus; Ctrl+A selects all and Ctrl+C copies, and what the pointer
// or Shift selects goes to the primary selection.
use "std/mem.cst" as mem;
use "std/math.cst" as fm;
use "../../math/math.cst" as math;
use "../../window/keys.cst" as keys;
use "../../render/draw2d.cst" as draw2d;
use "../../text/layout/model.cst" as model;
use "../../text/layout/layout.cst" as tlayout;
use "../../text/layout/cursor.cst" as cursor;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../event.cst" as event;
use "../layout.cst" as layout;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../../render/shapes2d.cst" as shapes;
use "../text.cst" as txt;

// The theme's text styles: which one the label is set in.
let is i64 as CAPTION     with imut = 0;
let is i64 as BODY        with imut = 1;
let is i64 as BODY_STRONG with imut = 2;
let is i64 as HEADING     with imut = 3;
let is i64 as TITLE       with imut = 4;
let is i64 as LARGE_TITLE with imut = 5;
let is i64 as MONO        with imut = 6;

// The theme's colours: which one it is drawn in.
let is i64 as NORMAL  with imut = 0;   // the text colour
let is i64 as DIM     with imut = 1;   // secondary text
let is i64 as ACCENT  with imut = 2;
let is i64 as ERROR   with imut = 3;
let is i64 as WARNING with imut = 4;
let is i64 as SUCCESS with imut = 5;
let is i64 as LINK    with imut = 6;

struct Data {
    run      as txt.Run;
    styles   as *txt.Style;   // the program's, for spans; null for the role's alone
    spans    as *model.Span;
    target   as i64;           // the widget it names; 0 for none
    // The style the sizes below were found in.
    key_size   as f64;
    key_weight as i64;
    key_family as *u8;
    nat_w    as f64;           // its text's own width, and height there
    nat_h    as f64;
    min_w    as f64;
    laid_w   as f64;           // the width its run is laid out at; below 0 for its own
    nstyles  as i32;
    nspans   as i32;
    role     as i32;
    tone     as i32;
    lines    as i32;           // at most; 0 for any number
    align    as i32;           // model.ALIGN_*
    mnemonic as i32;           // the byte its underlined letter starts at; -1 for none
    letter   as i32;           // that letter; 0 for none
    sel      as *Sel;          // selectable: its layout and selection; null when not
    wrap     as i32;
    ellipsis as i32;
    known    as i32;           // the sizes are for the key
    _pad0    as i32;
}

// What a selectable label keeps besides: a mapping of its own, the size of
// a text/layout Layout.
struct Sel {
    lay      as tlayout.Layout;
    lstyles  as [16]model.Style;
    anchor   as i64;              // where the selection began; the caret is its other end
    caret    as cursor.Position;
    want_x   as f64;              // the x moving up and down keeps; below 0 for none
    unit_a   as i64;              // the word or paragraph the press chose
    unit_b   as i64;
    by       as i64;              // a drag extends by: 1 graphemes, 2 words, 3 paragraphs
    pressing as i32;
    laid     as i32;              // lay holds its text as last laid out
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

// For laying out what is not the label's text: the ellipsis it measures.
let is txt.Run as _scratch with mut;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("label", sizeof(Data));
    _kind.destroy = fn_ptr(_destroy);
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.paint = fn_ptr(_paint);
    _kind.event = fn_ptr(_event);
    _kind.role = access.ROLE_LABEL;
    _kind.access = fn_ptr(_access);
    _kind.shape = fn_ptr(_shape);
    _scratch = txt.run();
    _ready = 1;
}

fn kind() as *tree.Kind {
    _init();
    return &_kind;
}

// A new label of text — n bytes of UTF-8, copied — as the last child of
// parent, in the body style. Its handle, or 0 with the tree's last_error set.
fn create(t as *tree.Tree, parent as i64, s as *u8, n as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.run = txt.run();
    d.role = cast(i32, BODY);
    d.align = cast(i32, model.ALIGN_START);
    d.mnemonic = 0 - 1;
    d.laid_w = 0.0 - 2.0;
    txt.set_text(&d.run, s, n);
    return w;
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

fn _destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Data as d = cast(*Data, data);
    _drop_sel(d);
    txt.run_close(&d.run);
}

fn _drop_sel(d as *Data) as void {
    if (cast(i64, d.sel) == 0) { return; }
    tlayout.close(&d.sel.lay);
    mem.core.munmap(cast(*u8, d.sel), sizeof(Sel));
    d.sel = cast(*Sel, 0);
}

// Nothing selected, the caret at the start.
fn _unselect(d as *Data) as void {
    if (cast(i64, d.sel) == 0) { return; }
    d.sel.anchor = 0;
    d.sel.caret = cursor.position(0, 0);
    d.sel.want_x = 0.0 - 1.0;
    d.sel.pressing = 0;
}

// Something it is laid out by changed: measured and drawn again.
fn _changed(t as *tree.Tree, w as i64, d as *Data) as void {
    d.known = 0;
    d.laid_w = 0.0 - 2.0;
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
}

// Its text from now on, copied: 1, or 0 when memory is refused and it keeps
// the old.
fn set_text(t as *tree.Tree, w as i64, s as *u8, n as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    if (txt.set_text(&d.run, s, n) == 0) { return 0; }
    d.mnemonic = 0 - 1;
    d.letter = 0;
    _unselect(d);
    _changed(t, w, d);
    return 1;
}

// The UTF-8 sequence's length from its first byte.
fn _seq(b as i64) as i64 {
    if (b < 128) { return 1; }
    if (b >= 240) { return 4; }
    if (b >= 224) { return 3; }
    if (b >= 192) { return 2; }
    return 1;
}

fn _decode(p as *u8, at as i64, n as i64) as i64 {
    let is i64 as b = cast(i64, p[at]);
    let is i64 as k = _seq(b);
    if (at + k > n) { return b; }
    if (k == 1) { return b; }
    if (k == 2) { return ((b & 31) << 6) | (cast(i64, p[at + 1]) & 63); }
    if (k == 3) { return ((b & 15) << 12) | ((cast(i64, p[at + 1]) & 63) << 6) | (cast(i64, p[at + 2]) & 63); }
    return ((b & 7) << 18) | ((cast(i64, p[at + 1]) & 63) << 12) | ((cast(i64, p[at + 2]) & 63) << 6) |
           (cast(i64, p[at + 3]) & 63);
}

// Its text with a mnemonic: an underscore before a letter marks it — the
// first so marked is the mnemonic, underlined while Alt is held — and is not
// shown; two underscores show one. bind_mnemonic hands the letter to the
// router. 1, or 0 as set_text.
fn set_text_mnemonic(t as *tree.Tree, w as i64, s as *u8, n as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    if (txt.set_text(&d.run, s, n) == 0) { return 0; }
    // Taken out in place, never moving a byte forward.
    let is *u8 as p = txt.text_of(&d.run);
    let is i64 as at with mut = 0 - 1;
    let is i64 as letter with mut = 0;
    let is i64 as i with mut = 0;
    let is i64 as o with mut = 0;
    while (i < n) {
        if (p[i] == 95 && i + 1 < n) {
            i = i + 1;
            if (p[i] != 95 && at < 0) {
                at = o;
                letter = _decode(p, i, n);
            }
        }
        p[o] = p[i];
        o = o + 1;
        i = i + 1;
    }
    txt.set_length(&d.run, o);
    d.mnemonic = cast(i32, at);
    d.letter = cast(i32, letter);
    _unselect(d);
    _changed(t, w, d);
    return 1;
}

// Its mnemonic's letter, as set_text_mnemonic found it; 0 for none.
fn mnemonic(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.letter;
}

// Alt and its mnemonic's letter, from now on, focus and activate the widget
// it labels — itself when it labels none. 1, or 0 for no mnemonic or a full
// table. Bound again after its text changes.
fn bind_mnemonic(t as *tree.Tree, r as *router.Router, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || d.letter == 0) { return 0; }
    let is i64 as to with mut = target(t, w);
    if (to == 0) { to = w; }
    router.remove_mnemonics(r, to);
    return router.add_mnemonic(t, r, to, d.letter);
}

// Its text, until it is next set; null and 0 for a widget that is no label.
fn text(t as *tree.Tree, w as i64) as *u8 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return cast(*u8, 0); }
    return txt.text_of(&d.run);
}

fn text_length(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return txt.text_length(&d.run);
}

// How it was last laid out; null for a widget that is no label.
fn run(t as *tree.Tree, w as i64) as *txt.Run {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return cast(*txt.Run, 0); }
    return &d.run;
}

// Which of the theme's text styles it is set in: BODY and the rest.
fn set_style(t as *tree.Tree, w as i64, role as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.role = cast(i32, role);
    _changed(t, w, d);
}

// Which of the theme's colours it is drawn in: NORMAL and the rest.
fn set_tone(t as *tree.Tree, w as i64, tone as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.tone = cast(i32, tone);
    widget.changed(t, w, widget.CHANGED_PAINT);
}

// Broken into lines to fit the width it is given.
fn set_wrap(t as *tree.Tree, w as i64, on as i32) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.wrap = on;
    _changed(t, w, d);
}

// At most lines lines, 0 for any number; what does not fit ends in an
// ellipsis when ellipsis is 1. Not wrapping, a label with an ellipsis is cut
// to the width it is given.
fn set_lines(t as *tree.Tree, w as i64, lines as i64, ellipsis as i32) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.lines = cast(i32, lines);
    d.ellipsis = ellipsis;
    _changed(t, w, d);
}

// Where its lines go across: model.ALIGN_START (the default), END, LEFT,
// RIGHT, CENTER, JUSTIFY. The text as a whole goes the same way in its
// rectangle.
fn set_align(t as *tree.Tree, w as i64, align as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.align = cast(i32, align);
    _changed(t, w, d);
}

// Spans of its text in other styles: styles[0] for the text outside every
// span, then what spans name. The program keeps both arrays alive while they
// are set, and sets them again when it changes them; a style's size or
// weight of 0, or family of null, is the label's. Null and 0 for none.
fn set_spans(t as *tree.Tree, w as i64, styles as *txt.Style, nstyles as i64, spans as *model.Span,
             nspans as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.styles = styles;
    d.nstyles = cast(i32, nstyles);
    d.spans = spans;
    d.nspans = cast(i32, nspans);
    _changed(t, w, d);
}

// The widget it names — for assistive technology, and for its mnemonic —
// 0 for none.
fn set_target(t as *tree.Tree, w as i64, target as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    if (d.target != 0 && tree.labelled_by(t, d.target) == w) { tree.set_labelled_by(t, d.target, 0); }
    d.target = target;
    if (target != 0) { tree.set_labelled_by(t, target, w); }
}

fn target(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    if (tree.is_valid(t, d.target) == 0) { return 0; }
    return d.target;
}

// --- Laying out ---

fn _theme_style(th as *style.Theme, role as i32) as style.TextStyle {
    if (role == CAPTION) { return th.fonts.caption; }
    if (role == BODY_STRONG) { return th.fonts.body_strong; }
    if (role == HEADING) { return th.fonts.heading; }
    if (role == TITLE) { return th.fonts.title; }
    if (role == LARGE_TITLE) { return th.fonts.large_title; }
    if (role == MONO) { return th.fonts.mono_body; }
    return th.fonts.body;
}

// Its style in theme th.
fn _style(th as *style.Theme, d as *Data) as txt.Style {
    let is txt.Style as st = txt.style_of(_theme_style(th, d.role));
    st.family = th.fonts.family;
    if (cast(i64, d.role) == MONO) { st.family = th.fonts.mono; }
    return st;
}

// The run laid out at width — below 0 for the text's own — in style st,
// with its spans: 1, or 0 when it could not be.
fn _lay(svc as *txt.Service, d as *Data, st as *txt.Style, width as f64) as i32 {
    let is model.Params as pp = model.params();
    pp.width = width;
    pp.align = cast(i64, d.align);
    pp.max_lines = cast(i64, d.lines);
    pp.ellipsis = d.ellipsis;
    // Cut to the width, not wrapped: one line.
    if (d.wrap == 0 && d.ellipsis == 1 && width >= 0.0) { pp.max_lines = 1; }
    d.laid_w = width;
    if (cast(i64, d.styles) == 0 || d.nstyles < 1) {
        let is i32 as ok = txt.lay_text(svc, &d.run, st, 1, cast(*model.Span, 0), 0, &pp);
        _lay_sel(svc, d, st, 1, cast(*model.Span, 0), 0, &pp);
        return ok;
    }
    let is [16]txt.Style as sts;
    let is i64 as n with mut = cast(i64, d.nstyles);
    if (n > txt.MAX_STYLES) { n = txt.MAX_STYLES; }
    let is i64 as k with mut = 0;
    while (k < n) {
        sts[k] = d.styles[k];
        if (sts[k].size <= 0.0) { sts[k].size = st.size; }
        if (sts[k].weight <= 0) { sts[k].weight = st.weight; }
        if (cast(i64, sts[k].family) == 0) { sts[k].family = st.family; }
        k = k + 1;
    }
    let is i32 as ok = txt.lay_text(svc, &d.run, cast(*txt.Style, &sts), n, d.spans, cast(i64, d.nspans), &pp);
    _lay_sel(svc, d, cast(*txt.Style, &sts), n, d.spans, cast(i64, d.nspans), &pp);
    return ok;
}

// A selectable label's own layout, laid out as its run just was.
fn _lay_sel(svc as *txt.Service, d as *Data, styles as *txt.Style, n as i64, spans as *model.Span, nspans as i64,
            pp as *model.Params) as void {
    if (cast(i64, d.sel) == 0) { return; }
    d.sel.laid = txt.lay_layout(svc, &d.sel.lay, cast(*model.Style, &d.sel.lstyles), txt.text_of(&d.run),
                                txt.text_length(&d.run), styles, n, spans, nspans, pp);
}

// Its sizes in style st, found when the style changed: its text's own width
// and height, and the least width it can take.
fn _know(svc as *txt.Service, d as *Data, st as *txt.Style) as void {
    if (d.known == 1 && d.key_size == st.size && d.key_weight == st.weight &&
        cast(i64, d.key_family) == cast(i64, st.family)) {
        return;
    }
    _lay(svc, d, st, 0.0 - 1.0);
    d.nat_w = d.run.width;
    d.nat_h = d.run.height;
    d.min_w = d.nat_w;
    if (d.wrap == 1) {
        // Its widest word: no narrower breaks one.
        d.min_w = d.run.least;
    } else if (d.ellipsis == 1) {
        let is model.Params as pp = model.params();
        txt.lay_plain(svc, &_scratch, "…", 3, st, &pp);
        if (_scratch.width < d.min_w) { d.min_w = _scratch.width; }
    }
    d.key_size = st.size;
    d.key_weight = st.weight;
    d.key_family = st.family;
    d.known = 1;
}

// Whether a width changes how its text is laid out.
fn _bends(d as *Data) as i32 { return cast(i32, d.wrap == 1 || d.ellipsis == 1); }

// The run laid out for width cw — as it is drawn there — and its height.
fn _fit(svc as *txt.Service, d as *Data, st as *txt.Style, cw as f64) as f64 {
    let is f64 as want with mut = 0.0 - 1.0;
    if (_bends(d) == 1 && cw < d.nat_w) {
        want = cw;
        if (want < d.min_w) { want = d.min_w; }
    }
    if (d.laid_w != want) { _lay(svc, d, st, want); }
    return d.run.height;
}

fn _service(t as *tree.Tree) as *txt.Service { return cast(*txt.Service, tree.text_service(t)); }

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    let is *txt.Service as svc = _service(t);
    geom.size_zero(out);
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
    if (cast(i64, svc) == 0) { return; }
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is txt.Style as st = _style(&th, d);
    _know(svc, d, &st);
    let is f64 as h = _fit(svc, d, &st, c.w);
    // Up to whole physical pixels, as GTK rounds Pango's sizes: edges are
    // snapped to them, and given a hair less than its text a label would
    // wrap its last word.
    let is f64 as s with mut = layout.scale(t);
    if (s <= 0.0) { s = 1.0; }
    out.min_w = _up(d.min_w, s);
    out.pref_w = _up(d.nat_w, s);
    out.min_h = _up(h, s);
    out.pref_h = out.min_h;
}

// v up to the next whole physical pixel at s a logical one.
fn _up(v as f64, s as f64) as f64 { return fm.ceil(v * s - 0.000000001) / s; }

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is *txt.Service as svc = _service(t);
    if (cast(i64, svc) == 0) { return; }
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is txt.Style as st = _style(&th, d);
    _know(svc, d, &st);
    _fit(svc, d, &st, r.w);
}

// --- Drawing ---

// Where its text is drawn in its rectangle, from its left and its top: for
// what is laid over it, a caret or an input method's window.
fn text_left(t as *tree.Tree, w as i64) as f64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0.0; }
    return _left(t, w, d, layout.rect(t, w).w);
}

fn text_top(t as *tree.Tree, w as i64) as f64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0.0; }
    return _top(d, layout.rect(t, w).h);
}

// How far down its rectangle, h tall, its text starts: centred.
fn _top(d as *Data, h as f64) as f64 {
    if (h > d.run.height) { return (h - d.run.height) / 2.0; }
    return 0.0;
}

fn _tone(th as *style.Theme, tone as i32) as math.color.Color {
    if (tone == DIM) { return th.palette.fg_dim; }
    if (tone == ACCENT) { return th.palette.accent; }
    if (tone == ERROR) { return th.palette.error; }
    if (tone == WARNING) { return th.palette.warning; }
    if (tone == SUCCESS) { return th.palette.success; }
    if (tone == LINK) { return th.palette.link; }
    return th.palette.fg;
}

// Where its text starts across in a rectangle w wide: by its alignment, the
// start the widget's own.
fn _left(t as *tree.Tree, w as i64, d as *Data, room as f64) as f64 {
    let is f64 as spare = room - d.run.width;
    if (spare <= 0.0) { return 0.0; }
    let is i32 as rtl = cast(i32, layout.direction(t, w) == layout.RTL);
    let is i64 as a = cast(i64, d.align);
    if (a == model.ALIGN_CENTER) { return spare / 2.0; }
    if (a == model.ALIGN_RIGHT) { return spare; }
    if (a == model.ALIGN_LEFT) { return 0.0; }
    if (a == model.ALIGN_END && rtl == 0) { return spare; }
    if (a != model.ALIGN_END && rtl == 1) { return spare; }
    return 0.0;
}

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Data as d = cast(*Data, data);
    let is *txt.Service as svc = _service(t);
    if (cast(i64, svc) == 0) { return; }
    let is txt.Style as st = _style(p.theme, d);
    _know(svc, d, &st);
    _fit(svc, d, &st, p.rect.w);
    let is math.color.Color as col with mut = _tone(p.theme, d.tone);
    if (cast(i64, d.tone) == NORMAL && p.fg.a > 0.0) {
        // Given by what holds it — a button's text colour — and faded by
        // it already.
        col = p.fg;
    } else if (painter.has(p, painter.S_DISABLED) == 1) {
        col = style.with_alpha(col, col.a * p.theme.control.disabled_alpha);
    } else if (painter.has(p, painter.S_BACKDROP) == 1) {
        col = style.with_alpha(col, col.a * 0.6);
    }
    let is f64 as x = p.rect.x + _left(t, w, d, p.rect.w);
    let is f64 as y = p.rect.y + _top(d, p.rect.h);
    // The selection's background behind the text, its text in the
    // selection's colour over it.
    let is [32]cursor.Rect as rs;
    let is i64 as nr with mut = 0;
    if (cast(i64, d.sel) != 0 && d.sel.laid == 1 && d.sel.anchor != d.sel.caret.offset) {
        nr = cursor.selection(&d.sel.lay, d.sel.anchor, d.sel.caret.offset, cast(*cursor.Rect, &rs), 32);
        if (nr > 32) { nr = 32; }
    }
    let is i64 as i with mut = 0;
    while (i < nr) {
        shapes.fill_rect(p.canvas, x + rs[i].x, y + rs[i].y, rs[i].w, rs[i].h, p.theme.palette.selection_bg);
        i = i + 1;
    }
    txt.draw(svc, p.canvas, &d.run, x, y, col);
    i = 0;
    while (i < nr) {
        draw2d.push_clip(p.canvas, x + rs[i].x, y + rs[i].y, rs[i].w, rs[i].h);
        txt.draw(svc, p.canvas, &d.run, x, y, p.theme.palette.selection_fg);
        draw2d.pop_clip(p.canvas);
        i = i + 1;
    }
    let is txt.Deco as u;
    if (d.mnemonic >= 0 && painter.has(p, painter.S_MNEMONICS) == 1 &&
        txt.underline_at(&d.run, cast(i64, d.mnemonic), &u) == 1) {
        shapes.fill_rect(p.canvas, x + u.x, y + u.y, u.w, u.h, col);
    }
}

// --- Told ---

fn _access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Data as d = cast(*Data, data);
    if (q.action != access.ASK) { return 0; }
    access.set_name(q, txt.text_of(&d.run), txt.text_length(&d.run));
    if (d.wrap == 1) { q.states = q.states | access.MULTI_LINE; }
    if (cast(i64, d.sel) != 0) { q.states = q.states | access.SELECTABLE; }
    return 1;
}

// The text beam over a selectable label; nothing of its own otherwise.
fn _shape(t as *tree.Tree, w as i64, data as *u8, p as *math.vec.Vec2) as i32 {
    if (cast(i64, cast(*Data, data).sel) == 0) { return tree.SHAPE_INHERIT; }
    return tree.SHAPE_TEXT;
}

// --- Selecting ---

// Selectable or not: 1, or 0 when memory is refused or w is no label. A
// selectable label takes the focus, from the keyboard as from a press.
fn set_selectable(t as *tree.Tree, w as i64, on as i32) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    if (on == 1 && cast(i64, d.sel) == 0) {
        let is *Sel as s = cast(*Sel, mem.core.mmap_anon(sizeof(Sel)));
        if (cast(i64, s) <= 0) { return 0; }
        tlayout.open(&s.lay);
        d.sel = s;
        _unselect(d);
    }
    if (on == 0) { _drop_sel(d); }
    tree.set_focusable(t, w, on);
    _changed(t, w, d);
    return 1;
}

// The selection: where it began and where the caret is, either way round;
// 1 when it is not empty. Both 0 for a label that is not selectable.
fn selection(t as *tree.Tree, w as i64, a as *i64, b as *i64) as i32 {
    let is *Data as d = _data(t, w);
    *a = 0;
    *b = 0;
    if (cast(i64, d) == 0 || cast(i64, d.sel) == 0) { return 0; }
    *a = d.sel.anchor;
    *b = d.sel.caret.offset;
    return cast(i32, *a != *b);
}

fn _clamp(d as *Data, v as i64) as i64 {
    if (v < 0) { return 0; }
    if (v > txt.text_length(&d.run)) { return txt.text_length(&d.run); }
    return v;
}

// Selects a .. b, held to the text; nothing for a label that is not
// selectable.
fn select(t as *tree.Tree, w as i64, a as i64, b as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || cast(i64, d.sel) == 0) { return; }
    d.sel.anchor = _clamp(d, a);
    d.sel.caret = cursor.position(_clamp(d, b), 0);
    d.sel.want_x = 0.0 - 1.0;
    widget.changed(t, w, widget.CHANGED_PAINT);
}

// What is selected, to which of the program's places.
fn _copy(t as *tree.Tree, d as *Data, which as i32) as void {
    let is i64 as a with mut = d.sel.anchor;
    let is i64 as b with mut = d.sel.caret.offset;
    if (b < a) {
        a = d.sel.caret.offset;
        b = d.sel.anchor;
    }
    if (a == b) { return; }
    tree.copy(t, which, cast(*u8, cast(i64, txt.text_of(&d.run)) + a), b - a);
}

// The paragraph around offset o: from the end of the separator before it to
// the start of the one after.
fn _paragraph(d as *Data, o as i64, a as *i64, b as *i64) as void {
    let is *u8 as p = txt.text_of(&d.run);
    let is i64 as n = txt.text_length(&d.run);
    *a = 0;
    let is i64 as i with mut = o - 1;
    while (i >= 0) {
        let is i64 as k = _separator(p, i, n);
        if (k > 0 && i + k <= o) {
            *a = i + k;
            i = 0;
        }
        i = i - 1;
    }
    i = o;
    while (i < n && _separator(p, i, n) == 0) { i = i + 1; }
    *b = i;
}

// The length of the paragraph separator that starts at byte i — a line feed,
// a carriage return, U+0085 or U+2029 — or 0.
fn _separator(p as *u8, i as i64, n as i64) as i64 {
    let is i64 as c = cast(i64, p[i]);
    if (c == 10 || c == 13) { return 1; }
    if (c == 194 && i + 1 < n && cast(i64, p[i + 1]) == 133) { return 2; }
    if (c == 226 && i + 2 < n && cast(i64, p[i + 1]) == 128 && cast(i64, p[i + 2]) == 169) { return 3; }
    return 0;
}

// The word, or the paragraph, at offset o.
fn _unit(d as *Data, by as i64, o as i64, a as *i64, b as *i64) as void {
    if (by == 3) {
        _paragraph(d, o, a, b);
        return;
    }
    *b = cursor.next_word(&d.sel.lay, o);
    *a = cursor.prev_word(&d.sel.lay, *b);
    if (*a > o) { *a = o; }
}

// Where the pointer is, in the text, for an event at local x, y of w.
fn _hit(t as *tree.Tree, w as i64, d as *Data, e as *event.Event) as cursor.Position {
    let is math.rect.Rect as r = layout.rect(t, w);
    return cursor.hit(&d.sel.lay, e.local_x - _left(t, w, d, r.w), e.local_y - _top(d, r.h));
}

// The selection carried on to p by the press's unit: from the unit's far
// side, round the unit at p.
fn _extend(d as *Data, p as cursor.Position) as void {
    let is *Sel as s = d.sel;
    if (s.by == 1) {
        s.caret = p;
        return;
    }
    let is i64 as a with mut = 0;
    let is i64 as b with mut = 0;
    _unit(d, s.by, p.offset, &a, &b);
    if (a < s.unit_a) {
        s.anchor = s.unit_b;
        s.caret = cursor.position(a, 0);
    } else {
        s.anchor = s.unit_a;
        if (b < s.unit_b) { b = s.unit_b; }
        s.caret = cursor.position(b, 0);
    }
}

fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Data as d = cast(*Data, data);
    let is *Sel as s = d.sel;
    if (cast(i64, s) == 0 || s.laid == 0) { return 0; }
    if (e.kind == event.POINTER_DOWN) {
        if (e.button != 1) { return 0; }
        let is cursor.Position as p = _hit(t, w, d, e);
        s.want_x = 0.0 - 1.0;
        s.by = 1;
        if (e.clicks >= 2) {
            s.by = 3;
            if (e.clicks == 2) { s.by = 2; }
            _unit(d, s.by, p.offset, &s.unit_a, &s.unit_b);
            s.anchor = s.unit_a;
            s.caret = cursor.position(s.unit_b, 0);
        } else if ((e.mods & keys.MOD_SHIFT) != 0) {
            s.caret = p;
        } else {
            s.anchor = p.offset;
            s.caret = p;
        }
        s.pressing = 1;
        widget.changed(t, w, widget.CHANGED_PAINT);
        return 1;
    }
    if (e.kind == event.POINTER_MOVE) {
        if (s.pressing == 0) { return 0; }
        _extend(d, _hit(t, w, d, e));
        widget.changed(t, w, widget.CHANGED_PAINT);
        return 1;
    }
    if (e.kind == event.POINTER_UP || e.kind == event.POINTER_CANCEL) {
        if (s.pressing == 0) { return 0; }
        s.pressing = 0;
        if (e.kind == event.POINTER_UP) { _copy(t, d, tree.PRIMARY); }
        return 1;
    }
    if (e.kind == event.KEY_DOWN) { return _key(t, w, d, e); }
    if (e.kind == event.SHORTCUT_OVERRIDE) {
        // Before the window's shortcuts: Ctrl+A, and Ctrl+C with something
        // to copy.
        let is i32 as k with mut = e.key;
        if (k >= 65 && k <= 90) { k = k + 32; }
        if ((e.mods & keys.MOD_CONTROL) == 0) { return 0; }
        if (k == keys.A) { return 1; }
        if (k == keys.C && s.anchor != s.caret.offset) { return 1; }
    }
    return 0;
}

fn _key(t as *tree.Tree, w as i64, d as *Data, e as *event.Event) as i64 {
    let is *Sel as s = d.sel;
    let is *tlayout.Layout as l = &s.lay;
    let is i32 as ctrl = cast(i32, (e.mods & keys.MOD_CONTROL) != 0);
    let is i32 as shift = cast(i32, (e.mods & keys.MOD_SHIFT) != 0);
    let is i32 as k with mut = e.key;
    if (k >= 65 && k <= 90) { k = k + 32; }
    if (ctrl == 1 && k == keys.A) {
        s.anchor = 0;
        s.caret = cursor.position(txt.text_length(&d.run), 0);
        _copy(t, d, tree.PRIMARY);
        widget.changed(t, w, widget.CHANGED_PAINT);
        return 1;
    }
    if (ctrl == 1 && k == keys.C) {
        _copy(t, d, tree.CLIPBOARD);
        return 1;
    }
    let is cursor.Position as at = s.caret;
    let is cursor.Position as to with mut = at;
    let is i32 as vertical with mut = 0;
    let is i64 as li = cursor.line_of(l, at);
    if (k == keys.LEFT) {
        if (ctrl == 1) { to = cursor.position(cursor.prev_word(l, at.offset), 0); }
        else { to = cursor.left(l, at); }
    } else if (k == keys.RIGHT) {
        if (ctrl == 1) { to = cursor.position(cursor.next_word(l, at.offset), 0); }
        else { to = cursor.right(l, at); }
    } else if (k == keys.UP || k == keys.DOWN) {
        if (s.want_x < 0.0) { s.want_x = cursor.caret(l, at).x; }
        if (k == keys.UP) { to = cursor.up(l, at, s.want_x); }
        else { to = cursor.down(l, at, s.want_x); }
        vertical = 1;
    } else if (k == keys.HOME) {
        to = cursor.position(tlayout.line(l, li).start, 0);
        if (ctrl == 1) { to = cursor.position(0, 0); }
    } else if (k == keys.END) {
        to = cursor.position(tlayout.line(l, li).end, 1);
        if (ctrl == 1) { to = cursor.position(txt.text_length(&d.run), 0); }
    } else {
        return 0;
    }
    if (vertical == 0) { s.want_x = 0.0 - 1.0; }
    s.caret = to;
    if (shift == 0) { s.anchor = to.offset; }
    if (shift == 1) { _copy(t, d, tree.PRIMARY); }
    widget.changed(t, w, widget.CHANGED_PAINT);
    return 1;
}
