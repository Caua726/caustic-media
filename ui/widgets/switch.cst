// ui/widgets/switch.cst — on or off, as a light switch is.
//
// A track the theme's size, rounded at both ends, filled when on, and a knob
// that slides to the end it stands for over the theme's fast duration,
// through the window's animator (tree.animator) — at once with reduced motion,
// or with no animator lent. Clicked on a release inside it after a press, on
// Space released and on Enter, as GTK's switch is, and by assistive
// technology; TOGGLED on every change. A switch has no label of its own: the
// label beside it names it (tree.set_labelled_by).
use "../../math/math.cst" as math;
use "../../window/keys.cst" as keys;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../signal.cst" as signal;
use "../anim.cst" as anim;

struct Data {
    pos      as f64;   // the knob: 0 at the start, 1 at the end
    on       as i32;
    held     as i32;   // Space held on it
    pressing as i32;
    out      as i32;   // pressed, and the pointer has left it
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("switch", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.paint = fn_ptr(_paint);
    _kind.event = fn_ptr(_event);
    _kind.role = access.ROLE_SWITCH;
    _kind.access = fn_ptr(_access);
    _ready = 1;
}

// A new switch, off, as the last child of parent. Its handle, or 0 with the
// tree's last_error set.
fn create(t as *tree.Tree, parent as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    tree.set_focusable(t, w, 1);
    return w;
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

fn _repaint(t as *tree.Tree, w as i64) as void { widget.changed(t, w, widget.CHANGED_PAINT); }

// On or off, saying TOGGLED when that changes it, the knob sliding there. 1,
// or 0 for a widget that is no switch.
fn set_active(t as *tree.Tree, w as i64, on as i32) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    if (d.on == on) { return 1; }
    d.on = on;
    let is f64 as to = cast(f64, on);
    let is *anim.Animator as an = cast(*anim.Animator, tree.animator(t));
    if (cast(i64, an) != 0) {
        anim.number(an, w, &d.pos, to, tree.theme(t).motion.fast, anim.THEME_EASE);
    } else {
        d.pos = to;
    }
    _repaint(t, w);
    signal.emit(t, w, signal.TOGGLED, cast(*u8, 0));
    return 1;
}

fn is_active(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.on;
}

// Where its knob is now: 0 at the start, 1 at the end.
fn knob(t as *tree.Tree, w as i64) as f64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0.0; }
    return d.pos;
}

// Whether it is held down now: by a press the pointer is still over, or by
// Space.
fn is_down(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return cast(i32, d.held == 1 || (d.pressing == 1 && d.out == 0));
}

// Its track in rc, its rectangle: at its start, centred down.
fn _track_in(t as *tree.Tree, w as i64, rc as math.rect.Rect, th as *style.Theme) as math.rect.Rect {
    let is f64 as sw = th.metrics.switch_w;
    let is f64 as sh = th.metrics.switch_h;
    let is f64 as x with mut = rc.x;
    if (layout.direction(t, w) == layout.RTL) { x = rc.x + rc.w - sw; }
    return math.rect.rect(x, rc.y + (rc.h - sh) / 2.0, sw, sh);
}

// Its track, in the window; nothing for a widget that is no switch.
fn track(t as *tree.Tree, w as i64) as math.rect.Rect {
    if (cast(i64, _data(t, w)) == 0) { return math.rect.rect_zero(); }
    let is style.Theme as th;
    widget.theme(t, w, &th);
    return _track_in(t, w, layout.window_rect(t, w), &th);
}

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is style.Theme as th;
    widget.theme(t, w, &th);
    out.min_w = th.metrics.switch_w;
    out.min_h = th.metrics.switch_h;
    out.pref_w = out.min_w;
    out.pref_h = out.min_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Data as d = cast(*Data, data);
    let is *style.Theme as th = p.theme;
    let is math.rect.Rect as tr = _track_in(t, w, p.rect, th);
    let is i64 as st with mut = p.state | painter.S_PRESSED;
    if (is_down(t, w) == 0) { st = st - painter.S_PRESSED; }
    if (d.pressing == 1 && d.out == 1 && (st & painter.S_HOVER) != 0) { st = st - painter.S_HOVER; }
    let is style.Look as look = style.pick(&th.track, st, d.on);
    let is f64 as rad = tr.h / 2.0;
    shapes.fill_rounded(p.canvas, tr.x, tr.y, tr.w, tr.h, rad, rad, rad, rad, look.bg);
    if (th.metrics.border_width > 0.0 && look.border.a > 0.0) {
        shapes.stroke_rounded(p.canvas, tr.x, tr.y, tr.w, tr.h, rad, rad, rad, rad, th.metrics.border_width,
                              look.border);
    }
    // The knob: inset two pixels, at the end the position says, mirrored
    // right to left.
    let is f64 as k with mut = d.pos;
    if (p.rtl == 1) { k = 1.0 - k; }
    let is math.color.Color as knob_col with mut = th.indicator.checked.fg;
    if (painter.has(p, painter.S_DISABLED) == 1) {
        knob_col = style.with_alpha(knob_col, knob_col.a * th.indicator.disabled_alpha);
    }
    shapes.fill_circle(p.canvas, tr.x + rad + k * (tr.w - tr.h), tr.y + rad, rad - 2.0, knob_col);
}

fn _inside(t as *tree.Tree, w as i64, e as *event.Event) as i32 {
    let is math.rect.Rect as r = layout.rect(t, w);
    return cast(i32, e.local_x >= 0.0 && e.local_y >= 0.0 && e.local_x < r.w && e.local_y < r.h);
}

fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Data as d = cast(*Data, data);
    let is i32 as k = e.kind;
    let is i32 as plain = cast(i32, (e.mods & (keys.MOD_CONTROL | keys.MOD_ALT)) == 0);
    if (k == event.POINTER_DOWN) {
        if (e.button != 1) { return 0; }
        d.pressing = 1;
        d.out = 0;
        _repaint(t, w);
        return 1;
    }
    if (k == event.POINTER_MOVE) {
        if (d.pressing == 0) { return 0; }
        let is i32 as out = 1 - _inside(t, w, e);
        if (out != d.out) {
            d.out = out;
            _repaint(t, w);
        }
        return 1;
    }
    if (k == event.POINTER_UP || k == event.POINTER_CANCEL) {
        if (d.pressing == 0) { return 0; }
        d.pressing = 0;
        _repaint(t, w);
        if (k == event.POINTER_UP && _inside(t, w, e) == 1) { set_active(t, w, 1 - d.on); }
        return 1;
    }
    if (k == event.SHORTCUT_OVERRIDE) {
        return cast(i64, plain == 1 && (e.key == keys.SPACE || e.key == keys.RETURN));
    }
    if (k == event.KEY_DOWN) {
        if (plain == 0) { return 0; }
        if (e.key == keys.SPACE) {
            if (d.held == 0) {
                d.held = 1;
                _repaint(t, w);
            }
            return 1;
        }
        if (e.key == keys.RETURN) {
            if (e.repeat == 0) { set_active(t, w, 1 - d.on); }
            return 1;
        }
        return 0;
    }
    if (k == event.KEY_UP) {
        if (e.key != keys.SPACE || d.held == 0) { return 0; }
        d.held = 0;
        _repaint(t, w);
        set_active(t, w, 1 - d.on);
        return 1;
    }
    if (k == event.FOCUS_OUT) {
        if (d.held == 1) {
            d.held = 0;
            _repaint(t, w);
        }
        return 0;
    }
    if (k == event.ACTIVATE) {
        set_active(t, w, 1 - d.on);
        return 1;
    }
    return 0;
}

fn _access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Data as d = cast(*Data, data);
    if (q.action == access.ASK) {
        q.actions = access.PRESS | access.TOGGLE;
        q.states = q.states | access.CHECKABLE;
        if (d.on == 1) { q.states = q.states | access.CHECKED; }
        return 1;
    }
    set_active(t, w, 1 - d.on);
    return 1;
}
