// ui/widgets/label_test.cst — the label: measured as the text service lays
// its text out — natural, wrapped to a width, cut to lines with an ellipsis —
// in the theme's text style for its role, restyled when the theme changes;
// spans of other styles; drawn in the theme's colour for its tone, faded when
// disabled, aligned in its rectangle; told to assistive technology, and the
// name of what it labels.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/math.cst" as fm;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/model.cst" as model;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../../window/keys.cst" as keys;
use "../text.cst" as text;
use "label.cst" as label;

let is i64 as W with imut = 200;
let is i64 as H with imut = 100;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn near(a as f64, b as f64, eps as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < eps && d > 0.0 - eps);
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

// --- Fonts ---

let is [2]table.Face as faces with mut;
let is font.List as plain_list with mut;
let is font.List as glyf_list with mut;
let is font.Font as plain_font with mut;
let is font.Font as glyf_font with mut;
let is *u8 as mono_asked with mut;

// The theme's interface family is shape-plain.ttf, glyf.ttf from 600 up;
// its monospace family, and one called "Bold", glyf.ttf whatever the weight.
fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font {
    if (same(family, 4, "Mono") == 1) {
        mono_asked = family;
        return &glyf_font;
    }
    if (same(family, 4, "Bold") == 1) { return &glyf_font; }
    if (weight >= 600) { return &glyf_font; }
    return &plain_font;
}

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;

// What the service lays out for text in a size and weight of the theme's
// family, at width (below 0 for the text's own) with at most lines.
let is text.Run as want with mut;

fn expect(s as *u8, n as i64, size as f64, weight as i64, width as f64, lines as i64, ellipsis as i32) as void {
    let is style.TextStyle as ts;
    ts.size = size;
    ts.weight = weight;
    let is text.Style as st = text.style_of(ts);
    st.family = theme.fonts.family;
    let is model.Params as pp = model.params();
    pp.width = width;
    pp.max_lines = lines;
    pp.ellipsis = ellipsis;
    text.lay_plain(svc, &want, s, n, &st, &pp);
}

// v up to a whole pixel, as a label measures, at scale 1.
fn up(v as f64) as f64 { return fm.ceil(v - 0.000000001); }

fn measure(t as *tree.Tree, w as i64, cw as f64) as geom.Size {
    let is geom.Constraint as c = geom.constraint(cw, layout.UNBOUNDED);
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

// --- Measured ---

fn measured() as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    let is i64 as root = tree.root(&t);
    let is i64 as w = label.create(&t, root, "Hello world", 11);
    check("a label", w != 0 && cast(i64, tree.kind(&t, w)) == cast(i64, label.kind()) &&
          tree.kind(&t, w).role == access.ROLE_LABEL);
    check("its text, its own copy", same(label.text(&t, w), label.text_length(&t, w), "Hello world") == 1);

    let is geom.Size as s with mut = measure(&t, w, layout.UNBOUNDED);
    expect("Hello world", 11, 20.0, 400, 0.0 - 1.0, 0, 0);
    check("as wide and tall as its text, in the body style", s.pref_w == up(want.width) && s.pref_h == up(want.height) &&
          want.width > 50.0 && want.height > 0.0);
    check("no smaller: it does not wrap", s.min_w == s.pref_w && s.min_h == s.pref_h);
    check("free to be given more", s.max_w >= layout.UNBOUNDED);
    let is f64 as one = want.height;
    s = measure(&t, w, 30.0);
    check("narrower than its text: still one line", s.pref_h == up(one) && s.min_w == up(want.width));

    label.set_wrap(&t, w, 1);
    check("wrapping: measured again", tree.needs_layout(&t, w) == 1);
    s = measure(&t, w, 60.0);
    expect("Hello world", 11, 20.0, 400, 60.0, 0, 0);
    check("wrapping: as tall as the text at the width it is offered", s.pref_h == up(want.height) && want.height > one);
    let is f64 as wrapped = want.height;
    check("no narrower than its widest word", s.min_w == up(want.least) && want.least < 60.0 && want.least > 0.0);
    expect("Hello world", 11, 20.0, 400, 0.0 - 1.0, 0, 0);
    check("and as wide as its text would like", s.pref_w == up(want.width));
    s = measure(&t, w, layout.UNBOUNDED);
    check("all the room it wants: one line", s.pref_h == up(one));
    s = measure(&t, w, 5.0);
    expect("Hello world", 11, 20.0, 400, 0.0 - 1.0, 0, 0);
    expect("Hello world", 11, 20.0, 400, want.least, 0, 0);
    check("narrower than a word: as at the widest word", s.pref_h == up(want.height) && want.nlines == 2);

    label.set_lines(&t, w, 1, 1);
    s = measure(&t, w, 60.0);
    check("one line at most, an ellipsis: one line tall", s.pref_h == up(one));
    check("its run cut short", label.run(&t, w).cut == 1);
    label.set_wrap(&t, w, 0);
    s = measure(&t, w, layout.UNBOUNDED);
    expect("Hello world", 11, 20.0, 400, 0.0 - 1.0, 0, 0);
    check("not wrapping, an ellipsis: as wide as its text would like", s.pref_w == up(want.width));
    s = measure(&t, w, 60.0);
    expect("…", 3, 20.0, 400, 0.0 - 1.0, 0, 0);
    check("but no smaller than an ellipsis", s.min_w == up(want.width) && s.min_w < 60.0);
    check("cut to the width", label.run(&t, w).cut == 1 && label.run(&t, w).width <= 60.0 && s.pref_h == up(one));
    // Wrapping, an ellipsis but no limit to the lines: every line.
    label.set_wrap(&t, w, 1);
    label.set_lines(&t, w, 0, 1);
    s = measure(&t, w, 60.0);
    check("wrapping with an ellipsis and no limit: every line", s.pref_h == up(wrapped) && label.run(&t, w).cut == 0);
    label.set_lines(&t, w, 0, 0);

    // In a column of a known width: as tall as the text wrapped to it.
    let is i64 as col = box.create(&t, root, box.COLUMN);
    tree.reparent(&t, w, col);
    layout.set_align(&t, col, layout.START, layout.START);
    layout.set_min_size(&t, col, 60.0, 0.0);
    layout.set_max_size(&t, col, 60.0, layout.UNBOUNDED);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as rc = layout.rect(&t, w);
    check("in a column: the column's width, as tall as wrapped", rc.w == 60.0 && rc.h == up(wrapped));
    check("laid out at that width", label.run(&t, w).nlines == 2);

    // The text changed: measured again, and its own.
    let is [8]u8 as buf;
    buf[0] = 72; buf[1] = 105;
    label.set_text(&t, w, cast(*u8, &buf), 2);
    buf[0] = 0;
    check("new text: measured again", tree.needs_layout(&t, w) == 1 && label.text_length(&t, w) == 2 &&
          label.text(&t, w)[0] == 72);
    s = measure(&t, w, layout.UNBOUNDED);
    expect("Hi", 2, 20.0, 400, 0.0 - 1.0, 0, 0);
    check("measured as its new text", s.pref_w == up(want.width));

    // Whole physical pixels, so that laid out at its size it fits on them:
    // given its own width, a wrapping label does not wrap.
    label.set_text(&t, w, "Hello world", 11);
    layout.set_align(&t, col, layout.START, layout.START);
    layout.set_min_size(&t, col, 0.0, 0.0);
    layout.set_max_size(&t, col, layout.UNBOUNDED, layout.UNBOUNDED);
    layout.set_margin(&t, col, 0.5, 0.0, 0.0, 0.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    expect("Hello world", 11, 20.0, 400, 0.0 - 1.0, 0, 0);
    check("given its own width, at a fraction of a pixel: one line", label.run(&t, w).nlines == 1 &&
          layout.rect(&t, w).w == up(want.width) && want.width != up(want.width));
    layout.set_scale(&t, 1.5);
    s = measure(&t, w, layout.UNBOUNDED);
    check("at a scale of 1.5: whole physical pixels", s.pref_w * 1.5 == fm.ceil(want.width * 1.5) &&
          s.pref_h * 1.5 == fm.ceil(want.height * 1.5));
    layout.set_scale(&t, 1.0);
    layout.set_margin(&t, col, 0.0, 0.0, 0.0, 0.0);

    // Asked of what is no label.
    let is i64 as other = tree.create(&t, &plain_kind, root);
    check("set on what is no label: refused", label.set_text(&t, other, "x", 1) == 0 &&
          label.set_text_mnemonic(&t, other, "_x", 2) == 0 && label.target(&t, other) == 0 &&
          label.mnemonic(&t, other) == 0 && cast(i64, label.text(&t, other)) == 0);
    check("on a label: done", label.set_text(&t, w, "Hi", 2) == 1);
    tree.close(&t);

    // A tree with no room.
    let is tree.Limits as tiny = tree.limits_default();
    tiny.widgets = 1;
    let is tree.Tree as full = tree.open(&tiny);
    check("no room: no label", label.create(&full, tree.root(&full), "x", 1) == 0);
    tree.close(&full);
}

// --- The theme's styles ---

fn styled() as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    let is i64 as root = tree.root(&t);
    let is i64 as w = label.create(&t, root, "Hello", 5);
    label.set_style(&t, w, label.HEADING);
    let is geom.Size as s with mut = measure(&t, w, layout.UNBOUNDED);
    expect("Hello", 5, theme.fonts.heading.size, theme.fonts.heading.weight, 0.0 - 1.0, 0, 0);
    check("a heading: the theme's heading style", s.pref_w == up(want.width) && s.pref_h == up(want.height) &&
          cast(i64, text.face(label.run(&t, w), 0).font) == cast(i64, &glyf_font));
    label.set_style(&t, w, label.MONO);
    measure(&t, w, layout.UNBOUNDED);
    check("monospace: the theme's monospace family", same(mono_asked, 4, "Mono") == 1 &&
          text.face(label.run(&t, w), 0).px == theme.fonts.mono_body.size);
    label.set_style(&t, w, label.BODY);

    // Text scaled for this part of the window.
    let is f64 as before = measure(&t, w, layout.UNBOUNDED).pref_w;
    let is style.Overrides as o = style.overrides();
    style.override_text_scale(&o, 2.0);
    tree.set_overrides(&t, w, &o);
    s = measure(&t, w, layout.UNBOUNDED);
    expect("Hello", 5, 40.0, 400, 0.0 - 1.0, 0, 0);
    check("an override's text scale: laid out again, larger", s.pref_w == up(want.width) && s.pref_w > before);
    tree.set_overrides(&t, w, cast(*style.Overrides, 0));

    // Spans: a bold word, the rest in the label's style.
    let is [2]text.Style as sts;
    sts[0] = text.style_of(theme.fonts.body);
    sts[0].size = 0.0;
    sts[0].weight = 0;
    sts[1] = sts[0];
    sts[1].weight = 700;
    sts[1].underline = 1;
    let is model.Span as sp;
    sp.start = 2;
    sp.end = 4;
    sp.style = 1;
    label.set_spans(&t, w, cast(*text.Style, &sts), 2, &sp, 1);
    measure(&t, w, layout.UNBOUNDED);
    let is *text.Run as r with mut = label.run(&t, w);
    check("spans: their styles, sizes and weights of no value the label's", r.nfaces == 2 &&
          cast(i64, text.face(r, text.glyph(r, 0).face).font) == cast(i64, &plain_font) &&
          cast(i64, text.face(r, text.glyph(r, 2).face).font) == cast(i64, &glyf_font) &&
          text.face(r, text.glyph(r, 2).face).px == 20.0 && text.glyph(r, 3).style == 1 &&
          text.deco_count(r) == 1);
    label.set_spans(&t, w, cast(*text.Style, 0), 0, cast(*model.Span, 0), 0);
    measure(&t, w, layout.UNBOUNDED);
    check("no spans again: one face", label.run(&t, w).nfaces == 1);

    // One style of the program's, over the whole text.
    sts[0].weight = 700;
    label.set_spans(&t, w, cast(*text.Style, &sts), 1, cast(*model.Span, 0), 0);
    measure(&t, w, layout.UNBOUNDED);
    check("one style of the program's: the whole text in it",
          cast(i64, text.face(label.run(&t, w), 0).font) == cast(i64, &glyf_font) && label.run(&t, w).nfaces == 1);
    sts[0].weight = 0;
    // A span's weight of 0 under a bold heading: bold.
    label.set_style(&t, w, label.HEADING);
    sts[1].weight = 0;
    label.set_spans(&t, w, cast(*text.Style, &sts), 2, &sp, 1);
    measure(&t, w, layout.UNBOUNDED);
    r = label.run(&t, w);
    check("a weight of 0: the label's, however heavy",
          cast(i64, text.face(r, text.glyph(r, 2).face).font) == cast(i64, &glyf_font) && r.nfaces == 1);
    // A span's own family.
    label.set_style(&t, w, label.BODY);
    sts[1].family = "Mono";
    mono_asked = cast(*u8, 0);
    label.set_spans(&t, w, cast(*text.Style, &sts), 2, &sp, 1);
    measure(&t, w, layout.UNBOUNDED);
    r = label.run(&t, w);
    check("a family of its own", cast(i64, text.face(r, text.glyph(r, 2).face).font) == cast(i64, &glyf_font) &&
          cast(i64, text.face(r, text.glyph(r, 0).face).font) == cast(i64, &plain_font));
    label.set_spans(&t, w, cast(*text.Style, 0), 0, cast(*model.Span, 0), 0);

    // The theme's weight and family changed: laid out again.
    let is style.Theme as heavy = theme;
    heavy.fonts.body.weight = 700;
    tree.set_theme(&t, &heavy);
    measure(&t, w, layout.UNBOUNDED);
    check("the theme's weight changed", cast(i64, text.face(label.run(&t, w), 0).font) == cast(i64, &glyf_font));
    tree.set_theme(&t, &theme);
    measure(&t, w, layout.UNBOUNDED);
    check("and back", cast(i64, text.face(label.run(&t, w), 0).font) == cast(i64, &plain_font));
    let is style.Theme as other = theme;
    other.fonts.family = "Bold";
    tree.set_theme(&t, &other);
    measure(&t, w, layout.UNBOUNDED);
    check("the theme's family changed", cast(i64, text.face(label.run(&t, w), 0).font) == cast(i64, &glyf_font));
    tree.close(&t);
}

// --- Told ---

fn told() as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    let is i64 as root = tree.root(&t);
    let is i64 as w = label.create(&t, root, "Name:", 5);
    let is i64 as field = tree.create(&t, &plain_kind, root);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("a label to assistive technology: its text its name", q.role == access.ROLE_LABEL &&
          same(q.name, q.name_len, "Name:") == 1 && q.actions == 0 && (q.states & access.MULTI_LINE) == 0);
    label.set_wrap(&t, w, 1);
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("wrapping: many lines", (q.states & access.MULTI_LINE) != 0);
    label.set_target(&t, w, field);
    check("what it labels", label.target(&t, w) == field && tree.labelled_by(&t, field) == w);
    access.describe(&t, cast(*router.Router, 0), field, &q);
    check("named by it", same(q.name, q.name_len, "Name:") == 1);
    label.set_target(&t, w, 0);
    check("labels nothing again", label.target(&t, w) == 0 && tree.labelled_by(&t, field) == 0);
    label.set_target(&t, w, field);
    label.set_text(&t, w, "Full name:", 10);
    access.describe(&t, cast(*router.Router, 0), field, &q);
    check("named by its new text", same(q.name, q.name_len, "Full name:") == 1);
    check("not a label: no text", label.text_length(&t, field) == 0 && cast(i64, label.run(&t, field)) == 0);
    tree.close(&t);
}

let is tree.Kind as plain_kind with mut;

// --- With no text service ---

fn unserviced() as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    let is i64 as w = label.create(&t, tree.root(&t), "Hello", 5);
    let is geom.Size as s with mut = measure(&t, w, layout.UNBOUNDED);
    check("no service: nothing to measure", s.pref_w == 0.0 && s.pref_h == 0.0 && s.min_w == 0.0 &&
          label.text_length(&t, w) == 5);
    tree.close(&t);
}

// --- Drawn ---

let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [20000]i32 as px with mut;

let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// The middle of the ink of glyph i of w's text, drawn from (x, y): the
// rectangles of shape-plain.ttf are solid there.
fn ink_x(t as *tree.Tree, w as i64, i as i64, x as f64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, w), i);
    return cast(i64, x + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, w as i64, i as i64, y as f64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, w), i);
    return cast(i64, y + g.y - 4.0);
}

fn painted(c as *draw2d.Canvas) as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    let is i64 as a = label.create(&t, col, "Hello", 5);
    let is i64 as b = label.create(&t, col, "Hello", 5);
    layout.set_align(&t, a, layout.START, layout.START);
    label.set_align(&t, b, model.ALIGN_CENTER);
    frame(&t, c);
    let is math.rect.Rect as ra = layout.rect(&t, a);
    let is math.rect.Rect as rb = layout.rect(&t, b);
    check("its own size at the start; the other the column's width", ra.w < rb.w && rb.w == cast(f64, W) &&
          ra.h == rb.h);
    check("drawn in the theme's text colour", is8(ink_x(&t, a, 0, ra.x), ink_y(&t, a, 0, ra.y), theme.palette.fg, 1) == 1);
    check("nothing past its text", is8(cast(i64, ra.x + ra.w) + 2, ink_y(&t, a, 0, ra.y), theme.palette.window_bg, 1) == 1);
    let is f64 as dx = (rb.w - label.run(&t, b).width) / 2.0;
    check("centred: in the middle of its rectangle",
          is8(ink_x(&t, b, 0, rb.x + dx), ink_y(&t, b, 0, rb.y), theme.palette.fg, 1) == 1 &&
          is8(ink_x(&t, b, 0, rb.x), ink_y(&t, b, 0, rb.y), theme.palette.window_bg, 1) == 1);

    label.set_tone(&t, a, label.DIM);
    label.set_tone(&t, b, label.ERROR);
    frame(&t, c);
    check("dim: the theme's secondary text", is8(ink_x(&t, a, 0, ra.x), ink_y(&t, a, 0, ra.y), theme.palette.fg_dim, 1) == 1);
    check("an error: the theme's error colour",
          is8(ink_x(&t, b, 0, rb.x + dx), ink_y(&t, b, 0, rb.y), theme.palette.error, 1) == 1);
    label.set_tone(&t, a, label.NORMAL);
    tree.set_enabled(&t, a, 0);
    frame(&t, c);
    let is math.color.Color as faded = style.over(style.with_alpha(theme.palette.fg, theme.control.disabled_alpha),
                                                  theme.palette.window_bg);
    check("disabled: faded as the theme fades", is8(ink_x(&t, a, 0, ra.x), ink_y(&t, a, 0, ra.y), faded, 2) == 1);
    tree.close(&t);
}

// --- Where in its rectangle ---

// A label filling the window, aligned and in a direction: its text's left
// in the rectangle should be at, its first glyph's ink there and not where
// the other alignments would put it.
fn placed(c as *draw2d.Canvas, align as i64, rtl as i32, at as i64) as i32 {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    let is i64 as w = label.create(&t, tree.root(&t), "Hello", 5);
    label.set_align(&t, w, align);
    if (rtl == 1) { layout.set_direction(&t, w, layout.RTL); }
    frame(&t, c);
    let is math.rect.Rect as rc = layout.rect(&t, w);
    let is *text.Run as r = label.run(&t, w);
    let is f64 as spare = rc.w - r.width;
    let is f64 as y = rc.y + (rc.h - r.height) / 2.0;
    let is [3]f64 as xs;
    xs[0] = 0.0;
    xs[1] = spare / 2.0;
    xs[2] = spare;
    let is i32 as ok with mut = cast(i32, rc.w == cast(f64, W) && rc.h == cast(f64, H) && spare > 100.0);
    let is i64 as k with mut = 0;
    while (k < 3) {
        let is math.color.Color as want with mut = theme.palette.window_bg;
        if (k == at) { want = theme.palette.fg; }
        if (is8(ink_x(&t, w, 0, rc.x + xs[k]), ink_y(&t, w, 0, y), want, 1) == 0) { ok = 0; }
        k = k + 1;
    }
    tree.close(&t);
    return ok;
}

fn aligned(c as *draw2d.Canvas) as void {
    check("at the start, centred down", placed(c, model.ALIGN_START, 0, 0) == 1);
    check("at the start, right to left", placed(c, model.ALIGN_START, 1, 2) == 1);
    check("at the end", placed(c, model.ALIGN_END, 0, 2) == 1);
    check("at the end, right to left", placed(c, model.ALIGN_END, 1, 0) == 1);
    check("left, right to left", placed(c, model.ALIGN_LEFT, 1, 0) == 1);
    check("right", placed(c, model.ALIGN_RIGHT, 0, 2) == 1);
    check("centred", placed(c, model.ALIGN_CENTER, 1, 1) == 1);
    check("justified: at the start", placed(c, model.ALIGN_JUSTIFY, 0, 0) == 1);
}

// --- Mnemonics ---

// Nothing drawn along w's row at y below its top.
fn clean_under(t as *tree.Tree, w as i64, y as f64) as i32 {
    let is math.rect.Rect as rc = layout.rect(t, w);
    let is i64 as x with mut = cast(i64, rc.x);
    while (x < cast(i64, rc.x + rc.w) && x < W) {
        if (is8(x, cast(i64, rc.y + y), theme.palette.window_bg, 1) == 0) { return 0; }
        x = x + 1;
    }
    return 1;
}

fn mnemonics(c as *draw2d.Canvas) as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    let is i64 as w = label.create(&t, col, "", 0);
    let is i64 as field = tree.create(&t, &plain_kind, col);
    tree.set_focusable(&t, field, 1);
    layout.set_align(&t, w, layout.START, layout.START);

    label.set_text_mnemonic(&t, w, "_Save as", 8);
    check("the underscore marks the letter, and is not shown",
          same(label.text(&t, w), label.text_length(&t, w), "Save as") == 1 && label.mnemonic(&t, w) == 83);
    label.set_text_mnemonic(&t, w, "Sa__ve", 6);
    check("two underscores: one shown, no mnemonic",
          same(label.text(&t, w), label.text_length(&t, w), "Sa_ve") == 1 && label.mnemonic(&t, w) == 0);
    label.set_text_mnemonic(&t, w, "ab_", 3);
    check("an underscore last: shown", same(label.text(&t, w), label.text_length(&t, w), "ab_") == 1 &&
          label.mnemonic(&t, w) == 0);
    label.set_text_mnemonic(&t, w, "\xc3\x89_dit _\xc3\x89l", 11);
    check("the first marked letter, of any script",
          same(label.text(&t, w), label.text_length(&t, w), "\xc3\x89dit \xc3\x89l") == 1 &&
          label.mnemonic(&t, w) == 100);
    label.set_text(&t, w, "Plain_text", 10);
    check("set as plain text: no mnemonic, underscores shown", label.mnemonic(&t, w) == 0 &&
          label.text_length(&t, w) == 10);
    // Letters of every length, and what is not UTF-8.
    check("set", label.set_text_mnemonic(&t, w, "_\xc3\x89dit", 6) == 1 && label.mnemonic(&t, w) == 201);
    label.set_text_mnemonic(&t, w, "_\xe0\xa4\x95", 4);
    check("three bytes", label.mnemonic(&t, w) == 2325 && label.text_length(&t, w) == 3);
    label.set_text_mnemonic(&t, w, "_\xf0\x9d\x90\x81", 5);
    check("four bytes", label.mnemonic(&t, w) == 119809 && label.text_length(&t, w) == 4);
    label.set_text_mnemonic(&t, w, "x_\xc3\x89", 4);
    check("the letter last", label.mnemonic(&t, w) == 201 &&
          same(label.text(&t, w), label.text_length(&t, w), "x\xc3\x89") == 1);
    label.set_text_mnemonic(&t, w, "x_S", 3);
    check("one byte, last", label.mnemonic(&t, w) == 83 && same(label.text(&t, w), label.text_length(&t, w), "xS") == 1);
    label.set_text_mnemonic(&t, w, "a_\xc3", 3);
    check("cut short: the byte", label.mnemonic(&t, w) == 195);
    label.set_text_mnemonic(&t, w, "_\x80a", 3);
    check("not UTF-8: the byte", label.mnemonic(&t, w) == 128);
    label.set_text_mnemonic(&t, w, "_Edit _As", 9);
    check("the first marked", label.mnemonic(&t, w) == 69 &&
          same(label.text(&t, w), label.text_length(&t, w), "Edit As") == 1);
    check("lengths below 0 refused", label.set_text_mnemonic(&t, w, "_x", 0 - 1) == 0 &&
          label.set_text(&t, w, "x", 0 - 1) == 0 && label.mnemonic(&t, w) == 69);
    label.set_text_mnemonic(&t, w, "_Save as", 8);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("told without the underscore", same(q.name, q.name_len, "Save as") == 1);

    // Alt and the letter: what it labels has the focus.
    let is router.Router as r = router.init(router.settings_default());
    label.set_target(&t, w, field);
    check("bound to what it labels", label.bind_mnemonic(&t, &r, w) == 1);
    router.key(&t, &r, keys.S, keys.MOD_ALT, 1, 0, 10);
    router.key(&t, &r, keys.S, keys.MOD_ALT, 0, 0, 15);
    router.key(&t, &r, keys.ALT_L, 0, 0, 0, 20);
    check("alt+s: focus on what it labels", router.focused(&t, &r) == field);
    let is i64 as plain = label.create(&t, col, "No mnemonic", 11);
    check("no mnemonic: nothing bound", label.bind_mnemonic(&t, &r, plain) == 0 &&
          label.bind_mnemonic(&t, &r, field) == 0);
    // Labelling nothing: its own.
    let is i64 as alone = label.create(&t, col, "_Quit", 5);
    label.set_text_mnemonic(&t, alone, "_Quit", 5);
    check("labelling nothing: bound to itself", label.bind_mnemonic(&t, &r, alone) == 1 &&
          r.mnemonic_w[1] == alone);

    // Underlined while Alt is held.
    frame_router = &r;
    frame(&t, c);
    let is math.rect.Rect as rw with mut = layout.rect(&t, w);
    let is text.Deco as u;
    text.underline_at(label.run(&t, w), 0, &u);
    let is i64 as ux = cast(i64, rw.x + u.x + u.w / 2.0);
    let is i64 as uy = cast(i64, rw.y + u.y);
    check("alt up: no underline", is8(ux, uy, theme.palette.window_bg, 1) == 1);
    router.key(&t, &r, keys.ALT_L, keys.MOD_ALT, 1, 0, 30);
    frame(&t, c);
    check("alt held: its letter underlined", is8(ux, uy, theme.palette.fg, 1) == 1);
    check("only its letter", is8(cast(i64, rw.x + u.x + u.w) + 2, uy, theme.palette.window_bg, 1) == 1);
    router.key(&t, &r, keys.ALT_L, 0, 0, 0, 40);
    frame(&t, c);
    check("alt released: gone", is8(ux, uy, theme.palette.window_bg, 1) == 1);

    // Under a letter further in; never under a label with none.
    label.set_text_mnemonic(&t, w, "Save _as", 8);
    router.key(&t, &r, keys.ALT_L, keys.MOD_ALT, 1, 0, 50);
    frame(&t, c);
    rw = layout.rect(&t, w);
    text.underline_at(label.run(&t, w), 5, &u);
    let is text.Deco as first;
    text.underline_at(label.run(&t, w), 0, &first);
    check("under its letter, wherever it is",
          is8(cast(i64, rw.x + u.x + u.w / 2.0), cast(i64, rw.y + u.y), theme.palette.fg, 1) == 1 &&
          is8(cast(i64, rw.x + first.x + first.w / 2.0), cast(i64, rw.y + first.y), theme.palette.window_bg, 1) == 1);
    label.set_text(&t, w, "Save as", 7);
    frame(&t, c);
    check("text set plainly: nothing under it", clean_under(&t, w, u.y) == 1);
    check("made with none: nothing under it", clean_under(&t, plain, u.y) == 1);
    router.key(&t, &r, keys.ALT_L, 0, 0, 0, 60);
    frame_router = cast(*router.Router, 0);
    tree.close(&t);
}

// --- Selectable ---

let is [64]u8 as copied with mut;
let is i64 as copied_n with mut = 0;
let is i32 as copied_to with mut = 0 - 1;

fn on_copy(user as *u8, which as i32, s as *u8, n as i64) as void {
    copied_to = which;
    copied_n = n;
    let is i64 as i with mut = 0;
    while (i < n && i < 64) {
        copied[i] = s[i];
        i = i + 1;
    }
}

fn copied_is(which as i32, s as *u8) as i32 {
    return cast(i32, copied_to == which && same(cast(*u8, &copied), copied_n, s) == 1);
}

fn sel_is(t as *tree.Tree, w as i64, a as i64, b as i64) as i32 {
    let is i64 as sa with mut = 0 - 1;
    let is i64 as sb with mut = 0 - 1;
    label.selection(t, w, &sa, &sb);
    return cast(i32, sa == a && sb == b);
}

// Window x of the caret before byte at of w's one-line text, as drawn.
fn x_at(t as *tree.Tree, w as i64, at as i64) as f64 {
    let is math.rect.Rect as rc = layout.window_rect(t, w);
    let is *text.Run as r = label.run(t, w);
    let is i64 as i with mut = 0;
    while (i < text.glyph_count(r)) {
        if (text.glyph(r, i).cluster == at) { return rc.x + text.glyph(r, i).x; }
        i = i + 1;
    }
    return rc.x + r.width;
}

fn y_mid(t as *tree.Tree, w as i64) as f64 {
    let is math.rect.Rect as rc = layout.window_rect(t, w);
    return rc.y + rc.h / 2.0;
}

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn press(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn selected(c as *draw2d.Canvas) as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    tree.set_clipboard(&t, fn_ptr(on_copy), cast(*u8, 0));
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    let is i64 as w = label.create(&t, col, "Hello brave world", 17);
    let is i64 as other = label.create(&t, col, "Other", 5);
    layout.set_align(&t, w, layout.START, layout.START);
    let is router.Router as r = router.init(router.settings_default());
    frame(&t, c);

    // Not selectable: a press is not its.
    click(&t, &r, x_at(&t, w, 2), y_mid(&t, w), 10);
    check("not selectable: nothing selected, nothing focused", sel_is(&t, w, 0, 0) == 1 &&
          router.focused(&t, &r) == 0);
    check("not selectable: the pointer as it was", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    check("selectable", label.set_selectable(&t, w, 1) == 1 && tree.is_focusable(&t, w) == 1);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("told it is", (q.states & access.SELECTABLE) != 0);
    check("the pointer over it: the text beam", router.pointer_shape(&t, &r) == tree.SHAPE_TEXT);
    frame(&t, c);

    // Dragged across: what it passed over, to the primary selection.
    let is f64 as y = y_mid(&t, w);
    router.pointer_move(&t, &r, x_at(&t, w, 0) + 0.5, y, 100);
    router.pointer_button(&t, &r, 1, 1, x_at(&t, w, 0) + 0.5, y, 100);
    check("pressed: focused, nothing selected yet", router.focused(&t, &r) == w && sel_is(&t, w, 0, 0) == 1);
    router.pointer_move(&t, &r, x_at(&t, w, 5) + 0.3, y, 110);
    check("dragged: selected as it goes", sel_is(&t, w, 0, 5) == 1);
    router.pointer_move(&t, &r, x_at(&t, w, 3) + 0.3, y, 120);
    check("and back", sel_is(&t, w, 0, 3) == 1);
    router.pointer_button(&t, &r, 1, 0, x_at(&t, w, 3) + 0.3, y, 130);
    check("released: copied to the primary selection", copied_is(tree.PRIMARY, "Hel") == 1);
    // Shift and a click: to there from where it began.
    router.key(&t, &r, keys.SHIFT_L, keys.MOD_SHIFT, 1, 0, 200);
    click(&t, &r, x_at(&t, w, 11) + 0.3, y, 210);
    router.key(&t, &r, keys.SHIFT_L, 0, 0, 0, 220);
    check("shift and a click: from where it began", sel_is(&t, w, 0, 11) == 1 &&
          copied_is(tree.PRIMARY, "Hello brave") == 1);
    // A double click: the word; dragged on, by words.
    click(&t, &r, x_at(&t, w, 8), y, 1000);
    router.pointer_button(&t, &r, 1, 1, x_at(&t, w, 8), y, 1100);
    check("a double click: the word", sel_is(&t, w, 6, 11) == 1);
    router.pointer_move(&t, &r, x_at(&t, w, 14), y, 1110);
    check("dragged on: by words", sel_is(&t, w, 6, 17) == 1);
    router.pointer_move(&t, &r, x_at(&t, w, 2), y, 1120);
    check("and back, from the word's end", sel_is(&t, w, 11, 0) == 1);
    router.pointer_button(&t, &r, 1, 0, x_at(&t, w, 2), y, 1130);
    check("copied as the text runs", copied_is(tree.PRIMARY, "Hello brave") == 1);
    // A triple click: the paragraph.
    click(&t, &r, x_at(&t, w, 8), y, 3000);
    click(&t, &r, x_at(&t, w, 8), y, 3100);
    click(&t, &r, x_at(&t, w, 8), y, 3200);
    check("a triple click: the paragraph", sel_is(&t, w, 0, 17) == 1);

    // By keyboard, focused.
    router.focus(&t, &r, w, 1);
    press(&t, &r, keys.HOME, 0, 4000);
    check("home: nothing selected, at the start", sel_is(&t, w, 0, 0) == 1);
    press(&t, &r, keys.RIGHT, keys.MOD_SHIFT, 4010);
    press(&t, &r, keys.RIGHT, keys.MOD_SHIFT, 4020);
    check("shift and right: a letter at a time", sel_is(&t, w, 0, 2) == 1);
    press(&t, &r, keys.RIGHT, keys.MOD_SHIFT | keys.MOD_CONTROL, 4030);
    check("and control: to the word's end", sel_is(&t, w, 0, 5) == 1);
    press(&t, &r, keys.END, keys.MOD_SHIFT, 4040);
    check("shift and end: to the line's end", sel_is(&t, w, 0, 17) == 1);
    press(&t, &r, keys.LEFT, keys.MOD_SHIFT | keys.MOD_CONTROL, 4050);
    check("control, shift and left: back a word", sel_is(&t, w, 0, 12) == 1);
    press(&t, &r, keys.LEFT, 0, 4060);
    check("left alone: nothing selected", sel_is(&t, w, 11, 11) == 1);
    press(&t, &r, keys.A, keys.MOD_CONTROL, 4070);
    check("control and a: all", sel_is(&t, w, 0, 17) == 1);
    copied_to = 0 - 1;
    press(&t, &r, keys.C, keys.MOD_CONTROL, 4080);
    check("control and c: to the clipboard", copied_is(tree.CLIPBOARD, "Hello brave world") == 1);
    press(&t, &r, keys.HOME, 0, 4090);
    copied_to = 0 - 1;
    press(&t, &r, keys.C, keys.MOD_CONTROL, 4100);
    check("nothing selected: nothing copied", copied_to == 0 - 1);
    press(&t, &r, keys.B, 0, 4110);
    check("other keys not its", sel_is(&t, w, 0, 0) == 1);

    // Drawn: the selection's background behind it, its text in the
    // selection's colour, the rest as it was.
    label.select(&t, w, 0, 7);
    frame(&t, c);
    let is math.rect.Rect as rw = layout.rect(&t, w);
    check("selected text: the selection's colours",
          is8(ink_x(&t, w, 0, rw.x), ink_y(&t, w, 0, rw.y), theme.palette.selection_fg, 1) == 1 &&
          is8(ink_x(&t, w, 5, rw.x), ink_y(&t, w, 0, rw.y), theme.palette.selection_bg, 1) == 1);
    check("the rest as it was", is8(ink_x(&t, w, 8, rw.x), ink_y(&t, w, 8, rw.y), theme.palette.fg, 1) == 1);

    // Many lines: up and down keep the x.
    label.set_wrap(&t, w, 1);
    layout.set_min_size(&t, col, 60.0, 0.0);
    layout.set_max_size(&t, col, 60.0, layout.UNBOUNDED);
    layout.set_align(&t, col, layout.START, layout.START);
    layout.set_align(&t, w, layout.FILL, layout.START);
    frame(&t, c);
    check("wrapped", label.run(&t, w).nlines >= 2);
    label.select(&t, w, 1, 1);
    press(&t, &r, keys.DOWN, keys.MOD_SHIFT, 5000);
    let is i64 as sa with mut = 0;
    let is i64 as sb with mut = 0;
    label.selection(&t, w, &sa, &sb);
    check("shift and down: onto the next line", sa == 1 && sb > text.line(label.run(&t, w), 1).start &&
          sb < text.line(label.run(&t, w), 1).end);
    press(&t, &r, keys.DOWN, keys.MOD_SHIFT, 5010);
    press(&t, &r, keys.UP, keys.MOD_SHIFT, 5020);
    let is i64 as back with mut = 0;
    label.selection(&t, w, &sa, &back);
    check("down and up: back where it was", back == sb);

    // New text: nothing selected. Not selectable: nothing either.
    label.set_text(&t, w, "Hi", 2);
    check("new text: nothing selected", sel_is(&t, w, 0, 0) == 1);
    label.select(&t, w, 0, 9);
    check("selected within the text", sel_is(&t, w, 0, 2) == 1);
    label.set_selectable(&t, w, 0);
    check("not selectable again: nothing selected, not focusable", sel_is(&t, w, 0, 0) == 1 &&
          tree.is_focusable(&t, w) == 0);
    check("asked of what is no label", label.set_selectable(&t, col, 1) == 0);
    label.set_selectable(&t, other, 1);
    tree.close(&t);
}

// --- Selectable, further ---

// A container that takes what reaches it: presses, and scrolling.
struct Catcher {
    presses as i64;
    scrolls as i64;
}

fn catcher_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catcher_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

fn catcher_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Catcher as k = cast(*Catcher, data);
    if (e.kind == event.POINTER_DOWN) { k.presses = k.presses + 1; return 1; }
    if (e.kind == event.SCROLL) { k.scrolls = k.scrolls + 1; return 1; }
    return 0;
}

let is tree.Kind as catcher_kind with mut;

// Where the caret before byte at of w goes on screen, a little inside its
// line: x and y in the window.
fn point_at(t as *tree.Tree, w as i64, at as i64, x as *f64, y as *f64) as void {
    let is math.rect.Rect as rc = layout.window_rect(t, w);
    let is *text.Run as r = label.run(t, w);
    let is f64 as ox = rc.x + label.text_left(t, w);
    let is f64 as oy = rc.y + label.text_top(t, w);
    *x = ox + r.width;
    *y = oy + text.glyph(r, text.glyph_count(r) - 1).y - 4.0;
    let is i64 as i with mut = 0;
    while (i < text.glyph_count(r)) {
        let is *text.Glyph as g = text.glyph(r, i);
        if (g.cluster == at) {
            *x = ox + g.x + 0.3;
            *y = oy + g.y - 4.0;
            return;
        }
        i = i + 1;
    }
}

fn press_at(t as *tree.Tree, r as *router.Router, w as i64, at as i64, button as i32, time as i64) as void {
    let is f64 as x with mut = 0.0;
    let is f64 as y with mut = 0.0;
    point_at(t, w, at, &x, &y);
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, button, 1, x, y, time);
}

fn release_at(t as *tree.Tree, r as *router.Router, w as i64, at as i64, button as i32, time as i64) as void {
    let is f64 as x with mut = 0.0;
    let is f64 as y with mut = 0.0;
    point_at(t, w, at, &x, &y);
    router.pointer_button(t, r, button, 0, x, y, time);
}

fn triple_at(t as *tree.Tree, r as *router.Router, w as i64, at as i64, time as i64) as void {
    press_at(t, r, w, at, 1, time);
    release_at(t, r, w, at, 1, time + 1);
    press_at(t, r, w, at, 1, time + 100);
    release_at(t, r, w, at, 1, time + 101);
    press_at(t, r, w, at, 1, time + 200);
    release_at(t, r, w, at, 1, time + 201);
}

let is i64 as shortcut_runs with mut = 0;

fn on_shortcut(user as *u8) as void { shortcut_runs = shortcut_runs + 1; }

fn selected_more(c as *draw2d.Canvas) as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    tree.set_clipboard(&t, fn_ptr(on_copy), cast(*u8, 0));
    let is i64 as root = tree.root(&t);
    let is i64 as k = tree.create(&t, &catcher_kind, root);
    let is *Catcher as kd = cast(*Catcher, tree.data(&t, k));
    let is i64 as col = box.create(&t, k, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as w = label.create(&t, col, "Hello brave world", 17);
    let is i64 as plain = label.create(&t, col, "Plain", 5);
    let is i64 as next = label.create(&t, col, "Next", 4);
    label.set_selectable(&t, w, 1);
    label.set_selectable(&t, next, 1);
    let is router.Router as r = router.init(router.settings_default());
    frame(&t, c);

    // What is not its own passes on: presses on a label that is not
    // selectable, other buttons, scrolling.
    press_at(&t, &r, plain, 2, 1, 10);
    check("not selectable: the press goes on to what holds it", kd.presses == 1 && router.capture(&r) == k);
    release_at(&t, &r, plain, 2, 1, 11);
    let is i64 as sa with mut = 0;
    let is i64 as sb with mut = 0;
    check("not selectable: no selection", label.selection(&t, plain, &sa, &sb) == 0 && sa == 0 && sb == 0);
    press_at(&t, &r, w, 2, 3, 20);
    check("another button: not its", kd.presses == 2 && sel_is(&t, w, 0, 0) == 1);
    release_at(&t, &r, w, 2, 3, 21);
    let is f64 as px with mut = 0.0;
    let is f64 as py with mut = 0.0;
    point_at(&t, w, 3, &px, &py);
    router.scroll(&t, &r, px, py, 0.0, 1.0, 1, 30);
    check("scrolling: not its", kd.scrolls == 1);

    // A double click and nothing more: the word, copied.
    press_at(&t, &r, w, 8, 1, 100);
    release_at(&t, &r, w, 8, 1, 101);
    press_at(&t, &r, w, 8, 1, 150);
    release_at(&t, &r, w, 8, 1, 151);
    check("the word double-clicked, copied", sel_is(&t, w, 6, 11) == 1 && label.selection(&t, w, &sa, &sb) == 1 &&
          copied_is(tree.PRIMARY, "brave") == 1);
    // Dragged out of it: on to the end.
    press_at(&t, &r, w, 0, 1, 1000);
    let is math.rect.Rect as rw = layout.window_rect(&t, w);
    router.pointer_move(&t, &r, rw.x + rw.w + 30.0, rw.y + rw.h / 2.0, 1010);
    check("dragged out past its end: to the end", sel_is(&t, w, 0, 17) == 1);
    router.pointer_button(&t, &r, 1, 0, rw.x + rw.w + 30.0, rw.y + rw.h / 2.0, 1020);
    check("released out of it: copied", copied_is(tree.PRIMARY, "Hello brave world") == 1);

    // Paragraphs, whatever ends them.
    label.set_text(&t, w, "One\nTwo three\rFour\xc2\x85Five\xe2\x80\xa9Six", 30);
    frame(&t, c);
    triple_at(&t, &r, w, 9, 2000);
    check("a paragraph after a line feed, before a return", sel_is(&t, w, 4, 13) == 1);
    triple_at(&t, &r, w, 1, 3000);
    check("the first", sel_is(&t, w, 0, 3) == 1);
    triple_at(&t, &r, w, 15, 4000);
    check("after a return, before a next line", sel_is(&t, w, 14, 18) == 1);
    triple_at(&t, &r, w, 21, 5000);
    check("after a next line, before a paragraph separator", sel_is(&t, w, 20, 24) == 1);
    triple_at(&t, &r, w, 28, 6000);
    check("after a paragraph separator, the last", sel_is(&t, w, 27, 30) == 1);
    triple_at(&t, &r, w, 4, 6500);
    check("pressed on its first letter", sel_is(&t, w, 4, 13) == 1);
    label.set_text(&t, w, "\nab\xc2\x85", 5);
    frame(&t, c);
    triple_at(&t, &r, w, 2, 6600);
    check("a separator first and one last", sel_is(&t, w, 1, 3) == 1);
    label.set_text(&t, w, "ab\xe2\x80\xa9", 5);
    frame(&t, c);
    triple_at(&t, &r, w, 1, 6700);
    check("a paragraph separator last", sel_is(&t, w, 0, 2) == 1);

    // Selected across lines, from inside the first to inside the last.
    label.set_text(&t, w, "Hello brave world", 17);
    label.set_wrap(&t, w, 1);
    layout.set_min_size(&t, col, 60.0, 0.0);
    layout.set_max_size(&t, col, 60.0, layout.UNBOUNDED);
    frame(&t, c);
    check("three lines", label.run(&t, w).nlines == 3);
    label.select(&t, w, 3, 14);
    frame(&t, c);
    let is f64 as ox = layout.window_rect(&t, w).x;
    let is f64 as oy = layout.window_rect(&t, w).y;
    check("the first line's start as it was",
          is8(ink_x(&t, w, 0, ox), ink_y(&t, w, 0, oy), theme.palette.fg, 1) == 1);
    check("the first line from where it begins",
          is8(ink_x(&t, w, 3, ox), ink_y(&t, w, 3, oy), theme.palette.selection_fg, 1) == 1);
    check("the middle line, all of it", is8(ink_x(&t, w, 7, ox), ink_y(&t, w, 7, oy), theme.palette.selection_fg, 1) == 1);
    check("the last line, to where it ends",
          is8(ink_x(&t, w, 12, ox), ink_y(&t, w, 12, oy), theme.palette.selection_fg, 1) == 1 &&
          is8(ink_x(&t, w, 15, ox), ink_y(&t, w, 15, oy), theme.palette.fg, 1) == 1);
    // Behind it, above the letters' ink: the selection's background, line by
    // line, where the selection is.
    let is *text.Run as rn = label.run(&t, w);
    check("behind the first line from where it begins",
          is8(ink_x(&t, w, 3, ox), cast(i64, oy + text.line(rn, 0).top + 2.0), theme.palette.selection_bg, 1) == 1 &&
          is8(ink_x(&t, w, 1, ox), cast(i64, oy + text.line(rn, 0).top + 2.0), theme.palette.window_bg, 1) == 1);
    check("behind the middle line",
          is8(ink_x(&t, w, 8, ox), cast(i64, oy + text.line(rn, 1).top + 2.0), theme.palette.selection_bg, 1) == 1);
    check("behind the last line to where it ends",
          is8(ink_x(&t, w, 12, ox), cast(i64, oy + text.line(rn, 2).top + 2.0), theme.palette.selection_bg, 1) == 1 &&
          is8(ink_x(&t, w, 15, ox), cast(i64, oy + text.line(rn, 2).top + 2.0), theme.palette.window_bg, 1) == 1);

    // Held to the text.
    label.select(&t, w, 0 - 5, 3);
    check("held to the text", sel_is(&t, w, 0, 3) == 1);
    label.select(&t, w, 3, 3);
    check("empty: says so", label.selection(&t, w, &sa, &sb) == 0 && sa == 3);

    // By keyboard across lines: the whole text, a line's ends.
    router.focus(&t, &r, w, 1);
    label.select(&t, w, 8, 8);
    press(&t, &r, keys.END, keys.MOD_CONTROL, 7000);
    check("control and end: the text's end", sel_is(&t, w, 17, 17) == 1);
    label.select(&t, w, 8, 8);
    press(&t, &r, keys.HOME, keys.MOD_CONTROL, 7010);
    check("control and home: the text's start", sel_is(&t, w, 0, 0) == 1);
    label.select(&t, w, 8, 8);
    press(&t, &r, keys.HOME, 0, 7020);
    check("home: the line's start", sel_is(&t, w, 6, 6) == 1);
    press(&t, &r, keys.END, keys.MOD_SHIFT, 7030);
    label.selection(&t, w, &sa, &sb);
    check("shift and end: the line's end", sa == 6 && sb >= 11 && sb <= 12);
    press(&t, &r, 65, keys.MOD_CONTROL, 7040);
    check("control and a capital: all", sel_is(&t, w, 0, 17) == 1);

    // The window's Ctrl+C: the focused label's selection wins it.
    router.add_shortcut(&r, keys.C, keys.MOD_CONTROL, fn_ptr(on_shortcut), cast(*u8, 0));
    copied_to = 0 - 1;
    press(&t, &r, keys.C, keys.MOD_CONTROL, 7100);
    check("a selection: the label copies, not the window", copied_is(tree.CLIPBOARD, "Hello brave world") == 1 &&
          shortcut_runs == 0);
    label.select(&t, w, 2, 2);
    copied_to = 0 - 1;
    press(&t, &r, keys.C, keys.MOD_CONTROL, 7110);
    check("nothing selected: the window's", shortcut_runs == 1 && copied_to == 0 - 1);
    router.add_shortcut(&r, keys.A, keys.MOD_CONTROL, fn_ptr(on_shortcut), cast(*u8, 0));
    press(&t, &r, keys.A, keys.MOD_CONTROL, 7120);
    check("control and a: always the label's", shortcut_runs == 1 && sel_is(&t, w, 0, 17) == 1);
    label.select(&t, w, 2, 2);
    press(&t, &r, 65, keys.MOD_CONTROL, 7130);
    check("a capital: the same", shortcut_runs == 1 && sel_is(&t, w, 0, 17) == 1);
    copied_to = 0 - 1;
    press(&t, &r, 67, keys.MOD_CONTROL, 7140);
    check("a capital c: the label's too", shortcut_runs == 1 && copied_is(tree.CLIPBOARD, "Hello brave world") == 1);

    // Tab is not its: the focus moves on.
    press(&t, &r, keys.TAB, 0, 7200);
    check("tab: on to the next", router.focused(&t, &r) == next);
    tree.close(&t);
}

// Up and down keep the x they began at, across a shorter line.
fn kept_x(c as *draw2d.Canvas) as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as w = label.create(&t, col, "aaaaaaa b aaaaaaa", 17);
    label.set_wrap(&t, w, 1);
    label.set_selectable(&t, w, 1);
    expect("aaaaaaa", 7, 20.0, 400, 0.0 - 1.0, 0, 0);
    layout.set_min_size(&t, col, want.width + 1.0, 0.0);
    layout.set_max_size(&t, col, want.width + 1.0, layout.UNBOUNDED);
    frame(&t, c);
    check("a short line between two long", label.run(&t, w).nlines == 3);
    let is router.Router as r = router.init(router.settings_default());
    router.focus(&t, &r, w, 1);
    label.select(&t, w, 6, 6);
    press(&t, &r, keys.DOWN, 0, 10);
    press(&t, &r, keys.DOWN, 0, 20);
    let is i64 as a with mut = 0;
    let is i64 as b with mut = 0;
    label.selection(&t, w, &a, &b);
    check("down twice: as far across as it began", b == 16);
    press(&t, &r, keys.LEFT, 0, 30);
    press(&t, &r, keys.UP, 0, 40);
    label.selection(&t, w, &a, &b);
    check("a move across forgets it", b == 9 || b == 10);
    tree.close(&t);
}

// Aligned and centred down: pressed where it is drawn.
fn hit_aligned(c as *draw2d.Canvas) as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    let is i64 as w = label.create(&t, tree.root(&t), "Hello brave world\nNext", 22);
    label.set_align(&t, w, model.ALIGN_CENTER);
    label.set_selectable(&t, w, 1);
    frame(&t, c);
    check("drawn in the middle", label.text_left(&t, w) > 10.0 && label.text_top(&t, w) > 10.0 &&
          label.run(&t, w).nlines == 2);
    let is router.Router as r = router.init(router.settings_default());
    press_at(&t, &r, w, 6, 1, 10);
    let is f64 as x with mut = 0.0;
    let is f64 as y with mut = 0.0;
    point_at(&t, w, 11, &x, &y);
    router.pointer_move(&t, &r, x, y, 20);
    router.pointer_button(&t, &r, 1, 0, x, y, 30);
    check("selected where it is drawn", sel_is(&t, w, 6, 11) == 1);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d0 = load("text/testdata/shape-plain.ttf");
    let is i64 as n0 = loaded;
    let is *u8 as d1 = load("text/testdata/glyf.ttf");
    let is i64 as n1 = loaded;
    if (cast(i64, d0) == 0 || cast(i64, d1) == 0) {
        io.printf("FAIL: cannot read the test fonts\n");
        return 1;
    }
    faces[0] = sfnt.open(d0, n0, 0);
    faces[1] = sfnt.open(d1, n1, 0);
    plain_list.faces = &faces[0];
    plain_list.n = 1;
    glyf_list.faces = &faces[1];
    glyf_list.n = 1;
    plain_font = font.of_list(&plain_list);
    glyf_font = font.of_list(&glyf_list);
    mono_asked = cast(*u8, 0);
    frame_router = cast(*router.Router, 0);
    plain_kind = widget.kind("plain", 0);
    catcher_kind = widget.kind("catcher", sizeof(Catcher));
    catcher_kind.measure = fn_ptr(catcher_measure);
    catcher_kind.arrange = fn_ptr(catcher_arrange);
    catcher_kind.event = fn_ptr(catcher_event);

    theme = style.light();
    theme.fonts.family = "Plain";
    theme.fonts.mono = "Mono";
    theme.fonts.body.size = 20.0;
    theme.fonts.body.weight = 400;
    theme.fonts.heading.size = 30.0;
    theme.fonts.heading.weight = 700;
    theme.fonts.mono_body.size = 18.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as dl = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &dl);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);
    want = text.run();

    measured();
    styled();
    told();
    unserviced();
    painted(&c);
    aligned(&c);
    mnemonics(&c);
    selected(&c);
    selected_more(&c);
    kept_x(&c);
    hit_aligned(&c);

    if (fails == 0) {
        io.printf("label: %d checks passed\n", checks);
        return 0;
    }
    io.printf("label: %d of %d checks failed\n", fails, checks);
    return 1;
}
