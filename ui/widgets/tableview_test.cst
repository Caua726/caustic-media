// ui/widgets/tableview_test.cst — a table view: a model's rows in columns
// under a header, columns resized by their header's edge and sorted by a
// click on it, scrolled across with the header following, drawn and told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "label.cst" as label;
use "../event.cst" as event;
use "../scroll.cst" as scroll;
use "../model.cst" as model;
use "listview.cst" as listview;
use "tableview.cst" as tableview;
use "image.cst" as image;
use "../icons.cst" as icons;
use "../sortmodel.cst" as sortmodel;

let is i64 as W with imut = 400;
let is i64 as H with imut = 240;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}



// --- Files: a name, a size, a kind ---
struct Files {
    n   as i64;
    ids as [64]i64;
}

let is Files as files with mut;
let is model.Model as m with mut;

fn length(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn name(id as i64) as *u8 {
    if (id == 1) { return "notes.txt"; }
    if (id == 2) { return "photo.png"; }
    if (id == 3) { return "a.out"; }
    return "zeta";
}

fn kind_of(id as i64) as *u8 {
    if (id == 2) { return "image"; }
    if (id == 3) { return "program"; }
    return "text";
}

fn files_count(self as *u8, parent as i64) as i64 {
    if (parent != 0) { return 0; }
    return files.n;
}

fn files_row_id(self as *u8, parent as i64, index as i64) as i64 {
    if (parent != 0 || index < 0 || index >= files.n) { return 0; }
    return files.ids[index];
}

// Icons, when on: notes.txt's name (one of the toolkit's), photo.png's kind
// (a texture of the program's).
let is i32 as icons_on with mut = 0;

fn files_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    if (role == model.ICON && icons_on == 1) {
        if (id == 1 && column == 0) {
            *out = model.integer(cast(i64, icons.DOCUMENT));
            return 1;
        }
        if (id == 2 && column == 2) {
            *out = model.handle(55);
            return 1;
        }
        return 0;
    }
    if (role != model.TEXT) { return 0; }
    if (column == 0) {
        *out = model.text(name(id), length(name(id)));
        return 1;
    }
    if (column == 1) {
        *out = model.integer(id * 100);
        return 1;
    }
    if (column == 2) {
        *out = model.text(kind_of(id), length(kind_of(id)));
        return 1;
    }
    return 0;
}

fn files_columns(self as *u8) as i64 { return 3; }

fn fill() as void {
    files.n = 4;
    files.ids[0] = 3;
    files.ids[1] = 1;
    files.ids[2] = 4;
    files.ids[3] = 2;
}

// What the header asked to be sorted by.
let is i64 as sorted_col with mut = 0;
let is i32 as sorted_order with mut = 0;
let is i64 as sorts with mut = 0;

fn on_sort(user as *u8, column as i64, order as i32) as void {
    sorted_col = column;
    sorted_order = order;
    sorts = sorts + 1;
}

fn made(t as *tree.Tree) as i64 {
    fill();
    let is i64 as tb = tableview.create(t, tree.root(t), &m);
    tableview.add_column(t, tb, "Name", 4, 120.0);
    tableview.add_column(t, tb, "Size", 4, 80.0);
    tableview.add_column(t, tb, "Kind", 4, 90.0);
    return tb;
}

fn cell_text(t as *tree.Tree, tb as i64, index as i64, col as i64, s as *u8) as i32 {
    let is i64 as rw = listview.row_widget(t, tableview.list(t, tb), index);
    if (rw == 0) { return 0; }
    let is i64 as l = tableview.cell_label(t, rw, col);
    if (l == 0) { return 0; }
    return same(label.text(t, l), label.text_length(t, l), s);
}

fn cell_rect(t as *tree.Tree, tb as i64, index as i64, col as i64) as math.rect.Rect {
    return layout.window_rect(t, tableview.cell_label(t, listview.row_widget(t, tableview.list(t, tb), index), col));
}

fn head_rect(t as *tree.Tree, tb as i64, col as i64) as math.rect.Rect {
    return layout.window_rect(t, tableview.header_cell(t, tb, col));
}

// The model's icons at the start of their cells, the text after them.
fn iconed() as void {
    let is tree.Tree as t = tree_for();
    icons_on = 1;
    let is i64 as tb = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is f64 as px = theme.metrics.control_pad_x;
    let is f64 as gap = theme.metrics.space_m;
    let is i64 as lv = tableview.list(&t, tb);
    // Rows: a.out, notes.txt, zeta, photo.png.
    let is i64 as notes = listview.row_widget(&t, lv, 1);
    let is i64 as ic = tableview.cell_icon(&t, notes, 0);
    let is math.rect.Rect as h0 = head_rect(&t, tb, 0);
    let is math.rect.Rect as ir = layout.window_rect(&t, ic);
    let is math.rect.Rect as lr = cell_rect(&t, tb, 1, 0);
    check("the model's icon at its cell's start", ic != 0 && image.icon(&t, ic) == icons.DOCUMENT && tree.is_hidden_here(&t, ic) == 0 &&
          near(ir.x, h0.x + px) == 1 && near(ir.w, listview.ICON_SIZE) == 1 && near(ir.y + ir.h / 2.0, lr.y + lr.h / 2.0) == 1);
    check("its text after it, to its column's end", cell_text(&t, tb, 1, 0, "notes.txt") == 1 && near(lr.x, ir.x + ir.w + gap) == 1 &&
          near(lr.x + lr.w, h0.x + h0.w - px) == 1);
    let is i64 as aout = listview.row_widget(&t, lv, 0);
    check("none: none shown, the text at its column's start", tree.is_hidden_here(&t, tableview.cell_icon(&t, aout, 0)) == 1 &&
          near(cell_rect(&t, tb, 0, 0).x, h0.x + px) == 1);
    let is i64 as kind = tableview.cell_icon(&t, listview.row_widget(&t, lv, 3), 2);
    check("in another column, a texture of the program's", image.texture(&t, kind) == 55 && tree.is_hidden_here(&t, kind) == 0 &&
          near(layout.window_rect(&t, kind).x, head_rect(&t, tb, 2).x + px) == 1);
    check("no icon past the last column", tableview.cell_icon(&t, notes, 3) == 0 && tableview.cell_icon(&t, notes, 0 - 1) == 0 &&
          tableview.cell_label(&t, notes, 3) == 0);
    // Right to left: at the cell's right, the text before it.
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as q0 = head_rect(&t, tb, 0);
    let is math.rect.Rect as qi = layout.window_rect(&t, tableview.cell_icon(&t, listview.row_widget(&t, lv, 1), 0));
    let is math.rect.Rect as ql = cell_rect(&t, tb, 1, 0);
    check("right to left: the icon at its cell's right, the text before it", near(qi.x + qi.w, q0.x + q0.w - px) == 1 &&
          near(ql.x + ql.w, qi.x - gap) == 1 && near(ql.x, q0.x + px) == 1);
    icons_on = 0;
    tree.close(&t);
}

// A column other than the last taking the room the columns leave.
fn stretched() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as tb = made(&t);
    check("the last stretches at first", tableview.stretch(&t, tb) == 2);
    tableview.set_stretch(&t, tb, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is f64 as px = theme.metrics.control_pad_x;
    let is math.rect.Rect as tr = layout.window_rect(&t, tb);
    let is math.rect.Rect as h0 = head_rect(&t, tb, 0);
    let is math.rect.Rect as h1 = head_rect(&t, tb, 1);
    let is math.rect.Rect as h2 = head_rect(&t, tb, 2);
    let is f64 as extra = tr.w - 2.0 * px - 290.0;
    check("the first takes what is left, the rest as wide as said", tableview.stretch(&t, tb) == 0 && near(h0.w, 120.0 + extra) == 1 &&
          near(h1.x, h0.x + h0.w) == 1 && near(h1.w, 80.0) == 1 && near(h2.w, 90.0) == 1 && near(h2.x + h2.w, tr.x + tr.w - px) == 1);
    check("its cells with it", near(cell_rect(&t, tb, 0, 0).w, h0.w - 2.0 * px) == 1 && near(cell_rect(&t, tb, 0, 1).x, h1.x + px) == 1 &&
          near(cell_rect(&t, tb, 0, 2).x, h2.x + px) == 1);
    check("its width as said still", near(tableview.column_width(&t, tb, 0), 120.0) == 1);
    // Right to left: mirrored.
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as r0 = head_rect(&t, tb, 0);
    let is math.rect.Rect as r2 = head_rect(&t, tb, 2);
    check("right to left: the first at the right, stretched", near(r0.x + r0.w, tr.x + tr.w - px) == 1 && near(r0.w, 120.0 + extra) == 1 &&
          near(r2.x, tr.x + px) == 1 && near(cell_rect(&t, tb, 0, 1).x, head_rect(&t, tb, 1).x + px) == 1);
    layout.set_direction(&t, tb, layout.LTR);
    // No such column: the last again.
    tableview.set_stretch(&t, tb, 7);
    check("no such column: the last", tableview.stretch(&t, tb) == 2);
    tree.close(&t);
}

fn drag(t as *tree.Tree, r as *router.Router, x0 as f64, y as f64, x1 as f64, time as i64) as void {
    router.pointer_move(t, r, x0, y, time);
    router.pointer_button(t, r, 1, 1, x0, y, time);
    router.pointer_move(t, r, (x0 + x1) / 2.0, y, time + 10);
    router.pointer_move(t, r, x1, y, time + 20);
    router.pointer_button(t, r, 1, 0, x1, y, time + 30);
}

fn columns() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as tb = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is f64 as px = theme.metrics.control_pad_x;
    check("three columns, as wide as said", tableview.column_count(&t, tb) == 3 && near(tableview.column_width(&t, tb, 0), 120.0) == 1 &&
          near(tableview.column_width(&t, tb, 2), 90.0) == 1);
    check("each row's cells from the model", cell_text(&t, tb, 0, 0, "a.out") == 1 && cell_text(&t, tb, 0, 1, "300") == 1 &&
          cell_text(&t, tb, 1, 2, "text") == 1 && cell_text(&t, tb, 3, 0, "photo.png") == 1);
    let is math.rect.Rect as h0 = head_rect(&t, tb, 0);
    let is math.rect.Rect as h1 = head_rect(&t, tb, 1);
    let is math.rect.Rect as h2 = head_rect(&t, tb, 2);
    let is math.rect.Rect as tr = layout.window_rect(&t, tb);
    check("the header on top, its cells side by side", near(h0.y, tr.y) == 1 && near(h1.x, h0.x + h0.w) == 1 && near(h0.w, 120.0) == 1 &&
          near(h2.x, h1.x + h1.w) == 1 && near(h0.x, tr.x + px) == 1);
    check("the last column to the view's end", near(h2.x + h2.w, tr.x + tr.w - px) == 1 && h2.w > 90.0);
    let is math.rect.Rect as c0 = cell_rect(&t, tb, 0, 0);
    let is math.rect.Rect as c1 = cell_rect(&t, tb, 0, 1);
    let is math.rect.Rect as c2 = cell_rect(&t, tb, 0, 2);
    check("the rows under it, each cell under its column, padded", c0.y >= h0.y + h0.h - 0.01 && near(c0.x, h0.x + px) == 1 &&
          near(c1.x, h1.x + px) == 1 && near(c2.x, h2.x + px) == 1 && near(c0.w, 120.0 - 2.0 * px) == 1);
    let is math.rect.Rect as l0 = layout.window_rect(&t, tableview.header_label(&t, tb, 0));
    check("its titles in the header", same(label.text(&t, tableview.header_label(&t, tb, 0)), 4, "Name") == 1 && near(l0.x, h0.x + px) == 1 &&
          near(l0.y + l0.h / 2.0, h0.y + h0.h / 2.0) == 1);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(&t, tb, &free, &s);
    check("as wide as its columns would like", near(s.pref_w, 2.0 * px + 290.0) == 1);
    // Set by the program.
    tableview.set_column_width(&t, tb, 1, 60.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("a column narrowed: the rest closer", near(head_rect(&t, tb, 2).x, h1.x + 60.0) == 1 &&
          near(cell_rect(&t, tb, 0, 2).x, h1.x + 60.0 + px) == 1);
    tableview.set_column_width(&t, tb, 1, 1.0);
    check("never narrower than its least", near(tableview.column_width(&t, tb, 1), tableview.MIN_WIDTH) == 1);
    let is math.rect.Rect as rr0 = layout.window_rect(&t, listview.row_widget(&t, tableview.list(&t, tb), 0));
    check("a cell across its row's middle", near(c0.y + c0.h / 2.0, rr0.y + rr0.h / 2.0) == 1);
    let is geom.Size as hs;
    layout.measure(&t, tableview.header_cell(&t, tb, 0), &free, &hs);
    let is geom.Size as tl;
    layout.measure(&t, tableview.header_label(&t, tb, 0), &free, &tl);
    let is geom.Size as ls;
    layout.measure(&t, tableview.list(&t, tb), &free, &ls);
    check("the header as tall as a title, padded", near(h0.h, tl.pref_h + 2.0 * theme.metrics.space_xs) == 1 &&
          near(hs.pref_h, h0.h) == 1);
    check("as tall as its header and rows", near(s.pref_h, h0.h + ls.pref_h) == 1 && near(s.min_h, h0.h + ls.min_h) == 1);
    let is math.rect.Rect as lr = layout.window_rect(&t, tableview.list(&t, tb));
    check("its rows to its foot", near(lr.y + lr.h, tr.y + tr.h) == 1 && near(lr.y, h0.y + h0.h) == 1);
    check("a title as wide as its column, padded", near(l0.w, 120.0 - 2.0 * px) == 1);
    check("no cell past the last column", tableview.cell_label(&t, listview.row_widget(&t, tableview.list(&t, tb), 0), 3) == 0);
    check("not a table view, or no such column: nothing", tableview.column_count(&t, tree.root(&t)) == 0 &&
          tableview.sort_column(&t, tree.root(&t)) == 0 - 1 && tableview.sort_order(&t, tree.root(&t)) == sortmodel.NONE &&
          tableview.column_width(&t, tb, 7) == 0.0 && tableview.header_cell(&t, tb, 3) == 0 && tableview.list(&t, tree.root(&t)) == 0 &&
          tableview.add_column(&t, tree.root(&t), "x", 1, 10.0) == 0 - 1);
    // Thirty-two columns at most.
    let is i64 as k with mut = tableview.column_count(&t, tb);
    while (k < tableview.MAX_COLUMNS) {
        tableview.add_column(&t, tb, "c", 1, 30.0);
        k = k + 1;
    }
    check("thirty-two columns, no more", tableview.column_count(&t, tb) == tableview.MAX_COLUMNS &&
          tableview.add_column(&t, tb, "d", 1, 30.0) == 0 - 1 && tableview.column_count(&t, tb) == tableview.MAX_COLUMNS);
    tree.close(&t);
}

fn resized() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as tb = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as h0 = head_rect(&t, tb, 0);
    let is f64 as edge = h0.x + h0.w;
    let is f64 as y = h0.y + h0.h / 2.0;
    router.pointer_move(&t, &r, edge - 1.0, y, 10);
    check("over a column's edge: the pointer to resize", router.pointer_shape(&t, &r) == tree.SHAPE_COL_RESIZE);
    router.pointer_move(&t, &r, h0.x + 20.0, y, 20);
    check("elsewhere: not", router.pointer_shape(&t, &r) != tree.SHAPE_COL_RESIZE);
    sorts = 0;
    drag(&t, &r, edge - 1.0, y, edge + 29.0, 100);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("its edge dragged: as much wider, nothing sorted", near(tableview.column_width(&t, tb, 0), 150.0) == 1 && sorts == 0 &&
          near(cell_rect(&t, tb, 0, 1).x, edge + 30.0 + theme.metrics.control_pad_x) == 1);
    drag(&t, &r, edge + 29.0, y, h0.x - 200.0, 1000);
    check("dragged far back: its least", near(tableview.column_width(&t, tb, 0), tableview.MIN_WIDTH) == 1);
    tableview.set_resizable(&t, tb, 0, 0);
    let is math.rect.Rect as h0b = head_rect(&t, tb, 0);
    drag(&t, &r, h0b.x + h0b.w - 1.0, y, h0b.x + h0b.w + 50.0, 2000);
    check("one that may not be resized: not", near(tableview.column_width(&t, tb, 0), tableview.MIN_WIDTH) == 1);
    router.pointer_move(&t, &r, h0b.x + h0b.w - 1.0, y, 2100);
    check("nor its edge offered", router.pointer_shape(&t, &r) != tree.SHAPE_COL_RESIZE);
    // Right to left: the edge at the left, dragged left to widen.
    tableview.set_resizable(&t, tb, 0, 1);
    tableview.set_column_width(&t, tb, 0, 120.0);
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as r0 = head_rect(&t, tb, 0);
    let is math.rect.Rect as tr = layout.window_rect(&t, tb);
    check("right to left: the first column at the right", near(r0.x + r0.w, tr.x + tr.w - theme.metrics.control_pad_x) == 1 &&
          head_rect(&t, tb, 1).x + head_rect(&t, tb, 1).w <= r0.x + 0.01);
    drag(&t, &r, r0.x + 1.0, y, r0.x - 19.0, 3000);
    check("its edge dragged left: wider", near(tableview.column_width(&t, tb, 0), 140.0) == 1);
    tree.close(&t);
}

fn sorted() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as tb = made(&t);
    tableview.set_sort_hook(&t, tb, fn_ptr(on_sort), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as h1 = head_rect(&t, tb, 1);
    sorts = 0;
    click(&t, &r, h1.x + 20.0, h1.y + h1.h / 2.0, 10);
    check("not sortable: a click sorts nothing", sorts == 0 && tableview.sort_order(&t, tb) == sortmodel.NONE &&
          tableview.sort_column(&t, tb) == 0 - 1);
    tableview.set_sortable(&t, tb, 1, 1);
    click(&t, &r, h1.x + 20.0, h1.y + h1.h / 2.0, 1000);
    check("sortable: up", sorts == 1 && sorted_col == 1 && sorted_order == sortmodel.ASCENDING &&
          tableview.sort_column(&t, tb) == 1 && tableview.sort_order(&t, tb) == sortmodel.ASCENDING);
    click(&t, &r, h1.x + 20.0, h1.y + h1.h / 2.0, 2000);
    check("again: down", sorts == 2 && sorted_order == sortmodel.DESCENDING);
    click(&t, &r, h1.x + 20.0, h1.y + h1.h / 2.0, 3000);
    check("again: up", sorted_order == sortmodel.ASCENDING);
    tableview.set_sortable(&t, tb, 0, 1);
    let is math.rect.Rect as h0 = head_rect(&t, tb, 0);
    click(&t, &r, h0.x + 20.0, h0.y + h0.h / 2.0, 4000);
    check("another column: up by it", sorted_col == 0 && sorted_order == sortmodel.ASCENDING);
    router.pointer_move(&t, &r, h0.x + 20.0, h0.y + h0.h / 2.0, 5000);
    router.pointer_button(&t, &r, 1, 1, h0.x + 20.0, h0.y + h0.h / 2.0, 5000);
    router.pointer_move(&t, &r, h0.x + 20.0, h0.y + 300.0, 5010);
    router.pointer_button(&t, &r, 1, 0, h0.x + 20.0, h0.y + 300.0, 5020);
    check("pressed, let go off it: nothing", sorted_order == sortmodel.ASCENDING && sorts == 4);
    tableview.set_sort(&t, tb, 2, sortmodel.DESCENDING);
    check("set by the program: shown, asked", tableview.sort_column(&t, tb) == 2 && sorted_col == 2 &&
          sorted_order == sortmodel.DESCENDING && sorts == 5);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is f64 as px = theme.metrics.control_pad_x;
    let is f64 as k = theme.metrics.indicator * 0.75;
    let is math.rect.Rect as t2 = layout.window_rect(&t, tableview.header_label(&t, tb, 2));
    let is math.rect.Rect as hc2 = head_rect(&t, tb, 2);
    let is math.rect.Rect as t0 = layout.window_rect(&t, tableview.header_label(&t, tb, 0));
    check("the sorted column's title leaves its arrow room, the others not", near(t2.w, hc2.w - 2.0 * px - k - theme.metrics.space_xs) == 1 &&
          near(t0.w, h0.w - 2.0 * px) == 1);
    let is math.rect.Rect as a2 = tableview.arrow_rect(&t, tb, 2);
    check("its arrow at its end, across its middle", near(a2.x + a2.w, hc2.x + hc2.w - px) == 1 &&
          near(a2.y + a2.h / 2.0, hc2.y + hc2.h / 2.0) == 1);
    tableview.set_sort(&t, tb, 1, sortmodel.ASCENDING);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as t1 = layout.window_rect(&t, tableview.header_label(&t, tb, 1));
    let is math.rect.Rect as t2b = layout.window_rect(&t, tableview.header_label(&t, tb, 2));
    check("sorted by another: its title makes room, the last one's back", near(t1.w, head_rect(&t, tb, 1).w - 2.0 * px - k - theme.metrics.space_xs) == 1 &&
          near(t2b.w, hc2.w - 2.0 * px) == 1);
    tableview.set_sort(&t, tb, 2, sortmodel.DESCENDING);
    layout.run(&t, cast(f64, W), cast(f64, H));
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as rh2 = head_rect(&t, tb, 2);
    let is math.rect.Rect as rt2 = layout.window_rect(&t, tableview.header_label(&t, tb, 2));
    let is math.rect.Rect as ra2 = tableview.arrow_rect(&t, tb, 2);
    check("right to left: the title from the right, the arrow at the left", near(rt2.x + rt2.w, rh2.x + rh2.w - px) == 1 &&
          near(ra2.x, rh2.x + px) == 1);
    layout.set_direction(&t, tb, layout.LTR);
    tableview.set_sort(&t, tb, 3, sortmodel.ASCENDING);
    check("sorted by no such column: no arrow", tableview.arrow_rect(&t, tb, 3).w == 0.0);
    tree.close(&t);
    // With a sort model: the rows in the order clicked.
    let is tree.Tree as t2 = tree_for();
    let is router.Router as r2 = router.init(router.settings_default());
    tree.set_router(&t2, cast(*u8, &r2));
    fill();
    let is *sortmodel.Sort as sm = sortmodel.open(&m);
    let is i64 as tb2 = tableview.create(&t2, tree.root(&t2), sortmodel.model_of(sm));
    tableview.add_column(&t2, tb2, "Name", 4, 120.0);
    tableview.add_column(&t2, tb2, "Size", 4, 80.0);
    tableview.set_sortable(&t2, tb2, 0, 1);
    tableview.set_sort_hook(&t2, tb2, fn_ptr(sortmodel.hook), cast(*u8, sm));
    layout.run(&t2, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as n0 = head_rect(&t2, tb2, 0);
    click(&t2, &r2, n0.x + 20.0, n0.y + n0.h / 2.0, 10);
    layout.run(&t2, cast(f64, W), cast(f64, H));
    check("sorted by name, up", cell_text(&t2, tb2, 0, 0, "a.out") == 1 && cell_text(&t2, tb2, 1, 0, "notes.txt") == 1 &&
          cell_text(&t2, tb2, 3, 0, "zeta") == 1);
    click(&t2, &r2, n0.x + 20.0, n0.y + n0.h / 2.0, 1000);
    layout.run(&t2, cast(f64, W), cast(f64, H));
    check("and down", cell_text(&t2, tb2, 0, 0, "zeta") == 1 && cell_text(&t2, tb2, 3, 0, "a.out") == 1);
    tree.close(&t2);
    sortmodel.close(sm);
}

// What the header passes on.
let is i64 as caught with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase == event.BUBBLE && e.kind == event.POINTER_DOWN) {
        caught = caught + 1;
        return 1;
    }
    return 0;
}

fn catch_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catch_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as catcher with mut;

fn passed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t, &catcher, tree.root(&t));
    fill();
    let is i64 as tb = tableview.create(&t, holder, &m);
    tableview.add_column(&t, tb, "Name", 4, 120.0);
    tableview.add_column(&t, tb, "Size", 4, 80.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as h0 = head_rect(&t, tb, 0);
    caught = 0;
    click(&t, &r, h0.x + 20.0, h0.y + h0.h / 2.0, 10);
    check("a header pressed: its own", caught == 0);
    router.pointer_move(&t, &r, h0.x + 20.0, h0.y + h0.h / 2.0, 100);
    router.pointer_button(&t, &r, 3, 1, h0.x + 20.0, h0.y + h0.h / 2.0, 100);
    router.pointer_button(&t, &r, 3, 0, h0.x + 20.0, h0.y + h0.h / 2.0, 101);
    check("the right button on it: on up", caught == 1);
    tree.close(&t);
}

fn across() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as tb = made(&t);
    tableview.set_column_width(&t, tb, 0, 300.0);
    tableview.set_column_width(&t, tb, 1, 200.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as area = listview.area(&t, tableview.list(&t, tb));
    let is math.rect.Rect as h1 = head_rect(&t, tb, 1);
    let is math.rect.Rect as c1 = cell_rect(&t, tb, 0, 1);
    check("wider than the view: scrolls across", scroll.bar_shown(&t, area, scroll.X) == 1);
    scroll.set_offset(&t, area, 50.0, 0.0);
    check("scrolled across: the header with the rows", near(head_rect(&t, tb, 1).x, h1.x - 50.0) == 1 &&
          near(cell_rect(&t, tb, 0, 1).x, c1.x - 50.0) == 1);
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as rh1 = head_rect(&t, tb, 1);
    let is math.rect.Rect as rc1 = cell_rect(&t, tb, 0, 1);
    check("right to left: the header over the rows", near(rh1.x + theme.metrics.control_pad_x, rc1.x) == 1);
    scroll.set_offset(&t, area, 30.0, 0.0);
    check("and scrolled with them", near(head_rect(&t, tb, 1).x + theme.metrics.control_pad_x, cell_rect(&t, tb, 0, 1).x) == 1);
    tree.close(&t);
}

fn dark_on(y as i64, x0 as i64, x1 as i64) as i64 {
    let is i64 as k with mut = 0;
    let is i64 as x with mut = x0;
    while (x <= x1) {
        if (ch(x, y, 0) < 150) { k = k + 1; }
        x = x + 1;
    }
    return k;
}

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is i64 as tb = made(&t);
    tableview.set_sortable(&t, tb, 0, 1);
    tableview.set_sort(&t, tb, 0, sortmodel.ASCENDING);
    frame(&t, c);
    let is math.rect.Rect as h0 = head_rect(&t, tb, 0);
    let is math.rect.Rect as h1 = head_rect(&t, tb, 1);
    check("a line under the header", is8(cast(i64, h1.x + 30.0), cast(i64, h1.y + h1.h - 1.0), theme.palette.separator, 2) == 1);
    check("a line between its cells", is8(cast(i64, h0.x + h0.w - 1.0), cast(i64, h0.y + h0.h / 2.0), theme.palette.separator, 2) == 1);
    let is math.rect.Rect as ar = tableview.arrow_rect(&t, tb, 0);
    let is i64 as ax = cast(i64, ar.x + ar.w / 2.0);
    let is i64 as ay = cast(i64, ar.y + ar.h / 2.0);
    check("the sorted column's arrow", ar.w > 0.0 && ar.x + ar.w <= h0.x + h0.w && is8(ax, ay, theme.palette.fg, 90) == 1);
    let is i64 as up_foot = dark_on(ay + 1, ax - 7, ax + 7);
    let is i64 as up_head = dark_on(ay - 1, ax - 7, ax + 7);
    check("up: wide at its foot", up_foot > up_head + 1);
    tableview.set_sort(&t, tb, 0, sortmodel.DESCENDING);
    frame(&t, c);
    let is i64 as down_foot = dark_on(ay + 1, ax - 7, ax + 7);
    let is i64 as down_head = dark_on(ay - 1, ax - 7, ax + 7);
    check("down: wide at its top", down_head > down_foot + 1 && is8(ax, ay, theme.palette.fg, 90) == 1);
    check("no arrow on another", tableview.arrow_rect(&t, tb, 1).w == 0.0);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as tb = made(&t);
    tableview.set_sort_hook(&t, tb, fn_ptr(on_sort), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is tree.Access as q;
    access.describe(&t, &r, tableview.list(&t, tb), &q);
    check("told: a table", q.role == access.ROLE_TABLE);
    check("of its columns, headed by its header's cells", q.columns == 3 && q.rows == listview.count(&t, tableview.list(&t, tb)) &&
          q.rows > 0 && q.headers == tree.parent(&t, tableview.header_cell(&t, tb, 0)));
    access.describe(&t, &r, listview.row_widget(&t, tableview.list(&t, tb), 1), &q);
    check("its rows table rows, named by their first cell", q.role == access.ROLE_TABLE_ROW && (q.states & access.SELECTABLE) != 0 &&
          q.row == 1);
    access.describe(&t, &r, listview.row_widget(&t, tableview.list(&t, tb), 0), &q);
    check("the first named by its first cell", same(q.name, q.name_len, "a.out") == 1);
    access.describe(&t, &r, tableview.header_cell(&t, tb, 0), &q);
    check("its header's cells column headers, named", q.role == access.ROLE_COLUMN_HEADER && same(q.name, q.name_len, "Name") == 1 &&
          (q.actions & access.PRESS) == 0);
    tableview.set_sortable(&t, tb, 0, 1);
    access.describe(&t, &r, tableview.header_cell(&t, tb, 0), &q);
    check("sortable: pressed to sort", (q.actions & access.PRESS) != 0);
    sorts = 0;
    check("sorted by assistive technology", access.act(&t, tableview.header_cell(&t, tb, 0), access.PRESS, 0.0) == 1 && sorts == 1);
    tree.close(&t);
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;
    m = model.make(cast(*u8, 0), fn_ptr(files_count), fn_ptr(files_row_id), fn_ptr(files_cell));
    m.columns = fn_ptr(files_columns);

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    columns();
    iconed();
    stretched();
    resized();
    sorted();
    passed();
    across();
    drawn(&c);
    told();

    if (fails == 0) {
        io.printf("tableview: %d checks passed\n", checks);
        return 0;
    }
    io.printf("tableview: %d of %d checks failed\n", fails, checks);
    return 1;
}
