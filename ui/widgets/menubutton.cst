// ui/widgets/menubutton.cst — a button that opens a menu, or a popover.
//
// A control titled with a mnemonic, an arrow pointing down at its end, that
// opens what the program gives it: a menu (menu.cst) under it, flush with
// its start — its end, right to left — or a popover (a popup with an arrow,
// popup.cst) under it, centred, the focus on the first of what it holds. A
// press opens it, as do Space, Enter, Down and its mnemonic, a menu opened by
// the keys with its first item chosen; a press on it while open closes what
// is open, spent on that. Drawn pressed while open. Told as a button that
// expands, named by its title, expanded while open.
use "../../math/math.cst" as math;
use "../../input/keys.cst" as keys;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../../window/positioner.cst" as positioner;
use "../popup.cst" as popup;
use "label.cst" as label;
use "menu.cst" as menu;

struct Data {
    title as i64;
    menu  as i64;   // what it opens: a menu,
    pop   as i64;   // or a popover
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("menu button", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.paint = fn_ptr(_paint);
    _kind.event = fn_ptr(_event);
    _kind.role = access.ROLE_BUTTON;
    _kind.access = fn_ptr(_access);
    _ready = 1;
}

// A new menu button titled s — n bytes, an underscore before its mnemonic —
// as the last child of parent, opening nothing yet. Its handle, or 0.
fn create(t as *tree.Tree, parent as i64, s as *u8, n as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.title = label.create(t, w, "", 0);
    if (d.title == 0) {
        tree.destroy(t, w);
        return 0;
    }
    label.set_text_mnemonic(t, d.title, s, n);
    label.set_target(t, d.title, w);
    label.set_lines(t, d.title, 1, 1);
    tree.set_labelled_by(t, w, d.title);
    tree.set_focusable(t, w, 1);
    return w;
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

fn label_of(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.title;
}

// What it opens from now on: menu m, instead of a popover.
fn set_menu(t as *tree.Tree, w as i64, m as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.menu = m;
    d.pop = 0;
}

// Popover p, instead of a menu.
fn set_popover(t as *tree.Tree, w as i64, p as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.pop = p;
    d.menu = 0;
}

fn menu_of(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.menu;
}

fn popover_of(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.pop;
}

fn is_open(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    if (d.menu != 0) { return menu.is_open(t, d.menu); }
    if (d.pop != 0) { return popup.is_open(t, d.pop); }
    return 0;
}

// Its mnemonic, from now on, opens it.
fn bind_mnemonic(t as *tree.Tree, r as *router.Router, w as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    label.bind_mnemonic(t, r, d.title);
}

fn _rtl(t as *tree.Tree, w as i64) as i32 { return cast(i32, layout.direction(t, w) == layout.RTL); }

// What it opens, opened; a menu with its first item chosen when by_keys.
fn _open(t as *tree.Tree, w as i64, d as *Data, by_keys as i32) as void {
    let is *router.Router as r = cast(*router.Router, tree.router(t));
    if (cast(i64, r) == 0) { return; }
    let is math.rect.Rect as wr = layout.window_rect(t, w);
    if (d.menu != 0) {
        let is i32 as anchor with mut = positioner.BOTTOM_LEFT;
        let is i32 as gravity with mut = positioner.BOTTOM_RIGHT;
        if (_rtl(t, w) == 1) {
            anchor = positioner.BOTTOM_RIGHT;
            gravity = positioner.BOTTOM_LEFT;
        }
        menu.popup_at(t, r, d.menu, wr, anchor, gravity, by_keys);
    } else if (d.pop != 0) {
        popup.open_at(t, r, d.pop, wr, positioner.BOTTOM, positioner.BOTTOM, popup.FOCUS_FIRST);
    } else {
        return;
    }
    widget.changed(t, w, widget.CHANGED_PAINT);
}

// What it opens, opened as by the keys.
fn open(t as *tree.Tree, w as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    _open(t, w, d, 1);
}

fn _close(t as *tree.Tree, d as *Data) as void {
    if (d.menu != 0) { menu.close(t, d.menu); }
    if (d.pop != 0) { popup.close(t, d.pop); }
}

fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Data as d = cast(*Data, data);
    if (e.kind == event.POINTER_DOWN && e.button == 1) {
        _open(t, w, d, 0);
        return 1;
    }
    if (e.kind == event.ACTIVATE) {
        _open(t, w, d, 1);
        return 1;
    }
    if (e.kind == event.KEY_DOWN && e.mods == 0 && (e.key == keys.SPACE || e.key == keys.RETURN || e.key == keys.DOWN)) {
        _open(t, w, d, 1);
        return 1;
    }
    return 0;
}

// --- Measured, arranged, drawn ---

fn _arrow(th as *style.Theme) as f64 { return th.metrics.indicator; }

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    layout.measure(t, d.title, &free, &ls);
    geom.size_zero(out);
    out.pref_w = 2.0 * th.metrics.control_pad_x + ls.pref_w + th.metrics.space_s + _arrow(&th);
    out.min_w = out.pref_w;
    out.pref_h = th.metrics.control_height;
    if (ls.pref_h > out.pref_h) { out.pref_h = ls.pref_h; }
    out.min_h = out.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = out.pref_h;
}

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as px = th.metrics.control_pad_x;
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ls;
    layout.measure(t, d.title, &free, &ls);
    let is f64 as room with mut = r.w - 2.0 * px - th.metrics.space_s - _arrow(&th);
    if (room < 0.0) { room = 0.0; }
    let is math.rect.Rect as at with mut = math.rect.rect(px, (r.h - ls.pref_h) / 2.0, room, ls.pref_h);
    if (_rtl(t, w) == 1) { at.x = r.w - px - room; }
    layout.place(t, d.title, &at);
}

// Its arrow's place, in the window.
fn arrow_rect(t as *tree.Tree, w as i64) as math.rect.Rect {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return math.rect.rect_zero(); }
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is math.rect.Rect as wr = layout.window_rect(t, w);
    let is f64 as k = _arrow(&th);
    let is f64 as x with mut = wr.x + wr.w - th.metrics.control_pad_x - k;
    if (_rtl(t, w) == 1) { x = wr.x + th.metrics.control_pad_x; }
    return math.rect.rect(x, wr.y + (wr.h - k) / 2.0, k, k);
}

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *style.Theme as th = p.theme;
    let is math.rect.Rect as rc = p.rect;
    let is i64 as state with mut = p.state;
    if (is_open(t, w) == 1) { state = state | painter.S_PRESSED; }
    let is style.Look as look = style.pick(&th.control, state, 0);
    let is f64 as rad = th.metrics.radius_m;
    shapes.fill_rounded(p.canvas, rc.x, rc.y, rc.w, rc.h, rad, rad, rad, rad, look.bg);
    if (look.border.a > 0.0) {
        shapes.stroke_rounded(p.canvas, rc.x, rc.y, rc.w, rc.h, rad, rad, rad, rad, th.metrics.border_width, look.border);
    }
    p.fg = look.fg;
    let is math.rect.Rect as ar = arrow_rect(t, w);
    let is f64 as cx = ar.x + ar.w / 2.0;
    let is f64 as cy = ar.y + ar.h / 2.0;
    let is f64 as a = ar.w * 0.3;
    let is [3]f64 as xs;
    let is [3]f64 as ys;
    xs[0] = cx - a; ys[0] = cy - a * 0.5;
    xs[1] = cx + a; ys[1] = cy - a * 0.5;
    xs[2] = cx;     ys[2] = cy + a * 0.5;
    shapes.fill_convex(p.canvas, cast(*f64, &xs), cast(*f64, &ys), 3, look.fg);
}

// --- Told ---

fn _access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Data as d = cast(*Data, data);
    if (q.action == access.ASK) {
        q.states = q.states | access.EXPANDABLE;
        if (is_open(t, w) == 1) {
            q.states = q.states | access.EXPANDED;
            q.actions = access.COLLAPSE;
        } else {
            q.actions = access.PRESS | access.EXPAND;
        }
        return 1;
    }
    if (q.action == access.PRESS || q.action == access.EXPAND) { _open(t, w, d, 1); }
    if (q.action == access.COLLAPSE) { _close(t, d); }
    return 1;
}
