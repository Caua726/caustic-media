// ui/widgets/dialog_test.cst — dialogs drawn inside the window: modal over a
// dimmed window or not, their buttons in the platform's order answering
// Enter and Escape; message boxes; drawn and told. And in a window of their
// own, where the application can open one.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../render/shapes2d.cst" as shapes;
use "../../input/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "../app.cst" as app;
use "../winstate.cst" as winstate;
use "label.cst" as label;
use "../event.cst" as event;
use "../scroll.cst" as scroll;
use "../model.cst" as model;
use "../strings.cst" as strings;
use "dialog.cst" as dialog;
use "../icons.cst" as icons;
use "button.cst" as button;
use "entry.cst" as entry;

let is i64 as W with imut = 400;
let is i64 as H with imut = 240;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}



fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn within1(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d <= 1.0 && d >= 0.0 - 1.0);
}

fn mx(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).x + layout.window_rect(t, w).w / 2.0; }
fn my(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).y + layout.window_rect(t, w).h / 2.0; }

let is i64 as answered with mut = 0;
let is i64 as answers with mut = 0;
fn on_answer(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    answered = *cast(*i64, arg);
    answers = answers + 1;
}

let is i64 as behind_clicks with mut = 0;
fn on_behind(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { behind_clicks = behind_clicks + 1; }

fn says(t as *tree.Tree, l as i64, s as *u8) as i32 { return same(label.text(t, l), label.text_length(t, l), s); }

// An answer looked at before it is given: held back while asked to be.
let is i32 as allow with mut = 1;
let is i64 as looked with mut = 0;
fn check_answer(user as *u8, response as i64) as i32 {
    looked = response;
    return allow;
}

fn checked() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as dg = dialog.create(&t, "Name", 4);
    dialog.add_button(&t, dg, "_OK", 3, dialog.OK);
    dialog.set_default_response(&t, dg, dialog.OK);
    dialog.set_check(&t, dg, fn_ptr(check_answer), cast(*u8, 0));
    signal.connect(&t, dg, signal.ACTIVATED, fn_ptr(on_answer), cast(*u8, 0));
    dialog.show(&t, &r, dg, 1);
    answers = 0;
    allow = 0;
    key(&t, &r, keys.RETURN, 0, 10);
    check("held back: still shown, nothing said", looked == dialog.OK && dialog.is_shown(&t, dg) == 1 && answers == 0);
    allow = 1;
    key(&t, &r, keys.RETURN, 0, 20);
    check("let through: given", dialog.is_shown(&t, dg) == 0 && answers == 1);
    dialog.set_check(&t, tree.root(&t), fn_ptr(check_answer), cast(*u8, 0));
    tree.close(&t);
}

fn modal() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as behind = button.create(&t, tree.root(&t), "Behind", 6);
    layout.set_align(&t, behind, layout.START, layout.START);
    signal.connect(&t, behind, signal.CLICKED, fn_ptr(on_behind), cast(*u8, 0));
    let is i64 as dg = dialog.create(&t, "Rename", 6);
    let is i64 as e = entry.create(&t, dialog.content(&t, dg));
    entry.set_activates_default(&t, e, 1);
    let is i64 as cancel = dialog.add_button(&t, dg, "_Cancel", 7, dialog.CANCEL);
    let is i64 as ok = dialog.add_button(&t, dg, "_Rename", 7, dialog.OK);
    dialog.set_default_response(&t, dg, dialog.OK);
    signal.connect(&t, dg, signal.ACTIVATED, fn_ptr(on_answer), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("made hidden", dialog.is_shown(&t, dg) == 0 && tree.is_visible(&t, dg) == 0);
    router.focus(&t, &r, behind, 1);
    dialog.show(&t, &r, dg, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as dr = layout.window_rect(&t, dg);
    check("shown in the middle of the window", dialog.is_shown(&t, dg) == 1 && within1(dr.x + dr.w / 2.0, cast(f64, W) / 2.0) == 1 &&
          within1(dr.y + dr.h / 2.0, cast(f64, H) / 2.0) == 1);
    let is math.rect.Rect as tl = layout.window_rect(&t, dialog.title_label(&t, dg));
    let is math.rect.Rect as cr = layout.window_rect(&t, dialog.content(&t, dg));
    let is math.rect.Rect as kr = layout.window_rect(&t, cancel);
    let is math.rect.Rect as or = layout.window_rect(&t, ok);
    let is f64 as pad = theme.metrics.space_l;
    check("its title on top, what it holds under it, its buttons at its foot", says(&t, dialog.title_label(&t, dg), "Rename") == 1 &&
          near(tl.y, dr.y + pad) == 1 && cr.y >= tl.y + tl.h && kr.y >= cr.y + cr.h && near(or.y + or.h, dr.y + dr.h - pad) == 1);
    check("the affirmative last, at the end", kr.x + kr.w <= or.x && near(or.x + or.w, dr.x + dr.w - pad) == 1);
    check("the window's input its own, the focus on what it holds first", router.scope(&r) == dg && router.focused(&t, &r) == e);
    // A press outside: nothing, spent.
    behind_clicks = 0;
    click(&t, &r, mx(&t, behind), my(&t, behind), 10);
    check("pressed outside: still shown, nothing behind pressed", dialog.is_shown(&t, dg) == 1 && behind_clicks == 0);
    // Enter in its entry: the default.
    answers = 0;
    router.focus(&t, &r, e, 1);
    key(&t, &r, keys.RETURN, 0, 100);
    check("enter: the default's answer, hidden, the focus back", answers == 1 && answered == dialog.OK && dialog.is_shown(&t, dg) == 0 &&
          router.scope(&r) == 0 && router.focused(&t, &r) == behind);
    // Escape: plain, as it goes down.
    dialog.show(&t, &r, dg, 1);
    key(&t, &r, keys.ESCAPE, keys.MOD_SHIFT, 190);
    check("shift escape: nothing", answers == 1 && dialog.is_shown(&t, dg) == 1);
    router.key(&t, &r, keys.ESCAPE, 0, 0, 0, 195);
    check("escape coming up alone, pressed before: nothing", answers == 1 && dialog.is_shown(&t, dg) == 1);
    check("escape: taken as it goes down, cancelled", router.key(&t, &r, keys.ESCAPE, 0, 1, 0, 200) == 1 && answers == 2 &&
          answered == dialog.CANCEL && dialog.is_shown(&t, dg) == 0);
    router.key(&t, &r, keys.ESCAPE, 0, 0, 0, 201);
    // A button clicked.
    dialog.show(&t, &r, dg, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    click(&t, &r, mx(&t, cancel), my(&t, cancel), 300);
    check("cancel clicked: its answer", answers == 3 && answered == dialog.CANCEL && dialog.is_shown(&t, dg) == 0);
    // Hidden by the program: nothing said.
    dialog.show(&t, &r, dg, 1);
    dialog.hide(&t, dg);
    check("hidden by the program: nothing said, the focus back", answers == 3 && router.focused(&t, &r) == behind);
    // The window's Enter does not reach a hidden dialog's default.
    router.focus(&t, &r, behind, 1);
    key(&t, &r, keys.RETURN, 0, 400);
    check("hidden: its default answers nothing", answers == 3);
    // Destroyed while shown: the window's input given back, its backdrop gone.
    dialog.show(&t, &r, dg, 1);
    let is i64 as back = dialog.backdrop_of(&t, dg);
    tree.destroy(&t, dg);
    check("destroyed shown: the window's again, nothing dims it", router.scope(&r) == 0 && back != 0 && tree.is_valid(&t, back) == 0);
    tree.close(&t);
}

// Taller than the window: as tall as it, what it holds shrunk.
fn fitted() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as dg = dialog.create(&t, "Many", 4);
    let is i64 as sc = scroll.create(&t, dialog.content(&t, dg));
    let is i64 as col = box.create(&t, sc, box.COLUMN);
    let is i64 as i with mut = 0;
    while (i < 12) {
        button.create(&t, col, "Row", 3);
        i = i + 1;
    }
    let is i64 as ok = dialog.add_button(&t, dg, "_Close", 6, dialog.CLOSE);
    dialog.show(&t, &r, dg, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(&t, dg, &free, &s);
    check("at its least, what it holds at its least", s.pref_h > cast(f64, H) && s.min_h < cast(f64, H) && s.max_h == s.pref_h &&
          s.max_w == s.pref_w && s.min_w <= s.pref_w);
    let is math.rect.Rect as dr = layout.window_rect(&t, dg);
    let is math.rect.Rect as or = layout.window_rect(&t, ok);
    let is math.rect.Rect as cr = layout.window_rect(&t, sc);
    check("taller than the window: as tall as it, its buttons in it", near(dr.y, 0.0) == 1 && near(dr.h, cast(f64, H)) == 1 &&
          near(or.y + or.h, cast(f64, H) - theme.metrics.space_l) == 1 && cr.y + cr.h <= or.y && cr.h > 20.0);
    // Its least, in a window smaller still: the title, the buttons, the
    // padding and gaps, what it holds at nothing.
    let is f64 as pad = theme.metrics.space_l;
    let is f64 as gap = theme.metrics.space_m;
    let is math.rect.Rect as tr = layout.window_rect(&t, dialog.title_label(&t, dg));
    layout.run(&t, 60.0, 60.0);
    let is math.rect.Rect as small = layout.window_rect(&t, dg);
    check("in a window smaller than its least: its least", near(small.h, 2.0 * pad + tr.h + gap + gap + or.h) == 1 &&
          near(small.h, s.min_h) == 1 && near(small.w, s.min_w) == 1 && near(s.min_w, 2.0 * pad + or.w) == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    dialog.hide(&t, dg);
    // Something wide in it that can give way: as wide as it asks, the window
    // being wide enough.
    let is i64 as wd = dialog.create(&t, "W", 1);
    let is i64 as ws = scroll.create(&t, dialog.content(&t, wd));
    let is i64 as wide = button.create(&t, ws, "A row much wider than its buttons", 33);
    let is i64 as wk = dialog.add_button(&t, wd, "_Close", 6, dialog.CLOSE);
    dialog.show(&t, &r, wd, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is geom.Size as ws2;
    layout.measure(&t, wd, &free, &ws2);
    let is math.rect.Rect as wdr = layout.window_rect(&t, wd);
    let is math.rect.Rect as wtr = layout.window_rect(&t, dialog.title_label(&t, wd));
    let is math.rect.Rect as wcr = layout.window_rect(&t, ws);
    let is math.rect.Rect as wkr = layout.window_rect(&t, wk);
    let is math.rect.Rect as wr = layout.window_rect(&t, wide);
    check("as it asks: its parts, padded", ws2.min_w < ws2.pref_w && near(wdr.w, ws2.pref_w) == 1 &&
          near(wdr.w, 2.0 * pad + wr.w) == 1 && near(wdr.h, ws2.pref_h) == 1 &&
          near(wdr.h, 2.0 * pad + wtr.h + gap + wcr.h + gap + wkr.h) == 1 && near(wcr.h, wr.h) == 1);
    dialog.hide(&t, wd);
    // What it holds with a least of its own: kept, in a window too small.
    let is i64 as ld = dialog.create(&t, "L", 1);
    let is i64 as lb = button.create(&t, dialog.content(&t, ld), "Least", 5);
    let is i64 as lk = dialog.add_button(&t, ld, "_Close", 6, dialog.CLOSE);
    dialog.show(&t, &r, ld, 1);
    layout.run(&t, 60.0, 60.0);
    let is math.rect.Rect as ldr = layout.window_rect(&t, ld);
    check("its least with what it holds at its least", near(ldr.h, 2.0 * pad + layout.window_rect(&t, dialog.title_label(&t, ld)).h + gap +
          layout.window_rect(&t, lb).h + gap + layout.window_rect(&t, lk).h) == 1 && layout.window_rect(&t, lb).h > 20.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    tree.close(&t);
}

fn ordered() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as dg = dialog.create(&t, "Save?", 5);
    let is i64 as help = dialog.add_button(&t, dg, "_Help", 5, dialog.HELP);
    let is i64 as yes = dialog.add_button(&t, dg, "_Save", 5, dialog.YES);
    let is i64 as no = dialog.add_button(&t, dg, "_Discard", 8, dialog.NO);
    let is i64 as cancel = dialog.add_button(&t, dg, "_Cancel", 7, dialog.CANCEL);
    dialog.show(&t, &r, dg, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as dr = layout.window_rect(&t, dg);
    let is math.rect.Rect as hr = layout.window_rect(&t, help);
    let is math.rect.Rect as yr = layout.window_rect(&t, yes);
    let is math.rect.Rect as nr = layout.window_rect(&t, no);
    let is math.rect.Rect as cr = layout.window_rect(&t, cancel);
    let is f64 as pad = theme.metrics.space_l;
    check("help at the start, the others at the end, the affirmative last", near(hr.x, dr.x + pad) == 1 &&
          nr.x + nr.w <= cr.x && cr.x + cr.w <= yr.x && near(yr.x + yr.w, dr.x + dr.w - pad) == 1 && hr.x + hr.w < nr.x);
    // Windows' order: the affirmative first.
    dialog.set_order(dialog.AFFIRMATIVE_FIRST);
    widget.changed(&t, dg, widget.CHANGED_LAYOUT);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as yr2 = layout.window_rect(&t, yes);
    let is math.rect.Rect as nr2 = layout.window_rect(&t, no);
    let is math.rect.Rect as cr2 = layout.window_rect(&t, cancel);
    check("the affirmative first", yr2.x + yr2.w <= nr2.x && nr2.x + nr2.w <= cr2.x && near(cr2.x + cr2.w, dr.x + dr.w - pad) == 1);
    dialog.set_order(dialog.AFFIRMATIVE_LAST);
    // Right to left: mirrored.
    layout.set_direction(&t, dg, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as yr3 = layout.window_rect(&t, yes);
    let is math.rect.Rect as hr3 = layout.window_rect(&t, help);
    let is math.rect.Rect as tl3 = layout.window_rect(&t, dialog.title_label(&t, dg));
    check("right to left: the affirmative at the left end, help at the right, the title from the right", near(yr3.x, dr.x + pad) == 1 &&
          near(hr3.x + hr3.w, dr.x + dr.w - pad) == 1 && near(tl3.x + tl3.w, dr.x + dr.w - pad) == 1);
    dialog.hide(&t, dg);
    // The program's own answer is affirmative; help second and third still at the start.
    let is i64 as d2 = dialog.create(&t, "More", 4);
    let is i64 as mine = dialog.add_button(&t, d2, "_Mine", 5, dialog.USER);
    let is i64 as close = dialog.add_button(&t, d2, "_Close", 6, dialog.CLOSE);
    let is i64 as h1 = dialog.add_button(&t, d2, "_Help", 5, dialog.HELP);
    let is i64 as h2 = dialog.add_button(&t, d2, "_Tips", 5, dialog.HELP);
    dialog.show(&t, &r, d2, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as d2r = layout.window_rect(&t, d2);
    let is math.rect.Rect as h1r = layout.window_rect(&t, h1);
    let is math.rect.Rect as h2r = layout.window_rect(&t, h2);
    check("the program's own: affirmative, last", near(layout.window_rect(&t, mine).x + layout.window_rect(&t, mine).w, d2r.x + d2r.w - pad) == 1 &&
          layout.window_rect(&t, close).x + layout.window_rect(&t, close).w <= layout.window_rect(&t, mine).x);
    check("helps at the start, one after the other", near(h1r.x, d2r.x + pad) == 1 && near(h2r.x, h1r.x + h1r.w + theme.metrics.space_s) == 1);
    // As wide as its buttons when they are the widest.
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ds;
    layout.measure(&t, d2, &free, &ds);
    let is f64 as row = layout.window_rect(&t, close).w + layout.window_rect(&t, h1).w + layout.window_rect(&t, h2).w +
                        layout.window_rect(&t, mine).w + 3.0 * theme.metrics.space_s;
    check("as wide as its buttons, padded", near(ds.pref_w, 2.0 * pad + row) == 1);
    let is math.rect.Rect as c2 = layout.window_rect(&t, dialog.content(&t, d2));
    check("what it holds as wide as it, less its padding", near(c2.w, d2r.w - 2.0 * pad) == 1);
    dialog.hide(&t, d2);
    // Secondary buttons: at the start after help, in the order added.
    let is i64 as d4 = dialog.create(&t, "About", 5);
    let is i64 as close4 = dialog.add_button(&t, d4, "_Close", 6, dialog.CLOSE);
    let is i64 as credits = dialog.add_button(&t, d4, "C_redits", 8, dialog.USER + 1);
    let is i64 as help4 = dialog.add_button(&t, d4, "_Help", 5, dialog.HELP);
    let is i64 as lic = dialog.add_button(&t, d4, "_License", 8, dialog.USER + 2);
    check("secondary: set", dialog.set_secondary(&t, d4, dialog.USER + 1, 1) == 1 && dialog.set_secondary(&t, d4, dialog.USER + 2, 1) == 1 &&
          dialog.is_secondary(&t, d4, dialog.USER + 2) == 1 && dialog.is_secondary(&t, d4, dialog.CLOSE) == 0);
    check("no such answer, or no dialog: not", dialog.set_secondary(&t, d4, dialog.USER + 5, 1) == 0 &&
          dialog.is_secondary(&t, d4, dialog.USER + 5) == 0 &&
          dialog.set_secondary(&t, tree.root(&t), dialog.CLOSE, 1) == 0 && dialog.is_secondary(&t, tree.root(&t), dialog.CLOSE) == 0);
    dialog.show(&t, &r, d4, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as d4r = layout.window_rect(&t, d4);
    let is math.rect.Rect as h4r = layout.window_rect(&t, help4);
    let is math.rect.Rect as crr = layout.window_rect(&t, credits);
    let is math.rect.Rect as lr = layout.window_rect(&t, lic);
    let is math.rect.Rect as c4r = layout.window_rect(&t, close4);
    let is f64 as bgap = theme.metrics.space_s;
    check("help, then the secondary ones, from the start; the rest at the end", near(h4r.x, d4r.x + pad) == 1 &&
          near(crr.x, h4r.x + h4r.w + bgap) == 1 && near(lr.x, crr.x + crr.w + bgap) == 1 &&
          near(c4r.x + c4r.w, d4r.x + d4r.w - pad) == 1);
    dialog.set_secondary(&t, d4, dialog.USER + 1, 0);
    widget.changed(&t, d4, widget.CHANGED_LAYOUT);
    layout.run(&t, cast(f64, W), cast(f64, H));
    dialog.set_secondary(&t, d4, dialog.CLOSE, 1);
    dialog.set_secondary(&t, d4, dialog.USER + 2, 0);
    check("one no longer, the others still", dialog.is_secondary(&t, d4, dialog.CLOSE) == 1 &&
          dialog.is_secondary(&t, d4, dialog.USER + 2) == 0);
    dialog.set_secondary(&t, d4, dialog.CLOSE, 0);
    dialog.set_secondary(&t, d4, dialog.USER + 2, 1);
    check("no longer: at the end again", dialog.is_secondary(&t, d4, dialog.USER + 1) == 0 &&
          near(layout.window_rect(&t, credits).x + layout.window_rect(&t, credits).w, d4r.x + d4r.w - pad) == 1);
    dialog.hide(&t, d4);
    // Eight buttons at most.
    let is i64 as d3 = dialog.create(&t, "Many", 4);
    let is i64 as k with mut = 0;
    while (k < 8) {
        dialog.add_button(&t, d3, "B", 1, dialog.USER + k);
        k = k + 1;
    }
    check("a ninth: refused", dialog.add_button(&t, d3, "C", 1, dialog.USER + 9) == 0 && dialog.button_for(&t, d3, dialog.USER) != 0);
    check("not a dialog: no labels", dialog.title_label(&t, tree.root(&t)) == 0 && dialog.text_label(&t, tree.root(&t)) == 0 &&
          dialog.icon_of(&t, tree.root(&t)) == 0 && dialog.backdrop_of(&t, tree.root(&t)) == 0);
    tree.close(&t);
}

fn modeless() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as behind = button.create(&t, tree.root(&t), "Behind", 6);
    layout.set_align(&t, behind, layout.START, layout.START);
    signal.connect(&t, behind, signal.CLICKED, fn_ptr(on_behind), cast(*u8, 0));
    let is i64 as dg = dialog.create(&t, "Find", 4);
    let is i64 as row = box.create(&t, dialog.content(&t, dg), box.ROW);
    let is i64 as e = entry.create(&t, row);
    dialog.add_button(&t, dg, "_Close", 6, dialog.CLOSE);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, behind, 1);
    dialog.show(&t, &r, dg, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("not modal: the window's input still its own, the focus inside", router.scope(&r) == 0 && router.focused(&t, &r) == e);
    behind_clicks = 0;
    click(&t, &r, mx(&t, behind), my(&t, behind), 10);
    check("what is behind it pressed", behind_clicks == 1 && dialog.is_shown(&t, dg) == 1);
    router.focus(&t, &r, e, 1);
    dialog.hide(&t, dg);
    check("hidden: the focus back where it was", router.focused(&t, &r) == behind);
    tree.close(&t);
}

fn messages(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as dg = dialog.message(&t, dialog.WARNING, "Delete the file?", 16, "It cannot be brought back.", 26, dialog.YES_NO);
    signal.connect(&t, dg, signal.ACTIVATED, fn_ptr(on_answer), cast(*u8, 0));
    dialog.show(&t, &r, dg, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as yes = dialog.button_for(&t, dg, dialog.YES);
    let is i64 as no = dialog.button_for(&t, dg, dialog.NO);
    let is math.rect.Rect as yr = layout.window_rect(&t, yes);
    let is math.rect.Rect as nr = layout.window_rect(&t, no);
    check("yes and no, yes last", yes != 0 && no != 0 && nr.x + nr.w <= yr.x && dialog.button_for(&t, dg, dialog.OK) == 0);
    check("its text", says(&t, dialog.text_label(&t, dg), "It cannot be brought back.") == 1);
    let is math.rect.Rect as ir = dialog.icon_rect(&t, dg);
    let is math.rect.Rect as tr = layout.window_rect(&t, dialog.text_label(&t, dg));
    check("its icon before its text", ir.w > 0.0 && ir.x + ir.w <= tr.x);
    answers = 0;
    key(&t, &r, keys.RETURN, 0, 10);
    check("enter: the affirmative", answers == 1 && answered == dialog.YES);
    let is i64 as d2 = dialog.message(&t, dialog.ERROR, "Failed", 6, "No room left.", 13, dialog.OK_CANCEL);
    check("ok and cancel", dialog.button_for(&t, d2, dialog.OK) != 0 && dialog.button_for(&t, d2, dialog.CANCEL) != 0);
    let is i64 as d3 = dialog.message(&t, dialog.INFO, "Done", 4, "Saved.", 6, dialog.OK);
    check("ok alone", dialog.button_for(&t, d3, dialog.OK) != 0 && dialog.button_for(&t, d3, dialog.CANCEL) == 0);
    let is i64 as d4 = dialog.message(&t, dialog.QUESTION, "Save?", 5, "Changes will be lost.", 21, dialog.YES_NO_CANCEL);
    check("yes, no and cancel", dialog.button_for(&t, d4, dialog.YES) != 0 && dialog.button_for(&t, d4, dialog.NO) != 0 &&
          dialog.button_for(&t, d4, dialog.CANCEL) != 0);
    let is i64 as d5 = dialog.message(&t, dialog.INFO, "Note", 4, "Read me.", 8, dialog.CLOSE_ONLY);
    check("close alone", dialog.button_for(&t, d5, dialog.CLOSE) != 0);
    check("each kind its icon", dialog.icon_shape(&t, dg) == icons.DIALOG_WARNING && dialog.icon_shape(&t, d2) == icons.DIALOG_ERROR &&
          dialog.icon_shape(&t, d3) == icons.DIALOG_INFO && dialog.icon_shape(&t, d4) == icons.DIALOG_QUESTION &&
          dialog.icon_shape(&t, tree.root(&t)) == 0);
    dialog.show(&t, &r, d4, 1);
    frame(&t, c);
    let is math.rect.Rect as icr = layout.window_rect(&t, dialog.icon_of(&t, d4));
    check("drawn in its colour: the question's ring, its sign a hole",
          is8(cast(i64, icr.x + icr.w / 2.0), cast(i64, icr.y + icr.h * 1.6 / 16.0), theme.palette.accent, 40) == 1 &&
          is8(cast(i64, icr.x + icr.w * 8.0 / 16.0), cast(i64, icr.y + icr.h * 11.75 / 16.0), theme.palette.accent, 40) == 0);
    // In the tree's language.
    tree.set_language(&t, strings.PT_BR);
    let is i64 as d6 = dialog.message(&t, dialog.QUESTION, "Salvar?", 7, "Tudo se perde.", 14, dialog.YES_NO_CANCEL);
    check("its buttons in the tree's language", says(&t, button.content(&t, dialog.button_for(&t, d6, dialog.YES)), "Sim") == 1 &&
          says(&t, button.content(&t, dialog.button_for(&t, d6, dialog.NO)), "Não") == 1 &&
          says(&t, button.content(&t, dialog.button_for(&t, d6, dialog.CANCEL)), "Cancelar") == 1);
    let is i64 as d7 = dialog.message(&t, dialog.INFO, "Nota", 4, "Leia.", 5, dialog.CLOSE_ONLY);
    let is i64 as d8 = dialog.message(&t, dialog.INFO, "Pronto", 6, "Salvo.", 6, dialog.OK_CANCEL);
    check("every one", says(&t, button.content(&t, dialog.button_for(&t, d7, dialog.CLOSE)), "Fechar") == 1 &&
          says(&t, button.content(&t, dialog.button_for(&t, d8, dialog.OK)), "OK") == 1);
    tree.close(&t);
}

// A square in the window's colour, to be covered.
fn plain_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    geom.size_zero(out);
    out.pref_w = 20.0;
    out.pref_h = 20.0;
    out.min_w = 20.0;
    out.min_h = 20.0;
    out.max_w = 20.0;
    out.max_h = 20.0;
}

fn plain_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    shapes.fill_rect(p.canvas, p.rect.x, p.rect.y, p.rect.w, p.rect.h, theme.palette.window_bg);
}

let is tree.Kind as plain_kind with mut;

fn drawn(c as *draw2d.Canvas) as void {
    plain_kind = widget.kind("plain", 0);
    plain_kind.measure = fn_ptr(plain_measure);
    plain_kind.paint = fn_ptr(plain_paint);
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as dg = dialog.message(&t, dialog.WARNING, "Delete?", 7, "Really.", 7, dialog.YES_NO);
    dialog.show(&t, &r, dg, 1);
    frame(&t, c);
    let is math.rect.Rect as dr = layout.window_rect(&t, dg);
    let is math.color.Color as dim = style.over(dialog.backdrop_colour(&theme), theme.palette.window_bg);
    check("the window behind it dimmed", is8(2, 2, dim, 3) == 1 && is8(2, 2, theme.palette.window_bg, 3) == 0);
    check("in the popover colour", is8(cast(i64, dr.x + dr.w - 10.0), cast(i64, dr.y + 10.0), theme.palette.popover_bg, 3) == 1);
    let is math.rect.Rect as ir = dialog.icon_rect(&t, dg);
    check("its icon in the warning colour", is8(cast(i64, ir.x + ir.w * 5.0 / 16.0), cast(i64, ir.y + ir.h * 13.0 / 16.0),
          theme.palette.warning, 40) == 1);
    let is i64 as yes = dialog.button_for(&t, dg, dialog.YES);
    let is style.Look as look = style.pick(&theme.suggested, 0, 0);
    let is math.rect.Rect as yr = layout.window_rect(&t, yes);
    check("its default in the accent", is8(cast(i64, yr.x + 4.0), cast(i64, yr.y + yr.h / 2.0), look.bg, 10) == 1);
    dialog.hide(&t, dg);
    frame(&t, c);
    check("hidden: the window as it was", is8(2, 2, theme.palette.window_bg, 3) == 1);
    // Something added to the window after the backdrop was made: dimmed too.
    let is i64 as late = tree.create(&t, &plain_kind, tree.root(&t));
    layout.set_align(&t, late, layout.START, layout.START);
    dialog.show(&t, &r, dg, 1);
    frame(&t, c);
    check("shown again: dimmed again", is8(2, 2, dim, 3) == 1);
    check("what came after the backdrop: dimmed too", is8(2, 2, theme.palette.window_bg, 3) == 0);
    dialog.hide(&t, dg);
    frame(&t, c);
    check("hidden again: as it was", is8(2, 2, theme.palette.window_bg, 3) == 1);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as dg = dialog.create(&t, "Rename", 6);
    dialog.add_button(&t, dg, "OK", 2, dialog.OK);
    dialog.show(&t, &r, dg, 1);
    let is tree.Access as q;
    access.describe(&t, &r, dg, &q);
    check("told: a dialog, modal, named by its title", q.role == access.ROLE_DIALOG && (q.states & access.MODAL) != 0 &&
          same(q.name, q.name_len, "Rename") == 1);
    dialog.hide(&t, dg);
    dialog.show(&t, &r, dg, 0);
    access.describe(&t, &r, dg, &q);
    check("not modal: so told", (q.states & access.MODAL) == 0);
    dialog.hide(&t, dg);
    let is i64 as mb = dialog.message(&t, dialog.ERROR, "Failed", 6, "No room left.", 13, dialog.OK);
    access.describe(&t, &r, mb, &q);
    check("a message: an alert, its text its description", q.role == access.ROLE_ALERT && same(q.description, q.description_len,
          "No room left.") == 1);
    check("not a dialog: nothing", dialog.is_shown(&t, tree.root(&t)) == 0 && dialog.content(&t, tree.root(&t)) == 0 &&
          dialog.add_button(&t, tree.root(&t), "x", 1, dialog.OK) == 0 && dialog.button_for(&t, tree.root(&t), dialog.OK) == 0);
    tree.close(&t);
}

// In a window of its own: asked of the application through the tree, filling
// that window, its title the window's, shown and hidden with it.
fn windowed(c as *draw2d.Canvas) as void {
    let is app.Limits as al with mut = app.limits_default();
    al.windows = 4;
    let is app.App as a = app.open(&al);
    app.set_theme(&a, &theme);
    app.set_text_service(&a, cast(*u8, svc));
    let is i64 as main_w = app.window_open(&a, cast(f64, W), cast(f64, H));
    let is *tree.Tree as t = app.tree(&a, main_w);
    let is *tree.Tree as dt = dialog.window_tree(t);
    let is i64 as dw = app.window_of(&a, dt);
    check("windowed: a window of its own, belonging to the window, hidden", cast(i64, dt) != cast(i64, t) && dw != 0 &&
          app.owner(&a, dw) == main_w && app.is_shown(&a, dw) == 0);
    let is i64 as dg = dialog.create(dt, "Rename", 6);
    let is i64 as name = entry.create(dt, dialog.content(dt, dg));
    dialog.add_button(dt, dg, "_Cancel", 7, dialog.CANCEL);
    dialog.add_button(dt, dg, "_OK", 3, dialog.OK);
    dialog.set_default_response(dt, dg, dialog.OK);
    signal.connect(dt, dg, signal.ACTIVATED, fn_ptr(on_answer), cast(*u8, 0));
    let is *router.Router as dr = app.router(&a, dw);
    dialog.show(dt, dr, dg, 1);
    check("windowed: shown, its window shown modal, the owner waiting", dialog.is_shown(dt, dg) == 1 &&
          app.is_shown(&a, dw) == 1 && app.is_modal(&a, dw) == 1 && app.blocked(&a, main_w) == 1);
    check("windowed: its title the window's", same(app.title(&a, dw), app.title_length(&a, dw), "Rename") == 1);
    check("windowed: no title inside, no backdrop", tree.is_hidden_here(dt, dialog.title_label(dt, dg)) == 1 &&
          dialog.backdrop_of(dt, dg) == 0);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as pref;
    layout.measure(dt, dg, &free, &pref);
    let is winstate.State as ws = app.window_state(&a, dw);
    check("windowed: the window sized to it", ws.width == pref.pref_w && ws.height == pref.pref_h);
    app.frame(&a, dw);
    let is math.rect.Rect as at = layout.rect(dt, dg);
    check("windowed: filling it", at.x == 0.0 && at.y == 0.0 && at.w == ws.width && at.h == ws.height);
    app.resize(&a, dw, ws.width + 100.0, ws.height + 60.0);
    app.frame(&a, dw);
    let is math.rect.Rect as big = layout.rect(dt, dg);
    check("windowed: its window made larger, still filling it", big.w == ws.width + 100.0 && big.h == ws.height + 60.0);
    app.resize(&a, dw, ws.width, ws.height);
    app.frame(&a, dw);
    check("windowed: the focus on what it holds", router.focused(dt, dr) == name);
    entry.set_activates_default(dt, name, 1);
    answers = 0;
    key(dt, dr, keys.RETURN, 0, 5);
    check("windowed: enter in it, the default's answer", answers == 1 && answered == dialog.OK && app.is_shown(&a, dw) == 0);
    dialog.show(dt, dr, dg, 1);
    app.frame(&a, dw);
    answers = 0;
    key(dt, dr, keys.ESCAPE, 0, 10);
    check("windowed: answered, its window hidden, the owner going on", answers == 1 && answered == dialog.CANCEL &&
          dialog.is_shown(dt, dg) == 0 && app.is_shown(&a, dw) == 0 && app.blocked(&a, main_w) == 0);
    // The platform asked its window to close — the title bar's close button:
    // as Escape.
    dialog.show(dt, dr, dg, 1);
    app.frame(&a, dw);
    answers = 0;
    check("windowed: asked to close, cancelled", router.close_request(dt, dr, 15) == 1 && answers == 1 &&
          answered == dialog.CANCEL && app.is_shown(&a, dw) == 0);
    check("windowed: asked again, hidden: nothing takes it", router.close_request(dt, dr, 16) == 0 && answers == 1);
    dialog.show(dt, dr, dg, 0);
    check("windowed: shown not modal", app.is_shown(&a, dw) == 1 && app.is_modal(&a, dw) == 0 &&
          app.blocked(&a, main_w) == 0);
    dialog.hide(dt, dg);
    check("windowed: hidden", app.is_shown(&a, dw) == 0 && dialog.is_shown(dt, dg) == 0);
    key(dt, dr, keys.RETURN, 0, 20);
    check("windowed: hidden, no answer", answers == 1);

    // Drawn as the window it is: no frame of its own.
    dialog.show(dt, dr, dg, 1);
    frame_router = dr;
    frame(dt, c);
    frame_router = cast(*router.Router, 0);
    let is math.rect.Rect as wr = layout.window_rect(dt, dg);
    check("windowed: in the window's colour, not a popover's", is8(cast(i64, wr.x + wr.w - 4.0), cast(i64, wr.y + 4.0),
          theme.palette.window_bg, 2) == 1);

    // Nothing in it takes the focus: the default's button has it.
    let is *tree.Tree as nt = dialog.window_tree(t);
    let is i64 as nd = dialog.create(nt, "Quit?", 5);
    dialog.add_button(nt, nd, "_Cancel", 7, dialog.CANCEL);
    let is i64 as nok = dialog.add_button(nt, nd, "_OK", 3, dialog.OK);
    dialog.set_default_response(nt, nd, dialog.OK);
    let is i64 as nw = app.window_of(&a, nt);
    dialog.show(nt, app.router(&a, nw), nd, 0);
    check("windowed: nothing inside to focus, the default's button", router.focused(nt, app.router(&a, nw)) == nok);
    app.window_close(&a, nw);

    // A message box too, in a window of its own belonging to the same window.
    let is *tree.Tree as mt = dialog.window_tree(t);
    let is i64 as mw = app.window_of(&a, mt);
    let is i64 as mb = dialog.message(mt, dialog.INFO, "Saved", 5, "All is kept.", 12, dialog.OK_ONLY);
    dialog.show(mt, app.router(&a, mw), mb, 1);
    check("windowed: a message box, its own window", mw != dw && app.owner(&a, mw) == main_w && app.is_shown(&a, mw) == 1 &&
          same(app.title(&a, mw), app.title_length(&a, mw), "Saved") == 1);
    dialog.respond(mt, mb, dialog.OK);
    check("windowed: answered, hidden", app.is_shown(&a, mw) == 0);

    // Destroyed shown: its window put away.
    dialog.show(mt, app.router(&a, mw), mb, 1);
    tree.destroy(mt, mb);
    check("windowed: destroyed shown, its window hidden", app.is_shown(&a, mw) == 0 && app.blocked(&a, main_w) == 1 &&
          app.is_shown(&a, dw) == 1);
    dialog.hide(dt, dg);

    // A reference to it, good while it is there.
    let is dialog.Ref as ref = dialog.ref(dt, dg);
    check("a reference: good", dialog.ref_valid(&ref) == 1 && cast(i64, ref.t) == cast(i64, dt) && ref.w == dg);
    let is dialog.Ref as none = dialog.ref(dt, tree.root(dt));
    check("a reference to no dialog: none", dialog.ref_valid(&none) == 0);
    dialog.show(dt, dr, dg, 1);
    dialog.dispose(&ref);
    check("disposed: its window closed, the owner going on", app.window_valid(&a, dw) == 0 && dialog.ref_valid(&ref) == 0 &&
          app.blocked(&a, main_w) == 0);
    dialog.dispose(&ref);
    check("disposed twice: nothing", app.window_valid(&a, main_w) == 1);
    // Its window's slot taken again: the reference stays bad.
    let is *tree.Tree as again = dialog.window_tree(t);
    let is i64 as dg2 = dialog.create(again, "Again", 5);
    check("a slot taken again: still bad", cast(i64, again) == cast(i64, dt) && dg2 == dg && dialog.ref_valid(&ref) == 0);
    let is dialog.Ref as ref2 = dialog.ref(again, dg2);
    app.window_close(&a, app.window_of(&a, again));
    check("its window closed: bad", dialog.ref_valid(&ref2) == 0);

    // No application: inside the window, as before.
    let is tree.Tree as plain = tree_for();
    check("no application: the tree itself", cast(i64, dialog.window_tree(&plain)) == cast(i64, &plain));
    let is i64 as pd = dialog.create(&plain, "Here", 4);
    check("no application: its title inside", tree.is_hidden_here(&plain, dialog.title_label(&plain, pd)) == 0);
    let is dialog.Ref as pref_ = dialog.ref(&plain, pd);
    check("no application: a reference", dialog.ref_valid(&pref_) == 1);
    dialog.dispose(&pref_);
    check("no application: disposed, destroyed", tree.is_valid(&plain, pd) == 0 && dialog.ref_valid(&pref_) == 0);
    tree.close(&plain);
    app.close(&a);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    modal();
    fitted();
    checked();
    ordered();
    modeless();
    messages(&c);
    drawn(&c);
    told();
    windowed(&c);

    if (fails == 0) {
        io.printf("dialog: %d checks passed\n", checks);
        return 0;
    }
    io.printf("dialog: %d of %d checks failed\n", fails, checks);
    return 1;
}
