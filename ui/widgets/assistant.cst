// ui/widgets/assistant.cst — a task in steps, one at a time.
//
// Each step's title on top, the step under it — an overlay the program
// fills — and at the foot Cancel at the start and Back and Next at the end,
// mirrored in right to left. Next is Finish on the last step, and held back
// while the step is not complete (set_complete); Back is held back on the
// first. Steps are kept in a stack, as large as the largest, so nothing moves
// from one to the next. Moving says VALUE_CHANGED; Finish says ACTIVATED,
// Cancel CLOSED — closing is the program's to do. Bound to a window's router,
// Enter is Next or Finish and Escape Cancel. Told as a panel named by its
// step's title.
use "../../math/math.cst" as math;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../stack.cst" as stack;
use "label.cst" as label;
use "button.cst" as button;

struct Data {
    t          as *tree.Tree;
    self       as i64;
    titles     as i64;   // a stack of each step's title
    pages      as i64;   // a stack of the steps
    cancel     as i64;
    back       as i64;
    next       as i64;
    cur        as i64;   // -1 before the first step is added
    incomplete as i64;   // a bit each for the first 64 steps; past them all are complete
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("assistant", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.role = access.ROLE_PANEL;
    _ready = 1;
}

fn _button(t as *tree.Tree, w as i64, s as *u8, n as i64, cb as tree.SignalFn, d as *Data) as i64 {
    let is i64 as b = button.create(t, w, s, n);
    if (b != 0) { signal.connect(t, b, signal.CLICKED, cb, cast(*u8, d)); }
    return b;
}

// A new assistant, with no steps yet, as the last child of parent. Its
// handle, or 0.
fn create(t as *tree.Tree, parent as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.t = t;
    d.self = w;
    d.cur = 0 - 1;
    d.titles = stack.create(t, w);
    d.pages = stack.create(t, w);
    d.cancel = _button(t, w, "_Cancel", 7, fn_ptr(_on_cancel), d);
    d.back = _button(t, w, "_Back", 5, fn_ptr(_on_back), d);
    d.next = _button(t, w, "_Next", 5, fn_ptr(_on_next), d);
    if (d.titles == 0 || d.pages == 0 || d.cancel == 0 || d.back == 0 || d.next == 0) {
        tree.destroy(t, w);
        return 0;
    }
    button.set_variant(t, d.next, button.SUGGESTED);
    tree.set_enabled(t, d.back, 0);
    return w;
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

fn _nth(t as *tree.Tree, w as i64, i as i64) as i64 {
    if (i < 0) { return 0; }
    let is i64 as ch with mut = tree.first_child(t, w);
    let is i64 as k with mut = 0;
    while (ch != 0 && k < i) {
        ch = tree.next_sibling(t, ch);
        k = k + 1;
    }
    return ch;
}

fn count(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return tree.child_count(t, d.pages);
}

fn current(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0 - 1; }
    return d.cur;
}

// Step i, where its content goes.
fn page(t as *tree.Tree, w as i64, i as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return _nth(t, d.pages, i);
}

// The label of the current step's title.
fn title(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return _nth(t, d.titles, d.cur);
}

fn back_button(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.back;
}

fn next_button(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.next;
}

fn cancel_button(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.cancel;
}

// Whether step i is complete: Next goes on from it only then.
fn complete(t as *tree.Tree, w as i64, i as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || i < 0 || i >= count(t, w)) { return 0; }
    if (i >= 64) { return 1; }
    return cast(i32, ((d.incomplete >> i) & 1) == 0);
}

// The buttons as the current step has them.
fn _buttons(t as *tree.Tree, d as *Data) as void {
    let is i64 as n = count(t, d.self);
    tree.set_enabled(t, d.back, cast(i32, d.cur > 0));
    tree.set_enabled(t, d.next, complete(t, d.self, d.cur));
    let is i64 as l = button.content(t, d.next);
    if (d.cur == n - 1) { label.set_text_mnemonic(t, l, "_Finish", 7); } else { label.set_text_mnemonic(t, l, "_Next", 5); }
}

// Step i shown under its title. 1 if it changed.
fn set_current(t as *tree.Tree, w as i64, i as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || i < 0 || i >= count(t, w) || i == d.cur) { return 0; }
    d.cur = i;
    stack.set_current(t, d.titles, _nth(t, d.titles, i));
    stack.set_current(t, d.pages, _nth(t, d.pages, i));
    tree.set_labelled_by(t, w, _nth(t, d.titles, i));
    _buttons(t, d);
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    let is i64 as at = i;
    signal.emit(t, w, signal.VALUE_CHANGED, cast(*u8, &at));
    return 1;
}

// A new step, last, titled s — n bytes. The first one made is shown. Its
// page, or 0.
fn add(t as *tree.Tree, w as i64, s as *u8, n as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    let is i64 as l = label.create(t, d.titles, s, n);
    if (l == 0) { return 0; }
    let is i64 as pg = stack.create_overlay(t, d.pages);
    if (pg == 0) {
        tree.destroy(t, l);
        return 0;
    }
    label.set_style(t, l, label.HEADING);
    tree.set_visible(t, l, 0);
    tree.set_visible(t, pg, 0);
    if (d.cur < 0) {
        set_current(t, w, 0);
    } else {
        _buttons(t, d);
    }
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    return pg;
}

// Step i complete (1) or not (0): only a complete step lets Next go on.
fn set_complete(t as *tree.Tree, w as i64, i as i64, on as i32) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || i < 0 || i >= 64) { return; }
    if (on == 1) {
        d.incomplete = d.incomplete & (0 - 1 - (1 << i));
    } else {
        d.incomplete = d.incomplete | (1 << i);
    }
    if (i == d.cur) { _buttons(t, d); }
}

// Enter for Next or Finish, Escape for Cancel, and the buttons' mnemonics.
fn bind(t as *tree.Tree, r as *router.Router, w as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    button.set_default(t, r, d.next);
    button.set_cancel(t, r, d.cancel);
    button.bind_mnemonic(t, r, d.next);
    button.bind_mnemonic(t, r, d.back);
    button.bind_mnemonic(t, r, d.cancel);
}

fn _on_next(t as *tree.Tree, b as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    if (complete(t, d.self, d.cur) == 0) { return; }
    if (d.cur == count(t, d.self) - 1) {
        signal.emit(t, d.self, signal.ACTIVATED, cast(*u8, 0));
        return;
    }
    set_current(t, d.self, d.cur + 1);
}

fn _on_back(t as *tree.Tree, b as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    set_current(t, d.self, d.cur - 1);
}

fn _on_cancel(t as *tree.Tree, b as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    signal.emit(t, d.self, signal.CLOSED, cast(*u8, 0));
}

// --- Measuring and arranging ---

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _pref(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &free, &s);
    return s;
}

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as pad = th.metrics.space_m;
    let is f64 as gap = th.metrics.space_s;
    let is geom.Size as ts = _pref(t, d.titles);
    let is geom.Size as ps = _pref(t, d.pages);
    let is geom.Size as cs = _pref(t, d.cancel);
    let is geom.Size as bs = _pref(t, d.back);
    let is geom.Size as ns = _pref(t, d.next);
    let is f64 as row = cs.pref_w + gap + bs.pref_w + gap + ns.pref_w;
    let is f64 as bh = _max(cs.pref_h, _max(bs.pref_h, ns.pref_h));
    geom.size_zero(out);
    out.pref_w = 2.0 * pad + _max(row, _max(ts.pref_w, ps.pref_w));
    out.min_w = 2.0 * pad + _max(row, _max(ts.min_w, ps.min_w));
    out.pref_h = 2.0 * pad + ts.pref_h + gap + ps.pref_h + gap + bh;
    out.min_h = 2.0 * pad + ts.pref_h + gap + ps.min_h + gap + bh;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as pad = th.metrics.space_m;
    let is f64 as gap = th.metrics.space_s;
    let is geom.Size as ts = _pref(t, d.titles);
    let is geom.Size as cs = _pref(t, d.cancel);
    let is geom.Size as bs = _pref(t, d.back);
    let is geom.Size as ns = _pref(t, d.next);
    let is f64 as bh = _max(cs.pref_h, _max(bs.pref_h, ns.pref_h));
    let is f64 as inner = _max(0.0, r.w - 2.0 * pad);
    let is math.rect.Rect as tr = math.rect.rect(pad, pad, inner, ts.pref_h);
    layout.place(t, d.titles, &tr);
    let is f64 as by = r.h - pad - bh;
    let is f64 as py = pad + ts.pref_h + gap;
    let is math.rect.Rect as pr = math.rect.rect(pad, py, inner, _max(0.0, by - gap - py));
    layout.place(t, d.pages, &pr);
    let is i32 as rtl = cast(i32, layout.direction(t, w) == layout.RTL);
    let is math.rect.Rect as cr with mut = math.rect.rect(pad, by, cs.pref_w, bh);
    let is math.rect.Rect as nr with mut = math.rect.rect(r.w - pad - ns.pref_w, by, ns.pref_w, bh);
    let is math.rect.Rect as br with mut = math.rect.rect(nr.x - gap - bs.pref_w, by, bs.pref_w, bh);
    if (rtl == 1) {
        cr.x = r.w - pad - cs.pref_w;
        nr.x = pad;
        br.x = pad + ns.pref_w + gap;
    }
    layout.place(t, d.cancel, &cr);
    layout.place(t, d.back, &br);
    layout.place(t, d.next, &nr);
}
