// ui/widgets/toolbar.cst — tools in a row.
//
// Flat buttons, toggles, separators — or any widget the program makes with
// the toolbar as its parent — side by side from the start edge, as tall as a
// control. The buttons among them are one stop for Tab: only one takes the
// focus, the one last focused, and while one has it the arrows along the row
// move to the next or the one before — past separators and what is disabled —
// with Home and End to the ends.
//
// More than fit: those that do not are taken out of the row, and a button at
// its end offers them from a menu — a toggle as a check item showing how it
// stands, a disabled tool disabled — where choosing one presses it as a click
// would. That button is the last stop along the row for the arrows, and
// Space, Enter or Down there opens its menu with the first item chosen.
//
// Told as a tool bar, across.
use "../../math/math.cst" as math;
use "../../window/keys.cst" as keys;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../positioner.cst" as positioner;
use "button.cst" as button;
use "label.cst" as label;
use "separator.cst" as separator;
use "menu.cst" as menu;

struct Data {
    t     as *tree.Tree;
    self  as i64;
    more  as i64;   // the button that offers what does not fit
    menu  as i64;   // its menu, made the first time
    shown as i64;   // how many of the items are in the row
    over  as i32;
    _pad0 as i32;
}

let is tree.Kind as _kind with mut;
let is tree.Kind as _more_kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("toolbar", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.event = fn_ptr(_event);
    _kind.role = access.ROLE_TOOL_BAR;
    _kind.access = fn_ptr(_access);
    _kind.destroy = fn_ptr(_destroy);
    _more_kind = widget.kind("toolbar more", 8);
    _more_kind.measure = fn_ptr(_more_measure);
    _more_kind.paint = fn_ptr(_more_paint);
    _more_kind.event = fn_ptr(_more_event);
    _more_kind.role = access.ROLE_BUTTON;
    _more_kind.access = fn_ptr(_more_access);
    _ready = 1;
}

// A new, empty toolbar as the last child of parent. Its handle, or 0.
fn create(t as *tree.Tree, parent as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.t = t;
    d.self = w;
    d.more = tree.create(t, &_more_kind, w);
    if (d.more == 0) {
        tree.destroy(t, w);
        return 0;
    }
    tree.set_visible(t, d.more, 0);
    return w;
}

fn _destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Data as d = cast(*Data, data);
    if (d.menu != 0 && tree.is_valid(t, d.menu) == 1) { tree.destroy(t, d.menu); }
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

// --- Its tools ---

fn count(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return tree.child_count(t, w) - 1;
}

// Tool i, 0 past the last.
fn item(t as *tree.Tree, w as i64, i as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || i < 0) { return 0; }
    let is i64 as ch with mut = tree.first_child(t, w);
    let is i64 as k with mut = 0;
    while (ch != 0) {
        if (ch != d.more) {
            if (k == i) { return ch; }
            k = k + 1;
        }
        ch = tree.next_sibling(t, ch);
    }
    return 0;
}

fn _roving(t as *tree.Tree, ch as i64) as i32 {
    return cast(i32, cast(i64, tree.kind(t, ch)) == cast(i64, button.kind()));
}

// A button joining the row: the stop for Tab only when it is the first.
fn _join(t as *tree.Tree, w as i64, b as i64) as void {
    button.set_variant(t, b, button.FLAT);
    let is i64 as n = count(t, w);
    let is i32 as first with mut = 1;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as ch = item(t, w, i);
        if (ch != b && _roving(t, ch) == 1 && tree.is_focusable(t, ch) == 1) { first = 0; }
        i = i + 1;
    }
    tree.set_focusable(t, b, first);
}

// A flat button titled s — n bytes, an underscore before its mnemonic — at
// the end. Its handle, or 0.
fn add_button(t as *tree.Tree, w as i64, s as *u8, n as i64) as i64 {
    if (cast(i64, _data(t, w)) == 0) { return 0; }
    let is i64 as b = button.create(t, w, s, n);
    if (b == 0) { return 0; }
    _join(t, w, b);
    return b;
}

// The same, staying down until pressed again.
fn add_toggle(t as *tree.Tree, w as i64, s as *u8, n as i64) as i64 {
    let is i64 as b = add_button(t, w, s, n);
    if (b != 0) { button.set_toggle(t, b, 1); }
    return b;
}

fn add_separator(t as *tree.Tree, w as i64) as i64 {
    if (cast(i64, _data(t, w)) == 0) { return 0; }
    return separator.create(t, w, 1);
}

// How many of its tools are in the row: the rest are in its menu.
fn shown(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.shown;
}

fn overflowing(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.over;
}

// The button at its end that offers what does not fit.
fn more(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.more;
}

fn overflow_menu(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.menu;
}

// --- Measuring and arranging ---

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _rtl(t as *tree.Tree, w as i64) as i32 { return cast(i32, layout.direction(t, w) == layout.RTL); }

fn _pref(t as *tree.Tree, ch as i64) as geom.Size {
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, ch, &free, &s);
    return s;
}

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as h with mut = th.metrics.control_height;
    let is f64 as across with mut = 0.0;
    let is i64 as n = count(t, w);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is geom.Size as s = _pref(t, item(t, w, i));
        across = across + s.pref_w;
        h = _max(h, s.pref_h);
        i = i + 1;
    }
    geom.size_zero(out);
    out.pref_w = across;
    out.min_w = _max(0.0, th.metrics.control_height);
    out.pref_h = h;
    out.min_h = h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// Side by side from the start edge; when they do not all fit, as many as fit
// before the menu button at the end, the rest out of the row.
fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is i64 as n = count(t, w);
    let is f64 as all with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < n) {
        all = all + _pref(t, item(t, w, i)).pref_w;
        i = i + 1;
    }
    let is i32 as over = cast(i32, all > r.w + 0.001);
    let is f64 as mw = r.h;
    let is f64 as room with mut = r.w;
    if (over == 1) { room = r.w - mw; }
    if (over != d.over || tree.is_visible(t, d.more) != over) { tree.set_visible(t, d.more, over); }
    d.over = over;
    let is i32 as rtl = _rtl(t, w);
    let is f64 as x with mut = 0.0;
    let is i32 as full with mut = 0;
    d.shown = 0;
    i = 0;
    while (i < n) {
        let is i64 as ch = item(t, w, i);
        let is f64 as iw = _pref(t, ch).pref_w;
        if (full == 0 && x + iw > room + 0.001) { full = 1; }
        if (full == 1) {
            // Out of the row: far past its end, beyond its clip and the pointer.
            let is math.rect.Rect as away with mut = math.rect.rect(r.w + 10000.0, 0.0, iw, r.h);
            if (rtl == 1) { away.x = 0.0 - 10000.0 - iw; }
            layout.place(t, ch, &away);
        } else {
            let is math.rect.Rect as at with mut = math.rect.rect(x, 0.0, iw, r.h);
            if (rtl == 1) { at.x = r.w - x - iw; }
            layout.place(t, ch, &at);
            x = x + iw;
            d.shown = d.shown + 1;
        }
        i = i + 1;
    }
    if (over == 1) {
        let is math.rect.Rect as mr with mut = math.rect.rect(r.w - mw, 0.0, mw, r.h);
        if (rtl == 1) { mr.x = 0.0; }
        layout.place(t, d.more, &mr);
    }
    _keep_stop(t, w, d);
}

// The stop for Tab out of the row, on a menu button gone, or destroyed: the
// last button still in the row takes it, or the menu button when none is.
fn _keep_stop(t as *tree.Tree, w as i64, d as *Data) as void {
    if (d.over == 0) { tree.set_focusable(t, d.more, 0); }
    let is i32 as kept with mut = cast(i32, d.over == 1 && tree.is_focusable(t, d.more) == 1);
    let is i64 as n = count(t, w);
    let is i64 as last with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as ch = item(t, w, i);
        if (_roving(t, ch) == 1) {
            if (i >= d.shown) { tree.set_focusable(t, ch, 0); }
            if (i < d.shown) {
                last = ch;
                if (tree.is_focusable(t, ch) == 1) { kept = 1; }
            }
        }
        i = i + 1;
    }
    if (kept == 1) { return; }
    if (last != 0) {
        tree.set_focusable(t, last, 1);
    } else if (d.over == 1) {
        tree.set_focusable(t, d.more, 1);
    }
}

fn _more_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    geom.size_zero(out);
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// --- Moving among them ---

fn _usable(t as *tree.Tree, d as *Data, ch as i64, i as i64) as i32 {
    return cast(i32, _roving(t, ch) == 1 && tree.is_enabled(t, ch) == 1 && i < d.shown);
}

// The button at i — or, at d.shown, the menu button — takes the stop for
// Tab, and the focus.
fn _go(t as *tree.Tree, w as i64, d as *Data, i as i64) as void {
    let is i64 as n = count(t, w);
    let is i64 as k with mut = 0;
    while (k < n) {
        let is i64 as ch = item(t, w, k);
        if (_roving(t, ch) == 1) { tree.set_focusable(t, ch, cast(i32, k == i && i < d.shown)); }
        k = k + 1;
    }
    tree.set_focusable(t, d.more, cast(i32, i == d.shown));
    let is i64 as to with mut = item(t, w, i);
    if (i == d.shown) { to = d.more; }
    let is *router.Router as r = cast(*router.Router, tree.router(t));
    if (cast(i64, r) != 0) { router.focus(t, r, to, 1); }
}

fn _index(t as *tree.Tree, w as i64, ch as i64) as i64 {
    let is i64 as n = count(t, w);
    let is i64 as k with mut = 0;
    while (k < n) {
        if (item(t, w, k) == ch) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Data as d = cast(*Data, data);
    let is *router.Router as r = cast(*router.Router, tree.router(t));
    if (e.kind != event.KEY_DOWN || e.mods != 0 || cast(i64, r) == 0) { return 0; }
    let is i64 as f = router.focused(t, r);
    let is i64 as from with mut = _index(t, w, f);
    if (f == d.more && d.over == 1) { from = d.shown; }
    if (from < 0) { return 0; }
    // The stops: the tools in the row, then the menu button when there is one.
    let is i64 as stops with mut = d.shown;
    if (d.over == 1) { stops = d.shown + 1; }
    let is i64 as step with mut = 0;
    let is i64 as ahead with mut = 1;
    if (_rtl(t, w) == 1) { ahead = 0 - 1; }
    let is i64 as start with mut = from;
    if (e.key == keys.RIGHT) { step = ahead; }
    if (e.key == keys.LEFT) { step = 0 - ahead; }
    if (e.key == keys.HOME) {
        step = 1;
        start = 0 - 1;
    }
    if (e.key == keys.END) {
        step = 0 - 1;
        start = stops;
    }
    if (step == 0) { return 0; }
    let is i64 as k with mut = start + step;
    while (k >= 0 && k < stops) {
        if (k == d.shown || _usable(t, d, item(t, w, k), k) == 1) {
            _go(t, w, d, k);
            return 1;
        }
        k = k + step;
    }
    return 1;
}

// --- What does not fit ---

fn _chosen(t as *tree.Tree, m as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    let is i64 as it = item(d.t, d.self, *cast(*i64, arg));
    if (it != 0) { access.act(d.t, it, access.PRESS, 0.0); }
}

// Its menu, of what is out of the row now.
fn _offer(t as *tree.Tree, w as i64, d as *Data) as i32 {
    if (d.menu == 0 || tree.is_valid(t, d.menu) == 0) {
        d.menu = menu.create(t);
        if (d.menu == 0) { return 0; }
        signal.connect(t, d.menu, signal.ACTIVATED, fn_ptr(_chosen), cast(*u8, d));
    }
    while (tree.first_child(t, d.menu) != 0) { tree.destroy(t, tree.first_child(t, d.menu)); }
    let is i64 as n = count(t, w);
    let is i64 as i with mut = d.shown;
    while (i < n) {
        let is i64 as ch = item(t, w, i);
        if (_roving(t, ch) == 1) {
            let is i64 as l = button.content(t, ch);
            let is *u8 as s with mut = "";
            let is i64 as len with mut = 0;
            if (cast(i64, label.text(t, l)) != 0) {
                s = label.text(t, l);
                len = label.text_length(t, l);
            }
            let is i64 as mi with mut = 0;
            if (button.is_toggle(t, ch) == 1) {
                mi = menu.add_check(t, d.menu, s, len, i, button.is_active(t, ch));
            } else {
                mi = menu.add_item(t, d.menu, s, len, i);
            }
            if (mi != 0 && tree.is_enabled(t, ch) == 0) { tree.set_enabled(t, mi, 0); }
        } else {
            menu.add_separator(t, d.menu);
        }
        i = i + 1;
    }
    return 1;
}

fn _open(t as *tree.Tree, mw as i64, by_key as i32) as void {
    let is i64 as w = tree.parent(t, mw);
    let is *Data as d = cast(*Data, tree.data(t, w));
    let is *router.Router as r = cast(*router.Router, tree.router(t));
    if (cast(i64, r) == 0 || _offer(t, w, d) == 0) { return; }
    let is i32 as anchor with mut = positioner.BOTTOM_RIGHT;
    let is i32 as gravity with mut = positioner.BOTTOM_LEFT;
    if (_rtl(t, w) == 1) {
        anchor = positioner.BOTTOM_LEFT;
        gravity = positioner.BOTTOM_RIGHT;
    }
    menu.popup_at(t, r, d.menu, layout.window_rect(t, mw), anchor, gravity, by_key);
}

fn _more_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.kind == event.POINTER_DOWN && e.button == 1) {
        _open(t, w, 0);
        return 1;
    }
    if (e.kind == event.KEY_DOWN && e.phase == event.TARGET && e.mods == 0 &&
        (e.key == keys.SPACE || e.key == keys.RETURN || e.key == keys.DOWN)) {
        _open(t, w, 1);
        return 1;
    }
    return 0;
}

// Three dots.
fn _more_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is math.rect.Rect as r = p.rect;
    if ((p.state & painter.S_HOVER) != 0 || (p.state & painter.S_PRESSED) != 0) {
        shapes.fill_rect(p.canvas, r.x, r.y, r.w, r.h, style.with_alpha(p.theme.palette.fg, 0.08));
    }
    let is math.color.Color as ink with mut = p.fg;
    if (ink.a <= 0.0) { ink = p.theme.palette.fg; }
    let is f64 as dot = _max(1.5, r.h * 0.06);
    let is f64 as gap = dot * 3.0;
    let is f64 as cx = r.x + r.w / 2.0;
    let is f64 as cy = r.y + r.h / 2.0;
    shapes.fill_circle(p.canvas, cx - gap, cy, dot, ink);
    shapes.fill_circle(p.canvas, cx, cy, dot, ink);
    shapes.fill_circle(p.canvas, cx + gap, cy, dot, ink);
}

// --- Told ---

fn _access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    if (q.action == access.ASK) { q.states = q.states | access.HORIZONTAL; }
    return 1;
}

fn _more_access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    if (q.action == access.ASK) {
        q.actions = access.PRESS;
        return 1;
    }
    if (q.action == access.PRESS) { _open(t, w, 1); }
    return 1;
}
