// ui/widgets/titlebar.cst — a window's title bar, drawn by the toolkit.
//
// The program's widgets at its start (start()); the window's title — and a
// subtitle under it, when there is one — after them, from the start, cut with
// an ellipsis where there is no more room; the program's widgets at its end
// (end()); and the window's own buttons last, minimize, maximize and close,
// whichever set_buttons asks for. Everything mirrors in right to left.
//
// What the window does is asked of it through the tree (tree.window_op): its
// buttons minimize, maximize — or restore, once set_maximized says it is —
// and close; a drag on the bar's empty places moves the window, a double click
// maximizes it, and the right button opens the window's own menu where the
// pointer is. Drawn in the title bar's colour, its height the theme's; told as
// a title bar named by its title, its buttons named for what they do.
use "../../math/math.cst" as math;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../box.cst" as box;
use "label.cst" as label;

// The window's buttons, as button() names them.
let is i32 as MINIMIZE with imut = 1;
let is i32 as MAXIMIZE with imut = 2;
let is i32 as CLOSE    with imut = 3;

// Which of them it shows, for set_buttons: always in this order.
let is i32 as BTN_MINIMIZE with imut = 1;
let is i32 as BTN_MAXIMIZE with imut = 2;
let is i32 as BTN_CLOSE    with imut = 4;
let is i32 as BTN_ALL      with imut = 7;

let is f64 as _GAP   with imut = 6.0;    // between its buttons, and after the last
let is f64 as _GLYPH with imut = 10.0;   // a button's glyph, a side
let is f64 as _STROKE with imut = 1.25;

struct Data {
    start     as i64;
    end       as i64;
    title     as i64;
    subtitle  as i64;
    buttons   as [3]i64;   // the window's buttons, in order
    nbuttons  as i64;
    flags     as i32;      // BTN_* bits: which they are
    maximized as i32;
    radius    as f64;      // its top corners', as a window's frame has them
}

struct Btn {
    owner as i64;
    which as i32;
    _pad0 as i32;
}

let is tree.Kind as _kind with mut;
let is tree.Kind as _btn_kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("title bar", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.paint = fn_ptr(_paint);
    _kind.event = fn_ptr(_event);
    _kind.role = access.ROLE_TITLE_BAR;
    _btn_kind = widget.kind("window button", sizeof(Btn));
    _btn_kind.measure = fn_ptr(_btn_measure);
    _btn_kind.paint = fn_ptr(_btn_paint);
    _btn_kind.event = fn_ptr(_btn_event);
    _btn_kind.role = access.ROLE_BUTTON;
    _btn_kind.access = fn_ptr(_btn_access);
    _ready = 1;
}

// A new title bar, untitled, a close button at its end, as the last child of
// parent. Its handle, or 0.
fn create(t as *tree.Tree, parent as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.start = box.create(t, w, box.ROW);
    d.end = box.create(t, w, box.ROW);
    d.title = label.create(t, w, "", 0);
    d.subtitle = label.create(t, w, "", 0);
    if (d.start == 0 || d.end == 0 || d.title == 0 || d.subtitle == 0) {
        tree.destroy(t, w);
        return 0;
    }
    box.set_spacing(t, d.start, 6.0);
    box.set_spacing(t, d.end, 6.0);
    label.set_style(t, d.title, label.HEADING);
    label.set_lines(t, d.title, 1, 1);
    label.set_style(t, d.subtitle, label.CAPTION);
    label.set_lines(t, d.subtitle, 1, 1);
    tree.set_visible(t, d.subtitle, 0);
    tree.set_labelled_by(t, w, d.title);
    set_buttons(t, w, BTN_CLOSE);
    return w;
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

// Where the program's widgets go at its start, and at its end.
fn start(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.start;
}

fn end(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.end;
}

// Its title's label.
fn title(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.title;
}

fn set_title(t as *tree.Tree, w as i64, s as *u8, n as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    label.set_text(t, d.title, s, n);
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
}

// A line under the title; none for n 0.
fn set_subtitle(t as *tree.Tree, w as i64, s as *u8, n as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    label.set_text(t, d.subtitle, s, n);
    tree.set_visible(t, d.subtitle, cast(i32, n > 0));
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
}

// The window is maximized, or not: its button restores, or maximizes.
fn set_maximized(t as *tree.Tree, w as i64, on as i32) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    d.maximized = on;
    widget.changed(t, w, widget.CHANGED_PAINT);
}

fn is_maximized(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.maximized;
}

// Its top corners rounded by r, as the window's are when the toolkit draws
// its frame (decoration.cst); 0 for square.
fn set_rounding(t as *tree.Tree, w as i64, r as f64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0 || d.radius == r) { return; }
    d.radius = r;
    widget.changed(t, w, widget.CHANGED_PAINT);
}

// The window's button which (MINIMIZE, MAXIMIZE, CLOSE), 0 when it has none.
fn button(t as *tree.Tree, w as i64, which as i32) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (i < d.nbuttons) {
        if (cast(*Btn, tree.data(t, d.buttons[i])).which == which) { return d.buttons[i]; }
        i = i + 1;
    }
    return 0;
}

// Which of the window's buttons it shows: BTN_* bits, always minimize, then
// maximize, then close.
fn buttons(t as *tree.Tree, w as i64) as i32 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    return d.flags;
}

fn _make_btn(t as *tree.Tree, w as i64, which as i32) as i64 {
    let is i64 as b = tree.create(t, &_btn_kind, w);
    if (b == 0) { return 0; }
    let is *Btn as bd = cast(*Btn, tree.data(t, b));
    bd.owner = w;
    bd.which = which;
    return b;
}

fn _add(t as *tree.Tree, w as i64, d as *Data, which as i32) as void {
    let is i64 as b = _make_btn(t, w, which);
    if (b == 0) { return; }
    d.buttons[d.nbuttons] = b;
    d.nbuttons = d.nbuttons + 1;
}

// The window's buttons it shows: flags, BTN_* bits. A dialog has only
// BTN_CLOSE; a window of one size no BTN_MAXIMIZE.
fn set_buttons(t as *tree.Tree, w as i64, flags as i32) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    let is i32 as f = flags & BTN_ALL;
    if (f == d.flags && d.nbuttons > 0) { return; }
    let is i64 as k with mut = 0;
    while (k < d.nbuttons) {
        tree.destroy(t, d.buttons[k]);
        k = k + 1;
    }
    d.nbuttons = 0;
    d.flags = f;
    if ((f & BTN_MINIMIZE) != 0) { _add(t, w, d, MINIMIZE); }
    if ((f & BTN_MAXIMIZE) != 0) { _add(t, w, d, MAXIMIZE); }
    if ((f & BTN_CLOSE) != 0) { _add(t, w, d, CLOSE); }
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
}

// --- Measuring and arranging ---

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }
fn _min(a as f64, b as f64) as f64 { if (a < b) { return a; } return b; }

fn _pref(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &free, &s);
    return s;
}

fn _btn_size(th as *style.Theme) as f64 { return th.metrics.caption_button; }

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as pad = th.metrics.space_m;
    let is geom.Size as ss = _pref(t, d.start);
    let is geom.Size as es = _pref(t, d.end);
    let is geom.Size as ts = _pref(t, d.title);
    let is geom.Size as us = _pref(t, d.subtitle);
    let is f64 as buttons_w = cast(f64, d.nbuttons) * (_btn_size(&th) + _GAP);
    geom.size_zero(out);
    out.pref_w = pad + ss.pref_w + pad + _max(ts.pref_w, us.pref_w) + pad + es.pref_w + pad + buttons_w;
    out.min_w = pad + ss.min_w + es.min_w + pad + buttons_w;
    let is f64 as inner = _max(ss.pref_h, _max(es.pref_h, ts.pref_h + us.pref_h));
    out.pref_h = _max(th.metrics.titlebar_height, inner + 2.0 * th.metrics.space_xs);
    out.min_h = out.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = out.pref_h;
}

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as pad = th.metrics.space_m;
    let is f64 as bs = _btn_size(&th);
    let is i32 as rtl = cast(i32, layout.direction(t, w) == layout.RTL);
    // Along the line, from the start edge; mirrored as placed. The buttons
    // from the end, the last nearest it.
    let is f64 as x1 with mut = r.w - _GAP;
    let is f64 as by = (r.h - bs) / 2.0;
    let is i64 as i with mut = d.nbuttons - 1;
    while (i >= 0) {
        _put(t, d.buttons[i], x1 - bs, by, bs, bs, r.w, rtl);
        x1 = x1 - bs - _GAP;
        i = i - 1;
    }
    if (d.nbuttons > 0) { x1 = x1 - pad + _GAP; } else { x1 = r.w - pad; }
    let is f64 as x0 with mut = pad;
    let is geom.Size as ss = _pref(t, d.start);
    let is geom.Size as es = _pref(t, d.end);
    _put(t, d.start, x0, (r.h - ss.pref_h) / 2.0, ss.pref_w, ss.pref_h, r.w, rtl);
    if (ss.pref_w > 0.0) { x0 = x0 + ss.pref_w + pad; }
    _put(t, d.end, x1 - es.pref_w, (r.h - es.pref_h) / 2.0, es.pref_w, es.pref_h, r.w, rtl);
    if (es.pref_w > 0.0) { x1 = x1 - es.pref_w - pad; }
    // The title from where the start's widgets end, cut to what is left.
    let is geom.Size as ts = _pref(t, d.title);
    let is geom.Size as us = _pref(t, d.subtitle);
    let is f64 as room = _max(0.0, x1 - x0);
    let is f64 as th2 = ts.pref_h + us.pref_h;
    let is f64 as ty = (r.h - th2) / 2.0;
    _put(t, d.title, x0, ty, _min(ts.pref_w, room), ts.pref_h, r.w, rtl);
    _put(t, d.subtitle, x0, ty + ts.pref_h, _min(us.pref_w, room), us.pref_h, r.w, rtl);
}

// ch at x along the line from the start edge — from the right in right to
// left — y down, w by h.
fn _put(t as *tree.Tree, ch as i64, x as f64, y as f64, w as f64, h as f64, across as f64, rtl as i32) as void {
    let is math.rect.Rect as at with mut = math.rect.rect(x, y, w, h);
    if (rtl == 1) { at.x = across - x - w; }
    layout.place(t, ch, &at);
}

fn _btn_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as s = _btn_size(&th);
    geom.size_zero(out);
    out.min_w = s;
    out.pref_w = s;
    out.min_h = s;
    out.pref_h = s;
    out.max_w = s;
    out.max_h = s;
}

// --- Asking the window ---

fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.kind == event.POINTER_DOWN && e.button == 1) {
        if (e.clicks == 2) { tree.window_op(t, tree.WIN_MAXIMIZE, e.x, e.y); }
        return 1;
    }
    if (e.kind == event.DRAG_START) {
        tree.window_op(t, tree.WIN_MOVE, e.x, e.y);
        return 1;
    }
    if (e.kind == event.CONTEXT_MENU && e.button == 3) {
        tree.window_op(t, tree.WIN_MENU, e.x, e.y);
        return 1;
    }
    return 0;
}

fn _op(which as i32) as i32 {
    if (which == MINIMIZE) { return tree.WIN_MINIMIZE; }
    if (which == MAXIMIZE) { return tree.WIN_MAXIMIZE; }
    return tree.WIN_CLOSE;
}

fn _btn_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Btn as b = cast(*Btn, data);
    if (e.kind == event.POINTER_DOWN && e.button == 1) { return 1; }
    if (e.kind == event.POINTER_UP && e.button == 1) {
        let is math.rect.Rect as r = layout.rect(t, w);
        if (e.local_x >= 0.0 && e.local_x < r.w && e.local_y >= 0.0 && e.local_y < r.h) {
            tree.window_op(t, _op(b.which), e.x, e.y);
        }
        return 1;
    }
    return 0;
}

// --- Drawn ---

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Data as d = cast(*Data, data);
    let is *style.Theme as th = p.theme;
    let is f64 as rr = d.radius;
    shapes.fill_rounded(p.canvas, p.rect.x, p.rect.y, p.rect.w, p.rect.h, rr, rr, 0.0, 0.0, th.palette.titlebar_bg);
    if ((p.state & painter.S_BACKDROP) != 0) { p.fg = th.palette.fg_dim; } else { p.fg = th.palette.fg; }
}

// A square of the theme's corners, filled only under the pointer — the close
// button in the destructive colour — and its glyph stroked in the middle: a
// line, a square, two squares once the window is maximized, a cross.
fn _btn_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Btn as b = cast(*Btn, data);
    let is *Data as d = cast(*Data, tree.data(t, b.owner));
    let is *style.Theme as th = p.theme;
    let is math.rect.Rect as r = p.rect;
    let is math.color.Color as ink with mut = th.palette.fg;
    if ((p.state & painter.S_BACKDROP) != 0) { ink = th.palette.fg_dim; }
    let is i32 as lit = cast(i32, (p.state & (painter.S_HOVER | painter.S_PRESSED)) != 0);
    let is f64 as rad = th.metrics.radius_m;
    if (b.which == CLOSE && lit == 1) {
        let is math.color.Color as fill with mut = th.palette.destructive;
        if ((p.state & painter.S_PRESSED) != 0) { fill = style.mix(fill, th.palette.fg, 0.15); }
        shapes.fill_rounded(p.canvas, r.x, r.y, r.w, r.h, rad, rad, rad, rad, fill);
        ink = th.palette.destructive_fg;
    } else if ((p.state & painter.S_PRESSED) != 0) {
        shapes.fill_rounded(p.canvas, r.x, r.y, r.w, r.h, rad, rad, rad, rad, style.with_alpha(th.palette.fg, 0.14));
    } else if (lit == 1) {
        shapes.fill_rounded(p.canvas, r.x, r.y, r.w, r.h, rad, rad, rad, rad, style.with_alpha(th.palette.fg, 0.08));
    }
    let is f64 as h = _GLYPH / 2.0;
    let is f64 as cx = r.x + r.w / 2.0;
    let is f64 as cy = r.y + r.h / 2.0;
    if (b.which == CLOSE) {
        shapes.line(p.canvas, cx - h, cy - h, cx + h, cy + h, _STROKE, ink);
        shapes.line(p.canvas, cx - h, cy + h, cx + h, cy - h, _STROKE, ink);
    } else if (b.which == MINIMIZE) {
        shapes.line(p.canvas, cx - h, cy, cx + h, cy, _STROKE, ink);
    } else if (d.maximized == 1) {
        // The window behind: its top and far side, past the one in front.
        let is f64 as off = 2.5;
        shapes.line(p.canvas, cx - h + off, cy - h, cx + h, cy - h, _STROKE, ink);
        shapes.line(p.canvas, cx + h, cy - h, cx + h, cy + h - off, _STROKE, ink);
        shapes.stroke_rounded(p.canvas, cx - h, cy - h + off, _GLYPH - off, _GLYPH - off, 1.0, 1.0, 1.0, 1.0, _STROKE, ink);
    } else {
        shapes.stroke_rounded(p.canvas, cx - h, cy - h, _GLYPH, _GLYPH, 1.0, 1.0, 1.0, 1.0, _STROKE, ink);
    }
}

// --- Told ---

fn _btn_access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Btn as b = cast(*Btn, data);
    let is *Data as d = cast(*Data, tree.data(t, b.owner));
    if (q.action == access.ASK) {
        q.actions = access.PRESS;
        // Named in the tree's language.
        let is i64 as word with mut = strings.MAXIMIZE;
        if (b.which == CLOSE) {
            word = strings.CLOSE_WINDOW;
        } else if (b.which == MINIMIZE) {
            word = strings.MINIMIZE;
        } else if (d.maximized == 1) {
            word = strings.RESTORE;
        }
        q.name = strings.of(t, word, &q.name_len);
        return 1;
    }
    if (q.action == access.PRESS) {
        let is math.rect.Rect as wr = layout.window_rect(t, w);
        tree.window_op(t, _op(b.which), wr.x + wr.w / 2.0, wr.y + wr.h / 2.0);
    }
    return 1;
}
