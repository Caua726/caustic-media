// ui/widgets/tabs_test.cst — tabs: pages one at a time under a strip of tabs,
// each tab its page's title; chosen by the pointer, by the arrows along the
// strip, by Ctrl and Page Up or Down or Tab from inside a page, by a mnemonic,
// by assistive technology; closed from a button on the tab; scrolled when
// there are more than fit; drawn with the chosen one underlined; told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "label.cst" as label;
use "button.cst" as button;
use "../event.cst" as event;
use "../scroll.cst" as scroll;
use "tabs.cst" as tabs;

let is i64 as W with imut = 400;
let is i64 as H with imut = 240;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

let is i64 as changes with mut = 0;
let is i64 as closing with mut = 0 - 1;

fn on_change(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { changes = changes + 1; }
fn on_close(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { closing = *cast(*i64, arg); }

// What bubbles out of them: presses, keys and wheels they do not take.
let is i64 as caught with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase == event.BUBBLE && (e.kind == event.KEY_DOWN || e.kind == event.POINTER_DOWN || e.kind == event.SCROLL)) {
        caught = caught + 1;
        return 1;
    }
    return 0;
}

fn catch_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catch_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as catcher with mut;

fn measure(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

// Tabs filling a window w by h at its top left, three pages.
fn three(t as *tree.Tree, w as f64, h as f64) as i64 {
    let is i64 as tb = tabs.create(t, tree.root(t));
    layout.set_align(t, tb, layout.START, layout.START);
    layout.set_min_size(t, tb, w, h);
    layout.set_max_size(t, tb, w, h);
    tabs.add(t, tb, "_One", 4);
    tabs.add(t, tb, "_Two", 4);
    tabs.add(t, tb, "Th_ree", 6);
    signal.connect(t, tb, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    signal.connect(t, tb, signal.CLOSED, fn_ptr(on_close), cast(*u8, 0));
    return tb;
}

fn made() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as tb with mut = tabs.create(&t, tree.root(&t));
    check("tabs: none yet", tb != 0 && tabs.count(&t, tb) == 0 && tabs.current(&t, tb) == 0 - 1);
    tree.destroy(&t, tb);
    tb = three(&t, 300.0, 200.0);
    let is i64 as p0 = tabs.page(&t, tb, 0);
    let is i64 as p1 = tabs.page(&t, tb, 1);
    check("three pages, the first current", tabs.count(&t, tb) == 3 && tabs.current(&t, tb) == 0 && p0 != 0 && p1 != 0 &&
          tree.is_visible(&t, p0) == 1 && tree.is_visible(&t, p1) == 0);
    check("each tab titled, its mnemonic taken out", label.text_length(&t, tabs.title(&t, tb, 1)) == 3 &&
          label.mnemonic(&t, tabs.title(&t, tb, 1)) == 84);
    changes = 0;
    check("another made current", tabs.set_current(&t, tb, 1) == 1 && tabs.current(&t, tb) == 1 && changes == 1 &&
          tree.is_visible(&t, p1) == 1 && tree.is_visible(&t, p0) == 0);
    check("the same again: nothing", tabs.set_current(&t, tb, 1) == 0 && changes == 1);
    check("one that is not there: nothing", tabs.set_current(&t, tb, 7) == 0 && tabs.set_current(&t, tb, 3) == 0 &&
          tabs.set_current(&t, tb, 0 - 1) == 0 && tabs.current(&t, tb) == 1 && tabs.remove(&t, tb, 3) == 0 &&
          tabs.remove(&t, tb, 0 - 1) == 0 && tabs.count(&t, tb) == 3);
    // As tall as its strip and its largest page.
    let is i64 as free = tabs.create(&t, tree.root(&t));
    tabs.add(&t, free, "A", 1);
    let is i64 as fp = tabs.add(&t, free, "B", 1);
    let is i64 as bigger = button.create(&t, fp, "Big", 3);
    layout.set_min_size(&t, bigger, 50.0, 90.0);
    let is geom.Size as ms = measure(&t, free);
    let is geom.Size as ss = measure(&t, tabs.strip(&t, free));
    check("as tall as its strip and its largest page", near(ms.min_h, ss.pref_h + 90.0) == 1 && near(ms.pref_h, ss.pref_h + 90.0) == 1);
    let is i64 as fq = tabs.add(&t, free, "Q", 1);
    let is i64 as sa = scroll.create(&t, fq);
    let is i64 as tall = button.create(&t, sa, "Tall", 4);
    layout.set_min_size(&t, tall, 50.0, 150.0);
    let is geom.Size as ms2 = measure(&t, free);
    check("a page liking more than it needs: so does it", near(ms2.pref_h, ss.pref_h + 150.0) == 1 &&
          near(ms2.min_h, ss.pref_h + 90.0) == 1);
    tabs.remove(&t, free, 2);
    // One before the current taken away: the same page still current.
    let is i64 as extra = tabs.add(&t, free, "C", 1);
    tabs.set_current(&t, free, 2);
    tabs.remove(&t, free, 0);
    check("one before it taken: the same page, its place one less", tabs.current(&t, free) == 1 && tabs.page(&t, free, 1) == extra);
    tree.destroy(&t, free);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as r0 = layout.window_rect(&t, tabs.tab(&t, tb, 0));
    let is math.rect.Rect as r1 = layout.window_rect(&t, tabs.tab(&t, tb, 1));
    let is math.rect.Rect as pr = layout.window_rect(&t, p1);
    check("the tabs along the top, one after another", r0.y == 0.0 && r0.x == 0.0 && r1.x >= r0.x + r0.w - 0.01 &&
          r0.h >= theme.metrics.control_height);
    check("the page under them, the rest of it", near(pr.y, r0.h) == 1 && near(pr.h, 200.0 - r0.h) == 1 && pr.w == 300.0);
    tabs.set_side(&t, tb, tabs.BOTTOM);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as b0 = layout.window_rect(&t, tabs.tab(&t, tb, 0));
    check("the tabs along the bottom", near(b0.y + b0.h, 200.0) == 1 && layout.window_rect(&t, p1).y == 0.0);
    tabs.set_side(&t, tb, tabs.TOP);
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as l0 = layout.window_rect(&t, tabs.tab(&t, tb, 0));
    let is math.rect.Rect as l1 = layout.window_rect(&t, tabs.tab(&t, tb, 1));
    let is math.rect.Rect as wr = layout.window_rect(&t, tb);
    check("right to left: the first on the right", near(l0.x + l0.w, wr.x + wr.w) == 1 && l1.x + l1.w <= l0.x + 0.01);
    layout.set_direction(&t, tb, layout.LTR);
    // Taken away: the current one the next, or the last.
    tabs.set_current(&t, tb, 2);
    check("taken away", tabs.remove(&t, tb, 2) == 1 && tabs.count(&t, tb) == 2 && tabs.current(&t, tb) == 1 &&
          tree.is_valid(&t, tabs.page(&t, tb, 1)) == 1);
    tabs.set_current(&t, tb, 0);
    tabs.remove(&t, tb, 0);
    check("the first taken: the next current, and shown", tabs.count(&t, tb) == 1 && tabs.current(&t, tb) == 0 &&
          label.text_length(&t, tabs.title(&t, tb, 0)) == 3 && tree.is_visible(&t, tabs.page(&t, tb, 0)) == 1 &&
          tree.is_focusable(&t, tabs.tab(&t, tb, 0)) == 1);
    tabs.remove(&t, tb, 0);
    check("the last taken: none", tabs.count(&t, tb) == 0 && tabs.current(&t, tb) == 0 - 1);
    let is i64 as root = tree.root(&t);
    check("not tabs: nothing", tabs.current(&t, root) == 0 - 1 && tabs.page(&t, root, 0) == 0 && tabs.tab(&t, root, 0) == 0 &&
          tabs.title(&t, root, 0) == 0 && tabs.strip(&t, root) == 0 && tabs.overflowing(&t, root) == 0 &&
          tabs.arrow_rect(&t, root, 0).w == 0.0 && tabs.close_rect(&t, root, 0).w == 0.0);
    tree.close(&t);
}

fn pointed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as tb = three(&t, 300.0, 200.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as t2 = tabs.tab(&t, tb, 2);
    changes = 0;
    router.pointer_button(&t, &r, 3, 1, mid_x(&t, tabs.tab(&t, tb, 1)), mid_y(&t, tabs.tab(&t, tb, 1)), 5);
    router.pointer_button(&t, &r, 3, 0, mid_x(&t, tabs.tab(&t, tb, 1)), mid_y(&t, tabs.tab(&t, tb, 1)), 6);
    check("the right button on a tab: nothing", tabs.current(&t, tb) == 0 && changes == 0);
    let is i64 as outside = button.create(&t, tree.root(&t), "Out", 3);
    layout.set_align(&t, outside, layout.END, layout.END);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, outside, 1);
    click(&t, &r, mid_x(&t, t2), mid_y(&t, t2), 10);
    check("a tab clicked: its page, the focus where it was", tabs.current(&t, tb) == 2 && changes == 1 &&
          router.focused(&t, &r) == outside);
    // A closable tab: its button asks, the program decides.
    let is f64 as plain_w = layout.window_rect(&t, tabs.tab(&t, tb, 1)).w;
    tabs.set_closable(&t, tb, 1, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as cb = tabs.close_rect(&t, tb, 1);
    let is math.rect.Rect as t1r = layout.window_rect(&t, tabs.tab(&t, tb, 1));
    check("closable: a button on the tab, at its end", cb.w > 0.0 && tabs.close_rect(&t, tb, 0).w == 0.0 &&
          near(t1r.w, plain_w + theme.metrics.space_s + theme.fonts.body.size) == 1 &&
          near(cb.x + cb.w, t1r.x + t1r.w - theme.metrics.control_pad_x) == 1 &&
          near(cb.y + cb.h / 2.0, t1r.y + t1r.h / 2.0) == 1);
    closing = 0 - 1;
    changes = 0;
    click(&t, &r, cb.x + cb.w / 2.0, cb.y + cb.h / 2.0, 20);
    check("its button: asked to close it, nothing else", closing == 1 && tabs.count(&t, tb) == 3 && changes == 0 &&
          tabs.current(&t, tb) == 2);
    closing = 0 - 1;
    let is i64 as close1 = tree.last_child(&t, tabs.tab(&t, tb, 1));
    check("its button pressed by assistive technology: asked too", access.act(&t, close1, access.PRESS, 0.0) == 1 && closing == 1);
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as cb2 = tabs.close_rect(&t, tb, 1);
    let is math.rect.Rect as t1l = layout.window_rect(&t, tabs.tab(&t, tb, 1));
    let is math.rect.Rect as l1l = layout.window_rect(&t, tabs.title(&t, tb, 1));
    check("right to left: the close button at the left, the title at the right",
          near(cb2.x, t1l.x + theme.metrics.control_pad_x) == 1 &&
          near(l1l.x + l1l.w, t1l.x + t1l.w - theme.metrics.control_pad_x) == 1);
    layout.set_direction(&t, tb, layout.LTR);
    tabs.set_closable(&t, tb, 1, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("not closable again: its button gone", tabs.close_rect(&t, tb, 1).w == 0.0 &&
          near(layout.window_rect(&t, tabs.tab(&t, tb, 1)).w, plain_w) == 1);
    tree.close(&t);
}

fn keyed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as tb = three(&t, 300.0, 200.0);
    let is i64 as inside = button.create(&t, tabs.page(&t, tb, 0), "In", 2);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("only the current tab takes the focus", tree.is_focusable(&t, tabs.tab(&t, tb, 0)) == 1 &&
          tree.is_focusable(&t, tabs.tab(&t, tb, 1)) == 0);
    router.focus(&t, &r, tabs.tab(&t, tb, 0), 1);
    key(&t, &r, keys.RIGHT, 0, 10);
    check("right: the next, chosen and focused", tabs.current(&t, tb) == 1 && router.focused(&t, &r) == tabs.tab(&t, tb, 1) &&
          tree.is_focusable(&t, tabs.tab(&t, tb, 0)) == 0);
    key(&t, &r, keys.END, 0, 20);
    check("end: the last", tabs.current(&t, tb) == 2);
    key(&t, &r, keys.RIGHT, 0, 30);
    check("right at the last: there still", tabs.current(&t, tb) == 2);
    key(&t, &r, keys.HOME, 0, 40);
    check("home: the first", tabs.current(&t, tb) == 0 && router.focused(&t, &r) == tabs.tab(&t, tb, 0));
    key(&t, &r, keys.LEFT, 0, 50);
    check("left at the first: there still", tabs.current(&t, tb) == 0);
    // From inside a page.
    router.focus(&t, &r, inside, 1);
    key(&t, &r, keys.PAGE_DOWN, keys.MOD_CONTROL, 60);
    check("control and page down from inside a page: the next", tabs.current(&t, tb) == 1);
    key(&t, &r, keys.TAB, keys.MOD_CONTROL, 70);
    check("control and tab: the next", tabs.current(&t, tb) == 2);
    key(&t, &r, keys.PAGE_DOWN, keys.MOD_CONTROL, 80);
    check("and on round to the first", tabs.current(&t, tb) == 0);
    key(&t, &r, keys.PAGE_UP, keys.MOD_CONTROL, 90);
    check("control and page up: back round to the last", tabs.current(&t, tb) == 2);
    key(&t, &r, keys.TAB, keys.MOD_CONTROL | keys.MOD_SHIFT, 100);
    check("control, shift and tab: the one before", tabs.current(&t, tb) == 1);
    // Mnemonics.
    tabs.bind_mnemonics(&t, &r, tb);
    key(&t, &r, keys.R, keys.MOD_ALT, 110);
    check("alt and its letter: that one, focused", tabs.current(&t, tb) == 2 && router.focused(&t, &r) == tabs.tab(&t, tb, 2));
    key(&t, &r, keys.T, keys.MOD_ALT, 120);
    check("each one's", tabs.current(&t, tb) == 1);
    // Right to left: the arrows the other way.
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, tabs.tab(&t, tb, 1), 1);
    key(&t, &r, keys.LEFT, 0, 130);
    check("right to left: left is the next", tabs.current(&t, tb) == 2);
    key(&t, &r, keys.RIGHT, 0, 140);
    check("and right the one before", tabs.current(&t, tb) == 1);
    layout.set_direction(&t, tb, layout.LTR);
    tree.close(&t);
    // What they do not take goes on.
    let is tree.Tree as t2 = tree_for();
    let is router.Router as r2 = router.init(router.settings_default());
    tree.set_router(&t2, cast(*u8, &r2));
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t2, &catcher, tree.root(&t2));
    let is i64 as tb2 = tabs.create(&t2, holder);
    layout.set_align(&t2, tb2, layout.START, layout.START);
    layout.set_min_size(&t2, tb2, 300.0, 200.0);
    layout.set_max_size(&t2, tb2, 300.0, 200.0);
    tabs.add(&t2, tb2, "One", 3);
    tabs.add(&t2, tb2, "Two", 3);
    let is i64 as in2 = button.create(&t2, tabs.page(&t2, tb2, 0), "In", 2);
    layout.run(&t2, cast(f64, W), cast(f64, H));
    router.focus(&t2, &r2, tabs.tab(&t2, tb2, 0), 1);
    caught = 0;
    key(&t2, &r2, keys.RIGHT, 0, 10);
    key(&t2, &r2, keys.HOME, 0, 20);
    check("its arrows its own", caught == 0 && tabs.current(&t2, tb2) == 0);
    key(&t2, &r2, keys.X, 0, 30);
    check("a key it has no use for: on up, nothing chosen", caught == 1 && tabs.current(&t2, tb2) == 0);
    router.focus(&t2, &r2, in2, 1);
    caught = 0;
    key(&t2, &r2, keys.PAGE_DOWN, keys.MOD_CONTROL, 40);
    check("control and page down: its own", caught == 0 && tabs.current(&t2, tb2) == 1);
    router.focus(&t2, &r2, tabs.tab(&t2, tb2, 1), 1);
    caught = 0;
    key(&t2, &r2, keys.X, keys.MOD_CONTROL, 50);
    key(&t2, &r2, keys.Y, 0, 60);
    check("control and another key, or a plain one: on up", caught == 2);
    caught = 0;
    let is math.rect.Rect as tr0 = layout.window_rect(&t2, tabs.tab(&t2, tb2, 0));
    click(&t2, &r2, tr0.x + tr0.w / 2.0, tr0.y + tr0.h / 2.0, 70);
    check("a press on a tab: its own", caught == 0 && tabs.current(&t2, tb2) == 0);
    router.scroll(&t2, &r2, tr0.x + tr0.w / 2.0, tr0.y + tr0.h / 2.0, 0.0, 1.0, 1, 80);
    check("the wheel over tabs that all fit: on up", caught == 1);
    tree.close(&t2);
}

fn overflowing() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t, &catcher, tree.root(&t));
    let is i64 as tb = tabs.create(&t, holder);
    layout.set_align(&t, tb, layout.START, layout.START);
    layout.set_min_size(&t, tb, 200.0, 150.0);
    layout.set_max_size(&t, tb, 200.0, 150.0);
    let is i64 as i with mut = 0;
    while (i < 10) {
        tabs.add(&t, tb, "Page", 4);
        i = i + 1;
    }
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("more than fit: arrows at its ends", tabs.overflowing(&t, tb) == 1 && tabs.arrow_rect(&t, tb, 0).w > 0.0 &&
          tabs.arrow_rect(&t, tb, 1).x + tabs.arrow_rect(&t, tb, 1).w <= 200.01);
    tabs.set_current(&t, tb, 9);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as last = layout.window_rect(&t, tabs.tab(&t, tb, 9));
    let is math.rect.Rect as right = tabs.arrow_rect(&t, tb, 1);
    check("the last chosen: brought into view, before the arrow", last.x + last.w <= right.x + 0.01 && last.x >= tabs.arrow_rect(&t, tb, 0).w - 0.01);
    let is f64 as x9 = last.x;
    let is math.rect.Rect as left = tabs.arrow_rect(&t, tb, 0);
    click(&t, &r, left.x + left.w / 2.0, left.y + left.h / 2.0, 10);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the arrow back: the tabs moved on", layout.window_rect(&t, tabs.tab(&t, tb, 9)).x > x9 && tabs.current(&t, tb) == 9);
    router.scroll(&t, &r, 100.0, left.y + left.h / 2.0, 1.0, 0.0, 1, 20);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the wheel across over them: on again", near(layout.window_rect(&t, tabs.tab(&t, tb, 9)).x, x9) == 1);
    caught = 0;
    router.scroll(&t, &r, 100.0, left.y + left.h / 2.0, 0.0, 1.0, 1, 25);
    check("the wheel at their end: on up", caught == 1);
    check("the arrow back pressed by assistive technology", access.act(&t, tabs.strip(&t, tb) + 0, access.ASK, 0.0) == 0);
    let is i64 as back_arrow = tree.first_child(&t, tabs.strip(&t, tb));
    access.act(&t, back_arrow, access.PRESS, 0.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("and the tabs moved on", layout.window_rect(&t, tabs.tab(&t, tb, 9)).x > x9);
    tabs.set_current(&t, tb, 5);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as mid = layout.window_rect(&t, tabs.tab(&t, tb, 5));
    check("one in the middle chosen: in view", mid.x >= left.x + left.w - 0.01 && mid.x + mid.w <= right.x + 0.01);
    tabs.set_current(&t, tb, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the first chosen: in view", near(layout.window_rect(&t, tabs.tab(&t, tb, 0)).x, left.x + left.w) == 1);
    tabs.set_current(&t, tb, 5);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as mid2 = layout.window_rect(&t, tabs.tab(&t, tb, 5));
    check("then one further on: brought in from the right", near(mid2.x + mid2.w, right.x) == 1);
    // Room for them all: no arrows.
    layout.set_min_size(&t, tb, 390.0, 150.0);
    layout.set_max_size(&t, tb, 390.0, 150.0);
    i = 0;
    while (i < 6) {
        tabs.remove(&t, tb, 0);
        i = i + 1;
    }
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("room for them all: no arrows", tabs.overflowing(&t, tb) == 0 && tabs.arrow_rect(&t, tb, 0).w == 0.0 &&
          layout.window_rect(&t, tabs.tab(&t, tb, 0)).x == 0.0);
    tree.close(&t);
}

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    frame_router = &r;
    let is i64 as tb = three(&t, 300.0, 200.0);
    frame(&t, c);
    let is math.rect.Rect as r0 = layout.window_rect(&t, tabs.tab(&t, tb, 0));
    let is math.rect.Rect as r1 = layout.window_rect(&t, tabs.tab(&t, tb, 1));
    check("the chosen tab underlined in the accent", is8(cast(i64, r0.x + r0.w / 2.0), cast(i64, r0.y + r0.h - 1.0), theme.palette.accent, 2) == 1);
    check("the others not", is8(cast(i64, r1.x + r1.w / 2.0), cast(i64, r1.y + r1.h - 1.0), theme.palette.accent, 40) == 0);
    check("the chosen one's title in the text's colour, the others' dimmer",
          is8(ink_x(&t, tabs.title(&t, tb, 0)), ink_y(&t, tabs.title(&t, tb, 0)), theme.palette.fg, 24) == 1 &&
          is8(ink_x(&t, tabs.title(&t, tb, 1)), ink_y(&t, tabs.title(&t, tb, 1)), theme.palette.fg_dim, 24) == 1);
    router.pointer_move(&t, &r, r1.x + 3.0, r1.y + 3.0, 10);
    frame(&t, c);
    check("the pointer over a tab: lit", is8(cast(i64, r1.x + 3.0), cast(i64, r1.y + 3.0), theme.palette.window_bg, 1) == 0);
    tabs.set_side(&t, tb, tabs.BOTTOM);
    frame(&t, c);
    let is math.rect.Rect as b0 = layout.window_rect(&t, tabs.tab(&t, tb, 0));
    check("along the bottom: underlined on top", is8(cast(i64, b0.x + b0.w / 2.0), cast(i64, b0.y), theme.palette.accent, 2) == 1);
    frame_router = cast(*router.Router, 0);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as tb = three(&t, 300.0, 200.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is tree.Access as q;
    access.describe(&t, &r, tabs.strip(&t, tb), &q);
    check("told: its strip a list of tabs", q.role == access.ROLE_TAB_LIST);
    access.describe(&t, &r, tabs.tab(&t, tb, 0), &q);
    check("each a tab named by its title, the chosen one selected", q.role == access.ROLE_TAB &&
          (q.states & access.SELECTABLE) != 0 && (q.states & access.SELECTED) != 0 && q.name_len == 3 &&
          (q.actions & access.SELECT) != 0);
    access.describe(&t, &r, tabs.tab(&t, tb, 1), &q);
    check("the others not selected", (q.states & access.SELECTED) == 0);
    check("chosen by assistive technology", access.act(&t, tabs.tab(&t, tb, 1), access.SELECT, 0.0) == 1 &&
          tabs.current(&t, tb) == 1);
    check("not tabs: nothing", tabs.count(&t, tree.root(&t)) == 0 && tabs.add(&t, tree.root(&t), "x", 1) == 0 &&
          tabs.page(&t, tb, 9) == 0 && tabs.tab(&t, tb, 0 - 1) == 0);
    tree.close(&t);
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    made();
    pointed();
    keyed();
    overflowing();
    drawn(&c);
    told();

    if (fails == 0) {
        io.printf("tabs: %d checks passed\n", checks);
        return 0;
    }
    io.printf("tabs: %d of %d checks failed\n", fails, checks);
    return 1;
}
