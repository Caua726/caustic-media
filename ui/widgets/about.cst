// ui/widgets/about.cst — what a program is: its name and version, what it
// does, where it lives, who made it, and its licence.
//
// An about dialog (create) shows down its middle the program's image when it
// has one (set_logo), its name in the title's text, its version, a line of
// what it does, a link to its website and its copyright, small — each only
// once it is said. Credits and License, at the start of its foot once there
// are credits or a licence, show in their place who made it — sections of
// names, a name a line — and the licence's text, each in a scroll area;
// pressed again, or the other, they go back or across. Close, or Escape,
// hides it, back on its first page for the next time.
use "std/mem.cst" as mem;
use "../../math/math.cst" as math;
use "../../text/layout/model.cst" as tmodel;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../stack.cst" as stack;
use "../scroll.cst" as scroll;
use "../text.cst" as txt;
use "label.cst" as label;
use "button.cst" as button;
use "image.cst" as image;
use "dialog.cst" as dialog;

// Its pages.
let is i32 as MAIN    with imut = 0;
let is i32 as CREDITS with imut = 1;
let is i32 as LICENSE with imut = 2;

// The answers of its two secondary buttons.
let is i64 as CREDITS_ANSWER with imut = 101;
let is i64 as LICENSE_ANSWER with imut = 102;

let is i64 as MAX_CREDITS with imut = 8192;
let is i64 as MAX_SECTIONS with imut = 16;

// What does not fit a widget's data: the credits as one text, its headings
// in bold.
struct Side {
    text   as [8192]u8;
    n      as i64;
    spans  as [16]tmodel.Span;
    ns     as i64;
    styles as [2]txt.Style;
    name   as [128]u8;   // the program's, for its logo's description
    name_n as i64;
}

struct Data {
    t       as *tree.Tree;
    self    as i64;
    dlg     as i64;
    pages   as i64;
    main    as i64;
    cpage   as i64;
    lpage   as i64;
    logo    as i64;
    name    as i64;
    version as i64;
    comments as i64;
    website as i64;
    copyright as i64;
    credits as i64;
    license as i64;
    side    as *Side;
    page    as i32;
    _pad0   as i32;
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("about", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.destroy = fn_ptr(_destroy);
    _ready = 1;
}

// The about of dialog a; null for none.
fn _of(t as *tree.Tree, a as i64) as *Data {
    let is i64 as c = dialog.content(t, a);
    if (c == 0) { return cast(*Data, 0); }
    let is i64 as w = tree.first_child(t, c);
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

fn _centred(t as *tree.Tree, w as i64) as i64 {
    layout.set_align(t, w, layout.CENTER, layout.START);
    return w;
}

fn _label(t as *tree.Tree, parent as i64, role as i64) as i64 {
    let is i64 as l = label.create(t, parent, "", 0);
    if (l == 0) { return 0; }
    label.set_style(t, l, role);
    label.set_wrap(t, l, 1);
    label.set_align(t, l, tmodel.ALIGN_CENTER);
    tree.set_visible(t, l, 0);
    return _centred(t, l);
}

// A new about dialog for the program named s, n bytes, titled "About" and
// its name in the tree's language; hidden. Its handle — the dialog's — or 0.
fn create(t as *tree.Tree, s as *u8, n as i64) as i64 {
    _init();
    let is [160]u8 as title;
    let is i64 as k = strings.fits(s, n, 128);
    let is i64 as tn = strings.fill(tree.language(t), strings.ABOUT, s, k, "", 0, cast(*u8, &title), 160);
    let is i64 as a = dialog.create(t, cast(*u8, &title), tn);
    if (a == 0) { return 0; }
    let is i64 as w = tree.create(t, &_kind, dialog.content(t, a));
    let is *u8 as p = mem.core.mmap_anon(sizeof(Side));
    if (w == 0 || cast(i64, p) <= 0) {
        tree.destroy(t, a);
        return 0;
    }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.t = t;
    d.self = w;
    d.dlg = a;
    d.side = cast(*Side, p);
    let is *Side as g = d.side;
    mem.memcpy(cast(*u8, &g.name), s, k);
    g.name_n = k;
    g.styles[0].family = cast(*u8, 0);
    g.styles[1].family = cast(*u8, 0);
    g.styles[1].weight = 700;
    d.pages = stack.create(t, w);
    d.main = box.create(t, d.pages, box.COLUMN);
    d.cpage = scroll.create(t, d.pages);
    d.lpage = scroll.create(t, d.pages);
    if (d.pages == 0 || d.main == 0 || d.cpage == 0 || d.lpage == 0) {
        tree.destroy(t, a);
        return 0;
    }
    box.set_spacing(t, d.main, 8.0);
    d.logo = _centred(t, image.create(t, d.main, 0, 0.0, 0.0));
    d.name = _label(t, d.main, label.TITLE);
    d.version = _label(t, d.main, label.BODY);
    d.comments = _label(t, d.main, label.BODY);
    d.website = button.link(t, d.main, "", 0, "");
    d.copyright = _label(t, d.main, label.CAPTION);
    d.credits = label.create(t, d.cpage, "", 0);
    d.license = label.create(t, d.lpage, "", 0);
    if (d.logo == 0 || d.name == 0 || d.version == 0 || d.comments == 0 || d.website == 0 || d.copyright == 0 ||
        d.credits == 0 || d.license == 0) {
        tree.destroy(t, a);
        return 0;
    }
    _centred(t, d.website);
    tree.set_visible(t, d.logo, 0);
    tree.set_visible(t, d.website, 0);
    image.set_description(t, d.logo, cast(*u8, &g.name), g.name_n);
    label.set_text(t, d.name, s, k);
    tree.set_visible(t, d.name, 1);
    label.set_wrap(t, d.credits, 1);
    label.set_wrap(t, d.license, 1);
    label.set_selectable(t, d.license, 1);
    stack.set_current(t, d.pages, d.main);
    _button(t, a, strings.CLOSE, dialog.CLOSE);
    dialog.set_default_response(t, a, dialog.CLOSE);
    dialog.set_check(t, a, fn_ptr(_check), cast(*u8, d));
    return a;
}

fn _destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Data as d = cast(*Data, data);
    if (cast(i64, d.side) != 0) { mem.core.munmap(cast(*u8, d.side), sizeof(Side)); }
}

// A label's text from now on, shown when there is any.
fn _say(t as *tree.Tree, l as i64, s as *u8, n as i64) as void {
    label.set_text(t, l, s, n);
    tree.set_visible(t, l, cast(i32, n > 0));
}

fn set_version(t as *tree.Tree, a as i64, s as *u8, n as i64) as void {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return; }
    _say(t, d.version, s, n);
}

fn set_comments(t as *tree.Tree, a as i64, s as *u8, n as i64) as void {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return; }
    _say(t, d.comments, s, n);
}

fn set_copyright(t as *tree.Tree, a as i64, s as *u8, n as i64) as void {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return; }
    _say(t, d.copyright, s, n);
}

// Its website: uri — the program's, kept alive — shown as s, n bytes.
fn set_website(t as *tree.Tree, a as i64, uri as *u8, s as *u8, n as i64) as void {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return; }
    tree.destroy(t, d.website);
    d.website = button.link(t, d.main, s, n, uri);
    if (d.website == 0) { return; }
    _centred(t, d.website);
    // Back in its place, before the copyright.
    tree.move_before(t, d.website, d.copyright);
}

// Its image: texture tex, shown w by h.
fn set_logo(t as *tree.Tree, a as i64, tex as i64, w as f64, h as f64) as void {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return; }
    image.set_image(t, d.logo, tex, w, h);
    tree.set_visible(t, d.logo, 1);
}

// The licence's text, s, n bytes: the License button then.
fn set_license(t as *tree.Tree, a as i64, s as *u8, n as i64) as void {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return; }
    label.set_text(t, d.license, s, n);
    _secondary(t, d, strings.LICENSE, LICENSE_ANSWER);
}

// Who made it: a section titled s, sn bytes — "Created by", "Documented by",
// or the program's own — of names, nn bytes, one a line. The Credits button
// then.
fn add_credits(t as *tree.Tree, a as i64, s as *u8, sn as i64, names as *u8, nn as i64) as void {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return; }
    let is *Side as g = d.side;
    let is i64 as gap with mut = 0;
    if (g.n > 0) { gap = 2; }
    if (g.n + gap + sn + 1 + nn > MAX_CREDITS || g.ns >= MAX_SECTIONS) { return; }
    if (gap == 2) {
        g.text[g.n] = cast(u8, 10);
        g.text[g.n + 1] = cast(u8, 10);
        g.n = g.n + 2;
    }
    g.spans[g.ns].start = g.n;
    mem.memcpy(cast(*u8, cast(i64, &g.text) + g.n), s, sn);
    g.n = g.n + sn;
    g.spans[g.ns].end = g.n;
    g.spans[g.ns].style = 1;
    g.ns = g.ns + 1;
    g.text[g.n] = cast(u8, 10);
    g.n = g.n + 1;
    mem.memcpy(cast(*u8, cast(i64, &g.text) + g.n), names, nn);
    g.n = g.n + nn;
    label.set_text(t, d.credits, cast(*u8, &g.text), g.n);
    label.set_spans(t, d.credits, cast(*txt.Style, &g.styles), 2, cast(*tmodel.Span, &g.spans), g.ns);
    _secondary(t, d, strings.CREDITS, CREDITS_ANSWER);
}

// A section of its authors — "Created by" in the tree's language — names, nn
// bytes, one a line.
fn add_authors(t as *tree.Tree, a as i64, names as *u8, nn as i64) as void {
    let is i64 as n with mut = 0;
    let is *u8 as s = strings.of(t, strings.CREATED_BY, &n);
    add_credits(t, a, s, n, names, nn);
}

// A section of who documented it: "Documented by".
fn add_documenters(t as *tree.Tree, a as i64, names as *u8, nn as i64) as void {
    let is i64 as n with mut = 0;
    let is *u8 as s = strings.of(t, strings.DOCUMENTED_BY, &n);
    add_credits(t, a, s, n, names, nn);
}

// A button of a, saying word in the tree's language, answering response.
fn _button(t as *tree.Tree, a as i64, word as i64, response as i64) as i64 {
    let is i64 as n with mut = 0;
    let is *u8 as s = strings.of(t, word, &n);
    return dialog.add_button(t, a, s, n, response);
}

// A toggle at the foot's start answering response, made the first time.
fn _secondary(t as *tree.Tree, d as *Data, word as i64, response as i64) as void {
    if (dialog.button_for(t, d.dlg, response) != 0) { return; }
    let is i64 as b = _button(t, d.dlg, word, response);
    if (b == 0) { return; }
    button.set_toggle(t, b, 1);
    dialog.set_secondary(t, d.dlg, response, 1);
}

// --- Its pages ---

fn _show(t as *tree.Tree, d as *Data, page as i32) as void {
    d.page = page;
    let is i64 as to with mut = d.main;
    if (page == CREDITS) { to = d.cpage; }
    if (page == LICENSE) { to = d.lpage; }
    stack.set_current(t, d.pages, to);
    let is i64 as cb = dialog.button_for(t, d.dlg, CREDITS_ANSWER);
    let is i64 as lb = dialog.button_for(t, d.dlg, LICENSE_ANSWER);
    if (cb != 0) { button.set_active(t, cb, cast(i32, page == CREDITS)); }
    if (lb != 0) { button.set_active(t, lb, cast(i32, page == LICENSE)); }
}

// Credits and License turn their page over, the dialog kept; any other
// answer hides it, back on its first page.
fn _check(user as *u8, response as i64) as i32 {
    let is *Data as d = cast(*Data, user);
    let is *tree.Tree as t = d.t;
    if (response == CREDITS_ANSWER || response == LICENSE_ANSWER) {
        let is i32 as to with mut = CREDITS;
        if (response == LICENSE_ANSWER) { to = LICENSE; }
        if (d.page == to) { to = MAIN; }
        _show(t, d, to);
        return 0;
    }
    _show(t, d, MAIN);
    return 1;
}

fn page(t as *tree.Tree, a as i64) as i32 {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return 0 - 1; }
    return d.page;
}

// --- Its parts ---

fn name_label(t as *tree.Tree, a as i64) as i64 {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return 0; }
    return d.name;
}

fn version_label(t as *tree.Tree, a as i64) as i64 {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return 0; }
    return d.version;
}

fn comments_label(t as *tree.Tree, a as i64) as i64 {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return 0; }
    return d.comments;
}

fn website_link(t as *tree.Tree, a as i64) as i64 {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return 0; }
    return d.website;
}

fn copyright_label(t as *tree.Tree, a as i64) as i64 {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return 0; }
    return d.copyright;
}

fn logo_of(t as *tree.Tree, a as i64) as i64 {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return 0; }
    return d.logo;
}

fn credits_label(t as *tree.Tree, a as i64) as i64 {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return 0; }
    return d.credits;
}

fn license_label(t as *tree.Tree, a as i64) as i64 {
    let is *Data as d = _of(t, a);
    if (cast(i64, d) == 0) { return 0; }
    return d.license;
}

// --- Laid out: its pages, as large as the largest ---

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    layout.measure(t, d.pages, c, out);
    // Room for a licence to be read, scrolled.
    if (out.pref_w < 360.0) { out.pref_w = 360.0; }
    if (out.pref_h < 240.0) { out.pref_h = 240.0; }
}

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is math.rect.Rect as all = math.rect.rect(0.0, 0.0, r.w, r.h);
    layout.place(t, d.pages, &all);
}
