// ui/widgets/fontpicker_test.cst — a font chosen from the families of a font
// index, searched by name; its styles, a variable face's weights among them;
// its size; a preview in it; in a dialog, and behind a button.
//
// Run from the repository's root, where text/testdata is: the index is made
// of text/testdata/fonts.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../../text/fonts/scan.cst" as scan;
use "../../text/fonts/index.cst" as index;
use "../tree.cst" as tree;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "../model.cst" as model;
use "dialog.cst" as dialog;
use "entry.cst" as entry;
use "label.cst" as label;
use "listview.cst" as listview;
use "spin.cst" as spin;
use "button.cst" as button;
use "fontpicker.cst" as fontpicker;

let is i64 as W with imut = 480;
let is i64 as H with imut = 480;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

// Every font the text service asks for, the last that matched the one looked for.
let is *u8 as want_family with mut;
let is i64 as want_weight with mut = 0;
let is i32 as want_italic with mut = 0;
let is i32 as asked_for with mut = 0;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font {
    if (cast(i64, want_family) != 0 && cast(i64, family) != 0 && same(family, len(family), want_family) == 1 &&
        weight == want_weight && italic == want_italic) {
        asked_for = 1;
    }
    return &plain_font;
}

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [230400]i32 as px with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

fn mx(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).x + layout.window_rect(t, w).w / 2.0; }
fn my(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).y + layout.window_rect(t, w).h / 2.0; }

let is index.Index as ix with mut;

let is i64 as changes with mut = 0;
fn on_change(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { changes = changes + 1; }

// The rows of a list's model, joined by '|'.
let is [2048]u8 as rows with mut;

fn listed(t as *tree.Tree, l as i64) as *u8 {
    let is *model.Model as m = listview.model_of(t, l);
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    while (i < model.count(m, 0) && k < 1900) {
        let is model.Value as v;
        model.cell(m, model.row_id(m, 0, i), 0, model.TEXT, &v);
        if (i > 0) {
            rows[k] = cast(u8, 124);
            k = k + 1;
        }
        mem.memcpy(cast(*u8, cast(i64, &rows) + k), v.p, v.len);
        k = k + v.len;
        i = i + 1;
    }
    rows[k] = cast(u8, 0);
    return cast(*u8, &rows);
}

fn lists(t as *tree.Tree, l as i64, s as *u8) as i32 {
    let is *u8 as got = listed(t, l);
    if (same(got, len(got), s) == 1) { return 1; }
    io.printf("  listed: %s\n", got);
    return 0;
}

fn chosen_is(t as *tree.Tree, w as i64, family as *u8, weight as i64, italic as i32, size as f64) as i32 {
    let is *u8 as f = fontpicker.family(t, w);
    let is i64 as n = fontpicker.family_length(t, w);
    if (same(f, n, family) == 1 && fontpicker.weight(t, w) == weight && fontpicker.italic(t, w) == italic &&
        fontpicker.size(t, w) == size) { return 1; }
    io.printf("  chosen: %d bytes of family, %d, %d, size %d\n", n, fontpicker.weight(t, w), cast(i64, fontpicker.italic(t, w)),
              cast(i64, fontpicker.size(t, w)));
    return 0;
}

fn row(t as *tree.Tree, l as i64, i as i64) as i64 { return listview.row_widget(t, l, i); }

fn label_of(t as *tree.Tree, w as i64) as i64 { return tree.labelled_by(t, w); }

fn measured(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &free, &s);
    return s;
}

let is *u8 as SANS with imut = "Caustic Test Sans";

// --- The families, searched ---

fn families() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as w = fontpicker.create(&t, tree.root(&t), &ix);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as fl = fontpicker.families_of(&t, w);
    check("the families in order, the nameless left out", lists(&t, fl,
          "Caustic Test CJK JP|Caustic Test CJK SC|Caustic Test Emoji|Caustic Test Greek|Caustic Test Ital|Caustic Test Mono|Caustic Test Odd|Caustic Test Plain|Caustic Test Sans|Caustic Test Sans Cyr|Caustic Test Sans Cyrillic|Caustic Test Sans Greek|Caustic Test Short|Caustic Test Var|Caustic Test Weights|Caustic Test Wild") == 1);
    check("the theme's family not there: the first chosen, as the theme's text", chosen_is(&t, w, "Caustic Test CJK JP", 400, 0, 16.0) == 1 &&
          listview.is_selected(&t, fl, 0) == 1);
    let is i64 as e = fontpicker.search_of(&t, w);
    entry.set_text(&t, e, "sans", 4);
    check("searched: those with it in their name, case aside", lists(&t, fl,
          "Caustic Test Sans|Caustic Test Sans Cyr|Caustic Test Sans Cyrillic|Caustic Test Sans Greek") == 1);
    check("the chosen one not among them: still chosen", chosen_is(&t, w, "Caustic Test CJK JP", 400, 0, 16.0) == 1 &&
          listview.selected_count(&t, fl) == 0);
    entry.set_text(&t, e, "SANS GR", 7);
    check("all of what is typed", lists(&t, fl, "Caustic Test Sans Greek") == 1);
    entry.set_text(&t, e, "zzz", 3);
    check("nothing has it: none", lists(&t, fl, "") == 1);
    entry.set_text(&t, e, "", 0);
    check("nothing typed: all again, the chosen one chosen", model.count(listview.model_of(&t, fl), 0) == 16 &&
          listview.is_selected(&t, fl, 0) == 1);
    // A family clicked.
    changes = 0;
    signal.connect(&t, w, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    click(&t, &r, mx(&t, row(&t, fl, 5)), my(&t, row(&t, fl, 5)), 10);
    check("a family clicked: chosen, said", chosen_is(&t, w, "Caustic Test Mono", 400, 0, 16.0) == 1 && changes == 1);
    entry.set_text(&t, e, "Mono", 4);
    entry.set_text(&t, e, "", 0);
    check("searched and back: its row chosen again", listview.is_selected(&t, fl, 5) == 1 && listview.selected_count(&t, fl) == 1);
    check("its style chosen", listview.is_selected(&t, fontpicker.styles_of(&t, w), 0) == 1);
    // The families' model, its edges.
    let is *model.Model as fm = listview.model_of(&t, fl);
    let is model.Value as v;
    check("the families' model", model.count(fm, 1) == 0 && model.row_id(fm, 0, 15) == 16 && model.row_id(fm, 0, 16) == 0 &&
          model.row_id(fm, 0, 0 - 1) == 0 && model.row_id(fm, 1, 0) == 0 && model.index_of(fm, 16) == 15 &&
          model.index_of(fm, 17) == 0 - 1 && model.index_of(fm, 0) == 0 - 1 && model.index_of(fm, 1) == 0 &&
          model.cell(fm, 16, 0, model.TEXT, &v) == 1 && model.cell(fm, 17, 0, model.TEXT, &v) == 0 &&
          model.cell(fm, 0, 0, model.TEXT, &v) == 0 && model.cell(fm, 1, 1, model.TEXT, &v) == 0 &&
          model.cell(fm, 1, 0, model.SORT, &v) == 0);
    let is *model.Model as sm = listview.model_of(&t, fontpicker.styles_of(&t, w));
    check("the styles' model", model.count(sm, 0) == 1 && model.count(sm, 1) == 0 && model.row_id(sm, 0, 0) == 1 &&
          model.row_id(sm, 0, 1) == 0 && model.row_id(sm, 0, 0 - 1) == 0 && model.row_id(sm, 1, 0) == 0 &&
          model.index_of(sm, 1) == 0 && model.index_of(sm, 2) == 0 - 1 && model.index_of(sm, 0) == 0 - 1 &&
          model.cell(sm, 1, 0, model.TEXT, &v) == 1 && model.cell(sm, 2, 0, model.TEXT, &v) == 0 &&
          model.cell(sm, 0, 0, model.TEXT, &v) == 0 && model.cell(sm, 1, 1, model.TEXT, &v) == 0 &&
          model.cell(sm, 1, 0, model.SORT, &v) == 0);
    key(&t, &r, keys.DOWN, 0, 20);
    check("down: the next", chosen_is(&t, w, "Caustic Test Odd", 700, 0, 16.0) == 1 && changes == 2);
    tree.close(&t);
}

// --- Its styles ---

fn styles() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as w = fontpicker.create(&t, tree.root(&t), &ix);
    let is i64 as sl = fontpicker.styles_of(&t, w);
    signal.connect(&t, w, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    changes = 0;
    check("set", fontpicker.set_font(&t, w, SANS, 17, 400, 0, 14.0) == 1 && changes == 1);
    check("no such family: not set", fontpicker.set_font(&t, w, "Nope", 4, 400, 0, 14.0) == 0 && changes == 1 &&
          chosen_is(&t, w, SANS, 400, 0, 14.0) == 1);
    check("its styles: upright by weight, then slanted, then other widths", lists(&t, sl,
          "Thin|Light|Regular|Bold|Black|Italic|Bold Italic|Condensed|Expanded") == 1);
    check("the one chosen", listview.is_selected(&t, sl, 2) == 1 && listview.selected_count(&t, sl) == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    click(&t, &r, mx(&t, row(&t, sl, 6)), my(&t, row(&t, sl, 6)), 10);
    check("a style clicked", chosen_is(&t, w, SANS, 700, 1, 14.0) == 1 && changes == 2 && fontpicker.width(&t, w) == 100.0);
    click(&t, &r, mx(&t, row(&t, sl, 7)), my(&t, row(&t, sl, 7)), 1000);
    check("another width", chosen_is(&t, w, SANS, 400, 0, 14.0) == 1 && fontpicker.width(&t, w) == 75.0);
    click(&t, &r, mx(&t, row(&t, sl, 6)), my(&t, row(&t, sl, 6)), 2000);
    // Another family: the nearest of its styles.
    fontpicker.set_font(&t, w, "Caustic Test Var", 16, 700, 1, 14.0);
    check("a variable face: its weights by the hundred, oblique too", lists(&t, sl,
          "Extra Light|Light|Regular|Medium|Semi Bold|Bold|Extra Bold|Extra Light Oblique|Light Oblique|Oblique|Medium Oblique|Semi Bold Oblique|Bold Oblique|Extra Bold Oblique") == 1);
    check("bold and slanted kept", chosen_is(&t, w, "Caustic Test Var", 700, 1, 14.0) == 1 && listview.is_selected(&t, sl, 12) == 1);
    fontpicker.set_font(&t, w, "Caustic Test Wild", 17, 1000, 0, 14.0);
    check("its whole range, from the first hundred in it", lists(&t, sl,
          "Thin|Extra Light|Light|Regular|Medium|Semi Bold|Bold|Extra Bold|Black|Thin Italic|Extra Light Italic|Light Italic|Italic|Medium Italic|Semi Bold Italic|Bold Italic|Extra Bold Italic|Black Italic") == 1);
    check("asked for what it has not: the nearest", chosen_is(&t, w, "Caustic Test Wild", 900, 0, 14.0) == 1);
    fontpicker.set_font(&t, w, "Caustic Test Weights", 20, 450, 1, 14.0);
    check("weights not by the hundred: their own names", lists(&t, sl, "W300|W460|W480|W500") == 1 &&
          chosen_is(&t, w, "Caustic Test Weights", 460, 0, 14.0) == 1);
    fontpicker.set_font(&t, w, "Caustic Test Weights", 20, 470, 0, 14.0);
    check("as near one as another: the lighter", chosen_is(&t, w, "Caustic Test Weights", 460, 0, 14.0) == 1);
    fontpicker.set_font(&t, w, "Caustic Test Plain", 18, 400, 0, 14.0);
    check("only slanted: that", lists(&t, sl, "Bold Italic") == 1 && chosen_is(&t, w, "Caustic Test Plain", 700, 1, 14.0) == 1);
    // The keys in the list of styles.
    fontpicker.set_font(&t, w, SANS, 17, 400, 0, 14.0);
    router.focus(&t, &r, sl, 1);
    key(&t, &r, keys.DOWN, 0, 3000);
    check("down: the next style", chosen_is(&t, w, SANS, 700, 0, 14.0) == 1);
    tree.close(&t);
}

// --- Its size, and the preview ---

fn sized() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as w = fontpicker.create(&t, tree.root(&t), &ix);
    signal.connect(&t, w, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    fontpicker.set_font(&t, w, SANS, 17, 700, 1, 14.0);
    let is i64 as sp = fontpicker.size_of(&t, w);
    check("its size in the spin box", spin.value(&t, sp) == 14.0);
    changes = 0;
    spin.set_value(&t, sp, 20.0);
    check("another size: chosen, said", chosen_is(&t, w, SANS, 700, 1, 20.0) == 1 && changes == 1);
    fontpicker.set_font(&t, w, SANS, 17, 700, 1, 3.0);
    check("held to its range", fontpicker.size(&t, w) == 4.0 && spin.value(&t, sp) == 4.0);
    // The preview: its text, in the font chosen — one no other part here
    // asks for, which the text service has not got yet.
    fontpicker.set_font(&t, w, SANS, 17, 900, 0, 24.0);
    let is i64 as pv = fontpicker.preview_of(&t, w);
    check("the preview's text", same(label.text(&t, pv), label.text_length(&t, pv), "The quick brown fox jumps over the lazy dog") == 1);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    want_family = SANS;
    want_weight = 900;
    want_italic = 0;
    asked_for = 0;
    frame(&t, &c);
    check("drawn in the font chosen", asked_for == 1);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(&t, pv, &free, &s);
    check("as large as chosen", s.pref_h >= 24.0);
    // Laid out: the search over the lists, the size and the preview under them.
    let is math.rect.Rect as er = layout.window_rect(&t, fontpicker.search_of(&t, w));
    let is math.rect.Rect as fr = layout.window_rect(&t, fontpicker.families_of(&t, w));
    let is math.rect.Rect as sr = layout.window_rect(&t, fontpicker.styles_of(&t, w));
    let is math.rect.Rect as zr = layout.window_rect(&t, sp);
    let is math.rect.Rect as pr = layout.window_rect(&t, pv);
    check("laid out", er.y == 0.0 && er.w == cast(f64, W) && fr.y >= er.y + er.h && sr.y == fr.y && fr.x == 0.0 &&
          sr.x >= fr.x + fr.w && sr.x + sr.w == cast(f64, W) && fr.w > sr.w && zr.y >= fr.y + fr.h && pr.y >= zr.y + zr.h &&
          pr.y + pr.h <= cast(f64, H) && fr.h > 100.0);
    // Exactly: three fifths for the families, the headings over the lists,
    // the size label and its spin box side by side, centred on one line.
    let is f64 as g = theme.metrics.space_s;
    let is i64 as fh = label_of(&t, fontpicker.families_of(&t, w));
    let is i64 as sh = label_of(&t, fontpicker.styles_of(&t, w));
    let is i64 as zl = label_of(&t, sp);
    let is math.rect.Rect as fhr = layout.window_rect(&t, fh);
    let is math.rect.Rect as shr = layout.window_rect(&t, sh);
    let is math.rect.Rect as zlr = layout.window_rect(&t, zl);
    check("its parts exactly", fr.w == 285.0 && sr.x == 289.0 && fhr.y == er.h + g && shr.x == sr.x && shr.y == fhr.y &&
          fr.y == fhr.y + fhr.h + g && zlr.x == 0.0 && zr.x == zlr.w + g &&
          zlr.y + zlr.h / 2.0 == zr.y + zr.h / 2.0 && zr.y + zr.h + g <= pr.y + 0.5 && pr.y + pr.h == cast(f64, H));
    let is geom.Size as cs;
    layout.measure(&t, w, &free, &cs);
    let is f64 as zh with mut = measured(&t, sp).pref_h;
    if (measured(&t, zl).pref_h > zh) { zh = measured(&t, zl).pref_h; }
    let is f64 as fixed = measured(&t, fontpicker.search_of(&t, w)).pref_h + g + measured(&t, fh).pref_h + g + g + zh + g +
                          measured(&t, pv).pref_h;
    check("its size: the lists' room besides its parts", cs.pref_h == fixed + 240.0 && cs.min_h == fixed + 80.0 &&
          cs.pref_w == 480.0 && cs.min_w == 240.0);
    layout.set_direction(&t, w, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as fr2 = layout.window_rect(&t, fontpicker.families_of(&t, w));
    let is math.rect.Rect as sr2 = layout.window_rect(&t, fontpicker.styles_of(&t, w));
    check("mirrored", fr2.x + fr2.w == cast(f64, W) && sr2.x == 0.0);
    draw2d.close(&c);
    let is tree.Access as q;
    access.describe(&t, &r, w, &q);
    check("told as a font chooser", q.role == access.ROLE_FONT_CHOOSER);
    access.describe(&t, &r, fontpicker.families_of(&t, w), &q);
    check("its lists named", same(q.name, q.name_len, "Family") == 1);
    access.describe(&t, &r, fontpicker.styles_of(&t, w), &q);
    check("both", same(q.name, q.name_len, "Style") == 1);
    access.describe(&t, &r, sp, &q);
    check("and its size", same(q.name, q.name_len, "Size") == 1);
    tree.close(&t);
}

// --- In a dialog, and behind a button ---

let is i64 as answered with mut = 0;
let is i64 as answers with mut = 0;
fn on_answer(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    answered = *cast(*i64, arg);
    answers = answers + 1;
}

fn dialogged() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as dlg = fontpicker.dialog(&t, "Font", 4, &ix);
    let is i64 as w = fontpicker.chooser_of(&t, dlg);
    signal.connect(&t, dlg, signal.ACTIVATED, fn_ptr(on_answer), cast(*u8, 0));
    check("a dialog holding a chooser", dlg != 0 && w != 0 && fontpicker.chooser_of(&t, tree.root(&t)) == 0);
    fontpicker.set_font(&t, w, SANS, 17, 400, 0, 14.0);
    dialog.show(&t, &r, dlg, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the search focused first", router.focused(&t, &r) == fontpicker.search_of(&t, w));
    let is i64 as sl = fontpicker.styles_of(&t, w);
    click(&t, &r, mx(&t, row(&t, sl, 3)), my(&t, row(&t, sl, 3)), 10);
    let is i64 as ok = dialog.button_for(&t, dlg, dialog.OK);
    click(&t, &r, mx(&t, ok), my(&t, ok), 20);
    check("a style, then Select", answers == 1 && answered == dialog.OK && chosen_is(&t, w, SANS, 700, 0, 14.0) == 1 &&
          dialog.is_shown(&t, dlg) == 0);
    tree.close(&t);
}

let is i64 as button_changes with mut = 0;
fn on_button(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { button_changes = button_changes + 1; }

fn says(t as *tree.Tree, b as i64, s as *u8) as i32 {
    let is i64 as l = fontpicker.button_label(t, b);
    if (same(label.text(t, l), label.text_length(t, l), s) == 1) { return 1; }
    io.printf("  says %d bytes\n", label.text_length(t, l));
    return 0;
}

fn buttoned() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as b = fontpicker.button(&t, tree.root(&t), &ix);
    layout.set_align(&t, b, layout.START, layout.START);
    signal.connect(&t, b, signal.VALUE_CHANGED, fn_ptr(on_button), cast(*u8, 0));
    check("a button saying the font", fontpicker.set_button_font(&t, b, SANS, 17, 700, 1, 14.0) == 1 &&
          says(&t, b, "Caustic Test Sans Bold Italic 14") == 1);
    check("no dialog before it is pressed", fontpicker.button_dialog(&t, b) == 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    button_changes = 0;
    click(&t, &r, mx(&t, b), my(&t, b), 10);
    let is i64 as dlg = fontpicker.button_dialog(&t, b);
    let is i64 as w = fontpicker.chooser_of(&t, dlg);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("pressed: the dialog, its font", dlg != 0 && dialog.is_shown(&t, dlg) == 1 && chosen_is(&t, w, SANS, 700, 1, 14.0) == 1);
    let is i64 as sl = fontpicker.styles_of(&t, w);
    click(&t, &r, mx(&t, row(&t, sl, 2)), my(&t, row(&t, sl, 2)), 20);
    key(&t, &r, keys.ESCAPE, 0, 30);
    check("cancelled: as it was", button_changes == 0 && says(&t, b, "Caustic Test Sans Bold Italic 14") == 1);
    click(&t, &r, mx(&t, b), my(&t, b), 40);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("again: its font once more", chosen_is(&t, w, SANS, 700, 1, 14.0) == 1);
    click(&t, &r, mx(&t, row(&t, sl, 2)), my(&t, row(&t, sl, 2)), 1050);
    spin.set_value(&t, fontpicker.size_of(&t, w), 11.0);
    let is i64 as ok = dialog.button_for(&t, dlg, dialog.OK);
    click(&t, &r, mx(&t, ok), my(&t, ok), 1060);
    check("selected: the button's, said", button_changes == 1 && says(&t, b, "Caustic Test Sans Regular 11") == 1);
    let is fontpicker.Font as f;
    check("read back", fontpicker.button_font(&t, b, &f) == 1 && f.weight == 400 && f.italic == 0 && f.size == 11.0 &&
          same(cast(*u8, &f.family), f.family_len, SANS) == 1);
    check("the first style named too", fontpicker.set_button_font(&t, b, SANS, 17, 100, 0, 10.5) == 1 &&
          says(&t, b, "Caustic Test Sans Thin 10.5") == 1);
    check("no such family: not set", fontpicker.set_button_font(&t, b, "Nope", 4, 100, 0, 10.0) == 0 &&
          says(&t, b, "Caustic Test Sans Thin 10.5") == 1);
    check("not a font button: no label", fontpicker.button_label(&t, tree.root(&t)) == 0);
    check("not a font button: nothing", fontpicker.button_dialog(&t, tree.root(&t)) == 0 &&
          fontpicker.button_font(&t, tree.root(&t), &f) == 0 && fontpicker.set_button_font(&t, tree.root(&t), SANS, 17, 400, 0, 1.0) == 0 &&
          fontpicker.set_font(&t, tree.root(&t), SANS, 17, 400, 0, 1.0) == 0 && fontpicker.styles_of(&t, tree.root(&t)) == 0);
    let is i64 as top = tree.root(&t);
    let is i64 as sn with mut = 0;
    check("nor a chooser", cast(i64, fontpicker.family(&t, top)) == 0 && fontpicker.family_length(&t, top) == 0 &&
          fontpicker.weight(&t, top) == 0 && fontpicker.italic(&t, top) == 0 && fontpicker.width(&t, top) == 0.0 &&
          fontpicker.size(&t, top) == 0.0 && fontpicker.font(&t, top, &f) == 0 && fontpicker.font(&t, w, &f) == 1 &&
          cast(i64, fontpicker.style_name(&t, top, &sn)) == 0 && fontpicker.search_of(&t, top) == 0 &&
          fontpicker.families_of(&t, top) == 0 && fontpicker.size_of(&t, top) == 0 && fontpicker.preview_of(&t, top) == 0);
    let is i64 as plain = dialog.create(&t, "Plain", 5);
    check("a dialog without one: none", fontpicker.chooser_of(&t, plain) == 0);
    tree.destroy(&t, b);
    check("its dialog goes with it", tree.is_valid(&t, dlg) == 0);
    tree.close(&t);
}

// An index with no fonts: a chooser with nothing to choose.
fn emptied() as void {
    let is tree.Tree as t = tree_for();
    let is index.Index as none with mut = index.empty();
    let is i64 as w = fontpicker.create(&t, tree.root(&t), &none);
    check("an empty index: a chooser with nothing", w != 0 && model.count(listview.model_of(&t, fontpicker.families_of(&t, w)), 0) == 0 &&
          fontpicker.family_length(&t, w) == 0 && model.count(listview.model_of(&t, fontpicker.styles_of(&t, w)), 0) == 0);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    want_family = cast(*u8, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    let is scan.Scan as s with mut = scan.open();
    scan.walk(&s, "text/testdata/fonts");
    let is index.Index as none with mut = index.empty();
    ix = index.update(&none, &s);

    emptied();
    families();
    styles();
    sized();
    dialogged();
    buttoned();

    index.close(&ix);
    scan.close(&s);
    if (fails == 0) {
        io.printf("fontpicker: %d checks passed\n", checks);
        return 0;
    }
    io.printf("fontpicker: %d of %d checks failed\n", fails, checks);
    return 1;
}
