// ui/widgets/statusbar_test.cst — a status bar: messages pushed and popped by
// context, the newest shown, one flashed for a while; widgets kept at its
// end; drawn under a line; told its message.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../event.cst" as event;
use "../text.cst" as text;
use "label.cst" as label;
use "button.cst" as button;
use "../scroll.cst" as scroll;
use "../timer.cst" as timer;
use "statusbar.cst" as statusbar;

let is i64 as W with imut = 400;
let is i64 as H with imut = 100;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn says(t as *tree.Tree, w as i64, s as *u8) as i32 { return same(statusbar.message(t, w), statusbar.message_length(t, w), s); }

fn messages() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as sb = statusbar.create(&t, tree.root(&t));
    check("a status bar: nothing said", sb != 0 && statusbar.message_length(&t, sb) == 0);
    let is i64 as ready = statusbar.push(&t, sb, 1, "Ready", 5);
    check("pushed: said", ready != 0 && says(&t, sb, "Ready") == 1);
    statusbar.push(&t, sb, 2, "Saving", 6);
    check("another: the newest said", says(&t, sb, "Saving") == 1);
    statusbar.pop(&t, sb, 2);
    check("popped: the one before", says(&t, sb, "Ready") == 1);
    statusbar.push(&t, sb, 1, "Loading", 7);
    let is i64 as saving = statusbar.push(&t, sb, 2, "Saving", 6);
    statusbar.pop(&t, sb, 1);
    check("its context's newest popped, not the one said", says(&t, sb, "Saving") == 1);
    statusbar.remove(&t, sb, saving);
    check("one taken away by its id", says(&t, sb, "Ready") == 1);
    check("popped where its context has none: nothing", statusbar.pop(&t, sb, 7) == 0 && says(&t, sb, "Ready") == 1);
    statusbar.pop(&t, sb, 1);
    check("all popped: nothing said", statusbar.message_length(&t, sb) == 0);
    check("not a status bar: nothing", statusbar.push(&t, tree.root(&t), 1, "x", 1) == 0 &&
          statusbar.message_length(&t, tree.root(&t)) == 0 && statusbar.permanent(&t, tree.root(&t)) == 0 &&
          statusbar.remove(&t, sb, sb) == 0 && statusbar.label_of(&t, tree.root(&t)) == 0 &&
          statusbar.pop(&t, tree.root(&t), 1) == 0 && statusbar.remove(&t, tree.root(&t), 1) == 0 &&
          statusbar.flash(&t, tree.root(&t), "x", 1, 10, 0) == 0);
    tree.close(&t);
    // Nothing pushed yet: nothing to pop or take away.
    let is tree.Tree as t2 = tree_for();
    let is i64 as sb2 = statusbar.create(&t2, tree.root(&t2));
    check("nothing pushed: nothing popped or taken away", statusbar.pop(&t2, sb2, 0) == 0 && statusbar.remove(&t2, sb2, 1) == 0);
    // Taken from the middle: those after it all kept, in order.
    statusbar.push(&t2, sb2, 1, "A", 1);
    let is i64 as b = statusbar.push(&t2, sb2, 2, "B", 1);
    statusbar.push(&t2, sb2, 3, "C", 1);
    statusbar.push(&t2, sb2, 4, "D", 1);
    check("taken from the middle", statusbar.remove(&t2, sb2, b) == 1 && says(&t2, sb2, "D") == 1);
    check("the one under it", statusbar.pop(&t2, sb2, 4) == 1 && says(&t2, sb2, "C") == 1);
    check("and under that", statusbar.pop(&t2, sb2, 3) == 1 && says(&t2, sb2, "A") == 1);
    // Gone once: not again, what is left kept.
    check("popped once: not twice", statusbar.pop(&t2, sb2, 3) == 0 && says(&t2, sb2, "A") == 1);
    let is i64 as e = statusbar.push(&t2, sb2, 5, "E", 1);
    check("taken away once", statusbar.remove(&t2, sb2, e) == 1 && says(&t2, sb2, "A") == 1);
    check("not twice", statusbar.remove(&t2, sb2, e) == 0 && says(&t2, sb2, "A") == 1);
    tree.close(&t2);
}

let is timer.Timers as ts with mut;

fn flashed() as void {
    let is tree.Tree as t = tree_for();
    ts = timer.init();
    tree.set_timers(&t, cast(*u8, &ts));
    let is i64 as sb = statusbar.create(&t, tree.root(&t));
    statusbar.push(&t, sb, 1, "Ready", 5);
    statusbar.flash(&t, sb, "Saved", 5, 2000, 100);
    check("flashed: said", says(&t, sb, "Saved") == 1);
    timer.fire(&ts, 2099);
    check("a moment before its time: still", says(&t, sb, "Saved") == 1);
    timer.fire(&ts, 2100);
    check("its time up: gone", says(&t, sb, "Ready") == 1);
    // One flashed over another: the first gone at once, the second its own time.
    statusbar.flash(&t, sb, "First", 5, 1000, 3000);
    statusbar.flash(&t, sb, "Second", 6, 1000, 3500);
    timer.fire(&ts, 4200);
    check("flashed over another: the second, its own time", says(&t, sb, "Second") == 1);
    statusbar.pop(&t, sb, 0 - 1);
    check("the first gone with it", says(&t, sb, "Ready") == 1);
    timer.fire(&ts, 4600);
    statusbar.flash(&t, sb, "Again", 5, 2000, 5000);
    tree.destroy(&t, sb);
    check("destroyed while one flashes: its timer gone", timer.next_due(&ts) < 0);
    tree.close(&t);
}

fn laid() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as sb = statusbar.create(&t, tree.root(&t));
    layout.set_align(&t, sb, layout.FILL, layout.END);
    statusbar.push(&t, sb, 1, "Ready", 5);
    let is i64 as kept = button.create(&t, statusbar.permanent(&t, sb), "Kept", 4);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as sr = layout.window_rect(&t, sb);
    let is math.rect.Rect as kr = layout.window_rect(&t, kept);
    let is math.rect.Rect as mr = layout.window_rect(&t, statusbar.label_of(&t, sb));
    check("along the bottom, the window wide", near(sr.y + sr.h, cast(f64, H)) == 1 && near(sr.w, cast(f64, W)) == 1);
    check("what is kept at its end, the message before it", near(kr.x + kr.w, sr.x + sr.w - theme.metrics.space_s) == 1 &&
          mr.x < kr.x && mr.x + mr.w <= kr.x + 0.01);
    check("both across its middle", near(kr.y + kr.h / 2.0, sr.y + sr.h / 2.0) == 1 && near(mr.y + mr.h / 2.0, sr.y + sr.h / 2.0) == 1);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ss;
    let is geom.Size as ks;
    let is geom.Size as ls;
    layout.measure(&t, sb, &free, &ss);
    layout.measure(&t, kept, &free, &ks);
    layout.measure(&t, statusbar.label_of(&t, sb), &free, &ls);
    let is f64 as px = theme.metrics.space_s;
    check("as wide as its message and what is kept, apart", near(ss.pref_w, 3.0 * px + ls.pref_w + ks.pref_w) == 1);
    check("no narrower than what is kept", near(ss.min_w, 2.0 * px + ks.min_w) == 1);
    layout.set_direction(&t, sb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as kr2 = layout.window_rect(&t, kept);
    let is math.rect.Rect as mr2 = layout.window_rect(&t, statusbar.label_of(&t, sb));
    check("right to left: what is kept at the left", near(kr2.x, sr.x + theme.metrics.space_s) == 1 && mr2.x > kr2.x);
    check("right to left: the message at the right", near(mr2.x + mr2.w, sr.x + sr.w - theme.metrics.space_s) == 1);
    tree.close(&t);
}

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is i64 as sb = statusbar.create(&t, tree.root(&t));
    layout.set_align(&t, sb, layout.FILL, layout.END);
    statusbar.push(&t, sb, 1, "Ready", 5);
    frame(&t, c);
    let is math.rect.Rect as sr = layout.window_rect(&t, sb);
    check("drawn under a line", is8(cast(i64, sr.x + sr.w - 3.0), cast(i64, sr.y), theme.palette.separator, 2) == 1);
    check("its message dimmer than text", is8(ink_x(&t, statusbar.label_of(&t, sb)), ink_y(&t, statusbar.label_of(&t, sb)),
          theme.palette.fg_dim, 30) == 1);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as sb = statusbar.create(&t, tree.root(&t));
    statusbar.push(&t, sb, 1, "Ready", 5);
    let is tree.Access as q;
    access.describe(&t, &r, sb, &q);
    check("told: a status bar, its message its name", q.role == access.ROLE_STATUS_BAR && q.name_len == 5);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    messages();
    flashed();
    laid();
    drawn(&c);
    told();

    if (fails == 0) {
        io.printf("statusbar: %d checks passed\n", checks);
        return 0;
    }
    io.printf("statusbar: %d of %d checks failed\n", fails, checks);
    return 1;
}
