// ui/widgets/image_test.cst — the image: a texture of the program's at its
// own size or scaled to fit keeping its proportions, centred in what it is
// given; a symbolic one drawn in the colour it is given; faded when
// disabled; described to assistive technology.
use "std/io.cst" as io;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "image.cst" as image;

let is i64 as W with imut = 64;
let is i64 as H with imut = 40;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [2560]i32 as px with mut;
let is style.Theme as theme with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// A texture of w by h of one colour, opaque or not.
fn solid(w as i64, h as i64, r as i64, g as i64, b as i64, a as i64) as i64 {
    let is gpu.texture.Desc as td = gpu.texture.desc(w, h, gpu.texture.RGBA8, gpu.texture.SAMPLED);
    let is i64 as tex = gpu.texture.create(&dv, &td);
    let is [1024]u8 as pix;
    let is i64 as i with mut = 0;
    while (i < w * h) {
        pix[i * 4] = cast(u8, r);
        pix[i * 4 + 1] = cast(u8, g);
        pix[i * 4 + 2] = cast(u8, b);
        pix[i * 4 + 3] = cast(u8, a);
        i = i + 1;
    }
    gpu.texture.upload_region(&dv, tex, 0, 0, w, h, cast(*u8, &pix), w * 4);
    return tex;
}

fn measure(t as *tree.Tree, w as i64, cw as f64) as geom.Size {
    let is geom.Constraint as c = geom.constraint(cw, layout.UNBOUNDED);
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

// --- A kind that gives what it holds a colour ---

struct Giver {
    give as math.color.Color;
}

fn giver_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn giver_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

fn giver_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    p.fg = cast(*Giver, data).give;
}

let is tree.Kind as giver_kind with mut;

fn main() as i32 {
    theme = style.light();
    giver_kind = widget.kind("giver", sizeof(Giver));
    giver_kind.measure = fn_ptr(giver_measure);
    giver_kind.arrange = fn_ptr(giver_arrange);
    giver_kind.paint = fn_ptr(giver_paint);
    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as dl = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &dl);
    let is i64 as red = solid(4, 4, 255, 0, 0, 255);
    let is i64 as mask = solid(4, 4, 255, 255, 255, 255);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    let is i64 as root = tree.root(&t);
    let is i64 as w = image.create(&t, root, red, 8.0, 6.0);
    check("an image", w != 0 && tree.kind(&t, w).role == access.ROLE_IMAGE);

    // Its own size; given more, it stays so, centred.
    let is geom.Size as s with mut = measure(&t, w, layout.UNBOUNDED);
    check("as big as it is", s.min_w == 8.0 && s.min_h == 6.0 && s.pref_w == 8.0 && s.pref_h == 6.0 &&
          s.max_w >= layout.UNBOUNDED);
    frame(&t, &c);
    // The window is 64 by 40: the image at 28..36 across, 17..23 down.
    check("drawn at its size, in the middle", is8(28, 17, math.color.red(), 1) == 1 && is8(35, 22, math.color.red(), 1) == 1);
    check("no larger", is8(27, 20, theme.palette.window_bg, 1) == 1 && is8(36, 20, theme.palette.window_bg, 1) == 1 &&
          is8(31, 16, theme.palette.window_bg, 1) == 1 && is8(31, 23, theme.palette.window_bg, 1) == 1);

    // Scaled to fit, keeping its proportions: 40 tall at most, so 53 by 40.
    image.set_fit(&t, w, 1);
    s = measure(&t, w, layout.UNBOUNDED);
    check("fitting: as small as need be", s.min_w == 0.0 && s.min_h == 0.0 && s.pref_w == 8.0 && s.pref_h == 6.0);
    s = measure(&t, w, 4.0);
    check("fitting, narrower: shorter as well", s.pref_h == 3.0);
    frame(&t, &c);
    check("scaled to fit, centred", is8(6, 0, math.color.red(), 1) == 1 && is8(57, 39, math.color.red(), 1) == 1 &&
          is8(4, 20, theme.palette.window_bg, 1) == 1 && is8(59, 20, theme.palette.window_bg, 1) == 1);

    // A symbolic image: its shape in the theme's text colour, or the colour
    // it is given.
    image.set_fit(&t, w, 0);
    image.set_image(&t, w, mask, 8.0, 6.0);
    image.set_symbolic(&t, w, 1);
    frame(&t, &c);
    check("symbolic: in the text colour", is8(31, 20, theme.palette.fg, 2) == 1);
    let is i64 as g = tree.create(&t, &giver_kind, root);
    cast(*Giver, tree.data(&t, g)).give = math.color.blue();
    tree.reparent(&t, w, g);
    frame(&t, &c);
    check("symbolic: in the colour it is given", is8(31, 20, math.color.blue(), 1) == 1);
    tree.set_enabled(&t, g, 0);
    frame(&t, &c);
    check("given a colour: as given, whatever its state", is8(31, 20, math.color.blue(), 1) == 1);
    tree.set_enabled(&t, g, 1);
    tree.reparent(&t, w, root);
    image.set_symbolic(&t, w, 0);
    image.set_image(&t, w, red, 8.0, 6.0);
    tree.set_enabled(&t, w, 0);
    frame(&t, &c);
    let is math.color.Color as faded = style.over(style.with_alpha(math.color.red(), theme.control.disabled_alpha),
                                                  theme.palette.window_bg);
    check("disabled: faded", is8(31, 20, faded, 2) == 1);
    tree.set_enabled(&t, w, 1);

    // Nothing to show.
    image.set_image(&t, w, 0, 0.0, 0.0);
    s = measure(&t, w, layout.UNBOUNDED);
    check("no image: no size", s.pref_w == 0.0 && s.pref_h == 0.0);
    frame(&t, &c);
    check("and nothing drawn", is8(31, 20, theme.palette.window_bg, 1) == 1);

    // Told.
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("no description: no name", q.name_len == 0);
    image.set_description(&t, w, "A red square", 12);
    access.describe(&t, cast(*router.Router, 0), w, &q);
    check("described", q.role == access.ROLE_IMAGE && same(q.name, q.name_len, "A red square") == 1);
    check("asked of what is no image: nothing", image.set_fit(&t, root, 1) == 0 &&
          image.set_image(&t, root, red, 1.0, 1.0) == 0 && image.set_symbolic(&t, root, 1) == 0 &&
          image.set_smooth(&t, root, 1) == 0 && image.set_premultiplied(&t, root, 1) == 0 &&
          image.set_description(&t, root, "x", 1) == 0);
    check("asked of an image: done", image.set_fit(&t, w, 0) == 1 && image.set_symbolic(&t, w, 0) == 1 &&
          image.set_smooth(&t, w, 1) == 1 && image.set_premultiplied(&t, w, 0) == 1 &&
          image.set_image(&t, w, red, 8.0, 6.0) == 1 && image.set_description(&t, w, "A red square", 12) == 1);

    // Scaled up: filtered between its texels, or the nearest taken.
    let is i64 as two = solid(2, 1, 255, 0, 0, 255);
    let is [8]u8 as rb;
    rb[0] = 255; rb[1] = 0; rb[2] = 0; rb[3] = 255;
    rb[4] = 0; rb[5] = 0; rb[6] = 255; rb[7] = 255;
    gpu.texture.upload_region(&dv, two, 0, 0, 2, 1, cast(*u8, &rb), 8);
    image.set_image(&t, w, two, 2.0, 1.0);
    image.set_fit(&t, w, 1);
    image.set_smooth(&t, w, 0);
    frame(&t, &c);
    check("the nearest: two halves, crisp", is8(30, 20, math.color.red(), 1) == 1 && is8(33, 20, math.color.blue(), 1) == 1);
    image.set_smooth(&t, w, 1);
    frame(&t, &c);
    check("filtered: blended where they meet", ch(31, 20, 0) > 20 && ch(31, 20, 2) > 20);
    image.set_fit(&t, w, 0);

    // Colours that already carry their alpha.
    let is i64 as half = solid(4, 4, 128, 0, 0, 128);
    image.set_image(&t, w, half, 8.0, 6.0);
    image.set_premultiplied(&t, w, 1);
    frame(&t, &c);
    let is math.color.Color as over_bg = style.over(math.color.rgba(1.0, 0.0, 0.0, 128.0 / 255.0), theme.palette.window_bg);
    check("premultiplied: half a red over the window", is8(31, 20, over_bg, 2) == 1);
    image.set_premultiplied(&t, w, 0);
    frame(&t, &c);
    check("taken as straight: darker", ch(31, 20, 0) < cast(i64, over_bg.r * 255.0) - 20);

    let is tree.Limits as tl = tree.limits_default();
    tl.widgets = 1;
    let is tree.Tree as full = tree.open(&tl);
    check("no room: no image", image.create(&full, tree.root(&full), red, 1.0, 1.0) == 0);
    tree.close(&full);

    tree.close(&t);
    if (fails == 0) {
        io.printf("image: %d checks passed\n", checks);
        return 0;
    }
    io.printf("image: %d of %d checks failed\n", fails, checks);
    return 1;
}
