// ui/widgets/assistant_test.cst — an assistant: steps one at a time under
// their title, Back and Next — Finish on the last — and Cancel; a step not
// complete holding Next back; Enter and Escape; told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../event.cst" as event;
use "../text.cst" as text;
use "label.cst" as label;
use "button.cst" as button;
use "../scroll.cst" as scroll;
use "assistant.cst" as assistant;

let is i64 as W with imut = 400;
let is i64 as H with imut = 300;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn click(t as *tree.Tree, r as *router.Router, w as i64, time as i64) as void {
    let is math.rect.Rect as wr = layout.window_rect(t, w);
    router.pointer_move(t, r, wr.x + wr.w / 2.0, wr.y + wr.h / 2.0, time);
    router.pointer_button(t, r, 1, 1, wr.x + wr.w / 2.0, wr.y + wr.h / 2.0, time);
    router.pointer_button(t, r, 1, 0, wr.x + wr.w / 2.0, wr.y + wr.h / 2.0, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn titled(t as *tree.Tree, w as i64, s as *u8) as i32 {
    let is i64 as l = assistant.title(t, w);
    return same(label.text(t, l), label.text_length(t, l), s);
}

fn says(t as *tree.Tree, b as i64, s as *u8) as i32 {
    let is i64 as l = button.content(t, b);
    return same(label.text(t, l), label.text_length(t, l), s);
}

let is i64 as changes with mut = 0;
let is i64 as finished with mut = 0;
let is i64 as cancelled with mut = 0;
fn on_change(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { changes = changes + 1; }
fn on_finish(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { finished = finished + 1; }
fn on_cancel(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { cancelled = cancelled + 1; }

fn made(t as *tree.Tree) as i64 {
    let is i64 as a = assistant.create(t, tree.root(t));
    assistant.add(t, a, "Welcome", 7);
    assistant.add(t, a, "Details", 7);
    assistant.add(t, a, "Done", 4);
    signal.connect(t, a, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    signal.connect(t, a, signal.ACTIVATED, fn_ptr(on_finish), cast(*u8, 0));
    signal.connect(t, a, signal.CLOSED, fn_ptr(on_cancel), cast(*u8, 0));
    return a;
}

fn stepped() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as a = made(&t);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as back = assistant.back_button(&t, a);
    let is i64 as next = assistant.next_button(&t, a);
    let is i64 as cancel = assistant.cancel_button(&t, a);
    check("three steps, the first shown under its title", assistant.count(&t, a) == 3 && assistant.current(&t, a) == 0 &&
          titled(&t, a, "Welcome") == 1 && tree.is_visible(&t, assistant.page(&t, a, 0)) == 1 &&
          tree.is_visible(&t, assistant.page(&t, a, 1)) == 0);
    check("back not yet, next on", tree.is_enabled(&t, back) == 0 && tree.is_enabled(&t, next) == 1 && says(&t, next, "Next") == 1);
    let is math.rect.Rect as ar = layout.window_rect(&t, a);
    let is math.rect.Rect as tr = layout.window_rect(&t, assistant.title(&t, a));
    let is math.rect.Rect as pr = layout.window_rect(&t, assistant.page(&t, a, 0));
    let is math.rect.Rect as nr = layout.window_rect(&t, next);
    let is math.rect.Rect as br = layout.window_rect(&t, back);
    let is math.rect.Rect as cr = layout.window_rect(&t, cancel);
    check("its title on top, the step under it, the buttons at the foot", tr.y < pr.y && pr.y + pr.h <= nr.y + 0.01 &&
          near(nr.y + nr.h, ar.y + ar.h - theme.metrics.space_m) == 1);
    check("cancel at the start, back and next at the end", near(cr.x, ar.x + theme.metrics.space_m) == 1 &&
          near(nr.x + nr.w, ar.x + ar.w - theme.metrics.space_m) == 1 && br.x + br.w <= nr.x && br.x > cr.x + cr.w);
    check("the step as wide as it less its padding, a gap under the title", near(pr.w, ar.w - 2.0 * theme.metrics.space_m) == 1 &&
          near(pr.y, tr.y + tr.h + theme.metrics.space_s) == 1 && near(tr.w, pr.w) == 1);
    changes = 0;
    click(&t, &r, next, 10);
    check("next: the second step", assistant.current(&t, a) == 1 && titled(&t, a, "Details") == 1 && changes == 1 &&
          tree.is_enabled(&t, back) == 1);
    assistant.set_complete(&t, a, 1, 0);
    check("not complete: next held back", tree.is_enabled(&t, next) == 0 && assistant.complete(&t, a, 1) == 0);
    click(&t, &r, next, 20);
    check("so nothing", assistant.current(&t, a) == 1);
    assistant.set_complete(&t, a, 1, 1);
    click(&t, &r, next, 30);
    check("complete: on to the last, next now finish", assistant.current(&t, a) == 2 && says(&t, next, "Finish") == 1);
    finished = 0;
    click(&t, &r, next, 40);
    check("finish: said so, still there", finished == 1 && assistant.current(&t, a) == 2);
    click(&t, &r, back, 50);
    check("back: the step before, next again", assistant.current(&t, a) == 1 && says(&t, next, "Next") == 1);
    cancelled = 0;
    click(&t, &r, cancel, 60);
    check("cancel: said so", cancelled == 1);
    // Enter and Escape.
    assistant.bind(&t, &r, a);
    router.focus(&t, &r, 0, 0);
    key(&t, &r, keys.RETURN, 0, 70);
    check("enter: next", assistant.current(&t, a) == 2);
    key(&t, &r, keys.ESCAPE, 0, 80);
    check("escape: cancel", cancelled == 2);
    check("set to one: there", assistant.set_current(&t, a, 0) == 1 && assistant.current(&t, a) == 0 && titled(&t, a, "Welcome") == 1);
    check("not there: nothing", assistant.set_current(&t, a, 3) == 0 && assistant.set_current(&t, a, 0 - 1) == 0 &&
          assistant.current(&t, a) == 0);
    // Right to left: cancel on the right.
    layout.set_direction(&t, a, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as cr2 = layout.window_rect(&t, cancel);
    let is math.rect.Rect as nr2 = layout.window_rect(&t, next);
    let is math.rect.Rect as br2 = layout.window_rect(&t, back);
    check("right to left: cancel at the right, next at the left", near(cr2.x + cr2.w, ar.x + ar.w - theme.metrics.space_m) == 1 &&
          near(nr2.x, ar.x + theme.metrics.space_m) == 1 && near(br2.x, nr2.x + nr2.w + theme.metrics.space_s) == 1);
    tree.close(&t);
}

fn size_of(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &free, &s);
    return s;
}

// As large as its parts: the buttons' row or the widest step, the title, the
// tallest step and the row of buttons, padded and apart.
fn measured() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as a = assistant.create(&t, tree.root(&t));
    let is i64 as p0 = assistant.add(&t, a, "One", 3);
    assistant.add(&t, a, "Two", 3);
    // A step that scrolls: as tall as what it shows, though it could shrink to nothing.
    let is i64 as sa = scroll.create(&t, p0);
    let is i64 as inside = button.create(&t, sa, "Something", 9);
    layout.set_min_size(&t, inside, 10.0, 70.0);
    let is f64 as pad = theme.metrics.space_m;
    let is f64 as gap = theme.metrics.space_s;
    let is geom.Size as s = size_of(&t, a);
    let is geom.Size as ts = size_of(&t, tree.parent(&t, assistant.title(&t, a)));
    let is geom.Size as ps = size_of(&t, tree.parent(&t, p0));
    let is geom.Size as cs = size_of(&t, assistant.cancel_button(&t, a));
    let is geom.Size as bs = size_of(&t, assistant.back_button(&t, a));
    let is geom.Size as ns = size_of(&t, assistant.next_button(&t, a));
    let is f64 as row = cs.pref_w + gap + bs.pref_w + gap + ns.pref_w;
    check("the row of buttons the widest: as wide as it, padded", ps.pref_w < row && ts.pref_w < row &&
          near(s.pref_w, 2.0 * pad + row) == 1 && near(s.min_w, 2.0 * pad + row) == 1);
    check("as tall as its title, its step and its buttons, padded and apart", ps.pref_h >= 70.0 && ps.min_h < 1.0 &&
          near(s.pref_h, 2.0 * pad + ts.pref_h + gap + ps.pref_h + gap + ns.pref_h) == 1 &&
          near(s.min_h, 2.0 * pad + ts.pref_h + gap + ps.min_h + gap + ns.pref_h) == 1);
    // A step wider than the buttons: as wide as it, though no narrower than them.
    layout.set_min_size(&t, inside, 600.0, 70.0);
    let is geom.Size as s2 = size_of(&t, a);
    let is geom.Size as ps2 = size_of(&t, tree.parent(&t, p0));
    check("a wide step: as wide as it, padded", ps2.pref_w > row && near(s2.pref_w, 2.0 * pad + ps2.pref_w) == 1 &&
          near(s2.min_w, 2.0 * pad + row) == 1);
    tree.close(&t);
}

// Before any step, and many of them: the first 64 each complete or not on
// their own, those past them always complete.
fn many() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as a = assistant.create(&t, tree.root(&t));
    check("no step yet: none current, no title", assistant.current(&t, a) == 0 - 1 && assistant.title(&t, a) == 0 &&
          assistant.page(&t, a, 0 - 1) == 0);
    let is [66]i64 as pages;
    let is i64 as i with mut = 0;
    while (i < 66) {
        pages[i] = assistant.add(&t, a, "Step", 4);
        i = i + 1;
    }
    check("each step's page where it is", assistant.page(&t, a, 1) == pages[1] && assistant.page(&t, a, 2) == pages[2] &&
          assistant.page(&t, a, 65) == pages[65] && assistant.page(&t, a, 66) == 0);
    assistant.set_complete(&t, a, 0, 0);
    check("the first not complete", assistant.complete(&t, a, 0) == 0 && assistant.complete(&t, a, 1) == 1);
    assistant.set_complete(&t, a, 1, 0);
    assistant.set_complete(&t, a, 1, 1);
    check("another complete again: only it", assistant.complete(&t, a, 1) == 1 && assistant.complete(&t, a, 0) == 0);
    assistant.set_complete(&t, a, 63, 0);
    check("the 64th on its own", assistant.complete(&t, a, 63) == 0 && assistant.complete(&t, a, 62) == 1 &&
          assistant.complete(&t, a, 40) == 1);
    assistant.set_complete(&t, a, 40, 0);
    check("the 41st on its own", assistant.complete(&t, a, 40) == 0 && assistant.complete(&t, a, 8) == 1);
    assistant.set_complete(&t, a, 40, 1);
    check("the 41st complete again: the 64th still not", assistant.complete(&t, a, 40) == 1 && assistant.complete(&t, a, 63) == 0);
    check("past the 64th, with the first not complete: complete", assistant.complete(&t, a, 64) == 1);
    assistant.set_complete(&t, a, 0, 1);
    assistant.set_complete(&t, a, 64, 0);
    check("past the 64th: always complete, the rest as they were", assistant.complete(&t, a, 64) == 1 &&
          assistant.complete(&t, a, 0) == 1 && assistant.complete(&t, a, 65) == 1 && assistant.complete(&t, a, 66) == 0);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as a = made(&t);
    let is tree.Access as q;
    access.describe(&t, &r, a, &q);
    check("told: a panel named by its step's title", q.role == access.ROLE_PANEL && q.name_len == 7);
    check("not an assistant: nothing", assistant.count(&t, tree.root(&t)) == 0 && assistant.add(&t, tree.root(&t), "x", 1) == 0 &&
          assistant.page(&t, a, 5) == 0 && assistant.current(&t, tree.root(&t)) == 0 - 1 &&
          assistant.complete(&t, a, 9) == 0 && assistant.next_button(&t, tree.root(&t)) == 0 &&
          assistant.page(&t, tree.root(&t), 0) == 0 && assistant.title(&t, tree.root(&t)) == 0 &&
          assistant.back_button(&t, tree.root(&t)) == 0 && assistant.cancel_button(&t, tree.root(&t)) == 0);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    stepped();
    measured();
    many();
    told();

    if (fails == 0) {
        io.printf("assistant: %d checks passed\n", checks);
        return 0;
    }
    io.printf("assistant: %d of %d checks failed\n", fails, checks);
    return 1;
}
