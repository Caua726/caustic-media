// ui/widgets/button_test.cst — the button: a label or an image inside the
// theme's padding; clicked on a release inside it, on Space, Enter or its
// mnemonic, and by assistive technology; toggles; the window's default and
// cancel buttons; drawn in the theme's variants for its state, its label in
// the variant's text colour; links.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "label.cst" as label;
use "image.cst" as image;
use "button.cst" as button;

let is i64 as W with imut = 240;
let is i64 as H with imut = 200;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [48000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The pixel just inside a button's top left, past its rounded corner and
// border: its background.
fn bg_x(t as *tree.Tree, b as i64) as i64 { return cast(i64, layout.window_rect(t, b).x + theme.metrics.radius_m + 2.0); }
fn bg_y(t as *tree.Tree, b as i64) as i64 { return cast(i64, layout.window_rect(t, b).y + theme.metrics.border_width + 2.0); }

// The middle of the ink of the first glyph of a button's label.
fn ink_x(t as *tree.Tree, b as i64) as i64 {
    let is i64 as l = button.content(t, b);
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, b as i64) as i64 {
    let is i64 as l = button.content(t, b);
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }

// --- Signals ---

let is i64 as clicks with mut = 0;
let is i64 as toggles with mut = 0;
let is i64 as links with mut = 0;
let is *u8 as link_arg with mut;

fn on_click(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { clicks = clicks + 1; }
fn on_toggle(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { toggles = toggles + 1; }
fn on_link(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    links = links + 1;
    link_arg = arg;
}

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn measure(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

// --- Made and measured ---

fn made() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as b = button.create(&t, col, "_Save", 5);
    let is i64 as l = button.content(&t, b);
    check("a button around a label", b != 0 && tree.kind(&t, b).role == access.ROLE_BUTTON &&
          cast(i64, tree.kind(&t, l)) == cast(i64, label.kind()) && tree.parent(&t, l) == b);
    check("the label's mnemonic, named by it", same(label.text(&t, l), label.text_length(&t, l), "Save") == 1 &&
          label.mnemonic(&t, l) == 83 && tree.labelled_by(&t, b) == l && label.target(&t, l) == b);
    check("focusable", tree.is_focusable(&t, b) == 1);
    let is geom.Size as s with mut = measure(&t, b);
    let is geom.Size as ls with mut = measure(&t, l);
    let is router.Router as rr = router.init(router.settings_default());
    let is f64 as px = theme.metrics.control_pad_x;
    let is f64 as py = theme.metrics.control_pad_y;
    let is f64 as h with mut = ls.pref_h + 2.0 * py;
    if (h < theme.metrics.control_height) { h = theme.metrics.control_height; }
    check("its label and the theme's padding", s.pref_w == ls.pref_w + 2.0 * px && s.pref_h == h &&
          s.min_h == h && s.min_w == ls.min_w + 2.0 * px);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as rb = layout.rect(&t, b);
    let is math.rect.Rect as rl = layout.rect(&t, l);
    check("its label in the middle of it", rl.x == px && rl.w == rb.w - 2.0 * px &&
          rl.y + rl.h / 2.0 == rb.h / 2.0);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), b, &q);
    check("told: a button named by its label, pressed by assistive technology", same(q.name, q.name_len, "Save") == 1 &&
          q.actions == access.PRESS);
    check("not a button: nothing", button.content(&t, col) == 0 && button.set_toggle(&t, col, 1) == 0 &&
          button.set_variant(&t, col, button.FLAT) == 0 && button.set_active(&t, col, 1) == 0 &&
          button.is_active(&t, col) == 0 && button.is_down(&t, col) == 0 && button.bind_mnemonic(&t, &rr, col) == 0 &&
          button.set_default(&t, &rr, col) == 0 && button.set_cancel(&t, &rr, col) == 0);
    check("a button: done", button.set_variant(&t, b, button.NORMAL) == 1 && button.set_toggle(&t, b, 0) == 1);
    check("not a toggle: not set", button.set_active(&t, b, 1) == 0 && button.is_active(&t, b) == 0);

    // The padding where a control's height does not hide it.
    let is style.Theme as low = theme;
    low.metrics.control_height = 0.0;
    tree.set_theme(&t, &low);
    s = measure(&t, b);
    ls = measure(&t, l);
    check("no least height: its label's and the padding", s.pref_h == ls.pref_h + 2.0 * py &&
          s.min_h == ls.min_h + 2.0 * py && s.pref_w == ls.pref_w + 2.0 * px);
    tree.set_theme(&t, &theme);

    // An icon.
    let is i64 as ib = button.create_icon(&t, col, 7, 16.0, 16.0);
    let is i64 as im = button.content(&t, ib);
    check("an icon's button: an image inside", cast(i64, tree.kind(&t, im)) == cast(i64, image.kind()) &&
          tree.labelled_by(&t, ib) == im);
    image.set_description(&t, im, "Open", 4);
    access.describe(&t, cast(*router.Router, 0), ib, &q);
    check("named by its image's description", same(q.name, q.name_len, "Open") == 1);
    s = measure(&t, ib);
    check("its image and the padding, at least a control tall", s.pref_w == 16.0 + 2.0 * px &&
          s.pref_h >= theme.metrics.control_height);
    tree.close(&t);

    // No room: no button, and nothing left behind.
    let is tree.Limits as tl = tree.limits_default();
    tl.widgets = 2;
    let is tree.Tree as tight with mut = tree.open(&tl);
    tree.set_text_service(&tight, cast(*u8, svc));
    check("no room for its label: none", button.create(&tight, tree.root(&tight), "x", 1) == 0 &&
          button.create_icon(&tight, tree.root(&tight), 7, 1.0, 1.0) == 0 &&
          button.link(&tight, tree.root(&tight), "x", 1, "u") == 0 && tree.live_count(&tight) == 1);
    tree.close(&tight);
    tl.widgets = 1;
    tight = tree.open(&tl);
    check("no room at all: none", button.create(&tight, tree.root(&tight), "x", 1) == 0 &&
          button.create_icon(&tight, tree.root(&tight), 7, 1.0, 1.0) == 0 &&
          button.link(&tight, tree.root(&tight), "x", 1, "u") == 0);
    tree.close(&tight);
}

// --- Clicked ---

fn clicked() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as b = button.create(&t, col, "_Save", 5);
    let is i64 as other = button.create(&t, col, "Other", 5);
    signal.connect(&t, b, signal.CLICKED, fn_ptr(on_click), cast(*u8, 0));
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    clicks = 0;
    click(&t, &r, mid_x(&t, b), mid_y(&t, b), 10);
    check("pressed and released inside: clicked", clicks == 1 && router.focused(&t, &r) == b);
    router.pointer_move(&t, &r, mid_x(&t, b), mid_y(&t, b), 100);
    router.pointer_button(&t, &r, 1, 1, mid_x(&t, b), mid_y(&t, b), 100);
    router.pointer_move(&t, &r, 230.0, 110.0, 110);
    router.pointer_button(&t, &r, 1, 0, 230.0, 110.0, 120);
    check("released outside: not clicked", clicks == 1);
    router.pointer_move(&t, &r, mid_x(&t, b), mid_y(&t, b), 200);
    router.pointer_button(&t, &r, 1, 1, mid_x(&t, b), mid_y(&t, b), 200);
    router.pointer_move(&t, &r, 230.0, 110.0, 210);
    router.pointer_move(&t, &r, mid_x(&t, b) + 1.0, mid_y(&t, b), 220);
    router.pointer_button(&t, &r, 1, 0, mid_x(&t, b) + 1.0, mid_y(&t, b), 230);
    check("out and back in, released: clicked", clicks == 2);
    router.pointer_button(&t, &r, 3, 1, mid_x(&t, b), mid_y(&t, b), 300);
    check("another button: not taken", router.capture(&r) != b);
    router.pointer_button(&t, &r, 3, 0, mid_x(&t, b), mid_y(&t, b), 310);
    check("another button: not clicked", clicks == 2);
    router.pointer_move(&t, &r, mid_x(&t, b), mid_y(&t, b), 320);
    router.pointer_button(&t, &r, 1, 1, mid_x(&t, b), mid_y(&t, b), 320);
    router.pointer_move(&t, &r, mid_x(&t, b) + 3.0, mid_y(&t, b) + 1.0, 330);
    check("pressed and moved within it: still down", button.is_down(&t, b) == 1);
    router.pointer_move(&t, &r, 230.0, 195.0, 335);
    check("moved off it: up", button.is_down(&t, b) == 0);
    router.pointer_button(&t, &r, 1, 0, 230.0, 195.0, 340);

    // By keyboard.
    router.focus(&t, &r, b, 1);
    router.key(&t, &r, keys.SPACE, 0, 1, 0, 400);
    check("space down: not yet", clicks == 2 && button.is_down(&t, b) == 1);
    router.key(&t, &r, keys.SPACE, 0, 0, 0, 410);
    check("space up: clicked", clicks == 3 && button.is_down(&t, b) == 0);
    router.key(&t, &r, keys.RETURN, 0, 1, 0, 420);
    check("enter: clicked at once", clicks == 4);
    router.key(&t, &r, keys.RETURN, 0, 0, 0, 430);
    key(&t, &r, keys.B, 0, 440);
    check("other keys: not", clicks == 4);
    router.key(&t, &r, keys.SPACE, 0, 1, 0, 450);
    router.focus(&t, &r, other, 1);
    check("space held, the focus gone: up", button.is_down(&t, b) == 0);
    router.key(&t, &r, keys.SPACE, 0, 0, 0, 455);
    check("and not clicked on its release", clicks == 4);
    router.focus(&t, &r, b, 1);
    key(&t, &r, keys.TAB, 0, 460);
    check("tab: on to the next", router.focused(&t, &r) == other);

    // Its mnemonic.
    check("its mnemonic bound", button.bind_mnemonic(&t, &r, b) == 1);
    router.focus(&t, &r, other, 1);
    key(&t, &r, keys.S, keys.MOD_ALT, 500);
    router.key(&t, &r, keys.ALT_L, 0, 0, 0, 510);
    check("alt and its letter: focused and clicked", clicks == 5 && router.focused(&t, &r) == b);

    // Assistive technology.
    check("pressed by assistive technology", access.act(&t, b, access.PRESS, 0.0) == 1 && clicks == 6);

    // Disabled.
    tree.set_enabled(&t, b, 0);
    click(&t, &r, mid_x(&t, b), mid_y(&t, b), 600);
    check("disabled: not by the pointer", clicks == 6);
    check("nor by assistive technology", access.act(&t, b, access.PRESS, 0.0) == 0 && clicks == 6);
    tree.close(&t);
}

// --- Toggles ---

fn toggled() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as b = button.create(&t, col, "Bold", 4);
    check("made a toggle", button.set_toggle(&t, b, 1) == 1 && tree.kind(&t, b).role == access.ROLE_BUTTON);
    signal.connect(&t, b, signal.TOGGLED, fn_ptr(on_toggle), cast(*u8, 0));
    signal.connect(&t, b, signal.CLICKED, fn_ptr(on_click), cast(*u8, 0));
    let is router.Router as r = router.init(router.settings_default());
    layout.run(&t, cast(f64, W), cast(f64, H));
    clicks = 0;
    toggles = 0;
    check("up at first", button.is_active(&t, b) == 0);
    click(&t, &r, mid_x(&t, b), mid_y(&t, b), 10);
    check("clicked: down, toggled", button.is_active(&t, b) == 1 && toggles == 1 && clicks == 1);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), b, &q);
    check("told: a toggle button, pressed", q.role == access.ROLE_TOGGLE_BUTTON &&
          (q.states & access.PRESSED) != 0 && (q.states & access.CHECKABLE) != 0 &&
          (q.actions & access.TOGGLE) != 0);
    click(&t, &r, mid_x(&t, b), mid_y(&t, b), 1000);
    check("again: up", button.is_active(&t, b) == 0 && toggles == 2);
    check("set: down, said", button.set_active(&t, b, 1) == 1 && button.is_active(&t, b) == 1 && toggles == 3 &&
          clicks == 2);
    check("set as it is: nothing said", button.set_active(&t, b, 1) == 1 && toggles == 3);
    check("toggled by assistive technology", access.act(&t, b, access.TOGGLE, 0.0) == 1 &&
          button.is_active(&t, b) == 0 && toggles == 4);
    button.set_active(&t, b, 1);
    button.set_toggle(&t, b, 0);
    check("a toggle no more: up, nothing said", button.is_active(&t, b) == 0 && toggles == 5);
    button.set_toggle(&t, b, 1);
    check("a toggle again: up", button.is_active(&t, b) == 0);
    tree.close(&t);
}

// --- The window's default and cancel ---

fn defaults() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as text_l = label.create(&t, col, "Name", 4);
    label.set_selectable(&t, text_l, 1);
    let is i64 as ok = button.create(&t, col, "OK", 2);
    let is i64 as cancel = button.create(&t, col, "Cancel", 6);
    let is i64 as other = button.create(&t, col, "Other", 5);
    let is router.Router as r = router.init(router.settings_default());
    check("the default", button.set_default(&t, &r, ok) == 1);
    check("made the default again: one key, not two", button.set_default(&t, &r, ok) == 1 &&
          r.shortcuts[1].key == 0);
    check("the cancel", button.set_cancel(&t, &r, cancel) == 1);
    let is i64 as ok_clicks with mut = 0;
    let is i64 as cancel_clicks with mut = 0;
    let is i64 as other_clicks with mut = 0;
    signal.connect(&t, ok, signal.CLICKED, fn_ptr(count), cast(*u8, &ok_clicks));
    signal.connect(&t, cancel, signal.CLICKED, fn_ptr(count), cast(*u8, &cancel_clicks));
    signal.connect(&t, other, signal.CLICKED, fn_ptr(count), cast(*u8, &other_clicks));
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, text_l, 1);
    key(&t, &r, keys.RETURN, 0, 10);
    check("enter anywhere: the default", ok_clicks == 1);
    key(&t, &r, keys.ESCAPE, 0, 20);
    check("escape anywhere: the cancel", cancel_clicks == 1);
    router.focus(&t, &r, other, 1);
    key(&t, &r, keys.RETURN, 0, 30);
    check("enter on another button: that one", other_clicks == 1 && ok_clicks == 1);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), ok, &q);
    check("told it is the default", (q.states & access.DEFAULT) != 0);
    tree.set_enabled(&t, ok, 0);
    router.focus(&t, &r, text_l, 1);
    key(&t, &r, keys.RETURN, 0, 40);
    check("disabled: enter does nothing", ok_clicks == 1);
    tree.set_enabled(&t, ok, 1);
    tree.destroy(&t, ok);
    key(&t, &r, keys.RETURN, 0, 50);
    check("gone: its enter with it, the cancel's escape kept", ok_clicks == 1 && r.shortcuts[0].key == 0 && r.shortcuts[1].key == keys.ESCAPE);
    // A full table of shortcuts: said.
    let is router.Router as full = router.init(router.settings_default());
    let is i64 as n with mut = 0;
    while (n < router.MAX_SHORTCUTS) {
        router.add_shortcut(&full, keys.F1, cast(i32, n + 1), fn_ptr(nothing), cast(*u8, 0));
        n = n + 1;
    }
    check("no room for its key: said", button.set_default(&t, &full, other) == 0 &&
          button.set_cancel(&t, &full, other) == 0);
    tree.close(&t);
}

fn nothing(user as *u8) as void {}

fn count(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    let is *i64 as n = cast(*i64, user);
    *n = *n + 1;
}

// --- Drawn ---

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    box.set_spacing(&t, col, 4.0);
    let is i64 as b = button.create(&t, col, "Hello", 5);
    let is i64 as s = button.create(&t, col, "Hello", 5);
    let is i64 as d = button.create(&t, col, "Hello", 5);
    let is i64 as f = button.create(&t, col, "Hello", 5);
    button.set_variant(&t, s, button.SUGGESTED);
    button.set_variant(&t, d, button.DESTRUCTIVE);
    button.set_variant(&t, f, button.FLAT);
    let is router.Router as r = router.init(router.settings_default());
    frame_router = &r;
    frame(&t, c);
    check("a button: the control's background", is8(bg_x(&t, b), bg_y(&t, b), bg_of(theme.control.normal), 1) == 1);
    check("its label in the control's text colour", is8(ink_x(&t, b), ink_y(&t, b), theme.control.normal.fg, 1) == 1);
    check("suggested: the accent", is8(bg_x(&t, s), bg_y(&t, s), bg_of(theme.suggested.normal), 1) == 1 &&
          is8(ink_x(&t, s), ink_y(&t, s), theme.suggested.normal.fg, 1) == 1);
    check("destructive", is8(bg_x(&t, d), bg_y(&t, d), bg_of(theme.destructive.normal), 1) == 1 &&
          is8(ink_x(&t, d), ink_y(&t, d), theme.destructive.normal.fg, 1) == 1);
    check("flat: no background at rest", is8(bg_x(&t, f), bg_y(&t, f), theme.palette.window_bg, 1) == 1 &&
          is8(ink_x(&t, f), ink_y(&t, f), theme.control.normal.fg, 1) == 1);
    // Hovered, pressed.
    router.pointer_move(&t, &r, mid_x(&t, b), mid_y(&t, b), 10);
    frame(&t, c);
    let is style.Look as hl = style.pick(&theme.control, painter.S_HOVER, 0);
    check("hovered: the hover's overlay", is8(bg_x(&t, b), bg_y(&t, b), bg_of(hl), 1) == 1);
    router.pointer_button(&t, &r, 1, 1, mid_x(&t, b), mid_y(&t, b), 20);
    frame(&t, c);
    let is style.Look as pl = style.pick(&theme.control, painter.S_HOVER | painter.S_PRESSED, 0);
    check("pressed: the press's", is8(bg_x(&t, b), bg_y(&t, b), bg_of(pl), 1) == 1);
    router.pointer_move(&t, &r, 230.0, 195.0, 30);
    frame(&t, c);
    check("pressed, the pointer gone: at rest", is8(bg_x(&t, b), bg_y(&t, b), bg_of(theme.control.normal), 1) == 1);
    router.pointer_button(&t, &r, 1, 0, 230.0, 195.0, 40);
    router.pointer_move(&t, &r, mid_x(&t, f), mid_y(&t, f), 50);
    frame(&t, c);
    check("flat, hovered: the hover's overlay alone",
          is8(bg_x(&t, f), bg_y(&t, f), style.over(theme.control.hover_overlay, theme.palette.window_bg), 2) == 1);
    router.pointer_move(&t, &r, 230.0, 195.0, 60);
    // Space held: pressed.
    router.focus(&t, &r, b, 1);
    router.key(&t, &r, keys.SPACE, 0, 1, 0, 70);
    frame(&t, c);
    let is style.Look as kl = style.pick(&theme.control, painter.S_PRESSED, 0);
    check("space held: pressed", is8(bg_x(&t, b), bg_y(&t, b), bg_of(kl), 1) == 1);
    router.key(&t, &r, keys.SPACE, 0, 0, 0, 80);
    router.focus(&t, &r, 0, 0);
    // A toggle down: the checked look.
    button.set_toggle(&t, b, 1);
    button.set_active(&t, b, 1);
    frame(&t, c);
    check("a toggle down: checked", is8(bg_x(&t, b), bg_y(&t, b), bg_of(theme.control.checked), 1) == 1 &&
          is8(ink_x(&t, b), ink_y(&t, b), theme.control.checked.fg, 1) == 1);
    button.set_toggle(&t, b, 0);
    // Disabled: faded, its label too.
    tree.set_enabled(&t, b, 0);
    frame(&t, c);
    let is style.Look as dl = style.pick(&theme.control, painter.S_DISABLED, 0);
    check("disabled: faded", is8(bg_x(&t, b), bg_y(&t, b), bg_of(dl), 2) == 1);
    let is math.color.Color as ink = style.over(dl.fg, style.over(dl.bg, theme.palette.window_bg));
    check("its label faded once", is8(ink_x(&t, b), ink_y(&t, b), ink, 2) == 1);
    frame_router = cast(*router.Router, 0);
    tree.close(&t);
}

// --- Links ---

fn linked(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as k = button.link(&t, col, "Docs", 4, "https://example.org");
    signal.connect(&t, k, signal.ACTIVATED, fn_ptr(on_link), cast(*u8, 0));
    let is i64 as l = button.content(&t, k);
    let is router.Router as r = router.init(router.settings_default());
    frame(&t, c);
    check("a link", tree.kind(&t, k).role == access.ROLE_LINK);
    router.pointer_move(&t, &r, mid_x(&t, k), mid_y(&t, k), 1);
    check("the pointer over it: a hand", router.pointer_shape(&t, &r) == tree.SHAPE_POINTER);
    tree.set_enabled(&t, k, 0);
    check("disabled: not", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    tree.set_enabled(&t, k, 1);
    let is i64 as plain = button.create(&t, col, "Plain", 5);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.pointer_move(&t, &r, mid_x(&t, plain), mid_y(&t, plain), 2);
    check("over a button: the default", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    button.set_variant(&t, plain, button.LINK);
    check("a button drawn as a link: a hand", router.pointer_shape(&t, &r) == tree.SHAPE_POINTER);
    tree.destroy(&t, plain);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("no background", is8(bg_x(&t, k), bg_y(&t, k), theme.palette.window_bg, 1) == 1 ||
          layout.window_rect(&t, k).h < 10.0);
    check("its text in the link colour", is8(ink_x(&t, k), ink_y(&t, k), theme.palette.link, 1) == 1);
    check("underlined", text.deco_count(label.run(&t, l)) == 1);
    let is geom.Size as s = measure(&t, k);
    let is geom.Size as ls = measure(&t, l);
    check("no padding", s.pref_w == ls.pref_w && s.pref_h == ls.pref_h);
    links = 0;
    clicks = 0;
    signal.connect(&t, k, signal.CLICKED, fn_ptr(on_click), cast(*u8, 0));
    click(&t, &r, mid_x(&t, k), mid_y(&t, k), 10);
    check("clicked: its address", links == 1 && same(link_arg, 19, "https://example.org") == 1 && clicks == 1);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), k, &q);
    check("followed: visited", (q.states & access.VISITED) != 0 && same(q.name, q.name_len, "Docs") == 1);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    link_arg = cast(*u8, 0);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 20.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as dl = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &dl);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    made();
    clicked();
    toggled();
    defaults();
    drawn(&c);
    linked(&c);

    if (fails == 0) {
        io.printf("button: %d checks passed\n", checks);
        return 0;
    }
    io.printf("button: %d of %d checks failed\n", fails, checks);
    return 1;
}
