// ui/widgets/textedit.cst — what the entry and the text view share.
//
// What goes in: UTF-8 as Unicode's table 3-7 has it — overlong forms,
// surrogates and anything past U+10FFFF left out, as a byte that begins no
// sequence or one cut short is — at most so many characters, each one the
// program's filter lets in; line ends kept as line feeds, CR LF and a lone CR
// each one, for text of many lines, or each made a space for one line.
//
// And the context menu every editable text offers — Undo, Redo, Cut, Copy,
// Paste, Delete and Select All, their keys shown — its items enabled only
// as what they would do can be done.
use "../../window/keys.cst" as keys;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "menu.cst" as menu;

// Says whether codepoint c may go in: 1 yes, 0 no.
type FilterFn = fn(*u8, i64) as i32;

// The context menu's items: their ids.
let is i64 as UNDO       with imut = 1;
let is i64 as REDO       with imut = 2;
let is i64 as CUT        with imut = 3;
let is i64 as COPY       with imut = 4;
let is i64 as PASTE      with imut = 5;
let is i64 as DELETE     with imut = 6;
let is i64 as SELECT_ALL with imut = 7;

// --- Characters ---

// The length of the sequence a byte begins, as its bits say.
fn seq(b as i64) as i64 {
    if (b < 128) { return 1; }
    if (b >= 240) { return 4; }
    if (b >= 224) { return 3; }
    if (b >= 192) { return 2; }
    return 1;
}

// The codepoint of the whole sequence at at.
fn decode(p as *u8, at as i64, n as i64) as i64 {
    let is i64 as b = cast(i64, p[at]);
    let is i64 as k = seq(b);
    if (k == 1) { return b; }
    if (k == 2) { return ((b & 31) << 6) | (cast(i64, p[at + 1]) & 63); }
    if (k == 3) { return ((b & 15) << 12) | ((cast(i64, p[at + 1]) & 63) << 6) | (cast(i64, p[at + 2]) & 63); }
    return ((b & 7) << 18) | ((cast(i64, p[at + 1]) & 63) << 12) | ((cast(i64, p[at + 2]) & 63) << 6) |
           (cast(i64, p[at + 3]) & 63);
}

// Whether the k bytes from i of s, n long, are one well-formed sequence, as
// Unicode's table 3-7 has them.
fn whole(s as *u8, i as i64, n as i64, k as i64) as i32 {
    let is i64 as b = cast(i64, s[i]);
    if (b < 128) { return 1; }
    if (b < 194 || b > 244 || i + k > n) { return 0; }
    let is i64 as lo with mut = 128;
    let is i64 as hi with mut = 191;
    if (b == 224) { lo = 160; }
    if (b == 237) { hi = 159; }
    if (b == 240) { lo = 144; }
    if (b == 244) { hi = 143; }
    let is i64 as c = cast(i64, s[i + 1]);
    if (c < lo || c > hi) { return 0; }
    let is i64 as j with mut = 2;
    while (j < k) {
        if ((cast(i64, s[i + j]) & 192) != 128) { return 0; }
        j = j + 1;
    }
    return 1;
}

// What goes in of s, n bytes, into out — room for n bytes there: what is no
// UTF-8 left out, each character f says no to left out (f null lets all
// in), at most room characters (below 0: any number), and each line end a
// line feed when lines is 1, a space when it is 0. Its length.
fn accept(s as *u8, n as i64, room as i64, f as FilterFn, user as *u8, lines as i32, out as *u8) as i64 {
    let is i64 as o with mut = 0;
    let is i64 as chars with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as k with mut = seq(cast(i64, s[i]));
        let is i64 as step with mut = k;
        if (whole(s, i, n, k) == 0) {
            // A byte that begins no sequence, or one cut short: left out.
            step = 1;
        } else {
            let is i64 as c with mut = decode(s, i, n);
            if (c == 13 && i + 1 < n && cast(i64, s[i + 1]) == 10) { step = 2; }
            if (c == 10 || c == 13) {
                c = 10;
                if (lines == 0) { c = 32; }
                k = 0;
            }
            if (room >= 0 && chars >= room) {
                step = n - i;
            } else if (cast(i64, f) == 0 || call(f, user, c) == 1) {
                if (k == 0) {
                    out[o] = cast(u8, c);
                    o = o + 1;
                } else {
                    let is i64 as j with mut = 0;
                    while (j < k) {
                        out[o] = s[i + j];
                        o = o + 1;
                        j = j + 1;
                    }
                }
                chars = chars + 1;
            }
        }
        i = i + step;
    }
    return o;
}

// --- The context menu ---

fn _offer(t as *tree.Tree, m as i64, items as *i64, id as i64, word as i64, k as i32, mods as i32) as void {
    let is i64 as n with mut = 0;
    let is *u8 as s = strings.of(t, word, &n);
    let is i64 as it = menu.add_item(t, m, s, n, id);
    items[id] = it;
    if (it != 0 && k != 0) { menu.set_accel(t, it, k, mods); }
}

// A new context menu of an editable text, its items into items by id —
// room for SELECT_ALL + 1. Its handle, or 0.
fn context_menu(t as *tree.Tree, items as *i64) as i64 {
    let is i64 as m = menu.create(t);
    if (m == 0) { return 0; }
    _offer(t, m, items, UNDO, strings.UNDO, keys.Z, keys.MOD_CONTROL);
    _offer(t, m, items, REDO, strings.REDO, keys.Z, keys.MOD_CONTROL | keys.MOD_SHIFT);
    menu.add_separator(t, m);
    _offer(t, m, items, CUT, strings.CUT, keys.X, keys.MOD_CONTROL);
    _offer(t, m, items, COPY, strings.COPY, keys.C, keys.MOD_CONTROL);
    _offer(t, m, items, PASTE, strings.PASTE, keys.V, keys.MOD_CONTROL);
    _offer(t, m, items, DELETE, strings.DELETE, 0, 0);
    menu.add_separator(t, m);
    _offer(t, m, items, SELECT_ALL, strings.SELECT_ALL, keys.A, keys.MOD_CONTROL);
    return m;
}

fn _on(t as *tree.Tree, items as *i64, id as i64, on as i32) as void {
    if (items[id] != 0) { tree.set_enabled(t, items[id], on); }
}

// Whether action id can be done: editable, the text seen — no password —
// something selected, something to undo or redo, any text. 0 for no such
// action.
fn can(id as i64, editable as i32, seen as i32, selected as i32, undo as i32, redo as i32, any as i32) as i32 {
    if (id == UNDO) { return editable & undo; }
    if (id == REDO) { return editable & redo; }
    if (id == CUT) { return editable & seen & selected; }
    if (id == COPY) { return seen & selected; }
    if (id == PASTE) { return editable; }
    if (id == DELETE) { return editable & selected; }
    if (id == SELECT_ALL) { return any; }
    return 0;
}

// Its items enabled as what they do can be done (can).
fn offer(t as *tree.Tree, items as *i64, editable as i32, seen as i32, selected as i32, undo as i32, redo as i32,
         any as i32) as void {
    let is i64 as id with mut = UNDO;
    while (id <= SELECT_ALL) {
        _on(t, items, id, can(id, editable, seen, selected, undo, redo, any));
        id = id + 1;
    }
}
