// ui/widgets/menubar.cst — menus behind titles in a row.
//
// Titles side by side from the start edge, each with a popup menu the
// program built (menu.cst), opened under it — flush with its start, and
// flipped where the window ends as any popup is. A press on a title opens its
// menu and one on it again closes it; while one is open the pointer reaching
// another title opens that one instead, and Left and Right with nothing to
// open or close in the menu go to the menu before or after, round from the
// ends. F10 opens the first, and Alt with a title's mnemonic its own, each
// with its first item chosen; Escape closes, the focus going back where it
// was. The title whose menu is open is drawn lit.
//
// Told as a menu bar of items that open, expanded while open.
use "../../math/math.cst" as math;
use "../../window/keys.cst" as keys;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../positioner.cst" as positioner;
use "label.cst" as label;
use "menu.cst" as menu;

struct Data {
    t      as *tree.Tree;
    self   as i64;
    open   as i64;              // the title whose menu is open, -1 for none
    r      as *router.Router;   // where F10 is registered
    f10_id as i64;
}

struct Title {
    owner as i64;
    menu  as i64;
    label as i64;
}

let is tree.Kind as _kind with mut;
let is tree.Kind as _title_kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("menu bar", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.destroy = fn_ptr(_destroy);
    _kind.role = access.ROLE_MENU_BAR;
    _title_kind = widget.kind("menu bar title", sizeof(Title));
    _title_kind.measure = fn_ptr(_title_measure);
    _title_kind.arrange = fn_ptr(_title_arrange);
    _title_kind.paint = fn_ptr(_title_paint);
    _title_kind.event = fn_ptr(_title_event);
    _title_kind.role = access.ROLE_MENU_ITEM;
    _title_kind.access = fn_ptr(_title_access);
    _ready = 1;
}

// A new, empty menu bar as the last child of parent. Its handle, or 0.
fn create(t as *tree.Tree, parent as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, w));
    d.t = t;
    d.self = w;
    d.open = 0 - 1;
    return w;
}

fn _destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Data as d = cast(*Data, data);
    if (d.f10_id != 0) { router.remove_shortcut(d.r, d.f10_id); }
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

fn count(t as *tree.Tree, w as i64) as i64 {
    if (cast(i64, _data(t, w)) == 0) { return 0; }
    return tree.child_count(t, w);
}

// Title i, 0 past the last.
fn title(t as *tree.Tree, w as i64, i as i64) as i64 {
    if (cast(i64, _data(t, w)) == 0 || i < 0) { return 0; }
    let is i64 as ch with mut = tree.first_child(t, w);
    let is i64 as k with mut = 0;
    while (ch != 0 && k < i) {
        ch = tree.next_sibling(t, ch);
        k = k + 1;
    }
    return ch;
}

fn _index(t as *tree.Tree, w as i64, ch as i64) as i64 {
    let is i64 as c with mut = tree.first_child(t, w);
    let is i64 as k with mut = 0;
    while (c != 0) {
        if (c == ch) { return k; }
        c = tree.next_sibling(t, c);
        k = k + 1;
    }
    return 0 - 1;
}

// The title whose menu is open, -1 for none.
fn open_index(t as *tree.Tree, w as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0 - 1; }
    return d.open;
}

fn _menu_of(t as *tree.Tree, w as i64, i as i64) as i64 {
    let is i64 as ti = title(t, w, i);
    if (ti == 0) { return 0; }
    return cast(*Title, tree.data(t, ti)).menu;
}

// --- Opening ---

fn _open(t as *tree.Tree, w as i64, d as *Data, i as i64, by_keys as i32) as void {
    let is *router.Router as r = cast(*router.Router, tree.router(t));
    let is i64 as m = _menu_of(t, w, i);
    if (cast(i64, r) == 0 || m == 0) { return; }
    let is i32 as anchor with mut = positioner.BOTTOM_LEFT;
    let is i32 as gravity with mut = positioner.BOTTOM_RIGHT;
    if (layout.direction(t, w) == layout.RTL) {
        anchor = positioner.BOTTOM_RIGHT;
        gravity = positioner.BOTTOM_LEFT;
    }
    if (menu.popup_at(t, r, m, layout.window_rect(t, title(t, w, i)), anchor, gravity, by_keys) == 1) {
        d.open = i;
        widget.changed(t, w, widget.CHANGED_PAINT);
    }
}

// The open menu closed, title i's opened in its place.
fn _switch(t as *tree.Tree, w as i64, d as *Data, i as i64, by_keys as i32) as void {
    if (d.open >= 0) { menu.close(t, _menu_of(t, w, d.open)); }
    _open(t, w, d, i, by_keys);
}

fn _sideways(user as *u8, dir as i32) as void {
    let is *Data as d = cast(*Data, user);
    let is i64 as n = count(d.t, d.self);
    if (d.open < 0 || n == 0) { return; }
    _switch(d.t, d.self, d, (d.open + cast(i64, dir) + n) % n, 1);
}

fn _outside(user as *u8, x as f64, y as f64) as void {
    let is *Data as d = cast(*Data, user);
    let is i64 as n = count(d.t, d.self);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is math.rect.Rect as r = layout.window_rect(d.t, title(d.t, d.self, i));
        if (x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) {
            if (i != d.open) { _switch(d.t, d.self, d, i, 0); }
            return;
        }
        i = i + 1;
    }
}

fn _closed(t as *tree.Tree, m as i64, arg as *u8, user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    if (d.open >= 0 && _menu_of(t, d.self, d.open) == m) {
        d.open = 0 - 1;
        widget.changed(t, d.self, widget.CHANGED_PAINT);
    }
}

// A title — s, n bytes, an underscore before its mnemonic — opening m, at the
// end. Its handle, or 0.
fn add(t as *tree.Tree, w as i64, s as *u8, n as i64, m as i64) as i64 {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return 0; }
    let is i64 as ti = tree.create(t, &_title_kind, w);
    if (ti == 0) { return 0; }
    let is i64 as lb = label.create(t, ti, "", 0);
    if (lb == 0) {
        tree.destroy(t, ti);
        return 0;
    }
    label.set_text_mnemonic(t, lb, s, n);
    label.set_target(t, lb, ti);
    tree.set_labelled_by(t, ti, lb);
    let is *Title as td = cast(*Title, tree.data(t, ti));
    td.owner = w;
    td.menu = m;
    td.label = lb;
    menu.set_sideways(t, m, fn_ptr(_sideways), cast(*u8, d));
    menu.set_outside(t, m, fn_ptr(_outside), cast(*u8, d));
    signal.connect(t, m, signal.CLOSED, fn_ptr(_closed), cast(*u8, d));
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    return ti;
}

fn _f10(user as *u8) as void {
    let is *Data as d = cast(*Data, user);
    if (count(d.t, d.self) > 0) { _switch(d.t, d.self, d, 0, 1); }
}

// F10 and the titles' mnemonics, from now on.
fn bind(t as *tree.Tree, r as *router.Router, w as i64) as void {
    let is *Data as d = _data(t, w);
    if (cast(i64, d) == 0) { return; }
    if (d.f10_id != 0) { router.remove_shortcut(d.r, d.f10_id); }
    d.r = r;
    d.f10_id = router.add_shortcut_for(r, w, keys.F10, 0, fn_ptr(_f10), cast(*u8, d));
    let is i64 as n = count(t, w);
    let is i64 as i with mut = 0;
    while (i < n) {
        label.bind_mnemonic(t, r, cast(*Title, tree.data(t, title(t, w, i))).label);
        i = i + 1;
    }
}

// --- Measuring and arranging ---

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _pref(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &free, &s);
    return s;
}

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is style.Theme as th;
    widget.theme(t, w, &th);
    geom.size_zero(out);
    let is f64 as h with mut = th.metrics.control_height;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        let is geom.Size as s = _pref(t, ch);
        out.pref_w = out.pref_w + s.pref_w;
        h = _max(h, s.pref_h);
        ch = tree.next_sibling(t, ch);
    }
    out.min_w = out.pref_w;
    out.pref_h = h;
    out.min_h = h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = h;
}

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is i32 as rtl = cast(i32, layout.direction(t, w) == layout.RTL);
    let is f64 as x with mut = 0.0;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        let is f64 as cw = _pref(t, ch).pref_w;
        let is math.rect.Rect as at with mut = math.rect.rect(x, 0.0, cw, r.h);
        if (rtl == 1) { at.x = r.w - x - cw; }
        layout.place(t, ch, &at);
        x = x + cw;
        ch = tree.next_sibling(t, ch);
    }
}

fn _title_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Title as td = cast(*Title, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is geom.Size as ls = _pref(t, td.label);
    geom.size_zero(out);
    out.pref_w = 2.0 * th.metrics.control_pad_x + ls.pref_w;
    out.min_w = out.pref_w;
    out.pref_h = _max(th.metrics.control_height, ls.pref_h);
    out.min_h = out.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn _title_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Title as td = cast(*Title, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is geom.Size as ls = _pref(t, td.label);
    let is math.rect.Rect as lr = math.rect.rect(th.metrics.control_pad_x, (r.h - ls.pref_h) / 2.0, ls.pref_w, ls.pref_h);
    layout.place(t, td.label, &lr);
}

// --- Its titles ---

fn _title_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Title as td = cast(*Title, data);
    let is *Data as d = cast(*Data, tree.data(t, td.owner));
    let is i64 as i = _index(t, td.owner, w);
    if (e.kind == event.POINTER_DOWN && e.button == 1) {
        if (d.open == i) { menu.close(t, td.menu); } else { _switch(t, td.owner, d, i, 0); }
        return 1;
    }
    if (e.kind == event.ACTIVATE) {
        _switch(t, td.owner, d, i, 1);
        return 1;
    }
    return 0;
}

fn _title_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Title as td = cast(*Title, data);
    let is *Data as d = cast(*Data, tree.data(t, td.owner));
    let is f64 as lit with mut = 0.0;
    if ((p.state & painter.S_HOVER) != 0) { lit = 0.06; }
    if (d.open == _index(t, td.owner, w)) { lit = 0.12; }
    if (lit > 0.0) {
        shapes.fill_rect(p.canvas, p.rect.x, p.rect.y, p.rect.w, p.rect.h, style.with_alpha(p.theme.palette.fg, lit));
    }
}

fn _title_access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Title as td = cast(*Title, data);
    let is *Data as d = cast(*Data, tree.data(t, td.owner));
    let is i64 as i = _index(t, td.owner, w);
    if (q.action == access.ASK) {
        q.states = q.states | access.EXPANDABLE;
        q.actions = access.EXPAND;
        if (d.open == i) {
            q.states = q.states | access.EXPANDED;
            q.actions = access.COLLAPSE;
        }
        return 1;
    }
    if (q.action == access.EXPAND) { _switch(t, td.owner, d, i, 1); }
    if (q.action == access.COLLAPSE && d.open == i) { menu.close(t, td.menu); }
    return 1;
}
