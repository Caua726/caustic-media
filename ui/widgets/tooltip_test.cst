// ui/widgets/tooltip_test.cst — tooltips: a widget's tip shown after the
// hover delay below the pointer, kept inside the window, on top of everything;
// hidden by leaving it, a press or a key, and not again until the pointer
// comes back; drawn in the theme's tooltip colours; told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "label.cst" as label;
use "button.cst" as button;
use "tooltip.cst" as tooltip;

let is i64 as W with imut = 240;
let is i64 as H with imut = 200;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [48000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }

// --- Signals ---

let is i64 as toggles with mut = 0;

fn on_toggle(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { toggles = toggles + 1; }

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn measure(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    return s;
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 20.0;
    theme.fonts.caption.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    let is tree.Tree as t = tree_for();
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    layout.set_align(&t, col, layout.START, layout.START);
    let is i64 as a = button.create(&t, col, "Save", 4);
    let is i64 as b = button.create(&t, col, "Open", 4);
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as delay = r.settings.tooltip_ms;
    check("a delay of half a second", delay == 500);
    let is tooltip.Tooltips as tt = tooltip.open(&t, &r);
    check("a tip", tooltip.set(&tt, a, "Save the file", 13) == 1 && tooltip.shown(&tt) == 0);
    layout.run(&t, cast(f64, W), cast(f64, H));

    // Hovered: shown after the delay, not before.
    router.pointer_move(&t, &r, mid_x(&t, a), mid_y(&t, a), 1000);
    tooltip.tick(&tt, 1000);
    check("hovered: not yet", tooltip.shown(&tt) == 0 && tooltip.next_due(&tt) == 1000 + delay);
    tooltip.tick(&tt, 1000 + delay - 1);
    check("not before the delay", tooltip.shown(&tt) == 0);
    tooltip.tick(&tt, 1000 + delay);
    let is i64 as bub with mut = tooltip.shown(&tt);
    check("then shown, for it", bub != 0 && tooltip.showing_for(&tt) == a && tree.kind(&t, bub).role == access.ROLE_TOOLTIP &&
          tooltip.next_due(&tt) == 0 - 1);
    let is i64 as tl with mut = tooltip.label_of(&tt);
    check("its text, its own", same(label.text(&t, tl), label.text_length(&t, tl), "Save the file") == 1 &&
          tree.parent(&t, tl) == bub);
    check("on top of everything", tree.layer(&t, bub) > 0 && tree.parent(&t, bub) == root);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as rb with mut = layout.window_rect(&t, bub);
    check("below the pointer", rb.y >= mid_y(&t, a) + 16.0 && within(rb.x, mid_x(&t, a)) == 1);
    let is math.rect.Rect as rl = layout.window_rect(&t, tl);
    let is f64 as pad = theme.metrics.space_s;
    let is geom.Size as ls = measure(&t, tl);
    check("its text in the theme's small space, on whole pixels", within(rl.x, rb.x + pad) == 1 &&
          within(rl.y, rb.y + pad) == 1 && within(rl.w, rb.w - 2.0 * pad) == 1 &&
          within(rl.h, rb.h - 2.0 * pad) == 1 && within(rb.w, ls.pref_w + 2.0 * pad) == 1 &&
          within(rb.h, ls.pref_h + 2.0 * pad) == 1);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), bub, &q);
    check("told: a tooltip named by its text", same(q.name, q.name_len, "Save the file") == 1);

    // Drawn in the tooltip's colours.
    frame(&t, c_ptr(&c));
    check("its background", is8(cast(i64, rb.x + 3.0), cast(i64, rb.y + 3.0), theme.palette.tooltip_bg, 2) == 1);
    check("its text", is8(ink_x(&t, tl), ink_y(&t, tl), theme.palette.tooltip_fg, 2) == 1);

    // Moving within it: still shown. Onto another: gone.
    router.pointer_move(&t, &r, mid_x(&t, a) + 3.0, mid_y(&t, a), 2000);
    tooltip.tick(&tt, 2000);
    check("moved within it: still shown", tooltip.shown(&tt) == bub);
    router.pointer_move(&t, &r, mid_x(&t, b), mid_y(&t, b), 2100);
    tooltip.tick(&tt, 2100);
    check("onto another with no tip: gone", tooltip.shown(&tt) == 0 && tree.is_valid(&t, bub) == 0 &&
          tooltip.showing_for(&tt) == 0 && tooltip.label_of(&tt) == 0);
    tooltip.tick(&tt, 2100 + delay * 2);
    check("and none for it", tooltip.shown(&tt) == 0 && tooltip.next_due(&tt) == 0 - 1);

    // A press hides it, and it stays hidden until the pointer comes back.
    router.pointer_move(&t, &r, mid_x(&t, a), mid_y(&t, a), 3000);
    tooltip.tick(&tt, 3000);
    tooltip.tick(&tt, 3000 + delay);
    check("back: shown again after the delay", tooltip.shown(&tt) != 0);
    router.pointer_button(&t, &r, 1, 1, mid_x(&t, a), mid_y(&t, a), 3600);
    router.pointer_button(&t, &r, 1, 0, mid_x(&t, a), mid_y(&t, a), 3610);
    tooltip.tick(&tt, 3610);
    check("pressed: hidden", tooltip.shown(&tt) == 0);
    tooltip.tick(&tt, 3610 + delay * 3);
    check("and not again while it stays", tooltip.shown(&tt) == 0 && tooltip.next_due(&tt) == 0 - 1);
    router.pointer_move(&t, &r, 230.0, 195.0, 5000);
    tooltip.tick(&tt, 5000);
    router.pointer_move(&t, &r, mid_x(&t, a), mid_y(&t, a), 5100);
    tooltip.tick(&tt, 5100);
    tooltip.tick(&tt, 5100 + delay);
    check("left and back: shown", tooltip.shown(&tt) != 0);
    key(&t, &r, keys.B, 0, 5700);
    tooltip.tick(&tt, 5700);
    check("a key: hidden", tooltip.shown(&tt) == 0);

    // A press before the delay: none.
    router.pointer_move(&t, &r, 230.0, 195.0, 6000);
    tooltip.tick(&tt, 6000);
    router.pointer_move(&t, &r, mid_x(&t, a), mid_y(&t, a), 6100);
    tooltip.tick(&tt, 6100);
    router.pointer_button(&t, &r, 1, 1, mid_x(&t, a), mid_y(&t, a), 6200);
    router.pointer_button(&t, &r, 1, 0, mid_x(&t, a), mid_y(&t, a), 6210);
    tooltip.tick(&tt, 6100 + delay);
    check("pressed before the delay: none", tooltip.shown(&tt) == 0);

    // Kept inside the window: near its right edge, to the left; near its
    // bottom, above the pointer.
    tooltip.set(&tt, b, "Open a file", 11);
    router.pointer_move(&t, &r, mid_x(&t, b), mid_y(&t, b), 6500);
    tooltip.tick(&tt, 6500);
    tooltip.tick(&tt, 6500 + delay);
    tl = tooltip.label_of(&tt);
    check("another's tip, its own", tooltip.showing_for(&tt) == b &&
          same(label.text(&t, tl), label.text_length(&t, tl), "Open a file") == 1);
    router.pointer_move(&t, &r, 230.0, 195.0, 7000);
    tooltip.tick(&tt, 7000);
    router.pointer_move(&t, &r, 230.0, 195.0, 7001);
    let is i64 as wide = button.create(&t, root, "Wide", 4);
    layout.set_align(&t, wide, layout.FILL, layout.END);
    layout.run(&t, cast(f64, W), cast(f64, H));
    tooltip.set(&tt, wide, "A tip long enough to need room", 30);
    router.pointer_move(&t, &r, 230.0, 195.0, 7100);
    tooltip.tick(&tt, 7100);
    tooltip.tick(&tt, 7100 + delay);
    bub = tooltip.shown(&tt);
    layout.run(&t, cast(f64, W), cast(f64, H));
    rb = layout.window_rect(&t, bub);
    check("inside the window, across", bub != 0 && rb.x + rb.w <= cast(f64, W) && rb.x < 230.0);
    check("and down: above the pointer", rb.y + rb.h <= 195.0);

    // A tip changed while shown; taken away; its widget gone.
    tooltip.set(&tt, wide, "Short", 5);
    tl = tooltip.label_of(&tt);
    check("changed while shown: the new text", same(label.text(&t, tl), label.text_length(&t, tl), "Short") == 1);
    tooltip.set(&tt, wide, cast(*u8, 0), 0);
    tooltip.tick(&tt, 8000);
    check("taken away: gone", tooltip.shown(&tt) == 0);
    tooltip.set(&tt, wide, "Again", 5);
    router.pointer_move(&t, &r, 100.0, 100.0, 9000);
    tooltip.tick(&tt, 9000);
    router.pointer_move(&t, &r, 230.0, 195.0, 9100);
    tooltip.tick(&tt, 9100);
    tooltip.tick(&tt, 9100 + delay);
    check("shown again", tooltip.shown(&tt) != 0);
    tree.destroy(&t, wide);
    tooltip.tick(&tt, 9800);
    check("its widget gone: gone", tooltip.shown(&tt) == 0);
    check("a tip for nothing: refused", tooltip.set(&tt, 0, "x", 1) == 0);
    // A full table: refused; a dead widget's place taken back.
    let is [64]i64 as many;
    let is i64 as i with mut = 0;
    let is i32 as all with mut = 1;
    while (i < 64) {
        many[i] = button.create(&t, col, "x", 1);
        if (tooltip.set(&tt, many[i], "x", 1) == 0) { all = 0; }
        i = i + 1;
    }
    check("the table filled", all == 0);
    let is i64 as extra = button.create(&t, col, "y", 1);
    check("full: refused", tooltip.set(&tt, extra, "y", 1) == 0);
    tree.destroy(&t, many[40]);
    check("a place freed by a widget gone", tooltip.set(&tt, extra, "y", 1) == 1);
    check("changed in place: no new one needed", tooltip.set(&tt, extra, "z", 1) == 1);
    // Right to left: at the pointer all the same.
    layout.set_direction(&t, root, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    tree.destroy(&t, many[41]);
    check("a tip for the window", tooltip.set(&tt, root, "Root", 4) == 1);
    router.pointer_leave(&t, &r, 9990);
    tooltip.tick(&tt, 9990);
    router.pointer_move(&t, &r, 20.0, 150.0, 10000);
    tooltip.tick(&tt, 10000);
    tooltip.tick(&tt, 10000 + delay);
    bub = tooltip.shown(&tt);
    layout.run(&t, cast(f64, W), cast(f64, H));
    rb = layout.window_rect(&t, bub);
    check("right to left: at the pointer all the same", bub != 0 && tooltip.showing_for(&tt) == root && within(rb.x, 20.0) == 1);
    layout.set_direction(&t, root, layout.LTR);
    tooltip.close(&tt);
    tree.close(&t);

    if (fails == 0) {
        io.printf("tooltip: %d checks passed\n", checks);
        return 0;
    }
    io.printf("tooltip: %d of %d checks failed\n", fails, checks);
    return 1;
}

fn c_ptr(c as *draw2d.Canvas) as *draw2d.Canvas { return c; }

// a and b less than a pixel apart.
fn within(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 1.0 && d > 0.0 - 1.0);
}
