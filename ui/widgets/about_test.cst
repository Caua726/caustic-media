// ui/widgets/about_test.cst — an about dialog: a program's name, version,
// what it does, its website and copyright; who made it and its licence,
// shown in its place by Credits and License.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "../stack.cst" as stack;
use "dialog.cst" as dialog;
use "label.cst" as label;
use "button.cst" as button;
use "image.cst" as image;
use "about.cst" as about;

let is i64 as W with imut = 480;
let is i64 as H with imut = 480;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.6 && d > 0.0 - 0.6);
}

fn mx(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).x + layout.window_rect(t, w).w / 2.0; }
fn my(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).y + layout.window_rect(t, w).h / 2.0; }

fn says(t as *tree.Tree, l as i64, s as *u8) as i32 {
    if (same(label.text(t, l), label.text_length(t, l), s) == 1) { return 1; }
    io.printf("  says %d bytes\n", label.text_length(t, l));
    return 0;
}

let is i64 as answered with mut = 0;
let is i64 as answers with mut = 0;
fn on_answer(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    answered = *cast(*i64, arg);
    answers = answers + 1;
}

fn shown_here(t as *tree.Tree, w as i64) as i32 { return cast(i32, tree.is_hidden_here(t, w) == 0); }

// Shown, its page too.
fn seen(t as *tree.Tree, w as i64) as i32 { return tree.is_visible(t, w); }

fn made() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as a = about.create(&t, "Caustic Demo", 12);
    signal.connect(&t, a, signal.ACTIVATED, fn_ptr(on_answer), cast(*u8, 0));
    check("titled for the program, its name in it", a != 0 && says(&t, dialog.title_label(&t, a), "About Caustic Demo") == 1 &&
          says(&t, about.name_label(&t, a), "Caustic Demo") == 1);
    check("nothing else until it is said", shown_here(&t, about.version_label(&t, a)) == 0 &&
          shown_here(&t, about.comments_label(&t, a)) == 0 && shown_here(&t, about.website_link(&t, a)) == 0 &&
          shown_here(&t, about.copyright_label(&t, a)) == 0 && shown_here(&t, about.logo_of(&t, a)) == 0 &&
          dialog.button_for(&t, a, about.CREDITS_ANSWER) == 0 && dialog.button_for(&t, a, about.LICENSE_ANSWER) == 0);
    about.set_version(&t, a, "1.2.3", 5);
    about.set_comments(&t, a, "Shows what the toolkit does.", 28);
    about.set_website(&t, a, "https://example.org", "Website", 7);
    about.set_copyright(&t, a, "Copyright 2026 The Authors", 26);
    about.set_logo(&t, a, 7, 64.0, 64.0);
    check("each shown once said", says(&t, about.version_label(&t, a), "1.2.3") == 1 &&
          says(&t, about.comments_label(&t, a), "Shows what the toolkit does.") == 1 &&
          says(&t, about.copyright_label(&t, a), "Copyright 2026 The Authors") == 1 &&
          says(&t, button.content(&t, about.website_link(&t, a)), "Website") == 1 &&
          shown_here(&t, about.version_label(&t, a)) == 1 && shown_here(&t, about.website_link(&t, a)) == 1 &&
          shown_here(&t, about.logo_of(&t, a)) == 1);
    about.set_version(&t, a, "", 0);
    check("an empty one hidden again", shown_here(&t, about.version_label(&t, a)) == 0);
    about.set_version(&t, a, "1.2.3", 5);
    // Credits and a licence: their buttons, at the start.
    about.add_credits(&t, a, "Created by", 10, "Alice\nBob", 9);
    about.add_credits(&t, a, "Documented by", 13, "Carol", 5);
    about.set_license(&t, a, "Permission is granted.", 22);
    let is i64 as cb = dialog.button_for(&t, a, about.CREDITS_ANSWER);
    let is i64 as lb = dialog.button_for(&t, a, about.LICENSE_ANSWER);
    let is i64 as close = dialog.button_for(&t, a, dialog.CLOSE);
    check("credits, a section after another", cb != 0 && says(&t, about.credits_label(&t, a), "Created by\nAlice\nBob\n\nDocumented by\nCarol") == 1);
    check("the licence", lb != 0 && says(&t, about.license_label(&t, a), "Permission is granted.") == 1);
    check("their buttons secondary, toggles", dialog.is_secondary(&t, a, about.CREDITS_ANSWER) == 1 && dialog.is_secondary(&t, a, about.LICENSE_ANSWER) == 1 &&
          button.is_toggle(&t, cb) == 1 && button.is_toggle(&t, lb) == 1);
    dialog.show(&t, &r, a, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ar = layout.window_rect(&t, a);
    let is f64 as centre = ar.x + ar.w / 2.0;
    let is math.rect.Rect as nr = layout.window_rect(&t, about.name_label(&t, a));
    let is math.rect.Rect as vr = layout.window_rect(&t, about.version_label(&t, a));
    let is math.rect.Rect as gr = layout.window_rect(&t, about.logo_of(&t, a));
    let is math.rect.Rect as cr = layout.window_rect(&t, about.copyright_label(&t, a));
    let is math.rect.Rect as wr = layout.window_rect(&t, about.website_link(&t, a));
    check("down its middle: the logo, the name, the version, ..., the copyright", near(nr.x + nr.w / 2.0, centre) == 1 &&
          near(vr.x + vr.w / 2.0, centre) == 1 && near(gr.x + gr.w / 2.0, centre) == 1 && gr.w == 64.0 &&
          gr.y + gr.h <= nr.y && nr.y + nr.h <= vr.y && vr.y < wr.y && wr.y + wr.h <= cr.y);
    let is math.rect.Rect as cbr = layout.window_rect(&t, cb);
    let is math.rect.Rect as lbr = layout.window_rect(&t, lb);
    let is math.rect.Rect as clr = layout.window_rect(&t, close);
    check("credits and licence at the foot's start, close at its end", cbr.x < lbr.x && lbr.x + lbr.w < clr.x &&
          near(cbr.x, ar.x + theme.metrics.space_l) == 1);
    check("the main page first", about.page(&t, a) == about.MAIN && seen(&t, about.name_label(&t, a)) == 1 &&
          seen(&t, about.credits_label(&t, a)) == 0 && seen(&t, about.license_label(&t, a)) == 0);
    // Credits, then the licence, then back.
    answers = 0;
    click(&t, &r, mx(&t, cb), my(&t, cb), 10);
    check("credits: shown in its place, the button down, still open", about.page(&t, a) == about.CREDITS && button.is_active(&t, cb) == 1 &&
          dialog.is_shown(&t, a) == 1 && answers == 0 && seen(&t, about.credits_label(&t, a)) == 1 &&
          seen(&t, about.name_label(&t, a)) == 0);
    click(&t, &r, mx(&t, lb), my(&t, lb), 20);
    check("the licence instead", about.page(&t, a) == about.LICENSE && button.is_active(&t, lb) == 1 && button.is_active(&t, cb) == 0 &&
          seen(&t, about.license_label(&t, a)) == 1 && seen(&t, about.credits_label(&t, a)) == 0);
    click(&t, &r, mx(&t, lb), my(&t, lb), 30);
    check("pressed again: back", about.page(&t, a) == about.MAIN && button.is_active(&t, lb) == 0 && dialog.is_shown(&t, a) == 1);
    click(&t, &r, mx(&t, cb), my(&t, cb), 40);
    key(&t, &r, keys.ESCAPE, 0, 50);
    check("escape: hidden, back to the main page", dialog.is_shown(&t, a) == 0 && about.page(&t, a) == about.MAIN &&
          button.is_active(&t, cb) == 0 && answers == 1);
    dialog.show(&t, &r, a, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    click(&t, &r, mx(&t, lb), my(&t, lb), 54);
    key(&t, &r, keys.ESCAPE, 0, 56);
    check("escape on the licence: its button up again", button.is_active(&t, lb) == 0 && about.page(&t, a) == about.MAIN);
    answers = 1;
    dialog.show(&t, &r, a, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    click(&t, &r, mx(&t, close), my(&t, close), 60);
    check("close: hidden, said", dialog.is_shown(&t, a) == 0 && answers == 2 && answered == dialog.CLOSE);
    // Told.
    dialog.show(&t, &r, a, 1);
    let is tree.Access as q;
    access.describe(&t, &r, a, &q);
    check("told as a dialog named by its title", q.role == access.ROLE_DIALOG && same(q.name, q.name_len, "About Caustic Demo") == 1);
    access.describe(&t, &r, cb, &q);
    check("its credits a toggle", q.role == access.ROLE_TOGGLE_BUTTON);
    access.describe(&t, &r, about.logo_of(&t, a), &q);
    check("its logo described as the program", same(q.name, q.name_len, "Caustic Demo") == 1);
    let is i64 as top = tree.root(&t);
    check("not an about dialog: nothing", about.name_label(&t, top) == 0 && about.page(&t, top) == 0 - 1 &&
          about.credits_label(&t, top) == 0 && about.version_label(&t, top) == 0 && about.comments_label(&t, top) == 0 &&
          about.website_link(&t, top) == 0 && about.copyright_label(&t, top) == 0 && about.logo_of(&t, top) == 0 &&
          about.license_label(&t, top) == 0);
    about.set_version(&t, top, "x", 1);
    about.add_credits(&t, top, "x", 1, "y", 1);
    tree.close(&t);
}

// Credits past what it keeps: sixteen sections, eight thousand bytes.
fn credited() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as a = about.create(&t, "Many", 4);
    let is i64 as k with mut = 0;
    while (k < 17) {
        about.add_credits(&t, a, "S", 1, "n", 1);
        k = k + 1;
    }
    let is i64 as cl = about.credits_label(&t, a);
    check("sixteen sections, not a seventeenth", label.text_length(&t, cl) == 16 * 3 + 15 * 2);
    let is i64 as b = about.create(&t, "Long", 4);
    let is *u8 as names = mem.core.mmap_anon(9000);
    mem.memset(names, 120, 9000);
    about.add_credits(&t, b, "S", 1, names, 8190);
    check("a section that just fits: 8192 bytes", label.text_length(&t, about.credits_label(&t, b)) == 8192);
    about.add_credits(&t, b, "S", 1, "n", 1);
    check("no room for more: as it was", label.text_length(&t, about.credits_label(&t, b)) == 8192);
    let is i64 as c = about.create(&t, "Longer", 6);
    about.add_credits(&t, c, "S", 1, names, 8191);
    check("one byte past: not taken", label.text_length(&t, about.credits_label(&t, c)) == 0);
    about.add_credits(&t, c, "S", 1, names, 4000);
    about.add_credits(&t, c, "S", 1, names, 4186);
    check("a second that just fits", label.text_length(&t, about.credits_label(&t, c)) == 4002 + 2 + 4188);
    let is i64 as e = about.create(&t, "Over", 4);
    about.add_credits(&t, e, "S", 1, names, 4000);
    about.add_credits(&t, e, "S", 1, names, 4187);
    check("a second a byte past: not taken", label.text_length(&t, about.credits_label(&t, e)) == 4002);
    tree.close(&t);
}

// In the tree's language: its title, its buttons, the sections the toolkit
// names.
fn spoken() as void {
    let is tree.Tree as t = tree_for();
    tree.set_language(&t, strings.PT_BR);
    let is i64 as a = about.create(&t, "Notas", 5);
    check("titled in it", says(&t, dialog.title_label(&t, a), "Sobre Notas") == 1);
    check("closed in it", says(&t, button.content(&t, dialog.button_for(&t, a, dialog.CLOSE)), "Fechar") == 1);
    about.add_authors(&t, a, "Ana\nBeto", 8);
    about.add_documenters(&t, a, "Caio", 4);
    about.set_license(&t, a, "Livre.", 6);
    check("its authors and documenters, named in it", says(&t, about.credits_label(&t, a), "Criado por\nAna\nBeto\n\nDocumentado por\nCaio") == 1);
    check("its pages' buttons", says(&t, button.content(&t, dialog.button_for(&t, a, about.CREDITS_ANSWER)), "Créditos") == 1 &&
          says(&t, button.content(&t, dialog.button_for(&t, a, about.LICENSE_ANSWER)), "Licença") == 1);
    tree.set_language(&t, strings.EN);
    let is i64 as b = about.create(&t, "Notes", 5);
    check("English again", says(&t, dialog.title_label(&t, b), "About Notes") == 1);
    about.add_authors(&t, b, "Ana", 3);
    // A name past what it keeps, 128 bytes, cut where a character starts.
    let is [130]u8 as long;
    mem.memset(cast(*u8, &long), 120, 127);
    long[127] = cast(u8, 195);
    long[128] = cast(u8, 169);
    let is i64 as c = about.create(&t, cast(*u8, &long), 129);
    check("a long name cut between characters", label.text_length(&t, about.name_label(&t, c)) == 127 &&
          label.text_length(&t, dialog.title_label(&t, c)) == 6 + 127);
    check("its sections in English", says(&t, about.credits_label(&t, b), "Created by\nAna") == 1);
    tree.close(&t);
}

fn unused() as void {
    let is tree.Tree as t = tree_for();
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    theme = style.light();
    theme.fonts.body.size = 16.0;
    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    made();
    credited();
    spoken();

    if (fails == 0) {
        io.printf("about: %d checks passed\n", checks);
        return 0;
    }
    io.printf("about: %d of %d checks failed\n", fails, checks);
    return 1;
}
