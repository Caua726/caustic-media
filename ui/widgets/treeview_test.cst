// ui/widgets/treeview_test.cst — a tree view: a tree model's rows shown as a
// list, branches opened by their expander and the keys, read when opened,
// drawn and told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "label.cst" as label;
use "../event.cst" as event;
use "../scroll.cst" as scroll;
use "../model.cst" as model;
use "listview.cst" as listview;
use "treeview.cst" as treeview;
use "../flatten.cst" as flatten;

let is i64 as W with imut = 400;
let is i64 as H with imut = 240;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}



// --- A tree of files ---
//
//   1 docs           2 music
//   ├─ 3 a.txt       └─ 7 song
//   ├─ 4 b.txt
//   └─ 5 sub
//      └─ 6 c.txt
struct Branch {
    parent as i64;
    n      as i64;
    kids   as [8]i64;
}

let is [16]Branch as nodes with mut;
let is i64 as counted with mut = 0;   // count() asked of a node not the top
let is model.Model as src with mut;

fn name(id as i64) as *u8 {
    if (id == 1) { return "docs"; }
    if (id == 2) { return "music"; }
    if (id == 3) { return "a.txt"; }
    if (id == 4) { return "b.txt"; }
    if (id == 5) { return "sub"; }
    if (id == 6) { return "c.txt"; }
    if (id == 7) { return "song"; }
    return "new";
}

fn length(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn files_count(self as *u8, parent as i64) as i64 {
    if (parent != 0) { counted = counted + 1; }
    return nodes[parent].n;
}

fn files_row_id(self as *u8, parent as i64, index as i64) as i64 {
    if (index < 0 || index >= nodes[parent].n) { return 0; }
    return nodes[parent].kids[index];
}

fn files_parent_of(self as *u8, id as i64) as i64 { return nodes[id].parent; }

// 8 says it has children, as a lazy model before loading, and has none.
fn files_has_children(self as *u8, id as i64) as i64 {
    if (id == 8) { return 1; }
    return cast(i64, nodes[id].n > 0);
}

fn files_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    if (role != model.TEXT || column != 0) { return 0; }
    *out = model.text(name(id), length(name(id)));
    return 1;
}

fn add(parent as i64, id as i64) as void {
    nodes[parent].kids[nodes[parent].n] = id;
    nodes[parent].n = nodes[parent].n + 1;
    nodes[id].parent = parent;
    nodes[id].n = 0;
}

fn grow() as void {
    nodes[0].n = 0;
    add(0, 1);
    add(0, 2);
    add(1, 3);
    add(1, 4);
    add(1, 5);
    add(5, 6);
    add(2, 7);
}

let is i64 as changes with mut = 0;
let is i64 as activated with mut = 0;

fn on_change(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { changes = changes + 1; }
fn on_activate(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { activated = *cast(*i64, arg); }

fn made(t as *tree.Tree) as i64 {
    grow();
    let is i64 as tv = treeview.create(t, tree.root(t), &src);
    signal.connect(t, tv, signal.SELECTION_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    signal.connect(t, tv, signal.ACTIVATED, fn_ptr(on_activate), cast(*u8, 0));
    return tv;
}

// The label of the row at index.
fn label_of(t as *tree.Tree, tv as i64, index as i64) as i64 {
    let is i64 as rw = listview.row_widget(t, treeview.list(t, tv), index);
    if (rw == 0) { return 0; }
    return treeview.row_label(t, rw);
}

fn shows(t as *tree.Tree, tv as i64, index as i64, s as *u8) as i32 {
    let is i64 as l = label_of(t, tv, index);
    if (l == 0) { return 0; }
    return same(label.text(t, l), label.text_length(t, l), s);
}

fn expander_of(t as *tree.Tree, tv as i64, index as i64) as i64 {
    let is i64 as rw = listview.row_widget(t, treeview.list(t, tv), index);
    if (rw == 0) { return 0; }
    return treeview.row_expander(t, rw);
}

fn click_on(t as *tree.Tree, r as *router.Router, w as i64, time as i64) as void {
    let is math.rect.Rect as wr = layout.window_rect(t, w);
    let is f64 as x = wr.x + wr.w / 2.0;
    let is f64 as y = wr.y + wr.h / 2.0;
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn opened() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    counted = 0;
    let is i64 as tv = made(&t);
    let is i64 as lv = treeview.list(&t, tv);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the top level shown, nothing under it read", listview.count(&t, lv) == 2 && shows(&t, tv, 0, "docs") == 1 &&
          shows(&t, tv, 1, "music") == 1 && counted == 0);
    check("each with an expander", expander_of(&t, tv, 0) != 0 && treeview.is_expanded(&t, tv, 0) == 0);
    let is math.rect.Rect as l0 = layout.window_rect(&t, label_of(&t, tv, 0));
    let is math.rect.Rect as e0 = layout.window_rect(&t, expander_of(&t, tv, 0));
    check("the expander before the name", e0.x + e0.w <= l0.x && e0.w > 0.0);
    // Its expander clicked: opened, nothing chosen.
    click_on(&t, &r, expander_of(&t, tv, 0), 10);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the expander clicked: opened, its children under it", treeview.is_expanded(&t, tv, 0) == 1 &&
          listview.count(&t, lv) == 5 && shows(&t, tv, 1, "a.txt") == 1 && shows(&t, tv, 3, "sub") == 1 &&
          shows(&t, tv, 4, "music") == 1 && counted > 0 && listview.selected_count(&t, lv) == 0);
    let is math.rect.Rect as l1 = layout.window_rect(&t, label_of(&t, tv, 1));
    check("one deeper: further in by the indent", near(l1.x - l0.x, treeview.indent(&t, tv)) == 1 && treeview.indent(&t, tv) > 0.0);
    click_on(&t, &r, expander_of(&t, tv, 0), 2000);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("clicked again: closed", treeview.is_expanded(&t, tv, 0) == 0 && listview.count(&t, lv) == 2);
    // The keys.
    router.focus(&t, &r, lv, 1);
    key(&t, &r, keys.DOWN, 0, 3000);
    check("down: the first", listview.cursor(&t, lv) == 0 && listview.is_selected(&t, lv, 0) == 1 && changes > 0);
    key(&t, &r, keys.RIGHT, 0, 3010);
    check("right on one closed: opened, the keyboard stays", treeview.is_expanded(&t, tv, 0) == 1 && listview.cursor(&t, lv) == 0);
    key(&t, &r, keys.RIGHT, 0, 3020);
    check("right on one open: its first child", listview.cursor(&t, lv) == 1 && listview.is_selected(&t, lv, 1) == 1);
    key(&t, &r, keys.RIGHT, 0, 3030);
    check("right on a leaf: nothing", listview.cursor(&t, lv) == 1 && listview.count(&t, lv) == 5);
    key(&t, &r, keys.DOWN, 0, 3040);
    key(&t, &r, keys.DOWN, 0, 3050);
    key(&t, &r, keys.RIGHT, 0, 3060);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("deeper still", listview.count(&t, lv) == 6 && shows(&t, tv, 4, "c.txt") == 1);
    key(&t, &r, keys.RIGHT, 0, 3070);
    key(&t, &r, keys.LEFT, 0, 3080);
    check("left on a leaf: its parent", listview.cursor(&t, lv) == 3 && listview.is_selected(&t, lv, 3) == 1);
    key(&t, &r, keys.LEFT, 0, 3090);
    check("left on one open: closed", treeview.is_expanded(&t, tv, 3) == 0 && listview.count(&t, lv) == 5 &&
          listview.cursor(&t, lv) == 3);
    key(&t, &r, keys.LEFT, 0, 3100);
    check("left again: its parent", listview.cursor(&t, lv) == 0);
    key(&t, &r, keys.LEFT, 0, 3110);
    key(&t, &r, keys.LEFT, 0, 3120);
    check("left at the top, closed: nothing", treeview.is_expanded(&t, tv, 0) == 0 && listview.cursor(&t, lv) == 0);
    // Right to left: the other way.
    layout.set_direction(&t, tv, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    key(&t, &r, keys.LEFT, 0, 4000);
    check("right to left: left opens", treeview.is_expanded(&t, tv, 0) == 1);
    key(&t, &r, keys.RIGHT, 0, 4010);
    check("and right closes", treeview.is_expanded(&t, tv, 0) == 0);
    key(&t, &r, keys.LEFT, 0, 4020);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as rl0 = layout.window_rect(&t, label_of(&t, tv, 0));
    let is math.rect.Rect as rl1 = layout.window_rect(&t, label_of(&t, tv, 1));
    let is math.rect.Rect as re0 = layout.window_rect(&t, expander_of(&t, tv, 0));
    check("right to left: from the right, deeper further left", rl0.x + rl0.w <= re0.x &&
          near((rl0.x + rl0.w) - (rl1.x + rl1.w), treeview.indent(&t, tv)) == 1);
    // Activated, said by it.
    activated = 0;
    key(&t, &r, keys.RETURN, 0, 5000);
    check("enter: activated, said by the tree view", activated == 1);
    // By the program.
    treeview.collapse(&t, tv, 0);
    check("closed by the program", treeview.is_expanded(&t, tv, 0) == 0 && listview.count(&t, lv) == 2);
    treeview.expand(&t, tv, 1);
    check("opened by the program", treeview.is_expanded(&t, tv, 1) == 1 && listview.count(&t, lv) == 3 &&
          flatten.count(treeview.flat(&t, tv)) == 3);
    check("not a tree view: nothing", treeview.list(&t, tree.root(&t)) == 0 && treeview.is_expanded(&t, tree.root(&t), 0) == 0 &&
          treeview.indent(&t, tree.root(&t)) == 0.0 && treeview.expand(&t, tree.root(&t), 0) == 0 &&
          treeview.collapse(&t, tree.root(&t), 0) == 0 && treeview.flat(&t, tree.root(&t)) == cast(*flatten.Flat, 0));
    tree.destroy(&t, tv);
    model.reset(&src);
    check("destroyed: the tree no longer heard", 1 == 1);
    tree.close(&t);
}

// Its rows laid out: the indent the theme's, or the program's; the expander
// and name across each row's middle, the name to the row's end.
fn laid() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as tv = made(&t);
    let is i64 as lv = treeview.list(&t, tv);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the theme's indent: an expander and a little", near(treeview.indent(&t, tv), theme.metrics.indicator + theme.metrics.space_xs) == 1);
    let is math.rect.Rect as rr = layout.window_rect(&t, listview.row_widget(&t, lv, 0));
    let is math.rect.Rect as l0 = layout.window_rect(&t, label_of(&t, tv, 0));
    let is math.rect.Rect as e0 = layout.window_rect(&t, expander_of(&t, tv, 0));
    let is f64 as px = theme.metrics.control_pad_x;
    check("across the row's middle", near(l0.y + l0.h / 2.0, rr.y + rr.h / 2.0) == 1 && near(e0.y + e0.h / 2.0, rr.y + rr.h / 2.0) == 1);
    check("the expander at the start, the name to the end", near(e0.x, rr.x + px) == 1 &&
          near(l0.x + l0.w, rr.x + rr.w - px) == 1 && near(l0.x, e0.x + e0.w + theme.metrics.space_xs) == 1);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ts;
    let is geom.Size as ls;
    layout.measure(&t, tv, &free, &ts);
    layout.measure(&t, label_of(&t, tv, 0), &free, &ls);
    check("as wide as its first row would like", near(ts.pref_w, 2.0 * px + theme.metrics.indicator + theme.metrics.space_xs + ls.pref_w) == 1);
    treeview.set_indent(&t, tv, 30.0);
    treeview.expand(&t, tv, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as l1 = layout.window_rect(&t, label_of(&t, tv, 1));
    check("its own indent", near(treeview.indent(&t, tv), 30.0) == 1 && near(l1.x - layout.window_rect(&t, label_of(&t, tv, 0)).x, 30.0) == 1);
    layout.set_direction(&t, tv, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as re0 = layout.window_rect(&t, expander_of(&t, tv, 0));
    let is math.rect.Rect as re1 = layout.window_rect(&t, expander_of(&t, tv, 1));
    check("right to left: the expander at the right, deeper further left", near(re0.x + re0.w, rr.x + rr.w - px) == 1 &&
          near(re0.x - re1.x, 30.0) == 1);
    treeview.set_indent(&t, tree.root(&t), 5.0);
    tree.close(&t);
}

// What it does not take goes on: a leaf's expander pressed is its row
// pressed; the keys it has no use for.
fn passed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as tv = made(&t);
    let is i64 as lv = treeview.list(&t, tv);
    // 8, with nothing under it, between docs and music.
    nodes[0].kids[2] = nodes[0].kids[1];
    nodes[0].kids[1] = 8;
    nodes[0].n = 3;
    nodes[8].parent = 0;
    nodes[8].n = 0;
    model.inserted(&src, 0, 1, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, lv, 1);
    check("right with no row: taken all the same", router.key(&t, &r, keys.RIGHT, 0, 1, 0, 10) == 1);
    router.key(&t, &r, keys.RIGHT, 0, 0, 0, 11);
    treeview.expand(&t, tv, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    click_on(&t, &r, expander_of(&t, tv, 1), 100);
    check("a leaf's expander pressed: its row chosen", listview.is_selected(&t, lv, 1) == 1 && listview.cursor(&t, lv) == 1);
    router.pointer_move(&t, &r, mid_x(&t, expander_of(&t, tv, 2)), mid_y(&t, expander_of(&t, tv, 2)), 200);
    router.pointer_button(&t, &r, 3, 1, mid_x(&t, expander_of(&t, tv, 2)), mid_y(&t, expander_of(&t, tv, 2)), 200);
    router.pointer_button(&t, &r, 3, 0, mid_x(&t, expander_of(&t, tv, 2)), mid_y(&t, expander_of(&t, tv, 2)), 201);
    check("the right button on an expander: its row's", listview.is_selected(&t, lv, 2) == 1);
    router.focus(&t, &r, lv, 1);
    check("right and left, used: taken", router.key(&t, &r, keys.LEFT, 0, 1, 0, 300) == 1 &&
          router.key(&t, &r, keys.LEFT, 0, 0, 0, 301) == 0 && listview.cursor(&t, lv) == 0 &&
          router.key(&t, &r, keys.LEFT, 0, 1, 0, 310) == 1 && router.key(&t, &r, keys.RIGHT, 0, 1, 0, 320) == 1);
    check("with control, or other keys: not", router.key(&t, &r, keys.RIGHT, keys.MOD_CONTROL, 1, 0, 330) == 0 &&
          router.key(&t, &r, keys.F2, 0, 1, 0, 340) == 0);
    // A branch that says it has children and has none: opened, nothing under it.
    listview.go_to(&t, lv, listview.count(&t, lv) - 2);
    key(&t, &r, keys.RIGHT, 0, 400);
    let is i64 as at = listview.cursor(&t, lv);
    key(&t, &r, keys.RIGHT, 0, 410);
    check("opened with nothing under it: right goes nowhere, not on to the next", treeview.is_expanded(&t, tv, at) == 1 &&
          listview.cursor(&t, lv) == at && shows(&t, tv, at, "new") == 1);
    tree.close(&t);
}

// Dark pixels on row y from x0 to x1, and the first of them (-1 for none).
let is i64 as first_dark with mut = 0;

fn dark_on(y as i64, x0 as i64, x1 as i64) as i64 {
    let is i64 as k with mut = 0;
    first_dark = 0 - 1;
    let is i64 as x with mut = x0;
    while (x <= x1) {
        if (ch(x, y, 0) < 150) {
            if (first_dark < 0) { first_dark = x; }
            k = k + 1;
        }
        x = x + 1;
    }
    return k;
}

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is i64 as tv = made(&t);
    treeview.expand(&t, tv, 0);
    frame(&t, c);
    let is math.rect.Rect as e0 = layout.window_rect(&t, expander_of(&t, tv, 0));
    let is math.rect.Rect as e1 = layout.window_rect(&t, expander_of(&t, tv, 1));
    let is i64 as cx = cast(i64, e0.x + e0.w / 2.0);
    let is i64 as cy = cast(i64, e0.y + e0.h / 2.0);
    check("open: a triangle pointing down", is8(cx, cy, theme.palette.fg, 90) == 1 &&
          is8(cx, cast(i64, e0.y + e0.h * 0.25), theme.palette.fg, 90) == 0);
    check("a leaf: none", is8(cast(i64, e1.x + e1.w / 2.0), cast(i64, e1.y + e1.h / 2.0), theme.palette.window_bg, 4) == 1);
    let is math.rect.Rect as e4 = layout.window_rect(&t, expander_of(&t, tv, 4));
    check("closed: a triangle pointing along the line", is8(cast(i64, e4.x + e4.w / 2.0), cast(i64, e4.y + e4.h / 2.0),
          theme.palette.fg, 90) == 1 && is8(cast(i64, e4.x + e4.w * 0.75), cast(i64, e4.y + e4.h / 2.0), theme.palette.fg, 90) == 0);
    // Wide when it points down, narrow when it points along.
    let is i64 as wide = dark_on(cy - 1, cx - 7, cx + 7);
    let is i64 as cx4 = cast(i64, e4.x + e4.w / 2.0);
    let is i64 as cy4 = cast(i64, e4.y + e4.h / 2.0);
    let is i64 as narrow = dark_on(cy4 - 1, cx4 - 7, cx4 + 7);
    check("open wide, closed narrow", wide >= 6 && narrow <= 5 && narrow >= 2);
    dark_on(cy4 - 2, cx4 - 7, cx4 + 7);
    let is i64 as ltr_first = first_dark;
    layout.set_direction(&t, tv, layout.RTL);
    frame(&t, c);
    let is math.rect.Rect as f4 = layout.window_rect(&t, expander_of(&t, tv, 4));
    let is i64 as fx = cast(i64, f4.x + f4.w / 2.0);
    dark_on(cast(i64, f4.y + f4.h / 2.0) - 2, fx - 7, fx + 7);
    check("right to left: pointing the other way", ltr_first <= cx4 - 2 && first_dark >= fx - 1);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as tv = made(&t);
    let is i64 as lv = treeview.list(&t, tv);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is tree.Access as q;
    access.describe(&t, &r, lv, &q);
    check("told: a tree", q.role == access.ROLE_TREE);
    let is i64 as rw = listview.row_widget(&t, lv, 0);
    access.describe(&t, &r, rw, &q);
    check("its rows tree items, named, closed", q.role == access.ROLE_TREE_ITEM && same(q.name, q.name_len, "docs") == 1 &&
          (q.states & access.EXPANDABLE) != 0 && (q.states & access.EXPANDED) == 0 && (q.actions & access.EXPAND) != 0 &&
          (q.states & access.SELECTABLE) != 0);
    check("opened by assistive technology", access.act(&t, rw, access.EXPAND, 0.0) == 1 && treeview.is_expanded(&t, tv, 0) == 1);
    access.describe(&t, &r, rw, &q);
    check("then told open", (q.states & access.EXPANDED) != 0 && (q.actions & access.COLLAPSE) != 0 &&
          (q.actions & access.EXPAND) == 0);
    check("closed by it", access.act(&t, rw, access.COLLAPSE, 0.0) == 1 && treeview.is_expanded(&t, tv, 0) == 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    treeview.expand(&t, tv, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    access.describe(&t, &r, listview.row_widget(&t, lv, 1), &q);
    check("a leaf: nothing to open", (q.states & access.EXPANDABLE) == 0 && (q.actions & (access.EXPAND | access.COLLAPSE)) == 0);
    check("still chosen by it", access.act(&t, listview.row_widget(&t, lv, 1), access.SELECT, 0.0) == 1 &&
          listview.is_selected(&t, lv, 1) == 1);
    tree.close(&t);
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;
    src = model.make(cast(*u8, 0), fn_ptr(files_count), fn_ptr(files_row_id), fn_ptr(files_cell));
    src.parent_of = fn_ptr(files_parent_of);
    src.has_children = fn_ptr(files_has_children);

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    opened();
    laid();
    passed();
    drawn(&c);
    told();

    if (fails == 0) {
        io.printf("treeview: %d checks passed\n", checks);
        return 0;
    }
    io.printf("treeview: %d of %d checks failed\n", fails, checks);
    return 1;
}
