// ui/widgets/group.cst — a titled frame around related controls.
//
// A group box's first child is its title, a label in the theme's strong
// body style with its mnemonic; its second, whatever the program puts in it,
// is its content. The title goes on top, as wide as the box; below it, after
// the theme's small space, a frame — a rounded border in the theme's border
// colour, its corners the controls' — and the content inside it, the theme's
// medium space in from the border. Its title names it to assistive
// technology, and the title's mnemonic gives the focus to the first thing
// inside that can take it.
use "../../math/math.cst" as math;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../event.cst" as event;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "label.cst" as label;

struct Data {
    title as i64;
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("group", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.arrange = fn_ptr(_arrange);
    _kind.paint = fn_ptr(_paint);
    _kind.event = fn_ptr(_event);
    _kind.role = access.ROLE_GROUP;
    _ready = 1;
}

// A new group box titled text — an underscore marking its mnemonic's letter
// — as the last child of parent; its content is the next child made in it.
// Its handle, or 0 with the tree's last_error set.
fn create(t as *tree.Tree, parent as i64, s as *u8, n as i64) as i64 {
    _init();
    let is i64 as g = tree.create(t, &_kind, parent);
    if (g == 0) { return 0; }
    let is i64 as l = label.create(t, g, "", 0);
    if (l == 0) {
        tree.destroy(t, g);
        return 0;
    }
    label.set_text_mnemonic(t, l, s, n);
    label.set_style(t, l, label.BODY_STRONG);
    label.set_target(t, l, g);
    cast(*Data, tree.data(t, g)).title = l;
    return g;
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

// Its title; 0 for a widget that is no group box.
fn title(t as *tree.Tree, g as i64) as i64 {
    let is *Data as d = _data(t, g);
    if (cast(i64, d) == 0) { return 0; }
    return d.title;
}

// What it holds, its child after the title; 0 for none, or for a widget that
// is no group box.
fn content(t as *tree.Tree, g as i64) as i64 {
    let is *Data as d = _data(t, g);
    if (cast(i64, d) == 0) { return 0; }
    let is i64 as ch with mut = tree.first_child(t, g);
    while (ch != 0) {
        if (ch != d.title) { return ch; }
        ch = tree.next_sibling(t, ch);
    }
    return 0;
}

// Alt and its title's mnemonic letter, from now on, focus the first thing in
// it that can take the focus. 1, or 0 for no mnemonic or a full table.
fn bind_mnemonic(t as *tree.Tree, r as *router.Router, g as i64) as i32 {
    let is *Data as d = _data(t, g);
    if (cast(i64, d) == 0) { return 0; }
    return label.bind_mnemonic(t, r, d.title);
}

// How far in from its frame's edge its content is, and how far below its
// title the frame starts.
fn _inset(th as *style.Theme) as f64 { return th.metrics.space_m + th.metrics.border_width; }

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as inset = _inset(&th);
    let is f64 as gap = th.metrics.space_s;
    let is geom.Size as ts;
    layout.measure(t, d.title, c, &ts);
    let is geom.Size as cs;
    geom.size_zero(&cs);
    let is i64 as ch = content(t, w);
    if (ch != 0) {
        let is geom.Constraint as cc with mut = *c;
        if (cc.w < layout.UNBOUNDED) { cc.w = _max(0.0, cc.w - 2.0 * inset); }
        layout.measure(t, ch, &cc, &cs);
    }
    out.min_w = _max(ts.min_w, cs.min_w + 2.0 * inset);
    out.pref_w = _max(ts.pref_w, cs.pref_w + 2.0 * inset);
    out.min_h = ts.min_h + gap + cs.min_h + 2.0 * inset;
    out.pref_h = ts.pref_h + gap + cs.pref_h + 2.0 * inset;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// The title's height at width w.
fn _title_h(t as *tree.Tree, d as *Data, w as f64) as f64 {
    let is geom.Constraint as c = geom.constraint(w, layout.UNBOUNDED);
    let is geom.Size as ts;
    layout.measure(t, d.title, &c, &ts);
    return ts.pref_h;
}

fn _arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Data as d = cast(*Data, data);
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as inset = _inset(&th);
    let is f64 as th_h = _title_h(t, d, r.w);
    let is math.rect.Rect as ta = math.rect.rect(0.0, 0.0, r.w, th_h);
    layout.place(t, d.title, &ta);
    let is i64 as ch = content(t, w);
    if (ch == 0) { return; }
    let is f64 as top = th_h + th.metrics.space_s;
    let is math.rect.Rect as ca = math.rect.rect(inset, top + inset, _max(0.0, r.w - 2.0 * inset),
                                                _max(0.0, r.h - top - 2.0 * inset));
    layout.place(t, ch, &ca);
}

// Its frame in rc, its rectangle, below a title th_h tall.
fn _frame_in(rc as math.rect.Rect, th_h as f64, th as *style.Theme) as math.rect.Rect {
    let is f64 as top = th_h + th.metrics.space_s;
    return math.rect.rect(rc.x, rc.y + top, rc.w, _max(0.0, rc.h - top));
}

// Its frame, in the window; nothing for a widget that is no group box.
fn frame(t as *tree.Tree, g as i64) as math.rect.Rect {
    let is *Data as d = _data(t, g);
    if (cast(i64, d) == 0) { return math.rect.rect_zero(); }
    let is style.Theme as th;
    widget.theme(t, g, &th);
    return _frame_in(layout.window_rect(t, g), layout.rect(t, d.title).h, &th);
}

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Data as d = cast(*Data, data);
    let is *style.Theme as th = p.theme;
    let is math.rect.Rect as fr = _frame_in(p.rect, layout.rect(t, d.title).h, th);
    let is f64 as bw = th.metrics.border_width;
    if (bw <= 0.0) { return; }
    let is math.color.Color as col with mut = th.palette.border;
    if (painter.has(p, painter.S_DISABLED) == 1) { col = style.with_alpha(col, col.a * th.control.disabled_alpha); }
    let is f64 as rad = th.metrics.radius_m;
    shapes.stroke_rounded(p.canvas, fr.x, fr.y, fr.w, fr.h, rad, rad, rad, rad, bw, col);
}

// The first widget under w, in the order Tab goes, that can take the focus.
fn _first_focusable(t as *tree.Tree, w as i64) as i64 {
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        if (tree.is_focusable(t, ch) == 1 && tree.is_visible(t, ch) == 1 && tree.is_enabled(t, ch) == 1) { return ch; }
        let is i64 as below = _first_focusable(t, ch);
        if (below != 0) { return below; }
        ch = tree.next_sibling(t, ch);
    }
    return 0;
}

fn _event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.kind != event.ACTIVATE) { return 0; }
    let is i64 as f = _first_focusable(t, w);
    if (f != 0) { tree.request_focus(t, f); }
    return 1;
}
