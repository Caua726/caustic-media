// ui/widgets/colorpicker_test.cst — a colour chosen: from a palette, on a
// plane of saturation and value beside a strip of hue, on a strip of alpha,
// or typed as a hex code; in a dialog, and behind a colour button. Laid out,
// drawn, and told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../input/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "label.cst" as label;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "../app.cst" as app;
use "dialog.cst" as dialog;
use "entry.cst" as entry;
use "button.cst" as button;
use "colorpicker.cst" as colorpicker;

let is i64 as W with imut = 300;
let is i64 as H with imut = 400;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [120000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn rgb_near(x as i64, y as i64, r as i64, g as i64, b as i64, tol as i64) as i32 {
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

fn rgb_is(x as i64, y as i64, r as i64, g as i64, b as i64, tol as i64) as i32 {
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    if (dr > tol || dg > tol || db > tol) {
        io.printf("  at %d,%d: %d %d %d, not %d %d %d\n", x, y, ch(x, y, 0), ch(x, y, 1), ch(x, y, 2), r, g, b);
        return 0;
    }
    return 1;
}

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.001 && d > 0.0 - 0.001);
}

fn near_rect(r as math.rect.Rect, x as f64, y as f64, w as f64, h as f64) as i32 {
    if (near(r.x, x) == 1 && near(r.y, y) == 1 && near(r.w, w) == 1 && near(r.h, h) == 1) { return 1; }
    io.printf("  rect %f,%f %fx%f, not %f,%f %fx%f\n", r.x, r.y, r.w, r.h, x, y, w, h);
    return 0;
}

fn mx(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).x + layout.window_rect(t, w).w / 2.0; }
fn my(t as *tree.Tree, w as i64) as f64 { return layout.window_rect(t, w).y + layout.window_rect(t, w).h / 2.0; }

let is i64 as changes with mut = 0;
let is math.color.Color as said with mut;
fn on_change(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    changes = changes + 1;
    said = *cast(*math.color.Color, arg);
}

// The hex code the colour is, "#rrggbb" or "#rrggbbaa".
fn hex_is(t as *tree.Tree, w as i64, s as *u8) as i32 {
    let is [12]u8 as b;
    let is i64 as n = colorpicker.hex(t, w, cast(*u8, &b));
    if (same(cast(*u8, &b), n, s) == 1) { return 1; }
    b[n] = cast(u8, 0);
    io.printf("  hex %s, not %s\n", cast(*u8, &b), s);
    return 0;
}

fn entry_is(t as *tree.Tree, w as i64, s as *u8) as i32 {
    let is i64 as e = colorpicker.entry_of(t, w);
    return same(entry.text(t, e), entry.length(t, e), s);
}

// Every key a plane or a strip moves by, taken.
fn took_all(t as *tree.Tree, r as *router.Router) as i32 {
    let is [8]i32 as ks;
    ks[0] = keys.RIGHT;
    ks[1] = keys.LEFT;
    ks[2] = keys.UP;
    ks[3] = keys.DOWN;
    ks[4] = keys.PAGE_UP;
    ks[5] = keys.PAGE_DOWN;
    ks[6] = keys.HOME;
    ks[7] = keys.END;
    let is i32 as all with mut = 1;
    let is i64 as i with mut = 0;
    while (i < 8) {
        if (router.key(t, r, ks[i], 0, 1, 0, 5000 + i * 10) != 1) { all = 0; }
        router.key(t, r, ks[i], 0, 0, 0, 5001 + i * 10);
        i = i + 1;
    }
    return all;
}

fn hsv_is(t as *tree.Tree, w as i64, h as f64, s as f64, v as f64) as i32 {
    let is f64 as hh with mut = 0.0;
    let is f64 as ss with mut = 0.0;
    let is f64 as vv with mut = 0.0;
    colorpicker.hsv(t, w, &hh, &ss, &vv);
    let is f64 as dh with mut = hh - h;
    if (dh < 0.0) { dh = 0.0 - dh; }
    let is f64 as ds with mut = ss - s;
    if (ds < 0.0) { ds = 0.0 - ds; }
    let is f64 as dvv with mut = vv - v;
    if (dvv < 0.0) { dvv = 0.0 - dvv; }
    if (dh < 0.01 && ds < 0.0001 && dvv < 0.0001) { return 1; }
    io.printf("  hsv %f %f %f, not %f %f %f\n", hh, ss, vv, h, s, v);
    return 0;
}

// --- The chooser: its parts, laid out ---

let is f64 as BLUE_HUE with imut = 212.91428571428573;

fn laid() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as w = colorpicker.create(&t, tree.root(&t));
    layout.run(&t, cast(f64, W), cast(f64, H));
    // 45 swatches, 24 square, 4 apart: hues down the columns.
    let is i64 as s0 = colorpicker.swatch(&t, w, 0);
    let is i64 as s7 = colorpicker.swatch(&t, w, 7);
    let is i64 as s44 = colorpicker.swatch(&t, w, 44);
    check("the palette: a column a hue, its shades down", colorpicker.swatch_count() == 45 &&
          near_rect(layout.window_rect(&t, s0), 0.0, 0.0, 24.0, 24.0) == 1 &&
          near_rect(layout.window_rect(&t, s7), 28.0, 56.0, 24.0, 24.0) == 1 &&
          near_rect(layout.window_rect(&t, s44), 224.0, 112.0, 24.0, 24.0) == 1 && colorpicker.swatch(&t, w, 45) == 0 &&
          colorpicker.swatch(&t, w, 0 - 1) == 0);
    // Below it the plane, the hue beside it; the preview and the entry at the foot.
    check("the plane", near_rect(layout.window_rect(&t, colorpicker.plane_of(&t, w)), 0.0, 144.0, 280.0, 218.0) == 1);
    check("the hue beside it", near_rect(layout.window_rect(&t, colorpicker.hue_of(&t, w)), 284.0, 144.0, 16.0, 218.0) == 1);
    check("no alpha at first", tree.is_hidden_here(&t, colorpicker.alpha_of(&t, w)) == 1);
    check("the entry at the foot, after the preview", near_rect(layout.window_rect(&t, colorpicker.entry_of(&t, w)), 38.0, 366.0, 262.0, 34.0) == 1 &&
          near_rect(colorpicker.preview(&t, w), 0.0, 366.0, 34.0, 34.0) == 1);
    colorpicker.set_alpha_shown(&t, w, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("alpha shown: under the plane", near_rect(layout.window_rect(&t, colorpicker.alpha_of(&t, w)), 0.0, 346.0, 280.0, 16.0) == 1 &&
          near_rect(layout.window_rect(&t, colorpicker.plane_of(&t, w)), 0.0, 144.0, 280.0, 198.0) == 1 &&
          near_rect(layout.window_rect(&t, colorpicker.hue_of(&t, w)), 284.0, 144.0, 16.0, 198.0) == 1);
    colorpicker.set_palette_shown(&t, w, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is geom.Constraint as free0 = geom.unbounded();
    let is geom.Size as s0z;
    layout.measure(&t, w, &free0, &s0z);
    check("no palette: the plane at the top", tree.is_hidden_here(&t, s0) == 1 && tree.is_hidden_here(&t, s44) == 1 &&
          near(s0z.pref_w, 160.0 + 4.0 + 16.0) == 1 &&
          near_rect(layout.window_rect(&t, colorpicker.plane_of(&t, w)), 0.0, 0.0, 280.0, 342.0) == 1);
    colorpicker.set_palette_shown(&t, w, 1);
    // Right to left: mirrored.
    layout.set_direction(&t, w, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("right to left: mirrored", near_rect(layout.window_rect(&t, s0), 276.0, 0.0, 24.0, 24.0) == 1 &&
          near_rect(layout.window_rect(&t, colorpicker.plane_of(&t, w)), 20.0, 144.0, 280.0, 198.0) == 1 &&
          near_rect(layout.window_rect(&t, colorpicker.hue_of(&t, w)), 0.0, 144.0, 16.0, 198.0) == 1 &&
          near_rect(layout.window_rect(&t, colorpicker.entry_of(&t, w)), 0.0, 366.0, 262.0, 34.0) == 1 &&
          near_rect(colorpicker.preview(&t, w), 266.0, 366.0, 34.0, 34.0) == 1);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(&t, w, &free, &s);
    check("its size", near(s.pref_w, 248.0) == 1 && near(s.pref_h, 136.0 + 8.0 + 160.0 + 20.0 + 4.0 + 34.0) == 1 &&
          near(s.min_w, 64.0 + 4.0 + 16.0) == 1 && near(s.min_h, 136.0 + 8.0 + 64.0 + 20.0 + 4.0 + 34.0) == 1);
    tree.close(&t);
}

// --- Set, read, and the plane, the strips and the keys ---

fn edited() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as w = colorpicker.create(&t, tree.root(&t));
    signal.connect(&t, w, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("white at first", hex_is(&t, w, "#ffffff") == 1 && entry_is(&t, w, "#ffffff") == 1);
    changes = 0;
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    check("set: its hue, saturation and value; its code", hsv_is(&t, w, BLUE_HUE, 175.0 / 228.0, 228.0 / 255.0) == 1 &&
          hex_is(&t, w, "#3584e4") == 1 && entry_is(&t, w, "#3584e4") == 1);
    check("said", changes == 1 && math.color.col_approx(said, math.color.hex(0x3584E4), 0.0001) == 1 &&
          math.color.col_approx(colorpicker.color(&t, w), math.color.hex(0x3584E4), 0.0001) == 1);
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    check("the same again: not said", changes == 1);
    check("not alpha while it is not shown", colorpicker.set_color(&t, w, math.color.rgba(1.0, 0.0, 0.0, 0.5)) == 1 &&
          near(colorpicker.color(&t, w).a, 1.0) == 1 && hex_is(&t, w, "#ff0000") == 1);
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    // Hues where red, then green, leads with the third channel above zero.
    colorpicker.set_color(&t, w, math.color.hex(0xFF0080));
    let is f64 as hh with mut = 0.0;
    let is f64 as ss with mut = 0.0;
    let is f64 as vv with mut = 0.0;
    colorpicker.hsv(&t, w, &hh, &ss, &vv);
    let is i32 as magenta = cast(i32, hh > 329.8 && hh < 330.0);
    colorpicker.set_color(&t, w, math.color.hex(0x80FF00));
    colorpicker.hsv(&t, w, &hh, &ss, &vv);
    let is i32 as lime = cast(i32, hh > 89.8 && hh < 90.0);
    colorpicker.set_color(&t, w, math.color.hex(0x00FF80));
    colorpicker.hsv(&t, w, &hh, &ss, &vv);
    check("hues of every side of the wheel", magenta == 1 && lime == 1 && hh > 150.0 && hh < 150.2);
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    // A grey: its hue kept.
    colorpicker.set_color(&t, w, math.color.hex(0x808080));
    check("a grey keeps the hue", hsv_is(&t, w, BLUE_HUE, 0.0, 128.0 / 255.0) == 1);
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    // The plane: saturation across, value up.
    let is i64 as pl = colorpicker.plane_of(&t, w);
    changes = 0;
    click(&t, &r, 140.0, 144.0 + 0.25 * 218.0, 10);
    check("the plane clicked: saturation and value there, the hue kept", hsv_is(&t, w, BLUE_HUE, 0.5, 0.75) == 1 &&
          hex_is(&t, w, "#608bbf") == 1 && entry_is(&t, w, "#608bbf") == 1 && changes == 1 && router.focused(&t, &r) == pl);
    router.pointer_move(&t, &r, 70.0, 144.0 + 0.5 * 218.0, 20);
    check("not dragged without a press", hsv_is(&t, w, BLUE_HUE, 0.5, 0.75) == 1);
    router.pointer_button(&t, &r, 1, 1, 140.0, 144.0 + 0.25 * 218.0, 30);
    router.pointer_move(&t, &r, 70.0, 144.0 + 0.5 * 218.0, 40);
    check("dragged: followed", hsv_is(&t, w, BLUE_HUE, 0.25, 0.5) == 1);
    router.pointer_move(&t, &r, 0.0 - 50.0, 500.0, 50);
    check("dragged out: held to its edges", hsv_is(&t, w, BLUE_HUE, 0.0, 0.0) == 1);
    router.pointer_move(&t, &r, 400.0, 0.0, 60);
    check("and the other edges", hsv_is(&t, w, BLUE_HUE, 1.0, 1.0) == 1);
    router.pointer_button(&t, &r, 1, 0, 400.0, 0.0, 70);
    router.pointer_move(&t, &r, 140.0, 200.0, 80);
    check("let go: no longer followed", hsv_is(&t, w, BLUE_HUE, 1.0, 1.0) == 1);
    router.pointer_button(&t, &r, 3, 1, 140.0, 200.0, 90);
    router.pointer_button(&t, &r, 3, 0, 140.0, 200.0, 91);
    check("another button: nothing", hsv_is(&t, w, BLUE_HUE, 1.0, 1.0) == 1);
    // Its keys.
    colorpicker.set_hsv(&t, w, BLUE_HUE, 0.5, 0.5);
    router.focus(&t, &r, pl, 1);
    key(&t, &r, keys.RIGHT, 0, 100);
    key(&t, &r, keys.UP, 0, 110);
    check("right and up: a hundredth more", hsv_is(&t, w, BLUE_HUE, 0.51, 0.51) == 1);
    key(&t, &r, keys.LEFT, 0, 120);
    key(&t, &r, keys.LEFT, 0, 130);
    key(&t, &r, keys.DOWN, 0, 140);
    check("left and down: less", hsv_is(&t, w, BLUE_HUE, 0.49, 0.5) == 1);
    key(&t, &r, keys.PAGE_UP, 0, 150);
    check("page up: a tenth more value", hsv_is(&t, w, BLUE_HUE, 0.49, 0.6) == 1);
    key(&t, &r, keys.PAGE_DOWN, 0, 160);
    key(&t, &r, keys.PAGE_DOWN, 0, 170);
    check("page down: less", hsv_is(&t, w, BLUE_HUE, 0.49, 0.4) == 1);
    key(&t, &r, keys.HOME, 0, 180);
    check("home: no saturation", hsv_is(&t, w, BLUE_HUE, 0.0, 0.4) == 1);
    key(&t, &r, keys.LEFT, 0, 190);
    check("held there", hsv_is(&t, w, BLUE_HUE, 0.0, 0.4) == 1);
    key(&t, &r, keys.END, 0, 200);
    check("end: all of it", hsv_is(&t, w, BLUE_HUE, 1.0, 0.4) == 1);
    check("keys it has no use for: on up", router.key(&t, &r, keys.A, 0, 1, 0, 210) == 0 &&
          router.key(&t, &r, keys.RIGHT, keys.MOD_CONTROL, 1, 0, 220) == 0);
    check("its keys taken", took_all(&t, &r) == 1);
    // The hue: up and down, the least at the bottom.
    let is i64 as hu = colorpicker.hue_of(&t, w);
    colorpicker.set_hsv(&t, w, 100.0, 1.0, 1.0);
    click(&t, &r, 292.0, 144.0 + 109.0, 300);
    check("the hue's middle: 180", hsv_is(&t, w, 180.0, 1.0, 1.0) == 1 && hex_is(&t, w, "#00ffff") == 1 && router.focused(&t, &r) == hu);
    router.pointer_move(&t, &r, 292.0, 300.0, 310);
    router.pointer_button(&t, &r, 1, 1, 292.0, 300.0, 311);
    router.pointer_move(&t, &r, 292.0, 500.0, 312);
    router.pointer_button(&t, &r, 1, 0, 292.0, 500.0, 313);
    check("dragged past its bottom: 0", hsv_is(&t, w, 0.0, 1.0, 1.0) == 1);
    click(&t, &r, 292.0, 144.0, 320);
    check("its top: 360", hsv_is(&t, w, 360.0, 1.0, 1.0) == 1 && hex_is(&t, w, "#ff0000") == 1);
    router.pointer_button(&t, &r, 1, 1, 292.0, 144.0 + 109.0, 330);
    router.pointer_move(&t, &r, 0.0, 144.0 + 218.0 * 0.75, 340);
    router.pointer_button(&t, &r, 1, 0, 0.0, 144.0 + 218.0 * 0.75, 350);
    check("dragged along it, wherever across", hsv_is(&t, w, 90.0, 1.0, 1.0) == 1);
    router.pointer_move(&t, &r, 292.0, 144.0 + 109.0, 355);
    check("let go: no longer followed", hsv_is(&t, w, 90.0, 1.0, 1.0) == 1);
    key(&t, &r, keys.UP, 0, 360);
    key(&t, &r, keys.RIGHT, 0, 370);
    check("up and right: a degree more", hsv_is(&t, w, 92.0, 1.0, 1.0) == 1);
    key(&t, &r, keys.DOWN, 0, 380);
    key(&t, &r, keys.PAGE_DOWN, 0, 390);
    check("down, page down: less", hsv_is(&t, w, 81.0, 1.0, 1.0) == 1);
    key(&t, &r, keys.PAGE_UP, 0, 400);
    key(&t, &r, keys.LEFT, 0, 410);
    check("page up: ten more; left: one less", hsv_is(&t, w, 90.0, 1.0, 1.0) == 1);
    key(&t, &r, keys.HOME, 0, 420);
    check("home", hsv_is(&t, w, 0.0, 1.0, 1.0) == 1);
    key(&t, &r, keys.DOWN, 0, 430);
    check("held there", hsv_is(&t, w, 0.0, 1.0, 1.0) == 1);
    key(&t, &r, keys.END, 0, 440);
    check("end", hsv_is(&t, w, 360.0, 1.0, 1.0) == 1);
    check("its keys taken, the rest on up", took_all(&t, &r) == 1 && router.key(&t, &r, keys.A, 0, 1, 0, 450) == 0 &&
          router.key(&t, &r, keys.UP, keys.MOD_ALT, 1, 0, 460) == 0);
    // Alpha: across, mirrored right to left.
    colorpicker.set_alpha_shown(&t, w, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as al = colorpicker.alpha_of(&t, w);
    colorpicker.set_hsv(&t, w, BLUE_HUE, 1.0, 1.0);
    click(&t, &r, 70.0, 354.0, 500);
    check("alpha clicked: a quarter, its code with it", near(colorpicker.color(&t, w).a, 0.25) == 1 && hex_is(&t, w, "#0073ff40") == 1 &&
          entry_is(&t, w, "#0073ff40") == 1 && router.focused(&t, &r) == al);
    key(&t, &r, keys.RIGHT, 0, 510);
    key(&t, &r, keys.UP, 0, 520);
    check("right and up: a hundredth more", near(colorpicker.color(&t, w).a, 0.27) == 1);
    key(&t, &r, keys.PAGE_DOWN, 0, 530);
    key(&t, &r, keys.LEFT, 0, 540);
    check("page down, left: less", near(colorpicker.color(&t, w).a, 0.16) == 1);
    key(&t, &r, keys.END, 0, 550);
    check("end: opaque, its code without alpha", near(colorpicker.color(&t, w).a, 1.0) == 1 && hex_is(&t, w, "#0073ff") == 1);
    key(&t, &r, keys.HOME, 0, 560);
    check("home: clear", near(colorpicker.color(&t, w).a, 0.0) == 1 && hex_is(&t, w, "#0073ff00") == 1);
    layout.set_direction(&t, w, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ar = layout.window_rect(&t, al);
    click(&t, &r, ar.x + ar.w * 0.25, ar.y + 8.0, 570);
    check("right to left: from the right", near(colorpicker.color(&t, w).a, 0.75) == 1);
    key(&t, &r, keys.RIGHT, 0, 580);
    check("right: less", near(colorpicker.color(&t, w).a, 0.74) == 1);
    layout.set_direction(&t, w, layout.LTR);
    colorpicker.set_alpha_shown(&t, w, 0);
    check("alpha hidden: opaque again", near(colorpicker.color(&t, w).a, 1.0) == 1);
    tree.close(&t);
}

// --- The hex code typed ---

fn typed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as w = colorpicker.create(&t, tree.root(&t));
    signal.connect(&t, w, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as e = colorpicker.entry_of(&t, w);
    router.focus(&t, &r, e, 1);
    changes = 0;
    entry.set_text(&t, e, "#ff0000", 7);
    check("a whole code typed: taken at once, the text left", hex_is(&t, w, "#ff0000") == 1 && hsv_is(&t, w, 0.0, 1.0, 1.0) == 1 &&
          changes == 1 && entry_is(&t, w, "#ff0000") == 1);
    entry.set_text(&t, e, "12", 2);
    check("half of one: nothing yet", hex_is(&t, w, "#ff0000") == 1 && changes == 1 && entry_is(&t, w, "12") == 1);
    key(&t, &r, keys.RETURN, 0, 10);
    check("enter on nonsense: put back", entry_is(&t, w, "#ff0000") == 1 && changes == 1);
    entry.set_text(&t, e, "#0f0", 4);
    check("three digits: not at once", hex_is(&t, w, "#ff0000") == 1);
    key(&t, &r, keys.RETURN, 0, 20);
    check("but on enter, written whole", hex_is(&t, w, "#00ff00") == 1 && entry_is(&t, w, "#00ff00") == 1 && changes == 2);
    entry.set_text(&t, e, "AbC", 3);
    key(&t, &r, keys.RETURN, 0, 30);
    check("no '#', either case", hex_is(&t, w, "#aabbcc") == 1 && entry_is(&t, w, "#aabbcc") == 1);
    entry.set_text(&t, e, "123456", 6);
    check("six digits without '#': at once", hex_is(&t, w, "#123456") == 1);
    entry.set_text(&t, e, "#12345g", 7);
    key(&t, &r, keys.RETURN, 0, 40);
    check("not a digit: put back", hex_is(&t, w, "#123456") == 1 && entry_is(&t, w, "#123456") == 1);
    entry.set_text(&t, e, "#09afAF", 7);
    check("every kind of digit", hex_is(&t, w, "#09afaf") == 1);
    entry.set_text(&t, e, "#11223344", 9);
    check("eight digits, alpha hidden: opaque", hex_is(&t, w, "#112233") == 1 && near(colorpicker.color(&t, w).a, 1.0) == 1);
    key(&t, &r, keys.RETURN, 0, 50);
    check("written without it", entry_is(&t, w, "#112233") == 1);
    colorpicker.set_alpha_shown(&t, w, 1);
    entry.set_text(&t, e, "#11223344", 9);
    check("alpha shown: taken", hex_is(&t, w, "#11223344") == 1 && near(colorpicker.color(&t, w).a, 68.0 / 255.0) == 1);
    entry.set_text(&t, e, "#abcd", 5);
    key(&t, &r, keys.RETURN, 0, 60);
    check("four digits", hex_is(&t, w, "#aabbccdd") == 1 && entry_is(&t, w, "#aabbccdd") == 1);

    entry.set_text(&t, e, "#1234567", 8);
    key(&t, &r, keys.RETURN, 0, 70);
    check("seven: put back", hex_is(&t, w, "#aabbccdd") == 1 && entry_is(&t, w, "#aabbccdd") == 1);
    entry.set_text(&t, e, "", 0);
    key(&t, &r, keys.RETURN, 0, 80);
    check("nothing: put back", entry_is(&t, w, "#aabbccdd") == 1);
    entry.set_text(&t, e, "#0f0", 4);
    key(&t, &r, keys.RETURN, 0, 82);
    check("three digits, alpha shown: opaque", hex_is(&t, w, "#00ff00") == 1);
    entry.set_text(&t, e, "#abcdef", 7);
    check("six, alpha shown: opaque", hex_is(&t, w, "#abcdef") == 1);
    colorpicker.set_color(&t, w, math.color.rgba(0x35 / 255.0, 0x84 / 255.0, 0xE4 / 255.0, 0.5));
    check("a palette's colour, see-through: no swatch", colorpicker.selected(&t, w) == 0 - 1);
    tree.close(&t);
}

// --- The palette ---

let is i64 as BLUE with imut = 2;   // #3584e4: the blue column's middle

fn paletted() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as w = colorpicker.create(&t, tree.root(&t));
    signal.connect(&t, w, signal.VALUE_CHANGED, fn_ptr(on_change), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the palette's colours", math.color.col_approx(colorpicker.swatch_color(BLUE), math.color.hex(0x3584E4), 0.0001) == 1 &&
          math.color.col_approx(colorpicker.swatch_color(0), math.color.hex(0x99C1F1), 0.0001) == 1 &&
          math.color.col_approx(colorpicker.swatch_color(44), math.color.hex(0x000000), 0.0001) == 1 &&
          math.color.col_approx(colorpicker.swatch_color(35), math.color.hex(0xFFFFFF), 0.0001) == 1);
    check("white at first: its swatch chosen", colorpicker.selected(&t, w) == 35);
    changes = 0;
    click(&t, &r, mx(&t, colorpicker.swatch(&t, w, BLUE)), my(&t, colorpicker.swatch(&t, w, BLUE)), 10);
    check("a swatch clicked: its colour", hex_is(&t, w, "#3584e4") == 1 && colorpicker.selected(&t, w) == BLUE && changes == 1 &&
          router.focused(&t, &r) == colorpicker.swatch(&t, w, BLUE));
    check("one stop for Tab: the chosen", tree.is_focusable(&t, colorpicker.swatch(&t, w, BLUE)) == 1 &&
          tree.is_focusable(&t, colorpicker.swatch(&t, w, 0)) == 0);
    colorpicker.set_color(&t, w, math.color.hex(0x123456));
    check("a colour no swatch has: none chosen, the Tab stop left", colorpicker.selected(&t, w) == 0 - 1 &&
          tree.is_focusable(&t, colorpicker.swatch(&t, w, BLUE)) == 1 && tree.is_focusable(&t, colorpicker.swatch(&t, w, 0)) == 0);
    colorpicker.set_color(&t, w, math.color.hex(0x99C1F1));
    check("the first's colour: the Tab stop to it", colorpicker.selected(&t, w) == 0 &&
          tree.is_focusable(&t, colorpicker.swatch(&t, w, 0)) == 1 && tree.is_focusable(&t, colorpicker.swatch(&t, w, BLUE)) == 0);
    colorpicker.set_color(&t, w, math.color.hex(0x000000));
    check("one it has: that one", colorpicker.selected(&t, w) == 44);
    // The keys: right a column on, down a shade.
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    router.focus(&t, &r, colorpicker.swatch(&t, w, BLUE), 1);
    key(&t, &r, keys.RIGHT, 0, 100);
    let is i64 as at = colorpicker.swatch(&t, w, BLUE + 5);
    check("right: the next column", router.focused(&t, &r) == at && tree.is_focusable(&t, at) == 1 &&
          tree.is_focusable(&t, colorpicker.swatch(&t, w, BLUE)) == 0 && hex_is(&t, w, "#3584e4") == 1);
    key(&t, &r, keys.DOWN, 0, 110);
    check("down: a darker shade", router.focused(&t, &r) == colorpicker.swatch(&t, w, BLUE + 6));
    key(&t, &r, keys.UP, 0, 120);
    key(&t, &r, keys.UP, 0, 130);
    key(&t, &r, keys.LEFT, 0, 140);
    check("up and left", router.focused(&t, &r) == colorpicker.swatch(&t, w, BLUE - 1));
    key(&t, &r, keys.UP, 0, 150);
    key(&t, &r, keys.UP, 0, 160);
    key(&t, &r, keys.LEFT, 0, 170);
    check("held at the edges", router.focused(&t, &r) == colorpicker.swatch(&t, w, 0));
    key(&t, &r, keys.END, 0, 180);
    check("end: the last", router.focused(&t, &r) == colorpicker.swatch(&t, w, 44));
    key(&t, &r, keys.DOWN, 0, 190);
    key(&t, &r, keys.RIGHT, 0, 200);
    check("held there too", router.focused(&t, &r) == colorpicker.swatch(&t, w, 44));
    key(&t, &r, keys.HOME, 0, 210);
    check("home: the first", router.focused(&t, &r) == colorpicker.swatch(&t, w, 0));
    router.focus(&t, &r, colorpicker.swatch(&t, w, 0), 1);
    key(&t, &r, keys.DOWN, 0, 212);
    key(&t, &r, keys.DOWN, 0, 213);
    key(&t, &r, keys.DOWN, 0, 214);
    check("down to the fourth shade", router.focused(&t, &r) == colorpicker.swatch(&t, w, 3));
    key(&t, &r, keys.DOWN, 0, 215);
    check("and the fifth", router.focused(&t, &r) == colorpicker.swatch(&t, w, 4));
    check("its keys taken", router.key(&t, &r, keys.UP, 0, 1, 0, 216) == 1 && router.key(&t, &r, keys.HOME, 0, 1, 0, 218) == 1);
    changes = 0;
    key(&t, &r, keys.RETURN, 0, 220);
    check("enter: chosen", hex_is(&t, w, "#99c1f1") == 1 && colorpicker.selected(&t, w) == 0 && changes == 1);
    key(&t, &r, keys.DOWN, 0, 230);
    key(&t, &r, keys.SPACE, 0, 240);
    check("space: chosen", hex_is(&t, w, "#62a0ea") == 1 && colorpicker.selected(&t, w) == 1);
    check("keys it has no use for: on up", router.key(&t, &r, keys.A, 0, 1, 0, 250) == 0 &&
          router.key(&t, &r, keys.RIGHT, keys.MOD_CONTROL, 1, 0, 260) == 0);
    layout.set_direction(&t, w, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    key(&t, &r, keys.LEFT, 0, 270);
    check("right to left: left a column on", router.focused(&t, &r) == colorpicker.swatch(&t, w, 6));
    key(&t, &r, keys.RIGHT, 0, 280);
    check("and right back", router.focused(&t, &r) == colorpicker.swatch(&t, w, 1));
    key(&t, &r, keys.RIGHT, 0, 282);
    check("held at the first column", router.focused(&t, &r) == colorpicker.swatch(&t, w, 1));
    key(&t, &r, keys.END, 0, 284);
    key(&t, &r, keys.LEFT, 0, 286);
    check("and at the last", router.focused(&t, &r) == colorpicker.swatch(&t, w, 44));
    layout.set_direction(&t, w, layout.LTR);
    layout.run(&t, cast(f64, W), cast(f64, H));
    // Pressed at its very edge: chosen; let go past it: not.
    let is math.rect.Rect as er = layout.window_rect(&t, colorpicker.swatch(&t, w, 10));
    click(&t, &r, er.x, er.y + 12.0, 300);
    check("pressed at its edge: chosen", colorpicker.selected(&t, w) == 10);
    let is math.rect.Rect as fr = layout.window_rect(&t, colorpicker.swatch(&t, w, 11));
    router.pointer_move(&t, &r, fr.x + 12.0, fr.y + 12.0, 310);
    router.pointer_button(&t, &r, 1, 1, fr.x + 12.0, fr.y + 12.0, 310);
    router.pointer_button(&t, &r, 1, 0, fr.x + fr.w, fr.y + 12.0, 311);
    check("let go just past it: not", colorpicker.selected(&t, w) == 10);
    let is math.rect.Rect as tr = layout.window_rect(&t, colorpicker.swatch(&t, w, 12));
    click(&t, &r, tr.x + 12.0, tr.y, 320);
    check("pressed at its top edge: chosen", colorpicker.selected(&t, w) == 12);
    router.pointer_move(&t, &r, fr.x + 12.0, fr.y + 12.0, 330);
    router.pointer_button(&t, &r, 1, 1, fr.x + 12.0, fr.y + 12.0, 330);
    router.pointer_button(&t, &r, 1, 0, fr.x + 12.0, fr.y + fr.h, 331);
    check("let go just below it: not", colorpicker.selected(&t, w) == 12);
    let is i64 as kids with mut = 0;
    let is i64 as ch with mut = tree.first_child(&t, w);
    while (ch != 0) {
        kids = kids + 1;
        ch = tree.next_sibling(&t, ch);
    }
    check("forty-five swatches and its four other parts", kids == 49);
    tree.close(&t);
}

// --- Drawn ---

fn drawn() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as w = colorpicker.create(&t, tree.root(&t));
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    frame(&t, &c);
    // The plane: white at the top's start, the pure hue at its end, black at the foot.
    check("the plane: white at the top's start", rgb_is(1, 145, 255, 255, 255, 6) == 1);
    check("the pure hue at its end", rgb_is(278, 145, 0, 115, 255, 6) == 1);
    check("black at its foot", rgb_is(140, 361, 0, 0, 0, 6) == 1);
    check("between: half of each", rgb_is(140, 253, 64, 92, 127, 6) == 1);
    // The hue: red at the bottom, cyan halfway, red at the top.
    check("the hue strip: red at the bottom", rgb_is(292, 360, 255, 0, 0, 20) == 1);
    check("cyan halfway", rgb_is(292, 253, 0, 255, 255, 10) == 1);
    check("red at the top", rgb_is(292, 146, 255, 0, 0, 20) == 1);
    check("nothing above it", rgb_is(292, 141, 250, 250, 250, 12) == 1 || rgb_is(292, 141, 255, 255, 255, 12) == 1);
    // The preview, the colour.
    check("the preview", rgb_is(17, 383, 0x35, 0x84, 0xE4, 2) == 1);
    // The chosen swatch ringed: its middle its colour, near its edge not.
    let is math.rect.Rect as sr = layout.window_rect(&t, colorpicker.swatch(&t, w, BLUE));
    check("the chosen swatch: its colour", rgb_is(cast(i64, sr.x + 12.0), cast(i64, sr.y + 12.0), 0x35, 0x84, 0xE4, 2) == 1);
    check("ringed", rgb_near(cast(i64, sr.x + 4.0), cast(i64, sr.y + 12.0), 0x35, 0x84, 0xE4, 30) == 0);
    let is math.rect.Rect as or = layout.window_rect(&t, colorpicker.swatch(&t, w, BLUE + 1));
    check("another: not", rgb_is(cast(i64, or.x + 4.0), cast(i64, or.y + 12.0), 0x1C, 0x71, 0xD8, 2) == 1);
    colorpicker.set_color(&t, w, math.color.hex(0xFFFFFF));
    frame(&t, &c);
    let is math.rect.Rect as wr = layout.window_rect(&t, colorpicker.swatch(&t, w, 35));
    check("a light one ringed dark", ch(cast(i64, wr.x + 4.0), cast(i64, wr.y + 12.0), 0) < 60);
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    // Alpha: a checkerboard showing through at its start, the colour at its end.
    colorpicker.set_alpha_shown(&t, w, 1);
    colorpicker.set_color(&t, w, math.color.rgba(1.0, 0.0, 0.0, 0.5));
    frame(&t, &c);
    let is math.rect.Rect as ar = layout.window_rect(&t, colorpicker.alpha_of(&t, w));
    let is i64 as ay = cast(i64, ar.y + 4.0);
    check("alpha: the colour at its end", rgb_is(cast(i64, ar.x + ar.w - 2.0), ay, 255, 0, 0, 10) == 1);
    check("a checkerboard at its start", ch(1, ay, 1) == ch(1, ay, 2) && ch(1, ay, 1) > ch(9, ay, 1) + 20);
    check("the preview, half clear", ch(17, 383, 0) > 200 && ch(17, 383, 1) < 220 && ch(17, 383, 1) > 60 &&
          ch(17, 383, 1) == ch(17, 383, 2));
    draw2d.close(&c);
    tree.close(&t);
}

// --- Told ---

fn named(q as *tree.Access, s as *u8) as i32 { return same(q.name, q.name_len, s); }

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as w = colorpicker.create(&t, tree.root(&t));
    colorpicker.set_alpha_shown(&t, w, 1);
    colorpicker.set_hsv(&t, w, 200.0, 0.5, 0.75);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is tree.Access as q;
    access.describe(&t, &r, w, &q);
    check("a colour chooser", q.role == access.ROLE_COLOR_CHOOSER);
    access.describe(&t, &r, colorpicker.plane_of(&t, w), &q);
    check("the plane: a slider of saturation and value", q.role == access.ROLE_SLIDER && named(&q, "Saturation and value") == 1 &&
          same(q.description, q.description_len, "Saturation 50%, value 75%") == 1 && (q.actions & access.SET_VALUE) == 0);
    colorpicker.set_hsv(&t, w, 200.0, 1.0, 0.1);
    access.describe(&t, &r, colorpicker.plane_of(&t, w), &q);
    check("all of it, a tenth", same(q.description, q.description_len, "Saturation 100%, value 10%") == 1 &&
          access.act(&t, colorpicker.plane_of(&t, w), access.INCREMENT, 0.0) == 0);
    colorpicker.set_hsv(&t, w, 200.0, 0.5, 0.75);
    access.describe(&t, &r, colorpicker.hue_of(&t, w), &q);
    check("the hue: a slider of degrees", q.role == access.ROLE_SLIDER && named(&q, "Hue") == 1 && q.has_value == 1 &&
          near(q.value, 200.0) == 1 && near(q.max, 360.0) == 1 && near(q.step, 1.0) == 1 && (q.states & access.VERTICAL) != 0);
    check("acted on", access.act(&t, colorpicker.hue_of(&t, w), access.INCREMENT, 0.0) == 1);
    access.act(&t, colorpicker.hue_of(&t, w), access.SET_VALUE, 30.0);
    access.act(&t, colorpicker.hue_of(&t, w), access.DECREMENT, 0.0);
    check("and set by it", hsv_is(&t, w, 29.0, 0.5, 0.75) == 1);
    access.describe(&t, &r, colorpicker.alpha_of(&t, w), &q);
    check("alpha: a slider of percent", q.role == access.ROLE_SLIDER && named(&q, "Alpha") == 1 && near(q.value, 100.0) == 1 &&
          near(q.max, 100.0) == 1 && (q.states & access.HORIZONTAL) != 0);
    access.act(&t, colorpicker.alpha_of(&t, w), access.SET_VALUE, 40.0);
    access.act(&t, colorpicker.alpha_of(&t, w), access.DECREMENT, 0.0);
    access.act(&t, colorpicker.alpha_of(&t, w), access.DECREMENT, 0.0);
    access.act(&t, colorpicker.alpha_of(&t, w), access.INCREMENT, 0.0);
    check("and set by it", near(colorpicker.color(&t, w).a, 0.39) == 1);
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    access.describe(&t, &r, colorpicker.swatch(&t, w, BLUE), &q);
    check("a swatch: a radio button named by its colour, chosen", q.role == access.ROLE_RADIO_BUTTON && named(&q, "Blue") == 1 &&
          (q.states & access.CHECKED) != 0 && (q.states & access.CHECKABLE) != 0);
    access.describe(&t, &r, colorpicker.swatch(&t, w, 0), &q);
    check("its shades", named(&q, "Very Light Blue") == 1 && (q.states & access.CHECKED) == 0);
    access.describe(&t, &r, colorpicker.swatch(&t, w, 1), &q);
    check("light", named(&q, "Light Blue") == 1);
    access.describe(&t, &r, colorpicker.swatch(&t, w, 13), &q);
    check("dark", named(&q, "Dark Yellow") == 1);
    access.describe(&t, &r, colorpicker.swatch(&t, w, 34), &q);
    check("very dark", named(&q, "Very Dark Brown") == 1);
    access.describe(&t, &r, colorpicker.swatch(&t, w, 35), &q);
    check("the greys: white", named(&q, "White") == 1);
    access.describe(&t, &r, colorpicker.swatch(&t, w, 37), &q);
    check("light greys", named(&q, "Light Gray 2") == 1);
    access.describe(&t, &r, colorpicker.swatch(&t, w, 41), &q);
    check("dark greys", named(&q, "Dark Gray 2") == 1);
    access.describe(&t, &r, colorpicker.swatch(&t, w, 44), &q);
    check("black", named(&q, "Black") == 1);
    check("pressed: chosen", access.act(&t, colorpicker.swatch(&t, w, 44), access.PRESS, 0.0) == 1 && hex_is(&t, w, "#000000") == 1 &&
          access.act(&t, colorpicker.swatch(&t, w, 44), access.INCREMENT, 0.0) == 0);
    check("not a chooser: nothing", colorpicker.hue_of(&t, tree.root(&t)) == 0 && colorpicker.alpha_of(&t, tree.root(&t)) == 0 &&
          colorpicker.entry_of(&t, tree.root(&t)) == 0 && colorpicker.selected(&t, tree.root(&t)) == 0 - 1 &&
          colorpicker.swatch(&t, tree.root(&t), 0) == 0 && colorpicker.set_hsv(&t, tree.root(&t), 1.0, 1.0, 1.0) == 0 &&
          colorpicker.set_hsv(&t, w, 1.0, 1.0, 1.0) == 1 && colorpicker.preview(&t, tree.root(&t)).w == 0.0 &&
          colorpicker.color(&t, tree.root(&t)).a == 0.0);
    let is [12]u8 as hb;
    check("nor a code", colorpicker.hex(&t, tree.root(&t), cast(*u8, &hb)) == 0);
    tree.close(&t);
}

// --- In a dialog, and behind a button ---

let is i64 as answered with mut = 0;
let is i64 as answers with mut = 0;
fn on_answer(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    answered = *cast(*i64, arg);
    answers = answers + 1;
}

fn dialogged() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as dlg = colorpicker.dialog(&t, "Pick", 4);
    let is i64 as w = colorpicker.chooser_of(&t, dlg);
    signal.connect(&t, dlg, signal.ACTIVATED, fn_ptr(on_answer), cast(*u8, 0));
    let is i64 as plain = dialog.create(&t, "Plain", 5);
    check("a dialog holding a chooser", dlg != 0 && w != 0 && colorpicker.chooser_of(&t, tree.root(&t)) == 0 &&
          colorpicker.chooser_of(&t, plain) == 0);
    colorpicker.set_color(&t, w, math.color.hex(0x3584E4));
    dialog.show(&t, &r, dlg, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the chosen swatch focused first", router.focused(&t, &r) == colorpicker.swatch(&t, w, BLUE));
    key(&t, &r, keys.RIGHT, 0, 5);
    key(&t, &r, keys.RETURN, 0, 7);
    check("enter on a swatch: chosen, not the dialog's answer", answers == 0 && dialog.is_shown(&t, dlg) == 1 &&
          hex_is(&t, w, "#33d17a") == 1);
    click(&t, &r, mx(&t, colorpicker.swatch(&t, w, 20)), my(&t, colorpicker.swatch(&t, w, 20)), 10);
    let is i64 as ok = dialog.button_for(&t, dlg, dialog.OK);
    click(&t, &r, mx(&t, ok), my(&t, ok), 20);
    check("a swatch, then Select: the colour", answers == 1 && answered == dialog.OK && hex_is(&t, w, "#f66151") == 1 &&
          dialog.is_shown(&t, dlg) == 0);
    tree.close(&t);
}

let is i64 as button_changes with mut = 0;
fn on_button(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    button_changes = button_changes + 1;
    said = *cast(*math.color.Color, arg);
}

fn buttoned() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as b = colorpicker.button(&t, tree.root(&t), math.color.hex(0x3584E4));
    layout.set_align(&t, b, layout.START, layout.START);
    signal.connect(&t, b, signal.VALUE_CHANGED, fn_ptr(on_button), cast(*u8, 0));
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    frame(&t, &c);
    let is math.rect.Rect as br = layout.window_rect(&t, b);
    check("a button showing its colour", br.w > 30.0 && rgb_is(cast(i64, br.x + br.w / 2.0), cast(i64, br.y + br.h / 2.0), 0x35, 0x84, 0xE4, 2) == 1);
    check("no dialog before it is pressed", colorpicker.button_dialog(&t, b) == 0);
    button_changes = 0;
    click(&t, &r, mx(&t, b), my(&t, b), 10);
    let is i64 as dlg = colorpicker.button_dialog(&t, b);
    let is i64 as w = colorpicker.chooser_of(&t, dlg);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("pressed: the dialog, its colour", dlg != 0 && dialog.is_shown(&t, dlg) == 1 && hex_is(&t, w, "#3584e4") == 1);
    click(&t, &r, mx(&t, colorpicker.swatch(&t, w, 44)), my(&t, colorpicker.swatch(&t, w, 44)), 20);
    key(&t, &r, keys.ESCAPE, 0, 30);
    check("cancelled: as it was", button_changes == 0 && math.color.col_approx(colorpicker.button_color(&t, b), math.color.hex(0x3584E4), 0.0001) == 1);
    key(&t, &r, keys.SPACE, 0, 40);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("space: again, the dialog its colour once more", dialog.is_shown(&t, dlg) == 1 && colorpicker.button_dialog(&t, b) == dlg &&
          hex_is(&t, w, "#3584e4") == 1);
    click(&t, &r, mx(&t, colorpicker.swatch(&t, w, 44)), my(&t, colorpicker.swatch(&t, w, 44)), 50);
    let is i64 as ok = dialog.button_for(&t, dlg, dialog.OK);
    click(&t, &r, mx(&t, ok), my(&t, ok), 60);
    check("selected: the button's, said", button_changes == 1 && math.color.col_approx(said, math.color.hex(0x000000), 0.0001) == 1 &&
          math.color.col_approx(colorpicker.button_color(&t, b), math.color.hex(0x000000), 0.0001) == 1);
    frame(&t, &c);
    check("and shown", rgb_is(cast(i64, br.x + br.w / 2.0), cast(i64, br.y + br.h / 2.0), 0, 0, 0, 2) == 1);
    colorpicker.set_button_color(&t, b, math.color.hex(0xFFFFFF));
    check("set by the program: not said", button_changes == 1 &&
          math.color.col_approx(colorpicker.button_color(&t, b), math.color.hex(0xFFFFFF), 0.0001) == 1);
    let is tree.Access as q;
    access.describe(&t, &r, b, &q);
    check("told as a button named by its code", q.role == access.ROLE_BUTTON && named(&q, "#ffffff") == 1 &&
          access.act(&t, button.content(&t, b), access.PRESS, 0.0) == 0);
    check("not a colour button: nothing", colorpicker.button_dialog(&t, tree.root(&t)) == 0 &&
          colorpicker.set_color(&t, tree.root(&t), math.color.hex(0)) == 0 && colorpicker.plane_of(&t, tree.root(&t)) == 0);
    tree.destroy(&t, b);
    check("its dialog goes with it", tree.is_valid(&t, dlg) == 0);
    draw2d.close(&c);
    tree.close(&t);
}

// Where the application can open windows, the button's dialog has one of its
// own, belonging to the button's.
fn buttoned_windowed() as void {
    let is app.Limits as al with mut = app.limits_default();
    al.windows = 4;
    let is app.App as a = app.open(&al);
    app.set_theme(&a, &theme);
    app.set_text_service(&a, cast(*u8, svc));
    let is i64 as mw = app.window_open(&a, cast(f64, W), cast(f64, H));
    let is *tree.Tree as t = app.tree(&a, mw);
    let is *router.Router as r = app.router(&a, mw);
    let is i64 as b = colorpicker.button(t, tree.root(t), math.color.hex(0x3584E4));
    layout.set_align(t, b, layout.START, layout.START);
    signal.connect(t, b, signal.VALUE_CHANGED, fn_ptr(on_button), cast(*u8, 0));
    app.frame(&a, mw);
    check("windowed: no dialog before it is pressed", colorpicker.button_dialog(t, b) == 0 &&
          cast(i64, colorpicker.button_dialog_tree(t, b)) == 0);
    button_changes = 0;
    click(t, r, mx(t, b), my(t, b), 10);
    let is *tree.Tree as dt = colorpicker.button_dialog_tree(t, b);
    let is i64 as dlg = colorpicker.button_dialog(t, b);
    let is i64 as dw = app.window_of(&a, dt);
    check("windowed: pressed, its dialog in a window of its own, shown modal", cast(i64, dt) != cast(i64, t) && dw != 0 &&
          app.owner(&a, dw) == mw && app.is_shown(&a, dw) == 1 && app.is_modal(&a, dw) == 1 && dialog.is_shown(dt, dlg) == 1);
    let is i64 as w = colorpicker.chooser_of(dt, dlg);
    app.frame(&a, dw);
    check("windowed: the dialog its colour", hex_is(dt, w, "#3584e4") == 1);
    let is *router.Router as dr = app.router(&a, dw);
    click(dt, dr, mx(dt, colorpicker.swatch(dt, w, 44)), my(dt, colorpicker.swatch(dt, w, 44)), 20);
    let is i64 as ok = dialog.button_for(dt, dlg, dialog.OK);
    click(dt, dr, mx(dt, ok), my(dt, ok), 30);
    check("windowed: selected, the button's, said, the window put away", button_changes == 1 &&
          math.color.col_approx(colorpicker.button_color(t, b), math.color.hex(0x000000), 0.0001) == 1 &&
          app.is_shown(&a, dw) == 0 && app.blocked(&a, mw) == 0);
    click(t, r, mx(t, b), my(t, b), 100);
    check("windowed: pressed again, the same window", cast(i64, colorpicker.button_dialog_tree(t, b)) == cast(i64, dt) &&
          colorpicker.button_dialog(t, b) == dlg && app.is_shown(&a, dw) == 1 && app.window_count(&a) == 2);
    key(dt, dr, keys.ESCAPE, 0, 110);
    check("windowed: cancelled, as it was", button_changes == 1 && app.is_shown(&a, dw) == 0);
    tree.destroy(t, b);
    check("windowed: its dialog's window goes with it", app.window_valid(&a, dw) == 0 && app.window_count(&a) == 1);
    app.close(&a);
}

fn label_says(t as *tree.Tree, l as i64, s as *u8) as i32 { return same(label.text(t, l), label.text_length(t, l), s); }

// In the tree's language: what it tells, its dialog.
fn spoken() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    tree.set_language(&t, strings.PT_BR);
    let is i64 as w = colorpicker.create(&t, tree.root(&t));
    colorpicker.set_alpha_shown(&t, w, 1);
    colorpicker.set_hsv(&t, w, 200.0, 0.5, 0.75);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is tree.Access as q;
    access.describe(&t, &r, colorpicker.plane_of(&t, w), &q);
    check("the plane in it", named(&q, "Saturação e valor") == 1 && same(q.description, q.description_len, "Saturação 50%, valor 75%") == 1);
    access.describe(&t, &r, colorpicker.hue_of(&t, w), &q);
    let is i32 as hue = named(&q, "Matiz");
    access.describe(&t, &r, colorpicker.alpha_of(&t, w), &q);
    check("the strips", hue == 1 && named(&q, "Opacidade") == 1);
    access.describe(&t, &r, colorpicker.swatch(&t, w, BLUE), &q);
    let is i32 as blue = named(&q, "Azul");
    access.describe(&t, &r, colorpicker.swatch(&t, w, 0), &q);
    let is i32 as lightest = named(&q, "Azul muito claro");
    access.describe(&t, &r, colorpicker.swatch(&t, w, 13), &q);
    let is i32 as dark = named(&q, "Amarelo escuro");
    access.describe(&t, &r, colorpicker.swatch(&t, w, 24), &q);
    check("swatches, the shade after the colour", blue == 1 && lightest == 1 && dark == 1 && named(&q, "Vermelho muito escuro") == 1);
    access.describe(&t, &r, colorpicker.swatch(&t, w, 35), &q);
    let is i32 as white = named(&q, "Branco");
    access.describe(&t, &r, colorpicker.swatch(&t, w, 37), &q);
    let is i32 as light = named(&q, "Cinza claro 2");
    access.describe(&t, &r, colorpicker.swatch(&t, w, 41), &q);
    let is i32 as darkg = named(&q, "Cinza escuro 2");
    access.describe(&t, &r, colorpicker.swatch(&t, w, 44), &q);
    check("the greys", white == 1 && light == 1 && darkg == 1 && named(&q, "Preto") == 1);
    let is i64 as dlg = colorpicker.dialog(&t, "Cor", 3);
    check("its dialog's buttons", label_says(&t, button.content(&t, dialog.button_for(&t, dlg, dialog.OK)), "Selecionar") == 1 &&
          label_says(&t, button.content(&t, dialog.button_for(&t, dlg, dialog.CANCEL)), "Cancelar") == 1);
    let is i64 as b = colorpicker.button(&t, tree.root(&t), math.color.hex(0x3584E4));
    layout.run(&t, cast(f64, W), cast(f64, H));
    click(&t, &r, mx(&t, b), my(&t, b), 10);
    let is i64 as bd = colorpicker.button_dialog(&t, b);
    check("the button's dialog titled in it", bd != 0 && label_says(&t, dialog.title_label(&t, bd), "Escolha uma cor") == 1);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    laid();
    edited();
    typed();
    paletted();
    drawn();
    told();
    dialogged();
    buttoned();
    buttoned_windowed();
    spoken();

    if (fails == 0) {
        io.printf("colorpicker: %d checks passed\n", checks);
        return 0;
    }
    io.printf("colorpicker: %d of %d checks failed\n", fails, checks);
    return 1;
}
