// ui/widgets/headerbar_test.cst — a header bar: the window's title over its
// middle, the program's widgets at its ends, the window's buttons where the
// desktop's layout puts them; dragged to move the window, double-clicked to
// maximize it, its menu on the right button; drawn; told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../strings.cst" as strings;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../event.cst" as event;
use "../text.cst" as text;
use "label.cst" as label;
use "button.cst" as button;
use "../scroll.cst" as scroll;
use "headerbar.cst" as headerbar;

let is i64 as W with imut = 400;
let is i64 as H with imut = 120;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;
let is i32 as frame_active with mut = 1;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    o.active = frame_active;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


// Whether the point gx, gy of a button's icon — 16 to its side, half the
// button wide, in its middle — is drawn.
fn on_grid(r as math.rect.Rect, gx as f64, gy as f64) as i32 {
    let is f64 as side = r.w * 0.5;
    let is f64 as x = r.x + r.w / 2.0 - side / 2.0 + gx * side / 16.0;
    let is f64 as y = r.y + r.h / 2.0 - side / 2.0 + gy * side / 16.0;
    return dark(cast(i64, x), cast(i64, y));
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

// Within a pixel: placed on whole pixels, a middle can be half of one off.
fn within1(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d <= 1.0 && d >= 0.0 - 1.0);
}

fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

// What the window was asked to do.
let is [16]i64 as ops with mut;
let is i64 as nops with mut = 0;
let is f64 as op_x with mut = 0.0;
let is f64 as op_y with mut = 0.0;

fn on_op(user as *u8, op as i32, x as f64, y as f64) as void {
    if (nops < 16) { ops[nops] = cast(i64, op); }
    nops = nops + 1;
    op_x = x;
    op_y = y;
}

fn made(t as *tree.Tree) as i64 {
    tree.set_window_ops(t, fn_ptr(on_op), cast(*u8, 0));
    let is i64 as hb = headerbar.create(t, tree.root(t));
    layout.set_align(t, hb, layout.FILL, layout.START);
    headerbar.set_title(t, hb, "Documents", 9);
    return hb;
}

fn laid() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as hb = made(&t);
    let is i64 as open = button.create(&t, headerbar.start(&t, hb), "Open", 4);
    let is i64 as menu_b = button.create(&t, headerbar.end(&t, hb), "Menu", 4);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as hr = layout.window_rect(&t, hb);
    let is math.rect.Rect as tr = layout.window_rect(&t, headerbar.title(&t, hb));
    let is i64 as close = headerbar.button(&t, hb, headerbar.CLOSE);
    check("the desktop's usual buttons: close at the end only", close != 0 &&
          headerbar.button(&t, hb, headerbar.MINIMIZE) == 0 && headerbar.button(&t, hb, headerbar.MAXIMIZE) == 0);
    let is math.rect.Rect as cr = layout.window_rect(&t, close);
    let is math.rect.Rect as orr = layout.window_rect(&t, open);
    let is math.rect.Rect as mr = layout.window_rect(&t, menu_b);
    check("along the top, as tall as a header", hr.y == 0.0 && hr.h >= theme.metrics.control_height + 2.0 * theme.metrics.space_s);
    let is f64 as off = tr.x + tr.w / 2.0 - hr.x - hr.w / 2.0;
    check("its title in the middle of the whole bar, to the pixel", off < 1.0 && off > 0.0 - 1.0);
    check("the program's at its start and end, the window's buttons after them", orr.x < tr.x && mr.x + mr.w <= cr.x &&
          near(cr.x + cr.w, hr.x + hr.w - theme.metrics.space_s) == 1);
    check("the program's across its middle, a gap from the window's buttons",
          near(orr.y + orr.h / 2.0, hr.y + hr.h / 2.0) == 1 && near(mr.y + mr.h / 2.0, hr.y + hr.h / 2.0) == 1 &&
          near(mr.x + mr.w, cr.x - theme.metrics.space_s) == 1 && near(orr.x, hr.x + theme.metrics.space_s) == 1);
    // GNOME's layout: buttons on both sides.
    headerbar.set_layout(&t, hb, "close:minimize,maximize", 23);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as close2 = headerbar.button(&t, hb, headerbar.CLOSE);
    let is i64 as mini = headerbar.button(&t, hb, headerbar.MINIMIZE);
    let is i64 as maxi = headerbar.button(&t, hb, headerbar.MAXIMIZE);
    let is math.rect.Rect as c2 = layout.window_rect(&t, close2);
    let is math.rect.Rect as n2 = layout.window_rect(&t, mini);
    let is math.rect.Rect as x2 = layout.window_rect(&t, maxi);
    check("a layout: close at the start, minimize then maximize at the end", near(c2.x, hr.x + theme.metrics.space_s) == 1 &&
          n2.x + n2.w <= x2.x && near(x2.x + x2.w, hr.x + hr.w - theme.metrics.space_s) == 1 &&
          layout.window_rect(&t, open).x >= c2.x + c2.w);
    // The buttons do what they say.
    nops = 0;
    click(&t, &r, n2.x + n2.w / 2.0, n2.y + n2.h / 2.0, 10);
    click(&t, &r, x2.x + x2.w / 2.0, x2.y + x2.h / 2.0, 20);
    click(&t, &r, c2.x + c2.w / 2.0, c2.y + c2.h / 2.0, 30);
    check("minimize, maximize, close: asked of the window", nops == 3 && ops[0] == tree.WIN_MINIMIZE &&
          ops[1] == tree.WIN_MAXIMIZE && ops[2] == tree.WIN_CLOSE);
    // Its empty places: dragged moves, twice clicked maximizes, the right
    // button the window's menu.
    let is f64 as ex = tr.x + tr.w + 10.0;
    let is f64 as ey = hr.y + hr.h / 2.0;
    nops = 0;
    router.pointer_move(&t, &r, ex, ey, 1000);
    router.pointer_button(&t, &r, 1, 1, ex, ey, 1000);
    router.pointer_move(&t, &r, ex + 20.0, ey, 1010);
    router.pointer_button(&t, &r, 1, 0, ex + 20.0, ey, 1020);
    check("dragged: the window moved by the pointer", nops == 1 && ops[0] == tree.WIN_MOVE);
    nops = 0;
    click(&t, &r, ex, ey, 3000);
    click(&t, &r, ex, ey, 3100);
    check("clicked twice: maximized", nops == 1 && ops[0] == tree.WIN_MAXIMIZE);
    nops = 0;
    router.pointer_button(&t, &r, 3, 1, ex, ey, 5000);
    router.pointer_button(&t, &r, 3, 0, ex, ey, 5010);
    check("the right button: the window's menu, where the pointer is", nops == 1 && ops[0] == tree.WIN_MENU && op_x == ex);
    nops = 0;
    let is math.rect.Rect as orr2 = layout.window_rect(&t, open);
    click(&t, &r, orr2.x + orr2.w / 2.0, orr2.y + orr2.h / 2.0, 6000);
    check("what the program put there: its own", nops == 0);
    // A subtitle under the title.
    headerbar.set_subtitle(&t, hb, "~/docs", 6);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as sub_l = tree.next_sibling(&t, headerbar.title(&t, hb));
    let is math.rect.Rect as tr2 = layout.window_rect(&t, headerbar.title(&t, hb));
    let is math.rect.Rect as sr2 = layout.window_rect(&t, sub_l);
    check("a subtitle under the title", tree.is_visible(&t, sub_l) == 1 && near(sr2.y, tr2.y + tr2.h) == 1);
    headerbar.set_subtitle(&t, hb, "", 0);
    check("none again: gone", tree.is_visible(&t, sub_l) == 0);
    // Too much at its start for the middle: the middle of what is left.
    let is i64 as wide = button.create(&t, headerbar.start(&t, hb), "Wide", 4);
    layout.set_min_size(&t, wide, 110.0, 0.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as tr3 = layout.window_rect(&t, headerbar.title(&t, hb));
    let is math.rect.Rect as wr3 = layout.window_rect(&t, wide);
    let is math.rect.Rect as mr3 = layout.window_rect(&t, menu_b);
    let is f64 as mid3 = (wr3.x + wr3.w + mr3.x) / 2.0;
    let is f64 as off3 = tr3.x + tr3.w / 2.0 - mid3;
    check("no room in the middle: the middle of what is left", tr3.x >= wr3.x + wr3.w && off3 < 1.0 && off3 > 0.0 - 1.0);
    tree.destroy(&t, wide);
    // Right to left: mirrored.
    layout.set_direction(&t, hb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as c4 = layout.window_rect(&t, headerbar.button(&t, hb, headerbar.CLOSE));
    check("right to left: close at the right, its layout's start", near(c4.x + c4.w, hr.x + hr.w - theme.metrics.space_s) == 1);
    layout.set_direction(&t, hb, layout.LTR);
    // Maximized: the button says it restores.
    headerbar.set_maximized(&t, hb, 1);
    let is tree.Access as q;
    access.describe(&t, &r, maxi, &q);
    check("maximized: its button restores", same(q.name, q.name_len, "Restore") == 1);
    tree.close(&t);
}

fn size_of(t as *tree.Tree, w as i64) as geom.Size {
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &free, &s);
    return s;
}

// The window's buttons made again for each layout, the old ones gone; two on
// a side in order; as large as all it holds.
fn buttons() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as hb = made(&t);
    let is f64 as pad = theme.metrics.space_s;
    let is i64 as old = headerbar.button(&t, hb, headerbar.CLOSE);
    headerbar.set_layout(&t, hb, "close,minimize:maximize", 23);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as c = headerbar.button(&t, hb, headerbar.CLOSE);
    let is i64 as n = headerbar.button(&t, hb, headerbar.MINIMIZE);
    let is i64 as x = headerbar.button(&t, hb, headerbar.MAXIMIZE);
    let is math.rect.Rect as hr = layout.window_rect(&t, hb);
    let is math.rect.Rect as cr = layout.window_rect(&t, c);
    let is math.rect.Rect as nr = layout.window_rect(&t, n);
    check("made again: the old one gone", tree.is_valid(&t, old) == 0 && c != 0 && n != 0 && x != 0);
    check("two at its start, in order", near(cr.x, hr.x + pad) == 1 && near(nr.x, cr.x + cr.w + pad) == 1 &&
          near(nr.y, cr.y) == 1 && nr.w > 0.0);
    headerbar.set_layout(&t, hb, "minimize:maximize,close", 23);
    check("and again: all three old ones gone", tree.is_valid(&t, c) == 0 && tree.is_valid(&t, n) == 0 &&
          tree.is_valid(&t, x) == 0 && tree.child_count(&t, hb) == 7);
    let is i64 as x2 = headerbar.button(&t, hb, headerbar.MAXIMIZE);
    let is i64 as c2 = headerbar.button(&t, hb, headerbar.CLOSE);
    headerbar.set_layout(&t, hb, "minimize:maximize,close", 23);
    check("two at its end gone too", tree.is_valid(&t, x2) == 0 && tree.is_valid(&t, c2) == 0 && tree.child_count(&t, hb) == 7);
    // As large as all it holds.
    let is i64 as b = button.create(&t, headerbar.start(&t, hb), "Open", 4);
    button.create(&t, headerbar.end(&t, hb), "Menu", 4);
    headerbar.set_subtitle(&t, hb, "~/docs", 6);
    layout.set_min_size(&t, headerbar.title(&t, hb), 0.0, 30.0);
    let is geom.Size as hs = size_of(&t, hb);
    let is geom.Size as ss = size_of(&t, headerbar.start(&t, hb));
    let is geom.Size as es = size_of(&t, headerbar.end(&t, hb));
    let is geom.Size as ts = size_of(&t, headerbar.title(&t, hb));
    let is geom.Size as us = size_of(&t, tree.next_sibling(&t, headerbar.title(&t, hb)));
    let is f64 as bs = theme.metrics.control_height;
    let is f64 as tw with mut = ts.pref_w;
    if (us.pref_w > tw) { tw = us.pref_w; }
    check("as wide as its buttons, what it holds and its title, apart", ss.pref_w > 0.0 && es.min_w > 0.0 &&
          near(hs.pref_w, 4.0 * pad + 3.0 * (bs + pad) + ss.pref_w + es.pref_w + tw) == 1 &&
          near(hs.min_w, 2.0 * pad + 3.0 * (bs + pad) + ss.min_w + es.min_w) == 1);
    check("as tall as its title and subtitle together, padded", ts.pref_h + us.pref_h > bs &&
          near(hs.pref_h, 2.0 * pad + ts.pref_h + us.pref_h) == 1 && b != 0);
    check("not a header bar: no end", headerbar.end(&t, tree.root(&t)) == 0);
    tree.close(&t);
}

// The title over its subtitle, both in the middle, and in the middle of what
// is left when one side has too much.
fn titled() as void {
    let is tree.Tree as t = tree_for();
    let is i64 as hb = made(&t);
    let is i64 as sub = tree.next_sibling(&t, headerbar.title(&t, hb));
    headerbar.set_title(&t, hb, "A", 1);
    headerbar.set_subtitle(&t, hb, "a longer line", 13);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as hr = layout.window_rect(&t, hb);
    let is math.rect.Rect as tr = layout.window_rect(&t, headerbar.title(&t, hb));
    let is math.rect.Rect as sr = layout.window_rect(&t, sub);
    check("a short title over a long subtitle: over its middle", tr.w < sr.w &&
          within1(tr.x + tr.w / 2.0, sr.x + sr.w / 2.0) == 1);
    check("the two across its middle", near(tr.y - hr.y, hr.y + hr.h - sr.y - sr.h) == 1 && near(sr.y, tr.y + tr.h) == 1);
    headerbar.set_title(&t, hb, "A long title", 12);
    headerbar.set_subtitle(&t, hb, "b", 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as tr2 = layout.window_rect(&t, headerbar.title(&t, hb));
    let is math.rect.Rect as sr2 = layout.window_rect(&t, sub);
    check("a short subtitle under a long title: under its middle", sr2.w < tr2.w &&
          within1(tr2.x + tr2.w / 2.0, sr2.x + sr2.w / 2.0) == 1);
    headerbar.set_subtitle(&t, hb, "", 0);
    headerbar.set_title(&t, hb, "Documents", 9);
    // Too much at its end: the middle of what is left, from the start's edge.
    let is i64 as wide = button.create(&t, headerbar.end(&t, hb), "Wide", 4);
    layout.set_min_size(&t, wide, 230.0, 0.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as tr3 = layout.window_rect(&t, headerbar.title(&t, hb));
    let is math.rect.Rect as wr3 = layout.window_rect(&t, wide);
    let is f64 as mid3 = (hr.x + theme.metrics.space_s + wr3.x - theme.metrics.space_s) / 2.0;
    let is f64 as off3 = tr3.x + tr3.w / 2.0 - mid3;
    check("too much at its end: the middle of what is left", tr3.x + tr3.w <= wr3.x && off3 < 1.0 && off3 > 0.0 - 1.0);
    tree.destroy(&t, wide);
    // And at its start, nothing at its end but the close button.
    let is i64 as wide2 = button.create(&t, headerbar.start(&t, hb), "Wide", 4);
    layout.set_min_size(&t, wide2, 230.0, 0.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as tr4 = layout.window_rect(&t, headerbar.title(&t, hb));
    let is math.rect.Rect as wr4 = layout.window_rect(&t, wide2);
    let is math.rect.Rect as cr4 = layout.window_rect(&t, headerbar.button(&t, hb, headerbar.CLOSE));
    let is f64 as mid4 = (wr4.x + wr4.w + theme.metrics.space_s + cr4.x - theme.metrics.space_s) / 2.0;
    let is f64 as off4 = tr4.x + tr4.w / 2.0 - mid4;
    check("too much at its start: the middle of what is left", tr4.x >= wr4.x + wr4.w && off4 < 1.0 && off4 > 0.0 - 1.0);
    tree.close(&t);
}

// What passes on: the right button, onto whoever holds it; a button released
// off it does nothing.
let is i64 as caught with mut = 0;
let is i64 as menus with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase == event.BUBBLE && e.kind == event.POINTER_DOWN) {
        caught = caught + 1;
        return 1;
    }
    if (e.phase == event.BUBBLE && e.kind == event.CONTEXT_MENU) {
        menus = menus + 1;
        return 1;
    }
    return 0;
}

fn catch_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catch_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as catcher with mut;

fn asked() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    tree.set_window_ops(&t, fn_ptr(on_op), cast(*u8, 0));
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t, &catcher, tree.root(&t));
    let is i64 as hb = headerbar.create(&t, holder);
    layout.set_align(&t, hb, layout.FILL, layout.START);
    headerbar.set_title(&t, hb, "Documents", 9);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as hr = layout.window_rect(&t, hb);
    let is math.rect.Rect as cr = layout.window_rect(&t, headerbar.button(&t, hb, headerbar.CLOSE));
    let is f64 as ex = hr.x + 20.0;
    let is f64 as ey = hr.y + hr.h / 2.0;
    caught = 0;
    menus = 0;
    nops = 0;
    click(&t, &r, ex, ey, 10);
    check("pressed on its empty places: its own", caught == 0 && nops == 0);
    router.pointer_button(&t, &r, 3, 1, ex, ey, 1000);
    router.pointer_button(&t, &r, 3, 0, ex, ey, 1010);
    check("the right button: on up, the window's menu still", caught == 1 && nops == 1 && ops[0] == tree.WIN_MENU);
    check("that menu its own", menus == 0);
    nops = 0;
    router.pointer_button(&t, &r, 3, 1, cr.x + cr.w / 2.0, cr.y + cr.h / 2.0, 2000);
    router.pointer_button(&t, &r, 3, 0, cr.x + cr.w / 2.0, cr.y + cr.h / 2.0, 2010);
    check("the right button on a window's button: the window's menu", nops == 1 && ops[0] == tree.WIN_MENU);
    // Released on its very edges: inside at its left and top, outside past
    // its right and bottom.
    nops = 0;
    router.pointer_move(&t, &r, cr.x + cr.w / 2.0, cr.y + cr.h / 2.0, 3000);
    router.pointer_button(&t, &r, 1, 1, cr.x + cr.w / 2.0, cr.y + cr.h / 2.0, 3000);
    router.pointer_button(&t, &r, 1, 0, cr.x, cr.y, 3010);
    check("released on its first column and row: done", nops == 1 && ops[0] == tree.WIN_CLOSE);
    nops = 0;
    router.pointer_move(&t, &r, cr.x + cr.w / 2.0, cr.y + cr.h / 2.0, 5000);
    router.pointer_button(&t, &r, 1, 1, cr.x + cr.w / 2.0, cr.y + cr.h / 2.0, 5000);
    router.pointer_button(&t, &r, 1, 0, cr.x + cr.w, cr.y + cr.h / 2.0, 5010);
    router.pointer_move(&t, &r, cr.x + cr.w / 2.0, cr.y + cr.h / 2.0, 7000);
    router.pointer_button(&t, &r, 1, 1, cr.x + cr.w / 2.0, cr.y + cr.h / 2.0, 7000);
    router.pointer_button(&t, &r, 1, 0, cr.x + cr.w / 2.0, cr.y + cr.h, 7010);
    check("released just past it: nothing", nops == 0);
    // Pressed by assistive technology: asked at its middle.
    nops = 0;
    check("pressed by assistive technology: done, at its middle",
          access.act(&t, headerbar.button(&t, hb, headerbar.CLOSE), access.PRESS, 0.0) == 1 && nops == 1 &&
          near(op_x, cr.x + cr.w / 2.0) == 1 && near(op_y, cr.y + cr.h / 2.0) == 1);
    tree.close(&t);
}

fn dark(x as i64, y as i64) as i32 { return cast(i32, ch(x, y, 0) < 140); }

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    frame_router = &r;
    let is i64 as hb = made(&t);
    frame(&t, c);
    let is math.rect.Rect as hr = layout.window_rect(&t, hb);
    check("its background the header's", is8(cast(i64, hr.x + 3.0), cast(i64, hr.y + 3.0), theme.palette.headerbar_bg, 2) == 1);
    check("a line under it", is8(cast(i64, hr.x + 3.0), cast(i64, hr.y + hr.h - 1.0), theme.palette.separator, 2) == 1);
    let is i64 as title = headerbar.title(&t, hb);
    check("its title in the text colour", is8(ink_x(&t, title), ink_y(&t, title), theme.palette.fg, 40) == 1);
    // The window's buttons' icons (icons.cst), half a button wide in its
    // middle: a cross, a bar along its foot, a square; two once maximized.
    headerbar.set_layout(&t, hb, "close:minimize,maximize", 23);
    frame(&t, c);
    let is math.rect.Rect as cr = layout.window_rect(&t, headerbar.button(&t, hb, headerbar.CLOSE));
    let is math.rect.Rect as nr = layout.window_rect(&t, headerbar.button(&t, hb, headerbar.MINIMIZE));
    let is math.rect.Rect as xr = layout.window_rect(&t, headerbar.button(&t, hb, headerbar.MAXIMIZE));
    check("close: a cross", on_grid(cr, 8.0, 8.0) == 1 && on_grid(cr, 4.4, 4.4) == 1 && on_grid(cr, 11.6, 4.4) == 1 &&
          on_grid(cr, 8.0, 4.4) == 0);
    check("minimize: a bar along its foot", on_grid(nr, 8.0, 8.0) == 0 && on_grid(nr, 5.0, 11.75) == 1 && on_grid(nr, 11.0, 11.75) == 1);
    check("maximize: a square", on_grid(xr, 8.0, 8.0) == 0 && on_grid(xr, 4.25, 8.0) == 1 && on_grid(xr, 11.75, 10.0) == 1 &&
          on_grid(xr, 8.0, 4.25) == 1);
    headerbar.set_maximized(&t, hb, 1);
    frame(&t, c);
    check("restore: two squares", on_grid(xr, 12.75, 6.0) == 1 && on_grid(xr, 9.75, 12.0) == 1 && on_grid(xr, 3.25, 9.0) == 1 &&
          on_grid(xr, 8.0, 3.25) == 1 && on_grid(xr, 6.5, 9.5) == 0);
    // Its window not the active one: its title dimmer.
    frame_active = 0;
    tree.invalidate_paint(&t, hb);
    frame(&t, c);
    check("in the background: its title dimmer", is8(ink_x(&t, title), ink_y(&t, title), theme.palette.fg_dim, 40) == 1 &&
          is8(ink_x(&t, title), ink_y(&t, title), theme.palette.fg, 40) == 0);
    frame_active = 1;
    frame_router = cast(*router.Router, 0);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as hb = made(&t);
    headerbar.set_layout(&t, hb, ":minimize,maximize,close", 24);
    let is tree.Access as q;
    access.describe(&t, &r, hb, &q);
    check("told: a title bar named by its title", q.role == access.ROLE_TITLE_BAR && q.name_len == 9);
    access.describe(&t, &r, headerbar.button(&t, hb, headerbar.CLOSE), &q);
    check("its buttons named", q.role == access.ROLE_BUTTON && same(q.name, q.name_len, "Close") == 1 &&
          (q.actions & access.PRESS) != 0);
    nops = 0;
    access.act(&t, headerbar.button(&t, hb, headerbar.MINIMIZE), access.PRESS, 0.0);
    check("pressed by assistive technology: asked of the window", nops == 1 && ops[0] == tree.WIN_MINIMIZE);
    tree.set_window_ops(&t, cast(tree.WindowOpFn, 0), cast(*u8, 0));
    access.act(&t, headerbar.button(&t, hb, headerbar.CLOSE), access.PRESS, 0.0);
    check("no window to ask: nothing", nops == 1);
    // In the tree's language.
    tree.set_language(&t, strings.PT_BR);
    access.describe(&t, &r, headerbar.button(&t, hb, headerbar.CLOSE), &q);
    let is i32 as close = same(q.name, q.name_len, "Fechar");
    access.describe(&t, &r, headerbar.button(&t, hb, headerbar.MINIMIZE), &q);
    let is i32 as mini = same(q.name, q.name_len, "Minimizar");
    access.describe(&t, &r, headerbar.button(&t, hb, headerbar.MAXIMIZE), &q);
    let is i32 as maxi = same(q.name, q.name_len, "Maximizar");
    headerbar.set_maximized(&t, hb, 1);
    access.describe(&t, &r, headerbar.button(&t, hb, headerbar.MAXIMIZE), &q);
    check("named in the tree's language", close == 1 && mini == 1 && maxi == 1 && same(q.name, q.name_len, "Restaurar") == 1);
    tree.set_language(&t, strings.EN);
    check("not a header bar: nothing", headerbar.start(&t, tree.root(&t)) == 0 && headerbar.title(&t, tree.root(&t)) == 0 &&
          headerbar.button(&t, tree.root(&t), headerbar.CLOSE) == 0);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    laid();
    buttons();
    titled();
    asked();
    drawn(&c);
    told();

    if (fails == 0) {
        io.printf("headerbar: %d checks passed\n", checks);
        return 0;
    }
    io.printf("headerbar: %d of %d checks failed\n", fails, checks);
    return 1;
}
