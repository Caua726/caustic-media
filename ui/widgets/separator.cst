// ui/widgets/separator.cst — a line between things.
//
// A line the theme's border thick in its separator colour, across all of
// what it is given, or up and down, in the middle of it and on whole physical
// pixels so it is crisp; it has no other size, so a box gives it the length.
use "std/math.cst" as fm;
use "../../render/draw2d.cst" as draw2d;
use "../../render/shapes2d.cst" as shapes;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;

struct Data {
    vertical as i32;
    _pad0    as i32;
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("separator", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.paint = fn_ptr(_paint);
    _kind.role = access.ROLE_SEPARATOR;
    _kind.access = fn_ptr(_access);
    _ready = 1;
}

// A new separator, across — up and down for vertical 1 — as the last child
// of parent. Its handle, or 0 with the tree's last_error set.
fn create(t as *tree.Tree, parent as i64, vertical as i32) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_kind, parent);
    if (w == 0) { return 0; }
    cast(*Data, tree.data(t, w)).vertical = vertical;
    return w;
}

// Up and down rather than across: 1, or 0 for a widget that is no separator.
fn set_vertical(t as *tree.Tree, w as i64, on as i32) as i32 {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return 0; }
    cast(*Data, tree.data(t, w)).vertical = on;
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    return 1;
}

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is f64 as bw = th.metrics.border_width;
    geom.size_zero(out);
    if (cast(*Data, data).vertical == 1) {
        out.min_w = bw;
        out.pref_w = bw;
    } else {
        out.min_h = bw;
        out.pref_h = bw;
    }
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

// v down to the physical pixel grid, at s pixels a logical one.
fn _snap(v as f64, s as f64) as f64 { return fm.floor(v * s) / s; }

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is f64 as bw = p.theme.metrics.border_width;
    let is f64 as s = draw2d.scale(p.canvas);
    let is f64 as x with mut = p.rect.x;
    let is f64 as y with mut = p.rect.y;
    let is f64 as lw with mut = p.rect.w;
    let is f64 as lh with mut = bw;
    if (cast(*Data, data).vertical == 1) {
        x = _snap(p.rect.x + (p.rect.w - bw) / 2.0, s);
        lw = bw;
        lh = p.rect.h;
    } else {
        y = _snap(p.rect.y + (p.rect.h - bw) / 2.0, s);
    }
    shapes.fill_rect(p.canvas, x, y, lw, lh, p.theme.palette.separator);
}

fn _access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    if (q.action != access.ASK) { return 0; }
    if (cast(*Data, data).vertical == 1) { q.states = q.states | access.VERTICAL; }
    else { q.states = q.states | access.HORIZONTAL; }
    return 1;
}
