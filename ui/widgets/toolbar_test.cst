// ui/widgets/toolbar_test.cst — a toolbar: tools in a row, one stop for Tab
// with the arrows moving among them; those that do not fit offered from a
// menu at its end; told.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../math/math.cst" as math;
use "../../gpu/gpu.cst" as gpu;
use "../../render/draw2d.cst" as draw2d;
use "../../window/keys.cst" as keys;
use "../../text/sfnt/sfnt.cst" as sfnt;
use "../../text/sfnt/table.cst" as table;
use "../../text/layout/font.cst" as font;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../box.cst" as box;
use "../damage.cst" as damage;
use "../paint.cst" as paint;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;
use "../router.cst" as router;
use "../signal.cst" as signal;
use "../text.cst" as text;
use "label.cst" as label;
use "button.cst" as button;
use "menu.cst" as menu;
use "separator.cst" as separator;
use "../event.cst" as event;
use "toolbar.cst" as toolbar;

let is i64 as W with imut = 400;
let is i64 as H with imut = 200;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}

let is i64 as clicks with mut = 0;
let is i64 as last_clicked with mut = 0;
fn on_click(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    clicks = clicks + 1;
    last_clicked = w;
}

// What bubbles out of it: presses and keys it does not take.
let is i64 as caught with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase == event.BUBBLE && (e.kind == event.KEY_DOWN || e.kind == event.POINTER_DOWN)) {
        caught = caught + 1;
        return 1;
    }
    return 0;
}

fn catch_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catch_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as catcher with mut;

fn rowed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as tb = toolbar.create(&t, tree.root(&t));
    layout.set_align(&t, tb, layout.START, layout.START);
    let is i64 as open = toolbar.add_button(&t, tb, "_Open", 5);
    let is i64 as bold = toolbar.add_toggle(&t, tb, "_Bold", 5);
    let is i64 as sep = toolbar.add_separator(&t, tb);
    let is i64 as save = toolbar.add_button(&t, tb, "_Save", 5);
    let is i64 as quit = toolbar.add_button(&t, tb, "_Quit", 5);
    check("a toolbar of five", tb != 0 && toolbar.count(&t, tb) == 5 && toolbar.item(&t, tb, 2) == sep &&
          button.is_active(&t, bold) == 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ro = layout.window_rect(&t, open);
    let is math.rect.Rect as rb = layout.window_rect(&t, bold);
    let is math.rect.Rect as rs = layout.window_rect(&t, sep);
    let is math.rect.Rect as rv = layout.window_rect(&t, save);
    check("in a row, in order", ro.x == 0.0 && rb.x >= ro.x + ro.w && rs.x >= rb.x + rb.w && rv.x >= rs.x + rs.w &&
          ro.y == rb.y && ro.h >= theme.metrics.control_height);
    check("one stop for Tab: the first", tree.is_focusable(&t, open) == 1 && tree.is_focusable(&t, bold) == 0 &&
          tree.is_focusable(&t, save) == 0);
    router.focus(&t, &r, open, 1);
    key(&t, &r, keys.RIGHT, 0, 10);
    check("right: the next, the stop with it", router.focused(&t, &r) == bold && tree.is_focusable(&t, bold) == 1 &&
          tree.is_focusable(&t, open) == 0);
    key(&t, &r, keys.RIGHT, 0, 20);
    check("past the separator", router.focused(&t, &r) == save);
    tree.set_enabled(&t, quit, 0);
    key(&t, &r, keys.RIGHT, 0, 30);
    check("not onto what is disabled: there still", router.focused(&t, &r) == save);
    tree.set_enabled(&t, quit, 1);
    key(&t, &r, keys.END, 0, 40);
    check("end: the last", router.focused(&t, &r) == quit);
    key(&t, &r, keys.HOME, 0, 50);
    check("home: the first", router.focused(&t, &r) == open);
    key(&t, &r, keys.LEFT, 0, 60);
    check("left at the first: there still", router.focused(&t, &r) == open);
    // A tool clicked: its own; the stop goes with the focus.
    signal.connect(&t, save, signal.CLICKED, fn_ptr(on_click), cast(*u8, 0));
    clicks = 0;
    click(&t, &r, rv.x + rv.w / 2.0, rv.y + rv.h / 2.0, 100);
    check("a tool clicked", clicks == 1);
    // Right to left: from the right, the arrows the other way.
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as wr = layout.window_rect(&t, tb);
    check("right to left: from the right", layout.window_rect(&t, open).x + layout.window_rect(&t, open).w == wr.x + wr.w &&
          layout.window_rect(&t, bold).x + layout.window_rect(&t, bold).w == layout.window_rect(&t, open).x);
    router.focus(&t, &r, open, 1);
    key(&t, &r, keys.LEFT, 0, 200);
    check("right to left: left is on", router.focused(&t, &r) == bold);
    tree.close(&t);
    // A separator first: still only the first button takes the stop.
    let is tree.Tree as t2 = tree_for();
    let is i64 as tb2 = toolbar.create(&t2, tree.root(&t2));
    toolbar.add_separator(&t2, tb2);
    let is i64 as a2 = toolbar.add_button(&t2, tb2, "A", 1);
    let is i64 as b2 = toolbar.add_button(&t2, tb2, "B", 1);
    check("a separator first: the first button the stop, only it", tree.is_focusable(&t2, a2) == 1 && tree.is_focusable(&t2, b2) == 0);
    check("not a toolbar: nothing", toolbar.item(&t2, tree.root(&t2), 0) == 0 && toolbar.add_separator(&t2, tree.root(&t2)) == 0 &&
          toolbar.shown(&t2, tree.root(&t2)) == 0 && toolbar.overflowing(&t2, tree.root(&t2)) == 0 &&
          toolbar.more(&t2, tree.root(&t2)) == 0 && toolbar.overflow_menu(&t2, tree.root(&t2)) == 0 && toolbar.item(&t2, tb2, 0 - 1) == 0);
    // The stop destroyed: another takes it.
    tree.destroy(&t2, a2);
    layout.run(&t2, cast(f64, W), cast(f64, H));
    check("the stop gone: another the stop", tree.is_focusable(&t2, b2) == 1);
    tree.close(&t2);
}

// A widget of the program's among the tools, a button inside it: the arrows
// there are not the toolbar's.
fn nested() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t, &catcher, tree.root(&t));
    let is i64 as tb = toolbar.create(&t, holder);
    layout.set_align(&t, tb, layout.START, layout.START);
    toolbar.add_button(&t, tb, "One", 3);
    let is i64 as bx = box.create(&t, tb, box.ROW);
    let is i64 as inner = button.create(&t, bx, "In", 2);
    toolbar.add_button(&t, tb, "Two", 3);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, inner, 1);
    caught = 0;
    key(&t, &r, keys.RIGHT, 0, 10);
    check("a button inside a widget of its own: the arrows on up", router.focused(&t, &r) == inner && caught == 1);
    tree.close(&t);
}

// Its menu under its menu button, flush with the end — the left in right to
// left.
fn placed() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as tb = toolbar.create(&t, tree.root(&t));
    layout.set_align(&t, tb, layout.CENTER, layout.START);
    layout.set_min_size(&t, tb, 120.0, 0.0);
    layout.set_max_size(&t, tb, 120.0, 100.0);
    toolbar.add_button(&t, tb, "One", 3);
    toolbar.add_button(&t, tb, "Two", 3);
    toolbar.add_button(&t, tb, "Three", 5);
    toolbar.add_button(&t, tb, "Four", 4);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as mr = layout.window_rect(&t, toolbar.more(&t, tb));
    click(&t, &r, mr.x + mr.w / 2.0, mr.y + mr.h / 2.0, 10);
    let is i64 as m = toolbar.overflow_menu(&t, tb);
    let is math.rect.Rect as pr = layout.window_rect(&t, m);
    check("its menu under it, flush with its end", menu.is_open(&t, m) == 1 && pr.x + pr.w > mr.x + mr.w - 0.01 &&
          pr.x + pr.w < mr.x + mr.w + 0.01 && pr.y >= mr.y + mr.h - 0.01);
    key(&t, &r, keys.ESCAPE, 0, 20);
    layout.set_direction(&t, tb, layout.RTL);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as mr2 = layout.window_rect(&t, toolbar.more(&t, tb));
    click(&t, &r, mr2.x + mr2.w / 2.0, mr2.y + mr2.h / 2.0, 30);
    let is math.rect.Rect as pr2 = layout.window_rect(&t, m);
    check("right to left: flush with its left", menu.is_open(&t, m) == 1 && pr2.x > mr2.x - 0.01 && pr2.x < mr2.x + 0.01 &&
          mr2.x < 200.0);
    key(&t, &r, keys.ESCAPE, 0, 40);
    tree.close(&t);
}

// Three dots on its menu button.
fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is i64 as tb = toolbar.create(&t, tree.root(&t));
    layout.set_align(&t, tb, layout.START, layout.START);
    layout.set_min_size(&t, tb, 120.0, 0.0);
    layout.set_max_size(&t, tb, 120.0, 100.0);
    toolbar.add_button(&t, tb, "One", 3);
    toolbar.add_button(&t, tb, "Two", 3);
    toolbar.add_button(&t, tb, "Three", 5);
    frame(&t, c);
    let is math.rect.Rect as mr = layout.window_rect(&t, toolbar.more(&t, tb));
    let is i64 as cx = cast(i64, mr.x + mr.w / 2.0);
    let is i64 as cy = cast(i64, mr.y + mr.h / 2.0);
    let is i64 as gap = cast(i64, 3.0 * 1.5 + 0.5);
    let is f64 as dot = mr.h * 0.06;
    let is i64 as g = cast(i64, 3.0 * dot + 0.5);
    check("three dots on its menu button", is8(cx, cy, theme.palette.fg, 60) == 1 && is8(cx - g, cy, theme.palette.fg, 60) == 1 &&
          is8(cx + g, cy, theme.palette.fg, 60) == 1 && is8(cx + g / 2, cy, theme.palette.window_bg, 10) == 1 && gap > 0);
    tree.close(&t);
}

fn overflowing() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.arrange = fn_ptr(catch_arrange);
    catcher.event = fn_ptr(catch);
    let is i64 as holder = tree.create(&t, &catcher, tree.root(&t));
    let is i64 as tb = toolbar.create(&t, holder);
    layout.set_align(&t, tb, layout.START, layout.START);
    layout.set_min_size(&t, tb, 150.0, 0.0);
    layout.set_max_size(&t, tb, 150.0, 100.0);
    let is [6]i64 as items;
    items[0] = toolbar.add_button(&t, tb, "One", 3);
    items[1] = toolbar.add_button(&t, tb, "Two", 3);
    items[2] = toolbar.add_button(&t, tb, "Three", 5);
    items[3] = toolbar.add_toggle(&t, tb, "Four", 4);
    items[4] = toolbar.add_button(&t, tb, "Five", 4);
    items[5] = toolbar.add_button(&t, tb, "Six", 3);
    signal.connect(&t, items[4], signal.CLICKED, fn_ptr(on_click), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as shown = toolbar.shown(&t, tb);
    let is math.rect.Rect as mr = layout.window_rect(&t, toolbar.more(&t, tb));
    check("more than fit: the rest behind a button at the end", toolbar.overflowing(&t, tb) == 1 && shown > 0 &&
          shown < 6 && mr.x + mr.w <= 150.01 && mr.w > 0.0);
    let is math.rect.Rect as gone = layout.window_rect(&t, items[5]);
    check("those past it not there", router.hit(&t, 75.0, gone.y + gone.h / 2.0) != items[5] && gone.x >= 150.0 &&
          layout.window_rect(&t, items[shown - 1]).x + layout.window_rect(&t, items[shown - 1]).w <= mr.x + 0.01);
    // Its menu: the rest, a toggle's as it stands.
    button.set_active(&t, items[3], 1);
    click(&t, &r, mr.x + mr.w / 2.0, mr.y + mr.h / 2.0, 10);
    let is i64 as m = toolbar.overflow_menu(&t, tb);
    check("its menu open, the rest in it", menu.is_open(&t, m) == 1 && tree.child_count(&t, m) == 6 - shown);
    let is i64 as four with mut = 0;
    let is i64 as mc with mut = tree.first_child(&t, m);
    while (mc != 0) {
        if (menu.id_of(&t, mc) == 3) { four = mc; }
        mc = tree.next_sibling(&t, mc);
    }
    check("a toggle there as it stands", four != 0 && menu.checked(&t, four) == 1);
    let is i64 as last_mi = tree.last_child(&t, m);
    check("each by its tool's title", same(label.text(&t, menu.item_label(&t, last_mi)), label.text_length(&t, menu.item_label(&t, last_mi)), "Six") == 1);
    // Five, chosen from it: as if clicked.
    clicks = 0;
    let is i64 as k with mut = shown;
    while (k <= 4) {
        key(&t, &r, keys.DOWN, 0, 20 + k);
        k = k + 1;
    }
    key(&t, &r, keys.RETURN, 0, 40);
    check("one chosen from it: as if clicked", clicks == 1 && last_clicked == items[4] && menu.is_open(&t, m) == 0);
    // Reached by keyboard: past the last tool in the row, its menu button.
    router.focus(&t, &r, items[0], 1);
    caught = 0;
    key(&t, &r, keys.END, 0, 50);
    check("end with tools out of the row: the menu button", router.focused(&t, &r) == toolbar.more(&t, tb) && caught == 0);
    check("it the only stop", tree.is_focusable(&t, items[shown]) == 0 && tree.is_focusable(&t, items[0]) == 0);
    key(&t, &r, keys.LEFT, 0, 60);
    check("left from it: the last tool in the row", router.focused(&t, &r) == items[shown - 1]);
    key(&t, &r, keys.RIGHT, 0, 70);
    tree.set_enabled(&t, items[5], 0);
    key(&t, &r, keys.DOWN, 0, 80);
    check("down on it: its menu, the first chosen", menu.is_open(&t, m) == 1 && toolbar.overflow_menu(&t, tb) == m &&
          menu.current(&t, m) != 0);
    let is i64 as six = tree.last_child(&t, m);
    check("a tool disabled: so in its menu", tree.is_enabled_here(&t, six) == 0);
    key(&t, &r, keys.ESCAPE, 0, 90);
    tree.set_enabled(&t, items[5], 1);
    check("pressed by assistive technology: its menu", access.act(&t, toolbar.more(&t, tb), access.PRESS, 0.0) == 1 &&
          menu.is_open(&t, m) == 1);
    key(&t, &r, keys.ESCAPE, 0, 100);
    caught = 0;
    router.focus(&t, &r, items[0], 1);
    key(&t, &r, keys.X, 0, 110);
    key(&t, &r, keys.RIGHT, keys.MOD_CONTROL, 120);
    check("keys it has no use for: on up", caught == 2);
    key(&t, &r, keys.HOME, 0, 124);
    caught = 0;
    key(&t, &r, keys.LEFT, 0, 125);
    check("left at the first: still its own", router.focused(&t, &r) == items[0] && caught == 0);
    caught = 0;
    click(&t, &r, mr.x + mr.w / 2.0, mr.y + mr.h / 2.0, 126);
    check("its menu button pressed: its own", menu.is_open(&t, m) == 1 && caught == 0);
    key(&t, &r, keys.ESCAPE, 0, 127);
    router.focus(&t, &r, items[0], 1);
    key(&t, &r, keys.END, 0, 128);
    caught = 0;
    router.key(&t, &r, keys.DOWN, 0, 1, 0, 129);
    check("down on it: its menu as the key goes down, the key its own", menu.is_open(&t, m) == 1 && caught == 0);
    router.key(&t, &r, keys.DOWN, 0, 0, 0, 130);
    key(&t, &r, keys.ESCAPE, 0, 131);
    router.pointer_button(&t, &r, 3, 1, mr.x + mr.w / 2.0, mr.y + mr.h / 2.0, 130);
    router.pointer_button(&t, &r, 3, 0, mr.x + mr.w / 2.0, mr.y + mr.h / 2.0, 140);
    check("the right button on its menu button: no menu", menu.is_open(&t, m) == 0);
    key(&t, &r, keys.ESCAPE, 0, 150);
    // Room for them all: no menu button.
    layout.set_min_size(&t, tb, 390.0, 0.0);
    layout.set_max_size(&t, tb, 390.0, 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("room for all: no menu button", toolbar.overflowing(&t, tb) == 0 && toolbar.shown(&t, tb) == 6 &&
          layout.window_rect(&t, items[5]).x < 390.0 && tree.is_visible(&t, toolbar.more(&t, tb)) == 0);
    // The stop at the end, then out of the row: back into it.
    router.focus(&t, &r, items[0], 1);
    key(&t, &r, keys.END, 0, 50);
    check("end: the last the stop", tree.is_focusable(&t, items[5]) == 1);
    layout.set_min_size(&t, tb, 150.0, 0.0);
    layout.set_max_size(&t, tb, 150.0, 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is i64 as kept = toolbar.shown(&t, tb) - 1;
    check("out of the row: the last still in it the stop", tree.is_focusable(&t, items[5]) == 0 &&
          tree.is_focusable(&t, items[kept]) == 1);
    // The stop on the first tool out of the row; then only one left in it.
    layout.set_min_size(&t, tb, 390.0, 0.0);
    layout.set_max_size(&t, tb, 390.0, 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    router.focus(&t, &r, items[kept], 1);
    key(&t, &r, keys.RIGHT, 0, 200);
    layout.set_min_size(&t, tb, 150.0, 0.0);
    layout.set_max_size(&t, tb, 150.0, 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("the stop on the first tool out of the row: back into it", tree.is_focusable(&t, items[kept + 1]) == 0 &&
          tree.is_focusable(&t, items[kept]) == 1);
    let is f64 as one_w = layout.window_rect(&t, items[0]).w + layout.window_rect(&t, toolbar.more(&t, tb)).w + 1.0;
    layout.set_min_size(&t, tb, one_w, 0.0);
    layout.set_max_size(&t, tb, one_w, 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("one tool left in the row: it the stop", toolbar.shown(&t, tb) == 1 && tree.is_focusable(&t, items[0]) == 1);
    // None in the row: its menu button the stop.
    let is f64 as none_w = layout.window_rect(&t, toolbar.more(&t, tb)).w + 1.0;
    layout.set_min_size(&t, tb, none_w, 0.0);
    layout.set_max_size(&t, tb, none_w, 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("none in the row: its menu button the stop", toolbar.shown(&t, tb) == 0 &&
          tree.is_focusable(&t, items[0]) == 0 && tree.is_focusable(&t, toolbar.more(&t, tb)) == 1);
    layout.set_min_size(&t, tb, one_w, 0.0);
    layout.set_max_size(&t, tb, one_w, 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("one back in the row: still one stop", tree.is_focusable(&t, items[0]) == 0 &&
          tree.is_focusable(&t, toolbar.more(&t, tb)) == 1);
    // Just too wide by a pixel: the menu button.
    let is f64 as all_w = layout.window_rect(&t, items[0]).w + layout.window_rect(&t, items[1]).w + 70.0;
    tree.destroy(&t, items[5]);
    tree.destroy(&t, items[4]);
    tree.destroy(&t, items[3]);
    tree.destroy(&t, items[2]);
    layout.set_min_size(&t, tb, 10.0, 0.0);
    layout.set_max_size(&t, tb, 1000.0, 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is f64 as both = layout.window_rect(&t, items[0]).w + layout.window_rect(&t, items[1]).w;
    layout.set_min_size(&t, tb, both - 1.0, 0.0);
    layout.set_max_size(&t, tb, both - 1.0, 100.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("a pixel too narrow for them: the menu button", toolbar.overflowing(&t, tb) == 1 && all_w > 0.0);
    // Gone: its menu with it.
    let is i64 as gone_menu = toolbar.overflow_menu(&t, tb);
    tree.destroy(&t, tb);
    check("destroyed: its menu with it", tree.is_valid(&t, gone_menu) == 0);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as tb = toolbar.create(&t, tree.root(&t));
    toolbar.add_button(&t, tb, "One", 3);
    let is tree.Access as q;
    access.describe(&t, &r, tb, &q);
    check("told: a tool bar, across", q.role == access.ROLE_TOOL_BAR && (q.states & access.HORIZONTAL) != 0);
    check("not a toolbar: nothing", toolbar.count(&t, tree.root(&t)) == 0 && toolbar.add_button(&t, tree.root(&t), "x", 1) == 0 &&
          toolbar.item(&t, tb, 5) == 0);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    rowed();
    nested();
    overflowing();
    placed();
    drawn(&c);
    told();

    if (fails == 0) {
        io.printf("toolbar: %d checks passed\n", checks);
        return 0;
    }
    io.printf("toolbar: %d of %d checks failed\n", fails, checks);
    return 1;
}
