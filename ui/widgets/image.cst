// ui/widgets/image.cst — a picture: a texture of the program's.
//
// The program owns the texture and says how big it is in logical pixels; the
// image draws it at that size, centred in what it is given, or scaled to fit
// keeping its proportions. A symbolic image — an icon of one colour, drawn
// white on transparency — takes the colour it is given by what holds it (a
// button's text colour, painter.fg), else the theme's text colour, the way
// GTK recolours symbolic icons. Disabled, it fades as the theme fades
// controls, unless it was given a colour, which its giver has faded already.
use "../../math/math.cst" as math;
use "../../render/draw2d.cst" as draw2d;
use "../tree.cst" as tree;
use "../widget.cst" as widget;
use "../geom.cst" as geom;
use "../layout.cst" as layout;
use "../painter.cst" as painter;
use "../style.cst" as style;
use "../access.cst" as access;

struct Data {
    tex      as i64;    // the program's; 0 for none
    w        as f64;    // its size, logical pixels
    h        as f64;
    desc     as *u8;    // what it shows, for assistive technology; the program's
    desc_n   as i64;
    fit      as i32;    // scaled to fit what it is given
    symbolic as i32;    // drawn in the colour it is given
    smooth   as i32;    // filtered when scaled
    premul   as i32;    // its colours already carry their alpha
}

let is tree.Kind as _kind with mut;
let is i32 as _ready with mut = 0;

fn _init() as void {
    if (_ready == 1) { return; }
    _kind = widget.kind("image", sizeof(Data));
    _kind.measure = fn_ptr(_measure);
    _kind.paint = fn_ptr(_paint);
    _kind.role = access.ROLE_IMAGE;
    _kind.access = fn_ptr(_access);
    _ready = 1;
}

fn kind() as *tree.Kind {
    _init();
    return &_kind;
}

// A new image of texture tex, w by h logical pixels, as the last child of
// parent. Its handle, or 0 with the tree's last_error set.
fn create(t as *tree.Tree, parent as i64, tex as i64, w as f64, h as f64) as i64 {
    _init();
    let is i64 as im = tree.create(t, &_kind, parent);
    if (im == 0) { return 0; }
    let is *Data as d = cast(*Data, tree.data(t, im));
    d.tex = tex;
    d.w = w;
    d.h = h;
    d.smooth = 1;
    return im;
}

fn _data(t as *tree.Tree, w as i64) as *Data {
    if (tree.is_valid(t, w) == 0 || cast(i64, tree.kind(t, w)) != cast(i64, &_kind)) { return cast(*Data, 0); }
    return cast(*Data, tree.data(t, w));
}

// Another texture, of w by h; 0 for none. Each setter returns 1, or 0 for a
// widget that is no image.
fn set_image(t as *tree.Tree, im as i64, tex as i64, w as f64, h as f64) as i32 {
    let is *Data as d = _data(t, im);
    if (cast(i64, d) == 0) { return 0; }
    d.tex = tex;
    d.w = w;
    d.h = h;
    widget.changed(t, im, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    return 1;
}

// Scaled to fit what it is given, keeping its proportions; else at its size.
fn set_fit(t as *tree.Tree, im as i64, on as i32) as i32 {
    let is *Data as d = _data(t, im);
    if (cast(i64, d) == 0) { return 0; }
    d.fit = on;
    widget.changed(t, im, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    return 1;
}

fn set_symbolic(t as *tree.Tree, im as i64, on as i32) as i32 {
    let is *Data as d = _data(t, im);
    if (cast(i64, d) == 0) { return 0; }
    d.symbolic = on;
    widget.changed(t, im, widget.CHANGED_PAINT);
    return 1;
}

// Filtered between texels when scaled (the default), or the nearest taken —
// pixel art.
fn set_smooth(t as *tree.Tree, im as i64, on as i32) as i32 {
    let is *Data as d = _data(t, im);
    if (cast(i64, d) == 0) { return 0; }
    d.smooth = on;
    widget.changed(t, im, widget.CHANGED_PAINT);
    return 1;
}

// Its texture's colours already carry their alpha.
fn set_premultiplied(t as *tree.Tree, im as i64, on as i32) as i32 {
    let is *Data as d = _data(t, im);
    if (cast(i64, d) == 0) { return 0; }
    d.premul = on;
    widget.changed(t, im, widget.CHANGED_PAINT);
    return 1;
}

// What it shows, said to assistive technology: n bytes of UTF-8 the program
// keeps alive.
fn set_description(t as *tree.Tree, im as i64, s as *u8, n as i64) as i32 {
    let is *Data as d = _data(t, im);
    if (cast(i64, d) == 0) { return 0; }
    d.desc = s;
    d.desc_n = n;
    return 1;
}

fn _measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Data as d = cast(*Data, data);
    geom.size_zero(out);
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
    if (d.tex == 0 || d.w <= 0.0 || d.h <= 0.0) { return; }
    out.pref_w = d.w;
    out.pref_h = d.h;
    if (d.fit == 0) {
        out.min_w = d.w;
        out.min_h = d.h;
    } else if (c.w < d.w) {
        // Narrower: shorter in proportion.
        out.pref_h = d.h * c.w / d.w;
    }
}

fn _paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Data as d = cast(*Data, data);
    if (d.tex == 0 || d.w <= 0.0 || d.h <= 0.0) { return; }
    let is f64 as k with mut = 1.0;
    if (d.fit == 1) {
        k = p.rect.w / d.w;
        if (p.rect.h / d.h < k) { k = p.rect.h / d.h; }
    }
    let is f64 as dw = d.w * k;
    let is f64 as dh = d.h * k;
    let is f64 as x = p.rect.x + (p.rect.w - dw) / 2.0;
    let is f64 as y = p.rect.y + (p.rect.h - dh) / 2.0;
    let is math.color.Color as tint with mut = math.color.white();
    let is i32 as given = cast(i32, p.fg.a > 0.0);
    if (d.symbolic == 1) {
        tint = p.theme.palette.fg;
        if (given == 1) { tint = p.fg; }
    }
    if (given == 0 || d.symbolic == 0) {
        if (painter.has(p, painter.S_DISABLED) == 1) {
            tint = style.with_alpha(tint, tint.a * p.theme.control.disabled_alpha);
        }
    }
    if (d.premul == 1) {
        let is f64 as a = tint.a;
        draw2d.image_premultiplied(p.canvas, d.tex, d.smooth, x, y, dw, dh, 0.0, 0.0, 1.0, 1.0,
                                   math.color.rgba(tint.r * a, tint.g * a, tint.b * a, a));
    } else {
        draw2d.image(p.canvas, d.tex, d.smooth, x, y, dw, dh, 0.0, 0.0, 1.0, 1.0, tint);
    }
}

fn _access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Data as d = cast(*Data, data);
    if (q.action != access.ASK) { return 0; }
    if (cast(i64, d.desc) != 0) { access.set_name(q, d.desc, d.desc_n); }
    return 1;
}
