// ui/geom.cst — the sizes layout trades in, and what each widget carries for it.
//
// Its own module because both tree.cst (which stores an Item per node) and
// layout.cst (which reads and writes them) need these types, and the tree must
// not import layout.
//
// Everything is in logical pixels, as f64. Sizes are measured in them as they
// are; layout.place rounds the edges it hands out to the window's physical
// pixel grid (layout.set_scale), so what is drawn is crisp at any scale.
use "../math/math.cst" as math;

// "No limit", for a constraint nothing bounds and for a size that may grow
// without end. Large rather than infinite so sums of it stay ordinary numbers.
// layout.UNBOUNDED is the same value.
let is f64 as UNBOUNDED with imut = 1000000000000000000000000000000.0;

// What a widget reports when measured: the least it can be, what it would
// like, and the most it can use. Outer sizes — margins included — whenever
// layout.measure is the one answering.
struct Size {
    min_w  as f64;
    min_h  as f64;
    pref_w as f64;
    pref_h as f64;
    max_w  as f64;
    max_h  as f64;
}

// The room on offer while measuring. UNBOUNDED in an axis means the widget is
// asked for its natural size there — a scroll area's content is measured that
// way, and so is a box's main axis before space is distributed.
struct Constraint {
    w as f64;
    h as f64;
}

// What layout keeps for each widget: the properties the program sets and the
// results layout computes. Zeroed means FILL, inheriting direction, no
// stretch, no margin and no minimum; item_default() sets the rest.
struct Item {
    margin_l as f64;
    margin_t as f64;
    margin_r as f64;
    margin_b as f64;
    min_w    as f64;     // raises the kind's minimum; 0 is none
    min_h    as f64;
    max_w    as f64;     // lowers the kind's maximum; UNBOUNDED is none
    max_h    as f64;
    hstretch as f64;     // share of spare room a container hands out
    vstretch as f64;
    rect     as math.rect.Rect;   // arranged, relative to the parent's rect
    cache    as Size;             // the last measure, outer
    cache_c  as Constraint;       // and the constraint it answered
    align_h  as i32;
    align_v  as i32;
    dir      as i32;
    cache_ok as i32;
    row      as i32;     // grid cell
    col      as i32;
    row_span as i32;
    col_span as i32;
}

fn size_zero(s as *Size) as void {
    s.min_w = 0.0;
    s.min_h = 0.0;
    s.pref_w = 0.0;
    s.pref_h = 0.0;
    s.max_w = 0.0;
    s.max_h = 0.0;
}

fn constraint(w as f64, h as f64) as Constraint {
    let is Constraint as c;
    c.w = w;
    c.h = h;
    return c;
}

fn unbounded() as Constraint { return constraint(UNBOUNDED, UNBOUNDED); }

fn item_default() as Item {
    let is Item as it;
    it.margin_l = 0.0;
    it.margin_t = 0.0;
    it.margin_r = 0.0;
    it.margin_b = 0.0;
    it.min_w = 0.0;
    it.min_h = 0.0;
    it.max_w = UNBOUNDED;
    it.max_h = UNBOUNDED;
    it.hstretch = 0.0;
    it.vstretch = 0.0;
    it.rect = math.rect.rect_zero();
    size_zero(&it.cache);
    it.cache_c = constraint(0.0, 0.0);
    it.align_h = 0;
    it.align_v = 0;
    it.dir = 0;
    it.cache_ok = 0;
    it.row = 0;
    it.col = 0;
    it.row_span = 1;
    it.col_span = 1;
    return it;
}
