// ui/textbuf.cst — the text an entry or a text view edits.
//
// A gap buffer: the text in one block with a gap where the last edit was, so
// typing in one place costs nothing and moving the gap costs only the bytes
// between. Any range can be had in one piece (span) for laying out — the gap
// moves out of it only when it is inside — and read out anywhere.
//
// Paragraphs are indexed: the offset each one starts at, and the character
// it starts at, kept through every edit, so a text view finds the paragraph
// of an offset by a search and lays out only those it shows, and a byte
// offset and a character's are had one from the other within a paragraph —
// not from the start of the text. A character starts at every byte that does
// not continue one. Line ends come in as line feeds: CR LF and a lone CR are
// made one LF on the way in (added says how many bytes went in).
//
// Whoever listens is told every edit as it happens (set_listener): bytes put
// in, once they are in, and bytes taken out, before they go — for an
// assistive technology to be told what changed without reading the text.
//
// Undo and redo go by the steps a person would undo by: a run of typing is
// one — a word's start breaks it, so is the caret moving (break_group) — a
// run of backspaces or of deletes forward is one, a paste, a replacement and
// a move each one. Each step puts the caret back where it belongs (caret). The
// plain edits, insert and delete, are a program setting text: they are not
// remembered, and they forget what was, whose places they move.
use "std/mem.cst" as mem;

// An edit told to the listener: listen(user, what, at, bytes, n).
let is i32 as INSERTED with imut = 1;
let is i32 as DELETED  with imut = 2;

type EditFn = fn(*u8, i32, i64, *u8, i64) as void;

// What a step is, to know what joins it.
let is i64 as _TYPING   with imut = 1;
let is i64 as _BACK     with imut = 2;   // backspaces: each before the last
let is i64 as _FORWARD  with imut = 3;   // deletes forward: each where the last was
let is i64 as _OTHER    with imut = 4;   // a paste, a replacement: alone

// One edit: at at, del bytes taken out and ins put in, both kept in the
// store at their offsets.
struct Rec {
    at      as i64;
    del_off as i64;
    del_n   as i64;
    ins_off as i64;
    ins_n   as i64;
}

// A step: its edits, its kind, and where the caret goes undoing and redoing
// it.
struct Group {
    first     as i64;   // records
    last      as i64;
    kind      as i64;
    caret_un  as i64;
    caret_re  as i64;
}

struct Buf {
    block    as *u8;
    cap      as i64;
    gap_at   as i64;
    gap_len  as i64;
    len      as i64;
    added    as i64;   // what the last insertion put in, line ends made LF
    paras    as *i64;  // each paragraph's start
    pchars   as *i64;  // and the character it starts at
    npara    as i64;
    para_cap as i64;
    nchars   as i64;   // characters in all
    listen   as EditFn;
    listen_user as *u8;
    recs     as *Rec;
    nrec     as i64;
    rec_cap  as i64;
    groups   as *Group;
    ngroup   as i64;   // undone ones stay past done, for redoing
    done     as i64;   // groups done; below ngroup, some can be redone
    group_cap as i64;
    store    as *u8;   // the bytes edits took out and put in
    nstore   as i64;
    store_cap as i64;
    open_grp as i32;   // the last group may be joined
    ch_on    as i32;   // something changed since take_change last said
    caret_at as i64;   // where the caret goes after an undo or redo
    ch_lo    as i64;   // what changed: from here, nothing before it moved
    ch_hi    as i64;   // to here, as the text is now
    ch_len0  as i64;   // its length before
}

fn _grow(p as *u8, used as i64, cap as i64, want as i64, out_cap as *i64) as *u8 {
    if (want <= cap) {
        *out_cap = cap;
        return p;
    }
    let is i64 as c with mut = cap * 2;
    if (c < 4096) { c = 4096; }
    while (c < want) { c = c * 2; }
    let is *u8 as q = mem.core.mmap_anon(c);
    if (cast(i64, q) <= 0) {
        *out_cap = cap;
        return cast(*u8, 0);
    }
    if (used > 0) { mem.memcpy(q, p, used); }
    if (cap > 0) { mem.core.munmap(p, cap); }
    *out_cap = c;
    return q;
}

fn open() as Buf {
    let is Buf as b;
    mem.memset(cast(*u8, &b), 0, sizeof(Buf));
    let is i64 as c with mut = 0;
    b.paras = cast(*i64, _grow(cast(*u8, 0), 0, 0, 8 * 64, &c));
    b.pchars = cast(*i64, _grow(cast(*u8, 0), 0, 0, c, &c));
    b.para_cap = c / 8;
    b.paras[0] = 0;
    b.pchars[0] = 0;
    b.npara = 1;
    return b;
}

fn close(b as *Buf) as void {
    if (b.cap > 0) { mem.core.munmap(b.block, b.cap); }
    if (b.para_cap > 0) {
        mem.core.munmap(cast(*u8, b.paras), b.para_cap * 8);
        mem.core.munmap(cast(*u8, b.pchars), b.para_cap * 8);
    }
    if (b.rec_cap > 0) { mem.core.munmap(cast(*u8, b.recs), b.rec_cap * sizeof(Rec)); }
    if (b.group_cap > 0) { mem.core.munmap(cast(*u8, b.groups), b.group_cap * sizeof(Group)); }
    if (b.store_cap > 0) { mem.core.munmap(b.store, b.store_cap); }
    mem.memset(cast(*u8, b), 0, sizeof(Buf));
}

fn length(b as *Buf) as i64 { return b.len; }

// How many characters it holds.
fn chars(b as *Buf) as i64 { return b.nchars; }

// Who is told every edit, with user; null for nobody.
fn set_listener(b as *Buf, cb as EditFn, user as *u8) as void {
    b.listen = cb;
    b.listen_user = user;
}
fn added(b as *Buf) as i64 { return b.added; }

// --- The gap ---

// --- What changed ---

// An edit at at, del bytes out and ins in, joined to what changed before:
// one span over both, as the text is now.
fn _note(b as *Buf, at as i64, del as i64, ins as i64) as void {
    if (b.ch_on == 0) {
        b.ch_on = 1;
        b.ch_lo = at;
        b.ch_hi = at + ins;
        b.ch_len0 = b.len + del - ins;
        return;
    }
    if (b.ch_hi <= at) {
        b.ch_hi = at + ins;
    } else if (b.ch_hi >= at + del) {
        b.ch_hi = b.ch_hi - del + ins;
    } else {
        b.ch_hi = at + ins;
    }
    if (at < b.ch_lo) { b.ch_lo = at; }
}

// What changed since the last time it was asked, for a view of the text to
// lay out again only that: from *lo — nothing before it moved — to *hi, as
// the text is now, which is *delta bytes longer than it was. 1, or 0 when
// nothing changed.
fn take_change(b as *Buf, lo as *i64, hi as *i64, delta as *i64) as i32 {
    if (b.ch_on == 0) { return 0; }
    *lo = b.ch_lo;
    *hi = b.ch_hi;
    *delta = b.len - b.ch_len0;
    b.ch_on = 0;
    return 1;
}

// The gap moved to at.
fn _move_gap(b as *Buf, at as i64) as void {
    if (at == b.gap_at) { return; }
    if (at < b.gap_at) {
        // The bytes at .. gap_at go to the gap's far end.
        let is i64 as n = b.gap_at - at;
        let is i64 as i with mut = n - 1;
        while (i >= 0) {
            b.block[at + b.gap_len + i] = b.block[at + i];
            i = i - 1;
        }
    } else {
        let is i64 as n = at - b.gap_at;
        let is i64 as i with mut = 0;
        while (i < n) {
            b.block[b.gap_at + i] = b.block[b.gap_at + b.gap_len + i];
            i = i + 1;
        }
    }
    b.gap_at = at;
}

// Room in the gap for n more bytes: 1, or 0 when memory is refused.
fn _room(b as *Buf, n as i64) as i32 {
    if (b.gap_len >= n) { return 1; }
    let is i64 as want = b.len + n + 64;
    let is i64 as c with mut = b.cap * 2;
    if (c < 256) { c = 256; }
    while (c < want) { c = c * 2; }
    let is *u8 as q = mem.core.mmap_anon(c);
    if (cast(i64, q) <= 0) { return 0; }
    // Before the gap, then after it, at the new block's end.
    if (b.gap_at > 0) { mem.memcpy(q, b.block, b.gap_at); }
    let is i64 as tail = b.len - b.gap_at;
    if (tail > 0) { mem.memcpy(cast(*u8, cast(i64, q) + c - tail), cast(*u8, cast(i64, b.block) + b.gap_at + b.gap_len), tail); }
    if (b.cap > 0) { mem.core.munmap(b.block, b.cap); }
    b.block = q;
    b.gap_len = c - b.len;
    b.cap = c;
    return 1;
}

// The byte at offset i, -1 past the text.
fn byte_at(b as *Buf, i as i64) as i64 {
    if (i < 0 || i >= b.len) { return 0 - 1; }
    if (i < b.gap_at) { return cast(i64, b.block[i]); }
    return cast(i64, b.block[i + b.gap_len]);
}

// n bytes from at into out.
fn read(b as *Buf, at as i64, n as i64, out as *u8) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        out[i] = cast(u8, byte_at(b, at + i));
        i = i + 1;
    }
}

// n bytes from at, in one piece, until the next edit; the gap moved away
// only when it is inside them.
fn span(b as *Buf, at as i64, n as i64) as *u8 {
    if (at < b.gap_at && at + n > b.gap_at) { _move_gap(b, at + n); }
    if (at < b.gap_at) { return cast(*u8, cast(i64, b.block) + at); }
    return cast(*u8, cast(i64, b.block) + at + b.gap_len);
}

// --- Paragraphs ---

fn paragraphs(b as *Buf) as i64 { return b.npara; }

fn para_start(b as *Buf, i as i64) as i64 { return b.paras[i]; }

// Where paragraph i ends, its line feed left out.
fn para_end(b as *Buf, i as i64) as i64 {
    if (i + 1 < b.npara) { return b.paras[i + 1] - 1; }
    return b.len;
}

// The paragraph offset at is in; a line feed is its paragraph's.
fn para_of(b as *Buf, at as i64) as i64 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = b.npara - 1;
    while (lo < hi) {
        let is i64 as mid = (lo + hi + 1) / 2;
        if (b.paras[mid] <= at) { lo = mid; } else { hi = mid - 1; }
    }
    return lo;
}

// Paragraphs from paragraph from on moved by by bytes and chs characters.
fn _shift(b as *Buf, from as i64, by as i64, chs as i64) as void {
    let is i64 as i with mut = from;
    while (i < b.npara) {
        b.paras[i] = b.paras[i] + by;
        b.pchars[i] = b.pchars[i] + chs;
        i = i + 1;
    }
}

fn _add_para(b as *Buf, i as i64, start as i64, ch as i64) as i32 {
    if (b.npara >= b.para_cap) {
        // Both arrays grown together, or neither.
        let is i64 as c with mut = b.para_cap * 2;
        if (c < 64) { c = 64; }
        let is *u8 as q = mem.core.mmap_anon(c * 8);
        let is *u8 as q2 = mem.core.mmap_anon(c * 8);
        if (cast(i64, q) <= 0 || cast(i64, q2) <= 0) {
            if (cast(i64, q) > 0) { mem.core.munmap(q, c * 8); }
            if (cast(i64, q2) > 0) { mem.core.munmap(q2, c * 8); }
            return 0;
        }
        mem.memcpy(q, cast(*u8, b.paras), b.npara * 8);
        mem.memcpy(q2, cast(*u8, b.pchars), b.npara * 8);
        mem.core.munmap(cast(*u8, b.paras), b.para_cap * 8);
        mem.core.munmap(cast(*u8, b.pchars), b.para_cap * 8);
        b.paras = cast(*i64, q);
        b.pchars = cast(*i64, q2);
        b.para_cap = c;
    }
    let is i64 as k with mut = b.npara;
    while (k > i) {
        b.paras[k] = b.paras[k - 1];
        b.pchars[k] = b.pchars[k - 1];
        k = k - 1;
    }
    b.paras[i] = start;
    b.pchars[i] = ch;
    b.npara = b.npara + 1;
    return 1;
}

fn _starts(c as i64) as i32 { return cast(i32, (c & 192) != 128); }

// The characters before offset at: its paragraph's, then those from its
// start.
fn char_of(b as *Buf, at as i64) as i64 {
    if (at <= 0) { return 0; }
    if (at >= b.len) { return b.nchars; }
    let is i64 as p = para_of(b, at);
    let is i64 as k with mut = b.pchars[p];
    let is i64 as i with mut = b.paras[p];
    while (i < at) {
        if (_starts(byte_at(b, i)) == 1) { k = k + 1; }
        i = i + 1;
    }
    return k;
}

// Where character k starts: found in its paragraph; the end past the last.
fn byte_of(b as *Buf, k as i64) as i64 {
    if (k <= 0) { return 0; }
    if (k >= b.nchars) { return b.len; }
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = b.npara - 1;
    while (lo < hi) {
        let is i64 as mid = (lo + hi + 1) / 2;
        if (b.pchars[mid] <= k) { lo = mid; } else { hi = mid - 1; }
    }
    let is i64 as c with mut = b.pchars[lo];
    let is i64 as i with mut = b.paras[lo];
    while (i < b.len) {
        if (_starts(byte_at(b, i)) == 1) {
            if (c == k) { return i; }
            c = c + 1;
        }
        i = i + 1;
    }
    return b.len;
}

// --- Plain edits ---

// s, n bytes, in at at — line ends made LF — the index kept: 1, or 0 for a
// place past the text or memory refused.
fn _insert(b as *Buf, at as i64, s as *u8, n as i64) as i32 {
    b.added = 0;
    if (at < 0 || at > b.len || n < 0) { return 0; }
    if (_room(b, n) == 0) { return 0; }
    // Where it goes, in characters, while the text before it is as it was.
    let is i64 as at_ch = char_of(b, at);
    _move_gap(b, at);
    let is i64 as p = para_of(b, at);
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    let is i64 as made with mut = 0;
    while (i < n) {
        let is u8 as c with mut = s[i];
        if (c == 13) {
            c = 10;
            if (i + 1 < n && s[i + 1] == 10) { i = i + 1; }
        }
        b.block[at + k] = c;
        k = k + 1;
        i = i + 1;
    }
    b.gap_at = at + k;
    b.gap_len = b.gap_len - k;
    b.len = b.len + k;
    b.added = k;
    if (k > 0) { _note(b, at, 0, k); }
    let is i64 as chs with mut = 0;
    i = 0;
    while (i < k) {
        if (_starts(cast(i64, b.block[at + i])) == 1) { chs = chs + 1; }
        i = i + 1;
    }
    b.nchars = b.nchars + chs;
    // The paragraphs after it move, and each line feed starts one.
    _shift(b, p + 1, k, chs);
    let is i64 as ch with mut = at_ch;
    i = 0;
    while (i < k) {
        if (_starts(cast(i64, b.block[at + i])) == 1) { ch = ch + 1; }
        if (b.block[at + i] == 10) {
            if (_add_para(b, p + 1 + made, at + i + 1, ch) == 0) { return 0; }
            made = made + 1;
        }
        i = i + 1;
    }
    if (k > 0 && cast(i64, b.listen) != 0) { call(b.listen, b.listen_user, INSERTED, at, cast(*u8, cast(i64, b.block) + at), k); }
    return 1;
}

// n bytes from at out, the index kept: 1, or 0 for a range past the text.
fn _delete(b as *Buf, at as i64, n as i64) as i32 {
    if (at < 0 || n < 0 || at + n > b.len) { return 0; }
    _move_gap(b, at);
    // What goes, right after the gap: told while it is still there.
    let is *u8 as gone = cast(*u8, cast(i64, b.block) + at + b.gap_len);
    if (n > 0 && cast(i64, b.listen) != 0) { call(b.listen, b.listen_user, DELETED, at, gone, n); }
    let is i64 as chs with mut = 0;
    let is i64 as j with mut = 0;
    while (j < n) {
        if (_starts(cast(i64, gone[j])) == 1) { chs = chs + 1; }
        j = j + 1;
    }
    b.gap_len = b.gap_len + n;
    b.len = b.len - n;
    b.nchars = b.nchars - chs;
    if (n > 0) { _note(b, at, n, 0); }
    // Paragraphs starting inside the range go; those after it move back.
    let is i64 as i with mut = 1;
    let is i64 as o with mut = 1;
    while (i < b.npara) {
        let is i64 as st = b.paras[i];
        let is i64 as sc = b.pchars[i];
        if (st > at && st <= at + n) {
            i = i + 1;
        } else {
            if (st > at + n) {
                b.paras[o] = st - n;
                b.pchars[o] = sc - chs;
            } else {
                b.paras[o] = st;
                b.pchars[o] = sc;
            }
            o = o + 1;
            i = i + 1;
        }
    }
    b.npara = o;
    return 1;
}

// The program's edits: not remembered, and forgetting what was.
fn insert(b as *Buf, at as i64, s as *u8, n as i64) as i32 {
    let is i32 as ok = _insert(b, at, s, n);
    if (ok == 1) { forget(b); }
    return ok;
}

fn delete(b as *Buf, at as i64, n as i64) as i32 {
    let is i32 as ok = _delete(b, at, n);
    if (ok == 1) { forget(b); }
    return ok;
}

// n bytes at at made s, m bytes.
fn replace(b as *Buf, at as i64, n as i64, s as *u8, m as i64) as i32 {
    if (_delete(b, at, n) == 0) { return 0; }
    let is i32 as ok = _insert(b, at, s, m);
    forget(b);
    return ok;
}

// --- What can be undone ---

// Nothing to undo or redo.
fn forget(b as *Buf) as void {
    b.nrec = 0;
    b.ngroup = 0;
    b.done = 0;
    b.nstore = 0;
    b.open_grp = 0;
}

fn can_undo(b as *Buf) as i32 { return cast(i32, b.done > 0); }
fn can_redo(b as *Buf) as i32 { return cast(i32, b.done < b.ngroup); }

// Where the caret goes, after the last undo or redo.
fn caret(b as *Buf) as i64 { return b.caret_at; }

// The next edit a step of its own: the caret moved, the selection changed.
fn break_group(b as *Buf) as void { b.open_grp = 0; }

// What could be redone, dropped: a new edit goes on from here.
fn _drop_redo(b as *Buf) as void {
    if (b.done >= b.ngroup) { return; }
    let is i64 as first = b.groups[b.done].first;
    b.nrec = first;
    if (first > 0) {
        let is *Rec as last = &b.recs[first - 1];
        b.nstore = last.ins_off + last.ins_n;
    } else {
        b.nstore = 0;
    }
    b.ngroup = b.done;
    b.open_grp = 0;
}

// The text at at, n bytes, kept in the store.
fn _keep_text(b as *Buf, at as i64, n as i64) as i64 {
    // Nothing to keep needs no store, which may not exist yet.
    if (n == 0) { return b.nstore; }
    let is i64 as c with mut = 0;
    let is *u8 as q = _grow(b.store, b.nstore, b.store_cap, b.nstore + n, &c);
    if (cast(i64, q) == 0) { return 0 - 1; }
    b.store = q;
    b.store_cap = c;
    let is i64 as off = b.nstore;
    read(b, at, n, cast(*u8, cast(i64, b.store) + off));
    b.nstore = b.nstore + n;
    return off;
}

fn _rec(b as *Buf) as *Rec {
    if (b.nrec >= b.rec_cap) {
        let is i64 as c with mut = 0;
        let is *u8 as q = _grow(cast(*u8, b.recs), b.nrec * sizeof(Rec), b.rec_cap * sizeof(Rec),
                               (b.nrec + 1) * sizeof(Rec), &c);
        if (cast(i64, q) == 0) { return cast(*Rec, 0); }
        b.recs = cast(*Rec, q);
        b.rec_cap = c / sizeof(Rec);
    }
    let is *Rec as r = &b.recs[b.nrec];
    b.nrec = b.nrec + 1;
    return r;
}

fn _group(b as *Buf, kind as i64) as *Group {
    if (b.ngroup >= b.group_cap) {
        let is i64 as c with mut = 0;
        let is *u8 as q = _grow(cast(*u8, b.groups), b.ngroup * sizeof(Group), b.group_cap * sizeof(Group),
                               (b.ngroup + 1) * sizeof(Group), &c);
        if (cast(i64, q) == 0) { return cast(*Group, 0); }
        b.groups = cast(*Group, q);
        b.group_cap = c / sizeof(Group);
    }
    let is *Group as g = &b.groups[b.ngroup];
    g.first = b.nrec;
    g.last = b.nrec;
    g.kind = kind;
    b.ngroup = b.ngroup + 1;
    b.done = b.ngroup;
    b.open_grp = 1;
    return g;
}

// The open group, when an edit of kind may join it.
fn _joinable(b as *Buf, kind as i64) as *Group {
    if (b.open_grp == 0 || b.done == 0 || b.done != b.ngroup) { return cast(*Group, 0); }
    let is *Group as g = &b.groups[b.done - 1];
    if (g.kind != kind) { return cast(*Group, 0); }
    return g;
}

fn _is_space(c as i64) as i32 { return cast(i32, c == 32 || c == 9 || c == 10); }

// Typed: s, n bytes, in at at — joining the typing before it when it goes on
// from where that ended and does not start a word.
fn type_in(b as *Buf, at as i64, s as *u8, n as i64) as i32 {
    _drop_redo(b);
    let is *Group as g with mut = _joinable(b, _TYPING);
    if (cast(i64, g) != 0) {
        let is *Rec as last = &b.recs[g.last];
        let is i64 as end = last.at + last.ins_n;
        let is i64 as before = byte_at(b, at - 1);
        if (at != end || n == 0 || (_is_space(before) == 1 && _is_space(cast(i64, s[0])) == 0)) {
            g = cast(*Group, 0);
        }
    }
    if (_insert(b, at, s, n) == 0) { return 0; }
    let is i64 as k = b.added;
    if (cast(i64, g) != 0) {
        let is *Rec as last = &b.recs[g.last];
        // Its bytes go on after the last's, at the store's end.
        if (_keep_text(b, at, k) < 0) { return 0; }
        last.ins_n = last.ins_n + k;
        g.caret_re = at + k;
        return 1;
    }
    g = _group(b, _TYPING);
    let is *Rec as r = _rec(b);
    if (cast(i64, g) == 0 || cast(i64, r) == 0) { return 0; }
    r.at = at;
    r.del_off = b.nstore;
    r.del_n = 0;
    r.ins_off = _keep_text(b, at, k);
    r.ins_n = k;
    g.first = b.nrec - 1;
    g.last = b.nrec - 1;
    g.caret_un = at;
    g.caret_re = at + k;
    return 1;
}

// Erased: n bytes from at — by Backspace when the caret was after them, by
// Delete when it was at at — joining a run of the same: backspaces each just
// before the last, deletes each where the last was. A run starts as
// backspaces, and a second erase at its first's place makes it deletes.
fn erase(b as *Buf, at as i64, n as i64) as i32 {
    if (at < 0 || n <= 0 || at + n > b.len) { return 0; }
    _drop_redo(b);
    let is *Group as g with mut = _joinable(b, _BACK);
    if (cast(i64, g) == 0) { g = _joinable(b, _FORWARD); }
    if (cast(i64, g) != 0) {
        let is *Rec as last = &b.recs[g.last];
        if (g.kind == _BACK && at + n == last.at) {
            // Backspacing on.
        } else if ((g.kind == _FORWARD || g.first == g.last) && at == last.at) {
            g.kind = _FORWARD;
            g.caret_un = at;
        } else {
            g = cast(*Group, 0);
        }
    }
    let is i64 as off = _keep_text(b, at, n);
    if (off < 0 || _delete(b, at, n) == 0) { return 0; }
    if (cast(i64, g) == 0) {
        g = _group(b, _BACK);
        if (cast(i64, g) == 0) { return 0; }
        g.caret_un = at + n;
    }
    let is *Rec as r = _rec(b);
    if (cast(i64, r) == 0) { return 0; }
    r.at = at;
    r.del_off = off;
    r.del_n = n;
    r.ins_off = b.nstore;
    r.ins_n = 0;
    g.last = b.nrec - 1;
    g.caret_re = at;
    return 1;
}

// Erased by Delete, known to be: n bytes from at, the caret at at — joining
// only deletes forward at the same place, so a backspace before it stays a
// step of its own and undoing it puts the caret back at at.
fn erase_ahead(b as *Buf, at as i64, n as i64) as i32 {
    if (at < 0 || n <= 0 || at + n > b.len) { return 0; }
    _drop_redo(b);
    let is *Group as g with mut = _joinable(b, _FORWARD);
    if (cast(i64, g) != 0 && b.recs[g.last].at != at) { g = cast(*Group, 0); }
    let is i64 as off = _keep_text(b, at, n);
    if (off < 0 || _delete(b, at, n) == 0) { return 0; }
    if (cast(i64, g) == 0) {
        g = _group(b, _FORWARD);
        if (cast(i64, g) == 0) { return 0; }
        g.caret_un = at;
    }
    let is *Rec as r = _rec(b);
    if (cast(i64, r) == 0) { return 0; }
    r.at = at;
    r.del_off = off;
    r.del_n = n;
    r.ins_off = b.nstore;
    r.ins_n = 0;
    g.last = b.nrec - 1;
    g.caret_re = at;
    return 1;
}

// n bytes at at moved to before offset to of the text as it was — a
// selection dragged — one step: undone, the caret at the bytes' old end;
// redone, at their new one. 1, or 0 for nothing to move, a place past the
// text, or one inside them or at their edges, where moving changes nothing.
fn move(b as *Buf, at as i64, n as i64, to as i64) as i32 {
    if (at < 0 || n <= 0 || at + n > b.len || to < 0 || to > b.len) { return 0; }
    if (to >= at && to <= at + n) { return 0; }
    _drop_redo(b);
    let is i64 as off = _keep_text(b, at, n);
    if (off < 0 || _delete(b, at, n) == 0) { return 0; }
    let is i64 as dest with mut = to;
    if (to > at) { dest = to - n; }
    if (_insert(b, dest, cast(*u8, cast(i64, b.store) + off), n) == 0) { return 0; }
    let is *Group as g = _group(b, _OTHER);
    let is *Rec as out = _rec(b);
    if (cast(i64, g) == 0 || cast(i64, out) == 0) { return 0; }
    out.at = at;
    out.del_off = off;
    out.del_n = n;
    out.ins_off = b.nstore;
    out.ins_n = 0;
    g.first = b.nrec - 1;
    let is *Rec as in = _rec(b);
    if (cast(i64, in) == 0) { return 0; }
    in.at = dest;
    in.del_off = b.nstore;
    in.del_n = 0;
    in.ins_off = off;
    in.ins_n = n;
    g.last = b.nrec - 1;
    g.caret_un = at + n;
    g.caret_re = dest + n;
    b.open_grp = 0;
    return 1;
}

// A change of its own: n bytes at at made s, m bytes — a paste, a
// replacement, what is typed over a selection.
fn change(b as *Buf, at as i64, n as i64, s as *u8, m as i64) as i32 {
    if (at < 0 || n < 0 || at + n > b.len) { return 0; }
    _drop_redo(b);
    let is i64 as off = _keep_text(b, at, n);
    if (off < 0 || _delete(b, at, n) == 0) { return 0; }
    if (_insert(b, at, s, m) == 0) { return 0; }
    let is i64 as k = b.added;
    let is *Group as g = _group(b, _OTHER);
    let is *Rec as r = _rec(b);
    if (cast(i64, g) == 0 || cast(i64, r) == 0) { return 0; }
    r.at = at;
    r.del_off = off;
    r.del_n = n;
    r.ins_off = _keep_text(b, at, k);
    r.ins_n = k;
    g.first = b.nrec - 1;
    g.last = b.nrec - 1;
    g.caret_un = at + n;
    g.caret_re = at + k;
    b.open_grp = 0;
    return 1;
}

// A paste: s, n bytes, in at at, a step of its own.
fn paste_in(b as *Buf, at as i64, s as *u8, n as i64) as i32 { return change(b, at, 0, s, n); }

// The last step undone: 1, or 0 for none.
fn undo(b as *Buf) as i32 {
    if (b.done == 0) { return 0; }
    let is *Group as g = &b.groups[b.done - 1];
    let is i64 as i with mut = g.last;
    while (i >= g.first) {
        let is *Rec as r = &b.recs[i];
        _delete(b, r.at, r.ins_n);
        _insert(b, r.at, cast(*u8, cast(i64, b.store) + r.del_off), r.del_n);
        i = i - 1;
    }
    b.done = b.done - 1;
    b.caret_at = g.caret_un;
    b.open_grp = 0;
    return 1;
}

// The last step undone, done again: 1, or 0 for none.
fn redo(b as *Buf) as i32 {
    if (b.done >= b.ngroup) { return 0; }
    let is *Group as g = &b.groups[b.done];
    let is i64 as i with mut = g.first;
    while (i <= g.last) {
        let is *Rec as r = &b.recs[i];
        _delete(b, r.at, r.del_n);
        _insert(b, r.at, cast(*u8, cast(i64, b.store) + r.ins_off), r.ins_n);
        i = i + 1;
    }
    b.done = b.done + 1;
    b.caret_at = g.caret_re;
    b.open_grp = 0;
    return 1;
}
