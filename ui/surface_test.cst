// ui/surface_test.cst — a widget on a layer put against a rectangle: inside
// the window, by the positioner within it, with no host; in a window of its
// own, where a stand-in host says the platform put it, with one. Either way
// placed again when what it is anchored to moves or its own size changes,
// and left alone when neither does.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "surface.cst" as surface;
use "../window/positioner.cst" as positioner;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn same(a as math.rect.Rect, b as math.rect.Rect) as i32 {
    return cast(i32, near(a.x, b.x) == 1 && near(a.y, b.y) == 1 && near(a.w, b.w) == 1 && near(a.h, b.h) == 1);
}

fn show(name as *u8, r as math.rect.Rect) as void {
    io.printf("  %s: %d %d %d %d\n", name, cast(i32, r.x), cast(i32, r.y), cast(i32, r.w), cast(i32, r.h));
}

struct Leaf {
    pref_w as f64;
    pref_h as f64;
}

fn leaf_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Leaf as d = cast(*Leaf, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = d.pref_w;
    out.pref_h = d.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn leaf_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        let is math.rect.Rect as area = math.rect.rect(0.0, 0.0, r.w, r.h);
        layout.place(t, ch, &area);
        ch = tree.next_sibling(t, ch);
    }
}

let is tree.Kind as leaf_kind with mut;

fn leaf(t as *tree.Tree, parent as i64, pw as f64, ph as f64) as i64 {
    let is i64 as w = tree.create(t, &leaf_kind, parent);
    let is *Leaf as d = cast(*Leaf, tree.data(t, w));
    d.pref_w = pw;
    d.pref_h = ph;
    return w;
}

fn resize(t as *tree.Tree, w as i64, pw as f64, ph as f64) as void {
    let is *Leaf as d = cast(*Leaf, tree.data(t, w));
    d.pref_w = pw;
    d.pref_h = ph;
    widget.changed(t, w, widget.CHANGED_LAYOUT);
}

// --- The stand-in host: a screen of 4000 by 4000, the window at 1000, 1000 ---

let is i64 as opens with mut = 0;
let is i64 as moves with mut = 0;
let is i64 as closes with mut = 0;

fn host(user as *u8, t as *tree.Tree, op as i32, s as i64) as i32 {
    if (op == tree.SURFACE_CLOSE) { closes = closes + 1; return 1; }
    if (op == tree.SURFACE_OPEN) { opens = opens + 1; }
    if (op == tree.SURFACE_MOVE) { moves = moves + 1; }
    let is positioner.Positioner as p with mut = tree.surface_place(t, s);
    tree.surface_set_rect(t, s, positioner.place(&p, math.rect.rect(0.0 - 1000.0, 0.0 - 1000.0, 4000.0, 4000.0)));
    return 1;
}


fn main() as i32 {
    leaf_kind = widget.kind("leaf", sizeof(Leaf));
    leaf_kind.measure = fn_ptr(leaf_measure);
    leaf_kind.arrange = fn_ptr(leaf_arrange);
    let is i32 as adjust = positioner.FLIP_X | positioner.FLIP_Y | positioner.SLIDE_X | positioner.SLIDE_Y | positioner.RESIZE_Y;

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is i64 as content = leaf(&t, root, 300.0, 200.0);
    let is i64 as button = leaf(&t, content, 40.0, 20.0);
    layout.set_align(&t, button, layout.START, layout.START);
    layout.set_margin(&t, button, 10.0, 10.0, 0.0, 0.0);
    let is i64 as pop = leaf(&t, root, 100.0, 80.0);
    tree.set_layer(&t, pop, 900);
    layout.run(&t, 300.0, 200.0);
    let is math.rect.Rect as br with mut = layout.window_rect(&t, button);

    // --- No host: inside the window, as the positioner places it there ---
    let is math.rect.Rect as at = surface.open(&t, pop, surface.LIST, 0, button, br, positioner.BOTTOM_LEFT,
                                               positioner.BOTTOM_RIGHT, adjust);
    check("below the button", same(at, math.rect.rect(10.0, 30.0, 100.0, 80.0)) == 1);
    check("not in a window of its own", surface.is_native(&t, pop) == 0);
    layout.run(&t, 300.0, 200.0);
    check("laid out there", same(layout.window_rect(&t, pop), at) == 1);
    check("where it is", same(surface.rect(&t, pop), at) == 1 && same(surface.anchor_rect(&t, pop), br) == 1);
    check("nothing moved: not placed again", surface.follow(&t) == 0);

    // Taller than the window's room below: flipped above? no room either —
    // slid and cut to the window.
    resize(&t, pop, 100.0, 300.0);
    check("grew: placed again", surface.follow(&t) == 1);
    check("where it went, before layout says so", same(surface.rect(&t, pop), math.rect.rect(10.0, 0.0, 100.0, 200.0)) == 1);
    layout.run(&t, 300.0, 200.0);
    check("cut to the window's height", same(layout.window_rect(&t, pop), math.rect.rect(10.0, 0.0, 100.0, 200.0)) == 1);
    check("then left alone", surface.follow(&t) == 0);
    resize(&t, pop, 100.0, 80.0);
    surface.follow(&t);
    layout.run(&t, 300.0, 200.0);

    // The button moves: the popup with it.
    layout.set_margin(&t, button, 150.0, 60.0, 0.0, 0.0);
    layout.run(&t, 300.0, 200.0);
    check("the anchor moved: placed again", surface.follow(&t) == 1);
    layout.run(&t, 300.0, 200.0);
    check("below where the button is now", same(layout.window_rect(&t, pop), math.rect.rect(150.0, 80.0, 100.0, 80.0)) == 1);
    check("and left alone after", surface.follow(&t) == 0);

    // Two placed against it: both follow it.
    let is i64 as pop_b = leaf(&t, root, 50.0, 30.0);
    tree.set_layer(&t, pop_b, 901);
    br = layout.window_rect(&t, button);
    surface.open(&t, pop_b, surface.LIST, 0, button, math.rect.rect(br.x, br.y, 10.0, 10.0), positioner.TOP_RIGHT,
                 positioner.BOTTOM_RIGHT, adjust);
    check("a second placed", tree.placed_entry(&t, pop_b) >= 0 && tree.placed_entry(&t, pop_b) != tree.placed_entry(&t, pop));
    layout.set_margin(&t, button, 140.0, 50.0, 0.0, 0.0);
    layout.run(&t, 300.0, 200.0);
    check("the anchor moved: both placed again", surface.follow(&t) == 2);
    layout.run(&t, 300.0, 200.0);
    check("the second where it is now", same(layout.window_rect(&t, pop_b), math.rect.rect(150.0, 50.0, 50.0, 30.0)) == 1);
    surface.close(&t, pop_b);
    tree.set_visible(&t, pop_b, 0);
    layout.set_margin(&t, button, 150.0, 60.0, 0.0, 0.0);
    layout.run(&t, 300.0, 200.0);
    surface.follow(&t);
    layout.run(&t, 300.0, 200.0);

    // A minimum of its own: what follow weighs is what open measured.
    layout.set_min_size(&t, pop, 120.0, 90.0);
    check("a minimum: placed again once", surface.follow(&t) == 1);
    check("then left alone", surface.follow(&t) == 0);
    layout.run(&t, 300.0, 200.0);
    check("at its minimum", near(layout.window_rect(&t, pop).w, 120.0) == 1 && near(layout.window_rect(&t, pop).h, 90.0) == 1);
    layout.set_min_size(&t, pop, 0.0, 0.0);
    surface.follow(&t);

    // Hidden: not followed.
    tree.set_visible(&t, pop, 0);
    layout.set_margin(&t, button, 20.0, 20.0, 0.0, 0.0);
    layout.run(&t, 300.0, 200.0);
    check("hidden: not placed again", surface.follow(&t) == 0);
    tree.set_visible(&t, pop, 1);
    check("shown again: placed again", surface.follow(&t) == 1);

    surface.close(&t, pop);
    check("closed: nothing to follow", tree.placed_entry(&t, pop) < 0 && surface.follow(&t) == 0);

    // Right to left: placed from the window's corner all the same.
    layout.set_direction(&t, pop, layout.RTL);
    let is math.rect.Rect as rtl = surface.open(&t, pop, surface.LIST, 0, 0, math.rect.rect(30.0, 40.0, 10.0, 10.0),
                                                positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, adjust);
    layout.run(&t, 300.0, 200.0);
    check("right to left: where it was put", same(layout.window_rect(&t, pop), rtl) == 1 &&
          same(rtl, math.rect.rect(30.0, 50.0, 100.0, 80.0)) == 1);
    surface.close(&t, pop);
    layout.set_direction(&t, pop, layout.INHERIT);

    // --- A host: in a window of its own, past the window's edges ---
    tree.set_surfaces(&t, fn_ptr(host), cast(*u8, 0));
    layout.set_margin(&t, button, 10.0, 180.0, 0.0, 0.0);
    layout.run(&t, 300.0, 200.0);
    br = layout.window_rect(&t, button);
    resize(&t, pop, 100.0, 300.0);
    let is math.rect.Rect as out = surface.open(&t, pop, surface.MENU, 1, button, br, positioner.BOTTOM_LEFT,
                                                positioner.BOTTOM_RIGHT, adjust);
    check("in a window of its own", surface.is_native(&t, pop) == 1 && opens == 1);
    check("below the button, past the window's bottom, whole", same(out, math.rect.rect(10.0, 200.0, 100.0, 300.0)) == 1);
    layout.run(&t, 300.0, 200.0);
    check("laid out there", same(layout.window_rect(&t, pop), out) == 1);
    check("where it is", same(surface.rect(&t, pop), out) == 1);
    check("nothing moved: not placed again", surface.follow(&t) == 0 && moves == 0);
    let is math.rect.Rect as in_r with mut = math.rect.rect_zero();
    surface.set_input(&t, pop, math.rect.rect(12.0, 202.0, 96.0, 296.0));
    check("where it takes the pointer, told its window", tree.surface_input(&t, tree.surface_index(&t, pop), &in_r) == 1 &&
          same(in_r, math.rect.rect(12.0, 202.0, 96.0, 296.0)) == 1);
    layout.set_margin(&t, button, 60.0, 180.0, 0.0, 0.0);
    layout.run(&t, 300.0, 200.0);
    check("the anchor moved: the host asked to place it again", surface.follow(&t) == 1 && moves == 1);
    layout.run(&t, 300.0, 200.0);
    check("there", same(layout.window_rect(&t, pop), math.rect.rect(60.0, 200.0, 100.0, 300.0)) == 1);
    resize(&t, pop, 140.0, 300.0);
    check("grew: placed again", surface.follow(&t) == 1 && moves == 2);
    layout.run(&t, 300.0, 200.0);
    check("at its new size", near(layout.window_rect(&t, pop).w, 140.0) == 1);
    check("then left alone", surface.follow(&t) == 0 && moves == 2);
    surface.close(&t, pop);
    check("closed: its window put away", closes == 1 && surface.is_native(&t, pop) == 0);

    check("no widget: nothing", same(surface.open(&t, 0, surface.MENU, 0, 0, br, 0, 0, 0), math.rect.rect_zero()) == 1);

    tree.close(&t);
    if (fails == 0) {
        io.printf("ui surface: all checks passed\n");
        return 0;
    }
    io.printf("ui surface: %d failures\n", fails);
    return 1;
}
