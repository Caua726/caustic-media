// ui/sortmodel_test.cst — a flat model's rows in the order of a column:
// text without regard to case, numbers as numbers, the SORT role first when
// there is one, equal rows as they came; the model's changes passed on where
// the rows now stand.
use "std/io.cst" as io;
use "model.cst" as model;
use "sortmodel.cst" as sortmodel;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

// --- Files: a name, a size, a day ---
//
// Row ids are slots; ids[] is the source order.
struct Files {
    n   as i64;
    ids as [128]i64;
}

let is Files as files with mut;
let is [64]i64 as sizes with mut;
let is [64]*u8 as names with mut;
let is [64]i64 as days with mut;   // 0 for none: the day column has no SORT then
let is model.Model as src with mut;

fn length(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn files_count(self as *u8, parent as i64) as i64 {
    if (parent != 0) { return 0; }
    return files.n;
}

fn files_row_id(self as *u8, parent as i64, index as i64) as i64 {
    if (parent != 0 || index < 0 || index >= files.n) { return 0; }
    return files.ids[index];
}

// Named so that their names sort another way than their numbers.
fn day_name(d as i64) as *u8 {
    if (d == 1) { return "Wednesday"; }
    if (d == 2) { return "Tuesday"; }
    if (d == 3) { return "Monday"; }
    return "Sunday";
}

fn files_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    if (column == 0 && role == model.TEXT) {
        *out = model.text(names[id], length(names[id]));
        return 1;
    }
    if (column == 1 && role == model.TEXT) {
        // No size at all for -1000; text for -2000.
        if (sizes[id] == 0 - 1000) { return 0; }
        if (sizes[id] == 0 - 2000) {
            *out = model.text("big", 3);
            return 1;
        }
        *out = model.integer(sizes[id]);
        return 1;
    }
    if (column == 2 && role == model.TEXT) {
        *out = model.text(day_name(days[id]), length(day_name(days[id])));
        return 1;
    }
    if (column == 2 && role == model.SORT && days[id] != 0) {
        *out = model.integer(days[id]);
        return 1;
    }
    return 0;
}

fn files_columns(self as *u8) as i64 { return 3; }

let is i64 as set_asked with mut = 0;

fn files_set_cell(self as *u8, id as i64, column as i64, role as i32, v as *model.Value) as i64 {
    set_asked = id;
    return 1;
}

fn put(id as i64, name as *u8, size as i64, day as i64) as void {
    names[id] = name;
    sizes[id] = size;
    days[id] = day;
}

//   id  name     size  day
//   1   pear       10  Wednesday
//   2   Apple       9  Monday
//   3   banana    100  Tuesday
//   4   apple       9  Monday
fn fill() as void {
    put(1, "pear", 10, 3);
    put(2, "Apple", 9, 1);
    put(3, "banana", 100, 2);
    put(4, "apple", 9, 1);
    files.n = 4;
    files.ids[0] = 1;
    files.ids[1] = 2;
    files.ids[2] = 3;
    files.ids[3] = 4;
}

// The ids in order, as a number.
fn order(m as *model.Model) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < model.count(m, 0)) {
        v = v * 10 + model.row_id(m, 0, i);
        i = i + 1;
    }
    return v;
}

let is [32]model.Change as told with mut;
let is i64 as ntold with mut = 0;

fn on_change(user as *u8, c as *model.Change) as void {
    if (ntold < 32) { told[ntold] = *c; }
    ntold = ntold + 1;
}

fn was(i as i64, kind as i32, first as i64, count as i64) as i32 {
    return cast(i32, i < ntold && told[i].kind == kind && told[i].parent == 0 && told[i].first == first &&
                told[i].count == count);
}

fn sorted() as void {
    fill();
    let is *sortmodel.Sort as s = sortmodel.open(&src);
    let is *model.Model as m = sortmodel.model_of(s);
    model.observe(m, fn_ptr(on_change), cast(*u8, 0));
    check("unsorted: as it came", order(m) == 1234 && sortmodel.column(s) == 0 - 1 && sortmodel.order(s) == sortmodel.NONE);
    ntold = 0;
    sortmodel.sort(s, 0, sortmodel.ASCENDING);
    check("by name: case aside, equal ones as they came, said", order(m) == 2431 && ntold == 1 && told[0].kind == model.RESET &&
          sortmodel.column(s) == 0 && sortmodel.order(s) == sortmodel.ASCENDING);
    sortmodel.sort(s, 0, sortmodel.DESCENDING);
    check("the other way: equal ones still as they came", order(m) == 1324);
    sortmodel.sort(s, 1, sortmodel.ASCENDING);
    check("by size: numbers as numbers", order(m) == 2413);
    sortmodel.sort(s, 2, sortmodel.ASCENDING);
    check("by day: what it sorts by, not what it says", order(m) == 2431);
    sortmodel.sort(s, 0, sortmodel.NONE);
    check("unsorted again", order(m) == 1234 && sortmodel.column(s) == 0 - 1);
    sortmodel.hook(cast(*u8, s), 1, sortmodel.DESCENDING);
    check("sorted through the hook a table calls", order(m) == 3124 && sortmodel.source_index(s, 0) == 2 &&
          sortmodel.source_index(s, 4) == 0 - 1);
    // What a row holds, from the model.
    let is model.Value as v;
    model.cell(m, 3, 0, model.TEXT, &v);
    check("cells read from the model", v.kind == model.V_TEXT && v.len == 6 && model.columns(m) == 3);
    let is model.Value as nv = model.integer(1);
    check("and written to it", model.set_cell(m, 4, 0, model.TEXT, &nv) == 1 && set_asked == 4);
    check("a flat model", model.count(m, 3) == 0 && model.row_id(m, 3, 0) == 0 && model.row_id(m, 0, 9) == 0 &&
          model.index_of(m, 4) == 3 && model.index_of(m, 9) == 0 - 1);
    sortmodel.close(s);
}

// What compares how: nothing first, then numbers, then text; letters' case
// aside to the last; a word before a longer one it starts; every letter.
fn compared() as void {
    put(1, "Zeta", 0 - 1000, 0);
    put(2, "yak", 0 - 5, 0);
    put(3, "pearl", 0 - 2000, 0);
    put(4, "pear", 7, 0);
    put(5, "bb", 3, 0);
    put(6, "ba", 0 - 1000, 0);
    files.n = 6;
    let is i64 as i with mut = 0;
    while (i < 6) {
        files.ids[i] = i + 1;
        i = i + 1;
    }
    let is *sortmodel.Sort as s = sortmodel.open(&src);
    let is *model.Model as m = sortmodel.model_of(s);
    sortmodel.sort(s, 0, sortmodel.ASCENDING);
    check("by name: ba bb pear pearl yak Zeta", order(m) == 654321);
    sortmodel.sort(s, 1, sortmodel.ASCENDING);
    check("by size: none, then numbers, then text", order(m) == 162543);
    sortmodel.close(s);
}

// Rows removed, past which their places still hold them; a row first gone;
// two changed at once; more rows than there first was room for.
fn edges() as void {
    fill();
    let is *sortmodel.Sort as s = sortmodel.open(&src);
    let is *model.Model as m = sortmodel.model_of(s);
    model.observe(m, fn_ptr(on_change), cast(*u8, 0));
    sortmodel.sort(s, 1, sortmodel.ASCENDING);   // 2 4 1 3
    // The row sorted first, removed.
    ntold = 0;
    files.ids[1] = 3;
    files.ids[2] = 4;
    files.n = 3;
    model.removed(&src, 0, 1, 1);   // id 2: source 1 3 4
    check("the first sorted gone: said there", order(m) == 413 && was(0, model.REMOVED, 0, 1) == 1);
    check("each row where the model has it", sortmodel.source_index(s, 0) == 2 && sortmodel.source_index(s, 1) == 0 &&
          sortmodel.source_index(s, 2) == 1);
    check("past the last: no row", model.row_id(m, 0, 3) == 0 && model.index_of(m, 2) == 0 - 1);
    // Inserted at the source's start: every row's place moves on.
    put(5, "kiwi", 50, 0);
    files.ids[3] = files.ids[2];
    files.ids[2] = files.ids[1];
    files.ids[1] = files.ids[0];
    files.ids[0] = 5;
    files.n = 4;
    model.inserted(&src, 0, 0, 1);   // source 5 1 3 4
    check("inserted first in the source: the others' places on", order(m) == 4153 && sortmodel.source_index(s, 0) == 3 &&
          sortmodel.source_index(s, 1) == 1 && sortmodel.source_index(s, 3) == 2 && sortmodel.source_index(s, 2) == 0);
    // Two changed at once.
    ntold = 0;
    sizes[1] = 200;
    sizes[3] = 1;
    model.changed(&src, 0, 1, 2);   // ids 1 and 3
    check("two changed at once: each where it now sorts", order(m) == 3451 && ntold == 4);
    // Unsorted by anything: a row inserted where the source has it.
    sortmodel.sort(s, 3, sortmodel.ASCENDING);
    ntold = 0;
    put(6, "fig", 0, 0);
    files.ids[4] = 6;
    files.n = 5;
    model.inserted(&src, 0, 4, 1);
    check("all equal: inserted where the source has it", order(m) == 51346 && was(0, model.INSERTED, 4, 1) == 1);
    sortmodel.close(s);
    // Sixty-four, then one more.
    files.n = 0;
    let is i64 as i with mut = 0;
    while (i < 64) {
        put(i % 60 + 1, "x", i, 0);
        files.ids[i] = i % 60 + 1;
        files.n = files.n + 1;
        i = i + 1;
    }
    let is *sortmodel.Sort as s2 = sortmodel.open(&src);
    let is *model.Model as m2 = sortmodel.model_of(s2);
    files.ids[64] = 60;
    files.n = 65;
    model.inserted(&src, 0, 64, 1);
    check("sixty-five: all kept", model.count(m2, 0) == 65 && model.row_id(m2, 0, 0) == 1 && model.row_id(m2, 0, 59) == 60 &&
          model.row_id(m2, 0, 63) == 4 && model.row_id(m2, 0, 64) == 60);
    sortmodel.close(s2);
}

fn followed() as void {
    fill();
    let is *sortmodel.Sort as s = sortmodel.open(&src);
    let is *model.Model as m = sortmodel.model_of(s);
    model.observe(m, fn_ptr(on_change), cast(*u8, 0));
    sortmodel.sort(s, 1, sortmodel.ASCENDING);   // 2 4 1 3: 9 9 10 100
    // Inserted: where it sorts.
    ntold = 0;
    put(5, "kiwi", 50, 0);
    files.ids[4] = 5;
    files.n = 5;
    model.inserted(&src, 0, 4, 1);
    check("inserted: where it sorts, said there", order(m) == 24153 && was(0, model.INSERTED, 3, 1) == 1);
    // Inserted at the source's start: the rest keep their places.
    ntold = 0;
    put(6, "fig", 9, 0);
    let is i64 as i with mut = files.n;
    while (i > 0) {
        files.ids[i] = files.ids[i - 1];
        i = i - 1;
    }
    files.ids[0] = 6;
    files.n = 6;
    model.inserted(&src, 0, 0, 1);
    check("equal to others, first in the source: before them", order(m) == 624153 && was(0, model.INSERTED, 0, 1) == 1);
    // Removed: from where it stood.
    ntold = 0;
    i = 2;
    while (i + 1 < files.n) {
        files.ids[i] = files.ids[i + 1];
        i = i + 1;
    }
    files.n = 5;
    model.removed(&src, 0, 2, 1);   // id 2 gone: 6 1 3 4 5
    check("removed: from where it stood, said there", order(m) == 64153 && was(0, model.REMOVED, 1, 1) == 1);
    // Changed so it moves: out and in.
    ntold = 0;
    sizes[3] = 1;
    model.changed(&src, 0, 2, 1);   // id 3
    check("changed to sort elsewhere: out and in", order(m) == 36415 && was(0, model.REMOVED, 4, 1) == 1 &&
          was(1, model.INSERTED, 0, 1) == 1);
    ntold = 0;
    names[3] = "cherry";
    model.changed(&src, 0, 2, 1);
    check("changed in what it is not sorted by: changed where it stands", order(m) == 36415 && was(0, model.CHANGED, 0, 1) == 1 &&
          ntold == 1);
    // Two inserted at once, two removed at once.
    ntold = 0;
    put(7, "lime", 20, 0);
    put(8, "plum", 5, 0);
    files.ids[5] = 7;
    files.ids[6] = 8;
    files.n = 7;
    model.inserted(&src, 0, 5, 2);
    check("two inserted: each where it sorts", order(m) == 3864175 && ntold == 2);
    ntold = 0;
    files.n = 5;
    model.removed(&src, 0, 5, 2);
    check("two removed: each from where it stood", order(m) == 36415 && ntold == 2);
    // Unsorted: changes pass as they are.
    sortmodel.sort(s, 0, sortmodel.NONE);
    ntold = 0;
    put(9, "date", 1, 0);
    files.ids[5] = 9;
    files.n = 6;
    model.inserted(&src, 0, 5, 1);
    check("unsorted: inserted where the source has it", was(0, model.INSERTED, 5, 1) == 1 &&
          model.row_id(m, 0, 5) == 9);
    // Reset: sorted again, said.
    sortmodel.sort(s, 0, sortmodel.ASCENDING);
    ntold = 0;
    fill();
    model.reset(&src);
    check("reset: sorted again, said", order(m) == 2431 && ntold == 1 && told[0].kind == model.RESET);
    model.changed(&src, 3, 0, 1);
    check("a change under a parent: nothing", ntold == 1);
    sortmodel.close(s);
    ntold = 0;
    model.reset(&src);
    check("closed: no longer heard", ntold == 0);
    sortmodel.close(cast(*sortmodel.Sort, 0));
}

// More rows than there was first room for, sorted.
fn many() as void {
    files.n = 0;
    let is i64 as i with mut = 0;
    while (i < 60) {
        put(i + 1, "x", 60 - i, 0);
        files.ids[i] = i + 1;
        files.n = files.n + 1;
        i = i + 1;
    }
    let is *sortmodel.Sort as s = sortmodel.open(&src);
    let is *model.Model as m = sortmodel.model_of(s);
    sortmodel.sort(s, 1, sortmodel.ASCENDING);
    let is i32 as ok with mut = 1;
    i = 0;
    while (i < 60) {
        if (model.row_id(m, 0, i) != 60 - i) { ok = 0; }
        i = i + 1;
    }
    check("sixty, sorted", ok == 1 && model.count(m, 0) == 60);
    sortmodel.close(s);
}

fn main() as i32 {
    src = model.make(cast(*u8, 0), fn_ptr(files_count), fn_ptr(files_row_id), fn_ptr(files_cell));
    src.columns = fn_ptr(files_columns);
    src.set_cell = fn_ptr(files_set_cell);

    sorted();
    compared();
    edges();
    followed();
    many();

    if (fails == 0) {
        io.printf("sortmodel: %d checks passed\n", checks);
        return 0;
    }
    io.printf("sortmodel: %d of %d checks failed\n", fails, checks);
    return 1;
}
