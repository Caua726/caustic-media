// ui/app.cst — the application: its windows, each with its own tree, and what
// they share.
//
// One App per program. It holds what belongs to no single window — the
// settings from the system (double-click time, drag threshold, ...), the
// timers, which run on one clock in one loop — and a bounded table of windows.
// Each window has a tree of its own and a router of its own: widgets, focus,
// hover, capture and shortcuts never cross from one window to another, which
// is how the platforms behave and what lets a dialog be a window like any
// other.
//
// Like the router, it is fed by calls: the window's size, its scale, whether
// the platform says it is active, the time. The platform loop that makes those
// calls — and opens a real window for each of these, and presents what a frame
// painted — sits above it; nothing here touches the platform, so all of it is
// tested without a display.
//
// Windows are named by handles with an era, as widgets are: a closed window's
// handle fails every check, even once its slot holds another. The table is
// sized when the application opens and running out is FULL, never growth.
use "std/mem.cst" as mem;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "layout.cst" as layout;
use "router.cst" as router;
use "timer.cst" as timer;
use "anim.cst" as anim;
use "damage.cst" as damage;
use "paint.cst" as paint;
use "style.cst" as style;
use "system.cst" as system;
use "../window/settings.cst" as wsettings;
use "../render/draw2d.cst" as draw2d;

// --- Errors ---

let is i32 as OK             with imut = 0;
let is i32 as FULL           with imut = 1;
let is i32 as INVALID_HANDLE with imut = 2;
let is i32 as BAD_ARGUMENT   with imut = 3;
let is i32 as OUT_OF_MEMORY  with imut = 5;
let is i32 as TREE_FAILED    with imut = 7;   // the window's tree could not open

struct Limits {
    windows as i64;          // open at once
    tree    as tree.Limits;  // every window's tree
}

fn limits_default() as Limits {
    let is Limits as l;
    l.windows = 16;
    l.tree = tree.limits_default();
    return l;
}

struct Window {
    tree   as tree.Tree;
    router as router.Router;
    width  as f64;   // logical pixels
    height as f64;
    user   as *u8;   // the program's
    cache  as *paint.Cache;   // the program's; null for none. See set_cache
    anim   as anim.Animator;  // its frame clock: the tweens on its widgets
    era    as i32;
    used   as i32;
    active as i32;   // the platform's keyboard focus is in this window
    _pad0  as i32;
}

struct App {
    settings    as router.Settings;
    timers      as timer.Timers;
    tree_limits as tree.Limits;
    // Every window's theme, in the mapping rather than in the App, so the
    // trees' pointers to it survive the App being returned by value.
    theme       as *style.Theme;
    // The desktop's settings the theme was built from, in the mapping too:
    // the theme's font names point into it.
    desktop     as *wsettings.Settings;
    text        as *u8;   // the text service every window lays text out with; see set_text_service
    block       as *u8;
    block_bytes as i64;
    cap         as i64;
    live        as i64;
    err         as i32;
    ok          as i32;
}

fn _win(a as *App, i as i64) as *Window {
    return cast(*Window, cast(i64, a.block) + _theme_bytes() + _desktop_bytes() + i * sizeof(Window));
}

// The theme's room at the start of the mapping, rounded so the windows after
// it stay aligned.
fn _theme_bytes() as i64 { return (sizeof(style.Theme) + 15) / 16 * 16; }
fn _desktop_bytes() as i64 { return (sizeof(wsettings.Settings) + 15) / 16 * 16; }

fn _handle(a as *App, i as i64) as i64 {
    return (cast(i64, _win(a, i).era) << 32) | (i + 1);
}

// The slot a handle names while its window is open, -1 otherwise.
fn _index(a as *App, h as i64) as i64 {
    if (a.ok == 0 || h == 0) { return 0 - 1; }
    let is i64 as i = (h & 4294967295) - 1;
    if (i < 0 || i >= a.cap) { return 0 - 1; }
    let is *Window as w = _win(a, i);
    if (w.used == 0) { return 0 - 1; }
    if (cast(i64, w.era) != ((h >> 32) & 4294967295)) { return 0 - 1; }
    return i;
}

// --- Opening and closing ---

fn open(l as *Limits) as App {
    let is App as a;
    a.settings = router.settings_default();
    a.timers = timer.init();
    a.tree_limits = l.tree;
    a.theme = cast(*style.Theme, 0);
    a.desktop = cast(*wsettings.Settings, 0);
    a.text = cast(*u8, 0);
    a.block = cast(*u8, 0);
    a.block_bytes = 0;
    a.cap = 0;
    a.live = 0;
    a.ok = 0;
    a.err = OK;
    if (l.windows < 1) { a.err = BAD_ARGUMENT; return a; }
    a.cap = l.windows;
    a.block_bytes = _theme_bytes() + _desktop_bytes() + a.cap * sizeof(Window);
    a.block = mem.core.mmap_anon(a.block_bytes);
    if (cast(i64, a.block) == 0) { a.err = OUT_OF_MEMORY; return a; }
    mem.core.memzero(a.block, a.block_bytes);
    a.theme = cast(*style.Theme, a.block);
    a.desktop = cast(*wsettings.Settings, cast(i64, a.block) + _theme_bytes());
    *a.theme = style.light();
    let is i64 as i with mut = 0;
    while (i < a.cap) {
        _win(&a, i).era = 1;
        i = i + 1;
    }
    a.ok = 1;
    return a;
}

// Closes every window still open — their widgets' destroy entries run — and
// releases the table.
fn close(a as *App) as void {
    if (a.ok == 0) { return; }
    let is i64 as i with mut = 0;
    while (i < a.cap) {
        if (_win(a, i).used == 1) { _close_slot(a, i); }
        i = i + 1;
    }
    mem.core.munmap(a.block, a.block_bytes);
    a.block = cast(*u8, 0);
    a.theme = cast(*style.Theme, 0);
    a.desktop = cast(*wsettings.Settings, 0);
    a.ok = 0;
}

fn is_open(a as *App) as i32 { return a.ok; }
fn last_error(a as *App) as i32 { return a.err; }
fn window_count(a as *App) as i64 { return a.live; }

// --- Windows ---

// A new window of width by height logical pixels, inactive, at scale 1, with
// an empty tree and the application's settings. Returns its handle, or 0 with
// last_error() set.
fn window_open(a as *App, width as f64, height as f64) as i64 {
    if (a.ok == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (i < a.cap && _win(a, i).used == 1) { i = i + 1; }
    if (i >= a.cap) { a.err = FULL; return 0; }
    let is *Window as w = _win(a, i);
    w.tree = tree.open(&a.tree_limits);
    if (tree.is_open(&w.tree) == 0) { a.err = TREE_FAILED; return 0; }
    tree.set_theme(&w.tree, a.theme);
    tree.set_text_service(&w.tree, a.text);
    w.router = router.init(a.settings);
    w.anim = anim.init(&w.tree);
    w.width = width;
    w.height = height;
    w.user = cast(*u8, 0);
    w.cache = cast(*paint.Cache, 0);
    w.active = 0;
    w.used = 1;
    a.live = a.live + 1;
    return _handle(a, i);
}

fn _close_slot(a as *App, i as i64) as void {
    let is *Window as w = _win(a, i);
    tree.close(&w.tree);
    w.used = 0;
    w.era = w.era + 1;
    if (w.era == 0) { w.era = 1; }
    a.live = a.live - 1;
}

// Closes the window: every widget in it is destroyed. A stale handle is
// ignored.
fn window_close(a as *App, h as i64) as void {
    let is i64 as i = _index(a, h);
    if (i < 0) { return; }
    _close_slot(a, i);
}

fn window_valid(a as *App, h as i64) as i32 {
    if (_index(a, h) < 0) { return 0; }
    return 1;
}

// The open window after h, in table order; 0 starts the walk and ends it.
fn next_window(a as *App, h as i64) as i64 {
    if (a.ok == 0) { return 0; }
    let is i64 as i with mut = 0;
    if (h != 0) {
        i = _index(a, h);
        if (i < 0) { return 0; }
        i = i + 1;
    }
    while (i < a.cap) {
        if (_win(a, i).used == 1) { return _handle(a, i); }
        i = i + 1;
    }
    return 0;
}

// The window's tree and router; null for a stale handle.
fn tree(a as *App, h as i64) as *tree.Tree {
    let is i64 as i = _index(a, h);
    if (i < 0) { return cast(*tree.Tree, 0); }
    return &_win(a, i).tree;
}

fn router(a as *App, h as i64) as *router.Router {
    let is i64 as i = _index(a, h);
    if (i < 0) { return cast(*router.Router, 0); }
    return &_win(a, i).router;
}

// The window's animator, for tweens on its widgets; null for a stale handle.
// Its frame interval is the display's refresh, where the platform says it
// (anim.set_interval).
fn animator(a as *App, h as i64) as *anim.Animator {
    let is i64 as i = _index(a, h);
    if (i < 0) { return cast(*anim.Animator, 0); }
    return &_win(a, i).anim;
}

fn set_user(a as *App, h as i64, user as *u8) as void {
    let is i64 as i = _index(a, h);
    if (i < 0) { return; }
    _win(a, i).user = user;
}

fn user(a as *App, h as i64) as *u8 {
    let is i64 as i = _index(a, h);
    if (i < 0) { return cast(*u8, 0); }
    return _win(a, i).user;
}

// --- What the platform says about a window ---

// The window's size in logical pixels — the platform's physical size over the
// scale. The next frame lays out at it.
fn resize(a as *App, h as i64, width as f64, height as f64) as void {
    let is i64 as i = _index(a, h);
    if (i < 0) { return; }
    let is *Window as w = _win(a, i);
    w.width = width;
    w.height = height;
    tree.want_paint(&w.tree);
}

// Physical pixels per logical one, from the monitor the window is on.
fn set_scale(a as *App, h as i64, s as f64) as void {
    let is i64 as i = _index(a, h);
    if (i < 0) { return; }
    layout.set_scale(&_win(a, i).tree, s);
}

fn scale(a as *App, h as i64) as f64 {
    let is i64 as i = _index(a, h);
    if (i < 0) { return 0.0; }
    return layout.scale(&_win(a, i).tree);
}

// Whether the window has the keyboard focus. Everything in it looks different
// when it does not — the toolkits call it the backdrop — so a change repaints
// the whole window.
fn set_active(a as *App, h as i64, on as i32) as void {
    let is i64 as i = _index(a, h);
    if (i < 0) { return; }
    let is *Window as w = _win(a, i);
    if (w.active == on) { return; }
    w.active = on;
    tree.invalidate_paint_subtree(&w.tree, tree.root(&w.tree));
}

fn is_active(a as *App, h as i64) as i32 {
    let is i64 as i = _index(a, h);
    if (i < 0) { return 0; }
    return _win(a, i).active;
}

// --- Frames ---

// Whether the window has anything to lay out or repaint. An idle window is
// skipped on this.
fn needs_frame(a as *App, h as i64) as i32 {
    let is i64 as i = _index(a, h);
    if (i < 0) { return 0; }
    let is *Window as w = _win(a, i);
    if (tree.paint_wanted(&w.tree) == 1) { return 1; }
    return tree.needs_layout(&w.tree, tree.root(&w.tree));
}

// Lays the window out at its size and collects what has to be repainted.
// Returns how many rectangles that is; painting draws them, and the window,
// once it has presented them, clears them with tree.damage_clear.
fn frame(a as *App, h as i64) as i64 {
    let is i64 as i = _index(a, h);
    if (i < 0) { return 0; }
    let is *Window as w = _win(a, i);
    layout.run(&w.tree, w.width, w.height);
    return damage.collect(&w.tree);
}

// The textures the window paints cached and translucent widgets through
// (paint.Cache), on the device its target is on; the program opens it and
// closes it after the window. Null, as a window starts, paints them directly
// — a translucent widget at full opacity.
fn set_cache(a as *App, h as i64, cc as *paint.Cache) as void {
    let is i64 as i = _index(a, h);
    if (i < 0) { return; }
    _win(a, i).cache = cc;
}

fn cache(a as *App, h as i64) as *paint.Cache {
    let is i64 as i = _index(a, h);
    if (i < 0) { return cast(*paint.Cache, 0); }
    return _win(a, i).cache;
}

// Paints what the last frame collected on c — begun by the caller on the
// window's target — with the window's own router for hover, press and focus,
// its cache and its active state; in theme, or the application's when it is
// null. st, if not null, says what was done.
fn paint(a as *App, h as i64, c as *draw2d.Canvas, theme as *style.Theme, time as i64,
         st as *paint.Stats) as i64 {
    let is i64 as i = _index(a, h);
    if (i < 0) { return 0; }
    let is *Window as w = _win(a, i);
    let is paint.Options as o = paint.options(theme);
    o.router = &w.router;
    o.cache = w.cache;
    o.time = time;
    o.active = w.active;
    return paint.frame(&w.tree, c, &o, st);
}

// --- What the windows share ---

// The theme every window paints in. Change it through set_theme or
// set_prefs, which tell the windows.
fn theme(a as *App) as *style.Theme { return a.theme; }

fn _retheme(a as *App) as void {
    let is i64 as i with mut = 0;
    // A slot with no window holds a closed tree, which ignores it.
    while (i < a.cap) {
        tree.set_theme(&_win(a, i).tree, a.theme);
        i = i + 1;
    }
}

// A new theme for every window, laid out and repainted in it; th is copied.
fn set_theme(a as *App, th as *style.Theme) as void {
    if (a.ok == 0) { return; }
    *a.theme = *th;
    _retheme(a);
}

// The theme the system's preferences call for — dark, high contrast, the
// accent, the interface font, text scale, reduced motion — in every window.
fn set_prefs(a as *App, p as *style.Prefs) as void {
    if (a.ok == 0) { return; }
    *a.theme = style.for_prefs(p);
    _retheme(a);
}

// What the desktop says — window.read_settings, the portal — in every window:
// the theme its preferences call for, and its timings in every router. s is
// copied; read again and call this when a SETTINGS event says it changed.
fn set_system(a as *App, s as *wsettings.Settings) as void {
    if (a.ok == 0) { return; }
    *a.desktop = *s;
    let is style.Prefs as p = system.prefs(a.desktop);
    set_prefs(a, &p);
    set_settings(a, system.input(a.desktop, a.settings));
}

fn settings(a as *App) as *router.Settings { return &a.settings; }

// The text service (ui/text.cst) every window, open and to come, lays its
// text out with; the program keeps it open while the windows are.
fn set_text_service(a as *App, s as *u8) as void {
    if (a.ok == 0) { return; }
    a.text = s;
    let is i64 as i with mut = 0;
    while (i < a.cap) {
        tree.set_text_service(&_win(a, i).tree, s);
        i = i + 1;
    }
}

// New settings from the system: every window's router takes them, and every
// window opened later.
fn set_settings(a as *App, s as router.Settings) as void {
    a.settings = s;
    let is i64 as i with mut = 0;
    while (i < a.cap) {
        if (_win(a, i).used == 1) { _win(a, i).router.settings = s; }
        i = i + 1;
    }
}

fn timers(a as *App) as *timer.Timers { return &a.timers; }

// When the loop has something to do next with no event to wake it — a timer,
// a long press being held, a window's next frame while something in it
// animates — or -1 for nothing.
fn next_due(a as *App) as i64 {
    let is i64 as best with mut = timer.next_due(&a.timers);
    let is i64 as i with mut = 0;
    while (i < a.cap) {
        if (_win(a, i).used == 1) {
            let is i64 as d = router.next_due(&_win(a, i).router);
            if (d >= 0 && (best < 0 || d < best)) { best = d; }
            let is i64 as f = anim.next_due(&_win(a, i).anim);
            if (f >= 0 && (best < 0 || f < best)) { best = f; }
        }
        i = i + 1;
    }
    return best;
}

// Runs the timers due by now, every window's due long press, and steps every
// window's animations to now. Returns how many things ran; the windows whose
// widgets changed want a frame.
fn tick(a as *App, now as i64) as i64 {
    let is i64 as ran with mut = timer.fire(&a.timers, now);
    let is i64 as i with mut = 0;
    while (i < a.cap) {
        let is *Window as w = _win(a, i);
        if (w.used == 1) {
            ran = ran + cast(i64, router.tick(&w.tree, &w.router, now));
            ran = ran + anim.tick(&w.anim, now);
        }
        i = i + 1;
    }
    return ran;
}
