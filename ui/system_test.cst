// ui/system_test.cst — the desktop's settings, as the toolkit uses them: the
// theme's preferences and the input timings, and an application following
// them in every window.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "../window/settings.cst" as wsettings;
use "style.cst" as style;
use "router.cst" as router;
use "tree.cst" as tree;
use "app.cst" as app;
use "system.cst" as system;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn desktop() as wsettings.Settings {
    let is wsettings.Settings as s with mut = wsettings.defaults();
    s.dark = 1;
    s.high_contrast = 0;
    s.animations = 0;
    s.accent_r = 0.8;
    s.accent_g = 0.2;
    s.accent_b = 0.1;
    s.known = wsettings.K_DARK | wsettings.K_ANIMATIONS | wsettings.K_ACCENT;
    wsettings.set_font(&s, "Inter 12", 8, 0);
    wsettings.set_font(&s, "Hack 9", 6, 1);
    s.text_scale = 1.5;
    s.double_click_ms = 250;
    s.double_click_px = 7;
    s.drag_px = 11;
    s.blink = 1;
    s.blink_ms = 1000;
    return s;
}

fn main() as i32 {
    let is wsettings.Settings as s with mut = desktop();

    // --- The theme's preferences ---
    let is style.Prefs as p = system.prefs(&s);
    check("dark", p.dark == 1 && p.high_contrast == 0);
    check("less motion", p.reduce_motion == 1);
    check("the accent, opaque", p.has_accent == 1 && p.accent.r == 0.8 && p.accent.g == 0.2 && p.accent.b == 0.1
          && p.accent.a == 1.0);
    check("the fonts", p.font_family[0] == 73 && p.mono_family[0] == 72);
    check("points are 96/72 logical pixels", p.font_size == 16.0);
    check("text scale", p.text_scale == 1.5);
    let is style.Theme as th = style.for_prefs(&p);
    check("a theme from them", th.dark == 1 && th.motion.reduced == 1 && th.fonts.body.size == 24.0);
    let is wsettings.Settings as plain with mut = wsettings.defaults();
    let is style.Prefs as q = system.prefs(&plain);
    check("nothing said, nothing asked", q.dark == 0 && q.reduce_motion == 0 && q.has_accent == 0
          && cast(i64, q.font_family) == 0 && cast(i64, q.mono_family) == 0 && q.font_size == 0.0 && q.text_scale == 1.0);
    plain.high_contrast = 1;
    check("high contrast", system.prefs(&plain).high_contrast == 1);

    // --- The input timings ---
    let is router.Settings as base with mut = router.settings_default();
    base.long_press_ms = 777;
    let is router.Settings as t = system.input(&s, base);
    check("double click", t.double_click_ms == 250 && t.double_click_distance == 7.0);
    check("the drag threshold", t.drag_threshold == 11.0);
    check("the caret's blink", t.caret_blink_ms == 1000);
    check("what the desktop does not say, kept", t.long_press_ms == 777 && t.context_on_release == base.context_on_release);
    s.blink = 0;
    check("a caret that does not blink", system.input(&s, base).caret_blink_ms == 0);
    check("blinking by default", router.settings_default().caret_blink_ms == 1200);

    // --- An application following them ---
    s = desktop();
    let is app.Limits as al = app.limits_default();
    let is app.App as a = app.open(&al);
    let is i64 as w1 = app.window_open(&a, 100.0, 100.0);
    app.set_system(&a, &s);
    let is i64 as w2 = app.window_open(&a, 100.0, 100.0);
    check("the theme", app.theme(&a).dark == 1 && app.theme(&a).fonts.body.size == 24.0);
    check("in every window", tree.theme(app.tree(&a, w1)).dark == 1 && tree.theme(app.tree(&a, w2)).dark == 1);
    check("the timings, in every window", app.router(&a, w1).settings.double_click_ms == 250
          && app.router(&a, w2).settings.drag_threshold == 11.0);
    check("its own copy: the font's name is not the caller's", app.theme(&a).fonts.family != cast(*u8, &s.font)
          && app.theme(&a).fonts.family[0] == 73);
    mem.memset(cast(*u8, &s.font), 0, 128);
    check("and outlives it", app.theme(&a).fonts.family[0] == 73);
    app.close(&a);
    app.set_system(&a, &s);
    check("closed, nothing", cast(i64, app.theme(&a)) == 0);

    if (fails > 0) {
        io.printf("ui system: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("ui system: all checks passed\n");
    return 0;
}
