// ui/grid_test.cst — rows and columns at once: forms, spans, stretch, mirroring.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "grid.cst" as grid;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn near(name as *u8, got as f64, want as f64) as void {
    let is i64 as g = cast(i64, got * 100.0 + 0.5);
    let is i64 as w = cast(i64, want * 100.0 + 0.5);
    if (g != w) {
        io.printf("FAIL: %s: got %d/100, want %d/100\n", name, cast(i32, g), cast(i32, w));
        fails = fails + 1;
    }
}

// The leaf from layout_test: a preferred size, and with wrap > 0 a paragraph
// of `wrap` square units of text, 10 units tall per line.
struct Leaf {
    pref_w as f64;
    pref_h as f64;
    wrap   as f64;
}

fn leaf_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Leaf as d = cast(*Leaf, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = d.pref_w;
    out.pref_h = d.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
    if (d.wrap > 0.0) {
        let is f64 as width with mut = d.pref_w;
        if (c.w < width) { width = c.w; }
        if (width < 1.0) { width = 1.0; }
        let is f64 as lines with mut = 1.0;
        while (lines * width < d.wrap) { lines = lines + 1.0; }
        out.pref_h = lines * 10.0;
        out.min_h = out.pref_h;
    }
}

let is widget.Kind as leaf_kind with mut;

fn cell(t as *tree.Tree, g as i64, row as i32, col as i32, pw as f64, ph as f64) as i64 {
    let is i64 as w = tree.create(t, &leaf_kind, g);
    let is *Leaf as d = cast(*Leaf, tree.data(t, w));
    d.pref_w = pw;
    d.pref_h = ph;
    layout.set_cell(t, w, row, col, 1, 1);
    return w;
}

fn r(t as *tree.Tree, w as i64) as math.rect.Rect { return layout.rect(t, w); }

fn main() as i32 {
    leaf_kind = widget.kind("leaf", sizeof(Leaf));
    leaf_kind.measure = fn_ptr(leaf_measure);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);

    // --- A two-row form: labels in column 0, fields in column 1 ---
    let is i64 as g with mut = grid.create(&t, root);
    grid.set_spacing(&t, g, 5.0, 4.0);
    let is i64 as name_label = cell(&t, g, 0, 0, 30.0, 10.0);
    let is i64 as name_field = cell(&t, g, 0, 1, 100.0, 15.0);
    let is i64 as mail_label = cell(&t, g, 1, 0, 40.0, 20.0);
    let is i64 as mail_field = cell(&t, g, 1, 1, 80.0, 25.0);

    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(&t, g, &free, &s);
    near("grid pref w: widest per column", s.pref_w, 145.0);
    near("grid pref h: tallest per row", s.pref_h, 44.0);

    layout.run(&t, 145.0, 44.0);
    near("labels line up", r(&t, mail_label).x, 0.0);
    near("fields line up", r(&t, mail_field).x, 45.0);
    near("column width is the widest", r(&t, name_label).w, 40.0);
    near("second row below the first", r(&t, mail_field).y, 19.0);
    near("row height is the tallest", r(&t, name_label).h, 15.0);

    // --- The fields' column takes the spare width ---
    layout.set_stretch(&t, name_field, 1.0, 0.0);
    layout.run(&t, 200.0, 44.0);
    near("stretching column", r(&t, mail_field).w, 155.0);
    near("fixed column", r(&t, mail_label).w, 40.0);

    // --- And a stretching row takes the spare height ---
    layout.set_stretch(&t, mail_label, 0.0, 1.0);
    layout.run(&t, 200.0, 100.0);
    near("fixed row", r(&t, name_field).h, 15.0);
    near("stretching row", r(&t, mail_field).h, 81.0);
    layout.set_stretch(&t, mail_label, 0.0, 0.0);

    // --- Right to left: column 0 is the rightmost ---
    layout.set_direction(&t, root, layout.RTL);
    layout.run(&t, 200.0, 44.0);
    near("rtl label at the right", r(&t, name_label).x, 160.0);
    near("rtl field at the left", r(&t, name_field).x, 0.0);
    layout.set_direction(&t, root, layout.LTR);

    // --- A cell spanning both columns shares out what it lacks ---
    let is i64 as wide = cell(&t, g, 2, 0, 300.0, 10.0);
    layout.set_cell(&t, wide, 2, 0, 1, 2);
    layout.measure(&t, g, &free, &s);
    near("span widens the grid", s.pref_w, 300.0);
    layout.run(&t, 300.0, 100.0);
    near("span covers both columns", r(&t, wide).w, 300.0);
    near("span starts at column 0", r(&t, wide).x, 0.0);
    tree.destroy(&t, wide);

    // --- No fixed ceiling on columns ---
    //
    // 70 is past the 64 a grid once allowed; every column is 2 wide.
    tree.destroy(&t, g);
    let is i64 as wide_grid = grid.create(&t, root);
    layout.set_align(&t, wide_grid, layout.START, layout.START);
    let is i64 as last_cell with mut = 0;
    let is i32 as col with mut = 0;
    while (col < 70) {
        last_cell = cell(&t, wide_grid, 0, col, 2.0, 2.0);
        col = col + 1;
    }
    layout.run(&t, 1000.0, 50.0);
    near("70th column placed", r(&t, last_cell).x, 138.0);
    check("scratch all given back after the pass", tree.scratch_mark(&t) == 0);

    // A grid that cannot be laid out says so instead of dropping cells: a
    // cell at column 100000 needs more room to work in than this tree has.
    tree.clear_error(&t);
    let is i64 as far = cell(&t, wide_grid, 0, 100000, 2.0, 2.0);
    layout.run(&t, 1000.0, 50.0);
    check("oversized grid reported", tree.last_error(&t) == tree.LAYOUT_TOO_LARGE);
    tree.destroy(&t, far);
    tree.clear_error(&t);
    tree.destroy(&t, wide_grid);
    g = grid.create(&t, root);

    // --- Height for width: a row's height comes from its column's final width ---
    tree.destroy(&t, g);
    let is i64 as g2 = grid.create(&t, root);
    let is i64 as para = cell(&t, g2, 0, 0, 100.0, 10.0);
    (cast(*Leaf, tree.data(&t, para))).wrap = 100.0;
    layout.set_stretch(&t, para, 1.0, 0.0);
    let is i64 as below = cell(&t, g2, 1, 0, 10.0, 10.0);
    layout.set_align(&t, g2, layout.FILL, layout.START);
    layout.run(&t, 25.0, 200.0);
    near("wrapped row height", r(&t, para).h, 40.0);
    near("next row after it", r(&t, below).y, 40.0);
    // The grid itself asks for the height its wrapped row will need, not for
    // the one-line height its natural widths would give.
    near("grid grows to fit the wrapped row", r(&t, g2).h, 50.0);

    tree.close(&t);
    if (fails != 0) { return 1; }
    io.printf("ui grid: all checks passed\n");
    return 0;
}
