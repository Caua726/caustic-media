// ui/surface_router_test.cst — the router and widgets shown in windows of
// their own. The host hands it the popup window's input in window
// coordinates: a point past the window's edges is the popup's when it lies
// in one, nothing's when it does not; moving from the popup to the window
// leaves the one and enters the other, as the pointer did; outside a modal
// scope the scope hears of it; the window system taking the popup down is
// a press outside, at no point (dismiss); and what takes no input — a
// tooltip — lets the pointer through to what lies beneath.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "event.cst" as event;
use "router.cst" as router;
use "router_hit.cst" as rhit;
use "surface.cst" as surface;
use "../window/positioner.cst" as positioner;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

// A block that records what it hears: how many of each kind, and the last.
struct Block {
    w      as f64;
    h      as f64;
    shape  as i32;
    _pad0  as i32;
    counts as [26]i64;
    last_x as f64;
    last_y as f64;
}

fn block_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Block as b = cast(*Block, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = b.w;
    out.pref_h = b.h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn block_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is f64 as y with mut = 0.0;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        let is geom.Constraint as c = geom.unbounded();
        let is geom.Size as s;
        layout.measure(t, ch, &c, &s);
        let is math.rect.Rect as area = math.rect.rect(0.0, y, r.w, s.pref_h);
        layout.place(t, ch, &area);
        y = y + s.pref_h;
        ch = tree.next_sibling(t, ch);
    }
}

fn block_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Block as b = cast(*Block, data);
    if (e.kind >= 0 && e.kind < 26) { b.counts[e.kind] = b.counts[e.kind] + 1; }
    b.last_x = e.x;
    b.last_y = e.y;
    if (e.kind == event.POINTER_DOWN || e.kind == event.PRESS_OUTSIDE || e.kind == event.MOVE_OUTSIDE) { return 1; }
    return 0;
}

fn block_shape(t as *tree.Tree, w as i64, data as *u8, p as *math.vec.Vec2) as i32 {
    let is *Block as b = cast(*Block, data);
    return b.shape;
}

let is tree.Kind as block_kind with mut;

fn block(t as *tree.Tree, parent as i64, w as f64, h as f64, shape as i32) as i64 {
    let is i64 as b = tree.create(t, &block_kind, parent);
    let is *Block as d = cast(*Block, tree.data(t, b));
    d.w = w;
    d.h = h;
    d.shape = shape;
    return b;
}

fn heard(t as *tree.Tree, w as i64, kind as i32) as i64 {
    return (cast(*Block, tree.data(t, w))).counts[kind];
}

fn host(user as *u8, t as *tree.Tree, op as i32, s as i64) as i32 {
    if (op == tree.SURFACE_CLOSE) { return 1; }
    let is positioner.Positioner as p with mut = tree.surface_place(t, s);
    tree.surface_set_rect(t, s, positioner.place(&p, math.rect.rect(0.0 - 1000.0, 0.0 - 1000.0, 4000.0, 4000.0)));
    return 1;
}

fn main() as i32 {
    block_kind = widget.kind("block", sizeof(Block));
    block_kind.measure = fn_ptr(block_measure);
    block_kind.arrange = fn_ptr(block_arrange);
    block_kind.event = fn_ptr(block_event);
    block_kind.shape = fn_ptr(block_shape);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is router.Router as r = router.init(router.settings_default());
    router.lend(&t, &r);
    let is i64 as back = block(&t, root, 200.0, 100.0, tree.SHAPE_TEXT);
    let is i64 as pop = block(&t, root, 120.0, 160.0, tree.SHAPE_INHERIT);
    tree.set_layer(&t, pop, 900);
    let is i64 as row1 = block(&t, pop, 120.0, 40.0, tree.SHAPE_POINTER);
    let is i64 as row2 = block(&t, pop, 120.0, 40.0, tree.SHAPE_INHERIT);
    tree.set_surfaces(&t, fn_ptr(host), cast(*u8, 0));
    // Opened against the window's bottom: past it, below the window.
    surface.open(&t, pop, surface.MENU, 1, 0, math.rect.rect(150.0, 60.0, 10.0, 10.0), positioner.BOTTOM_LEFT,
                 positioner.BOTTOM_RIGHT, 0);
    layout.run(&t, 200.0, 100.0);
    check("in a window of its own, past the window", tree.surface_index(&t, pop) >= 0 &&
          layout.window_rect(&t, pop).y + layout.window_rect(&t, pop).h > 100.0 &&
          layout.window_rect(&t, pop).x + layout.window_rect(&t, pop).w > 200.0);
    let is math.rect.Rect as pr = layout.window_rect(&t, pop);

    // --- A point past the window's edges, in the popup: the popup's ---
    let is f64 as px = pr.x + 100.0;
    let is f64 as py = pr.y + 60.0;
    router.pointer_move(&t, &r, px, py, 10);
    check("past the window, in the popup: what is there is under it", router.hover(&r) == row2);
    check("entered", heard(&t, row2, event.POINTER_ENTER) == 1);
    check("its shape: its parent's, the popup's, none of its own: the default", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    router.pointer_move(&t, &r, pr.x + 100.0, pr.y + 10.0, 11);
    check("its first row there, its shape", router.hover(&r) == row1 && router.pointer_shape(&t, &r) == tree.SHAPE_POINTER);
    check("left the one, entered the other", heard(&t, row2, event.POINTER_LEAVE) == 1 && heard(&t, row1, event.POINTER_ENTER) == 1);
    router.pointer_button(&t, &r, 1, 1, pr.x + 100.0, pr.y + 10.0, 12);
    check("pressed there: its own", heard(&t, row1, event.POINTER_DOWN) == 1);
    router.pointer_button(&t, &r, 1, 0, pr.x + 100.0, pr.y + 10.0, 13);
    // Past the window and past the popup: nothing.
    router.pointer_move(&t, &r, pr.x + pr.w + 30.0, pr.y + 10.0, 14);
    check("past both: nothing under it", router.hover(&r) == 0);

    // The window's own edges, where no popup is: its first row and column
    // inside it, one past its last outside.
    check("its first column and row: the window's", rhit.hit(&t, 0.0, 20.0) == back && rhit.hit(&t, 20.0, 0.0) == back);
    check("one past its last: nothing", rhit.hit(&t, 200.0, 20.0) == 0 && rhit.hit(&t, 20.0, 100.0) == 0);

    // --- From the popup to the window: the one left, the other entered ---
    router.pointer_move(&t, &r, pr.x + 100.0, pr.y + 50.0, 15);
    router.pointer_move(&t, &r, 20.0, 20.0, 16);
    check("over the window: the window's", router.hover(&r) == back && heard(&t, back, event.POINTER_ENTER) == 1);
    check("and the popup's row left", heard(&t, row2, event.POINTER_LEAVE) == 2);
    check("the window's shape", router.pointer_shape(&t, &r) == tree.SHAPE_TEXT);

    // --- A modal scope: the pointer over the window outside it ---
    router.set_scope(&t, &r, pop);
    let is i64 as moved_out = heard(&t, pop, event.MOVE_OUTSIDE);
    let is i64 as back_moves = heard(&t, back, event.POINTER_MOVE);
    router.pointer_move(&t, &r, 30.0, 30.0, 17);
    check("outside the scope: the scope hears of it", heard(&t, pop, event.MOVE_OUTSIDE) == moved_out + 1);
    check("not the window's", heard(&t, back, event.POINTER_MOVE) == back_moves);
    router.pointer_move(&t, &r, pr.x + 100.0, pr.y + 10.0, 18);
    check("inside it again, past the window: its own", router.hover(&r) == row1);

    // --- The window system took it down: a press outside, at no point ---
    let is i64 as outside = heard(&t, pop, event.PRESS_OUTSIDE);
    check("dismissed: the scope told", router.dismiss(&t, &r, 19) == 1 && heard(&t, pop, event.PRESS_OUTSIDE) == outside + 1);
    let is *Block as pd = cast(*Block, tree.data(&t, pop));
    check("at no point", pd.last_x < 0.0 && pd.last_y < 0.0);
    router.set_scope(&t, &r, 0);
    check("no scope: nothing to tell", router.dismiss(&t, &r, 20) == 0);

    // --- Inside the window again: no point past the window is anyone's ---
    surface.close(&t, pop);
    tree.set_surfaces(&t, cast(tree.SurfaceFn, 0), cast(*u8, 0));
    surface.open(&t, pop, surface.MENU, 1, 0, math.rect.rect(150.0, 60.0, 10.0, 10.0), positioner.BOTTOM_LEFT,
                 positioner.BOTTOM_RIGHT, 0);
    layout.run(&t, 200.0, 100.0);
    router.pointer_move(&t, &r, 250.0, 150.0, 21);
    check("inside the window, past its edges: nothing", router.hover(&r) == 0);

    // --- What takes no input lets the pointer through ---
    tree.set_visible(&t, pop, 0);
    let is i64 as tip = block(&t, root, 60.0, 30.0, tree.SHAPE_HELP);
    tree.set_layer(&t, tip, 950);
    surface.open(&t, tip, surface.TOOLTIP, 0, 0, math.rect.rect(10.0, 10.0, 10.0, 10.0), positioner.BOTTOM_RIGHT,
                 positioner.BOTTOM_RIGHT, 0);
    layout.run(&t, 200.0, 100.0);
    let is math.rect.Rect as tr = layout.window_rect(&t, tip);
    router.pointer_move(&t, &r, tr.x + 5.0, tr.y + 5.0, 22);
    check("over a tooltip that takes input: the tooltip's", router.hover(&r) == tip);
    tree.set_flag(&t, tip, tree.F_NO_INPUT, 1);
    check("marked so", tree.has_flag(&t, tip, tree.F_NO_INPUT) == 1);
    router.pointer_move(&t, &r, tr.x + 6.0, tr.y + 5.0, 23);
    check("over one that takes none: what is beneath it", router.hover(&r) == back);
    router.pointer_button(&t, &r, 1, 1, tr.x + 6.0, tr.y + 5.0, 24);
    check("and the press its", heard(&t, back, event.POINTER_DOWN) == 1 && heard(&t, tip, event.POINTER_DOWN) == 0);
    router.pointer_button(&t, &r, 1, 0, tr.x + 6.0, tr.y + 5.0, 25);
    check("its shape the window's", router.pointer_shape(&t, &r) == tree.SHAPE_TEXT);

    tree.close(&t);
    if (fails == 0) {
        io.printf("ui surface router: all checks passed\n");
        return 0;
    }
    io.printf("ui surface router: %d failures\n", fails);
    return 1;
}
