// ui/surface.cst — a widget on a layer put against a rectangle of the window:
// a menu, a list dropping down, a popover, a tooltip.
//
// Where the host lends the tree its windows (tree.set_surfaces), the widget is
// shown in a platform window of its own — a popup, which reaches past the
// window's edges — placed by the platform from the positioner: flipped,
// slid, cut to the room the screen has. It stays a widget of the tree, its
// handles, router and signals its own; layout puts it where the platform
// put it (tree.surface_rect), and its input comes through the router as the
// window's does. Where there is no host, or it could not open one, it is
// drawn inside the window on its layer, placed by the same positioner within
// the window, as it always was.
//
// Either way what it is anchored to is remembered — a widget, and the
// rectangle in that widget's own coordinates — and follow places it again
// when that moves or the widget's own size changes: a list under an entry
// that grows as it is typed into, a popover over a button the window's
// resize moved.
use "../math/math.cst" as math;
use "../window/positioner.cst" as positioner;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;

let is i32 as MENU    with imut = tree.SURFACE_MENU;
let is i32 as LIST    with imut = tree.SURFACE_LIST;
let is i32 as TOOLTIP with imut = tree.SURFACE_TOOLTIP;

fn _max(a as f64, b as f64) as f64 { if (a > b) { return a; } return b; }

// The size w would like with nothing in its way, as open measures it — no
// margins, no maximum, its own minimum — without touching what it was given
// inside the window.
fn _wanted(t as *tree.Tree, w as i64, out as *geom.Size) as void {
    let is geom.Constraint as c = geom.unbounded();
    geom.size_zero(out);
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
    let is *tree.Kind as k = tree.kind(t, w);
    if (cast(i64, k) != 0 && cast(i64, k.measure) != 0) {
        call(k.measure, t, w, tree.data(t, w), &c, out);
    }
    let is *geom.Item as it = tree.item(t, w);
    if (cast(i64, it) == 0) { return; }
    let is f64 as lo_w = _max(out.min_w, it.min_w);
    let is f64 as lo_h = _max(out.min_h, it.min_h);
    let is f64 as hi_w = _max(out.max_w, lo_w);
    let is f64 as hi_h = _max(out.max_h, lo_h);
    if (out.pref_w < lo_w) { out.pref_w = lo_w; }
    if (out.pref_w > hi_w) { out.pref_w = hi_w; }
    if (out.pref_h < lo_h) { out.pref_h = lo_h; }
    if (out.pref_h > hi_h) { out.pref_h = hi_h; }
}

// Inside the window: at, window coordinates, by its margins from the root's
// corner — its far corner, right to left — no larger than at.
fn _in_window(t as *tree.Tree, w as i64, at as math.rect.Rect) as void {
    layout.set_max_size(t, w, at.w, at.h);
    layout.set_margin(t, w, at.x, at.y, 0.0, 0.0);
    if (layout.direction(t, w) == layout.RTL) {
        layout.set_align(t, w, layout.END, layout.START);
    } else {
        layout.set_align(t, w, layout.START, layout.START);
    }
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    widget.changed(t, tree.root(t), widget.CHANGED_LAYOUT);
}

// w — a child of the root on a layer — shown against rect, window
// coordinates, of the widget from (0 for the window itself, rect then in its
// coordinates as they are): from its anchor point, growing as gravity says,
// adjusted as adjust allows (positioner.*), as kind (MENU, LIST, TOOLTIP),
// taking the pointer and keys while it is up when grab is 1. Shown already,
// it is placed again. Where it went, window coordinates — past the window's
// edges when it is in a window of its own.
fn open(t as *tree.Tree, w as i64, kind as i32, grab as i32, from as i64, rect as math.rect.Rect,
        anchor as i32, gravity as i32, adjust as i32) as math.rect.Rect {
    if (tree.is_valid(t, w) == 0) { return math.rect.rect_zero(); }
    // Measured whole: nothing it was given before holds it in.
    layout.set_max_size(t, w, layout.UNBOUNDED, layout.UNBOUNDED);
    layout.set_margin(t, w, 0.0, 0.0, 0.0, 0.0);
    let is geom.Constraint as c = geom.unbounded();
    let is geom.Size as s;
    layout.measure(t, w, &c, &s);
    let is positioner.Positioner as p with mut = positioner.make(s.pref_w, s.pref_h, rect);
    p.anchor = anchor;
    p.gravity = gravity;
    p.adjust = adjust;
    let is i64 as sf = tree.surface_open(t, w, kind, grab, from, &p);
    if (sf >= 0) {
        widget.changed(t, tree.root(t), widget.CHANGED_LAYOUT);
        return tree.surface_rect(t, sf);
    }
    let is math.rect.Rect as at = positioner.place(&p, layout.rect(t, tree.root(t)));
    _in_window(t, w, at);
    let is i64 as e = tree.placed_entry(t, w);
    if (e >= 0) { tree.placed_set_rect(t, e, at); }
    return at;
}

// Put away: its window, when it has one, and what it was anchored to
// forgotten. Hiding it is the caller's.
fn close(t as *tree.Tree, w as i64) as void { tree.surface_close(t, w); }

// Whether it is in a window of its own.
fn is_native(t as *tree.Tree, w as i64) as i32 { return cast(i32, tree.surface_index(t, w) >= 0); }

// Where it is, window coordinates: where the platform put it, where it was
// put inside the window, or where layout has it.
fn rect(t as *tree.Tree, w as i64) as math.rect.Rect {
    let is i64 as s = tree.surface_index(t, w);
    if (s >= 0) { return tree.surface_rect(t, s); }
    let is i64 as e = tree.placed_entry(t, w);
    if (e >= 0) { return tree.placed_rect(t, e); }
    return layout.window_rect(t, w);
}

// What it was last placed against, window coordinates.
fn anchor_rect(t as *tree.Tree, w as i64) as math.rect.Rect {
    let is i64 as e = tree.placed_entry(t, w);
    if (e < 0) { return math.rect.rect_zero(); }
    return tree.placed_place(t, e).anchor_rect;
}

fn _differs(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d > 0.001 || d < 0.0 - 0.001);
}

fn _moved(a as math.rect.Rect, b as math.rect.Rect) as i32 {
    return cast(i32, _differs(a.x, b.x) == 1 || _differs(a.y, b.y) == 1 || _differs(a.w, b.w) == 1 ||
                     _differs(a.h, b.h) == 1);
}

// Every widget placed in the tree and shown, placed again where what it is
// anchored to has moved or its own size has changed — run after layout, and
// layout run again when it says so. How many were placed again.
fn follow(t as *tree.Tree) as i64 {
    let is i64 as moved with mut = 0;
    let is i64 as e with mut = 0;
    while (e < tree.MAX_SURFACES) {
        let is i64 as w = tree.placed_widget(t, e);
        if (w != 0 && tree.is_visible(t, w) == 1) {
            let is positioner.Positioner as was = tree.placed_place(t, e);
            let is math.rect.Rect as now = tree.placed_anchor(t, e);
            let is geom.Size as s;
            _wanted(t, w, &s);
            let is i32 as grew = cast(i32, _differs(s.pref_w, was.w) == 1 || _differs(s.pref_h, was.h) == 1);
            if (_moved(now, was.anchor_rect) == 1 || grew == 1) {
                open(t, w, tree.placed_kind(t, e), tree.placed_grab(t, e), tree.placed_from(t, e), now,
                     was.anchor, was.gravity, was.adjust);
                moved = moved + 1;
            }
        }
        e = e + 1;
    }
    return moved;
}
