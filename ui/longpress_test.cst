// ui/longpress_test.cst — a press held still opens the context menu.
//
// On a touch screen there is no right button: holding a finger still is how a
// context menu is asked for, and a pen does the same. The router arms it on
// the press, says when it is due, and fires it when ticked at that time — no
// event arrives while a finger is still, so the loop has to ask.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "event.cst" as event;
use "router.cst" as router;
use "app.cst" as app;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

// Records what reaches it; captures presses when grab is 1.
struct Probe {
    grab    as i64;
    menus   as i64;
    cancels as i64;
    ups     as i64;
    menu_x  as f64;
    menu_y  as f64;
    menu_button as i64;
}

fn probe_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = 100.0;
    out.pref_h = 100.0;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn probe_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Probe as p = cast(*Probe, data);
    if (e.kind == event.POINTER_DOWN) { return p.grab; }
    if (e.kind == event.CONTEXT_MENU) {
        p.menus = p.menus + 1;
        p.menu_x = e.x;
        p.menu_y = e.y;
        p.menu_button = cast(i64, e.button);
        return 1;
    }
    if (e.kind == event.POINTER_CANCEL) { p.cancels = p.cancels + 1; return 1; }
    if (e.kind == event.POINTER_UP) { p.ups = p.ups + 1; return 1; }
    return 0;
}

let is tree.Kind as probe_kind with mut;

fn reset(p as *Probe) as void {
    p.menus = 0;
    p.cancels = 0;
    p.ups = 0;
}

fn main() as i32 {
    probe_kind = widget.kind("probe", sizeof(Probe));
    probe_kind.measure = fn_ptr(probe_measure);
    probe_kind.event = fn_ptr(probe_event);

    let is router.Settings as st = router.settings_default();
    check("half a second by default", st.long_press_ms == 500);
    check("not for a mouse by default", st.long_press_mouse == 0);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as w = tree.create(&t, &probe_kind, tree.root(&t));
    layout.set_align(&t, w, layout.START, layout.START);
    layout.run(&t, 400.0, 300.0);
    let is *Probe as p = cast(*Probe, tree.data(&t, w));
    p.grab = 1;
    let is router.Router as r = router.init(st);

    // --- A mouse held still is just held ---
    router.pointer_button(&t, &r, 1, 1, 50.0, 50.0, 1000);
    check("mouse: nothing due", router.next_due(&r) < 0);
    router.tick(&t, &r, 5000);
    check("mouse: no menu", p.menus == 0);
    router.pointer_button(&t, &r, 1, 0, 50.0, 50.0, 5100);
    check("mouse: the release arrives", p.ups == 1);
    reset(p);

    // --- A finger held still: the menu, where it was pressed ---
    router.set_source(&r, router.TOUCH);
    router.pointer_button(&t, &r, 1, 1, 50.0, 40.0, 10000);
    check("touch: due after the delay", router.next_due(&r) == 10500);
    router.tick(&t, &r, 10499);
    check("touch: not before", p.menus == 0);
    router.tick(&t, &r, 10500);
    check("touch: the menu", p.menus == 1);
    check("touch: where the finger is", p.menu_x == 50.0 && p.menu_y == 40.0);
    check("touch: from a long press", p.menu_button == 1);
    check("touch: the press it interrupted is cancelled", p.cancels == 1);
    check("touch: the capture is gone", router.capture(&r) == 0);
    check("touch: nothing more due", router.next_due(&r) < 0);
    router.tick(&t, &r, 20000);
    check("touch: once", p.menus == 1);
    router.pointer_button(&t, &r, 1, 0, 50.0, 40.0, 11000);
    check("touch: the release that follows is no click", p.ups == 0);
    router.pointer_button(&t, &r, 1, 1, 50.0, 40.0, 30000);
    router.pointer_button(&t, &r, 1, 0, 50.0, 40.0, 30100);
    check("touch: the next tap's release arrives", p.ups == 1);
    reset(p);

    // --- Moving disarms it; a little does not ---
    router.pointer_button(&t, &r, 1, 1, 50.0, 50.0, 40000);
    router.pointer_move(&t, &r, 53.0, 52.0, 40100);
    check("a small move: still due", router.next_due(&r) == 40500);
    router.pointer_move(&t, &r, 70.0, 50.0, 40200);
    check("past the drag threshold: disarmed", router.next_due(&r) < 0);
    router.tick(&t, &r, 41000);
    check("past the drag threshold: no menu", p.menus == 0);
    router.pointer_button(&t, &r, 1, 0, 70.0, 50.0, 41100);
    check("a drag's release arrives", p.ups == 1);
    reset(p);

    // --- Lifting before it is due disarms it ---
    router.pointer_button(&t, &r, 1, 1, 50.0, 50.0, 50000);
    router.pointer_button(&t, &r, 1, 0, 50.0, 50.0, 50200);
    check("lifted early: disarmed", router.next_due(&r) < 0);
    router.tick(&t, &r, 51000);
    check("lifted early: no menu", p.menus == 0);
    reset(p);

    // --- Nobody captured the press: the menu still comes, the release does not ---
    p.grab = 0;
    router.pointer_button(&t, &r, 1, 1, 50.0, 50.0, 60000);
    router.tick(&t, &r, 60500);
    check("uncaptured: the menu", p.menus == 1);
    check("uncaptured: nothing to cancel", p.cancels == 0);
    router.pointer_button(&t, &r, 1, 0, 50.0, 50.0, 60600);
    check("uncaptured: the release is no click either", p.ups == 0);
    p.grab = 1;
    reset(p);

    // --- A pen too; a mouse when the settings say so ---
    router.set_source(&r, router.PEN);
    router.pointer_button(&t, &r, 1, 1, 50.0, 50.0, 70000);
    router.tick(&t, &r, 70500);
    check("pen: the menu", p.menus == 1);
    router.pointer_button(&t, &r, 1, 0, 50.0, 50.0, 70600);
    reset(p);
    router.set_source(&r, router.MOUSE);
    let is router.Settings as hold = router.settings_default();
    hold.long_press_mouse = 1;
    r.settings = hold;
    router.pointer_button(&t, &r, 1, 1, 50.0, 50.0, 80000);
    router.tick(&t, &r, 80500);
    check("mouse, when asked: the menu", p.menus == 1);
    router.pointer_button(&t, &r, 1, 0, 50.0, 50.0, 80600);
    reset(p);
    // Only the primary button: a held middle button is not a long press.
    router.pointer_button(&t, &r, 2, 1, 50.0, 50.0, 90000);
    check("middle button: nothing due", router.next_due(&r) < 0);
    router.pointer_button(&t, &r, 2, 0, 50.0, 50.0, 90100);
    // A delay of zero turns it off.
    hold.long_press_ms = 0;
    r.settings = hold;
    router.pointer_button(&t, &r, 1, 1, 50.0, 50.0, 95000);
    check("zero delay: off", router.next_due(&r) < 0);
    router.pointer_button(&t, &r, 1, 0, 50.0, 50.0, 95100);
    reset(p);
    tree.close(&t);

    // --- The application's loop sees it with its timers ---
    let is app.Limits as al = app.limits_default();
    let is app.App as a = app.open(&al);
    let is i64 as win = app.window_open(&a, 400.0, 300.0);
    let is *tree.Tree as wt = app.tree(&a, win);
    let is i64 as aw = tree.create(wt, &probe_kind, tree.root(wt));
    layout.set_align(wt, aw, layout.START, layout.START);
    app.frame(&a, win);
    let is *Probe as ap = cast(*Probe, tree.data(wt, aw));
    ap.grab = 1;
    router.set_source(app.router(&a, win), router.TOUCH);
    check("app: nothing due", app.next_due(&a) < 0);
    router.pointer_button(wt, app.router(&a, win), 1, 1, 50.0, 50.0, 1000);
    check("app: due with the press", app.next_due(&a) == 1500);
    app.tick(&a, 1500);
    check("app: the tick fires it", ap.menus == 1);
    app.close(&a);

    if (fails > 0) {
        io.printf("long press: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("long press: all checks passed\n");
    return 0;
}
