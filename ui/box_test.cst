// ui/box_test.cst — rows and columns: measuring, distributing, mirroring.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "box.cst" as box;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn near(name as *u8, got as f64, want as f64) as void {
    let is i64 as g = cast(i64, got * 100.0 + 0.5);
    let is i64 as w = cast(i64, want * 100.0 + 0.5);
    if (g != w) {
        io.printf("FAIL: %s: got %d/100, want %d/100\n", name, cast(i32, g), cast(i32, w));
        fails = fails + 1;
    }
}

// A leaf that would like a fixed size and can shrink to nothing — or, with
// wrap > 0, a paragraph of `wrap` square units of text, 10 tall per line.
struct Leaf {
    pref_w as f64;
    pref_h as f64;
    wrap   as f64;
}

fn leaf_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Leaf as d = cast(*Leaf, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = d.pref_w;
    out.pref_h = d.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
    if (d.wrap > 0.0) {
        let is f64 as width with mut = d.pref_w;
        if (c.w < width) { width = c.w; }
        if (width < 1.0) { width = 1.0; }
        let is f64 as lines with mut = 1.0;
        while (lines * width < d.wrap) { lines = lines + 1.0; }
        out.pref_h = lines * 10.0;
        out.min_h = out.pref_h;
    }
}

let is widget.Kind as leaf_kind with mut;

fn leaf(t as *tree.Tree, parent as i64, pw as f64, ph as f64) as i64 {
    let is i64 as w = tree.create(t, &leaf_kind, parent);
    let is *Leaf as d = cast(*Leaf, tree.data(t, w));
    d.pref_w = pw;
    d.pref_h = ph;
    return w;
}

fn r(t as *tree.Tree, w as i64) as math.rect.Rect { return layout.rect(t, w); }

fn main() as i32 {
    leaf_kind = widget.kind("leaf", sizeof(Leaf));
    leaf_kind.measure = fn_ptr(leaf_measure);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);

    // --- A column: heights add up, widths take the widest ---
    let is i64 as col = box.create(&t, root, box.COLUMN);
    box.set_spacing(&t, col, 5.0);
    box.set_padding(&t, col, 2.0, 2.0, 2.0, 2.0);
    let is i64 as a = leaf(&t, col, 40.0, 10.0);
    let is i64 as b = leaf(&t, col, 50.0, 20.0);
    let is i64 as c = leaf(&t, col, 60.0, 30.0);

    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    layout.measure(&t, col, &free, &s);
    near("column pref w", s.pref_w, 64.0);
    near("column pref h", s.pref_h, 74.0);
    near("column min h", s.min_h, 14.0);

    // --- Room to spare and nobody stretches: preferred sizes, from the top ---
    layout.run(&t, 100.0, 200.0);
    near("a y", r(&t, a).y, 2.0);
    near("b y", r(&t, b).y, 17.0);
    near("c y", r(&t, c).y, 42.0);
    near("b h", r(&t, b).h, 20.0);
    near("cross axis fills", r(&t, b).w, 96.0);
    near("cross axis inside padding", r(&t, b).x, 2.0);

    // --- Spare room goes by stretch ---
    layout.set_stretch(&t, b, 0.0, 1.0);
    layout.set_stretch(&t, c, 0.0, 2.0);
    layout.run(&t, 100.0, 200.0);
    near("stretch 1 gets a third", r(&t, b).h, 62.0);
    near("stretch 2 gets two thirds", r(&t, c).h, 114.0);
    near("stretched c y", r(&t, c).y, 84.0);

    // A widget that reaches its maximum hands the rest to the others.
    layout.set_max_size(&t, c, layout.UNBOUNDED, 40.0);
    layout.run(&t, 100.0, 200.0);
    near("capped at max", r(&t, c).h, 40.0);
    near("the rest goes to b", r(&t, b).h, 136.0);
    layout.set_max_size(&t, c, layout.UNBOUNDED, layout.UNBOUNDED);
    layout.set_stretch(&t, b, 0.0, 0.0);
    layout.set_stretch(&t, c, 0.0, 0.0);

    // --- Too little room: each gives up in proportion to what it can ---
    layout.run(&t, 100.0, 50.0);
    near("shrunk a", r(&t, a).h, 6.0);
    near("shrunk b", r(&t, b).h, 12.0);
    near("shrunk c", r(&t, c).h, 18.0);

    // --- Hidden takes no room, and no spacing either ---
    tree.set_visible(&t, b, 0);
    layout.run(&t, 100.0, 200.0);
    near("c follows a directly", r(&t, c).y, 17.0);
    layout.measure(&t, col, &free, &s);
    near("hidden not measured", s.pref_h, 49.0);
    tree.set_visible(&t, b, 1);
    tree.destroy(&t, col);

    // --- A row, and right to left ---
    let is i64 as row = box.create(&t, root, box.ROW);
    layout.set_align(&t, row, layout.FILL, layout.START);
    let is i64 as x = leaf(&t, row, 10.0, 10.0);
    let is i64 as y = leaf(&t, row, 20.0, 10.0);
    layout.run(&t, 100.0, 50.0);
    near("ltr first", r(&t, x).x, 0.0);
    near("ltr second", r(&t, y).x, 10.0);

    layout.set_direction(&t, root, layout.RTL);
    layout.run(&t, 100.0, 50.0);
    near("rtl first starts at the right", r(&t, x).x, 90.0);
    near("rtl second to its left", r(&t, y).x, 70.0);
    layout.set_direction(&t, root, layout.LTR);
    layout.run(&t, 100.0, 50.0);
    near("back to ltr", r(&t, x).x, 0.0);

    // Cross-axis alignment is the child's own.
    layout.set_align(&t, y, layout.FILL, layout.CENTER);
    layout.set_align(&t, row, layout.FILL, layout.FILL);
    layout.run(&t, 100.0, 50.0);
    near("centered across", r(&t, y).y, 20.0);
    near("filled across", r(&t, x).h, 50.0);

    // --- Homogeneous: equal shares regardless of preference ---
    box.set_homogeneous(&t, row, 1);
    let is i64 as z = leaf(&t, row, 5.0, 10.0);
    layout.run(&t, 90.0, 50.0);
    near("equal share 1", r(&t, x).w, 30.0);
    near("equal share 2", r(&t, y).w, 30.0);
    near("equal share 3", r(&t, z).x, 60.0);
    box.set_homogeneous(&t, row, 0);
    tree.destroy(&t, z);

    // --- A row measured for a known width reports the height of what wraps ---
    //
    // 35 wide: the fixed leaf keeps its minimum 10, the paragraph gets 25 and
    // wraps to four lines, so the row has to be 40 tall, not one line's 10.
    let is i64 as wrow = box.create(&t, root, box.ROW);
    layout.set_align(&t, wrow, layout.FILL, layout.START);
    let is i64 as para = leaf(&t, wrow, 100.0, 10.0);
    (cast(*Leaf, tree.data(&t, para))).wrap = 100.0;
    let is i64 as fixed = leaf(&t, wrow, 10.0, 10.0);
    layout.set_min_size(&t, fixed, 10.0, 0.0);
    tree.set_visible(&t, row, 0);
    layout.run(&t, 35.0, 200.0);
    near("paragraph width", r(&t, para).w, 25.0);
    near("row as tall as the wrapped text", r(&t, wrow).h, 40.0);
    tree.destroy(&t, wrow);
    tree.set_visible(&t, row, 1);

    // --- A nested box that was clean still mirrors when the direction changes ---
    //
    // The inner row keeps its size, so nothing but the direction change can
    // tell it to arrange again.
    let is i64 as inner = box.create(&t, row, box.ROW);
    let is i64 as p = leaf(&t, inner, 10.0, 10.0);
    let is i64 as q = leaf(&t, inner, 10.0, 10.0);
    layout.set_stretch(&t, inner, 1.0, 0.0);
    layout.run(&t, 100.0, 50.0);
    let is f64 as p_ltr = r(&t, p).x;
    layout.set_direction(&t, root, layout.RTL);
    layout.run(&t, 100.0, 50.0);
    check("nested row mirrored", r(&t, p).x > r(&t, q).x);
    check("nested row moved", r(&t, p).x != p_ltr);

    tree.close(&t);
    if (fails != 0) { return 1; }
    io.printf("ui box: all checks passed\n");
    return 0;
}
