// ui/tree_test.cst — the widget tree: handles, structure, destruction, flags.
//
// Everything here is geometry-free on purpose. The tree is what every later
// part of the toolkit assumes — layout walks it, events route through it, the
// accessibility bridge exposes it — so it is tested on its own, before any of
// them exists to hide a mistake in it.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "layout.cst" as layout;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL: %s: got %d, want %d\n", name, cast(i32, got), cast(i32, want));
        fails = fails + 1;
    }
}

// --- A kind that records its destruction ---
//
// Each widget's data holds a tag; destroy appends the tag to a log, so a test
// can see both that every widget was released and in what order.
let is [64]i64 as destroyed_log with mut;
let is i64 as destroyed_count with mut = 0;

struct Tagged {
    tag as i64;
}

fn tagged_destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Tagged as d = cast(*Tagged, data);
    if (destroyed_count < 64) { destroyed_log[destroyed_count] = d.tag; }
    destroyed_count = destroyed_count + 1;
}

// A widget that, going, takes another with it — as a text view its menu,
// which lives under the root.
struct Taker {
    other as i64;
}

let is i64 as taken with mut = 0;

fn taker_destroy(t as *tree.Tree, w as i64, data as *u8) as void {
    let is *Taker as d = cast(*Taker, data);
    if (d.other != 0 && tree.is_valid(t, d.other) == 1) {
        tree.destroy(t, d.other);
        taken = taken + 1;
    }
}

fn make(t as *tree.Tree, k as *tree.Kind, parent as i64, tag as i64) as i64 {
    let is i64 as w = tree.create(t, k, parent);
    if (w != 0) {
        let is *Tagged as d = cast(*Tagged, tree.data(t, w));
        d.tag = tag;
    }
    return w;
}

fn reset_log() as void { destroyed_count = 0; }

let is i64 as copied_n with mut = 0;
let is i32 as copied_which with mut = 0 - 1;
let is *u8 as copied_text with mut;
let is *u8 as copied_user with mut;

let is i64 as asked_n with mut = 0;
let is i32 as asked_which with mut = 0 - 1;
let is i64 as asked_w with mut = 0;
let is *u8 as asked_user with mut;

fn on_paste(user as *u8, which as i32, w as i64) as void {
    asked_n = asked_n + 1;
    asked_which = which;
    asked_w = w;
    asked_user = user;
}

fn on_copy(user as *u8, which as i32, text as *u8, n as i64) as void {
    copied_user = user;
    copied_which = which;
    copied_text = text;
    copied_n = n;
}

let is i32 as asked_op with mut = 0;
let is f64 as asked_x with mut = 0.0;
let is f64 as asked_y with mut = 0.0;

fn on_window(user as *u8, op as i32, x as f64, y as f64) as void {
    asked_op = op;
    asked_x = x;
    asked_y = y;
}

fn small_limits(widgets as i64) as tree.Limits {
    let is tree.Limits as l = tree.limits_default();
    l.widgets = widgets;
    return l;
}

// --- What is watched ---

let is [32]i64 as watched_w with mut;
let is [32]i32 as watched_what with mut;
let is i64 as watched with mut = 0;

// A text change, as the watcher reads it while told.
let is i64 as change_what with mut = 0;
let is i64 as change_at with mut = 0;
let is i64 as change_n with mut = 0;
let is u8 as change_first with mut = 0;
let is i32 as change_none with mut = 0;

fn on_watch(user as *u8, t as *tree.Tree, w as i64, what as i32) as void {
    if (watched < 32) {
        watched_w[watched] = w;
        watched_what[watched] = what;
    }
    watched = watched + 1;
    let is *tree.TextChange as c = tree.text_change(t);
    if (what == tree.WATCH_TEXT && cast(i64, c) != 0) {
        change_what = c.what;
        change_at = c.at;
        change_n = c.len;
        change_first = c.text[0];
    }
    if (what != tree.WATCH_TEXT && cast(i64, c) != 0) { change_none = 1; }
}

// Whether w was told what, once at least.
fn told(w as i64, what as i32) as i32 {
    let is i64 as i with mut = 0;
    while (i < watched && i < 32) {
        if (watched_w[i] == w && watched_what[i] == what) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() as i32 {
    let is tree.Kind as k = widget.kind("tagged", sizeof(Tagged));
    k.destroy = fn_ptr(tagged_destroy);

    // --- A new tree is a root and nothing else ---
    let is tree.Limits as l = small_limits(16);
    let is tree.Tree as t = tree.open(&l);
    check("open", tree.is_open(&t));
    let is i64 as root = tree.root(&t);
    check("root is valid", tree.is_valid(&t, root));
    eq("root has no parent", tree.parent(&t, root), 0);
    eq("root has no children", tree.child_count(&t, root), 0);
    eq("live after open", tree.live_count(&t), 1);

    // --- Children keep the order they were added in ---
    let is i64 as a = make(&t, &k, root, 1);
    let is i64 as b = make(&t, &k, root, 2);
    let is i64 as c = make(&t, &k, root, 3);
    check("children created", a != 0 && b != 0 && c != 0);
    eq("child count", tree.child_count(&t, root), 3);
    eq("first child", tree.first_child(&t, root), a);
    eq("last child", tree.last_child(&t, root), c);
    eq("a -> b", tree.next_sibling(&t, a), b);
    eq("b -> c", tree.next_sibling(&t, b), c);
    eq("c -> none", tree.next_sibling(&t, c), 0);
    eq("c <- b", tree.prev_sibling(&t, c), b);
    eq("a <- none", tree.prev_sibling(&t, a), 0);
    eq("parent of b", tree.parent(&t, b), root);
    check("kind is kept", cast(i64, tree.kind(&t, b)) == cast(i64, &k));

    // --- Per-widget data starts zeroed and belongs to one widget ---
    let is i64 as z = tree.create(&t, &k, root);
    eq("data starts zeroed", (cast(*Tagged, tree.data(&t, z))).tag, 0);
    eq("data is per widget", (cast(*Tagged, tree.data(&t, b))).tag, 2);

    // --- Destroying unlinks, calls destroy, and kills the handle ---
    reset_log();
    tree.destroy(&t, z);
    check("destroyed handle is invalid", tree.is_valid(&t, z) == 0);
    check("destroyed handle has no data", cast(i64, tree.data(&t, z)) == 0);
    eq("destroy called once", destroyed_count, 1);
    eq("child count after destroy", tree.child_count(&t, root), 3);

    reset_log();
    tree.destroy(&t, b);
    eq("a -> c after b goes", tree.next_sibling(&t, a), c);
    eq("c <- a after b goes", tree.prev_sibling(&t, c), a);

    // A slot that is reused hands out a different handle, so the old one keeps
    // failing instead of quietly naming the new widget. A tree with room for
    // the root and one widget leaves the second create no slot but the first.
    let is tree.Limits as one = small_limits(2);
    let is tree.Tree as solo = tree.open(&one);
    let is i64 as x = tree.create(&solo, &k, tree.root(&solo));
    tree.destroy(&solo, x);
    let is i64 as y = tree.create(&solo, &k, tree.root(&solo));
    check("reused slot was reused", (x & 4294967295) == (y & 4294967295));
    check("reused slot gets a new handle", y != 0 && y != x);
    check("old handle invalid after reuse", tree.is_valid(&solo, x) == 0);
    check("new handle valid", tree.is_valid(&solo, y));
    tree.close(&solo);

    // --- Destruction is recursive and post-order ---
    //
    //   a(1) ── a1(11) ── a11(111)
    //        └─ a2(12)
    reset_log();
    let is i64 as a1 = make(&t, &k, a, 11);
    let is i64 as a11 = make(&t, &k, a1, 111);
    let is i64 as a2 = make(&t, &k, a, 12);
    eq("live before subtree destroy", tree.live_count(&t), 6);
    tree.destroy(&t, a);
    eq("whole subtree destroyed", destroyed_count, 4);
    eq("post-order 1", destroyed_log[0], 111);
    eq("post-order 2", destroyed_log[1], 11);
    eq("post-order 3", destroyed_log[2], 12);
    eq("post-order 4", destroyed_log[3], 1);
    check("descendants invalid", tree.is_valid(&t, a11) == 0 && tree.is_valid(&t, a2) == 0);
    eq("live after subtree destroy", tree.live_count(&t), 2);
    eq("root keeps the rest", tree.first_child(&t, root), c);

    // --- The root is not the program's to destroy ---
    tree.destroy(&t, root);
    check("root survives destroy", tree.is_valid(&t, root));
    eq("root destroy is refused", cast(i64, tree.last_error(&t)), cast(i64, tree.BAD_ARGUMENT));
    tree.clear_error(&t);

    // --- Reparenting moves a subtree and refuses cycles ---
    let is i64 as p = make(&t, &k, root, 4);
    let is i64 as q = make(&t, &k, p, 5);
    let is i64 as r = make(&t, &k, q, 6);
    check("reparent ok", tree.reparent(&t, q, c));
    eq("q now under c", tree.parent(&t, q), c);
    eq("p lost its child", tree.child_count(&t, p), 0);
    eq("r came along", tree.parent(&t, r), q);
    check("into own descendant refused", tree.reparent(&t, c, r) == 0);
    eq("cycle error", cast(i64, tree.last_error(&t)), cast(i64, tree.BAD_ARGUMENT));
    tree.clear_error(&t);
    check("into itself refused", tree.reparent(&t, q, q) == 0);
    check("root cannot move", tree.reparent(&t, root, p) == 0);
    tree.clear_error(&t);

    // --- A stale handle is an error on the setup path, not a crash ---
    eq("create under dead parent", tree.create(&t, &k, z), 0);
    eq("dead parent error", cast(i64, tree.last_error(&t)), cast(i64, tree.INVALID_HANDLE));
    tree.clear_error(&t);

    // --- Flags ---
    check("visible by default", tree.is_visible(&t, q));
    check("enabled by default", tree.is_enabled(&t, r));
    tree.set_enabled(&t, c, 0);
    check("disabled itself", tree.is_enabled(&t, c) == 0);
    check("descendant disabled through ancestor", tree.is_enabled(&t, r) == 0);
    tree.set_enabled(&t, c, 1);
    check("re-enabled", tree.is_enabled(&t, r));
    tree.set_visible(&t, q, 0);
    check("hidden", tree.is_visible(&t, q) == 0);
    check("descendant hidden through ancestor", tree.is_visible(&t, r) == 0);
    tree.set_visible(&t, q, 1);

    // Layout invalidation climbs to the root, because a child that changes
    // size can change every ancestor's.
    tree.clear_layout(&t, root);
    tree.clear_layout(&t, c);
    tree.clear_layout(&t, q);
    tree.clear_layout(&t, r);
    tree.clear_layout(&t, p);
    check("a new widget needs layout", tree.needs_layout(&t, make(&t, &k, p, 7)));
    tree.clear_layout(&t, p);
    tree.invalidate_layout(&t, r);
    check("r needs layout", tree.needs_layout(&t, r));
    check("q needs layout", tree.needs_layout(&t, q));
    check("root needs layout", tree.needs_layout(&t, root));
    check("sibling subtree untouched", tree.needs_layout(&t, p) == 0);

    // --- Inserting at a place, and moving among siblings ---
    let is i64 as row = make(&t, &k, root, 100);
    let is i64 as x1 = make(&t, &k, row, 101);
    let is i64 as x3 = make(&t, &k, row, 103);
    let is i64 as x2 = tree.create_before(&t, &k, row, x3);
    let is i64 as x0 = tree.create_before(&t, &k, row, x1);
    let is i64 as x4 = tree.create_before(&t, &k, row, 0);
    check("inserted: first", tree.first_child(&t, row) == x0);
    check("inserted: in order", tree.next_sibling(&t, x0) == x1 && tree.next_sibling(&t, x1) == x2
          && tree.next_sibling(&t, x2) == x3 && tree.next_sibling(&t, x3) == x4);
    check("inserted: backwards too", tree.last_child(&t, row) == x4 && tree.prev_sibling(&t, x4) == x3
          && tree.prev_sibling(&t, x2) == x1 && tree.prev_sibling(&t, x0) == 0);
    eq("inserted: counted", tree.child_count(&t, row), 5);
    eq("index of the middle", tree.index_of(&t, x2), 2);
    eq("index of the first", tree.index_of(&t, x0), 0);
    check("child at an index", tree.child_at(&t, row, 3) == x3);
    check("child past the end", tree.child_at(&t, row, 5) == 0);
    check("child at a negative index", tree.child_at(&t, row, 0 - 1) == 0);
    eq("the root has no index", tree.index_of(&t, root), 0 - 1);

    tree.clear_layout(&t, row);
    check("moved to the front", tree.move_before(&t, x4, x0) == 1);
    check("moved to the front: first", tree.first_child(&t, row) == x4 && tree.next_sibling(&t, x4) == x0);
    check("moved to the front: the old last is gone from the end", tree.last_child(&t, row) == x3
          && tree.next_sibling(&t, x3) == 0);
    check("moved: the parent lays out again", tree.needs_layout(&t, row));
    eq("moved: still five", tree.child_count(&t, row), 5);
    check("moved to the end", tree.move_before(&t, x4, 0) == 1 && tree.last_child(&t, row) == x4
          && tree.first_child(&t, row) == x0);
    check("before itself: nothing moves", tree.move_before(&t, x2, x2) == 1 && tree.index_of(&t, x2) == 2);
    check("before its own next: nothing moves", tree.move_before(&t, x1, x2) == 1 && tree.index_of(&t, x1) == 1);

    // Into another parent, before one of its children.
    tree.clear_layout(&t, row);
    tree.clear_layout(&t, x0);
    check("inserted elsewhere", tree.insert(&t, x3, root, row) == 1);
    check("inserted elsewhere: the parent it left lays out again", tree.needs_layout(&t, row));
    check("inserted elsewhere: its siblings need not", tree.needs_layout(&t, x0) == 0);
    check("inserted elsewhere: under the new parent", tree.parent(&t, x3) == root
          && tree.next_sibling(&t, x3) == row);
    eq("inserted elsewhere: the old parent has one fewer", tree.child_count(&t, row), 4);

    // Refused: a place that is not among the parent's children, a cycle, the root.
    check("before a stranger: refused", tree.insert(&t, x1, root, x2) == 0);
    eq("before a stranger: the error", cast(i64, tree.last_error(&t)), cast(i64, tree.BAD_ARGUMENT));
    tree.clear_error(&t);
    check("into its own child: refused", tree.insert(&t, row, x1, 0) == 0);
    check("the root: refused", tree.insert(&t, root, row, 0) == 0);
    tree.clear_error(&t);
    eq("created before a stranger: refused", tree.create_before(&t, &k, row, x3), 0);
    eq("created before a stranger: the error", cast(i64, tree.last_error(&t)), cast(i64, tree.BAD_ARGUMENT));
    tree.clear_error(&t);
    tree.destroy(&t, x3);
    tree.destroy(&t, row);

    // --- What the application lends every widget ---
    let is [4]u8 as service;
    check("no text service at first", cast(i64, tree.text_service(&t)) == 0);
    let is i64 as lw = make(&t, &k, root, 41);
    let is i64 as target = make(&t, &k, root, 42);
    layout.run(&t, 100.0, 100.0);
    tree.set_text_service(&t, cast(*u8, &service));
    check("a text service lent", cast(i64, tree.text_service(&t)) == cast(i64, &service));
    check("text measured again, everywhere", tree.needs_layout(&t, root) == 1 && tree.needs_layout(&t, lw) == 1);

    // --- The window's animator, lent ---
    let is [4]u8 as animator;
    check("no animator at first", cast(i64, tree.animator(&t)) == 0);
    tree.set_animator(&t, cast(*u8, &animator));
    check("an animator lent", cast(i64, tree.animator(&t)) == cast(i64, &animator));

    // --- The focus asked for ---
    eq("none asked for at first", tree.focus_request(&t), 0);
    tree.request_focus(&t, lw);
    eq("asked for", tree.focus_request(&t), lw);
    eq("taken: once", tree.take_focus_request(&t), lw);
    eq("then none", tree.focus_request(&t), 0);

    // --- Which widget names which ---
    eq("labelled by nothing at first", tree.labelled_by(&t, target), 0);
    tree.set_labelled_by(&t, target, lw);
    eq("labelled by its label", tree.labelled_by(&t, target), lw);
    eq("the label by nothing", tree.labelled_by(&t, lw), 0);
    tree.destroy(&t, lw);
    eq("its label gone: nothing", tree.labelled_by(&t, target), 0);
    let is i64 as lw2 = make(&t, &k, root, 43);
    eq("not whatever took the label's place", tree.labelled_by(&t, target), 0);
    tree.set_labelled_by(&t, target, lw2);
    tree.set_labelled_by(&t, target, 0);
    eq("unlabelled", tree.labelled_by(&t, target), 0);
    tree.set_labelled_by(&t, lw, lw2);
    eq("a stale widget labels nothing", tree.labelled_by(&t, lw), 0);
    tree.destroy(&t, target);
    tree.destroy(&t, lw2);

    // --- Copying, through the program ---
    let is [4]u8 as who;
    tree.copy(&t, tree.CLIPBOARD, "lost", 4);
    eq("nothing to copy through: nothing happens", copied_n, 0);
    tree.set_clipboard(&t, fn_ptr(on_copy), cast(*u8, &who));
    tree.copy(&t, tree.PRIMARY, "abc", 3);
    check("copied through the program's function", copied_n == 3 && copied_which == tree.PRIMARY &&
          copied_text[0] == 97 && copied_text[2] == 99 && cast(i64, copied_user) == cast(i64, &who));

    // --- Text asked of the clipboard, through the program ---
    let is i64 as want_w = make(&t, &k, root, 44);
    tree.request_paste(&t, tree.CLIPBOARD, want_w);
    eq("nothing to ask through: nothing happens", asked_n, 0);
    tree.set_paste(&t, fn_ptr(on_paste), cast(*u8, &who));
    tree.request_paste(&t, tree.PRIMARY, want_w);
    check("asked through the program's function", asked_n == 1 && asked_which == tree.PRIMARY &&
          asked_w == want_w && cast(i64, asked_user) == cast(i64, &who));

    // --- Where text is being typed, for the input method ---
    eq("no text area at first", tree.text_area(&t), 0);
    tree.set_text_area(&t, want_w, math.rect.rect(10.0, 20.0, 1.0, 16.0));
    let is math.rect.Rect as area = tree.text_area_rect(&t);
    check("a text area: the widget, its caret", tree.text_area(&t) == want_w && area.x == 10.0 && area.y == 20.0 &&
          area.w == 1.0 && area.h == 16.0);
    tree.destroy(&t, want_w);
    eq("its widget gone: none", tree.text_area(&t), 0);
    tree.set_text_area(&t, 0, math.rect.rect_zero());
    eq("none", tree.text_area(&t), 0);

    // --- Capacity is declared, and running out is reported ---
    let is tree.Limits as tl = small_limits(3);
    let is tree.Tree as tiny = tree.open(&tl);
    let is i64 as t1 = tree.create(&tiny, &k, tree.root(&tiny));
    let is i64 as t2 = tree.create(&tiny, &k, tree.root(&tiny));
    let is i64 as t3 = tree.create(&tiny, &k, tree.root(&tiny));
    check("fits", t1 != 0 && t2 != 0);
    eq("full", t3, 0);
    eq("full error", cast(i64, tree.last_error(&tiny)), cast(i64, tree.FULL));
    tree.close(&tiny);

    // Data larger than the tree's declared per-widget size is refused.
    let is tree.Kind as big = widget.kind("big", 100000);
    eq("data too big", tree.create(&t, &big, root), 0);
    eq("data too big error", cast(i64, tree.last_error(&t)), cast(i64, tree.DATA_TOO_BIG));
    tree.clear_error(&t);

    // --- A destroy entry that destroys a sibling, not yet released ---
    let is tree.Kind as takes = widget.kind("taker", sizeof(Taker));
    takes.destroy = fn_ptr(taker_destroy);
    let is tree.Limits as tl = tree.limits_default();
    let is tree.Tree as tt = tree.open(&tl);
    let is i64 as box1 = tree.create(&tt, &takes, tree.root(&tt));
    let is i64 as later = tree.create(&tt, &takes, tree.root(&tt));
    tree.create(&tt, &takes, later);
    cast(*Taker, tree.data(&tt, box1)).other = later;
    taken = 0;
    tree.close(&tt);
    check("closed, a destroy entry taking a later sibling with it: no harm", taken == 1 && tree.is_open(&tt) == 0);
    let is tree.Tree as tu = tree.open(&tl);
    let is i64 as holder = tree.create(&tu, &takes, tree.root(&tu));
    let is i64 as first = tree.create(&tu, &takes, holder);
    let is i64 as second = tree.create(&tu, &takes, holder);
    cast(*Taker, tree.data(&tu, first)).other = second;
    taken = 0;
    tree.destroy(&tu, holder);
    check("destroyed, a child taking its later sibling: no harm", taken == 1 && tree.live_count(&tu) == 1);
    tree.close(&tu);

    // --- What a widget asks of its window ---
    check("no window lent: nobody asked", tree.window_op(&t, tree.WIN_CLOSE, 0.0, 0.0) == 0);
    tree.set_window_ops(&t, fn_ptr(on_window), cast(*u8, 0));
    check("a window lent: asked", tree.window_op(&t, tree.WIN_MENU, 3.0, 4.0) == 1 && asked_op == tree.WIN_MENU &&
          asked_x == 3.0 && asked_y == 4.0);

    // --- Watched: what an accessibility bridge hears ---
    let is tree.Limits as wl = tree.limits_default();
    let is tree.Tree as tw = tree.open(&wl);
    let is tree.Kind as plain = widget.kind("plain", 0);
    let is i64 as unseen = tree.create(&tw, &plain, tree.root(&tw));
    check("nobody watching: nothing told", watched == 0);
    tree.set_watch(&tw, fn_ptr(on_watch), cast(*u8, 0));
    let is i64 as box1 = tree.create(&tw, &plain, tree.root(&tw));
    let is i64 as leaf = tree.create(&tw, &plain, box1);
    check("made: told added", told(box1, tree.WATCH_ADDED) == 1 && told(leaf, tree.WATCH_ADDED) == 1);
    watched = 0;
    widget.changed(&tw, leaf, widget.CHANGED_PAINT);
    check("changed, its look: told", told(leaf, tree.WATCH_CHANGED) == 1);
    watched = 0;
    widget.changed(&tw, leaf, widget.CHANGED_LAYOUT);
    check("changed, its size: told", told(leaf, tree.WATCH_CHANGED) == 1);
    watched = 0;
    tree.set_visible(&tw, box1, 0);
    check("hidden: told, with what is under it", told(box1, tree.WATCH_STATE) == 1);
    watched = 0;
    tree.set_enabled(&tw, box1, 0);
    check("disabled: told, with what is under it", told(box1, tree.WATCH_STATE) == 1);
    watched = 0;
    tree.reparent(&tw, leaf, tree.root(&tw));
    check("moved elsewhere: told removed from where it was, added where it is",
          told(leaf, tree.WATCH_REMOVED) == 1 && told(leaf, tree.WATCH_ADDED) == 1);
    watched = 0;
    tree.destroy(&tw, box1);
    check("destroyed: told removed", told(box1, tree.WATCH_REMOVED) == 1 && watched == 1);
    watched = 0;
    tree.notify(&tw, leaf, tree.WATCH_FOCUS);
    check("told as asked", told(leaf, tree.WATCH_FOCUS) == 1);
    watched = 0;
    tree.notify_text(&tw, leaf, tree.TEXT_INSERTED, 4, "xyz", 3);
    check("its text changed: told, with the change", told(leaf, tree.WATCH_TEXT) == 1 && change_what == tree.TEXT_INSERTED &&
          change_at == 4 && change_n == 3 && change_first == 120);
    check("the change there only while told", cast(i64, tree.text_change(&tw)) == 0 && change_none == 0);
    tree.set_watch(&tw, cast(tree.WatchFn, 0), cast(*u8, 0));
    watched = 0;
    tree.destroy(&tw, unseen);
    tree.notify_text(&tw, leaf, tree.TEXT_DELETED, 0, "a", 1);
    check("no longer watched: nothing", watched == 0);
    tree.close(&tw);

    // --- close releases every widget still alive ---
    reset_log();
    let is i64 as live_before = tree.live_count(&t) - 1;   // everything but the root
    tree.close(&t);
    eq("close destroys what is left", destroyed_count, live_before);
    check("closed", tree.is_open(&t) == 0);

    if (fails != 0) { return 1; }
    io.printf("ui tree: all checks passed\n");
    return 0;
}
