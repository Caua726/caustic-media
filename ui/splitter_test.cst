// ui/splitter_test.cst — panes divided by handles the user drags.
use "std/io.cst" as io;
use "std/math.cst" as fm;
use "../math/math.cst" as math;
use "../window/keys.cst" as keys;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "event.cst" as event;
use "router.cst" as router;
use "signal.cst" as signal;
use "splitter.cst" as splitter;
use "../gpu/gpu.cst" as gpu;
use "../render/draw2d.cst" as draw2d;
use "../render/shapes2d.cst" as shapes;
use "damage.cst" as damage;
use "paint.cst" as paint;
use "painter.cst" as painter;
use "style.cst" as style;
use "access.cst" as access;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn near(name as *u8, got as f64, want as f64) as void {
    let is f64 as d = got - want;
    if (d > 0.000001 || d < 0.0 - 0.000001) {
        io.printf("FAIL: %s: got %d/1000, want %d/1000\n", name,
                  cast(i64, got * 1000.0), cast(i64, want * 1000.0));
        fails = fails + 1;
    }
}

fn is_rect(name as *u8, r as math.rect.Rect, x as f64, y as f64, w as f64, h as f64) as void {
    if (r.x != x || r.y != y || r.w != w || r.h != h) {
        io.printf("FAIL: %s: got %d,%d %dx%d, want %d,%d %dx%d\n", name,
                  cast(i64, r.x), cast(i64, r.y), cast(i64, r.w), cast(i64, r.h),
                  cast(i64, x), cast(i64, y), cast(i64, w), cast(i64, h));
        fails = fails + 1;
    }
}

// A pane: a preferred size, a minimum and a maximum, the same on both axes.
struct Pane {
    pref as f64;
    min  as f64;
    max  as f64;
    wrap as f64;   // above 0: that many square units of text, 10 a line, as wide as it is offered
}

fn pane_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Pane as d = cast(*Pane, data);
    out.min_w = d.min;
    out.min_h = d.min;
    out.pref_w = d.pref;
    out.pref_h = d.pref;
    out.max_w = d.max;
    out.max_h = d.max;
    if (d.wrap > 0.0) {
        let is f64 as width with mut = c.w;
        if (width >= layout.UNBOUNDED) { width = d.wrap; }
        out.pref_h = fm.ceil(d.wrap / width) * 10.0;
        out.min_h = out.pref_h;
    }
}

let is tree.Kind as pane_kind with mut;

fn pane(t as *tree.Tree, parent as i64, pref as f64) as i64 {
    let is i64 as k = tree.create(t, &pane_kind, parent);
    let is *Pane as d = cast(*Pane, tree.data(t, k));
    d.pref = pref;
    d.min = 0.0;
    d.max = layout.UNBOUNDED;
    return k;
}

fn pane_data(t as *tree.Tree, w as i64) as *Pane { return cast(*Pane, tree.data(t, w)); }

// A splitter exactly w by h at the window's top-left.
fn split(t as *tree.Tree, orientation as i32, w as f64, h as f64) as i64 {
    let is i64 as s = splitter.create(t, tree.root(t), orientation);
    layout.set_align(t, s, layout.START, layout.START);
    layout.set_min_size(t, s, w, h);
    layout.set_max_size(t, s, w, h);
    splitter.set_handle_size(t, s, 6.0);
    return s;
}

fn resize(t as *tree.Tree, s as i64, w as f64, h as f64) as void {
    layout.set_min_size(t, s, w, h);
    layout.set_max_size(t, s, w, h);
    layout.run(t, 800.0, 600.0);
}

let is i64 as moves with mut = 0;

fn on_moved(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    moves = moves + 1;
}

fn drag(t as *tree.Tree, r as *router.Router, x0 as f64, y0 as f64, x1 as f64, y1 as f64) as void {
    router.pointer_move(t, r, x0, y0, 0);
    router.pointer_button(t, r, 1, 1, x0, y0, 0);
    router.pointer_move(t, r, x1, y1, 0);
    router.pointer_button(t, r, 1, 0, x1, y1, 0);
    layout.run(t, 800.0, 600.0);
}

fn w_of(t as *tree.Tree, p as i64) as f64 { return layout.rect(t, p).w; }


// --- Told, and drawn ---

fn told_split() as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as s = split(&t, splitter.ROW, 206.0, 100.0);
    pane(&t, s, 100.0);
    pane(&t, s, 100.0);
    layout.run(&t, 800.0, 600.0);
    let is tree.Access as q;
    access.describe(&t, cast(*router.Router, 0), s, &q);
    check("told: a split pane, across, the handle's place its value", q.role == access.ROLE_SPLIT_PANE &&
          (q.states & access.HORIZONTAL) != 0 && q.has_value == 1 && q.value == 100.0 && q.min == 0.0 &&
          q.max == 206.0 && (q.actions & access.SET_VALUE) != 0 && (q.actions & access.INCREMENT) != 0);
    check("its handle moved by assistive technology", access.act(&t, s, access.SET_VALUE, 60.0) == 1);
    layout.run(&t, 800.0, 600.0);
    near("set: there", splitter.position(&t, s, 0), 60.0);
    access.act(&t, s, access.INCREMENT, 0.0);
    layout.run(&t, 800.0, 600.0);
    near("a step on", splitter.position(&t, s, 0), 60.0 + splitter.step(&t, s));
    access.act(&t, s, access.DECREMENT, 0.0);
    layout.run(&t, 800.0, 600.0);
    access.act(&t, s, access.DECREMENT, 0.0);
    layout.run(&t, 800.0, 600.0);
    near("two back", splitter.position(&t, s, 0), 60.0 - splitter.step(&t, s));
    let is i64 as c = split(&t, splitter.COLUMN, 100.0, 100.0);
    pane(&t, c, 40.0);
    pane(&t, c, 40.0);
    layout.run(&t, 800.0, 600.0);
    access.describe(&t, cast(*router.Router, 0), c, &q);
    check("a column: up and down", (q.states & access.VERTICAL) != 0);
    tree.close(&t);
}

// What bubbles out of a splitter: the presses and keys it does not take.
let is i64 as caught with mut = 0;

fn catch(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.phase == event.BUBBLE && (e.kind == event.KEY_DOWN || e.kind == event.POINTER_DOWN)) {
        caught = caught + 1;
        return 1;
    }
    return 0;
}

let is tree.Kind as catcher with mut;

fn more_split() as void {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as root = tree.root(&t);
    // Not a splitter: nothing, and no harm.
    splitter.set_step(&t, root, 5.0);
    splitter.set_grab(&t, root, 5.0);
    splitter.set_handle_size(&t, root, 5.0);
    check("not a splitter: nothing", splitter.step(&t, root) == 0.0 && splitter.current_handle(&t, root) == 0 &&
          splitter.handle_count(&t, root) == 0 && splitter.position(&t, root, 0) == 0.0 &&
          splitter.set_position(&t, root, 0, 10.0) == 0 && splitter.handle_rect(&t, root, 0).w == 0.0);
    // Inside something that catches what it does not take.
    catcher = widget.kind("catcher", 8);
    catcher.measure = fn_ptr(catch_measure);
    catcher.event = fn_ptr(catch);
    catcher.arrange = fn_ptr(catch_arrange);
    let is i64 as holder = tree.create(&t, &catcher, root);
    layout.set_align(&t, holder, layout.START, layout.START);
    let is i64 as s = splitter.create(&t, holder, splitter.ROW);
    layout.set_min_size(&t, s, 206.0, 100.0);
    layout.set_max_size(&t, s, 206.0, 100.0);
    let is i64 as a = pane(&t, s, 100.0);
    let is i64 as b = pane(&t, s, 100.0);
    layout.run(&t, 800.0, 600.0);
    splitter.set_handle_size(&t, s, 10.0);
    layout.run(&t, 800.0, 600.0);
    check("a handle's thickness set", splitter.handle_rect(&t, s, 0).w == 10.0);
    splitter.set_grab(&t, s, 8.0);
    let is math.rect.Rect as h = splitter.handle_rect(&t, s, 0);
    check("a press's reach set", router.hit(&t, h.x - 7.0, 50.0) == s && router.hit(&t, h.x - 9.0, 50.0) == a);
    splitter.set_step(&t, s, 25.0);
    splitter.set_step(&t, s, 0.0);
    check("a key's step set; none of nothing", splitter.step(&t, s) == 25.0);
    check("no handle past the last", splitter.handle_rect(&t, s, 1).w == 0.0 && splitter.set_position(&t, s, 1, 50.0) == 0);
    check("to where it is: no move", splitter.set_position(&t, s, 0, splitter.position(&t, s, 0)) == 0);
    // Keys.
    router.focus(&t, &r, s, 1);
    caught = 0;
    let is f64 as p0 = splitter.position(&t, s, 0);
    router.key(&t, &r, keys.RIGHT, 0, 1, 0, 10);
    layout.run(&t, 800.0, 600.0);
    near("right: a step", splitter.position(&t, s, 0), p0 + 25.0);
    router.key(&t, &r, keys.HOME, 0, 1, 0, 20);
    router.key(&t, &r, keys.END, 0, 1, 0, 30);
    router.key(&t, &r, keys.F8, 0, 1, 0, 40);
    check("its keys its own", caught == 0);
    router.key(&t, &r, keys.RIGHT, keys.MOD_CONTROL, 1, 0, 50);
    router.key(&t, &r, keys.X, 0, 1, 0, 60);
    check("others passed on", caught == 2);
    // A press in a pane: on up.
    caught = 0;
    router.pointer_button(&t, &r, 1, 1, 20.0, 50.0, 70);
    router.pointer_button(&t, &r, 1, 0, 20.0, 50.0, 80);
    check("a press in a pane: passed on", caught == 1);
    // A key in a pane: on up, past the splitter.
    tree.set_focusable(&t, b, 1);
    router.focus(&t, &r, b, 1);
    caught = 0;
    router.key(&t, &r, keys.RIGHT, 0, 1, 0, 90);
    check("a key in a pane: not the splitter's", caught == 1);
    tree.destroy(&t, holder);
    // One pane: no handle.
    let is i64 as one = splitter.create(&t, root, splitter.ROW);
    pane(&t, one, 50.0);
    layout.run(&t, 800.0, 600.0);
    check("one pane: no handle", splitter.handle_count(&t, one) == 0);
    tree.destroy(&t, one);
    // Its maximum: the panes' and the handles'.
    let is i64 as m = splitter.create(&t, root, splitter.ROW);
    splitter.set_handle_size(&t, m, 6.0);
    let is i64 as m1 = pane(&t, m, 50.0);
    let is i64 as m2 = pane(&t, m, 50.0);
    pane_data(&t, m1).max = 100.0;
    pane_data(&t, m2).max = 100.0;
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ms;
    layout.measure(&t, m, &free, &ms);
    check("as wide at most as its panes and handle", ms.max_w == 206.0 && ms.pref_w == 106.0);
    tree.destroy(&t, m);
    // A column of three: measured down, its handles, its keys, its reach.
    let is i64 as c = splitter.create(&t, root, splitter.COLUMN);
    layout.set_align(&t, c, layout.START, layout.START);
    splitter.set_handle_size(&t, c, 6.0);
    let is i64 as c1 = pane(&t, c, 40.0);
    let is i64 as c2 = pane(&t, c, 40.0);
    pane(&t, c, 40.0);
    pane_data(&t, c1).min = 30.0;
    pane_data(&t, c2).min = 30.0;
    layout.measure(&t, c, &free, &ms);
    check("a column: as tall as its panes and handles", ms.pref_h == 132.0 && ms.pref_w == 40.0);
    layout.run(&t, 800.0, 600.0);
    let is math.rect.Rect as h1 = splitter.handle_rect(&t, c, 1);
    check("its second handle under the second pane", h1.y == 86.0 && h1.h == 6.0);
    check("held to its panes' least heights", splitter.set_position(&t, c, 0, 10.0) == 1);
    layout.run(&t, 800.0, 600.0);
    near("not past the first's least height", splitter.position(&t, c, 0), 30.0);
    splitter.set_grab(&t, c, 4.0);
    let is math.rect.Rect as h0 = splitter.handle_rect(&t, c, 0);
    check("a column's reach: above its handle too", router.hit(&t, 20.0, h0.y - 3.0) == c);
    router.focus(&t, &r, c, 1);
    let is f64 as q0 = splitter.position(&t, c, 0);
    router.key(&t, &r, keys.DOWN, 0, 1, 0, 100);
    layout.run(&t, 800.0, 600.0);
    router.key(&t, &r, keys.UP, 0, 1, 0, 110);
    router.key(&t, &r, keys.UP, 0, 1, 0, 120);
    layout.run(&t, 800.0, 600.0);
    near("a column: down and up twice", splitter.position(&t, c, 0), q0 + splitter.step(&t, c) - splitter.step(&t, c));
    tree.destroy(&t, c);
    // Right to left: the handle as thick.
    let is i64 as rt = splitter.create(&t, root, splitter.ROW);
    layout.set_align(&t, rt, layout.START, layout.START);
    splitter.set_handle_size(&t, rt, 6.0);
    pane(&t, rt, 50.0);
    pane(&t, rt, 50.0);
    layout.set_direction(&t, rt, layout.RTL);
    layout.run(&t, 800.0, 600.0);
    check("right to left: the handle as thick", splitter.handle_rect(&t, rt, 0).w == 6.0);
    pane(&t, rt, 50.0);
    layout.run(&t, 800.0, 600.0);
    check("right to left, three: each handle as thick", splitter.handle_rect(&t, rt, 0).w == 6.0 &&
          splitter.handle_rect(&t, rt, 1).w == 6.0);
    tree.destroy(&t, rt);
    // Text that wraps in a pane: measured at the width the pane will get.
    let is i64 as wr = splitter.create(&t, root, splitter.ROW);
    splitter.set_handle_size(&t, wr, 6.0);
    pane(&t, wr, 100.0);
    let is i64 as wp = pane(&t, wr, 100.0);
    pane(&t, wr, 100.0);
    pane_data(&t, wp).wrap = 1050.0;
    let is geom.Constraint as at312 = geom.constraint(312.0, layout.UNBOUNDED);
    layout.measure(&t, wr, &at312, &ms);
    check("a row: a pane's wrapped text measured at its share", ms.pref_h == 110.0);
    tree.destroy(&t, wr);
    let is i64 as wc = splitter.create(&t, root, splitter.COLUMN);
    splitter.set_handle_size(&t, wc, 6.0);
    let is i64 as wq = pane(&t, wc, 40.0);
    pane(&t, wc, 40.0);
    pane_data(&t, wq).wrap = 1000.0;
    let is geom.Constraint as at50 = geom.constraint(50.0, layout.UNBOUNDED);
    layout.measure(&t, wc, &at50, &ms);
    check("a column: a pane's wrapped text measured at its width", ms.pref_h == 200.0 + 40.0 + 6.0);
    layout.set_align(&t, wc, layout.START, layout.START);
    layout.set_min_size(&t, wc, 50.0, 300.0);
    layout.set_max_size(&t, wc, 50.0, 300.0);
    layout.run(&t, 800.0, 600.0);
    splitter.set_position(&t, wc, 0, 0.0);
    layout.run(&t, 800.0, 600.0);
    near("a column held to a pane's least height, not its width", splitter.position(&t, wc, 0), 200.0);
    tree.destroy(&t, wc);
    // A column's keys, far from its panes' least heights.
    let is i64 as kc = splitter.create(&t, root, splitter.COLUMN);
    layout.set_align(&t, kc, layout.START, layout.START);
    splitter.set_handle_size(&t, kc, 6.0);
    splitter.set_step(&t, kc, 10.0);
    pane(&t, kc, 60.0);
    pane(&t, kc, 60.0);
    layout.run(&t, 800.0, 600.0);
    router.focus(&t, &r, kc, 1);
    router.key(&t, &r, keys.DOWN, 0, 1, 0, 200);
    layout.run(&t, 800.0, 600.0);
    router.key(&t, &r, keys.DOWN, 0, 1, 0, 210);
    layout.run(&t, 800.0, 600.0);
    router.key(&t, &r, keys.UP, 0, 1, 0, 220);
    layout.run(&t, 800.0, 600.0);
    near("a column: down twice, up once", splitter.position(&t, kc, 0), 70.0);
    tree.destroy(&t, kc);
    // One pane, no handle: its keys go on.
    let is i64 as holder2 = tree.create(&t, &catcher, root);
    let is i64 as lone = splitter.create(&t, holder2, splitter.ROW);
    pane(&t, lone, 50.0);
    layout.run(&t, 800.0, 600.0);
    router.focus(&t, &r, lone, 1);
    caught = 0;
    router.key(&t, &r, keys.RIGHT, 0, 1, 0, 300);
    check("no handle: its keys passed on", caught == 1);
    tree.close(&t);
}

fn catch_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.overlay_measure(t, w, c, out);
}

fn catch_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is i64 as W with imut = 120;
let is i64 as H with imut = 60;
let is [7200]i32 as px with mut;

fn lum(x as f64, y as f64) as i64 {
    let is i64 as i = (cast(i64, y) * W + cast(i64, x)) * 4;
    let is *u8 as b = cast(*u8, &px);
    return cast(i64, b[i]) + cast(i64, b[i + 1]) + cast(i64, b[i + 2]);
}

fn same_as(x as f64, y as f64, col as math.color.Color) as i32 {
    let is i64 as i = (cast(i64, y) * W + cast(i64, x)) * 4;
    let is *u8 as b = cast(*u8, &px);
    let is i64 as dr with mut = cast(i64, b[i]) - cast(i64, col.r * 255.0 + 0.5);
    let is i64 as dg with mut = cast(i64, b[i + 1]) - cast(i64, col.g * 255.0 + 0.5);
    let is i64 as db with mut = cast(i64, b[i + 2]) - cast(i64, col.b * 255.0 + 0.5);
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= 2 && dg <= 2 && db <= 2);
}

fn drawn_split() as void {
    let is style.Theme as th = style.light();
    let is gpu.device.Device as dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    let is i64 as target = gpu.texture.create(&dv, &td);
    let is i64 as cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &th);
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as s = split(&t, splitter.ROW, 106.0, 50.0);
    pane(&t, s, 50.0);
    pane(&t, s, 50.0);
    let is i32 as round with mut = 0;
    let is f64 as mid = 53.0;
    let is i64 as rest with mut = 0;
    while (round < 3) {
        if (round == 1) {
            router.pointer_move(&t, &r, mid, 25.0, 10);
            router.pointer_button(&t, &r, 1, 1, mid, 25.0, 10);
        }
        if (round == 2) {
            router.pointer_button(&t, &r, 1, 0, mid, 25.0, 20);
            router.focus(&t, &r, s, 1);
        }
        layout.run(&t, cast(f64, W), cast(f64, H));
        let is math.rect.Rect as all = math.rect.rect(0.0, 0.0, cast(f64, W), cast(f64, H));
        tree.damage_add(&t, &all);
        damage.collect(&t);
        draw2d.begin(&c, cast(f64, W), cast(f64, H), 1.0);
        let is paint.Options as o = paint.options(&th);
        o.router = &r;
        paint.frame(&t, &c, &o, cast(*paint.Stats, 0));
        gpu.command.begin(&dv, cmd);
        let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
        gpu.command.begin_pass(&dv, cmd, &ps);
        draw2d.flush(&c, cmd);
        gpu.command.end_pass(&dv, cmd);
        gpu.command.end(&dv, cmd);
        gpu.command.submit(&dv, cmd);
        gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
        tree.damage_clear(&t);
        if (round == 0) {
            rest = lum(mid, 25.0);
            check("drawn: a line down the handle's middle", same_as(mid, 25.0, th.palette.separator) == 1 &&
                  same_as(mid - 2.0, 25.0, th.palette.window_bg) == 1);
        }
        if (round == 1) { check("held: in the accent colour", same_as(mid, 25.0, th.palette.accent) == 1); }
        if (round == 2) {
            check("focused by keyboard: a ring round the current handle", same_as(50.0, 25.0, th.palette.focus) == 1 &&
                  same_as(1.0, 25.0, th.palette.focus) == 0);
        }
        round = round + 1;
    }
    // Three panes: a line down each handle.
    router.focus(&t, &r, 0, 0);
    pane(&t, s, 50.0);
    layout.set_min_size(&t, s, 116.0, 50.0);
    layout.set_max_size(&t, s, 116.0, 50.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as all2 = math.rect.rect(0.0, 0.0, cast(f64, W), cast(f64, H));
    tree.damage_add(&t, &all2);
    damage.collect(&t);
    draw2d.begin(&c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o2 = paint.options(&th);
    paint.frame(&t, &c, &o2, cast(*paint.Stats, 0));
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps2 = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps2);
    draw2d.flush(&c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    let is math.rect.Rect as k0 = splitter.handle_rect(&t, s, 0);
    let is math.rect.Rect as k1 = splitter.handle_rect(&t, s, 1);
    check("three panes: a line down each handle", same_as(fm.floor(k0.x + k0.w / 2.0), 25.0, th.palette.separator) == 1 &&
          same_as(fm.floor(k1.x + k1.w / 2.0), 25.0, th.palette.separator) == 1);
    tree.close(&t);
}

fn main() as i32 {
    pane_kind = widget.kind("pane", sizeof(Pane));
    pane_kind.measure = fn_ptr(pane_measure);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is router.Router as r = router.init(router.settings_default());

    // --- Measured as the panes in a row, with the handles between ---
    let is i64 as free = splitter.create(&t, root, splitter.ROW);
    splitter.set_handle_size(&t, free, 6.0);
    let is i64 as f0 = pane(&t, free, 100.0);
    let is i64 as f1 = pane(&t, free, 80.0);
    pane_data(&t, f0).min = 30.0;
    pane_data(&t, f1).min = 20.0;
    let is geom.Constraint as unb = geom.unbounded();
    let is geom.Size as fs;
    layout.measure(&t, free, &unb, &fs);
    near("measure: minimum is the panes' and a handle", fs.min_w, 56.0);
    near("measure: preferred too", fs.pref_w, 186.0);
    near("measure: across, the largest pane", fs.pref_h, 100.0);
    // Laid out — every pane given a size and that size kept — it still
    // measures as its panes would like, not as they were left.
    layout.run(&t, 800.0, 600.0);
    layout.invalidate(&t, free);
    layout.measure(&t, free, &unb, &fs);
    near("measure: kept sizes are not preferences", fs.pref_w, 186.0);
    tree.destroy(&t, free);

    // --- Room nobody stretches for is shared equally ---
    let is i64 as s = split(&t, splitter.ROW, 306.0, 100.0);
    let is i64 as a = pane(&t, s, 100.0);
    let is i64 as b = pane(&t, s, 100.0);
    layout.run(&t, 800.0, 600.0);
    check("one handle between two panes", splitter.handle_count(&t, s) == 1);
    is_rect("equal: the first pane", layout.rect(&t, a), 0.0, 0.0, 150.0, 100.0);
    is_rect("equal: the second, after the handle", layout.rect(&t, b), 156.0, 0.0, 150.0, 100.0);
    is_rect("the handle between them", splitter.handle_rect(&t, s, 0), 150.0, 0.0, 6.0, 100.0);

    // --- The pointer over a handle: arrows to resize the panes beside ---
    router.pointer_move(&t, &r, 153.0, 50.0, 0);
    check("over the handle: columns resize", router.pointer_shape(&t, &r) == tree.SHAPE_COL_RESIZE);
    router.pointer_move(&t, &r, 148.0, 50.0, 0);
    check("within its reach: the same", router.pointer_shape(&t, &r) == tree.SHAPE_COL_RESIZE);
    router.pointer_move(&t, &r, 50.0, 50.0, 0);
    check("over a pane: the default", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    router.pointer_move(&t, &r, 153.0, 50.0, 0);
    router.pointer_button(&t, &r, 1, 1, 153.0, 50.0, 0);
    router.pointer_move(&t, &r, 153.0, 300.0, 0);
    check("held, wherever the pointer went: the same", router.pointer_shape(&t, &r) == tree.SHAPE_COL_RESIZE);
    router.pointer_move(&t, &r, 153.0, 50.0, 0);
    router.pointer_button(&t, &r, 1, 0, 153.0, 50.0, 0);
    layout.run(&t, 800.0, 600.0);
    near("position: where the handle starts", splitter.position(&t, s, 0), 150.0);

    // --- Dragging the handle: one pane grows, the other gives ---
    signal.connect(&t, s, signal.VALUE_CHANGED, fn_ptr(on_moved), cast(*u8, 0));
    drag(&t, &r, 153.0, 50.0, 183.0, 50.0);
    near("dragged: the first grew", w_of(&t, a), 180.0);
    near("dragged: the second gave it", w_of(&t, b), 120.0);
    check("dragged: told", moves > 0);
    check("dragged: released", router.capture(&r) == 0);
    router.pointer_move(&t, &r, 186.0, 50.0, 0);
    layout.run(&t, 800.0, 600.0);
    near("released: passing over the handle drags nothing", w_of(&t, a), 180.0);

    // Not past a minimum, not past a maximum.
    pane_data(&t, b).min = 50.0;
    layout.invalidate(&t, b);
    layout.run(&t, 800.0, 600.0);
    drag(&t, &r, 183.0, 50.0, 400.0, 50.0);
    near("past the second's minimum: it keeps it", w_of(&t, b), 50.0);
    near("past the second's minimum: the first takes the rest", w_of(&t, a), 250.0);
    pane_data(&t, a).max = 220.0;
    layout.invalidate(&t, a);
    layout.run(&t, 800.0, 600.0);
    near("a maximum lowered under it: the first at it", w_of(&t, a), 220.0);
    drag(&t, &r, 223.0, 50.0, 300.0, 50.0);
    near("past the first's maximum: it stays at it", w_of(&t, a), 220.0);
    pane_data(&t, a).max = layout.UNBOUNDED;
    pane_data(&t, b).min = 0.0;
    layout.invalidate(&t, a);
    layout.invalidate(&t, b);
    splitter.set_position(&t, s, 0, 180.0);
    layout.run(&t, 800.0, 600.0);
    near("set_position: the handle where asked", splitter.position(&t, s, 0), 180.0);
    near("set_position: the first pane up to it", w_of(&t, a), 180.0);

    // --- A larger window keeps the sizes and shares out the difference ---
    resize(&t, s, 406.0, 100.0);
    near("wider, nobody stretching: half each, first", w_of(&t, a), 230.0);
    near("wider, nobody stretching: half each, second", w_of(&t, b), 170.0);
    layout.set_stretch(&t, b, 1.0, 0.0);
    resize(&t, s, 506.0, 100.0);
    near("wider, the second stretching: the first keeps its size", w_of(&t, a), 230.0);
    near("wider, the second stretching: it takes it all", w_of(&t, b), 270.0);
    resize(&t, s, 306.0, 100.0);
    near("narrower: both give in proportion, first", w_of(&t, a), 230.0 - 200.0 * 230.0 / 500.0);
    near("narrower: both give in proportion, second", w_of(&t, b), 270.0 - 200.0 * 270.0 / 500.0);

    // --- The grab area reaches past the handle; beyond it is the pane's ---
    check("on the handle: the splitter's", router.hit(&t, splitter.position(&t, s, 0) + 3.0, 50.0) == s);
    check("just before it: still the splitter's",
          router.hit(&t, splitter.position(&t, s, 0) - 2.0, 50.0) == s);
    check("further: the pane's", router.hit(&t, splitter.position(&t, s, 0) - 10.0, 50.0) == a);
    tree.destroy(&t, s);

    // --- Three panes: a handle moves only its two neighbours ---
    let is i64 as s3 = split(&t, splitter.ROW, 312.0, 50.0);
    let is i64 as p0 = pane(&t, s3, 100.0);
    let is i64 as p1 = pane(&t, s3, 100.0);
    let is i64 as p2 = pane(&t, s3, 100.0);
    layout.run(&t, 800.0, 600.0);
    check("three panes, two handles", splitter.handle_count(&t, s3) == 2);
    near("three: the second handle", splitter.position(&t, s3, 1), 206.0);
    drag(&t, &r, 209.0, 25.0, 229.0, 25.0);
    near("second handle: the first pane untouched", w_of(&t, p0), 100.0);
    near("second handle: the middle grew", w_of(&t, p1), 120.0);
    near("second handle: the last gave", w_of(&t, p2), 80.0);
    // Its neighbours' limits stop it, and nothing else is touched.
    pane_data(&t, p2).min = 30.0;
    layout.invalidate(&t, p2);
    layout.run(&t, 800.0, 600.0);
    drag(&t, &r, 229.0, 25.0, 400.0, 25.0);
    near("limited by the last's minimum: the last at it", w_of(&t, p2), 30.0);
    near("limited by the last's minimum: the first untouched", w_of(&t, p0), 100.0);
    pane_data(&t, p1).max = 140.0;
    layout.invalidate(&t, p1);
    layout.run(&t, 800.0, 600.0);
    // Lowering the maximum under the middle's size shared the difference out;
    // dragging against it from there moves nothing.
    near("a maximum lowered under the middle: it is at it", w_of(&t, p1), 140.0);
    let is f64 as first_then = w_of(&t, p0);
    let is f64 as h1 = splitter.position(&t, s3, 1);
    drag(&t, &r, h1 + 3.0, 25.0, 400.0, 25.0);
    near("limited by the middle's maximum: the middle at it", w_of(&t, p1), 140.0);
    near("limited by the middle's maximum: the first untouched", w_of(&t, p0), first_then);
    pane_data(&t, p2).min = 0.0;
    pane_data(&t, p1).max = layout.UNBOUNDED;
    layout.invalidate(&t, p2);
    layout.invalidate(&t, p1);
    layout.run(&t, 800.0, 600.0);
    splitter.set_position(&t, s3, 0, 100.0);
    layout.run(&t, 800.0, 600.0);
    splitter.set_position(&t, s3, 1, 226.0);
    layout.run(&t, 800.0, 600.0);
    near("back: the first", w_of(&t, p0), 100.0);
    near("back: the middle", w_of(&t, p1), 120.0);
    // Towards the start, the first pane's minimum stops it.
    pane_data(&t, p0).min = 40.0;
    layout.invalidate(&t, p0);
    layout.run(&t, 800.0, 600.0);
    let is f64 as last_then = w_of(&t, p2);
    drag(&t, &r, 103.0, 25.0, 0.0, 25.0);
    near("limited by the first's minimum: the first at it", w_of(&t, p0), 40.0);
    near("limited by the first's minimum: the last untouched", w_of(&t, p2), last_then);
    pane_data(&t, p0).min = 0.0;
    layout.invalidate(&t, p0);
    splitter.set_position(&t, s3, 0, 100.0);
    layout.run(&t, 800.0, 600.0);
    splitter.set_position(&t, s3, 1, 226.0);
    layout.run(&t, 800.0, 600.0);
    drag(&t, &r, 229.0, 25.0, 229.0, 25.0);

    // A hidden pane is not there, and nor is its handle.
    tree.set_visible(&t, p1, 0);
    layout.run(&t, 800.0, 600.0);
    check("hidden: one handle", splitter.handle_count(&t, s3) == 1);
    near("hidden: the others meet at the handle", layout.rect(&t, p2).x, w_of(&t, p0) + 6.0);
    near("hidden: and fill the splitter", w_of(&t, p0) + 6.0 + w_of(&t, p2), 312.0);
    tree.set_visible(&t, p1, 1);
    layout.run(&t, 800.0, 600.0);

    // --- The keyboard: arrows move the current handle, F8 picks the next ---
    router.focus(&t, &r, s3, 1);
    check("the splitter takes focus", router.focused(&t, &r) == s3);
    check("the handle last dragged is current", splitter.current_handle(&t, s3) == 1);
    router.key(&t, &r, keys.F8, 0, 1, 0, 0);
    check("f8: round to the first", splitter.current_handle(&t, s3) == 0);
    let is f64 as before = splitter.position(&t, s3, 0);
    router.key(&t, &r, keys.RIGHT, 0, 1, 0, 0);
    layout.run(&t, 800.0, 600.0);
    near("right: a step", splitter.position(&t, s3, 0), before + splitter.step(&t, s3));
    router.key(&t, &r, keys.LEFT, 0, 1, 0, 0);
    layout.run(&t, 800.0, 600.0);
    near("left: back", splitter.position(&t, s3, 0), before);
    router.key(&t, &r, keys.F8, 0, 1, 0, 0);
    check("f8: the next handle", splitter.current_handle(&t, s3) == 1);
    router.key(&t, &r, keys.F8, keys.MOD_SHIFT, 1, 0, 0);
    check("shift+f8: the previous", splitter.current_handle(&t, s3) == 0);
    router.key(&t, &r, keys.F8, keys.MOD_SHIFT, 1, 0, 0);
    check("shift+f8: round to the last", splitter.current_handle(&t, s3) == 1);
    router.key(&t, &r, keys.HOME, 0, 1, 0, 0);
    layout.run(&t, 800.0, 600.0);
    near("home: the middle pane to nothing", w_of(&t, p1), 0.0);
    router.key(&t, &r, keys.END, 0, 1, 0, 0);
    layout.run(&t, 800.0, 600.0);
    near("end: the last pane to nothing", w_of(&t, p2), 0.0);
    check("across the axis: not the splitter's", router.key(&t, &r, keys.DOWN, 0, 1, 0, 0) == 0);
    // Focus inside a pane: the arrows are the pane's, not the splitter's.
    tree.set_focusable(&t, p2, 1);
    router.focus(&t, &r, p2, 1);
    let is f64 as kept = splitter.position(&t, s3, 1);
    router.key(&t, &r, keys.LEFT, 0, 1, 0, 0);
    layout.run(&t, 800.0, 600.0);
    near("focus in a pane: the handle stays", splitter.position(&t, s3, 1), kept);
    router.focus(&t, &r, 0, 0);
    tree.destroy(&t, s3);

    // --- F8 goes round the handles both ways ---
    let is i64 as s4 = split(&t, splitter.ROW, 318.0, 50.0);
    pane(&t, s4, 75.0);
    pane(&t, s4, 75.0);
    pane(&t, s4, 75.0);
    pane(&t, s4, 75.0);
    layout.run(&t, 800.0, 600.0);
    router.focus(&t, &r, s4, 1);
    router.key(&t, &r, keys.F8, keys.MOD_SHIFT, 1, 0, 0);
    check("four panes: shift+f8 from the first is the last", splitter.current_handle(&t, s4) == 2);
    router.key(&t, &r, keys.F8, keys.MOD_SHIFT, 1, 0, 0);
    check("four panes: shift+f8 again, the middle", splitter.current_handle(&t, s4) == 1);
    router.focus(&t, &r, 0, 0);
    tree.destroy(&t, s4);

    // --- Right to left: the first pane on the right, positions from there ---
    let is i64 as sr = split(&t, splitter.ROW, 306.0, 100.0);
    layout.set_direction(&t, sr, layout.RTL);
    let is i64 as ra = pane(&t, sr, 200.0);
    let is i64 as rb = pane(&t, sr, 100.0);
    layout.run(&t, 800.0, 600.0);
    is_rect("rtl: the first pane on the right", layout.rect(&t, ra), 106.0, 0.0, 200.0, 100.0);
    is_rect("rtl: the handle between", splitter.handle_rect(&t, sr, 0), 100.0, 0.0, 6.0, 100.0);
    near("rtl: the position counts from the right", splitter.position(&t, sr, 0), 200.0);
    router.focus(&t, &r, sr, 1);
    router.key(&t, &r, keys.RIGHT, 0, 1, 0, 0);
    layout.run(&t, 800.0, 600.0);
    near("rtl: right moves the handle right, the first shrinks", w_of(&t, ra), 200.0 - splitter.step(&t, sr));
    router.key(&t, &r, keys.LEFT, 0, 1, 0, 0);
    layout.run(&t, 800.0, 600.0);
    router.focus(&t, &r, 0, 0);
    // START is mirrored too: the splitter sits at the window's right edge.
    let is f64 as wx = layout.window_rect(&t, sr).x;
    near("rtl: the splitter at the right", wx, 800.0 - 306.0);
    drag(&t, &r, wx + 103.0, 50.0, wx + 133.0, 50.0);
    near("rtl: dragged right, the first shrank", w_of(&t, ra), 170.0);
    near("rtl: and the second grew", w_of(&t, rb), 130.0);
    tree.destroy(&t, sr);

    // --- A column divides the height ---
    let is i64 as sc = split(&t, splitter.COLUMN, 100.0, 206.0);
    let is i64 as ca = pane(&t, sc, 50.0);
    let is i64 as cb = pane(&t, sc, 50.0);
    layout.run(&t, 800.0, 600.0);
    is_rect("column: the top pane", layout.rect(&t, ca), 0.0, 0.0, 100.0, 100.0);
    is_rect("column: the handle", splitter.handle_rect(&t, sc, 0), 0.0, 100.0, 100.0, 6.0);
    router.pointer_move(&t, &r, 50.0, 103.0, 0);
    check("column: over the handle, rows resize", router.pointer_shape(&t, &r) == tree.SHAPE_ROW_RESIZE);
    drag(&t, &r, 50.0, 103.0, 50.0, 73.0);
    near("column: dragged up, the top shrank", layout.rect(&t, ca).h, 70.0);
    near("column: the bottom grew", layout.rect(&t, cb).h, 130.0);
    tree.destroy(&t, sc);

    tree.close(&t);
    told_split();
    drawn_split();
    more_split();
    if (fails > 0) {
        io.printf("splitter: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("splitter: all checks passed\n");
    return 0;
}
