// ui/model_test.cst — the interface lists, trees and tables read their data
// through, and the notifications that keep them current.
use "std/io.cst" as io;
use "model.cst" as model;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL: %s: got %d, want %d\n", name, cast(i32, got), cast(i32, want));
        fails = fails + 1;
    }
}

// --- A small file tree, ids chosen by the program ---
//
//   1 docs        2 music
//   ├─ 3 a.txt
//   └─ 4 b.txt
//
// It answers count, row_id, cell, columns, parent_of and set_cell, and leaves
// index_of and has_children to the defaults.
struct Files {
    checked3 as i64;
}

fn files_count(self as *u8, parent as i64) as i64 {
    if (parent == 0) { return 2; }
    if (parent == 1) { return 2; }
    return 0;
}

fn files_row_id(self as *u8, parent as i64, index as i64) as i64 {
    if (parent == 0) { return index + 1; }
    if (parent == 1) { return index + 3; }
    return 0;
}

fn files_parent_of(self as *u8, id as i64) as i64 {
    if (id == 3 || id == 4) { return 1; }
    return 0;
}

fn files_columns(self as *u8) as i64 { return 2; }

fn files_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    let is *Files as f = cast(*Files, self);
    if (role == model.TEXT && column == 0) {
        if (id == 1) { *out = model.text("docs", 4); return 1; }
        if (id == 2) { *out = model.text("music", 5); return 1; }
        if (id == 3) { *out = model.text("a.txt", 5); return 1; }
        if (id == 4) { *out = model.text("b.txt", 5); return 1; }
    }
    if (role == model.CHECKED && id == 3) { *out = model.boolean(cast(i32, f.checked3)); return 1; }
    return 0;
}

fn files_set_cell(self as *u8, id as i64, column as i64, role as i32, v as *model.Value) as i64 {
    let is *Files as f = cast(*Files, self);
    if (role == model.CHECKED && id == 3) { f.checked3 = v.i; return 1; }
    return 0;
}

// --- A flat list answering only what is required ---
fn flat_count(self as *u8, parent as i64) as i64 {
    if (parent == 0) { return 3; }
    return 0;
}

fn flat_row_id(self as *u8, parent as i64, index as i64) as i64 { return 100 + index; }

fn flat_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    if (role == model.TEXT) { *out = model.integer(id); return 1; }
    return 0;
}

// --- Observers record what they are told ---
let is [32]i64 as seen with mut;
let is i64 as nseen with mut = 0;

fn watch(user as *u8, c as *model.Change) as void {
    if (nseen + 4 <= 32) {
        seen[nseen] = cast(i64, user) * 100 + cast(i64, c.kind);
        seen[nseen + 1] = c.parent;
        seen[nseen + 2] = c.first;
        seen[nseen + 3] = c.count;
        nseen = nseen + 4;
    }
}

let is *model.Model as self_removing with mut;
let is i64 as self_id with mut = 0;

fn watch_once(user as *u8, c as *model.Change) as void {
    watch(user, c);
    model.unobserve(self_removing, self_id);
}

fn main() as i32 {
    let is Files as data;
    data.checked3 = 0;
    let is model.Model as m = model.make(cast(*u8, &data), fn_ptr(files_count), fn_ptr(files_row_id),
                                         fn_ptr(files_cell));
    m.columns = fn_ptr(files_columns);
    m.parent_of = fn_ptr(files_parent_of);
    m.set_cell = fn_ptr(files_set_cell);

    // --- Walking it ---
    eq("top-level rows", model.count(&m, 0), 2);
    eq("children of docs", model.count(&m, 1), 2);
    eq("second child of docs", model.row_id(&m, 1, 1), 4);
    eq("columns", model.columns(&m), 2);
    eq("parent of a.txt", model.parent_of(&m, 3), 1);
    eq("index found by search", model.index_of(&m, 4), 1);
    eq("index of a top row", model.index_of(&m, 2), 1);
    eq("unknown id", model.index_of(&m, 77), 0 - 1);
    check("docs has children", model.has_children(&m, 1));
    check("music has none", model.has_children(&m, 2) == 0);

    // --- Cells by role ---
    let is model.Value as v;
    check("text provided", model.cell(&m, 3, 0, model.TEXT, &v) == 1);
    check("text value", v.kind == model.V_TEXT && v.len == 5 && v.p[0] == 97);
    check("role not provided", model.cell(&m, 3, 0, model.TOOLTIP, &v) == 0);
    check("not provided leaves NONE", v.kind == model.V_NONE);

    // --- Editing, when the model allows it ---
    let is model.Value as yes = model.boolean(1);
    check("set accepted", model.set_cell(&m, 3, 0, model.CHECKED, &yes) == 1);
    model.cell(&m, 3, 0, model.CHECKED, &v);
    check("and visible", v.kind == model.V_BOOL && v.i == 1);

    // --- The defaults for a model that answers only the required three ---
    let is model.Model as flat = model.make(cast(*u8, 0), fn_ptr(flat_count), fn_ptr(flat_row_id),
                                            fn_ptr(flat_cell));
    eq("one column by default", model.columns(&flat), 1);
    eq("flat: every row at the top", model.parent_of(&flat, 101), 0);
    eq("flat: index by search", model.index_of(&flat, 102), 2);
    check("flat: no children", model.has_children(&flat, 100) == 0);
    check("read-only by default", model.set_cell(&flat, 100, 0, model.TEXT, &yes) == 0);
    model.cell(&flat, 101, 0, model.TEXT, &v);
    check("integer value", v.kind == model.V_INT && v.i == 101);

    // --- Notifications reach every observer, in order ---
    let is i64 as o1 = model.observe(&m, fn_ptr(watch), cast(*u8, 1));
    model.observe(&m, fn_ptr(watch), cast(*u8, 2));
    model.inserted(&m, 1, 2, 3);
    eq("first observer, kind", seen[0], 100 + cast(i64, model.INSERTED));
    eq("parent", seen[1], 1);
    eq("first", seen[2], 2);
    eq("count", seen[3], 3);
    eq("second observer next", seen[4], 200 + cast(i64, model.INSERTED));
    nseen = 0;
    model.unobserve(&m, o1);
    model.removed(&m, 0, 0, 1);
    check("only the remaining observer", nseen == 4 && seen[0] == 200 + cast(i64, model.REMOVED));
    nseen = 0;
    model.changed(&m, 1, 0, 2);
    model.reset(&m);
    check("changed then reset", nseen == 8 && seen[0] == 200 + cast(i64, model.CHANGED)
                                && seen[4] == 200 + cast(i64, model.RESET));

    // An observer may remove itself while being told.
    self_removing = &m;
    self_id = model.observe(&m, fn_ptr(watch_once), cast(*u8, 3));
    nseen = 0;
    model.reset(&m);
    nseen = 0;
    model.reset(&m);
    check("removed itself", nseen == 4);

    // --- Observers are bounded ---
    let is model.Model as busy = model.make(cast(*u8, 0), fn_ptr(flat_count), fn_ptr(flat_row_id),
                                            fn_ptr(flat_cell));
    let is i64 as n with mut = 0;
    let is i64 as got with mut = 1;
    while (got != 0 && n < 100) {
        got = model.observe(&busy, fn_ptr(watch), cast(*u8, 9));
        n = n + 1;
    }
    eq("full returns 0", got, 0);
    eq("holds MAX_OBSERVERS", n - 1, model.MAX_OBSERVERS);

    if (fails != 0) { return 1; }
    io.printf("ui model: all checks passed\n");
    return 0;
}
