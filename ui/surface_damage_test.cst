// ui/surface_damage_test.cst — what a frame repaints when a widget is shown
// in a window of its own: everything in it damages its surface's region, in
// window coordinates and clipped to it, and nothing of it the window's —
// even where it lies over the window; the window's own widgets damage the
// window alone. A scroll area inside it moves its surface's pixels; one in
// the window under it moves the window's, since the popup is drawn
// elsewhere — where one drawn inside the window would have refused it.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "damage.cst" as damage;
use "surface.cst" as surface;
use "box.cst" as box;
use "scroll.cst" as scroll;
use "../window/positioner.cst" as positioner;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn same(a as math.rect.Rect, b as math.rect.Rect) as i32 {
    return cast(i32, near(a.x, b.x) == 1 && near(a.y, b.y) == 1 && near(a.w, b.w) == 1 && near(a.h, b.h) == 1);
}

// A box of a size of its own: measured as it says, arranging its children
// down its length.
struct Block {
    w as f64;
    h as f64;
}

fn block_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Block as b = cast(*Block, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = b.w;
    out.pref_h = b.h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn block_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is f64 as y with mut = 0.0;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        let is geom.Constraint as c = geom.unbounded();
        let is geom.Size as s;
        layout.measure(t, ch, &c, &s);
        let is f64 as h with mut = s.pref_h;
        if (tree.next_sibling(t, ch) == 0) { h = r.h - y; }
        let is math.rect.Rect as area = math.rect.rect(0.0, y, r.w, h);
        layout.place(t, ch, &area);
        y = y + h;
        ch = tree.next_sibling(t, ch);
    }
}

let is tree.Kind as block_kind with mut;

fn block(t as *tree.Tree, parent as i64, w as f64, h as f64) as i64 {
    let is i64 as b = tree.create(t, &block_kind, parent);
    let is *Block as d = cast(*Block, tree.data(t, b));
    d.w = w;
    d.h = h;
    return b;
}

let is i32 as opens with mut = 0;

fn host(user as *u8, t as *tree.Tree, op as i32, s as i64) as i32 {
    if (op == tree.SURFACE_CLOSE) { return 1; }
    if (op == tree.SURFACE_OPEN) { opens = opens + 1; }
    let is positioner.Positioner as p with mut = tree.surface_place(t, s);
    tree.surface_set_rect(t, s, positioner.place(&p, math.rect.rect(0.0 - 1000.0, 0.0 - 1000.0, 4000.0, 4000.0)));
    return 1;
}

// What the last frame collected, kept as it was presented: the window's
// region, each surface's, and the pixels it moved.
let is [16]math.rect.Rect as main_r with mut;
let is i64 as main_n with mut = 0;
let is [128]math.rect.Rect as surf_r with mut;   // 16 a surface
let is [8]i64 as surf_n with mut;
let is i32 as moved with mut = 0;
let is i64 as moved_in with mut = 0 - 1;
let is f64 as moved_dy with mut = 0.0;

fn frame(t as *tree.Tree) as void {
    layout.run(t, 200.0, 100.0);
    surface.follow(t);
    layout.run(t, 200.0, 100.0);
    damage.collect(t);
    main_n = tree.damage_count(t);
    let is i64 as i with mut = 0;
    while (i < main_n) { main_r[i] = tree.damage_at(t, i); i = i + 1; }
    let is i64 as s with mut = 0;
    while (s < 8) {
        surf_n[s] = tree.surface_damage_count(t, s);
        i = 0;
        while (i < surf_n[s]) { surf_r[s * 16 + i] = tree.surface_damage_at(t, s, i); i = i + 1; }
        s = s + 1;
    }
    let is math.rect.Rect as sr;
    let is f64 as dx with mut = 0.0;
    moved_dy = 0.0;
    moved = tree.shift(t, &sr, &dx, &moved_dy);
    moved_in = tree.shift_surface(t);
    tree.damage_clear(t);
}

// The smallest rectangle round a surface's region; empty for none.
fn bounds_of(s as i64) as math.rect.Rect {
    let is math.rect.Rect as b with mut = math.rect.rect_zero();
    let is i64 as i with mut = 0;
    while (i < surf_n[s]) {
        b = math.rect.rect_union(b, surf_r[s * 16 + i]);
        i = i + 1;
    }
    return b;
}

fn area_of(s as i64) as f64 {
    let is f64 as a with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < surf_n[s]) {
        let is math.rect.Rect as r = surf_r[s * 16 + i];
        a = a + r.w * r.h;
        i = i + 1;
    }
    return a;
}

fn main() as i32 {
    block_kind = widget.kind("block", sizeof(Block));
    block_kind.measure = fn_ptr(block_measure);
    block_kind.arrange = fn_ptr(block_arrange);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is i64 as content = block(&t, root, 200.0, 100.0);
    let is i64 as top = block(&t, content, 200.0, 20.0);
    let is i64 as under = block(&t, content, 200.0, 80.0);
    let is i64 as pop = block(&t, root, 150.0, 300.0);
    tree.set_layer(&t, pop, 900);
    let is i64 as item = block(&t, pop, 150.0, 30.0);
    let is i64 as sa = scroll.create(&t, pop);
    let is i64 as col = box.create(&t, sa, box.COLUMN);
    let is i64 as k with mut = 0;
    while (k < 40) { block(&t, col, 140.0, 20.0); k = k + 1; }
    tree.set_visible(&t, pop, 0);
    tree.set_surfaces(&t, fn_ptr(host), cast(*u8, 0));
    tree.set_moves(&t, 1);
    frame(&t);
    frame(&t);

    // --- Opened in a window of its own: its region, not the window's ---
    tree.set_visible(&t, pop, 1);
    let is math.rect.Rect as at = surface.open(&t, pop, surface.MENU, 1, top, layout.window_rect(&t, top),
                                               positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    let is i64 as s with mut = tree.surface_index(&t, pop);
    check("in a window of its own", s >= 0 && same(at, math.rect.rect(0.0, 20.0, 150.0, 300.0)) == 1);
    frame(&t);
    check("its surface repaints all of it", same(bounds_of(s), at) == 1);
    check("the window nothing, though it lies over it", main_n == 0);

    // A widget in it changes: its surface, there.
    frame(&t);
    check("then nothing", surf_n[s] == 0 && main_n == 0);
    tree.invalidate_paint(&t, item);
    frame(&t);
    check("a change in it: its surface", same(bounds_of(s), layout.window_rect(&t, item)) == 1 && main_n == 0);

    // One of the window's under it: the window.
    tree.invalidate_paint(&t, under);
    frame(&t);
    check("a change under it: the window", main_n == 1 && surf_n[s] == 0 &&
          same(main_r[0], layout.window_rect(&t, under)) == 1);

    // The platform moves it: all of it again, where it is now.
    tree.surface_set_rect(&t, s, math.rect.rect(0.0 - 30.0, 50.0, 150.0, 200.0));
    frame(&t);
    check("moved by the platform: repainted where it is", same(bounds_of(s), math.rect.rect(0.0 - 30.0, 50.0, 150.0, 200.0)) == 1);
    check("and the window nothing", main_n == 0);
    frame(&t);

    // --- A scroll area inside it scrolls: its surface's pixels move ---
    scroll.set_offset(&t, sa, 0.0, 13.0);
    frame(&t);
    check("scrolled inside it: its pixels moved", moved == 1 && moved_in == s && near(moved_dy, 0.0 - 13.0) == 1);
    let is math.rect.Rect as sar = layout.window_rect(&t, sa);
    check("only what came into view repainted", area_of(s) < sar.w * sar.h && area_of(s) > 0.0);
    check("in its surface, the window nothing", main_n == 0);
    frame(&t);

    // One in the window under it moves the window's: nothing drawn over it there.
    let is i64 as wa = scroll.create(&t, under);
    let is i64 as wcol = box.create(&t, wa, box.COLUMN);
    k = 0;
    while (k < 40) { block(&t, wcol, 190.0, 20.0); k = k + 1; }
    tree.surface_set_rect(&t, s, math.rect.rect(10.0, 20.0, 150.0, 200.0));
    frame(&t);
    frame(&t);
    scroll.set_offset(&t, wa, 0.0, 11.0);
    frame(&t);
    check("under the popup's window, the window's moved", moved == 1 && moved_in < 0);
    check("in the window's region", main_n > 0 && surf_n[s] == 0);

    // Hidden, then closed: what it leaves is its own window's, not this one's.
    frame(&t);
    tree.set_visible(&t, pop, 0);
    surface.close(&t, pop);
    frame(&t);
    check("hidden and closed: the window nothing", main_n == 0);

    // Inside the window, the same popup over the scroll area: refused.
    tree.set_surfaces(&t, cast(tree.SurfaceFn, 0), cast(*u8, 0));
    tree.set_visible(&t, pop, 1);
    surface.open(&t, pop, surface.MENU, 1, top, layout.window_rect(&t, top), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    frame(&t);
    check("drawn inside the window: the window repaints it", main_n > 0 && tree.surface_index(&t, pop) < 0);
    frame(&t);
    scroll.set_offset(&t, wa, 0.0, 30.0);
    frame(&t);
    check("under a popup drawn in the window: not moved", moved == 0);

    // Destroyed while in a window of its own: its region, then gone.
    tree.set_surfaces(&t, fn_ptr(host), cast(*u8, 0));
    surface.close(&t, pop);
    surface.open(&t, pop, surface.MENU, 1, top, layout.window_rect(&t, top), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    s = tree.surface_index(&t, pop);
    frame(&t);
    frame(&t);
    tree.destroy(&t, item);
    check("a child destroyed: its surface", tree.surface_damage_count(&t, s) == 1 && tree.damage_count(&t) == 0);

    tree.close(&t);
    if (fails == 0) {
        io.printf("ui surface damage: all checks passed\n");
        return 0;
    }
    io.printf("ui surface damage: %d failures\n", fails);
    return 1;
}
