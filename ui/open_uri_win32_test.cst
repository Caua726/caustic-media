// ui/open_uri_win32_test.cst — a link or a file opened by the shell on
// Windows (under Wine in test-win32): ShellExecuteW, the asking window named
// as its owner. A file URI is the file's own path there, "file:///C:/a"
// being C:/a; what the shell cannot open is said to have failed.
use "std/io.cst" as io;
use "std/os.cst" as os;
use "std/mem.cst" as mem;
use "std/env.cst" as env;
use "../sys/file.cst" as file;
use "../dbus/dbus.cst" as dbus;
use "open_uri.cst" as open_uri;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    return cast(i32, n == _len(b) && mem.memcmp(a, b, n) == 0);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is [4097]u8 as p;
    let is i64 as pn with mut = open_uri.local_path("file:///C:/notes/a%20b.txt", 26, cast(*u8, &p));
    check("a file URI on a drive: its path, no '/' before the drive", same(cast(*u8, &p), pn, "C:/notes/a b.txt") == 1);
    pn = open_uri.local_path("file:///tmp/x", 13, cast(*u8, &p));
    check("one without a drive: the path as it is", same(cast(*u8, &p), pn, "/tmp/x") == 1);

    let is *dbus.conn.Conn as none = cast(*dbus.conn.Conn, 0);
    let is open_uri.Request as rq;
    mem.memzero(cast(*u8, &rq), sizeof(open_uri.Request));

    // A file there: the shell opens it in the program it is for — an .ini,
    // which Notepad opens on Windows and in Wine's prefix alike (its .txt is
    // not associated there).
    let is [512]u8 as here;
    let is i64 as hn = file.cwd(cast(*u8, &here), 512);
    let is [128]u8 as rel;
    let is i64 as rn = io.sprintf(cast(*u8, &rel), 128, "build/open_uri.%d.ini", os.pid());
    check("a file to open", file.write_atomic(cast(*u8, &rel), "hello\n", 6, 0) == 1);
    let is [1024]u8 as uri;
    let is i64 as un = io.sprintf(cast(*u8, &uri), 1024, "file:///%s/%s", cast(*u8, &here), cast(*u8, &rel));
    check("the file opened by the shell", hn > 0 && open_uri.open(&rq, none, cast(*u8, &uri), un, "", 0) == 1 &&
          open_uri.how(&rq) == open_uri.SHELL);
    let is [1024]u8 as bad;
    let is i64 as bn = io.sprintf(cast(*u8, &bad), 1024, "file:///%s/build/no-such-file.%d", cast(*u8, &here), os.pid());
    check("a file not there: failed", open_uri.open(&rq, none, cast(*u8, &bad), bn, "", 0) == 0 && open_uri.how(&rq) == open_uri.FAILED);
    check("another machine's file: failed", open_uri.open(&rq, none, "file://far/x.txt", 16, "", 0) == 0 &&
          open_uri.how(&rq) == open_uri.FAILED);
    check("a scheme nothing opens: failed", open_uri.open(&rq, none, "no-such-scheme-caustic:x", 24, "", 0) == 0 &&
          open_uri.how(&rq) == open_uri.FAILED);
    check("a parent named that is not a window: still opened", open_uri.open(&rq, none, cast(*u8, &uri), un, "win32:zz", 8) == 1 &&
          open_uri.how(&rq) == open_uri.SHELL);
    file.remove(cast(*u8, &rel));

    if (fails != 0) {
        io.printf("open uri win32: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("open uri win32: all checks passed\n");
    return 0;
}
