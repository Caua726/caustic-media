// ui/clip_test.cst — what a program puts on the clipboard, without one: its
// formats, what is made on demand and by what, a copy of it; HTML's text.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "clip.cst" as clip;
use "../image/buffer.cst" as buffer;
use "../window/transfer.cst" as transfer;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn same(b as *clip.Bytes, s as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    if (cast(i64, b) == 0 || b.len != n) { return 0; }
    return cast(i32, n == 0 || mem.memcmp(b.data, s, n) == 0);
}

// The provider: what it was asked, as it heard it.
let is i32 as made with mut = 0;
let is i32 as heard with mut = 0;

fn provide(user as *u8, format as i32, name as *u8, n as i64, out as *clip.Bytes) as i32 {
    made = made + 1;
    heard = format;
    if (format == clip.HTML) { return clip.put(out, "<b>made</b>", 11); }
    if (format == clip.NAMED) { return clip.put(out, name, n); }
    if (format == clip.PNG) { return clip.put(out, "\x89PNG made", 9); }
    return clip.put(out, "text made", 9);
}

// What makes a PNG of pixels, standing in for the host's.
fn encode(img as *buffer.Image, out as *clip.Bytes) as i32 {
    made = made + 1;
    return clip.put(out, "\x89PNG pixels", 11);
}

// html's text is want.
fn text_is(what as *u8, html as *u8, want as *u8) as void {
    let is clip.Bytes as out;
    transfer.bytes_init(&out);
    let is i64 as n with mut = 0;
    while (html[n] != 0) { n = n + 1; }
    let is i32 as ok = clip.html_text(html, n, &out);
    if (ok == 0 || same(&out, want) == 0) {
        io.printf("  got [%s]\n", out.data);
    }
    check(what, ok == 1 && same(&out, want) == 1);
    transfer.bytes_free(&out);
}

fn main() as i32 {
    let is clip.Content as c with mut;
    clip.init(&c);
    check("empty", clip.formats(&c) == 0 && clip.has(&c, clip.TEXT) == 0);

    // --- Its formats ---
    check("text", clip.add_text(&c, "plain", 5) == 1 && clip.has(&c, clip.TEXT) == 1 && same(clip.text_of(&c), "plain") == 1);
    check("HTML, as its own format", clip.add_html(&c, "<i>x</i>", 8) == 1 && clip.has(&c, clip.HTML) == 1 && clip.has(&c, clip.NAMED) == 0 &&
          same(clip.html_of(&c), "<i>x</i>") == 1);
    check("a program's own", clip.add_named(&c, "application/x-t", 15, "own", 3) == 1 && clip.has(&c, clip.NAMED) == 1 &&
          same(clip.named_of(&c, "application/x-t", 15), "own") == 1);
    check("no such type", cast(i64, clip.named_of(&c, "application/x-u", 15)) == 0);
    check("a PNG's bytes", clip.add_png(&c, "\x89PNG\r\n\x1a\n", 8) == 1 && clip.has(&c, clip.PNG) == 1);
    check("files", clip.add_files(&c, "/tmp/one\x00/tmp/two\x00", 2) == 1 && clip.has(&c, clip.FILES) == 1 && c.offer.count == 2);
    check("what goes out is what it holds", clip.offer(&c).formats == c.offer.formats);
    clip.clear(&c);
    check("emptied", clip.formats(&c) == 0);

    // --- An image: pixels, a PNG in its place, and back ---
    let is buffer.Image as img with mut = buffer.create(2, 2, buffer.RGBA8);
    check("an image: a PNG to be had", clip.add_image(&c, &img) == 1 && clip.has(&c, clip.PNG) == 1 && c.has_image == 1 &&
          (c.offer.formats & transfer.PNG) == 0);
    check("copied, not lent", cast(i64, c.image.pixels) != cast(i64, img.pixels));
    made = 0;
    let is clip.Bytes as bare = *clip.png_of(&c);
    check("nothing to encode it with: none", bare.len == 0 && made == 0);
    clip.set_encoder(fn_ptr(encode));
    check("encoded when asked for", same(clip.png_of(&c), "\x89PNG pixels") == 1 && made == 1);
    check("once", same(clip.png_of(&c), "\x89PNG pixels") == 1 && made == 1);
    clip.set_encoder(cast(clip.EncodeFn, 0));
    check("a PNG takes the image's place", clip.add_png(&c, "\x89PNG\r\n\x1a\n", 8) == 1 && c.has_image == 0 && clip.has(&c, clip.PNG) == 1);
    check("the image the PNG's", clip.add_image(&c, &img) == 1 && (c.offer.formats & transfer.PNG) == 0 && c.has_image == 1 &&
          clip.has(&c, clip.PNG) == 1);
    let is buffer.Image as none with mut = buffer.from_memory(cast(*u8, 0), 0, 0, buffer.RGBA8);
    check("no pixels: refused", clip.add_image(&c, &none) == 0);
    clip.free(&c);
    buffer.destroy(&img);

    // --- Made on demand ---
    check("no provider: refused", clip.add_lazy(&c, clip.TEXT) == 0 && clip.add_lazy_named(&c, "application/x-t", 15) == 0 && clip.formats(&c) == 0);
    clip.set_provider(&c, fn_ptr(provide), cast(*u8, 0));
    check("said", clip.add_lazy(&c, clip.TEXT | clip.PNG | clip.HTML) == 1 && clip.add_lazy_named(&c, "application/x-t", 15) == 1);
    made = 0;
    check("all had, none made", clip.has(&c, clip.TEXT) == 1 && clip.has(&c, clip.PNG) == 1 && clip.has(&c, clip.HTML) == 1 &&
          clip.has(&c, clip.NAMED) == 1 && made == 0);
    check("HTML heard as HTML, not by name", same(clip.html_of(&c), "<b>made</b>") == 1 && made == 1 && heard == clip.HTML);
    check("once", same(clip.html_of(&c), "<b>made</b>") == 1 && made == 1);
    check("its own by name", same(clip.named_of(&c, "application/x-t", 15), "application/x-t") == 1 && made == 2 && heard == clip.NAMED);
    check("text", same(clip.text_of(&c), "text made") == 1 && made == 3 && heard == clip.TEXT);
    // A copy of what is yet to be made: made through the copy, the original gone.
    let is clip.Content as d with mut;
    clip.init(&d);
    clip.clear(&c);
    clip.set_provider(&c, fn_ptr(provide), cast(*u8, 0));
    clip.add_lazy(&c, clip.PNG);
    let is buffer.Image as pic with mut = buffer.create(1, 1, buffer.RGBA8);
    clip.add_text(&c, "kept", 4);
    check("copied", clip.copy(&d, &c) == 1 && clip.has(&d, clip.PNG) == 1 && same(clip.text_of(&d), "kept") == 1);
    clip.free(&c);
    made = 0;
    check("made through the copy", same(clip.png_of(&d), "\x89PNG made") == 1 && made == 1 && heard == clip.PNG);
    clip.free(&d);
    clip.add_image(&c, &pic);
    check("pixels copied too", clip.copy(&d, &c) == 1 && d.has_image == 1 && cast(i64, d.image.pixels) != cast(i64, c.image.pixels));
    clip.free(&c);
    clip.free(&d);
    buffer.destroy(&pic);

    // --- HTML's text ---
    text_is("words", "just words", "just words");
    text_is("tags out", "<b>bold</b> and <i>it</i>", "bold and it");
    text_is("white space one", "a  \n\t b", "a b");
    text_is("a line break", "one<br>two<br/>three", "one\ntwo\nthree");
    text_is("two breaks, an empty line", "one<br><br>two", "one\n\ntwo");
    text_is("blocks, a line each", "<p>one</p><p>two</p><div>three</div>", "one\ntwo\nthree");
    text_is("no line after the last", "<p>one</p>\n", "one");
    text_is("a list", "<ul><li>a</li><li>b</li></ul>", "a\nb");
    text_is("a heading", "<h1>Title</h1>body", "Title\nbody");
    text_is("a table's cells", "<table><tr><td>a</td><td>b</td></tr><tr><td>c</td></tr></table>", "a\tb\nc");
    text_is("entities", "a &amp; b &lt;c&gt; &quot;d&quot; &apos;e&apos;", "a & b <c> \"d\" 'e'");
    text_is("numbers, both ways", "&#65;&#x42;&#xe7;", "ABç");
    text_is("no break space", "a&nbsp;b", "a\xc2\xa0b");
    text_is("an & that is none", "fish & chips &unknown; &", "fish & chips &unknown; &");
    text_is("a < of the text", "1 < 2", "1 < 2");
    text_is("style and script out", "<style>p { color: red }</style>a<script>if (x < y) {}</script>b", "ab");
    text_is("a page's head out", "<html><head><title>no</title></head><body>yes</body></html>", "yes");
    text_is("a comment out", "a<!-- not <b>this</b> -->b", "ab");
    text_is("a comment left open: the rest", "a<!-- never closed", "a");
    text_is("a tag left open: the rest", "a<b", "a");
    text_is("pre kept", "<pre>a  b\n  c</pre>", "a  b\n  c");
    text_is("attributes", "<a href=\"x\">link</a>", "link");
    text_is("UTF-8 kept", "<p>ação ✓</p>", "ação ✓");
    text_is("nothing", "", "");
    text_is("only markup", "<p></p>", "");

    if (fails > 0) {
        io.printf("clip: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("clip: all checks passed\n");
    return 0;
}
