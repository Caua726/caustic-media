// ui/tree_lent.cst — what the tree is lent and keeps for its widgets: the
// theme, the application's services, the focus asked for, where text is
// typed and the host's text, which widget names which.
use "../math/math.cst" as math;
use "style.cst" as style;
use "tree_state.cst" as tst;

fn text_service(t as *tst.Tree) as *u8 { return t.text; }
fn set_animator(t as *tst.Tree, a as *u8) as void { t.animator = a; }
fn animator(t as *tst.Tree) as *u8 { return t.animator; }
fn set_timers(t as *tst.Tree, ts as *u8) as void { t.timers = ts; }
fn timers(t as *tst.Tree) as *u8 { return t.timers; }
fn set_router(t as *tst.Tree, r as *u8) as void { t.router = r; }
fn router(t as *tst.Tree) as *u8 { return t.router; }
fn request_focus(t as *tst.Tree, w as i64) as void { t.want_focus = w; }
fn focus_request(t as *tst.Tree) as i64 { return t.want_focus; }
fn take_focus_request(t as *tst.Tree) as i64 {
    let is i64 as w = t.want_focus;
    t.want_focus = 0;
    return w;
}
fn set_clipboard(t as *tst.Tree, cb as tst.ClipboardFn, user as *u8) as void {
    t.clip_fn = cb;
    t.clip_user = user;
}
fn copy(t as *tst.Tree, which as i32, text as *u8, n as i64) as void {
    if (cast(i64, t.clip_fn) == 0) { return; }
    call(t.clip_fn, t.clip_user, which, text, n);
}
fn set_paste(t as *tst.Tree, cb as tst.PasteFn, user as *u8) as void {
    t.paste_fn = cb;
    t.paste_user = user;
}
fn request_paste(t as *tst.Tree, which as i32, w as i64) as void {
    if (cast(i64, t.paste_fn) == 0) { return; }
    call(t.paste_fn, t.paste_user, which, w);
}
fn set_text_area(t as *tst.Tree, w as i64, r as math.rect.Rect) as void {
    t.area_w = w;
    t.area = r;
}
fn text_area(t as *tst.Tree) as i64 {
    if (tst.is_valid(t, t.area_w) == 0) { return 0; }
    return t.area_w;
}
fn text_area_rect(t as *tst.Tree) as math.rect.Rect { return t.area; }
fn set_ime_reset(t as *tst.Tree, cb as tst.ImeResetFn, user as *u8) as void {
    t.ime_fn = cb;
    t.ime_user = user;
}
fn reset_ime(t as *tst.Tree, w as i64) as void {
    if (cast(i64, t.ime_fn) == 0) { return; }
    call(t.ime_fn, t.ime_user, w);
}
fn set_window_ops(t as *tst.Tree, cb as tst.WindowOpFn, user as *u8) as void {
    t.win_fn = cb;
    t.win_user = user;
}
fn window_op(t as *tst.Tree, op as i32, x as f64, y as f64) as i32 {
    if (cast(i64, t.win_fn) == 0) { return 0; }
    call(t.win_fn, t.win_user, op, x, y);
    return 1;
}
fn set_watch(t as *tst.Tree, cb as tst.WatchFn, user as *u8) as void {
    t.watch_fn = cb;
    t.watch_user = user;
}
fn notify(t as *tst.Tree, w as i64, what as i32) as void {
    if (cast(i64, t.watch_fn) == 0) { return; }
    call(t.watch_fn, t.watch_user, t, w, what);
}
fn notify_text(t as *tst.Tree, w as i64, what as i64, at as i64, s as *u8, n as i64) as void {
    if (cast(i64, t.watch_fn) == 0) { return; }
    let is tst.TextChange as c;
    c.what = what;
    c.at = at;
    c.text = s;
    c.len = n;
    t.text_change = &c;
    call(t.watch_fn, t.watch_user, t, w, tst.WATCH_TEXT);
    t.text_change = cast(*tst.TextChange, 0);
}
fn set_language(t as *tst.Tree, lang as i32) as void { t.language = lang; }
fn language(t as *tst.Tree) as i32 { return t.language; }
fn text_change(t as *tst.Tree) as *tst.TextChange { return t.text_change; }
fn set_host(t as *tst.Tree, cb as tst.HostFn, user as *u8, window as i64) as void {
    t.host_fn = cb;
    t.host_user = user;
    t.host_window = window;
}
fn host_id(t as *tst.Tree) as i64 {
    if (t.ok == 0) { return 0; }
    return t.host_window;
}
fn ask_host(t as *tst.Tree, op as i32, arg as i64) as i64 {
    if (cast(i64, t.host_fn) == 0) { return 0; }
    return call(t.host_fn, t.host_user, t.host_window, op, arg);
}
fn set_labelled_by(t as *tst.Tree, w as i64, label as i64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    tst._node(t, i).labelled_by = label;
}
fn set_tab_group(t as *tst.Tree, w as i64, g as i64) as void {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return; }
    tst._node(t, i).group = g;
}
fn tab_group(t as *tst.Tree, w as i64) as i64 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    return tst._node(t, i).group;
}
fn labelled_by(t as *tst.Tree, w as i64) as i64 {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return 0; }
    let is i64 as l = tst._node(t, i).labelled_by;
    if (tst.is_valid(t, l) == 0) { return 0; }
    return l;
}
fn theme(t as *tst.Tree) as *style.Theme {
    if (cast(i64, t.theme) != 0) { return t.theme; }
    return &tst._default_theme;
}
fn overrides(t as *tst.Tree, w as i64) as *style.Overrides {
    let is i64 as i = tst._index(t, w);
    if (i < 0) { return cast(*style.Overrides, 0); }
    return tst._node(t, i).overrides;
}
