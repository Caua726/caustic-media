// ui/pointer_shape_test.cst — what the pointer looks like where it is.
//
// A widget kind may say, for a point of a widget, which shape the pointer
// takes there — the text beam over an entry, a hand over a link, the
// resizing arrows over a splitter's handle — or that its parent decides.
// The router asks the deepest widget under the pointer and up, or the one
// that holds a press wherever the pointer went, and skips what is disabled:
// a shape says what can be done, and nothing can.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "box.cst" as box;
use "event.cst" as event;
use "router.cst" as router;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

struct Probe {
    shape  as i32;   // what it says over its left half
    right  as i32;   // and over its right half
    asked_x as f64;  // where it was last asked, its own coordinates
    asked_y as f64;
}

fn probe_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = 100.0;
    out.pref_h = 50.0;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn probe_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is i64 as child = tree.first_child(t, w);
    if (child == 0) { return; }
    let is math.rect.Rect as quarter = math.rect.rect(r.w / 4.0, 0.0, r.w / 4.0, r.h);
    layout.place(t, child, &quarter);
}

fn probe_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    if (e.kind == event.POINTER_DOWN) { return 1; }
    return 0;
}

fn probe_shape(t as *tree.Tree, w as i64, data as *u8, p as *math.vec.Vec2) as i32 {
    let is *Probe as d = cast(*Probe, data);
    d.asked_x = p.x;
    d.asked_y = p.y;
    if (p.x >= layout.rect(t, w).w / 2.0) { return d.right; }
    return d.shape;
}

let is tree.Kind as probe_kind with mut;

fn probe(t as *tree.Tree, parent as i64, shape as i32, right as i32) as i64 {
    let is i64 as w = tree.create(t, &probe_kind, parent);
    let is *Probe as d = cast(*Probe, tree.data(t, w));
    d.shape = shape;
    d.right = right;
    return w;
}

fn pd(t as *tree.Tree, w as i64) as *Probe { return cast(*Probe, tree.data(t, w)); }

fn main() as i32 {
    probe_kind = widget.kind("probe", sizeof(Probe));
    probe_kind.measure = fn_ptr(probe_measure);
    probe_kind.arrange = fn_ptr(probe_arrange);
    probe_kind.event = fn_ptr(probe_event);
    probe_kind.shape = fn_ptr(probe_shape);
    check("a kind says nothing of it unless it is told", cast(i64, widget.kind("plain", 8).shape) == 0);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    //   column, 100 wide:
    //   text (TEXT; right half: its parent's)   y 0..50
    //   └─ link (POINTER), its second quarter     x 25..50
    //   plain (no shape of its own)              y 50..100
    let is i64 as col = box.create(&t, root, box.COLUMN);
    let is i64 as text = probe(&t, col, tree.SHAPE_TEXT, tree.SHAPE_INHERIT);
    let is i64 as link = probe(&t, text, tree.SHAPE_POINTER, tree.SHAPE_POINTER);
    let is i64 as plain = tree.create(&t, &probe_kind, col);
    layout.set_align(&t, col, layout.START, layout.START);
    layout.run(&t, 300.0, 200.0);

    let is router.Router as r = router.init(router.settings_default());
    check("nowhere yet: the default", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    router.pointer_move(&t, &r, 30.0, 10.0, 10);
    check("over what says: its", router.pointer_shape(&t, &r) == tree.SHAPE_POINTER);
    check("asked at its own point", pd(&t, link).asked_x == 5.0 && pd(&t, link).asked_y == 10.0);
    router.pointer_move(&t, &r, 10.0, 10.0, 20);
    check("beside it, over what holds it: that one's", router.pointer_shape(&t, &r) == tree.SHAPE_TEXT);
    router.pointer_move(&t, &r, 80.0, 10.0, 30);
    check("its parent's there: the default above", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    check("asked there", pd(&t, text).asked_x == 80.0);
    router.pointer_move(&t, &r, 10.0, 60.0, 40);
    check("a kind with nothing to say: the default", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    check("asked below the first, at its own point", pd(&t, plain).asked_y == 10.0);
    router.pointer_move(&t, &r, 250.0, 150.0, 50);
    check("over nothing: the default", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);

    // A press held: the shape of what holds it, wherever the pointer goes.
    router.pointer_move(&t, &r, 30.0, 10.0, 100);
    router.pointer_button(&t, &r, 1, 1, 30.0, 10.0, 100);
    router.pointer_move(&t, &r, 30.0, 70.0, 110);
    check("held: the holder's, asked where the pointer is", router.pointer_shape(&t, &r) == tree.SHAPE_POINTER &&
          pd(&t, link).asked_x == 5.0 && pd(&t, link).asked_y == 70.0);
    router.pointer_button(&t, &r, 1, 0, 30.0, 70.0, 120);
    check("let go: what is under it again", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);

    // Disabled: no shape of its own.
    tree.set_enabled(&t, link, 0);
    router.pointer_move(&t, &r, 30.0, 10.0, 200);
    check("disabled: what holds it decides", router.pointer_shape(&t, &r) == tree.SHAPE_TEXT);
    tree.set_enabled(&t, text, 0);
    check("all of it: the default", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    tree.set_enabled(&t, text, 1);
    tree.set_enabled(&t, link, 1);

    // Out of the window, or out of a modal scope.
    router.pointer_leave(&t, &r, 300);
    check("left the window: the default", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    router.pointer_move(&t, &r, 30.0, 10.0, 310);
    router.set_scope(&t, &r, plain);
    check("outside the scope: the default", router.pointer_shape(&t, &r) == tree.SHAPE_DEFAULT);
    router.set_scope(&t, &r, 0);
    check("back: its", router.pointer_shape(&t, &r) == tree.SHAPE_POINTER);

    tree.close(&t);
    if (fails != 0) { return 1; }
    io.printf("pointer shapes: all checks passed\n");
    return 0;
}
