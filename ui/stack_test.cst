// ui/stack_test.cst — one page at a time, and children on top of each other.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "stack.cst" as stack;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn near(name as *u8, got as f64, want as f64) as void {
    let is i64 as g = cast(i64, got * 100.0 + 0.5);
    let is i64 as w = cast(i64, want * 100.0 + 0.5);
    if (g != w) {
        io.printf("FAIL: %s: got %d/100, want %d/100\n", name, cast(i32, g), cast(i32, w));
        fails = fails + 1;
    }
}

struct Leaf {
    pref_w as f64;
    pref_h as f64;
}

fn leaf_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Leaf as d = cast(*Leaf, data);
    out.min_w = d.pref_w;
    out.min_h = d.pref_h;
    out.pref_w = d.pref_w;
    out.pref_h = d.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

let is tree.Kind as leaf_kind with mut;

fn leaf(t as *tree.Tree, parent as i64, pw as f64, ph as f64) as i64 {
    let is i64 as w = tree.create(t, &leaf_kind, parent);
    let is *Leaf as d = cast(*Leaf, tree.data(t, w));
    d.pref_w = pw;
    d.pref_h = ph;
    return w;
}

fn r(t as *tree.Tree, w as i64) as math.rect.Rect { return layout.rect(t, w); }

fn main() as i32 {
    leaf_kind = widget.kind("leaf", sizeof(Leaf));
    leaf_kind.measure = fn_ptr(leaf_measure);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);

    // --- A stack is as large as its largest page, shown or not ---
    let is i64 as s = stack.create(&t, root);
    layout.set_align(&t, s, layout.START, layout.START);
    let is i64 as small = leaf(&t, s, 20.0, 10.0);
    let is i64 as big = leaf(&t, s, 50.0, 40.0);
    stack.set_current(&t, s, small);
    check("current is the one set", stack.current(&t, s) == small);
    check("current shown", tree.is_visible(&t, small));
    check("other page hidden", tree.is_visible(&t, big) == 0);

    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as sz;
    layout.measure(&t, s, &free, &sz);
    near("measured as the largest page w", sz.pref_w, 50.0);
    near("measured as the largest page h", sz.pref_h, 40.0);

    // A page holding its content, not being it: the content counts too.
    let is i64 as holder = stack.create_overlay(&t, s);
    leaf(&t, holder, 70.0, 60.0);
    stack.set_current(&t, s, small);
    check("that page hidden", tree.is_visible(&t, holder) == 0);
    layout.measure(&t, s, &free, &sz);
    near("a hidden page's content measured w", sz.pref_w, 70.0);
    near("a hidden page's content measured h", sz.pref_h, 60.0);
    tree.destroy(&t, holder);
    layout.measure(&t, s, &free, &sz);

    layout.run(&t, 200.0, 100.0);
    near("stack size", r(&t, s).w, 50.0);
    near("current page fills the stack", r(&t, small).w, 50.0);
    near("current page fills the stack h", r(&t, small).h, 40.0);

    // --- Switching pages does not resize the stack ---
    stack.set_current(&t, s, big);
    layout.run(&t, 200.0, 100.0);
    check("switched", tree.is_visible(&t, big) && tree.is_visible(&t, small) == 0);
    near("same stack size after switching", r(&t, s).w, 50.0);
    near("new page placed", r(&t, big).h, 40.0);

    // A widget that is not one of the pages is refused.
    stack.set_current(&t, s, root);
    check("non-page refused", stack.current(&t, s) == big);
    tree.destroy(&t, s);

    // --- An overlay: everything shares the area, each aligned on its own ---
    let is i64 as o = stack.create_overlay(&t, root);
    let is i64 as base = leaf(&t, o, 30.0, 20.0);
    let is i64 as badge = leaf(&t, o, 10.0, 10.0);
    layout.set_align(&t, badge, layout.END, layout.START);
    layout.measure(&t, o, &free, &sz);
    near("overlay as large as its largest child", sz.pref_w, 30.0);
    layout.run(&t, 100.0, 50.0);
    near("base fills", r(&t, base).w, 100.0);
    near("badge at the end", r(&t, badge).x, 90.0);
    near("badge at the top", r(&t, badge).y, 0.0);
    check("both shown", tree.is_visible(&t, base) && tree.is_visible(&t, badge));

    tree.close(&t);
    if (fails != 0) { return 1; }
    io.printf("ui stack: all checks passed\n");
    return 0;
}
