// ui/host.cst — the application on the screen.
//
// app.cst keeps the program's windows — each a tree and a router — and is fed
// by calls; nothing in it touches the platform. This is what feeds it: for
// every window of the application that is shown, a window of the platform's
// (window/device.cst) — a dialog's above its owner's and modal when it is —
// put away when the application's is hidden or closed, titled as it is
// titled. What the platform says of a window becomes what the application
// and its router are told: the pointer, buttons and wheel, keys and the
// text they type, the keyboard focus, its size, its place, its state, a
// drag from another program, a request to close it. A window waiting on a
// modal dialog (app.blocked) is told nothing of the pointer or the keys.
//
// Each window is painted into a texture of its own on the program's device —
// only what changed, as the damage says — and that texture is what is shown:
// copied whole to the platform's buffer, which on X11 is converted in place
// as it is shown and so cannot be painted on again. The text service's glyph
// cache is the one the program opened on the same device.
//
// Between rounds it sleeps (window/wait.cst) until a window has an event, a
// descriptor the program watches is readable — the accessibility bridge's,
// a portal's — another thread posts something to run, or the next timer is
// due: an idle program takes no time at all.
//
// Every top-level window and dialog has a frame of the toolkit's own on every
// platform — the automatic one (decoration.cst, titlebar.cst), or one the
// program made (app.set_decoration) — and is opened without the platform's,
// seen through where its shadow is on Wayland; what the frame asks
// (tree.set_window_ops) — moved or resized from a press, minimized, maximized,
// closed — is asked of the platform's window, its menu is the toolkit's own,
// and the platform is told where the window really is inside the shadow,
// where it takes the pointer and where its maximize button is. What the
// platform says of the window — maximized, full screen, tiled — the frame
// follows. Every window is kept from being made smaller than its content can
// be laid out in (layout.min_size), told the platform again whenever that
// changes. On X11 and Windows, and where nothing behind the window shows
// through, the frame is drawn flat: the shadow there is the platform's or
// none. While a text field has the keyboard the platform's input method
// composes for it: told where the caret is (its candidates go there), what
// the field holds around it and what it is for (a password's text never), its
// composition shown in the field as it draws it, and abandoned when the field
// with the keyboard changes.
use "std/os.cst" as os;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/sync.cst" as sync;
use "../gpu/gpu.cst" as gpu;
use "../math/math.cst" as math;
use "../render/draw2d.cst" as draw2d;
use "../window/device.cst" as device;
use "../window/event.cst" as wevent;
use "../input/event.cst" as ie;
use "../input/keys.cst" as keys;
use "../window/wait.cst" as wait;
use "../window/cursor.cst" as cursor;
use "../window/display.cst" as display;
use "../window/settings.cst" as wsettings;
use "../window/x11/locale.cst" as xlocale;
use "../window/x11/xinput.cst" as xinput;
use "app.cst" as app;
use "tree.cst" as tree;
use "router.cst" as router;
use "event.cst" as event;
use "access.cst" as access;
use "../input/text.cst" as itext;
use "text.cst" as text;
use "dnd.cst" as dnd;
use "style.cst" as style;
use "paint.cst" as paint;
use "layout.cst" as layout;
use "geom.cst" as geom;
use "stack.cst" as stack;
use "widgets/decoration.cst" as decoration;
use "widgets/titlebar.cst" as titlebar;
use "widgets/menu.cst" as menu;
use "signal.cst" as signal;
use "strings.cst" as strings;
use "../window/positioner.cst" as positioner;
use "../gpu/software/target.cst" as tgt;
use "../window/damage.cst" as damage;
use "../window/transfer.cst" as transfer;

// The most windows on the screen at once: X11's table of them.
let is i64 as MAX_WINDOWS with imut = 32;
let is i64 as MAX_WATCHED with imut = 16;
let is i64 as MAX_POSTED  with imut = 64;
let is i64 as MAX_ROUND   with imut = 8;

// A descriptor readable: cb(user, fd).
type WatchFn = fn(*u8, i64) as void;
// Once a round, after the events: cb(user). And what another thread posts.
type RoundFn = fn(*u8) as void;
// The platform asked window h to close and nothing in it took the request:
// cb(user, h), 1 to close it.
type CloseFn = fn(*u8, i64) as i32;

// A window of the platform's for one of the application's.
struct Native {
    h         as i64;            // the application's window; 0: a free slot
    hs        as *Host;
    win       as device.Window;
    cur       as cursor.Cursors;
    tex       as i64;            // what it is painted into
    tw        as i64;            // its size, physical pixels
    th        as i64;
    scale     as f64;
    shape     as i32;            // the pointer's, as last set
    over      as i64;            // a drag begun here over another window: its slot + 1, 0 for none
    icon_gen  as i64;            // the application's icon as last set on it
    present   as i32;            // to be shown again though nothing changed: exposed
    paste_on  as i32;            // a paste asked of the platform, awaited
    paste_w   as i64;            // for which widget
    paste_which as i32;
    title_len as i32;
    deco      as i64;            // the frame of its own it was opened for; 0: the platform's
    typed     as i32;            // the text the last key pressed typed is the program's: the key was not taken
    texting   as i64;            // the text field text input was last enabled for; 0: none
    finger    as i32;            // the touch contact driving the pointer; -1: none
    pen_in    as i32;            // a pen in range over it
    told_ext  as [4]i64;         // the frame's extents as last told, physical pixels
    told_in   as [4]i64;         // and the input region
    told_min  as [2]i64;         // the smallest it may be made, as last told, physical pixels
    title     as [256]u8;        // as given to the platform, and a zero
    told_max  as [4]i64;         // its maximize button, as last told, physical pixels
    wmenu     as i64;            // its window menu, while there is one in its tree
    deco_auto as i32;            // deco is the automatic frame, not the program's
    // What changed of it since it was last shown, physical pixels — kept
    // until it is, whatever stops a frame — and what the frames shown last
    // changed: a platform buffer's age says which of those it lacks.
    pending   as damage.List;
    shown     as damage.History;
}

struct Host {
    a          as *app.App;
    dv         as *gpu.device.Device;
    svc        as *u8;           // the program's text service (ui/text.cst)
    canvas     as draw2d.Canvas;
    cmd        as i64;
    wt         as wait.Wait;
    disp       as display.Display;
    disp_ok    as i32;
    quitting   as i32;
    held       as i64;           // hold's count
    desktop    as wsettings.Settings;
    // What the platform said last, and what the program read beside it —
    // the settings portal — laid over it whenever either is read anew.
    platform   as wsettings.Settings;
    beside     as wsettings.Settings;
    natives    as *Native;       // MAX_WINDOWS of them
    wfd        as [16]i64;
    wcb        as [16]WatchFn;
    wuser      as [16]*u8;
    nw         as i64;
    rcb        as [8]RoundFn;
    ruser      as [8]*u8;
    nr         as i64;
    close_cb   as CloseFn;
    close_user as *u8;
    lock       as sync.Mutex;    // what is posted, from any thread
    pcb        as [64]RoundFn;
    puser      as [64]*u8;
    np         as i64;
}

fn _native(hs as *Host, i as i64) as *Native {
    return cast(*Native, cast(i64, hs.natives) + i * sizeof(Native));
}

// The application a, shown with dv — the device its text service svc is on —
// the windows it has open and those to come. Null when there is no room.
fn open(a as *app.App, dv as *gpu.device.Device, svc as *u8) as *Host {
    let is *Host as hs = cast(*Host, mem.core.mmap_anon(sizeof(Host)));
    if (cast(i64, hs) <= 0) { return cast(*Host, 0); }
    hs.natives = cast(*Native, mem.core.mmap_anon(MAX_WINDOWS * sizeof(Native)));
    hs.a = a;
    hs.dv = dv;
    hs.svc = svc;
    hs.wt = wait.open();
    // Text in the user's locale (LC_CTYPE): what X11's input methods compose
    // in — Xlib takes it from the C library, and in "C" an input method can
    // commit nothing past ASCII.
    if (os.current() == os.OS_LINUX) { xlocale.use_environment(); }
    hs.desktop = wsettings.defaults();
    hs.platform = wsettings.defaults();
    hs.beside = wsettings.defaults();
    let is draw2d.Limits as dl = draw2d.limits_default();
    hs.canvas = draw2d.open(dv, &dl);
    hs.cmd = gpu.command.create(dv);
    return hs;
}

fn close(hs as *Host) as void {
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        if (_native(hs, i).h != 0) { _put_away(hs, i); }
        i = i + 1;
    }
    if (hs.disp_ok == 1) { display.close(&hs.disp); }
    draw2d.close(&hs.canvas);
    wait.close(&hs.wt);
    mem.core.munmap(cast(*u8, hs.natives), MAX_WINDOWS * sizeof(Native));
    mem.core.munmap(cast(*u8, hs), sizeof(Host));
}

// The platform's window for the application's h, null when it has none.
fn native(hs as *Host, h as i64) as *device.Window {
    let is i64 as i = _slot_of(hs, h);
    if (i < 0) { return cast(*device.Window, 0); }
    return &_native(hs, i).win;
}

fn _slot_of(hs as *Host, h as i64) as i64 {
    if (h == 0) { return 0 - 1; }
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        if (_native(hs, i).h == h) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// The platform's window of h brought forward and given the keyboard — as a
// later start of the program asks (instance.cst). 1, or 0 for a window not
// on the screen.
fn present(hs as *Host, h as i64) as i32 {
    let is i64 as i = _slot_of(hs, h);
    if (i < 0) { return 0; }
    device.activate(&_native(hs, i).win);
    return 1;
}

// How many windows are on the screen.
fn shown(hs as *Host) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        if (_native(hs, i).h != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// --- What the program adds to the loop ---

// fd watched: cb(user, fd) when it is readable. 1, or 0 with MAX_WATCHED.
fn watch(hs as *Host, fd as i64, cb as WatchFn, user as *u8) as i32 {
    if (hs.nw >= MAX_WATCHED || wait.watch(&hs.wt, fd) == 0) { return 0; }
    hs.wfd[hs.nw] = fd;
    hs.wcb[hs.nw] = cb;
    hs.wuser[hs.nw] = user;
    hs.nw = hs.nw + 1;
    return 1;
}

// How many descriptors are watched.
fn watched(hs as *Host) as i64 { return hs.nw; }

fn unwatch(hs as *Host, fd as i64) as void {
    wait.unwatch(&hs.wt, fd);
    let is i64 as i with mut = 0;
    while (i < hs.nw) {
        if (hs.wfd[i] == fd) {
            hs.nw = hs.nw - 1;
            hs.wfd[i] = hs.wfd[hs.nw];
            hs.wcb[i] = hs.wcb[hs.nw];
            hs.wuser[i] = hs.wuser[hs.nw];
            return;
        }
        i = i + 1;
    }
}

// cb(user) once every round, after the events: the accessibility bridge's
// pump. 1, or 0 with MAX_ROUND.
fn every_round(hs as *Host, cb as RoundFn, user as *u8) as i32 {
    if (hs.nr >= MAX_ROUND) { return 0; }
    hs.rcb[hs.nr] = cb;
    hs.ruser[hs.nr] = user;
    hs.nr = hs.nr + 1;
    return 1;
}

// What is asked when the platform asks to close a window nothing in it kept
// open; none set: it closes.
fn set_on_close(hs as *Host, cb as CloseFn, user as *u8) as void {
    hs.close_cb = cb;
    hs.close_user = user;
}

// cb(user) run by the loop, in its thread, as soon as it can: from any
// thread. 1, or 0 with MAX_POSTED waiting already.
fn post(hs as *Host, cb as RoundFn, user as *u8) as i32 {
    sync.mutex_lock(&hs.lock);
    if (hs.np >= MAX_POSTED) {
        sync.mutex_unlock(&hs.lock);
        return 0;
    }
    hs.pcb[hs.np] = cb;
    hs.puser[hs.np] = user;
    hs.np = hs.np + 1;
    sync.mutex_unlock(&hs.lock);
    wait.wake(&hs.wt);
    return 1;
}

// The loop going on with no window on the screen — a program living in the
// tray, its window hidden — until release is called as often.
fn hold(hs as *Host) as void { hs.held = hs.held + 1; }

fn release(hs as *Host) as void {
    if (hs.held > 0) { hs.held = hs.held - 1; }
}

// The loop to end after this round.
fn quit(hs as *Host) as void {
    hs.quitting = 1;
    wait.wake(&hs.wt);
}

fn _run_posted(hs as *Host) as void {
    let is [64]RoundFn as cbs;
    let is [64]*u8 as users;
    sync.mutex_lock(&hs.lock);
    let is i64 as n = hs.np;
    let is i64 as i with mut = 0;
    while (i < n) {
        cbs[i] = hs.pcb[i];
        users[i] = hs.puser[i];
        i = i + 1;
    }
    hs.np = 0;
    sync.mutex_unlock(&hs.lock);
    i = 0;
    while (i < n) {
        call(cbs[i], users[i]);
        i = i + 1;
    }
}

// --- Windows put on the screen and away ---

fn _set_title(n as *Native, s as *u8, k as i64) as void {
    let is i64 as m with mut = k;
    if (m > 255) { m = 255; }
    mem.memcpy(cast(*u8, &n.title), s, m);
    n.title[m] = cast(u8, 0);
    n.title_len = cast(i32, m);
}

fn _scale(hs as *Host) as f64 {
    if ((hs.desktop.known & wsettings.K_DPI) != 0 && hs.desktop.dpi > 0.0) { return hs.desktop.dpi / 96.0; }
    if (hs.disp_ok == 1) { return cast(f64, display.dpi(&hs.disp)) / 96.0; }
    return 1.0;
}

// Physical pixels per logical one in n's window. Wayland's and Windows' scale
// is the window's own — its output's, its monitor's — whatever DPI the
// desktop's settings say; X11 has one for the screen, which those settings
// may say (Xft/DPI) and the display otherwise works out.
fn _window_scale(hs as *Host, n as *Native) as f64 {
    if (n.win.backend == device.X11 && (hs.desktop.known & wsettings.K_DPI) != 0 && hs.desktop.dpi > 0.0) {
        return hs.desktop.dpi / 96.0;
    }
    if (hs.disp_ok == 1) { return display.scale(&hs.disp, &n.win); }
    return 1.0;
}
fn _copy(user as *u8, which as i32, s as *u8, n as i64) as void {
    let is *Native as nt = cast(*Native, user);
    let is i32 as w with mut = device.CLIPBOARD;
    if (which == tree.PRIMARY) { w = device.PRIMARY; }
    let is transfer.Offer as o with mut;
    transfer.offer_init(&o);
    if (transfer.offer_text(&o, s, n) == 1) { device.clipboard_set(&nt.win, w, &o); }
    transfer.offer_free(&o);
}

fn _paste(user as *u8, which as i32, w as i64) as void {
    let is *Native as nt = cast(*Native, user);
    let is i32 as sel with mut = device.CLIPBOARD;
    if (which == tree.PRIMARY) { sel = device.PRIMARY; }
    nt.paste_w = w;
    nt.paste_which = which;
    nt.paste_on = device.clipboard_request(&nt.win, sel, transfer.TEXT);
    if (nt.paste_on == 0) {
        // Nobody to ask: nothing pasted.
        router.paste(app.tree(nt.hs.a, nt.h), app.router(nt.hs.a, nt.h), w, which, "", 0, time.now_ms());
    }
}

// The automatic frame's buttons: a dialog has only a close button.
fn _sync_frame(hs as *Host, n as *Native) as void {
    if (n.deco == 0 || app.decoration_is_automatic(hs.a, n.h) == 0) { return; }
    let is i32 as flags with mut = titlebar.BTN_ALL;
    if (app.is_dialog(hs.a, n.h) == 1) { flags = titlebar.BTN_CLOSE; }
    let is *tree.Tree as t = app.tree(hs.a, n.h);
    titlebar.set_buttons(t, decoration.header_of(t, n.deco), flags);
}

// Whether n's frame is drawn flat: always on X11, which has no word for a
// shadow outside the window, and on Windows, whose system draws its own; on
// Wayland where nothing behind the window shows through it.
fn _flat(n as *Native) as i32 {
    if (n.win.backend != device.WAYLAND) { return 1; }
    return cast(i32, device.transparent(&n.win) == 0 || device.composited(&n.win) == 0);
}

// Moves the root's children under a new automatic frame, keeping the root's
// overlay rule.
fn _automatic_frame(a as *app.App, h as i64) as i64 {
    let is *tree.Tree as t = app.tree(a, h);
    let is i64 as root = tree.root(t);
    let is i64 as child with mut = tree.first_child(t, root);
    let is i64 as deco = decoration.create(t, root);
    if (deco == 0) { return 0; }
    let is i64 as overlay = stack.create_overlay(t, decoration.content_of(t, deco));
    if (overlay == 0) { tree.destroy(t, deco); return 0; }
    layout.set_stretch(t, overlay, 1.0, 1.0);
    while (child != 0 && child != deco) {
        let is i64 as next = tree.next_sibling(t, child);
        // Popups keep their root-relative positioning and clip.
        if (tree.layer(t, child) == 0) { tree.reparent(t, child, overlay); }
        child = next;
    }
    app.set_automatic_decoration(a, h, deco);
    return deco;
}

// An automatic frame taken away again: what it held back under the root, as
// it was before the frame came.
fn _unwrap_frame(t as *tree.Tree, deco as i64) as void {
    if (cast(i64, t) == 0 || tree.is_valid(t, deco) == 0) { return; }
    let is i64 as root = tree.root(t);
    let is i64 as overlay = tree.first_child(t, decoration.content_of(t, deco));
    let is i64 as child with mut = tree.first_child(t, overlay);
    while (overlay != 0 && child != 0) {
        let is i64 as next = tree.next_sibling(t, child);
        tree.reparent(t, child, root);
        child = next;
    }
    tree.destroy(t, deco);
}

// A platform window for h, owned by its owner's: 1, or 0 on failure.
fn _put_up(hs as *Host, h as i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS && _native(hs, i).h != 0) { i = i + 1; }
    if (i == MAX_WINDOWS) { return 0; }
    let is *Native as n = _native(hs, i);
    let is *app.App as a = hs.a;
    _set_title(n, app.title(a, h), app.title_length(a, h));
    let is f64 as s with mut = _scale(hs);
    let is i64 as o = _slot_of(hs, app.owner(a, h));
    let is i64 as deco with mut = app.decoration(a, h);
    if (deco == 0) {
        deco = _automatic_frame(a, h);
        if (deco == 0) { return 0; }
    }
    // Dialogs are sized to their content. Include the automatic frame before
    // opening, also when a hidden dialog is shown again with different content.
    if (app.is_dialog(a, h) == 1 && app.decoration_is_automatic(a, h) == 1) {
        let is geom.Constraint as free = geom.unbounded();
        let is geom.Size as pref;
        layout.measure(app.tree(a, h), deco, &free, &pref);
        app.resize(a, h, pref.pref_w, pref.pref_h);
    }
    let is device.Config as c with mut = device.config(cast(*u8, &n.title), cast(i64, app.width(a, h) * s + 0.5),
                                                       cast(i64, app.height(a, h) * s + 0.5));
    if (c.width < 1) { c.width = 1; }
    if (c.height < 1) { c.height = 1; }
    if (o >= 0) { c.owner = &_native(hs, o).win; }
    c.dialog = app.is_dialog(a, h);
    c.modal = app.is_modal(a, h);
    // A frame of its own: none of the platform's. Its shadow seen through
    // only on Wayland; elsewhere the frame is flat (_flat).
    c.decorated = 0;
    let is i32 as backend with mut = c.backend;
    if (backend == device.AUTO) { backend = device.auto_backend(); }
    if (backend == device.WAYLAND) { c.transparent = 1; }
    n.win = device.open_config(&c);
    let is f64 as opened_at = s;
    if (device.is_open(&n.win) == 0) { return 0; }
    n.h = h;
    n.hs = hs;
    n.scale = s;
    n.shape = 0;
    n.tex = 0;
    n.tw = 0;
    n.th = 0;
    n.present = 1;
    damage.whole(&n.pending);
    damage.history_clear(&n.shown);
    n.paste_on = 0;
    n.over = 0;
    n.icon_gen = 0;
    n.deco = deco;
    n.deco_auto = app.decoration_is_automatic(a, h);
    n.typed = 0;
    n.texting = 0;
    n.finger = 0 - 1;
    n.pen_in = 0;
    mem.memset(cast(*u8, &n.told_max), 255, 32);
    n.wmenu = 0;
    // Nothing told yet (-1 each, all bits set): told with its first frame.
    mem.memset(cast(*u8, &n.told_ext), 255, 32);
    mem.memset(cast(*u8, &n.told_in), 255, 32);
    // The platform's window opens with no floor.
    n.told_min[0] = 0;
    n.told_min[1] = 0;
    n.cur = cursor.open(&n.win);
    _cursor_theme(hs, n);
    if ((hs.desktop.known & wsettings.K_DARK) != 0) { device.set_dark_frame(&n.win, hs.desktop.dark); }
    // X: the pointer as XInput 2 reports it — a touchpad's and a fine wheel's
    // scrolling not in whole notches, a pen's pressure, a touchscreen's
    // fingers, a touchpad's gestures.
    if (os.current() == os.OS_LINUX && n.win.backend == device.X11) { xinput.enable(&n.win.x11_win); }
    // The screen, and the desktop's settings, with the first window there is.
    if (hs.disp_ok == 0) {
        hs.disp = display.open(&n.win);
        hs.disp_ok = 1;
        _read_settings(hs, n);
        s = _scale(hs);
    }
    // Its compositing manager heard of from here on, on whatever connection
    // the window has (opened anew once every window had closed).
    display.follow(&hs.disp, &n.win);
    n.scale = _window_scale(hs, n);
    // Opened before its scale was known — the first window opens the display
    // that tells it — it is made the size the program asked at that scale.
    if (n.scale != opened_at) {
        device.set_size(&n.win, cast(i64, app.width(a, h) * n.scale + 0.5), cast(i64, app.height(a, h) * n.scale + 0.5));
    }
    app.set_scale(a, h, n.scale);
    let is *tree.Tree as t = app.tree(a, h);
    if (app.decoration_is_automatic(a, h) == 1) {
        titlebar.set_title(t, decoration.header_of(t, deco), app.title(a, h), app.title_length(a, h));
        _sync_frame(hs, n);
    }
    tree.set_clipboard(t, fn_ptr(_copy), cast(*u8, n));
    tree.set_paste(t, fn_ptr(_paste), cast(*u8, n));
    tree.set_window_ops(t, fn_ptr(_window_op), cast(*u8, n));
    tree.set_ime_reset(t, fn_ptr(_ime_reset), cast(*u8, n));
    // Its texture keeps what it holds: a scroll area's pixels are moved.
    tree.set_moves(t, 1);
    // Its shadow only where what is behind shows through it.
    decoration.set_flat(t, deco, _flat(n));
    app.set_see_through(a, h, 1 - _flat(n));
    tree.invalidate_paint_subtree(t, tree.root(t));
    return 1;
}

// A widget gave its composition up: the platform's input method gives it up
// too, or what it commits next is what the widget no longer shows.
fn _ime_reset(user as *u8, w as i64) as void {
    let is *Native as n = cast(*Native, user);
    device.text_input_reset(&n.win);
}

fn _put_away(hs as *Host, i as i64) as void {
    let is *Native as n = _native(hs, i);
    let is *tree.Tree as t = app.tree(hs.a, n.h);
    if (cast(i64, t) != 0) {
        tree.set_clipboard(t, cast(tree.ClipboardFn, 0), cast(*u8, 0));
        tree.set_paste(t, cast(tree.PasteFn, 0), cast(*u8, 0));
        tree.set_window_ops(t, cast(tree.WindowOpFn, 0), cast(*u8, 0));
        tree.set_ime_reset(t, cast(tree.ImeResetFn, 0), cast(*u8, 0));
    }
    if (n.tex != 0) { gpu.texture.destroy(hs.dv, n.tex); }
    cursor.close(&n.cur, &n.win);
    device.close(&n.win);
    n.h = 0;
    n.tex = 0;
}

// The platform's windows as the application's are: opened for those shown,
// owners first; put away for those hidden or closed, and opened again for
// those whose frame changed — its own or the platform's; titled.
fn _sync(hs as *Host) as void {
    let is *app.App as a = hs.a;
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0 && (app.window_valid(a, n.h) == 0 || app.is_shown(a, n.h) == 0 || app.decoration(a, n.h) != n.deco)) {
            // The program gave it a frame of its own: the automatic one goes.
            if (n.deco_auto == 1 && app.window_valid(a, n.h) == 1 && app.decoration(a, n.h) != n.deco) {
                _unwrap_frame(app.tree(a, n.h), n.deco);
            }
            _put_away(hs, i);
        }
        i = i + 1;
    }
    // Owners before what belongs to them: rounds until none is left to open.
    let is i32 as more with mut = 1;
    while (more == 1) {
        more = 0;
        let is i64 as h with mut = app.next_window(a, 0);
        while (h != 0) {
            let is i64 as o = app.owner(a, h);
            if (app.is_shown(a, h) == 1 && _slot_of(hs, h) < 0 && (o == 0 || _slot_of(hs, o) >= 0 || app.is_shown(a, o) == 0)) {
                if (_put_up(hs, h) == 1) { more = 1; }
            }
            h = app.next_window(a, h);
        }
    }
    i = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0) {
            let is i64 as k = app.title_length(a, n.h);
            let is *u8 as s = app.title(a, n.h);
            if (k != cast(i64, n.title_len) || mem.memcmp(s, cast(*u8, &n.title), k) != 0) {
                _set_title(n, s, k);
                device.set_title(&n.win, s, k);
                if (n.deco != 0 && app.decoration_is_automatic(a, n.h) == 1) {
                    let is *tree.Tree as t = app.tree(a, n.h);
                    titlebar.set_title(t, decoration.header_of(t, n.deco), s, k);
                }
            }
            _sync_frame(hs, n);
            // The application's icon, as it is now.
            if (n.icon_gen != app.icon_generation(a)) {
                n.icon_gen = app.icon_generation(a);
                let is i64 as size with mut = 0;
                let is *u32 as px = app.icon(a, &size);
                if (cast(i64, px) != 0) { device.set_icon(&n.win, cast(*u8, px), size, size); }
            }
        }
        i = i + 1;
    }
}

// --- The desktop's settings ---

fn _read_settings(hs as *Host, n as *Native) as void {
    let is wsettings.Settings as s with mut = wsettings.defaults();
    device.read_settings(&n.win, &s);
    hs.platform = s;
    _compose_settings(hs);
}

// The desktop's settings, from what the program reads beside the platform —
// the settings portal, read whole each time — laid over what the platform
// says, now and after the platform's are read again.
fn set_settings(hs as *Host, s as *wsettings.Settings) as void {
    hs.beside = *s;
    _compose_settings(hs);
    _rescale(hs);
}

fn _compose_settings(hs as *Host) as void {
    hs.desktop = hs.platform;
    wsettings.merge(&hs.desktop, &hs.beside);
    app.set_system(hs.a, &hs.desktop);
    _cursor_themes(hs);
    _dark_frames(hs);
}

// Each window's frame, where the system draws part of it, dark when the
// desktop says dark.
fn _dark_frames(hs as *Host) as void {
    if ((hs.desktop.known & wsettings.K_DARK) == 0) { return; }
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0) { device.set_dark_frame(&n.win, hs.desktop.dark); }
        i = i + 1;
    }
}

// The pointer drawn from the desktop's cursor theme and size, when it says
// them.
fn _cursor_theme(hs as *Host, n as *Native) as void {
    let is wsettings.Settings as d = hs.desktop;
    if ((d.known & (wsettings.K_CURSOR_THEME | wsettings.K_CURSOR_SIZE)) == 0) { return; }
    let is *u8 as theme with mut = cast(*u8, 0);
    if ((d.known & wsettings.K_CURSOR_THEME) != 0) { theme = &hs.desktop.cursor_theme[0]; }
    let is i64 as size with mut = 0;
    if ((d.known & wsettings.K_CURSOR_SIZE) != 0) { size = d.cursor_size; }
    cursor.set_theme(&n.cur, &n.win, theme, size);
}

fn _cursor_themes(hs as *Host) as void {
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0) { _cursor_theme(hs, n); }
        i = i + 1;
    }
}

// The desktop's settings as the windows follow them.
fn settings(hs as *Host) as *wsettings.Settings { return &hs.desktop; }

fn _rescale(hs as *Host) as void {
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0) {
            let is f64 as s = _window_scale(hs, n);
            if (n.scale != s) {
                n.scale = s;
                app.set_scale(hs.a, n.h, s);
                app.resize(hs.a, n.h, cast(f64, device.width(&n.win)) / s,
                           cast(f64, device.height(&n.win)) / s);
            }
        }
        i = i + 1;
    }
}

// Each frame of the program's own drawn as what is behind it now shows: flat
// where nothing would, with its shadow where something does. The window as
// the desktop counts it keeps its size: the platform's grows or shrinks by
// the shadow it gains or loses.
fn _recomposite(hs as *Host) as void {
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        let is *tree.Tree as t = app.tree(hs.a, n.h);
        if (n.h != 0 && n.deco != 0 && cast(i64, t) != 0 && tree.is_valid(t, n.deco) == 1) {
            let is i32 as flat = _flat(n);
            if (flat != decoration.is_flat(t, n.deco)) {
                let is decoration.Extents as was = decoration.extents(t, n.deco);
                decoration.set_flat(t, n.deco, flat);
                app.set_see_through(hs.a, n.h, 1 - flat);
                let is decoration.Extents as now = decoration.extents(t, n.deco);
                let is f64 as dw = (now.left + now.right - was.left - was.right) * n.scale;
                let is f64 as dh = (now.top + now.bottom - was.top - was.bottom) * n.scale;
                device.set_size(&n.win, device.width(&n.win) + _round(dw), device.height(&n.win) + _round(dh));
                tree.invalidate_paint_subtree(t, tree.root(t));
            }
        }
        i = i + 1;
    }
}

// --- What the platform says ---

fn _payload(n as *Native, offers as i32, with_data as i32) as dnd.Payload {
    let is dnd.Payload as p with mut = dnd.files(cast(*u8, 0), 0);
    p.offers = 0;
    if ((offers & wevent.DROP_FILES) != 0) { p.offers = p.offers | dnd.FILES; }
    if ((offers & wevent.DROP_TEXT) != 0) { p.offers = p.offers | dnd.TEXT; }
    if (with_data == 1) {
        let is i64 as nf = device.dropped_files(&n.win);
        if (nf > 0) {
            p.files = device.dropped_file(&n.win, 0);
            p.files_n = nf;
        }
        p.text = device.dropped_text(&n.win);
        p.text_len = device.dropped_text_length(&n.win);
    }
    return p;
}

fn _answer(n as *Native, takes as i32) as void {
    let is i32 as w with mut = 0;
    if ((takes & dnd.FILES) != 0) { w = w | wevent.DROP_FILES; }
    if ((takes & dnd.TEXT) != 0) { w = w | wevent.DROP_TEXT; }
    device.drop_answer(&n.win, w, 0);
}

// Another window of the program's under the point x, y of n's window
// (physical pixels): its slot, and the point in it, at *ox, *oy; -1 for none.
fn _other_under(hs as *Host, n as *Native, x as i64, y as i64, ox as *i64, oy as *i64) as i64 {
    let is i64 as ax with mut = 0;
    let is i64 as ay with mut = 0;
    if (device.position(&n.win, &ax, &ay) == 0) { return 0 - 1; }
    let is i64 as rx = ax + x;
    let is i64 as ry = ay + y;
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as m = _native(hs, i);
        let is i64 as mx with mut = 0;
        let is i64 as my with mut = 0;
        if (m.h != 0 && m.h != n.h && app.blocked(hs.a, m.h) == 0 && device.position(&m.win, &mx, &my) == 1 &&
            rx >= mx && ry >= my && rx < mx + device.width(&m.win) && ry < my + device.height(&m.win)) {
            *ox = rx - mx;
            *oy = ry - my;
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// The drag begun in n's window no longer over the one it went to.
fn _drag_back(hs as *Host, n as *Native, now as i64) as void {
    if (n.over == 0) { return; }
    let is *Native as m = _native(hs, n.over - 1);
    if (m.h != 0) { router.drag_leave(app.tree(hs.a, m.h), app.router(hs.a, m.h), now); }
    n.over = 0;
}

// A drag begun in n's window, the pointer at x, y of it, over another of
// the program's windows: run by that window's router, from what this one
// carries — and let go there, this one told what was done. 1 when it was.
fn _drag_across(hs as *Host, n as *Native, e as *ie.Event, now as i64) as i32 {
    let is *app.App as a = hs.a;
    let is *tree.Tree as t = app.tree(a, n.h);
    let is *router.Router as r = app.router(a, n.h);
    let is *dnd.Payload as p = router.drag_payload(r);
    if (cast(i64, p) == 0) {
        n.over = 0;
        return 0;
    }
    let is i64 as ox with mut = 0;
    let is i64 as oy with mut = 0;
    let is i64 as o = _other_under(hs, n, e.x, e.y, &ox, &oy);
    if (o < 0) {
        _drag_back(hs, n, now);
        return 0;
    }
    let is *Native as m = _native(hs, o);
    let is *tree.Tree as mt = app.tree(a, m.h);
    let is *router.Router as mr = app.router(a, m.h);
    let is f64 as mx = cast(f64, ox) / m.scale;
    let is f64 as my = cast(f64, oy) / m.scale;
    // What is held now, as this window's event says it: Ctrl copies there.
    router.set_modifiers(mr, e.modifiers);
    if (n.over != o + 1) {
        if (n.over == 0) {
            router.drag_elsewhere(t, r, now);
        } else {
            _drag_back(hs, n, now);
        }
        router.drag_enter(mt, mr, p, mx, my, now);
        n.over = o + 1;
    } else {
        router.drag_move(mt, mr, mx, my, now);
    }
    if (e.kind == ie.BUTTON_UP) {
        let is i32 as done = router.drag_drop(mt, mr, mx, my, now);
        router.drag_finish(t, r, done, now);
        router.pointer_button(t, r, e.button, 0, cast(f64, e.x) / n.scale, cast(f64, e.y) / n.scale, now);
        n.over = 0;
    }
    return 1;
}

fn _close_asked(hs as *Host, n as *Native, now as i64) as void {
    let is *app.App as a = hs.a;
    if (app.blocked(a, n.h) == 1) { return; }
    if (router.close_request(app.tree(a, n.h), app.router(a, n.h), now) == 1) {
        // Taken — a dialog answered it, and hid itself, or asks first.
        device.keep_open(&n.win);
        return;
    }
    if (app.is_dialog(a, n.h) == 1) {
        app.hide(a, n.h);
        return;
    }
    if (cast(i64, hs.close_cb) != 0 && call(hs.close_cb, hs.close_user, n.h) == 0) {
        device.keep_open(&n.win);
        return;
    }
    app.window_close(a, n.h);
}

// The window menu's items, by id.
let is i64 as _MENU_MAXIMIZE with imut = 1;
let is i64 as _MENU_MINIMIZE with imut = 2;
let is i64 as _MENU_CLOSE    with imut = 3;

// The window's own menu, the toolkit's, at x, y in the window: restore or
// maximize, minimize, close — a dialog's, close alone. Made afresh each time,
// in the tree's language and as the window is now.
fn _window_menu(n as *Native, x as f64, y as f64) as void {
    let is *app.App as a = n.hs.a;
    let is *tree.Tree as t = app.tree(a, n.h);
    if (n.wmenu != 0 && tree.is_valid(t, n.wmenu) == 1) { tree.destroy(t, n.wmenu); }
    n.wmenu = menu.create(t);
    if (n.wmenu == 0) { return; }
    let is i64 as k with mut = 0;
    if (app.is_dialog(a, n.h) == 0) {
        let is i64 as word with mut = strings.MAXIMIZE;
        if (app.is_maximized(a, n.h) == 1) { word = strings.RESTORE; }
        let is *u8 as size_word = strings.of(t, word, &k);
        menu.add_item(t, n.wmenu, size_word, k, _MENU_MAXIMIZE);
        let is *u8 as min_word = strings.of(t, strings.MINIMIZE, &k);
        menu.add_item(t, n.wmenu, min_word, k, _MENU_MINIMIZE);
        menu.add_separator(t, n.wmenu);
    }
    let is *u8 as close_word = strings.of(t, strings.CLOSE_WINDOW, &k);
    menu.add_item(t, n.wmenu, close_word, k, _MENU_CLOSE);
    signal.connect(t, n.wmenu, signal.ACTIVATED, fn_ptr(_window_menu_chosen), cast(*u8, n));
    menu.popup_at(t, app.router(a, n.h), n.wmenu, math.rect.rect(x, y, 0.0, 0.0), positioner.TOP_LEFT,
                  positioner.BOTTOM_RIGHT, 0);
}

fn _window_menu_chosen(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    let is i64 as id = *cast(*i64, arg);
    if (id == _MENU_MAXIMIZE) { _window_op(user, tree.WIN_MAXIMIZE, 0.0, 0.0); }
    if (id == _MENU_MINIMIZE) { _window_op(user, tree.WIN_MINIMIZE, 0.0, 0.0); }
    if (id == _MENU_CLOSE) { _window_op(user, tree.WIN_CLOSE, 0.0, 0.0); }
}

// What the window's frame asks — moved or resized from a press, its menu,
// minimized, maximized or back, closed — asked of the platform's window, at
// window x, y in logical pixels.
fn _window_op(user as *u8, op as i32, x as f64, y as f64) as void {
    let is *Native as n = cast(*Native, user);
    let is *Host as hs = n.hs;
    let is i64 as px = cast(i64, x * n.scale);
    let is i64 as py = cast(i64, y * n.scale);
    if (op == tree.WIN_MOVE || (op >= tree.WIN_RESIZE_N && op <= tree.WIN_RESIZE_NW)) {
        let is i64 as how with mut = device.MOVE;
        // The tree's edges go round from the top, the platform's from the
        // top left corner.
        if (op != tree.WIN_MOVE) { how = cast(i64, op - tree.WIN_RESIZE_N + 1) % 8; }
        device.begin_move_resize(&n.win, px, py, how, 1);
        return;
    }
    if (op == tree.WIN_MENU) {
        _window_menu(n, x, y);
        return;
    }
    if (op == tree.WIN_MINIMIZE) {
        device.minimize(&n.win);
        return;
    }
    if (op == tree.WIN_MAXIMIZE) {
        device.set_maximized(&n.win, cast(i32, app.is_maximized(hs.a, n.h) == 0));
        return;
    }
    if (op == tree.WIN_CLOSE) { _close_asked(hs, n, time.now_ms()); }
}

fn _px(v as f64, s as f64) as i64 { return cast(i64, v * s + 0.5); }

// v to the nearest whole number, either side of 0.
fn _round(v as f64) as i64 {
    if (v < 0.0) { return 0 - cast(i64, 0.5 - v); }
    return cast(i64, v + 0.5);
}

// What the frame says of the window, laid out — where it really is inside
// the shadow, where it takes the pointer, where its maximize button is — told
// the platform when it changed.
fn _tell_frame(hs as *Host, n as *Native) as void {
    let is *tree.Tree as t = app.tree(hs.a, n.h);
    if (tree.is_valid(t, n.deco) == 0) { return; }
    let is decoration.Extents as e = decoration.extents(t, n.deco);
    let is math.rect.Rect as r = decoration.input(t, n.deco);
    let is f64 as s = n.scale;
    let is [4]i64 as ext;
    ext[0] = _px(e.left, s);
    ext[1] = _px(e.right, s);
    ext[2] = _px(e.top, s);
    ext[3] = _px(e.bottom, s);
    let is [4]i64 as inp;
    inp[0] = _px(r.x, s);
    inp[1] = _px(r.y, s);
    inp[2] = _px(r.w, s);
    inp[3] = _px(r.h, s);
    if (mem.memcmp(cast(*u8, &ext), cast(*u8, &n.told_ext), 32) != 0) {
        device.set_frame_extents(&n.win, ext[0], ext[1], ext[2], ext[3]);
        mem.memcpy(cast(*u8, &n.told_ext), cast(*u8, &ext), 32);
    }
    if (mem.memcmp(cast(*u8, &inp), cast(*u8, &n.told_in), 32) != 0) {
        device.set_input_region(&n.win, inp[0], inp[1], inp[2], inp[3]);
        mem.memcpy(cast(*u8, &n.told_in), cast(*u8, &inp), 32);
    }
    let is [4]i64 as mx;
    mem.memset(cast(*u8, &mx), 0, 32);
    let is i64 as bar = decoration.header_of(t, n.deco);
    let is i64 as max_btn = titlebar.button(t, bar, titlebar.MAXIMIZE);
    if (max_btn != 0 && tree.is_visible(t, bar) == 1) {
        let is math.rect.Rect as b = layout.window_rect(t, max_btn);
        mx[0] = _px(b.x, s);
        mx[1] = _px(b.y, s);
        mx[2] = _px(b.w, s);
        mx[3] = _px(b.h, s);
    }
    if (mem.memcmp(cast(*u8, &mx), cast(*u8, &n.told_max), 32) != 0) {
        device.set_maximize_button(&n.win, mx[0], mx[1], mx[2], mx[3]);
        mem.memcpy(cast(*u8, &n.told_max), cast(*u8, &mx), 32);
    }
}

// v, s times, up to a whole number of physical pixels: room enough.
fn _px_up(v as f64, s as f64) as i64 {
    let is f64 as x = v * s;
    let is i64 as i = cast(i64, x);
    if (cast(f64, i) < x) { return i + 1; }
    return i;
}

// v at scale s, physical pixels, rounded down whatever its sign.
fn _px_down(v as f64, s as f64) as i64 {
    let is f64 as x = v * s;
    let is i64 as i = cast(i64, x);
    if (cast(f64, i) > x) { return i - 1; }
    return i;
}

// The smallest its content can be laid out in, told the platform as the
// window's floor when it changed, and the window grown to it when it is
// smaller: a window manager that keeps the floor would, and one that does not
// (none at all, under Xvfb) leaves it to the program.
fn _tell_min(hs as *Host, n as *Native) as void {
    let is geom.Size as least;
    layout.min_size(app.tree(hs.a, n.h), &least);
    let is i64 as mw = _px_up(least.min_w, n.scale);
    let is i64 as mh = _px_up(least.min_h, n.scale);
    if (mw == n.told_min[0] && mh == n.told_min[1]) { return; }
    device.set_min_size(&n.win, mw, mh);
    n.told_min[0] = mw;
    n.told_min[1] = mh;
    let is i64 as cw = device.width(&n.win);
    let is i64 as ch = device.height(&n.win);
    if (cw < mw || ch < mh) {
        let is i64 as gw with mut = cw;
        let is i64 as gh with mut = ch;
        if (gw < mw) { gw = mw; }
        if (gh < mh) { gh = mh; }
        device.set_size(&n.win, gw, gh);
    }
}

// The sides the platform says the window is tiled to, as the frame counts them.
fn _sides(state as i32) as i32 {
    let is i32 as s with mut = 0;
    if ((state & wevent.STATE_TILED_TOP) != 0) { s = s | decoration.TILED_TOP; }
    if ((state & wevent.STATE_TILED_RIGHT) != 0) { s = s | decoration.TILED_RIGHT; }
    if ((state & wevent.STATE_TILED_BOTTOM) != 0) { s = s | decoration.TILED_BOTTOM; }
    if ((state & wevent.STATE_TILED_LEFT) != 0) { s = s | decoration.TILED_LEFT; }
    return s;
}

// One event the platform said of the application's window h, given to it as
// if it came from there now.
fn feed(hs as *Host, h as i64, e as *wevent.Event, now as i64) as void {
    let is i64 as i = _slot_of(hs, h);
    if (i < 0) { return; }
    _feed(hs, _native(hs, i), e, now);
}

// And one thing a person did there, as the platform's translator says it.
fn feed_input(hs as *Host, h as i64, e as *ie.Event, now as i64) as void {
    let is i64 as i = _slot_of(hs, h);
    if (i < 0) { return; }
    _feed_input(hs, _native(hs, i), e, now);
}

// The pointer's shape over h, as last set; 0 before any.
fn pointer_shape(hs as *Host, h as i64) as i32 {
    let is i64 as i = _slot_of(hs, h);
    if (i < 0) { return 0; }
    return _native(hs, i).shape;
}

// Event e given to n's window — as one thing done for the windows
// (app.begin_dispatch), so a window closed by what it sets off goes on until
// it is over; none for a window closed already.
fn _feed(hs as *Host, n as *Native, e as *wevent.Event, now as i64) as void {
    if (app.window_valid(hs.a, n.h) == 0) { return; }
    app.begin_dispatch(hs.a);
    _feed_one(hs, n, e, now);
    app.end_dispatch(hs.a);
}

fn _feed_input(hs as *Host, n as *Native, e as *ie.Event, now as i64) as void {
    if (app.window_valid(hs.a, n.h) == 0) { return; }
    app.begin_dispatch(hs.a);
    _input_one(hs, n, e, now);
    app.end_dispatch(hs.a);
}

fn _input_one(hs as *Host, n as *Native, e as *ie.Event, now as i64) as void {
    let is *app.App as a = hs.a;
    let is i64 as h = n.h;
    let is *tree.Tree as t = app.tree(a, h);
    let is *router.Router as r = app.router(a, h);
    let is f64 as s = n.scale;
    let is f64 as x = cast(f64, e.x) / s;
    let is f64 as y = cast(f64, e.y) / s;
    let is i32 as input = cast(i32, app.blocked(a, h) == 0);
    let is i32 as k = e.kind;
    // The modifiers held, as a pointer's event says them: right at its
    // moment, where a key's says the state before it.
    if (input == 1 && (k == ie.MOTION || k == ie.ENTER || k == ie.BUTTON_DOWN || k == ie.BUTTON_UP ||
                       k == ie.SCROLL || (k >= ie.TOUCH_DOWN && k <= ie.GESTURE_END))) {
        router.set_modifiers(r, e.modifiers);
    }
    if (k >= ie.TOUCH_DOWN && k <= ie.TOUCH_CANCEL) {
        _touch(t, r, n, e, x, y, input, now);
        return;
    }
    if (k >= ie.PEN_IN && k <= ie.PEN_BUTTON) {
        _pen(t, r, n, e, x, y, input, now);
        return;
    }
    if (k >= ie.GESTURE_BEGIN && k <= ie.GESTURE_END) {
        if (input == 0) { return; }
        let is i32 as phase with mut = event.GESTURE_UPDATE;
        if (k == ie.GESTURE_BEGIN) { phase = event.GESTURE_BEGIN; }
        if (k == ie.GESTURE_END) { phase = event.GESTURE_END; }
        router.gesture(t, r, x, y, e.gesture, phase, e.fingers, e.dx / s, e.dy / s, e.scale, e.rotation,
                       cast(i32, e.detail == ie.CANCELLED), now);
        return;
    }
    // The mouse's again, after a finger or a pen.
    if (k == ie.MOTION || k == ie.ENTER || k == ie.BUTTON_DOWN) { router.set_source(r, router.MOUSE); }
    if (k == ie.BUTTON_UP && e.detail == ie.BUTTON_TAKEN) {
        // The platform took the press, to move or resize the window from:
        // it clicks nothing.
        router.pointer_cancel(t, r, e.button, now);
        return;
    }
    // A drag begun here, carried over another of the program's windows.
    if (input == 1 && (k == ie.MOTION || (k == ie.BUTTON_UP && e.button == 1)) &&
        _drag_across(hs, n, e, now) == 1) { return; }
    if (k == ie.MOTION || k == ie.ENTER) {
        if (input == 1) { router.pointer_move(t, r, x, y, now); }
        return;
    }
    if (k == ie.LEAVE) {
        router.pointer_leave(t, r, now);
        return;
    }
    if (k == ie.BUTTON_DOWN || k == ie.BUTTON_UP) {
        if (input == 0) { return; }
        if (e.button >= 1 && e.button <= 3) {
            router.pointer_button(t, r, e.button, cast(i32, k == ie.BUTTON_DOWN), x, y, now);
        }
        return;
    }
    if (k == ie.SCROLL) {
        if (input == 0) { return; }
        // Fingers and continuous devices: the content follows by the pixels
        // they moved, and flies on when they lift. A wheel: notches, and
        // fractions of one where it is finer, each gliding a line.
        if (e.source == ie.SCROLL_FINGER || e.source == ie.SCROLL_CONTINUOUS) {
            if (e.dx != 0.0 || e.dy != 0.0) {
                router.scroll(t, r, x, y, e.dx * ie.LINE_PIXELS, e.dy * ie.LINE_PIXELS, 0, now);
            }
            if (e.stop != 0) { router.scroll_end(t, r, x, y, now); }
        } else if (e.dx != 0.0 || e.dy != 0.0) {
            router.scroll(t, r, x, y, e.dx, e.dy, 1, now);
        }
        return;
    }
    if (k == ie.TEXT) {
        // Typed by the key just before it: the program's only when that key
        // was not taken. What is not text — a command's key, a control
        // character — the platform's translator never says as text.
        if (e.from_key == 1 && n.typed == 0) { return; }
        if (input == 1) { router.text(t, r, e.text, e.text_len, now); }
        return;
    }
    if (k == ie.PREEDIT) {
        if (input == 1) { router.preedit_segment(t, r, e.text, e.text_len, e.cursor, e.hl_start, e.hl_end, now); }
        return;
    }
    if (k == ie.DELETE_SURROUNDING) {
        if (input == 1) { router.delete_surrounding(t, r, e.delete_before, e.delete_after, now); }
        return;
    }
    if (k == ie.KEY_UP) {
        if (input == 1) { router.key(t, r, _routed_key(e), e.modifiers, 0, 0, now); }
        return;
    }
    if (k == ie.KEY_DOWN) {
        n.typed = 0;
        if (input == 0) { return; }
        let is i32 as taken = router.key(t, r, _routed_key(e), e.modifiers, 1, e.repeat, now);
        n.typed = cast(i32, taken == 0);
        return;
    }
    if (k == ie.CANCEL) {
        // Everything held is let go: a press held clicks nothing, and its
        // release will not come.
        n.typed = 0;
        // A finger driving the pointer included: its up will not come.
        n.finger = 0 - 1;
        _drag_back(hs, n, now);
        let is i32 as b with mut = 1;
        while (b <= 3) {
            router.pointer_cancel(t, r, b, now);
            b = b + 1;
        }
    }
}

// A finger: the first down drives the pointer, a press of button 1 — the
// router's long press is a touch's own — from its down to its up, and others
// with it are not the pointer's (a gesture's, which the widget under them
// does not hear). Lifted, the pointer is nowhere: nothing stays hovered.
// Cancelled — the system took the touches — the press clicks nothing.
fn _touch(t as *tree.Tree, r as *router.Router, n as *Native, e as *ie.Event, x as f64, y as f64,
          input as i32, now as i64) as void {
    let is i32 as k = e.kind;
    if (k == ie.TOUCH_CANCEL) {
        if (n.finger < 0) { return; }
        n.finger = 0 - 1;
        router.pointer_cancel(t, r, 1, now);
        router.pointer_leave(t, r, now);
        return;
    }
    if (k == ie.TOUCH_DOWN) {
        if (n.finger >= 0 || input == 0) { return; }
        n.finger = e.contact;
        router.set_source(r, router.TOUCH);
        router.pointer_move(t, r, x, y, now);
        router.pointer_button(t, r, 1, 1, x, y, now);
        return;
    }
    if (e.contact != n.finger) { return; }
    if (k == ie.TOUCH_MOTION) {
        router.pointer_move(t, r, x, y, now);
        return;
    }
    n.finger = 0 - 1;
    router.pointer_button(t, r, 1, 0, x, y, now);
    router.pointer_leave(t, r, now);
}

// A pen: the pointer while it is in range — hovering moves it, touching is
// button 1, its first barrel button the secondary (3), its second the
// middle (2) — gone when it leaves the range.
fn _pen(t as *tree.Tree, r as *router.Router, n as *Native, e as *ie.Event, x as f64, y as f64,
        input as i32, now as i64) as void {
    let is i32 as k = e.kind;
    if (k == ie.PEN_OUT) {
        if (n.pen_in == 0) { return; }
        n.pen_in = 0;
        router.pointer_leave(t, r, now);
        return;
    }
    if (input == 0) { return; }
    router.set_source(r, router.PEN);
    n.pen_in = 1;
    if (k == ie.PEN_IN || k == ie.PEN_MOTION) {
        router.pointer_move(t, r, x, y, now);
        return;
    }
    if (k == ie.PEN_DOWN || k == ie.PEN_UP) {
        router.pointer_button(t, r, 1, cast(i32, k == ie.PEN_DOWN), x, y, now);
        return;
    }
    let is i32 as b with mut = 0;
    if (e.button == 1) { b = 3; }
    if (e.button == 2) { b = 2; }
    if (b != 0) { router.pointer_button(t, r, b, cast(i32, e.detail == ie.PRESSED), x, y, now); }
}

// The key the router is told: with Control or Super held a command's, so the
// key a shortcut is matched against — Ctrl+C is Ctrl+C in a Cyrillic layout,
// where the key itself is С — else the key as the layout has it, which an
// Alt mnemonic and plain keys mean.
fn _routed_key(e as *ie.Event) as i32 {
    if ((e.modifiers & (keys.MOD_CONTROL | keys.MOD_SUPER)) != 0 && e.shortcut != 0) { return e.shortcut; }
    return e.key;
}

fn _feed_one(hs as *Host, n as *Native, e as *wevent.Event, now as i64) as void {
    let is *app.App as a = hs.a;
    let is i64 as h = n.h;
    let is *tree.Tree as t = app.tree(a, h);
    let is *router.Router as r = app.router(a, h);
    let is f64 as s = n.scale;
    let is f64 as x = cast(f64, e.x) / s;
    let is f64 as y = cast(f64, e.y) / s;
    if (app.blocked(a, h) == 1 && e.kind == wevent.CLOSE) { device.keep_open(&n.win); }
    let is i32 as k = e.kind;
    if (k == wevent.FOCUS_IN || k == wevent.FOCUS_OUT) {
        app.set_active(a, h, cast(i32, k == wevent.FOCUS_IN));
        return;
    }
    if (k == wevent.RESIZE) {
        let is f64 as lw = cast(f64, e.width) / s;
        let is f64 as lh = cast(f64, e.height) / s;
        if (lw != app.width(a, h) || lh != app.height(a, h)) { app.resize(a, h, lw, lh); }
        let is i64 as px with mut = 0;
        let is i64 as py with mut = 0;
        if (device.position(&n.win, &px, &py) == 1) { app.set_position(a, h, cast(f64, px) / s, cast(f64, py) / s); }
        return;
    }
    if (k == wevent.EXPOSE) {
        // The area the platform lost, shown again from the texture.
        if (e.width > 0 && e.height > 0) {
            damage.add(&n.pending, e.x, e.y, e.width, e.height, n.tw, n.th);
        } else {
            damage.whole(&n.pending);
        }
        n.present = 1;
        return;
    }
    if (k == wevent.CLOSE) {
        _close_asked(hs, n, now);
        return;
    }
    if (k == wevent.STATE) {
        let is i32 as max = cast(i32, (e.state & wevent.STATE_MAXIMIZED) != 0);
        let is i32 as full = cast(i32, (e.state & wevent.STATE_FULLSCREEN) != 0);
        app.set_maximized(a, h, max);
        app.set_fullscreen(a, h, full);
        // Its frame, if it has one of its own, as the state is.
        decoration.set_maximized(t, n.deco, max);
        decoration.set_fullscreen(t, n.deco, full);
        decoration.set_tiled(t, n.deco, _sides(e.state));
        return;
    }
    if (k == wevent.SETTINGS) {
        _read_settings(hs, n);
        _rescale(hs);
        return;
    }
    if (k == wevent.COMPOSITOR) {
        _recomposite(hs);
        return;
    }
    if (k == wevent.DND_ENTER) {
        let is dnd.Payload as p = _payload(n, e.drop, 0);
        _answer(n, router.drag_enter(t, r, &p, x, y, now));
        return;
    }
    if (k == wevent.DND_MOVE) {
        _answer(n, router.drag_move(t, r, x, y, now));
        return;
    }
    if (k == wevent.DND_LEAVE) {
        router.drag_leave(t, r, now);
        return;
    }
    if (k == wevent.DND_DROP) {
        let is dnd.Payload as got = _payload(n, e.drop, 1);
        router.drag_update(r, &got);
        router.drag_drop(t, r, x, y, now);
        device.clear_drop(&n.win);
        return;
    }
}

// Every window's events, and a paste that came.
fn _events(hs as *Host, now as i64) as void {
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0) {
            device.pump(&n.win);
            let is wevent.Event as e;
            while (n.h != 0 && device.poll_event(&n.win, &e) == 1) { _feed(hs, n, &e, now); }
            let is ie.Event as in;
            while (n.h != 0 && device.poll_input(&n.win, &in) == 1) { _feed_input(hs, n, &in, now); }
            if (n.h != 0 && n.paste_on == 1 && device.clipboard_pending(&n.win) == 0 && app.window_valid(hs.a, n.h) == 1) {
                // The window's bytes, until it is asked again: text, or none.
                let is i64 as got with mut = 0;
                if (device.clipboard_format(&n.win) == transfer.TEXT) { got = device.clipboard_length(&n.win); }
                let is *u8 as text with mut = device.clipboard_data(&n.win);
                if (got == 0) { text = ""; }
                n.paste_on = 0;
                app.begin_dispatch(hs.a);
                router.paste(app.tree(hs.a, n.h), app.router(hs.a, n.h), n.paste_w, n.paste_which, text, got, now);
                app.end_dispatch(hs.a);
            }
        }
        i = i + 1;
    }
}

// --- Painted and shown ---

fn _paint(hs as *Host, now as i64) as void {
    let is *app.App as a = hs.a;
    let is i32 as glyphs with mut = 0;
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0 && (app.needs_frame(a, n.h) == 1 || n.present == 1)) {
            if (glyphs == 0 && cast(i64, hs.svc) != 0) {
                text.next_frame(cast(*text.Service, hs.svc));
                glyphs = 1;
            }
            _frame(hs, n, now);
        }
        // The pointer's shape, as the widget under it asks.
        if (n.h != 0) {
            let is i32 as shape with mut = app.pointer_shape(a, n.h);
            if (shape == tree.SHAPE_INHERIT) { shape = tree.SHAPE_DEFAULT; }
            if (shape != n.shape) {
                // A shape the platform has not got: the default pointer, chosen
                // here, where it is known that another was asked for.
                if (cursor.set(&n.cur, &n.win, shape) == 0) { cursor.set(&n.cur, &n.win, tree.SHAPE_DEFAULT); }
                n.shape = shape;
            }
        }
        i = i + 1;
    }
}

fn _text_inputs(hs as *Host) as void {
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0) {
            let is *tree.Tree as t = app.tree(hs.a, n.h);
            let is i64 as area = tree.text_area(t);
            let is i32 as active = cast(i32, app.blocked(hs.a, n.h) == 0 && area != 0);
            // Another field: what was composing for the last one is not this one's.
            if (active == 1 && n.texting != 0 && n.texting != area) { device.text_input_reset(&n.win); }
            n.texting = 0;
            if (active == 1) { n.texting = area; }
            if (device.text_input_enable(&n.win, active) == 1 && active == 1) {
                let is math.rect.Rect as r = tree.text_area_rect(t);
                let is i64 as x = _round(r.x * n.scale);
                let is i64 as y = _round(r.y * n.scale);
                let is i64 as width = _px_up(r.w, n.scale);
                let is i64 as height = _px_up(r.h, n.scale);
                device.text_input_rect(&n.win, x, y, width, height);
                _text_context(n, t, area);
            }
        }
        i = i + 1;
    }
}

// What the field with the keyboard is and holds, told the platform's input
// method: its purpose from its role — a password keeps its text — and its
// text around the caret.
fn _text_context(n as *Native, t as *tree.Tree, area as i64) as void {
    let is i64 as role = access.role(t, area);
    let is i32 as purpose with mut = itext.PURPOSE_NORMAL;
    let is i32 as hints with mut = itext.HINT_NONE;
    if (role == access.ROLE_PASSWORD) {
        purpose = itext.PURPOSE_PASSWORD;
        hints = itext.HINT_HIDDEN_TEXT | itext.HINT_SENSITIVE_DATA;
    }
    if (role == access.ROLE_TEXT) { hints = itext.HINT_MULTILINE; }
    let is tree.TextQuery as q;
    if (itext.secret(purpose) == 1 || access.text_around(t, area, itext.CONTEXT_MAX, &q) == 0) {
        device.text_input_context(&n.win, cast(*u8, 0), 0, 0, 0, purpose, hints);
        return;
    }
    device.text_input_context(&n.win, q.text, q.text_len, q.caret, q.a, purpose, hints);
}

fn _frame(hs as *Host, n as *Native, now as i64) as void {
    let is *app.App as a = hs.a;
    let is *tree.Tree as t = app.tree(a, n.h);
    let is i64 as pw = device.width(&n.win);
    let is i64 as ph = device.height(&n.win);
    if (pw <= 0 || ph <= 0) { return; }
    // A texture the window's size: made again when it is not, and then all
    // of it painted.
    let is i32 as made with mut = 0;
    if (n.tex == 0 || n.tw != pw || n.th != ph) {
        made = 1;
        if (n.tex != 0) { gpu.texture.destroy(hs.dv, n.tex); }
        let is gpu.texture.Desc as td = gpu.texture.desc(pw, ph, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
        n.tex = gpu.texture.create(hs.dv, &td);
        n.tw = pw;
        n.th = ph;
        if (n.tex == 0) { return; }
        tree.invalidate_paint_subtree(t, tree.root(t));
        damage.whole(&n.pending);
        damage.history_clear(&n.shown);
    }
    let is i64 as k = app.frame(a, n.h);
    _tell_frame(hs, n);
    _tell_min(hs, n);
    if (k > 0) {
        draw2d.begin(&hs.canvas, cast(f64, pw), cast(f64, ph), n.scale);
        app.paint(a, n.h, &hs.canvas, cast(*style.Theme, 0), now, cast(*paint.Stats, 0));
        gpu.command.begin(hs.dv, hs.cmd);
        // A scroll area's pixels that only moved, moved first: the damage
        // painted over what they left (tree.shift). Both where they were and
        // where they went changed.
        let is math.rect.Rect as sr;
        let is f64 as sdx with mut = 0.0;
        let is f64 as sdy with mut = 0.0;
        let is f64 as s = n.scale;
        if (made == 0 && tree.shift(t, &sr, &sdx, &sdy) == 1) {
            gpu.command.move_region(hs.dv, hs.cmd, n.tex, _px(sr.x, s), _px(sr.y, s), _px(sr.w, s), _px(sr.h, s),
                                    _round(sdx * s), _round(sdy * s));
            _changed(n, sr.x, sr.y, sr.w, sr.h);
            _changed(n, sr.x + sdx, sr.y + sdy, sr.w, sr.h);
        }
        let is gpu.command.Pass as ps = gpu.command.pass_load(n.tex, 0);
        gpu.command.begin_pass(hs.dv, hs.cmd, &ps);
        draw2d.flush(&hs.canvas, hs.cmd);
        gpu.command.end_pass(hs.dv, hs.cmd);
        gpu.command.end(hs.dv, hs.cmd);
        gpu.command.submit(hs.dv, hs.cmd);
        let is i64 as d with mut = 0;
        while (d < tree.damage_count(t)) {
            let is math.rect.Rect as r = tree.damage_at(t, d);
            _changed(n, r.x, r.y, r.w, r.h);
            d = d + 1;
        }
        tree.damage_clear(t);
    }
    if (k == 0 && n.present == 0) { return; }
    // Shown, when the platform's buffer is still the texture's size — a
    // resize just read waits for the next round, and what changed waits with
    // it. Into the buffer goes what it lacks for its age: what changed since
    // it was last shown, all of it when that is not known.
    if (device.next_frame(&n.win) == 0) { return; }
    let is tgt.Target as out = device.acquire(&n.win);
    if (out.width != pw || out.height != ph || cast(i64, out.color) == 0) {
        n.present = 1;
        return;
    }
    let is damage.List as fix;
    if (damage.repair(&n.shown, &n.pending, device.buffer_age(&n.win), pw, ph, &fix) == 0) {
        gpu.texture.read(hs.dv, n.tex, out.color, pw * ph * 4);
        device.submit(&n.win);
    } else if (damage.empty(&fix) == 0) {
        let is i32 as i with mut = 0;
        while (i < fix.n) {
            let is *damage.Rect as r = &fix.rects[i];
            let is *u8 as at = cast(*u8, cast(i64, out.color) + (cast(i64, r.y) * pw + cast(i64, r.x)) * 4);
            gpu.texture.read_region(hs.dv, n.tex, cast(i64, r.x), cast(i64, r.y), cast(i64, r.w), cast(i64, r.h), at, pw * 4);
            i = i + 1;
        }
        device.submit_region(&n.win, &fix);
    }
    damage.push(&n.shown, &n.pending);
    damage.clear(&n.pending);
    n.present = 0;
}

// A rectangle of the window, logical pixels, changed: what it covers in
// physical ones, rounded out, kept until shown.
fn _changed(n as *Native, x as f64, y as f64, w as f64, h as f64) as void {
    let is i64 as x0 = _px_down(x, n.scale);
    let is i64 as y0 = _px_down(y, n.scale);
    let is i64 as x1 = _px_up(x + w, n.scale);
    let is i64 as y1 = _px_up(y + h, n.scale);
    damage.add(&n.pending, x0, y0, x1 - x0, y1 - y0, n.tw, n.th);
}

// Whether a window has something to paint or show.
fn busy(hs as *Host) as i32 {
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0 && (n.present == 1 || app.needs_frame(hs.a, n.h) == 1)) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _first(hs as *Host) as *device.Window {
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        if (_native(hs, i).h != 0) { return &_native(hs, i).win; }
        i = i + 1;
    }
    return cast(*device.Window, 0);
}

// The timers, long presses and animations come due by now: an animation
// steps at its frame clock, not each time X wakes the loop — a frame shown
// is itself an event.
fn _tick(hs as *Host, now as i64) as void {
    let is i64 as due = app.next_due(hs.a);
    if (due >= 0 && due <= now) { app.tick(hs.a, now); }
}

// One round: the windows put up and away as the application's are, every
// event given to it, what was posted run, the timers, the round's callbacks,
// what changed painted and shown — then asleep until something is to be
// done, or timeout_ms (negative: no limit), and what woke it run: a watched
// descriptor's callback, what was posted, the timers come due. 0 once there
// is no window left on the screen and nothing holds the loop, or quit was
// asked; 1 otherwise.
fn step(hs as *Host, timeout_ms as i64) as i32 {
    let is *app.App as a = hs.a;
    _sync(hs);
    let is i64 as now = time.now_ms();
    _events(hs, now);
    _run_posted(hs);
    _tick(hs, now);
    let is i64 as i with mut = 0;
    while (i < hs.nr) {
        call(hs.rcb[i], hs.ruser[i]);
        i = i + 1;
    }
    _sync(hs);
    _paint(hs, now);
    _text_inputs(hs);
    if (hs.quitting == 1) {
        // Said once: a later round goes on.
        hs.quitting = 0;
        return 0;
    }
    if (shown(hs) == 0 && hs.held == 0) { return 0; }
    let is i64 as t with mut = timeout_ms;
    let is i64 as due = app.next_due(a);
    if (due >= 0) {
        let is i64 as d with mut = due - time.now_ms();
        if (d < 0) { d = 0; }
        if (t < 0 || d < t) { t = d; }
    }
    // A window's own input coming due — a held key's repeat on Wayland — in
    // whichever window holds the keyboard.
    i = 0;
    while (i < MAX_WINDOWS) {
        let is *Native as n = _native(hs, i);
        if (n.h != 0) {
            let is i64 as d = device.input_due(&n.win);
            if (d >= 0 && (t < 0 || d < t)) { t = d; }
        }
        i = i + 1;
    }
    if (busy(hs) == 1) { t = 0; }
    let is i32 as got = wait.wait(&hs.wt, _first(hs), t);
    if ((got & wait.DESCRIPTOR) != 0) {
        i = 0;
        while (i < hs.nw) {
            if (wait.readable(&hs.wt, hs.wfd[i]) == 1) { call(hs.wcb[i], hs.wuser[i], hs.wfd[i]); }
            i = i + 1;
        }
    }
    // What woke it, run before it returns: posted, or come due.
    _run_posted(hs);
    _tick(hs, time.now_ms());
    return 1;
}

// Rounds until no window is left on the screen and nothing holds the loop,
// or quit is asked.
fn run(hs as *Host) as void {
    while (step(hs, 0 - 1) == 1) { }
}
