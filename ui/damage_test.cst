// ui/damage_test.cst — what needs repainting, found without painting anything.
//
// Widgets are placed by the root's overlay rule at fixed spots — aligned to
// the top-left, pushed in by their margins — so every rectangle below is known
// exactly. A test checks the region damage.collect leaves in the tree, not
// pixels: painting reads that region, and is tested on its own.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "damage.cst" as damage;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL: %s: got %d, want %d\n", name, got, want);
        fails = fails + 1;
    }
}

fn same_rect(a as math.rect.Rect, x as f64, y as f64, w as f64, h as f64) as i32 {
    if (a.x == x && a.y == y && a.w == w && a.h == h) { return 1; }
    return 0;
}

fn show_region(t as *tree.Tree) as void {
    let is i64 as i with mut = 0;
    while (i < tree.damage_count(t)) {
        let is math.rect.Rect as d = tree.damage_at(t, i);
        io.printf("      damage[%d] = %d,%d %dx%d\n", i, cast(i64, d.x), cast(i64, d.y),
                  cast(i64, d.w), cast(i64, d.h));
        i = i + 1;
    }
}

// Whether r lies inside one rectangle of the region.
fn covered(t as *tree.Tree, r as math.rect.Rect) as i32 {
    let is i64 as i with mut = 0;
    while (i < tree.damage_count(t)) {
        if (math.rect.rect_contains_rect(tree.damage_at(t, i), r) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn area(t as *tree.Tree) as f64 {
    let is f64 as a with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < tree.damage_count(t)) {
        let is math.rect.Rect as d = tree.damage_at(t, i);
        a = a + d.w * d.h;
        i = i + 1;
    }
    return a;
}

// A leaf of a fixed size.
struct Leaf {
    w as f64;
    h as f64;
}

fn leaf_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Leaf as d = cast(*Leaf, data);
    out.min_w = d.w;
    out.min_h = d.h;
    out.pref_w = d.w;
    out.pref_h = d.h;
    out.max_w = d.w;
    out.max_h = d.h;
}

// Children of a leaf are laid out by the overlay rule, so a leaf can hold one.
fn leaf_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    layout.overlay_arrange(t, w, r);
}

let is tree.Kind as leaf_kind with mut;

// A leaf at x, y of the parent, w by h.
fn leaf(t as *tree.Tree, parent as i64, x as f64, y as f64, w as f64, h as f64) as i64 {
    let is i64 as k = tree.create(t, &leaf_kind, parent);
    let is *Leaf as d = cast(*Leaf, tree.data(t, k));
    d.w = w;
    d.h = h;
    layout.set_align(t, k, layout.START, layout.START);
    layout.set_margin(t, k, x, y, 0.0, 0.0);
    return k;
}

// A container laying its children out by the overlay rule, w by h.
fn box_at(t as *tree.Tree, parent as i64, x as f64, y as f64, w as f64, h as f64) as i64 {
    let is i64 as k = leaf(t, parent, x, y, w, h);
    return k;
}

fn frame(t as *tree.Tree, w as f64, h as f64) as i64 {
    layout.run(t, w, h);
    return damage.collect(t);
}

fn main() as i32 {
    leaf_kind = widget.kind("leaf", sizeof(Leaf));
    leaf_kind.measure = fn_ptr(leaf_measure);
    leaf_kind.arrange = fn_ptr(leaf_arrange);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);

    let is i64 as a = leaf(&t, root, 10.0, 10.0, 20.0, 20.0);
    let is i64 as b = leaf(&t, root, 300.0, 200.0, 30.0, 30.0);

    // --- The first frame repaints the window, as one rectangle ---
    check("a new tree wants painting", tree.paint_wanted(&t));
    eq("first frame: one rectangle", frame(&t, 400.0, 300.0), 1);
    check("first frame: the whole window", same_rect(tree.damage_at(&t, 0), 0.0, 0.0, 400.0, 300.0));
    tree.damage_clear(&t);

    // --- Nothing changed, nothing to paint ---
    check("cleared: nothing wanted", 1 - tree.paint_wanted(&t));
    eq("unchanged frame: no damage", frame(&t, 400.0, 300.0), 0);

    // --- One widget changed: its rectangle, exactly ---
    tree.invalidate_paint(&t, a);
    check("invalidated: painting wanted", tree.paint_wanted(&t));
    check("invalidated: the widget is marked", tree.needs_paint(&t, a));
    eq("one widget: one rectangle", frame(&t, 400.0, 300.0), 1);
    check("one widget: its rectangle", same_rect(tree.damage_at(&t, 0), 10.0, 10.0, 20.0, 20.0));
    check("collected: the mark is cleared", 1 - tree.needs_paint(&t, a));
    tree.damage_clear(&t);

    // --- Two apart stay two; overlapping ones merge ---
    tree.invalidate_paint(&t, a);
    tree.invalidate_paint(&t, b);
    eq("two apart: two rectangles", frame(&t, 400.0, 300.0), 2);
    tree.damage_clear(&t);

    let is i64 as c = leaf(&t, root, 25.0, 10.0, 20.0, 20.0);
    frame(&t, 400.0, 300.0);
    tree.damage_clear(&t);
    tree.invalidate_paint(&t, a);
    tree.invalidate_paint(&t, c);
    eq("overlapping: one rectangle", frame(&t, 400.0, 300.0), 1);
    check("overlapping: their union", same_rect(tree.damage_at(&t, 0), 10.0, 10.0, 35.0, 20.0));
    tree.damage_clear(&t);

    // Sharing an edge merges too: the union is exactly the two.
    let is i64 as e2 = leaf(&t, root, 10.0, 30.0, 20.0, 15.0);
    frame(&t, 400.0, 300.0);
    tree.damage_clear(&t);
    tree.invalidate_paint(&t, a);
    tree.invalidate_paint(&t, e2);
    eq("sharing an edge: one rectangle", frame(&t, 400.0, 300.0), 1);
    check("sharing an edge: their union", same_rect(tree.damage_at(&t, 0), 10.0, 10.0, 20.0, 35.0));
    tree.damage_clear(&t);

    // Touching only at a corner does not: the bounding box would double it.
    let is i64 as corner = leaf(&t, root, 30.0, 30.0, 10.0, 10.0);
    frame(&t, 400.0, 300.0);
    tree.damage_clear(&t);
    tree.invalidate_paint(&t, a);
    tree.invalidate_paint(&t, corner);
    eq("touching at a corner: two rectangles", frame(&t, 400.0, 300.0), 2);
    tree.damage_clear(&t);
    tree.destroy(&t, corner);
    tree.destroy(&t, e2);
    frame(&t, 400.0, 300.0);
    tree.damage_clear(&t);

    // --- A rectangle inside another adds nothing ---
    let is i64 as outer = box_at(&t, root, 100.0, 100.0, 80.0, 60.0);
    let is i64 as inner = leaf(&t, outer, 5.0, 5.0, 10.0, 10.0);
    frame(&t, 400.0, 300.0);
    tree.damage_clear(&t);
    tree.invalidate_paint(&t, inner);
    tree.invalidate_paint(&t, outer);
    eq("contained: one rectangle", frame(&t, 400.0, 300.0), 1);
    check("contained: the outer one", same_rect(tree.damage_at(&t, 0), 100.0, 100.0, 80.0, 60.0));
    tree.damage_clear(&t);
    // And a child's rectangle is in window coordinates, not its parent's.
    tree.invalidate_paint(&t, inner);
    frame(&t, 400.0, 300.0);
    check("a child: window coordinates", same_rect(tree.damage_at(&t, 0), 105.0, 105.0, 10.0, 10.0));
    tree.damage_clear(&t);

    // --- Moving repaints where it was and where it is, and nothing else ---
    layout.set_margin(&t, b, 200.0, 150.0, 0.0, 0.0);
    check("a layout change wants painting", tree.paint_wanted(&t));
    frame(&t, 400.0, 300.0);
    check("moved: the old place", covered(&t, math.rect.rect(300.0, 200.0, 30.0, 30.0)));
    check("moved: the new place", covered(&t, math.rect.rect(200.0, 150.0, 30.0, 30.0)));
    check("moved: no more than both", area(&t) <= 1800.0);
    tree.damage_clear(&t);

    // --- Hiding repaints where it was; showing, where it is ---
    tree.set_visible(&t, b, 0);
    frame(&t, 400.0, 300.0);
    check("hidden: its place", covered(&t, math.rect.rect(200.0, 150.0, 30.0, 30.0)));
    check("hidden: nothing more", area(&t) <= 900.0);
    tree.damage_clear(&t);
    eq("hidden and unchanged: no damage", frame(&t, 400.0, 300.0), 0);
    tree.set_visible(&t, b, 1);
    frame(&t, 400.0, 300.0);
    check("shown: its place", covered(&t, math.rect.rect(200.0, 150.0, 30.0, 30.0)));
    tree.damage_clear(&t);

    // A child hidden with its parent is repainted with it, and forgotten.
    tree.set_visible(&t, outer, 0);
    frame(&t, 400.0, 300.0);
    check("hidden parent: its place", covered(&t, math.rect.rect(100.0, 100.0, 80.0, 60.0)));
    tree.damage_clear(&t);
    let is math.rect.Rect as gone = tree.painted(&t, inner);
    check("hidden parent: the child is off screen", math.rect.rect_is_empty(gone));
    tree.set_visible(&t, outer, 1);
    frame(&t, 400.0, 300.0);
    tree.damage_clear(&t);

    // --- Disabling changes how a whole subtree looks ---
    tree.set_enabled(&t, outer, 0);
    check("disabled: the child is marked too", tree.needs_paint(&t, inner));
    frame(&t, 400.0, 300.0);
    check("disabled: the container", covered(&t, math.rect.rect(100.0, 100.0, 80.0, 60.0)));
    tree.damage_clear(&t);
    tree.set_enabled(&t, outer, 1);
    frame(&t, 400.0, 300.0);
    tree.damage_clear(&t);

    // --- Destroying repaints where it was ---
    tree.destroy(&t, c);
    check("destroyed: painting wanted", tree.paint_wanted(&t));
    frame(&t, 400.0, 300.0);
    check("destroyed: its place", covered(&t, math.rect.rect(25.0, 10.0, 20.0, 20.0)));
    tree.damage_clear(&t);
    tree.destroy(&t, outer);
    frame(&t, 400.0, 300.0);
    check("destroyed subtree: its place", covered(&t, math.rect.rect(100.0, 100.0, 80.0, 60.0)));
    tree.damage_clear(&t);

    // --- Reparenting repaints the old place and the new ---
    let is i64 as holder = box_at(&t, root, 250.0, 20.0, 100.0, 100.0);
    frame(&t, 400.0, 300.0);
    tree.damage_clear(&t);
    tree.reparent(&t, a, holder);
    frame(&t, 400.0, 300.0);
    check("reparented: the old place", covered(&t, math.rect.rect(10.0, 10.0, 20.0, 20.0)));
    check("reparented: the new place", covered(&t, math.rect.rect(260.0, 30.0, 20.0, 20.0)));
    tree.damage_clear(&t);

    // --- A resized window is repainted whole ---
    eq("resized: one rectangle", frame(&t, 500.0, 350.0), 1);
    check("resized: the new window", same_rect(tree.damage_at(&t, 0), 0.0, 0.0, 500.0, 350.0));
    tree.damage_clear(&t);

    // --- Damage is kept inside the window ---
    let is math.rect.Rect as half_out = math.rect.rect(480.0, 340.0, 50.0, 50.0);
    tree.damage_add(&t, &half_out);
    damage.collect(&t);
    eq("outside: still one rectangle", tree.damage_count(&t), 1);
    check("outside: clipped to the window", same_rect(tree.damage_at(&t, 0), 480.0, 340.0, 20.0, 10.0));
    tree.damage_clear(&t);
    let is math.rect.Rect as all_out = math.rect.rect(600.0, 10.0, 50.0, 50.0);
    tree.damage_add(&t, &all_out);
    eq("entirely outside: dropped", damage.collect(&t), 0);
    tree.damage_clear(&t);
    let is math.rect.Rect as nothing = math.rect.rect(10.0, 10.0, 0.0, 30.0);
    tree.damage_add(&t, &nothing);
    check("an empty rectangle wants nothing", 1 - tree.paint_wanted(&t));

    // --- What their box would waste kept apart ---
    // A band along a hole's top and one down its side share an edge, but
    // their box would paint the hole: two. Overlapping ones whose box is no
    // larger than both: one; overlapping at a corner, their box larger: two.
    let is math.rect.Rect as top_band = math.rect.rect(100.0, 100.0, 200.0, 10.0);
    let is math.rect.Rect as side_band = math.rect.rect(100.0, 110.0, 10.0, 150.0);
    tree.damage_add(&t, &top_band);
    tree.damage_add(&t, &side_band);
    eq("an L of two bands: two rectangles", tree.damage_count(&t), 2);
    tree.damage_clear(&t);
    let is math.rect.Rect as wide = math.rect.rect(100.0, 100.0, 100.0, 20.0);
    let is math.rect.Rect as wide2 = math.rect.rect(150.0, 100.0, 100.0, 20.0);
    tree.damage_add(&t, &wide);
    tree.damage_add(&t, &wide2);
    eq("overlapping, their box no larger than both: one", tree.damage_count(&t), 1);
    check("their box", same_rect(tree.damage_at(&t, 0), 100.0, 100.0, 150.0, 20.0));
    tree.damage_clear(&t);
    let is math.rect.Rect as sq = math.rect.rect(100.0, 100.0, 20.0, 20.0);
    let is math.rect.Rect as sq2 = math.rect.rect(115.0, 115.0, 20.0, 20.0);
    tree.damage_add(&t, &sq);
    tree.damage_add(&t, &sq2);
    eq("overlapping at a corner, their box larger than both: two", tree.damage_count(&t), 2);
    tree.damage_clear(&t);
    let is math.rect.Rect as row = math.rect.rect(100.0, 100.0, 40.0, 10.0);
    let is math.rect.Rect as next = math.rect.rect(140.0, 100.0, 40.0, 10.0);
    tree.damage_add(&t, &row);
    tree.damage_add(&t, &next);
    eq("side by side, the same height: one", tree.damage_count(&t), 1);
    tree.damage_clear(&t);

    // --- More than the region holds: merged, never dropped ---
    let is [40]i64 as many;
    let is i64 as i with mut = 0;
    while (i < 40) {
        many[i] = leaf(&t, root, cast(f64, (i % 10) * 45), 200.0 + cast(f64, (i / 10) * 30), 6.0, 6.0);
        i = i + 1;
    }
    frame(&t, 500.0, 350.0);
    tree.damage_clear(&t);
    i = 0;
    while (i < 40) { tree.invalidate_paint(&t, many[i]); i = i + 1; }
    let is i64 as n = frame(&t, 500.0, 350.0);
    check("forty apart: within the region's capacity", n <= tree.MAX_DAMAGE);
    check("forty apart: more than one", n > 1);
    i = 0;
    let is i32 as all_covered with mut = 1;
    while (i < 40) {
        if (covered(&t, layout.window_rect(&t, many[i])) == 0) { all_covered = 0; }
        i = i + 1;
    }
    check("forty apart: every one covered", all_covered);
    // The forty cover 1440 square pixels. Merging each into the rectangle it
    // grows least keeps the region near three times that; merging blindly
    // reaches fifteen.
    check("forty apart: merged where it costs least", area(&t) < 6000.0);
    tree.damage_clear(&t);

    // --- Setters say what they changed ---
    let is i64 as s = leaf(&t, root, 400.0, 20.0, 40.0, 40.0);
    frame(&t, 500.0, 350.0);
    tree.damage_clear(&t);
    widget.changed(&t, s, widget.CHANGED_PAINT);
    check("changed paint: marked", tree.needs_paint(&t, s));
    check("changed paint: no layout", 1 - tree.needs_layout(&t, s));
    eq("changed paint: one rectangle", frame(&t, 500.0, 350.0), 1);
    check("changed paint: its rectangle", same_rect(tree.damage_at(&t, 0), 400.0, 20.0, 40.0, 40.0));
    tree.damage_clear(&t);
    widget.changed(&t, s, widget.CHANGED_LAYOUT);
    check("changed layout: needs layout", tree.needs_layout(&t, s));
    check("changed layout: not marked for paint", 1 - tree.needs_paint(&t, s));
    widget.changed(&t, s, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
    check("changed both: needs layout", tree.needs_layout(&t, s));
    check("changed both: marked", tree.needs_paint(&t, s));
    frame(&t, 500.0, 350.0);
    check("changed both: its rectangle", covered(&t, math.rect.rect(400.0, 20.0, 40.0, 40.0)));
    tree.damage_clear(&t);

    if (fails > 0) {
        show_region(&t);
        io.printf("damage: %d failures\n", cast(i64, fails));
        return 1;
    }
    tree.close(&t);
    io.printf("damage: all checks passed\n");
    return 0;
}
