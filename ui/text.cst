// ui/text.cst — the toolkit's text: one service per application that lays
// text out and draws it, and runs — what a widget keeps of its text.
//
// A text/layout Layout carries a shaper and a table of open faces, tens of
// kilobytes; the service owns one and lays out with it whatever a widget asks
// for. What comes back is a Run: each glyph placed — from the run's top
// left, y down, on its baseline — with its face named by font, face index and
// size rather than by a slot of the layout's, which the next layout may give
// to another face; the lines, and what is drawn under and through them. A
// label keeps a run, measures by it and draws it.
//
// Fonts come from the theme through a resolver the program gives: family,
// weight and italic to a text/layout Font — chains over the system's index
// for an application, the test fonts for a test.
//
// Glyphs are drawn from text/'s glyph cache at the size and subpixel step
// they land on — the canvas's scale included — coverage on render/coverage's
// R8 pages and colour glyphs on RGBA pages of the service's own. A page's
// changed part goes to its texture as soon as a draw has put glyphs on it, so
// a subtree painted into a texture of its own, flushed before the frame is,
// finds them there. The service works with no device for measuring alone.
use "std/mem.cst" as mem;
use "../math/math.cst" as math;
use "../image/image.cst" as image;
use "../gpu/device.cst" as dev;
use "../gpu/texture.cst" as texture;
use "../render/draw2d.cst" as draw2d;
use "../render/shapes2d.cst" as shapes;
use "../render/coverage.cst" as coverage;
use "../text/sfnt/table.cst" as table;
use "../text/sfnt/var.cst" as var;
use "../text/outline/outline.cst" as outline;
use "../text/raster/raster.cst" as raster;
use "../text/atlas.cst" as atlas;
use "../text/color/color.cst" as color;
use "../text/layout/model.cst" as model;
use "../text/layout/font.cst" as font;
use "../text/layout/layout.cst" as layout;
use "style.cst" as style;

// A text/layout Font for a family, a weight (100 to 900) and italic or not;
// null when there is none. user is what the program gave with it.
type ResolveFn = fn(*u8, *u8, i64, i32) as *font.Font;

let is i64 as MAX_FONTS  with imut = 16;   // families, weights and styles remembered
let is i64 as MAX_STYLES with imut = 16;   // styles in one run
let is i64 as MAX_COLOR_PAGES with imut = 16;

// How much a service holds, sized once: the glyph pages and their side — the
// largest glyph it draws — the glyphs the caches remember, and the faces open
// for drawing at once.
struct Limits {
    page         as i64;   // coverage, R8
    pages        as i64;   // up to coverage.MAX_PAGES
    color_page   as i64;   // colour glyphs, RGBA
    color_pages  as i64;   // up to MAX_COLOR_PAGES
    glyphs       as i64;   // coverage glyphs remembered
    color_glyphs as i64;
    faces        as i64;
}

fn limits_default() as Limits {
    let is Limits as l;
    l.page = 512;
    l.pages = 8;
    l.color_page = 512;
    l.color_pages = 4;
    l.glyphs = 4096;
    l.color_glyphs = 512;
    l.faces = 64;
    return l;
}

// --- Styles ---

// How a stretch of text is set: a family (null for the theme's), a size in
// logical pixels, a weight, italic; drawn underlined or struck through, in a
// colour — one of alpha 0 is whatever the run is drawn in.
struct Style {
    family    as *u8;
    size      as f64;
    weight    as i64;
    italic    as i32;
    underline as i32;
    strike    as i32;
    _pad0     as i32;
    color     as math.color.Color;
}

// The theme's text of a role: its family, size and weight.
fn style_of(ts as style.TextStyle) as Style {
    let is Style as s;
    s.family = cast(*u8, 0);
    s.size = ts.size;
    s.weight = ts.weight;
    s.italic = 0;
    s.underline = 0;
    s.strike = 0;
    s._pad0 = 0;
    s.color = math.color.rgba(0.0, 0.0, 0.0, 0.0);
    return s;
}

// --- Runs ---

struct Glyph {
    x       as f64;   // the pen, from the run's top left
    y       as f64;   // the baseline
    adv     as f64;   // its advance, along the line
    id      as i64;
    face    as i64;   // in the run's faces
    style   as i64;   // in the run's styles
    cluster as i64;   // the byte offset of the first character it came from
}

struct Face {
    font    as *font.Font;
    index   as i64;
    px      as f64;
    under_y as f64;   // an underline's top, below the baseline
    under_h as f64;   // and its thickness
}

struct Line {
    x      as f64;   // its content's left
    top    as f64;
    y      as f64;   // the baseline
    width  as f64;
    height as f64;
    start  as i64;   // bytes
    end    as i64;
}

struct Deco {
    x     as f64;
    y     as f64;
    w     as f64;
    h     as f64;
    style as i64;
}

// What a widget keeps of its text: the text itself and how it was last laid
// out, in one block — the text, then the glyphs, the faces, the lines, the
// decorations and each style's colour. A label's whole text is one mapping.
struct Run {
    block   as *u8;
    bytes   as i64;   // the block's size
    nbytes  as i64;   // the text's
    nglyphs as i64;
    nfaces  as i64;
    nlines  as i64;
    ndecos  as i64;
    nstyles as i64;
    width   as f64;   // the widest line's content
    height  as f64;
    least   as f64;   // the widest stretch between break opportunities: no narrower breaks a word
    cut     as i32;   // max_lines left text out
    ok      as i32;   // laid out since the text was set
}

fn run() as Run {
    let is Run as r;
    r.block = cast(*u8, 0);
    r.bytes = 0;
    r.nbytes = 0;
    r.nglyphs = 0;
    r.nfaces = 0;
    r.nlines = 0;
    r.ndecos = 0;
    r.nstyles = 0;
    r.width = 0.0;
    r.height = 0.0;
    r.least = 0.0;
    r.cut = 0;
    r.ok = 0;
    return r;
}

fn _forget(r as *Run) as void {
    r.nglyphs = 0;
    r.nfaces = 0;
    r.nlines = 0;
    r.ndecos = 0;
    r.nstyles = 0;
    r.width = 0.0;
    r.height = 0.0;
    r.least = 0.0;
    r.cut = 0;
    r.ok = 0;
}

fn run_close(r as *Run) as void {
    if (r.bytes > 0) { mem.core.munmap(r.block, r.bytes); }
    r.block = cast(*u8, 0);
    r.bytes = 0;
    r.nbytes = 0;
    _forget(r);
}

fn _a8(n as i64) as i64 { return (n + 7) / 8 * 8; }

// The block at least need bytes, its first keep kept: 1, or 0 when memory is
// refused, the run as it was.
fn _room(r as *Run, need as i64, keep as i64) as i32 {
    if (need <= r.bytes) { return 1; }
    let is i64 as size = (need + 4095) / 4096 * 4096;
    let is *u8 as nb = mem.core.mmap_anon(size);
    if (cast(i64, nb) <= 0) { return 0; }
    if (keep > 0) { mem.memcpy(nb, r.block, keep); }
    if (r.bytes > 0) { mem.core.munmap(r.block, r.bytes); }
    r.block = nb;
    r.bytes = size;
    return 1;
}

// The run's text from here on: n bytes of UTF-8 copied in — from anywhere,
// the run's own text included — and nothing laid out. 1, or 0 when memory is
// refused, the run as it was.
fn set_text(r as *Run, text as *u8, n as i64) as i32 {
    if (n < 0) { return 0; }
    let is i64 as at = cast(i64, text) - cast(i64, r.block);
    if (r.bytes > 0 && at >= 0 && at < r.bytes) {
        // Part of its own: moved to the front, which is never past it.
        let is i64 as i with mut = 0;
        while (i < n) {
            r.block[i] = r.block[at + i];
            i = i + 1;
        }
    } else {
        if (_room(r, _a8(n), 0) == 0) { return 0; }
        if (n > 0) { mem.memcpy(r.block, text, n); }
    }
    r.nbytes = n;
    _forget(r);
    return 1;
}

// The text, which the caller may change in place before the run is laid out
// again; set_length shortens it.
fn text_of(r as *Run) as *u8 { return r.block; }
fn text_length(r as *Run) as i64 { return r.nbytes; }

fn set_length(r as *Run, n as i64) as void {
    if (n >= 0 && n <= r.nbytes) {
        r.nbytes = n;
        _forget(r);
    }
}

fn _glyphs(r as *Run) as i64 { return cast(i64, r.block) + _a8(r.nbytes); }
fn _faces(r as *Run) as i64 { return _glyphs(r) + r.nglyphs * sizeof(Glyph); }
fn _lines(r as *Run) as i64 { return _faces(r) + r.nfaces * sizeof(Face); }
fn _decos(r as *Run) as i64 { return _lines(r) + r.nlines * sizeof(Line); }
fn _colors(r as *Run) as i64 { return _decos(r) + r.ndecos * sizeof(Deco); }

fn glyph_count(r as *Run) as i64 { return r.nglyphs; }
fn glyph(r as *Run, i as i64) as *Glyph { return cast(*Glyph, _glyphs(r) + i * sizeof(Glyph)); }
fn face_count(r as *Run) as i64 { return r.nfaces; }
fn face(r as *Run, i as i64) as *Face { return cast(*Face, _faces(r) + i * sizeof(Face)); }
fn line_count(r as *Run) as i64 { return r.nlines; }
fn line(r as *Run, i as i64) as *Line { return cast(*Line, _lines(r) + i * sizeof(Line)); }
fn deco_count(r as *Run) as i64 { return r.ndecos; }
fn deco(r as *Run, i as i64) as *Deco { return cast(*Deco, _decos(r) + i * sizeof(Deco)); }

// Style k's colour, alpha 0 when it has none of its own.
fn color_of(r as *Run, k as i64) as math.color.Color {
    return *cast(*math.color.Color, _colors(r) + k * sizeof(math.color.Color));
}

// The rectangle under the character at byte offset at — its glyphs', where an
// underline of it alone would be drawn — into *out: 1, or 0 when no glyph
// starts there. The underlined letter of a mnemonic.
fn underline_at(r as *Run, at as i64, out as *Deco) as i32 {
    let is i32 as any with mut = 0;
    let is f64 as x1 with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < r.nglyphs) {
        let is *Glyph as g = glyph(r, i);
        if (g.cluster == at) {
            let is *Face as f = face(r, g.face);
            if (any == 0) {
                out.x = g.x;
                out.y = g.y + f.under_y;
                out.h = f.under_h;
                out.style = g.style;
                x1 = g.x + g.adv;
                any = 1;
            } else {
                if (g.x < out.x) { out.x = g.x; }
                if (g.x + g.adv > x1) { x1 = g.x + g.adv; }
            }
        }
        i = i + 1;
    }
    if (any == 1) { out.w = x1 - out.x; }
    return any;
}

// The first line's baseline, from the run's top; 0 for a run of no lines.
fn baseline(r as *Run) as f64 {
    if (r.nlines == 0) { return 0.0; }
    return line(r, 0).y;
}

// --- The service ---

struct Resolved {
    family as *u8;
    weight as i64;
    italic as i64;
    font   as *font.Font;
}

// A face open for drawing: the reader rasterizing it, and the glyph cache's
// name for it, new each time it is opened.
struct Open {
    font  as *font.Font;
    index as i64;
    px    as f64;
    id    as i64;     // 0 for an entry not in use
    used  as i64;     // the frame it was last drawn in
    face  as *table.Face;
    r     as outline.Reader;
}

struct Service {
    lay      as layout.Layout;
    resolve  as ResolveFn;
    user     as *u8;
    family   as *u8;                   // the theme's interface font
    fonts    as [16]Resolved;
    nfonts   as i64;
    opens    as *Open;
    nopens   as i64;
    next_id  as i64;
    frame    as i64;
    d        as *dev.Device;
    cov      as coverage.Coverage;
    path     as outline.path.Path;
    cache    as atlas.Cache;
    colors   as image.atlas.Atlas;
    ctex     as [16]i64;                 // each colour page's texture; 0 until made
    ccache   as atlas.Cache;
    painter  as color.Painter;
    lstyles  as [16]model.Style;
    drawing  as i32;                   // a device to draw with
    _pad0    as i32;
}

// A service on device d — null to measure alone — holding what l says,
// resolving fonts with resolve(user, ...). family is the theme's interface
// font, what a style of no family of its own is set in. Null when memory is
// refused; on a device, drawing is 0 when the pages were.
fn open(d as *dev.Device, l as *Limits, resolve as ResolveFn, user as *u8, family as *u8) as *Service {
    // Both mappings come zeroed: no fonts resolved, no face open, no colour
    // page's texture made.
    let is *Service as s = cast(*Service, mem.core.mmap_anon(sizeof(Service)));
    if (cast(i64, s) <= 0) { return cast(*Service, 0); }
    s.nopens = l.faces;
    if (s.nopens < 1) { s.nopens = 1; }
    s.opens = cast(*Open, mem.core.mmap_anon(s.nopens * sizeof(Open)));
    if (cast(i64, s.opens) <= 0) {
        mem.core.munmap(cast(*u8, s), sizeof(Service));
        return cast(*Service, 0);
    }
    layout.open(&s.lay);
    s.resolve = resolve;
    s.user = user;
    s.family = family;
    s.next_id = 1;
    s.frame = 1;
    s.d = d;
    if (cast(i64, d) != 0) {
        let is i64 as cp with mut = l.color_pages;
        if (cp > MAX_COLOR_PAGES) { cp = MAX_COLOR_PAGES; }
        s.cov = coverage.open(d, l.page, l.pages, l.page);
        s.path = outline.path.open(65536);
        s.cache = atlas.open(&s.cov.atlas, &s.cov.raster, &s.path, l.glyphs, 4, 1);
        s.colors = image.atlas.open(l.color_page, l.color_page, image.RGBA8, cp);
        s.ccache = atlas.open(&s.colors, &s.cov.raster, &s.path, l.color_glyphs, 1, 1);
        s.painter = color.painter(&s.cov.raster, &s.path);
        if (coverage.ok(&s.cov) == 1 && atlas.ok(&s.cache) == 1 && atlas.ok(&s.ccache) == 1 &&
            image.atlas.ok(&s.colors) == 1) {
            s.drawing = 1;
        }
    }
    return s;
}

fn close(s as *Service) as void {
    let is i64 as i with mut = 0;
    while (i < s.nopens) {
        let is *Open as o = &s.opens[i];
        if (o.id != 0) { outline.close(&o.r); }
        o.id = 0;
        i = i + 1;
    }
    if (cast(i64, s.d) != 0) {
        i = 0;
        while (i < MAX_COLOR_PAGES) {
            if (s.ctex[i] != 0) { texture.destroy(s.d, s.ctex[i]); }
            s.ctex[i] = 0;
            i = i + 1;
        }
        color.close(&s.painter);
        atlas.close(&s.ccache);
        image.atlas.close(&s.colors);
        atlas.close(&s.cache);
        outline.path.close(&s.path);
        coverage.close(&s.cov);
    }
    layout.close(&s.lay);
    mem.core.munmap(cast(*u8, s.opens), s.nopens * sizeof(Open));
    mem.core.munmap(cast(*u8, s), sizeof(Service));
}

// The interface font a style of no family is set in, from here on.
fn set_family(s as *Service, family as *u8) as void { s.family = family; }

// A frame begins: what the glyph caches hold for it is kept until the next.
fn next_frame(s as *Service) as void {
    s.frame = s.frame + 1;
    if (s.drawing == 1) {
        atlas.next_frame(&s.cache);
        atlas.next_frame(&s.ccache);
        coverage.next_frame(&s.cov);
        image.atlas.next_frame(&s.colors);
    }
}

fn _same(a as *u8, b as *u8) as i32 {
    if (cast(i64, a) == cast(i64, b)) { return 1; }
    if (cast(i64, a) == 0 || cast(i64, b) == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    return cast(i32, a[i] == b[i]);
}

// The font for a family, weight and style: resolved once and remembered.
fn font_for(s as *Service, family as *u8, weight as i64, italic as i32) as *font.Font {
    let is *u8 as fam with mut = family;
    if (cast(i64, fam) == 0) { fam = s.family; }
    let is i64 as i with mut = 0;
    while (i < s.nfonts) {
        let is *Resolved as rv = &s.fonts[i];
        if (rv.weight == weight && rv.italic == cast(i64, italic) && _same(rv.family, fam) == 1) { return rv.font; }
        i = i + 1;
    }
    let is *font.Font as f = call(s.resolve, s.user, fam, weight, italic);
    if (cast(i64, f) == 0) { return f; }
    // Past the table's room, resolved each time: still right, only slower.
    if (s.nfonts < MAX_FONTS) {
        let is *Resolved as rv = &s.fonts[s.nfonts];
        rv.family = fam;
        rv.weight = weight;
        rv.italic = cast(i64, italic);
        rv.font = f;
        s.nfonts = s.nfonts + 1;
    }
    return f;
}

// --- Laying out ---

// The run's text set in styles, each span of it in its style and the rest
// in style 0, in the box params describes: 1, or 0 when it could not be — a
// style with no font, more than MAX_STYLES of them, memory refused, or what
// layout refuses — and then nothing is laid out.
// The text — nbytes of UTF-8 — set in styles, as lay_text sets a run's, into
// a text/layout Layout of the caller's: for a widget that asks the cursor's
// questions of it. Its styles' fonts go in lstyles, MAX_STYLES of
// text/layout's own, which the layout reads while it is used. 1, or 0 as
// lay_text.
fn lay_layout(s as *Service, l as *layout.Layout, lstyles as *model.Style, text as *u8, nbytes as i64,
              styles as *Style, nstyles as i64, spans as *model.Span, nspans as i64,
              params as *model.Params) as i32 {
    if (nstyles < 1 || nstyles > MAX_STYLES) { return 0; }
    let is i64 as k with mut = 0;
    while (k < nstyles) {
        let is *Style as st = &styles[k];
        let is *model.Style as ls = &lstyles[k];
        mem.memset(cast(*u8, ls), 0, sizeof(model.Style));
        ls.font = font_for(s, st.family, st.weight, st.italic);
        if (cast(i64, ls.font) == 0) { return 0; }
        ls.px = st.size;
        ls.underline = st.underline;
        ls.strike = st.strike;
        k = k + 1;
    }
    return layout.set(l, text, nbytes, lstyles, nstyles, spans, nspans, params);
}

fn lay_text(s as *Service, r as *Run, styles as *Style, nstyles as i64, spans as *model.Span, nspans as i64,
            params as *model.Params) as i32 {
    _forget(r);
    let is *layout.Layout as l = &s.lay;
    if (lay_layout(s, l, cast(*model.Style, &s.lstyles), r.block, r.nbytes, styles, nstyles, spans, nspans,
                   params) == 0) {
        return 0;
    }
    let is i64 as k with mut = 0;
    // The faces, each layout slot's once, in the order glyphs first use
    // them. A layout has no more slots than font.MAX_SIZED, and never one
    // face in two.
    let is [16]i64 as of_slot;
    let is [16]Face as found;
    let is i64 as nf with mut = 0;
    k = 0;
    while (k < font.MAX_SIZED) {
        of_slot[k] = 0 - 1;
        k = k + 1;
    }
    let is i64 as ng = layout.glyph_count(l);
    let is i64 as i with mut = 0;
    while (i < ng) {
        let is i64 as slot = cast(i64, layout.glyph(l, i).slot);
        if (of_slot[slot] < 0) {
            let is *font.Sized as z = layout.face(l, slot);
            found[nf].font = z.font;
            found[nf].index = z.index;
            found[nf].px = z.px;
            // As text/layout puts an underline: the face's own, or a tenth
            // of an em down and a fourteenth thick when it says none.
            let is f64 as em = cast(f64, z.m.upem);
            let is f64 as thick with mut = cast(f64, z.m.underline_thickness);
            if (thick <= 0.0) { thick = em / 14.0; }
            let is f64 as pos with mut = cast(f64, z.m.underline_pos);
            if (pos == 0.0) { pos = 0.0 - em / 10.0; }
            found[nf].under_y = 0.0 - pos * z.scale;
            found[nf].under_h = thick * z.scale;
            of_slot[slot] = nf;
            nf = nf + 1;
        }
        i = i + 1;
    }
    let is i64 as nl = layout.line_count(l);
    let is i64 as nd = layout.deco_count(l);
    let is i64 as need = _a8(r.nbytes) + ng * sizeof(Glyph) + nf * sizeof(Face) + nl * sizeof(Line) +
                         nd * sizeof(Deco) + nstyles * sizeof(math.color.Color);
    if (_room(r, need, r.nbytes) == 0) { return 0; }
    r.nglyphs = ng;
    r.nfaces = nf;
    r.nlines = nl;
    r.ndecos = nd;
    r.nstyles = nstyles;
    i = 0;
    while (i < ng) {
        let is *model.Glyph as g = layout.glyph(l, i);
        let is *Glyph as out = glyph(r, i);
        out.x = g.x;
        out.y = g.y;
        out.adv = g.adv;
        out.id = cast(i64, g.id);
        out.face = of_slot[cast(i64, g.slot)];
        out.style = cast(i64, g.style);
        out.cluster = cast(i64, g.cluster);
        i = i + 1;
    }
    i = 0;
    while (i < nf) {
        *face(r, i) = found[i];
        i = i + 1;
    }
    i = 0;
    while (i < nl) {
        let is *model.Line as ml = layout.line(l, i);
        let is *Line as ln = line(r, i);
        ln.x = ml.x;
        ln.top = ml.top;
        ln.y = ml.y;
        ln.width = ml.width;
        ln.height = ml.height;
        ln.start = ml.start;
        ln.end = ml.end;
        i = i + 1;
    }
    i = 0;
    while (i < nd) {
        let is *model.Deco as md = layout.deco(l, i);
        let is *Deco as dc = deco(r, i);
        dc.x = md.x;
        dc.y = md.y;
        dc.w = md.w;
        dc.h = md.h;
        dc.style = md.style;
        i = i + 1;
    }
    k = 0;
    while (k < nstyles) {
        *cast(*math.color.Color, _colors(r) + k * sizeof(math.color.Color)) = styles[k].color;
        k = k + 1;
    }
    r.width = layout.width(l);
    r.height = layout.height(l);
    r.least = layout.min_width(l);
    r.cut = layout.cut(l);
    r.ok = 1;
    return 1;
}

// The text — nbytes of UTF-8, copied into the run — laid out as lay_text
// does.
fn lay(s as *Service, r as *Run, text as *u8, nbytes as i64, styles as *Style, nstyles as i64,
       spans as *model.Span, nspans as i64, params as *model.Params) as i32 {
    if (set_text(r, text, nbytes) == 0) { return 0; }
    return lay_text(s, r, styles, nstyles, spans, nspans, params);
}

// One style over the whole of the text: the common case.
fn lay_plain(s as *Service, r as *Run, text as *u8, nbytes as i64, st as *Style, params as *model.Params) as i32 {
    return lay(s, r, text, nbytes, st, 1, cast(*model.Span, 0), 0, params);
}

// --- Drawing ---

// The open entry for a run's face: found, or opened in the place used
// longest ago — never one drawn from in this frame. Null when none.
fn _open(s as *Service, fc as *Face) as *Open {
    let is i64 as free with mut = 0 - 1;
    let is i64 as oldest with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < s.nopens) {
        let is *Open as o = &s.opens[i];
        if (o.id != 0 && cast(i64, o.font) == cast(i64, fc.font) && o.index == fc.index && o.px == fc.px) {
            o.used = s.frame;
            return o;
        }
        if (o.id == 0 && free < 0) { free = i; }
        if (o.id != 0 && o.used < s.frame && (oldest < 0 || o.used < s.opens[oldest].used)) { oldest = i; }
        i = i + 1;
    }
    let is i64 as at with mut = free;
    if (at < 0) { at = oldest; }
    if (at < 0) { return cast(*Open, 0); }
    let is var.Coords as c;
    let is *table.Face as f = call(fc.font.face, fc.font.user, fc.index, fc.px, &c);
    if (cast(i64, f) == 0) { return cast(*Open, 0); }
    let is *Open as o = &s.opens[at];
    if (o.id != 0) { outline.close(&o.r); }
    o.font = fc.font;
    o.index = fc.index;
    o.px = fc.px;
    o.face = f;
    o.r = outline.open(f);
    outline.vary(&o.r, &c);
    o.id = s.next_id;
    s.next_id = s.next_id + 1;
    o.used = s.frame;
    return o;
}

// Colour page p's texture, made the first time it is asked for.
fn _color_texture(s as *Service, p as i64) as i64 {
    if (s.ctex[p] == 0) {
        let is texture.Desc as td = texture.desc(s.colors.w, s.colors.h, texture.RGBA8, texture.SAMPLED);
        s.ctex[p] = texture.create(s.d, &td);
    }
    return s.ctex[p];
}

// Every changed part of every page sent to its texture: 1, or 0 when the
// device refused one.
fn upload(s as *Service) as i32 {
    if (s.drawing == 0) { return 1; }
    let is i32 as ok with mut = coverage.upload(&s.cov);
    let is i64 as p with mut = 0;
    while (p < image.atlas.pages(&s.colors)) {
        let is image.atlas.Region as rg;
        if (image.atlas.dirty(&s.colors, p, &rg) == 1) {
            let is *image.buffer.Image as pg = image.atlas.page(&s.colors, p);
            let is *u8 as at = cast(*u8, cast(i64, pg.pixels) + rg.y * pg.stride + rg.x * 4);
            if (texture.upload_region(s.d, _color_texture(s, p), rg.x, rg.y, rg.w, rg.h, at, pg.stride) == 0) {
                ok = 0;
            }
            image.atlas.clean(&s.colors, p);
        }
        p = p + 1;
    }
    return ok;
}

fn _rgba(c as math.color.Color) as u32 {
    let is i64 as r = cast(i64, c.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, c.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, c.b * 255.0 + 0.5);
    let is i64 as a = cast(i64, c.a * 255.0 + 0.5);
    return cast(u32, (r << 24) | (g << 16) | (b << 8) | a);
}

// Run r drawn on c with its top left at (x, y), logical pixels, in fg where
// a style gives no colour of its own. Glyphs land on the canvas's physical
// pixels, a quarter of one apart across. 1, or 0 when a glyph found no room
// in this frame or the device refused a page — what did fit is drawn.
fn draw(s as *Service, c as *draw2d.Canvas, r as *Run, x as f64, y as f64, fg as math.color.Color) as i32 {
    if (s.drawing == 0 || r.ok == 0) { return 0; }
    let is i32 as ok with mut = 1;
    let is f64 as k = draw2d.scale(c);
    let is f64 as pw = cast(f64, s.cov.atlas.w);
    let is f64 as ph = cast(f64, s.cov.atlas.h);
    let is f64 as cw = cast(f64, s.colors.w);
    let is f64 as chh = cast(f64, s.colors.h);
    let is i64 as i with mut = 0;
    while (i < r.nglyphs) {
        let is *Glyph as g = glyph(r, i);
        let is *Face as fc = face(r, g.face);
        let is *Open as o = _open(s, fc);
        let is math.color.Color as col with mut = color_of(r, g.style);
        if (col.a <= 0.0) { col = fg; }
        if (cast(i64, o) == 0) {
            ok = 0;
        } else {
            let is f64 as px = fc.px * k;
            let is f64 as gx = (x + g.x) * k;
            let is f64 as gy = (y + g.y) * k;
            let is atlas.Placed as pl;
            if (color.kind(o.face, g.id) == color.NONE) {
                let is i32 as got = atlas.get(&s.cache, &o.r, o.id, px, g.id, gx, gy, &pl);
                if (got == atlas.NO_ROOM) { ok = 0; }
                if (got == atlas.PLACED && pl.w > 0 && pl.h > 0) {
                    let is i64 as tex = coverage.texture_of(&s.cov, pl.page);
                    draw2d.glyph(c, tex, cast(f64, pl.x) / k, cast(f64, pl.y) / k, cast(f64, pl.w) / k,
                                 cast(f64, pl.h) / k, cast(f64, pl.sx) / pw, cast(f64, pl.sy) / ph,
                                 cast(f64, pl.sx + pl.w) / pw, cast(f64, pl.sy + pl.h) / ph, col);
                }
            } else {
                // A layer may be in the text's colour, so the colour is
                // part of what the glyph is cached under — opaque: the
                // text's opacity comes after, over all of the glyph.
                let is u32 as fgc = _rgba(math.color.rgba(col.r, col.g, col.b, 1.0));
                let is i64 as key = (o.id << 32) | (cast(i64, fgc) & 4294967295);
                let is i32 as got = color.get(&s.ccache, &s.painter, &o.r, key, px, g.id, gx, gy, 0, fgc, &pl);
                if (got == atlas.NO_ROOM) { ok = 0; }
                if (got == atlas.PLACED && pl.w > 0 && pl.h > 0) {
                    let is i64 as tex = _color_texture(s, pl.page);
                    // Colour glyphs keep their colours; only the text's
                    // opacity reaches them.
                    let is f64 as a = col.a;
                    draw2d.image_premultiplied(c, tex, 0, cast(f64, pl.x) / k, cast(f64, pl.y) / k,
                                               cast(f64, pl.w) / k, cast(f64, pl.h) / k,
                                               cast(f64, pl.sx) / cw, cast(f64, pl.sy) / chh,
                                               cast(f64, pl.sx + pl.w) / cw, cast(f64, pl.sy + pl.h) / chh,
                                               math.color.rgba(a, a, a, a));
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < r.ndecos) {
        let is *Deco as dc = deco(r, i);
        let is math.color.Color as col with mut = color_of(r, dc.style);
        if (col.a <= 0.0) { col = fg; }
        shapes.fill_rect(c, x + dc.x, y + dc.y, dc.w, dc.h, col);
        i = i + 1;
    }
    if (upload(s) == 0) { ok = 0; }
    return ok;
}
