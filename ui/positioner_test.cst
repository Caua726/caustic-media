// ui/positioner_test.cst — where a popup goes: Wayland's xdg_positioner,
// the most constrained of the three platforms' models, as plain geometry.
//
// A popup of a size is put against a point of an anchor rectangle, growing
// the way its gravity says, moved by an offset; when that leaves the bounds
// on an axis, the adjustments allowed are tried on it in the spec's order —
// flipped to the other side if that fits, slid back inside, cut to fit.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "positioner.cst" as positioner;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn at(r as math.rect.Rect, x as f64, y as f64, w as f64, h as f64) as i32 {
    return cast(i32, r.x == x && r.y == y && r.w == w && r.h == h);
}

fn main() as i32 {
    let is math.rect.Rect as win = math.rect.rect(0.0, 0.0, 400.0, 300.0);
    // An item at 100,100, 80 by 20; a popup 120 by 90.
    let is positioner.Positioner as p with mut = positioner.make(120.0, 90.0, math.rect.rect(100.0, 100.0, 80.0, 20.0));
    check("by default: centred on the anchor's centre", at(positioner.place(&p, win), 80.0, 65.0, 120.0, 90.0) == 1);
    p.anchor = positioner.BOTTOM_LEFT;
    p.gravity = positioner.BOTTOM_RIGHT;
    check("below it, from its left", at(positioner.place(&p, win), 100.0, 120.0, 120.0, 90.0) == 1);
    p.anchor = positioner.TOP_RIGHT;
    p.gravity = positioner.BOTTOM_RIGHT;
    check("beside it, from its top", at(positioner.place(&p, win), 180.0, 100.0, 120.0, 90.0) == 1);
    p.anchor = positioner.TOP;
    p.gravity = positioner.TOP;
    check("above it, centred", at(positioner.place(&p, win), 80.0, 10.0, 120.0, 90.0) == 1);
    p.anchor = positioner.LEFT;
    p.gravity = positioner.LEFT;
    check("left of it, centred across", at(positioner.place(&p, win), 0.0 - 20.0, 65.0, 120.0, 90.0) == 1);
    p.anchor = positioner.BOTTOM_RIGHT;
    p.gravity = positioner.TOP_LEFT;
    check("ending at its far corner", at(positioner.place(&p, win), 60.0, 30.0, 120.0, 90.0) == 1);
    p.anchor = positioner.BOTTOM_LEFT;
    p.gravity = positioner.BOTTOM_RIGHT;
    p.off_x = 4.0;
    p.off_y = 0.0 - 2.0;
    check("moved by its offset", at(positioner.place(&p, win), 104.0, 118.0, 120.0, 90.0) == 1);
    p.off_x = 0.0;
    p.off_y = 0.0;

    // Constrained: nothing allowed, as it was.
    p.anchor_rect = math.rect.rect(340.0, 250.0, 40.0, 20.0);
    check("past the bounds, nothing allowed: as it was", at(positioner.place(&p, win), 340.0, 270.0, 120.0, 90.0) == 1);
    // Flipped: to the other side when that fits.
    p.adjust = positioner.FLIP_X | positioner.FLIP_Y;
    check("flipped both ways", at(positioner.place(&p, win), 260.0, 160.0, 120.0, 90.0) == 1);
    p.adjust = positioner.FLIP_Y;
    check("flipped down to up only", at(positioner.place(&p, win), 340.0, 160.0, 120.0, 90.0) == 1);
    // Slid: back inside.
    p.adjust = positioner.SLIDE_X | positioner.SLIDE_Y;
    check("slid both ways", at(positioner.place(&p, win), 280.0, 210.0, 120.0, 90.0) == 1);
    // Flip first, then slide what still does not fit.
    p.anchor_rect = math.rect.rect(340.0, 10.0, 40.0, 20.0);
    p.h = 290.0;
    p.adjust = positioner.FLIP_X | positioner.FLIP_Y | positioner.SLIDE_Y;
    check("flipped across; up would not fit either: slid", at(positioner.place(&p, win), 260.0, 10.0, 120.0, 290.0) == 1);
    // Resized: cut to the bounds.
    p.adjust = positioner.RESIZE_Y;
    check("cut to fit", at(positioner.place(&p, win), 340.0, 30.0, 120.0, 270.0) == 1);
    p.adjust = positioner.RESIZE_X | positioner.RESIZE_Y;
    check("cut both ways", at(positioner.place(&p, win), 340.0, 30.0, 60.0, 270.0) == 1);
    // Larger than the bounds: slid to their start.
    p.h = 400.0;
    p.adjust = positioner.SLIDE_Y;
    check("larger than the bounds: at their start", positioner.place(&p, win).y == 0.0);
    // Flipped and still constrained: the flip undone, the slide after it.
    p.h = 90.0;
    p.anchor_rect = math.rect.rect(150.0, 50.0, 40.0, 160.0);
    p.adjust = positioner.FLIP_Y;
    let is math.rect.Rect as tall_win = math.rect.rect(0.0, 0.0, 400.0, 250.0);
    check("no room either side: the flip undone", at(positioner.place(&p, tall_win), 150.0, 210.0, 120.0, 90.0) == 1);
    // Leaving to the left: slid, flipped.
    p.anchor = positioner.BOTTOM_LEFT;
    p.gravity = positioner.BOTTOM_LEFT;
    p.anchor_rect = math.rect.rect(30.0, 50.0, 40.0, 20.0);
    p.adjust = positioner.SLIDE_X;
    check("past the left: slid right", positioner.place(&p, win).x == 0.0);
    p.adjust = positioner.FLIP_X;
    check("past the left: flipped right", positioner.place(&p, win).x == 70.0);
    // Bounds not at the origin.
    p.anchor_rect = math.rect.rect(100.0, 50.0, 40.0, 20.0);
    let is math.rect.Rect as inner = math.rect.rect(50.0, 40.0, 200.0, 200.0);
    p.adjust = positioner.SLIDE_X | positioner.SLIDE_Y;
    let is math.rect.Rect as q with mut = positioner.place(&p, inner);
    check("bounds of their own: inside them", q.x == 50.0 && q.y == 70.0);
    p.adjust = positioner.RESIZE_X;
    q = positioner.place(&p, inner);
    check("cut on the left", q.x == 50.0 && q.w == 50.0);
    p.anchor_rect = math.rect.rect(30.0, 50.0, 40.0, 20.0);
    check("nothing left of it to show: not cut", positioner.place(&p, inner).w == 120.0);
    p.anchor_rect = math.rect.rect(50.0, 50.0, 40.0, 20.0);
    q = positioner.place(&p, inner);
    check("cut to nothing: not cut", q.x == 0.0 - 70.0 && q.w == 120.0);
    // Just touching an edge fits: nothing to flip.
    p.anchor = positioner.BOTTOM_LEFT;
    p.gravity = positioner.BOTTOM_RIGHT;
    p.adjust = positioner.FLIP_X;
    p.anchor_rect = math.rect.rect(280.0, 50.0, 40.0, 20.0);
    check("ending at the right edge: kept", positioner.place(&p, win).x == 280.0);
    p.anchor_rect = math.rect.rect(0.0, 50.0, 200.0, 20.0);
    check("starting at the left edge: kept", positioner.place(&p, win).x == 0.0);
    if (fails != 0) { return 1; }
    io.printf("positioner: all checks passed\n");
    return 0;
}
