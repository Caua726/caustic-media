// ui/icon_theme_test.cst — icons by name from a freedesktop icon theme, as
// its specification looks them up, in themes made for the test
// (ui/testdata/icons, and ui/testdata/icons-user standing in for ~/.icons).
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "../image/image.cst" as image;
use "icon_theme.cst" as icon_theme;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

let is [1024]u8 as out with mut;

let is *u8 as BASES with imut = "ui/testdata/icons-user:ui/testdata/icons";

// Icon name at size and scale, in theme: whether it is the file want ("" for
// none).
fn found(theme as *u8, name as *u8, size as i64, scale as i64, want as *u8) as i32 {
    let is i64 as n = icon_theme.find(BASES, theme, name, size, scale, cast(*u8, &out), 1024);
    if (want[0] == 0) { return cast(i32, n == 0); }
    if (n != _len(want) || mem.memcmp(cast(*u8, &out), want, n) != 0) {
        io.printf("  found %d bytes: %s\n", n, cast(*u8, &out));
        return 0;
    }
    return 1;
}

fn main() as i32 {
    // --- The size asked for ---
    check("its size exactly", found("Test", "notes", 32, 1, "ui/testdata/icons/Test/32x32/apps/notes.png") == 1);
    check("the first base that has it: the user's", found("Test", "notes", 16, 1, "ui/testdata/icons-user/Test/16x16/apps/notes.png") == 1);
    check("at twice the scale: the scaled directory", found("Test", "notes", 32, 2, "ui/testdata/icons/Test/32x32@2/apps/notes.png") == 1);
    check("within a threshold", found("Test", "notes", 45, 1, "ui/testdata/icons/Test/48x48/apps/notes.png") == 1 &&
          found("Test", "notes", 52, 1, "ui/testdata/icons/Test/48x48/apps/notes.png") == 1);
    check("in a scalable directory: any size within it", found("Test", "only", 300, 1, "ui/testdata/icons/Test/scalable/apps/only.png") == 1 &&
          found("Test", "only", 8, 1, "ui/testdata/icons/Test/scalable/apps/only.png") == 1);

    // --- None of its size: the nearest ---
    check("none of its size: the nearest, the first of two as near", found("Test", "notes", 40, 1, "ui/testdata/icons/Test/32x32/apps/notes.png") == 1);
    check("smaller than any", found("Test", "notes", 4, 1, "ui/testdata/icons-user/Test/16x16/apps/notes.png") == 1);
    // The nearest in physical pixels: the scaled directory's 64 nearer 200
    // than the largest's 48 plus its threshold.
    check("larger than any: nearest in pixels", found("Test", "notes", 200, 1, "ui/testdata/icons/Test/32x32@2/apps/notes.png") == 1);
    check("past a scalable directory's range: still the nearest", found("Test", "only", 600, 1, "ui/testdata/icons/Test/scalable/apps/only.png") == 1);

    // --- Elsewhere ---
    check("in the theme it inherits", found("Test", "folder", 24, 1, "ui/testdata/icons/Parent/24x24/places/folder.png") == 1);
    check("in hicolor, after them", found("Test", "rare", 64, 1, "ui/testdata/icons/hicolor/64x64/apps/rare.png") == 1);
    check("in a base directory itself, last", found("Test", "plain", 16, 1, "ui/testdata/icons/plain.png") == 1);
    check("nowhere: none", found("Test", "missing", 16, 1, "") == 1);
    check("drawn only as SVG: none here", found("Test", "notes", 48, 1, "ui/testdata/icons/Test/48x48/apps/notes.png") == 1);
    check("in a directory the theme does not list: not", found("Test", "hidden", 40, 1, "") == 1);
    check("no such theme: hicolor's", found("Nope", "rare", 64, 1, "ui/testdata/icons/hicolor/64x64/apps/rare.png") == 1);
    check("asked of the parent, inheriting back: no endless round", found("Parent", "notes", 32, 1,
          "ui/testdata/icons/Test/32x32/apps/notes.png") == 1);
    check("no room for the path: none", icon_theme.find(BASES, "Test", "notes", 32, 1, cast(*u8, &out), 20) == 0);
    check("no name: none", found("Test", "", 16, 1, "") == 1);

    // --- Taken by the directory that takes the size, listed before Fixed
    // ones of the sizes asked: each shows what was read of it ---
    check("Fixed: its size", found("Range", "fixed", 20, 1, "ui/testdata/icons/Range/fixed/apps/fixed.png") == 1);
    check("Fixed: no other", found("Range", "fixed", 21, 1, "ui/testdata/icons/Range/f21/apps/fixed.png") == 1);
    check("Threshold: its top", found("Range", "thresh", 29, 1, "ui/testdata/icons/Range/thresh/apps/thresh.png") == 1);
    check("Threshold: its bottom", found("Range", "thresh", 11, 1, "ui/testdata/icons/Range/thresh/apps/thresh.png") == 1);
    check("Threshold: past its top", found("Range", "thresh", 30, 1, "ui/testdata/icons/Range/f30/apps/thresh.png") == 1);
    check("Threshold: below its bottom", found("Range", "thresh", 10, 1, "ui/testdata/icons/Range/f10/apps/thresh.png") == 1);
    check("Scalable: its least", found("Range", "scal", 10, 1, "ui/testdata/icons/Range/scal/apps/scal.png") == 1);
    check("Scalable: its most", found("Range", "scal", 100, 1, "ui/testdata/icons/Range/scal/apps/scal.png") == 1);
    check("Scalable: below its least", found("Range", "scal", 9, 1, "ui/testdata/icons/Range/f9/apps/scal.png") == 1);
    check("Scalable: past its most", found("Range", "scal", 101, 1, "ui/testdata/icons/Range/f101/apps/scal.png") == 1);
    check("no Type: a threshold of 2, up", found("Range", "dflt", 22, 1, "ui/testdata/icons/Range/dflt/apps/dflt.png") == 1);
    check("no Type: down", found("Range", "dflt", 18, 1, "ui/testdata/icons/Range/dflt/apps/dflt.png") == 1);
    check("no Type: past it", found("Range", "dflt", 23, 1, "ui/testdata/icons/Range/f23/apps/dflt.png") == 1);
    check("no Type: below it", found("Range", "dflt", 17, 1, "ui/testdata/icons/Range/f17/apps/dflt.png") == 1);
    check("spaces, tabs, comments, a key alone and lines of nothing: read through", found("Range", "messy", 20, 1, "ui/testdata/icons/Range/messy/apps/messy.png") == 1);
    check("read through: its size alone", found("Range", "messy", 21, 1, "ui/testdata/icons/Range/f21/apps/messy.png") == 1);
    check("no Size: no directory", found("Range", "nosize", 20, 1, "ui/testdata/icons/Range/f20/apps/nosize.png") == 1);
    check("no Size: not even of size 1", found("Range", "nosize", 1, 1, "ui/testdata/icons/Range/f1/apps/nosize.png") == 1);
    check("a Scale of 0: no directory", found("Range", "noscale", 20, 1, "ui/testdata/icons/Range/f20/apps/noscale.png") == 1);
    check("a Scale of 0: never the nearest", found("Range", "noscale", 1, 3, "ui/testdata/icons/Range/f20/apps/noscale.png") == 1);
    check("a section with no closing bracket: to its line's end", found("Range", "noclose", 20, 1,
          "ui/testdata/icons/Range/noclose/apps/noclose.png") == 1);
    check("an empty Size: no directory", found("Range", "empty", 1, 1, "ui/testdata/icons/Range/f1/apps/empty.png") == 1);
    check("a Size of 0: no directory", found("Range", "zero", 1, 1, "ui/testdata/icons/Range/f1/apps/zero.png") == 1);
    check("a MinSize of 0: from 0", found("Range", "scal0", 5, 1, "ui/testdata/icons/Range/scal0/apps/scal0.png") == 1);
    check("a MaxSize of 0: to 0", found("Range", "max0", 5, 1, "ui/testdata/icons/Range/f5/apps/max0.png") == 1);
    check("a scaled directory: at its scale, before one as near in pixels", found("Range", "two", 20, 2, "ui/testdata/icons/Range/two/apps/two.png") == 1);
    check("a scaled directory: not at another scale", found("Range", "two", 20, 1, "ui/testdata/icons/Range/f20/apps/two.png") == 1);
    check("in the order its list says, not its sections'", found("Order", "o", 16, 1, "ui/testdata/icons/Order/b/apps/o.png") == 1);

    // --- None takes it: the nearest, as each kind measures it ---
    check("below a Fixed one: how far", found("Near", "n", 25, 1, "ui/testdata/icons/Near/f30/apps/n.png") == 1 &&
          found("Near", "n", 34, 1, "ui/testdata/icons/Near/f30/apps/n.png") == 1);
    check("as near as two: the first", found("Near", "n", 35, 1, "ui/testdata/icons/Near/f30/apps/n.png") == 1);
    check("below a Scalable one's least", found("Near", "n", 36, 1, "ui/testdata/icons/Near/s/apps/n.png") == 1);
    check("past a Scalable one's most", found("Near", "n", 57, 1, "ui/testdata/icons/Near/s/apps/n.png") == 1);
    check("below a threshold", found("Near", "n", 64, 1, "ui/testdata/icons/Near/t/apps/n.png") == 1);
    check("past a threshold", found("Near", "n", 80, 1, "ui/testdata/icons/Near/t/apps/n.png") == 1);
    check("in physical pixels", found("Near", "n", 32, 2, "ui/testdata/icons/Near/t/apps/n.png") == 1);
    // At another scale none takes it: within a directory's own range, none
    // nearer.
    check("within a Scalable one's range: none nearer", found("Near", "v", 23, 2, "ui/testdata/icons/Near/s/apps/v.png") == 1);
    check("within a threshold: none nearer", found("Near", "w", 34, 2, "ui/testdata/icons/Near/t/apps/w.png") == 1);
    check("at a threshold's bottom: within", found("Near", "w3", 13, 5, "ui/testdata/icons/Near/t/apps/w3.png") == 1);
    check("at a threshold's top: within", found("Near", "w4", 15, 5, "ui/testdata/icons/Near/t/apps/w4.png") == 1);
    check("as near as one before it: that one", found("Near", "w5", 34, 2, "ui/testdata/icons/Near/pre68/apps/w5.png") == 1);

    // --- What a theme inherits ---
    check("fifteen themes down: found", found("Chain0", "deep", 16, 1, "ui/testdata/icons/Chain15/d/apps/deep.png") == 1);
    check("sixteen down: past what is followed", found("Chain0", "deeper", 16, 1, "") == 1);
    check("a parent not there: the next", found("Second", "folder", 24, 1, "ui/testdata/icons/Parent/24x24/places/folder.png") == 1);
    let is [140]u8 as long_theme;
    mem.memset(cast(*u8, &long_theme), 84, 139);
    long_theme[139] = cast(u8, 0);
    check("its first index, even empty: its directories none", found("Hollow", "hollow", 16, 1, "") == 1);
    check("more directories than kept: the first", found("Many", "first", 16, 1, "ui/testdata/icons/Many/d0/apps/first.png") == 1);
    check("the last kept", found("Many", "kept", 16, 1, "ui/testdata/icons/Many/d4095/apps/kept.png") == 1);
    check("past them: unseen", found("Many", "lost", 16, 1, "") == 1);
    check("a theme's name longer than kept: hicolor's", found(cast(*u8, &long_theme), "rare", 64, 1,
          "ui/testdata/icons/hicolor/64x64/apps/rare.png") == 1);

    // --- The bases, and the room given ---
    let is i64 as got_n with mut = icon_theme.find("nowhere-x:ui/testdata/icons-user:ui/testdata/icons", "Test", "notes", 16, 1,
                                          cast(*u8, &out), 1024);
    check("a base not there, then two", got_n == 48 && mem.memcmp(cast(*u8, &out), "ui/testdata/icons-user/Test/16x16/apps/notes.png", 48) == 0);
    got_n = icon_theme.find("nowhere-x:nowhere-y:ui/testdata/icons", "Test", "notes", 32, 1, cast(*u8, &out), 1024);
    check("two bases not there, then one", got_n == 43 && mem.memcmp(cast(*u8, &out), "ui/testdata/icons/Test/32x32/apps/notes.png", 43) == 0);
    mem.memset(cast(*u8, &out), 90, 64);
    check("room for it and its zero, exactly", icon_theme.find(BASES, "Test", "notes", 32, 1, cast(*u8, &out), 44) == 43 &&
          out[43] == 0 && out[44] == 90);
    check("one byte short: none", icon_theme.find(BASES, "Test", "notes", 32, 1, cast(*u8, &out), 43) == 0);
    mem.memset(cast(*u8, &out), 90, 64);
    check("the nearest: room exactly", icon_theme.find(BASES, "Test", "notes", 40, 1, cast(*u8, &out), 44) == 43 &&
          out[44] == 90 && icon_theme.find(BASES, "Test", "notes", 40, 1, cast(*u8, &out), 43) == 0);
    mem.memset(cast(*u8, &out), 90, 64);
    check("in a base itself: room exactly", icon_theme.find(BASES, "Test", "plain", 16, 1, cast(*u8, &out), 28) == 27 &&
          out[28] == 90 && icon_theme.find(BASES, "Test", "plain", 16, 1, cast(*u8, &out), 27) == 0);
    // A path as long as the platform takes: 4095 bytes, slashes making it so.
    let is [4200]u8 as far_base;
    mem.memcpy(cast(*u8, &far_base), "ui/testdata/icons", 17);
    mem.memset(cast(*u8, cast(i64, &far_base) + 17), 47, 4052);
    far_base[4069] = cast(u8, 0);
    let is [4096]u8 as far_out;
    check("a path of 4095 bytes: found", icon_theme.find(cast(*u8, &far_base), "Test", "notes", 32, 1, cast(*u8, &far_out), 4096) == 4095);
    // In a base itself, as long.
    mem.memset(cast(*u8, cast(i64, &far_base) + 17), 47, 4068);
    far_base[4085] = cast(u8, 0);
    check("in a base itself, a path of 4095 bytes: found", icon_theme.find(cast(*u8, &far_base), "Nope", "plain", 16, 1,
          cast(*u8, &far_out), 4096) == 4095);

    // --- Loaded ---
    let is image.buffer.Image as im = icon_theme.load("ui/testdata/icons/Test/32x32@2/apps/notes.png");
    check("loaded: its pixels", im.width == 2 && im.height == 2 && cast(i64, im.pixels[0]) == 0 && cast(i64, im.pixels[2]) == 255 &&
          cast(i64, im.pixels[3]) == 255);
    let is image.buffer.Image as none = icon_theme.load("ui/testdata/icons/Test/scalable/apps/notes.svg");
    check("not a PNG: nothing", none.width == 0);

    // --- Where the desktop keeps them ---
    let is [4096]u8 as bases;
    let is i64 as bn with mut = icon_theme.default_bases("/home/ana", 9, "/opt/share:/usr/share", 21, cast(*u8, &bases), 4096);
    check("the user's, the data directories', pixmaps", bn > 0 && mem.memcmp(cast(*u8, &bases),
          "/home/ana/.icons:/home/ana/.local/share/icons:/opt/share/icons:/usr/share/icons:/usr/share/pixmaps", bn) == 0 &&
          bn == _len("/home/ana/.icons:/home/ana/.local/share/icons:/opt/share/icons:/usr/share/icons:/usr/share/pixmaps"));
    bn = icon_theme.default_bases("/home/ana", 9, "", 0, cast(*u8, &bases), 4096);
    check("no data directories said: the usual ones", mem.memcmp(cast(*u8, &bases),
          "/home/ana/.icons:/home/ana/.local/share/icons:/usr/local/share/icons:/usr/share/icons:/usr/share/pixmaps", bn) == 0);
    bn = icon_theme.default_bases("/home/ana", 9, "/a::/b", 6, cast(*u8, &bases), 4096);
    check("an empty one among them: passed over", bn == _len("/home/ana/.icons:/home/ana/.local/share/icons:/a/icons:/b/icons:/usr/share/pixmaps") &&
          mem.memcmp(cast(*u8, &bases), "/home/ana/.icons:/home/ana/.local/share/icons:/a/icons:/b/icons:/usr/share/pixmaps", bn) == 0);
    bn = icon_theme.default_bases("/h", 2, "/ab:/c", 6, cast(*u8, &bases), 4096);
    check("each of them, whatever its length", bn == _len("/h/.icons:/h/.local/share/icons:/ab/icons:/c/icons:/usr/share/pixmaps") &&
          mem.memcmp(cast(*u8, &bases), "/h/.icons:/h/.local/share/icons:/ab/icons:/c/icons:/usr/share/pixmaps", bn) == 0);
    // A long home, the room exactly or a byte short: never past it.
    let is [128]u8 as home;
    mem.memcpy(cast(*u8, &home), "/home/", 6);
    mem.memset(cast(*u8, cast(i64, &home) + 6), 104, 94);
    let is i64 as whole = 2 * 100 + 28 + 23 + 17 + 18;
    mem.memset(cast(*u8, &bases), 90, 400);
    check("a long home: room exactly", icon_theme.default_bases(cast(*u8, &home), 100, "", 0, cast(*u8, &bases), whole + 1) == whole &&
          bases[whole] == 0 && bases[whole + 1] == 90);
    let is i32 as short_ok with mut = 1;
    let is i64 as room with mut = 0;
    while (room <= whole) {
        mem.memset(cast(*u8, &bases), 90, 400);
        if (icon_theme.default_bases(cast(*u8, &home), 100, "", 0, cast(*u8, &bases), room) != 0 || bases[room] != 90) { short_ok = 0; }
        room = room + 1;
    }
    check("any less: none, nothing written past it", short_ok == 1);

    if (fails == 0) {
        io.printf("ui icon theme: all checks passed\n");
        return 0;
    }
    io.printf("ui icon theme: %d failures\n", fails);
    return 1;
}
