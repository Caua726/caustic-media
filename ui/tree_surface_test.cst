// ui/tree_surface_test.cst — widgets shown in platform windows of their
// own, as the tree keeps them: with no host lent every widget stays in the
// window; with one, a layered child of the root is opened, moved and closed
// through it, laid out exactly where it says the platform put it — past the
// window's edges, larger than it — and its descendants are said to be drawn
// in it, damage included. A stand-in host here places each one as a
// positioner would on a screen far larger than the window.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "../window/positioner.cst" as positioner;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn same(a as math.rect.Rect, b as math.rect.Rect) as i32 {
    return cast(i32, near(a.x, b.x) == 1 && near(a.y, b.y) == 1 && near(a.w, b.w) == 1 && near(a.h, b.h) == 1);
}

struct Leaf {
    pref_w   as f64;
    pref_h   as f64;
    arranged as i64;
}

fn leaf_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Leaf as d = cast(*Leaf, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = d.pref_w;
    out.pref_h = d.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn leaf_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Leaf as d = cast(*Leaf, data);
    d.arranged = d.arranged + 1;
    let is i64 as ch with mut = tree.first_child(t, w);
    while (ch != 0) {
        let is math.rect.Rect as area = math.rect.rect(0.0, 0.0, r.w, r.h);
        layout.place(t, ch, &area);
        ch = tree.next_sibling(t, ch);
    }
}

let is tree.Kind as leaf_kind with mut;

fn leaf(t as *tree.Tree, parent as i64, pw as f64, ph as f64) as i64 {
    let is i64 as w = tree.create(t, &leaf_kind, parent);
    let is *Leaf as d = cast(*Leaf, tree.data(t, w));
    d.pref_w = pw;
    d.pref_h = ph;
    return w;
}

// --- The stand-in host ---

let is i64 as opens with mut = 0;
let is i64 as moves with mut = 0;
let is i64 as closes with mut = 0;
let is i64 as last_op_surface with mut = 0 - 1;
let is i32 as refuse with mut = 0;

// A screen of 4000 by 4000 with the window at 1000, 1000 on it: a surface
// placed in it may reach far past the window's 200 by 100.
fn host(user as *u8, t as *tree.Tree, op as i32, s as i64) as i32 {
    last_op_surface = s;
    if (op == tree.SURFACE_CLOSE) { closes = closes + 1; return 1; }
    if (op == tree.SURFACE_MOVE) { moves = moves + 1; }
    if (op == tree.SURFACE_OPEN) {
        if (refuse == 1) { return 0; }
        opens = opens + 1;
    }
    let is positioner.Positioner as p with mut = tree.surface_place(t, s);
    let is math.rect.Rect as at = positioner.place(&p, math.rect.rect(0.0 - 1000.0, 0.0 - 1000.0, 4000.0, 4000.0));
    tree.surface_set_rect(t, s, at);
    return 1;
}

fn place_below(anchor as math.rect.Rect, w as f64, h as f64) as positioner.Positioner {
    let is positioner.Positioner as p with mut = positioner.make(w, h, anchor);
    p.anchor = positioner.BOTTOM_LEFT;
    p.gravity = positioner.BOTTOM_RIGHT;
    return p;
}

fn main() as i32 {
    leaf_kind = widget.kind("leaf", sizeof(Leaf));
    leaf_kind.measure = fn_ptr(leaf_measure);
    leaf_kind.arrange = fn_ptr(leaf_arrange);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is i64 as content = leaf(&t, root, 200.0, 100.0);
    let is i64 as button = leaf(&t, content, 40.0, 20.0);
    let is i64 as pop = leaf(&t, root, 150.0, 300.0);
    tree.set_layer(&t, pop, 900);
    let is i64 as item = leaf(&t, pop, 150.0, 30.0);
    layout.run(&t, 200.0, 100.0);

    // --- No host: every widget stays in the window ---
    let is positioner.Positioner as below = place_below(math.rect.rect(10.0, 10.0, 40.0, 20.0), 150.0, 300.0);
    check("no host lent", tree.has_surfaces(&t) == 0);
    check("no host: nothing opened", tree.surface_open(&t, pop, tree.SURFACE_MENU, 1, button, &below) < 0);
    check("drawn in the window", tree.surface_of(&t, item) < 0 && tree.surface_index(&t, pop) < 0);

    // --- A host: opened through it, where it says ---
    tree.set_surfaces(&t, fn_ptr(host), cast(*u8, 0));
    check("a host lent", tree.has_surfaces(&t) == 1);
    check("not on a layer: refused", tree.surface_open(&t, content, tree.SURFACE_MENU, 1, 0, &below) < 0);
    check("not a child of the root: refused", tree.surface_open(&t, item, tree.SURFACE_MENU, 1, 0, &below) < 0);
    check("the host not asked for those", opens == 0);
    let is i64 as s = tree.surface_open(&t, pop, tree.SURFACE_MENU, 1, button, &below);
    check("opened", s >= 0 && opens == 1 && last_op_surface == s);
    check("its widget, kind and grab", tree.surface_widget(&t, s) == pop && tree.surface_kind(&t, s) == tree.SURFACE_MENU &&
          tree.surface_grab(&t, s) == 1);
    check("opened against the window", tree.surface_owner(&t, s) < 0);
    check("the widget's surface", tree.surface_index(&t, pop) == s && tree.surface_of(&t, pop) == s);
    check("what it holds is drawn in it", tree.surface_of(&t, item) == s);
    check("the window's widgets are not", tree.surface_of(&t, button) < 0 && tree.surface_of(&t, content) < 0 &&
          tree.surface_of(&t, root) < 0);
    let is math.rect.Rect as at = tree.surface_rect(&t, s);
    check("where the host put it", same(at, math.rect.rect(10.0, 30.0, 150.0, 300.0)) == 1);
    layout.run(&t, 200.0, 100.0);
    check("laid out there, taller than the window", same(layout.rect(&t, pop), at) == 1);
    check("what it holds inside it", same(layout.rect(&t, item), math.rect.rect(0.0, 0.0, 150.0, 300.0)) == 1);
    check("the window's content as it was", same(layout.rect(&t, content), math.rect.rect(0.0, 0.0, 200.0, 100.0)) == 1);

    // Past the window's edges: before its start, above its top.
    let is positioner.Positioner as above = place_below(math.rect.rect(0.0 - 50.0, 0.0 - 80.0, 10.0, 10.0), 150.0, 300.0);
    check("opened again: placed again", tree.surface_open(&t, pop, tree.SURFACE_MENU, 1, button, &above) == s && moves == 1 &&
          opens == 1);
    layout.run(&t, 200.0, 100.0);
    check("laid out before the window's start", same(layout.rect(&t, pop), math.rect.rect(0.0 - 50.0, 0.0 - 70.0, 150.0, 300.0)) == 1);
    // The platform cut it: the size it was given.
    tree.surface_set_rect(&t, s, math.rect.rect(5.0, 6.0, 150.0, 120.0));
    layout.run(&t, 200.0, 100.0);
    check("cut: laid out at the size given", same(layout.rect(&t, pop), math.rect.rect(5.0, 6.0, 150.0, 120.0)) == 1);
    check("what it holds at that size", same(layout.rect(&t, item), math.rect.rect(0.0, 0.0, 150.0, 120.0)) == 1);

    // --- A surface opened against another: a submenu ---
    let is i64 as sub = leaf(&t, root, 100.0, 80.0);
    tree.set_layer(&t, sub, 901);
    let is positioner.Positioner as beside = place_below(math.rect.rect(150.0, 6.0, 10.0, 30.0), 100.0, 80.0);
    let is i64 as s2 = tree.surface_open(&t, sub, tree.SURFACE_MENU, 1, item, &beside);
    check("a second surface", s2 >= 0 && s2 != s && opens == 2);
    check("opened against the first", tree.surface_owner(&t, s2) == s);

    // --- A surface inside another: a submenu, a child of its menu on a
    // layer above it, in a window of its own ---
    let is i64 as nested = leaf(&t, pop, 80.0, 60.0);
    tree.set_layer(&t, nested, 905);
    let is i64 as nested_item = leaf(&t, nested, 80.0, 20.0);
    let is positioner.Positioner as by_item = place_below(math.rect.rect(150.0, 40.0, 10.0, 20.0), 80.0, 60.0);
    let is i64 as s3n = tree.surface_open(&t, nested, tree.SURFACE_MENU, 1, item, &by_item);
    check("a surface inside another's widget", s3n >= 0 && s3n != s && tree.surface_owner(&t, s3n) == s);
    check("what it holds drawn in it, not in its parent's", tree.surface_of(&t, nested_item) == s3n && tree.surface_of(&t, nested) == s3n);
    check("its parent's still in its parent's", tree.surface_of(&t, item) == s);
    layout.run(&t, 200.0, 100.0);
    let is math.rect.Rect as nr = tree.surface_rect(&t, s3n);
    check("laid out where the host put it, in the window's coordinates", same(layout.window_rect(&t, nested), nr) == 1);
    tree.surface_close(&t, nested);
    tree.destroy(&t, nested);

    // --- Damage goes where the widget is drawn ---
    tree.damage_clear(&t);
    let is math.rect.Rect as d = math.rect.rect(20.0, 20.0, 10.0, 10.0);
    tree.damage_add_for(&t, item, &d);
    check("a surface's widget damages the surface", tree.surface_damage_count(&t, s) == 1 && tree.damage_count(&t) == 0 &&
          tree.surface_damage_count(&t, s2) == 0 && same(tree.surface_damage_at(&t, s, 0), d) == 1);
    tree.damage_add_for(&t, button, &d);
    check("a window's widget damages the window", tree.damage_count(&t) == 1 && tree.surface_damage_count(&t, s) == 1);
    tree.damage_add_to(&t, 0 - 1, &d);
    check("-1 is the window", tree.damage_count(&t) == 1);
    check("a repaint wanted", tree.paint_wanted(&t) == 1);
    tree.surface_damage_clip(&t, s, math.rect.rect(0.0, 0.0, 25.0, 25.0));
    check("clipped to a rectangle", same(tree.surface_damage_at(&t, s, 0), math.rect.rect(20.0, 20.0, 5.0, 5.0)) == 1);
    tree.damage_clear(&t);
    check("cleared, every surface's too", tree.surface_damage_count(&t, s) == 0 && tree.damage_count(&t) == 0 &&
          tree.paint_wanted(&t) == 0);

    // --- The host's own: its window, and whether it is seen through ---
    tree.surface_set_native(&t, s, 77);
    check("the host's own kept", tree.surface_native(&t, s) == 77);
    tree.surface_set_see_through(&t, s, 1);
    check("seen through, as the host says", tree.surface_see_through(&t, s) == 1 && tree.surface_see_through(&t, s2) == 0);

    // --- Closed: its window put away, drawn in the window again ---
    tree.surface_close(&t, sub);
    check("closed: the host told", closes == 2 && last_op_surface == s2 && tree.surface_index(&t, sub) < 0);
    check("a closed one's entry is nothing", tree.surface_widget(&t, s2) == 0 && tree.surface_owner(&t, s2) < 0);
    tree.surface_close(&t, sub);
    check("closed twice: told once", closes == 2);
    layout.run(&t, 200.0, 100.0);
    check("back in the window", same(layout.rect(&t, sub), math.rect.rect(0.0, 0.0, 200.0, 100.0)) == 1);

    // Moved anywhere but under the root: its window goes.
    let is i64 as s3 = tree.surface_open(&t, sub, tree.SURFACE_LIST, 0, button, &beside);
    check("open again", s3 >= 0 && tree.surface_kind(&t, s3) == tree.SURFACE_LIST && tree.surface_grab(&t, s3) == 0);
    tree.reparent(&t, sub, content);
    check("moved under another: closed", closes == 3 && tree.surface_index(&t, sub) < 0);
    tree.reparent(&t, sub, root);
    tree.set_layer(&t, sub, 901);

    // Destroyed: its window goes, and its entry is free.
    tree.destroy(&t, pop);
    check("destroyed: closed", closes == 4 && tree.surface_index(&t, pop) < 0 && tree.surface_widget(&t, s) == 0);

    // --- The host could not open it: it stays in the window ---
    refuse = 1;
    check("refused: in the window", tree.surface_open(&t, sub, tree.SURFACE_MENU, 1, 0, &beside) < 0 &&
          tree.surface_index(&t, sub) < 0);
    refuse = 0;
    let is i64 as kept = tree.placed_entry(&t, sub);
    check("its entry kept, inside the window", kept >= 0 && tree.placed_widget(&t, kept) == sub &&
          tree.placed_native(&t, kept) == 0 && tree.surface_widget(&t, kept) == 0);
    tree.placed_set_rect(&t, kept, math.rect.rect(1.0, 2.0, 3.0, 4.0));
    check("where it was put inside the window, kept", same(tree.placed_rect(&t, kept), math.rect.rect(1.0, 2.0, 3.0, 4.0)) == 1);
    tree.surface_close(&t, sub);
    check("closed: its entry free", tree.placed_entry(&t, sub) < 0 && tree.placed_widget(&t, kept) == 0);

    // --- What it is anchored to moves: its anchor where that is now ---
    let is i64 as anchored = leaf(&t, root, 30.0, 30.0);
    tree.set_layer(&t, anchored, 902);
    let is positioner.Positioner as on_button = place_below(math.rect.rect(12.0, 14.0, 8.0, 6.0), 30.0, 30.0);
    layout.run(&t, 200.0, 100.0);
    let is math.rect.Rect as br = layout.window_rect(&t, button);
    on_button.anchor_rect = math.rect.rect(br.x + 2.0, br.y + 4.0, 8.0, 6.0);
    let is i64 as sa = tree.surface_open(&t, anchored, tree.SURFACE_LIST, 0, button, &on_button);
    check("anchored to the button", sa >= 0 && tree.placed_from(&t, sa) == button && tree.placed_kind(&t, sa) == tree.SURFACE_LIST &&
          tree.placed_grab(&t, sa) == 0);
    check("its anchor where it was asked", same(tree.placed_anchor(&t, sa), on_button.anchor_rect) == 1);
    layout.set_margin(&t, button, 50.0, 30.0, 0.0, 0.0);
    layout.run(&t, 200.0, 100.0);
    let is math.rect.Rect as moved_to = layout.window_rect(&t, button);
    check("the button moved", near(moved_to.x, br.x) == 0);
    check("its anchor moved with it", same(tree.placed_anchor(&t, sa), math.rect.rect(moved_to.x + 2.0, moved_to.y + 4.0, 8.0, 6.0)) == 1);
    check("as last placed: where it was", same(tree.placed_place(&t, sa).anchor_rect, on_button.anchor_rect) == 1);
    tree.destroy(&t, button);
    check("what it is anchored to gone: where it was last", same(tree.placed_anchor(&t, sa), on_button.anchor_rect) == 1);
    tree.surface_close(&t, anchored);

    // --- As many as MAX_SURFACES at once ---
    let is [9]i64 as many;
    let is i64 as k with mut = 0;
    let is i32 as all_opened with mut = 1;
    while (k < 9) {
        many[k] = leaf(&t, root, 20.0, 20.0);
        tree.set_layer(&t, many[k], 950);
        let is i64 as got = tree.surface_open(&t, many[k], tree.SURFACE_TOOLTIP, 0, 0, &beside);
        if (k < tree.MAX_SURFACES && got < 0) { all_opened = 0; }
        if (k == tree.MAX_SURFACES) { check("one past them: in the window", got < 0); }
        k = k + 1;
    }
    check("every one up to them opened", all_opened == 1);

    tree.close(&t);
    if (fails == 0) {
        io.printf("ui tree surfaces: all checks passed\n");
        return 0;
    }
    io.printf("ui tree surfaces: %d failures\n", fails);
    return 1;
}
