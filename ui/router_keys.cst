// ui/router_keys.cst — keys and the text they type: to the focused widget
// and up, the window's shortcuts, the mnemonics.
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "layout.cst" as layout;
use "event.cst" as event;
use "../input/keys.cst" as keys;
use "router_state.cst" as rst;
use "router_hit.cst" as rhit;
use "router_focus.cst" as rfocus;
use "router_drag.cst" as rdrag;

// --- Keys and text ---

fn _plain(mods as i32) as i32 { return (mods | keys.MOD_LOCK) - keys.MOD_LOCK; }

// What is held once key k went down or up, mods as its event says them: X
// says the state before the event, so a modifier key's own counts only
// after it — held from its press, no longer from its release.
fn _held(k as i32, mods as i32, pressed as i32) as i32 {
    let is i32 as bit with mut = 0;
    if (k == keys.SHIFT_L || k == keys.SHIFT_R) { bit = keys.MOD_SHIFT; }
    if (k == keys.CONTROL_L || k == keys.CONTROL_R) { bit = keys.MOD_CONTROL; }
    if (k == keys.ALT_L || k == keys.ALT_R) { bit = keys.MOD_ALT; }
    if (k == keys.SUPER_L || k == keys.SUPER_R) { bit = keys.MOD_SUPER; }
    if (pressed == 1) { return mods | bit; }
    return mods - (mods & bit);
}

fn _key(t as *tree.Tree, r as *rst.Router, k as i32, mods as i32, pressed as i32,
        repeat as i32, time as i64) as i32 {
    if (pressed == 1) { r.inputs = r.inputs + 1; }
    let is i32 as held = _held(k, mods, pressed);
    // Alt going down or up shows or hides every mnemonic's underline.
    if (((r.mods ^ held) & keys.MOD_ALT) != 0) { tree.invalidate_paint_subtree(t, tree.root(t)); }
    r.mods = held;
    // Escape calls off a drag begun here; the release after it does nothing.
    if (pressed == 1 && k == keys.ESCAPE && r.drag_on == 1 && r.drag_own == 1) {
        rdrag._drag_target(t, r, 0, 0, 0, time);
        rdrag._end(t, r, 0, time);
        r.capture = 0;
        r.dragging = 0;
        r.swallow = 1;
        return 1;
    }
    let is i64 as f = rfocus.focused(t, r);
    let is event.Event as e = event.make(event.KEY_DOWN, time);
    e.key = k;
    e.mods = mods;
    e.repeat = repeat;
    e.x = r.pointer_x;
    e.y = r.pointer_y;
    if (pressed == 0) {
        e.kind = event.KEY_UP;
        if (f != 0 && rhit._dispatch(t, &e, f) != 0) { return 1; }
        return 0;
    }

    if (f != 0) {
        // Bubbling: what holds the focused widget may keep a key for it —
        // a spin box Enter for the entry inside it.
        let is event.Event as o = e;
        o.kind = event.SHORTCUT_OVERRIDE;
        if (rhit._dispatch(t, &o, f) != 0) {
            rhit._dispatch(t, &e, f);
            return 1;
        }
    }

    let is i32 as plain = _plain(mods);
    if (_run_shortcut(t, r, k, mods) == 1) { return 1; }
    if (plain == keys.MOD_ALT && _run_mnemonic(t, r, k, time) == 1) { return 1; }
    if ((k == keys.MENU && plain == 0) || (k == keys.F10 && plain == keys.MOD_SHIFT)) {
        if (f != 0) {
            // Where a pointer would have been: the middle of the widget.
            let is math.rect.Rect as fr = layout.window_rect(t, f);
            let is event.Event as c = event.make(event.CONTEXT_MENU, time);
            c.x = fr.x + fr.w * 0.5;
            c.y = fr.y + fr.h * 0.5;
            c.mods = mods;
            if (rhit._dispatch(t, &c, f) != 0) { return 1; }
        }
    }

    if (f != 0 && rhit._dispatch(t, &e, f) != 0) { return 1; }

    if (k == keys.TAB && (plain == 0 || plain == keys.MOD_SHIFT)) {
        let is i32 as dir with mut = 1;
        if (plain == keys.MOD_SHIFT) { dir = 0 - 1; }
        rfocus.focus_next(t, r, dir);
        return 1;
    }
    return 0;
}

// --- Shortcuts ---
//
// Letters match regardless of case and Caps Lock; the other modifiers must
// match exactly, so Ctrl+Shift+S is not Ctrl+S. A shortcut a widget owns — a
// default button's Enter — runs only while the widget is shown, enabled and
// inside the modal scope, and is passed over otherwise for the next that
// matches; the window's own wait while a scope is set, as they would were the
// scope a window of its own.

fn _norm_key(k as i32) as i32 {
    if (k >= 65 && k <= 90) { return k + 32; }
    return k;
}

// Whether shortcut i may run now.
fn _live(t as *tree.Tree, r as *rst.Router, i as i64) as i32 {
    let is i64 as w = r.shortcuts[i].owner;
    if (w == 0) { return cast(i32, r.scope == 0 || tree.is_valid(t, r.scope) == 0); }
    return cast(i32, tree.is_valid(t, w) == 1 && tree.is_visible(t, w) == 1 && tree.is_enabled(t, w) == 1 &&
                rfocus._in_scope(t, r, w) == 1);
}

fn _run_shortcut(t as *tree.Tree, r as *rst.Router, k as i32, mods as i32) as i32 {
    let is i32 as nk = _norm_key(k);
    let is i32 as pm = _plain(mods);
    let is i64 as i with mut = 0;
    while (i < rst.MAX_SHORTCUTS) {
        if (r.shortcuts[i].key != 0 && r.shortcuts[i].key == nk && r.shortcuts[i].mods == pm && _live(t, r, i) == 1) {
            call(r.shortcuts[i].cb, r.shortcuts[i].user);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn _run_mnemonic(t as *tree.Tree, r as *rst.Router, k as i32, time as i64) as i32 {
    let is i32 as nk = _norm_key(k);
    let is i64 as i with mut = 0;
    while (i < rst.MAX_MNEMONICS) {
        let is i64 as w = r.mnemonic_w[i];
        if (w != 0 && r.mnemonic_key[i] == nk && tree.is_valid(t, w) == 1
            && tree.is_visible(t, w) == 1 && tree.is_enabled(t, w) == 1 && rfocus._in_scope(t, r, w) == 1) {
            // It takes the focus when it can, as Tab would give it: an entry
            // a label's mnemonic names is then typed in.
            if (rfocus._can_focus(t, r, w) == 1) { rfocus.focus(t, r, w, 1); }
            let is event.Event as e = event.make(event.ACTIVATE, time);
            e.key = k;
            e.mods = r.mods;
            rhit._direct(t, w, &e);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
