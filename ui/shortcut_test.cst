// ui/shortcut_test.cst — window shortcuts, the override that lets a widget keep
// a key, and mnemonics.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "../input/keys.cst" as keys;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "box.cst" as box;
use "event.cst" as event;
use "router.cst" as router;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL: %s: got %d, want %d\n", name, cast(i32, got), cast(i32, want));
        fails = fails + 1;
    }
}

// --- A widget that counts what it receives ---
struct Probe {
    key_downs   as i64;
    activations as i64;
    claim_key   as i32;   // answers SHORTCUT_OVERRIDE for this key
    claim_mods  as i32;
}

fn probe_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = 100.0;
    out.pref_h = 20.0;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn probe_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Probe as d = cast(*Probe, data);
    if (e.kind == event.SHORTCUT_OVERRIDE) {
        if (d.claim_key != 0 && e.key == d.claim_key && e.mods == d.claim_mods) { return 1; }
        return 0;
    }
    if (e.kind == event.KEY_DOWN) { d.key_downs = d.key_downs + 1; return 1; }
    if (e.kind == event.ACTIVATE) { d.activations = d.activations + 1; return 1; }
    return 0;
}

let is tree.Kind as probe_kind with mut;

fn probe(t as *tree.Tree, parent as i64) as i64 {
    let is i64 as w = tree.create(t, &probe_kind, parent);
    tree.set_focusable(t, w, 1);
    return w;
}

fn pd(t as *tree.Tree, w as i64) as *Probe { return cast(*Probe, tree.data(t, w)); }

// --- Shortcut callbacks count into the integer their user pointer names ---
fn bump(user as *u8) as void {
    let is *i64 as n = cast(*i64, user);
    *n = *n + 1;
}

fn press(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as i32 {
    let is i32 as h = router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
    return h;
}

fn main() as i32 {
    probe_kind = widget.kind("probe", sizeof(Probe));
    probe_kind.measure = fn_ptr(probe_measure);
    probe_kind.event = fn_ptr(probe_event);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);
    let is i64 as col = box.create(&t, root, box.COLUMN);
    let is i64 as entry = probe(&t, col);
    let is i64 as button = probe(&t, col);
    let is i64 as dialog = probe(&t, col);
    let is i64 as ok = probe(&t, dialog);
    layout.run(&t, 100.0, 100.0);

    let is router.Router as r = router.init(router.settings_default());
    router.focus(&t, &r, entry, 1);

    // --- A shortcut runs its callback, and the focused widget never sees the key ---
    let is i64 as saves with mut = 0;
    let is i64 as id = router.add_shortcut(&r, keys.S, keys.MOD_CONTROL, fn_ptr(bump), cast(*u8, &saves));
    check("shortcut added", id != 0);
    check("handled", press(&t, &r, keys.S, keys.MOD_CONTROL, 100) == 1);
    eq("callback ran", saves, 1);
    eq("focused widget did not get it", pd(&t, entry).key_downs, 0);

    // Modifiers must match exactly; case and Caps Lock do not matter.
    press(&t, &r, keys.S, keys.MOD_CONTROL | keys.MOD_SHIFT, 110);
    eq("ctrl+shift+s is not ctrl+s", saves, 1);
    press(&t, &r, 83, keys.MOD_CONTROL, 120);
    eq("uppercase S matches", saves, 2);
    press(&t, &r, keys.S, keys.MOD_CONTROL | keys.MOD_LOCK, 130);
    eq("caps lock ignored", saves, 3);
    eq("ctrl+shift+s went to the widget", pd(&t, entry).key_downs, 1);

    // --- A widget can keep a key the window has a shortcut for ---
    let is i64 as selects with mut = 0;
    router.add_shortcut(&r, keys.A, keys.MOD_CONTROL, fn_ptr(bump), cast(*u8, &selects));
    pd(&t, entry).claim_key = keys.A;
    pd(&t, entry).claim_mods = keys.MOD_CONTROL;
    press(&t, &r, keys.A, keys.MOD_CONTROL, 200);
    eq("claimed: the window's shortcut did not run", selects, 0);
    eq("claimed: the widget got the key", pd(&t, entry).key_downs, 2);
    // The same key with another widget focused goes to the shortcut.
    router.focus(&t, &r, button, 1);
    press(&t, &r, keys.A, keys.MOD_CONTROL, 210);
    eq("not claimed: shortcut ran", selects, 1);

    // --- What holds the focused widget can keep a key for it ---
    let is i64 as cancels with mut = 0;
    router.add_shortcut(&r, keys.ESCAPE, 0, fn_ptr(bump), cast(*u8, &cancels));
    pd(&t, dialog).claim_key = keys.ESCAPE;
    router.focus(&t, &r, ok, 1);
    let is i64 as before = pd(&t, ok).key_downs;
    check("claimed above it: handled", press(&t, &r, keys.ESCAPE, 0, 250) == 1);
    eq("claimed above it: the window's shortcut did not run", cancels, 0);
    eq("the focused widget got the key first", pd(&t, ok).key_downs, before + 1);
    router.focus(&t, &r, button, 1);
    press(&t, &r, keys.ESCAPE, 0, 260);
    eq("focus outside it: the window's", cancels, 1);
    pd(&t, dialog).claim_key = 0;

    // --- Removing a shortcut ---
    router.remove_shortcut(&r, id);
    press(&t, &r, keys.S, keys.MOD_CONTROL, 300);
    eq("removed shortcut no longer runs", saves, 3);

    // --- Mnemonics: Alt and the letter activate the widget ---
    check("mnemonic added", router.add_mnemonic(&t, &r, button, keys.B) == 1);
    check("alt+b handled", press(&t, &r, keys.B, keys.MOD_ALT, 400) == 1);
    eq("activated", pd(&t, button).activations, 1);
    press(&t, &r, 66, keys.MOD_ALT, 410);
    eq("uppercase letter too", pd(&t, button).activations, 2);
    press(&t, &r, keys.B, 0, 420);
    eq("b alone is just a key", pd(&t, button).activations, 2);

    // What a mnemonic chooses takes the focus when it can, as by Tab.
    router.focus(&t, &r, entry, 0);
    press(&t, &r, keys.B, keys.MOD_ALT, 430);
    eq("focused by its mnemonic", router.focused(&t, &r), button);
    check("by keyboard: its ring shown", router.focus_visible(&r));
    eq("and activated", pd(&t, button).activations, 3);
    tree.set_focusable(&t, button, 0);
    router.focus(&t, &r, entry, 1);
    press(&t, &r, keys.B, keys.MOD_ALT, 440);
    eq("one that cannot take it: activated", pd(&t, button).activations, 4);
    eq("the focus left where it was", router.focused(&t, &r), entry);
    tree.set_focusable(&t, button, 1);

    // The underlines show while Alt is held, and the window is drawn again
    // as it goes down and up.
    router.key(&t, &r, keys.ALT_L, 0, 0, 0, 495);
    tree.clear_paint(&t, entry);
    tree.clear_paint(&t, ok);
    router.key(&t, &r, keys.ALT_L, keys.MOD_ALT, 1, 0, 500);
    check("alt held: mnemonics shown", router.mnemonics_visible(&r));
    check("alt held: drawn again", tree.needs_paint(&t, entry) == 1 && tree.needs_paint(&t, ok) == 1);
    tree.clear_paint(&t, entry);
    router.key(&t, &r, keys.SHIFT_L, keys.MOD_ALT | keys.MOD_SHIFT, 1, 0, 505);
    check("another key with alt still held: not", tree.needs_paint(&t, entry) == 0);
    router.key(&t, &r, keys.SHIFT_L, keys.MOD_ALT, 0, 0, 506);
    router.key(&t, &r, keys.ALT_L, 0, 0, 0, 510);
    check("alt released: hidden", router.mnemonics_visible(&r) == 0);
    check("alt released: drawn again", tree.needs_paint(&t, entry) == 1);

    // A hidden widget's mnemonic does nothing.
    tree.set_visible(&t, button, 0);
    press(&t, &r, keys.B, keys.MOD_ALT, 600);
    eq("hidden: not activated", pd(&t, button).activations, 4);
    tree.set_visible(&t, button, 1);

    // Inside a modal scope, only the scope's mnemonics work.
    router.add_mnemonic(&t, &r, ok, keys.O);
    router.set_scope(&t, &r, dialog);
    press(&t, &r, keys.B, keys.MOD_ALT, 700);
    eq("outside the scope: not activated", pd(&t, button).activations, 4);
    press(&t, &r, keys.O, keys.MOD_ALT, 710);
    eq("inside the scope: activated", pd(&t, ok).activations, 1);
    router.set_scope(&t, &r, 0);

    // --- A shortcut a widget owns: only while it is shown, enabled and in
    // scope; the window's wait while a scope is set ---
    let is i64 as window_enter with mut = 0;
    let is i64 as dialog_enter with mut = 0;
    check("owned shortcuts added", router.add_shortcut_for(&r, button, keys.RETURN, 0, fn_ptr(bump), cast(*u8, &window_enter)) != 0 &&
          router.add_shortcut_for(&r, ok, keys.RETURN, 0, fn_ptr(bump), cast(*u8, &dialog_enter)) != 0);
    router.focus(&t, &r, entry, 1);
    press(&t, &r, keys.RETURN, 0, 800);
    check("the first whose owner can: it alone", window_enter == 1 && dialog_enter == 0);
    router.set_scope(&t, &r, dialog);
    press(&t, &r, keys.RETURN, 0, 810);
    check("in a scope: the one inside it", window_enter == 1 && dialog_enter == 1);
    let is i64 as cancels_before = cancels;
    press(&t, &r, keys.ESCAPE, 0, 820);
    check("in a scope: the window's own waits", cancels == cancels_before);
    router.set_scope(&t, &r, 0);
    tree.set_visible(&t, button, 0);
    press(&t, &r, keys.RETURN, 0, 830);
    check("its owner hidden: passed over", window_enter == 1 && dialog_enter == 2);
    tree.set_visible(&t, button, 1);
    tree.set_enabled(&t, button, 0);
    press(&t, &r, keys.RETURN, 0, 840);
    check("its owner disabled: passed over", window_enter == 1 && dialog_enter == 3);
    tree.set_enabled(&t, button, 1);
    press(&t, &r, keys.ESCAPE, 0, 850);
    check("no scope: the window's again", cancels == cancels_before + 1);

    // Unknown platform keys are still delivered to the focused widget, but
    // cannot select a free slot or revive a removed shortcut.
    let is router.Router as unknown = router.init(router.settings_default());
    router.focus(&t, &unknown, entry, 1);
    let is i64 as keys_before = pd(&t, entry).key_downs;
    press(&t, &unknown, keys.UNKNOWN, 0, 860);
    eq("unknown key reaches focus", pd(&t, entry).key_downs, keys_before + 1);
    let is i64 as removed_calls with mut = 0;
    let is i64 as removed = router.add_shortcut(&unknown, keys.S, 0, fn_ptr(bump), cast(*u8, &removed_calls));
    router.remove_shortcut(&unknown, removed);
    press(&t, &unknown, keys.UNKNOWN, 0, 870);
    eq("unknown key does not revive removed callback", removed_calls, 0);
    eq("removed slot still delivers to focus", pd(&t, entry).key_downs, keys_before + 2);

    // --- Tables are bounded and say so ---
    let is router.Router as small = router.init(router.settings_default());
    let is i64 as n with mut = 0;
    let is i64 as last with mut = 1;
    while (last != 0 && n < 1000) {
        last = router.add_shortcut(&small, keys.F1, cast(i32, n), fn_ptr(bump), cast(*u8, &saves));
        n = n + 1;
    }
    eq("shortcut table full returns 0", last, 0);
    eq("and holds MAX_SHORTCUTS", n - 1, router.MAX_SHORTCUTS);

    tree.close(&t);
    if (fails != 0) { return 1; }
    io.printf("ui shortcuts: all checks passed\n");
    return 0;
}
