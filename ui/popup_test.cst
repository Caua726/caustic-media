// ui/popup_test.cst — a popup: what it holds, framed over the window, placed
// against a rectangle, the window's input its own until dismissed.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../math/math.cst" as math;
use "../gpu/gpu.cst" as gpu;
use "../render/draw2d.cst" as draw2d;
use "../window/keys.cst" as keys;
use "../text/sfnt/sfnt.cst" as sfnt;
use "../text/sfnt/table.cst" as table;
use "../text/layout/font.cst" as font;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "box.cst" as box;
use "damage.cst" as damage;
use "paint.cst" as paint;
use "painter.cst" as painter;
use "style.cst" as style;
use "access.cst" as access;
use "router.cst" as router;
use "signal.cst" as signal;
use "text.cst" as text;
use "widgets/label.cst" as label;
use "widgets/button.cst" as button;
use "event.cst" as event;
use "scroll.cst" as scroll;
use "model.cst" as model;
use "../window/positioner.cst" as positioner;
use "popup.cst" as popup;

let is i64 as W with imut = 400;
let is i64 as H with imut = 240;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

let is table.Face as face with mut;
let is font.List as list with mut;
let is font.Font as plain_font with mut;

fn resolve(user as *u8, family as *u8, weight as i64, italic as i32) as *font.Font { return &plain_font; }

let is style.Theme as theme with mut;
let is *text.Service as svc with mut;
let is gpu.device.Device as dv with mut;
let is i64 as target with mut = 0;
let is i64 as cmd with mut = 0;
let is [96000]i32 as px with mut;
let is *router.Router as frame_router with mut;

fn frame(t as *tree.Tree, c as *draw2d.Canvas) as void {
    layout.run(t, cast(f64, W), cast(f64, H));
    damage.collect(t);
    text.next_frame(svc);
    draw2d.begin(c, cast(f64, W), cast(f64, H), 1.0);
    let is paint.Options as o = paint.options(&theme);
    o.router = frame_router;
    let is paint.Stats as st;
    paint.frame(t, c, &o, &st);
    gpu.command.begin(&dv, cmd);
    let is gpu.command.Pass as ps = gpu.command.pass_load(target, 0);
    gpu.command.begin_pass(&dv, cmd, &ps);
    draw2d.flush(c, cmd);
    gpu.command.end_pass(&dv, cmd);
    gpu.command.end(&dv, cmd);
    gpu.command.submit(&dv, cmd);
    gpu.texture.read(&dv, target, cast(*u8, &px), W * H * 4);
    tree.damage_clear(t);
}

fn ch(x as i64, y as i64, c as i64) as i64 { return cast(i64, cast(*u8, &px)[(y * W + x) * 4 + c]); }

fn is8(x as i64, y as i64, col as math.color.Color, tol as i64) as i32 {
    let is i64 as r = cast(i64, col.r * 255.0 + 0.5);
    let is i64 as g = cast(i64, col.g * 255.0 + 0.5);
    let is i64 as b = cast(i64, col.b * 255.0 + 0.5);
    let is i64 as dr with mut = ch(x, y, 0) - r;
    let is i64 as dg with mut = ch(x, y, 1) - g;
    let is i64 as db with mut = ch(x, y, 2) - b;
    if (dr < 0) { dr = 0 - dr; }
    if (dg < 0) { dg = 0 - dg; }
    if (db < 0) { db = 0 - db; }
    return cast(i32, dr <= tol && dg <= tol && db <= tol);
}

// What a look's background is over the window's.
fn bg_of(l as style.Look) as math.color.Color { return style.over(l.bg, theme.palette.window_bg); }

// The middle of the ink of the first glyph of a label.
fn ink_x(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).x + label.text_left(t, l) + g.x + g.adv / 2.0);
}

fn ink_y(t as *tree.Tree, l as i64) as i64 {
    let is *text.Glyph as g = text.glyph(label.run(t, l), 0);
    return cast(i64, layout.window_rect(t, l).y + label.text_top(t, l) + g.y - 4.0);
}

fn mid_x(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).x + layout.window_rect(t, b).w / 2.0; }
fn mid_y(t as *tree.Tree, b as i64) as f64 { return layout.window_rect(t, b).y + layout.window_rect(t, b).h / 2.0; }


fn click(t as *tree.Tree, r as *router.Router, x as f64, y as f64, time as i64) as void {
    router.pointer_move(t, r, x, y, time);
    router.pointer_button(t, r, 1, 1, x, y, time);
    router.pointer_button(t, r, 1, 0, x, y, time + 1);
}

fn key(t as *tree.Tree, r as *router.Router, k as i32, mods as i32, time as i64) as void {
    router.key(t, r, k, mods, 1, 0, time);
    router.key(t, r, k, mods, 0, 0, time + 1);
}

fn tree_for() as tree.Tree {
    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    tree.set_theme(&t, &theme);
    tree.set_text_service(&t, cast(*u8, svc));
    return t;
}



let is i64 as closes with mut = 0;
fn on_close(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { closes = closes + 1; }

let is i64 as clicks with mut = 0;
fn on_click(t as *tree.Tree, w as i64, arg as *u8, user as *u8) as void { clicks = clicks + 1; }

fn near(a as f64, b as f64) as i32 {
    let is f64 as d = a - b;
    return cast(i32, d < 0.01 && d > 0.0 - 0.01);
}

fn opened() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as before = button.create(&t, tree.root(&t), "Before", 6);
    layout.set_align(&t, before, layout.CENTER, layout.CENTER);
    let is i64 as opener = button.create(&t, tree.root(&t), "Open", 4);
    layout.set_align(&t, opener, layout.START, layout.START);
    layout.set_margin(&t, opener, 50.0, 20.0, 0.0, 0.0);
    let is i64 as under = button.create(&t, tree.root(&t), "Under", 5);
    layout.set_align(&t, under, layout.END, layout.END);
    signal.connect(&t, under, signal.CLICKED, fn_ptr(on_click), cast(*u8, 0));
    let is i64 as p = popup.create(&t);
    let is i64 as box1 = box.create(&t, p, box.COLUMN);
    let is i64 as first = button.create(&t, box1, "First", 5);
    let is i64 as second = button.create(&t, box1, "Second", 6);
    signal.connect(&t, p, signal.CLOSED, fn_ptr(on_close), cast(*u8, 0));
    layout.run(&t, cast(f64, W), cast(f64, H));
    check("made closed, out of sight", popup.is_open(&t, p) == 0 && tree.is_visible(&t, p) == 0 && popup.content(&t, p) == box1);
    router.focus(&t, &r, opener, 1);
    let is math.rect.Rect as or = layout.window_rect(&t, opener);
    check("opened under it", popup.open_at(&t, &r, p, or, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1) == 1 &&
          popup.is_open(&t, p) == 1 && tree.is_visible(&t, p) == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as pr = layout.window_rect(&t, p);
    check("under the rectangle, flush with its start", near(pr.y, or.y + or.h) == 1 && near(pr.x, or.x) == 1 &&
          near(popup.placed(&t, p).x, pr.x) == 1);
    let is math.rect.Rect as br = layout.window_rect(&t, box1);
    let is f64 as pad = theme.metrics.space_xs + theme.metrics.border_width;
    check("what it holds inside its frame", near(br.x, pr.x + pad) == 1 && near(br.y, pr.y + pad) == 1 &&
          near(pr.w, br.w + 2.0 * pad) == 1 && near(pr.h, br.h + 2.0 * pad) == 1);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as bs;
    layout.measure(&t, box1, &free, &bs);
    let is geom.Size as ps;
    layout.measure(&t, p, &free, &ps);
    check("as large as what it holds would like, framed", near(pr.w, bs.pref_w + 2.0 * pad) == 1 &&
          near(pr.h, bs.pref_h + 2.0 * pad) == 1 && near(ps.min_w, bs.min_w + 2.0 * pad + pr.x) == 1);
    check("the window's input its own, the focus on what it holds first", router.scope(&r) == p && router.focused(&t, &r) == first);
    key(&t, &r, keys.TAB, 0, 10);
    key(&t, &r, keys.TAB, 0, 20);
    check("Tab round inside it", router.focused(&t, &r) == first);
    check("keys it has no use for: not taken, still open", router.key(&t, &r, keys.LEFT, 0, 1, 0, 30) == 0 &&
          popup.is_open(&t, p) == 1);
    router.key(&t, &r, keys.LEFT, 0, 0, 0, 31);
    router.key(&t, &r, keys.ESCAPE, keys.MOD_SHIFT, 1, 0, 32);
    router.key(&t, &r, keys.ESCAPE, 0, 0, 0, 33);
    check("escape with shift: still open", popup.is_open(&t, p) == 1);
    // Opened again while open: moved, the focus to give back still the first.
    popup.open_at(&t, &r, p, math.rect.rect(10.0, 10.0, 20.0, 20.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    popup.open_at(&t, &r, p, or, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    // A press outside: closed, spent on that, the focus back.
    closes = 0;
    clicks = 0;
    let is math.rect.Rect as ur = layout.window_rect(&t, under);
    click(&t, &r, ur.x + ur.w / 2.0, ur.y + ur.h / 2.0, 100);
    check("pressed outside: closed, said, nothing else pressed", popup.is_open(&t, p) == 0 && closes == 1 && clicks == 0 &&
          tree.is_visible(&t, p) == 0);
    check("the focus back where it was, the window's input its own again", router.focused(&t, &r) == opener && router.scope(&r) == 0);
    // Escape, from inside.
    popup.open_at(&t, &r, p, or, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    check("opened not to its first: the focus on it", router.focused(&t, &r) == p);
    key(&t, &r, keys.ESCAPE, 0, 200);
    check("escape: closed", popup.is_open(&t, p) == 0 && closes == 2 && router.focused(&t, &r) == opener);
    popup.open_at(&t, &r, p, or, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    check("escape from what it holds: taken as it goes down, closed", router.key(&t, &r, keys.ESCAPE, 0, 1, 0, 300) == 1 &&
          popup.is_open(&t, p) == 0);
    router.key(&t, &r, keys.ESCAPE, 0, 0, 0, 301);
    popup.close(&t, p);
    check("closed again: nothing said", closes == 3);
    // Opened keeping the focus where it is: an entry typed in below it.
    router.focus(&t, &r, opener, 1);
    popup.open_at(&t, &r, p, or, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, popup.KEEP_FOCUS);
    check("the focus kept, the popup no stop for Tab", popup.is_open(&t, p) == 1 && router.focused(&t, &r) == opener &&
          tree.is_focusable(&t, p) == 0);
    let is math.rect.Rect as opr = layout.window_rect(&t, opener);
    closes = 0;
    click(&t, &r, opr.x + 5.0, opr.y + opr.h / 2.0, 260);
    check("pressed on what kept the focus: still open", popup.is_open(&t, p) == 1 && closes == 0);
    popup.close(&t, p);
    check("closed: the focus still there", router.focused(&t, &r) == opener);
    // Near the window's foot: above instead; taller than the window: cut.
    let is math.rect.Rect as low = math.rect.rect(100.0, cast(f64, H) - 20.0, 50.0, 20.0);
    popup.open_at(&t, &r, p, low, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as pr2 = layout.window_rect(&t, p);
    check("no room under: above", near(pr2.y + pr2.h, low.y) == 1);
    popup.close(&t, p);
    layout.set_min_size(&t, box1, 10.0, 1000.0);
    popup.open_at(&t, &r, p, or, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as pr3 = layout.window_rect(&t, p);
    check("taller than the window: cut to it", pr3.y >= 0.0 && pr3.y + pr3.h <= cast(f64, H) + 0.01);
    // Destroyed while open: the window's input given back.
    tree.destroy(&t, p);
    check("destroyed open: the window's again", router.scope(&r) == 0);
    check("not a popup: nothing", popup.is_open(&t, opener) == 0 && popup.content(&t, opener) == 0 &&
          popup.open_at(&t, &r, opener, or, positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 1) == 0);
    popup.close(&t, opener);
    tree.close(&t);
}

fn drawn(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as p = popup.create(&t);
    let is i64 as filler = box.create(&t, p, box.COLUMN);
    layout.set_min_size(&t, filler, 100.0, 60.0);
    popup.open_at(&t, &r, p, math.rect.rect(20.0, 20.0, 10.0, 10.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    frame(&t, c);
    let is math.rect.Rect as pr = layout.window_rect(&t, p);
    check("in the popover's colour", is8(cast(i64, pr.x + pr.w / 2.0), cast(i64, pr.y + pr.h / 2.0), theme.palette.popover_bg, 2) == 1);
    check("framed", is8(cast(i64, pr.x + pr.w / 2.0), cast(i64, pr.y), theme.palette.border, 30) == 1);
    check("over the window", tree.layer(&t, p) >= popup.LAYER);
    tree.close(&t);
}

// Holding what can shrink: still as wide as it would like.
fn shrinkable() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as p = popup.create(&t);
    let is i64 as sa = scroll.create(&t, p);
    let is i64 as wide = button.create(&t, sa, "A rather wide button", 20);
    popup.open_at(&t, &r, p, math.rect.rect(10.0, 10.0, 10.0, 10.0), positioner.BOTTOM_LEFT, positioner.BOTTOM_RIGHT, 0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ss;
    layout.measure(&t, sa, &free, &ss);
    let is f64 as pad = theme.metrics.space_xs + theme.metrics.border_width;
    check("what it holds can shrink: as wide as it would like all the same", ss.min_w < ss.pref_w &&
          near(layout.window_rect(&t, p).w, ss.pref_w + 2.0 * pad) == 1 && wide != 0);
    tree.close(&t);
}

// An arrow at its anchor: a popover.
fn arrowed(c as *draw2d.Canvas) as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    tree.set_router(&t, cast(*u8, &r));
    let is i64 as p = popup.create(&t);
    popup.set_arrow(&t, p, 1);
    let is i64 as filler = box.create(&t, p, box.COLUMN);
    layout.set_min_size(&t, filler, 120.0, 50.0);
    let is math.rect.Rect as at = math.rect.rect(150.0, 40.0, 40.0, 20.0);
    layout.run(&t, cast(f64, W), cast(f64, H));
    popup.open_at(&t, &r, p, at, positioner.BOTTOM, positioner.BOTTOM, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as pr = layout.window_rect(&t, p);
    let is math.rect.Rect as ar = popup.arrow_rect(&t, p);
    let is math.rect.Rect as fr = layout.window_rect(&t, filler);
    let is f64 as pad = theme.metrics.space_xs + theme.metrics.border_width;
    check("under it, its middle under its middle", near(pr.y, at.y + at.h) == 1 && near(pr.x + pr.w / 2.0, at.x + at.w / 2.0) == 1);
    check("its arrow on top, pointing at the middle", popup.arrow_side(&t, p) == positioner.TOP && near(ar.y, at.y + at.h) == 1 &&
          near(ar.x + ar.w / 2.0, at.x + at.w / 2.0) == 1 && near(ar.h, popup.ARROW) == 1);
    check("what it holds below the arrow", near(fr.y, pr.y + popup.ARROW + pad) == 1 && near(pr.h, 50.0 + 2.0 * pad + popup.ARROW) == 1 &&
          near(fr.h, 50.0) == 1);
    frame(&t, c);
    check("the arrow drawn in its colour", is8(cast(i64, ar.x + ar.w / 2.0), cast(i64, ar.y + ar.h * 0.7), theme.palette.popover_bg, 3) == 1 &&
          is8(cast(i64, ar.x + 1.0), cast(i64, ar.y + 1.0), theme.palette.window_bg, 3) == 1);
    popup.close(&t, p);
    // No room under: above, its arrow at its foot.
    let is math.rect.Rect as low = math.rect.rect(150.0, cast(f64, H) - 30.0, 40.0, 20.0);
    popup.open_at(&t, &r, p, low, positioner.BOTTOM, positioner.BOTTOM, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as pr2 = layout.window_rect(&t, p);
    let is math.rect.Rect as ar2 = popup.arrow_rect(&t, p);
    check("flipped above: its arrow at its foot", popup.arrow_side(&t, p) == positioner.BOTTOM && near(pr2.y + pr2.h, low.y) == 1 &&
          near(ar2.y + ar2.h, low.y) == 1 && near(layout.window_rect(&t, filler).y, pr2.y + pad) == 1);
    popup.close(&t, p);
    // Near the window's edge: slid along, the arrow still at the middle.
    let is math.rect.Rect as edge = math.rect.rect(2.0, 40.0, 20.0, 20.0);
    popup.open_at(&t, &r, p, edge, positioner.BOTTOM, positioner.BOTTOM, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ar3 = popup.arrow_rect(&t, p);
    let is math.rect.Rect as pr3 = layout.window_rect(&t, p);
    check("slid along: the arrow still at the middle, inside its corner", pr3.x >= 0.0 && near(ar3.x + ar3.w / 2.0, 12.0) == 0 &&
          ar3.x >= pr3.x + theme.metrics.radius_m - 0.01 && ar3.x + ar3.w / 2.0 <= 12.0 + popup.ARROW);
    popup.close(&t, p);
    // At the side: its arrow on the side.
    let is math.rect.Rect as side = math.rect.rect(100.0, 100.0, 20.0, 20.0);
    popup.open_at(&t, &r, p, side, positioner.RIGHT, positioner.RIGHT, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ar4 = popup.arrow_rect(&t, p);
    let is math.rect.Rect as pr4 = layout.window_rect(&t, p);
    check("beside it: its arrow at its left", popup.arrow_side(&t, p) == positioner.LEFT && near(pr4.x, 120.0) == 1 &&
          near(ar4.x, 120.0) == 1 && near(ar4.y + ar4.h / 2.0, 110.0) == 1 && near(pr4.w, 120.0 + 2.0 * pad + popup.ARROW) == 1);
    popup.close(&t, p);
    // At its other side: its arrow at its right.
    let is math.rect.Rect as side2 = math.rect.rect(300.0, 100.0, 20.0, 20.0);
    popup.open_at(&t, &r, p, side2, positioner.LEFT, positioner.LEFT, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ar5 = popup.arrow_rect(&t, p);
    let is math.rect.Rect as pr5 = layout.window_rect(&t, p);
    let is math.rect.Rect as fr5 = layout.window_rect(&t, filler);
    check("before it: its arrow at its right", popup.arrow_side(&t, p) == positioner.RIGHT && near(pr5.x + pr5.w, 300.0) == 1 &&
          near(ar5.x + ar5.w, 300.0) == 1 && near(ar5.y + ar5.h / 2.0, 110.0) == 1 && near(fr5.x, pr5.x + pad) == 1 &&
          near(fr5.w, pr5.w - 2.0 * pad - popup.ARROW) == 1);
    frame(&t, c);
    check("drawn there", is8(cast(i64, ar5.x + ar5.w * 0.3), cast(i64, ar5.y + ar5.h / 2.0), theme.palette.popover_bg, 3) == 1);
    popup.close(&t, p);
    popup.open_at(&t, &r, p, side, positioner.RIGHT, positioner.RIGHT, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as fr4 = layout.window_rect(&t, filler);
    let is math.rect.Rect as ar6 = popup.arrow_rect(&t, p);
    check("beside it, what it holds past the arrow", near(fr4.x, layout.window_rect(&t, p).x + popup.ARROW + pad) == 1 &&
          near(fr4.w, 120.0) == 1);
    frame(&t, c);
    check("drawn at its left", is8(cast(i64, ar6.x + ar6.w * 0.7), cast(i64, ar6.y + ar6.h / 2.0), theme.palette.popover_bg, 3) == 1);
    popup.close(&t, p);
    // Beside it near the window's foot: slid up, the arrow inside its corner.
    let is math.rect.Rect as foot = math.rect.rect(100.0, cast(f64, H) - 12.0, 20.0, 10.0);
    popup.open_at(&t, &r, p, foot, positioner.RIGHT, positioner.RIGHT, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as arf = popup.arrow_rect(&t, p);
    let is math.rect.Rect as prf = layout.window_rect(&t, p);
    check("slid up: the arrow inside its lower corner", near(prf.y + prf.h, cast(f64, H)) == 1 &&
          near(arf.y + arf.h, prf.y + prf.h - theme.metrics.radius_m) == 1);
    popup.close(&t, p);
    // Flipped above, drawn at its foot; what it holds above the arrow.
    popup.open_at(&t, &r, p, low, positioner.BOTTOM, positioner.BOTTOM, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ar7 = popup.arrow_rect(&t, p);
    frame(&t, c);
    check("above: drawn at its foot, what it holds over the arrow", is8(cast(i64, ar7.x + ar7.w / 2.0), cast(i64, ar7.y + ar7.h * 0.3),
          theme.palette.popover_bg, 3) == 1 && near(layout.window_rect(&t, filler).h, 50.0) == 1);
    popup.close(&t, p);
    // Near the window's other edge: the arrow inside its far corner.
    let is math.rect.Rect as far = math.rect.rect(cast(f64, W) - 22.0, 40.0, 20.0, 20.0);
    popup.open_at(&t, &r, p, far, positioner.BOTTOM, positioner.BOTTOM, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ar8 = popup.arrow_rect(&t, p);
    let is math.rect.Rect as pr8 = layout.window_rect(&t, p);
    check("at the far edge: the arrow inside its far corner", ar8.x + ar8.w <= pr8.x + pr8.w - theme.metrics.radius_m + 0.01 &&
          ar8.x + ar8.w / 2.0 >= far.x + far.w / 2.0 - popup.ARROW - 0.01);
    popup.close(&t, p);
    // Too narrow for its corners and an arrow: the arrow in its middle.
    layout.set_min_size(&t, filler, 4.0, 50.0);
    layout.set_max_size(&t, filler, 4.0, 50.0);
    popup.open_at(&t, &r, p, at, positioner.BOTTOM, positioner.BOTTOM, popup.FOCUS_SELF);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is math.rect.Rect as ar9 = popup.arrow_rect(&t, p);
    let is math.rect.Rect as pr9 = layout.window_rect(&t, p);
    check("too narrow: the arrow in its middle", near(ar9.x + ar9.w / 2.0, pr9.x + pr9.w / 2.0) == 1);
    popup.close(&t, p);
    // Across, holding what can shrink: as wide as it would like, and the arrow.
    tree.destroy(&t, filler);
    let is i64 as sa = scroll.create(&t, p);
    button.create(&t, sa, "A rather wide button", 20);
    check("opened keeping the focus: done", popup.open_at(&t, &r, p, side, positioner.RIGHT, positioner.RIGHT, popup.KEEP_FOCUS) == 1);
    layout.run(&t, cast(f64, W), cast(f64, H));
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as ss;
    layout.measure(&t, sa, &free, &ss);
    check("across: as wide as what it holds would like, framed, and its arrow", ss.min_w < ss.pref_w &&
          near(layout.window_rect(&t, p).w, ss.pref_w + 2.0 * pad + popup.ARROW) == 1);
    popup.close(&t, p);
    popup.set_arrow(&t, p, 0);
    popup.open_at(&t, &r, p, at, positioner.BOTTOM, positioner.BOTTOM, popup.FOCUS_SELF);
    check("without: none", popup.arrow_rect(&t, p).w == 0.0 && popup.arrow_side(&t, p) == positioner.NONE);
    tree.close(&t);
}

fn told() as void {
    let is tree.Tree as t = tree_for();
    let is router.Router as r = router.init(router.settings_default());
    let is i64 as p = popup.create(&t);
    let is tree.Access as q;
    access.describe(&t, &r, p, &q);
    check("told as a panel", q.role == access.ROLE_PANEL);
    tree.close(&t);
}

fn main() as i32 {
    let is *u8 as d = load("text/testdata/shape-plain.ttf");
    if (cast(i64, d) == 0) {
        io.printf("FAIL: cannot read the test font\n");
        return 1;
    }
    face = sfnt.open(d, loaded, 0);
    list.faces = &face;
    list.n = 1;
    plain_font = font.of_list(&list);
    frame_router = cast(*router.Router, 0);
    theme = style.light();
    theme.fonts.body.size = 16.0;

    dv = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    target = gpu.texture.create(&dv, &td);
    cmd = gpu.command.create(&dv);
    let is draw2d.Limits as limits = draw2d.limits_default();
    let is draw2d.Canvas as c = draw2d.open(&dv, &limits);
    let is text.Limits as lim = text.limits_default();
    svc = text.open(&dv, &lim, fn_ptr(resolve), cast(*u8, 0), theme.fonts.family);

    opened();
    shrinkable();
    drawn(&c);
    arrowed(&c);
    told();

    if (fails == 0) {
        io.printf("popup: %d checks passed\n", checks);
        return 0;
    }
    io.printf("popup: %d of %d checks failed\n", fails, checks);
    return 1;
}
