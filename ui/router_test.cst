// ui/router_test.cst — pointer events: hit-testing, bubbling, capture, hover.
//
// Driven entirely by synthetic events through the same functions input/ will
// call, so what is tested here is the routing, not any platform.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "tree.cst" as tree;
use "widget.cst" as widget;
use "geom.cst" as geom;
use "layout.cst" as layout;
use "box.cst" as box;
use "event.cst" as event;
use "router.cst" as router;
use "../window/keys.cst" as keys;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL: %s: got %d, want %d\n", name, cast(i32, got), cast(i32, want));
        fails = fails + 1;
    }
}

// --- A probe: sized like a leaf, frames its one child, logs what it gets ---
//
// Each probe has a tag and a mask of event kinds it handles (returns 1 for).
// Every delivery is logged as tag * 1000 + kind * 10 + phase, so a test reads
// the whole sequence back in order.
struct Probe {
    pref_w  as f64;
    pref_h  as f64;
    tag     as i64;
    handles as i64;   // bit (1 << kind) set: handled
    clicks  as i64;   // clicks of the last POINTER_DOWN it saw
    lx      as f64;   // local position of the last event
    ly      as f64;
}

let is [256]i64 as log with mut;
let is i64 as logged with mut = 0;

fn reset() as void { logged = 0; }

fn probe_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    let is *Probe as d = cast(*Probe, data);
    out.min_w = 0.0;
    out.min_h = 0.0;
    out.pref_w = d.pref_w;
    out.pref_h = d.pref_h;
    out.max_w = layout.UNBOUNDED;
    out.max_h = layout.UNBOUNDED;
}

fn probe_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is i64 as child = tree.first_child(t, w);
    if (child == 0) { return; }
    let is math.rect.Rect as all = math.rect.rect(0.0, 0.0, r.w, r.h);
    layout.place(t, child, &all);
}

let is i64 as last_text with mut = 0;
let is i64 as last_len with mut = 0;
let is i32 as last_which with mut = 0;
let is i64 as last_cursor with mut = 0;

fn probe_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Probe as d = cast(*Probe, data);
    if (e.kind == event.PASTE || e.kind == event.PREEDIT) {
        last_text = cast(i64, e.text[0]);
        last_len = e.text_len;
        last_which = e.which;
        last_cursor = e.cursor;
    }
    if (logged < 256) {
        log[logged] = d.tag * 1000 + cast(i64, e.kind) * 10 + cast(i64, e.phase);
        logged = logged + 1;
    }
    if (e.kind == event.POINTER_DOWN) { d.clicks = cast(i64, e.clicks); }
    d.lx = e.local_x;
    d.ly = e.local_y;
    if ((d.handles & (1 << cast(i64, e.kind))) != 0) { return 1; }
    return 0;
}

let is tree.Kind as probe_kind with mut;

fn probe(t as *tree.Tree, parent as i64, tag as i64, pw as f64, ph as f64) as i64 {
    let is i64 as w = tree.create(t, &probe_kind, parent);
    let is *Probe as d = cast(*Probe, tree.data(t, w));
    d.pref_w = pw;
    d.pref_h = ph;
    d.tag = tag;
    return w;
}

fn handles(t as *tree.Tree, w as i64, kind as i32) as void {
    let is *Probe as d = cast(*Probe, tree.data(t, w));
    d.handles = d.handles | (1 << cast(i64, kind));
}

fn pd(t as *tree.Tree, w as i64) as *Probe { return cast(*Probe, tree.data(t, w)); }

fn has(want as i64) as i32 {
    let is i64 as k with mut = 0;
    while (k < logged) {
        if (log[k] == want) { return 1; }
        k = k + 1;
    }
    return 0;
}

fn entry(tag as i64, kind as i32, phase as i32) as i64 {
    return tag * 1000 + cast(i64, kind) * 10 + cast(i64, phase);
}

fn logged_is(name as *u8, i as i64, want as i64) as void {
    if (i >= logged) {
        io.printf("FAIL: %s: only %d entries logged\n", name, cast(i32, logged));
        fails = fails + 1;
        return;
    }
    eq(name, log[i], want);
}

fn main() as i32 {
    probe_kind = widget.kind("probe", sizeof(Probe));
    probe_kind.measure = fn_ptr(probe_measure);
    probe_kind.arrange = fn_ptr(probe_arrange);
    probe_kind.event = fn_ptr(probe_event);

    let is tree.Limits as l = tree.limits_default();
    let is tree.Tree as t = tree.open(&l);
    let is i64 as root = tree.root(&t);

    //   root 100x100
    //   └─ column
    //      ├─ a (tag 1)  y 0..50
    //      └─ b (tag 2)  y 50..100
    //         └─ c (tag 3)  20x20 at b's top-left
    let is i64 as col = box.create(&t, root, box.COLUMN);
    let is i64 as a = probe(&t, col, 1, 100.0, 50.0);
    let is i64 as b = probe(&t, col, 2, 100.0, 50.0);
    let is i64 as c = probe(&t, b, 3, 20.0, 20.0);
    layout.set_align(&t, c, layout.START, layout.START);
    layout.run(&t, 100.0, 100.0);

    let is router.Router as r = router.init(router.settings_default());

    // --- Hit-testing finds the deepest widget under the point ---
    eq("hit a", router.hit(&t, 10.0, 10.0), a);
    eq("hit c inside b", router.hit(&t, 10.0, 60.0), c);
    eq("hit b beside c", router.hit(&t, 50.0, 80.0), b);
    eq("outside the window hits nothing", router.hit(&t, 200.0, 200.0), 0);

    // --- Entering: every widget that now contains the pointer, outermost first ---
    reset();
    router.pointer_move(&t, &r, 10.0, 60.0, 1000);
    logged_is("enter b first", 0, entry(2, event.POINTER_ENTER, event.TARGET));
    logged_is("then enter c", 1, entry(3, event.POINTER_ENTER, event.TARGET));
    logged_is("move goes to c", 2, entry(3, event.POINTER_MOVE, event.TARGET));
    logged_is("and bubbles to b", 3, entry(2, event.POINTER_MOVE, event.BUBBLE));
    check("c hovered", router.hovered(&t, &r, c));
    check("b hovered through c", router.hovered(&t, &r, b));
    check("a not hovered", router.hovered(&t, &r, a) == 0);
    check("local coordinates", pd(&t, c).lx == 10.0 && pd(&t, c).ly == 10.0);

    // --- Leaving: innermost first, only what no longer contains the pointer ---
    reset();
    router.pointer_move(&t, &r, 10.0, 10.0, 1010);
    logged_is("leave c", 0, entry(3, event.POINTER_LEAVE, event.TARGET));
    logged_is("leave b", 1, entry(2, event.POINTER_LEAVE, event.TARGET));
    logged_is("enter a", 2, entry(1, event.POINTER_ENTER, event.TARGET));
    reset();
    router.pointer_leave(&t, &r, 1020);
    logged_is("pointer left the window", 0, entry(1, event.POINTER_LEAVE, event.TARGET));
    eq("nothing hovered", router.hover(&r), 0);

    // --- A press bubbles until handled, and the handler captures the pointer ---
    handles(&t, b, event.POINTER_DOWN);
    handles(&t, b, event.POINTER_MOVE);
    handles(&t, b, event.POINTER_UP);
    router.pointer_move(&t, &r, 10.0, 60.0, 1100);
    reset();
    router.pointer_button(&t, &r, 1, 1, 10.0, 60.0, 1110);
    logged_is("press reaches c", 0, entry(3, event.POINTER_DOWN, event.TARGET));
    logged_is("press bubbles to b", 1, entry(2, event.POINTER_DOWN, event.BUBBLE));
    eq("b captured", router.capture(&r), b);

    // While captured, motion goes to the captor alone, even over another widget,
    // and nothing enters or leaves.
    // 50 px with the button held is a drag, so the captor hears that first.
    reset();
    router.pointer_move(&t, &r, 10.0, 10.0, 1120);
    logged_is("drag start to captor", 0, entry(2, event.DRAG_START, event.TARGET));
    logged_is("move to captor", 1, entry(2, event.POINTER_MOVE, event.TARGET));
    eq("only the captor heard it", logged, 2);
    check("captor sees where the pointer is", pd(&t, b).ly == 0.0 - 40.0);

    reset();
    router.pointer_button(&t, &r, 1, 0, 10.0, 10.0, 1130);
    logged_is("release to captor", 0, entry(2, event.POINTER_UP, event.TARGET));
    eq("capture ends with the last button", router.capture(&r), 0);
    // Now the hover catches up with where the pointer went.
    logged_is("after release, leave c", 1, entry(3, event.POINTER_LEAVE, event.TARGET));
    logged_is("after release, leave b", 2, entry(2, event.POINTER_LEAVE, event.TARGET));
    logged_is("after release, enter a", 3, entry(1, event.POINTER_ENTER, event.TARGET));

    // --- Nobody handles the press: no capture ---
    reset();
    router.pointer_button(&t, &r, 1, 1, 10.0, 10.0, 2000);
    eq("unhandled press captures nothing", router.capture(&r), 0);
    router.pointer_button(&t, &r, 1, 0, 10.0, 10.0, 2010);

    // --- Click counting: time and distance from the settings ---
    router.pointer_move(&t, &r, 10.0, 60.0, 3000);
    router.pointer_button(&t, &r, 1, 1, 10.0, 60.0, 3000);
    router.pointer_button(&t, &r, 1, 0, 10.0, 60.0, 3010);
    eq("single", pd(&t, c).clicks, 1);
    router.pointer_button(&t, &r, 1, 1, 11.0, 61.0, 3200);
    router.pointer_button(&t, &r, 1, 0, 11.0, 61.0, 3210);
    eq("double", pd(&t, c).clicks, 2);
    router.pointer_button(&t, &r, 1, 1, 11.0, 61.0, 3400);
    router.pointer_button(&t, &r, 1, 0, 11.0, 61.0, 3410);
    eq("triple", pd(&t, c).clicks, 3);
    router.pointer_button(&t, &r, 1, 1, 11.0, 61.0, 3600);
    router.pointer_button(&t, &r, 1, 0, 11.0, 61.0, 3610);
    eq("after triple, single again", pd(&t, c).clicks, 1);
    router.pointer_button(&t, &r, 1, 1, 11.0, 61.0, 5000);
    router.pointer_button(&t, &r, 1, 0, 11.0, 61.0, 5010);
    eq("too slow: single", pd(&t, c).clicks, 1);
    router.pointer_button(&t, &r, 1, 1, 11.0, 61.0, 5100);
    router.pointer_button(&t, &r, 1, 0, 11.0, 61.0, 5110);
    router.pointer_button(&t, &r, 1, 1, 19.0, 61.0, 5200);
    router.pointer_button(&t, &r, 1, 0, 19.0, 61.0, 5210);
    eq("too far: single", pd(&t, c).clicks, 1);

    // --- Dragging starts past the threshold, once ---
    router.pointer_button(&t, &r, 1, 1, 10.0, 60.0, 6000);
    reset();
    router.pointer_move(&t, &r, 15.0, 60.0, 6010);
    check("5 px is not a drag", logged == 1 && log[0] == entry(2, event.POINTER_MOVE, event.TARGET));
    reset();
    router.pointer_move(&t, &r, 19.0, 60.0, 6020);
    logged_is("9 px starts the drag", 0, entry(2, event.DRAG_START, event.TARGET));
    reset();
    router.pointer_move(&t, &r, 30.0, 60.0, 6030);
    check("the drag starts once", logged == 1);
    router.pointer_button(&t, &r, 1, 0, 30.0, 60.0, 6040);

    // --- Scrolling goes to the widget under the pointer and bubbles ---
    handles(&t, b, event.SCROLL);
    router.pointer_move(&t, &r, 10.0, 60.0, 7000);
    reset();
    router.scroll(&t, &r, 10.0, 60.0, 0.0, 3.0, 1, 7010);
    logged_is("scroll reaches c", 0, entry(3, event.SCROLL, event.TARGET));
    logged_is("scroll bubbles to b", 1, entry(2, event.SCROLL, event.BUBBLE));

    // --- The context menu: a right press, bubbling like any press ---
    reset();
    router.pointer_button(&t, &r, 3, 1, 10.0, 60.0, 8000);
    let is i32 as found with mut = 0;
    let is i64 as k with mut = 0;
    while (k < logged) {
        if (log[k] == entry(3, event.CONTEXT_MENU, event.TARGET)) { found = 1; }
        k = k + 1;
    }
    check("right press asks for a context menu", found);
    router.pointer_button(&t, &r, 3, 0, 10.0, 60.0, 8010);

    // --- A disabled widget swallows the press: nothing reaches it or above ---
    tree.set_enabled(&t, c, 0);
    reset();
    router.pointer_button(&t, &r, 1, 1, 10.0, 60.0, 9000);
    eq("disabled: nothing delivered", logged, 0);
    eq("disabled: nothing captured", router.capture(&r), 0);
    router.pointer_button(&t, &r, 1, 0, 10.0, 60.0, 9010);
    // ... but not the wheel: it goes on to what holds it, as GTK has it, so a
    // disabled control inside a scrolled view does not stop the view.
    reset();
    router.scroll(&t, &r, 10.0, 60.0, 0.0, 1.0, 1, 9020);
    check("disabled: the wheel on to what holds it", has(entry(2, event.SCROLL, event.TARGET)) == 1 &&
          has(entry(3, event.SCROLL, event.TARGET)) == 0);
    tree.set_enabled(&t, c, 1);

    // --- A widget destroyed under the pointer is simply gone ---
    router.pointer_move(&t, &r, 10.0, 60.0, 10000);
    tree.destroy(&t, c);
    layout.run(&t, 100.0, 100.0);
    reset();
    router.pointer_move(&t, &r, 11.0, 61.0, 10010);
    eq("hover moves to what is there now", router.hover(&r), b);

    // --- What the user does, counted: presses and keys going down ---
    let is router.Router as fresh = router.init(router.settings_default());
    eq("nothing yet", router.inputs(&fresh), 0);
    eq("a tooltip's delay by default", fresh.settings.tooltip_ms, 500);
    router.pointer_move(&t, &fresh, 11.0, 61.0, 20000);
    eq("a move is not one", router.inputs(&fresh), 0);
    router.pointer_button(&t, &fresh, 1, 1, 11.0, 61.0, 20010);
    eq("a press is", router.inputs(&fresh), 1);
    router.pointer_button(&t, &fresh, 1, 0, 11.0, 61.0, 20020);
    eq("its release is not", router.inputs(&fresh), 1);
    router.key(&t, &fresh, keys.B, 0, 1, 0, 20030);
    eq("a key going down is", router.inputs(&fresh), 2);
    router.key(&t, &fresh, keys.B, 0, 0, 0, 20040);
    eq("coming up is not", router.inputs(&fresh), 2);

    // --- The modifiers held: as X says them, the state before the event,
    // a modifier key's own going down or up counted in; and as the
    // pointer's events say them ---
    router.key(&t, &fresh, keys.CONTROL_L, 0, 1, 0, 20050);
    eq("Ctrl down: held, though its event says nothing yet", router.modifiers(&fresh), keys.MOD_CONTROL);
    router.key(&t, &fresh, keys.SHIFT_R, keys.MOD_CONTROL, 1, 0, 20051);
    eq("Shift too", router.modifiers(&fresh), keys.MOD_CONTROL | keys.MOD_SHIFT);
    router.key(&t, &fresh, keys.CONTROL_R, keys.MOD_CONTROL | keys.MOD_SHIFT, 0, 0, 20052);
    eq("Ctrl up, though its event still says it", router.modifiers(&fresh), keys.MOD_SHIFT);
    router.key(&t, &fresh, keys.SHIFT_L, keys.MOD_SHIFT, 0, 0, 20053);
    eq("Shift up: none", router.modifiers(&fresh), 0);
    router.key(&t, &fresh, keys.ALT_R, 0, 1, 0, 20054);
    router.key(&t, &fresh, keys.SUPER_L, keys.MOD_ALT, 1, 0, 20055);
    eq("Alt and Super", router.modifiers(&fresh), keys.MOD_ALT | keys.MOD_SUPER);
    router.key(&t, &fresh, keys.ALT_L, keys.MOD_ALT | keys.MOD_SUPER, 0, 0, 20056);
    router.key(&t, &fresh, keys.SUPER_R, keys.MOD_SUPER, 0, 0, 20057);
    eq("both up", router.modifiers(&fresh), 0);
    router.key(&t, &fresh, keys.B, keys.MOD_SHIFT, 1, 0, 20058);
    eq("another key: as its event says", router.modifiers(&fresh), keys.MOD_SHIFT);
    router.set_modifiers(&fresh, keys.MOD_CONTROL);
    eq("as the pointer's events say them", router.modifiers(&fresh), keys.MOD_CONTROL);
    router.set_modifiers(&fresh, 0);
    router.key(&t, &fresh, keys.B, 0, 0, 0, 20059);
    // Alt going down or up: every mnemonic's underline shown or hidden, so
    // all repainted; another key, nothing.
    tree.damage_clear(&t);
    router.key(&t, &fresh, keys.ALT_L, 0, 1, 0, 20060);
    let is i32 as alt_down_paints = tree.paint_wanted(&t);
    tree.damage_clear(&t);
    router.key(&t, &fresh, keys.B, keys.MOD_ALT, 1, 0, 20061);
    router.key(&t, &fresh, keys.B, keys.MOD_ALT, 0, 0, 20062);
    let is i32 as other_paints = tree.paint_wanted(&t);
    tree.damage_clear(&t);
    router.key(&t, &fresh, keys.ALT_L, keys.MOD_ALT, 0, 0, 20063);
    check("Alt down, up: all repainted; a key between: nothing", alt_down_paints == 1 && other_paints == 0 &&
          tree.paint_wanted(&t) == 1);

    // --- Pasted text, to what asked; an input method's composition, to the
    // focus ---
    router.focus(&t, &fresh, a, 0);
    reset();
    router.paste(&t, &fresh, b, tree.PRIMARY, "pasted", 6, 20100);
    check("pasted: to what asked, whatever has the focus", has(entry(2, event.PASTE, event.TARGET)) &&
          last_text == 112 && last_which == tree.PRIMARY && last_len == 6);
    reset();
    router.paste(&t, &fresh, b + 1000000, tree.CLIPBOARD, "x", 1, 20110);
    eq("to what is gone: nothing", logged, 0);
    tree.set_focusable(&t, a, 1);
    router.focus(&t, &fresh, a, 1);
    reset();
    router.preedit(&t, &fresh, "kana", 4, 2, 20120);
    check("a composition: to the focus, its caret with it", has(entry(1, event.PREEDIT, event.TARGET)) &&
          last_text == 107 && last_cursor == 2 && last_len == 4);
    router.focus(&t, &fresh, 0, 0);
    reset();
    router.preedit(&t, &fresh, "kana", 4, 2, 20130);
    eq("no focus: nobody", logged, 0);

    // --- The wheel during a press: the hover stays with what was pressed ---
    let is router.Router as held = router.init(router.settings_default());
    handles(&t, a, event.POINTER_DOWN);
    router.pointer_move(&t, &held, 10.0, 10.0, 30000);
    router.pointer_button(&t, &held, 1, 1, 10.0, 10.0, 30000);
    router.scroll(&t, &held, 50.0, 80.0, 0.0, 1.0, 1, 30010);
    check("scrolled elsewhere while pressed: the hover kept", router.hovered(&t, &held, a) == 1 &&
          router.hovered(&t, &held, b) == 0);
    router.pointer_button(&t, &held, 1, 0, 10.0, 10.0, 30020);

    // --- The platform asking the window to close ---
    // Nothing focused, nothing taking it: every widget asked, outermost
    // first, and it is not taken.
    let is router.Router as cl = router.init(router.settings_default());
    let is i64 as c2 = probe(&t, b, 4, 20.0, 20.0);
    reset();
    check("nothing takes it: not taken", router.close_request(&t, &cl, 40000) == 0);
    logged_is("asked of a", 0, entry(1, event.CLOSE_REQUEST, event.TARGET));
    logged_is("then of b", 1, entry(2, event.CLOSE_REQUEST, event.TARGET));
    logged_is("then of what b holds", 2, entry(4, event.CLOSE_REQUEST, event.TARGET));
    // Taken by the one inside another: the walk stops there.
    handles(&t, c2, event.CLOSE_REQUEST);
    reset();
    check("taken inside: taken", router.close_request(&t, &cl, 40010) == 1 && logged == 3);
    // Focused: to it first, bubbling.
    handles(&t, b, event.CLOSE_REQUEST);
    router.focus(&t, &cl, a, 1);
    reset();
    check("focused: asked first, then the rest, taken", router.close_request(&t, &cl, 40020) == 1);
    logged_is("to the focused first", 0, entry(1, event.CLOSE_REQUEST, event.TARGET));

    tree.close(&t);
    if (fails != 0) { return 1; }
    io.printf("ui router: all checks passed\n");
    return 0;
}
