// ui/flatten_test.cst — a tree's rows as a list: those shown, their depths,
// branches opened and closed, children read only when opened, and the tree's
// changes passed on as the rows shown change.
use "std/io.cst" as io;
use "model.cst" as model;
use "flatten.cst" as flatten;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

// --- A tree the test changes at will ---
//
// Each node has an id, a parent and its children in order. Ids are the
// node's slot; 0 is the top.
struct Node {
    parent as i64;
    n      as i64;
    kids   as [128]i64;
}

let is [160]Node as nodes with mut;
let is i64 as counted with mut = 0;   // how many times count() was asked of a node other than the top
let is model.Model as src with mut;

fn tree_count(self as *u8, parent as i64) as i64 {
    if (parent != 0) { counted = counted + 1; }
    return nodes[parent].n;
}

fn tree_row_id(self as *u8, parent as i64, index as i64) as i64 {
    if (index < 0 || index >= nodes[parent].n) { return 0; }
    return nodes[parent].kids[index];
}

fn tree_parent_of(self as *u8, id as i64) as i64 { return nodes[id].parent; }

// Whether a node has children, answered without counting them — 13 says
// it has, as a lazy model would before loading, and has none.
fn tree_has_children(self as *u8, id as i64) as i64 {
    if (id == 13) { return 1; }
    return cast(i64, nodes[id].n > 0);
}

let is i64 as cell_asked with mut = 0;

fn tree_cell(self as *u8, id as i64, column as i64, role as i32, out as *model.Value) as i64 {
    cell_asked = id;
    *out = model.integer(id * 10 + column);
    return 1;
}

fn tree_columns(self as *u8) as i64 { return 3; }

let is i64 as set_asked with mut = 0;

fn tree_set_cell(self as *u8, id as i64, column as i64, role as i32, v as *model.Value) as i64 {
    set_asked = id;
    return 1;
}

// Node id under parent at index, its own children none yet.
fn add(parent as i64, index as i64, id as i64) as void {
    let is i64 as i with mut = nodes[parent].n;
    while (i > index) {
        nodes[parent].kids[i] = nodes[parent].kids[i - 1];
        i = i - 1;
    }
    nodes[parent].kids[index] = id;
    nodes[parent].n = nodes[parent].n + 1;
    nodes[id].parent = parent;
    nodes[id].n = 0;
}

fn cut(parent as i64, index as i64, count as i64) as void {
    let is i64 as i with mut = index;
    while (i + count < nodes[parent].n) {
        nodes[parent].kids[i] = nodes[parent].kids[i + count];
        i = i + 1;
    }
    nodes[parent].n = nodes[parent].n - count;
}

//   1 docs
//   ├─ 3
//   │  └─ 5
//   └─ 4
//   2 music
//   └─ 6
fn grow() as void {
    nodes[0].n = 0;
    add(0, 0, 1);
    add(0, 1, 2);
    add(1, 0, 3);
    add(1, 1, 4);
    add(3, 0, 5);
    add(2, 0, 6);
}

// What the flat model told its observers.
let is [32]model.Change as told with mut;
let is i64 as ntold with mut = 0;

fn on_change(user as *u8, c as *model.Change) as void {
    if (ntold < 32) { told[ntold] = *c; }
    ntold = ntold + 1;
}

fn was(i as i64, kind as i32, first as i64, count as i64) as i32 {
    return cast(i32, i < ntold && told[i].kind == kind && told[i].parent == 0 && told[i].first == first &&
                told[i].count == count);
}

// The ids shown, in order, as a number: 1, 3, 4 is 134.
fn shown(f as *flatten.Flat) as i64 {
    let is *model.Model as m = flatten.model_of(f);
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < model.count(m, 0)) {
        v = v * 10 + model.row_id(m, 0, i);
        i = i + 1;
    }
    return v;
}

fn opened() as void {
    grow();
    counted = 0;
    let is *flatten.Flat as f = flatten.open(&src);
    let is *model.Model as m = flatten.model_of(f);
    model.observe(m, fn_ptr(on_change), cast(*u8, 0));
    check("the top level shown, nothing else read", shown(f) == 12 && counted == 0);
    check("each at depth 0, closed, with children to open", flatten.depth(f, 0) == 0 && flatten.depth(f, 1) == 0 &&
          flatten.is_expanded(f, 0) == 0 && flatten.expandable(f, 0) == 1);
    check("a flat model: nothing under its rows", model.count(m, 1) == 0 && model.parent_of(m, 3) == 0);
    ntold = 0;
    check("opened", flatten.expand(f, 0) == 1);
    check("its children under it, one deeper, said", shown(f) == 1342 && flatten.depth(f, 1) == 1 &&
          flatten.depth(f, 2) == 1 && flatten.is_expanded(f, 0) == 1 && was(0, model.INSERTED, 1, 2) == 1 && counted > 0);
    check("opened again: nothing", flatten.expand(f, 0) == 0 && ntold == 1);
    flatten.expand(f, 1);
    check("deeper still", shown(f) == 13542 && flatten.depth(f, 2) == 2 && was(1, model.INSERTED, 2, 1) == 1);
    check("a leaf: nothing to open", flatten.expandable(f, 2) == 0 && flatten.expand(f, 2) == 0);
    check("each row's parent", flatten.parent_index(f, 2) == 1 && flatten.parent_index(f, 1) == 0 &&
          flatten.parent_index(f, 3) == 0 && flatten.parent_index(f, 4) == 0 - 1 && flatten.parent_index(f, 0) == 0 - 1);
    check("a row by its id", flatten.index_of(f, 4) == 3 && flatten.index_of(f, 6) == 0 - 1 && model.index_of(m, 5) == 2);
    ntold = 0;
    flatten.collapse(f, 0);
    check("closed: all under it gone, said", shown(f) == 12 && was(0, model.REMOVED, 1, 3) == 1 && flatten.is_expanded(f, 0) == 0);
    check("closed again: nothing", flatten.collapse(f, 0) == 0 && ntold == 1);
    flatten.expand(f, 0);
    check("opened again: its children closed", shown(f) == 1342 && flatten.is_expanded(f, 1) == 0);
    flatten.toggle(f, 3);
    check("the last opened: its child at the end", shown(f) == 13426);
    flatten.toggle(f, 3);
    check("and closed", shown(f) == 1342);
    // What a row holds, from the tree.
    let is model.Value as v;
    model.cell(m, 4, 2, model.TEXT, &v);
    check("cells read from the tree", v.kind == model.V_INT && v.i == 42 && model.columns(m) == 3);
    let is model.Value as nv = model.integer(1);
    check("and written to it", model.set_cell(m, 3, 0, model.TEXT, &nv) == 1 && set_asked == 3);
    check("out of range: nothing", flatten.depth(f, 9) == 0 - 1 && flatten.is_expanded(f, 0 - 1) == 0 &&
          flatten.expand(f, 9) == 0 && flatten.collapse(f, 0 - 1) == 0 && model.row_id(m, 0, 9) == 0);
    flatten.close(f);
}

fn followed() as void {
    grow();
    let is *flatten.Flat as f = flatten.open(&src);
    let is *model.Model as m = flatten.model_of(f);
    model.observe(m, fn_ptr(on_change), cast(*u8, 0));
    flatten.expand(f, 0);   // 1 3 4 2
    flatten.expand(f, 1);   // 1 3 5 4 2
    // Into an open branch: where they now show.
    ntold = 0;
    add(1, 1, 7);
    model.inserted(&src, 1, 1, 1);
    check("into an open branch: shown in place, said", shown(f) == 135742 && was(0, model.INSERTED, 3, 1) == 1 &&
          flatten.depth(f, 3) == 1);
    add(0, 2, 8);
    model.inserted(&src, 0, 2, 1);
    check("at the top, past the last: at the end", shown(f) == 1357428 && was(1, model.INSERTED, 6, 1) == 1);
    add(0, 0, 9);
    model.inserted(&src, 0, 0, 1);
    check("at the top, first: first", shown(f) == 91357428 && flatten.depth(f, 0) == 0);
    // Into a closed branch: nothing shown, its row told it changed.
    ntold = 0;
    add(2, 1, 10);
    model.inserted(&src, 2, 1, 1);
    check("into a closed branch: not shown, its row changed", shown(f) == 91357428 && was(0, model.CHANGED, 6, 1) == 1);
    // Into a branch not shown at all: nothing.
    ntold = 0;
    add(5, 0, 11);
    model.inserted(&src, 5, 0, 1);
    check("under a row shown, closed: its row changed", was(0, model.CHANGED, 3, 1) == 1);
    add(11, 0, 12);
    ntold = 0;
    model.inserted(&src, 11, 0, 1);
    check("under one not shown: nothing", ntold == 0);
    // Removed: with all shown under them.
    flatten.expand(f, 3);   // 9 1 3 5 11 7 4 2 8
    ntold = 0;
    cut(1, 0, 1);
    model.removed(&src, 1, 0, 1);
    check("a row removed: all shown under it with it", shown(f) == 91742 * 10 + 8 && was(0, model.REMOVED, 2, 3) == 1);
    ntold = 0;
    cut(0, 2, 1);
    model.removed(&src, 0, 2, 1);
    check("at the top: the last", shown(f) == 91748 && was(0, model.REMOVED, 4, 1) == 1);
    ntold = 0;
    cut(2, 0, 2);
    model.removed(&src, 2, 0, 2);
    check("from a branch not shown: nothing", ntold == 0);
    // Changed: the rows shown said changed, one by one.
    ntold = 0;
    model.changed(&src, 1, 0, 2);
    check("changed: each shown row said", was(0, model.CHANGED, 2, 1) == 1 && was(1, model.CHANGED, 3, 1) == 1 && ntold == 2);
    ntold = 0;
    model.changed(&src, 0, 0, 1);
    check("changed at the top", was(0, model.CHANGED, 0, 1) == 1);
    // Reset: the top level again, all closed.
    ntold = 0;
    grow();
    model.reset(&src);
    check("reset: the top level, all closed, said", shown(f) == 12 && flatten.is_expanded(f, 0) == 0 && ntold == 1 &&
          told[0].kind == model.RESET);
    flatten.close(f);
    // Closed: no longer hearing the tree.
    ntold = 0;
    model.reset(&src);
    check("closed: no longer hearing", ntold == 0);
}

// Rows read past the last, the parent past a sibling, branches opened empty,
// several rows at once, and more rows than first had room.
fn edges() as void {
    grow();
    let is *flatten.Flat as f = flatten.open(&src);
    let is *model.Model as m = flatten.model_of(f);
    model.observe(m, fn_ptr(on_change), cast(*u8, 0));
    // The last row gone from the tree: what was there is not a row.
    cut(0, 1, 1);
    model.removed(&src, 0, 1, 1);
    check("past the last: no row to open", shown(f) == 1 && flatten.expand(f, 1) == 0 && flatten.expandable(f, 1) == 0 &&
          flatten.depth(f, 1) == 0 - 1 && model.row_id(m, 0, 1) == 0 && flatten.index_of(f, 2) == 0 - 1);
    grow();
    model.reset(&src);
    flatten.expand(f, 1);   // 1 2 6
    cut(0, 1, 1);
    model.removed(&src, 0, 1, 1);
    check("past the last, open: nothing to close", shown(f) == 1 && flatten.is_expanded(f, 1) == 0 &&
          flatten.collapse(f, 1) == 0 && flatten.parent_index(f, 1) == 0 - 1);
    // Where a branch ends, with rows once there past it.
    grow();
    model.reset(&src);
    flatten.expand(f, 0);
    flatten.expand(f, 1);   // 1 3 5 4 2
    flatten.collapse(f, 0); // 1 2
    flatten.expand(f, 1);   // 1 2 6
    ntold = 0;
    check("closed at the end: only its own, said", flatten.collapse(f, 1) == 1 && shown(f) == 12 &&
          was(0, model.REMOVED, 2, 1) == 1);
    flatten.expand(f, 0);   // 1 3 4 2
    flatten.collapse(f, 0); // 1 2, a row of depth 1 once past them
    check("past the last, once deeper: no parent", flatten.parent_index(f, 2) == 0 - 1);
    // A parent with two children shown.
    grow();
    add(3, 1, 14);
    model.reset(&src);
    flatten.expand(f, 0);
    flatten.expand(f, 1);   // 1 3 5 14 4 2
    check("the parent past a sibling", flatten.parent_index(f, 3) == 1 && flatten.parent_index(f, 2) == 1);
    ntold = 0;
    check("closed further down: its two gone", flatten.collapse(f, 1) == 1 && shown(f) == 1342 && was(0, model.REMOVED, 2, 2) == 1);
    flatten.expand(f, 1);
    ntold = 0;
    model.changed(&src, 1, 0, 1);
    check("one of two changed: only it", ntold == 1 && was(0, model.CHANGED, 1, 1) == 1);
    ntold = 0;
    cut(1, 0, 2);
    model.removed(&src, 1, 0, 2);
    check("two removed at once: with all under them", shown(f) == 12 && was(0, model.REMOVED, 1, 4) == 1);
    // A branch that says it has children, and has none.
    add(0, 2, 13);
    model.inserted(&src, 0, 2, 1);
    ntold = 0;
    check("opened empty: opened, nothing said", flatten.expand(f, 2) == 1 && flatten.is_expanded(f, 2) == 1 && ntold == 0);
    check("closed empty: closed, nothing said", flatten.collapse(f, 2) == 1 && ntold == 0);
    // More rows than there was room for.
    nodes[0].n = 0;
    let is i64 as i with mut = 0;
    while (i < 100) {
        add(0, i, 30 + i);
        i = i + 1;
    }
    i = 0;
    while (i < 30) {
        add(30, i, 130 + i);
        i = i + 1;
    }
    model.reset(&src);
    flatten.expand(f, 0);
    check("a hundred and thirty rows, all kept", model.count(m, 0) == 130 && model.row_id(m, 0, 0) == 30 &&
          model.row_id(m, 0, 1) == 130 && model.row_id(m, 0, 31) == 31 && model.row_id(m, 0, 129) == 129);
    flatten.close(f);
    flatten.close(cast(*flatten.Flat, 0));
}

fn main() as i32 {
    src = model.make(cast(*u8, 0), fn_ptr(tree_count), fn_ptr(tree_row_id), fn_ptr(tree_cell));
    src.parent_of = fn_ptr(tree_parent_of);
    src.has_children = fn_ptr(tree_has_children);
    src.columns = fn_ptr(tree_columns);
    src.set_cell = fn_ptr(tree_set_cell);

    opened();
    followed();
    edges();

    if (fails == 0) {
        io.printf("flatten: %d checks passed\n", checks);
        return 0;
    }
    io.printf("flatten: %d of %d checks failed\n", fails, checks);
    return 1;
}
