// tools/windows/compact_check.cst — caustic-compact, built for Windows and
// run under wine: text through zlib and back.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "caustic-compact/formats/zlib.cst" as zlib;
use "caustic-compact/core/bytes.cst" as bytes;

fn main() as i32 {
    let is *u8 as text = "caustic-media on windows, caustic-media on windows, caustic-media on windows";
    let is i64 as len with mut = 0;
    while (*cast(*u8, cast(i64, text) + len) != 0) { len = len + 1; }
    let is bytes.Bytes as packed = bytes.bytes_new(256);
    let is bytes.Bytes as back = bytes.bytes_new(256);
    if (zlib.zlib_compress(text, len, &packed, 6) < 0 || packed.len >= len) {
        io.printf("caustic-compact on windows: compress failed\n");
        return 1;
    }
    if (zlib.zlib_decompress(packed.ptr, packed.len, &back) != len || mem.memcmp(back.ptr, text, len) != 0) {
        io.printf("caustic-compact on windows: not the same back\n");
        return 1;
    }
    io.printf("caustic-compact on windows: %d bytes to %d and back\n", len, packed.len);
    return 0;
}
