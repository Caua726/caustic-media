// tools/windows/image_check.cst — caustic-image, built for Windows and run
// under wine: a PNG decoded from memory, its pixels as written
// (image/testdata/rgba.png, by image/tools/make_pngs.py).
use "std/io.cst" as io;
use "caustic-image/decode.cst" as decode;
use "caustic-image/core/image.cst" as cimage;

let is *u8 as HEX with imut = "89504e470d0a1a0a0000000d49484452000000030000000208060000009d74661a0000001e4944415478da63f8cfc0f01f081b4014032313330b2b1b3b072717370f005c3404cbe613cbcf0000000049454e44ae426082";

fn _hex(c as i64) as i64 {
    if (c >= 97) { return c - 87; }
    return c - 48;
}

fn main() as i32 {
    let is [256]u8 as png;
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, HEX) + n * 2) != 0) {
        png[n] = cast(u8, _hex(cast(i64, *cast(*u8, cast(i64, HEX) + n * 2))) * 16
                         + _hex(cast(i64, *cast(*u8, cast(i64, HEX) + n * 2 + 1))));
        n = n + 1;
    }
    let is cimage.Image as im;
    let is i64 as rc = decode.decode(cast(*u8, &png), n, &im);
    if (rc < 0 || im.width != 3 || im.height != 2) {
        io.printf("caustic-image on windows: decode failed (%d)\n", rc);
        return 1;
    }
    let is *u8 as p = cast(*u8, cast(i64, im.pixels) + 4);
    if (p[0] != 0 || p[1] != 255 || p[2] != 0 || p[3] != 128) {
        io.printf("caustic-image on windows: wrong pixel\n");
        return 1;
    }
    cimage.image_free(&im);
    io.printf("caustic-image on windows: a PNG decoded\n");
    return 0;
}
