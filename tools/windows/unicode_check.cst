// tools/windows/unicode_check.cst — caustic-unicode, built for Windows and
// run under wine: a width in columns, and a normalization.
use "std/io.cst" as io;
use "caustic-unicode/src/width/width.cst" as width;
use "caustic-unicode/src/normalize/normalize.cst" as nz;
use "caustic-unicode/src/core/buf.cst" as buf;

fn main() as i32 {
    let is i64 as cols = width.string_width("hello 世界", 12);
    let is [2]i32 as decomposed;
    decomposed[0] = 101;
    decomposed[1] = 769;
    let is buf.CpBuf as nfc = buf.cpbuf_new(8);
    nz.nfc(cast(*i32, &decomposed), 2, &nfc);
    if (cols != 10 || nfc.len != 1 || cast(i64, nfc.ptr[0]) != 233) {
        io.printf("caustic-unicode on windows: %%d columns, %%d code points\n", cols, nfc.len);
        return 1;
    }
    io.printf("caustic-unicode on windows: 10 columns, e and its accent one\n");
    return 0;
}
