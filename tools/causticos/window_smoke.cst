// tools/causticos/window_smoke.cst — a window that draws, for the backend's build.
use "../../window/window.cst" as window;
use "../../gpu/software/target.cst" as tgt;
fn main() as i32 {
    let is window.device.Window as w = window.open("smoke", 320, 200);
    if (window.is_open(&w) == 0) { return 1; }
    let is i64 as frames with mut = 0;
    while (window.next_frame(&w) == 1 && frames < 3) {
        let is tgt.Target as t = window.acquire(&w);
        if (t.width == 0) { continue; }
        let is *u32 as px = cast(*u32, t.color);
        let is i64 as i with mut = 0;
        while (i < t.width * t.height) { px[i] = cast(u32, 0x003070C0); i = i + 1; }
        window.submit(&w);
        frames = frames + 1;
    }
    window.close(&w);
    return 0;
}
