// tools/causticos/runall.cst — caustic-media's tests, inside CausticOS.
//
// /init of a test image that tools/causticos/run.sh builds. /cm/tests lists the
// tests one per line, as the path of each .cse on the root; /cm is the
// repository's own layout, so a test that opens "text/testdata/x.ttf" finds it,
// because every test is started in /cm (its KEY_DIR).
//
// One process per test, waited for with a deadline: a test that hangs is
// ended and reported as such, and the next one still runs. Each prints its own
// verdict; this prints the name before it and the exit code after, so a test
// that dies silently is a name with a bad code, not a gap. The host waits for
// "cmtests: DONE".

use "std/os/causticos.cst" as sys;

let is i64 as DEADLINE_NS with imut = 120000000000;   // two minutes a test

let is [24]u8 as numbuf;

fn num(v as i64) as *u8 {
    let is i64 as x with mut = v;
    let is i64 as neg with mut = 0;
    if (x < 0) { neg = 1; x = 0 - x; }
    let is i64 as i with mut = 23;
    numbuf[23] = cast(u8, 0);
    if (x == 0) { i = 22; numbuf[22] = cast(u8, 48); }
    while (x > 0 && i > 1) {
        i = i - 1;
        numbuf[i] = cast(u8, 48 + (x % 10));
        x = x / 10;
    }
    if (neg == 1) { i = i - 1; numbuf[i] = cast(u8, 45); }
    return cast(*u8, &numbuf[i]);
}

fn say(m as *u8) as void {
    let is i64 as n with mut = 0;
    while (m[n] != cast(u8, 0)) { n = n + 1; }
    sys.write_serial(m, n);
    return;
}

let is [65536]u8 as list;
let is [256]u8 as path;

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as fd = sys.open_read("/cm/tests");
    if (fd < 0) { say("cmtests: no /cm/tests\ncmtests: DONE\n"); return 1; }
    let is i64 as len with mut = 0;
    while (len < 65535) {
        let is i64 as r = sys.read(fd, cast(*u8, cast(i64, &list[0]) + len), 65535 - len);
        if (r <= 0) { break; }
        len = len + r;
    }
    sys.close(fd);
    let is i64 as dir = sys.dir_open("/cm", 3);
    if (dir < 0) { say("cmtests: no /cm directory\ncmtests: DONE\n"); return 1; }

    let is i64 as ran with mut = 0;
    let is i64 as bad with mut = 0;
    let is i64 as at with mut = 0;
    while (at < len) {
        let is i64 as n with mut = 0;
        while (at + n < len && list[at + n] != cast(u8, 10) && n < 255) {
            path[n] = list[at + n];
            n = n + 1;
        }
        at = at + n + 1;
        if (n == 0) { continue; }
        path[n] = cast(u8, 0);
        let is *u8 as p = cast(*u8, &path[0]);

        say("cmtests: >>> "); say(p); say("\n");
        let is [2]i64 as av;
        av[0] = cast(i64, p); av[1] = n;
        let is [4]i64 as acts;
        acts[0] = sys.KEY_DIR; acts[1] = dir;
        acts[2] = sys.KEY_HW;  acts[3] = sys.key(sys.KEY_HW);
        let is i64 as nacts with mut = 2;
        if (acts[3] < 0) { nacts = 1; }
        let is i64 as pid = sys.spawn_path(p, cast(*u8, &acts[0]), nacts, cast(*u8, &av[0]), 1);
        if (pid < 0) {
            say("cmtests: <<< "); say(p); say(" SPAWNFAIL "); say(num(pid)); say("\n");
            bad = bad + 1;
            continue;
        }
        let is [1]i64 as code;
        code[0] = 0 - 1;
        let is i64 as w with mut = sys.wait_ns(pid, cast(*i64, &code[0]), DEADLINE_NS);
        ran = ran + 1;
        say("cmtests: <<< "); say(p);
        if (w == sys.E_AGAIN) {
            sys.kill(pid);
            sys.wait(pid, cast(*i64, &code[0]));
            say(" TIMEOUT\n");
            bad = bad + 1;
            continue;
        }
        if (w < 0) {
            say(" WAITFAIL "); say(num(w)); say("\n");
            bad = bad + 1;
            continue;
        }
        say(" exit="); say(num(code[0])); say("\n");
        if (code[0] != 0) { bad = bad + 1; }
    }
    say("cmtests: "); say(num(ran)); say(" ran, "); say(num(bad)); say(" failed\n");
    say("cmtests: DONE\n");
    if (bad != 0) { return 1; }
    return 0;
}
