// gpu/software/reference_test.cst — frames against references written by an
// independent PNG encoder (tools/make_references.py). Run from the
// repository's root with caustic-image on the module path:
//   caustic -q gpu/software/reference_test.cst -o build/reference_test --path .caustic/deps
use "std/io.cst" as io;
use "target.cst" as tgt;
use "reference.cst" as reference;
use "../../image/load.cst" as load;
use "../../image/buffer.cst" as buffer;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is *u8 as DIR with imut = "build/reference-test";
let is *u8 as PATTERN with imut = "gpu/software/testdata/reference/pattern-v1.png";
let is *u8 as OPAQUE with imut = "gpu/software/testdata/reference/opaque-v1.png";

fn pack(r as i64, g as i64, b as i64, a as i64) as i64 { return r | (g << 8) | (b << 16) | (a << 24); }

fn draw_pattern(t as *tgt.Target) as void {
    let is i64 as y with mut = 0;
    while (y < t.height) {
        let is i64 as x with mut = 0;
        while (x < t.width) {
            let is i64 as a with mut = 255;
            if ((x + y) % 5 == 0) { a = 128; }
            tgt.put(t, x, y, pack(x * 32 + 7, y * 40 + 3, (x + y) * 16, a));
            x = x + 1;
        }
        y = y + 1;
    }
}

fn channel(t as *tgt.Target, x as i64, y as i64, shift as i64) as i64 { return (tgt.get(t, x, y) >> shift) & 255; }

// The file at path decodes to exactly frame's pixels.
fn same_pixels(path as *u8, frame as *tgt.Target) as i32 {
    let is buffer.Image as im with mut = load.file(path);
    if (cast(i64, im.pixels) == 0 || im.width != frame.width || im.height != frame.height ||
        im.format != buffer.RGBA8) {
        buffer.destroy(&im);
        return 0;
    }
    let is i32 as same with mut = 1;
    let is i64 as y with mut = 0;
    while (y < im.height) {
        let is i64 as x with mut = 0;
        while (x < im.width) {
            let is *u8 as p = buffer.pixel_at(&im, x, y);
            let is i64 as got = tgt.get(frame, x, y);
            if (cast(i64, p[0]) != (got & 255) || cast(i64, p[1]) != ((got >> 8) & 255) ||
                cast(i64, p[2]) != ((got >> 16) & 255) || cast(i64, p[3]) != ((got >> 24) & 255)) { same = 0; }
            x = x + 1;
        }
        y = y + 1;
    }
    buffer.destroy(&im);
    return same;
}

fn main() as i32 {
    io.mkdir("build");
    io.mkdir(DIR);
    io.unlink("build/reference-test/case.actual.png");
    io.unlink("build/reference-test/case.diff.png");

    let is [48]i32 as px;
    let is tgt.Target as frame = tgt.target(cast(*u8, &px), cast(*u8, 0), 8, 6);
    draw_pattern(&frame);

    // --- The same pixels: a match, and nothing left behind ---
    let is reference.Result as r with mut = reference.compare(&frame, PATTERN, reference.exact(), DIR, "case");
    check("an exact frame matches", r.status == reference.MATCH && r.differing == 0 &&
          r.first_x == 0 - 1 && r.first_y == 0 - 1 && r.artifacts == 0);
    check("the reference's own size reported", r.ref_width == 8 && r.ref_height == 6);
    check("alpha from the reference, not assumed", r.max_a == 0);
    check("no artifacts for a match", io.exists("build/reference-test/case.actual.png") == 0 &&
          io.exists("build/reference-test/case.diff.png") == 0);

    // --- One channel moved three steps ---
    tgt.put(&frame, 5, 2, pack(5 * 32 + 7 + 3, 2 * 40 + 3, 7 * 16, 255));
    r = reference.compare(&frame, PATTERN, reference.tolerance(2, 0, 0, 0), DIR, "case");
    check("outside its tolerance: differs", r.status == reference.PIXELS && r.differing == 1);
    check("which pixel, by how much", r.first_x == 5 && r.first_y == 2 && r.max_r == 3 && r.max_g == 0);
    check("its files written", r.artifacts == 1);
    check("the actual frame left as it is", same_pixels("build/reference-test/case.actual.png", &frame) == 1);
    let is buffer.Image as diff with mut = load.file("build/reference-test/case.diff.png");
    check("a difference image of the frame's size", cast(i64, diff.pixels) != 0 && diff.width == 8 && diff.height == 6);
    if (cast(i64, diff.pixels) != 0) {
        let is *u8 as hot = buffer.pixel_at(&diff, 5, 2);
        let is *u8 as cold = buffer.pixel_at(&diff, 4, 2);
        check("the differing pixel shown, amplified", cast(i64, hot[0]) == 12 && cast(i64, hot[1]) == 0);
        check("matching pixels black", cast(i64, cold[0]) == 0 && cast(i64, cold[1]) == 0 && cast(i64, cold[2]) == 0);
    }
    buffer.destroy(&diff);
    draw_pattern(&frame);
    tgt.put(&frame, 1, 3, pack(1 * 32 + 7 + 2, 3 * 40 + 3 + 2, 4 * 16, 255));
    tgt.put(&frame, 2, 3, pack(2 * 32 + 7 + 2, 3 * 40 + 3, 5 * 16 + 2, 128));
    r = reference.compare(&frame, PATTERN, reference.exact(), DIR, "case");
    let is buffer.Image as even with mut = load.file("build/reference-test/case.diff.png");
    if (cast(i64, even.pixels) != 0) {
        let is *u8 as e = buffer.pixel_at(&even, 1, 3);
        let is *u8 as f = buffer.pixel_at(&even, 2, 3);
        check("two channels moved alike: their difference, not magenta",
              cast(i64, e[0]) == 8 && cast(i64, e[1]) == 8 && cast(i64, e[2]) == 0 &&
              cast(i64, f[0]) == 8 && cast(i64, f[1]) == 0 && cast(i64, f[2]) == 8);
    } else {
        check("two-channel difference image written", 0);
    }
    buffer.destroy(&even);
    tgt.put(&frame, 5, 2, pack(5 * 32 + 7 + 3, 2 * 40 + 3, 7 * 16, 255));
    tgt.put(&frame, 1, 3, pack(1 * 32 + 7, 3 * 40 + 3, 4 * 16, 255));
    tgt.put(&frame, 2, 3, pack(2 * 32 + 7, 3 * 40 + 3, 5 * 16, 128));
    r = reference.compare(&frame, PATTERN, reference.tolerance(3, 0, 0, 0), DIR, "case");
    check("within its tolerance: a match", r.status == reference.MATCH && r.max_r == 3 && r.differing == 0);
    check("a later match removes the earlier failure's files",
          io.exists("build/reference-test/case.actual.png") == 0 && io.exists("build/reference-test/case.diff.png") == 0);

    // --- Alpha alone ---
    draw_pattern(&frame);
    tgt.put(&frame, 0, 0, pack(7, 3, 0, 200));
    r = reference.compare(&frame, PATTERN, reference.tolerance(255, 255, 255, 71), DIR, "case");
    check("alpha is a channel too", r.status == reference.PIXELS && r.max_a == 72 && r.first_x == 0 && r.first_y == 0);
    let is buffer.Image as alpha_diff with mut = load.file("build/reference-test/case.diff.png");
    if (cast(i64, alpha_diff.pixels) != 0) {
        let is *u8 as m = buffer.pixel_at(&alpha_diff, 0, 0);
        check("alpha alone shown magenta", cast(i64, m[0]) == 255 && cast(i64, m[1]) == 0 && cast(i64, m[2]) == 255);
    } else {
        check("alpha difference image written", 0);
    }
    buffer.destroy(&alpha_diff);
    r = reference.compare(&frame, PATTERN, reference.tolerance(0, 0, 0, 72), DIR, "case");
    check("alpha within its tolerance", r.status == reference.MATCH);

    // --- Another size ---
    draw_pattern(&frame);
    let is tgt.Target as short = tgt.target(cast(*u8, &px), cast(*u8, 0), 8, 5);
    r = reference.compare(&short, PATTERN, reference.exact(), DIR, "case");
    check("a different size, not pixels", r.status == reference.SIZE && r.ref_width == 8 && r.ref_height == 6 &&
          r.differing == 0);
    check("its actual frame kept, no difference image", same_pixels("build/reference-test/case.actual.png", &short) == 1 &&
          io.exists("build/reference-test/case.diff.png") == 0);
    let is tgt.Target as narrow = tgt.target(cast(*u8, &px), cast(*u8, 0), 6, 8);
    check("same pixel count, other shape", reference.compare(&narrow, PATTERN, reference.exact(), DIR, "case").status == reference.SIZE);

    // --- No reference ---
    r = reference.compare(&frame, "gpu/software/testdata/reference/absent.png", reference.exact(), DIR, "case");
    check("a missing reference", r.status == reference.NO_REFERENCE && r.ref_width == 0);
    check("its actual frame kept to be reviewed", same_pixels("build/reference-test/case.actual.png", &frame) == 1);
    r = reference.compare(&frame, "gpu/software/reference.cst", reference.exact(), DIR, "case");
    check("not an image: no reference", r.status == reference.NO_REFERENCE);
    r = reference.compare(&frame, PATTERN, reference.exact(), cast(*u8, 0), "case");
    check("no artifact directory: compared all the same", r.status == reference.MATCH);

    // --- An opaque reference without alpha ---
    let is [20]i32 as op;
    let is tgt.Target as opaque = tgt.target(cast(*u8, &op), cast(*u8, 0), 5, 4);
    let is i64 as y with mut = 0;
    while (y < 4) {
        let is i64 as x with mut = 0;
        while (x < 5) {
            tgt.put(&opaque, x, y, pack(200 - x * 30, 50 + y * 50, 90 + x * y, 255));
            x = x + 1;
        }
        y = y + 1;
    }
    r = reference.compare(&opaque, OPAQUE, reference.exact(), DIR, "opaque");
    check("RGB reference: opaque frame matches", r.status == reference.MATCH);
    tgt.put(&opaque, 4, 3, pack(200 - 120, 200, 102, 254));
    r = reference.compare(&opaque, OPAQUE, reference.exact(), DIR, "opaque");
    check("RGB reference: alpha checked against 255", r.status == reference.PIXELS && r.max_a == 1 &&
          r.first_x == 4 && r.first_y == 3);
    check("first channel decoded in order", channel(&opaque, 4, 3, 0) == 80);

    // --- A gray reference without alpha ---
    let is [6]i32 as gp;
    let is tgt.Target as gray = tgt.target(cast(*u8, &gp), cast(*u8, 0), 3, 2);
    y = 0;
    while (y < 2) {
        let is i64 as x with mut = 0;
        while (x < 3) {
            let is i64 as v = 40 + 70 * x + 30 * y;
            tgt.put(&gray, x, y, pack(v, v, v, 255));
            x = x + 1;
        }
        y = y + 1;
    }
    check("gray reference: gray on every channel, opaque",
          reference.compare(&gray, "gpu/software/testdata/reference/gray-v1.png", reference.exact(), DIR, "gray").status == reference.MATCH);
    tgt.put(&gray, 2, 1, pack(210, 210, 210, 250));
    r = reference.compare(&gray, "gpu/software/testdata/reference/gray-v1.png", reference.exact(), DIR, "gray");
    check("gray reference: alpha 255 and each channel compared", r.status == reference.PIXELS && r.max_a == 5 &&
          r.max_r == 0 && r.first_x == 2 && r.first_y == 1);
    io.unlink("build/reference-test/gray.actual.png");
    io.unlink("build/reference-test/gray.diff.png");

    // --- A name too long for a path: compared, nothing written ---
    let is [1100]u8 as long_name;
    let is i64 as k with mut = 0;
    while (k < 1099) { long_name[k] = cast(u8, 120); k = k + 1; }
    long_name[1099] = cast(u8, 0);
    r = reference.compare(&gray, "gpu/software/testdata/reference/gray-v1.png", reference.exact(), DIR, cast(*u8, &long_name));
    check("a name too long: compared all the same", r.status == reference.PIXELS && r.differing == 1);
    check("a name too long: no files", r.artifacts == 0);
    io.unlink("build/reference-test/opaque.actual.png");
    io.unlink("build/reference-test/opaque.diff.png");
    io.unlink("build/reference-test/case.actual.png");

    if (fails == 0) {
        io.printf("software reference: all checks passed\n");
        return 0;
    }
    io.printf("software reference: %d failures\n", fails);
    return 1;
}
