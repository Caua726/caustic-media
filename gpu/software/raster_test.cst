// gpu/software/raster_test.cst — the rasterizer's invariants.
//
// Rendering is hard to assert on pixel by pixel, so these check the properties
// that distinguish a correct rasterizer from one that merely produces an
// image: coverage adds up to the triangle's area, a shared edge is drawn
// exactly once, the depth buffer keeps the nearer surface whichever order the
// two arrive in, and an attribute interpolated across a perspective view
// tracks the surface rather than the screen.
//
// Exit code is the number of failures.
use "std/io.cst" as io;
use "std/math.cst" as fm;
use "../../math/math.cst" as math;
use "software.cst" as soft;

let is i32 as fails with mut = 0;

// 64x64 is enough for every property below and keeps the buffers static, so
// the test allocates nothing either.
let is i32 as W with imut = 64;
let is i32 as H with imut = 64;
let is [16384]u8 as pixels;   // 64*64*4
let is [32768]u8 as depth;    // 64*64*8

fn chk(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("  FAIL %s\n", name); }
}

fn chk_i(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

fn make_target() as soft.target.Target {
    return soft.target.target(cast(*u8, &pixels), cast(*u8, &depth),
                              cast(i64, W), cast(i64, H));
}

// Pixels differing from the clear colour.
fn count_drawn(t as *soft.target.Target, clear_packed as i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as y with mut = 0;
    while (y < t.height) {
        let is i64 as x with mut = 0;
        while (x < t.width) {
            if (soft.target.get(t, x, y) != clear_packed) { n = n + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

// A vertex in screen coordinates, drawn through an orthographic matrix that
// maps the target's pixel grid onto clip space one to one.
fn screen_vertex(x as f64, y as f64, c as math.color.Color) as soft.raster.Vertex {
    return soft.raster.vertex(math.vec.v3(x, y, 0.0), c);
}

// Maps (0..W, 0..H, -1..1) onto the clip cube, with Y already pointing down so
// it survives the rasterizer's flip.
fn screen_matrix() as math.mat.Mat4 {
    return math.mat.m4_ortho(0.0, cast(f64, W), cast(f64, H), 0.0, -1.0, 1.0);
}

fn test_coverage() as void {
    let is soft.target.Target as t = make_target();
    let is i64 as bg = math.color.pack_rgba8(math.color.black());
    soft.target.clear(&t, math.color.black());

    // A right triangle over half a 40x40 square: 800 pixels, give or take the
    // boundary. Coverage that is wildly off means the edge test or the
    // bounding box is wrong.
    let is math.mat.Mat4 as m = screen_matrix();
    soft.raster.triangle(&t, m,
        screen_vertex(10.0, 10.0, math.color.white()),
        screen_vertex(50.0, 10.0, math.color.white()),
        screen_vertex(10.0, 50.0, math.color.white()),
        soft.raster.CULL_NONE);

    let is i64 as drawn = count_drawn(&t, bg);
    chk("coverage near half the square", cast(i32, drawn > 700 && drawn < 900));

    // Nothing outside the triangle's bounding box may be touched.
    chk("outside box untouched", cast(i32, soft.target.get(&t, 60, 60) == bg));
    chk("inside filled", cast(i32, soft.target.get(&t, 15, 15) != bg));
    // The far corner of the box is outside the hypotenuse.
    chk("beyond hypotenuse empty", cast(i32, soft.target.get(&t, 45, 45) == bg));
}

fn test_fill_rule() as void {
    let is soft.target.Target as t = make_target();
    let is i64 as bg = math.color.pack_rgba8(math.color.black());
    soft.target.clear(&t, math.color.black());
    let is math.mat.Mat4 as m = screen_matrix();

    // Two triangles tiling a 40x40 square along a shared diagonal. Under a
    // correct fill rule the pair covers exactly 1600 pixels: every pixel of
    // the square once, none of the diagonal twice, and no gap along it.
    soft.raster.triangle(&t, m,
        screen_vertex(10.0, 10.0, math.color.white()),
        screen_vertex(50.0, 10.0, math.color.white()),
        screen_vertex(10.0, 50.0, math.color.white()),
        soft.raster.CULL_NONE);
    soft.raster.triangle(&t, m,
        screen_vertex(50.0, 10.0, math.color.white()),
        screen_vertex(50.0, 50.0, math.color.white()),
        screen_vertex(10.0, 50.0, math.color.white()),
        soft.raster.CULL_NONE);

    chk_i("two triangles tile the square exactly", count_drawn(&t, bg), 1600);
}

// A rectangle as two triangles, wound one way or the other.
fn rect(t as *soft.target.Target, x0 as f64, y0 as f64, x1 as f64, y1 as f64, reverse as i32) as void {
    let is math.mat.Mat4 as m = screen_matrix();
    let is soft.raster.Vertex as a = screen_vertex(x0, y0, math.color.white());
    let is soft.raster.Vertex as b = screen_vertex(x1, y0, math.color.white());
    let is soft.raster.Vertex as c = screen_vertex(x1, y1, math.color.white());
    let is soft.raster.Vertex as d = screen_vertex(x0, y1, math.color.white());
    if (reverse == 0) {
        soft.raster.triangle(t, m, a, b, c, soft.raster.CULL_NONE);
        soft.raster.triangle(t, m, a, c, d, soft.raster.CULL_NONE);
    } else {
        soft.raster.triangle(t, m, c, b, a, soft.raster.CULL_NONE);
        soft.raster.triangle(t, m, d, c, a, soft.raster.CULL_NONE);
    }
}

// Pixels the two rectangles draw: each alone, then both.
fn seam(x0 as f64, y0 as f64, x1 as f64, y1 as f64, x2 as f64, y2 as f64, x3 as f64, y3 as f64,
        first as i32, alone as *i64) as i64 {
    let is soft.target.Target as t = make_target();
    let is i64 as bg = math.color.pack_rgba8(math.color.black());
    soft.target.clear(&t, math.color.black());
    rect(&t, x0, y0, x1, y1, first);
    let is i64 as n = count_drawn(&t, bg);
    soft.target.clear(&t, math.color.black());
    rect(&t, x2, y2, x3, y3, 1 - first);
    *alone = n + count_drawn(&t, bg);
    soft.target.clear(&t, math.color.black());
    rect(&t, x0, y0, x1, y1, first);
    rect(&t, x2, y2, x3, y3, 1 - first);
    return count_drawn(&t, bg);
}

// Which pixels on an edge a triangle owns does not hang on its winding: two
// triangles wound opposite ways meeting on a line of pixel centres — a fill
// and the fringe around it — draw each pixel of it once, neither twice nor
// not at all.
fn test_fill_rule_windings() as void {
    let is i64 as alone with mut = 0;
    let is i32 as first with mut = 0;
    while (first < 2) {
        // Meeting across: rows of centres on y = 20.5.
        let is i64 as both with mut = seam(10.0, 10.5, 50.0, 20.5, 10.0, 20.5, 50.0, 30.5, first, &alone);
        chk_i("windings meeting across: every pixel", both, 800);
        chk_i("windings meeting across: none twice", alone, 800);
        // Meeting down: columns of centres on x = 30.5.
        both = seam(10.5, 10.0, 30.5, 30.0, 30.5, 10.0, 50.5, 30.0, first, &alone);
        chk_i("windings meeting down: every pixel", both, 800);
        chk_i("windings meeting down: none twice", alone, 800);
        first = first + 1;
    }
}

fn test_depth() as void {
    let is math.mat.Mat4 as m = screen_matrix();
    let is math.color.Color as red  = math.color.red();
    let is math.color.Color as blue = math.color.blue();

    // Same footprint, different depths. Whichever order they are submitted in,
    // the nearer one has to survive — that is the whole point of the buffer.
    //
    // The sign is worth stating: this orthographic matrix has near = -1 and
    // far = +1, so it maps view z to -z in normalized device coordinates. The
    // vertex with the LARGER z is therefore the nearer one.
    let is i64 as i with mut = 0;
    while (i < 2) {
        let is soft.target.Target as t = make_target();
        soft.target.clear(&t, math.color.black());
        let is f64 as near_z = 0.5;
        let is f64 as far_z  = -0.5;
        let is math.color.Color as first with mut = red;
        let is math.color.Color as second with mut = blue;
        let is f64 as z1 with mut = near_z;
        let is f64 as z2 with mut = far_z;
        if (i == 1) { z1 = far_z; z2 = near_z; first = blue; second = red; }

        soft.raster.triangle(&t, m,
            soft.raster.vertex(math.vec.v3(10.0, 10.0, z1), first),
            soft.raster.vertex(math.vec.v3(50.0, 10.0, z1), first),
            soft.raster.vertex(math.vec.v3(10.0, 50.0, z1), first),
            soft.raster.CULL_NONE);
        soft.raster.triangle(&t, m,
            soft.raster.vertex(math.vec.v3(10.0, 10.0, z2), second),
            soft.raster.vertex(math.vec.v3(50.0, 10.0, z2), second),
            soft.raster.vertex(math.vec.v3(10.0, 50.0, z2), second),
            soft.raster.CULL_NONE);

        // Red is at the near depth in both passes, so red must win both times.
        chk("nearer surface wins regardless of order",
            cast(i32, soft.target.get(&t, 15, 15) == math.color.pack_rgba8(red)));
        i = i + 1;
    }
}

fn test_culling() as void {
    let is soft.target.Target as t = make_target();
    let is i64 as bg = math.color.pack_rgba8(math.color.black());
    let is math.mat.Mat4 as m = screen_matrix();

    // The same three points in both windings. Back-face culling has to accept
    // one and reject the other — and reversing the winding must flip which.
    soft.target.clear(&t, math.color.black());
    soft.raster.triangle(&t, m,
        screen_vertex(10.0, 10.0, math.color.white()),
        screen_vertex(50.0, 10.0, math.color.white()),
        screen_vertex(10.0, 50.0, math.color.white()),
        soft.raster.CULL_BACK);
    let is i64 as cw_screen = count_drawn(&t, bg);

    soft.target.clear(&t, math.color.black());
    soft.raster.triangle(&t, m,
        screen_vertex(10.0, 10.0, math.color.white()),
        screen_vertex(10.0, 50.0, math.color.white()),
        screen_vertex(50.0, 10.0, math.color.white()),
        soft.raster.CULL_BACK);
    let is i64 as ccw_screen = count_drawn(&t, bg);

    chk("one winding survives back-face culling", cast(i32, (cw_screen > 0) != (ccw_screen > 0)));
    chk("culling is not dropping everything", cast(i32, cw_screen + ccw_screen > 0));

    // WHICH one survives, not merely that one does.
    //
    // The two assertions above pass whichever way round the comparison is, and
    // that is exactly how an inverted facing test survived here: project()
    // flips Y so framebuffer rows run downward, which reverses the sign of the
    // screen-space area, and the culling comparison did not account for it.
    // Every closed mesh was then culled inside-out — examples/cube.cst
    // included, for as long as it has existed. It still looked like a cube,
    // because a cube seen from inside has the same silhouette as one seen from
    // outside.
    //
    // Naming these needs care, and getting it wrong was the first attempt.
    // These points go through screen_matrix(), so they are already in
    // framebuffer coordinates with Y running DOWN. The shoelace sign therefore
    // means the opposite of what it means in the usual Y-up convention:
    //
    //     (10,10) -> (50,10) -> (10,50)   area = +1600, CLOCKWISE on screen
    //     (10,10) -> (10,50) -> (50,10)   area = -1600, counter-clockwise
    //
    // Counter-clockwise on screen is the front face, which is the ordinary
    // convention and what a front-facing triangle in a right-handed world
    // becomes after the flip. So the second one has to survive.
    chk("the clockwise-on-screen one is culled as back-facing", cast(i32, cw_screen == 0));
    chk("the counter-clockwise one survives", cast(i32, ccw_screen > 0));
}

// The shaded path — the one gpu/ actually runs — has its own copy of the same
// comparison and had the same inversion. It is covered end to end by
// examples/vkcube.cst --check, which draws each face of a cube on its own with
// the camera square in front of it; that is what found this in the first place.

fn test_near_plane() as void {
    let is soft.target.Target as t = make_target();
    let is i64 as bg = math.color.pack_rgba8(math.color.black());
    soft.target.clear(&t, math.color.black());

    // A triangle straddling the eye. Without the w <= 0 guard the divide
    // throws vertices to infinity with the wrong sign and the result is
    // garbage smeared over the target; rejecting it leaves the frame clean.
    let is math.mat.Mat4 as proj = math.mat.m4_perspective(fm.PI_2, 1.0, 1.0, 100.0);
    soft.raster.triangle(&t, proj,
        soft.raster.vertex(math.vec.v3(0.0, 0.0, -5.0), math.color.white()),
        soft.raster.vertex(math.vec.v3(1.0, 0.0,  5.0), math.color.white()),
        soft.raster.vertex(math.vec.v3(0.0, 1.0, -5.0), math.color.white()),
        soft.raster.CULL_NONE);
    chk_i("triangle crossing the eye is rejected", count_drawn(&t, bg), 0);
}

fn test_perspective_correction() as void {
    let is soft.target.Target as t = make_target();
    soft.target.clear(&t, math.color.black());

    // A floor receding from the camera, red at the near edge and blue at the
    // far one, spanning distance 1 to 40.
    //
    // Perspective crushes the far half into a thin band near the horizon, so
    // most of the screen shows the near part: the vertical middle of the drawn
    // band corresponds to distance ~1.95, only about 2% along the surface, and
    // the colour there is almost pure red.
    //
    // Interpolating the colour by the screen-space weight instead — the bug
    // this catches — would put the surface midpoint at the screen midpoint and
    // read an even red/blue mix. Demanding red near 1 and blue near 0 is a
    // result linear interpolation cannot produce by accident.
    let is math.mat.Mat4 as proj = math.mat.m4_perspective(fm.PI_2, 1.0, 0.5, 100.0);
    let is math.color.Color as red  = math.color.rgb(1.0, 0.0, 0.0);
    let is math.color.Color as blue = math.color.rgb(0.0, 0.0, 1.0);

    // Two triangles forming a floor stretching away below the eye line.
    let is math.vec.Vec3 as nl = math.vec.v3(-2.0, -1.0, -1.0);
    let is math.vec.Vec3 as nr = math.vec.v3( 2.0, -1.0, -1.0);
    let is math.vec.Vec3 as fl = math.vec.v3(-2.0, -1.0, -40.0);
    let is math.vec.Vec3 as fr = math.vec.v3( 2.0, -1.0, -40.0);

    soft.raster.triangle(&t, proj,
        soft.raster.vertex(nl, red), soft.raster.vertex(nr, red),
        soft.raster.vertex(fl, blue), soft.raster.CULL_NONE);
    soft.raster.triangle(&t, proj,
        soft.raster.vertex(nr, red), soft.raster.vertex(fr, blue),
        soft.raster.vertex(fl, blue), soft.raster.CULL_NONE);

    // Scan the centre column for the vertical midpoint of the drawn floor and
    // read the colour there.
    let is i64 as bg = math.color.pack_rgba8(math.color.black());
    let is i64 as top with mut = 0 - 1;
    let is i64 as bot with mut = 0 - 1;
    let is i64 as y with mut = 0;
    while (y < t.height) {
        if (soft.target.get(&t, 32, y) != bg) {
            if (top < 0) { top = y; }
            bot = y;
        }
        y = y + 1;
    }
    chk("floor was drawn", cast(i32, top >= 0 && bot > top));
    if (top < 0 || bot <= top) { return; }

    let is math.color.Color as mid = math.color.unpack_rgba8(
        soft.target.get(&t, 32, (top + bot) / 2));
    chk("screen midpoint sits near the start of the surface",
        cast(i32, mid.r > 0.85 && mid.b < 0.15));
    // The far edge of the band is the far edge of the floor, and is blue.
    let is math.color.Color as far_end = math.color.unpack_rgba8(
        soft.target.get(&t, 32, top));
    chk("far edge is the far colour", cast(i32, far_end.b > far_end.r));
}

fn test_primitives() as void {
    let is soft.target.Target as t = make_target();
    let is i64 as bg = math.color.pack_rgba8(math.color.black());
    soft.target.clear(&t, math.color.black());

    soft.target.fill_rect(&t, math.rect.rect(8.0, 8.0, 16.0, 4.0), math.color.white());
    chk_i("fill_rect covers its area", count_drawn(&t, bg), 64);

    soft.target.clear(&t, math.color.black());
    soft.target.line(&t, 0, 0, 31, 0, math.color.white());
    chk_i("horizontal line length", count_drawn(&t, bg), 32);

    // Off-target coordinates must be clipped, not written out of bounds.
    soft.target.clear(&t, math.color.black());
    soft.target.line(&t, -50, 5, 200, 5, math.color.white());
    chk_i("line clipped to width", count_drawn(&t, bg), cast(i64, W));

    soft.target.clear(&t, math.color.black());
    soft.target.put_safe(&t, 1000, 1000, math.color.white());
    chk_i("out-of-range point ignored", count_drawn(&t, bg), 0);
}

// Vertices land on a grid of 1/256 of a pixel after projection, as on GPUs.
// Without it, a point exactly on a pixel centre reaches the rasterizer as
// 23.4999999 or 23.5000001 depending on the target's width, and the top-left
// rule gives that pixel to different triangles in two targets — a layer
// painted into a texture and put back would differ from painting directly.
fn test_subpixel() as void {
    // The x an orthographic projection gives 23.5 on a 28-wide target.
    let is f64 as ndc = 2.0 * 23.5 / 28.0 - 1.0;
    let is math.vec.Vec4 as clip = math.vec.v4(ndc, 0.0, 0.0, 1.0);
    let is soft.raster.Projected as p = soft.raster.project_viewport(clip, 0.0, 0.0, 28.0, 10.0);
    chk("subpixel: a centre stays a centre", p.x == 23.5);
    let is math.vec.Vec4 as off = math.vec.v4(2.0 * 10.3 / 28.0 - 1.0, 0.0, 0.0, 1.0);
    let is soft.raster.Projected as q = soft.raster.project_viewport(off, 0.0, 0.0, 28.0, 10.0);
    chk("subpixel: on the 1/256 grid", q.x * 256.0 == fm.floor(q.x * 256.0));
    chk("subpixel: the nearest point of it", q.x > 10.298 && q.x < 10.302);
}

// --- Blending, against dividing by 255 ---

fn ch(p as i64, k as i64) as i64 { return (p >> (k * 8)) & 255; }

fn ref_over(src as i64, dst as i64) as i64 {
    let is i64 as sa = ch(src, 3);
    if (sa == 255) { return src; }
    if (sa == 0) { return dst; }
    let is i64 as ia = 255 - sa;
    let is i64 as a with mut = sa + ch(dst, 3) * ia / 255;
    if (a > 255) { a = 255; }
    return (a << 24) | (((ch(src, 2) * sa + ch(dst, 2) * ia) / 255) << 16) |
           (((ch(src, 1) * sa + ch(dst, 1) * ia) / 255) << 8) | ((ch(src, 0) * sa + ch(dst, 0) * ia) / 255);
}

fn ref_premul(src as i64, dst as i64) as i64 {
    let is i64 as sa = ch(src, 3);
    if (sa == 255) { return src; }
    let is i64 as ia = 255 - sa;
    let is [4]i64 as o;
    let is i64 as k with mut = 0;
    while (k < 4) {
        let is i64 as v with mut = ch(src, k) + ch(dst, k) * ia / 255;
        if (k == 3) { v = sa + ch(dst, 3) * ia / 255; }
        if (v > 255) { v = 255; }
        o[k] = v;
        k = k + 1;
    }
    return (o[3] << 24) | (o[2] << 16) | (o[1] << 8) | o[0];
}

fn test_blends() as void {
    let is [8]i64 as vals;
    vals[0] = 0; vals[1] = 1; vals[2] = 2; vals[3] = 127; vals[4] = 128; vals[5] = 200; vals[6] = 254; vals[7] = 255;
    let is i64 as bad_over with mut = 0;
    let is i64 as bad_premul with mut = 0;
    let is i64 as sa with mut = 0;
    while (sa < 256) {
        let is i64 as i with mut = 0;
        while (i < 8) {
            let is i64 as j with mut = 0;
            while (j < 8) {
                // Each channel its own value, so a channel taken for another shows.
                let is i64 as src = (sa << 24) | (vals[(i + 1) % 8] << 16) | (vals[(i + 2) % 8] << 8) | vals[i];
                let is i64 as dst = (vals[(j + 3) % 8] << 24) | (vals[(j + 5) % 8] << 16) | (vals[(j + 6) % 8] << 8) | vals[j];
                if (soft.raster._blend_over(src, dst) != ref_over(src, dst)) { bad_over = bad_over + 1; }
                if (soft.raster._blend_premul(src, dst) != ref_premul(src, dst)) { bad_premul = bad_premul + 1; }
                j = j + 1;
            }
            i = i + 1;
        }
        sa = sa + 1;
    }
    chk_i("blend over: as dividing by 255", bad_over, 0);
    chk_i("premultiplied: as dividing by 255", bad_premul, 0);
}

// --- The general path's colours, interpolated ---

fn frag_color(env as *u8, vary as *soft.raster.Varyings) as i64 { return math.color.pack_rgba8(vary.color); }

// Independent live shader values exceed the XMM pool before reduction.
let is [20]f64 as pressure_values;
fn frag_pressure(env as *u8, vary as *soft.raster.Varyings) as i64 {
    let is *f64 as p = cast(*f64, env);
    let is f64 as a0 = p[0] + vary.u;
    let is f64 as a1 = p[1] + vary.u;
    let is f64 as a2 = p[2] + vary.u;
    let is f64 as a3 = p[3] + vary.u;
    let is f64 as a4 = p[4] + vary.u;
    let is f64 as a5 = p[5] + vary.u;
    let is f64 as a6 = p[6] + vary.u;
    let is f64 as a7 = p[7] + vary.u;
    let is f64 as a8 = p[8] + vary.u;
    let is f64 as a9 = p[9] + vary.u;
    let is f64 as a10 = p[10] + vary.u;
    let is f64 as a11 = p[11] + vary.u;
    let is f64 as a12 = p[12] + vary.u;
    let is f64 as a13 = p[13] + vary.u;
    let is f64 as a14 = p[14] + vary.u;
    let is f64 as a15 = p[15] + vary.u;
    let is f64 as a16 = p[16] + vary.u;
    let is f64 as a17 = p[17] + vary.u;
    let is f64 as a18 = p[18] + vary.u;
    let is f64 as a19 = p[19] + vary.u;
    let is f64 as red = a0 - a1 - a2 - a3 - a4 - a5 - a6 - a7 - a8 - a9 -
                       a10 - a11 - a12 - a13 - a14 - a15 - a16 - a17 - a18 - a19;
    return math.color.pack_rgba8(math.color.rgba(red, vary.color.g, vary.color.b, 1.0));
}

fn shaded(x as f64, y as f64, c as math.color.Color) as soft.raster.Shaded {
    let is soft.raster.Shaded as s;
    s.clip = math.vec.v4(x / cast(f64, W) * 2.0 - 1.0, 1.0 - y / cast(f64, H) * 2.0, 0.0, 1.0);
    s.vary.color = c;
    s.vary.u = 0.0;
    s.vary.v = 0.0;
    return s;
}

fn test_shaded_colors() as void {
    let is soft.target.Target as t = soft.target.target(cast(*u8, &pixels), cast(*u8, 0), cast(i64, W), cast(i64, H));
    soft.target.clear_color(&t, math.color.black());
    let is soft.raster.ShadeState as st;
    st.vx = 0; st.vy = 0; st.vw = cast(i64, W); st.vh = cast(i64, H);
    st.sx0 = 0; st.sy0 = 0; st.sx1 = cast(i64, W); st.sy1 = cast(i64, H);
    st.cull = soft.raster.CULL_NONE;
    st.depth_test = soft.raster.DEPTH_NONE;
    st.depth_write = 0;
    st.blend = soft.raster.BLEND_NONE;
    st.frag = cast(*u8, fn_ptr(frag_color));
    st.env = cast(*u8, 0);
    st.unlit = 0;
    // Every channel of every corner its own, none of them 0.
    soft.raster.triangle_shaded(&t, shaded(2.0, 2.0, math.color.rgba(1.0, 0.2, 0.3, 1.0)),
                                shaded(32.0, 62.0, math.color.rgba(0.3, 0.4, 1.0, 1.0)),
                                shaded(62.0, 2.0, math.color.rgba(0.25, 1.0, 0.5, 1.0)), &st);
    chk("by each corner, its colour", near(soft.target.get(&t, 4, 3), 255, 51, 77) == 1 &&
        near(soft.target.get(&t, 59, 3), 64, 255, 128) == 1 && near(soft.target.get(&t, 32, 59), 77, 102, 255) == 1);
    chk("between two, both halves", near(soft.target.get(&t, 32, 3), 160, 153, 102) == 1);
}

fn test_shaded_pressure() as void {
    pressure_values[0] = 20.0;
    let is i64 as i with mut = 1;
    while (i < 20) { pressure_values[i] = 1.0; i = i + 1; }
    let is soft.target.Target as t = make_target();
    soft.target.clear_color(&t, math.color.black());
    let is soft.raster.ShadeState as st;
    st.vx = 0; st.vy = 0; st.vw = cast(i64, W); st.vh = cast(i64, H);
    st.sx0 = 0; st.sy0 = 0; st.sx1 = cast(i64, W); st.sy1 = cast(i64, H);
    st.cull = soft.raster.CULL_NONE; st.depth_test = soft.raster.DEPTH_NONE;
    st.depth_write = 0; st.blend = soft.raster.BLEND_NONE;
    st.frag = cast(*u8, fn_ptr(frag_pressure)); st.env = cast(*u8, &pressure_values); st.unlit = 0;
    let is soft.raster.Shaded as a = shaded(0.0, 0.0, math.color.red());
    let is soft.raster.Shaded as b = shaded(cast(f64, W), 0.0, math.color.red());
    let is soft.raster.Shaded as c = shaded(cast(f64, W), cast(f64, H), math.color.red());
    let is soft.raster.Shaded as d = shaded(0.0, cast(f64, H), math.color.red());
    soft.raster.triangle_shaded(&t, a, b, c, &st);
    soft.raster.triangle_shaded(&t, a, c, d, &st);
    let is i64 as bad with mut = 0;
    i = 0;
    while (i < cast(i64, W) * cast(i64, H)) {
        if (cast(*u32, &pixels)[i] != cast(u32, 0xff0000ff)) { bad = bad + 1; }
        i = i + 1;
    }
    chk_i("all pressure-shaded pixels preserve independent live operands", bad, 0);
}

// Whether packed p is r, g, b give or take a little, and opaque.
fn near(p as i64, r as i64, g as i64, b as i64) as i32 {
    let is i64 as dr = ch(p, 0) - r;
    let is i64 as dg = ch(p, 1) - g;
    let is i64 as db = ch(p, 2) - b;
    return cast(i32, dr * dr < 144 && dg * dg < 144 && db * db < 144 && ch(p, 3) == 255);
}

fn main() as i32 {
    test_blends();
    test_shaded_colors();
    test_shaded_pressure();
    test_subpixel();
    test_coverage();
    test_fill_rule();
    test_fill_rule_windings();
    test_depth();
    test_culling();
    test_near_plane();
    test_perspective_correction();
    test_primitives();
    if (fails == 0) { io.printf("software renderer: all checks passed\n"); }
    else { io.printf("  raster_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
