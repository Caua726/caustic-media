// gpu/software/software.cst — hub for the software renderer.
//
//   use "caustic-media/gpu/software/software.cst" as soft;
//
//   let is soft.target.Target as t = soft.target.target(pixels, depth, w, h);
//   soft.target.clear(&t, math.color.black());
//   soft.raster.triangle(&t, mvp, va, vb, vc, soft.raster.CULL_BACK);
//
// Depends on the math layer and on nothing else. It allocates nothing: a
// Target is a view over memory the caller owns, so the same code fills a heap
// block, a static array, or a framebuffer mapped from a display device.
// backend/ is the same code wearing the device's shape: buffers, pipelines,
// command submission. Reach for it through gpu.open(SOFTWARE) rather than
// directly — this hub exists for programs that want the rasterizer bare.
use "target.cst" as target;
use "raster.cst" as raster;
