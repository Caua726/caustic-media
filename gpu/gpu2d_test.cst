// gpu/gpu2d_test.cst — what drawing in two dimensions needs from the device:
// a scissor, a coverage material for glyphs, and partial texture updates.
use "std/io.cst" as io;
use "../math/math.cst" as math;
use "gpu.cst" as gpu;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL: %s: got %x, want %x\n", name, cast(i32, got), cast(i32, want));
        fails = fails + 1;
    }
}

let is i64 as W with imut = 16;
let is i64 as H with imut = 16;

// pos (F64X3), color (F64X4), uv (F64X2): layout_pos_color_uv.
struct Vtx {
    x as f64; y as f64; z as f64;
    r as f64; g as f64; b as f64; a as f64;
    u as f64; v as f64;
}

fn vtx(x as f64, y as f64, c as math.color.Color, u as f64, v as f64) as Vtx {
    let is Vtx as o;
    o.x = x; o.y = y; o.z = 0.0;
    o.r = c.r; o.g = c.g; o.b = c.b; o.a = c.a;
    o.u = u; o.v = v;
    return o;
}

// Two triangles covering clip space -1..1, which is the whole target when no
// uniforms are set. uv runs 0..1 left to right, top to bottom.
fn quad(out as *Vtx, c as math.color.Color) as void {
    out[0] = vtx(0.0 - 1.0, 1.0, c, 0.0, 0.0);
    out[1] = vtx(0.0 - 1.0, 0.0 - 1.0, c, 0.0, 1.0);
    out[2] = vtx(1.0, 0.0 - 1.0, c, 1.0, 1.0);
    out[3] = vtx(0.0 - 1.0, 1.0, c, 0.0, 0.0);
    out[4] = vtx(1.0, 0.0 - 1.0, c, 1.0, 1.0);
    out[5] = vtx(1.0, 1.0, c, 1.0, 0.0);
}

let is [256]i32 as px with mut;

fn pixel(x as i64, y as i64) as i64 {
    return cast(i64, px[y * W + x]) & 4294967295;
}

// --- A region moved within a texture ---

let is [256]i32 as was with mut;
let is [256]i32 as want with mut;
let is [256]i32 as got with mut;

// Texel i holding a value of its own in each of its four bytes, none 0:
// a byte copied from the wrong place, or not copied, shows.
fn numbered(d as *gpu.device.Device, tex as i64) as void {
    let is i64 as i with mut = 0;
    while (i < 256) {
        let is i64 as b0 = (i * 7 + 1) % 251 + 1;
        let is i64 as b1 = (i * 13 + 2) % 249 + 3;
        let is i64 as b2 = (i * 29 + 5) % 247 + 5;
        let is i64 as b3 = (i * 31 + 11) % 241 + 7;
        was[i] = cast(i32, (b3 << 24) | (b2 << 16) | (b1 << 8) | b0);
        i = i + 1;
    }
    gpu.texture.upload(d, tex, cast(*u8, &was), 1024);
}

// What moving x, y, w by h by dx, dy should leave: each texel of the
// rectangle, inside the texture, copied to where it lands inside it, from
// what was there before; everything else as it was.
fn expect_moved(x as i64, y as i64, w as i64, h as i64, dx as i64, dy as i64) as void {
    let is i64 as i with mut = 0;
    while (i < 256) {
        want[i] = was[i];
        i = i + 1;
    }
    let is i64 as yy with mut = y;
    while (yy < y + h) {
        let is i64 as xx with mut = x;
        while (xx < x + w) {
            let is i64 as tx = xx + dx;
            let is i64 as ty = yy + dy;
            if (xx >= 0 && yy >= 0 && xx < W && yy < H && tx >= 0 && ty >= 0 && tx < W && ty < H) {
                want[ty * W + tx] = was[yy * W + xx];
            }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}

fn moved_right(d as *gpu.device.Device, cmd as i64, tex as i64, x as i64, y as i64, w as i64, h as i64,
               dx as i64, dy as i64) as i32 {
    numbered(d, tex);
    gpu.command.begin(d, cmd);
    gpu.command.move_region(d, cmd, tex, x, y, w, h, dx, dy);
    gpu.command.end(d, cmd);
    gpu.command.submit(d, cmd);
    gpu.texture.read(d, tex, cast(*u8, &got), 1024);
    expect_moved(x, y, w, h, dx, dy);
    let is i64 as i with mut = 0;
    while (i < 256) {
        if (got[i] != want[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn moves(d as *gpu.device.Device) as void {
    let is gpu.texture.Desc as td = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    let is i64 as tex = gpu.texture.create(d, &td);
    let is i64 as cmd = gpu.command.create(d);
    check("moved down and right, apart from where it was", moved_right(d, cmd, tex, 1, 1, 4, 3, 6, 8) == 1);
    check("moved down onto itself", moved_right(d, cmd, tex, 2, 2, 10, 9, 0, 3) == 1);
    check("moved up onto itself", moved_right(d, cmd, tex, 2, 4, 10, 9, 0, 0 - 3) == 1);
    check("moved right onto itself", moved_right(d, cmd, tex, 1, 2, 9, 5, 5, 0) == 1);
    check("moved left and up onto itself", moved_right(d, cmd, tex, 4, 5, 9, 7, 0 - 3, 0 - 1) == 1);
    check("a texel across: the odd one", moved_right(d, cmd, tex, 3, 3, 1, 5, 1, 1) == 1);
    check("hanging off the texture: the part inside", moved_right(d, cmd, tex, 0 - 3, 10, 9, 9, 5, 0 - 4) == 1);
    check("landing off it: what lands inside", moved_right(d, cmd, tex, 8, 8, 8, 8, 4, 5) == 1);
    check("not moved at all", moved_right(d, cmd, tex, 2, 2, 5, 5, 0, 0) == 1);
    check("empty", moved_right(d, cmd, tex, 2, 2, 0, 5, 3, 3) == 1);
    gpu.command.destroy(d, cmd);
    gpu.texture.destroy(d, tex);
}

fn main() as i32 {
    let is gpu.device.Device as d = gpu.open_headless(W, H, gpu.SOFTWARE);
    let is gpu.texture.Desc as ctd = gpu.texture.desc(W, H, gpu.texture.RGBA8, gpu.texture.RENDER_TARGET);
    let is i64 as color = gpu.texture.create(&d, &ctd);
    let is math.color.Color as bg = math.color.black();
    let is i64 as black = math.color.pack_rgba8(bg);
    let is i64 as red = math.color.pack_rgba8(math.color.red());

    let is [6]Vtx as verts;
    quad(cast(*Vtx, &verts), math.color.red());
    let is i64 as vb = gpu.buffer.create(&d, sizeof(Vtx) * 6, gpu.buffer.VERTEX);
    gpu.buffer.upload(&d, vb, 0, cast(*u8, &verts), sizeof(Vtx) * 6);

    // A 2D pipeline: blended, no depth, no culling.
    let is i64 as unlit = gpu.shader.builtin(&d, gpu.shader.UNLIT_COLOR);
    let is gpu.pipeline.Desc as pd = gpu.pipeline.desc_blended(unlit, gpu.pipeline.layout_pos_color_uv());
    check("2d desc: no culling", pd.cull == gpu.pipeline.CULL_NONE);
    check("2d desc: no depth", pd.depth_test == gpu.pipeline.DEPTH_NONE && pd.depth_write == 0);
    check("2d desc: alpha blend", pd.blend == gpu.pipeline.BLEND_ALPHA);
    let is i64 as plain = gpu.pipeline.create(&d, &pd);

    // --- The scissor confines a draw that covers the whole target ---
    let is i64 as cb = gpu.command.create(&d);
    gpu.command.begin(&d, cb);
    let is gpu.command.Pass as ps = gpu.command.pass(color, 0, bg);
    gpu.command.begin_pass(&d, cb, &ps);
    gpu.command.bind_pipeline(&d, cb, plain);
    gpu.command.bind_vertex_buffer(&d, cb, vb);
    gpu.command.set_scissor(&d, cb, 4, 4, 8, 8);
    gpu.command.draw(&d, cb, 0, 6);
    gpu.command.end_pass(&d, cb);
    gpu.command.end(&d, cb);
    check("submit", gpu.command.submit(&d, cb));
    gpu.texture.read(&d, color, cast(*u8, &px), W * H * 4);
    eq("inside the scissor", pixel(4, 4), red);
    eq("inside the scissor, far corner", pixel(11, 11), red);
    eq("left of it", pixel(3, 8), black);
    eq("right of it", pixel(12, 8), black);
    eq("above it", pixel(8, 3), black);
    eq("below it", pixel(8, 12), black);

    // Clearing the scissor gives the whole target back.
    gpu.command.begin(&d, cb);
    gpu.command.begin_pass(&d, cb, &ps);
    gpu.command.bind_pipeline(&d, cb, plain);
    gpu.command.bind_vertex_buffer(&d, cb, vb);
    gpu.command.set_scissor(&d, cb, 4, 4, 8, 8);
    gpu.command.clear_scissor(&d, cb);
    gpu.command.draw(&d, cb, 0, 6);
    gpu.command.end_pass(&d, cb);
    gpu.command.end(&d, cb);
    gpu.command.submit(&d, cb);
    gpu.texture.read(&d, color, cast(*u8, &px), W * H * 4);
    eq("cleared scissor: corner drawn", pixel(0, 0), red);

    // An empty scissor draws nothing.
    gpu.command.begin(&d, cb);
    gpu.command.begin_pass(&d, cb, &ps);
    gpu.command.bind_pipeline(&d, cb, plain);
    gpu.command.bind_vertex_buffer(&d, cb, vb);
    gpu.command.set_scissor(&d, cb, 5, 5, 0, 0);
    gpu.command.draw(&d, cb, 0, 6);
    gpu.command.end_pass(&d, cb);
    gpu.command.end(&d, cb);
    gpu.command.submit(&d, cb);
    gpu.texture.read(&d, color, cast(*u8, &px), W * H * 4);
    eq("empty scissor: nothing", pixel(5, 5), black);

    // --- Premultiplied: the colour already carries its alpha ---
    //
    // What a layer painted on transparency holds — and so how it has to go
    // back onto the window: src + dst * (1 - a), not src * a + dst * (1 - a).
    let is gpu.pipeline.Desc as pmd = gpu.pipeline.desc_blended(unlit, gpu.pipeline.layout_pos_color_uv());
    pmd.blend = gpu.pipeline.BLEND_PREMULTIPLIED;
    let is i64 as premul = gpu.pipeline.create(&d, &pmd);
    check("premultiplied pipeline", premul != 0);
    let is math.color.Color as grey = math.color.rgb(0.4, 0.4, 0.4);
    let is gpu.command.Pass as gps = gpu.command.pass(color, 0, grey);
    let is [6]Vtx as half;
    quad(cast(*Vtx, &half), math.color.rgba(0.5, 0.0, 0.0, 0.5));   // red at half, premultiplied
    let is i64 as hb = gpu.buffer.create(&d, sizeof(Vtx) * 6, gpu.buffer.VERTEX);
    gpu.buffer.upload(&d, hb, 0, cast(*u8, &half), sizeof(Vtx) * 6);
    gpu.command.begin(&d, cb);
    gpu.command.begin_pass(&d, cb, &gps);
    gpu.command.bind_pipeline(&d, cb, premul);
    gpu.command.bind_vertex_buffer(&d, cb, hb);
    gpu.command.draw(&d, cb, 0, 6);
    gpu.command.end_pass(&d, cb);
    gpu.command.end(&d, cb);
    gpu.command.submit(&d, cb);
    gpu.texture.read(&d, color, cast(*u8, &px), W * H * 4);
    let is i64 as pr = pixel(8, 8) & 255;
    let is i64 as pg = (pixel(8, 8) >> 8) & 255;
    check("premultiplied: red is the source plus half the grey", pr >= 177 && pr <= 180);
    check("premultiplied: green is half the grey", pg >= 50 && pg <= 52);
    check("premultiplied: opaque after", ((pixel(8, 8) >> 24) & 255) == 255);
    // The same colours through straight alpha would multiply the red again.
    gpu.command.begin(&d, cb);
    gpu.command.begin_pass(&d, cb, &gps);
    gpu.command.bind_pipeline(&d, cb, plain);
    gpu.command.bind_vertex_buffer(&d, cb, hb);
    gpu.command.draw(&d, cb, 0, 6);
    gpu.command.end_pass(&d, cb);
    gpu.command.end(&d, cb);
    gpu.command.submit(&d, cb);
    gpu.texture.read(&d, color, cast(*u8, &px), W * H * 4);
    let is i64 as sr = pixel(8, 8) & 255;
    check("straight alpha: not the same", sr >= 113 && sr <= 116);
    // Fully transparent and premultiplied is nothing at all.
    quad(cast(*Vtx, &half), math.color.rgba(0.0, 0.0, 0.0, 0.0));
    gpu.buffer.upload(&d, hb, 0, cast(*u8, &half), sizeof(Vtx) * 6);
    gpu.command.begin(&d, cb);
    gpu.command.begin_pass(&d, cb, &gps);
    gpu.command.bind_pipeline(&d, cb, premul);
    gpu.command.bind_vertex_buffer(&d, cb, hb);
    gpu.command.draw(&d, cb, 0, 6);
    gpu.command.end_pass(&d, cb);
    gpu.command.end(&d, cb);
    gpu.command.submit(&d, cb);
    gpu.texture.read(&d, color, cast(*u8, &px), W * H * 4);
    eq("premultiplied transparency: the grey untouched", pixel(8, 8), math.color.pack_rgba8(grey));
    // Alpha 0 with colour is light added, not nothing: a glow.
    quad(cast(*Vtx, &half), math.color.rgba(0.2, 0.0, 0.0, 0.0));
    gpu.buffer.upload(&d, hb, 0, cast(*u8, &half), sizeof(Vtx) * 6);
    gpu.command.begin(&d, cb);
    gpu.command.begin_pass(&d, cb, &gps);
    gpu.command.bind_pipeline(&d, cb, premul);
    gpu.command.bind_vertex_buffer(&d, cb, hb);
    gpu.command.draw(&d, cb, 0, 6);
    gpu.command.end_pass(&d, cb);
    gpu.command.end(&d, cb);
    gpu.command.submit(&d, cb);
    gpu.texture.read(&d, color, cast(*u8, &px), W * H * 4);
    let is i64 as glow = pixel(8, 8) & 255;
    check("premultiplied, alpha 0: the colour adds", glow >= 152 && glow <= 154);

    // --- Coverage: an R8 texture is how much of the vertex colour lands ---
    //
    // Two texels, full and half; white over black gives white and middle grey.
    let is gpu.texture.Desc as gtd = gpu.texture.desc(2, 1, gpu.texture.R8, gpu.texture.SAMPLED);
    let is i64 as glyph = gpu.texture.create(&d, &gtd);
    let is [2]u8 as cov;
    cov[0] = 255;
    cov[1] = 128;
    gpu.texture.upload(&d, glyph, cast(*u8, &cov), 2);
    let is i64 as samp = gpu.texture.sampler(&d, gpu.texture.NEAREST, gpu.texture.CLAMP);
    let is i64 as covsh = gpu.shader.builtin(&d, gpu.shader.COVERAGE);
    let is gpu.pipeline.Desc as cd = gpu.pipeline.desc_blended(covsh, gpu.pipeline.layout_pos_color_uv());
    let is i64 as coverage = gpu.pipeline.create(&d, &cd);
    check("coverage pipeline", coverage != 0);
    quad(cast(*Vtx, &verts), math.color.white());
    gpu.buffer.upload(&d, vb, 0, cast(*u8, &verts), sizeof(Vtx) * 6);
    gpu.command.begin(&d, cb);
    gpu.command.begin_pass(&d, cb, &ps);
    gpu.command.bind_pipeline(&d, cb, coverage);
    gpu.command.bind_vertex_buffer(&d, cb, vb);
    gpu.command.bind_texture(&d, cb, 0, glyph, samp);
    gpu.command.draw(&d, cb, 0, 6);
    gpu.command.end_pass(&d, cb);
    gpu.command.end(&d, cb);
    gpu.command.submit(&d, cb);
    gpu.texture.read(&d, color, cast(*u8, &px), W * H * 4);
    let is i64 as left = pixel(2, 8);
    let is i64 as right = pixel(13, 8);
    eq("full coverage: the colour", left & 16777215, 16777215);
    let is i64 as half_r = right & 255;
    check("half coverage: half the colour", half_r >= 126 && half_r <= 130);
    check("half coverage: grey, not tinted", (right & 255) == ((right >> 8) & 255) && (right & 255) == ((right >> 16) & 255));

    // --- Partial upload: only the region changes ---
    let is gpu.texture.Desc as atd = gpu.texture.desc(4, 4, gpu.texture.RGBA8, gpu.texture.SAMPLED);
    let is i64 as atlas = gpu.texture.create(&d, &atd);
    let is [16]i32 as zero;
    let is i64 as i with mut = 0;
    while (i < 16) { zero[i] = 0; i = i + 1; }
    gpu.texture.upload(&d, atlas, cast(*u8, &zero), 64);
    let is [4]i32 as patch;
    i = 0;
    while (i < 4) { patch[i] = cast(i32, red); i = i + 1; }
    check("region upload", gpu.texture.upload_region(&d, atlas, 1, 1, 2, 2, cast(*u8, &patch), 8));
    let is [16]i32 as back;
    gpu.texture.read(&d, atlas, cast(*u8, &back), 64);
    eq("region (1,1)", cast(i64, back[5]) & 4294967295, red);
    eq("region (2,2)", cast(i64, back[10]) & 4294967295, red);
    eq("outside (0,0)", cast(i64, back[0]) & 4294967295, 0);
    eq("outside (3,1)", cast(i64, back[7]) & 4294967295, 0);
    eq("outside (1,3)", cast(i64, back[13]) & 4294967295, 0);
    // A region past the edge is refused rather than written past the texels.
    check("region past the edge refused", gpu.texture.upload_region(&d, atlas, 3, 3, 2, 2, cast(*u8, &patch), 8) == 0);
    eq("refused: last texel untouched", cast(i64, back[15]) & 4294967295, 0);
    // An R8 region, rows of one byte per texel.
    let is [2]u8 as dot;
    dot[0] = 9;
    dot[1] = 9;
    check("r8 region", gpu.texture.upload_region(&d, glyph, 1, 0, 1, 1, cast(*u8, &dot), 1));
    let is [2]u8 as gback;
    gpu.texture.read(&d, glyph, cast(*u8, &gback), 2);
    check("r8 region written, neighbour kept", gback[0] == 255 && gback[1] == 9);

    moves(&d);

    gpu.close(&d);
    if (fails != 0) { return 1; }
    io.printf("gpu 2d: all checks passed\n");
    return 0;
}
