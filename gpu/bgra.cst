// RGBA8 pixels with straight alpha — what the software target holds — as a
// platform's 32-bit window buffer reads them: BGRA bytes (0xAARRGGBB words),
// the colour premultiplied by alpha when the buffer is read that way.
//
// Two pixels a word: alpha and green stay, red and blue trade places, and an
// opaque pair needs nothing more — premultiplied, it is what it was. Pixels
// that are not opaque, and the last of an odd count, go one at a time, each
// channel c * a / 255 rounded to nearest, by shifts rather than a division.

// What a region read is turned into (texture.read_region_as).
let is i32 as AS_IS with imut = 0;
let is i32 as BGRA with imut = 1;
let is i32 as BGRA_PREMULTIPLIED with imut = 2;

// n pixels at src written converted to dst; src and dst may be the same.
fn convert(dst as i64, src as i64, n as i64, premultiply as i32) as void {
    let is i64 as ag = (4278255360 << 32) | 4278255360;   // 0xFF00FF00 in each half
    let is i64 as rb = (255 << 32) | 255;
    let is i64 as alphas = (4278190080 << 32) | 4278190080; // 0xFF000000 in each half
    let is i64 as i with mut = 0;
    while (i + 1 < n) {
        let is i64 as p = *cast(*i64, src + i * 4);
        if (premultiply == 0 || (p & alphas) == alphas) {
            *cast(*i64, dst + i * 4) = (p & ag) | ((p & rb) << 16) | ((p >> 16) & rb);
        } else {
            // Each of the two premultiplied in place, inline: red and blue
            // together, sixteen bits apart, each lane as _times.
            let is i64 as lo = p & 4294967295;
            let is i64 as la = lo >> 24;
            let is i64 as lrb with mut = (lo & 16711935) * la + 8388736;
            lrb = ((lrb + ((lrb >> 8) & 16711935)) >> 8) & 16711935;
            let is i64 as lg with mut = ((lo >> 8) & 255) * la + 128;
            lg = (lg + (lg >> 8)) >> 8;
            let is i64 as hi = (p >> 32) & 4294967295;
            let is i64 as ha = hi >> 24;
            let is i64 as hrb with mut = (hi & 16711935) * ha + 8388736;
            hrb = ((hrb + ((hrb >> 8) & 16711935)) >> 8) & 16711935;
            let is i64 as hg with mut = ((hi >> 8) & 255) * ha + 128;
            hg = (hg + (hg >> 8)) >> 8;
            let is i64 as lw = (la << 24) | ((lrb & 255) << 16) | (lg << 8) | (lrb >> 16);
            let is i64 as hw = (ha << 24) | ((hrb & 255) << 16) | (hg << 8) | (hrb >> 16);
            *cast(*i64, dst + i * 4) = lw | (hw << 32);
        }
        i = i + 2;
    }
    if (i < n) { _one(dst + i * 4, src + i * 4, premultiply); }
}

// c * a / 255 rounded to nearest, for c and a up to 255, by shifts: exactly
// (c * a + 127) / 255 (pixels_test holds every pair to it).
fn _times(c as i64, a as i64) as i64 {
    let is i64 as m = c * a + 128;
    return (m + (m >> 8)) >> 8;
}

fn _one(dst as i64, src as i64, premultiply as i32) as void {
    let is i64 as p = cast(i64, *cast(*i32, src)) & 4294967295;
    let is i64 as a = p >> 24;
    if (premultiply == 0 || a == 255) {
        *cast(*i32, dst) = cast(i32, (p & 4278255360) | ((p & 255) << 16) | ((p >> 16) & 255));
        return;
    }
    // Red and blue together, sixteen bits apart: each lane as _times.
    let is i64 as rb with mut = (p & 16711935) * a + 8388736;
    rb = ((rb + ((rb >> 8) & 16711935)) >> 8) & 16711935;
    let is i64 as g = _times((p >> 8) & 255, a);
    *cast(*i32, dst) = cast(i32, (a << 24) | ((rb & 255) << 16) | (g << 8) | (rb >> 16));
}
