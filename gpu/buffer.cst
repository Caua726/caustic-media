// gpu/buffer.cst — memory the device can read.
//
// The easy part of a device, and it is worth saying why: on hardware a buffer
// means staging, a transfer queue and visibility rules; in software it is
// memory, upload is a copy, and mapping is returning the pointer. The API is
// shaped for the hard case so that the easy one is not a different API.
//
// Every backend's buffer payload BEGINS with the Info struct below, and the
// backend's own state follows it at backend_state(). That rule is what lets
// buffer.size() answer without a vtable entry of its own, and it is the only
// layout contract between this file and a backend.
use "device.cst" as dev;

// Usage is declared at creation because hardware wants it declared at
// creation. Software ignores it, and that difference must not be visible.
let is i32 as VERTEX  with imut = 1;
let is i32 as INDEX   with imut = 2;
let is i32 as UNIFORM with imut = 4;
let is i32 as STORAGE with imut = 8;

struct Info {
    size  as i64;
    usage as i32;
}

// Where a backend's private state starts, given the payload it was handed.
fn backend_state(payload as *u8) as *u8 {
    return cast(*u8, cast(i64, payload) + sizeof(Info));
}

fn info_bytes() as i64 { return sizeof(Info); }

// --- Creation ---
//
// Returns a handle that may be invalid; last_error() says why. The slot is
// claimed before the backend is asked, and released again if the backend
// refuses, so a failed creation leaves no debris.
fn create(d as *dev.Device, size as i64, usage as i32) as i64 {
    if (size <= 0) { dev.set_error(d, dev.BAD_ARGUMENT); return 0; }
    let is i64 as h = dev.alloc_handle(d, dev.KIND_BUFFER);
    if (h == 0) { return 0; }

    let is *u8 as p = dev.payload(d, dev.KIND_BUFFER, h);
    let is *Info as inf = cast(*Info, p);
    inf.size = size;
    inf.usage = usage;

    if (call(d.vt.buffer_create, d.self, p, size, cast(i64, usage)) != 1) {
        dev.free_handle(d, dev.KIND_BUFFER, h);
        dev.set_error(d, dev.OUT_OF_MEMORY);
        return 0;
    }
    return h;
}

fn destroy(d as *dev.Device, h as i64) as void {
    let is *u8 as p = dev.payload(d, dev.KIND_BUFFER, h);
    if (cast(i64, p) == 0) { return; }
    call(d.vt.buffer_destroy, d.self, p);
    dev.free_handle(d, dev.KIND_BUFFER, h);
}

// --- Contents ---

// Copies into the buffer at an offset. Returns 1 on success, 0 with
// last_error() set — this is a setup-path operation, so it reports.
fn upload(d as *dev.Device, h as i64, offset as i64, src as *u8, bytes as i64) as i32 {
    let is *u8 as p = dev.payload_checked(d, dev.KIND_BUFFER, h);
    if (cast(i64, p) == 0) { return 0; }
    if (bytes < 0 || offset < 0) { dev.set_error(d, dev.BAD_ARGUMENT); return 0; }
    let is *Info as inf = cast(*Info, p);
    if (offset + bytes > inf.size) { dev.set_error(d, dev.BAD_ARGUMENT); return 0; }
    if (bytes == 0) { return 1; }
    if (cast(i64, src) == 0) { dev.set_error(d, dev.BAD_ARGUMENT); return 0; }
    if (call(d.vt.buffer_upload, d.self, p, offset, src, bytes) != 1) {
        dev.set_error(d, dev.DEVICE_LOST);
        return 0;
    }
    return 1;
}

// The buffer's memory. Null for a handle that names nothing.
//
// On a real GPU this is a mapping with a lifetime; in software it is the
// allocation itself. Programs that keep the pointer across a resize of the
// buffer are wrong on both.
fn map(d as *dev.Device, h as i64) as *u8 {
    let is *u8 as p = dev.payload(d, dev.KIND_BUFFER, h);
    if (cast(i64, p) == 0) { return cast(*u8, 0); }
    return cast(*u8, call(d.vt.buffer_map, d.self, p));
}

fn size(d as *dev.Device, h as i64) as i64 {
    let is *u8 as p = dev.payload(d, dev.KIND_BUFFER, h);
    if (cast(i64, p) == 0) { return 0; }
    return cast(*Info, p).size;
}

fn usage(d as *dev.Device, h as i64) as i32 {
    let is *u8 as p = dev.payload(d, dev.KIND_BUFFER, h);
    if (cast(i64, p) == 0) { return 0; }
    return cast(*Info, p).usage;
}
