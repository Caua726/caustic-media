// gpu/gpu.cst — hub for the GPU layer.
//
//   use "caustic-media/gpu/gpu.cst" as gpu;
//
//   let is gpu.device.Device as d = gpu.open(&surface, gpu.AUTO);
//   let is i64 as vb = gpu.buffer.create(&d, bytes, gpu.buffer.VERTEX);
//   let is i64 as sh = gpu.shader.builtin(&d, gpu.shader.UNLIT_COLOR);
//
// Modules:
//   device      the portable GPU: handles, errors, capabilities, device loss
//   buffer      creation, upload, mapping
//   texture     textures, samplers, formats
//   shader      built-in materials today, SPIR-V modules when they run
//   pipeline    vertex layouts, surface state, stages
//   command     command buffers, passes, draws, submission
//   swapchain   presentation, built from a window's native handles
//
// This is where a backend is chosen, and the only file that knows they exist:
// device.cst defines the vtable and knows nothing about who fills it, which
// is what keeps the dependency arrow pointing one way and lets a backend be
// deleted by deleting its directory.
use "device.cst" as device;
use "buffer.cst" as buffer;
use "texture.cst" as texture;
use "shader.cst" as shader;
use "pipeline.cst" as pipeline;
use "command.cst" as command;
use "swapchain.cst" as swapchain;
use "software/backend.cst" as software;

// --- Backends ---
//
// Which of these is in the binary is decided in the Causticfile; which is
// used is decided here, by the program, at run time. A backend that was not
// compiled in costs nothing and cannot be selected.
let is i32 as AUTO     with imut = cast(i32, 0 - 1);
let is i32 as VULKAN   with imut = 0;
let is i32 as OPENGL   with imut = 1;
let is i32 as D3D      with imut = 2;
let is i32 as SOFTWARE with imut = 3;

fn backend_name(id as i32) as *u8 {
    if (id == AUTO)     { return "auto"; }
    if (id == VULKAN)   { return "vulkan"; }
    if (id == OPENGL)   { return "opengl"; }
    if (id == D3D)      { return "direct3d"; }
    if (id == SOFTWARE) { return "software"; }
    return "unknown";
}

// Whether this build can actually reach a backend. Today only software
// exists; the others are notes and a generator away, and answering honestly
// here is what lets a program ask rather than discover.
fn available(id as i32) as i32 {
    if (id == SOFTWARE) { return 1; }
    return 0;
}

// --- Opening a device ---
//
// AUTO selects Vulkan, then Direct3D on Windows, then OpenGL, then software.
// Software always succeeds, so AUTO never fails outright — and a program can
// always name one instead, which is the level of choice the README describes.
fn _open_backend(id as i32, l as *device.Limits) as device.Device {
    if (id == SOFTWARE) { return software.open(l); }
    // Not compiled in, or not written yet. A device that reports NO_BACKEND
    // beats one that pretends to have opened.
    let is device.Device as d;
    d.ok = 0;
    d.err = device.NO_BACKEND;
    d.lost = 0;
    d.backend = id;
    return d;
}

fn _resolve(id as i32) as i32 {
    if (id != AUTO) { return id; }
    if (available(VULKAN) == 1) { return VULKAN; }
    if (available(D3D) == 1)    { return D3D; }
    if (available(OPENGL) == 1) { return OPENGL; }
    return SOFTWARE;
}

// A device that will present to a surface. The surface carries the window's
// native handles; see swapchain.cst for why this layer takes them as data
// rather than importing window/.
fn open_with(s as *swapchain.Surface, id as i32, l as *device.Limits) as device.Device {
    let is i32 as chosen = _resolve(id);
    if (available(chosen) == 0) {
        let is device.Device as bad;
        bad.ok = 0;
        bad.err = device.NO_BACKEND;
        bad.lost = 0;
        bad.backend = chosen;
        return bad;
    }
    return _open_backend(chosen, l);
}

fn open(s as *swapchain.Surface, id as i32) as device.Device {
    let is device.Limits as l = device.limits_default();
    return open_with(s, id, &l);
}

// No screen at all: the device renders into textures the program can read.
// This is what a test uses, what a program rendering to a file uses, and what
// makes the whole layer runnable in CI with no DISPLAY.
//
// The size arguments size nothing by themselves — a swapchain is still
// created explicitly — but they are what a backend needs to pick sensible
// defaults, and they keep the headless and windowed calls the same shape.
fn open_headless_with(width as i64, height as i64, id as i32, l as *device.Limits) as device.Device {
    let is swapchain.Surface as s = swapchain.surface_headless();
    return open_with(&s, id, l);
}

fn open_headless(width as i64, height as i64, id as i32) as device.Device {
    let is device.Limits as l = device.limits_default();
    return open_headless_with(width, height, id, &l);
}

// --- Releasing what the program did not ---
//
// A device's own tables live in one mapping, but the resources do not: a
// buffer's memory and a texture's pixels are mappings of their own, made when
// the resource was created. Unmapping the tables therefore frees the
// bookkeeping and leaks the contents — a program that opened a device per
// level and forgot one texture would leak that texture per level, and see it
// as a slow climb with nothing to point at.
//
// So closing sweeps. The order is not arbitrary: a swapchain owns its images,
// so it goes before textures, or it would be destroying handles that had
// already been released.
fn _release_kind(d as *device.Device, kind as i64) as void {
    let is i64 as cap = device.capacity(d, kind);
    let is i64 as i with mut = 0;
    while (i < cap) {
        let is i64 as h = device.handle_at(d, kind, i);
        if (h != 0) {
            if (kind == device.KIND_SWAPCHAIN) { swapchain.destroy(d, h); }
            else if (kind == device.KIND_COMMANDS) { command.destroy(d, h); }
            else if (kind == device.KIND_PIPELINE) { pipeline.destroy(d, h); }
            else if (kind == device.KIND_SHADER) { shader.destroy(d, h); }
            else if (kind == device.KIND_SAMPLER) { texture.sampler_destroy(d, h); }
            else if (kind == device.KIND_TEXTURE) { texture.destroy(d, h); }
            else if (kind == device.KIND_BUFFER) { buffer.destroy(d, h); }
        }
        i = i + 1;
    }
}

fn release_all(d as *device.Device) as void {
    if (device.is_open(d) == 0) { return; }
    _release_kind(d, device.KIND_SWAPCHAIN);
    _release_kind(d, device.KIND_COMMANDS);
    _release_kind(d, device.KIND_PIPELINE);
    _release_kind(d, device.KIND_SHADER);
    _release_kind(d, device.KIND_SAMPLER);
    _release_kind(d, device.KIND_TEXTURE);
    _release_kind(d, device.KIND_BUFFER);
}

fn close(d as *device.Device) as void {
    if (device.is_open(d) == 0) { return; }
    release_all(d);
    if (d.backend == SOFTWARE) { software.close(d); return; }
    device.shutdown(d);
}

// --- Forwarded, so the common calls read as gpu.something ---

fn last_error(d as *device.Device) as i32 { return device.last_error(d); }
fn error_name(code as i32) as *u8 { return device.error_name(code); }
fn is_lost(d as *device.Device) as i32 { return device.is_lost(d); }
fn caps(d as *device.Device) as device.Caps { return device.caps(d); }
