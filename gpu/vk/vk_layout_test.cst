// gpu/vk/vk_layout_test.cst — the pads are right, or this fails.
//
// Caustic structs are packed and C structs are not, so every struct in bind/
// carries explicit _padN fields wherever the C ABI would have aligned. A
// missing one is not a compile error and not a crash: it is a field read at the
// wrong offset, and the driver on the other side reads bytes that mean
// something else.
//
// Vulkan makes this the common case rather than an edge one. Measured on this
// registry, 1082 of the 1211 reachable structs need at least one pad, because
// nearly every struct in the API opens with a 4-byte sType followed by an
// 8-byte-aligned pNext.
//
// This test turns that class of bug into a failed assertion. Every sizeof and
// every field position in bind/ is checked against tools/layout.txt, which came
// out of tools/vk_layout.c asking the C compiler that built this machine's
// Vulkan headers.
//
// It links nothing. No libvulkan, no driver, no GPU — it only measures Caustic
// structs, which is why it belongs in the plain `test` script alongside math/
// and gpu/ rather than in `test-vk`.
//
// The numbers are x86_64 Linux. On another architecture they would differ and
// this would fail loudly, which is the correct outcome: it means the bindings
// have not been checked there.
//
// Exit code is the number of failures.
use "std/io.cst" as io;
use "bind/structs.cst" as vk;

let is i32 as fails with mut = 0;

fn chk_i(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

// Offsets are measured rather than declared: the address of a field minus the
// address of the struct is what the compiler actually laid out, which is the
// only number worth checking.
fn off(base as i64, field as i64) as i64 { return field - base; }

// --- Geometry ---
//
// No padding anywhere in these four: all fields are 4 bytes wide and 4-aligned.
// They are here because a test that only covered the padded structs would not
// notice the day something starts padding what should not be padded.

fn test_VkExtent2D() as void {
    let is vk.VkExtent2D as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkExtent2D",  sizeof(vk.VkExtent2D), 8);
    chk_i("VkExtent2D.width",   off(b, cast(i64, &s.width)),  0);
    chk_i("VkExtent2D.height",  off(b, cast(i64, &s.height)), 4);
}

fn test_VkExtent3D() as void {
    let is vk.VkExtent3D as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkExtent3D",  sizeof(vk.VkExtent3D), 12);
    chk_i("VkExtent3D.width",   off(b, cast(i64, &s.width)),  0);
    chk_i("VkExtent3D.height",  off(b, cast(i64, &s.height)), 4);
    chk_i("VkExtent3D.depth",   off(b, cast(i64, &s.depth)),  8);
}

fn test_VkOffset2D() as void {
    let is vk.VkOffset2D as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkOffset2D",  sizeof(vk.VkOffset2D), 8);
    chk_i("VkOffset2D.x",       off(b, cast(i64, &s.x)), 0);
    chk_i("VkOffset2D.y",       off(b, cast(i64, &s.y)), 4);
}

fn test_VkOffset3D() as void {
    let is vk.VkOffset3D as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkOffset3D",  sizeof(vk.VkOffset3D), 12);
    chk_i("VkOffset3D.x",       off(b, cast(i64, &s.x)), 0);
    chk_i("VkOffset3D.y",       off(b, cast(i64, &s.y)), 4);
    chk_i("VkOffset3D.z",       off(b, cast(i64, &s.z)), 8);
}

// --- Enumeration results ---
//
// VkExtensionProperties is 260 bytes and NOT rounded up to 264: its widest
// member is a char array, so the struct's alignment is 4 and 260 is already a
// multiple of it. A model that rounds every struct to 8 gets this wrong.

fn test_VkExtensionProperties() as void {
    let is vk.VkExtensionProperties as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkExtensionProperties",       sizeof(vk.VkExtensionProperties), 260);
    chk_i("VkExtensionProperties.extensionName", off(b, cast(i64, &s.extensionName)),   0);
    chk_i("VkExtensionProperties.specVersion",   off(b, cast(i64, &s.specVersion)),   256);
}

fn test_VkLayerProperties() as void {
    let is vk.VkLayerProperties as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkLayerProperties",                 sizeof(vk.VkLayerProperties), 520);
    chk_i("VkLayerProperties.layerName",              off(b, cast(i64, &s.layerName)),               0);
    chk_i("VkLayerProperties.specVersion",            off(b, cast(i64, &s.specVersion)),           256);
    chk_i("VkLayerProperties.implementationVersion",  off(b, cast(i64, &s.implementationVersion)), 260);
    chk_i("VkLayerProperties.description",            off(b, cast(i64, &s.description)),           264);
}

// --- The sType/pNext pair, which is where the padding lives ---

fn test_VkApplicationInfo() as void {
    let is vk.VkApplicationInfo as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkApplicationInfo",              sizeof(vk.VkApplicationInfo), 48);
    chk_i("VkApplicationInfo.sType",               off(b, cast(i64, &s.sType)),               0);
    chk_i("VkApplicationInfo.pNext",               off(b, cast(i64, &s.pNext)),               8);
    chk_i("VkApplicationInfo.pApplicationName",    off(b, cast(i64, &s.pApplicationName)),   16);
    chk_i("VkApplicationInfo.applicationVersion",  off(b, cast(i64, &s.applicationVersion)), 24);
    chk_i("VkApplicationInfo.pEngineName",         off(b, cast(i64, &s.pEngineName)),        32);
    chk_i("VkApplicationInfo.engineVersion",       off(b, cast(i64, &s.engineVersion)),      40);
    chk_i("VkApplicationInfo.apiVersion",          off(b, cast(i64, &s.apiVersion)),         44);
}

fn test_VkInstanceCreateInfo() as void {
    let is vk.VkInstanceCreateInfo as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkInstanceCreateInfo",                 sizeof(vk.VkInstanceCreateInfo), 64);
    chk_i("VkInstanceCreateInfo.sType",                  off(b, cast(i64, &s.sType)),                    0);
    chk_i("VkInstanceCreateInfo.pNext",                  off(b, cast(i64, &s.pNext)),                    8);
    chk_i("VkInstanceCreateInfo.flags",                  off(b, cast(i64, &s.flags)),                   16);
    chk_i("VkInstanceCreateInfo.pApplicationInfo",       off(b, cast(i64, &s.pApplicationInfo)),        24);
    chk_i("VkInstanceCreateInfo.enabledLayerCount",      off(b, cast(i64, &s.enabledLayerCount)),       32);
    chk_i("VkInstanceCreateInfo.ppEnabledLayerNames",    off(b, cast(i64, &s.ppEnabledLayerNames)),     40);
    chk_i("VkInstanceCreateInfo.enabledExtensionCount",  off(b, cast(i64, &s.enabledExtensionCount)),   48);
    chk_i("VkInstanceCreateInfo.ppEnabledExtensionNames", off(b, cast(i64, &s.ppEnabledExtensionNames)), 56);
}

fn test_VkPhysicalDeviceSparseProperties() as void {
    let is vk.VkPhysicalDeviceSparseProperties as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkPhysicalDeviceSparseProperties", sizeof(vk.VkPhysicalDeviceSparseProperties), 20);
    chk_i("VkPhysicalDeviceSparseProperties.residencyStandard2DBlockShape",
          off(b, cast(i64, &s.residencyStandard2DBlockShape)), 0);
    chk_i("VkPhysicalDeviceSparseProperties.residencyStandard2DMultisampleBlockShape",
          off(b, cast(i64, &s.residencyStandard2DMultisampleBlockShape)), 4);
    chk_i("VkPhysicalDeviceSparseProperties.residencyStandard3DBlockShape",
          off(b, cast(i64, &s.residencyStandard3DBlockShape)), 8);
    chk_i("VkPhysicalDeviceSparseProperties.residencyAlignedMipSize",
          off(b, cast(i64, &s.residencyAlignedMipSize)), 12);
    chk_i("VkPhysicalDeviceSparseProperties.residencyNonResidentStrict",
          off(b, cast(i64, &s.residencyNonResidentStrict)), 16);
}

// --- The one that carries a nested struct and two arrays ---
//
// pipelineCacheUUID ends at 292 and limits begins at 296, because
// VkPhysicalDeviceLimits contains VkDeviceSize members and is therefore
// 8-aligned. Nothing in the field list suggests that gap; it exists only in the
// ABI, and this assertion is the only thing standing between it and a
// deviceName that reads four bytes into the wrong place.

fn test_VkPhysicalDeviceLimits() as void {
    chk_i("sizeof VkPhysicalDeviceLimits", sizeof(vk.VkPhysicalDeviceLimits), 504);
}

fn test_VkPhysicalDeviceProperties() as void {
    let is vk.VkPhysicalDeviceProperties as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof VkPhysicalDeviceProperties",  sizeof(vk.VkPhysicalDeviceProperties), 824);
    chk_i("VkPhysicalDeviceProperties.apiVersion",        off(b, cast(i64, &s.apiVersion)),          0);
    chk_i("VkPhysicalDeviceProperties.driverVersion",     off(b, cast(i64, &s.driverVersion)),       4);
    chk_i("VkPhysicalDeviceProperties.vendorID",          off(b, cast(i64, &s.vendorID)),            8);
    chk_i("VkPhysicalDeviceProperties.deviceID",          off(b, cast(i64, &s.deviceID)),           12);
    chk_i("VkPhysicalDeviceProperties.deviceType",        off(b, cast(i64, &s.deviceType)),         16);
    chk_i("VkPhysicalDeviceProperties.deviceName",        off(b, cast(i64, &s.deviceName)),         20);
    chk_i("VkPhysicalDeviceProperties.pipelineCacheUUID", off(b, cast(i64, &s.pipelineCacheUUID)), 276);
    chk_i("VkPhysicalDeviceProperties.limits",            off(b, cast(i64, &s.limits)),            296);
    chk_i("VkPhysicalDeviceProperties.sparseProperties",  off(b, cast(i64, &s.sparseProperties)),  800);
}

fn main() as i32 {
    test_VkExtent2D();
    test_VkExtent3D();
    test_VkOffset2D();
    test_VkOffset3D();
    test_VkExtensionProperties();
    test_VkLayerProperties();
    test_VkApplicationInfo();
    test_VkInstanceCreateInfo();
    test_VkPhysicalDeviceSparseProperties();
    test_VkPhysicalDeviceLimits();
    test_VkPhysicalDeviceProperties();

    if (fails == 0) { io.printf("vk layout: all checks passed\n"); }
    else { io.printf("  vk_layout_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
