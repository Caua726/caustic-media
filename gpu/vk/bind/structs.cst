// gpu/vk/bind/structs.cst — Vulkan's structs, laid out the way C lays them out.
//
// --- Padding ---
//
// Caustic structs are packed and C structs are not, so every struct here
// carries explicit _padN fields wherever the C ABI would have aligned. This is
// not occasional: measured on this registry, 1082 of the 1211 structs a
// platform-independent build can reach need at least one, because nearly every
// Vulkan struct opens with
//
//     VkStructureType sType;    // 4 bytes
//     const void*     pNext;    // 8 bytes, 8-aligned
//
// and that pair alone forces four bytes of padding between them. Drop it and
// every field after lands four bytes early, the driver reads the wrong bytes,
// and nothing says a word — the same silent failure window/x11 paid for once
// already and now asserts against.
//
// The offset in the comment beside each field is not decoration and not
// counted by hand. It comes from tools/layout.txt, which came out of
// tools/vk_layout.c asking the C compiler that built this machine's Vulkan
// headers, and ../vk_layout_test.cst asserts every one of them.
//
// The number after the closing brace is sizeof.
//
// --- Types ---
//
// See core.cst. Briefly: enums are i32 because VkResult is negative, VkBool32
// and VkFlags are u32, VkDeviceSize is u64, dispatchable handles are *u8,
// non-dispatchable handles are u64 even on 32-bit, and every pointer is *u8.

// --- Geometry ---

struct VkExtent2D {
    width  as u32;   //   0
    height as u32;   //   4
}   // 8

struct VkExtent3D {
    width  as u32;   //   0
    height as u32;   //   4
    depth  as u32;   //   8
}   // 12

struct VkOffset2D {
    x as i32;   //   0
    y as i32;   //   4
}   // 8

struct VkOffset3D {
    x as i32;   //   0
    y as i32;   //   4
    z as i32;   //   8
}   // 12

// --- Enumeration results ---
//
// No sType, no pNext: these are filled by the driver rather than sent to it,
// so they are plain records. VkExtensionProperties is also the only struct in
// this first batch that needs no padding at all — a 256-byte char array
// followed by a u32 aligns on its own.

struct VkExtensionProperties {
    extensionName as [256]u8;   //   0   char[VK_MAX_EXTENSION_NAME_SIZE]
    specVersion   as u32    ;   // 256
}   // 260

struct VkLayerProperties {
    layerName             as [256]u8;   //   0   char[VK_MAX_EXTENSION_NAME_SIZE]
    specVersion           as u32    ;   // 256
    implementationVersion as u32    ;   // 260
    description           as [256]u8;   // 264   char[VK_MAX_DESCRIPTION_SIZE]
}   // 520

// --- Creating an instance ---
//
// The first two structs anyone writes, and both show the sType/pNext pad.
// VkApplicationInfo shows a second one: applicationVersion is a u32 at 24 and
// pEngineName is a pointer at 32.

struct VkApplicationInfo {
    sType              as i32;   //   0   VkStructureType
    _pad0              as i32;   //   4
    pNext              as *u8;   //   8   const void*
    pApplicationName   as *u8;   //  16   const char*
    applicationVersion as u32;   //  24
    _pad1              as u32;   //  28
    pEngineName        as *u8;   //  32   const char*
    engineVersion      as u32;   //  40
    apiVersion         as u32;   //  44
}   // 48

struct VkInstanceCreateInfo {
    sType                   as i32;   //   0   VkStructureType
    _pad0                   as i32;   //   4
    pNext                   as *u8;   //   8   const void*
    flags                   as u32;   //  16   VkInstanceCreateFlags
    _pad1                   as u32;   //  20
    pApplicationInfo        as *u8;   //  24   const VkApplicationInfo*
    enabledLayerCount       as u32;   //  32
    _pad2                   as u32;   //  36
    ppEnabledLayerNames     as *u8;   //  40   const char* const*
    enabledExtensionCount   as u32;   //  48
    _pad3                   as u32;   //  52
    ppEnabledExtensionNames as *u8;   //  56   const char* const*
}   // 64

// --- What a physical device is ---

struct VkPhysicalDeviceSparseProperties {
    residencyStandard2DBlockShape            as u32;   //   0   VkBool32
    residencyStandard2DMultisampleBlockShape as u32;   //   4   VkBool32
    residencyStandard3DBlockShape            as u32;   //   8   VkBool32
    residencyAlignedMipSize                  as u32;   //  12   VkBool32
    residencyNonResidentStrict               as u32;   //  16   VkBool32
}   // 20

// VkPhysicalDeviceLimits is 106 fields and has not been transcribed yet. It is
// declared at its measured size so that VkPhysicalDeviceProperties around it is
// correct today — every field after `limits` sits where the driver puts it, and
// the layout test asserts that.
//
// Reading a limit means transcribing this struct. It is deliberately opaque
// rather than half-written: a struct with the first twenty fields named and the
// rest missing looks finished and is not, and the field that silently reads
// from the wrong offset is the one nobody added.
struct VkPhysicalDeviceLimits {
    _opaque as [504]u8;   //   0   106 fields, not transcribed
}   // 504

struct VkPhysicalDeviceProperties {
    apiVersion        as u32     ;   //   0
    driverVersion     as u32     ;   //   4
    vendorID          as u32     ;   //   8
    deviceID          as u32     ;   //  12
    deviceType        as i32     ;   //  16   VkPhysicalDeviceType
    deviceName        as [256]u8 ;   //  20   char[VK_MAX_PHYSICAL_DEVICE_NAME_SIZE]
    pipelineCacheUUID as [16]u8  ;   // 276   uint8_t[VK_UUID_SIZE]
    // pipelineCacheUUID ends at 292 and limits begins at 296. VkDeviceSize
    // members make VkPhysicalDeviceLimits 8-aligned, so the C ABI inserts four
    // bytes here that nothing in the declaration hints at — exactly the pad
    // that is invisible by eye and fatal when missed.
    _pad0             as u32     ;   // 292
    limits            as VkPhysicalDeviceLimits      ;   // 296
    sparseProperties  as VkPhysicalDeviceSparseProperties;   // 800
    // sparseProperties ends at 820 and sizeof is 824: the struct inherits
    // 8-byte alignment from limits, so C rounds the total up. A TRAILING pad
    // like this is even less visible than an internal one — every field offset
    // is correct without it and only sizeof is wrong — and it matters as soon
    // as one of these is read out of an array, where a four-byte-short stride
    // walks off by one element per four elements read.
    _pad1             as u32     ;   // 820
}   // 824
