// gpu/vk/bind/core.cst — the types Vulkan is built out of.
//
// This directory is a BINDING, not a layer. What that means concretely:
//
//   vk.vkCreateBuffer(dev, &ci, cast(*u8, 0), &buf)
//
// The name the specification uses, the arguments the specification lists, the
// VkResult the specification defines. Nothing is grouped, renamed, hidden or
// made convenient. Somebody who knows Vulkan writes Vulkan, and somebody
// reading the specification transcribes it without translating.
//
// The other half of that promise is that nothing here imports gpu/. Not
// device.cst, not swapchain.cst, not math/. A program that wants to drive
// Vulkan itself takes bind/ and leaves the rest of the library behind, which
// is what the README promises when it says a program "reaches past it to the
// raw bindings". tools/check_isolation.sh asserts it on every CI run, because
// that property decays quietly: one import for a matrix, one for an error
// code, and a release later the binding drags the abstraction it sits under.
//
// --- Types ---
//
// Caustic has no typedef that crosses a module boundary, so the C names below
// are documentation rather than declarations, and struct fields are written in
// the underlying type with the C type in the comment beside them. Same choice
// window/x11/bind makes with Window and Atom.
//
//   VkBool32                     u32    0 or 1, never a bit pattern
//   VkFlags                      u32
//   VkFlags64                    u64    thirteen groups are this wide
//   VkDeviceSize                 u64
//   VkDeviceAddress              u64
//   VkSampleMask                 u32
//   an enum                      i32    signed: VkResult's errors are negative
//
//   a dispatchable handle        *u8    VkInstance, VkPhysicalDevice, VkDevice,
//                                      VkQueue, VkCommandBuffer — real pointers
//   a non-dispatchable handle    u64    VkBuffer, VkImage, VkSemaphore and the
//                                      rest. SIXTY-FOUR BITS EVEN ON 32-BIT,
//                                      which is the one portability trap in the
//                                      whole type system: they are not pointers
//                                      and must not be declared as one.
//
//   any T*                       *u8
//
// --- Pointers are *u8, always ---
//
// Every pointer parameter is *u8, never a typed pointer, for the same reason
// window/x11/bind/xlib.cst gives: it keeps these files free of import edges
// between each other. The cost is real — nothing stops passing a
// *VkBufferCreateInfo where VkImageCreateInfo* was wanted, and the compiler
// will not say a word. Type safety lives one level up, in the backend and in
// whatever program uses this. At a call site the cast is one token:
//
//     let is vk.VkBufferCreateInfo as ci;
//     vk.vkCreateBuffer(dev, cast(*u8, &ci), cast(*u8, 0), cast(*u8, &buf));

// --- VkResult ---
//
// Returned by most commands and negative for every error, which is why these
// are i32 and not u32. The extension errors are far from zero — the registry
// computes them as 1000000000 + (extension - 1) * 1000 + offset, negated — and
// they are declared beside the core ones as they are needed.
let is i32 as VK_SUCCESS                        with imut = 0;
let is i32 as VK_NOT_READY                      with imut = 1;
let is i32 as VK_TIMEOUT                        with imut = 2;
let is i32 as VK_EVENT_SET                      with imut = 3;
let is i32 as VK_EVENT_RESET                    with imut = 4;
let is i32 as VK_INCOMPLETE                     with imut = 5;
let is i32 as VK_ERROR_OUT_OF_HOST_MEMORY       with imut = -1;
let is i32 as VK_ERROR_OUT_OF_DEVICE_MEMORY     with imut = -2;
let is i32 as VK_ERROR_INITIALIZATION_FAILED    with imut = -3;
let is i32 as VK_ERROR_DEVICE_LOST              with imut = -4;
let is i32 as VK_ERROR_MEMORY_MAP_FAILED        with imut = -5;
let is i32 as VK_ERROR_LAYER_NOT_PRESENT        with imut = -6;
let is i32 as VK_ERROR_EXTENSION_NOT_PRESENT    with imut = -7;
let is i32 as VK_ERROR_FEATURE_NOT_PRESENT      with imut = -8;
let is i32 as VK_ERROR_INCOMPATIBLE_DRIVER      with imut = -9;
let is i32 as VK_ERROR_TOO_MANY_OBJECTS         with imut = -10;
let is i32 as VK_ERROR_FORMAT_NOT_SUPPORTED     with imut = -11;
let is i32 as VK_ERROR_FRAGMENTED_POOL          with imut = -12;
let is i32 as VK_ERROR_UNKNOWN                  with imut = -13;

// --- Sizes the API fixes ---
//
// These are array lengths inside structs, so getting one wrong moves every
// field after it. tools/check_constants.sh compares them against the registry.
let is i64 as VK_MAX_PHYSICAL_DEVICE_NAME_SIZE  with imut = 256;
let is i64 as VK_MAX_EXTENSION_NAME_SIZE        with imut = 256;
let is i64 as VK_MAX_DESCRIPTION_SIZE           with imut = 256;
let is i64 as VK_MAX_MEMORY_TYPES               with imut = 32;
let is i64 as VK_MAX_MEMORY_HEAPS               with imut = 16;
let is i64 as VK_UUID_SIZE                      with imut = 16;

// --- VkStructureType ---
//
// Every struct that can be chained carries one as its first field, and the
// driver reads it to know what the rest of the bytes are. A wrong tag is not a
// compile error and not a crash: it is the driver interpreting a struct as a
// different struct.
let is i32 as VK_STRUCTURE_TYPE_APPLICATION_INFO      with imut = 0;
let is i32 as VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO  with imut = 1;

// --- VkPhysicalDeviceType ---
let is i32 as VK_PHYSICAL_DEVICE_TYPE_OTHER          with imut = 0;
let is i32 as VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU with imut = 1;
let is i32 as VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU   with imut = 2;
let is i32 as VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU    with imut = 3;
let is i32 as VK_PHYSICAL_DEVICE_TYPE_CPU            with imut = 4;

// --- Version numbers ---
//
// Packed into a u32 as variant:3 major:7 minor:10 patch:12. Vulkan spells these
// as macros; a macro is a function here, and they are the two places in this
// file where something is computed rather than declared.
fn VK_MAKE_API_VERSION(variant as u32, major as u32, minor as u32, patch as u32) as u32 {
    return (variant << 29) | (major << 22) | (minor << 12) | patch;
}

fn VK_API_VERSION_VARIANT(v as u32) as u32 { return v >> 29; }
fn VK_API_VERSION_MAJOR(v as u32)   as u32 { return (v >> 22) & cast(u32, 0x7F); }
fn VK_API_VERSION_MINOR(v as u32)   as u32 { return (v >> 12) & cast(u32, 0x3FF); }
fn VK_API_VERSION_PATCH(v as u32)   as u32 { return v & cast(u32, 0xFFF); }
