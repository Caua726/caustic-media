// input/state_test.cst — sampled state, fed: keys held by their place,
// buttons, motion and scrolling per frame, and CANCEL letting go.
use "std/io.cst" as io;
use "event.cst" as event;
use "state.cst" as state;
use "keys.cst" as keys;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is state.State as st with mut;

fn key(kind as i32, physical as i32, k as i32) as void {
    let is event.Event as e;
    event.clear(&e);
    e.kind = kind;
    e.physical = physical;
    e.key = k;
    e.shortcut = k;
    state.feed(&st, &e);
}

fn pointer(kind as i32, x as i64, y as i64, button as i32) as void {
    let is event.Event as e;
    event.clear(&e);
    e.kind = kind;
    e.x = x;
    e.y = y;
    e.button = button;
    state.feed(&st, &e);
}

fn main() as i32 {
    state.init(&st);
    check("nothing held at first", state.key_down(&st, keys.A) == 0 && state.button_down(&st, 1) == 0 && st.inside == 0);

    // --- Keys, by their place ---
    key(event.KEY_DOWN, 38, keys.A);
    check("held", state.key_down(&st, keys.A) == 1 && state.physical_down(&st, 38) == 1);
    key(event.KEY_DOWN, 38, keys.A);
    check("a repeat: still once", st.held == 1);
    key(event.KEY_DOWN, 52, keys.Z);
    // The layout changed while A's key was held: it is let go as Q.
    key(event.KEY_UP, 38, keys.Q);
    check("let go by its place, whatever the layout says", state.key_down(&st, keys.A) == 0 && state.physical_down(&st, 38) == 0 &&
          state.key_down(&st, keys.Z) == 1);
    key(event.KEY_UP, 99, keys.X);
    check("a key never held let go: nothing changes", st.held == 1);
    // A platform with no place for its keys: matched by the key.
    key(event.KEY_DOWN, 0, keys.ESCAPE);
    check("no place: held by its key", state.key_down(&st, keys.ESCAPE) == 1);
    key(event.KEY_UP, 0, keys.ESCAPE);
    check("and let go by it", state.key_down(&st, keys.ESCAPE) == 0 && state.key_down(&st, keys.Z) == 1);

    // --- Buttons and the pointer ---
    pointer(event.ENTER, 10, 20, 0);
    check("in, there, no motion yet", st.inside == 1 && st.x == 10 && st.y == 20 && st.dx == 0 && st.dy == 0);
    pointer(event.MOTION, 15, 18, 0);
    pointer(event.MOTION, 25, 30, 0);
    check("its motion this frame", st.dx == 15 && st.dy == 10 && st.x == 25 && st.y == 30);
    state.new_frame(&st);
    check("the next frame: none", st.dx == 0 && st.dy == 0);
    pointer(event.BUTTON_DOWN, 25, 30, 1);
    pointer(event.BUTTON_DOWN, 25, 30, 3);
    check("buttons held", state.button_down(&st, 1) == 1 && state.button_down(&st, 3) == 1 && state.button_down(&st, 2) == 0);
    pointer(event.BUTTON_UP, 25, 30, 1);
    check("one let go", state.button_down(&st, 1) == 0 && state.button_down(&st, 3) == 1);
    check("no button outside them", state.button_down(&st, 0) == 0 && state.button_down(&st, 32) == 0);
    pointer(event.LEAVE, 0, 0, 0);
    check("out", st.inside == 0);

    // --- Scrolling, per frame ---
    let is event.Event as s;
    event.clear(&s);
    s.kind = event.SCROLL;
    s.dy = 1.5;
    s.steps_y = 1;
    state.feed(&st, &s);
    state.feed(&st, &s);
    s.dy = 0.0;
    s.dx = 0.0 - 2.0;
    s.steps_y = 0;
    s.steps_x = 0 - 1;
    state.feed(&st, &s);
    check("scrolled: added up", st.scroll_y == 3.0 && st.steps_y == 2 && st.scroll_x == 0.0 - 2.0 && st.steps_x == 0 - 1);
    state.new_frame(&st);
    check("the next frame: none", st.scroll_y == 0.0 && st.steps_y == 0 && st.steps_x == 0);

    // --- CANCEL lets everything go ---
    key(event.KEY_DOWN, 38, keys.A);
    pointer(event.BUTTON_DOWN, 1, 1, 1);
    let is event.Event as c;
    event.clear(&c);
    c.kind = event.CANCEL;
    c.detail = event.CANCEL_FOCUS;
    state.feed(&st, &c);
    check("cancelled: no key, no button", state.key_down(&st, keys.A) == 0 && state.key_down(&st, keys.Z) == 0 &&
          state.button_down(&st, 1) == 0 && state.button_down(&st, 3) == 0 && st.modifiers == 0);
    key(event.KEY_UP, 38, keys.A);
    check("a release after it: nothing", st.held == 0);

    // --- As many held as it keeps ---
    let is i32 as i with mut = 0;
    while (i < 70) { key(event.KEY_DOWN, 100 + i, 1000 + i); i = i + 1; }
    check("no more than it keeps", st.held == state.MAX_HELD && state.physical_down(&st, 100) == 1 &&
          state.physical_down(&st, 100 + cast(i32, state.MAX_HELD)) == 0);

    if (fails == 0) {
        io.printf("input state: all checks passed\n");
        return 0;
    }
    io.printf("input state: %d failures\n", fails);
    return 1;
}
