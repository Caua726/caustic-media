// input/xkb/grow.cst — bytes that grow: a keymap's or a Compose table's
// records, one block each, doubled when full, so a place in it is an offset —
// a pointer into it would not survive the move.

use "std/mem.cst" as mem;

struct Grow {
    base as *u8;
    len  as i64;
    cap  as i64;
}

fn free(g as *Grow) as void {
    if (cast(i64, g.base) != 0) { mem.core.munmap(g.base, g.cap); }
    g.base = cast(*u8, 0); g.len = 0; g.cap = 0;
}

// n zeroed bytes more: their offset, -1 when memory is refused.
fn add(g as *Grow, n as i64) as i64 {
    if (g.len + n > g.cap) {
        let is i64 as cap with mut = g.cap * 2;
        if (cap < 4096) { cap = 4096; }
        while (cap < g.len + n) { cap = cap * 2; }
        let is *u8 as b = mem.core.mmap_anon(cap);
        if (cast(i64, b) == 0) { return 0 - 1; }
        if (g.len > 0) { mem.memcpy(b, g.base, g.len); }
        if (cast(i64, g.base) != 0) { mem.core.munmap(g.base, g.cap); }
        g.base = b; g.cap = cap;
    }
    let is i64 as off = g.len;
    mem.memzero(cast(*u8, cast(i64, g.base) + off), n);
    g.len = g.len + n;
    return off;
}

fn at(g as *Grow, off as i64) as *u8 { return cast(*u8, cast(i64, g.base) + off); }
