// input/xkb/keysym.cst — keysyms: by name, as characters, in either case.
//
// The tables are keysyms.cst, generated from xkbcommon-keysyms.h and the
// UCD (tools/gen_keysyms.py); what libxkbcommon says by rule rather than by
// table is said here by the same rules, so a keysym means what it means to
// libxkbcommon (xkb_test.cst checks every named keysym and every Unicode
// one).

use "keysyms.cst" as tab;

let is u32 as NO_SYMBOL   with imut = 0;
let is u32 as VOID_SYMBOL with imut = 0xffffff;
let is u32 as UNICODE_OFFSET with imut = 0x1000000;
let is u32 as MAX         with imut = 0x1fffffff;

fn _u32(blob as *u8, off as i64) as u32 {
    return cast(u32, blob[off]) | (cast(u32, blob[off + 1]) << 8)
         | (cast(u32, blob[off + 2]) << 16) | (cast(u32, blob[off + 3]) << 24);
}

// The name of n bytes against the NUL-terminated one at s: below 0, 0, above.
fn _compare(name as *u8, n as i64, s as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as a = cast(i32, name[i]);
        let is i32 as b = cast(i32, s[i]);
        if (b == 0 || a != b) { return a - b; }
        i = i + 1;
    }
    if (s[n] == 0) { return 0; }
    return 0 - 1;
}

fn _hex(name as *u8, n as i64, out as *u32) as i32 {
    if (n <= 0 || n > 8) { return 0; }
    let is u32 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as c = cast(i32, name[i]);
        let is u32 as d with mut = 0;
        if (c >= 48 && c <= 57) { d = cast(u32, c - 48); }
        else if (c >= 97 && c <= 102) { d = cast(u32, c - 87); }
        else if (c >= 65 && c <= 70) { d = cast(u32, c - 55); }
        else { return 0; }
        v = (v << 4) | d;
        i = i + 1;
    }
    *out = v;
    return 1;
}

// A character of 0xff or below as a keysym: its Latin-1 keysym, a control
// character's function key, else its Unicode keysym.
fn utf32_to_keysym(cp as u32) as u32 {
    if ((cp >= 0x20 && cp <= 0x7e) || (cp >= 0xa0 && cp <= 0xff)) { return cp; }
    if ((cp >= 0x08 && cp <= 0x0b) || cp == 0x0d || cp == 0x1b) { return cp | 0xff00; }
    if (cp == 0x7f) { return 0xffff; }
    if (cp == 0 || (cp >= 0xd800 && cp <= 0xdfff) || cp > 0x10ffff) { return NO_SYMBOL; }
    let is i64 as i with mut = 0;
    while (i < tab.N_UCS) {
        if (_u32(tab.UCS, i * 8 + 4) == cp) { return _u32(tab.UCS, i * 8); }
        i = i + 1;
    }
    return cp | UNICODE_OFFSET;
}

// The keysym named by the n bytes at name — a keysym's name, "U" and hex
// digits for a character, "0x" and hex digits for a value — or NO_SYMBOL.
fn from_name(name as *u8, n as i64) as u32 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = tab.N_NAMES - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is i32 as c = _compare(name, n, cast(*u8, cast(i64, tab.NAMES) + cast(i64, _u32(tab.NAME_INDEX, mid * 8))));
        if (c == 0) { return _u32(tab.NAME_INDEX, mid * 8 + 4); }
        if (c < 0) { hi = mid - 1; } else { lo = mid + 1; }
    }
    let is u32 as v with mut = 0;
    if (n > 1 && name[0] == 85) {
        if (_hex(cast(*u8, cast(i64, name) + 1), n - 1, &v) == 0) { return NO_SYMBOL; }
        if (v > 0xff && v <= 0x10ffff) { return v + UNICODE_OFFSET; }
        return utf32_to_keysym(v);
    }
    if (n > 2 && name[0] == 48 && name[1] == 120) {
        if (_hex(cast(*u8, cast(i64, name) + 2), n - 2, &v) == 0 || v > MAX) { return NO_SYMBOL; }
        return v;
    }
    // XKeysymDB's XF86_ names: the header's without the underscore.
    if (n > 5 && name[0] == 88 && name[1] == 70 && name[2] == 56 && name[3] == 54 && name[4] == 95) {
        let is [64]u8 as buf with mut;
        if (n - 1 > 64) { return NO_SYMBOL; }
        let is i64 as i with mut = 0;
        while (i < 4) { buf[i] = name[i]; i = i + 1; }
        while (i < n - 1) { buf[i] = name[i + 1]; i = i + 1; }
        return from_name(&buf[0], n - 1);
    }
    return NO_SYMBOL;
}

// The character a keysym types, 0 for none.
fn to_utf32(ks as u32) as u32 {
    if ((ks >= 0x20 && ks <= 0x7e) || (ks >= 0xa0 && ks <= 0xff)) { return ks; }
    if (ks == 0xff80) { return 0x20; }
    if ((ks >= 0xff08 && ks <= 0xff0b) || (ks >= 0xffaa && ks <= 0xffb9) || ks == 0xff0d || ks == 0xff1b ||
        ks == 0xffff || ks == 0xff89 || ks == 0xff8d || ks == 0xffbd) {
        return ks & 0x7f;
    }
    if (ks >= 0x100d800 && ks <= 0x100dfff) { return 0; }
    if (ks >= UNICODE_OFFSET && ks <= 0x110ffff) { return ks - UNICODE_OFFSET; }
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = tab.N_UCS - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is u32 as k = _u32(tab.UCS, mid * 8);
        if (k == ks) { return _u32(tab.UCS, mid * 8 + 4); }
        if (ks < k) { hi = mid - 1; } else { lo = mid + 1; }
    }
    return 0;
}

// The character's UTF-8 bytes written to out (room for 4); their count.
fn utf8(cp as u32, out as *u8) as i64 {
    if (cp < 0x80) { out[0] = cast(u8, cp); return 1; }
    if (cp < 0x800) {
        out[0] = cast(u8, 0xc0 | (cp >> 6)); out[1] = cast(u8, 0x80 | (cp & 0x3f));
        return 2;
    }
    if (cp < 0x10000) {
        out[0] = cast(u8, 0xe0 | (cp >> 12)); out[1] = cast(u8, 0x80 | ((cp >> 6) & 0x3f));
        out[2] = cast(u8, 0x80 | (cp & 0x3f));
        return 3;
    }
    out[0] = cast(u8, 0xf0 | (cp >> 18)); out[1] = cast(u8, 0x80 | ((cp >> 12) & 0x3f));
    out[2] = cast(u8, 0x80 | ((cp >> 6) & 0x3f)); out[3] = cast(u8, 0x80 | (cp & 0x3f));
    return 4;
}

// The keysym's character as UTF-8 at out (room for 4); 0 bytes for none.
fn to_utf8(ks as u32, out as *u8) as i64 {
    let is u32 as cp = to_utf32(ks);
    if (cp == 0) { return 0; }
    return utf8(cp, out);
}

// A keysym's case row: its legacy row's or its code point's offset in the
// table and the row's size, -1 for none.
fn _case_row(ks as u32, blob as *u8, rows as i64, key as u32) as i64 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = rows - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is u32 as k = _u32(blob, mid * 12);
        if (k == key) { return mid * 12; }
        if (key < k) { hi = mid - 1; } else { lo = mid + 1; }
    }
    return 0 - 1;
}

// ks in the case column (4 upper, 8 lower), ks itself when uncased.
fn _case(ks as u32, column as i64) as u32 {
    if (ks <= 0x13be) {
        let is i64 as at = _case_row(ks, tab.LEGACY_CASE, tab.N_LEGACY_CASE, ks);
        if (at < 0) { return ks; }
        return _u32(tab.LEGACY_CASE, at + column);
    }
    if (ks >= UNICODE_OFFSET + 0x100 && ks <= 0x101f189) {
        let is u32 as cp = ks - UNICODE_OFFSET;
        let is i64 as at = _case_row(ks, tab.UNICODE_CASE, tab.N_UNICODE_CASE, cp);
        if (at < 0) { return ks; }
        let is u32 as to = _u32(tab.UNICODE_CASE, at + column);
        if (to < 0x100) { return to; }
        return to + UNICODE_OFFSET;
    }
    return ks;
}

fn to_upper(ks as u32) as u32 { return _case(ks, 4); }
fn to_lower(ks as u32) as u32 { return _case(ks, 8); }

// A lower case letter: one with an upper case and no lower case.
fn is_lower(ks as u32) as i32 {
    return cast(i32, to_upper(ks) != ks && to_lower(ks) == ks);
}

// An upper or title case letter: one with a lower case.
fn is_upper_or_title(ks as u32) as i32 {
    return cast(i32, to_lower(ks) != ks);
}

fn is_keypad(ks as u32) as i32 {
    return cast(i32, ks >= 0xff80 && ks <= 0xffbd);
}

// Shift_L to Hyper_R, the ISO locks and level keys, Mode_switch, Num_Lock.
fn is_modifier(ks as u32) as i32 {
    return cast(i32, (ks >= 0xffe1 && ks <= 0xffee) || (ks >= 0xfe01 && ks <= 0xfe13) ||
                     ks == 0xff7e || ks == 0xff7f);
}
