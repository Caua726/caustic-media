// input/xkb/keymap.cst — an XKB keymap read from its text.
//
// The text is what a Wayland compositor sends (wl_keyboard.keymap, format
// xkb_v1): the four sections libxkbcommon writes — keycodes, types,
// compatibility, symbols — with keysyms by name or by value, any order of
// sections, comments and other sections (geometry) skipped. Read as
// libxkbcommon reads it, step by step: key names and aliases; key types with
// their real and virtual modifiers; interpretations sorted most specific
// first; each key's groups, levels, keysyms and explicit actions, its type
// named or found from its keysyms; then the derived fields — interpretations
// giving keys their actions, repeat and virtual modifiers, virtual modifiers
// their real ones through the keys' modifier maps, types and actions their
// effective masks. A syntax error refuses the keymap (null); what libxkbcommon
// only warns about — an unknown keysym, field or type — is skipped the same
// way. Not read: keycodes above MAX_KEYCODE (evdev's stop at 0x2ff + 8),
// LEDs, the v2 format's extensions.

use "std/mem.cst" as mem;
use "keysym.cst" as keysym;
use "grow.cst" as grow;

let is i32 as MAX_GROUPS  with imut = 4;
let is i32 as MAX_MODS    with imut = 32;
let is i32 as MAX_KEYCODE with imut = 0xfff;
let is u32 as REAL_MASK   with imut = 0xff;

let is i32 as MOD_SHIFT   with imut = 0;
let is i32 as MOD_LOCK    with imut = 1;
let is i32 as MOD_CONTROL with imut = 2;
let is i32 as MOD_MOD1    with imut = 3;
let is i32 as MOD_MOD4    with imut = 6;

// Action kinds, libxkbcommon's numbering.
let is i32 as ACT_NONE        with imut = 0;
let is i32 as ACT_VOID        with imut = 1;
let is i32 as ACT_MOD_SET     with imut = 2;
let is i32 as ACT_MOD_LATCH   with imut = 3;
let is i32 as ACT_MOD_LOCK    with imut = 4;
let is i32 as ACT_GROUP_SET   with imut = 5;
let is i32 as ACT_GROUP_LATCH with imut = 6;
let is i32 as ACT_GROUP_LOCK  with imut = 7;
let is i32 as ACT_PTR_MOVE    with imut = 8;
let is i32 as ACT_PTR_BUTTON  with imut = 9;
let is i32 as ACT_PTR_LOCK    with imut = 10;
let is i32 as ACT_PTR_DEFAULT with imut = 11;
let is i32 as ACT_TERMINATE   with imut = 12;
let is i32 as ACT_SWITCH_VT   with imut = 13;
let is i32 as ACT_CTRL_SET    with imut = 14;
let is i32 as ACT_CTRL_LOCK   with imut = 15;
let is i32 as ACT_PRIVATE     with imut = 17;

let is i32 as FLAG_CLEAR_LOCKS   with imut = 1;
let is i32 as FLAG_LATCH_TO_LOCK with imut = 2;
let is i32 as FLAG_NO_LOCK       with imut = 4;
let is i32 as FLAG_NO_UNLOCK     with imut = 8;
let is i32 as FLAG_MODMAP        with imut = 16;
let is i32 as FLAG_ABSOLUTE      with imut = 32;

// An interpretation's test of a key's modifier map.
let is i32 as PRED_NONE_OF        with imut = 0;
let is i32 as PRED_ANY_OF_OR_NONE with imut = 1;
let is i32 as PRED_ANY_OF         with imut = 2;
let is i32 as PRED_ALL_OF         with imut = 3;
let is i32 as PRED_EXACTLY        with imut = 4;

// What a key does with a group it has not got.
let is i32 as RANGE_WRAP     with imut = 0;
let is i32 as RANGE_SATURATE with imut = 1;
let is i32 as RANGE_REDIRECT with imut = 2;

let is i32 as EXPLICIT_INTERP  with imut = 2;
let is i32 as EXPLICIT_VMODMAP with imut = 4;
let is i32 as EXPLICIT_REPEAT  with imut = 8;
let is i32 as EXPLICIT_TYPES   with imut = 16;

let is i32 as GROUP_SYMS with imut = 1;
let is i32 as GROUP_ACTS with imut = 2;
let is i32 as GROUP_TYPE with imut = 4;

struct Action {
    kind  as i32;
    flags as i32;
    mods  as u32;   // as written: real and virtual
    mask  as u32;   // effective: real, and what virtual ones map to
    group as i32;
    _pad  as i32;
}

struct Entry {
    level as i32;
    mods  as u32;
    mask  as u32;   // 0 with mods not 0: unbound virtual modifiers, never matches
    pmods as u32;   // preserved, as written
    pmask as u32;
    _pad  as i32;
}

struct Type {
    name_at     as i64;
    name_len    as i64;
    mods        as u32;
    mask        as u32;
    num_levels  as i32;
    first_entry as i32;
    num_entries as i32;
    _pad        as i32;
}

struct Interp {
    sym      as u32;
    pred     as i32;
    mods     as u32;
    vmod     as i32;   // -1 for none
    one      as i32;   // useModMapMods = level1
    repeat   as i32;
    has      as i32;   // an action (not NoAction)
    _pad     as i32;
    action   as Action;
}

struct Level {
    first_sym    as i32;
    num_syms     as i32;
    first_action as i32;
    num_actions  as i32;
}

struct Group {
    kind             as i32;   // its type's index
    given            as i32;   // GROUP_* written for it
    named_type       as i32;   // the type written for it, -1 none
    explicit_actions as i32;
    first_level      as i32;
    num_levels       as i32;
}

struct Key {
    name_at      as i64;
    name_len     as i64;
    named        as i32;
    num_groups   as i32;
    range        as i32;
    redirect     as i32;
    explicit     as i32;
    repeats      as i32;
    vmodmap      as u32;
    modmap       as u32;
    default_type as i32;   // -1 none
    repeat_given as i32;   // -1 none, else 0 or 1
    touched      as i32;
    num_given    as i32;   // groups written
    groups       as [4]Group;
}

struct Keymap {
    text      as *u8;
    text_size as i64;
    min_key   as i32;
    max_key   as i32;
    keys      as *Key;
    keys_size as i64;
    num_mods  as i32;
    num_groups as i32;
    mod_at    as [32]i64;
    mod_len   as [32]i64;
    mapping   as [32]u32;
    explicit_vmods as u32;
    canonical as u32;
    types     as grow.Grow;
    entries   as grow.Grow;
    interps   as grow.Grow;
    levels    as grow.Grow;
    syms      as grow.Grow;
    actions   as grow.Grow;
    keycodes  as grow.Grow;   // name_at, name_len, keycode: i64 each
    aliases   as grow.Grow;   // alias at, len, real at, len: i64 each
    // Defaults the compatibility section sets for interpretations.
    dflt_one    as i32;
    dflt_repeat as i32;
    err       as i32;
    // Where the text was refused: the byte the reading was at.
    err_at    as i64;
    lex       as *Lex;
}

fn key(km as *Keymap, kc as i64) as *Key {
    if (kc < cast(i64, km.min_key) || kc > cast(i64, km.max_key)) { return cast(*Key, 0); }
    return cast(*Key, cast(i64, km.keys) + kc * sizeof(Key));
}
fn type_at(km as *Keymap, i as i64) as *Type { return cast(*Type, grow.at(&km.types, i * sizeof(Type))); }
fn entry_at(km as *Keymap, i as i64) as *Entry { return cast(*Entry, grow.at(&km.entries, i * sizeof(Entry))); }
fn interp_at(km as *Keymap, i as i64) as *Interp { return cast(*Interp, grow.at(&km.interps, i * sizeof(Interp))); }
fn level_at(km as *Keymap, i as i64) as *Level { return cast(*Level, grow.at(&km.levels, i * sizeof(Level))); }
fn sym_at(km as *Keymap, i as i64) as *u32 { return cast(*u32, grow.at(&km.syms, i * 4)); }
fn action_at(km as *Keymap, i as i64) as *Action { return cast(*Action, grow.at(&km.actions, i * sizeof(Action))); }
fn num_types(km as *Keymap) as i64 { return km.types.len / sizeof(Type); }
fn num_interps(km as *Keymap) as i64 { return km.interps.len / sizeof(Interp); }

fn free(km as *Keymap) as void {
    if (cast(i64, km) == 0) { return; }
    grow.free(&km.types); grow.free(&km.entries); grow.free(&km.interps);
    grow.free(&km.levels); grow.free(&km.syms); grow.free(&km.actions);
    grow.free(&km.keycodes); grow.free(&km.aliases);
    if (cast(i64, km.keys) != 0) { mem.core.munmap(cast(*u8, km.keys), km.keys_size); }
    if (cast(i64, km.text) != 0) { mem.core.munmap(km.text, km.text_size); }
    mem.core.munmap(cast(*u8, km), sizeof(Keymap));
}

// --- Group wrapping ---

// The layout a group falls in for a key of num groups: wrapped, clamped or
// redirected as the key says; -1 when it has none.
fn wrap_group(group as i32, num as i32, range as i32, redirect as i32) as i32 {
    if (num <= 0) { return 0 - 1; }
    if (group >= 0 && group < num) { return group; }
    if (range == RANGE_REDIRECT) {
        if (redirect >= num) { return 0; }
        return redirect;
    }
    if (range == RANGE_SATURATE) {
        if (group < 0) { return 0; }
        return num - 1;
    }
    let is i32 as rem = group % num;
    if (rem >= 0) { return rem; }
    return rem + num;
}

// --- Modifiers ---

// The real modifiers of a mask, and those its virtual ones map to.
fn effective(km as *Keymap, mods as u32) as u32 {
    let is u32 as mask with mut = mods & REAL_MASK;
    let is i32 as i with mut = 8;
    while (i < km.num_mods) {
        if ((mods & (cast(u32, 1) << cast(u32, i))) != 0) { mask = mask | km.mapping[i]; }
        i = i + 1;
    }
    return mask;
}

// A mask the compositor sent: what is canonical kept, the rest resolved.
fn canonical_mods(km as *Keymap, mods as u32) as u32 {
    return (mods & km.canonical) | effective(km, mods & (~km.canonical));
}

fn _same(a as *u8, an as i64, b as *u8, bn as i64) as i32 {
    if (an != bn) { return 0; }
    return cast(i32, mem.memcmp(a, b, an) == 0);
}

fn _text(km as *Keymap, at as i64) as *u8 { return cast(*u8, cast(i64, km.text) + at); }

// The modifier of this name, -1 for none.
fn mod_index(km as *Keymap, name as *u8, n as i64) as i32 {
    let is i32 as i with mut = 0;
    while (i < km.num_mods) {
        if (_same(_text(km, km.mod_at[i]), km.mod_len[i], name, n) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// --- Lexer ---

let is i32 as TOK_END     with imut = 1000;
let is i32 as TOK_IDENT   with imut = 1001;
let is i32 as TOK_INT     with imut = 1002;
let is i32 as TOK_STRING  with imut = 1003;
let is i32 as TOK_KEYNAME with imut = 1004;
let is i32 as TOK_FLOAT   with imut = 1005;
let is i32 as TOK_ERROR   with imut = 1006;

struct Lex {
    s     as *u8;
    n     as i64;
    pos   as i64;
    tok   as i32;
    digit as i32;   // a lone decimal digit: the keysym of that digit
    at    as i64;
    len   as i64;
    value as i64;
}

fn _space(c as i32) as i32 { return cast(i32, c == 32 || (c >= 9 && c <= 13)); }
fn _alpha(c as i32) as i32 { return cast(i32, (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95); }
fn _num(c as i32) as i32 { return cast(i32, c >= 48 && c <= 57); }

fn _c(lx as *Lex, i as i64) as i32 {
    if (i >= lx.n) { return 0; }
    return cast(i32, lx.s[i]);
}

fn next(lx as *Lex) as i32 {
    while (1 == 1) {
        while (lx.pos < lx.n && _space(_c(lx, lx.pos)) == 1) { lx.pos = lx.pos + 1; }
        let is i32 as c0 = _c(lx, lx.pos);
        let is i32 as c1 = _c(lx, lx.pos + 1);
        if (c0 == 35 || (c0 == 47 && c1 == 47)) {
            while (lx.pos < lx.n && _c(lx, lx.pos) != 10) { lx.pos = lx.pos + 1; }
        } else if (c0 == 47 && c1 == 42) {
            lx.pos = lx.pos + 2;
            while (lx.pos < lx.n && !(_c(lx, lx.pos) == 42 && _c(lx, lx.pos + 1) == 47)) { lx.pos = lx.pos + 1; }
            lx.pos = lx.pos + 2;
            if (lx.pos > lx.n) { lx.pos = lx.n; }
        } else {
            break;
        }
    }
    lx.at = lx.pos; lx.len = 0; lx.digit = 0;
    if (lx.pos >= lx.n) { lx.tok = TOK_END; return lx.tok; }
    let is i32 as c = _c(lx, lx.pos);
    if (c == 60) {
        lx.pos = lx.pos + 1;
        lx.at = lx.pos;
        while (lx.pos < lx.n && _c(lx, lx.pos) != 62 && _c(lx, lx.pos) > 32 && _c(lx, lx.pos) < 127) { lx.pos = lx.pos + 1; }
        if (_c(lx, lx.pos) != 62) { lx.tok = TOK_ERROR; return lx.tok; }
        lx.len = lx.pos - lx.at;
        lx.pos = lx.pos + 1;
        lx.tok = TOK_KEYNAME;
        return lx.tok;
    }
    if (c == 34) {
        lx.pos = lx.pos + 1;
        lx.at = lx.pos;
        while (lx.pos < lx.n && _c(lx, lx.pos) != 34) {
            if (_c(lx, lx.pos) == 92) { lx.pos = lx.pos + 1; }
            lx.pos = lx.pos + 1;
        }
        if (lx.pos >= lx.n) { lx.tok = TOK_ERROR; return lx.tok; }
        lx.len = lx.pos - lx.at;
        lx.pos = lx.pos + 1;
        lx.tok = TOK_STRING;
        return lx.tok;
    }
    if (_num(c) == 1) {
        let is i64 as v with mut = 0;
        if (c == 48 && (_c(lx, lx.pos + 1) == 120 || _c(lx, lx.pos + 1) == 88)) {
            lx.pos = lx.pos + 2;
            while (lx.pos < lx.n) {
                let is i32 as h = _c(lx, lx.pos);
                if (_num(h) == 1) { v = v * 16 + cast(i64, h - 48); }
                else if (h >= 97 && h <= 102) { v = v * 16 + cast(i64, h - 87); }
                else if (h >= 65 && h <= 70) { v = v * 16 + cast(i64, h - 55); }
                else { break; }
                lx.pos = lx.pos + 1;
            }
        } else {
            while (lx.pos < lx.n && _num(_c(lx, lx.pos)) == 1) {
                v = v * 10 + cast(i64, _c(lx, lx.pos) - 48);
                lx.pos = lx.pos + 1;
            }
            if (lx.pos - lx.at == 1) { lx.digit = 1; }
            if (_c(lx, lx.pos) == 46 && _num(_c(lx, lx.pos + 1)) == 1) {
                lx.pos = lx.pos + 1;
                while (lx.pos < lx.n && _num(_c(lx, lx.pos)) == 1) { lx.pos = lx.pos + 1; }
                lx.len = lx.pos - lx.at;
                lx.tok = TOK_FLOAT;
                return lx.tok;
            }
        }
        lx.value = v;
        lx.len = lx.pos - lx.at;
        lx.tok = TOK_INT;
        return lx.tok;
    }
    if (_alpha(c) == 1) {
        while (lx.pos < lx.n && (_alpha(_c(lx, lx.pos)) == 1 || _num(_c(lx, lx.pos)) == 1)) { lx.pos = lx.pos + 1; }
        lx.len = lx.pos - lx.at;
        lx.tok = TOK_IDENT;
        return lx.tok;
    }
    lx.pos = lx.pos + 1;
    lx.len = 1;
    lx.tok = c;
    return lx.tok;
}

fn _lower(c as i32) as i32 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

// The current identifier is word (ASCII, any case).
fn _is(lx as *Lex, word as *u8) as i32 {
    if (lx.tok != TOK_IDENT) { return 0; }
    let is i64 as i with mut = 0;
    while (i < lx.len) {
        if (word[i] == 0 || _lower(_c(lx, lx.at + i)) != _lower(cast(i32, word[i]))) { return 0; }
        i = i + 1;
    }
    return cast(i32, word[lx.len] == 0);
}

// The current identifier is prefix followed by a number (Group2, Level3):
// that number, else -1.
fn _numbered(lx as *Lex, prefix as *u8) as i64 {
    if (lx.tok != TOK_IDENT) { return 0 - 1; }
    let is i64 as i with mut = 0;
    while (prefix[i] != 0) {
        if (i >= lx.len || _lower(_c(lx, lx.at + i)) != cast(i32, prefix[i])) { return 0 - 1; }
        i = i + 1;
    }
    if (i >= lx.len) { return 0 - 1; }
    let is i64 as v with mut = 0;
    while (i < lx.len) {
        let is i32 as c = _c(lx, lx.at + i);
        if (_num(c) == 0) { return 0 - 1; }
        v = v * 10 + cast(i64, c - 48);
        i = i + 1;
    }
    return v;
}

// Past the statement the current token begins: to its ';' at this depth,
// or to the '}' that ends the body (left as the current token).
fn _skip(lx as *Lex) as void {
    let is i32 as depth with mut = 0;
    while (lx.tok != TOK_END && lx.tok != TOK_ERROR) {
        if (lx.tok == 123 || lx.tok == 40 || lx.tok == 91) { depth = depth + 1; }
        if (lx.tok == 125 || lx.tok == 41 || lx.tok == 93) {
            if (depth == 0) { return; }
            depth = depth - 1;
        }
        if (lx.tok == 59 && depth == 0) { next(lx); return; }
        next(lx);
    }
}

fn _fail(km as *Keymap) as void {
    if (km.err == 0 && cast(i64, km.lex) != 0) { km.err_at = km.lex.at; }
    km.err = 1;
}

fn _expect(km as *Keymap, lx as *Lex, tok as i32) as i32 {
    if (lx.tok != tok) { _fail(km); return 0; }
    next(lx);
    return 1;
}

// --- Expressions ---

// A modifier mask: names joined by + or |, - taking some away, all, none,
// numbers; virtual names too when vmods. Stops before , ; ) ] }. ok 0 when
// a name is unknown.
fn _mask(km as *Keymap, lx as *Lex, vmods as i32, ok as *i32) as u32 {
    let is u32 as out with mut = 0;
    let is i32 as sign with mut = 1;
    *ok = 1;
    while (1 == 1) {
        let is u32 as term with mut = 0;
        if (lx.tok == 40) {
            next(lx);
            term = _mask(km, lx, vmods, ok);
            if (lx.tok != 41) { _fail(km); return 0; }
            next(lx);
        } else if (lx.tok == 126) {
            next(lx);
            term = ~_mask(km, lx, vmods, ok);
        } else if (lx.tok == TOK_INT) {
            term = cast(u32, lx.value);
            next(lx);
        } else if (lx.tok == TOK_IDENT) {
            if (_is(lx, "all") == 1) { term = REAL_MASK; }
            else if (_is(lx, "none") == 1) { term = 0; }
            else {
                let is i32 as m = mod_index(km, _text(km, lx.at), lx.len);
                if (m < 0 || (vmods == 0 && m >= 8)) { *ok = 0; }
                else { term = cast(u32, 1) << cast(u32, m); }
            }
            next(lx);
        } else {
            _fail(km);
            return 0;
        }
        if (sign > 0) { out = out | term; } else { out = out & (~term); }
        if (lx.tok == 43 || lx.tok == 124) { sign = 1; next(lx); }
        else if (lx.tok == 45) { sign = 0 - 1; next(lx); }
        else { return out; }
    }
    return out;
}

// true/yes/on 1, false/no/off 0, -1 otherwise (the identifier consumed).
fn _boolean(lx as *Lex) as i32 {
    let is i32 as v with mut = 0 - 1;
    if (_is(lx, "true") == 1 || _is(lx, "yes") == 1 || _is(lx, "on") == 1) { v = 1; }
    if (_is(lx, "false") == 1 || _is(lx, "no") == 1 || _is(lx, "off") == 1) { v = 0; }
    next(lx);
    return v;
}

// A group or level index, 1-based: a number, GroupN or LevelN; -1 if not.
fn _index(lx as *Lex, prefix as *u8) as i64 {
    let is i64 as v with mut = 0 - 1;
    if (lx.tok == TOK_INT) { v = lx.value; }
    else { v = _numbered(lx, prefix); }
    next(lx);
    return v;
}

// A keysym as written: a name, a lone digit, a number; NO_SYMBOL when unknown.
fn _keysym(km as *Keymap, lx as *Lex) as u32 {
    let is u32 as sym with mut = keysym.NO_SYMBOL;
    if (lx.tok == TOK_INT) {
        if (lx.digit == 1) { sym = cast(u32, 0x30 + lx.value); }
        else if (lx.value >= 0 && lx.value <= cast(i64, keysym.MAX)) { sym = cast(u32, lx.value); }
    } else if (lx.tok == TOK_IDENT) {
        if (_is(lx, "any") == 1 || _is(lx, "nosymbol") == 1) { sym = keysym.NO_SYMBOL; }
        else if (_is(lx, "none") == 1 || _is(lx, "voidsymbol") == 1) { sym = keysym.VOID_SYMBOL; }
        else { sym = keysym.from_name(_text(km, lx.at), lx.len); }
    } else {
        _fail(km);
    }
    next(lx);
    return sym;
}

// --- Virtual modifiers ---

fn _vmods(km as *Keymap, lx as *Lex) as void {
    next(lx);
    while (lx.tok == TOK_IDENT) {
        let is i32 as m with mut = mod_index(km, _text(km, lx.at), lx.len);
        if (m < 0) {
            if (km.num_mods >= MAX_MODS) { _fail(km); return; }
            m = km.num_mods;
            km.mod_at[m] = lx.at; km.mod_len[m] = lx.len; km.mapping[m] = 0;
            km.num_mods = km.num_mods + 1;
        }
        next(lx);
        if (lx.tok == 61) {
            next(lx);
            let is i32 as ok with mut = 1;
            let is u32 as v = _mask(km, lx, 0, &ok);
            if (m >= 8 && ok == 1) {
                km.mapping[m] = v;
                km.explicit_vmods = km.explicit_vmods | (cast(u32, 1) << cast(u32, m));
            }
        }
        if (lx.tok == 44) { next(lx); }
    }
    _expect(km, lx, 59);
}

// --- Keycodes ---

fn _keycodes(km as *Keymap, lx as *Lex) as void {
    next(lx);
    while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
        if (lx.tok == TOK_KEYNAME) {
            let is i64 as at = lx.at;
            let is i64 as len = lx.len;
            next(lx);
            if (_expect(km, lx, 61) == 0) { return; }
            if (lx.tok != TOK_INT) { _fail(km); return; }
            let is i64 as kc = lx.value;
            next(lx);
            if (_expect(km, lx, 59) == 0) { return; }
            if (kc <= cast(i64, MAX_KEYCODE)) {
                // A name or keycode given again: the later wins.
                let is i64 as n = km.keycodes.len / 24;
                let is i64 as i with mut = 0;
                while (i < n) {
                    let is *i64 as e = cast(*i64, grow.at(&km.keycodes, i * 24));
                    if (e[2] == kc || _same(_text(km, e[0]), e[1], _text(km, at), len) == 1) { e[2] = 0 - 1; }
                    i = i + 1;
                }
                let is i64 as off = grow.add(&km.keycodes, 24);
                if (off < 0) { _fail(km); return; }
                let is *i64 as e = cast(*i64, grow.at(&km.keycodes, off));
                e[0] = at; e[1] = len; e[2] = kc;
            }
        } else if (_is(lx, "alias") == 1) {
            next(lx);
            if (lx.tok != TOK_KEYNAME) { _fail(km); return; }
            let is i64 as aat = lx.at;
            let is i64 as alen = lx.len;
            next(lx);
            if (_expect(km, lx, 61) == 0) { return; }
            if (lx.tok != TOK_KEYNAME) { _fail(km); return; }
            let is i64 as off = grow.add(&km.aliases, 32);
            if (off < 0) { _fail(km); return; }
            let is *i64 as a = cast(*i64, grow.at(&km.aliases, off));
            a[0] = aat; a[1] = alen; a[2] = lx.at; a[3] = lx.len;
            next(lx);
            if (_expect(km, lx, 59) == 0) { return; }
        } else {
            _skip(lx);
        }
    }
}

// The keys of the keycodes read, min to max of them (8 to 255 for none).
fn _make_keys(km as *Keymap) as i32 {
    let is i64 as n = km.keycodes.len / 24;
    let is i64 as lo with mut = 0 - 1;
    let is i64 as hi with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is *i64 as e = cast(*i64, grow.at(&km.keycodes, i * 24));
        if (e[2] >= 0) {
            if (lo < 0 || e[2] < lo) { lo = e[2]; }
            if (e[2] > hi) { hi = e[2]; }
        }
        i = i + 1;
    }
    if (lo < 0) { lo = 8; hi = 255; }
    km.min_key = cast(i32, lo);
    km.max_key = cast(i32, hi);
    km.keys_size = (hi + 1) * sizeof(Key);
    km.keys = cast(*Key, mem.core.mmap_anon(km.keys_size));
    if (cast(i64, km.keys) == 0) { return 0; }
    i = 0;
    while (i <= hi) {
        let is *Key as k = cast(*Key, cast(i64, km.keys) + i * sizeof(Key));
        k.default_type = 0 - 1;
        k.repeat_given = 0 - 1;
        let is i32 as g with mut = 0;
        while (g < MAX_GROUPS) { k.groups[g].named_type = 0 - 1; g = g + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        let is *i64 as e = cast(*i64, grow.at(&km.keycodes, i * 24));
        if (e[2] >= 0) {
            let is *Key as k = key(km, e[2]);
            k.name_at = e[0]; k.name_len = e[1]; k.named = 1;
        }
        i = i + 1;
    }
    return 1;
}

// The keycode a key name or alias names, -1 for none.
fn key_by_name(km as *Keymap, name as *u8, n as i64) as i64 {
    let is i64 as kc with mut = cast(i64, km.min_key);
    while (kc <= cast(i64, km.max_key)) {
        let is *Key as k = key(km, kc);
        if (k.named == 1 && _same(_text(km, k.name_at), k.name_len, name, n) == 1) { return kc; }
        kc = kc + 1;
    }
    let is i64 as na = km.aliases.len / 32;
    let is i64 as i with mut = 0;
    while (i < na) {
        let is *i64 as a = cast(*i64, grow.at(&km.aliases, i * 32));
        if (_same(_text(km, a[0]), a[1], name, n) == 1) {
            kc = cast(i64, km.min_key);
            while (kc <= cast(i64, km.max_key)) {
                let is *Key as k = key(km, kc);
                if (k.named == 1 && _same(_text(km, k.name_at), k.name_len, _text(km, a[2]), a[3]) == 1) { return kc; }
                kc = kc + 1;
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// --- Types ---

fn type_by_name(km as *Keymap, name as *u8, n as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < num_types(km)) {
        let is *Type as t = type_at(km, i);
        if (_same(_text(km, t.name_at), t.name_len, name, n) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// The entry of t for these modifiers, appended at level 1 when new.
fn _entry_for(km as *Keymap, ti as i64, mods as u32) as *Entry {
    let is *Type as t = type_at(km, ti);
    let is i64 as i with mut = 0;
    while (i < cast(i64, t.num_entries)) {
        let is *Entry as e = entry_at(km, cast(i64, t.first_entry) + i);
        if (e.mods == mods) { return e; }
        i = i + 1;
    }
    let is i64 as off = grow.add(&km.entries, sizeof(Entry));
    if (off < 0) { _fail(km); return cast(*Entry, 0); }
    t.num_entries = t.num_entries + 1;
    let is *Entry as e = entry_at(km, off / sizeof(Entry));
    e.mods = mods;
    return e;
}

fn _type(km as *Keymap, lx as *Lex) as void {
    next(lx);
    if (lx.tok != TOK_STRING) { _fail(km); return; }
    let is i64 as at = lx.at;
    let is i64 as len = lx.len;
    next(lx);
    if (_expect(km, lx, 123) == 0) { return; }
    let is i64 as off = grow.add(&km.types, sizeof(Type));
    if (off < 0) { _fail(km); return; }
    let is i64 as ti = off / sizeof(Type);
    let is *Type as t = type_at(km, ti);
    t.name_at = at; t.name_len = len; t.num_levels = 1;
    t.first_entry = cast(i32, km.entries.len / sizeof(Entry));
    while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
        let is i32 as field with mut = 0;
        if (_is(lx, "modifiers") == 1) { field = 1; }
        else if (_is(lx, "map") == 1) { field = 2; }
        else if (_is(lx, "preserve") == 1) { field = 3; }
        if (field == 0) { _skip(lx); continue; }
        next(lx);
        let is u32 as index with mut = 0;
        let is i32 as ok with mut = 1;
        if (field != 1) {
            if (_expect(km, lx, 91) == 0) { return; }
            index = _mask(km, lx, 1, &ok);
            if (_expect(km, lx, 93) == 0) { return; }
            index = index & type_at(km, ti).mods;
        }
        if (_expect(km, lx, 61) == 0) { return; }
        if (field == 1) {
            let is u32 as m = _mask(km, lx, 1, &ok);
            if (ok == 1) { type_at(km, ti).mods = m; }
        } else if (field == 2) {
            let is i64 as level = _index(lx, "level");
            if (ok == 1 && level >= 1) {
                let is *Entry as e = _entry_for(km, ti, index);
                if (cast(i64, e) == 0) { return; }
                e.level = cast(i32, level - 1);
                if (cast(i32, level) > t.num_levels) { t.num_levels = cast(i32, level); }
            }
        } else {
            let is u32 as p = _mask(km, lx, 1, &ok);
            if (ok == 1) {
                let is *Entry as e = _entry_for(km, ti, index);
                if (cast(i64, e) == 0) { return; }
                e.pmods = p;
            }
        }
        if (_expect(km, lx, 59) == 0) { return; }
    }
    if (_expect(km, lx, 125) == 0) { return; }
    _expect(km, lx, 59);
    // A type given again: the later one, where the first was.
    let is i64 as old = type_by_name(km, _text(km, at), len);
    if (old >= 0 && old != ti) {
        mem.memcpy(cast(*u8, type_at(km, old)), cast(*u8, type_at(km, ti)), sizeof(Type));
        km.types.len = km.types.len - sizeof(Type);
    }
}

fn _types(km as *Keymap, lx as *Lex) as void {
    next(lx);
    while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
        if (_is(lx, "virtual_modifiers") == 1) { _vmods(km, lx); }
        else if (_is(lx, "type") == 1) { _type(km, lx); }
        else { _skip(lx); }
    }
}

// --- Actions ---

fn _action_kind(lx as *Lex) as i32 {
    if (_is(lx, "NoAction") == 1) { return ACT_NONE; }
    if (_is(lx, "VoidAction") == 1) { return ACT_VOID; }
    if (_is(lx, "SetMods") == 1) { return ACT_MOD_SET; }
    if (_is(lx, "LatchMods") == 1) { return ACT_MOD_LATCH; }
    if (_is(lx, "LockMods") == 1) { return ACT_MOD_LOCK; }
    if (_is(lx, "SetGroup") == 1) { return ACT_GROUP_SET; }
    if (_is(lx, "LatchGroup") == 1) { return ACT_GROUP_LATCH; }
    if (_is(lx, "LockGroup") == 1) { return ACT_GROUP_LOCK; }
    if (_is(lx, "MovePtr") == 1 || _is(lx, "MovePointer") == 1) { return ACT_PTR_MOVE; }
    if (_is(lx, "PtrBtn") == 1 || _is(lx, "PointerButton") == 1) { return ACT_PTR_BUTTON; }
    if (_is(lx, "LockPtrBtn") == 1 || _is(lx, "LockPtrButton") == 1 || _is(lx, "LockPointerButton") == 1 ||
        _is(lx, "LockPointerBtn") == 1) { return ACT_PTR_LOCK; }
    if (_is(lx, "SetPtrDflt") == 1 || _is(lx, "SetPointerDefault") == 1) { return ACT_PTR_DEFAULT; }
    if (_is(lx, "Terminate") == 1 || _is(lx, "TerminateServer") == 1) { return ACT_TERMINATE; }
    if (_is(lx, "SwitchScreen") == 1) { return ACT_SWITCH_VT; }
    if (_is(lx, "SetControls") == 1) { return ACT_CTRL_SET; }
    if (_is(lx, "LockControls") == 1) { return ACT_CTRL_LOCK; }
    if (_is(lx, "Private") == 1) { return ACT_PRIVATE; }
    // The X server's actions libxkbcommon keeps none of: no action.
    return ACT_NONE;
}

// Past an argument's value: to the , or ) that ends it.
fn _skip_value(lx as *Lex) as void {
    let is i32 as depth with mut = 0;
    while (lx.tok != TOK_END && lx.tok != TOK_ERROR) {
        if (depth == 0 && (lx.tok == 44 || lx.tok == 41)) { return; }
        if (lx.tok == 40 || lx.tok == 91) { depth = depth + 1; }
        if (lx.tok == 41 || lx.tok == 93) { depth = depth - 1; }
        next(lx);
    }
}

// Name(arguments): the action, its modifiers and group as written.
fn _action(km as *Keymap, lx as *Lex, out as *Action) as void {
    mem.memzero(cast(*u8, out), sizeof(Action));
    if (lx.tok != TOK_IDENT) { _fail(km); return; }
    out.kind = _action_kind(lx);
    next(lx);
    if (_expect(km, lx, 40) == 0) { return; }
    while (km.err == 0 && lx.tok != 41 && lx.tok != TOK_END) {
        let is i32 as negated with mut = 0;
        if (lx.tok == 33 || lx.tok == 126) { negated = 1; next(lx); }
        if (lx.tok != TOK_IDENT) { _fail(km); return; }
        let is i32 as field with mut = 0;
        if (_is(lx, "modifiers") == 1 || _is(lx, "mods") == 1) { field = 1; }
        else if (_is(lx, "group") == 1) { field = 2; }
        else if (_is(lx, "clearLocks") == 1) { field = 3; }
        else if (_is(lx, "latchToLock") == 1) { field = 4; }
        else if (_is(lx, "affect") == 1) { field = 5; }
        next(lx);
        if (lx.tok == 91) { _skip_value(lx); }
        if (lx.tok == 61) {
            next(lx);
            if (field == 1) {
                if (_is(lx, "modMapMods") == 1 || _is(lx, "useModMapMods") == 1) {
                    out.flags = out.flags | FLAG_MODMAP;
                    next(lx);
                } else {
                    let is i32 as ok with mut = 1;
                    out.mods = _mask(km, lx, 1, &ok);
                }
            } else if (field == 2) {
                let is i32 as sign with mut = 0;
                if (lx.tok == 43) { sign = 1; next(lx); }
                else if (lx.tok == 45) { sign = 0 - 1; next(lx); }
                let is i64 as g = _index(lx, "group");
                if (sign == 0) {
                    out.group = cast(i32, g - 1);
                    out.flags = out.flags | FLAG_ABSOLUTE;
                } else {
                    out.group = cast(i32, g) * sign;
                }
            } else if (field == 3 || field == 4) {
                let is i32 as v = _boolean(lx);
                let is i32 as bit with mut = FLAG_CLEAR_LOCKS;
                if (field == 4) { bit = FLAG_LATCH_TO_LOCK; }
                if (v == 1) { out.flags = out.flags | bit; }
                if (v == 0) { out.flags = out.flags & (~bit); }
            } else if (field == 5) {
                out.flags = out.flags & (~(FLAG_NO_LOCK | FLAG_NO_UNLOCK));
                if (_is(lx, "lock") == 1) { out.flags = out.flags | FLAG_NO_UNLOCK; }
                if (_is(lx, "unlock") == 1) { out.flags = out.flags | FLAG_NO_LOCK; }
                if (_is(lx, "neither") == 1) { out.flags = out.flags | FLAG_NO_LOCK | FLAG_NO_UNLOCK; }
                next(lx);
            }
            _skip_value(lx);
        } else if (field == 3 || field == 4) {
            let is i32 as bit with mut = FLAG_CLEAR_LOCKS;
            if (field == 4) { bit = FLAG_LATCH_TO_LOCK; }
            if (negated == 0) { out.flags = out.flags | bit; } else { out.flags = out.flags & (~bit); }
        }
        if (lx.tok == 44) { next(lx); }
    }
    _expect(km, lx, 41);
}

// --- Compatibility ---

fn _interp(km as *Keymap, lx as *Lex) as void {
    next(lx);
    if (lx.tok == 46) {
        // interpret.field = value: a default for those that follow.
        next(lx);
        if (_is(lx, "useModMapMods") == 1 || _is(lx, "useModMap") == 1) {
            next(lx);
            if (_expect(km, lx, 61) == 0) { return; }
            km.dflt_one = cast(i32, _is(lx, "level1") == 1 || _is(lx, "levelone") == 1);
            next(lx);
        } else if (_is(lx, "repeat") == 1) {
            next(lx);
            if (_expect(km, lx, 61) == 0) { return; }
            let is i32 as v = _boolean(lx);
            if (v >= 0) { km.dflt_repeat = v; }
        }
        _skip(lx);
        return;
    }
    let is Interp as si with mut;
    mem.memzero(cast(*u8, &si), sizeof(Interp));
    si.vmod = 0 - 1;
    si.one = km.dflt_one;
    si.repeat = km.dflt_repeat;
    si.sym = _keysym(km, lx);
    si.pred = PRED_ANY_OF_OR_NONE;
    si.mods = REAL_MASK;
    let is i32 as ok with mut = 1;
    if (lx.tok == 43) {
        next(lx);
        si.pred = PRED_EXACTLY;
        let is i32 as pred with mut = 0 - 1;
        if (_is(lx, "NoneOf") == 1) { pred = PRED_NONE_OF; }
        else if (_is(lx, "AnyOfOrNone") == 1) { pred = PRED_ANY_OF_OR_NONE; }
        else if (_is(lx, "AnyOf") == 1) { pred = PRED_ANY_OF; }
        else if (_is(lx, "AllOf") == 1) { pred = PRED_ALL_OF; }
        else if (_is(lx, "Exactly") == 1) { pred = PRED_EXACTLY; }
        if (pred >= 0) {
            next(lx);
            if (_expect(km, lx, 40) == 0) { return; }
            si.pred = pred;
            si.mods = _mask(km, lx, 0, &ok);
            if (_expect(km, lx, 41) == 0) { return; }
        } else if (_is(lx, "any") == 1) {
            next(lx);
            si.pred = PRED_ANY_OF;
            si.mods = REAL_MASK;
        } else {
            si.mods = _mask(km, lx, 0, &ok);
        }
    }
    if (_expect(km, lx, 123) == 0) { return; }
    while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
        if (_is(lx, "action") == 1) {
            next(lx);
            if (_expect(km, lx, 61) == 0) { return; }
            _action(km, lx, &si.action);
            si.has = cast(i32, si.action.kind != ACT_NONE);
            _expect(km, lx, 59);
        } else if (_is(lx, "virtualModifier") == 1 || _is(lx, "virtualMod") == 1) {
            next(lx);
            if (_expect(km, lx, 61) == 0) { return; }
            let is i32 as m = mod_index(km, _text(km, lx.at), lx.len);
            if (m >= 8) { si.vmod = m; }
            next(lx);
            _expect(km, lx, 59);
        } else if (_is(lx, "useModMapMods") == 1 || _is(lx, "useModMap") == 1) {
            next(lx);
            if (_expect(km, lx, 61) == 0) { return; }
            si.one = cast(i32, _is(lx, "level1") == 1 || _is(lx, "levelone") == 1);
            next(lx);
            _expect(km, lx, 59);
        } else if (_is(lx, "repeat") == 1) {
            next(lx);
            if (_expect(km, lx, 61) == 0) { return; }
            let is i32 as v = _boolean(lx);
            if (v >= 0) { si.repeat = v; }
            _expect(km, lx, 59);
        } else {
            _skip(lx);
        }
    }
    if (_expect(km, lx, 125) == 0) { return; }
    _expect(km, lx, 59);
    if (ok == 0) { return; }
    // The same keysym and test again: the later one.
    let is i64 as i with mut = 0;
    while (i < num_interps(km)) {
        let is *Interp as o = interp_at(km, i);
        if (o.sym == si.sym && o.pred == si.pred && o.mods == si.mods) {
            mem.memcpy(cast(*u8, o), cast(*u8, &si), sizeof(Interp));
            return;
        }
        i = i + 1;
    }
    let is i64 as off = grow.add(&km.interps, sizeof(Interp));
    if (off < 0) { _fail(km); return; }
    mem.memcpy(grow.at(&km.interps, off), cast(*u8, &si), sizeof(Interp));
}

fn _compat(km as *Keymap, lx as *Lex) as void {
    next(lx);
    while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
        if (_is(lx, "virtual_modifiers") == 1) { _vmods(km, lx); }
        else if (_is(lx, "interpret") == 1) { _interp(km, lx); }
        else { _skip(lx); }
    }
}

// Most specific first: with a keysym before without, then Exactly, AllOf,
// NoneOf, AnyOf, AnyOfOrNone — each in the order written.
fn _sort_interps(km as *Keymap) as i32 {
    let is i64 as n = num_interps(km);
    if (n == 0) { return 1; }
    let is i64 as size = n * sizeof(Interp);
    let is *u8 as sorted = mem.core.mmap_anon(size);
    if (cast(i64, sorted) == 0) { return 0; }
    let is i64 as out with mut = 0;
    let is i32 as with_sym with mut = 1;
    while (with_sym >= 0) {
        let is i32 as round with mut = 0;
        while (round < 5) {
            let is i32 as pred with mut = PRED_EXACTLY;
            if (round == 1) { pred = PRED_ALL_OF; }
            if (round == 2) { pred = PRED_NONE_OF; }
            if (round == 3) { pred = PRED_ANY_OF; }
            if (round == 4) { pred = PRED_ANY_OF_OR_NONE; }
            let is i64 as i with mut = 0;
            while (i < n) {
                let is *Interp as si = interp_at(km, i);
                if (si.pred == pred && cast(i32, si.sym != keysym.NO_SYMBOL) == with_sym) {
                    mem.memcpy(cast(*u8, cast(i64, sorted) + out * sizeof(Interp)), cast(*u8, si), sizeof(Interp));
                    out = out + 1;
                }
                i = i + 1;
            }
            round = round + 1;
        }
        with_sym = with_sym - 1;
    }
    mem.memcpy(km.interps.base, sorted, size);
    mem.core.munmap(sorted, size);
    return 1;
}

// --- Symbols ---

// The group's levels made room for: at least n, the old ones kept.
fn _levels(km as *Keymap, kc as i64, g as i32, n as i32) as i32 {
    let is *Key as k = key(km, kc);
    let is i32 as have = k.groups[g].num_levels;
    if (have >= n) { return 1; }
    let is i64 as off = grow.add(&km.levels, cast(i64, n) * sizeof(Level));
    if (off < 0) { _fail(km); return 0; }
    let is i64 as first = off / sizeof(Level);
    if (have > 0) {
        mem.memcpy(cast(*u8, level_at(km, first)), cast(*u8, level_at(km, cast(i64, k.groups[g].first_level))),
                   cast(i64, have) * sizeof(Level));
    }
    k.groups[g].first_level = cast(i32, first);
    k.groups[g].num_levels = n;
    return 1;
}

// The group a list goes to: its index written, else the first without one.
fn _group_of(km as *Keymap, lx as *Lex, k as *Key, what as i32) as i32 {
    if (lx.tok == 91) {
        next(lx);
        let is i64 as g = _index(lx, "group");
        if (_expect(km, lx, 93) == 0) { return 0 - 1; }
        if (g < 1 || g > cast(i64, MAX_GROUPS)) { return 0 - 1; }
        return cast(i32, g - 1);
    }
    return _first_free(k, what);
}

// The first group nothing of this kind was written for, -1 for none.
fn _first_free(k as *Key, what as i32) as i32 {
    let is i32 as g with mut = 0;
    while (g < MAX_GROUPS) {
        if ((k.groups[g].given & what) == 0) { return g; }
        g = g + 1;
    }
    return 0 - 1;
}

// [ level, level, ... ]: each a keysym, { keysyms } or "string".
fn _symbols(km as *Keymap, lx as *Lex, kc as i64, g as i32) as void {
    if (_expect(km, lx, 91) == 0) { return; }
    let is i64 as start = km.syms.len / 4;
    // Each level as its keysyms' first index and count, kept in a scratch
    // list until the level count is known.
    let is [64]i64 as firsts with mut;
    let is [64]i32 as counts with mut;
    let is i32 as n with mut = 0;
    let is i32 as nonempty with mut = 0;
    while (km.err == 0 && lx.tok != 93 && lx.tok != TOK_END) {
        let is i64 as first = km.syms.len / 4;
        let is i32 as count with mut = 0;
        if (lx.tok == 123) {
            next(lx);
            while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
                let is u32 as sym = _keysym(km, lx);
                if (sym != keysym.NO_SYMBOL) {
                    let is i64 as off = grow.add(&km.syms, 4);
                    if (off < 0) { _fail(km); return; }
                    *sym_at(km, off / 4) = sym;
                    count = count + 1;
                }
                if (lx.tok == 44) { next(lx); }
            }
            if (_expect(km, lx, 125) == 0) { return; }
        } else if (lx.tok == TOK_STRING) {
            // A string: the keysym of each character in it.
            let is i64 as i with mut = 0;
            while (i < lx.len) {
                let is i32 as c = _c(lx, lx.at + i);
                let is u32 as cp with mut = cast(u32, c);
                let is i64 as extra with mut = 0;
                if (c >= 0xf0) { cp = cast(u32, c & 7); extra = 3; }
                else if (c >= 0xe0) { cp = cast(u32, c & 15); extra = 2; }
                else if (c >= 0xc0) { cp = cast(u32, c & 31); extra = 1; }
                let is i64 as j with mut = 1;
                while (j <= extra) { cp = (cp << 6) | cast(u32, _c(lx, lx.at + i + j) & 63); j = j + 1; }
                i = i + 1 + extra;
                let is u32 as sym with mut = cp + keysym.UNICODE_OFFSET;
                if (cp <= 0xff) { sym = keysym.utf32_to_keysym(cp); }
                if (sym != keysym.NO_SYMBOL) {
                    let is i64 as off = grow.add(&km.syms, 4);
                    if (off < 0) { _fail(km); return; }
                    *sym_at(km, off / 4) = sym;
                    count = count + 1;
                }
            }
            next(lx);
        } else {
            let is u32 as sym = _keysym(km, lx);
            if (sym != keysym.NO_SYMBOL) {
                let is i64 as off = grow.add(&km.syms, 4);
                if (off < 0) { _fail(km); return; }
                *sym_at(km, off / 4) = sym;
                count = count + 1;
            }
        }
        if (n < 64) {
            firsts[n] = first; counts[n] = count;
            n = n + 1;
            if (count > 0) { nonempty = n; }
        }
        if (lx.tok == 44) { next(lx); }
    }
    if (_expect(km, lx, 93) == 0) { return; }
    if (g < 0) { return; }
    let is *Key as k = key(km, kc);
    if (g + 1 > k.num_given) { k.num_given = g + 1; }
    if ((k.groups[g].given & GROUP_SYMS) != 0) { return; }
    k.groups[g].given = k.groups[g].given | GROUP_SYMS;
    if (_levels(km, kc, g, nonempty) == 0) { return; }
    let is i32 as l with mut = 0;
    while (l < nonempty) {
        let is *Level as lv = level_at(km, cast(i64, k.groups[g].first_level + l));
        lv.first_sym = cast(i32, firsts[l]);
        lv.num_syms = counts[l];
        l = l + 1;
    }
}

// [ level, ... ]: each an action or { actions }.
fn _actions(km as *Keymap, lx as *Lex, kc as i64, g as i32) as void {
    if (_expect(km, lx, 91) == 0) { return; }
    let is [64]i64 as firsts with mut;
    let is [64]i32 as counts with mut;
    let is i32 as n with mut = 0;
    while (km.err == 0 && lx.tok != 93 && lx.tok != TOK_END) {
        let is i64 as first = km.actions.len / sizeof(Action);
        let is i32 as count with mut = 0;
        let is i32 as braced = cast(i32, lx.tok == 123);
        if (braced == 1) { next(lx); }
        while (km.err == 0 && lx.tok != 125 && lx.tok != 93 && lx.tok != TOK_END) {
            let is Action as a with mut;
            _action(km, lx, &a);
            if (a.kind != ACT_NONE) {
                let is i64 as off = grow.add(&km.actions, sizeof(Action));
                if (off < 0) { _fail(km); return; }
                mem.memcpy(grow.at(&km.actions, off), cast(*u8, &a), sizeof(Action));
                count = count + 1;
            }
            if (braced == 0) { break; }
            if (lx.tok == 44) { next(lx); }
        }
        if (braced == 1 && _expect(km, lx, 125) == 0) { return; }
        if (n < 64) { firsts[n] = first; counts[n] = count; n = n + 1; }
        if (lx.tok == 44) { next(lx); }
    }
    if (_expect(km, lx, 93) == 0) { return; }
    if (g < 0) { return; }
    let is *Key as k = key(km, kc);
    if (g + 1 > k.num_given) { k.num_given = g + 1; }
    if ((k.groups[g].given & GROUP_ACTS) != 0) { return; }
    k.groups[g].given = k.groups[g].given | GROUP_ACTS;
    if (_levels(km, kc, g, n) == 0) { return; }
    // Trailing levels with neither keysyms nor actions are dropped.
    let is i32 as keep with mut = 0;
    let is i32 as l with mut = 0;
    while (l < k.groups[g].num_levels) {
        let is *Level as lv = level_at(km, cast(i64, k.groups[g].first_level + l));
        if (l < n) { lv.first_action = cast(i32, firsts[l]); lv.num_actions = counts[l]; }
        if (lv.num_actions > 0 || lv.num_syms > 0) { keep = l + 1; }
        l = l + 1;
    }
    k.groups[g].num_levels = keep;
}

fn _key(km as *Keymap, lx as *Lex) as void {
    next(lx);
    if (lx.tok != TOK_KEYNAME) { _fail(km); return; }
    let is i64 as kc = key_by_name(km, _text(km, lx.at), lx.len);
    next(lx);
    if (_expect(km, lx, 123) == 0) { return; }
    // A key the keycodes do not name: read past, kept nowhere.
    let is Key as nowhere with mut;
    mem.memzero(cast(*u8, &nowhere), sizeof(Key));
    let is *Key as k with mut = &nowhere;
    if (kc >= 0) { k = key(km, kc); }
    k.touched = 1;
    while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
        if (lx.tok == 91) {
            let is i32 as g with mut = _first_free(k, GROUP_SYMS);
            if (kc < 0) { g = 0 - 1; }
            _symbols(km, lx, kc, g);
        } else if (lx.tok == 33 || lx.tok == 126) {
            next(lx);
            if (_is(lx, "groupsWrap") == 1 || _is(lx, "wrapGroups") == 1) { k.range = RANGE_SATURATE; }
            if (_is(lx, "groupsClamp") == 1 || _is(lx, "clampGroups") == 1) { k.range = RANGE_WRAP; }
            next(lx);
        } else if (lx.tok == TOK_IDENT) {
            let is i32 as field with mut = 0;
            if (_is(lx, "type") == 1) { field = 1; }
            else if (_is(lx, "symbols") == 1) { field = 2; }
            else if (_is(lx, "actions") == 1) { field = 3; }
            else if (_is(lx, "vmods") == 1 || _is(lx, "virtualMods") == 1 || _is(lx, "virtualModifiers") == 1) { field = 4; }
            else if (_is(lx, "repeat") == 1 || _is(lx, "repeats") == 1 || _is(lx, "repeating") == 1) { field = 5; }
            else if (_is(lx, "groupsWrap") == 1 || _is(lx, "wrapGroups") == 1) { field = 6; }
            else if (_is(lx, "groupsClamp") == 1 || _is(lx, "clampGroups") == 1) { field = 7; }
            else if (_is(lx, "groupsRedirect") == 1 || _is(lx, "redirectGroups") == 1) { field = 8; }
            next(lx);
            let is i32 as g with mut = 0 - 2;
            if (lx.tok == 91 && (field == 1 || field == 2 || field == 3)) {
                let is i32 as what with mut = GROUP_SYMS;
                if (field == 3) { what = GROUP_ACTS; }
                if (field == 1) { what = GROUP_TYPE; }
                g = _group_of(km, lx, k, what);
            } else if (field == 2) {
                g = _group_of(km, lx, k, GROUP_SYMS);
            } else if (field == 3) {
                g = _group_of(km, lx, k, GROUP_ACTS);
            }
            if (lx.tok != 61) {
                // A flag alone: groupsWrap, groupsClamp.
                if (field == 6) { k.range = RANGE_WRAP; }
                if (field == 7) { k.range = RANGE_SATURATE; }
            } else {
                next(lx);
                if (field == 1) {
                    if (lx.tok != TOK_STRING) { _fail(km); return; }
                    let is i64 as ti with mut = type_by_name(km, _text(km, lx.at), lx.len);
                    if (ti < 0) { ti = 0; }
                    if (g == 0 - 2) { k.default_type = cast(i32, ti); }
                    else if (g >= 0) {
                        if (g + 1 > k.num_given) { k.num_given = g + 1; }
                        k.groups[g].named_type = cast(i32, ti);
                        k.groups[g].given = k.groups[g].given | GROUP_TYPE;
                    }
                    next(lx);
                } else if (field == 2) {
                    if (kc < 0) { g = 0 - 1; }
                    _symbols(km, lx, kc, g);
                } else if (field == 3) {
                    if (kc < 0) { g = 0 - 1; }
                    _actions(km, lx, kc, g);
                } else if (field == 4) {
                    let is i32 as ok with mut = 1;
                    let is u32 as m = _mask(km, lx, 1, &ok);
                    if (ok == 1) { k.vmodmap = m; k.explicit = k.explicit | EXPLICIT_VMODMAP; }
                } else if (field == 5) {
                    if (_is(lx, "default") == 1) { k.repeat_given = 0 - 1; next(lx); }
                    else {
                        let is i32 as v = _boolean(lx);
                        if (v >= 0) { k.repeat_given = v; }
                    }
                } else if (field == 6 || field == 7) {
                    let is i32 as v = _boolean(lx);
                    if (v >= 0) {
                        if ((field == 6) == (v == 1)) { k.range = RANGE_WRAP; } else { k.range = RANGE_SATURATE; }
                    }
                } else if (field == 8) {
                    let is i64 as gi = _index(lx, "group");
                    if (gi >= 1 && gi <= cast(i64, MAX_GROUPS)) {
                        k.range = RANGE_REDIRECT;
                        k.redirect = cast(i32, gi - 1);
                    }
                } else {
                    _skip_value(lx);
                    while (lx.tok != 44 && lx.tok != 125 && lx.tok != TOK_END) { next(lx); }
                }
            }
        } else {
            _fail(km);
            return;
        }
        if (km.err != 0) { return; }
        if (lx.tok == 44) { next(lx); }
        else if (lx.tok != 125) { _fail(km); return; }
    }
    if (_expect(km, lx, 125) == 0) { return; }
    _expect(km, lx, 59);
}

// modifier_map Mod1 { <LALT>, Alt_L }: keys by name, or the first with the
// keysym; applied (apply 1) once the keys are made.
fn _modmap(km as *Keymap, lx as *Lex, apply as i32) as void {
    next(lx);
    if (lx.tok != TOK_IDENT) { _fail(km); return; }
    let is i32 as m = mod_index(km, _text(km, lx.at), lx.len);
    next(lx);
    if (_expect(km, lx, 123) == 0) { return; }
    while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
        let is i64 as kc with mut = 0 - 1;
        if (lx.tok == TOK_KEYNAME) {
            kc = key_by_name(km, _text(km, lx.at), lx.len);
            next(lx);
        } else {
            let is u32 as sym = _keysym(km, lx);
            if (apply == 1) { kc = _key_for_sym(km, sym); }
        }
        if (apply == 1 && kc >= 0 && m >= 0 && m < 8) {
            let is *Key as k = key(km, kc);
            k.modmap = k.modmap | (cast(u32, 1) << cast(u32, m));
        }
        if (lx.tok == 44) { next(lx); }
    }
    if (_expect(km, lx, 125) == 0) { return; }
    _expect(km, lx, 59);
}

// The key with the keysym in its first group at the lowest level, the
// lowest keycode among those.
fn _key_for_sym(km as *Keymap, sym as u32) as i64 {
    let is i32 as level with mut = 0;
    let is i32 as any with mut = 1;
    while (any == 1) {
        any = 0;
        let is i64 as kc with mut = cast(i64, km.min_key);
        while (kc <= cast(i64, km.max_key)) {
            let is *Key as k = key(km, kc);
            if (k.num_groups > 0 && level < k.groups[0].num_levels) {
                any = 1;
                let is *Level as lv = level_at(km, cast(i64, k.groups[0].first_level + level));
                if (lv.num_syms > 0 && *sym_at(km, cast(i64, lv.first_sym)) == sym) { return kc; }
            }
            kc = kc + 1;
        }
        level = level + 1;
    }
    return 0 - 1;
}

fn _symbols_section(km as *Keymap, lx as *Lex, pass as i32) as void {
    next(lx);
    while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
        if (_is(lx, "virtual_modifiers") == 1 && pass == 0) { _vmods(km, lx); }
        else if (_is(lx, "key") == 1 && pass == 0) { _key(km, lx); }
        else if ((_is(lx, "modifier_map") == 1 || _is(lx, "mod_map") == 1 || _is(lx, "modmap") == 1)) {
            _modmap(km, lx, pass);
        }
        else { _skip(lx); }
    }
}

// The type a group without one written gets: by the number of levels and
// whether its first keysyms are letters of two cases or keypad keys.
fn _auto_type(km as *Keymap, k as *Key, g as i32) as i64 {
    let is i32 as width = k.groups[g].num_levels;
    if (width <= 1) { return type_by_name(km, "ONE_LEVEL", 9); }
    let is [4]u32 as s with mut;
    let is i32 as l with mut = 0;
    while (l < 4) {
        s[l] = keysym.NO_SYMBOL;
        if (l < width) {
            let is *Level as lv = level_at(km, cast(i64, k.groups[g].first_level + l));
            if (lv.num_syms > 0) { s[l] = *sym_at(km, cast(i64, lv.first_sym)); }
        }
        l = l + 1;
    }
    if (width == 2) {
        if (keysym.is_lower(s[0]) == 1 && keysym.is_upper_or_title(s[1]) == 1) { return type_by_name(km, "ALPHABETIC", 10); }
        if (keysym.is_keypad(s[0]) == 1 || keysym.is_keypad(s[1]) == 1) { return type_by_name(km, "KEYPAD", 6); }
        return type_by_name(km, "TWO_LEVEL", 9);
    }
    if (width <= 4) {
        if (keysym.is_lower(s[0]) == 1 && keysym.is_upper_or_title(s[1]) == 1) {
            if (keysym.is_lower(s[2]) == 1 && keysym.is_upper_or_title(s[3]) == 1) {
                return type_by_name(km, "FOUR_LEVEL_ALPHABETIC", 21);
            }
            return type_by_name(km, "FOUR_LEVEL_SEMIALPHABETIC", 25);
        }
        if (keysym.is_keypad(s[0]) == 1 || keysym.is_keypad(s[1]) == 1) { return type_by_name(km, "FOUR_LEVEL_KEYPAD", 17); }
        return type_by_name(km, "FOUR_LEVEL", 10);
    }
    return 0 - 1;
}

// A key read from the symbols: its groups, their types and levels.
fn _make_key(km as *Keymap, kc as i64) as void {
    let is *Key as k with mut = key(km, kc);
    let is i32 as num with mut = 0;
    let is i32 as g with mut = 0;
    while (g < k.num_given) {
        let is i32 as typed = cast(i32, k.default_type >= 0 || (k.groups[g].given & GROUP_TYPE) != 0);
        if (k.groups[g].num_levels > 0 || typed == 1) { num = g + 1; }
        if (typed == 1) { k.explicit = k.explicit | EXPLICIT_TYPES; }
        g = g + 1;
    }
    if (k.repeat_given >= 0) {
        k.explicit = k.explicit | EXPLICIT_REPEAT;
        k.repeats = k.repeat_given;
    }
    k.num_groups = num;
    if (num == 0) { return; }
    // Groups left empty between: the first group's.
    g = 1;
    while (g < num) {
        if (k.groups[g].given == 0) {
            k.groups[g].first_level = k.groups[0].first_level;
            k.groups[g].num_levels = k.groups[0].num_levels;
            k.groups[g].named_type = k.groups[0].named_type;
            k.groups[g].given = k.groups[0].given;
        }
        g = g + 1;
    }
    g = 0;
    while (g < num) {
        let is i64 as ti with mut = cast(i64, k.groups[g].named_type);
        if (ti < 0) { ti = cast(i64, k.default_type); }
        if (ti < 0) {
            ti = _auto_type(km, k, g);
            if (ti < 0) { ti = 0; }
        }
        k.groups[g].kind = cast(i32, ti);
        let is i32 as want = type_at(km, ti).num_levels;
        if (k.groups[g].num_levels < want) {
            if (_levels(km, kc, g, want) == 0) { return; }
            k = key(km, kc);
        }
        k.groups[g].num_levels = want;
        if ((k.groups[g].given & GROUP_ACTS) != 0) {
            k.groups[g].explicit_actions = 1;
            k.explicit = k.explicit | EXPLICIT_INTERP;
        }
        g = g + 1;
    }
}

// --- Derived fields ---

// The interpretations for a level's keysyms, matched against the key's
// modifier map, appended to out (indices into the interpretations, -1 for
// none); their count, -1 when the level has no keysym.
fn _interps_for(km as *Keymap, k as *Key, g as i32, level as i32, out as *i64) as i32 {
    let is *Level as lv = level_at(km, cast(i64, k.groups[g].first_level + level));
    if (lv.num_syms <= 0) { return 0 - 1; }
    let is i32 as found_n with mut = 0;
    let is i32 as s with mut = 0;
    while (s < lv.num_syms && s < 16) {
        let is u32 as sym = *sym_at(km, cast(i64, lv.first_sym + s));
        let is i64 as pick with mut = 0 - 1;
        let is i64 as i with mut = 0;
        while (i < num_interps(km)) {
            let is *Interp as si = interp_at(km, i);
            if (si.sym == sym || si.sym == keysym.NO_SYMBOL) {
                let is u32 as mods with mut = k.modmap;
                if (si.one == 1 && level != 0) { mods = 0; }
                let is i32 as hit with mut = 0;
                if (si.pred == PRED_NONE_OF) { hit = cast(i32, (si.mods & mods) == 0); }
                if (si.pred == PRED_ANY_OF_OR_NONE) { hit = cast(i32, mods == 0 || (si.mods & mods) != 0); }
                if (si.pred == PRED_ANY_OF) { hit = cast(i32, (si.mods & mods) != 0); }
                if (si.pred == PRED_ALL_OF) { hit = cast(i32, (si.mods & mods) == si.mods); }
                if (si.pred == PRED_EXACTLY) { hit = cast(i32, si.mods == mods); }
                if (hit == 1) {
                    // An Any interpretation once per level.
                    if (i > 0 && si.sym == keysym.NO_SYMBOL) {
                        let is i32 as j with mut = 0;
                        while (j < found_n) {
                            if (out[j] == i) { hit = 0; }
                            j = j + 1;
                        }
                        if (hit == 0) { break; }
                    }
                    pick = i;
                    break;
                }
            }
            i = i + 1;
        }
        out[found_n] = pick;
        found_n = found_n + 1;
        s = s + 1;
    }
    return found_n;
}

fn _apply_interps(km as *Keymap, kc as i64) as void {
    let is *Key as k with mut = key(km, kc);
    let is u32 as vmodmap with mut = 0;
    let is [16]i64 as found with mut;
    let is i32 as g with mut = 0;
    while (g < k.num_groups) {
        if (k.groups[g].explicit_actions == 1) { g = g + 1; continue; }
        // The levels get actions of their own: the group's levels copied.
        let is i32 as n = k.groups[g].num_levels;
        let is i64 as off = grow.add(&km.levels, cast(i64, n) * sizeof(Level));
        if (off < 0) { _fail(km); return; }
        k = key(km, kc);
        mem.memcpy(grow.at(&km.levels, off), cast(*u8, level_at(km, cast(i64, k.groups[g].first_level))), cast(i64, n) * sizeof(Level));
        k.groups[g].first_level = cast(i32, off / sizeof(Level));
        let is i32 as level with mut = 0;
        while (level < n) {
            let is *Level as lv = level_at(km, cast(i64, k.groups[g].first_level + level));
            lv.num_actions = 0; lv.first_action = 0;
            let is i32 as count = _interps_for(km, k, g, level, &found[0]);
            let is i32 as f with mut = 0;
            while (f < count) {
                if (found[f] >= 0) {
                    let is *Interp as si = interp_at(km, found[f]);
                    if (g == 0 && level == 0 && (k.explicit & EXPLICIT_REPEAT) == 0 && si.repeat == 1) { k.repeats = 1; }
                    if ((g == 0 && level == 0) || si.one == 0) {
                        if (si.vmod >= 0) { vmodmap = vmodmap | (cast(u32, 1) << cast(u32, si.vmod)); }
                    }
                    if (si.has == 1) {
                        let is i64 as aoff = grow.add(&km.actions, sizeof(Action));
                        if (aoff < 0) { _fail(km); return; }
                        mem.memcpy(grow.at(&km.actions, aoff), cast(*u8, &si.action), sizeof(Action));
                        if (lv.num_actions == 0) { lv.first_action = cast(i32, aoff / sizeof(Action)); }
                        lv.num_actions = lv.num_actions + 1;
                    }
                } else if (g == 0 && level == 0 && (k.explicit & EXPLICIT_REPEAT) == 0) {
                    // No interpretation: libxkbcommon's default one, which repeats.
                    k.repeats = 1;
                }
                f = f + 1;
            }
            level = level + 1;
        }
        g = g + 1;
    }
    if ((k.explicit & EXPLICIT_VMODMAP) == 0) { k.vmodmap = vmodmap; }
}

// Modifier and group actions of one level: only the first of each kind.
fn _one_per_kind(km as *Keymap, lv as *Level) as void {
    let is i32 as i with mut = 0;
    while (i < lv.num_actions) {
        let is *Action as a = action_at(km, cast(i64, lv.first_action + i));
        let is i32 as mod_kind = cast(i32, a.kind >= ACT_MOD_SET && a.kind <= ACT_MOD_LOCK);
        let is i32 as group_kind = cast(i32, a.kind >= ACT_GROUP_SET && a.kind <= ACT_GROUP_LOCK);
        if (mod_kind == 1 || group_kind == 1) {
            let is i32 as j with mut = i + 1;
            while (j < lv.num_actions) {
                let is *Action as b = action_at(km, cast(i64, lv.first_action + j));
                if ((mod_kind == 1 && b.kind >= ACT_MOD_SET && b.kind <= ACT_MOD_LOCK) ||
                    (group_kind == 1 && b.kind >= ACT_GROUP_SET && b.kind <= ACT_GROUP_LOCK)) {
                    b.kind = ACT_NONE;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

fn _effective_of(km as *Keymap, mods as u32) as u32 {
    // Bits past the modifiers are kept as they are.
    let is u32 as unknown with mut = 0;
    if (km.num_mods < 32) { unknown = ~((cast(u32, 1) << cast(u32, km.num_mods)) - 1); }
    return effective(km, mods) | (mods & unknown);
}

fn _derive(km as *Keymap) as void {
    let is i64 as kc with mut = cast(i64, km.min_key);
    while (kc <= cast(i64, km.max_key)) {
        _apply_interps(km, kc);
        if (km.err != 0) { return; }
        let is *Key as k = key(km, kc);
        let is i32 as g with mut = 0;
        while (g < k.num_groups) {
            let is i32 as l with mut = 0;
            while (l < k.groups[g].num_levels) {
                _one_per_kind(km, level_at(km, cast(i64, k.groups[g].first_level + l)));
                l = l + 1;
            }
            g = g + 1;
        }
        kc = kc + 1;
    }
    // Virtual modifiers map to the real ones of the keys that carry them.
    kc = cast(i64, km.min_key);
    while (kc <= cast(i64, km.max_key)) {
        let is *Key as k = key(km, kc);
        let is i32 as m with mut = 8;
        while (m < km.num_mods) {
            if ((k.vmodmap & (cast(u32, 1) << cast(u32, m))) != 0) { km.mapping[m] = km.mapping[m] | k.modmap; }
            m = m + 1;
        }
        kc = kc + 1;
    }
    km.canonical = REAL_MASK;
    let is i32 as m with mut = 8;
    while (m < km.num_mods) { km.canonical = km.canonical | km.mapping[m]; m = m + 1; }
    // Types' masks; entries naming an unbound virtual modifier never match.
    let is i64 as ti with mut = 0;
    while (ti < num_types(km)) {
        let is *Type as t = type_at(km, ti);
        t.mask = _effective_of(km, t.mods);
        let is i64 as e with mut = 0;
        while (e < cast(i64, t.num_entries)) {
            let is *Entry as en = entry_at(km, cast(i64, t.first_entry) + e);
            let is i32 as unbound with mut = 0;
            m = 8;
            while (m < km.num_mods) {
                if ((en.mods & (cast(u32, 1) << cast(u32, m))) != 0 && km.mapping[m] == 0) { unbound = 1; }
                m = m + 1;
            }
            if (unbound == 1) { en.mask = 0; }
            else {
                en.mask = _effective_of(km, en.mods);
                en.pmask = _effective_of(km, en.pmods);
            }
            e = e + 1;
        }
        ti = ti + 1;
    }
    // Actions' masks, modMapMods the key's modifier map.
    kc = cast(i64, km.min_key);
    while (kc <= cast(i64, km.max_key)) {
        let is *Key as k = key(km, kc);
        let is i32 as g with mut = 0;
        while (g < k.num_groups) {
            let is i32 as l with mut = 0;
            while (l < k.groups[g].num_levels) {
                let is *Level as lv = level_at(km, cast(i64, k.groups[g].first_level + l));
                let is i32 as i with mut = 0;
                while (i < lv.num_actions) {
                    let is *Action as a = action_at(km, cast(i64, lv.first_action + i));
                    if (a.kind >= ACT_MOD_SET && a.kind <= ACT_MOD_LOCK) {
                        if ((a.flags & FLAG_MODMAP) != 0) { a.mods = k.modmap; }
                        a.mask = _effective_of(km, a.mods);
                    }
                    i = i + 1;
                }
                l = l + 1;
            }
            g = g + 1;
        }
        if (k.num_groups > km.num_groups) { km.num_groups = k.num_groups; }
        kc = kc + 1;
    }
}

// --- Reading ---

// Where each section's body begins (after its '{'), -1 for none.
struct Sections {
    keycodes as i64;
    types    as i64;
    compat   as i64;
    symbols  as i64;
}

fn _sections(km as *Keymap, lx as *Lex, out as *Sections) as void {
    out.keycodes = 0 - 1; out.types = 0 - 1; out.compat = 0 - 1; out.symbols = 0 - 1;
    next(lx);
    // Flags before the keymap: default, partial, hidden and the like.
    while (lx.tok == TOK_IDENT && _is(lx, "xkb_keymap") == 0) { next(lx); }
    if (_is(lx, "xkb_keymap") == 0) { _fail(km); return; }
    next(lx);
    if (lx.tok == TOK_STRING) { next(lx); }
    if (_expect(km, lx, 123) == 0) { return; }
    while (km.err == 0 && lx.tok != 125 && lx.tok != TOK_END) {
        let is i32 as which with mut = 0;
        while (lx.tok == TOK_IDENT && which == 0) {
            if (_is(lx, "xkb_keycodes") == 1) { which = 1; }
            else if (_is(lx, "xkb_types") == 1) { which = 2; }
            else if (_is(lx, "xkb_compatibility") == 1 || _is(lx, "xkb_compat") == 1 || _is(lx, "xkb_compatibility_map") == 1) { which = 3; }
            else if (_is(lx, "xkb_symbols") == 1) { which = 4; }
            else if (_is(lx, "xkb_geometry") == 1) { which = 5; }
            next(lx);
        }
        if (which == 0) { _fail(km); return; }
        if (lx.tok == TOK_STRING) { next(lx); }
        if (lx.tok != 123) { _fail(km); return; }
        let is i64 as body = lx.pos;
        // The first section of each kind counts.
        if (which == 1 && out.keycodes < 0) { out.keycodes = body; }
        if (which == 2 && out.types < 0) { out.types = body; }
        if (which == 3 && out.compat < 0) { out.compat = body; }
        if (which == 4 && out.symbols < 0) { out.symbols = body; }
        let is i32 as depth with mut = 0;
        while (lx.tok != TOK_END) {
            if (lx.tok == TOK_ERROR) { _fail(km); return; }
            if (lx.tok == 123) { depth = depth + 1; }
            if (lx.tok == 125) {
                depth = depth - 1;
                if (depth == 0) { break; }
            }
            next(lx);
        }
        if (_expect(km, lx, 125) == 0) { return; }
        if (_expect(km, lx, 59) == 0) { return; }
    }
    _expect(km, lx, 125);
}

fn _at_body(lx as *Lex, pos as i64) as void { lx.pos = pos; }

// The keymap of the n bytes of text; null when they are not one.
fn _real_name(km as *Keymap, at as *i64, m as i32, s as *u8, len as i64) as void {
    mem.memcpy(_text(km, *at), s, len);
    km.mod_at[m] = *at; km.mod_len[m] = len;
    *at = *at + len + 1;
}

fn parse(text as *u8, n as i64, where as *i64) as *Keymap {
    let is *Keymap as km = cast(*Keymap, mem.core.mmap_anon(sizeof(Keymap)));
    if (cast(i64, km) == 0) { return km; }
    // Its own copy, the real modifiers' names after it: names point into it.
    let is i64 as len with mut = n;
    while (len > 0 && text[len - 1] == 0) { len = len - 1; }
    km.text_size = len + 1 + 44;
    km.text = mem.core.mmap_anon(km.text_size);
    if (cast(i64, km.text) == 0) { free(km); return cast(*Keymap, 0); }
    mem.memcpy(km.text, text, len);
    let is i64 as at with mut = len + 1;
    _real_name(km, &at, 0, "Shift", 5);
    _real_name(km, &at, 1, "Lock", 4);
    _real_name(km, &at, 2, "Control", 7);
    _real_name(km, &at, 3, "Mod1", 4);
    _real_name(km, &at, 4, "Mod2", 4);
    _real_name(km, &at, 5, "Mod3", 4);
    _real_name(km, &at, 6, "Mod4", 4);
    _real_name(km, &at, 7, "Mod5", 4);
    km.num_mods = 8;
    let is Lex as lx with mut;
    mem.memzero(cast(*u8, &lx), sizeof(Lex));
    lx.s = km.text; lx.n = len;
    km.lex = &lx;
    let is Sections as sec with mut;
    _sections(km, &lx, &sec);
    if (km.err == 0 && sec.keycodes >= 0) { _at_body(&lx, sec.keycodes); _keycodes(km, &lx); }
    if (km.err == 0 && _make_keys(km) == 0) { _fail(km); }
    if (km.err == 0 && sec.types >= 0) { _at_body(&lx, sec.types); _types(km, &lx); }
    if (km.err == 0 && num_types(km) == 0) {
        // No types: one ONE_LEVEL type for every key.
        let is i64 as off = grow.add(&km.types, sizeof(Type));
        if (off < 0) { _fail(km); }
        else {
            let is *Type as t = type_at(km, 0);
            t.name_at = km.mod_at[0]; t.name_len = 0; t.num_levels = 1;
        }
    }
    if (km.err == 0 && sec.compat >= 0) { _at_body(&lx, sec.compat); _compat(km, &lx); }
    if (km.err == 0 && _sort_interps(km) == 0) { _fail(km); }
    if (km.err == 0 && sec.symbols >= 0) { _at_body(&lx, sec.symbols); _symbols_section(km, &lx, 0); }
    if (km.err == 0) {
        let is i64 as kc with mut = cast(i64, km.min_key);
        while (km.err == 0 && kc <= cast(i64, km.max_key)) {
            if (key(km, kc).touched == 1) { _make_key(km, kc); }
            kc = kc + 1;
        }
    }
    if (km.err == 0 && sec.symbols >= 0) { _at_body(&lx, sec.symbols); _symbols_section(km, &lx, 1); }
    if (km.err == 0) { _derive(km); }
    km.lex = cast(*Lex, 0);
    if (cast(i64, where) != 0) {
        *where = 0 - 1;
        if (km.err != 0) { *where = km.err_at; }
    }
    if (km.err != 0) { free(km); return cast(*Keymap, 0); }
    return km;
}

// --- Queries ---

fn num_layouts_for_key(km as *Keymap, kc as i64) as i32 {
    let is *Key as k = key(km, kc);
    if (cast(i64, k) == 0) { return 0; }
    return k.num_groups;
}

fn num_levels_for_key(km as *Keymap, kc as i64, layout as i32) as i32 {
    let is *Key as k = key(km, kc);
    if (cast(i64, k) == 0) { return 0; }
    let is i32 as g = wrap_group(layout, k.num_groups, k.range, k.redirect);
    if (g < 0) { return 0; }
    return k.groups[g].num_levels;
}

// The keysyms at a key's level of a layout: their count, *out their first.
fn key_syms(km as *Keymap, kc as i64, layout as i32, level as i32, out as **u32) as i32 {
    *out = cast(*u32, 0);
    let is *Key as k = key(km, kc);
    if (cast(i64, k) == 0) { return 0; }
    let is i32 as g = wrap_group(layout, k.num_groups, k.range, k.redirect);
    if (g < 0 || level < 0 || level >= k.groups[g].num_levels) { return 0; }
    let is *Level as lv = level_at(km, cast(i64, k.groups[g].first_level + level));
    if (lv.num_syms == 0) { return 0; }
    *out = sym_at(km, cast(i64, lv.first_sym));
    return lv.num_syms;
}

fn key_repeats(km as *Keymap, kc as i64) as i32 {
    let is *Key as k = key(km, kc);
    if (cast(i64, k) == 0) { return 0; }
    return k.repeats;
}
