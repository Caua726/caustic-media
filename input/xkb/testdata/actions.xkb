// Written by hand for input/xkb/xkb_test.cst: explicit actions — modifier
// and group latches, locks and sets — clamped and redirected groups, empty
// and multi-keysym levels, a type preserving a modifier, a virtual modifier
// nothing binds, modifiers mapped by keysym, interpretations of every kind.
xkb_keymap {
xkb_keycodes "test" {
	minimum = 8;
	maximum = 255;
	<ESC> = 9;
	<AE01> = 10;
	<AE02> = 11;
	<AD01> = 24;
	<AD02> = 25;
	<AD03> = 26;
	<AC01> = 38;
	<AC02> = 39;
	<AB01> = 52;
	<LFSH> = 50;
	<RTSH> = 62;
	<LCTL> = 37;
	<LALT> = 64;
	<CAPS> = 66;
	<RALT> = 108;
	<LWIN> = 133;
	<MENU> = 135;
	<FK01> = 67;
	<FK02> = 68;
	<FK03> = 69;
	<FK04> = 70;
	<FK05> = 71;
	<FK06> = 72;
	<FK07> = 73;
	<FK08> = 74;
	<KP1> = 87;
	alias <LatQ> = <AD01>;
	indicator 1 = "Caps Lock";
};

xkb_types "test" {
	virtual_modifiers NumLock,Alt,LevelThree,Unbound;

	type "ONE_LEVEL" {
		modifiers= none;
		level_name[Level1]= "Any";
	};
	type "TWO_LEVEL" {
		modifiers= Shift;
		map[Shift]= Level2;
	};
	type "ALPHABETIC" {
		modifiers= Shift+Lock;
		map[Shift]= 2;
		map[Lock]= 2;
	};
	type "FOUR_LEVEL" {
		modifiers= Shift+LevelThree;
		map[Shift]= 2;
		map[LevelThree]= 3;
		map[Shift+LevelThree]= 4;
	};
	type "PRESERVING" {
		modifiers= Shift+Control;
		map[Shift]= 2;
		preserve[Control]= Control;
		map[Shift+Control]= 2;
		preserve[Shift+Control]= Control;
	};
	type "UNBOUND" {
		modifiers= Shift+Unbound;
		map[Shift]= 2;
		map[Unbound]= 3;
	};
	type "KEYPAD" {
		modifiers= Shift+NumLock;
		map[Shift]= 2;
		map[NumLock]= 2;
		preserve[Shift+NumLock]= Shift;
	};
};

xkb_compatibility "test" {
	virtual_modifiers NumLock,Alt,LevelThree;

	interpret.useModMapMods= AnyLevel;
	interpret.repeat= False;
	interpret Shift_L+AnyOfOrNone(all) {
		action= SetMods(modifiers=Shift,clearLocks);
	};
	interpret Caps_Lock+AnyOfOrNone(all) {
		action= LockMods(modifiers=Lock);
	};
	interpret Alt_L+AnyOf(all) {
		virtualModifier= Alt;
		action= SetMods(modifiers=modMapMods,clearLocks);
	};
	interpret ISO_Level3_Shift+AnyOf(all) {
		virtualModifier= LevelThree;
		useModMapMods=level1;
		action= SetMods(modifiers=LevelThree,clearLocks);
	};
	interpret Num_Lock+AnyOf(all) {
		virtualModifier= NumLock;
		action= LockMods(modifiers=NumLock);
	};
	interpret Menu+NoneOf(Shift+Control) {
		repeat= True;
	};
	interpret Any+Exactly(Lock) {
		action= LockMods(modifiers=Lock);
	};
	interpret Any+AnyOf(all) {
		action= SetMods(modifiers=modMapMods,clearLocks);
	};
	indicator "Caps Lock" {
		whichModState= locked;
		modifiers= Lock;
	};
};

xkb_symbols "test" {
	name[Group1]="Test";

	key <ESC> { [ Escape ] };
	key <AE01> { [ 1, exclam, onesuperior, exclamdown ], [ 1, 0x21 ] };
	key <AE02> { type= "PRESERVING", [ 2, at ] };
	key <LatQ> { [ q, Q ], [ Cyrillic_shorti, Cyrillic_SHORTI ], [ Greek_finalsmallsigma, U03A3 ] };
	key <AD02> { groupsClamp, [ w, W ], [ Cyrillic_tse, Cyrillic_TSE ] };
	key <AD03> {
		groupsRedirect= Group1,
		symbols[Group1]= [ e, E ],
		symbols[Group2]= [ Cyrillic_u, Cyrillic_U ]
	};
	key <AC01> { [ { a, b }, { A, B }, NoSymbol ] };
	key <AC02> { type= "UNBOUND", [ s, S, ssharp ] };
	key <AB01> { [ z, Z ], [ ], [ 0x7a, 0x5a ] };
	key <LFSH> { [ Shift_L ] };
	key <RTSH> {
		symbols[Group1]= [ ISO_Level2_Latch ],
		actions[Group1]= [ LatchMods(modifiers=Shift,latchToLock,clearLocks) ]
	};
	key <LCTL> { [ Control_L ] };
	key <LALT> { [ Alt_L ] };
	key <CAPS> { [ Caps_Lock ] };
	key <RALT> { type= "ONE_LEVEL", [ ISO_Level3_Shift ] };
	key <LWIN> { [ Num_Lock ] };
	key <MENU> { vmods= Alt, [ Menu ] };
	key <FK01> { [ ISO_Next_Group ], actions[1]= [ LatchGroup(group=+1,latchToLock) ] };
	key <FK02> { actions= [ LockGroup(group=+1) ] };
	key <FK03> { actions[1]= [ SetGroup(group=2,clearLocks) ] };
	key <FK04> { actions[1]= [ LatchMods(modifiers=LevelThree,clearLocks) ] };
	key <FK05> { repeat= No, actions[1]= [ LockGroup(group=-1) ] };
	key <FK06> { actions[1]= [ LatchGroup(group=-1,clearLocks) ] };
	key <FK07> { [ Terminate_Server ], actions[Group1]= [ Terminate() ] };
	key <FK08> { actions[1]= [ LockMods(modifiers=Control,affect=lock) ] };
	key <KP1> { type= "KEYPAD", [ KP_End, KP_1 ] };
	modifier_map Shift { <LFSH>, <RTSH> };
	modifier_map Lock { Caps_Lock };
	modifier_map Control { <LCTL> };
	modifier_map Mod1 { <LALT>, <MENU> };
	modifier_map Mod2 { <LWIN> };
	modifier_map Mod5 { <RALT> };
};

};
