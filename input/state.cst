// input/state.cst — sampled input, as something a program feeds.
//
// "Is this key down", "where is the pointer", "how far did it move this
// frame" are questions about events already taken. The program hands each
// event it takes to feed and asks here; nothing polls a platform behind its
// back, and two states — one for a game, one for a replay — are two of these.
//
// A key is held from its KEY_DOWN to its KEY_UP, matched by its place
// (physical), so a layout change while it is held cannot leave it down. A
// CANCEL lets everything go: the keyboard's focus left, or events were lost.
// Motion, scrolling are per frame: new_frame starts the next.
use "event.cst" as event;

let is i64 as MAX_HELD with imut = 64;

struct State {
    held_physical as [64]i32;
    held_key      as [64]i32;
    held          as i64;
    buttons       as i32;   // bit b - 1 for button b
    modifiers     as i32;
    inside        as i32;   // the pointer is over the window
    placed        as i32;   // a position has been said, so motion has a start
    x             as i64;
    y             as i64;
    dx            as i64;   // motion since new_frame
    dy            as i64;
    scroll_x      as f64;   // scrolling since new_frame, lines
    scroll_y      as f64;
    steps_x       as i64;   // whole notches since new_frame
    steps_y       as i64;
}

fn init(st as *State) as void {
    st.held = 0;
    st.buttons = 0;
    st.modifiers = 0;
    st.inside = 0;
    st.placed = 0;
    st.x = 0;
    st.y = 0;
    new_frame(st);
}

// Per frame values back to nothing: what the next frame's events add up to.
fn new_frame(st as *State) as void {
    st.dx = 0;
    st.dy = 0;
    st.scroll_x = 0.0;
    st.scroll_y = 0.0;
    st.steps_x = 0;
    st.steps_y = 0;
}

fn _place(st as *State, x as i64, y as i64) as void {
    st.x = x;
    st.y = y;
    st.placed = 1;
}

fn _held_at(st as *State, physical as i32, key as i32) as i64 {
    let is i64 as i with mut = 0;
    while (i < st.held) {
        if (physical != 0 && st.held_physical[i] == physical) { return i; }
        if (physical == 0 && st.held_physical[i] == 0 && st.held_key[i] == key) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn feed(st as *State, e as *event.Event) as void {
    let is i32 as k = e.kind;
    if (k == event.KEY_DOWN || k == event.KEY_UP || k == event.BUTTON_DOWN || k == event.BUTTON_UP ||
        k == event.MOTION) { st.modifiers = e.modifiers; }
    if (k == event.KEY_DOWN) {
        if (_held_at(st, e.physical, e.key) < 0 && st.held < MAX_HELD) {
            st.held_physical[st.held] = e.physical;
            st.held_key[st.held] = e.key;
            st.held = st.held + 1;
        }
        return;
    }
    if (k == event.KEY_UP) {
        let is i64 as at = _held_at(st, e.physical, e.key);
        if (at < 0) { return; }
        st.held = st.held - 1;
        st.held_physical[at] = st.held_physical[st.held];
        st.held_key[at] = st.held_key[st.held];
        return;
    }
    if (k == event.BUTTON_DOWN || k == event.BUTTON_UP) {
        if (e.button >= 1 && e.button <= 31) {
            let is i32 as bit = cast(i32, 1 << (e.button - 1));
            if (k == event.BUTTON_DOWN) { st.buttons = st.buttons | bit; }
            else { st.buttons = st.buttons & cast(i32, 0 - 1 - bit); }
        }
        _place(st, e.x, e.y);
        return;
    }
    if (k == event.MOTION) {
        if (st.placed == 1) {
            st.dx = st.dx + e.x - st.x;
            st.dy = st.dy + e.y - st.y;
        }
        _place(st, e.x, e.y);
        return;
    }
    if (k == event.ENTER) {
        st.inside = 1;
        _place(st, e.x, e.y);
        return;
    }
    if (k == event.LEAVE) {
        st.inside = 0;
        return;
    }
    if (k == event.SCROLL) {
        st.scroll_x = st.scroll_x + e.dx;
        st.scroll_y = st.scroll_y + e.dy;
        st.steps_x = st.steps_x + cast(i64, e.steps_x);
        st.steps_y = st.steps_y + cast(i64, e.steps_y);
        return;
    }
    if (k == event.CANCEL) {
        st.held = 0;
        st.buttons = 0;
        st.modifiers = 0;
    }
}

// Whether a key that is key in the layout is held.
fn key_down(st as *State, key as i32) as i32 {
    let is i64 as i with mut = 0;
    while (i < st.held) {
        if (st.held_key[i] == key) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Whether the key at the platform's place physical is held.
fn physical_down(st as *State, physical as i32) as i32 {
    let is i64 as i with mut = 0;
    while (i < st.held) {
        if (st.held_physical[i] == physical) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn button_down(st as *State, button as i32) as i32 {
    if (button < 1 || button > 31) { return 0; }
    return cast(i32, (st.buttons & cast(i32, 1 << (button - 1))) != 0);
}
