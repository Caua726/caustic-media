// input/text.cst — what a text field tells the platform's input method.
//
// Composing works against the text already there: a method that predicts
// words reads what is before the caret, one that converts again reads the
// selection, an on-screen keyboard shows digits for a number. The field with
// the keyboard says its text around the caret, the caret and the selection's
// other end in it, what it is for (PURPOSE_*) and how its text goes
// (HINT_*); the window's backend tells the method what it can take
// (window/device.cst, text_input_context). The values are text-input-v3's,
// the richest of the three platforms'; the others take what they can.
//
// A password's text is never told: its purpose alone. X11's and Windows'
// methods cannot be told a field is secret, so they do not get its keys at
// all — Windows' own password fields do the same.

// At most this many bytes of text around the caret: text-input-v3 takes less
// than 4000, and a method needs no more than the sentence it is in.
let is i64 as CONTEXT_MAX with imut = 3999;

let is i32 as PURPOSE_NORMAL   with imut = 0;
let is i32 as PURPOSE_ALPHA    with imut = 1;
let is i32 as PURPOSE_DIGITS   with imut = 2;
let is i32 as PURPOSE_NUMBER   with imut = 3;
let is i32 as PURPOSE_PHONE    with imut = 4;
let is i32 as PURPOSE_URL      with imut = 5;
let is i32 as PURPOSE_EMAIL    with imut = 6;
let is i32 as PURPOSE_NAME     with imut = 7;
let is i32 as PURPOSE_PASSWORD with imut = 8;
let is i32 as PURPOSE_PIN      with imut = 9;
let is i32 as PURPOSE_DATE     with imut = 10;
let is i32 as PURPOSE_TIME     with imut = 11;
let is i32 as PURPOSE_DATETIME with imut = 12;
let is i32 as PURPOSE_TERMINAL with imut = 13;

let is i32 as HINT_NONE                with imut = 0;
let is i32 as HINT_COMPLETION          with imut = 1;
let is i32 as HINT_SPELLCHECK          with imut = 2;
let is i32 as HINT_AUTO_CAPITALIZATION with imut = 4;
let is i32 as HINT_LOWERCASE           with imut = 8;
let is i32 as HINT_UPPERCASE           with imut = 16;
let is i32 as HINT_TITLECASE           with imut = 32;
let is i32 as HINT_HIDDEN_TEXT         with imut = 64;
let is i32 as HINT_SENSITIVE_DATA      with imut = 128;
let is i32 as HINT_LATIN               with imut = 256;
let is i32 as HINT_MULTILINE           with imut = 512;

// Whether a field of purpose p keeps its text from the method: a password, a
// PIN.
fn secret(p as i32) as i32 { return cast(i32, p == PURPOSE_PASSWORD || p == PURPOSE_PIN); }
