// render/renderer.cst — renderer instance coordinating draws over a gpu.Device.

use "../gpu/device.cst" as dev;
use "../gpu/command.cst" as cmd;
use "../gpu/texture.cst" as tex;
use "../gpu/swapchain.cst" as swap;
use "../gpu/shader.cst" as shd;
use "../math/math.cst" as math;
use "mesh.cst" as mesh;
use "material.cst" as mat;

struct Renderer {
    d               as *dev.Device;
    commands        as i64;
    depth           as i64;
    depth_w         as i64;
    depth_h         as i64;
    sampler_nearest as i64;
    sampler_linear  as i64;
    current_sc      as i64;
    in_frame        as i32;
    _pad0           as i32;
}

fn open(d as *dev.Device) as Renderer {
    let is Renderer as r;
    r.d = d;
    r.commands = cmd.create(d);
    r.depth = 0;
    r.depth_w = 0;
    r.depth_h = 0;
    r.current_sc = 0;
    r.in_frame = 0;

    r.sampler_nearest = tex.sampler(d, tex.NEAREST, tex.CLAMP);
    r.sampler_linear  = tex.sampler(d, tex.LINEAR, tex.REPEAT);
    return r;
}

fn _ensure_depth(r as *Renderer, w as i64, h as i64) as void {
    if (r.depth != 0 && r.depth_w == w && r.depth_h == h) { return; }
    if (r.depth != 0) {
        tex.destroy(r.d, r.depth);
        r.depth = 0;
    }
    let is tex.Desc as td = tex.desc(w, h, tex.DEPTH, tex.RENDER_TARGET);
    r.depth = tex.create(r.d, &td);
    r.depth_w = w;
    r.depth_h = h;
}

fn begin_frame(r as *Renderer, sc as i64, w as i64, h as i64, clear_color as math.color.Color) as i32 {
    if (r.commands == 0 || sc == 0) { return 0; }
    _ensure_depth(r, w, h);

    let is i64 as img = swap.acquire(r.d, sc);
    if (img < 0) { return 0; }
    let is i64 as color_tex = swap.image(r.d, sc, img);

    r.current_sc = sc;
    r.in_frame = 1;

    cmd.begin(r.d, r.commands);
    let is cmd.Pass as ps = cmd.pass(color_tex, r.depth, clear_color);
    cmd.begin_pass(r.d, r.commands, &ps);
    return 1;
}

fn draw_mesh(r as *Renderer, m as *mesh.Mesh, material as *mat.Material, mvp as math.mat.Mat4) as void {
    if (r.in_frame == 0 || m.vertex_buffer == 0 || material.pipeline == 0) { return; }

    cmd.bind_pipeline(r.d, r.commands, material.pipeline);
    cmd.bind_vertex_buffer(r.d, r.commands, m.vertex_buffer);

    if (material.texture != 0) {
        let is i64 as samp with mut = material.sampler;
        if (samp == 0) { samp = r.sampler_nearest; }
        cmd.bind_texture(r.d, r.commands, 0, material.texture, samp);
    }

    let is shd.BuiltinUniforms as un = shd.uniforms_mvp(mvp);
    cmd.set_uniforms(r.d, r.commands, cast(*u8, &un), sizeof(shd.BuiltinUniforms));

    cmd.draw(r.d, r.commands, 0, m.vertex_count);
}

fn end_frame(r as *Renderer) as void {
    if (r.in_frame == 0) { return; }
    cmd.end_pass(r.d, r.commands);
    cmd.end(r.d, r.commands);
    cmd.submit(r.d, r.commands);
    swap.present(r.d, r.current_sc);
    r.in_frame = 0;
}

fn close(r as *Renderer) as void {
    if (r.commands != 0) {
        cmd.destroy(r.d, r.commands);
        r.commands = 0;
    }
    if (r.depth != 0) {
        tex.destroy(r.d, r.depth);
        r.depth = 0;
    }
    if (r.sampler_nearest != 0) {
        tex.sampler_destroy(r.d, r.sampler_nearest);
        r.sampler_nearest = 0;
    }
    if (r.sampler_linear != 0) {
        tex.sampler_destroy(r.d, r.sampler_linear);
        r.sampler_linear = 0;
    }
    r.in_frame = 0;
}
