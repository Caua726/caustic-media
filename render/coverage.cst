// render/coverage.cst — coverage for the 2D family to draw from: an atlas of
// R8 pages, each page a texture, and the rasterizer that fills them.
//
// A path filled on a canvas (shapes2d.fill_path) is rasterized into a place on
// a page and drawn from there as a glyph is, a quad of coverage in a colour.
// Glyphs can live on the same pages: the atlas and the rasterizer are fields,
// for text's glyph cache to place its own.
//
// Pixels reach the textures at upload(), every page's changed region at once
// — called after the frame's drawing and before the canvas is flushed. A
// frame is marked with next_frame(): a page used in the frame being drawn is
// never taken back during it (see image/atlas.cst), so a path that finds no
// room is refused, and the canvas says so.
use "../image/image.cst" as image;
use "../text/raster/raster.cst" as raster;
use "../gpu/device.cst" as dev;
use "../gpu/texture.cst" as texture;

let is i64 as MAX_PAGES with imut = 16;

struct Coverage {
    d      as *dev.Device;
    atlas  as image.atlas.Atlas;
    raster as raster.Raster;
    tex    as [16]i64;   // each page's texture; 0 until the page is made
}

// Pages of size by size pixels, up to pages of them (no more than MAX_PAGES),
// and a rasterizer for paths of up to max_side pixels a side.
fn open(d as *dev.Device, size as i64, pages as i64, max_side as i64) as Coverage {
    let is Coverage as c;
    c.d = d;
    let is i64 as n with mut = pages;
    if (n > MAX_PAGES) { n = MAX_PAGES; }
    c.atlas = image.atlas.open(size, size, image.R8, n);
    c.raster = raster.open(max_side, max_side);
    let is i64 as i with mut = 0;
    while (i < MAX_PAGES) {
        c.tex[i] = 0;
        i = i + 1;
    }
    return c;
}

fn ok(c as *Coverage) as i32 {
    if (image.atlas.ok(&c.atlas) == 1 && raster.ok(&c.raster) == 1) { return 1; }
    return 0;
}

fn close(c as *Coverage) as void {
    let is i64 as i with mut = 0;
    while (i < MAX_PAGES) {
        if (c.tex[i] != 0) { texture.destroy(c.d, c.tex[i]); }
        c.tex[i] = 0;
        i = i + 1;
    }
    image.atlas.close(&c.atlas);
    raster.close(&c.raster);
}

fn next_frame(c as *Coverage) as void { image.atlas.next_frame(&c.atlas); }

// Page p's texture, made the first time it is asked for.
fn texture_of(c as *Coverage, p as i64) as i64 {
    if (c.tex[p] == 0) {
        let is texture.Desc as td = texture.desc(c.atlas.w, c.atlas.h, texture.R8, texture.SAMPLED);
        c.tex[p] = texture.create(c.d, &td);
    }
    return c.tex[p];
}

// Every page's changed region sent to its texture. 1, or 0 when the device
// refused one.
fn upload(c as *Coverage) as i32 {
    let is i32 as ok with mut = 1;
    let is i64 as p with mut = 0;
    while (p < image.atlas.pages(&c.atlas)) {
        let is image.atlas.Region as r;
        if (image.atlas.dirty(&c.atlas, p, &r) == 1) {
            let is *image.buffer.Image as pg = image.atlas.page(&c.atlas, p);
            let is *u8 as at = cast(*u8, cast(i64, pg.pixels) + r.y * pg.stride + r.x);
            if (texture.upload_region(c.d, texture_of(c, p), r.x, r.y, r.w, r.h, at, pg.stride) == 0) { ok = 0; }
            image.atlas.clean(&c.atlas, p);
        }
        p = p + 1;
    }
    return ok;
}
