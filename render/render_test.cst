// render/render_test.cst — tests for the render layer.

use "std/io.cst" as io;
use "../math/math.cst" as math;
use "../gpu/gpu.cst" as gpu;
use "../image/image.cst" as img;
use "render.cst" as render;

fn main() as i32 {
    io.printf("testing render layer...\n");

    // 1. Camera tests
    let is math.vec.Vec3 as pos = math.vec.v3(0.0, 0.0, 5.0);
    let is math.vec.Vec3 as target = math.vec.v3(0.0, 0.0, 0.0);
    let is math.vec.Vec3 as up = math.vec.v3(0.0, 1.0, 0.0);
    let is render.camera.Camera3D as cam = render.camera.camera3d(
        pos, target, up, math.scalar.radians(60.0), 1.0, 0.1, 100.0);

    let is math.mat.Mat4 as proj = render.camera.proj_matrix(&cam);
    if (math.mat.m4_get(&proj, 3, 3) != 0.0) {
        io.printf("FAIL: perspective proj matrix invalid\n");
        return 1;
    }
    let is math.mat.Mat4 as vp = render.camera.view_proj(&cam);

    // 2. Open headless GPU device
    let is gpu.device.Device as d = gpu.open_headless(64, 64, gpu.AUTO);
    if (gpu.device.is_open(&d) == 0) {
        io.printf("FAIL: could not open headless device\n");
        return 2;
    }

    // 3. Create a mesh (cube)
    let is render.mesh.Mesh as cube_mesh = render.mesh.cube(&d);
    if (cube_mesh.vertex_buffer == 0 || cube_mesh.vertex_count != 36) {
        io.printf("FAIL: cube mesh creation failed\n");
        gpu.close(&d);
        return 3;
    }

    // 4. Generate an image and create a GPU texture from it
    let is math.color.Color as red = math.color.rgb(1.0, 0.0, 0.0);
    let is math.color.Color as white = math.color.rgb(1.0, 1.0, 1.0);
    let is img.buffer.Image as chk = img.checkerboard(16, 16, 4, red, white);

    let is render.texture.Texture as tex = render.texture.from_image(&d, &chk);
    if (tex.handle == 0 || tex.width != 16 || tex.height != 16) {
        io.printf("FAIL: texture from_image failed\n");
        img.destroy(&chk);
        render.mesh.destroy(&d, &cube_mesh);
        gpu.close(&d);
        return 4;
    }
    img.destroy(&chk);

    // 5. Create a material
    let is render.material.Material as mat = render.material.textured(&d, tex.handle, 0);
    if (mat.pipeline == 0 || mat.shader == 0) {
        io.printf("FAIL: material creation failed\n");
        render.texture.destroy(&d, &tex);
        render.mesh.destroy(&d, &cube_mesh);
        gpu.close(&d);
        return 5;
    }

    // 6. Create renderer and execute a headless draw pass
    let is render.renderer.Renderer as r = render.open(&d);
    if (r.commands == 0) {
        io.printf("FAIL: renderer.open failed\n");
        render.material.destroy(&d, &mat);
        render.texture.destroy(&d, &tex);
        render.mesh.destroy(&d, &cube_mesh);
        gpu.close(&d);
        return 6;
    }

    let is gpu.swapchain.Surface as s = gpu.swapchain.surface_headless();
    let is i64 as sc = gpu.swapchain.create(&d, &s, 64, 64, 1);
    let is math.color.Color as bg = math.color.from_hex(0x202020);

    let is i32 as ok = render.begin_frame(&r, sc, 64, 64, bg);
    if (ok == 1) {
        let is math.mat.Mat4 as model = math.mat.m4_identity();
        let is math.mat.Mat4 as mvp = math.mat.m4_mul(vp, model);
        render.draw_mesh(&r, &cube_mesh, &mat, mvp);
        render.end_frame(&r);
    } else {
        io.printf("FAIL: render.begin_frame failed\n");
        return 7;
    }

    // 7. Cleanup
    render.close(&r);
    gpu.swapchain.destroy(&d, sc);
    render.material.destroy(&d, &mat);
    render.texture.destroy(&d, &tex);
    render.mesh.destroy(&d, &cube_mesh);
    gpu.close(&d);

    io.printf("render layer: all checks passed\n");
    return 0;
}
