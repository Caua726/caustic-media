// render/texture.cst — GPU texture wrapper created from image.Image.

use "../gpu/device.cst" as dev;
use "../gpu/texture.cst" as tex;
use "../image/buffer.cst" as img;

struct Texture {
    handle as i64;
    width  as i64;
    height as i64;
    format as i32;
}

fn from_image(d as *dev.Device, im as *img.Image) as Texture {
    let is Texture as t;
    t.width = im.width;
    t.height = im.height;
    t.format = im.format;

    let is i32 as tex_fmt with mut = tex.RGBA8;
    if (im.format == img.R8) { tex_fmt = tex.R8; }

    let is tex.Desc as td = tex.desc(im.width, im.height, tex_fmt, tex.SAMPLED);
    t.handle = tex.create(d, &td);
    if (t.handle != 0 && cast(i64, im.pixels) != 0) {
        tex.upload(d, t.handle, im.pixels, img.byte_count(im));
    }
    return t;
}

fn destroy(d as *dev.Device, t as *Texture) as void {
    if (t.handle != 0) {
        tex.destroy(d, t.handle);
        t.handle = 0;
    }
}
