// render/material.cst — materials packaging shaders, textures and pipeline state.

use "../gpu/device.cst" as dev;
use "../gpu/shader.cst" as shd;
use "../gpu/pipeline.cst" as pipe;
use "../gpu/texture.cst" as tex;

struct Material {
    pipeline as i64;
    shader   as i64;
    texture  as i64;
    sampler  as i64;
}

fn unlit_color(d as *dev.Device) as Material {
    let is Material as m;
    m.texture = 0;
    m.sampler = 0;
    m.shader = shd.builtin(d, shd.UNLIT_COLOR);

    let is pipe.Desc as pd = pipe.desc_opaque(m.shader, pipe.layout_pos_color_uv());
    m.pipeline = pipe.create(d, &pd);
    return m;
}

fn textured(d as *dev.Device, texture as i64, sampler as i64) as Material {
    let is Material as m;
    m.texture = texture;
    m.sampler = sampler;
    m.shader = shd.builtin(d, shd.TEXTURED);

    let is pipe.Desc as pd = pipe.desc_opaque(m.shader, pipe.layout_pos_color_uv());
    m.pipeline = pipe.create(d, &pd);
    return m;
}

fn destroy(d as *dev.Device, m as *Material) as void {
    if (m.pipeline != 0) {
        pipe.destroy(d, m.pipeline);
        m.pipeline = 0;
    }
    if (m.shader != 0) {
        shd.destroy(d, m.shader);
        m.shader = 0;
    }
    m.texture = 0;
    m.sampler = 0;
}
