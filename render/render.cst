// render/render.cst — hub for the high-level rendering framework.
//
// A client of gpu/ in the style of raylib, but with explicit state and no hidden
// globals. Resources (meshes, materials, cameras) are declared; draws carry
// their own state.

use "../gpu/device.cst" as dev;
use "../math/math.cst" as math;
use "camera.cst" as camera;
use "mesh.cst" as mesh;
use "material.cst" as material;
use "texture.cst" as texture;
use "renderer.cst" as renderer;

fn open(d as *dev.Device) as renderer.Renderer {
    return renderer.open(d);
}

fn close(r as *renderer.Renderer) as void {
    renderer.close(r);
}

fn begin_frame(r as *renderer.Renderer, sc as i64, w as i64, h as i64, clear_color as math.color.Color) as i32 {
    return renderer.begin_frame(r, sc, w, h, clear_color);
}

fn draw_mesh(r as *renderer.Renderer, m as *mesh.Mesh, mat as *material.Material, mvp as math.mat.Mat4) as void {
    renderer.draw_mesh(r, m, mat, mvp);
}

fn end_frame(r as *renderer.Renderer) as void {
    renderer.end_frame(r);
}
