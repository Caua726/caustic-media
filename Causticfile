name "caustic-media"
version "0.0.1"
author "Caua"

// The sibling libraries this one builds on, fetched by caustic-mk into
// .caustic/deps at their tags — never a path into a directory beside this
// one. caustic-image decodes images (image/load.cst) and needs
// caustic-compact's DEFLATE; caustic-unicode is the text layer's breaking,
// bidi and segmentation. caustic-mk puts them on the module path of every
// target below; a module that uses one is built by a target, not by the bare
// compiler in a script.
depend "caustic-unicode" in "https://github.com/Caua726/caustic-unicode" tag "v0.1.0"
depend "caustic-image" in "https://github.com/Caua726/caustic-image" tag "v0.1.0"
depend "caustic-compact" in "https://github.com/Caua726/caustic-compact" tag "v0.1.0"

// Images decoded through caustic-image.
target "load_test" {
    src "image/load_test.cst"
    out "build/load_test"
}

// Fallback chains, which need caustic-unicode's script and emoji tables; and
// the font hub, which opens them.
target "font_chain_test" {
    src "text/fonts/chain_test.cst"
    out "build/font_chain_test"
}
target "fonts_test" {
    src "text/fonts/fonts_test.cst"
    out "build/fonts_test"
}

// Shaping, which needs caustic-unicode's properties and normalization.
target "shape_test" {
    src "text/shape/shape_test.cst"
    out "build/shape_test"
}
target "shape_parts_test" {
    src "text/shape/parts_test.cst"
    out "build/shape_parts_test"
}

// Layout, which needs caustic-unicode's bidi, line breaking and segments.
target "layout_test" {
    src "text/layout/layout_test.cst"
    out "build/text_layout_test"
}

// Colour glyphs, whose bitmaps are PNG: caustic-image and caustic-compact.
target "color_test" {
    src "text/color/color_test.cst"
    out "build/text_color_test"
}

// The toolkit's text service, which lays out through text/layout.
target "ui_text_test" {
    src "ui/text_test.cst"
    out "build/ui_text_test"
}

// The first widgets, which lay their text out through the text service.
target "label_test" {
    src "ui/widgets/label_test.cst"
    out "build/label_test"
}

target "button_test" {
    src "ui/widgets/button_test.cst"
    out "build/button_test"
}

target "check_test" {
    src "ui/widgets/check_test.cst"
    out "build/check_test"
}

target "group_test" {
    src "ui/widgets/group_test.cst"
    out "build/group_test"
}

target "tooltip_test" {
    src "ui/widgets/tooltip_test.cst"
    out "build/tooltip_test"
}

target "spin_test" {
    src "ui/widgets/spin_test.cst"
    out "build/spin_test"
}

target "entry_test" {
    src "ui/widgets/entry_test.cst"
    out "build/entry_test"
