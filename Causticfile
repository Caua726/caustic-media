name "caustic-media"
version "0.0.1"
author "Caua"

// The sibling libraries this one builds on, fetched by caustic-mk into
// .caustic/deps at their tags — never a path into a directory beside this
// one. caustic-image decodes images (image/load.cst) and needs
// caustic-compact's DEFLATE; caustic-unicode is the text layer's breaking,
// bidi and segmentation. caustic-mk puts them on the module path of every
// target below; a module that uses one is built by a target, not by the bare
// compiler in a script.
depend "caustic-unicode" in "https://github.com/Caua726/caustic-unicode" tag "v0.1.0"
depend "caustic-image" in "https://github.com/Caua726/caustic-image" tag "v0.1.0"
depend "caustic-compact" in "https://github.com/Caua726/caustic-compact" tag "v0.1.0"

// Images decoded through caustic-image.
target "load_test" {
    src "image/load_test.cst"
    out "build/load_test"
}

// Fallback chains, which need caustic-unicode's script and emoji tables; and
// the font hub, which opens them.
target "font_chain_test" {
    src "text/fonts/chain_test.cst"
    out "build/font_chain_test"
}
target "fonts_test" {
    src "text/fonts/fonts_test.cst"
    out "build/fonts_test"
}

// Shaping, which needs caustic-unicode's properties and normalization.
target "shape_test" {
    src "text/shape/shape_test.cst"
    out "build/shape_test"
}
target "shape_parts_test" {
    src "text/shape/parts_test.cst"
    out "build/shape_parts_test"
}

// Layout, which needs caustic-unicode's bidi, line breaking and segments.
target "layout_test" {
    src "text/layout/layout_test.cst"
    out "build/text_layout_test"
}

// Each library above built for Windows, run under wine by test-win32.
target "win_unicode" {
    src "tools/windows/unicode_check.cst"
    out "build/unicode_check.exe"
    flags "--target=windows-x86_64"
}
target "win_image" {
    src "tools/windows/image_check.cst"
    out "build/image_check.exe"
    flags "--target=windows-x86_64"
}
target "win_compact" {
    src "tools/windows/compact_check.cst"
    out "build/compact_check.exe"
    flags "--target=windows-x86_64"
}

script "test" {
    "mkdir -p build"
    "caustic -q math/math_test.cst -o build/math_test"
    "./build/math_test"
    "caustic -q math/geom_test.cst -o build/geom_test"
    "./build/geom_test"
    "caustic -q gpu/software/raster_test.cst -o build/raster_test"
    "./build/raster_test"
    "caustic -q gpu/gpu_test.cst -o build/gpu_test"
    "./build/gpu_test"
    // What 2D needs from the device: scissor, coverage, partial texture uploads
    "caustic -q gpu/gpu2d_test.cst -o build/gpu2d_test"
    "./build/gpu2d_test"
    // vkcube's geometry, checked headless: each of the six faces drawn on its
    // own with the camera square in front of it. Counting pixels of the whole
    // cube cannot catch a reversed winding — a cube seen from inside has the
    // same silhouette — so this draws one face at a time.
    "caustic -q examples/vkcube.cst -o build/vkcube"
    "./build/vkcube --check"
    // Belongs here rather than in test-x11 because it links nothing: it only
    // measures Caustic structs against the offsets the C compiler produced, so
    // it needs no libX11, no DISPLAY and no X server.
    "caustic -q window/x11/x11_layout_test.cst -o build/x11_layout_test"
    "./build/x11_layout_test"
    // Vulkan struct layout checks: asserts sizeof and field offsets against C layout.txt
    "caustic -q gpu/vk/vk_layout_test.cst -o build/vk_layout_test"
    "./build/vk_layout_test"
    // Image layer tests: allocation, pixel access, copy, transform, generators
    "caustic -q image/image_test.cst -o build/image_test"
    "./build/image_test"
    // The atlas: rectangles packed into pages, reused least recently first
    "caustic -q image/atlas_test.cst -o build/atlas_test"
    "./build/atlas_test"
    // Alpha multiplied in and out, rectangles copied between images
    "caustic -q image/transform_test.cst -o build/image_transform_test"
    "./build/image_transform_test"
    // Decoding, through caustic-image, which caustic-mk fetches
    "caustic-mk build -q load_test"
    "./build/load_test"
    // Render layer tests: camera, mesh, material, texture, high-level renderer
    "caustic -q render/render_test.cst -o build/render_test"
    "./build/render_test"
    // The 2D family: a canvas that batches, clips and layers, and its shapes
    "caustic -q render/draw2d_test.cst -o build/draw2d_test"
    "./build/draw2d_test"
    // The toolkit's widget tree: handles, structure, recursive destruction, flags
    "caustic -q ui/tree_test.cst -o build/tree_test"
    "./build/tree_test"
    // The application: its windows, each with its own tree and router
    "caustic -q ui/app_test.cst -o build/app_test"
    "./build/app_test"
    // Layout: the measure/place protocol, then each container on its own
    "caustic -q ui/layout_test.cst -o build/layout_test"
    "./build/layout_test"
    "caustic -q ui/box_test.cst -o build/box_test"
    "./build/box_test"
    "caustic -q ui/grid_test.cst -o build/grid_test"
    "./build/grid_test"
    "caustic -q ui/stack_test.cst -o build/stack_test"
    "./build/stack_test"
    "caustic -q ui/snap_test.cst -o build/snap_test"
    "./build/snap_test"
    "caustic -q ui/scroll_test.cst -o build/scroll_test"
    "./build/scroll_test"
    "caustic -q ui/splitter_test.cst -o build/splitter_test"
    "./build/splitter_test"
    // Events: pointer routing, focus and keys, shortcuts and mnemonics, timers
    "caustic -q ui/router_test.cst -o build/router_test"
    "./build/router_test"
    "caustic -q ui/focus_test.cst -o build/focus_test"
    "./build/focus_test"
    "caustic -q ui/shortcut_test.cst -o build/shortcut_test"
    "./build/shortcut_test"
    "caustic -q ui/timer_test.cst -o build/timer_test"
    "./build/timer_test"
    "caustic -q ui/longpress_test.cst -o build/longpress_test"
    "./build/longpress_test"
    // Signals and models: what widgets tell the program, what views read
    "caustic -q ui/signal_test.cst -o build/signal_test"
    "./build/signal_test"
    "caustic -q ui/model_test.cst -o build/model_test"
    "./build/model_test"
    // Damage: what a frame has to repaint, found from the tree without painting
    "caustic -q ui/damage_test.cst -o build/damage_test"
    "./build/damage_test"
    // Painting: the tree drawn region by region and read back as pixels
    "caustic -q ui/paint_test.cst -o build/paint_test"
    "./build/paint_test"
    "caustic -q ui/cache_test.cst -o build/cache_test"
    "./build/cache_test"
    "caustic -q ui/style_test.cst -o build/style_test"
    "./build/style_test"
    // Moved and faded without laying out: translation, opacity through textures
    "caustic -q ui/visual_test.cst -o build/visual_test"
    "./build/visual_test"
    // Tweens on a clock the test holds: easing, replacing, repeating, reduced motion
    "caustic -q ui/anim_test.cst -o build/anim_test"
    "./build/anim_test"
    // Fonts: the sfnt container, held to what fontTools reads from the test
    // fonts (text/testdata), and malformed input against a guard page
    "caustic -q text/sfnt/sfnt_test.cst -o build/sfnt_test"
    "./build/sfnt_test"
    // Variable fonts: axes, instances and HarfBuzz's coordinates to the bit,
    // avar 1 and 2, the variation store, HVAR and MVAR
    "caustic -q text/sfnt/var_test.cst -o build/var_test"
    "./build/var_test"
    // Outlines: every glyph of the test fonts held to what fontTools draws, at
    // the variable ones' instances too, then composites, charstrings and gvar
    // malformed, looping and fanning out
    "caustic -q text/outline/outline_test.cst -o build/outline_test"
    "./build/outline_test"
    // Coverage: paths and glyphs held to an exact reference, both winding
    // rules, any transform; refusals, strides and NaNs
    "caustic -q text/raster/raster_test.cst -o build/text_raster_test"
    "./build/text_raster_test"
    // The glyph cache: drawn once per font, size and step, found again, given
    // way least recently used, colour kept apart
    "caustic -q text/atlas_test.cst -o build/glyph_atlas_test"
    "./build/glyph_atlas_test"
    // Shaping: the test fonts' text through the default shaper, held glyph by
    // glyph — index, cluster, advances, offsets — to HarfBuzz's, and where it
    // says text may be broken, broken; then its parts held to their sources
    "caustic-mk build -q shape_test"
    "./build/shape_test"
    "caustic-mk build -q shape_parts_test"
    "./build/shape_parts_test"
    // Layout: lines, breaking, both directions, alignment, faces and styles;
    // the caret, hitting, selections and moving
    "caustic-mk build -q layout_test"
    "./build/text_layout_test"
    // Finding fonts: the files under a directory, every face described and
    // kept in a file, CSS's matching, fallback chains; then the hub, and this
    // machine's own fonts with the index kept in /tmp, never in the user's
    // cache
    "caustic -q window/fonts_test.cst -o build/window_fonts_test"
    "./build/window_fonts_test"
    "caustic -q text/fonts/scan_test.cst -o build/font_scan_test"
    "./build/font_scan_test"
    "caustic -q text/fonts/index_test.cst -o build/font_index_test"
    "./build/font_index_test"
    "caustic -q text/fonts/match_test.cst -o build/font_match_test"
    "./build/font_match_test"
    "caustic-mk build -q font_chain_test"
    "./build/font_chain_test"
    "caustic-mk build -q fonts_test"
    "env XDG_CACHE_HOME=/tmp/caustic-media-test-cache ./build/fonts_test"
    // Linux syscalls under D-Bus and Wayland: Unix sockets, descriptors passed
    "caustic -q sys/linux_test.cst -o build/sys_test"
    "./build/sys_test"
    // D-Bus: the wire format, messages, addresses; then two connections, and
    // busctl (sd-bus) against an exported object, each on a private bus of its
    // own (dbus-run-session) — never the desktop's
    "caustic -q dbus/wire_test.cst -o build/dbus_wire_test"
    "./build/dbus_wire_test"
    "caustic -q dbus/message_test.cst -o build/dbus_message_test"
    "./build/dbus_message_test"
    "caustic -q dbus/address_test.cst -o build/dbus_address_test"
    "./build/dbus_address_test"
    "caustic -q dbus/conn_test.cst -o build/dbus_conn_test"
    "sh dbus/tools/run_dbus.sh ./build/dbus_conn_test"
    "caustic -q dbus/tools/busctl_peer.cst -o build/busctl_peer"
    "sh dbus/tools/run_dbus.sh sh dbus/tools/busctl_check.sh ./build/busctl_peer"
    // The desktop's settings: fonts, theme names, merging, GTK's settings.ini
    "caustic -q window/settings_test.cst -o build/window_settings_test"
    "./build/window_settings_test"
    // The settings portal, played by a child process on a private bus
    "caustic -q window/linux/portal_test.cst -o build/portal_test"
    "sh dbus/tools/run_dbus.sh ./build/portal_test"
    // The desktop's settings turned into the theme and the timings
    "caustic -q ui/system_test.cst -o build/system_test"
    "./build/system_test"
    // Immediate-mode UI tests: widgets stay inside the target whatever rect they get
    "caustic -q ui/immediate/immediate_test.cst -o build/immediate_test"
    "./build/immediate_test"
    // ALSA audio layout tests: asserts sizeof and field offsets against C layout.txt
    "caustic -q audio/alsa/pcm_layout_test.cst -o build/pcm_layout_test"
    "./build/pcm_layout_test"
    // Audio layer tests: sample conversions, pcm negotiation, direct ioctl playback
    "caustic -q audio/audio_test.cst -o build/audio_test"
    "./build/audio_test"
    // Audio tone generation example check
    "caustic -q examples/audio_tone.cst -o build/audio_tone"
    "./build/audio_tone --check"
}

// What runs on Windows, under wine. Apart from `test` for the same reason as
// test-x11: the main suite needs no wine. For now the libraries this one
// builds on, each built for Windows and run: what the Win32 backend will
// stand on.
script "test-win32" {
    "mkdir -p build"
    "caustic-mk build -q win_unicode"
    "sh tools/run_wine.sh build/unicode_check.exe"
    "caustic-mk build -q win_image"
    "sh tools/run_wine.sh build/image_check.exe"
    "caustic-mk build -q win_compact"
    "sh tools/run_wine.sh build/compact_check.exe"
    // Where Windows keeps fonts and the font index, from wine's environment
    "caustic -q --target=windows-x86_64 window/fonts_test.cst -o build/window_fonts_test.exe"
    "sh tools/run_wine.sh build/window_fonts_test.exe"
}

// Everything that needs libX11 on the machine or a server to talk to. Kept
// apart from `test` so the promise that the main suite is headless stays true:
// a checkout with no X libraries still runs it all.
script "test-x11" {
    "mkdir -p build"
    "sh window/x11/tools/check_constants.sh"
    "sh window/x11/tools/check_symbols.sh"
    // Never call X. They exist so the dynamic loader resolves every bound name
    // at exec under BIND_NOW: one misspelling and the binary dies before main.
    // One per shared object so a failure names its library; the calls live in
    // window/x11/link/, and all_link_test below makes every one of them at once.
    "caustic -q window/x11/x11_link_test.cst -o build/x11_link_test"
    "./build/x11_link_test"
    "sh window/x11/tools/check_needed.sh build/x11_link_test 1 libX11.so.6"
    "caustic -q window/x11/xss_link_test.cst -o build/xss_link_test"
    "./build/xss_link_test"
    "sh window/x11/tools/check_needed.sh build/xss_link_test 1 libXss.so.1"
    "caustic -q window/x11/xext_link_test.cst -o build/xext_link_test"
    "./build/xext_link_test"
    "sh window/x11/tools/check_needed.sh build/xext_link_test 1 libXext.so.6"
    "caustic -q window/x11/xrandr_link_test.cst -o build/xrandr_link_test"
    "./build/xrandr_link_test"
    "sh window/x11/tools/check_needed.sh build/xrandr_link_test 1 libXrandr.so.2"
    "caustic -q window/x11/xcursor_link_test.cst -o build/xcursor_link_test"
    "./build/xcursor_link_test"
    "sh window/x11/tools/check_needed.sh build/xcursor_link_test 1 libXcursor.so.1"
    // The two libXcursor 1.2.3 added, apart so an older library — Ubuntu 24.04
    // ships 1.2.1 — skips them instead of failing the other 59 at exec.
    "caustic -q window/x11/xcursor_1_2_3_link_test.cst -o build/xcursor_1_2_3_link_test"
    "sh window/x11/tools/run_since.sh libXcursor.so.1 1.2.3 ./build/xcursor_1_2_3_link_test"
    "sh window/x11/tools/check_needed.sh build/xcursor_1_2_3_link_test 1 libXcursor.so.1"
    "caustic -q window/x11/xfixes_link_test.cst -o build/xfixes_link_test"
    "./build/xfixes_link_test"
    "sh window/x11/tools/check_needed.sh build/xfixes_link_test 1 libXfixes.so.3"
    "caustic -q window/x11/xi_link_test.cst -o build/xi_link_test"
    "./build/xi_link_test"
    "sh window/x11/tools/check_needed.sh build/xi_link_test 1 libXi.so.6"
    // All seven at once, 1161 imports: what a program linking several of them
    // looks like, every soname recorded.
    "caustic -q window/x11/all_link_test.cst -o build/all_link_test"
    "./build/all_link_test"
    "sh window/x11/tools/check_needed.sh build/all_link_test 7 libX11.so.6 libXss.so.1 libXext.so.6 libXrandr.so.2 libXcursor.so.1 libXfixes.so.3 libXi.so.6"
    // The functional half: opens real windows on a real server, blits real
    // frames and reads them back with XGetImage. run_headless.sh supplies the
    // server, waits for it to actually answer, and tears it down after.
    "caustic -q window/x11/x11_test.cst -o build/x11_test"
    "sh window/x11/tools/run_headless.sh ./build/x11_test"
    // The window-manager requests. Under Xvfb nothing manages the window, so
    // what this asserts there is that every request is well formed and every
    // query answers honestly when there is no answer. On a desktop it also
    // checks the fullscreen round trip.
    "caustic -q window/x11/wm_test.cst -o build/wm_test"
    "sh window/x11/tools/run_headless.sh ./build/wm_test"
    // Key presses in, the text a person typed out. Synthetic events with the
    // keycodes the real keymap reports, so it exercises the server's own
    // translation rather than a table this repo wrote.
    "caustic -q window/x11/text_test.cst -o build/text_test"
    "sh window/x11/tools/run_headless.sh ./build/text_test"
    // The sync counter and the frame limiter, both on the frame path and
    // neither called by a program directly.
    "caustic -q window/x11/framesync_test.cst -o build/framesync_test"
    "sh window/x11/tools/run_headless.sh ./build/framesync_test"
    // A real drag, driven from a second connection, because a client cannot
    // drop on itself in any way that proves the protocol works.
    "caustic -q window/x11/dnd_test.cst -o build/dnd_test"
    "sh window/x11/tools/run_headless.sh ./build/dnd_test"
    // Two windows on one connection, and events reaching the right one. Written
    // before the shared-connection refactor so there was something to regress
    // against, and it caught two bugs in it.
    "caustic -q window/x11/multi_test.cst -o build/multi_test"
    "sh window/x11/tools/run_headless.sh ./build/multi_test"
    // A window and a frame need libX11 and libXext, and nothing else, even
    // though bind/ declares four more libraries.
    "sh window/x11/tools/check_needed.sh build/x11_test 2 libX11.so.6 libXext.so.6"
    // The cursor, the monitors and the clipboard. Its own binary because it
    // genuinely links all six, which is what keeps the assertion above honest.
    "caustic -q window/x11/x11_ext_test.cst -o build/x11_ext_test"
    "sh window/x11/tools/run_headless.sh ./build/x11_ext_test"
    // A program that opens a window and draws links exactly two: libX11, and
    // libXext because the presentation path negotiates MIT-SHM. Not the other
    // four the hub imports — no Xrandr, no Xcursor, no Xfixes, no Xi — because
    // nothing reachable from main calls into them. That is the whole reason
    // binding a thousand symbols is affordable, and it is asserted rather than
    // assumed.
    "caustic -q examples/cube.cst -o build/cube"
    "sh window/x11/tools/check_needed.sh build/cube 2 libX11.so.6 libXext.so.6"
    // The interactive one reads the keyboard, the pointer and the wheel, and
    // asks for a fixed size. It links the same two: input is libX11's, and
    // nothing it touches reaches Xrandr, Xcursor, Xfixes or Xi.
    "caustic -q examples/cube_interactive.cst -o build/cube_interactive"
    "sh window/x11/tools/check_needed.sh build/cube_interactive 2 libX11.so.6 libXext.so.6"
    // vkcube portable window integration check
    "sh window/x11/tools/check_needed.sh build/vkcube 2 libX11.so.6 libXext.so.6"
    // The portable window abstraction hub
    "caustic -q window/window_test.cst -o build/window_test"
    "sh window/x11/tools/run_headless.sh ./build/window_test"
    "sh window/x11/tools/check_needed.sh build/window_test 2 libX11.so.6 libXext.so.6"
    // XSETTINGS: the property's format, and a daemon followed as it starts,
    // changes its settings and quits — played by the test on a second connection
    "caustic -q window/x11/xsettings_test.cst -o build/xsettings_test"
    "sh window/x11/tools/run_headless.sh ./build/xsettings_test"
    "sh window/x11/tools/check_needed.sh build/xsettings_test 1 libX11.so.6"
    // The same through the portable window: read_settings, and SETTINGS events
    // in its queue; GTK's files from window/testdata, not this machine's
    "caustic -q window/settings_x11_test.cst -o build/settings_x11_test"
    "XDG_CONFIG_HOME=window/testdata/xdg sh window/x11/tools/run_headless.sh ./build/settings_x11_test"
    "sh window/x11/tools/check_needed.sh build/settings_x11_test 2 libX11.so.6 libXext.so.6"
}
