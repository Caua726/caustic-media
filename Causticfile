target "expander_test" {
    src "ui/widgets/expander_test.cst"
    out "build/expander_test"
}

target "toolbar_test" {
    src "ui/widgets/toolbar_test.cst"
    out "build/toolbar_test"
}

target "statusbar_test" {
    src "ui/widgets/statusbar_test.cst"
    out "build/statusbar_test"
}

target "menubar_test" {
    src "ui/widgets/menubar_test.cst"
    out "build/menubar_test"
}

target "assistant_test" {
    src "ui/widgets/assistant_test.cst"
    out "build/assistant_test"
