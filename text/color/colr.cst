// text/color/colr.cst — colour glyphs in layers: COLR gives a glyph a list
// of other glyphs, drawn one over another from the first, each in a colour
// of a palette; CPAL holds the palettes.
//
// These are COLR's version 0 records, which version 1 keeps alongside its
// own. A layer's colour is an entry of the palette in use, or — entry
// 0xFFFF — the colour the text is drawn in. Colours are given here as
// 0xRRGGBBAA, not premultiplied.
use "../sfnt/table.cst" as table;

let is i64 as TAG_COLR with imut = 0x434F4C52;
let is i64 as TAG_CPAL with imut = 0x4350414C;

let is i64 as FOREGROUND with imut = 65535;

struct Layer {
    glyph as i64;
    entry as i64;   // in the palette; FOREGROUND for the text's colour
}

fn _colr(f as *table.Face) as table.Table { return table.find(f, TAG_COLR); }
fn _cpal(f as *table.Face) as table.Table { return table.find(f, TAG_CPAL); }

fn present(f as *table.Face) as i32 { return cast(i32, _colr(f).len >= 14); }

// The base glyph record of gid, by a binary search of them sorted; 0 for
// none.
fn _base(f as *table.Face, gid as i64) as i64 {
    let is table.Table as t = _colr(f);
    if (t.len < 14) { return 0; }
    let is i64 as n = table.u16_at(f, t.off + 2);
    let is i64 as recs = t.off + table.u32_at(f, t.off + 4);
    if (table.inside(t, recs, n * 6) == 0) { return 0; }
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = n - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is i64 as g = table.u16_at(f, recs + mid * 6);
        if (gid < g) { hi = mid - 1; } else if (gid > g) { lo = mid + 1; } else { return recs + mid * 6; }
    }
    return 0;
}

// How many layers glyph gid is drawn in; 0 for a glyph that is not one of
// COLR's.
fn layer_count(f as *table.Face, gid as i64) as i64 {
    let is i64 as rec = _base(f, gid);
    if (rec == 0) { return 0; }
    let is table.Table as t = _colr(f);
    let is i64 as first = table.u16_at(f, rec + 2);
    let is i64 as n = table.u16_at(f, rec + 4);
    let is i64 as layers = t.off + table.u32_at(f, t.off + 8);
    let is i64 as total = table.u16_at(f, t.off + 12);
    if (first + n > total || table.inside(t, layers + first * 4, n * 4) == 0) { return 0; }
    return n;
}

// Layer i of glyph gid, the first drawn first.
fn layer(f as *table.Face, gid as i64, i as i64) as Layer {
    let is Layer as l;
    l.glyph = 0;
    l.entry = FOREGROUND;
    let is i64 as rec = _base(f, gid);
    if (rec == 0 || i < 0 || i >= layer_count(f, gid)) { return l; }
    let is table.Table as t = _colr(f);
    let is i64 as at = t.off + table.u32_at(f, t.off + 8) + (table.u16_at(f, rec + 2) + i) * 4;
    l.glyph = table.u16_at(f, at);
    l.entry = table.u16_at(f, at + 2);
    return l;
}

// --- Palettes ---

fn palettes(f as *table.Face) as i64 {
    let is table.Table as t = _cpal(f);
    if (t.len < 12) { return 0; }
    let is i64 as n = table.u16_at(f, t.off + 4);
    if (table.inside(t, t.off + 12, n * 2) == 0) { return 0; }
    return n;
}

fn entries(f as *table.Face) as i64 {
    if (palettes(f) == 0) { return 0; }
    return table.u16_at(f, _cpal(f).off + 2);
}

// Entry e of palette p as 0xRRGGBBAA — or fg, the text's colour, for the
// foreground, and for an entry or palette the font does not have.
fn color(f as *table.Face, p as i64, e as i64, fg as u32) as u32 {
    if (e == FOREGROUND || p < 0 || p >= palettes(f) || e < 0 || e >= entries(f)) { return fg; }
    let is table.Table as t = _cpal(f);
    let is i64 as records = t.off + table.u32_at(f, t.off + 8);
    let is i64 as first = table.u16_at(f, t.off + 12 + p * 2);
    let is i64 as at = records + (first + e) * 4;
    if (first + e >= table.u16_at(f, t.off + 6) || table.inside(t, at, 4) == 0) { return fg; }
    // Stored blue, green, red, alpha.
    let is i64 as b = table.u8_at(f, at);
    let is i64 as g = table.u8_at(f, at + 1);
    let is i64 as r = table.u8_at(f, at + 2);
    let is i64 as a = table.u8_at(f, at + 3);
    return cast(u32, (r << 24) | (g << 16) | (b << 8) | a);
}
