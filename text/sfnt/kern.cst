// text/sfnt/kern.cst — the legacy kerning table: pairs of glyphs and how
// much closer or further apart they sit, in font units.
//
// Modern fonts kern in GPOS, which the shaper reads; this is the table older
// TrueType fonts carry instead, and some carry both. Microsoft's version 0
// with format 0 subtables is read — sorted pairs, searched — summed across the
// horizontal subtables that are not cross-stream, an override subtable
// replacing what came before. Apple's version 1 header says nothing here.
//
// A subtable's own length field is 16 bits and overflows in fonts with many
// pairs, so the pair count bounds the search instead.
use "table.cst" as table;

fn _pair(f as *table.Face, st as i64, end as i64, left as i64, right as i64) as i64 {
    let is i64 as n = table.u16_at(f, st + 6);
    let is i64 as pairs = st + 14;
    if (pairs + n * 6 > end) { return 0; }
    let is i64 as key = (left << 16) | right;
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = n;
    while (lo < hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is i64 as p = pairs + mid * 6;
        let is i64 as k = (table.u16_at(f, p) << 16) | table.u16_at(f, p + 2);
        if (k < key) { lo = mid + 1; } else if (k > key) { hi = mid; } else { return table.i16_at(f, p + 4); }
    }
    return 0;
}

// The adjustment between left and right; 0 for none.
fn pair(f as *table.Face, left as i64, right as i64) as i64 {
    let is table.Table as t = f.kern;
    if (table.inside(t, t.off, 4) == 0 || table.u16_at(f, t.off) != 0) { return 0; }
    let is i64 as end = t.off + t.len;
    let is i64 as n = table.u16_at(f, t.off + 2);
    let is i64 as st with mut = t.off + 4;
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n && st + 14 <= end) {
        let is i64 as len = table.u16_at(f, st + 2);
        let is i64 as cov = table.u16_at(f, st + 4);
        // Horizontal, format 0, not cross-stream.
        if ((cov & 1) != 0 && (cov >> 8) == 0 && (cov & 4) == 0) {
            let is i64 as k = _pair(f, st, end, left, right);
            if ((cov & 8) != 0) { v = k; } else { v = v + k; }
        }
        // The next subtable: where this one's pairs end for format 0, its
        // length otherwise.
        if ((cov >> 8) == 0) { st = st + 14 + table.u16_at(f, st + 6) * 6; } else { st = st + len; }
        if (len == 0 && (cov >> 8) != 0) { i = n; }
        i = i + 1;
    }
    return v;
}
