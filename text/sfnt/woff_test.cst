// text/sfnt/woff_test.cst — with two paths, undoes the first into the second, for comparing
// with another reader's idea of the same font. Alone: what is not a font must say so, and
// what is cut short or has bytes changed must not get past the end of anything.

use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "woff.cst" as woff;

let is i64 as _fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 1) { return; }
    _fails = _fails + 1;
    io.write_str(1, "FAIL  ");
    io.write_str(1, name);
    io.write_str(1, "\n");
}

fn load(path as *u8, out as *i64) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    if (fd < 0) { return cast(*u8, 0); }
    let is i64 as cap with mut = 67108864;
    let is *u8 as p = mem.core.mmap_anon(cap);
    let is i64 as n with mut = 0;
    while (1 == 1) {
        let is i64 as got = linux.read(fd, &p[n], cap - n);
        if (got <= 0) { break; }
        n = n + got;
    }
    linux.close(fd);
    *out = n;
    return p;
}

// What the file is, as many mangled ways as it can be asked in a moment. Returning at all
// is the test.
fn mangle(data as *u8, n as i64) as void {
    let is *u8 as copy = mem.core.mmap_anon(n + 1);
    let is i64 as seed with mut = 88172645463325252;
    let is i64 as round with mut = 0;
    while (round < 200) {
        mem.core.memcpy(copy, data, n);
        let is i64 as k with mut = 0;
        while (k < 1 + round % 8) {
            seed = seed ^ (seed << 13);
            seed = seed ^ ((seed >> 7) & 0x1FFFFFFFFFFFFFF);
            seed = seed ^ (seed << 17);
            let is i64 as at = ((seed >> 3) & 0xFFFFFFFFFF) % n;
            copy[at] = cast(u8, seed & 255);
            k = k + 1;
        }
        let is i64 as size with mut = 0;
        let is i64 as len with mut = n;
        if (round % 3 == 0) { len = ((seed >> 9) & 0xFFFFFFFF) % n; }
        let is *u8 as out = woff.unwrap(copy, len, &size);
        woff.free(out, size);
        round = round + 1;
    }
    mem.core.munmap(copy, n + 1);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (env.argc() == 3) {
        let is i64 as n with mut = 0;
        let is *u8 as data = load(env.argv(1), &n);
        if (cast(i64, data) == 0) { return 2; }
        let is i64 as size with mut = 0;
        let is *u8 as out = woff.unwrap(data, n, &size);
        if (cast(i64, out) == 0) { return 3; }
        let is i64 as fd = linux.open(env.argv(2), 577, 420);
        linux.write(fd, out, size);
        linux.close(fd);
        return 0;
    }
    if (env.argc() == 2) {
        let is i64 as n with mut = 0;
        let is *u8 as data = load(env.argv(1), &n);
        if (cast(i64, data) == 0) { return 2; }
        check("it is one", cast(i32, woff.is_wrapped(data, n) == 1));
        mangle(data, n);
        io.write_str(1, "mangled and still here\n");
        return cast(i32, _fails);
    }
    let is i64 as size with mut = 0;
    check("nothing is no font", cast(i32, cast(i64, woff.unwrap("", 0, &size)) == 0));
    check("a plain file is not wrapped", cast(i32, woff.is_wrapped("\x00\x01\x00\x00", 4) == 0));
    if (_fails == 0) { io.write_str(1, "woff: all checks pass\n"); }
    return cast(i32, _fails);
}
