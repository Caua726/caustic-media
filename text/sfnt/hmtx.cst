// text/sfnt/hmtx.cst — how far each glyph advances the pen, and where its
// outline starts, in font units.
//
// The table holds an advance and a left side bearing for the first
// numberOfHMetrics glyphs; the rest share the last advance — a monospaced
// tail, typically — and have their side bearings alone, after.
use "table.cst" as table;

fn advance(f as *table.Face, gid as i64) as i64 {
    if (gid < 0 || gid >= f.glyphs || f.hmetrics <= 0) { return 0; }
    let is i64 as i with mut = gid;
    if (i >= f.hmetrics) { i = f.hmetrics - 1; }
    return table.u16_at(f, f.hmtx.off + i * 4);
}

fn lsb(f as *table.Face, gid as i64) as i64 {
    if (gid < 0 || gid >= f.glyphs) { return 0; }
    if (gid < f.hmetrics) { return table.i16_at(f, f.hmtx.off + gid * 4 + 2); }
    let is i64 as at = f.hmtx.off + f.hmetrics * 4 + (gid - f.hmetrics) * 2;
    if (table.inside(f.hmtx, at, 2) == 0) { return 0; }
    return table.i16_at(f, at);
}
