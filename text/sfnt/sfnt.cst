// text/sfnt/sfnt.cst — the hub. See sfnt.md.
use "table.cst" as table;
use "head.cst" as head;
use "hmtx.cst" as hmtx;
use "cmap.cst" as cmap;
use "name.cst" as name;
use "kern.cst" as kern;
use "var.cst" as var;

// Face index of the font in data — 0 for a single font, which face of a
// collection otherwise — with its tables located, its counts read and its
// Unicode mapping chosen. f.ok says whether it can be used; f.err why not.
fn open(data as *u8, size as i64, index as i64) as table.Face {
    let is table.Face as f with mut = table.directory(data, size, index);
    if (f.err != table.OK) { return f; }
    if (head.read(&f) == 0) { return f; }
    cmap.select(&f);
    f.ok = 1;
    return f;
}
