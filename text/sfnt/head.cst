// text/sfnt/head.cst — head, hhea, maxp, OS/2 and post: the numbers every face
// needs before a glyph is read, and the metrics a layout lines text up by.
//
// Two tables say how tall a line is, and they disagree often enough that the
// answer is a convention. Browsers' is taken: OS/2's typographic values when
// the font sets USE_TYPO_METRICS, hhea's otherwise, and when hhea says nothing
// at all, OS/2's typographic values and then its Windows clipping ones.
use "table.cst" as table;

struct Head {
    upem       as i64;
    x_min      as i64;   // every glyph's bounding box, font units
    y_min      as i64;
    x_max      as i64;
    y_max      as i64;
    mac_style  as i64;   // bit 0 bold, bit 1 italic
    loc_format as i64;   // 0: loca holds 16-bit offsets halved; 1: 32-bit
}

struct Hhea {
    ascender  as i64;
    descender as i64;   // below the baseline: negative
    line_gap  as i64;
    hmetrics  as i64;   // numberOfHMetrics
}

// What OS/2 says; zeros for a face without one, and for fields its version
// does not have.
struct Os2 {
    version      as i64;
    weight       as i64;   // usWeightClass: 400 regular, 700 bold
    width        as i64;   // usWidthClass: 5 normal
    fs_selection as i64;
    typo_asc     as i64;
    typo_desc    as i64;
    typo_gap     as i64;
    win_asc      as i64;
    win_desc     as i64;   // positive, below the baseline
    x_height     as i64;
    cap_height   as i64;
    strike_size  as i64;
    strike_pos   as i64;
}

struct Post {
    underline_pos       as i64;   // the top of the underline: negative below
    underline_thickness as i64;
    italic_angle        as i64;   // 16.16 degrees, counter-clockwise from vertical
    fixed_pitch         as i64;
}

let is i64 as SEL_ITALIC     with imut = 1;
let is i64 as SEL_BOLD       with imut = 32;
let is i64 as SEL_REGULAR    with imut = 64;
let is i64 as SEL_USE_TYPO   with imut = 128;
let is i64 as SEL_OBLIQUE    with imut = 512;

fn head(f as *table.Face) as Head {
    let is Head as h;
    let is i64 as o = f.head.off;
    h.upem = table.u16_at(f, o + 18);
    h.x_min = table.i16_at(f, o + 36);
    h.y_min = table.i16_at(f, o + 38);
    h.x_max = table.i16_at(f, o + 40);
    h.y_max = table.i16_at(f, o + 42);
    h.mac_style = table.u16_at(f, o + 44);
    h.loc_format = table.i16_at(f, o + 50);
    return h;
}

fn hhea(f as *table.Face) as Hhea {
    let is Hhea as h;
    let is i64 as o = f.hhea.off;
    h.ascender = table.i16_at(f, o + 4);
    h.descender = table.i16_at(f, o + 6);
    h.line_gap = table.i16_at(f, o + 8);
    h.hmetrics = table.u16_at(f, o + 34);
    return h;
}

fn os2(f as *table.Face) as Os2 {
    let is Os2 as s;
    s.version = 0;
    s.weight = 400;
    s.width = 5;
    s.fs_selection = 0;
    s.typo_asc = 0;
    s.typo_desc = 0;
    s.typo_gap = 0;
    s.win_asc = 0;
    s.win_desc = 0;
    s.x_height = 0;
    s.cap_height = 0;
    s.strike_size = 0;
    s.strike_pos = 0;
    let is table.Table as t = f.os2;
    // Version 0 ends at usWinDescent, byte 78; the fields after it are read
    // only where the table reaches them.
    if (table.inside(t, t.off, 78) == 0) { return s; }
    let is i64 as o = t.off;
    s.version = table.u16_at(f, o);
    s.weight = table.u16_at(f, o + 4);
    s.width = table.u16_at(f, o + 6);
    s.strike_size = table.i16_at(f, o + 26);
    s.strike_pos = table.i16_at(f, o + 28);
    s.fs_selection = table.u16_at(f, o + 62);
    s.typo_asc = table.i16_at(f, o + 68);
    s.typo_desc = table.i16_at(f, o + 70);
    s.typo_gap = table.i16_at(f, o + 72);
    s.win_asc = table.u16_at(f, o + 74);
    s.win_desc = table.u16_at(f, o + 76);
    if (s.version >= 2 && table.inside(t, o + 86, 4) == 1) {
        s.x_height = table.i16_at(f, o + 86);
        s.cap_height = table.i16_at(f, o + 88);
    }
    return s;
}

fn post(f as *table.Face) as Post {
    let is Post as p;
    p.underline_pos = 0;
    p.underline_thickness = 0;
    p.italic_angle = 0;
    p.fixed_pitch = 0;
    let is table.Table as t = f.post;
    if (table.inside(t, t.off, 16) == 0) { return p; }
    p.italic_angle = table.i32_at(f, t.off + 4);
    p.underline_pos = table.i16_at(f, t.off + 8);
    p.underline_thickness = table.i16_at(f, t.off + 10);
    p.fixed_pitch = table.u32_at(f, t.off + 12);
    return p;
}

// What a layout needs of a face, in font units.
struct Metrics {
    upem                as i64;
    ascender            as i64;   // the convention above
    descender           as i64;   // negative
    line_gap            as i64;
    x_height            as i64;   // 0 when the face does not say
    cap_height          as i64;
    underline_pos       as i64;
    underline_thickness as i64;
    strike_pos          as i64;
    strike_size         as i64;
    italic_angle        as f64;   // degrees
    weight              as i64;
    width               as i64;
    italic              as i32;   // italic or oblique
    bold                as i32;
    fixed_pitch         as i32;
    _pad0               as i32;
}

fn metrics(f as *table.Face) as Metrics {
    let is Metrics as m;
    let is Head as h = head(f);
    let is Hhea as hh = hhea(f);
    let is Os2 as s = os2(f);
    let is Post as p = post(f);
    m.upem = h.upem;
    if ((s.fs_selection & SEL_USE_TYPO) != 0) {
        m.ascender = s.typo_asc;
        m.descender = s.typo_desc;
        m.line_gap = s.typo_gap;
    } else {
        m.ascender = hh.ascender;
        m.descender = hh.descender;
        m.line_gap = hh.line_gap;
    }
    if (m.ascender == 0 && m.descender == 0) {
        m.ascender = s.typo_asc;
        m.descender = s.typo_desc;
        m.line_gap = s.typo_gap;
        if (m.ascender == 0 && m.descender == 0) {
            m.ascender = s.win_asc;
            m.descender = 0 - s.win_desc;
            m.line_gap = 0;
        }
    }
    m.x_height = s.x_height;
    m.cap_height = s.cap_height;
    m.underline_pos = p.underline_pos;
    m.underline_thickness = p.underline_thickness;
    m.strike_pos = s.strike_pos;
    m.strike_size = s.strike_size;
    m.italic_angle = cast(f64, p.italic_angle) / 65536.0;
    m.weight = s.weight;
    m.width = s.width;
    m.italic = 0;
    if ((s.fs_selection & (SEL_ITALIC | SEL_OBLIQUE)) != 0 || (h.mac_style & 2) != 0) { m.italic = 1; }
    m.bold = 0;
    if ((s.fs_selection & SEL_BOLD) != 0 || (h.mac_style & 1) != 0) { m.bold = 1; }
    m.fixed_pitch = 0;
    if (p.fixed_pitch != 0) { m.fixed_pitch = 1; }
    m._pad0 = 0;
    return m;
}

// Fills the face's counts from head, maxp and hhea, checking what every
// lookup relies on: head's magic number, units per em in OpenType's range, a
// glyph count, metrics for at least one glyph and an hmtx long enough for
// them. 0 with f.err set when something is wrong.
fn read(f as *table.Face) as i32 {
    if (table.inside(f.head, f.head.off, 54) == 0 || table.u32_at(f, f.head.off + 12) != 0x5F0F3CF5) {
        f.err = table.BAD_TABLE;
        return 0;
    }
    let is Head as h = head(f);
    if (h.upem < 16 || h.upem > 16384) { f.err = table.BAD_TABLE; return 0; }
    f.upem = h.upem;
    f.loc_long = 0;
    if (h.loc_format == 1) { f.loc_long = 1; }
    if (table.inside(f.maxp, f.maxp.off, 6) == 0) { f.err = table.BAD_TABLE; return 0; }
    f.glyphs = table.u16_at(f, f.maxp.off + 4);
    if (table.inside(f.hhea, f.hhea.off, 36) == 0) { f.err = table.BAD_TABLE; return 0; }
    f.hmetrics = hhea(f).hmetrics;
    // No glyphs is caught here too: no metrics, or more metrics than glyphs.
    if (f.hmetrics == 0 || f.hmetrics > f.glyphs) { f.err = table.BAD_TABLE; return 0; }
    if (table.inside(f.hmtx, f.hmtx.off, f.hmetrics * 4) == 0) { f.err = table.BAD_TABLE; return 0; }
    return 1;
}
