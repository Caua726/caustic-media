// text/sfnt/name.cst — what a face is called: its family, its style, its
// full and PostScript names, as UTF-8.
//
// A name is stored per platform, encoding and language, and a font carries a
// handful of each. The record read is the first of: Windows Unicode in US
// English, Windows Unicode in any English, any Windows Unicode, the Unicode
// platform, Mac Roman in English — which is what a family name shown to an
// English-reading user should be, and the one font menus list. UTF-16BE is
// decoded with its surrogate pairs; Mac Roman through its table.
use "table.cst" as table;

let is i64 as FAMILY            with imut = 1;
let is i64 as STYLE             with imut = 2;
let is i64 as FULL              with imut = 4;
let is i64 as POSTSCRIPT        with imut = 6;
let is i64 as TYPOGRAPHIC_FAMILY with imut = 16;   // the family without weights split off
let is i64 as TYPOGRAPHIC_STYLE  with imut = 17;

// Mac Roman's upper half, 0x80..0xFF, as code points.
let is [128]i32 as MAC_ROMAN with mut;
let is i32 as _mac_ready with mut = 0;

fn _mac() as void {
    if (_mac_ready == 1) { return; }
    let is [128]i64 as v;
    v[0] = 196; v[1] = 197; v[2] = 199; v[3] = 201; v[4] = 209; v[5] = 214; v[6] = 220; v[7] = 225;
    v[8] = 224; v[9] = 226; v[10] = 228; v[11] = 227; v[12] = 229; v[13] = 231; v[14] = 233; v[15] = 232;
    v[16] = 234; v[17] = 235; v[18] = 237; v[19] = 236; v[20] = 238; v[21] = 239; v[22] = 241; v[23] = 243;
    v[24] = 242; v[25] = 244; v[26] = 246; v[27] = 245; v[28] = 250; v[29] = 249; v[30] = 251; v[31] = 252;
    v[32] = 8224; v[33] = 176; v[34] = 162; v[35] = 163; v[36] = 167; v[37] = 8226; v[38] = 182; v[39] = 223;
    v[40] = 174; v[41] = 169; v[42] = 8482; v[43] = 180; v[44] = 168; v[45] = 8800; v[46] = 198; v[47] = 216;
    v[48] = 8734; v[49] = 177; v[50] = 8804; v[51] = 8805; v[52] = 165; v[53] = 181; v[54] = 8706; v[55] = 8721;
    v[56] = 8719; v[57] = 960; v[58] = 8747; v[59] = 170; v[60] = 186; v[61] = 937; v[62] = 230; v[63] = 248;
    v[64] = 191; v[65] = 161; v[66] = 172; v[67] = 8730; v[68] = 402; v[69] = 8776; v[70] = 8710; v[71] = 171;
    v[72] = 187; v[73] = 8230; v[74] = 160; v[75] = 192; v[76] = 195; v[77] = 213; v[78] = 338; v[79] = 339;
    v[80] = 8211; v[81] = 8212; v[82] = 8220; v[83] = 8221; v[84] = 8216; v[85] = 8217; v[86] = 247; v[87] = 9674;
    v[88] = 255; v[89] = 376; v[90] = 8260; v[91] = 8364; v[92] = 8249; v[93] = 8250; v[94] = 64257; v[95] = 64258;
    v[96] = 8225; v[97] = 183; v[98] = 8218; v[99] = 8222; v[100] = 8240; v[101] = 194; v[102] = 202; v[103] = 193;
    v[104] = 203; v[105] = 200; v[106] = 205; v[107] = 206; v[108] = 207; v[109] = 204; v[110] = 211; v[111] = 212;
    v[112] = 63743; v[113] = 210; v[114] = 218; v[115] = 219; v[116] = 217; v[117] = 305; v[118] = 710; v[119] = 732;
    v[120] = 175; v[121] = 728; v[122] = 729; v[123] = 730; v[124] = 184; v[125] = 733; v[126] = 731; v[127] = 711;
    let is i64 as i with mut = 0;
    while (i < 128) {
        MAC_ROMAN[i] = cast(i32, v[i]);
        i = i + 1;
    }
    _mac_ready = 1;
}

// How good a record is for the order above: 5 best, 0 unusable.
fn _rank(platform as i64, encoding as i64, language as i64) as i64 {
    if (platform == 3 && (encoding == 1 || encoding == 10)) {
        if (language == 1033) { return 5; }
        if ((language & 1023) == 9) { return 4; }
        return 3;
    }
    if (platform == 0) { return 2; }
    if (platform == 1 && encoding == 0 && language == 0) { return 1; }
    return 0;
}

// Appends cp to out as UTF-8, room kept for the NUL; the new length, or -1
// when it does not fit — and nothing after it is written either.
fn _put(out as *u8, cap as i64, n as i64, cp as i64) as i64 {
    let is i64 as k with mut = 1;
    if (cp >= 128) { k = 2; }
    if (cp >= 2048) { k = 3; }
    if (cp >= 65536) { k = 4; }
    if (n + k + 1 > cap) { return 0 - 1; }
    let is i64 as base = cast(i64, out) + n;
    if (k == 1) { *cast(*u8, base) = cast(u8, cp); }
    if (k == 2) {
        *cast(*u8, base) = cast(u8, 192 | (cp >> 6));
        *cast(*u8, base + 1) = cast(u8, 128 | (cp & 63));
    }
    if (k == 3) {
        *cast(*u8, base) = cast(u8, 224 | (cp >> 12));
        *cast(*u8, base + 1) = cast(u8, 128 | ((cp >> 6) & 63));
        *cast(*u8, base + 2) = cast(u8, 128 | (cp & 63));
    }
    if (k == 4) {
        *cast(*u8, base) = cast(u8, 240 | (cp >> 18));
        *cast(*u8, base + 1) = cast(u8, 128 | ((cp >> 12) & 63));
        *cast(*u8, base + 2) = cast(u8, 128 | ((cp >> 6) & 63));
        *cast(*u8, base + 3) = cast(u8, 128 | (cp & 63));
    }
    return n + k;
}

// Name id as UTF-8 into out, NUL-terminated, cut at a character boundary to
// fit cap. Its length in bytes, or -1 when the face has no usable record.
fn get(f as *table.Face, id as i64, out as *u8, cap as i64) as i64 {
    let is table.Table as t = f.name;
    if (cap < 1 || table.inside(t, t.off, 6) == 0) { return 0 - 1; }
    let is i64 as n = table.u16_at(f, t.off + 2);
    // The records are not checked as a block: the string of the one chosen
    // is, and that is all that is read of it.
    let is i64 as strings = t.off + table.u16_at(f, t.off + 4);
    let is i64 as best with mut = 0 - 1;
    let is i64 as best_rank with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as rec = t.off + 6 + i * 12;
        if (table.u16_at(f, rec + 6) == id) {
            let is i64 as r = _rank(table.u16_at(f, rec), table.u16_at(f, rec + 2), table.u16_at(f, rec + 4));
            if (r > best_rank) {
                best_rank = r;
                best = rec;
            }
        }
        i = i + 1;
    }
    if (best < 0) { return 0 - 1; }
    let is i64 as len = table.u16_at(f, best + 8);
    let is i64 as at = strings + table.u16_at(f, best + 10);
    if (table.inside(t, at, len) == 0) { return 0 - 1; }
    let is i64 as w with mut = 0;
    let is i64 as next with mut = 0;
    if (best_rank == 1) {
        _mac();
        i = 0;
        while (i < len && next >= 0) {
            let is i64 as b = table.u8_at(f, at + i);
            if (b >= 128) { next = _put(out, cap, w, cast(i64, MAC_ROMAN[b - 128])); } else { next = _put(out, cap, w, b); }
            if (next >= 0) { w = next; }
            i = i + 1;
        }
    } else {
        i = 0;
        while (i + 1 < len && next >= 0) {
            let is i64 as u with mut = table.u16_at(f, at + i);
            i = i + 2;
            if (u >= 55296 && u < 56320 && i + 1 < len) {
                let is i64 as lo = table.u16_at(f, at + i);
                if (lo >= 56320 && lo < 57344) {
                    u = 65536 + ((u - 55296) << 10) + (lo - 56320);
                    i = i + 2;
                } else {
                    u = 65533;
                }
            } else if (u >= 55296 && u < 57344) {
                u = 65533;
            }
            next = _put(out, cap, w, u);
            if (next >= 0) { w = next; }
        }
    }
    *cast(*u8, cast(i64, out) + w) = 0;
    return w;
}
