// text/layout/layout.cst — the hub: text, its styles and a box in; lines of
// placed glyphs out. The steps are layout.md's: the text read into
// characters and items (items.cst), the items shaped and set in lines
// (lines.cst).
//
// A Layout keeps what it was given until the next set: the text, the styles
// and the fonts they name must outlive it. The faces its glyphs are in stay
// open until then, each a slot of its Sizes (face).
use "../shape/shape.cst" as shape;
use "model.cst" as model;
use "font.cst" as font;
use "items.cst" as items;
use "lines.cst" as lines;

struct Layout {
    chars   as items.Chars;
    sizes   as font.Sizes;
    shaper  as shape.Shaper;
    lines   as lines.Lines;
    text    as *u8;
    nbytes  as i64;
    styles  as *model.Style;
    nstyles as i64;
    params  as model.Params;
}

fn open(l as *Layout) as void {
    l.chars = items.open();
    l.sizes = font.sizes();
    shape.open(&l.shaper);
    l.lines = lines.open();
    l.text = cast(*u8, 0);
    l.nbytes = 0;
    l.styles = cast(*model.Style, 0);
    l.nstyles = 0;
    l.params = model.params();
}

fn close(l as *Layout) as void {
    items.close(&l.chars);
    font.close_sizes(&l.sizes);
    shape.close(&l.shaper);
    lines.close(&l.lines);
}

// The text — nbytes of UTF-8 — laid out in the styles, each span of it in
// its style and the rest in style 0, in the box the parameters describe: 1,
// or 0 when it could not be — a span's style out of range, memory refused, a
// face that would not open, more faces at once than Sizes holds, or the
// shaper's bounds passed.
fn set(l as *Layout, text as *u8, nbytes as i64, styles as *model.Style, nstyles as i64, spans as *model.Span,
       nspans as i64, params as *model.Params) as i32 {
    l.lines.lines.n = 0;
    l.lines.glyphs.n = 0;
    l.lines.pieces.n = 0;
    l.lines.decos.n = 0;
    if (nstyles < 1 || nbytes < 0) { return 0; }
    let is i64 as i with mut = 0;
    while (i < nspans) {
        if (spans[i].style < 0 || spans[i].style >= nstyles) { return 0; }
        i = i + 1;
    }
    l.text = text;
    l.nbytes = nbytes;
    l.styles = styles;
    l.nstyles = nstyles;
    l.params = *params;
    if (items.read(&l.chars, text, nbytes, styles, spans, nspans, params.dir) == 0) { return 0; }
    if (items.itemize(&l.chars) == 0) { return 0; }
    let is lines.Job as j;
    j.ln = &l.lines;
    j.c = &l.chars;
    j.sz = &l.sizes;
    j.s = &l.shaper;
    j.text = text;
    j.styles = styles;
    j.p = &l.params;
    j.tab = 0.0;
    j.base = 0;
    j.ifirst = 0;
    j.hang = 0.0;
    j.ink = 0.0;
    j.hs = 0;
    return lines.make(&j);
}

// The widest line's content, and the lines' height together.
fn width(l as *Layout) as f64 { return l.lines.width; }
fn height(l as *Layout) as f64 { return l.lines.height; }

// The widest stretch between two break opportunities, whatever the width:
// the least a box can be without a word broken inside — CSS's min-content.
fn min_width(l as *Layout) as f64 { return l.lines.least; }

// Whether max_lines left text out.
fn cut(l as *Layout) as i32 { return l.lines.cut; }

fn line_count(l as *Layout) as i64 { return l.lines.lines.n; }
fn line(l as *Layout, i as i64) as *model.Line { return lines.line(&l.lines, i); }
fn glyph_count(l as *Layout) as i64 { return l.lines.glyphs.n; }
fn glyph(l as *Layout, i as i64) as *model.Glyph { return lines.glyph(&l.lines, i); }
fn piece_count(l as *Layout) as i64 { return l.lines.pieces.n; }
fn piece(l as *Layout, i as i64) as *model.Piece { return lines.piece(&l.lines, i); }
fn deco_count(l as *Layout) as i64 { return l.lines.decos.n; }
fn deco(l as *Layout, i as i64) as *model.Deco { return lines.deco(&l.lines, i); }

// The face a glyph's slot names, open at its size.
fn face(l as *Layout, slot as i64) as *font.Sized { return &l.sizes.list[slot]; }
