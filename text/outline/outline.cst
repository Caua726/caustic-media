// text/outline/outline.cst — the hub: a face's glyphs as paths, whichever
// format they are stored in, at whichever instance of a variable font. See
// outline.md.
use "../sfnt/table.cst" as table;
use "../sfnt/hmtx.cst" as hmtx;
use "../sfnt/var.cst" as var;
use "path.cst" as path;
use "glyf.cst" as glyf;
use "cff.cst" as cff;

// What reading a face's outlines needs, made once per face: TrueType's
// scratch points, or CFF's located structures; and the instance, the default
// until vary() says otherwise.
struct Reader {
    face   as *table.Face;
    pts    as glyf.Points;
    cff    as cff.Cff;
    coords as var.Coords;
    ok     as i32;
    _pad0  as i32;
}

// Room for a glyph of 65536 points: more than a TrueType glyph can have,
// composites expanded.
fn open(f as *table.Face) as Reader {
    let is Reader as r;
    r.face = f;
    r.ok = 0;
    r._pad0 = 0;
    r.pts.block = cast(*u8, 0);
    r.pts.cap = 0;
    r.cff.ok = 0;
    r.coords = var.default_coords();
    if (f.outline == table.OUTLINE_GLYF) {
        r.pts = glyf.points_open(65536);
        r.ok = 1;
    } else if (f.outline == table.OUTLINE_CFF || f.outline == table.OUTLINE_CFF2) {
        r.cff = cff.open(f);
        r.ok = r.cff.ok;
    }
    return r;
}

fn close(r as *Reader) as void {
    glyf.points_close(&r.pts);
    r.ok = 0;
}

// The instance the glyphs are drawn at, from var.coords.
fn vary(r as *Reader, c as *var.Coords) as void {
    r.coords = *c;
}

// Glyph gid's outline into p, in font units, cleared first. 1, or 0 for a
// glyph that is malformed or does not fit p, with p empty. A glyph with no
// outline — a space — is 1 with p empty.
fn glyph(r as *Reader, gid as i64, p as *path.Path) as i32 {
    path.clear(p);
    if (r.face.outline == table.OUTLINE_GLYF) { return glyf.glyph(r.face, &r.pts, gid, &r.coords, p); }
    return cff.glyph(r.face, &r.cff, gid, &r.coords, p);
}

// Glyph gid's advance at the instance, in font units, unrounded — rounded
// half away from zero, and no less than 0, it is HarfBuzz's: hmtx's at the
// default instance; moved by HVAR when the font has it; otherwise, when it
// has gvar, from the glyph's phantom points (glyf.advance); otherwise hmtx's.
fn advance(r as *Reader, gid as i64) as f64 {
    let is f64 as plain = cast(f64, hmtx.advance(r.face, gid));
    if (var.is_default(&r.coords) == 1) { return plain; }
    if (var.has_hvar(r.face) == 1) { return plain + var.advance_delta(r.face, &r.coords, gid); }
    if (glyf.has_gvar(r.face) == 0) { return plain; }
    return glyf.advance(r.face, &r.pts, gid, &r.coords);
}
