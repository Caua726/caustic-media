// text/outline/outline.cst — the hub: a face's glyphs as paths, whichever
// format they are stored in. See outline.md.
use "../sfnt/table.cst" as table;
use "path.cst" as path;
use "glyf.cst" as glyf;
use "cff.cst" as cff;

// What reading a face's outlines needs, made once per face: TrueType's
// scratch points, or CFF's located structures.
struct Reader {
    face  as *table.Face;
    pts   as glyf.Points;
    cff   as cff.Cff;
    ok    as i32;
    _pad0 as i32;
}

// Room for a glyph of 65536 points: more than a TrueType glyph can have,
// composites expanded.
fn open(f as *table.Face) as Reader {
    let is Reader as r;
    r.face = f;
    r.ok = 0;
    r._pad0 = 0;
    r.pts.block = cast(*u8, 0);
    r.pts.cap = 0;
    r.cff.ok = 0;
    if (f.outline == table.OUTLINE_GLYF) {
        r.pts = glyf.points_open(65536);
        r.ok = 1;
    } else if (f.outline == table.OUTLINE_CFF || f.outline == table.OUTLINE_CFF2) {
        r.cff = cff.open(f);
        r.ok = r.cff.ok;
    }
    return r;
}

fn close(r as *Reader) as void {
    glyf.points_close(&r.pts);
    r.ok = 0;
}

// Glyph gid's outline into p, in font units, cleared first. 1, or 0 for a
// glyph that is malformed or does not fit p, with p empty. A glyph with no
// outline — a space — is 1 with p empty.
fn glyph(r as *Reader, gid as i64, p as *path.Path) as i32 {
    path.clear(p);
    if (r.face.outline == table.OUTLINE_GLYF) { return glyf.glyph(r.face, &r.pts, gid, p); }
    return cff.glyph(r.face, &r.cff, gid, p);
}
