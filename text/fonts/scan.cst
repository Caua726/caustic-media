// text/fonts/scan.cst — the font files under a directory, each with its
// size and modification time, which is all the index needs to know whether
// it has read a file before.
//
// A font file is one named .ttf, .otf, .ttc or .otc, in any case; what is
// inside is the index's to find out. Links are followed, into directories
// too — distributions link font directories into each other — and nothing
// is visited twice: each directory and file is known by its device and
// inode, so a link back up ends there, and a file reached by two names is
// listed under the first. The first is the first in the walk's order, which
// is each directory's names sorted by their bytes: the same tree gives the
// same list, whatever order the filesystem keeps.
//
// A walk goes MAX_DEPTH directories below the root and no further, and
// leaves out a path longer than PATH_MAX - 1 bytes. A directory that cannot
// be read is passed over.
//
// Linux, by getdents64 and stat. Windows lists directories with
// FindFirstFileW, which comes with the Win32 backend's bindings; until then
// a walk there finds nothing.
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "pool.cst" as pool;

let is i64 as MAX_DEPTH with imut = 16;
let is i64 as PATH_MAX  with imut = 512;

let is i64 as _O_DIRECTORY with imut = 65536;
let is i64 as _O_CLOEXEC   with imut = 524288;
let is i64 as _S_IFMT      with imut = 61440;
let is i64 as _S_IFDIR     with imut = 16384;
let is i64 as _S_IFREG     with imut = 32768;

struct File {
    path  as i64;   // in the scan's names, NUL-terminated
    size  as i64;
    mtime as i64;   // nanoseconds since 1970
}

struct Scan {
    files as pool.Pool;   // File records
    names as pool.Pool;   // their paths
    seen  as pool.Pool;   // (device, inode) pairs, open addressing; inode 0 is empty
    slots as i64;
    used  as i64;
    n     as i64;
}

fn open() as Scan {
    let is Scan as s;
    s.files = pool.empty();
    s.names = pool.empty();
    s.seen = pool.empty();
    s.slots = 0;
    s.used = 0;
    s.n = 0;
    return s;
}

fn close(s as *Scan) as void {
    pool.free(&s.files);
    pool.free(&s.names);
    pool.free(&s.seen);
    s.slots = 0;
    s.used = 0;
    s.n = 0;
}

fn count(s as *Scan) as i64 { return s.n; }

fn file(s as *Scan, i as i64) as *File { return cast(*File, pool.at(&s.files, i * sizeof(File))); }

fn path(s as *Scan, i as i64) as *u8 { return pool.at(&s.names, file(s, i).path); }

fn _byte(s as *u8, i as i64) as i64 { return cast(i64, *cast(*u8, cast(i64, s) + i)); }

// Whether a file named name, n bytes, is a font's.
fn is_font(name as *u8, n as i64) as i32 {
    if (n < 4 || _byte(name, n - 4) != 46) { return 0; }
    // Lower case by the bit ASCII keeps it in: exact for the four letters
    // here, which are all that is compared.
    let is i64 as a = _byte(name, n - 3) | 32;
    let is i64 as b = _byte(name, n - 2) | 32;
    let is i64 as c = _byte(name, n - 1) | 32;
    // ttf, ttc, otf, otc
    if ((a == 116 || a == 111) && b == 116 && (c == 102 || c == 99)) { return 1; }
    return 0;
}

// --- Seen ---

fn _slot(s as *Scan, i as i64) as *i64 { return cast(*i64, pool.at(&s.seen, i * 16)); }

fn _hash(dev as i64, ino as i64) as i64 {
    // Fibonacci hashing: 2^64 over the golden ratio, as a signed number.
    let is i64 as h = (dev * 1000003 + ino) * (0 - 7046029254386353131);
    return (h >> 29) & 4611686018427387903;
}

// Puts (dev, ino) in the table of a scan whose slots are free; no growing.
fn _put(s as *Scan, dev as i64, ino as i64) as void {
    let is i64 as i with mut = _hash(dev, ino) & (s.slots - 1);
    while (*cast(*i64, cast(i64, _slot(s, i)) + 8) != 0) { i = (i + 1) & (s.slots - 1); }
    *_slot(s, i) = dev;
    *cast(*i64, cast(i64, _slot(s, i)) + 8) = ino;
    s.used = s.used + 1;
}

// Whether (dev, ino) was seen before; it is now. 1 as well when the memory
// for remembering it is refused, so that nothing is visited without bound.
fn seen(s as *Scan, dev as i64, ino as i64) as i32 {
    if (s.slots > 0) {
        let is i64 as i with mut = _hash(dev, ino) & (s.slots - 1);
        while (*cast(*i64, cast(i64, _slot(s, i)) + 8) != 0) {
            if (*_slot(s, i) == dev && *cast(*i64, cast(i64, _slot(s, i)) + 8) == ino) { return 1; }
            i = (i + 1) & (s.slots - 1);
        }
    }
    if ((s.used + 1) * 2 > s.slots) {
        let is pool.Pool as old = s.seen;
        let is i64 as old_slots = s.slots;
        let is i64 as slots with mut = s.slots * 2;
        if (slots < 256) { slots = 256; }
        s.seen = pool.empty();
        if (pool.add(&s.seen, cast(*u8, 0), slots * 16) < 0) {
            s.seen = old;
            return 1;
        }
        s.slots = slots;
        s.used = 0;
        let is i64 as k with mut = 0;
        while (k < old_slots) {
            let is *i64 as e = cast(*i64, pool.at(&old, k * 16));
            if (*cast(*i64, cast(i64, e) + 8) != 0) { _put(s, *e, *cast(*i64, cast(i64, e) + 8)); }
            k = k + 1;
        }
        pool.free(&old);
    }
    _put(s, dev, ino);
    return 0;
}

// --- Walking ---

fn _mode(st as *u8) as i64 {
    if (__target_is_aarch64 == 1) { return cast(i64, *cast(*u32, cast(i64, st) + 16)); }
    return cast(i64, *cast(*u32, cast(i64, st) + 24));
}

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (_byte(s, n) != 0) { n = n + 1; }
    return n;
}

// Whether name a sorts before or with name b, by their bytes.
fn _not_after(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (_byte(a, i) != 0 && _byte(a, i) == _byte(b, i)) { i = i + 1; }
    if (_byte(a, i) <= _byte(b, i)) { return 1; }
    return 0;
}

// offs[0..n), offsets of names, sorted by the names; tmp holds n more.
fn _sort(offs as *i64, tmp as *i64, n as i64, names as *pool.Pool) as void {
    let is i64 as width with mut = 1;
    let is *i64 as src with mut = offs;
    let is *i64 as dst with mut = tmp;
    while (width < n) {
        let is i64 as lo with mut = 0;
        while (lo < n) {
            // mid may pass n: then the right half is empty, and the left
            // is copied as it is.
            let is i64 as mid = lo + width;
            let is i64 as hi with mut = lo + 2 * width;
            if (hi > n) { hi = n; }
            let is i64 as a with mut = lo;
            let is i64 as b with mut = mid;
            let is i64 as k with mut = lo;
            while (k < hi) {
                let is i32 as left with mut = 0;
                if (a < mid && b >= hi) { left = 1; }
                if (a < mid && b < hi) {
                    left = _not_after(pool.at(names, *cast(*i64, cast(i64, src) + a * 8)), pool.at(names, *cast(*i64, cast(i64, src) + b * 8)));
                }
                if (left == 1) {
                    *cast(*i64, cast(i64, dst) + k * 8) = *cast(*i64, cast(i64, src) + a * 8);
                    a = a + 1;
                } else {
                    *cast(*i64, cast(i64, dst) + k * 8) = *cast(*i64, cast(i64, src) + b * 8);
                    b = b + 1;
                }
                k = k + 1;
            }
            lo = hi;
        }
        let is *i64 as t = src;
        src = dst;
        dst = t;
        width = width * 2;
    }
    if (src != offs) { mem.memcpy(cast(*u8, offs), cast(*u8, src), n * 8); }
}

// The directory at path, n bytes long in a buffer of PATH_MAX, depth below
// the root.
fn _dir(s as *Scan, path as *u8, n as i64, depth as i64) as void {
    let is i64 as fd = linux.open(path, _O_DIRECTORY + _O_CLOEXEC, 0);
    if (fd < 0) { return; }
    let is pool.Pool as names with mut = pool.empty();
    let is pool.Pool as offs with mut = pool.empty();
    let is [8192]u8 as buf;
    let is i32 as ok with mut = 1;
    let is i64 as got with mut = linux.getdents64(fd, cast(*u8, &buf), 8192);
    while (got > 0 && ok == 1) {
        let is i64 as pos with mut = 0;
        while (pos < got && ok == 1) {
            let is i64 as e = cast(i64, &buf) + pos;
            let is *u8 as name = cast(*u8, e + 19);
            let is i64 as k = _len(name);
            // "." is the directory itself, seen already; ".." would climb out
            // of the root.
            if (k != 2 || _byte(name, 0) != 46 || _byte(name, 1) != 46) {
                let is i64 as at = pool.add(&names, name, k + 1);
                if (at < 0 || pool.add_i64(&offs, at) < 0) { ok = 0; }
            }
            pos = pos + (_byte(cast(*u8, e), 16) | (_byte(cast(*u8, e), 17) << 8));
        }
        got = linux.getdents64(fd, cast(*u8, &buf), 8192);
    }
    linux.close(fd);
    let is i64 as m = offs.len / 8;
    let is pool.Pool as tmp with mut = pool.empty();
    if (ok == 1) {
        if (pool.add(&tmp, cast(*u8, 0), m * 8) < 0) { ok = 0; } else { _sort(cast(*i64, offs.base), cast(*i64, tmp.base), m, &names); }
    }
    pool.free(&tmp);
    let is i64 as i with mut = 0;
    while (ok == 1 && i < m) {
        let is *u8 as name = pool.at(&names, pool.i64_at(&offs, i));
        let is i64 as k = _len(name);
        if (n + 1 + k < PATH_MAX) {
            *cast(*u8, cast(i64, path) + n) = cast(u8, 47);
            mem.memcpy(cast(*u8, cast(i64, path) + n + 1), name, k + 1);
            let is [144]u8 as st;
            if (linux.stat(path, cast(*u8, &st)) == 0) {
                let is i64 as dev = *cast(*i64, cast(i64, &st));
                let is i64 as ino = *cast(*i64, cast(i64, &st) + 8);
                let is i64 as kind = _mode(cast(*u8, &st)) & _S_IFMT;
                if (kind == _S_IFDIR && depth < MAX_DEPTH && seen(s, dev, ino) == 0) {
                    _dir(s, path, n + 1 + k, depth + 1);
                }
                if (kind == _S_IFREG && is_font(name, k) == 1 && seen(s, dev, ino) == 0) {
                    let is File as f;
                    f.path = pool.add(&s.names, path, n + 1 + k + 1);
                    f.size = *cast(*i64, cast(i64, &st) + 48);
                    f.mtime = *cast(*i64, cast(i64, &st) + 88) * 1000000000 + *cast(*i64, cast(i64, &st) + 96);
                    if (f.path >= 0 && pool.add(&s.files, cast(*u8, &f), sizeof(File)) >= 0) { s.n = s.n + 1; }
                }
            }
        }
        i = i + 1;
    }
    pool.free(&names);
    pool.free(&offs);
}

// The font files under root added to s; how many. A directory or file s
// has seen already, by this walk or an earlier one, is not listed again.
fn walk(s as *Scan, root as *u8) as i64 {
    if (__target_is_windows == 1) { return 0; }
    let is i64 as n = _len(root);
    if (n >= PATH_MAX) { return 0; }
    let is [512]u8 as path;
    mem.memcpy(cast(*u8, &path), root, n + 1);
    let is [144]u8 as st;
    if (linux.stat(cast(*u8, &path), cast(*u8, &st)) != 0) { return 0; }
    if ((_mode(cast(*u8, &st)) & _S_IFMT) != _S_IFDIR) { return 0; }
    if (seen(s, *cast(*i64, cast(i64, &st)), *cast(*i64, cast(i64, &st) + 8)) == 1) { return 0; }
    let is i64 as before = s.n;
    _dir(s, cast(*u8, &path), n, 0);
    return s.n - before;
}
