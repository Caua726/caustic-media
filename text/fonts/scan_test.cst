// text/fonts/scan_test.cst — the font files under a directory: the test
// fonts' tree, every file in the order the walk promises, with its size and
// time; then a tree made here in /tmp for what a tree in the repository
// cannot hold: links to files and to directories, a loop, depth past the
// limit, a directory that cannot be read, names of every case and none.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "scan.cst" as scan;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return n;
}

fn eq(a as *u8, b as *u8) as i32 {
    let is i64 as n = len(b);
    if (len(a) != n || mem.memcmp(a, b, n) != 0) { return 0; }
    return 1;
}

// Every file s found is the one listed, in order: paths joined by '|'.
fn files_are(s as *scan.Scan, list as *u8) as i32 {
    let is i64 as i with mut = 0;
    let is i64 as at with mut = 0;
    let is i64 as end = len(list);
    while (at < end) {
        let is i64 as k with mut = at;
        while (k < end && *cast(*u8, cast(i64, list) + k) != 124) { k = k + 1; }
        if (i >= scan.count(s)) {
            io.printf("  %d files, more listed\n", scan.count(s));
            return 0;
        }
        let is *u8 as p = scan.path(s, i);
        if (len(p) != k - at || mem.memcmp(p, cast(*u8, cast(i64, list) + at), k - at) != 0) {
            io.printf("  file %d: %s\n", i, p);
            return 0;
        }
        i = i + 1;
        at = k + 1;
    }
    if (i != scan.count(s)) {
        io.printf("  %d files, %d listed; then %s\n", scan.count(s), i, scan.path(s, i));
        return 0;
    }
    return 1;
}

// Each file's size and time as stat gives them.
fn stats_hold(s as *scan.Scan) as i32 {
    let is i64 as i with mut = 0;
    while (i < scan.count(s)) {
        let is [144]u8 as st;
        if (linux.stat(scan.path(s, i), cast(*u8, &st)) != 0) { return 0; }
        let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
        let is i64 as t = *cast(*i64, cast(i64, &st) + 88) * 1000000000 + *cast(*i64, cast(i64, &st) + 96);
        let is *scan.File as f = scan.file(s, i);
        if (f.size != size || f.mtime != t) {
            io.printf("  %s: %d bytes at %d\n", scan.path(s, i), f.size, f.mtime);
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

let is *u8 as TREE with imut = "text/testdata/fonts/cjk/TestCJK.ttc|text/testdata/fonts/emoji/TestEmoji.ttf|text/testdata/fonts/mono/TestMono.ttf|text/testdata/fonts/more/TestSansCyr.ttf|text/testdata/fonts/more/TestSansCyrillic.ttf|text/testdata/fonts/more/TestSansGreek-Bold.ttf|text/testdata/fonts/more/TestSansGreek-Regular.ttf|text/testdata/fonts/more/deeper/TestGreek.ttf|text/testdata/fonts/odd/TestNameless.ttf|text/testdata/fonts/odd/TestOdd.ttf|text/testdata/fonts/odd/TestPlain.ttf|text/testdata/fonts/odd/TestShort.ttf|text/testdata/fonts/odd/TestWild.ttf|text/testdata/fonts/odd/broken.ttf|text/testdata/fonts/odd/empty.otf|text/testdata/fonts/sans/TestSans-Black.ttf|text/testdata/fonts/sans/TestSans-Bold.TTF|text/testdata/fonts/sans/TestSans-BoldItalic.ttf|text/testdata/fonts/sans/TestSans-Condensed.ttf|text/testdata/fonts/sans/TestSans-Expanded.ttf|text/testdata/fonts/sans/TestSans-Italic.ttf|text/testdata/fonts/sans/TestSans-Light.otf|text/testdata/fonts/sans/TestSans-Oblique.ttf|text/testdata/fonts/sans/TestSans-Regular.ttf|text/testdata/fonts/sans/TestSans-Thin.ttf|text/testdata/fonts/var/TestItal.ttf|text/testdata/fonts/var/TestVar.ttf|text/testdata/fonts/weights/TestWeights-300.ttf|text/testdata/fonts/weights/TestWeights-460.ttf|text/testdata/fonts/weights/TestWeights-480.ttf|text/testdata/fonts/weights/TestWeights-500.ttf";

// --- A tree of our own ---

let is [512]u8 as root with mut;
let is i64 as root_n with mut = 0;
let is [1024]u8 as pb with mut;

// root joined with rel, in pb.
fn at(rel as *u8) as *u8 {
    mem.memcpy(cast(*u8, &pb), cast(*u8, &root), root_n);
    pb[root_n] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &pb) + root_n + 1), rel, len(rel) + 1);
    return cast(*u8, &pb);
}

fn put(rel as *u8, text as *u8) as void {
    let is i64 as fd = linux.open(at(rel), 577, 420);   // O_WRONLY|O_CREAT|O_TRUNC, 0644
    linux.write(fd, text, len(text));
    linux.close(fd);
}

fn mk(rel as *u8) as void { linux.mkdir(at(rel), 493); }

fn ln(target as *u8, rel as *u8) as void { linux.symlink(target, at(rel)); }

// Everything under path removed, links unfollowed.
fn rm_tree(path as *u8) as void {
    let is i64 as fd = linux.open(path, 65536, 0);   // O_RDONLY|O_DIRECTORY
    if (fd < 0) {
        linux.unlink(path);
        return;
    }
    let is [8192]u8 as buf;
    let is [1024]u8 as child;
    let is i64 as n = len(path);
    let is i64 as got with mut = linux.getdents64(fd, cast(*u8, &buf), 8192);
    while (got > 0) {
        let is i64 as pos with mut = 0;
        while (pos < got) {
            let is i64 as e = cast(i64, &buf) + pos;
            let is i64 as reclen = cast(i64, *cast(*u8, e + 16)) + cast(i64, *cast(*u8, e + 17)) * 256;
            let is i64 as kind = cast(i64, *cast(*u8, e + 18));
            let is *u8 as name = cast(*u8, e + 19);
            let is i64 as dots = (len(name) == 1 && *name == 46) || (len(name) == 2 && *name == 46 && *cast(*u8, e + 20) == 46);
            if (dots == 0) {
                mem.memcpy(cast(*u8, &child), path, n);
                child[n] = cast(u8, 47);
                mem.memcpy(cast(*u8, cast(i64, &child) + n + 1), name, len(name) + 1);
                if (kind == 4) {
                    linux.chmod(cast(*u8, &child), 493);
                    rm_tree(cast(*u8, &child));
                } else {
                    linux.unlink(cast(*u8, &child));
                }
            }
            pos = pos + reclen;
        }
        got = linux.getdents64(fd, cast(*u8, &buf), 8192);
    }
    linux.close(fd);
    linux.rmdir(path);
}

fn made() as void {
    // /tmp/caustic-fonts-<pid>
    let is *u8 as base = "/tmp/caustic-fonts-";
    root_n = len(base);
    mem.memcpy(cast(*u8, &root), base, root_n);
    let is i64 as pid with mut = linux.getpid();
    let is [24]u8 as digits;
    let is i64 as k with mut = 0;
    while (pid > 0 || k == 0) {
        digits[k] = cast(u8, 48 + pid % 10);
        pid = pid / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        root[root_n] = digits[k];
        root_n = root_n + 1;
    }
    root[root_n] = cast(u8, 0);
    rm_tree(cast(*u8, &root));
    linux.mkdir(cast(*u8, &root), 493);

    // Names: every extension in any case, and what only looks like one.
    mk("a");
    put("a/x.ttf", "x");
    put("a/y.OTF", "yy");
    put("a/z.TtC", "zzz");
    put("a/w.otc", "wwww");
    put("a/.ttf", "v");
    put("a/x.ttf.bak", "no");
    put("a/ttf", "no");
    put("a/x.ttc~", "no");
    put("a/x.woff2", "no");
    put("a/x.pcf.gz", "no");
    mk("a/x.otf");
    // A link to a file already listed, one to nowhere, one up to the root.
    ln("x.ttf", "a/link.ttf");
    ln("nowhere.ttf", "a/broken.ttf");
    ln("..", "a/loop");
    // A link to the whole directory, beside it.
    ln("a", "b");
    // Sixteen directories below the root are walked; the seventeenth is
    // not. d is the first, then fifteen more: b to p.
    mk("d");
    let is [256]u8 as rel;
    let is i64 as rn with mut = 1;
    rel[0] = cast(u8, 100);
    let is i64 as level with mut = 1;
    while (level <= 16) {
        rel[rn] = cast(u8, 47);
        rel[rn + 1] = cast(u8, 97 + level);
        rn = rn + 2;
        rel[rn] = cast(u8, 0);
        mk(cast(*u8, &rel));
        if (level == 15) {
            mem.memcpy(cast(*u8, cast(i64, &rel) + rn), "/deepest.ttf", 13);
            put(cast(*u8, &rel), "deepest");
            rel[rn] = cast(u8, 0);
        }
        if (level == 16) {
            mem.memcpy(cast(*u8, cast(i64, &rel) + rn), "/too-deep.ttf", 14);
            put(cast(*u8, &rel), "too deep");
            rel[rn] = cast(u8, 0);
        }
        level = level + 1;
    }
    // A directory no one may read.
    mk("locked");
    put("locked/hidden.ttf", "h");
    linux.chmod(at("locked"), 0);
    // A name long enough that its record in the directory passes 255 bytes.
    let is [300]u8 as long;
    let is i64 as i with mut = 0;
    mem.memcpy(cast(*u8, &long), "a/", 2);
    while (i < 240) {
        long[2 + i] = cast(u8, 113);
        i = i + 1;
    }
    mem.memcpy(cast(*u8, cast(i64, &long) + 242), ".ttf", 5);
    put(cast(*u8, &long), "long");
    // Something that is not a file, named as a font: a pipe, which would
    // block whoever opened it.
    let is *u8 as fifo = at("a/pipe.ttf");
    if (__target_is_aarch64 == 1) { syscall(33, 0 - 100, fifo, 4516, 0); } else { syscall(133, fifo, 4516, 0); }
    // Two names in two directories, made in each order: whatever order the
    // filesystem keeps, one of them is listed out of order.
    mk("e1");
    put("e1/y.ttf", "y");
    put("e1/z.ttf", "z");
    mk("e2");
    put("e2/z.ttf", "z");
    put("e2/y.ttf", "y");
    // Paths of 511 and 512 bytes: the longest kept, and one past it.
    let is [512]u8 as d1;
    i = 0;
    while (i < 200) {
        d1[i] = cast(u8, 112);
        i = i + 1;
    }
    d1[200] = cast(u8, 0);
    mk(cast(*u8, &d1));
    d1[200] = cast(u8, 47);
    i = 0;
    while (i < 200) {
        d1[201 + i] = cast(u8, 112);
        i = i + 1;
    }
    d1[401] = cast(u8, 0);
    mk(cast(*u8, &d1));
}

let is [600]u8 as edge with mut;

// The file under p.../p... whose whole path is n bytes long; its relative
// path in edge.
fn edge_file(n as i64) as *u8 {
    let is i64 as i with mut = 0;
    while (i < 200) {
        edge[i] = cast(u8, 112);
        edge[201 + i] = cast(u8, 112);
        i = i + 1;
    }
    edge[200] = cast(u8, 47);
    edge[401] = cast(u8, 47);
    // root, '/', 401 bytes of directories, '/', the name.
    let is i64 as k = n - root_n - 1 - 401 - 1;
    i = 0;
    while (i < k - 4) {
        edge[402 + i] = cast(u8, 114);
        i = i + 1;
    }
    mem.memcpy(cast(*u8, cast(i64, &edge) + 402 + k - 4), ".ttf", 5);
    return cast(*u8, &edge);
}

fn main() as i32 {
    // --- The test fonts ---
    let is scan.Scan as s with mut = scan.open();
    let is i64 as n = scan.walk(&s, "text/testdata/fonts");
    check("the test fonts, in order", files_are(&s, TREE));
    check("as many as it said", n == 31);
    check("sizes and times", stats_hold(&s));
    check("the empty one listed, empty", scan.file(&s, 14).size == 0);
    // The same tree again, and a directory inside it: nothing twice.
    check("again: nothing new", scan.walk(&s, "text/testdata/fonts") == 0 && scan.count(&s) == 31);
    check("nor from inside", scan.walk(&s, "text/testdata/fonts/sans") == 0 && scan.count(&s) == 31);
    // Roots that are not directories.
    check("no such directory", scan.walk(&s, "text/testdata/no such") == 0);
    check("a file for a root", scan.walk(&s, "text/testdata/glyf.ttf") == 0);
    check("an empty name", scan.walk(&s, "") == 0 && scan.count(&s) == 31);
    scan.close(&s);
    check("closed: empty", scan.count(&s) == 0);

    // --- Made here ---
    made();
    put(edge_file(511), "511");
    put(edge_file(512), "512");
    s = scan.open();
    // A font walked as a root first: refused, and not taken as seen.
    check("a font for a root", scan.walk(&s, at("a/w.otc")) == 0);
    scan.walk(&s, cast(*u8, &root));
    let is [8192]u8 as want;
    let is i64 as w with mut = 0;
    // a/.ttf, a/link.ttf (x.ttf by another name, first), the long name,
    // a/w.otc, a/y.OTF, a/z.TtC; b is a again; then down d to the deepest
    // allowed; e1 and e2 in order; then the path of 511 bytes.
    let is [600]u8 as long;
    let is i64 as i with mut = 0;
    mem.memcpy(cast(*u8, &long), "a/", 2);
    while (i < 240) {
        long[2 + i] = cast(u8, 113);
        i = i + 1;
    }
    mem.memcpy(cast(*u8, cast(i64, &long) + 242), ".ttf", 5);
    let is [12]*u8 as rels;
    rels[0] = "a/.ttf";
    rels[1] = "a/link.ttf";
    rels[2] = cast(*u8, &long);
    rels[3] = "a/w.otc";
    rels[4] = "a/y.OTF";
    rels[5] = "a/z.TtC";
    rels[6] = "d/b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/deepest.ttf";
    rels[7] = "e1/y.ttf";
    rels[8] = "e1/z.ttf";
    rels[9] = "e2/y.ttf";
    rels[10] = "e2/z.ttf";
    rels[11] = edge_file(511);
    let is i64 as r with mut = 0;
    while (r < 12) {
        if (w > 0) {
            want[w] = cast(u8, 124);
            w = w + 1;
        }
        let is *u8 as full = at(rels[r]);
        mem.memcpy(cast(*u8, cast(i64, &want) + w), full, len(full));
        w = w + len(full);
        r = r + 1;
    }
    want[w] = cast(u8, 0);
    check("links, loops, names, depth and order", files_are(&s, cast(*u8, &want)));
    check("their sizes", scan.file(&s, 3).size == 4 && scan.file(&s, 6).size == 7 && scan.file(&s, 11).size == 3);
    scan.close(&s);
    linux.chmod(at("locked"), 493);
    rm_tree(cast(*u8, &root));

    // --- Names ---
    check("a font's name", scan.is_font("Inter.ttc", 9) == 1 && scan.is_font("a.OtF", 5) == 1);
    check("not a font's", scan.is_font("a.ttf.bak", 9) == 0 && scan.is_font("ttf", 3) == 0 && scan.is_font("a.tt", 4) == 0
          && scan.is_font("a.woff", 6) == 0 && scan.is_font("a,ttf", 5) == 0 && scan.is_font("a.oxc", 5) == 0
          && scan.is_font("a.tff", 5) == 0);
    // Three bytes after a dot are not a name of four.
    check("not read before the name", scan.is_font(cast(*u8, cast(i64, ".ttf") + 1), 3) == 0);

    // --- Seen ---
    s = scan.open();
    check("not seen", scan.seen(&s, 1, 5) == 0);
    check("then seen", scan.seen(&s, 1, 5) == 1);
    check("the same inode on another device: not", scan.seen(&s, 2, 5) == 0);
    // Device 265 and inode 5 hash to the slot of 1 and 5 in the first table.
    check("nor one whose slot it shares", scan.seen(&s, 265, 5) == 0);
    // Thousands, the table grown many times: each remembered, none made up.
    let is i64 as k with mut = 0;
    let is i32 as all with mut = 1;
    while (k < 5000) {
        if (scan.seen(&s, 7, 1000 + k * 3) != 0) { all = 0; }
        k = k + 1;
    }
    k = 0;
    while (k < 5000) {
        if (scan.seen(&s, 7, 1000 + k * 3) != 1 || scan.seen(&s, 7, 1001 + k * 3) != 0) { all = 0; }
        k = k + 1;
    }
    check("thousands", all == 1 && scan.seen(&s, 1, 5) == 1 && scan.seen(&s, 2, 5) == 1);
    scan.close(&s);

    if (fails > 0) {
        io.printf("font scan: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("font scan: all checks passed\n");
    return 0;
}
