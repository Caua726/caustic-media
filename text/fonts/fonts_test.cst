// text/fonts/fonts_test.cst — the hub: an index made from directories and
// kept in a file, made again from that file and not rewritten when nothing
// changed; the interface's and the monospace font's chains from the
// desktop's settings; and this machine's own fonts, end to end, the index
// kept where XDG_CACHE_HOME says — the test script points it into /tmp.
//
// Built by caustic-mk (target fonts_test). Run from the repository's root.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../window/settings.cst" as settings;
use "../../window/fonts.cst" as places;
use "fonts.cst" as fonts;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return n;
}

fn eq(a as *u8, b as *u8) as i32 {
    let is i64 as n = len(b);
    if (len(a) != n || mem.memcmp(a, b, n) != 0) {
        io.printf("  '%s', want '%s'\n", a, b);
        return 0;
    }
    return 1;
}

fn ends(a as *u8, b as *u8) as i32 {
    let is i64 as na = len(a);
    let is i64 as nb = len(b);
    if (na < nb || mem.memcmp(cast(*u8, cast(i64, a) + na - nb), b, nb) != 0) { return 0; }
    return 1;
}

// The file's inode: a file saved again is a new one, moved over the old.
fn inode(path as *u8) as i64 {
    let is [144]u8 as st;
    if (linux.stat(path, cast(*u8, &st)) != 0) { return 0 - 1; }
    return *cast(*i64, cast(i64, &st) + 8);
}

fn mtime(path as *u8) as i64 {
    let is [144]u8 as st;
    if (linux.stat(path, cast(*u8, &st)) != 0) { return 0 - 1; }
    return *cast(*i64, cast(i64, &st) + 88) * 1000000000 + *cast(*i64, cast(i64, &st) + 96);
}

let is *u8 as CACHE with imut = "/tmp/caustic-fonts-hub/deep/fonts.index";

fn kept() as void {
    linux.unlink(CACHE);
    linux.rmdir("/tmp/caustic-fonts-hub/deep");
    linux.rmdir("/tmp/caustic-fonts-hub");
    let is places.Dirs as d;
    d.n = 1;
    mem.memcpy(places.dir(&d, 0), "text/testdata/fonts", 20);
    let is fonts.index.Index as ix with mut;
    check("made", fonts.refresh(&d, CACHE, &ix) == 1);
    check("every file read", ix.reads == 31 && fonts.index.face_count(&ix) == 30);
    let is i64 as t = mtime(CACHE);
    let is i64 as node = inode(CACHE);
    check("kept, the directories above made", t > 0);
    fonts.index.close(&ix);
    check("made again", fonts.refresh(&d, CACHE, &ix) == 1);
    check("from the file: nothing read", ix.reads == 0 && fonts.index.face_count(&ix) == 30);
    check("nor written", mtime(CACHE) == t && inode(CACHE) == node);
    fonts.index.close(&ix);
    // Nowhere to keep it: made all the same.
    check("no file", fonts.refresh(&d, "", &ix) == 1 && ix.reads == 31);
    fonts.index.close(&ix);
    check("a null one", fonts.refresh(&d, cast(*u8, 0), &ix) == 1 && ix.reads == 31);
    fonts.index.close(&ix);
    linux.unlink(CACHE);
    linux.rmdir("/tmp/caustic-fonts-hub/deep");
    linux.rmdir("/tmp/caustic-fonts-hub");
}

fn interface() as void {
    let is places.Dirs as d;
    d.n = 1;
    mem.memcpy(places.dir(&d, 0), "text/testdata/fonts", 20);
    let is fonts.index.Index as ix with mut;
    fonts.refresh(&d, "", &ix);
    let is fonts.chain.Prefs as p with mut = fonts.chain.defaults();
    p.ui = "Caustic Test Var";
    p.mono = "Caustic Test Mono";
    let is settings.Settings as s with mut = settings.defaults();
    check("no font set: system-ui", eq(fonts.ui_family(&s), "system-ui") && eq(fonts.mono_family(&s), "monospace"));
    let is fonts.chain.Chain as c with mut;
    check("system-ui's chain", fonts.ui(&c, &ix, &s, &p) == 1
          && ends(fonts.index.path_of(&ix, fonts.chain.member(&c, 0).face), "TestVar.ttf") == 1);
    fonts.chain.close(&c);
    mem.memcpy(cast(*u8, &s.font), "Caustic Test Sans", 18);
    mem.memcpy(cast(*u8, &s.mono), "Caustic Test Greek", 19);
    s.known = settings.K_FONT | settings.K_MONO;
    check("the desktop's", eq(fonts.ui_family(&s), "Caustic Test Sans") && eq(fonts.mono_family(&s), "Caustic Test Greek"));
    check("its chain", fonts.ui(&c, &ix, &s, &p) == 1
          && ends(fonts.index.path_of(&ix, fonts.chain.member(&c, 0).face), "TestSans-Regular.ttf") == 1);
    fonts.chain.close(&c);
    check("the monospace one", fonts.mono(&c, &ix, &s, &p) == 1
          && ends(fonts.index.path_of(&ix, fonts.chain.member(&c, 0).face), "TestGreek.ttf") == 1);
    fonts.chain.close(&c);
    // A name not reported is none, whatever the buffer holds; and one
    // reported empty.
    s.known = 0;
    check("not reported: none", eq(fonts.ui_family(&s), "system-ui") && eq(fonts.mono_family(&s), "monospace"));
    s.known = settings.K_FONT | settings.K_MONO;
    s.font[0] = cast(u8, 0);
    s.mono[0] = cast(u8, 0);
    check("reported empty: none", eq(fonts.ui_family(&s), "system-ui") && eq(fonts.mono_family(&s), "monospace"));
    // A family the desktop names that is not here: sans-serif's.
    mem.memcpy(cast(*u8, &s.font), "Caustic Test Nothing", 21);
    s.known = settings.K_FONT;
    p.sans = "Caustic Test Mono";
    check("not here: sans-serif's", fonts.ui(&c, &ix, &s, &p) == 1
          && ends(fonts.index.path_of(&ix, fonts.chain.member(&c, 0).face), "TestMono.ttf") == 1);
    fonts.chain.close(&c);
    fonts.index.close(&ix);
}

// An environment of its own: a, b and c (those not null), behind an argv of
// one, as the kernel lays them out — std/env's getenv reads it.
let is [6]*u8 as fake with mut;

fn fake_env(a as *u8, b as *u8, c as *u8) as void {
    fake[0] = "fonts_test";
    fake[1] = cast(*u8, 0);
    fake[2] = a;
    fake[3] = b;
    fake[4] = c;
    fake[5] = cast(*u8, 0);
    env.init(1, cast(*u8, &fake));
}

// The first of LC_ALL, LC_CTYPE and LANG that is set and not empty.
fn locale(argc as i64, argv as *u8) as void {
    let is *u8 as none = cast(*u8, 0);
    fake_env("LC_ALL=", "LC_CTYPE=ja_JP.UTF-8", "LANG=ko_KR.UTF-8");
    check("LC_ALL empty: LC_CTYPE", eq(fonts.locale(), "ja_JP.UTF-8") && fonts.prefs().lang == fonts.chain.JP);
    fake_env("LC_ALL=zh_TW.UTF-8", "LC_CTYPE=ja_JP.UTF-8", "LANG=ko_KR.UTF-8");
    check("LC_ALL before the others", eq(fonts.locale(), "zh_TW.UTF-8") && fonts.prefs().lang == fonts.chain.TC);
    fake_env("LC_CTYPE=", "LANG=ko_KR.UTF-8", none);
    check("LANG last", eq(fonts.locale(), "ko_KR.UTF-8") && fonts.prefs().lang == fonts.chain.KR);
    fake_env("HOME=/home/ana", none, none);
    check("none of them: none", eq(fonts.locale(), "") && fonts.prefs().lang == fonts.chain.SC);
    env.init(argc, argv);
}

// This machine: its directories, the index where XDG_CACHE_HOME says.
fn machine() as void {
    let is fonts.index.Index as ix with mut;
    check("this machine's fonts", fonts.system(&ix) == 1);
    let is [512]u8 as path;
    let is i64 as n = places.index_path(cast(*u8, &path), 512);
    check("kept", n == 0 || mtime(cast(*u8, &path)) > 0);
    let is places.Dirs as d;
    places.system(&d);
    if (fonts.index.face_count(&ix) > 0) {
        let is fonts.chain.Prefs as p = fonts.prefs();
        let is fonts.chain.Chain as c with mut;
        check("a chain of them", fonts.chain.open(&c, &ix, "sans-serif", 400.0, 100.0, 0, &p) == 1
              && fonts.chain.find(&c, 65) >= 0);
        fonts.chain.close(&c);
    }
    io.printf("  this machine: %d directories, %d files, %d faces, %d read\n", d.n, fonts.index.file_count(&ix),
              fonts.index.face_count(&ix), ix.reads);
    fonts.index.close(&ix);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    kept();
    interface();
    locale(argc, argv);
    machine();
    if (fails > 0) {
        io.printf("fonts: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("fonts: all checks passed\n");
    return 0;
}
