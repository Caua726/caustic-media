// text/fonts/fonts.cst — the hub. See fonts.md.
//
// system() finds the system's fonts and keeps their index; a chain is
// opened on it for a list of families (chain.open), or for the desktop's
// interface and monospace fonts (ui, mono), which window/settings.cst reads.
use "std/env.cst" as env;
use "../../window/fonts.cst" as places;
use "../../window/settings.cst" as settings;
use "scan.cst" as scan;
use "face.cst" as face;
use "index.cst" as index;
use "match.cst" as matching;
use "chain.cst" as chain;

fn _set(p as *u8) as i32 {
    if (cast(i64, p) != 0 && *p != 0) { return 1; }
    return 0;
}

// The fonts under the directories of d into ix, the index kept at cache
// read first and written again when it no longer holds — cache null or
// empty for none. 1; the index is empty when there are no fonts at all.
fn refresh(d as *places.Dirs, cache as *u8, ix as *index.Index) as i32 {
    let is index.Index as old with mut = index.empty();
    if (_set(cache) == 1) { index.load(cache, &old); }
    let is scan.Scan as s with mut = scan.open();
    let is i64 as i with mut = 0;
    while (i < d.n) {
        scan.walk(&s, places.dir(d, i));
        i = i + 1;
    }
    *ix = index.update(&old, &s);
    if (_set(cache) == 1 && index.changed(&old, ix) == 1) { index.save(ix, cache); }
    scan.close(&s);
    index.close(&old);
    return 1;
}

// This system's fonts, the index where the platform keeps it. std/env's
// environment, so the program must have called env.init.
fn system(ix as *index.Index) as i32 {
    let is places.Dirs as d;
    places.system(&d);
    let is [512]u8 as path;
    places.index_path(cast(*u8, &path), 512);   // "" for nowhere
    return refresh(&d, cast(*u8, &path), ix);
}

// The locale the text's language is taken from when nothing says: LC_ALL,
// LC_CTYPE or LANG, the first set; "" for none.
fn locale() as *u8 {
    let is *u8 as v with mut = env.getenv("LC_ALL");
    if (_set(v) == 0) { v = env.getenv("LC_CTYPE"); }
    if (_set(v) == 0) { v = env.getenv("LANG"); }
    if (_set(v) == 0) { return ""; }
    return v;
}

// The platforms' preferences, CJK in the locale's order.
fn prefs() as chain.Prefs {
    let is chain.Prefs as p with mut = chain.defaults();
    p.lang = chain.lang_of(locale());
    return p;
}

// The interface's family as the desktop names it, or system-ui.
fn ui_family(s as *settings.Settings) as *u8 {
    if ((s.known & settings.K_FONT) != 0 && s.font[0] != 0) { return cast(*u8, &s.font); }
    return "system-ui";
}

fn mono_family(s as *settings.Settings) as *u8 {
    if ((s.known & settings.K_MONO) != 0 && s.mono[0] != 0) { return cast(*u8, &s.mono); }
    return "monospace";
}

// A chain for the interface's text, regular and upright; the desktop's
// family first, and sans-serif's behind it for when the family is not here.
fn ui(c as *chain.Chain, ix as *index.Index, s as *settings.Settings, p as *chain.Prefs) as i32 {
    return chain.open(c, ix, ui_family(s), 400.0, 100.0, face.NORMAL, p);
}

fn mono(c as *chain.Chain, ix as *index.Index, s as *settings.Settings, p as *chain.Prefs) as i32 {
    return chain.open(c, ix, mono_family(s), 400.0, 100.0, face.NORMAL, p);
}
