// text/fonts/pool.cst — bytes that grow: the index's records, its strings
// and coverage, the walk's paths. One block each, doubled when full, so a
// place in it is an offset — a pointer would not survive the move.
use "std/mem.cst" as mem;

struct Pool {
    base as *u8;
    len  as i64;
    cap  as i64;
}

fn empty() as Pool {
    let is Pool as p;
    p.base = cast(*u8, 0);
    p.len = 0;
    p.cap = 0;
    return p;
}

fn free(p as *Pool) as void {
    if (p.cap > 0) { mem.core.munmap(p.base, p.cap); }
    p.base = cast(*u8, 0);
    p.len = 0;
    p.cap = 0;
}

// Room for n more bytes; 0 when the memory is refused, the pool as it was.
fn reserve(p as *Pool, n as i64) as i32 {
    if (n < 0) { return 0; }
    if (p.len + n <= p.cap) { return 1; }
    let is i64 as cap with mut = p.cap * 2;
    if (cap < 4096) { cap = 4096; }
    while (cap < p.len + n) { cap = cap * 2; }
    let is *u8 as b = mem.core.mmap_anon(cap);
    if (cast(i64, b) == 0 || cast(i64, b) == 0 - 1) { return 0; }
    if (p.len > 0) { mem.memcpy(b, p.base, p.len); }
    if (p.cap > 0) { mem.core.munmap(p.base, p.cap); }
    p.base = b;
    p.cap = cap;
    return 1;
}

// n bytes of src appended — zeros when src is null; their offset, or -1.
fn add(p as *Pool, src as *u8, n as i64) as i64 {
    if (reserve(p, n) == 0) { return 0 - 1; }
    let is i64 as at = p.len;
    if (cast(i64, src) == 0) { mem.memzero(cast(*u8, cast(i64, p.base) + at), n); } else { mem.memcpy(cast(*u8, cast(i64, p.base) + at), src, n); }
    p.len = p.len + n;
    return at;
}

// A NUL-terminated string appended with its NUL; its offset, or -1.
fn add_str(p as *Pool, s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return add(p, s, n + 1);
}

fn at(p as *Pool, off as i64) as *u8 { return cast(*u8, cast(i64, p.base) + off); }

fn i64_at(p as *Pool, i as i64) as i64 { return *cast(*i64, cast(i64, p.base) + i * 8); }

fn set_i64(p as *Pool, i as i64, v as i64) as void { *cast(*i64, cast(i64, p.base) + i * 8) = v; }

fn add_i64(p as *Pool, v as i64) as i64 {
    let is i64 as x = v;
    return add(p, cast(*u8, &x), 8);
}
