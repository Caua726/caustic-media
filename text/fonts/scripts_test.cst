// text/fonts/scripts_test.cst — this system's fonts, asked for a character of each
// writing system with a shaper of its own: the chain of the default sans-serif
// falls back to a font that has it. A writing system no installed font has is said,
// not failed; with Noto installed, as on the machine this is developed on, the
// major ones must be found.
//
// Built by caustic-mk (target font_scripts_test), for caustic-unicode's tables.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "../sfnt/sfnt.cst" as sfnt;
use "../sfnt/cmap.cst" as cmap;
use "face.cst" as face;
use "index.cst" as index;
use "chain.cst" as chain;
use "fonts.cst" as fonts;

let is i32 as fails with mut = 0;
let is i32 as found with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn ask(c as *chain.Chain, name as *u8, cp as i64) as void {
    let is i64 as m = chain.find(c, cp);
    if (m < 0) {
        io.printf("  %s: no font on this system\n", name);
        return;
    }
    check(name, cast(i32, cmap.glyph(chain.face(c, m), cp) != 0));
    found = found + 1;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is index.Index as ix with mut = index.empty();
    if (fonts.system(&ix) == 0 || index.face_count(&ix) == 0) {
        io.printf("font scripts: no fonts on this system\n");
        return 0;
    }
    let is chain.Prefs as p = chain.defaults();
    let is chain.Chain as c;
    check("a chain of the default family", chain.open(&c, &ix, "sans-serif", 400.0, 100.0, face.NORMAL, &p));
    ask(&c, "arabic", 1587);
    ask(&c, "syriac", 1808);
    ask(&c, "n'ko", 1994);
    ask(&c, "mongolian", 6176);
    ask(&c, "adlam", 125184);
    ask(&c, "devanagari", 2325);
    ask(&c, "bengali", 2453);
    ask(&c, "gurmukhi", 2581);
    ask(&c, "gujarati", 2709);
    ask(&c, "oriya", 2837);
    ask(&c, "tamil", 2965);
    ask(&c, "telugu", 3093);
    ask(&c, "kannada", 3221);
    ask(&c, "malayalam", 3349);
    ask(&c, "thai", 3585);
    ask(&c, "lao", 3713);
    ask(&c, "hangul", 44032);
    ask(&c, "khmer", 6016);
    ask(&c, "myanmar", 4096);
    ask(&c, "tibetan", 3904);
    ask(&c, "sinhala", 3482);
    ask(&c, "balinese", 6917);
    ask(&c, "javanese", 43407);
    chain.close(&c);
    if (fails > 0) {
        io.printf("font scripts: %d failures\n", fails);
        return 1;
    }
    io.printf("font scripts: %d writing systems found\n", found);
    return 0;
}
