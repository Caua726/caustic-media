// text/fonts/match.cst — the face of a family that best answers a request,
// by CSS Fonts' matching (level 4, §5.2): the faces are narrowed by width,
// then by style, then by weight, each step keeping the faces nearest what
// was asked in the order CSS sets for what is missing, so that a program
// here is given the face a web page asking the same would be.
//
//   width    the one asked; else, at or below 100%, the nearest narrower,
//            then the nearest wider; above 100%, the other way round
//   style    italic: italic, oblique, normal; oblique: oblique, italic,
//            normal; normal: normal, oblique, italic
//   weight   the one asked; else, from 400 to 500, the nearest heavier up
//            to 500, then the nearest lighter, then heavier past 500;
//            below 400 lighter, then heavier; above 500 heavier, then
//            lighter
//
// A variable face is a range of weights and widths and is at any value in
// it, so the value settled on is where it is drawn. Oblique angles are not
// matched by degree, as CSS's level 4 does: a face is oblique or not.
//
// Imported as matching: match is a word of the language.
use "face.cst" as face;
use "index.cst" as index;
use "pool.cst" as pool;

struct Choice {
    face   as i64;   // -1 for none
    weight as f64;   // the weight and width it is drawn at: in its ranges
    width  as f64;
    style  as i64;   // face.NORMAL, ITALIC or OBLIQUE: what it is drawn as
}

fn _clamp(v as f64, lo as f64, hi as f64) as f64 {
    if (v >= hi) { return hi; }
    if (v >= lo) { return v; }
    return lo;
}

fn _lo(ix as *index.Index, i as i64, width as i32) as f64 {
    if (width == 1) { return index.desc(ix, i).width_lo; }
    return index.desc(ix, i).weight_lo;
}

fn _hi(ix as *index.Index, i as i64, width as i32) as f64 {
    if (width == 1) { return index.desc(ix, i).width_hi; }
    return index.desc(ix, i).weight_hi;
}

// The value CSS settles on for w among the candidates' ranges: w when one
// holds it, else the nearest end in the order above.
fn _settle(ix as *index.Index, c as *i64, n as i64, w as f64, width as i32) as f64 {
    let is i32 as has_below with mut = 0;
    let is i32 as has_above with mut = 0;
    let is i32 as has_mid with mut = 0;
    let is f64 as below with mut = 0.0;   // the heaviest end under w
    let is f64 as above with mut = 0.0;   // the lightest end over w
    let is f64 as mid with mut = 0.0;     // the lightest end over w up to 500
    let is i64 as k with mut = 0;
    while (k < n) {
        let is i64 as i = *cast(*i64, cast(i64, c) + k * 8);
        let is f64 as lo = _lo(ix, i, width);
        let is f64 as hi = _hi(ix, i, width);
        if (w >= lo && hi >= w) { return w; }
        if (w > hi && (has_below == 0 || hi > below)) {
            below = hi;
            has_below = 1;
        }
        if (lo > w && (has_above == 0 || above > lo)) {
            above = lo;
            has_above = 1;
        }
        if (lo > w && 500.0 >= lo && (has_mid == 0 || mid > lo)) {
            mid = lo;
            has_mid = 1;
        }
        k = k + 1;
    }
    if (width == 1) {
        if (100.0 >= w) {
            if (has_below == 1) { return below; }
            return above;
        }
        if (has_above == 1) { return above; }
        return below;
    }
    if (w >= 400.0 && 500.0 >= w) {
        if (has_mid == 1) { return mid; }
        if (has_below == 1) { return below; }
        return above;
    }
    if (400.0 > w) {
        if (has_below == 1) { return below; }
        return above;
    }
    if (has_above == 1) { return above; }
    return below;
}

// The candidates whose ranges hold v, kept in their order; how many.
fn _keep(ix as *index.Index, c as *i64, n as i64, v as f64, width as i32) as i64 {
    let is i64 as kept with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        let is i64 as i = *cast(*i64, cast(i64, c) + k * 8);
        if (v >= _lo(ix, i, width) && _hi(ix, i, width) >= v) {
            *cast(*i64, cast(i64, c) + kept * 8) = i;
            kept = kept + 1;
        }
        k = k + 1;
    }
    return kept;
}

fn _bit(style as i64) as i64 {
    if (style == face.ITALIC) { return face.CAN_ITALIC; }
    if (style == face.OBLIQUE) { return face.CAN_OBLIQUE; }
    return face.CAN_NORMAL;
}

// The first style of asked's order some candidate can be.
fn _style(ix as *index.Index, c as *i64, n as i64, asked as i64) as i64 {
    let is [3]i64 as order;
    order[0] = face.NORMAL;
    order[1] = face.OBLIQUE;
    order[2] = face.ITALIC;
    if (asked == face.ITALIC) {
        order[0] = face.ITALIC;
        order[1] = face.OBLIQUE;
        order[2] = face.NORMAL;
    }
    if (asked == face.OBLIQUE) {
        order[0] = face.OBLIQUE;
        order[1] = face.ITALIC;
        order[2] = face.NORMAL;
    }
    let is i64 as s with mut = 0;
    while (s < 3) {
        let is i64 as k with mut = 0;
        while (k < n) {
            if ((index.desc(ix, *cast(*i64, cast(i64, c) + k * 8)).styles & _bit(order[s])) != 0) { return order[s]; }
            k = k + 1;
        }
        s = s + 1;
    }
    return 0 - 1;
}

// The best of the n faces at faces for weight, width and style, among those
// reaching page — all of them when page is negative; the first of those
// left when several are as good.
fn narrow(ix as *index.Index, faces as *i64, n as i64, page as i64, weight as f64, width as f64, style as i64) as Choice {
    let is Choice as r;
    r.face = 0 - 1;
    r.weight = 0.0;
    r.width = 0.0;
    r.style = face.NORMAL;
    let is f64 as w = _clamp(weight, 1.0, 1000.0);
    let is f64 as s = _clamp(width, 0.0, 1000.0);
    // The candidates: on the stack for a family of up to 256 faces.
    let is [256]i64 as small;
    let is pool.Pool as big with mut = pool.empty();
    let is *i64 as c with mut = cast(*i64, &small);
    if (n > 256) {
        if (pool.add(&big, cast(*u8, 0), n * 8) < 0) { return r; }
        c = cast(*i64, big.base);
    }
    let is i64 as m with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        let is i64 as i = *cast(*i64, cast(i64, faces) + k * 8);
        if (page < 0 || index.covers_page(ix, i, page) == 1) {
            *cast(*i64, cast(i64, c) + m * 8) = i;
            m = m + 1;
        }
        k = k + 1;
    }
    if (m > 0) {
        r.width = _settle(ix, c, m, s, 1);
        m = _keep(ix, c, m, r.width, 1);
        r.style = _style(ix, c, m, style);
        let is i64 as kept with mut = 0;
        k = 0;
        while (k < m) {
            let is i64 as i = *cast(*i64, cast(i64, c) + k * 8);
            if ((index.desc(ix, i).styles & _bit(r.style)) != 0) {
                *cast(*i64, cast(i64, c) + kept * 8) = i;
                kept = kept + 1;
            }
            k = k + 1;
        }
        if (kept == 0) {
            r.style = face.NORMAL;
        } else {
            r.weight = _settle(ix, c, kept, w, 0);
            _keep(ix, c, kept, r.weight, 0);
            r.face = *c;
        }
    }
    pool.free(&big);
    return r;
}

// The best face of the family called name; face -1 when there is no such
// family.
fn best(ix as *index.Index, name as *u8, weight as f64, width as f64, style as i64) as Choice {
    let is index.Run as run = index.family(ix, name);
    return narrow(ix, run.faces, run.n, 0 - 1, weight, width, style);
}
