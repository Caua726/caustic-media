// text/fonts/match_test.cst — CSS Fonts' matching over the test fonts:
// width first, then style, then weight, each by the order CSS gives for
// what is missing; ranges of variable faces; families by name, legacy name
// and none; a list of faces narrowed to those reaching a page.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "scan.cst" as scan;
use "face.cst" as face;
use "index.cst" as index;
use "match.cst" as matching;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return n;
}

fn ends(a as *u8, b as *u8) as i32 {
    let is i64 as na = len(a);
    let is i64 as nb = len(b);
    if (na < nb || mem.memcmp(cast(*u8, cast(i64, a) + na - nb), b, nb) != 0) { return 0; }
    return 1;
}

let is index.Index as ix with mut;

fn face_of(tail as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (i < index.face_count(&ix)) {
        if (ends(index.path_of(&ix, i), tail) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// The choice is the face in the file ending with tail, drawn at weight w,
// width s and in style st.
fn chose(c as matching.Choice, tail as *u8, w as f64, s as f64, st as i64) as i32 {
    let is i64 as want = face_of(tail);
    if (c.face != want || c.weight != w || c.width != s || c.style != st) {
        let is *u8 as got with mut = "none";
        if (c.face >= 0) { got = index.path_of(&ix, c.face); }
        io.printf("  %s at %d, %d%%, style %d\n", got, cast(i64, c.weight), cast(i64, c.width), c.style);
        return 0;
    }
    return 1;
}

let is *u8 as SANS with imut = "Caustic Test Sans";

fn sans(w as f64, s as f64, st as i64) as matching.Choice { return matching.best(&ix, SANS, w, s, st); }

let is [8]i64 as list with mut;

// The faces whose files end with a, b and c, those not null, narrowed.
fn among(a as *u8, b as *u8, c as *u8, page as i64, w as f64, st as i64) as matching.Choice {
    let is i64 as n with mut = 0;
    list[n] = face_of(a);
    n = n + 1;
    if (cast(i64, b) != 0) {
        list[n] = face_of(b);
        n = n + 1;
    }
    if (cast(i64, c) != 0) {
        list[n] = face_of(c);
        n = n + 1;
    }
    return matching.narrow(&ix, cast(*i64, &list), n, page, w, 100.0, st);
}

fn main() as i32 {
    let is scan.Scan as sc with mut = scan.open();
    scan.walk(&sc, "text/testdata/fonts");
    let is index.Index as none with mut = index.empty();
    ix = index.update(&none, &sc);
    let is i64 as N = face.NORMAL;
    let is i64 as I = face.ITALIC;
    let is i64 as O = face.OBLIQUE;
    let is *u8 as nothing = cast(*u8, 0);

    // --- Weight, among the normal faces of normal width ---
    check("400: regular", chose(sans(400.0, 100.0, N), "Sans-Regular.ttf", 400.0, 100.0, N));
    check("500: nothing heavier up to 500, so lighter", chose(sans(500.0, 100.0, N), "Sans-Regular.ttf", 400.0, 100.0, N));
    check("450: the same", chose(sans(450.0, 100.0, N), "Sans-Regular.ttf", 400.0, 100.0, N));
    check("600: heavier first", chose(sans(600.0, 100.0, N), "Sans-Bold.TTF", 700.0, 100.0, N));
    check("650", chose(sans(650.0, 100.0, N), "Sans-Bold.TTF", 700.0, 100.0, N));
    check("800", chose(sans(800.0, 100.0, N), "Sans-Black.ttf", 900.0, 100.0, N));
    check("1000: nothing heavier, so lighter", chose(sans(1000.0, 100.0, N), "Sans-Black.ttf", 900.0, 100.0, N));
    check("350: lighter first", chose(sans(350.0, 100.0, N), "Sans-Light.otf", 300.0, 100.0, N));
    check("200", chose(sans(200.0, 100.0, N), "Sans-Thin.ttf", 100.0, 100.0, N));
    check("50: nothing lighter, so heavier", chose(sans(50.0, 100.0, N), "Sans-Thin.ttf", 100.0, 100.0, N));
    check("700 and 300 and 100 exactly", chose(sans(700.0, 100.0, N), "Sans-Bold.TTF", 700.0, 100.0, N)
          && chose(sans(300.0, 100.0, N), "Sans-Light.otf", 300.0, 100.0, N) && chose(sans(100.0, 100.0, N), "Sans-Thin.ttf", 100.0, 100.0, N));

    // --- Style before weight ---
    check("italic", chose(sans(400.0, 100.0, I), "Sans-Italic.ttf", 400.0, 100.0, I));
    check("bold italic", chose(sans(700.0, 100.0, I), "Sans-BoldItalic.ttf", 700.0, 100.0, I));
    check("light italic: the italic above", chose(sans(300.0, 100.0, I), "Sans-Italic.ttf", 400.0, 100.0, I));
    check("black italic: the bold italic", chose(sans(900.0, 100.0, I), "Sans-BoldItalic.ttf", 700.0, 100.0, I));
    check("italic 500: the italic below", chose(sans(500.0, 100.0, I), "Sans-Italic.ttf", 400.0, 100.0, I));
    check("italic 550: heavier", chose(sans(550.0, 100.0, I), "Sans-BoldItalic.ttf", 700.0, 100.0, I));
    check("oblique", chose(sans(400.0, 100.0, O), "Sans-Oblique.ttf", 400.0, 100.0, O));
    check("bold oblique: the oblique, whatever its weight", chose(sans(700.0, 100.0, O), "Sans-Oblique.ttf", 400.0, 100.0, O));
    // Each style's order when it is missing.
    check("normal asked of an italic face", chose(matching.best(&ix, "Caustic Test Plain", 700.0, 100.0, N), "TestPlain.ttf", 700.0, 100.0, I));
    check("oblique asked: italic", chose(matching.best(&ix, "Caustic Test Ital", 400.0, 100.0, O), "TestItal.ttf", 400.0, 100.0, I));
    check("italic asked: oblique", chose(matching.best(&ix, "Caustic Test Var", 400.0, 100.0, I), "TestVar.ttf", 400.0, 100.0, O));
    check("italic asked of a normal face", chose(matching.best(&ix, "Caustic Test Mono", 400.0, 100.0, I), "TestMono.ttf", 400.0, 100.0, N));
    check("normal: oblique before italic", chose(among("Sans-Italic.ttf", "Sans-Oblique.ttf", nothing, 0 - 1, 400.0, N), "Sans-Oblique.ttf", 400.0, 100.0, O)
          && chose(among("Sans-Oblique.ttf", "Sans-Italic.ttf", nothing, 0 - 1, 400.0, N), "Sans-Oblique.ttf", 400.0, 100.0, O));
    check("italic: italic before oblique", chose(among("Sans-Oblique.ttf", "Sans-Italic.ttf", nothing, 0 - 1, 400.0, I), "Sans-Italic.ttf", 400.0, 100.0, I));
    check("oblique: oblique before italic", chose(among("Sans-Italic.ttf", "Sans-Oblique.ttf", nothing, 0 - 1, 400.0, O), "Sans-Oblique.ttf", 400.0, 100.0, O));
    check("oblique: italic before normal", chose(among("Sans-Regular.ttf", "Sans-Italic.ttf", nothing, 0 - 1, 400.0, O), "Sans-Italic.ttf", 400.0, 100.0, I));
    check("italic: oblique before normal", chose(among("Sans-Regular.ttf", "Sans-Oblique.ttf", nothing, 0 - 1, 400.0, I), "Sans-Oblique.ttf", 400.0, 100.0, O));

    // --- Width before both ---
    check("condensed", chose(sans(400.0, 75.0, N), "Sans-Condensed.ttf", 400.0, 75.0, N));
    check("80%: narrower first", chose(sans(400.0, 80.0, N), "Sans-Condensed.ttf", 400.0, 75.0, N));
    check("90%: narrower first, though normal is nearer", chose(sans(400.0, 90.0, N), "Sans-Condensed.ttf", 400.0, 75.0, N));
    check("50%: nothing narrower, so wider", chose(sans(400.0, 50.0, N), "Sans-Condensed.ttf", 400.0, 75.0, N));
    check("110%: wider first", chose(sans(400.0, 110.0, N), "Sans-Expanded.ttf", 400.0, 125.0, N));
    check("130%: nothing wider, so narrower", chose(sans(400.0, 130.0, N), "Sans-Expanded.ttf", 400.0, 125.0, N));
    check("condensed italic: condensed, not italic", chose(sans(400.0, 75.0, I), "Sans-Condensed.ttf", 400.0, 75.0, N));
    check("expanded bold: expanded, at its weight", chose(sans(700.0, 125.0, N), "Sans-Expanded.ttf", 400.0, 125.0, N));

    // --- Ranges ---
    let is *u8 as V = "Caustic Test Var";
    check("within: as asked", chose(matching.best(&ix, V, 700.0, 100.0, N), "TestVar.ttf", 700.0, 100.0, N));
    check("past the heaviest: the heaviest", chose(matching.best(&ix, V, 900.0, 100.0, N), "TestVar.ttf", 800.0, 100.0, N));
    check("below the lightest: the lightest", chose(matching.best(&ix, V, 100.0, 100.0, N), "TestVar.ttf", 200.0, 100.0, N));
    check("a width within", chose(matching.best(&ix, V, 450.0, 87.5, N), "TestVar.ttf", 450.0, 87.5, N));
    check("wider than it goes", chose(matching.best(&ix, V, 400.0, 120.0, N), "TestVar.ttf", 400.0, 100.0, N));
    check("narrower than it goes", chose(matching.best(&ix, V, 400.0, 60.0, N), "TestVar.ttf", 400.0, 75.0, N));
    check("oblique, slanted", chose(matching.best(&ix, V, 400.0, 100.0, O), "TestVar.ttf", 400.0, 100.0, O));
    check("a range and a face within it: the first listed", chose(among("Sans-Regular.ttf", "TestVar.ttf", nothing, 0 - 1, 400.0, N), "Sans-Regular.ttf", 400.0, 100.0, N)
          && chose(among("TestVar.ttf", "Sans-Regular.ttf", nothing, 0 - 1, 400.0, N), "TestVar.ttf", 400.0, 100.0, N));
    check("a range nearer than a face", chose(among("Sans-Regular.ttf", "TestVar.ttf", nothing, 0 - 1, 750.0, N), "TestVar.ttf", 750.0, 100.0, N));
    check("in 400..500, heavier up to 500 from a range", chose(among("Sans-Regular.ttf", "Sans-Black.ttf", nothing, 0 - 1, 450.0, N), "Sans-Regular.ttf", 400.0, 100.0, N));

    // --- Between 400 and 500 ---
    let is *u8 as W = "Caustic Test Weights";
    check("450: the lightest heavier, up to 500", chose(matching.best(&ix, W, 450.0, 100.0, N), "Weights-460.ttf", 460.0, 100.0, N));
    check("400: heavier up to 500 before lighter", chose(matching.best(&ix, W, 400.0, 100.0, N), "Weights-460.ttf", 460.0, 100.0, N));
    check("490: 500, heavier but not past it", chose(matching.best(&ix, W, 490.0, 100.0, N), "Weights-500.ttf", 500.0, 100.0, N));
    check("350: lighter", chose(matching.best(&ix, W, 350.0, 100.0, N), "Weights-300.ttf", 300.0, 100.0, N));
    check("250: heavier", chose(matching.best(&ix, W, 250.0, 100.0, N), "Weights-300.ttf", 300.0, 100.0, N));
    check("400 and 500 asked, none between: lighter before heavier",
          chose(among("Sans-Light.otf", "Sans-Bold.TTF", nothing, 0 - 1, 400.0, N), "Sans-Light.otf", 300.0, 100.0, N)
          && chose(among("Sans-Bold.TTF", "Sans-Light.otf", nothing, 0 - 1, 500.0, N), "Sans-Light.otf", 300.0, 100.0, N));
    check("normal width asked, none: narrower first", chose(among("Sans-Expanded.ttf", "Sans-Condensed.ttf", nothing, 0 - 1, 400.0, N), "Sans-Condensed.ttf", 400.0, 75.0, N));
    check("a face not on the page passed over", chose(among("Weights-460.ttf", "Sans-Regular.ttf", nothing, 0, 450.0, N), "Sans-Regular.ttf", 400.0, 100.0, N));

    // --- Names ---
    check("whatever the case", chose(matching.best(&ix, "CAUSTIC test sans", 400.0, 100.0, N), "Sans-Regular.ttf", 400.0, 100.0, N));
    check("a legacy family: its face", chose(matching.best(&ix, "Caustic Test Sans Black", 400.0, 100.0, N), "Sans-Black.ttf", 900.0, 100.0, N));
    let is matching.Choice as c with mut = matching.best(&ix, "Caustic Test Nothing", 400.0, 100.0, N);
    check("no such family", c.face == 0 - 1);
    c = matching.best(&ix, "", 400.0, 100.0, N);
    check("no name", c.face == 0 - 1);
    c = matching.narrow(&ix, cast(*i64, &list), 0, 0 - 1, 400.0, 100.0, N);
    check("no faces", c.face == 0 - 1);

    // --- Pages ---
    check("only the bold reaches page 1", chose(among("Sans-Regular.ttf", "Sans-Bold.TTF", "Sans-Italic.ttf", 1, 400.0, I), "Sans-Bold.TTF", 700.0, 100.0, N));
    check("none reaches page 3", among("Sans-Regular.ttf", "Sans-Bold.TTF", nothing, 3, 400.0, N).face == 0 - 1);
    check("page 0 for all", chose(among("Sans-Bold.TTF", "Sans-Regular.ttf", nothing, 0, 400.0, N), "Sans-Regular.ttf", 400.0, 100.0, N));

    // --- What is asked, held in range ---
    check("weight 0: the lightest", chose(sans(0.0, 100.0, N), "Sans-Thin.ttf", 100.0, 100.0, N));
    check("a weight not a number: the lightest", chose(sans(0.0 / 0.0, 100.0, N), "Sans-Thin.ttf", 100.0, 100.0, N));
    check("a width below nothing: the narrowest", chose(sans(400.0, 0.0 - 5.0, N), "Sans-Condensed.ttf", 400.0, 75.0, N));
    check("a style not one: normal", chose(sans(400.0, 100.0, 9), "Sans-Regular.ttf", 400.0, 100.0, N));
    check("a width not a number: the narrowest", chose(sans(400.0, 0.0 / 0.0, N), "Sans-Condensed.ttf", 400.0, 75.0, N));

    // --- A family of 300 faces, past what is kept on the stack ---
    let is [300]i64 as lots;
    let is i64 as k with mut = 0;
    while (k < 299) {
        lots[k] = face_of("Sans-Regular.ttf");
        k = k + 1;
    }
    lots[299] = face_of("Sans-Bold.TTF");
    check("300 faces", chose(matching.narrow(&ix, cast(*i64, &lots), 300, 0 - 1, 700.0, 100.0, N), "Sans-Bold.TTF", 700.0, 100.0, N)
          && chose(matching.narrow(&ix, cast(*i64, &lots), 300, 0 - 1, 400.0, 100.0, N), "Sans-Regular.ttf", 400.0, 100.0, N));

    // --- A face that can be drawn no way: none ---
    let is *face.Desc as mono = index.desc(&ix, face_of("TestMono.ttf"));
    mono.styles = 0;
    c = matching.best(&ix, "Caustic Test Mono", 400.0, 100.0, N);
    check("no style: none", c.face == 0 - 1);
    mono.styles = face.CAN_NORMAL;

    index.close(&ix);
    scan.close(&sc);
    if (fails > 0) {
        io.printf("font match: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("font match: all checks passed\n");
    return 0;
}
