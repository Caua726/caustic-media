// text/fonts/index_test.cst — every face of the test fonts' tree described
// as matching reads it (names, weight, width, style, flags, coverage), held
// to what text/tools/make_testdata.py wrote into each; families found by
// name; the index saved, loaded and refused when it is not what was saved;
// and kept up to date: a file changed, gone or new read again, nothing else.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "scan.cst" as scan;
use "face.cst" as face;
use "index.cst" as index;

let is i32 as fails with mut = 0;
// Set in main: a mutable global given a string literal is the literal's
// own bytes, a compiler bug — assigning it would rewrite the literal.
let is *u8 as current with mut;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s (%s)\n", name, current);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return n;
}

fn eq(a as *u8, b as *u8) as i32 {
    let is i64 as n = len(b);
    if (len(a) != n || mem.memcmp(a, b, n) != 0) {
        io.printf("  '%s', want '%s'\n", a, b);
        return 0;
    }
    return 1;
}

fn ends(a as *u8, b as *u8) as i32 {
    let is i64 as na = len(a);
    let is i64 as nb = len(b);
    if (na < nb || mem.memcmp(cast(*u8, cast(i64, a) + na - nb), b, nb) != 0) { return 0; }
    return 1;
}

// The face whose file's path ends with tail, face k of it; -1 for none.
fn face_of(ix as *index.Index, tail as *u8, k as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < index.face_count(ix)) {
        let is *face.Desc as d = index.desc(ix, i);
        if (d.index == k && ends(index.path_of(ix, i), tail) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Face k of the file ending with tail is as given: its names, its ranges,
// what it can be, its flags, and the pages it covers — pages listed with
// -1 after the last, and those from r0 to r1.
fn is_face(ix as *index.Index, tail as *u8, k as i64, family as *u8, legacy as *u8, style as *u8,
           w_lo as f64, w_hi as f64, s_lo as f64, s_hi as f64, styles as i64, flags as i64,
           p0 as i64, p1 as i64, p2 as i64, p3 as i64, r0 as i64, r1 as i64) as void {
    current = tail;
    let is i64 as i = face_of(ix, tail, k);
    check("found", i >= 0);
    if (i < 0) { return; }
    let is *face.Desc as d = index.desc(ix, i);
    check("family", eq(index.family_of(ix, i), family));
    check("legacy family", eq(index.text(ix, d.legacy), legacy));
    check("style name", eq(index.text(ix, d.style), style));
    if (d.weight_lo != w_lo || d.weight_hi != w_hi) { io.printf("  weight %d..%d\n", cast(i64, d.weight_lo), cast(i64, d.weight_hi)); }
    check("weights", d.weight_lo == w_lo && d.weight_hi == w_hi);
    if (d.width_lo != s_lo || d.width_hi != s_hi) { io.printf("  width %d..%d\n", cast(i64, d.width_lo), cast(i64, d.width_hi)); }
    check("widths", d.width_lo == s_lo && d.width_hi == s_hi);
    if (d.styles != styles) { io.printf("  styles %d\n", d.styles); }
    check("styles", d.styles == styles);
    if (d.flags != flags) { io.printf("  flags %d\n", d.flags); }
    check("flags", d.flags == flags);
    // Every page: covered when listed.
    let is [4]i64 as want;
    want[0] = p0;
    want[1] = p1;
    want[2] = p2;
    want[3] = p3;
    let is i32 as same with mut = 1;
    let is i64 as p with mut = 0;
    while (p < 4352) {
        let is i64 as listed with mut = 0;
        if (p >= r0 && r1 >= p) { listed = 1; }
        let is i64 as e with mut = 0;
        while (e < more_n) {
            if (more[e] == p) { listed = 1; }
            e = e + 1;
        }
        let is i64 as j with mut = 0;
        while (j < 4 && want[j] >= 0) {
            if (want[j] == p) { listed = 1; }
            j = j + 1;
        }
        if (index.covers_page(ix, i, p) != listed) {
            io.printf("  page %x: %d\n", p, index.covers_page(ix, i, p));
            same = 0;
        }
        p = p + 1;
    }
    check("pages", same);
}

let is *u8 as SANS with imut = "Caustic Test Sans";

// Pages a face covers besides those is_face is given, for the faces that
// cover more than it takes.
let is [8]i64 as more with mut;
let is i64 as more_n with mut = 0;

fn described(ix as *index.Index) as void {
    let is i64 as N = face.CAN_NORMAL;
    let is i64 as I = face.CAN_ITALIC;
    let is i64 as O = face.CAN_OBLIQUE;
    let is i64 as none = 0 - 1;
    is_face(ix, "TestSans-Thin.ttf", 0, SANS, SANS, "Thin", 100.0, 100.0, 100.0, 100.0, N, 0, 0, none, none, none, none, none);
    is_face(ix, "TestSans-Light.otf", 0, SANS, "Caustic Test Sans Light", "Light", 300.0, 300.0, 100.0, 100.0, N, 0, 0, none, none, none, none, none);
    is_face(ix, "TestSans-Regular.ttf", 0, SANS, SANS, "Regular", 400.0, 400.0, 100.0, 100.0, N, 0, 0, none, none, none, none, none);
    is_face(ix, "TestSans-Italic.ttf", 0, SANS, SANS, "Italic", 400.0, 400.0, 100.0, 100.0, I, 0, 0, none, none, none, none, none);
    is_face(ix, "TestSans-Bold.TTF", 0, SANS, SANS, "Bold", 700.0, 700.0, 100.0, 100.0, N, 0, 0, 1, 4, none, none, none);
    is_face(ix, "TestSans-BoldItalic.ttf", 0, SANS, SANS, "Bold Italic", 700.0, 700.0, 100.0, 100.0, I, 0, 0, none, none, none, none, none);
    is_face(ix, "TestSans-Black.ttf", 0, SANS, "Caustic Test Sans Black", "Black", 900.0, 900.0, 100.0, 100.0, N, 0, 0, none, none, none, none, none);
    is_face(ix, "TestSans-Oblique.ttf", 0, SANS, SANS, "Oblique", 400.0, 400.0, 100.0, 100.0, O, 0, 0, none, none, none, none, none);
    is_face(ix, "TestSans-Condensed.ttf", 0, SANS, "Caustic Test Sans Condensed", "Condensed", 400.0, 400.0, 75.0, 75.0, N, 0, 0, none, none, none, none, none);
    is_face(ix, "TestSans-Expanded.ttf", 0, SANS, "Caustic Test Sans Expanded", "Expanded", 400.0, 400.0, 125.0, 125.0, N, 0, 0, none, none, none, none, none);
    is_face(ix, "TestVar.ttf", 0, "Caustic Test Var", "Caustic Test Var", "Regular", 200.0, 800.0, 75.0, 100.0, N | O, face.VARIABLE, 0, none, none, none, none, none);
    is_face(ix, "TestItal.ttf", 0, "Caustic Test Ital", "Caustic Test Ital", "Regular", 400.0, 400.0, 100.0, 100.0, N | I, face.VARIABLE, 0, none, none, none, none, none);
    is_face(ix, "deeper/TestGreek.ttf", 0, "Caustic Test Greek", "Caustic Test Greek", "Regular", 400.0, 400.0, 100.0, 100.0, N, 0, 0, 3, none, none, none, none);
    is_face(ix, "TestSansGreek-Bold.ttf", 0, "Caustic Test Sans Greek", "Caustic Test Sans Greek", "Bold", 700.0, 700.0, 100.0, 100.0, N, 0, 0, 3, none, none, none, none);
    is_face(ix, "TestSansCyr.ttf", 0, "Caustic Test Sans Cyr", "Caustic Test Sans Cyr", "Condensed", 400.0, 400.0, 75.0, 75.0, N, 0, 0, 4, none, none, none, none);
    is_face(ix, "TestSansCyrillic.ttf", 0, "Caustic Test Sans Cyrillic", "Caustic Test Sans Cyrillic", "Regular", 400.0, 400.0, 100.0, 100.0, N, 0, 0, 4, none, none, none, none);
    more[0] = 2;
    more[1] = 17;
    more_n = 2;
    is_face(ix, "TestCJK.ttc", 0, "Caustic Test CJK JP", "Caustic Test CJK JP", "Regular", 400.0, 400.0, 100.0, 100.0, N, 0, 0, 78, 172, 255, 48, 49);
    is_face(ix, "TestCJK.ttc", 1, "Caustic Test CJK SC", "Caustic Test CJK SC", "Regular", 400.0, 400.0, 100.0, 100.0, N, 0, 0, 78, 172, 255, 48, 49);
    more_n = 0;
    is_face(ix, "TestEmoji.ttf", 0, "Caustic Test Emoji", "Caustic Test Emoji", "Regular", 400.0, 400.0, 100.0, 100.0, N, face.COLOR, 0, 3, 38, 502, 497, 497);
    is_face(ix, "TestMono.ttf", 0, "Caustic Test Mono", "Caustic Test Mono", "Regular", 400.0, 400.0, 100.0, 100.0, N, face.MONO, 0, none, none, none, none, none);
    // Weight 7 written the old way, a width class of 0; then no OS/2 at all.
    is_face(ix, "TestOdd.ttf", 0, "Caustic Test Odd", "Caustic Test Odd", "Bold", 700.0, 700.0, 100.0, 100.0, N, 0, 0, 3, none, none, none, none);
    is_face(ix, "TestWild.ttf", 0, "Caustic Test Wild", "Caustic Test Wild", "Italic", 1.0, 1000.0, 25.0, 1000.0, N | I | O, face.VARIABLE, 0, none, none, none, 256, 767);
    is_face(ix, "TestShort.ttf", 0, "Caustic Test Short", "Caustic Test Short", "Bold Italic", 700.0, 700.0, 100.0, 100.0, N | I | O, face.VARIABLE, 0, none, none, none, none, none);
    current = "runs";
    check("pages in a row are one run", index.desc(ix, face_of(ix, "TestSans-Bold.TTF", 0)).runs == 2
          && index.desc(ix, face_of(ix, "TestWild.ttf", 0)).runs == 2 && index.desc(ix, face_of(ix, "TestCJK.ttc", 0)).runs == 7);
    is_face(ix, "TestWeights-460.ttf", 0, "Caustic Test Weights", "Caustic Test Weights", "W460", 460.0, 460.0, 100.0, 100.0, N, 0, 4, none, none, none, none, none);
    is_face(ix, "TestNameless.ttf", 0, "", "", "", 400.0, 400.0, 100.0, 100.0, N, 0, 0, none, none, none, none, none);
    is_face(ix, "TestPlain.ttf", 0, "Caustic Test Plain", "Caustic Test Plain", "Bold Italic", 700.0, 700.0, 100.0, 100.0, I, 0, 0, 3, none, none, none, none);
    current = "the tree";
    check("30 faces", index.face_count(ix) == 30);
    check("31 files", index.file_count(ix) == 31);
    check("the second of a collection", face_of(ix, "TestCJK.ttc", 1) == face_of(ix, "TestCJK.ttc", 0) + 1);
    // What does not open is a file of no faces.
    let is i64 as i with mut = 0;
    let is i64 as empty with mut = 0;
    while (i < index.file_count(ix)) {
        let is *index.File as f = index.file(ix, i);
        if (f.faces == 0) {
            check("broken or empty", ends(index.text(ix, f.path), "broken.ttf") == 1 || ends(index.text(ix, f.path), "empty.otf") == 1);
            empty = empty + 1;
        }
        i = i + 1;
    }
    check("two of no faces", empty == 2);
    // The full and PostScript names.
    i = face_of(ix, "TestSans-BoldItalic.ttf", 0);
    check("full name", eq(index.text(ix, index.desc(ix, i).full), "Caustic Test Sans Bold Italic"));
    check("PostScript name", eq(index.text(ix, index.desc(ix, i).postscript), "CausticTestSans-BoldItalic"));
    // Coverage by character.
    i = face_of(ix, "TestEmoji.ttf", 0);
    check("covers U+1F600's page", index.covers(ix, i, 128512) == 1 && index.covers(ix, i, 128767) == 1);
    check("not U+1F700's", index.covers(ix, i, 128768) == 0 && index.covers(ix, i, 0 - 1) == 0
          && index.covers(ix, i, 1114112) == 0);
}

// --- Families ---

fn families(ix as *index.Index) as void {
    current = "families";
    let is index.Run as r with mut = index.family(ix, "Caustic Test Sans");
    check("ten faces of a family", r.n == 10);
    let is i64 as k with mut = 0;
    let is i32 as all with mut = 1;
    while (k < r.n) {
        let is i64 as i = *cast(*i64, cast(i64, r.faces) + k * 8);
        if (eq(index.family_of(ix, i), SANS) == 0) { all = 0; }
        if (k > 0 && i <= *cast(*i64, cast(i64, r.faces) + k * 8 - 8)) { all = 0; }
        k = k + 1;
    }
    check("all of it, in the index's order", all);
    r = index.family(ix, "cAUSTIC tEST sANS");
    check("whatever the case", r.n == 10);
    r = index.family(ix, "Caustic Test Sans Light");
    check("a legacy family: its face", r.n == 1 && *r.faces == face_of(ix, "TestSans-Light.otf", 0));
    r = index.family(ix, "Caustic Test Sans Greek");
    check("a family that begins with another's name", r.n == 2);
    r = index.family(ix, "Caustic Test San");
    check("not a prefix", r.n == 0);
    r = index.family(ix, "Caustic Test Sans ");
    check("not with a space more", r.n == 0);
    r = index.family(ix, "");
    check("no name: not the nameless face", r.n == 0);
    // Letters compared without case, and only letters.
    check("compared", index.compare("Z", "z") == 0 && index.compare("a", "A") == 0 && index.compare("@", "`") != 0
          && index.compare("[", "{") != 0 && index.compare("a", "b") < 0 && index.compare("b", "a") > 0
          && index.compare("ab", "a") > 0);
    r = index.family(ix, "Caustic Test Var");
    check("one face", r.n == 1);
    // The families in order, each once.
    check("families", index.family_count(ix) == 17);
    check("by name, whatever the case, the nameless first", eq(index.family_name(ix, 0), "")
          && eq(index.family_name(ix, 1), "Caustic Test CJK JP")
          && eq(index.family_name(ix, 9), SANS) && eq(index.family_name(ix, 10), "Caustic Test Sans Cyr")
          && eq(index.family_name(ix, 11), "Caustic Test Sans Cyrillic") && eq(index.family_name(ix, 12), "Caustic Test Sans Greek")
          && eq(index.family_name(ix, 13), "Caustic Test Short") && eq(index.family_name(ix, 14), "Caustic Test Var")
          && eq(index.family_name(ix, 15), "Caustic Test Weights") && eq(index.family_name(ix, 16), "Caustic Test Wild"));
    let is index.Run as cyr = index.family_run(ix, 10);
    check("a family's run", cyr.n == 1 && *cyr.faces == face_of(ix, "TestSansCyr.ttf", 0));
    let is index.Run as last = index.family_run(ix, 16);
    check("the last family's run", last.n == 1 && *last.faces == face_of(ix, "TestWild.ttf", 0));
}

// --- Saved and loaded ---

// Two indexes hold the same files and faces, field by field and name by name.
fn same(a as *index.Index, b as *index.Index) as i32 {
    if (index.file_count(a) != index.file_count(b) || index.face_count(a) != index.face_count(b)) { return 0; }
    let is i64 as i with mut = 0;
    while (i < index.file_count(a)) {
        let is *index.File as x = index.file(a, i);
        let is *index.File as y = index.file(b, i);
        if (x.size != y.size || x.mtime != y.mtime || x.first != y.first || x.faces != y.faces) { return 0; }
        if (eq(index.text(a, x.path), index.text(b, y.path)) == 0) { return 0; }
        i = i + 1;
    }
    i = 0;
    while (i < index.face_count(a)) {
        let is *face.Desc as x = index.desc(a, i);
        let is *face.Desc as y = index.desc(b, i);
        if (x.file != y.file || x.index != y.index || x.weight_lo != y.weight_lo || x.weight_hi != y.weight_hi
            || x.width_lo != y.width_lo || x.width_hi != y.width_hi || x.styles != y.styles || x.flags != y.flags
            || x.runs != y.runs) { return 0; }
        if (eq(index.text(a, x.family), index.text(b, y.family)) == 0 || eq(index.text(a, x.legacy), index.text(b, y.legacy)) == 0
            || eq(index.text(a, x.style), index.text(b, y.style)) == 0 || eq(index.text(a, x.full), index.text(b, y.full)) == 0
            || eq(index.text(a, x.postscript), index.text(b, y.postscript)) == 0) { return 0; }
        let is i64 as p with mut = 0;
        while (p < 4352) {
            if (index.covers_page(a, i, p) != index.covers_page(b, i, p)) { return 0; }
            p = p + 1;
        }
        i = i + 1;
    }
    return 1;
}

let is [512]u8 as tmp with mut;
let is i64 as tmp_n with mut = 0;
let is [1024]u8 as pb with mut;

fn at(rel as *u8) as *u8 {
    mem.memcpy(cast(*u8, &pb), cast(*u8, &tmp), tmp_n);
    pb[tmp_n] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &pb) + tmp_n + 1), rel, len(rel) + 1);
    return cast(*u8, &pb);
}

let is [65536]u8 as fbuf with mut;

// The file at src copied to rel; its length.
fn copy(src as *u8, rel as *u8) as i64 {
    let is i64 as fd = linux.open(src, 0, 0);
    let is i64 as n = linux.read(fd, cast(*u8, &fbuf), 65536);
    linux.close(fd);
    let is i64 as out = linux.open(at(rel), 577, 420);
    linux.write(out, cast(*u8, &fbuf), n);
    linux.close(out);
    return n;
}

fn write_bytes(rel as *u8, p as *u8, n as i64) as void {
    let is i64 as out = linux.open(at(rel), 577, 420);
    linux.write(out, p, n);
    linux.close(out);
}

// The index file's bytes, into fbuf; how many.
fn read_back(rel as *u8) as i64 {
    let is i64 as fd = linux.open(at(rel), 0, 0);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0) {
        r = linux.read(fd, cast(*u8, cast(i64, &fbuf) + n), 65536 - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    return n;
}

fn setup() as void {
    let is *u8 as base = "/tmp/caustic-index-";
    tmp_n = len(base);
    mem.memcpy(cast(*u8, &tmp), base, tmp_n);
    let is i64 as pid with mut = linux.getpid();
    let is [24]u8 as digits;
    let is i64 as k with mut = 0;
    while (pid > 0 || k == 0) {
        digits[k] = cast(u8, 48 + pid % 10);
        pid = pid / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        tmp[tmp_n] = digits[k];
        tmp_n = tmp_n + 1;
    }
    tmp[tmp_n] = cast(u8, 0);
    linux.mkdir(cast(*u8, &tmp), 493);
}

fn teardown() as void {
    linux.unlink(at("a.ttf"));
    linux.unlink(at("b.ttf"));
    linux.unlink(at("c.ttf"));
    linux.unlink(at("many.ttc"));
    linux.unlink(at("cache/one/two/three/four/fonts.index"));
    linux.rmdir(at("cache/one/two/three/four"));
    linux.rmdir(at("cache/one/two/three"));
    linux.rmdir(at("cache/one/two"));
    linux.rmdir(at("cache/one"));
    linux.rmdir(at("cache"));
    linux.unlink(at("fonts.index"));
    linux.rmdir(cast(*u8, &tmp));
}

// The file's modification time, seconds and nanoseconds.
fn mtime_of(rel as *u8, sec as *i64, nsec as *i64) as void {
    let is [144]u8 as st;
    linux.stat(at(rel), cast(*u8, &st));
    *sec = *cast(*i64, cast(i64, &st) + 88);
    *nsec = *cast(*i64, cast(i64, &st) + 96);
}

fn set_mtime(rel as *u8, sec as i64, nsec as i64) as void {
    let is [4]i64 as t;
    t[0] = 0;
    t[1] = 1073741822;   // UTIME_OMIT: the access time as it is
    t[2] = sec;
    t[3] = nsec;
    if (__target_is_aarch64 == 1) { syscall(88, 0 - 100, at(rel), cast(*u8, &t), 0); } else { syscall(280, 0 - 100, at(rel), cast(*u8, &t), 0); }
}

fn indexed(ix as *index.Index) as index.Index {
    let is scan.Scan as s with mut = scan.open();
    scan.walk(&s, cast(*u8, &tmp));
    let is index.Index as n = index.update(ix, &s);
    scan.close(&s);
    return n;
}

// b.ttf's face — Greek — in ix, its coverage read: pages 0 and 3.
fn greek_is(ix as *index.Index, file as i64) as i32 {
    let is i64 as i = face_of(ix, "b.ttf", 0);
    if (i < 0 || index.desc(ix, i).file != file) { return 0; }
    if (ends(index.path_of(ix, i), "b.ttf") == 0 || eq(index.family_of(ix, i), "Caustic Test Greek") == 0) { return 0; }
    if (index.covers_page(ix, i, 0) != 1 || index.covers_page(ix, i, 3) != 1 || index.covers_page(ix, i, 1) != 0) { return 0; }
    return 1;
}

fn kept() as void {
    current = "kept";
    setup();
    copy("text/testdata/fonts/mono/TestMono.ttf", "a.ttf");
    copy("text/testdata/fonts/more/deeper/TestGreek.ttf", "b.ttf");
    let is index.Index as none with mut = index.empty();
    let is index.Index as one with mut = indexed(&none);
    check("both read", one.reads == 2 && index.face_count(&one) == 2);
    check("saved, four directories made", index.save(&one, at("cache/one/two/three/four/fonts.index")) == 1);
    let is index.Index as two with mut = index.empty();
    check("loaded", index.load(at("cache/one/two/three/four/fonts.index"), &two) == 1);
    check("as it was", same(&one, &two));
    index.close(&one);
    let is index.Index as three with mut = indexed(&two);
    check("nothing changed: nothing read", three.reads == 0 && same(&two, &three));
    check("and nothing to save", index.changed(&two, &three) == 0);
    index.close(&three);
    // a.ttf rewritten as another font: read again, and only it; b.ttf
    // taken as it was, its names and coverage where they are now.
    copy("text/testdata/fonts/emoji/TestEmoji.ttf", "a.ttf");
    three = indexed(&two);
    check("a file changed: read again", three.reads == 1 && index.changed(&two, &three) == 1);
    check("as what it is now", eq(index.family_of(&three, face_of(&three, "a.ttf", 0)), "Caustic Test Emoji"));
    check("the other kept", greek_is(&three, 1));
    index.close(&two);
    two = three;
    // The same bytes again: a newer time, read again.
    copy("text/testdata/fonts/emoji/TestEmoji.ttf", "a.ttf");
    three = indexed(&two);
    check("the same size, a newer time", three.reads == 1);
    index.close(&two);
    two = three;
    // Other bytes of another length, the time put back: read again.
    let is i64 as sec with mut = 0;
    let is i64 as nsec with mut = 0;
    mtime_of("a.ttf", &sec, &nsec);
    copy("text/testdata/fonts/mono/TestMono.ttf", "a.ttf");
    set_mtime("a.ttf", sec, nsec);
    three = indexed(&two);
    check("the same time, another size", three.reads == 1 && eq(index.family_of(&three, face_of(&three, "a.ttf", 0)), "Caustic Test Mono"));
    index.close(&two);
    two = three;
    // Only a file new: everything else kept, and changed.
    copy("text/testdata/fonts/var/TestVar.ttf", "c.ttf");
    three = indexed(&two);
    check("only new", three.reads == 1 && three.kept == 2 && index.changed(&two, &three) == 1);
    index.close(&two);
    two = three;
    // The first gone: the others numbered again, nothing read.
    linux.unlink(at("a.ttf"));
    three = indexed(&two);
    check("the first gone", three.reads == 0 && index.file_count(&three) == 2 && greek_is(&three, 0)
          && index.desc(&three, face_of(&three, "c.ttf", 0)).file == 1);
    check("changed", index.changed(&two, &three) == 1);
    index.close(&two);
    // Only gone: nothing read, but changed.
    linux.unlink(at("c.ttf"));
    two = indexed(&three);
    check("only gone: nothing read, still changed", two.reads == 0 && index.file_count(&two) == 1
          && index.changed(&three, &two) == 1);
    index.close(&three);

    // --- Refused ---
    check("saved again", index.save(&two, at("fonts.index")) == 1);
    let is i64 as n = read_back("fonts.index");
    let is index.Index as back with mut = index.empty();
    check("as saved", index.load(at("fonts.index"), &back) == 1 && same(&two, &back));
    index.close(&back);
    // Whatever the index held before, a missing file leaves it empty.
    mem.memset(cast(*u8, &back), 255, sizeof(index.Index));
    check("no such file", index.load(at("nothing.index"), &back) == 0 && index.face_count(&back) == 0
          && index.file_count(&back) == 0);
    // Cut anywhere: refused.
    let is i64 as cut with mut = 0;
    let is i32 as all with mut = 1;
    while (cut < n) {
        write_bytes("fonts.index", cast(*u8, &fbuf), cut);
        if (index.load(at("fonts.index"), &back) != 0 || index.face_count(&back) != 0) { all = 0; }
        cut = cut + 1;
    }
    check("cut anywhere: refused", all);
    // A byte more: refused.
    write_bytes("fonts.index", cast(*u8, &fbuf), n + 1);
    check("a byte more", index.load(at("fonts.index"), &back) == 0);
    // The header's every field wrong, one at a time.
    let is i64 as h with mut = 0;
    all = 1;
    while (h < 8) {
        let is i64 as keep = *cast(*i64, cast(i64, &fbuf) + h * 8);
        *cast(*i64, cast(i64, &fbuf) + h * 8) = keep + 1;
        write_bytes("fonts.index", cast(*u8, &fbuf), n);
        if (h < 7 && index.load(at("fonts.index"), &back) != 0) { all = 0; }
        *cast(*i64, cast(i64, &fbuf) + h * 8) = keep;
        h = h + 1;
    }
    check("its header", all);
    // Counts so large that the records' sizes wrap round to the file's: 2^61
    // records more of 40 or of 120 bytes is a multiple of 2^64 more.
    all = 1;
    h = 4;
    while (h <= 5) {
        let is i64 as keep = *cast(*i64, cast(i64, &fbuf) + h * 8);
        *cast(*i64, cast(i64, &fbuf) + h * 8) = keep + 2305843009213693952;
        write_bytes("fonts.index", cast(*u8, &fbuf), n);
        if (index.load(at("fonts.index"), &back) != 0) { all = 0; }
        *cast(*i64, cast(i64, &fbuf) + h * 8) = keep;
        h = h + 1;
    }
    check("counts that wrap", all);
    index.close(&two);
    teardown();
}

// A collection claiming 300 faces, each the same font: 256 read.
fn many() as void {
    current = "many";
    setup();
    let is i64 as fd = linux.open("text/testdata/fonts/mono/TestMono.ttf", 0, 0);
    let is i64 as base = 1212;
    let is i64 as n = linux.read(fd, cast(*u8, cast(i64, &fbuf) + base), 65536 - base);
    linux.close(fd);
    let is *u8 as b = cast(*u8, &fbuf);
    // 'ttcf', version 1, 300 faces, each at base.
    let is i64 as k with mut = 0;
    let is [12]u8 as head;
    head[0] = cast(u8, 116); head[1] = cast(u8, 116); head[2] = cast(u8, 99); head[3] = cast(u8, 102);
    head[4] = cast(u8, 0); head[5] = cast(u8, 1); head[6] = cast(u8, 0); head[7] = cast(u8, 0);
    head[8] = cast(u8, 0); head[9] = cast(u8, 0); head[10] = cast(u8, 1); head[11] = cast(u8, 44);
    mem.memcpy(b, cast(*u8, &head), 12);
    while (k < 300) {
        let is i64 as at_ = cast(i64, b) + 12 + k * 4;
        *cast(*u8, at_) = cast(u8, 0);
        *cast(*u8, at_ + 1) = cast(u8, 0);
        *cast(*u8, at_ + 2) = cast(u8, base >> 8);
        *cast(*u8, at_ + 3) = cast(u8, base & 255);
        k = k + 1;
    }
    // The font's tables, at offsets from the start of the collection now.
    let is i64 as tables = (cast(i64, *cast(*u8, cast(i64, b) + base + 4)) << 8) | cast(i64, *cast(*u8, cast(i64, b) + base + 5));
    k = 0;
    while (k < tables) {
        let is i64 as at_ = cast(i64, b) + base + 12 + k * 16 + 8;
        let is i64 as off = (cast(i64, *cast(*u8, at_)) << 24) | (cast(i64, *cast(*u8, at_ + 1)) << 16)
                            | (cast(i64, *cast(*u8, at_ + 2)) << 8) | cast(i64, *cast(*u8, at_ + 3));
        let is i64 as moved = off + base;
        *cast(*u8, at_) = cast(u8, moved >> 24);
        *cast(*u8, at_ + 1) = cast(u8, (moved >> 16) & 255);
        *cast(*u8, at_ + 2) = cast(u8, (moved >> 8) & 255);
        *cast(*u8, at_ + 3) = cast(u8, moved & 255);
        k = k + 1;
    }
    write_bytes("many.ttc", b, base + n);
    let is index.Index as none with mut = index.empty();
    let is index.Index as ix with mut = indexed(&none);
    check("256 of 300", index.face_count(&ix) == 256 && index.file(&ix, 0).faces == 256
          && index.desc(&ix, 255).index == 255 && eq(index.family_of(&ix, 255), "Caustic Test Mono"));
    index.close(&ix);
    teardown();
}

// An index of one file and no faces, its text all zeros: whatever lies past
// its records reads as files of no faces, so a count of files wrapped round
// to the file's length would walk off its end if it were not refused.
fn wrapped() as void {
    current = "wrapped";
    setup();
    write_bytes("a.ttf", "not a font", 10);
    let is index.Index as none with mut = index.empty();
    let is index.Index as one with mut = indexed(&none);
    check("a file of no faces", index.file_count(&one) == 1 && index.face_count(&one) == 0);
    index.save(&one, at("fonts.index"));
    let is i64 as n = read_back("fonts.index");
    let is i64 as text = 64 + sizeof(index.File);
    mem.memzero(cast(*u8, cast(i64, &fbuf) + text), n - text);
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    let is index.Index as back with mut = index.empty();
    check("its text zeroed: still an index", index.load(at("fonts.index"), &back) == 1);
    index.close(&back);
    *cast(*i64, cast(i64, &fbuf) + 32) = 1 + 2305843009213693952;
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("files wrapped round: refused", index.load(at("fonts.index"), &back) == 0);
    index.close(&one);
    teardown();
}

// Records pointing past what was saved: refused, field by field.
fn forged() as void {
    current = "forged";
    setup();
    copy("text/testdata/fonts/mono/TestMono.ttf", "a.ttf");
    copy("text/testdata/fonts/more/deeper/TestGreek.ttf", "b.ttf");
    let is index.Index as none with mut = index.empty();
    let is index.Index as one with mut = indexed(&none);
    index.save(&one, at("fonts.index"));
    let is i64 as n = read_back("fonts.index");
    let is i64 as files = 64;
    let is i64 as faces = files + 2 * sizeof(index.File);
    let is index.Index as back with mut = index.empty();
    let is i32 as all with mut = 1;
    // Each of the first file's fields set past the text or the records,
    // then negative: path, first and faces; size and mtime may be anything.
    let is i64 as f with mut = 0;
    while (f < sizeof(index.File) / 8) {
        let is i64 as at_ = files + f * 8;
        let is i64 as keep = *cast(*i64, cast(i64, &fbuf) + at_);
        if (f != 1 && f != 2) {
            *cast(*i64, cast(i64, &fbuf) + at_) = 1000000;
            write_bytes("fonts.index", cast(*u8, &fbuf), n);
            if (index.load(at("fonts.index"), &back) != 0) {
                io.printf("  file field %d past the end\n", f);
                all = 0;
            }
            *cast(*i64, cast(i64, &fbuf) + at_) = 0 - 1;
            write_bytes("fonts.index", cast(*u8, &fbuf), n);
            if (index.load(at("fonts.index"), &back) != 0) {
                io.printf("  file field %d negative\n", f);
                all = 0;
            }
        }
        *cast(*i64, cast(i64, &fbuf) + at_) = keep;
        f = f + 1;
    }
    check("the file's", all);
    all = 1;
    // The first face's file, index, five names, pages and runs.
    f = 0;
    while (f < sizeof(face.Desc) / 8) {
        let is i64 as at_ = faces + f * 8;
        let is i64 as keep = *cast(*i64, cast(i64, &fbuf) + at_);
        if (f <= 6 || f >= 13) {
            *cast(*i64, cast(i64, &fbuf) + at_) = 1000000;
            write_bytes("fonts.index", cast(*u8, &fbuf), n);
            if (index.load(at("fonts.index"), &back) != 0) {
                io.printf("  face field %d past the end\n", f);
                all = 0;
            }
            *cast(*i64, cast(i64, &fbuf) + at_) = 0 - 1;
            write_bytes("fonts.index", cast(*u8, &fbuf), n);
            if (index.load(at("fonts.index"), &back) != 0) {
                io.printf("  face field %d negative\n", f);
                all = 0;
            }
        }
        *cast(*i64, cast(i64, &fbuf) + at_) = keep;
        f = f + 1;
    }
    check("the face's", all);
    // Ranges that are not: not numbers, backwards, below what they can be.
    all = 1;
    f = 7;
    while (f <= 10) {
        let is i64 as at_ = faces + f * 8;
        let is i64 as keep = *cast(*i64, cast(i64, &fbuf) + at_);
        let is f64 as nan = 0.0 / 0.0;
        *cast(*f64, cast(i64, &fbuf) + at_) = nan;
        write_bytes("fonts.index", cast(*u8, &fbuf), n);
        if (index.load(at("fonts.index"), &back) != 0) {
            io.printf("  field %d not a number\n", f);
            all = 0;
        }
        *cast(*i64, cast(i64, &fbuf) + at_) = keep;
        f = f + 1;
    }
    check("not numbers", all);
    *cast(*f64, cast(i64, &fbuf) + faces + 7 * 8) = 900.0;
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("backwards", index.load(at("fonts.index"), &back) == 0);
    *cast(*f64, cast(i64, &fbuf) + faces + 7 * 8) = 0.5;
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("a weight below 1", index.load(at("fonts.index"), &back) == 0);
    *cast(*f64, cast(i64, &fbuf) + faces + 7 * 8) = 400.0;
    *cast(*f64, cast(i64, &fbuf) + faces + 9 * 8) = 0.0 - 1.0;
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("a width below 0", index.load(at("fonts.index"), &back) == 0);
    *cast(*f64, cast(i64, &fbuf) + faces + 9 * 8) = 100.0;
    // Runs so many that four bytes each wraps round to a few.
    let is i64 as runs = *cast(*i64, cast(i64, &fbuf) + faces + 14 * 8);
    *cast(*i64, cast(i64, &fbuf) + faces + 14 * 8) = runs + 4611686018427387904;
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("runs that wrap", index.load(at("fonts.index"), &back) == 0);
    *cast(*i64, cast(i64, &fbuf) + faces + 14 * 8) = runs;
    // The text not ending in NUL.
    *cast(*u8, cast(i64, &fbuf) + n - 1) = cast(u8, 65);
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("text unended", index.load(at("fonts.index"), &back) == 0);
    *cast(*u8, cast(i64, &fbuf) + n - 1) = cast(u8, 0);
    // A face no file lists; the last file listing one more than there is;
    // a face listed by one file and saying it is the other's.
    *cast(*i64, cast(i64, &fbuf) + files + 4 * 8) = 0;
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("a face no file lists", index.load(at("fonts.index"), &back) == 0);
    *cast(*i64, cast(i64, &fbuf) + files + 4 * 8) = 1;
    *cast(*i64, cast(i64, &fbuf) + files + sizeof(index.File) + 4 * 8) = 2;
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("faces that are not there", index.load(at("fonts.index"), &back) == 0);
    *cast(*i64, cast(i64, &fbuf) + files + sizeof(index.File) + 4 * 8) = 1;
    *cast(*i64, cast(i64, &fbuf) + faces) = 1;
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("a face of the other file", index.load(at("fonts.index"), &back) == 0);
    *cast(*i64, cast(i64, &fbuf) + faces) = 0;
    write_bytes("fonts.index", cast(*u8, &fbuf), n);
    check("put back: read", index.load(at("fonts.index"), &back) == 1 && same(&one, &back));
    index.close(&back);
    index.close(&one);
    teardown();
}

// CSS's weight and width from OS/2's classes, every one and past them.
fn classes() as void {
    current = "classes";
    check("weight 0 is regular", face.css_weight(0) == 400.0 && face.css_weight(0 - 5) == 400.0);
    check("weights 1 to 9 in hundreds", face.css_weight(1) == 100.0 && face.css_weight(9) == 900.0);
    check("from 10 as written", face.css_weight(10) == 10.0 && face.css_weight(1000) == 1000.0);
    check("past 1000, 1000", face.css_weight(1001) == 1000.0 && face.css_weight(65535) == 1000.0);
    check("widths", face.css_width(1) == 50.0 && face.css_width(2) == 62.5 && face.css_width(3) == 75.0
          && face.css_width(4) == 87.5 && face.css_width(5) == 100.0 && face.css_width(6) == 112.5
          && face.css_width(7) == 125.0 && face.css_width(8) == 150.0 && face.css_width(9) == 200.0);
    check("other widths normal", face.css_width(0) == 100.0 && face.css_width(10) == 100.0 && face.css_width(0 - 1) == 100.0);
}

fn main() as i32 {
    current = "";
    classes();
    let is scan.Scan as s with mut = scan.open();
    scan.walk(&s, "text/testdata/fonts");
    let is index.Index as none with mut = index.empty();
    let is index.Index as ix with mut = index.update(&none, &s);
    check("every file read", ix.reads == 31);
    described(&ix);
    families(&ix);
    // Made again from itself: nothing read, all the same.
    let is index.Index as again with mut = index.update(&ix, &s);
    current = "again";
    check("nothing read", again.reads == 0 && same(&ix, &again) && index.changed(&ix, &again) == 0);
    index.close(&again);
    index.close(&ix);
    scan.close(&s);
    kept();
    many();
    wrapped();
    forged();

    if (fails > 0) {
        io.printf("font index: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("font index: all checks passed\n");
    return 0;
}
