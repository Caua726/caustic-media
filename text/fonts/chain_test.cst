// text/fonts/chain_test.cst — the faces a text is drawn with, over the test
// fonts: the families asked for, generic names, the last resort; a
// character each face lacks found in the family's other weights, in the
// family's own companion before any other, in the preferred CJK and emoji
// families by language, or nowhere; what was learned not asked again; the
// instance each face is drawn at.
//
// Built by caustic-mk (target font_chain_test), for caustic-unicode's
// tables. Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../sfnt/sfnt.cst" as sfnt;
use "scan.cst" as scan;
use "face.cst" as face;
use "index.cst" as index;
use "chain.cst" as chain;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return n;
}

fn ends(a as *u8, b as *u8) as i32 {
    let is i64 as na = len(a);
    let is i64 as nb = len(b);
    if (na < nb || mem.memcmp(cast(*u8, cast(i64, a) + na - nb), b, nb) != 0) { return 0; }
    return 1;
}

let is index.Index as ix with mut;

fn face_of(tail as *u8, k as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < index.face_count(&ix)) {
        if (index.desc(&ix, i).index == k && ends(index.path_of(&ix, i), tail) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// cp is drawn by member m, whose face is face k of the file ending in tail
// and which has a glyph for it.
fn drawn(c as *chain.Chain, cp as i64, tail as *u8, k as i64) as i32 {
    let is i64 as m = chain.find(c, cp);
    if (m < 0) {
        io.printf("  U+%x: no member\n", cp);
        return 0;
    }
    let is *chain.Member as mb = chain.member(c, m);
    if (mb.face != face_of(tail, k)) {
        io.printf("  U+%x: member %d, %s face %d\n", cp, m, index.path_of(&ix, mb.face), index.desc(&ix, mb.face).index);
        return 0;
    }
    if (sfnt.cmap.glyph(chain.face(c, m), cp) == 0) {
        io.printf("  U+%x: member %d has no glyph\n", cp, m);
        return 0;
    }
    return 1;
}

// No face has cp: the first member, to draw its missing glyph.
fn nowhere(c as *chain.Chain, cp as i64) as i32 {
    let is i64 as m = chain.find(c, cp);
    if (m != 0 || sfnt.cmap.glyph(chain.face(c, 0), cp) != 0) {
        io.printf("  U+%x: member %d\n", cp, m);
        return 0;
    }
    return 1;
}

fn prefs() as chain.Prefs {
    let is chain.Prefs as p with mut = chain.defaults();
    p.sans = "Caustic Test Sans";
    p.serif = "Caustic Test Nothing, Caustic Test Greek";
    p.mono = "Caustic Test Mono";
    p.ui = "Caustic Test Var";
    p.emoji = "Caustic Test Emoji";
    p.cjk[chain.SC] = "Caustic Test CJK SC";
    p.cjk[chain.TC] = "";
    p.cjk[chain.JP] = "Caustic Test Nothing, Caustic Test CJK JP";
    p.cjk[chain.KR] = "";
    p.lang = chain.SC;
    return p;
}

let is *u8 as SANS with imut = "Caustic Test Sans";

fn leads() as void {
    let is chain.Prefs as p with mut = prefs();
    let is chain.Chain as c with mut;
    check("opens", chain.open(&c, &ix, SANS, 400.0, 100.0, face.NORMAL, &p) == 1);
    check("one face asked for", chain.count(&c) == 1 && c.lead == 1);
    check("the regular", drawn(&c, 65, "TestSans-Regular.ttf", 0) && drawn(&c, 233, "TestSans-Regular.ttf", 0));
    check("as matched", chain.member(&c, 0).weight == 400.0 && chain.member(&c, 0).style == face.NORMAL);
    check("no face before the first member or past the last",
          cast(i64, chain.face(&c, 0 - 1)) == 0 && cast(i64, chain.face(&c, chain.count(&c))) == 0);
    chain.close(&c);
    // A list: the first that exists leads, each in turn behind it.
    chain.open(&c, &ix, "Caustic Test Nothing, 'Caustic Test Mono' , \"sans-serif\"", 400.0, 100.0, face.NORMAL, &p);
    check("a list, the missing passed over", chain.count(&c) == 2 && c.lead == 2);
    check("monospace first", drawn(&c, 65, "TestMono.ttf", 0));
    check("then the generic sans-serif, for what it lacks", drawn(&c, 233, "TestSans-Regular.ttf", 0));
    chain.close(&c);
    // Generic names, each through its list.
    chain.open(&c, &ix, "monospace", 400.0, 100.0, face.NORMAL, &p);
    check("monospace", drawn(&c, 65, "TestMono.ttf", 0) && c.lead == 1);
    chain.close(&c);
    chain.open(&c, &ix, "serif", 400.0, 100.0, face.NORMAL, &p);
    check("serif: the first of its list that exists", c.lead == 1 && chain.member(&c, 0).face == face_of("TestGreek.ttf", 0));
    chain.close(&c);
    chain.open(&c, &ix, "SYSTEM-UI", 400.0, 100.0, face.NORMAL, &p);
    check("system-ui, whatever the case", c.lead == 1 && chain.member(&c, 0).face == face_of("TestVar.ttf", 0));
    chain.close(&c);
    chain.open(&c, &ix, "emoji", 400.0, 100.0, face.NORMAL, &p);
    check("emoji", c.lead == 1 && chain.member(&c, 0).face == face_of("TestEmoji.ttf", 0));
    chain.close(&c);
    chain.open(&c, &ix, "ui-sans-serif, Caustic Test Mono", 400.0, 100.0, face.NORMAL, &p);
    check("ui-sans-serif", c.lead == 2 && chain.member(&c, 0).face == face_of("TestSans-Regular.ttf", 0));
    chain.close(&c);
    chain.open(&c, &ix, "ui-serif", 400.0, 100.0, face.NORMAL, &p);
    check("ui-serif", c.lead == 1 && chain.member(&c, 0).face == face_of("TestGreek.ttf", 0));
    chain.close(&c);
    chain.open(&c, &ix, "ui-monospace", 400.0, 100.0, face.NORMAL, &p);
    check("ui-monospace", c.lead == 1 && chain.member(&c, 0).face == face_of("TestMono.ttf", 0));
    chain.close(&c);
    // system-ui with nothing set: sans-serif's, in its place in the list.
    p.ui = "";
    chain.open(&c, &ix, "system-ui, Caustic Test Mono", 400.0, 100.0, face.NORMAL, &p);
    check("system-ui unset: sans-serif's", c.lead == 2 && chain.member(&c, 0).face == face_of("TestSans-Regular.ttf", 0)
          && chain.member(&c, 1).face == face_of("TestMono.ttf", 0));
    chain.close(&c);
    p.ui = "Caustic Test Var";
    // A generic name in a list of preferences is a name like any other.
    p.sans = "serif, Caustic Test Sans";
    chain.open(&c, &ix, "sans-serif", 400.0, 100.0, face.NORMAL, &p);
    check("a generic name among preferences: not followed", c.lead == 1 && chain.member(&c, 0).face == face_of("TestSans-Regular.ttf", 0));
    chain.close(&c);
    p.sans = "sans-serif";
    chain.open(&c, &ix, "sans-serif", 400.0, 100.0, face.NORMAL, &p);
    check("nor followed into itself", c.lead == 1 && chain.member(&c, 0).face == face_of("TestCJK.ttc", 0));
    chain.close(&c);
    p.sans = "Caustic Test Sans";
    // Named twice: one face.
    chain.open(&c, &ix, "Caustic Test Mono, caustic test mono", 400.0, 100.0, face.NORMAL, &p);
    check("named twice: once", chain.count(&c) == 1);
    chain.close(&c);
    // A name longer than any family's: cut, found nowhere, passed over.
    let is [400]u8 as long;
    let is i64 as i with mut = 0;
    while (i < 300) {
        long[i] = cast(u8, 120);
        i = i + 1;
    }
    mem.memcpy(cast(*u8, cast(i64, &long) + 300), ", Caustic Test Mono", 20);
    chain.open(&c, &ix, cast(*u8, &long), 400.0, 100.0, face.NORMAL, &p);
    check("a name too long, passed over", c.lead == 1 && chain.member(&c, 0).face == face_of("TestMono.ttf", 0));
    chain.close(&c);
    // Nothing asked for exists: sans-serif's list; and without it, the
    // first family by name that reaches the first page and is not colour.
    chain.open(&c, &ix, "Caustic Test Nothing", 400.0, 100.0, face.NORMAL, &p);
    check("nothing: sans-serif", c.lead == 1 && chain.member(&c, 0).face == face_of("TestSans-Regular.ttf", 0));
    chain.close(&c);
    p.sans = "Caustic Test Nothing Either";
    chain.open(&c, &ix, "", 400.0, 100.0, face.NORMAL, &p);
    check("nothing at all: the last resort", c.lead == 1 && chain.member(&c, 0).face == face_of("TestCJK.ttc", 0));
    chain.close(&c);
    // An empty index: nothing to draw with.
    let is index.Index as empty with mut = index.empty();
    check("an empty index: refused", chain.open(&c, &empty, SANS, 400.0, 100.0, face.NORMAL, &p) == 0
          && chain.count(&c) == 0 && chain.find(&c, 65) == 0 - 1);
    chain.close(&c);
}

fn fallbacks() as void {
    let is chain.Prefs as p with mut = prefs();
    let is chain.Chain as c with mut;
    chain.open(&c, &ix, SANS, 400.0, 100.0, face.NORMAL, &p);
    // The family's bold has U+014B; nothing else does.
    check("in the family's other weight", drawn(&c, 331, "TestSans-Bold.TTF", 0));
    check("drawn at its own weight", chain.member(&c, 1).weight == 700.0);
    // Greek: the family's own companion, before a family earlier by name.
    check("Greek from the companion", drawn(&c, 945, "TestSansGreek-Regular.ttf", 0));
    // Han, kana and Hangul: the preferred CJK family, by language.
    check("Han", drawn(&c, 19968, "TestCJK.ttc", 1));
    check("kana", drawn(&c, 12363, "TestCJK.ttc", 1));
    check("Hangul", drawn(&c, 44032, "TestCJK.ttc", 1));
    // Emoji: the emoji family's, though others reach the page.
    check("an emoji", drawn(&c, 128512, "TestEmoji.ttf", 0));
    check("a pictograph", drawn(&c, 9786, "TestEmoji.ttf", 0));
    check("what the face has, the face draws", drawn(&c, 35, "TestSans-Regular.ttf", 0));
    let is i64 as n = chain.count(&c);
    // In no face: Thai, and a letter on the page every face reaches.
    check("Thai: nowhere", nowhere(&c, 3585));
    check("è: nowhere", nowhere(&c, 232));
    check("faces tried and found wanting are not kept", chain.count(&c) == n && c.mapped == n);
    // What was learned is not asked again: ç is on è's page, and no face
    // has it either; nothing is opened to find that out.
    let is i64 as opened = c.opens;
    check("ç: nowhere", nowhere(&c, 231));
    check("without opening a face", c.opens == opened);
    check("asked again: the same", nowhere(&c, 3585) && drawn(&c, 945, "TestSansGreek-Regular.ttf", 0) && c.opens == opened);
    check("out of Unicode: nowhere", nowhere(&c, 1114112) && nowhere(&c, 0 - 1));
    // Of two companions with Cyrillic, the one at the width asked for,
    // though the other is first by name.
    check("Cyrillic of normal width", drawn(&c, 1072, "TestSansCyrillic.ttf", 0));
    // The family's own other face before its companions: д is in the bold
    // and in both Cyrillic companions.
    check("the family's own first", drawn(&c, 1076, "TestSans-Bold.TTF", 0));
    // Bopomofo, and a fullwidth letter: the CJK families'.
    check("Bopomofo", drawn(&c, 12549, "TestCJK.ttc", 1));
    check("fullwidth", drawn(&c, 65313, "TestCJK.ttc", 1));
    // And the CJK letters that are not wide.
    check("halfwidth katakana", drawn(&c, 65382, "TestCJK.ttc", 1));
    check("a Hangul jamo", drawn(&c, 4448, "TestCJK.ttc", 1));
    check("a Bopomofo tone mark", drawn(&c, 746, "TestCJK.ttc", 1));
    chain.close(&c);
    check("closed: nothing mapped", c.mapped == 0);
    chain.open(&c, &ix, SANS, 400.0, 75.0, face.NORMAL, &p);
    check("condensed: the condensed one", drawn(&c, 1072, "TestSansCyr.ttf", 0));
    chain.close(&c);
    chain.open(&c, &ix, "Caustic Test Mono", 400.0, 100.0, face.NORMAL, &p);
    check("no companion: the width asked for, before the order of names", drawn(&c, 1072, "TestSansCyrillic.ttf", 0));
    // A page learned of a face that lacks one letter is asked of it again
    // for a letter it has.
    check("è: nowhere", nowhere(&c, 232));
    check("é, from a face learned", drawn(&c, 233, "TestSans-Regular.ttf", 0));
    // Not colour before colour: α is in the colour face too, first by name.
    check("α, not in colour", drawn(&c, 945, "TestGreek.ttf", 0));
    chain.close(&c);
    // Italic: the face that can be, before one first by name that cannot.
    chain.open(&c, &ix, "Caustic Test Mono", 400.0, 100.0, face.ITALIC, &p);
    check("Ω in italic", drawn(&c, 937, "TestPlain.ttf", 0));
    chain.close(&c);
    // A fresh chain opens nothing for a page its face does not reach, and
    // an emoji or a flag goes to the emoji family before any other face on
    // its page — the wild one reaches both pages.
    chain.open(&c, &ix, SANS, 400.0, 100.0, face.NORMAL, &p);
    check("ŋ: one face opened", drawn(&c, 331, "TestSans-Bold.TTF", 0) && c.opens == 1);
    chain.close(&c);
    chain.open(&c, &ix, SANS, 400.0, 100.0, face.NORMAL, &p);
    check("an emoji: one face opened", drawn(&c, 128512, "TestEmoji.ttf", 0) && c.opens == 1);
    check("a flag: none more", drawn(&c, 127462, "TestEmoji.ttf", 0) && c.opens == 1);
    chain.close(&c);

    // Bold: the companion's bold.
    chain.open(&c, &ix, SANS, 700.0, 100.0, face.NORMAL, &p);
    check("bold Greek", drawn(&c, 945, "TestSansGreek-Bold.ttf", 0));
    chain.close(&c);
    // No companion: the families in order of their names.
    chain.open(&c, &ix, "Caustic Test Mono", 400.0, 100.0, face.NORMAL, &p);
    check("Greek, first by name", drawn(&c, 945, "TestGreek.ttf", 0));
    chain.close(&c);
    // Other languages, other CJK families first.
    p.lang = chain.JP;
    chain.open(&c, &ix, SANS, 400.0, 100.0, face.NORMAL, &p);
    check("Japanese: Han from the JP face, past a name not there", drawn(&c, 19968, "TestCJK.ttc", 0));
    chain.close(&c);
    p.lang = chain.TC;
    chain.open(&c, &ix, SANS, 400.0, 100.0, face.NORMAL, &p);
    check("Traditional, none listed: Simplified's next", drawn(&c, 19968, "TestCJK.ttc", 1));
    chain.close(&c);
    // No preferences at all: any face that has it.
    p.cjk[chain.SC] = "";
    p.cjk[chain.JP] = "";
    p.emoji = "";
    chain.open(&c, &ix, SANS, 400.0, 100.0, face.NORMAL, &p);
    check("Han from whichever has it, first by name", drawn(&c, 19968, "TestCJK.ttc", 0));
    check("an emoji from the colour face, the only one", drawn(&c, 128512, "TestEmoji.ttf", 0));
    chain.close(&c);
}

fn instances() as void {
    let is chain.Prefs as p with mut = prefs();
    let is chain.Chain as c with mut;
    let is sfnt.var.Design as d;
    // The variable face oblique: slanted as far as it goes toward 14 degrees.
    chain.open(&c, &ix, "Caustic Test Var", 400.0, 100.0, face.ITALIC, &p);
    check("drawn oblique", chain.member(&c, 0).style == face.OBLIQUE);
    chain.design(&c, 0, 16.0, &d);
    check("wght 400, wdth 100, slnt -12, opsz 16", d.n == 4 && d.v[0] == 400.0 && d.v[1] == 100.0 && d.v[2] == 0.0 - 12.0
          && d.v[3] == 16.0);
    chain.close(&c);
    chain.open(&c, &ix, "Caustic Test Var", 700.0, 87.5, face.NORMAL, &p);
    chain.design(&c, 0, 9.0, &d);
    check("wght 700, wdth 87.5, upright, opsz 9", d.v[0] == 700.0 && d.v[1] == 87.5 && d.v[2] == 0.0 && d.v[3] == 9.0);
    chain.close(&c);
    // Both an italic and a slant axis, drawn oblique: upright on the one.
    chain.open(&c, &ix, "Caustic Test Wild", 400.0, 100.0, face.OBLIQUE, &p);
    chain.design(&c, 0, 16.0, &d);
    check("oblique on slnt, not on ital", chain.member(&c, 0).style == face.OBLIQUE && d.v[2] == 0.0 && d.v[3] == 0.0 - 14.0);
    chain.close(&c);
    chain.open(&c, &ix, "Caustic Test Ital", 400.0, 100.0, face.ITALIC, &p);
    chain.design(&c, 0, 16.0, &d);
    check("italic on its axis", d.n == 1 && d.v[0] == 1.0 && chain.member(&c, 0).style == face.ITALIC);
    chain.close(&c);
    chain.open(&c, &ix, "Caustic Test Ital", 400.0, 100.0, face.NORMAL, &p);
    chain.design(&c, 0, 16.0, &d);
    check("upright on it", d.v[0] == 0.0);
    chain.close(&c);
    // A static face: no axes.
    chain.open(&c, &ix, SANS, 400.0, 100.0, face.NORMAL, &p);
    chain.design(&c, 0, 16.0, &d);
    check("static: none", d.n == 0);
    chain.close(&c);
}

fn languages() as void {
    check("zh-TW", chain.lang_of("zh-TW") == chain.TC);
    check("zh_HK.UTF-8", chain.lang_of("zh_HK.UTF-8") == chain.TC);
    check("zh-Hant", chain.lang_of("zh-Hant") == chain.TC && chain.lang_of("zh-Hant-CN") == chain.TC);
    check("zh-MO", chain.lang_of("zh_MO") == chain.TC);
    check("zh-CN", chain.lang_of("zh-CN") == chain.SC && chain.lang_of("zh") == chain.SC
          && chain.lang_of("zh_SG.UTF-8") == chain.SC && chain.lang_of("zh-Hans-HK") == chain.SC);
    check("ja", chain.lang_of("ja_JP.UTF-8") == chain.JP && chain.lang_of("ja") == chain.JP);
    check("ko", chain.lang_of("ko-KR") == chain.KR);
    check("without case", chain.lang_of("ZH-TW") == chain.TC && chain.lang_of("JA") == chain.JP);
    check("a modifier after @", chain.lang_of("zh_TW@radical") == chain.TC);
    check("others", chain.lang_of("pt_BR.UTF-8") == chain.SC && chain.lang_of("") == chain.SC
          && chain.lang_of(cast(*u8, 0)) == chain.SC && chain.lang_of("jav") == chain.SC && chain.lang_of("zhx") == chain.SC);
}

let is [65536]u8 as fbuf with mut;

// The file at src into fbuf; its length.
fn slurp(src as *u8) as i64 {
    let is i64 as fd = linux.open(src, 0, 0);
    let is i64 as n = linux.read(fd, cast(*u8, &fbuf), 65536);
    linux.close(fd);
    return n;
}

fn spill(path as *u8, p as *u8, n as i64) as void {
    let is i64 as fd = linux.open(path, 577, 420);
    linux.write(fd, p, n);
    linux.close(fd);
}

fn indexed(dir as *u8) as index.Index {
    let is scan.Scan as s with mut = scan.open();
    scan.walk(&s, dir);
    let is index.Index as none with mut = index.empty();
    let is index.Index as n = index.update(&none, &s);
    scan.close(&s);
    return n;
}

// /tmp/<base>-<pid> into out: a directory no other run of this test shares.
fn own_dir(base as *u8, out as *u8) as *u8 {
    let is i64 as n with mut = len(base);
    mem.memcpy(out, base, n);
    out[n] = cast(u8, 45);
    n = n + 1;
    let is i64 as pid with mut = linux.getpid();
    let is [24]u8 as digits;
    let is i64 as k with mut = 0;
    while (pid > 0 || k == 0) {
        digits[k] = cast(u8, 48 + pid % 10);
        pid = pid / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        out[n] = digits[k];
        n = n + 1;
    }
    out[n] = cast(u8, 0);
    return out;
}

// A face whose file is gone by the time it is opened, or is a directory, or
// is no font: nothing to draw with.
fn gone() as void {
    let is [96]u8 as dir_buf;
    let is *u8 as dir = own_dir("/tmp/caustic-chain-gone", &dir_buf[0]);
    let is [128]u8 as path_buf;
    let is i64 as dn = len(dir);
    mem.memcpy(&path_buf[0], dir, dn);
    mem.memcpy(cast(*u8, cast(i64, &path_buf[0]) + dn), "/mono.ttf", 10);
    let is *u8 as path = &path_buf[0];
    linux.mkdir(dir, 493);
    spill(path, cast(*u8, &fbuf), slurp("text/testdata/fonts/mono/TestMono.ttf"));
    let is index.Index as small with mut = indexed(dir);
    let is chain.Prefs as p with mut = prefs();
    let is chain.Chain as c with mut;
    linux.unlink(path);
    check("matched, then not there", chain.open(&c, &small, "Caustic Test Mono", 400.0, 100.0, face.NORMAL, &p) == 1);
    check("nothing to draw with", chain.find(&c, 65) == 0 - 1 && chain.find(&c, 66) == 0 - 1);
    chain.close(&c);
    linux.mkdir(path, 493);
    chain.open(&c, &small, "Caustic Test Mono", 400.0, 100.0, face.NORMAL, &p);
    check("a directory now", chain.find(&c, 65) == 0 - 1 && c.mapped == 0);
    chain.close(&c);
    linux.rmdir(path);
    spill(path, "not a font at all, though long enough to map", 44);
    chain.open(&c, &small, "Caustic Test Mono", 400.0, 100.0, face.NORMAL, &p);
    check("no font now", chain.find(&c, 65) == 0 - 1 && c.mapped == 0);
    chain.close(&c);
    linux.unlink(path);
    linux.rmdir(dir);
    index.close(&small);
}

let is [96]u8 as crowd_dir with mut;
let is *u8 as CROWD with mut;
let is [256]u8 as cp_path with mut;

fn crowd_path(name as *u8) as *u8 {
    let is i64 as n = len(CROWD);
    mem.memcpy(cast(*u8, &cp_path), CROWD, n);
    cp_path[n] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &cp_path) + n + 1), name, len(name) + 1);
    return cast(*u8, &cp_path);
}

// Seventy families made here from one: each its name's "gh" made two
// digits, "Caustic Test Wei00ts" to "Wei69ts", each reaching only page 4.
// With them, the Greek, mono and colour faces.
fn crowd() as void {
    let is [16]u8 as name;
    let is i64 as k with mut = 0;
    CROWD = own_dir("/tmp/caustic-chain-crowd", &crowd_dir[0]);
    linux.mkdir(CROWD, 493);
    let is i64 as n = slurp("text/testdata/fonts/weights/TestWeights-300.ttf");
    while (k < 70) {
        let is [2048]u8 as copy;
        mem.memcpy(cast(*u8, &copy), cast(*u8, &fbuf), n);
        let is i64 as i with mut = 0;
        while (i + 3 < n) {
            if (copy[i] == 0 && copy[i + 1] == 103 && copy[i + 2] == 0 && copy[i + 3] == 104) {
                copy[i + 1] = cast(u8, 48 + k / 10);
                copy[i + 3] = cast(u8, 48 + k % 10);
            }
            i = i + 1;
        }
        name[0] = cast(u8, 119);
        name[1] = cast(u8, 48 + k / 10);
        name[2] = cast(u8, 48 + k % 10);
        mem.memcpy(cast(*u8, cast(i64, &name) + 3), ".ttf", 5);
        spill(crowd_path(cast(*u8, &name)), cast(*u8, &copy), n);
        k = k + 1;
    }
    spill(crowd_path("greek.ttf"), cast(*u8, &fbuf), slurp("text/testdata/fonts/more/deeper/TestGreek.ttf"));
    spill(crowd_path("mono.ttf"), cast(*u8, &fbuf), slurp("text/testdata/fonts/mono/TestMono.ttf"));
    spill(crowd_path("emoji.ttf"), cast(*u8, &fbuf), slurp("text/testdata/fonts/emoji/TestEmoji.ttf"));
    let is index.Index as many with mut = indexed(CROWD);
    check("seventy families and three", index.family_count(&many) == 73);
    let is chain.Prefs as p with mut = prefs();
    let is chain.Chain as c with mut;
    // Sixty-four asked for, as many as a chain holds: what only another
    // family has is drawn as missing.
    let is [2048]u8 as list;
    let is i64 as at with mut = 0;
    k = 0;
    while (k < 64) {
        if (k > 0) {
            mem.memcpy(cast(*u8, cast(i64, &list) + at), ", ", 2);
            at = at + 2;
        }
        mem.memcpy(cast(*u8, cast(i64, &list) + at), "Caustic Test Wei", 16);
        at = at + 16;
        list[at] = cast(u8, 48 + k / 10);
        list[at + 1] = cast(u8, 48 + k % 10);
        mem.memcpy(cast(*u8, cast(i64, &list) + at + 2), "ts", 2);
        at = at + 4;
        k = k + 1;
    }
    list[at] = cast(u8, 0);
    chain.open(&c, &many, cast(*u8, &list), 400.0, 100.0, face.NORMAL, &p);
    check("sixty-four members", chain.count(&c) == 64);
    check("a sixty-fifth refused", nowhere(&c, 945));
    chain.close(&c);
    // Seventy faces found wanting on one page: each learned, none opened
    // for that page again.
    chain.open(&c, &many, "Caustic Test Mono", 400.0, 100.0, face.NORMAL, &p);
    check("а: nowhere", nowhere(&c, 1072));
    let is i64 as opened = c.opens;
    check("б: nowhere, nothing opened", nowhere(&c, 1073) && c.opens == opened && opened == 71);
    let is i64 as m = chain.find(&c, 945);
    check("α from the one face with it", m > 0 && ends(index.path_of(&many, chain.member(&c, m).face), "greek.ttf") == 1
          && sfnt.cmap.glyph(chain.face(&c, m), 945) != 0);
    chain.close(&c);
    // The last resort passes over colour, first by name though it is.
    p.sans = "Caustic Test Nothing";
    chain.open(&c, &many, "", 400.0, 100.0, face.NORMAL, &p);
    check("the last resort is not in colour", chain.member(&c, 0).face >= 0
          && ends(index.path_of(&many, chain.member(&c, 0).face), "greek.ttf") == 1);
    chain.close(&c);
    index.close(&many);
    k = 0;
    while (k < 70) {
        name[0] = cast(u8, 119);
        name[1] = cast(u8, 48 + k / 10);
        name[2] = cast(u8, 48 + k % 10);
        mem.memcpy(cast(*u8, cast(i64, &name) + 3), ".ttf", 5);
        linux.unlink(crowd_path(cast(*u8, &name)));
        k = k + 1;
    }
    linux.unlink(crowd_path("greek.ttf"));
    linux.unlink(crowd_path("mono.ttf"));
    linux.unlink(crowd_path("emoji.ttf"));
    linux.rmdir(CROWD);
}

fn main() as i32 {
    let is scan.Scan as s with mut = scan.open();
    scan.walk(&s, "text/testdata/fonts");
    let is index.Index as none with mut = index.empty();
    ix = index.update(&none, &s);
    scan.close(&s);
    leads();
    fallbacks();
    instances();
    languages();
    gone();
    crowd();
    index.close(&ix);
    if (fails > 0) {
        io.printf("font chain: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("font chain: all checks passed\n");
    return 0;
}
