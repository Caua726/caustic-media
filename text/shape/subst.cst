// text/shape/subst.cst — GSUB: the eight substitution types, and a lookup
// applied along the run.
//
// A lookup goes along the run once from its start — reverse chaining, the
// eighth type, from its end — and at each glyph its features apply to and
// its flag lets it see, its subtables are tried in order until one applies.
// A substitution writes what replaces the glyphs it read: one for one
// (single, alternate, reverse chaining), several for one (multiple), one for
// several (ligature); context rules apply other lookups at the glyphs they
// matched.
//
// A glyph that replaces another takes GDEF's class for it when the face has
// GDEF's classes; otherwise the one it replaces keeps its own, a ligature is
// one and the pieces of a ligature split apart are bases.
use "../sfnt/table.cst" as table;
use "glyphs.cst" as glyphs;
use "chars.cst" as chars;
use "otl.cst" as otl;
use "plan.cst" as plan;
use "seq.cst" as seq;

let is i64 as SINGLE with imut = 1;
let is i64 as MULTIPLE with imut = 2;
let is i64 as ALTERNATE with imut = 3;
let is i64 as LIGATURE with imut = 4;
let is i64 as CONTEXT with imut = 5;
let is i64 as CHAIN with imut = 6;
let is i64 as EXTENSION with imut = 7;
let is i64 as REVERSE with imut = 8;

fn _u16(c as *seq.Ctx, at as i64) as i64 { return seq.u16(c, at); }

// The coverage index of the current glyph in the subtable's coverage, whose
// offset is at st + 2; otl.NONE when not covered.
fn _covered(c as *seq.Ctx, st as i64) as i64 {
    return otl.coverage(c.f, c.l.t, otl.off16(c.f, c.l.t, st, st + 2), cast(i64, seq.cur(c).id));
}

// g made glyph id: its class as GDEF has it, or guess (0: as it was).
fn _become(c as *seq.Ctx, g as *glyphs.Glyph, id as i64, guess as i64, made as i64) as void {
    g.id = cast(u32, id);
    if (c.classes == 1) {
        g.cls = cast(u8, otl.glyph_class(c.f, id));
        g.mclass = cast(u8, otl.mark_class(c.f, id));
        if (g.cls == cast(u8, 4)) { g.cls = cast(u8, glyphs.UNCLASSED); }
    } else if (guess != 0) {
        g.cls = cast(u8, guess);
    }
    g.made = cast(u8, cast(i64, g.made) | glyphs.SUBSTITUTED | made);
}

// The current glyph replaced by glyph id.
fn replace(c as *seq.Ctx, id as i64) as void {
    let is glyphs.Glyph as g = *seq.cur(c);
    _become(c, &g, id, 0, 0);
    glyphs.put(c.run, &g);
    glyphs.drop(c.run);
}

// The current glyph taken out; its text goes to the glyph before it, or
// after it when it is the first.
fn delete(c as *seq.Ctx) as void {
    let is i64 as h = seq.here(c);
    let is i64 as t = seq.total(c);
    let is u32 as cl = seq.cur(c).cluster;
    if (h + 1 < t && seq.at(c, h + 1).cluster == cl) {
        // Its cluster goes on in the next.
    } else if (h > 0) {
        glyphs.join(c.run, h - 1, h + 1);
    } else if (h + 1 < t) {
        glyphs.join(c.run, h, h + 2);
    }
    glyphs.drop(c.run);
}

fn _single(c as *seq.Ctx, st as i64) as i32 {
    let is i64 as format = _u16(c, st);
    let is i64 as index = _covered(c, st);
    if (index == otl.NONE) { return 0; }
    if (format == 1) {
        replace(c, (cast(i64, seq.cur(c).id) + otl.i16(c.f, c.l.t, st + 4)) & 65535);
        return 1;
    }
    if (format == 2) {
        if (index >= _u16(c, st + 4)) { return 0; }
        replace(c, _u16(c, st + 6 + index * 2));
        return 1;
    }
    return 0;
}

// The current glyph replaced by the sequence at seq_at: none, one, or
// several pieces, each numbered from 0 — unless it is on a ligature, whose
// component it stays.
fn _sequence(c as *seq.Ctx, seq_at as i64) as i32 {
    let is i64 as n with mut = 0;
    if (seq_at != 0) { n = _u16(c, seq_at); }
    if (n == 0) {
        delete(c);
        return 1;
    }
    if (n == 1) {
        replace(c, _u16(c, seq_at + 2));
        return 1;
    }
    let is glyphs.Glyph as g = *seq.cur(c);
    let is i64 as guess with mut = 0;
    if (g.cls == cast(u8, glyphs.LIGATURE)) { guess = glyphs.BASE; }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is glyphs.Glyph as piece = g;
        _become(c, &piece, _u16(c, seq_at + 2 + i * 2), guess, glyphs.MULTIPLIED);
        if (g.lig == cast(u8, 0)) { piece.comp = cast(u8, i); }
        glyphs.put(c.run, &piece);
        i = i + 1;
    }
    glyphs.drop(c.run);
    return 1;
}

fn _multiple(c as *seq.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as index = _covered(c, st);
    if (index == otl.NONE) { return 0; }
    return _sequence(c, seq.offset(c, st, _u16(c, st + 4), st + 6, index));
}

fn _lowest_bit(v as i64) as i64 {
    let is i64 as n with mut = 0;
    while (n < 63 && ((v >> n) & 1) == 0) { n = n + 1; }
    return n;
}

// The alternate the glyph's value for the feature names, from 1; the
// largest value, for rand, one at random.
fn _alternate(c as *seq.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as index = _covered(c, st);
    if (index == otl.NONE) { return 0; }
    let is i64 as set = seq.offset(c, st, _u16(c, st + 4), st + 6, index);
    if (set == 0) { return 0; }
    let is i64 as n = _u16(c, set);
    if (n == 0) { return 0; }
    let is i64 as shift = _lowest_bit(c.mask);
    let is i64 as value with mut = (cast(i64, seq.cur(c).mask) & c.mask) >> shift;
    if ((c.flags & plan.F_RANDOM) != 0 && value == (c.mask >> shift)) {
        glyphs.mark_unsafe(c.run, 0, seq.total(c));
        value = glyphs.next_random(c.run) % n + 1;
    }
    if (value < 1 || value > n) { return 0; }
    replace(c, _u16(c, set + 2 + (value - 1) * 2));
    return 1;
}

// The glyphs of the input, matched into c.pos and ending before end, made
// the one glyph id, of comps components. Glyphs the lookup passed over
// between them are written after it, each mark given the component it
// followed; and the marks after the last one that belonged to it, too.
// Marks joined onto a base, or marks onto a mark, make no ligature of
// components: what they become keeps the first one's place.
fn ligate(c as *seq.Ctx, count as i64, end as i64, id as i64, comps as i64) as void {
    let is *glyphs.Run as r = c.run;
    let is i64 as h = seq.here(c);
    glyphs.join(r, h, end);
    let is glyphs.Glyph as first = *seq.cur(c);
    let is i32 as rest_marks with mut = 1;
    let is i64 as k with mut = 1;
    while (k < count) {
        if (seq.at(c, c.pos[k]).cls != cast(u8, glyphs.MARK)) { rest_marks = 0; }
        k = k + 1;
    }
    let is i32 as on_mark = cast(i32, rest_marks == 1 && first.cls == cast(u8, glyphs.MARK));
    let is i32 as on_base = cast(i32, rest_marks == 1 && first.cls == cast(u8, glyphs.BASE));
    let is i32 as real = cast(i32, on_mark == 0 && on_base == 0);
    let is i64 as lig with mut = 0;
    if (real == 1) { lig = glyphs.next_ligature(r); }

    // Where the components are among what is still to read.
    let is [64]i64 as src;
    k = 0;
    while (k < count) {
        src[k] = r.i + c.pos[k] - r.n;
        k = k + 1;
    }

    let is i64 as last_lig with mut = cast(i64, first.lig);
    let is i64 as last_n with mut = seq.own_count(&first);
    let is i64 as so_far with mut = last_n;

    let is glyphs.Glyph as out = first;
    let is i64 as guess with mut = 0;
    if (real == 1) { guess = glyphs.LIGATURE; }
    _become(c, &out, id, guess, glyphs.LIGATED);
    out.made = cast(u8, cast(i64, out.made) & (255 - glyphs.MULTIPLIED));
    if (real == 1) {
        out.lig = cast(u8, lig);
        out.comp = cast(u8, 0);
        out.ncomp = cast(u8, comps);
        // A ligature that starts with a mark is no longer one.
        if (chars.is_mark(cast(i64, out.cat)) == 1) { out.cat = cast(u8, chars.OTHER_LETTER); }
    }
    glyphs.put(r, &out);
    glyphs.drop(r);

    k = 1;
    while (k < count && r.ok == 1) {
        while (r.i < src[k] && r.ok == 1) {
            let is *glyphs.Glyph as g = glyphs.cur(r);
            if (real == 1) {
                let is i64 as this_comp with mut = cast(i64, g.comp);
                if (this_comp == 0) { this_comp = last_n; }
                if (this_comp > last_n) { this_comp = last_n; }
                g.lig = cast(u8, lig);
                g.comp = cast(u8, so_far - last_n + this_comp);
            }
            glyphs.keep(r);
        }
        let is *glyphs.Glyph as part = glyphs.cur(r);
        last_lig = cast(i64, part.lig);
        last_n = seq.own_count(part);
        so_far = so_far + last_n;
        glyphs.drop(r);
        k = k + 1;
    }

    if (on_mark == 0 && last_lig != 0) {
        let is i64 as j with mut = r.i;
        let is i32 as going with mut = 1;
        while (going == 1 && j < r.len) {
            let is *glyphs.Glyph as g = &r.src[j];
            if (cast(i64, g.lig) != last_lig || g.comp == cast(u8, 0)) {
                going = 0;
            } else {
                let is i64 as this_comp with mut = cast(i64, g.comp);
                if (this_comp > last_n) { this_comp = last_n; }
                g.lig = cast(u8, lig);
                g.comp = cast(u8, so_far - last_n + this_comp);
                j = j + 1;
            }
        }
    }
}

fn _ligature_set(c as *seq.Ctx, set as i64) as i32 {
    if (set == 0) { return 0; }
    let is i64 as n = _u16(c, set);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as lig = seq.offset(c, set, n, set + 2, i);
        if (lig != 0) {
            let is i64 as id = _u16(c, lig);
            let is i64 as count = _u16(c, lig + 2);
            if (count == 1) {
                replace(c, id);
                return 1;
            }
            let is i64 as end with mut = 0;
            let is i64 as comps with mut = 0;
            if (count > 1 && seq.match_input(c, count, seq.BY_GLYPH, 0, lig + 4, &end, &comps) == 1) {
                ligate(c, count, end, id, comps);
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn _ligature(c as *seq.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as index = _covered(c, st);
    if (index == otl.NONE) { return 0; }
    return _ligature_set(c, seq.offset(c, st, _u16(c, st + 4), st + 6, index));
}

// Reverse chaining: the glyph replaced where it stands when its backtrack
// and lookahead match. Not from within another lookup's context.
fn _reverse(c as *seq.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1 || c.depth > 0) { return 0; }
    let is i64 as index = _covered(c, st);
    if (index == otl.NONE) { return 0; }
    let is i64 as nback = _u16(c, st + 4);
    let is i64 as back = st + 6;
    let is i64 as at_ahead = back + nback * 2;
    let is i64 as nahead = _u16(c, at_ahead);
    let is i64 as ahead = at_ahead + 2;
    let is i64 as at_subs = ahead + nahead * 2;
    if (index >= _u16(c, at_subs)) { return 0; }
    let is i64 as h = seq.here(c);
    let is i64 as start with mut = h;
    let is i64 as end with mut = h + 1;
    if (seq.match_backtrack(c, nback, seq.BY_COVERAGE, st, back, &start) == 0) { return 0; }
    if (seq.match_lookahead(c, nahead, seq.BY_COVERAGE, st, ahead, h, &end) == 0) { return 0; }
    glyphs.mark_unsafe(c.run, start, end);
    _become(c, seq.cur(c), _u16(c, at_subs + 2 + index * 2), 0, 0);
    return 1;
}

fn subtable(c as *seq.Ctx, kind as i64, st as i64) as i32 {
    if (st == 0) { return 0; }
    if (kind == SINGLE) { return _single(c, st); }
    if (kind == MULTIPLE) { return _multiple(c, st); }
    if (kind == ALTERNATE) { return _alternate(c, st); }
    if (kind == LIGATURE) { return _ligature(c, st); }
    if (kind == CONTEXT) { return seq.context(c, st); }
    if (kind == CHAIN) { return seq.chain(c, st); }
    if (kind == EXTENSION) {
        let is i64 as inner = _u16(c, st + 2);
        if (_u16(c, st) != 1 || inner == EXTENSION) { return 0; }
        return subtable(c, inner, otl.off32(c.f, c.l.t, st, st + 4));
    }
    if (kind == REVERSE) { return _reverse(c, st); }
    return 0;
}

// Lookup index applied at the current glyph: its subtables tried in order.
fn apply_at(c as *seq.Ctx, index as i64) as i32 {
    let is i64 as lk = otl.lookup(c.f, c.l, index);
    if (lk == 0) { return 0; }
    let is i64 as kind = otl.lookup_type(c.f, c.l, lk);
    let is i64 as n = otl.subtable_count(c.f, c.l, lk);
    let is i64 as i with mut = 0;
    while (i < n) {
        if (subtable(c, kind, otl.subtable(c.f, c.l, lk, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _is_reverse(c as *seq.Ctx, lk as i64) as i32 {
    let is i64 as kind = otl.lookup_type(c.f, c.l, lk);
    if (kind == EXTENSION) {
        let is i64 as st = otl.subtable(c.f, c.l, lk, 0);
        return cast(i32, st != 0 && _u16(c, st + 2) == REVERSE);
    }
    return cast(i32, kind == REVERSE);
}

// Whether the lookup applies at glyph g: its features do, its flag lets it
// see it.
fn _applies(c as *seq.Ctx, g as *glyphs.Glyph) as i32 {
    return cast(i32, (cast(i64, g.mask) & c.mask) != 0 && seq.ignored(c, g) == 0);
}

// The plan's step applied along the run.
fn apply_step(c as *seq.Ctx, s as *plan.Step) as void {
    let is *glyphs.Run as r = c.run;
    let is i64 as lk = otl.lookup(c.f, c.l, s.lookup);
    if (lk == 0 || r.len == 0) { return; }
    seq.set_lookup(c, s.lookup, lk);
    c.mask = s.mask;
    c.flags = s.flags;
    if (_is_reverse(c, lk) == 1) {
        let is i64 as i with mut = r.len - 1;
        while (i >= 0 && r.ok == 1) {
            r.i = i;
            if (_applies(c, &r.src[i]) == 1) { apply_at(c, s.lookup); }
            glyphs.step(r, 1);
            i = i - 1;
        }
        r.i = 0;
        return;
    }
    glyphs.begin(r);
    while (glyphs.more(r) == 1) {
        let is i32 as done with mut = 0;
        if (_applies(c, glyphs.cur(r)) == 1) { done = apply_at(c, s.lookup); }
        if (done == 0) { glyphs.keep(r); }
        glyphs.step(r, 1);
    }
    glyphs.end(r);
}
