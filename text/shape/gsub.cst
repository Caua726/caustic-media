// text/shape/gsub.cst — substitution: GSUB's eight lookup types, and the
// map's GSUB lookups applied stage by stage, as HarfBuzz applies them.
//
// Each lookup goes along the text once, from its start — the last type,
// reverse chaining, from its end — and at each glyph it applies to, its
// subtables are tried in order until one applies. Writing as it reads, a
// lookup can replace a glyph by one (single, alternate), by several
// (multiple), several by one (ligature), or apply other lookups in a
// context.
use "../sfnt/table.cst" as table;
use "../outline/outline.cst" as outline;
use "buffer.cst" as buffer;
use "props.cst" as props;
use "ot.cst" as ot;
use "map.cst" as map;
use "apply.cst" as apply;

let is i64 as SINGLE with imut = 1;
let is i64 as MULTIPLE with imut = 2;
let is i64 as ALTERNATE with imut = 3;
let is i64 as LIGATURE with imut = 4;
let is i64 as CONTEXT with imut = 5;
let is i64 as CHAIN_CONTEXT with imut = 6;
let is i64 as EXTENSION with imut = 7;
let is i64 as REVERSE_CHAIN with imut = 8;

fn _u16(c as *apply.Ctx, at as i64) as i64 { return ot.u16(c.f, c.l.t, at); }
fn _cov(c as *apply.Ctx, st as i64, at as i64) as i64 {
    return ot.coverage(c.f, c.l.t, st + _u16(c, at), cast(i64, buffer.cur(c.b, 0).cp));
}

fn _single(c as *apply.Ctx, st as i64) as i32 {
    let is i64 as fmt = _u16(c, st);
    let is i64 as index = _cov(c, st, st + 2);
    if (index == ot.NOT_COVERED) { return 0; }
    if (fmt == 1) {
        let is i64 as g = (cast(i64, buffer.cur(c.b, 0).cp) + ot.i16(c.f, c.l.t, st + 4)) & 65535;
        apply.replace_glyph(c, g);
        return 1;
    }
    if (fmt == 2) {
        if (index >= _u16(c, st + 4)) { return 0; }
        apply.replace_glyph(c, _u16(c, st + 6 + index * 2));
        return 1;
    }
    return 0;
}

// A sequence of glyphs in place of the current one: one replaces it, none
// deletes it — as Uniscribe allows — and more are written each a component
// of what it was.
fn _sequence(c as *apply.Ctx, seq as i64) as i32 {
    let is *buffer.Buffer as b = c.b;
    let is i64 as count with mut = 0;
    if (seq != 0) { count = _u16(c, seq); }
    if (count == 1) {
        apply.replace_glyph(c, _u16(c, seq + 2));
        return 1;
    }
    if (count == 0) {
        buffer.delete_glyph(b);
        return 1;
    }
    let is i64 as klass with mut = 0;
    if (props.is_ligature(buffer.cur(b, 0)) == 1) { klass = props.BASE_GLYPH; }
    let is i64 as lig_id = props.lig_id(buffer.cur(b, 0));
    let is i64 as i with mut = 0;
    while (i < count) {
        // Glyphs on a ligature are left on it.
        if (lig_id == 0) { props.set_lig_props_for_component(buffer.cur(b, 0), i); }
        apply.output_glyph_for_component(c, _u16(c, seq + 2 + i * 2), klass);
        i = i + 1;
    }
    buffer.skip_glyph(b);
    return 1;
}

fn _multiple(c as *apply.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as index = _cov(c, st, st + 2);
    if (index == ot.NOT_COVERED) { return 0; }
    return _sequence(c, apply._offset(c, st, _u16(c, st + 4), st + 6, index));
}

fn _ctz(v as i64) as i64 {
    let is i64 as n with mut = 0;
    while (n < 32 && ((v >> n) & 1) == 0) { n = n + 1; }
    return n;
}

// The alternate the feature's value names — counted from 1; with rand, one
// of them at random.
fn _alternate(c as *apply.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as index = _cov(c, st, st + 2);
    if (index == ot.NOT_COVERED) { return 0; }
    let is i64 as set = apply._offset(c, st, _u16(c, st + 4), st + 6, index);
    if (set == 0) { return 0; }
    let is i64 as count = _u16(c, set);
    if (count == 0) { return 0; }
    let is i64 as shift = _ctz(c.lookup_mask);
    let is i64 as alt with mut = (c.lookup_mask & cast(i64, buffer.cur(c.b, 0).mask)) >> shift;
    if (alt == map.MAX_VALUE && c.random == 1) {
        buffer.unsafe_to_break(c.b, 0, c.b.len);
        alt = apply.random_number(c) % count + 1;
    }
    if (alt > count || alt == 0) { return 0; }
    apply.replace_glyph(c, _u16(c, set + 2 + (alt - 1) * 2));
    return 1;
}

fn _ligature_one(c as *apply.Ctx, lig as i64) as i32 {
    let is i64 as glyph = _u16(c, lig);
    let is i64 as count = _u16(c, lig + 2);
    if (count == 0) { return 0; }
    if (count == 1) {
        apply.replace_glyph(c, glyph);
        return 1;
    }
    if (count > apply.MAX_CONTEXT) { return 0; }
    let is i64 as end with mut = 0;
    let is i64 as total with mut = 0;
    if (apply.match_input(c, count, apply.MATCH_GLYPH, 0, lig + 4, &end, &total) == 0) { return 0; }
    apply.ligate_input(c, count, end, glyph, total);
    return 1;
}

fn _ligature(c as *apply.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as index = _cov(c, st, st + 2);
    if (index == ot.NOT_COVERED) { return 0; }
    let is i64 as set = apply._offset(c, st, _u16(c, st + 4), st + 6, index);
    if (set == 0) { return 0; }
    let is i64 as n = _u16(c, set);
    let is i64 as i with mut = 0;
    while (i < n) {
        if (_ligature_one(c, apply._offset(c, set, n, set + 2, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Reverse chaining single substitution: the current glyph replaced in
// place when its backtrack and lookahead match; never from another lookup.
fn _reverse_chain(c as *apply.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as index = _cov(c, st, st + 2);
    if (index == ot.NOT_COVERED) { return 0; }
    if (c.nesting_left != apply.MAX_NESTING) { return 0; }
    let is i64 as nback = _u16(c, st + 4);
    let is i64 as back = st + 6;
    let is i64 as at = back + nback * 2;
    let is i64 as nahead = _u16(c, at);
    let is i64 as ahead = at + 2;
    let is i64 as subs = ahead + nahead * 2;
    if (index >= _u16(c, subs)) { return 0; }
    let is i64 as start with mut = 0;
    let is i64 as end with mut = 0;
    if (apply.match_backtrack(c, nback, apply.MATCH_COVERAGE, st, back, &start) == 1 &&
        apply.match_lookahead(c, nahead, apply.MATCH_COVERAGE, st, ahead, c.b.idx + 1, &end) == 1) {
        buffer.unsafe_to_break_from_outbuffer(c.b, start, end);
        apply.replace_glyph_inplace(c, _u16(c, subs + 2 + index * 2));
        return 1;
    }
    return 0;
}

fn subtable(c as *apply.Ctx, kind as i64, st as i64) as i32 {
    if (st == 0) { return 0; }
    if (kind == SINGLE) { return _single(c, st); }
    if (kind == MULTIPLE) { return _multiple(c, st); }
    if (kind == ALTERNATE) { return _alternate(c, st); }
    if (kind == LIGATURE) { return _ligature(c, st); }
    if (kind == CONTEXT) { return apply.context(c, st); }
    if (kind == CHAIN_CONTEXT) { return apply.chain_context(c, st); }
    if (kind == EXTENSION) {
        let is i64 as ext = _u16(c, st + 2);
        if (_u16(c, st) != 1 || ext == EXTENSION) { return 0; }
        let is i64 as o = ot.u32(c.f, c.l.t, st + 4);
        if (o == 0) { return 0; }
        return subtable(c, ext, st + o);
    }
    if (kind == REVERSE_CHAIN) { return _reverse_chain(c, st); }
    return 0;
}

// Lookup index applied at the current glyph: its subtables tried in order.
fn apply_once(c as *apply.Ctx, index as i64) as i32 {
    let is i64 as lk = ot.lookup(c.f, c.l, index);
    if (lk == 0) { return 0; }
    let is i64 as kind = ot.lookup_type(c.f, c.l, lk);
    let is i64 as n = ot.subtable_count(c.f, c.l, lk);
    let is i64 as i with mut = 0;
    while (i < n) {
        if (subtable(c, kind, ot.subtable(c.f, c.l, lk, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _recurse(c as *apply.Ctx, index as i64) as i32 { return apply_once(c, index); }

fn is_reverse(c as *apply.Ctx, lk as i64) as i32 {
    let is i64 as kind = ot.lookup_type(c.f, c.l, lk);
    if (kind == EXTENSION) {
        let is i64 as st = ot.subtable(c.f, c.l, lk, 0);
        if (st == 0) { return 0; }
        return cast(i32, _u16(c, st + 2) == REVERSE_CHAIN);
    }
    return cast(i32, kind == REVERSE_CHAIN);
}

fn _applicable(c as *apply.Ctx, i as *buffer.Info) as i32 {
    if ((cast(i64, i.mask) & c.lookup_mask) != 0 && apply.check_glyph_property(c, i, c.lookup_props) == 1) { return 1; }
    return 0;
}

// Lookup index along the whole text.
fn apply_string(c as *apply.Ctx, index as i64) as void {
    let is *buffer.Buffer as b = c.b;
    if (b.len == 0 || c.lookup_mask == 0) { return; }
    let is i64 as lk = ot.lookup(c.f, c.l, index);
    apply.set_lookup_props(c, ot.lookup_props(c.f, c.l, lk));
    if (is_reverse(c, lk) == 0) {
        buffer.clear_output(b);
        b.idx = 0;
        while (b.successful == 1) {
            let is i64 as j with mut = b.idx;
            while (j < b.len && _applicable(c, &b.info[j]) == 0) { j = j + 1; }
            if (j > b.idx && buffer.next_glyphs(b, j - b.idx) == 0) { break; }
            if (b.idx >= b.len) { break; }
            if (apply_once(c, index) == 0) { buffer.next_glyph(b); }
        }
        buffer.sync(b);
    } else {
        b.idx = b.len - 1;
        while (b.idx >= 0) {
            if (_applicable(c, buffer.cur(b, 0)) == 1) { apply_once(c, index); }
            b.idx = b.idx - 1;
        }
    }
}

// The map's GSUB lookups applied to the glyphs, stage by stage.
fn substitute(r as *outline.Reader, b as *buffer.Buffer, m as *map.Map) as void {
    if (m.gsub.ok == 0) { return; }
    let is apply.Ctx as c;
    apply.open(&c, r.face, r, b, &m.gsub, 0, fn_ptr(_recurse));
    let is i64 as i with mut = 0;
    let is i64 as stage with mut = 0;
    while (stage < m.nstages0) {
        while (i < m.stages0[stage]) {
            let is *map.Lookup as k = &m.lookups0[i];
            c.lookup_index = k.index;
            c.lookup_mask = k.mask;
            c.last_base = 0 - 1;
            c.last_base_until = 0;
            c.auto_zwj = k.auto_zwj;
            c.auto_zwnj = k.auto_zwnj;
            c.random = k.random;
            c.per_syllable = k.per_syllable;
            apply_string(&c, k.index);
            i = i + 1;
        }
        stage = stage + 1;
    }
}
