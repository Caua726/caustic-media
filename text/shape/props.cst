// text/shape/props.cst — what shaping needs to know of each character, as
// HarfBuzz asks it.
//
// The answers are caustic-unicode's (Unicode 16) in HarfBuzz's terms: its
// numbering of the general categories; combining classes reordered the way
// HarfBuzz reorders them, so that Hebrew and Arabic marks sort as fonts
// expect; its own Default_Ignorable, which leaves out the Hangul fillers
// that fonts draw; the spaces it can make from a font's space; one level of
// canonical decomposition at a time, and the primary composites.
//
// Each record keeps what was found in sixteen bits (Info.uprops), as
// HarfBuzz does: the category in five, whether it is ignorable, hidden from
// lookups, a grapheme's continuation; and in the high byte, by category,
// a mark's class, which joiner or selector a format character is, which
// space a space is.
use "buffer.cst" as buffer;
use "caustic-unicode/src/ucd/props.cst" as ucd;
use "caustic-unicode/src/ucd/tables/decomp.cst" as dec;
use "caustic-unicode/src/normalize/normalize.cst" as norm;
use "caustic-unicode/src/ucd/tables/extpict.cst" as extpict;
use "caustic-unicode/src/bidi/bidi.cst" as bidi;

// HarfBuzz's general categories.
let is i64 as CONTROL with imut = 0;
let is i64 as FORMAT with imut = 1;
let is i64 as UNASSIGNED with imut = 2;
let is i64 as PRIVATE_USE with imut = 3;
let is i64 as SURROGATE with imut = 4;
let is i64 as LOWERCASE_LETTER with imut = 5;
let is i64 as MODIFIER_LETTER with imut = 6;
let is i64 as OTHER_LETTER with imut = 7;
let is i64 as TITLECASE_LETTER with imut = 8;
let is i64 as UPPERCASE_LETTER with imut = 9;
let is i64 as SPACING_MARK with imut = 10;
let is i64 as ENCLOSING_MARK with imut = 11;
let is i64 as NON_SPACING_MARK with imut = 12;
let is i64 as DECIMAL_NUMBER with imut = 13;
let is i64 as LETTER_NUMBER with imut = 14;
let is i64 as OTHER_NUMBER with imut = 15;
let is i64 as CONNECT_PUNCTUATION with imut = 16;
let is i64 as DASH_PUNCTUATION with imut = 17;
let is i64 as CLOSE_PUNCTUATION with imut = 18;
let is i64 as FINAL_PUNCTUATION with imut = 19;
let is i64 as INITIAL_PUNCTUATION with imut = 20;
let is i64 as OTHER_PUNCTUATION with imut = 21;
let is i64 as OPEN_PUNCTUATION with imut = 22;
let is i64 as CURRENCY_SYMBOL with imut = 23;
let is i64 as MODIFIER_SYMBOL with imut = 24;
let is i64 as MATH_SYMBOL with imut = 25;
let is i64 as OTHER_SYMBOL with imut = 26;
let is i64 as LINE_SEPARATOR with imut = 27;
let is i64 as PARAGRAPH_SEPARATOR with imut = 28;
let is i64 as SPACE_SEPARATOR with imut = 29;

// Info.uprops.
let is i64 as GEN_CAT with imut = 31;
let is i64 as IGNORABLE with imut = 32;
let is i64 as HIDDEN with imut = 64;
let is i64 as CONTINUATION with imut = 128;
let is i64 as CF_ZWJ with imut = 256;
let is i64 as CF_ZWNJ with imut = 512;
let is i64 as CF_VS with imut = 1024;

// The spaces made from the font's own (fallback.cst): an em, or a part of
// one, or as wide as a figure, a punctuation mark, half a space.
let is i64 as NOT_SPACE with imut = 0;
let is i64 as SPACE_EM with imut = 1;
let is i64 as SPACE_EM_2 with imut = 2;
let is i64 as SPACE_EM_3 with imut = 3;
let is i64 as SPACE_EM_4 with imut = 4;
let is i64 as SPACE_EM_5 with imut = 5;
let is i64 as SPACE_EM_6 with imut = 6;
let is i64 as SPACE_EM_16 with imut = 16;
let is i64 as SPACE_4_EM_18 with imut = 17;
let is i64 as SPACE with imut = 18;
let is i64 as SPACE_FIGURE with imut = 19;
let is i64 as SPACE_PUNCTUATION with imut = 20;
let is i64 as SPACE_NARROW with imut = 21;

// Info.gprops: the glyph's class, from GDEF or from its character, and
// whether a substitution made it, a ligature, or a multiple one.
let is i64 as BASE_GLYPH with imut = 2;
let is i64 as LIGATURE with imut = 4;
let is i64 as MARK with imut = 8;
let is i64 as SUBSTITUTED with imut = 16;
let is i64 as LIGATED with imut = 32;
let is i64 as MULTIPLIED with imut = 64;

fn _in(c as i64, lo as i64, hi as i64) as i32 {
    if (c >= lo && c <= hi) { return 1; }
    return 0;
}

// caustic-unicode's general categories, in HarfBuzz's numbering.
fn general_category(cp as i64) as i64 {
    if (cp < 0 || cp > 1114111) { return UNASSIGNED; }
    let is i64 as g = ucd.general_category(cast(i32, cp));
    if (g == ucd.GC_LU) { return UPPERCASE_LETTER; }
    if (g == ucd.GC_LL) { return LOWERCASE_LETTER; }
    if (g == ucd.GC_LT) { return TITLECASE_LETTER; }
    if (g == ucd.GC_LM) { return MODIFIER_LETTER; }
    if (g == ucd.GC_LO) { return OTHER_LETTER; }
    if (g == ucd.GC_MN) { return NON_SPACING_MARK; }
    if (g == ucd.GC_MC) { return SPACING_MARK; }
    if (g == ucd.GC_ME) { return ENCLOSING_MARK; }
    if (g == ucd.GC_ND) { return DECIMAL_NUMBER; }
    if (g == ucd.GC_NL) { return LETTER_NUMBER; }
    if (g == ucd.GC_NO) { return OTHER_NUMBER; }
    if (g == ucd.GC_PC) { return CONNECT_PUNCTUATION; }
    if (g == ucd.GC_PD) { return DASH_PUNCTUATION; }
    if (g == ucd.GC_PS) { return OPEN_PUNCTUATION; }
    if (g == ucd.GC_PE) { return CLOSE_PUNCTUATION; }
    if (g == ucd.GC_PI) { return INITIAL_PUNCTUATION; }
    if (g == ucd.GC_PF) { return FINAL_PUNCTUATION; }
    if (g == ucd.GC_PO) { return OTHER_PUNCTUATION; }
    if (g == ucd.GC_SM) { return MATH_SYMBOL; }
    if (g == ucd.GC_SC) { return CURRENCY_SYMBOL; }
    if (g == ucd.GC_SK) { return MODIFIER_SYMBOL; }
    if (g == ucd.GC_SO) { return OTHER_SYMBOL; }
    if (g == ucd.GC_ZS) { return SPACE_SEPARATOR; }
    if (g == ucd.GC_ZL) { return LINE_SEPARATOR; }
    if (g == ucd.GC_ZP) { return PARAGRAPH_SEPARATOR; }
    if (g == ucd.GC_CC) { return CONTROL; }
    if (g == ucd.GC_CF) { return FORMAT; }
    if (g == ucd.GC_CS) { return SURROGATE; }
    if (g == ucd.GC_CO) { return PRIVATE_USE; }
    return UNASSIGNED;
}

fn is_mark_category(gc as i64) as i32 { return _in(gc, SPACING_MARK, NON_SPACING_MARK); }
fn is_letter_category(gc as i64) as i32 { return _in(gc, LOWERCASE_LETTER, UPPERCASE_LETTER); }

// Default_Ignorable as HarfBuzz has it: without U+115F, U+1160, U+3164,
// U+FFA0 and U+1BCA0..1BCA3, which fonts draw.
fn is_default_ignorable(cp as i64) as i32 {
    let is i64 as plane = cp >> 16;
    if (plane == 0) {
        let is i64 as page = cp >> 8;
        if (page == 0) { return cast(i32, cp == 173); }
        if (page == 3) { return cast(i32, cp == 847); }
        if (page == 6) { return cast(i32, cp == 1564); }
        if (page == 23) { return _in(cp, 6068, 6069); }
        if (page == 24) { return _in(cp, 6155, 6159); }
        if (page == 32) {
            if (_in(cp, 8203, 8207) == 1 || _in(cp, 8234, 8238) == 1 || _in(cp, 8288, 8303) == 1) { return 1; }
            return 0;
        }
        if (page == 254) {
            if (_in(cp, 65024, 65039) == 1 || cp == 65279) { return 1; }
            return 0;
        }
        if (page == 255) { return _in(cp, 65520, 65528); }
        return 0;
    }
    if (plane == 1) { return _in(cp, 119155, 119162); }
    if (plane == 14) { return _in(cp, 917504, 921599); }
    return 0;
}

// U+FE00..FE0F and U+E0100..E01EF; the Mongolian ones are a shaper's.
fn is_variation_selector(cp as i64) as i32 {
    if (_in(cp, 65024, 65039) == 1 || _in(cp, 917760, 917999) == 1) { return 1; }
    return 0;
}

fn is_regional_indicator(cp as i64) as i32 { return _in(cp, 127462, 127487); }

fn is_extended_pictographic(cp as i64) as i32 {
    if (cp < 0 || cp > 1114111) { return 0; }
    if (extpict.extpict_get(cast(i32, cp)) != 0) { return 1; }
    return 0;
}

fn combining_class(cp as i64) as i64 {
    if (cp < 0 || cp > 1114111) { return 0; }
    return ucd.combining_class(cast(i32, cp));
}

// The class HarfBuzz sorts marks by: Hebrew's points in the order fonts
// stack them, Arabic's shadda first, and a few marks of Telugu, Thai, Lao,
// Tibetan and Tai Tham moved as their shapers need.
fn modified_class(cp as i64) as i64 {
    if (cp == 6752) { return 254; }   // U+1A60 TAI THAM SIGN SAKOT
    if (cp == 4038) { return 254; }   // U+0FC6 TIBETAN SYMBOL PADMA GDAN
    if (cp == 3897) { return 127; }   // U+0F39 TIBETAN MARK TSA -PHRU
    let is i64 as c = combining_class(cp);
    if (c >= 10 && c <= 36) {
        // CCC10 .. CCC36
        let is *u8 as m = "\x16\x0f\x10\x11\x17\x12\x13\x14\x15\x0e\x18\x0c\x19\x0d\x0a\x0b\x1a\x1c\x1d\x1e\x1f\x20\x21\x1b\x22\x23\x24";
        return cast(i64, m[c - 10]);
    }
    if (c == 84) { return 4; }
    if (c == 91) { return 5; }
    if (c == 103) { return 3; }
    if (c == 130) { return 132; }
    if (c == 132) { return 131; }
    return c;
}

// Which space HarfBuzz can make cp from the font's own; NOT_SPACE when none.
fn space_fallback(cp as i64) as i64 {
    if (cp == 32 || cp == 160) { return SPACE; }
    if (cp == 8192) { return SPACE_EM_2; }
    if (cp == 8193) { return SPACE_EM; }
    if (cp == 8194) { return SPACE_EM_2; }
    if (cp == 8195) { return SPACE_EM; }
    if (cp == 8196) { return SPACE_EM_3; }
    if (cp == 8197) { return SPACE_EM_4; }
    if (cp == 8198) { return SPACE_EM_6; }
    if (cp == 8199) { return SPACE_FIGURE; }
    if (cp == 8200) { return SPACE_PUNCTUATION; }
    if (cp == 8201) { return SPACE_EM_5; }
    if (cp == 8202) { return SPACE_EM_16; }
    if (cp == 8239) { return SPACE_NARROW; }
    if (cp == 8287) { return SPACE_4_EM_18; }
    if (cp == 12288) { return SPACE_EM; }
    return NOT_SPACE;
}

// The character drawn mirrored in right-to-left text; cp itself for none.
fn mirror(cp as i64) as i64 {
    if (cp < 0 || cp > 1114111) { return cp; }
    return cast(i64, bidi.mirror(cast(i32, cp)));
}

let is i64 as S_BASE with imut = 44032;
let is i64 as L_BASE with imut = 4352;
let is i64 as V_BASE with imut = 4449;
let is i64 as T_BASE with imut = 4519;
let is i64 as L_COUNT with imut = 19;
let is i64 as V_COUNT with imut = 21;
let is i64 as T_COUNT with imut = 28;
let is i64 as N_COUNT with imut = 588;
let is i64 as S_COUNT with imut = 11172;

// One level of ab's canonical decomposition into *a and *b — *b 0 for a
// singleton; 0 when it has none. A Hangul syllable of three jamo is its
// first two composed and the third, as HarfBuzz takes it apart.
fn decompose(ab as i64, a as *i64, b as *i64) as i32 {
    let is i64 as si = ab - S_BASE;
    if (si >= 0 && si < S_COUNT) {
        if (si % T_COUNT != 0) {
            *a = S_BASE + (si / T_COUNT) * T_COUNT;
            *b = T_BASE + si % T_COUNT;
        } else {
            *a = L_BASE + si / N_COUNT;
            *b = V_BASE + (si % N_COUNT) / T_COUNT;
        }
        return 1;
    }
    if (ab < 0 || ab > 1114111) { return 0; }
    let is i32 as m = dec.decomp_get(cast(i32, ab));
    if (m == 0) { return 0; }
    let is i64 as rec = cast(i64, dec.decomp_meta_at(m));
    let is i64 as off = rec & 1048575;
    let is i64 as n = (rec >> 20) & 255;
    if (((rec >> 28) & 1) != 0 || n < 1 || n > 2) { return 0; }
    *a = cast(i64, dec.decomp_pool_at(cast(i32, off)));
    *b = 0;
    if (n == 2) { *b = cast(i64, dec.decomp_pool_at(cast(i32, off + 1))); }
    return 1;
}

// The primary composite of a and b; -1 when there is none.
fn compose(a as i64, b as i64) as i64 {
    if (a < 0 || a > 1114111 || b < 0 || b > 1114111) { return 0 - 1; }
    return cast(i64, norm.compose_pair(cast(i32, a), cast(i32, b)));
}

// --- On records ---

fn _up(i as *buffer.Info) as i64 { return cast(i64, i.uprops); }
fn _set(i as *buffer.Info, v as i64) as void { i.uprops = cast(u16, v & 65535); }

// The record's properties from its character; what was seen noted in the
// buffer's scratch flags.
fn set_unicode_props(b as *buffer.Buffer, i as *buffer.Info) as void {
    let is i64 as u = cast(i64, i.cp);
    let is i64 as gc = general_category(u);
    let is i64 as p with mut = gc;
    if (u >= 128) {
        if (is_default_ignorable(u) == 1) {
            b.scratch = b.scratch | buffer.HAS_DEFAULT_IGNORABLES;
            p = p | IGNORABLE;
            if (u == 8204) { p = p | CF_ZWNJ; }
            else if (u == 8205) { p = p | CF_ZWJ; }
            else if (_in(u, 6155, 6157) == 1 || u == 6159) { p = p | HIDDEN; }
            else if (_in(u, 917536, 917631) == 1) { p = p | HIDDEN; }
            else if (u == 847) {
                b.scratch = b.scratch | buffer.HAS_CGJ;
                p = p | HIDDEN;
            }
        }
        if (is_mark_category(gc) == 1) {
            b.scratch = b.scratch | buffer.HAS_CONTINUATIONS;
            p = p | CONTINUATION | (modified_class(u) << 8);
        }
    }
    _set(i, p);
}

fn category(i as *buffer.Info) as i64 { return _up(i) & GEN_CAT; }

// The category replaced, the high byte cleared.
fn set_category(i as *buffer.Info, gc as i64) as void {
    _set(i, gc | (_up(i) & (255 - GEN_CAT)));
}

fn is_unicode_mark(i as *buffer.Info) as i32 { return is_mark_category(category(i)); }

fn set_modified_class(i as *buffer.Info, c as i64) as void {
    if (is_unicode_mark(i) == 0) { return; }
    _set(i, (c << 8) | (_up(i) & 255));
}

fn modified_class_of(i as *buffer.Info) as i64 {
    if (is_unicode_mark(i) == 1) { return _up(i) >> 8; }
    return 0;
}

fn is_unicode_space(i as *buffer.Info) as i32 { return cast(i32, category(i) == SPACE_SEPARATOR); }

fn set_space_fallback(i as *buffer.Info, s as i64) as void {
    if (is_unicode_space(i) == 0) { return; }
    _set(i, (s << 8) | (_up(i) & 255));
}

fn space_fallback_of(i as *buffer.Info) as i64 {
    if (is_unicode_space(i) == 1) { return _up(i) >> 8; }
    return NOT_SPACE;
}

fn is_unicode_format(i as *buffer.Info) as i32 { return cast(i32, category(i) == FORMAT); }

fn is_variation_selector_of(i as *buffer.Info) as i32 {
    if (is_unicode_format(i) == 1 && (_up(i) & CF_VS) != 0) { return 1; }
    return 0;
}

// A variation selector the font did not take is kept as a format character
// that says so; given back to being a mark when it is done with.
fn set_variation_selector(i as *buffer.Info, customize as i32) as void {
    if (customize == 1) {
        set_category(i, FORMAT);
        _set(i, _up(i) | CF_VS);
    } else {
        set_category(i, NON_SPACING_MARK);
    }
}

fn substituted(i as *buffer.Info) as i32 {
    if ((cast(i64, i.gprops) & SUBSTITUTED) != 0) { return 1; }
    return 0;
}

// Ignorable, and still its own character: a glyph a substitution made of
// it is drawn.
fn is_default_ignorable_of(i as *buffer.Info) as i32 {
    if ((_up(i) & IGNORABLE) != 0 && substituted(i) == 0) { return 1; }
    return 0;
}

fn clear_default_ignorable(i as *buffer.Info) as void { _set(i, _up(i) & (65535 - IGNORABLE)); }

fn is_hidden(i as *buffer.Info) as i32 {
    if ((_up(i) & HIDDEN) != 0) { return 1; }
    return 0;
}

fn unhide(i as *buffer.Info) as void { _set(i, _up(i) & (65535 - HIDDEN)); }

fn set_continuation(b as *buffer.Buffer, i as *buffer.Info) as void {
    b.scratch = b.scratch | buffer.HAS_CONTINUATIONS;
    _set(i, _up(i) | CONTINUATION);
}

fn is_continuation(i as *buffer.Info) as i32 {
    if ((_up(i) & CONTINUATION) != 0) { return 1; }
    return 0;
}

fn is_zwnj(i as *buffer.Info) as i32 {
    if (is_unicode_format(i) == 1 && (_up(i) & CF_ZWNJ) != 0) { return 1; }
    return 0;
}

fn is_zwj(i as *buffer.Info) as i32 {
    if (is_unicode_format(i) == 1 && (_up(i) & CF_ZWJ) != 0) { return 1; }
    return 0;
}

// --- Glyph classes ---

fn glyph_props(i as *buffer.Info) as i64 { return cast(i64, i.gprops); }
fn set_glyph_props(i as *buffer.Info, p as i64) as void { i.gprops = cast(u16, p & 65535); }

fn is_mark(i as *buffer.Info) as i32 {
    if ((glyph_props(i) & MARK) != 0) { return 1; }
    return 0;
}

fn is_base_glyph(i as *buffer.Info) as i32 {
    if ((glyph_props(i) & BASE_GLYPH) != 0) { return 1; }
    return 0;
}

fn is_ligature(i as *buffer.Info) as i32 {
    if ((glyph_props(i) & LIGATURE) != 0) { return 1; }
    return 0;
}

// --- Ligatures ---

// Info.lig: a ligature's id in the top three bits; below them, for the
// ligature itself (IS_LIG_BASE) how many components it has, for a mark on it
// which component it sits on — and for the glyphs a multiple substitution
// made, which of them each is.
let is i64 as IS_LIG_BASE with imut = 16;

fn lig_props(i as *buffer.Info) as i64 { return cast(i64, i.lig); }
fn set_lig_props(i as *buffer.Info, v as i64) as void { i.lig = cast(u8, v & 255); }

fn lig_id(i as *buffer.Info) as i64 { return lig_props(i) >> 5; }

fn _ligated_internal(i as *buffer.Info) as i32 {
    if ((lig_props(i) & IS_LIG_BASE) != 0) { return 1; }
    return 0;
}

fn lig_comp(i as *buffer.Info) as i64 {
    if (_ligated_internal(i) == 1) { return 0; }
    return lig_props(i) & 15;
}

fn lig_num_comps(i as *buffer.Info) as i64 {
    if ((glyph_props(i) & LIGATURE) != 0 && _ligated_internal(i) == 1) { return lig_props(i) & 15; }
    return 1;
}

fn set_lig_props_for_ligature(i as *buffer.Info, id as i64, comps as i64) as void {
    set_lig_props(i, (id << 5) | IS_LIG_BASE | (comps & 15));
}

fn set_lig_props_for_mark(i as *buffer.Info, id as i64, comp as i64) as void {
    set_lig_props(i, (id << 5) | (comp & 15));
}

fn set_lig_props_for_component(i as *buffer.Info, comp as i64) as void { set_lig_props_for_mark(i, 0, comp); }
