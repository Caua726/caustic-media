// text/shape/hangul.cst — Hangul: syllables and jamo as the font draws them.
//
// What is written may be a precomposed syllable or conjoining jamo, leading
// vowel and trailing. A leading consonant, a vowel and maybe a trailing one that
// have a precomposed syllable the font has become it, and a syllable made of an
// LV and a T likewise; a syllable the font lacks is taken apart into its jamo
// when the font has those. Those left as jamo are marked for the font's ljmo,
// vjmo and tjmo features, which draw them in their places. A tone mark moves in
// front of the syllable it follows.
use "glyphs.cst" as glyphs;
use "../sfnt/cmap.cst" as cmap;
use "../outline/outline.cst" as outline;
use "plan.cst" as plan;
use "work.cst" as work;

let is i64 as L_BASE with imut = 4352;
let is i64 as V_BASE with imut = 4449;
let is i64 as T_BASE with imut = 4519;
let is i64 as S_BASE with imut = 44032;
let is i64 as L_COUNT with imut = 19;
let is i64 as V_COUNT with imut = 21;
let is i64 as T_COUNT with imut = 28;
let is i64 as S_COUNT with imut = 11172;
let is i64 as N_COUNT with imut = 588;
let is i64 as TONE_1 with imut = 12334;
let is i64 as TONE_2 with imut = 12335;
let is i64 as CIRCLE with imut = 9676;

// What a record's jamo feature is, in spos.
let is i64 as NONE with imut = 0;
let is i64 as LJMO with imut = 1;
let is i64 as VJMO with imut = 2;
let is i64 as TJMO with imut = 3;

fn _is_combining_l(u as i64) as i32 { return cast(i32, u >= L_BASE && u < L_BASE + L_COUNT); }
fn _is_combining_v(u as i64) as i32 { return cast(i32, u >= V_BASE && u < V_BASE + V_COUNT); }
fn _is_combining_t(u as i64) as i32 { return cast(i32, u > T_BASE && u < T_BASE + T_COUNT); }
fn _is_tone(u as i64) as i32 { return cast(i32, u == TONE_1 || u == TONE_2); }
fn _is_syllable(u as i64) as i32 { return cast(i32, u >= S_BASE && u < S_BASE + S_COUNT); }

// The old jamo, outside the modern ranges: leading, vowel and trailing, and the
// extended blocks; these are never composed.
fn _is_l(u as i64) as i32 { return cast(i32, (u >= 4352 && u <= 4447) || (u >= 43360 && u <= 43388)); }
fn _is_v(u as i64) as i32 { return cast(i32, (u >= 4448 && u <= 4519) || (u >= 55216 && u <= 55238)); }
fn _is_t(u as i64) as i32 { return cast(i32, (u >= 4520 && u <= 4607) || (u >= 55243 && u <= 55291)); }

fn collect(w as *work.Work) as void {
    plan.add(w.plan, work.tag("ljmo"), 0);
    plan.add(w.plan, work.tag("vjmo"), 0);
    plan.add(w.plan, work.tag("tjmo"), 0);
}

// Fonts with jamo lookups in calt are not meant to have them applied here.
fn override(w as *work.Work) as void { plan.off(w.plan, work.tag("calt")); }

fn prepared(w as *work.Work) as void {
    w.masks[LJMO] = plan.one_of(w.plan, work.tag("ljmo"));
    w.masks[VJMO] = plan.one_of(w.plan, work.tag("vjmo"));
    w.masks[TJMO] = plan.one_of(w.plan, work.tag("tjmo"));
    w.masks[NONE] = 0;
}

fn _has(w as *work.Work, u as i64) as i32 { return cast(i32, cmap.glyph(w.f, u) != 0); }

// Whether the font draws u with no width of its own.
fn _zero_width(w as *work.Work, u as i64) as i32 {
    let is i64 as g = cmap.glyph(w.f, u);
    return cast(i32, g != 0 && outline.advance_rounded(w.r, g) == 0);
}

// The record g as character u, with feature `kind`.
fn _put(run as *glyphs.Run, g as *glyphs.Glyph, u as i64, kind as i64) as void {
    let is glyphs.Glyph as out = *g;
    out.id = cast(u32, u);
    out.spos = cast(u8, kind);
    glyphs.put(run, &out);
}

// count records from the current one made the one character s.
fn _composed(run as *glyphs.Run, count as i64, s as i64) as void {
    glyphs.join(run, run.n, run.n + count);
    let is glyphs.Glyph as out = *glyphs.cur(run);
    out.id = cast(u32, s);
    out.spos = cast(u8, NONE);
    glyphs.put(run, &out);
    run.i = run.i + count;
}

// A tone mark, the syllable before it having been written from start to end;
// start not below end when there is none. In front of it, the two one cluster,
// unless it has no width; alone, on a dotted circle.
fn _tone(w as *work.Work, run as *glyphs.Run, start as i64, end as i64) as void {
    let is i64 as u = cast(i64, glyphs.cur(run).id);
    if (start < end && end == run.n) {
        glyphs.mark_unsafe(run, start, run.n + 1);
        glyphs.keep(run);
        if (_zero_width(w, u) == 0) {
            glyphs.join(run, start, end + 1);
            let is glyphs.Glyph as tone = run.dst[end];
            let is i64 as k with mut = end;
            while (k > start) {
                run.dst[k] = run.dst[k - 1];
                k = k - 1;
            }
            run.dst[start] = tone;
        }
        return;
    }
    if (w.no_circle == 1 || _has(w, CIRCLE) == 0) {
        glyphs.keep(run);
        return;
    }
    let is glyphs.Glyph as g = *glyphs.cur(run);
    glyphs.drop(run);
    if (_zero_width(w, u) == 0) {
        _put(run, &g, u, NONE);
        _put(run, &g, CIRCLE, NONE);
    } else {
        _put(run, &g, CIRCLE, NONE);
        _put(run, &g, u, NONE);
    }
}

// A leading jamo and its vowel, maybe a trailing one: composed, or marked for
// the font's features and one cluster. The written end of the syllable, into *end.
fn _jamo(w as *work.Work, run as *glyphs.Run, l as i64, v as i64, start as i64, end as *i64) as void {
    let is i64 as t with mut = 0;
    if (run.i + 2 < run.len && _is_t(cast(i64, run.src[run.i + 2].id)) == 1) { t = cast(i64, run.src[run.i + 2].id); }
    let is i64 as count with mut = 2;
    if (t != 0) { count = 3; }
    glyphs.mark_unsafe(run, run.n, run.n + count);
    if (_is_combining_l(l) == 1 && _is_combining_v(v) == 1 && (t == 0 || _is_combining_t(t) == 1)) {
        let is i64 as tindex with mut = 0;
        if (t != 0) { tindex = t - T_BASE; }
        let is i64 as s = S_BASE + (l - L_BASE) * N_COUNT + (v - V_BASE) * T_COUNT + tindex;
        if (_has(w, s) == 1) {
            _composed(run, count, s);
            *end = start + 1;
            return;
        }
    }
    run.src[run.i].spos = cast(u8, LJMO);
    run.src[run.i + 1].spos = cast(u8, VJMO);
    if (t != 0) { run.src[run.i + 2].spos = cast(u8, TJMO); }
    glyphs.keep_n(run, count);
    glyphs.join(run, start, start + count);
    *end = start + count;
}

// A precomposed syllable: with a trailing jamo after it made one when the font
// has it; taken apart when the font does not have it, or a trailing jamo it does
// not compose with follows; else left as it is.
fn _syllable(w as *work.Work, run as *glyphs.Run, s as i64, start as i64, end as *i64) as void {
    let is i64 as si = s - S_BASE;
    let is i32 as has_it = _has(w, s);
    let is i64 as lindex = si / N_COUNT;
    let is i64 as vindex = (si % N_COUNT) / T_COUNT;
    let is i64 as tindex = si % T_COUNT;
    let is i64 as next with mut = 0;
    if (run.i + 1 < run.len) { next = cast(i64, run.src[run.i + 1].id); }
    if (tindex == 0 && _is_combining_t(next) == 1) {
        let is i64 as whole = s + (next - T_BASE);
        if (_has(w, whole) == 1) {
            _composed(run, 2, whole);
            *end = start + 1;
            return;
        }
        glyphs.mark_unsafe(run, run.n, run.n + 2);
    }
    let is i32 as t_follows = cast(i32, tindex == 0 && _is_t(next) == 1);
    if (has_it == 0 || t_follows == 1) {
        let is i64 as l = L_BASE + lindex;
        let is i64 as v = V_BASE + vindex;
        let is i64 as t = T_BASE + tindex;
        if (_has(w, l) == 1 && _has(w, v) == 1 && (tindex == 0 || _has(w, t) == 1)) {
            let is glyphs.Glyph as g = *glyphs.cur(run);
            glyphs.drop(run);
            _put(run, &g, l, LJMO);
            _put(run, &g, v, VJMO);
            if (tindex != 0) { _put(run, &g, t, TJMO); }
            // The trailing jamo it was taken apart for goes with it.
            if (has_it == 1 && tindex == 0) {
                run.src[run.i].spos = cast(u8, TJMO);
                glyphs.keep(run);
            }
            glyphs.join(run, start, run.n);
            *end = run.n;
            return;
        }
        if (t_follows == 1) { glyphs.mark_unsafe(run, run.n, run.n + 2); }
    }
    if (has_it == 1) { *end = start + 1; }
    glyphs.keep(run);
}

// Syllables and jamo as the font can draw them. The last syllable written is
// from start to end, when start is below end.
fn preprocess(w as *work.Work) as void {
    let is *glyphs.Run as run = w.run;
    let is i64 as start with mut = 0;
    let is i64 as end with mut = 0;
    glyphs.begin(run);
    while (glyphs.more(run) == 1) {
        let is i64 as u = cast(i64, glyphs.cur(run).id);
        glyphs.step(run, 1);
        if (_is_tone(u) == 1) {
            _tone(w, run, start, end);
            start = run.n;
            end = run.n;
        } else {
            start = run.n;
            if (_is_l(u) == 1 && run.i + 1 < run.len && _is_v(cast(i64, run.src[run.i + 1].id)) == 1) {
                _jamo(w, run, u, cast(i64, run.src[run.i + 1].id), start, &end);
            } else if (_is_l(u) == 0 && _is_syllable(u) == 1) {
                _syllable(w, run, u, start, &end);
            } else {
                glyphs.keep(run);
            }
        }
    }
    glyphs.end(run);
}

// Each record's feature switched on.
fn setup(w as *work.Work) as void {
    let is *glyphs.Run as run = w.run;
    let is i64 as i with mut = 0;
    while (i < run.len) {
        let is i64 as k = cast(i64, run.src[i].spos);
        if (k >= LJMO && k <= TJMO) { run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | w.masks[k]); }
        i = i + 1;
    }
}
