// text/shape/work.cst — what a script's shaper is given to work with, and what
// it says of itself.
//
// A script's shaper is a few steps put into shape.cst's: the features it wants,
// stage by stage, with pauses between them (collect); the text before any of it
// is looked at (preprocess); glyphs' masks, once it is composed (setup); what is
// done after substitution and after positions. Each keeps what it found out
// in the masks and values here.
use "../sfnt/table.cst" as table;
use "../outline/outline.cst" as outline;
use "glyphs.cst" as glyphs;
use "compose.cst" as compose;
use "plan.cst" as plan;
use "seq.cst" as seq;

let is i64 as K_DEFAULT with imut = 0;
let is i64 as K_ARABIC with imut = 1;
let is i64 as K_HANGUL with imut = 2;
let is i64 as K_THAI with imut = 3;
let is i64 as K_INDIC with imut = 4;
let is i64 as K_KHMER with imut = 5;
let is i64 as K_MYANMAR with imut = 6;
let is i64 as K_USE with imut = 7;

// When marks lose their advance: before GPOS, after it, or never.
let is i64 as ZERO_EARLY with imut = 0;
let is i64 as ZERO_LATE with imut = 1;
let is i64 as ZERO_NONE with imut = 2;

struct Work {
    f        as *table.Face;
    r        as *outline.Reader;
    run      as *glyphs.Run;
    plan     as *plan.Plan;
    ctx      as *seq.Ctx;
    lang     as *u8;
    bytes    as *u8;     // the text, and what is being shaped of it
    n        as i64;
    start    as i64;
    end      as i64;
    script   as i64;     // ISO 15924, as scripts.of says
    chosen   as i64;     // the OpenType script tag GSUB selected; 0 for none
    dir      as i64;     // the direction the run is shaped in
    kind     as i64;     // K_*
    zero     as i64;     // ZERO_*
    fallback as i32;     // marks placed by the shaper when the font has no GPOS
    circle   as i32;     // what a broken syllable is given; 0 for a font without
    no_circle as i32;    // the text asks for none to be put in
    _pad0    as i32;
    rules    as compose.Rules;
    masks    as [32]i64; // what its features' bits are, as each shaper arranges
    values   as [16]i64; // and what else it found out
}

// A feature's tag.
fn tag(s as *u8) as i64 {
    return (cast(i64, s[0]) << 24) | (cast(i64, s[1]) << 16) | (cast(i64, s[2]) << 8) | cast(i64, s[3]);
}

// All the run's records in a .. b made one cluster.
fn merge(run as *glyphs.Run, a as i64, b as i64) as void { glyphs.join(run, a, b); }
