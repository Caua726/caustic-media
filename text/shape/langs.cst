// text/shape/langs.cst — a BCP 47 language tag as OpenType's language
// system tags.
//
// The registry (tables.cst, from Microsoft's OpenType Language System Tags)
// gives each tag the ISO 639-3 languages it stands for; read backwards, a
// language has the tags that name it, in the registry's order. A two-letter
// language is its ISO 639-3 code first. A language the registry does not
// name takes its macrolanguage's tags — Standard Arabic, Arabic's; a
// macrolanguage it does not name has its members', worked out by the tool
// that made tables.cst — Norwegian, Bokmål's and Nynorsk's. Chinese has a tag
// for each way it is written, chosen by the script or the region; the
// phonetic transcriptions have theirs by variant.
use "scripts.cst" as scripts;
use "tables.cst" as tables;

let is i64 as MAX_TAGS with imut = 8;

let is i64 as LANG_RECORD with imut = 24;   // code, count, five tags

// One subtag of a tag being read.
struct Sub {
    at  as i64;
    len as i64;
}

fn _lower(c as i64) as i64 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

fn _is_alpha(c as i64) as i32 { return cast(i32, (c >= 65 && c <= 90) || (c >= 97 && c <= 122)); }

// The subtag starting at at: its length up to the next '-' or '_' or the end.
fn _sub(s as *u8, at as i64) as Sub {
    let is Sub as t;
    t.at = at;
    t.len = 0;
    while (s[at + t.len] != 0 && s[at + t.len] != 45 && s[at + t.len] != 95) { t.len = t.len + 1; }
    return t;
}

// Whether subtag t is word, case aside.
fn _is(s as *u8, t as Sub, word as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < t.len) {
        if (word[i] == 0 || _lower(cast(i64, s[t.at + i])) != cast(i64, word[i])) { return 0; }
        i = i + 1;
    }
    return cast(i32, word[t.len] == 0);
}

// Three letters, lower case, packed as a number for comparing.
fn _code(s as *u8, at as i64, n as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < 3) {
        v = v << 8;
        if (i < n) { v = v | _lower(cast(i64, s[at + i])); }
        i = i + 1;
    }
    return v;
}

fn _table_code(t as *u8, at as i64, n as i64) as i64 { return _code(t, at, n); }

// A record of fixed width, sorted by its first `width` letters, holding key;
// its start, or -1.
fn _find(t as *u8, count as i64, size as i64, width as i64, key as i64) as i64 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = count - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is i64 as k = _table_code(t, mid * size, width);
        if (key < k) { hi = mid - 1; } else if (key > k) { lo = mid + 1; } else { return mid * size; }
    }
    return 0 - 1;
}

fn _tag_at(t as *u8, at as i64) as i64 { return scripts.of(cast(*u8, cast(i64, t) + at)); }

fn _add(out as *i64, n as i64, max as i64, tag as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (out[i] == tag) { return n; }
        i = i + 1;
    }
    if (n >= max) { return n; }
    out[n] = tag;
    return n + 1;
}

// The registry's tags for ISO 639-3 code, added to out.
fn _registry(code as i64, out as *i64, n0 as i64, max as i64) as i64 {
    let is i64 as n with mut = n0;
    let is i64 as rec = _find(tables.LANGS, tables.LANG_COUNT, LANG_RECORD, 3, code);
    if (rec < 0) { return n; }
    let is i64 as count = cast(i64, tables.LANGS[rec + 3]) - 48;
    let is i64 as i with mut = 0;
    while (i < count) {
        n = _add(out, n, max, _tag_at(tables.LANGS, rec + 4 + i * 4));
        i = i + 1;
    }
    return n;
}

// The tags of code, or of its macrolanguage when it has none.
fn _language(code as i64, out as *i64, n0 as i64, max as i64) as i64 {
    let is i64 as n = _registry(code, out, n0, max);
    if (n > n0) { return n; }
    let is i64 as m = _find(tables.MACRO, tables.MACRO_COUNT, 6, 3, code);
    if (m < 0) { return n; }
    return _registry(_table_code(tables.MACRO, m + 3, 3), out, n, max);
}

// Chinese, by how it is written: traditional in Hong Kong, Macao and
// Taiwan or when the script says so, simplified otherwise.
fn _chinese(s as *u8, script as Sub, region as Sub, out as *i64, n0 as i64, max as i64) as i64 {
    let is i64 as n with mut = n0;
    if (_is(s, region, "hk") == 1) { return _add(out, n, max, scripts.of("ZHH ")); }
    if (_is(s, region, "mo") == 1) {
        n = _add(out, n, max, scripts.of("ZHTM"));
        return _add(out, n, max, scripts.of("ZHH "));
    }
    if (_is(s, region, "tw") == 1 || _is(s, script, "hant") == 1) { return _add(out, n, max, scripts.of("ZHT ")); }
    return _add(out, n, max, scripts.of("ZHS "));
}

// lang's OpenType tags into out — at most max — the one to try first
// first; how many. None for a language the registry does not know.
fn tags(lang as *u8, out as *i64, max as i64) as i64 {
    let is i64 as n with mut = 0;
    if (cast(i64, lang) == 0 || lang[0] == 0) { return 0; }
    let is Sub as primary = _sub(lang, 0);
    let is Sub as script with mut;
    script.at = 0;
    script.len = 0;
    let is Sub as region with mut;
    region.at = 0;
    region.len = 0;
    // The subtags after the language: its script, region and variants.
    let is i64 as at with mut = primary.len;
    while (lang[at] != 0) {
        at = at + 1;
        let is Sub as t = _sub(lang, at);
        if (t.len == 1) {
            // An extension or private use: what follows is not for us.
            while (lang[at] != 0) { at = at + 1; }
        } else {
            if (t.len == 4 && _is_alpha(cast(i64, lang[t.at])) == 1) { script = t; }
            else if (t.len == 2 && _is_alpha(cast(i64, lang[t.at])) == 1) { region = t; }
            else if (_is(lang, t, "fonipa") == 1) { n = _add(out, n, max, scripts.of("IPPH")); }
            else if (_is(lang, t, "fonnapa") == 1) { n = _add(out, n, max, scripts.of("APPH")); }
            else if (_is(lang, t, "fonupa") == 1) { n = _add(out, n, max, scripts.of("UPPH")); }
            at = at + t.len;
        }
    }
    if (primary.len != 2 && primary.len != 3) { return n; }
    let is i64 as code with mut = _code(lang, primary.at, primary.len);
    if (primary.len == 2) {
        let is i64 as k = _find(tables.ISO1, tables.ISO1_COUNT, 5, 2, _code(lang, primary.at, 2));
        if (k < 0) { return n; }
        code = _table_code(tables.ISO1, k + 2, 3);
    }
    if (code == _code("zho", 0, 3) || code == _code("cmn", 0, 3)) { return _chinese(lang, script, region, out, n, max); }
    return _language(code, out, n, max);
}
