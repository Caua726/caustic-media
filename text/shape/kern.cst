// text/shape/kern.cst — the legacy kern table applied, for fonts whose GPOS
// does not kern: each glyph the kern feature applies to moved closer to the
// next one, or further from it, by the table's value for the pair (read by
// ../sfnt/kern.cst). Marks and default ignorables between the two are passed
// over, as GPOS's kerning lookups pass over them.
//
// The adjustment is shared: half goes to the first glyph's advance, the
// rest to the second's advance and, back, to its offset — the second is
// drawn where it would have been, and a caret between the two sits in the
// middle of the gap they close.
use "../sfnt/table.cst" as table;
use "../sfnt/kern.cst" as legacy;
use "glyphs.cst" as glyphs;

// Whether the face has a kern table the shaper reads: version 0 with
// subtables.
fn present(f as *table.Face) as i32 {
    let is table.Table as t = f.kern;
    if (table.inside(t, t.off, 4) == 0) { return 0; }
    return cast(i32, table.u16_at(f, t.off) == 0 && table.u16_at(f, t.off + 2) > 0);
}

fn _passed(g as *glyphs.Glyph) as i32 {
    return cast(i32, g.cls == cast(u8, glyphs.MARK) || (cast(i64, g.uflags) & glyphs.U_IGNORABLE) != 0);
}

fn apply(f as *table.Face, run as *glyphs.Run, mask as i64) as void {
    let is i64 as i with mut = 0;
    while (i < run.len) {
        let is *glyphs.Glyph as g = &run.src[i];
        if ((cast(i64, g.mask) & mask) != 0 && _passed(g) == 0) {
            let is i64 as j with mut = i + 1;
            while (j < run.len && _passed(&run.src[j]) == 1) { j = j + 1; }
            // A pair is kerned when the feature applies to both of it.
            if (j < run.len && (cast(i64, run.src[j].mask) & mask) != 0) {
                let is i64 as v = legacy.pair(f, cast(i64, g.id), cast(i64, run.src[j].id));
                if (v != 0) {
                    let is i64 as half with mut = v / 2;
                    if (half * 2 > v) { half = half - 1; }
                    let is i64 as rest = v - half;
                    run.place[i].xa = cast(i32, cast(i64, run.place[i].xa) + half);
                    run.place[j].xa = cast(i32, cast(i64, run.place[j].xa) + rest);
                    run.place[j].xo = cast(i32, cast(i64, run.place[j].xo) + rest);
                    glyphs.mark_unsafe(run, i, j + 1);
                }
            }
        }
        i = i + 1;
    }
}
