// text/shape/kern.cst — the legacy kern table, as shaping uses it: applied
// when GPOS does not kern, and read for what it holds that changes how
// marks are positioned.
//
// Two layouts share the tag: Microsoft's, version 0 with 16-bit counts and
// six-byte subtable headers; Apple's, version 1.0 with 32-bit ones and
// eight-byte headers. Subtables are walked by their lengths, as HarfBuzz
// walks them.
use "../sfnt/table.cst" as table;

// Whether the face has a kern table that says anything: its first four
// bytes are not all zero.
fn has_kerning(f as *table.Face) as i32 {
    let is table.Table as t = f.kern;
    if (table.inside(t, t.off, 4) == 0) { return 0; }
    if (table.u32_at(f, t.off) != 0) { return 1; }
    return 0;
}

fn _major(f as *table.Face) as i64 { return table.u16_at(f, f.kern.off); }

// Each subtable's format and coverage bits, in Microsoft's layout or
// Apple's; what() 1 for a state machine (format 1), 2 for cross-stream.
fn _any(f as *table.Face, what as i64) as i32 {
    let is table.Table as t = f.kern;
    if (has_kerning(f) == 0) { return 0; }
    let is i64 as major = _major(f);
    let is i64 as n with mut = 0;
    let is i64 as st with mut = 0;
    if (major == 0) {
        n = table.u16_at(f, t.off + 2);
        st = t.off + 4;
    } else if (major == 1) {
        n = table.u32_at(f, t.off + 4);
        st = t.off + 8;
    } else {
        return 0;
    }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as len with mut = 0;
        let is i64 as fmt with mut = 0;
        let is i64 as cross with mut = 0;
        if (major == 0) {
            if (table.inside(t, st, 6) == 0) { return 0; }
            len = table.u16_at(f, st + 2);
            fmt = table.u8_at(f, st + 4);
            cross = table.u8_at(f, st + 5) & 4;
        } else {
            if (table.inside(t, st, 8) == 0) { return 0; }
            len = table.u32_at(f, st);
            fmt = table.u8_at(f, st + 5);
            cross = table.u8_at(f, st + 4) & 64;
        }
        if (what == 1 && fmt == 1) { return 1; }
        if (what == 2 && cross != 0) { return 1; }
        if (len <= 0) { return 0; }
        st = st + len;
        i = i + 1;
    }
    return 0;
}

fn has_state_machine(f as *table.Face) as i32 { return _any(f, 1); }
fn has_cross_stream(f as *table.Face) as i32 { return _any(f, 2); }
