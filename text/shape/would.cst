// text/shape/would.cst — whether a feature would substitute a few glyphs,
// without doing it: how a shaper asks the font which consonants have below-base
// or post-base forms, which the specifications for Indic scripts settle by
// asking just that. With zero_context, a rule that needs anything around the
// glyphs given does not count.
use "../sfnt/table.cst" as table;
use "otl.cst" as otl;
use "plan.cst" as plan;

let is i64 as SINGLE with imut = 1;
let is i64 as MULTIPLE with imut = 2;
let is i64 as ALTERNATE with imut = 3;
let is i64 as LIGATURE with imut = 4;
let is i64 as CONTEXT with imut = 5;
let is i64 as CHAIN with imut = 6;
let is i64 as EXTENSION with imut = 7;

fn _u(f as *table.Face, l as *otl.Layout, at as i64) as i64 { return otl.u16(f, l.t, at); }

fn _cov(f as *table.Face, l as *otl.Layout, st as i64, off as i64, g as i64) as i64 {
    return otl.coverage(f, l.t, otl.off16(f, l.t, st, off), g);
}

fn _ligature(f as *table.Face, l as *otl.Layout, st as i64, g as *i64, n as i64) as i32 {
    let is i64 as c = _cov(f, l, st, st + 2, g[0]);
    if (c == otl.NONE || c >= _u(f, l, st + 4)) { return 0; }
    let is i64 as set = otl.off16(f, l.t, st, st + 6 + c * 2);
    if (set == 0) { return 0; }
    let is i64 as count = _u(f, l, set);
    let is i64 as i with mut = 0;
    while (i < count) {
        let is i64 as lig = otl.off16(f, l.t, set, set + 2 + i * 2);
        if (lig != 0 && _u(f, l, lig + 2) == n) {
            let is i32 as same with mut = 1;
            let is i64 as k with mut = 1;
            while (k < n) {
                if (_u(f, l, lig + 4 + (k - 1) * 2) != g[k]) { same = 0; }
                k = k + 1;
            }
            if (same == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

// Whether the input at vals, count items from the first, is the glyphs given:
// by glyph, or by class in the class definition cd.
fn _input(f as *table.Face, l as *otl.Layout, count as i64, vals as i64, cd as i64, g as *i64, n as i64) as i32 {
    if (count != n) { return 0; }
    let is i64 as k with mut = 1;
    while (k < n) {
        let is i64 as v = _u(f, l, vals + (k - 1) * 2);
        let is i64 as have with mut = g[k];
        if (cd != 0) { have = otl.class_of(f, l.t, cd, g[k]); }
        if (v != have) { return 0; }
        k = k + 1;
    }
    return 1;
}

fn _context(f as *table.Face, l as *otl.Layout, st as i64, g as *i64, n as i64) as i32 {
    let is i64 as format = _u(f, l, st);
    if (format == 3) {
        let is i64 as count = _u(f, l, st + 2);
        if (count != n) { return 0; }
        let is i64 as k with mut = 0;
        while (k < n) {
            if (_cov(f, l, st, st + 6 + k * 2, g[k]) == otl.NONE) { return 0; }
            k = k + 1;
        }
        return 1;
    }
    let is i64 as c = _cov(f, l, st, st + 2, g[0]);
    if (c == otl.NONE) { return 0; }
    let is i64 as cd with mut = 0;
    let is i64 as index with mut = c;
    let is i64 as nsets with mut = 0;
    let is i64 as sets with mut = 0;
    if (format == 1) {
        nsets = _u(f, l, st + 4);
        sets = st + 6;
    } else if (format == 2) {
        cd = otl.off16(f, l.t, st, st + 4);
        index = otl.class_of(f, l.t, cd, g[0]);
        nsets = _u(f, l, st + 6);
        sets = st + 8;
    } else {
        return 0;
    }
    if (index >= nsets) { return 0; }
    let is i64 as set = otl.off16(f, l.t, st, sets + index * 2);
    if (set == 0) { return 0; }
    let is i64 as rules = _u(f, l, set);
    let is i64 as i with mut = 0;
    while (i < rules) {
        let is i64 as rule = otl.off16(f, l.t, set, set + 2 + i * 2);
        if (rule != 0 && _input(f, l, _u(f, l, rule), rule + 4, cd, g, n) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _chain(f as *table.Face, l as *otl.Layout, st as i64, g as *i64, n as i64, zero as i32) as i32 {
    let is i64 as format = _u(f, l, st);
    if (format == 3) {
        let is i64 as nback = _u(f, l, st + 2);
        let is i64 as at = st + 4 + nback * 2;
        let is i64 as count = _u(f, l, at);
        let is i64 as nahead = _u(f, l, at + 2 + count * 2);
        if (zero == 1 && (nback != 0 || nahead != 0)) { return 0; }
        if (count != n) { return 0; }
        let is i64 as k with mut = 0;
        while (k < n) {
            if (_cov(f, l, st, at + 2 + k * 2, g[k]) == otl.NONE) { return 0; }
            k = k + 1;
        }
        return 1;
    }
    let is i64 as c = _cov(f, l, st, st + 2, g[0]);
    if (c == otl.NONE) { return 0; }
    let is i64 as cd with mut = 0;
    let is i64 as index with mut = c;
    let is i64 as nsets with mut = 0;
    let is i64 as sets with mut = 0;
    if (format == 1) {
        nsets = _u(f, l, st + 4);
        sets = st + 6;
    } else if (format == 2) {
        cd = otl.off16(f, l.t, st, st + 6);
        index = otl.class_of(f, l.t, cd, g[0]);
        nsets = _u(f, l, st + 10);
        sets = st + 12;
    } else {
        return 0;
    }
    if (index >= nsets) { return 0; }
    let is i64 as set = otl.off16(f, l.t, st, sets + index * 2);
    if (set == 0) { return 0; }
    let is i64 as rules = _u(f, l, set);
    let is i64 as i with mut = 0;
    while (i < rules) {
        let is i64 as rule = otl.off16(f, l.t, set, set + 2 + i * 2);
        if (rule != 0) {
            let is i64 as nback = _u(f, l, rule);
            let is i64 as at = rule + 2 + nback * 2;
            let is i64 as count = _u(f, l, at);
            let is i64 as nahead = _u(f, l, at + 2 + (count - 1) * 2);
            if ((zero == 0 || (nback == 0 && nahead == 0)) && _input(f, l, count, at + 2, cd, g, n) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

fn _subtable(f as *table.Face, l as *otl.Layout, kind0 as i64, st0 as i64, g as *i64, n as i64, zero as i32) as i32 {
    let is i64 as kind with mut = kind0;
    let is i64 as st with mut = st0;
    if (kind == EXTENSION) {
        kind = _u(f, l, st + 2);
        st = st + otl.u32(f, l.t, st + 4);
    }
    if (kind == SINGLE || kind == MULTIPLE || kind == ALTERNATE) {
        return cast(i32, n == 1 && _cov(f, l, st, st + 2, g[0]) != otl.NONE);
    }
    if (kind == LIGATURE) { return _ligature(f, l, st, g, n); }
    if (kind == CONTEXT) { return _context(f, l, st, g, n); }
    if (kind == CHAIN) { return _chain(f, l, st, g, n, zero); }
    return 0;
}

// Whether feature tag, wanted in a stage of its own, would substitute the n
// glyphs at g.
fn would_substitute(f as *table.Face, p as *plan.Plan, tag as i64, g as *i64, n as i64, zero as i32) as i32 {
    let is *plan.Feature as ft = plan.feature(p, tag);
    if (cast(i64, ft) == 0 || ft.index0 == otl.NONE || p.gsub.ok == 0) { return 0; }
    let is *otl.Layout as l = &p.gsub;
    let is i64 as fe = otl.feature(f, l, ft.index0, p.var0);
    let is i64 as count = otl.feature_lookup_count(f, l, fe);
    let is i64 as i with mut = 0;
    while (i < count) {
        let is i64 as lk = otl.lookup(f, l, otl.feature_lookup(f, l, fe, i));
        if (lk != 0) {
            let is i64 as kind = otl.lookup_type(f, l, lk);
            let is i64 as subs = otl.subtable_count(f, l, lk);
            let is i64 as k with mut = 0;
            while (k < subs) {
                let is i64 as st = otl.subtable(f, l, lk, k);
                if (st != 0 && _subtable(f, l, kind, st, g, n, zero) == 1) { return 1; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}
