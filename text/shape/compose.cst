// text/shape/compose.cst — characters decomposed and composed as the font can
// draw them: Unicode's canonical normalization (UAX #15), with the font as
// the judge of which form to keep.
//
// Within each grapheme: a character the font has no glyph for is replaced by
// its canonical decomposition, as far down as the font needs — each piece
// kept when the font has it, decomposed further when not — if that ends in
// pieces the font has; marks are put in canonical order, by combining class;
// then a mark is composed into the character before it when the two have a
// canonical composition the font has a glyph for, and nothing between them
// blocks it (UAX #15's rule). So `e` + `◌́` and `é` come out alike, whichever
// the font has, and a font with neither draws both pieces.
//
// A space the font has no glyph for is drawn with its space, at the width
// chars.space_kind says; a non-breaking hyphen with its hyphen.
//
// A script's shaper has its say through Rules: some want everything taken apart
// as far as the font can and then put together again, whatever the font has
// (PARTS) — a split vowel, an Indic letter with its nukta — some nothing put
// together at all (KEEP); some have parts of their own for a character,
// compositions to leave alone, and an order of their own for marks.
use "../sfnt/table.cst" as table;
use "../sfnt/cmap.cst" as cmap;
use "caustic-unicode/src/ucd/tables/decomp.cst" as dec;
use "caustic-unicode/src/normalize/normalize.cst" as norm;
use "glyphs.cst" as glyphs;
use "chars.cst" as chars;

// Runs of marks longer than this are left in the order they came in: no
// text needs them reordered, and sorting them costs the square of their
// length.
let is i64 as MAX_MARKS with imut = 32;

let is i64 as HANGUL_S with imut = 44032;
let is i64 as HANGUL_L with imut = 4352;
let is i64 as HANGUL_V with imut = 4449;
let is i64 as HANGUL_T with imut = 4519;
let is i64 as HANGUL_COUNT with imut = 11172;

let is i64 as FONT with imut = 0;    // a character the font has stays, unless it has marks to go with
let is i64 as PARTS with imut = 1;   // all taken apart as far as the font can, then composed
let is i64 as KEEP with imut = 2;    // a character the font has stays, and nothing is composed

type DecomposeFn = fn(i64, *i64) as i64;
type ComposeFn = fn(i64, i64) as i64;
type ReorderFn = fn(*glyphs.Run, i64, i64) as void;

struct Rules {
    mode      as i64;
    decompose as DecomposeFn;   // u into parts: how many; null for Unicode's
    compose   as ComposeFn;     // a and b as one; 0 for none; null for Unicode's
    reorder   as ReorderFn;     // what to do after a run of marks is sorted, a .. b of what is written
}

fn nominal(f as *table.Face, u as i64) as i64 { return cmap.glyph(f, u); }

// u's canonical decomposition, one level, into parts: how many (0 for none).
fn decompose_once(u as i64, parts as *i64) as i64 {
    if (u >= HANGUL_S && u < HANGUL_S + HANGUL_COUNT) {
        let is i64 as s = u - HANGUL_S;
        let is i64 as t = s % 28;
        if (t != 0) {
            parts[0] = u - t;
            parts[1] = HANGUL_T + t;
        } else {
            parts[0] = HANGUL_L + s / 588;
            parts[1] = HANGUL_V + (s % 588) / 28;
        }
        return 2;
    }
    let is i32 as m = dec.decomp_get(cast(i32, u));
    if (m == 0) { return 0; }
    let is i64 as rec = cast(i64, dec.decomp_meta_at(m));
    let is i64 as off = rec & 1048575;
    let is i64 as n = (rec >> 20) & 255;
    if (((rec >> 28) & 1) != 0 || n < 1 || n > 2) { return 0; }
    let is i64 as i with mut = 0;
    while (i < n) {
        parts[i] = cast(i64, dec.decomp_pool_at(cast(i32, off + i)));
        i = i + 1;
    }
    return n;
}

// u's parts as rules has it: its shaper's say first.
fn _parts(rules as *Rules, u as i64, parts as *i64) as i64 {
    if (cast(i64, rules.decompose) != 0) { return call(rules.decompose, u, parts); }
    return decompose_once(u, parts);
}

// Decomposed as the font can draw it, into out from n: the new count, or -1 when
// it cannot be. The second part has to be a glyph of the font; the first, if
// shortest, stops there when the font has it, or else goes as far down as the
// font has the pieces.
fn _expand(f as *table.Face, u as i64, out as *i64, n as i64, depth as i64, shortest as i32, rules as *Rules) as i64 {
    if (depth > 8 || n >= 62) { return 0 - 1; }
    let is [2]i64 as parts;
    let is i64 as k = _parts(rules, u, cast(*i64, &parts));
    if (k == 0) { return 0 - 1; }
    if (k == 2 && nominal(f, parts[1]) == 0) { return 0 - 1; }
    let is i32 as has_first = cast(i32, nominal(f, parts[0]) != 0);
    let is i64 as m with mut = 0 - 1;
    if (shortest == 0 || has_first == 0) {
        m = _expand(f, parts[0], out, n, depth + 1, shortest, rules);
    }
    if (m < 0) {
        if (has_first == 0) { return 0 - 1; }
        out[n] = parts[0];
        m = n + 1;
    }
    if (k == 2) {
        out[m] = parts[1];
        m = m + 1;
    }
    return m;
}

// g with character u in its place: what Unicode says of u, its glyph.
fn _as(f as *table.Face, g as *glyphs.Glyph, u as i64) as void {
    g.id = cast(u32, u);
    g.cat = cast(u8, chars.category(u));
    g.ccc = cast(u8, chars.shaping_class(u));
    g.alt = cast(u32, nominal(f, u));
}

// The current record written as the font can draw it: keeping what the font has
// when shortest, as far decomposed as it can be when not.
fn _decompose(f as *table.Face, r as *glyphs.Run, shortest as i32, rules as *Rules) as void {
    let is glyphs.Glyph as g = *glyphs.cur(r);
    let is i64 as u = cast(i64, g.id);
    let is i64 as have = nominal(f, u);
    if (shortest == 1 && have != 0) {
        g.alt = cast(u32, have);
        glyphs.put(r, &g);
        glyphs.drop(r);
        return;
    }
    let is [64]i64 as pieces;
    let is i64 as n = _expand(f, u, cast(*i64, &pieces), 0, 0, shortest, rules);
    if (n > 0) {
        let is i64 as i with mut = 0;
        while (i < n) {
            let is glyphs.Glyph as piece = g;
            _as(f, &piece, pieces[i]);
            glyphs.put(r, &piece);
            i = i + 1;
        }
        glyphs.drop(r);
        return;
    }
    if (have != 0) {
        g.alt = cast(u32, have);
        glyphs.put(r, &g);
        glyphs.drop(r);
        return;
    }
    let is i64 as kind = chars.space_kind(u);
    let is i64 as space = nominal(f, 32);
    if (kind != chars.NOT_SPACE && space != 0) {
        g.alt = cast(u32, space);
        g.space = cast(u8, kind);
        g.uflags = cast(u8, cast(i64, g.uflags) | glyphs.U_FALLBACK_SPACE);
    } else if (u == 8209) {
        // A non-breaking hyphen looks like a hyphen.
        g.alt = cast(u32, nominal(f, 8208));
    }
    glyphs.put(r, &g);
    glyphs.drop(r);
}

// Records a .. b of what was written, marks in canonical order: each run of
// them sorted by class (chars.order_class), stably, then as its shaper says.
fn _order(r as *glyphs.Run, a as i64, b as i64, rules as *Rules) as void {
    let is i64 as i with mut = a;
    while (i < b) {
        if (r.dst[i].ccc == cast(u8, 0)) {
            i = i + 1;
        } else {
            let is i64 as end with mut = i;
            while (end < b && r.dst[end].ccc != cast(u8, 0)) { end = end + 1; }
            if (end - i <= MAX_MARKS) {
                let is i64 as k with mut = i + 1;
                while (k < end) {
                    let is glyphs.Glyph as x = r.dst[k];
                    let is i64 as j with mut = k;
                    let is i64 as xc = chars.order_class(cast(i64, x.ccc));
                    while (j > i && chars.order_class(cast(i64, r.dst[j - 1].ccc)) > xc) {
                        r.dst[j] = r.dst[j - 1];
                        j = j - 1;
                    }
                    r.dst[j] = x;
                    k = k + 1;
                }
                if (cast(i64, rules.reorder) != 0) { call(rules.reorder, r, i, end); }
            }
            i = end;
        }
    }
}

// Records a .. of what was written composed where the font can; the new
// end of them.
fn _compose(f as *table.Face, r as *glyphs.Run, a as i64, b as i64, rules as *Rules) as i64 {
    if (b - a < 2) { return b; }
    let is i64 as w with mut = a + 1;       // where the next kept record goes
    let is i64 as starter with mut = 0 - 1;
    if (r.dst[a].ccc == cast(u8, 0)) { starter = a; }
    let is i64 as last_ccc with mut = 0 - 1;  // of the last record kept after the starter; -1 for none
    let is i64 as i with mut = a + 1;
    while (i < b) {
        let is glyphs.Glyph as m = r.dst[i];
        let is i64 as ccc = chars.order_class(cast(i64, m.ccc));
        let is i32 as done with mut = 0;
        if (starter >= 0 && chars.is_mark(cast(i64, m.cat)) == 1 && (last_ccc < 0 || (last_ccc < ccc && last_ccc != 0))) {
            let is i64 as both with mut = 0;
            if (cast(i64, rules.compose) != 0) {
                both = call(rules.compose, cast(i64, r.dst[starter].id), cast(i64, m.id));
            } else {
                both = cast(i64, norm.compose_pair(cast(i32, r.dst[starter].id), cast(i32, m.id)));
            }
            if (both > 0) {
                let is i64 as g = nominal(f, both);
                if (g != 0) {
                    _as(f, &r.dst[starter], both);
                    done = 1;
                }
            }
        }
        if (done == 0) {
            r.dst[w] = m;
            if (ccc == 0) {
                starter = w;
                last_ccc = 0 - 1;
            } else {
                last_ccc = ccc;
            }
            w = w + 1;
        }
        i = i + 1;
    }
    return w;
}

// Whether the grapheme a .. of what is still to read, sharing cluster, has marks
// to go with its base, and so is more than one character to decompose together;
// a variation selector chooses from what the character is, and keeps it.
fn _is_many(r as *glyphs.Run, cluster as u32) as i32 {
    let is i64 as k with mut = r.i;
    let is i32 as marks with mut = 0;
    while (k < r.len && r.src[k].cluster == cluster) {
        if (chars.is_variation_selector(cast(i64, r.src[k].id)) == 1) { return 0; }
        if (chars.is_mark(cast(i64, r.src[k].cat)) == 1) { marks = 1; }
        k = k + 1;
    }
    return marks;
}

// Whether a mark comes after the first record of the run: with none, what was
// taken apart stays so, whatever its parts could make.
fn _has_marks(r as *glyphs.Run) as i32 {
    let is i64 as k with mut = 1;
    while (k < r.len) {
        if (chars.is_mark(cast(i64, r.src[k].cat)) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

// Whether the grapheme at what is still to read has marks of its own.
fn _has_own_marks(r as *glyphs.Run, cluster as u32) as i32 {
    let is i64 as k with mut = r.i;
    while (k < r.len && r.src[k].cluster == cluster) {
        if (chars.is_mark(cast(i64, r.src[k].cat)) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

// The run, a grapheme at a time, as the font can draw it and rules says.
fn compose(f as *table.Face, r as *glyphs.Run, rules as *Rules) as void {
    let is i32 as marks = _has_marks(r);
    let is i32 as by_others with mut = 0;   // something was composed for marks not its own
    glyphs.begin(r);
    while (glyphs.more(r) == 1) {
        let is i64 as a = r.n;
        let is u32 as cluster = glyphs.cur(r).cluster;
        let is i32 as shortest with mut = 1;
        let is i32 as own with mut = _has_own_marks(r, cluster);
        if (rules.mode != KEEP && (rules.mode == PARTS || _is_many(r, cluster) == 1)) { shortest = 0; }
        while (glyphs.more(r) == 1 && glyphs.cur(r).cluster == cluster) { _decompose(f, r, shortest, rules); }
        if (r.ok == 1 && r.n - a > 1 && marks == 1) {
            _order(r, a, r.n, rules);
            if (rules.mode != KEEP) {
                let is i64 as before = r.n;
                r.n = _compose(f, r, a, r.n, rules);
                if (r.n != before && own == 0) { by_others = 1; }
            }
        }
        glyphs.step(r, 1);
    }
    glyphs.end(r);
    // Cut anywhere, the part with it might have no mark to compose it.
    if (by_others == 1) { glyphs.mark_unsafe(r, 0, r.len); }
}
