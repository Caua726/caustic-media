// text/shape/use.cst — the Universal Shaping Engine: the many scripts Microsoft's
// "Creating and supporting OpenType fonts for the Universal Shaping Engine" says
// need no shaper of their own, each character categorized from its properties
// (use_table.cst, generated) and put through the same grammar and few reorderings.
// Also the Indic scripts, for fonts with the newest tags (dev3 and its like).
use "glyphs.cst" as glyphs;
use "chars.cst" as chars;
use "compose.cst" as compose;
use "plan.cst" as plan;
use "scripts.cst" as scripts;
use "work.cst" as work;
use "arabic.cst" as arabic;
use "syllable.cst" as syllable;
use "use_table.cst" as table;
use "caustic-unicode/src/normalize/normalize.cst" as norm;

// The categories that are asked about by name, as letters of the grammars.
let is i64 as C_OTHER with imut = 79;        // O
let is i64 as C_BASE with imut = 66;         // B
let is i64 as C_ZWNJ with imut = 122;        // z
let is i64 as C_R with imut = 82;            // R a repha
let is i64 as C_CGJ with imut = 99;          // c
let is i64 as C_H with imut = 72;            // H a halant
let is i64 as C_HVM with imut = 86;          // V a halant or vowel modifier
let is i64 as C_IS with imut = 73;           // I an invisible stacker
let is i64 as C_VPRE with imut = 116;        // t
let is i64 as C_VMPRE with imut = 67;        // C

let is i64 as S_VIRAMA with imut = 0;
let is i64 as S_SAKOT with imut = 1;
let is i64 as S_STANDARD with imut = 2;
let is i64 as S_NUMBER_JOINER with imut = 3;
let is i64 as S_NUMERAL with imut = 4;
let is i64 as S_SYMBOL with imut = 5;
let is i64 as S_HIEROGLYPH with imut = 6;
let is i64 as S_NONE with imut = 7;
let is i64 as S_BROKEN with imut = 8;

let is syllable.Grammar as G_VIRAMA with mut;
let is syllable.Grammar as G_SAKOT with mut;
let is syllable.Grammar as G_STANDARD with mut;
let is syllable.Grammar as G_NUMBER_JOINER with mut;
let is syllable.Grammar as G_NUMERAL with mut;
let is syllable.Grammar as G_SYMBOL with mut;
let is syllable.Grammar as G_HIEROGLYPH with mut;
let is syllable.Grammar as G_NONE with mut;
let is syllable.Grammar as G_BROKEN with mut;

// Letters: O other, B base, N number, g generic base, u subjoined, H halant, n
// number joiner, z ZWNJ, R repha, T consonant with stacker, I invisible stacker, G
// hieroglyph, J its joiner, s and e its segment begin and end, x its mirror, m its
// modifier, V halant or vowel modifier, k reordering killer, K sakot; a b f final
// consonants above, below, after; d h i j medials above, below, after, before; l o
// consonant modifiers above, below; p q r t vowels above, below, after, before; v y
// A C vowel modifiers above, below, after, before; D E symbol modifiers above,
// below; F L M final modifiers above, below, after.
//
// Written out from these:
//   h = (H|V|I|K); cmods = l* o* ((h B|u) l* o*)*; medial = j? d? h? i?
//   dep = (t* p* q* r* | H | k); vmods = V? C* v* y* A*; finals = a* b* f*
//   fmods = (F* L* | M?); start = (R|T)? (B|g); middle = cmods medial dep vmods (K B)*
//   tail = middle finals fmods; njt = (n N)* n; numt = (n N)+; sym = (D+ E* | E+)
//   virama = start cmods I; sakot = start middle K; standard = start tail
//   any = (tail | middle K | sym | cmods I)
//   broken = R? (any | njt | numt); number_joiner = N njt; numeral = N numt?
//   symbol = (O|g|s) any; hieroglyph = s* G x? m? e* (J e* (G x? m? e*)?)*
// each but a lone final modifier with a ZWNJ allowed to end it.
let is *u8 as W_VIRAMA with imut = "(R|T)?(B|g)l*o*(((H|V|I|K)B|u)l*o*)*Iz?";
let is *u8 as W_SAKOT with imut = "(R|T)?(B|g)l*o*(((H|V|I|K)B|u)l*o*)*j?d?h?i?(t*p*q*r*|H|k)V?C*v*y*A*(KB)*Kz?";
let is *u8 as W_STANDARD with imut = "(R|T)?(B|g)l*o*(((H|V|I|K)B|u)l*o*)*j?d?h?i?(t*p*q*r*|H|k)V?C*v*y*A*(KB)*a*b*f*(F*L*|M?)z?";
let is *u8 as W_NUMBER_JOINER with imut = "N(nN)*nz?";
let is *u8 as W_NUMERAL with imut = "N((nN)(nN)*)?z?";
let is *u8 as W_SYMBOL with imut = "(O|g|s)(l*o*(((H|V|I|K)B|u)l*o*)*j?d?h?i?(t*p*q*r*|H|k)V?C*v*y*A*(KB)*a*b*f*(F*L*|M?)|l*o*(((H|V|I|K)B|u)l*o*)*j?d?h?i?(t*p*q*r*|H|k)V?C*v*y*A*(KB)*K|(D(D)*E*|E(E)*)|l*o*(((H|V|I|K)B|u)l*o*)*I)z?";
let is *u8 as W_HIEROGLYPH with imut = "s*Gx?m?e*(Je*(Gx?m?e*)?)*z?";
let is *u8 as W_NONE with imut = "M";
let is *u8 as W_BROKEN with imut = "R?((l*o*(((H|V|I|K)B|u)l*o*)*j?d?h?i?(t*p*q*r*|H|k)V?C*v*y*A*(KB)*a*b*f*(F*L*|M?)|l*o*(((H|V|I|K)B|u)l*o*)*j?d?h?i?(t*p*q*r*|H|k)V?C*v*y*A*(KB)*K|(D(D)*E*|E(E)*)|l*o*(((H|V|I|K)B|u)l*o*)*I)|(nN)*n|(nN)(nN)*)z?";

let is i64 as V_RPHF with imut = 0;     // work.values: its bits
let is i64 as V_JOINING with imut = 1;  // a script whose letters join
let is i64 as V_BROKEN with imut = 2;

fn is_script(s as i64) as i32 { return _in_list(s); }

fn _in_list(s as i64) as i32 {
    let is *u8 as list = "";
    let is i64 as i with mut = 0;
    while (list[i] != cast(u8, 0)) {
        if (scripts.of(cast(*u8, cast(i64, list) + i)) == s) { return 1; }
        i = i + 4;
    }
    return 0;
}

fn _has_joining(s as i64) as i32 {
    return cast(i32, s == scripts.of("Adlm") || s == scripts.of("Arab") || s == scripts.of("Chrs") || s == scripts.of("Rohg") ||
                     s == scripts.of("Mand") || s == scripts.of("Mani") || s == scripts.of("Mong") || s == scripts.of("Nkoo") ||
                     s == scripts.of("Ougr") || s == scripts.of("Phag") || s == scripts.of("Phlp") || s == scripts.of("Sogd") ||
                     s == scripts.of("Syrc"));
}

fn collect(w as *work.Work) as void {
    let is *plan.Plan as p = w.plan;
    plan.pause(p, fn_ptr(_setup_syllables));
    plan.on(p, work.tag("locl"), plan.F_PER_SYLLABLE);
    plan.on(p, work.tag("ccmp"), plan.F_PER_SYLLABLE);
    plan.on(p, work.tag("nukt"), plan.F_PER_SYLLABLE);
    plan.on(p, work.tag("akhn"), plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE);
    plan.pause(p, fn_ptr(_clear_substituted));
    plan.add(p, work.tag("rphf"), plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE);
    plan.pause(p, fn_ptr(_record_rphf));
    plan.pause(p, fn_ptr(_clear_substituted));
    plan.on(p, work.tag("pref"), plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE);
    plan.pause(p, fn_ptr(_record_pref));
    let is i64 as flags = plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE;
    plan.on(p, work.tag("rkrf"), flags);
    plan.on(p, work.tag("abvf"), flags);
    plan.on(p, work.tag("blwf"), flags);
    plan.on(p, work.tag("half"), flags);
    plan.on(p, work.tag("pstf"), flags);
    plan.on(p, work.tag("vatu"), flags);
    plan.on(p, work.tag("cjct"), flags);
    plan.pause(p, fn_ptr(_reorder));
    plan.pause(p, cast(plan.Pause, 0));
    plan.add(p, work.tag("isol"), 0);
    plan.add(p, work.tag("init"), 0);
    plan.add(p, work.tag("medi"), 0);
    plan.add(p, work.tag("fina"), 0);
    plan.pause(p, cast(plan.Pause, 0));
    plan.on(p, work.tag("abvs"), plan.F_MANUAL_ZWJ);
    plan.on(p, work.tag("blws"), plan.F_MANUAL_ZWJ);
    plan.on(p, work.tag("haln"), plan.F_MANUAL_ZWJ);
    plan.on(p, work.tag("pres"), plan.F_MANUAL_ZWJ);
    plan.on(p, work.tag("psts"), plan.F_MANUAL_ZWJ);
}

fn prepared(w as *work.Work) as void {
    w.values[V_RPHF] = plan.one_of(w.plan, work.tag("rphf"));
    w.values[V_JOINING] = cast(i64, _has_joining(w.script));
    if (w.values[V_JOINING] == 1) { arabic.prepared_forms(w); }
    syllable.compile(&G_VIRAMA, W_VIRAMA);
    syllable.compile(&G_SAKOT, W_SAKOT);
    syllable.compile(&G_STANDARD, W_STANDARD);
    syllable.compile(&G_NUMBER_JOINER, W_NUMBER_JOINER);
    syllable.compile(&G_NUMERAL, W_NUMERAL);
    syllable.compile(&G_SYMBOL, W_SYMBOL);
    syllable.compile(&G_HIEROGLYPH, W_HIEROGLYPH);
    syllable.compile(&G_NONE, W_NONE);
    syllable.compile(&G_BROKEN, W_BROKEN);
}

fn compose_rule(a as i64, b as i64) as i64 {
    if (chars.is_mark(chars.category(a)) == 1) { return 0; }
    return cast(i64, norm.compose_pair(cast(i32, a), cast(i32, b)));
}

fn ways(w as *work.Work) as void {
    w.zero = work.ZERO_EARLY;
    w.fallback = 0;
    w.rules.mode = compose.PARTS;
    w.rules.compose = fn_ptr(compose_rule);
}

fn _hex6(s as *u8, at as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as k with mut = 0;
    while (k < 6) {
        let is i64 as c = cast(i64, s[at + k]);
        let is i64 as d with mut = c - 48;
        if (c >= 65) { d = c - 55; }
        v = v * 16 + d;
        k = k + 1;
    }
    return v;
}

// A character's category, as the table has it.
fn category(u as i64) as i64 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = table.RANGES_COUNT - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        if (u < _hex6(table.RANGES, mid * 13)) {
            hi = mid - 1;
        } else if (u > _hex6(table.RANGES, mid * 13 + 6)) {
            lo = mid + 1;
        } else {
            return cast(i64, table.RANGES[mid * 13 + 12]);
        }
    }
    return C_OTHER;
}

fn setup(w as *work.Work) as void {
    if (w.values[V_JOINING] == 1) { arabic.setup(w); }
    let is *glyphs.Run as run = w.run;
    let is i64 as i with mut = 0;
    while (i < run.len) {
        run.src[i].scat = cast(u8, category(cast(i64, run.src[i].id)));
        run.src[i].sflags = cast(u8, 0);
        i = i + 1;
    }
}

fn _is_ignorable_cgj(g as *glyphs.Glyph) as i32 {
    return cast(i32, cast(i64, g.scat) == C_CGJ && (cast(i64, g.uflags) & glyphs.U_IGNORABLE) != 0);
}

// What the grammar does not look at: joiners that are default ignorable, and a
// ZWNJ with a mark coming next.
fn _passed_over(run as *glyphs.Run) as void {
    let is i64 as i with mut = 0;
    while (i < run.len) {
        let is *glyphs.Glyph as g = &run.src[i];
        if (_is_ignorable_cgj(g) == 1) {
            g.sflags = cast(u8, syllable.SF_PASSED_OVER);
        } else if (cast(i64, g.scat) == C_ZWNJ) {
            let is i64 as k with mut = i + 1;
            while (k < run.len && _is_ignorable_cgj(&run.src[k]) == 1) { k = k + 1; }
            if (k < run.len && chars.is_mark(cast(i64, run.src[k].cat)) == 1) { g.sflags = cast(u8, syllable.SF_PASSED_OVER); }
        }
        i = i + 1;
    }
}

fn _rphf_masks(w as *work.Work) as void {
    let is i64 as mask = w.values[V_RPHF];
    if (mask == 0) { return; }
    let is *glyphs.Run as run = w.run;
    let is i64 as start with mut = 0;
    while (start < run.len) {
        let is i64 as end = syllable.end_of(run, start);
        let is i64 as limit with mut = end - start;
        if (limit > 3) { limit = 3; }
        if (cast(i64, run.src[start].scat) == C_R) { limit = 1; }
        let is i64 as i with mut = start;
        while (i < start + limit) {
            run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | mask);
            i = i + 1;
        }
        start = end;
    }
}

// Syllables join as letters do, in scripts where nothing says otherwise.
fn _topographical_masks(w as *work.Work) as void {
    if (w.values[V_JOINING] == 1) { return; }
    let is [4]i64 as m;
    m[0] = plan.one_of(w.plan, work.tag("isol"));
    m[1] = plan.one_of(w.plan, work.tag("init"));
    m[2] = plan.one_of(w.plan, work.tag("medi"));
    m[3] = plan.one_of(w.plan, work.tag("fina"));
    let is i64 as all with mut = 0;
    let is i64 as k with mut = 0;
    while (k < 4) {
        if (m[k] == plan.EVERYWHERE) { m[k] = 0; }
        all = all | m[k];
        k = k + 1;
    }
    if (all == 0) { return; }
    let is i64 as others = 0 - 1 - all;
    let is *glyphs.Run as run = w.run;
    let is i64 as last_start with mut = 0;
    let is i64 as last_form with mut = 4;
    let is i64 as start with mut = 0;
    while (start < run.len) {
        let is i64 as end = syllable.end_of(run, start);
        let is i64 as kind = cast(i64, run.src[start].syl) & 15;
        if (kind == S_HIEROGLYPH || kind == S_NONE) {
            last_form = 4;
        } else {
            let is i32 as joined = cast(i32, last_form == 3 || last_form == 0);
            if (joined == 1) {
                // What each is drawn as depends on the other.
                glyphs.mark_unsafe(run, last_start, end);
                if (last_form == 3) { last_form = 2; } else { last_form = 1; }
                let is i64 as i with mut = last_start;
                while (i < start) {
                    run.src[i].mask = cast(u64, (cast(i64, run.src[i].mask) & others) | m[last_form]);
                    i = i + 1;
                }
            }
            if (joined == 1) { last_form = 3; } else { last_form = 0; }
            let is i64 as i with mut = start;
            while (i < end) {
                run.src[i].mask = cast(u64, (cast(i64, run.src[i].mask) & others) | m[last_form]);
                i = i + 1;
            }
        }
        last_start = start;
        start = end;
    }
}

fn _setup_syllables(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is *glyphs.Run as run = w.run;
    _passed_over(run);
    let is [9]*syllable.Grammar as gs;
    gs[S_VIRAMA] = &G_VIRAMA;
    gs[S_SAKOT] = &G_SAKOT;
    gs[S_STANDARD] = &G_STANDARD;
    gs[S_NUMBER_JOINER] = &G_NUMBER_JOINER;
    gs[S_NUMERAL] = &G_NUMERAL;
    gs[S_SYMBOL] = &G_SYMBOL;
    gs[S_HIEROGLYPH] = &G_HIEROGLYPH;
    gs[S_NONE] = &G_NONE;
    gs[S_BROKEN] = &G_BROKEN;
    w.values[V_BROKEN] = cast(i64, syllable.find(run, cast(**syllable.Grammar, &gs), 9, S_NONE, S_BROKEN));
    _rphf_masks(w);
    _topographical_masks(w);
}

fn _clear_substituted(user as *u8) as void {
    let is *glyphs.Run as run = cast(*work.Work, user).run;
    let is i64 as i with mut = 0;
    while (i < run.len) {
        run.src[i].made = cast(u8, cast(i64, run.src[i].made) & (255 - glyphs.SUBSTITUTED));
        i = i + 1;
    }
}

// A repha the font formed is one from now on.
fn _record_rphf(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is i64 as mask = w.values[V_RPHF];
    if (mask == 0) { return; }
    let is *glyphs.Run as run = w.run;
    let is i64 as start with mut = 0;
    while (start < run.len) {
        let is i64 as end = syllable.end_of(run, start);
        let is i64 as i with mut = start;
        while (i < end && (cast(i64, run.src[i].mask) & mask) != 0) {
            if ((cast(i64, run.src[i].made) & glyphs.SUBSTITUTED) != 0) {
                run.src[i].scat = cast(u8, C_R);
                i = end;
            } else {
                i = i + 1;
            }
        }
        start = end;
    }
}

// So is a pre-base form a left vowel: they behave alike.
fn _record_pref(user as *u8) as void {
    let is *glyphs.Run as run = cast(*work.Work, user).run;
    let is i64 as start with mut = 0;
    while (start < run.len) {
        let is i64 as end = syllable.end_of(run, start);
        let is i64 as i with mut = start;
        while (i < end) {
            if ((cast(i64, run.src[i].made) & glyphs.SUBSTITUTED) != 0) {
                run.src[i].scat = cast(u8, C_VPRE);
                i = end;
            } else {
                i = i + 1;
            }
        }
        start = end;
    }
}

fn _is_halant(g as *glyphs.Glyph) as i32 {
    let is i64 as c = cast(i64, g.scat);
    return cast(i32, (c == C_H || c == C_HVM || c == C_IS) && (cast(i64, g.made) & glyphs.LIGATED) == 0);
}

// What a repha is moved up to, not past: what follows the base.
fn _is_post_base(g as *glyphs.Glyph) as i32 {
    let is i64 as c = cast(i64, g.scat);
    // a b f, d h i j, p q r t, v y A C, F L.
    return cast(i32, c == 97 || c == 98 || c == 102 || c == 100 || c == 104 || c == 105 || c == 106 ||
                     c == 112 || c == 113 || c == 114 || c == 116 || c == 118 || c == 121 || c == 65 || c == 67 ||
                     c == 70 || c == 76);
}

fn _reorder_syllable(run as *glyphs.Run, start as i64, end as i64) as void {
    let is i64 as kind = cast(i64, run.src[start].syl) & 15;
    if (kind != S_VIRAMA && kind != S_SAKOT && kind != S_STANDARD && kind != S_SYMBOL && kind != S_BROKEN) { return; }
    // A repha goes on, to before the first thing after the base, or the end.
    if (cast(i64, run.src[start].scat) == C_R && end - start > 1) {
        let is i64 as i with mut = start + 1;
        while (i < end) {
            let is i32 as post = cast(i32, _is_post_base(&run.src[i]) == 1 || _is_halant(&run.src[i]) == 1);
            if (post == 1 || i == end - 1) {
                let is i64 as to with mut = i;
                if (post == 1) { to = i - 1; }
                glyphs.join(run, start, to + 1);
                let is glyphs.Glyph as t = run.src[start];
                let is i64 as k with mut = start;
                while (k < to) {
                    run.src[k] = run.src[k + 1];
                    k = k + 1;
                }
                run.src[to] = t;
                i = end;
            } else {
                i = i + 1;
            }
        }
    }
    // Left vowels and their modifiers come back to the last halant, or the start.
    let is i64 as j with mut = start;
    let is i64 as i with mut = start;
    while (i < end) {
        let is i64 as c = cast(i64, run.src[i].scat);
        if (_is_halant(&run.src[i]) == 1) {
            j = i + 1;
        } else if ((c == C_VPRE || c == C_VMPRE) && run.src[i].comp == cast(u8, 0) && j < i) {
            glyphs.join(run, j, i + 1);
            let is glyphs.Glyph as t = run.src[i];
            let is i64 as k with mut = i;
            while (k > j) {
                run.src[k] = run.src[k - 1];
                k = k - 1;
            }
            run.src[j] = t;
        }
        i = i + 1;
    }
}

fn _reorder(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is *glyphs.Run as run = w.run;
    if (w.values[V_BROKEN] == 1) { syllable.insert_circles(w, S_BROKEN, C_BASE, 0, C_R); }
    let is i64 as start with mut = 0;
    while (start < run.len) {
        let is i64 as end = syllable.end_of(run, start);
        _reorder_syllable(run, start, end);
        start = end;
    }
}
