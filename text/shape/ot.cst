// text/shape/ot.cst — what GSUB and GPOS share, and GDEF: coverage tables,
// class definitions, and the glyph classes a font gives its glyphs.
//
// Reads stay within the table they are in: a table that points outside
// itself reads as zeros there, where HarfBuzz would have refused the table
// whole or the offset alone — fonts that do neither are read alike.
// Version 2 of these tables, for fonts of more than 65536 glyphs, is not
// read, as HarfBuzz's default build does not read it.
use "../sfnt/table.cst" as table;
use "props.cst" as props;
use "../sfnt/var.cst" as var;

let is i64 as NOT_COVERED with imut = 0 - 1;

fn u16(f as *table.Face, t as table.Table, at as i64) as i64 {
    if (table.inside(t, at, 2) == 0) { return 0; }
    return table.u16_at(f, at);
}

fn i16(f as *table.Face, t as table.Table, at as i64) as i64 {
    if (table.inside(t, at, 2) == 0) { return 0; }
    return table.i16_at(f, at);
}

fn u32(f as *table.Face, t as table.Table, at as i64) as i64 {
    if (table.inside(t, at, 4) == 0) { return 0; }
    return table.u32_at(f, at);
}

// --- Coverage ---

// Where glyph g is in the coverage table at off: its index, or NOT_COVERED.
// Searched as HarfBuzz searches, so a table out of order gives its answers.
fn coverage(f as *table.Face, t as table.Table, off as i64, g as i64) as i64 {
    let is i64 as fmt = u16(f, t, off);
    let is i64 as n = u16(f, t, off + 2);
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = n - 1;
    if (fmt == 1) {
        if (table.inside(t, off + 4, n * 2) == 0) { return NOT_COVERED; }
        while (lo <= hi) {
            let is i64 as mid = (lo + hi) / 2;
            let is i64 as v = table.u16_at(f, off + 4 + mid * 2);
            if (g < v) { hi = mid - 1; } else if (g > v) { lo = mid + 1; } else { return mid; }
        }
        return NOT_COVERED;
    }
    if (fmt == 2) {
        if (table.inside(t, off + 4, n * 6) == 0) { return NOT_COVERED; }
        while (lo <= hi) {
            let is i64 as mid = (lo + hi) / 2;
            let is i64 as r = off + 4 + mid * 6;
            let is i64 as first = table.u16_at(f, r);
            let is i64 as last = table.u16_at(f, r + 2);
            if (g < first) { hi = mid - 1; } else if (g > last) { lo = mid + 1; }
            else {
                if (first <= last) { return table.u16_at(f, r + 4) + (g - first); }
                return NOT_COVERED;
            }
        }
        return NOT_COVERED;
    }
    return NOT_COVERED;
}

// --- Class definitions ---

// Glyph g's class in the class definition at off; 0 for none.
fn class_of(f as *table.Face, t as table.Table, off as i64, g as i64) as i64 {
    let is i64 as fmt = u16(f, t, off);
    if (fmt == 1) {
        let is i64 as start = u16(f, t, off + 2);
        let is i64 as n = u16(f, t, off + 4);
        let is i64 as k = g - start;
        if (k < 0 || k >= n) { return 0; }
        return u16(f, t, off + 6 + k * 2);
    }
    if (fmt == 2) {
        let is i64 as n = u16(f, t, off + 2);
        if (table.inside(t, off + 4, n * 6) == 0) { return 0; }
        let is i64 as lo with mut = 0;
        let is i64 as hi with mut = n - 1;
        while (lo <= hi) {
            let is i64 as mid = (lo + hi) / 2;
            let is i64 as r = off + 4 + mid * 6;
            let is i64 as first = table.u16_at(f, r);
            let is i64 as last = table.u16_at(f, r + 2);
            if (g < first) { hi = mid - 1; } else if (g > last) { lo = mid + 1; } else { return table.u16_at(f, r + 4); }
        }
        return 0;
    }
    return 0;
}

// --- GDEF ---

fn _gdef_ok(f as *table.Face) as i32 {
    if (f.gdef.len >= 12 && u16(f, f.gdef, f.gdef.off) == 1) { return 1; }
    return 0;
}

// The offset, from GDEF's start, at header byte at; 0 for none.
fn _gdef_offset(f as *table.Face, at as i64) as i64 {
    if (_gdef_ok(f) == 0) { return 0; }
    return u16(f, f.gdef, f.gdef.off + at);
}

// Whether the font gives its glyphs classes; without them, shaping takes
// them from the characters.
fn has_glyph_classes(f as *table.Face) as i32 {
    if (_gdef_offset(f, 4) != 0) { return 1; }
    return 0;
}

fn glyph_class(f as *table.Face, g as i64) as i64 {
    let is i64 as o = _gdef_offset(f, 4);
    if (o == 0) { return 0; }
    return class_of(f, f.gdef, f.gdef.off + o, g);
}

fn mark_attachment_class(f as *table.Face, g as i64) as i64 {
    let is i64 as o = _gdef_offset(f, 10);
    if (o == 0) { return 0; }
    return class_of(f, f.gdef, f.gdef.off + o, g);
}

// Glyph g's properties: its class as props' BASE_GLYPH, LIGATURE or MARK,
// a mark's attachment class in the high byte; 0 for a glyph of no class or
// a component.
fn glyph_props(f as *table.Face, g as i64) as i64 {
    let is i64 as c = glyph_class(f, g);
    if (c == 1) { return props.BASE_GLYPH; }
    if (c == 2) { return props.LIGATURE; }
    if (c == 3) { return props.MARK | (mark_attachment_class(f, g) << 8); }
    return 0;
}

// Whether mark glyph set k (GDEF 1.2) has glyph g.
fn mark_set_covers(f as *table.Face, k as i64, g as i64) as i32 {
    if (_gdef_ok(f) == 0 || u16(f, f.gdef, f.gdef.off + 2) < 2) { return 0; }
    let is i64 as o = _gdef_offset(f, 12);
    if (o == 0) { return 0; }
    let is i64 as sets = f.gdef.off + o;
    if (u16(f, f.gdef, sets) != 1 || k < 0 || k >= u16(f, f.gdef, sets + 2)) { return 0; }
    let is i64 as c = u32(f, f.gdef, sets + 4 + k * 4);
    if (c == 0) { return 0; }
    if (coverage(f, f.gdef, sets + c, g) != NOT_COVERED) { return 1; }
    return 0;
}

// --- GSUB and GPOS: scripts, language systems, features, lookups ---

let is i64 as NOT_FOUND with imut = 65535;
let is i64 as NO_VARIATIONS with imut = 4294967295;

// Where a GSUB or GPOS table's lists are, absolute; ok 0 for a table the
// face does not have or that is not version 1.
struct Layout {
    t          as table.Table;
    scripts    as i64;
    features   as i64;
    lookups    as i64;
    variations as i64;   // FeatureVariations, 0 for none
    ok         as i32;
    _pad0      as i32;
}

fn layout(f as *table.Face, t as table.Table) as Layout {
    let is Layout as l;
    l.t = t;
    l.scripts = 0;
    l.features = 0;
    l.lookups = 0;
    l.variations = 0;
    l.ok = 0;
    l._pad0 = 0;
    if (t.len < 10 || u16(f, t, t.off) != 1) { return l; }
    l.ok = 1;
    let is i64 as o = t.off;
    if (u16(f, t, o + 4) != 0) { l.scripts = o + u16(f, t, o + 4); }
    if (u16(f, t, o + 6) != 0) { l.features = o + u16(f, t, o + 6); }
    if (u16(f, t, o + 8) != 0) { l.lookups = o + u16(f, t, o + 8); }
    if (u16(f, t, o + 2) >= 1 && u32(f, t, o + 10) != 0) { l.variations = o + u32(f, t, o + 10); }
    return l;
}

fn _count(f as *table.Face, l as *Layout, list as i64) as i64 {
    if (list == 0) { return 0; }
    return u16(f, l.t, list);
}

// Where a tag is among a list's records — six bytes each, a tag and an
// offset, sorted by tag — searched as HarfBuzz searches; NOT_FOUND for
// nowhere.
fn _find_record(f as *table.Face, l as *Layout, list as i64, tag as i64) as i64 {
    if (list == 0) { return NOT_FOUND; }
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = u16(f, l.t, list) - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is i64 as v = u32(f, l.t, list + 2 + mid * 6);
        if (tag < v) { hi = mid - 1; } else if (tag > v) { lo = mid + 1; } else { return mid; }
    }
    return NOT_FOUND;
}

// What record i of a list points to, from base, absolute; 0 for none.
fn _record_from(f as *table.Face, l as *Layout, list as i64, base as i64, i as i64) as i64 {
    if (list == 0 || i < 0 || i >= u16(f, l.t, list)) { return 0; }
    let is i64 as o = u16(f, l.t, list + 2 + i * 6 + 4);
    if (o == 0) { return 0; }
    return base + o;
}

// The same, for the lists whose offsets are from the list itself: scripts
// and features.
fn _record(f as *table.Face, l as *Layout, list as i64, i as i64) as i64 { return _record_from(f, l, list, list, i); }

fn find_script(f as *table.Face, l as *Layout, tag as i64) as i64 { return _find_record(f, l, l.scripts, tag); }

// HarfBuzz's hb_ot_layout_table_select_script: the first of tags the table
// has, or DFLT, dflt, latn; into *index (NOT_FOUND for none) and *chosen
// (0 for none). 1 when one of tags was found.
fn select_script(f as *table.Face, l as *Layout, tags as *i64, n as i64, index as *i64, chosen as *i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as k = find_script(f, l, tags[i]);
        if (k != NOT_FOUND) {
            *index = k;
            *chosen = tags[i];
            return 1;
        }
        i = i + 1;
    }
    let is [3]i64 as fallbacks;
    fallbacks[0] = 1145457748;   // DFLT
    fallbacks[1] = 1684434036;   // dflt
    fallbacks[2] = 1818326126;   // latn
    i = 0;
    while (i < 3) {
        let is i64 as k = find_script(f, l, fallbacks[i]);
        if (k != NOT_FOUND) {
            *index = k;
            *chosen = fallbacks[i];
            return 0;
        }
        i = i + 1;
    }
    *index = NOT_FOUND;
    *chosen = 0;
    return 0;
}

// The language system index of script — NOT_FOUND for its default — absolute;
// 0 for none.
fn langsys(f as *table.Face, l as *Layout, script as i64, index as i64) as i64 {
    let is i64 as s = _record(f, l, l.scripts, script);
    if (s == 0) { return 0; }
    if (index == NOT_FOUND) {
        let is i64 as d = u16(f, l.t, s);
        if (d == 0) { return 0; }
        return s + d;
    }
    // A script's language systems are found from the script.
    return _record_from(f, l, s + 2, s, index);
}

// HarfBuzz's hb_ot_layout_script_select_language: the first of tags the
// script has a language system for, or dflt; NOT_FOUND — the default
// language system — for none.
fn select_language(f as *table.Face, l as *Layout, script as i64, tags as *i64, n as i64) as i64 {
    let is i64 as s = _record(f, l, l.scripts, script);
    if (s == 0) { return NOT_FOUND; }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as k = _find_record(f, l, s + 2, tags[i]);
        if (k != NOT_FOUND) { return k; }
        i = i + 1;
    }
    return _find_record(f, l, s + 2, 1684434036);
}

fn required_feature(f as *table.Face, l as *Layout, ls as i64) as i64 {
    if (ls == 0) { return NOT_FOUND; }
    return u16(f, l.t, ls + 2);
}

fn langsys_feature_count(f as *table.Face, l as *Layout, ls as i64) as i64 {
    if (ls == 0) { return 0; }
    return u16(f, l.t, ls + 4);
}

fn langsys_feature(f as *table.Face, l as *Layout, ls as i64, i as i64) as i64 {
    return u16(f, l.t, ls + 6 + i * 2);
}

fn feature_count(f as *table.Face, l as *Layout) as i64 { return _count(f, l, l.features); }

// Feature i's tag; 0 for NOT_FOUND or past the list.
fn feature_tag(f as *table.Face, l as *Layout, i as i64) as i64 {
    if (l.features == 0 || i < 0 || i >= u16(f, l.t, l.features)) { return 0; }
    return u32(f, l.t, l.features + 2 + i * 6);
}

// The first feature with tag in the whole list, for features searched for
// beyond the language system; NOT_FOUND for none.
fn find_feature(f as *table.Face, l as *Layout, tag as i64) as i64 {
    let is i64 as n = feature_count(f, l);
    let is i64 as i with mut = 0;
    while (i < n) {
        if (feature_tag(f, l, i) == tag) { return i; }
        i = i + 1;
    }
    return NOT_FOUND;
}

// --- Feature variations ---

fn _condition(f as *table.Face, l as *Layout, c as i64, coords as *var.Coords, depth as i64) as i32 {
    if (depth > 64) { return 0; }
    let is i64 as fmt = u16(f, l.t, c);
    if (fmt == 1) {
        let is i64 as axis = u16(f, l.t, c + 2);
        let is i64 as v with mut = 0;
        if (axis < coords.n) { v = coords.v[axis]; }
        if (i16(f, l.t, c + 4) <= v && v <= i16(f, l.t, c + 6)) { return 1; }
        return 0;
    }
    if (fmt == 2) {
        let is f64 as value = cast(f64, i16(f, l.t, c + 2)) + gdef_delta(f, coords, u32(f, l.t, c + 4));
        if (value > 0.0) { return 1; }
        return 0;
    }
    // A null offset is a condition that is not met.
    if (fmt == 3 || fmt == 4) {
        let is i64 as n with mut = 0;
        if (table.inside(l.t, c + 2, 1) == 1) { n = table.u8_at(f, c + 2); }
        let is i64 as i with mut = 0;
        while (i < n) {
            let is i64 as o with mut = 0;
            if (table.inside(l.t, c + 3 + i * 3, 3) == 1) { o = table.u24_at(f, c + 3 + i * 3); }
            let is i32 as r with mut = 0;
            if (o != 0) { r = _condition(f, l, c + o, coords, depth + 1); }
            if (fmt == 3 && r == 0) { return 0; }
            if (fmt == 4 && r == 1) { return 1; }
            i = i + 1;
        }
        if (fmt == 3) { return 1; }
        return 0;
    }
    if (fmt == 5) {
        let is i64 as o with mut = 0;
        if (table.inside(l.t, c + 2, 3) == 1) { o = table.u24_at(f, c + 2); }
        if (o == 0) { return 1; }
        return 1 - _condition(f, l, c + o, coords, depth + 1);
    }
    return 0;
}

// The first FeatureVariations record whose conditions the coordinates meet;
// NO_VARIATIONS for none.
fn find_variations(f as *table.Face, l as *Layout, coords as *var.Coords) as i64 {
    let is i64 as fv = l.variations;
    if (fv == 0) { return NO_VARIATIONS; }
    let is i64 as n = u32(f, l.t, fv + 4);
    let is i64 as i with mut = 0;
    while (i < n) {
        if (table.inside(l.t, fv + 8 + i * 8, 8) == 0) { return NO_VARIATIONS; }
        let is i64 as cs with mut = u32(f, l.t, fv + 8 + i * 8);
        let is i32 as met with mut = 1;
        if (cs != 0) {
            cs = fv + cs;
            let is i64 as m = u16(f, l.t, cs);
            let is i64 as k with mut = 0;
            while (k < m && met == 1) {
                let is i64 as o = u32(f, l.t, cs + 2 + k * 4);
                if (o == 0) { met = 0; } else { met = _condition(f, l, cs + o, coords, 0); }
                k = k + 1;
            }
        }
        if (met == 1) { return i; }
        i = i + 1;
    }
    return NO_VARIATIONS;
}

// Feature index's table, absolute — its substitute under variations record
// var_index when it has one; 0 for none.
fn feature_table(f as *table.Face, l as *Layout, index as i64, var_index as i64) as i64 {
    if (var_index != NO_VARIATIONS && l.variations != 0) {
        let is i64 as fv = l.variations;
        if (var_index < u32(f, l.t, fv + 4)) {
            let is i64 as fts with mut = u32(f, l.t, fv + 8 + var_index * 8 + 4);
            if (fts != 0) {
                fts = fv + fts;
                let is i64 as n = u16(f, l.t, fts + 4);
                let is i64 as i with mut = 0;
                while (i < n) {
                    if (u16(f, l.t, fts + 6 + i * 6) == index) {
                        let is i64 as o = u32(f, l.t, fts + 6 + i * 6 + 2);
                        if (o == 0) { return 0; }
                        return fts + o;
                    }
                    i = i + 1;
                }
            }
        }
    }
    return _record(f, l, l.features, index);
}

fn feature_lookup_count(f as *table.Face, l as *Layout, ft as i64) as i64 {
    if (ft == 0) { return 0; }
    return u16(f, l.t, ft + 2);
}

fn feature_lookup(f as *table.Face, l as *Layout, ft as i64, i as i64) as i64 { return u16(f, l.t, ft + 4 + i * 2); }

// --- Lookups ---

fn lookup_count(f as *table.Face, l as *Layout) as i64 { return _count(f, l, l.lookups); }

// Lookup i, absolute; 0 for none.
fn lookup(f as *table.Face, l as *Layout, i as i64) as i64 {
    if (l.lookups == 0 || i < 0 || i >= u16(f, l.t, l.lookups)) { return 0; }
    let is i64 as o = u16(f, l.t, l.lookups + 2 + i * 2);
    if (o == 0) { return 0; }
    return l.lookups + o;
}

fn lookup_type(f as *table.Face, l as *Layout, lk as i64) as i64 { return u16(f, l.t, lk); }

// The lookup's flag in the low 16 bits; its mark filtering set above them
// when the flag says it has one.
fn lookup_props(f as *table.Face, l as *Layout, lk as i64) as i64 {
    let is i64 as flag = u16(f, l.t, lk + 2);
    if ((flag & 16) != 0) {
        let is i64 as n = u16(f, l.t, lk + 4);
        return flag + (u16(f, l.t, lk + 6 + n * 2) << 16);
    }
    return flag;
}

fn subtable_count(f as *table.Face, l as *Layout, lk as i64) as i64 { return u16(f, l.t, lk + 4); }

// Subtable i of the lookup, absolute; 0 for a null offset.
fn subtable(f as *table.Face, l as *Layout, lk as i64, i as i64) as i64 {
    let is i64 as o = u16(f, l.t, lk + 6 + i * 2);
    if (o == 0) { return 0; }
    return lk + o;
}

// How many mark glyph sets GDEF has (version 1.2 and later).
fn mark_set_count(f as *table.Face) as i64 {
    if (_gdef_ok(f) == 0 || u16(f, f.gdef, f.gdef.off + 2) < 2) { return 0; }
    let is i64 as o = _gdef_offset(f, 12);
    if (o == 0) { return 0; }
    let is i64 as sets = f.gdef.off + o;
    if (u16(f, f.gdef, sets) != 1) { return 0; }
    return u16(f, f.gdef, sets + 2);
}

// --- GDEF's variation store (1.3), for GPOS's devices and conditions ---

fn gdef_store(f as *table.Face) as var.Store {
    if (_gdef_ok(f) == 1 && u16(f, f.gdef, f.gdef.off + 2) >= 3) {
        let is i64 as o = u32(f, f.gdef, f.gdef.off + 14);
        if (o != 0) { return var.store(f, f.gdef, f.gdef.off + o); }
    }
    return var.no_store(f.gdef);
}

// The delta of variation index idx (outer << 16 | inner) at the
// coordinates, from GDEF's store; 0 at the default instance or for none.
fn gdef_delta(f as *table.Face, coords as *var.Coords, idx as i64) as f64 {
    if (idx == 4294967295 || var.is_default(coords) == 1) { return 0.0; }
    let is var.Store as s = gdef_store(f);
    return var.delta(f, &s, idx, coords);
}
