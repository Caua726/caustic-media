// text/shape/shape.cst — the hub: a text in, glyphs with their clusters and
// positions out. The steps are shape.md's.
//
// A Text is UTF-8 with the paragraph around it: the part to shape is one
// script, one direction and one face at one instance (the Reader's); the
// rest is context. What comes back is the Shaper's run, in the order glyphs
// are drawn, left to right: for each, its glyph, its cluster — the byte
// offset of the first character it came from — whether the text is unsafe to
// break before its cluster, and its advance and offset in font units.
use "std/mem.cst" as mem;
use "../sfnt/table.cst" as table;
use "../sfnt/cmap.cst" as cmap;
use "../outline/outline.cst" as outline;
use "glyphs.cst" as glyphs;
use "chars.cst" as chars;
use "compose.cst" as compose;
use "scripts.cst" as scripts;
use "otl.cst" as otl;
use "plan.cst" as plan;
use "seq.cst" as seq;
use "subst.cst" as subst;
use "pos.cst" as pos;
use "kern.cst" as kern;
use "fallback.cst" as fallback;
use "work.cst" as work;
use "syllable.cst" as syllable;
use "arabic.cst" as arabic;
use "hangul.cst" as hangul;
use "thai.cst" as thai;
use "indic.cst" as indic;
use "khmer.cst" as khmer;
use "myanmar.cst" as myanmar;
use "use.cst" as usee;

let is i64 as LTR with imut = 4;
let is i64 as RTL with imut = 5;

// A Text's flags.
let is i64 as AT_START with imut = 1;           // its bytes begin the paragraph
let is i64 as KEEP_IGNORABLES with imut = 2;    // default ignorables drawn as the font has them
let is i64 as DROP_IGNORABLES with imut = 4;    // taken out rather than drawn as nothing
let is i64 as NO_DOTTED_CIRCLE with imut = 8;   // a leading mark is not given one

let is i64 as ALL with imut = 4294967295;

// A feature a text asks for: its value — 0 off, 1 on, more an alternate's
// number — over clusters start .. end; 0 and ALL for the whole text.
struct Feature {
    tag   as i64;
    value as i64;
    start as i64;
    end   as i64;
}

// bytes holds n bytes of UTF-8; the part to shape is length of them from
// start (-1: to the end). dir is LTR or RTL; script an ISO 15924 code as a
// tag (scripts.of("Latn")); lang a BCP 47 tag, or null.
struct Text {
    bytes     as *u8;
    n         as i64;
    start     as i64;
    length    as i64;
    dir       as i64;
    script    as i64;
    lang      as *u8;
    features  as *Feature;
    nfeatures as i64;
    flags     as i64;
}

struct Shaper {
    run  as glyphs.Run;
    plan as plan.Plan;
    ctx  as seq.Ctx;
    text_wants as i64;   // where the text's own features begin among the plan's wants
    w    as work.Work;
}

fn open(s as *Shaper) as void {
    s.run = glyphs.open();
    s.plan = plan.open();
}

fn close(s as *Shaper) as void {
    glyphs.close(&s.run);
    plan.close(&s.plan);
}

fn count(s as *Shaper) as i64 { return s.run.len; }
fn glyph(s as *Shaper, i as i64) as *glyphs.Glyph { return &s.run.src[i]; }
fn place(s as *Shaper, i as i64) as *glyphs.Place { return &s.run.place[i]; }

fn _nominal(f as *table.Face, u as i64) as i64 { return cmap.glyph(f, u); }

// --- Characters ---

// The character at at, into *cp, and where the next begins. A byte that does
// not begin a complete, well-formed sequence reads as U+FFFD by itself.
fn decode(b as *u8, at as i64, end as i64, cp as *i64) as i64 {
    let is i64 as c0 = cast(i64, b[at]);
    if (c0 < 128) {
        *cp = c0;
        return at + 1;
    }
    let is i64 as need with mut = 0;
    let is i64 as lo with mut = 128;
    let is i64 as hi with mut = 191;
    let is i64 as v with mut = 0;
    if (c0 >= 194 && c0 <= 223) { need = 1; v = c0 & 31; }
    else if (c0 >= 224 && c0 <= 239) {
        need = 2;
        v = c0 & 15;
        if (c0 == 224) { lo = 160; }
        if (c0 == 237) { hi = 159; }
    } else if (c0 >= 240 && c0 <= 244) {
        need = 3;
        v = c0 & 7;
        if (c0 == 240) { lo = 144; }
        if (c0 == 244) { hi = 143; }
    } else {
        *cp = chars.REPLACEMENT;
        return at + 1;
    }
    let is i64 as k with mut = 1;
    while (k <= need) {
        if (at + k >= end) {
            *cp = chars.REPLACEMENT;
            return at + 1;
        }
        let is i64 as c = cast(i64, b[at + k]);
        if (c < lo || c > hi) {
            *cp = chars.REPLACEMENT;
            return at + 1;
        }
        v = (v << 6) | (c & 63);
        lo = 128;
        hi = 191;
        k = k + 1;
    }
    *cp = v;
    return at + need + 1;
}

// Each character of the text's part a record, its cluster its offset.
fn _characters(run as *glyphs.Run, t as *Text) as void {
    let is i64 as end with mut = t.n;
    if (t.length >= 0 && t.start + t.length < end) { end = t.start + t.length; }
    let is i64 as at with mut = t.start;
    glyphs.reset(run, end - t.start);
    let is glyphs.Glyph as g;
    mem.memzero(cast(*u8, &g), sizeof(glyphs.Glyph));
    while (at < end && run.ok == 1) {
        let is i64 as u with mut = 0;
        let is i64 as next = decode(t.bytes, at, end, &u);
        g.id = cast(u32, u);
        g.cluster = cast(u32, at);
        g.cat = cast(u8, chars.category(u));
        g.ccc = cast(u8, chars.shaping_class(u));
        let is i64 as fl with mut = 0;
        if (chars.is_ignorable(u) == 1) { fl = fl | glyphs.U_IGNORABLE; }
        if (chars.is_hidden(u) == 1) { fl = fl | glyphs.U_HIDDEN; }
        if (u == chars.ZWJ) { fl = fl | glyphs.U_ZWJ; }
        if (u == chars.ZWNJ) { fl = fl | glyphs.U_ZWNJ; }
        g.uflags = cast(u8, fl);
        glyphs.push(run, &g);
        at = next;
    }
}

// Each character that continues the grapheme before it joined to it.
fn _graphemes(run as *glyphs.Run) as void {
    let is i64 as i with mut = 1;
    while (i < run.len) {
        let is *glyphs.Glyph as g = &run.src[i];
        let is *glyphs.Glyph as prev = &run.src[i - 1];
        let is i64 as u = cast(i64, g.id);
        let is i64 as gc = cast(i64, g.cat);
        let is i32 as goes_on with mut = 0;
        if (chars.begins_grapheme(gc) == 1) {
            goes_on = 0;
        } else if (chars.is_mark(gc) == 1 || chars.is_emoji_modifier(u) == 1 || u == chars.ZWJ) {
            goes_on = 1;
        } else if (chars.is_regional_indicator(u) == 1) {
            goes_on = cast(i32, chars.is_regional_indicator(cast(i64, prev.id)) == 1 &&
                               (cast(i64, prev.uflags) & glyphs.U_CONTINUES) == 0);
        } else if (cast(i64, prev.id) == chars.ZWJ && chars.is_pictographic(u) == 1) {
            goes_on = 1;
        } else if (u == 65438 || u == 65439 || (u >= 917536 && u <= 917631)) {
            goes_on = 1;
        }
        if (goes_on == 1) {
            g.uflags = cast(u8, cast(i64, g.uflags) | glyphs.U_CONTINUES);
            g.cluster = prev.cluster;
        }
        i = i + 1;
    }
    // A grapheme joiner only means something where it keeps two combining
    // marks from being reordered — the first of a class above the second's;
    // elsewhere substitutions pass over it.
    i = 0;
    while (i < run.len) {
        let is *glyphs.Glyph as g = &run.src[i];
        if (cast(i64, g.id) == chars.CGJ &&
            (i == 0 || i + 1 >= run.len || run.src[i + 1].ccc == cast(u8, 0) || run.src[i - 1].ccc <= run.src[i + 1].ccc)) {
            g.uflags = cast(u8, cast(i64, g.uflags) & (255 - glyphs.U_HIDDEN));
        }
        i = i + 1;
    }
}

// A text that begins with a mark: a dotted circle to carry it.
fn _dotted_circle(f as *table.Face, run as *glyphs.Run, t as *Text) as void {
    if ((t.flags & NO_DOTTED_CIRCLE) != 0 || (t.flags & AT_START) == 0 || t.start != 0) { return; }
    if (run.len == 0 || chars.is_mark(cast(i64, run.src[0].cat)) == 0) { return; }
    if (_nominal(f, chars.DOTTED_CIRCLE) == 0) { return; }
    let is glyphs.Glyph as circle = run.src[0];
    circle.id = cast(u32, chars.DOTTED_CIRCLE);
    circle.cat = cast(u8, chars.category(chars.DOTTED_CIRCLE));
    circle.ccc = cast(u8, 0);
    circle.uflags = cast(u8, 0);
    glyphs.begin(run);
    glyphs.put(run, &circle);
    glyphs.end(run);
}

// The direction the run is shaped in: its script's, the run reversed by
// graphemes into it when it was set in the other — but digits and flags with
// no letters, which read left to right whatever the script. When digits or
// flags have a say, so do the letters around them: a piece of the run may
// be shaped in the other direction than the whole, and no break is safe.
fn _native(run as *glyphs.Run, dir as i64, script as i64) as i64 {
    let is i64 as native with mut = scripts.direction(script);
    if (native == scripts.RTL && dir == scripts.LTR) {
        let is i32 as letters with mut = 0;
        let is i32 as ltr with mut = 0;
        let is i64 as i with mut = 0;
        while (i < run.len) {
            let is i64 as gc = cast(i64, run.src[i].cat);
            if (gc >= 1 && gc <= 5) { letters = 1; }
            if (gc == chars.DECIMAL_NUMBER || chars.is_regional_indicator(cast(i64, run.src[i].id)) == 1) { ltr = 1; }
            i = i + 1;
        }
        if (letters == 0 && ltr == 1) { native = scripts.LTR; }
        if (ltr == 1) { glyphs.mark_unsafe(run, 0, run.len); }
    }
    if (native != 0 && native != dir) {
        glyphs.reverse_clusters(run);
        return native;
    }
    return dir;
}

// --- The plan ---

let is i64 as DEFAULT_FEATURES with imut = 96;

// Which shaper a text goes to: by its script, and for most by what the font
// has for it, a font made for no script in particular being shaped as one.
fn _kind(p as *plan.Plan, script as i64) as i64 {
    let is i64 as tag = p.chosen0;
    let is i32 as general = cast(i32, tag == scripts.DFLT || tag == scripts.LATN);
    if (script == scripts.of("Arab")) { return work.K_ARABIC; }
    if (script == scripts.of("Syrc")) {
        if (tag != scripts.DFLT) { return work.K_ARABIC; }
        return work.K_DEFAULT;
    }
    if (script == scripts.of("Thai") || script == scripts.of("Laoo")) { return work.K_THAI; }
    if (script == scripts.of("Hang")) { return work.K_HANGUL; }
    if (indic.is_script(script) == 1) {
        if (general == 1) { return work.K_DEFAULT; }
        // dev3 and its like.
        if ((tag & 255) == 51) { return work.K_USE; }
        return work.K_INDIC;
    }
    if (script == scripts.of("Khmr")) { return work.K_KHMER; }
    if (script == scripts.of("Mymr")) {
        // 'mymr' is from before there was a way of shaping it.
        if (general == 1 || tag == scripts.of("mymr")) { return work.K_DEFAULT; }
        return work.K_MYANMAR;
    }
    if (usee.is_script(script) == 1) {
        if (general == 1) { return work.K_DEFAULT; }
        return work.K_USE;
    }
    return work.K_DEFAULT;
}

fn _collect(w as *work.Work) as void {
    if (w.kind == work.K_ARABIC) { arabic.collect(w); }
    if (w.kind == work.K_HANGUL) { hangul.collect(w); }
    if (w.kind == work.K_INDIC) { indic.collect(w); }
    if (w.kind == work.K_KHMER) { khmer.collect(w); }
    if (w.kind == work.K_MYANMAR) { myanmar.collect(w); }
    if (w.kind == work.K_USE) { usee.collect(w); }
}

fn _override(w as *work.Work) as void {
    if (w.kind == work.K_HANGUL) { hangul.override(w); }
    if (w.kind == work.K_INDIC) { indic.override(w); }
    if (w.kind == work.K_KHMER) { khmer.override(w); }
    if (w.kind == work.K_MYANMAR) { myanmar.override(w); }
}

// The plan's compiled: what the shaper wants from it.
fn _prepared(w as *work.Work) as void {
    if (w.kind == work.K_ARABIC) { arabic.prepared(w); }
    if (w.kind == work.K_HANGUL) { hangul.prepared(w); }
    if (w.kind == work.K_INDIC) { indic.prepared(w); }
    if (w.kind == work.K_KHMER) { khmer.prepared(w); }
    if (w.kind == work.K_MYANMAR) { myanmar.prepared(w); }
    if (w.kind == work.K_USE) { usee.prepared(w); }
}

fn _preprocess(w as *work.Work) as void {
    if (w.kind == work.K_HANGUL) { hangul.preprocess(w); }
    if (w.kind == work.K_THAI) { thai.preprocess(w); }
    if (w.kind == work.K_INDIC || w.kind == work.K_USE) { syllable.vowel_constraints(w); }
}

fn _setup(w as *work.Work) as void {
    if (w.kind == work.K_ARABIC) { arabic.setup(w); }
    if (w.kind == work.K_HANGUL) { hangul.setup(w); }
    if (w.kind == work.K_INDIC) { indic.setup(w); }
    if (w.kind == work.K_KHMER) { khmer.setup(w); }
    if (w.kind == work.K_MYANMAR) { myanmar.setup(w); }
    if (w.kind == work.K_USE) { usee.setup(w); }
}

// What the shaper does with what positioning made.
fn _after_positions(w as *work.Work) as void {
    if (w.kind == work.K_ARABIC) { arabic.stretch(w); }
}

// How the shaper wants the run: marks' widths, normalization, the rest as it is.
fn _ways(w as *work.Work) as void {
    w.zero = work.ZERO_LATE;
    w.fallback = 0;
    w.rules.mode = compose.FONT;
    w.rules.decompose = cast(compose.DecomposeFn, 0);
    w.rules.compose = cast(compose.ComposeFn, 0);
    w.rules.reorder = cast(compose.ReorderFn, 0);
    if (w.kind == work.K_DEFAULT || w.kind == work.K_ARABIC) { w.fallback = 1; }
    if (w.kind == work.K_ARABIC) { w.rules.reorder = fn_ptr(arabic.reorder_marks); }
    if (w.kind == work.K_HANGUL) {
        w.zero = work.ZERO_NONE;
        w.rules.mode = compose.KEEP;
    }
    if (w.kind == work.K_INDIC) { indic.ways(w); }
    if (w.kind == work.K_KHMER) { khmer.ways(w); }
    if (w.kind == work.K_MYANMAR) { myanmar.ways(w); }
    if (w.kind == work.K_USE) { usee.ways(w); }
}

fn _plan(s as *Shaper, r as *outline.Reader, t as *Text, dir as i64) as i32 {
    let is *plan.Plan as p = &s.plan;
    if (plan.begin(p, r.face, t.script, t.lang, DEFAULT_FEATURES + t.nfeatures) == 0) { return 0; }
    let is *work.Work as w = &s.w;
    w.f = r.face;
    w.r = r;
    w.run = &s.run;
    w.plan = p;
    w.ctx = &s.ctx;
    w.lang = t.lang;
    w.script = t.script;
    w.chosen = p.chosen0;
    w.dir = dir;
    w.bytes = t.bytes;
    w.n = t.n;
    w.start = t.start;
    w.end = t.n;
    if (t.length >= 0 && t.start + t.length < t.n) { w.end = t.start + t.length; }
    w.kind = _kind(p, t.script);
    w.circle = cast(i32, _nominal(r.face, chars.DOTTED_CIRCLE));
    w.no_circle = cast(i32, (t.flags & NO_DOTTED_CIRCLE) != 0);
    plan.want(p, scripts.of("rvrn"), 1, 0, plan.ALL, plan.STAGE_FIRST, 0);
    plan.pause(p, cast(plan.Pause, 0));
    let is i64 as main with mut = p.current;
    if (t.dir == RTL) {
        plan.want(p, scripts.of("rtla"), 1, 0, plan.ALL, main, 0);
        plan.want(p, scripts.of("rtlm"), 1, 0, 0, main, 0);
    } else {
        plan.want(p, scripts.of("ltra"), 1, 0, plan.ALL, main, 0);
        plan.want(p, scripts.of("ltrm"), 1, 0, plan.ALL, main, 0);
    }
    // Set where fractions are, over no clusters until then.
    plan.want(p, scripts.of("frac"), 1, 0, 0, main, 0);
    plan.want(p, scripts.of("numr"), 1, 0, 0, main, 0);
    plan.want(p, scripts.of("dnom"), 1, 0, 0, main, 0);
    plan.want(p, scripts.of("rand"), 255, 0, plan.ALL, main, plan.F_RANDOM);
    _collect(w);
    main = p.current;
    plan.want(p, scripts.of("abvm"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("blwm"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("ccmp"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("locl"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("mark"), 1, 0, plan.ALL, main, plan.F_MANUAL_ZWJ);
    plan.want(p, scripts.of("mkmk"), 1, 0, plan.ALL, main, plan.F_MANUAL_ZWJ);
    plan.want(p, scripts.of("rlig"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("calt"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("clig"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("curs"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("dist"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("kern"), 1, 0, plan.ALL, main, plan.F_KEEP);
    plan.want(p, scripts.of("liga"), 1, 0, plan.ALL, main, 0);
    plan.want(p, scripts.of("rclt"), 1, 0, plan.ALL, main, 0);
    s.text_wants = p.nwants;
    let is i64 as i with mut = 0;
    while (i < t.nfeatures) {
        let is *Feature as ft = &t.features[i];
        plan.want(p, ft.tag, ft.value, ft.start, ft.end, main, 0);
        i = i + 1;
    }
    _override(w);
    if (plan.compile(r.face, p, &r.coords) == 0) { return 0; }
    _ways(w);
    // A font that places marks: everything taken apart for it to work on.
    if (w.rules.mode == compose.FONT && plan.one_of(p, scripts.of("mark")) != 0) { w.rules.mode = compose.PARTS; }
    _prepared(w);
    return 1;
}

// Every glyph's mask: the plan's.
fn _initial_masks(s as *Shaper) as void {
    let is *glyphs.Run as run = &s.run;
    let is i64 as i with mut = 0;
    while (i < run.len) {
        run.src[i].mask = cast(u64, s.plan.initial);
        i = i + 1;
    }
}

// The fractions', its shaper's, then each feature the text asks for over a
// stretch — after it last asked for it over the whole — set there.
fn _masks(s as *Shaper, t as *Text, dir as i64) as void {
    let is *glyphs.Run as run = &s.run;
    let is *plan.Plan as p = &s.plan;
    let is i64 as i with mut = 0;
    _fractions(s, dir);
    _setup(&s.w);
    let is i64 as k with mut = 0;
    while (k < t.nfeatures) {
        let is *Feature as ft = &t.features[k];
        let is *plan.Feature as pf = plan.feature(p, ft.tag);
        if ((ft.start != 0 || ft.end != ALL) && cast(i64, pf) != 0 && pf.mask != plan.EVERYWHERE &&
            s.text_wants + k > pf.last_whole) {
            let is i64 as bits = (ft.value << pf.shift) & pf.mask;
            i = 0;
            while (i < run.len) {
                let is i64 as c = cast(i64, run.src[i].cluster);
                if (c >= ft.start && c < ft.end) {
                    run.src[i].mask = cast(u64, (cast(i64, run.src[i].mask) & (0 - 1 - pf.mask)) | bits);
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
}

// Digits on both sides of a fraction slash: those before it the numerator
// — in the order the run is in — those after the denominator.
fn _fractions(s as *Shaper, dir as i64) as void {
    let is *glyphs.Run as run = &s.run;
    let is *plan.Plan as p = &s.plan;
    let is i64 as frac = plan.one_of(p, scripts.of("frac"));
    let is i64 as numr = plan.one_of(p, scripts.of("numr"));
    let is i64 as dnom = plan.one_of(p, scripts.of("dnom"));
    if (frac == 0 && (numr == 0 || dnom == 0)) { return; }
    let is i64 as before with mut = numr | frac;
    let is i64 as after with mut = frac | dnom;
    if (dir == RTL) {
        before = frac | dnom;
        after = numr | frac;
    }
    let is i64 as i with mut = 0;
    while (i < run.len) {
        if (cast(i64, run.src[i].id) == chars.FRACTION_SLASH) {
            let is i64 as a with mut = i;
            let is i64 as b with mut = i + 1;
            while (a > 0 && cast(i64, run.src[a - 1].cat) == chars.DECIMAL_NUMBER) { a = a - 1; }
            while (b < run.len && cast(i64, run.src[b].cat) == chars.DECIMAL_NUMBER) { b = b + 1; }
            if (a < i && b > i + 1) {
                glyphs.mark_unsafe(run, a, b);
                let is i64 as k with mut = a;
                while (k < b) {
                    let is i64 as add with mut = frac;
                    if (k < i) { add = before; }
                    if (k > i) { add = after; }
                    run.src[k].mask = cast(u64, cast(i64, run.src[k].mask) | add);
                    k = k + 1;
                }
                i = b - 1;
            }
        }
        i = i + 1;
    }
}

// Right to left, each character with a mirrored form the font has takes
// it; the rest are the font's rtlm's to mirror.
fn _mirror(f as *table.Face, s as *Shaper) as void {
    let is *glyphs.Run as run = &s.run;
    let is i64 as rtlm = plan.one_of(&s.plan, scripts.of("rtlm"));
    let is i64 as i with mut = 0;
    while (i < run.len) {
        let is i64 as u = cast(i64, run.src[i].id);
        let is i64 as m = chars.mirror(u);
        if (m != u && _nominal(f, m) != 0) {
            run.src[i].id = cast(u32, m);
        } else {
            run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | rtlm);
        }
        i = i + 1;
    }
}

// --- Glyphs ---

// Each character its glyph — a variation sequence's when the face has it,
// and then the selector, its work done, is taken out; one the face does not
// know stays, to be drawn as nothing.
fn _glyphs(f as *table.Face, run as *glyphs.Run) as void {
    glyphs.begin(run);
    while (glyphs.more(run) == 1) {
        let is glyphs.Glyph as g = *glyphs.cur(run);
        glyphs.drop(run);
        let is i32 as selected with mut = 0;
        if (glyphs.more(run) == 1 && glyphs.cur(run).cluster == g.cluster &&
            chars.is_variation_selector(cast(i64, glyphs.cur(run).id)) == 1) {
            let is i64 as v = cmap.variant(f, cast(i64, g.id), cast(i64, glyphs.cur(run).id));
            if (v > 0) {
                g.alt = cast(u32, v);
                selected = 1;
            }
        }
        // The character it was, for those who need to know after this.
        let is u32 as was = g.id;
        g.id = g.alt;
        g.alt = was;
        glyphs.put(run, &g);
        if (selected == 1) { glyphs.drop(run); }
        glyphs.step(run, 1);
    }
    glyphs.end(run);
}

// Each glyph's class: GDEF's, or, for a face without, a mark for a
// non-spacing mark that draws something and a base for the rest.
fn _classes(f as *table.Face, run as *glyphs.Run) as void {
    let is i32 as gdef = otl.has_classes(f);
    let is i64 as i with mut = 0;
    while (i < run.len) {
        let is *glyphs.Glyph as g = &run.src[i];
        g.lig = cast(u8, 0);
        g.comp = cast(u8, 0);
        g.ncomp = cast(u8, 0);
        g.made = cast(u8, 0);
        if (gdef == 1) {
            let is i64 as id = cast(i64, g.id);
            let is i64 as cls with mut = otl.glyph_class(f, id);
            if (cls == 4) { cls = glyphs.UNCLASSED; }
            g.cls = cast(u8, cls);
            g.mclass = cast(u8, otl.mark_class(f, id));
        } else {
            g.mclass = cast(u8, 0);
            if (cast(i64, g.cat) == chars.NON_SPACING_MARK && (cast(i64, g.uflags) & glyphs.U_IGNORABLE) == 0) {
                g.cls = cast(u8, glyphs.MARK);
            } else {
                g.cls = cast(u8, glyphs.BASE);
            }
        }
        i = i + 1;
    }
}

fn _subst_at(c as *seq.Ctx, index as i64) as i32 { return subst.apply_at(c, index); }
fn _pos_at(c as *seq.Ctx, index as i64) as i32 { return pos.apply_at(c, index); }

fn _substitute(s as *Shaper, r as *outline.Reader, dir as i64) as void {
    let is *plan.Plan as p = &s.plan;
    // With no GSUB there are no lookups, but a shaper's work is done all the same.
    if (p.gsub.ok == 1) { seq.open(&s.ctx, r.face, r, &s.run, &p.gsub, plan.GSUB, fn_ptr(_subst_at), dir); }
    let is i64 as k with mut = 0;
    let is i64 as st with mut = 0;
    while (st < p.nstages && s.run.ok == 1) {
        while (k < p.ends[st] && s.run.ok == 1) {
            subst.apply_step(&s.ctx, &p.steps[k]);
            k = k + 1;
        }
        if (cast(i64, p.pauses[st]) != 0 && s.run.ok == 1) { call(p.pauses[st], cast(*u8, &s.w)); }
        st = st + 1;
    }
}

// --- Positions ---

fn _position(s as *Shaper, r as *outline.Reader, dir as i64, t as *Text) as void {
    let is *glyphs.Run as run = &s.run;
    let is *plan.Plan as p = &s.plan;
    let is *table.Face as f = r.face;
    if (run.len > 0) { mem.memzero(cast(*u8, run.place), run.len * sizeof(glyphs.Place)); }
    let is i64 as i with mut = 0;
    while (i < run.len) {
        run.place[i].xa = cast(i32, outline.advance_rounded(r, cast(i64, run.src[i].id)));
        i = i + 1;
    }
    fallback.spaces(r, run);
    let is i32 as gpos = p.gpos.ok;
    // Marks have no advance of their own, for a shaper that wants it so before
    // the font places them.
    if (s.w.zero == work.ZERO_EARLY) {
        i = 0;
        while (i < run.len) {
            if (run.src[i].cls == cast(u8, glyphs.MARK)) {
                run.place[i].xa = cast(i32, 0);
                run.place[i].ya = cast(i32, 0);
            }
            i = i + 1;
        }
    }
    if (gpos == 1) {
        seq.open(&s.ctx, f, r, run, &p.gpos, plan.GPOS, fn_ptr(_pos_at), dir);
        let is i64 as k with mut = p.gsub_end;
        while (k < p.gpos_end && run.ok == 1) {
            pos.apply_step(&s.ctx, &p.steps[k]);
            k = k + 1;
        }
    }
    let is *plan.Feature as kf = plan.feature(p, scripts.of("kern"));
    if (kern.present(f) == 1 && cast(i64, kf) != 0 && (gpos == 0 || kf.index1 == otl.NONE)) {
        kern.apply(f, run, kf.mask);
    }
    // Marks have no advance of their own; without GPOS to place them, one
    // that had is moved back to hang over the glyph before it.
    i = 0;
    while (i < run.len) {
        if (s.w.zero == work.ZERO_LATE && run.src[i].cls == cast(u8, glyphs.MARK)) {
            let is *glyphs.Place as q = &run.place[i];
            if (gpos == 0 && dir == LTR) {
                q.xo = cast(i32, cast(i64, q.xo) - cast(i64, q.xa));
                q.yo = cast(i32, cast(i64, q.yo) - cast(i64, q.ya));
            }
            q.xa = cast(i32, 0);
            q.ya = cast(i32, 0);
        }
        i = i + 1;
    }
    if ((t.flags & KEEP_IGNORABLES) == 0) {
        i = 0;
        while (i < run.len) {
            if (glyphs.is_ignorable(&run.src[i]) == 1) {
                run.place[i].xa = cast(i32, 0);
                run.place[i].ya = cast(i32, 0);
                run.place[i].xo = cast(i32, 0);
            }
            i = i + 1;
        }
    }
    pos.resolve(run, dir);
    if (gpos == 0 && s.w.fallback == 1) { fallback.position_marks(r, run, dir); }
}

// --- The end ---

// Default ignorables drawn as nothing: the font's space, of no width — or
// taken out, when the text asks or the font has no space; the text of one
// taken out goes to the glyph before it, or after it when it is the first.
fn _ignorables(f as *table.Face, run as *glyphs.Run, flags as i64) as void {
    if ((flags & KEEP_IGNORABLES) != 0) { return; }
    let is i64 as space = _nominal(f, 32);
    let is i64 as i with mut = 0;
    if ((flags & DROP_IGNORABLES) == 0 && space != 0) {
        while (i < run.len) {
            if (glyphs.is_ignorable(&run.src[i]) == 1) { run.src[i].id = cast(u32, space); }
            i = i + 1;
        }
        return;
    }
    let is i64 as w with mut = 0;
    while (i < run.len) {
        let is glyphs.Glyph as g = run.src[i];
        if (glyphs.is_ignorable(&g) == 0) {
            run.src[w] = g;
            run.place[w] = run.place[i];
            w = w + 1;
        } else if (i + 1 < run.len && run.src[i + 1].cluster == g.cluster) {
            // Its cluster goes on in the next.
        } else if (w > 0) {
            let is u32 as old = run.src[w - 1].cluster;
            if (g.cluster < old) {
                let is i64 as k with mut = w - 1;
                while (k >= 0 && run.src[k].cluster == old) {
                    run.src[k].cluster = g.cluster;
                    k = k - 1;
                }
            }
        } else if (i + 1 < run.len) {
            let is u32 as old = run.src[i + 1].cluster;
            if (g.cluster < old) {
                let is i64 as k with mut = i + 1;
                while (k < run.len && run.src[k].cluster == old) {
                    run.src[k].cluster = g.cluster;
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }
    run.len = w;
}

// Each cluster unsafe to break before when any of its glyphs is.
fn _flags(run as *glyphs.Run) as void {
    let is i64 as i with mut = 0;
    while (i < run.len) {
        let is i64 as j with mut = i;
        let is u8 as u with mut = cast(u8, 0);
        while (j < run.len && run.src[j].cluster == run.src[i].cluster) {
            if (run.src[j].unsafe != cast(u8, 0)) { u = cast(u8, 1); }
            j = j + 1;
        }
        let is i64 as k with mut = i;
        while (k < j) {
            run.src[k].unsafe = u;
            k = k + 1;
        }
        i = j;
    }
}

// The text shaped into s: 1, or 0 when it could not be — memory refused,
// or a bound on the work passed.
fn shape(s as *Shaper, r as *outline.Reader, t as *Text) as i32 {
    let is *glyphs.Run as run = &s.run;
    let is *table.Face as f = r.face;
    _characters(run, t);
    if (run.ok == 0) { return 0; }
    if (run.len == 0) { return 1; }
    _graphemes(run);
    _dotted_circle(f, run, t);
    let is i64 as dir = _native(run, t.dir, t.script);
    if (_plan(s, r, t, dir) == 0) {
        run.ok = 0;
        return 0;
    }
    _initial_masks(s);
    _preprocess(&s.w);
    if (t.dir == RTL) { _mirror(f, s); }
    compose.compose(f, run, &s.w.rules);
    _masks(s, t, dir);
    _glyphs(f, run);
    _classes(f, run);
    _substitute(s, r, dir);
    _position(s, r, dir, t);
    _after_positions(&s.w);
    if (dir == RTL) { glyphs.reverse_range(run, 0, run.len); }
    _ignorables(f, run, t.flags);
    _flags(run);
    return run.ok;
}
