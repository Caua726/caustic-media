// text/shape/apply.cst — applying lookups: what GSUB and GPOS share.
// HarfBuzz's hb_ot_apply_context_t and the matching in
// hb-ot-layout-gsubgpos.hh.
//
// A lookup is applied at a glyph and looks along the text from it, skipping
// what its flags tell it to — marks, ligatures, glyphs of another mark
// class, default ignorables — for the glyphs its rules list: the input,
// which a substitution replaces; the backtrack before it, among the glyphs
// already written; the lookahead after it. Context rules then apply other
// lookups at positions of the input, nested to a depth of 64.
use "../sfnt/table.cst" as table;
use "../outline/outline.cst" as outline;
use "buffer.cst" as buffer;
use "props.cst" as props;
use "ot.cst" as ot;

let is i64 as MAX_NESTING with imut = 64;
let is i64 as MAX_CONTEXT with imut = 64;

// Lookup flags.
let is i64 as RIGHT_TO_LEFT with imut = 1;
let is i64 as IGNORE_FLAGS with imut = 14;
let is i64 as USE_MARK_FILTERING_SET with imut = 16;
let is i64 as MARK_ATTACHMENT_TYPE with imut = 65280;

// What a rule's values are matched by: glyph ids, classes of a class
// definition, coverage tables; or anything.
let is i64 as MATCH_NONE with imut = 0;
let is i64 as MATCH_GLYPH with imut = 1;
let is i64 as MATCH_CLASS with imut = 2;
let is i64 as MATCH_COVERAGE with imut = 3;
let is i64 as MATCH_ALWAYS with imut = 4;

// may_skip and match_one's answers.
let is i64 as SKIP_NO with imut = 0;
let is i64 as SKIP_YES with imut = 1;
let is i64 as SKIP_MAYBE with imut = 2;
let is i64 as MATCH with imut = 0;
let is i64 as NOT_MATCH with imut = 1;
let is i64 as SKIP with imut = 2;

// Applies lookup index at the current glyph: the table's own, so that GSUB
// and GPOS recurse into their own lookups.
type RecurseFn = fn(*Ctx, i64) as i32;

// A walk along the text from a glyph, skipping what the lookup skips:
// HarfBuzz's skipping_iterator_t with its matcher_t.
struct Iter {
    idx       as i64;
    end       as i64;
    props     as i64;   // lookup props
    mask      as i64;
    syllable  as i64;
    kind      as i64;   // MATCH_*
    base      as i64;   // the class definition, or the coverages' base, absolute
    data      as i64;   // the values still to match, absolute; 0 for none
    ignore_zwnj as i32;
    ignore_zwj  as i32;
    ignore_hidden as i32;
    per_syllable as i32;
}

struct Ctx {
    f        as *table.Face;
    r        as *outline.Reader;
    b        as *buffer.Buffer;
    l        as *ot.Layout;
    table_index as i64;   // 0 GSUB, 1 GPOS
    recurse  as RecurseFn;
    dir      as i64;
    lookup_mask as i64;
    lookup_index as i64;
    lookup_props as i64;
    nesting_left as i64;
    mark_sets as i64;
    last_base as i64;       // GPOS
    last_base_until as i64;
    has_glyph_classes as i32;
    auto_zwnj as i32;
    auto_zwj  as i32;
    per_syllable as i32;
    random   as i32;
    _pad0    as i32;
    iter_input   as Iter;
    iter_context as Iter;
    // Where the glyphs a rule matched are; each nested lookup has its own.
    positions as *i64;
    depth    as i64;
    stack    as [4160]i64;   // MAX_CONTEXT positions for each of 65 levels
}

fn open(c as *Ctx, f as *table.Face, r as *outline.Reader, b as *buffer.Buffer, l as *ot.Layout,
        table_index as i64, recurse as RecurseFn) as void {
    c.f = f;
    c.r = r;
    c.b = b;
    c.l = l;
    c.table_index = table_index;
    c.recurse = recurse;
    c.dir = b.dir;
    c.lookup_mask = 1;
    c.lookup_index = 0 - 1;
    c.lookup_props = 0;
    c.nesting_left = MAX_NESTING;
    c.mark_sets = ot.mark_set_count(f);
    c.last_base = 0 - 1;
    c.last_base_until = 0;
    c.has_glyph_classes = ot.has_glyph_classes(f);
    c.auto_zwnj = 1;
    c.auto_zwj = 1;
    c.per_syllable = 0;
    c.random = 0;
    c._pad0 = 0;
    c.depth = 0;
    c.positions = cast(*i64, &c.stack);
    init_iters(c);
}

// --- Glyph properties ---

// Whether the glyph is one the lookup looks at, by its class, its mark
// attachment class or its mark filtering set.
fn check_glyph_property(c as *Ctx, i as *buffer.Info, match_props as i64) as i32 {
    let is i64 as gp = props.glyph_props(i);
    if ((gp & match_props & IGNORE_FLAGS) != 0) { return 0; }
    if ((gp & props.MARK) != 0) {
        if ((match_props & USE_MARK_FILTERING_SET) != 0) {
            return ot.mark_set_covers(c.f, match_props >> 16, cast(i64, i.cp));
        }
        if ((match_props & MARK_ATTACHMENT_TYPE) != 0) {
            return cast(i32, (match_props & MARK_ATTACHMENT_TYPE) == (gp & MARK_ATTACHMENT_TYPE));
        }
    }
    return 1;
}

// --- Iterators ---

fn _iter_init(c as *Ctx, it as *Iter, context_match as i32) as void {
    it.end = c.b.len;
    it.props = c.lookup_props;
    it.ignore_zwnj = cast(i32, c.table_index == 1 || (context_match == 1 && c.auto_zwnj == 1));
    it.ignore_zwj = cast(i32, context_match == 1 || c.auto_zwj == 1);
    it.ignore_hidden = cast(i32, c.table_index == 1);
    it.mask = c.lookup_mask;
    if (context_match == 1) { it.mask = 4294967295; }
    it.per_syllable = cast(i32, c.table_index == 0 && c.per_syllable == 1);
    it.syllable = 0;
    it.kind = MATCH_NONE;
    it.base = 0;
    it.data = 0;
}

fn init_iters(c as *Ctx) as void {
    _iter_init(c, &c.iter_input, 0);
    _iter_init(c, &c.iter_context, 1);
}

// The lookup's props, a mark filtering set GDEF does not have dropped.
fn set_lookup_props(c as *Ctx, p as i64) as void {
    let is i64 as v with mut = p;
    if ((v & USE_MARK_FILTERING_SET) != 0 && (v >> 16) >= c.mark_sets) { v = v - USE_MARK_FILTERING_SET; }
    c.lookup_props = v;
    init_iters(c);
}

fn set_match(it as *Iter, kind as i64, base as i64, data as i64) as void {
    it.kind = kind;
    it.base = base;
    it.data = data;
}

fn reset(c as *Ctx, it as *Iter, start as i64) as void {
    it.idx = start;
    it.end = c.b.len;
    it.syllable = cast(i64, buffer.cur(c.b, 0).syllable);
}

fn reset_back(c as *Ctx, it as *Iter, start as i64) as void {
    it.idx = start;
    it.syllable = cast(i64, buffer.cur(c.b, 0).syllable);
}

fn reset_fast(it as *Iter, start as i64) as void { it.idx = start; }

fn may_skip(c as *Ctx, it as *Iter, i as *buffer.Info) as i64 {
    if (check_glyph_property(c, i, it.props) == 0) { return SKIP_YES; }
    if (props.is_default_ignorable_of(i) == 1 &&
        (it.ignore_zwnj == 1 || props.is_zwnj(i) == 0) &&
        (it.ignore_zwj == 1 || props.is_zwj(i) == 0) &&
        (it.ignore_hidden == 1 || props.is_hidden(i) == 0)) {
        return SKIP_MAYBE;
    }
    return SKIP_NO;
}

// Whether glyph info matches value by kind and base.
fn match_value(c as *Ctx, kind as i64, base as i64, i as *buffer.Info, value as i64) as i32 {
    let is i64 as g = cast(i64, i.cp);
    if (kind == MATCH_GLYPH) { return cast(i32, g == value); }
    if (kind == MATCH_CLASS) { return cast(i32, ot.class_of(c.f, c.l.t, base, g) == value); }
    if (kind == MATCH_COVERAGE) {
        if (value == 0) { return 0; }
        return cast(i32, ot.coverage(c.f, c.l.t, base + value, g) != ot.NOT_COVERED);
    }
    return 1;
}

fn _value(c as *Ctx, it as *Iter) as i64 {
    if (it.data == 0) { return 0; }
    return ot.u16(c.f, c.l.t, it.data);
}

// 0 no, 1 yes, 2 maybe — no matching function to say.
fn _may_match(c as *Ctx, it as *Iter, i as *buffer.Info) as i64 {
    if ((cast(i64, i.mask) & it.mask) == 0 ||
        (it.per_syllable == 1 && it.syllable != 0 && it.syllable != cast(i64, i.syllable))) { return 0; }
    if (it.kind != MATCH_NONE) {
        if (match_value(c, it.kind, it.base, i, _value(c, it)) == 1) { return 1; }
        return 0;
    }
    return 2;
}

fn match_one(c as *Ctx, it as *Iter, i as *buffer.Info) as i64 {
    let is i64 as skip = may_skip(c, it, i);
    if (skip == SKIP_YES) { return SKIP; }
    let is i64 as m = _may_match(c, it, i);
    if (m == 1 || (m == 2 && skip == SKIP_NO)) { return MATCH; }
    if (skip == SKIP_NO) { return NOT_MATCH; }
    return SKIP;
}

// The next glyph matched into it.idx: 1; or 0, with *unsafe_to where the
// text stopped matching.
fn next(c as *Ctx, it as *Iter, unsafe_to as *i64) as i32 {
    let is i64 as stop = it.end - 1;
    while (it.idx < stop) {
        it.idx = it.idx + 1;
        let is i64 as r = match_one(c, it, &c.b.info[it.idx]);
        if (r == MATCH) {
            if (it.data != 0) { it.data = it.data + 2; }
            return 1;
        }
        if (r == NOT_MATCH) {
            *unsafe_to = it.idx + 1;
            return 0;
        }
    }
    *unsafe_to = it.end;
    return 0;
}

// The glyph before, among those already written, matched into it.idx: 1;
// or 0, with *unsafe_from where the text stopped matching.
fn prev(c as *Ctx, it as *Iter, unsafe_from as *i64) as i32 {
    while (it.idx > 0) {
        it.idx = it.idx - 1;
        let is i64 as r = match_one(c, it, &c.b.out[it.idx]);
        if (r == MATCH) {
            if (it.data != 0) { it.data = it.data + 2; }
            return 1;
        }
        if (r == NOT_MATCH) {
            let is i64 as u with mut = it.idx;
            if (u < 1) { u = 1; }
            *unsafe_from = u - 1;
            return 0;
        }
    }
    *unsafe_from = 0;
    return 0;
}

// --- Substituting ---

fn random_number(c as *Ctx) as i64 {
    c.b.random = (c.b.random * 48271) % 2147483647;
    return c.b.random;
}

// The current glyph's class made the substitute's: GDEF's, or the guess,
// or what it was; marked as substituted, ligated, multiplied.
fn set_glyph_class(c as *Ctx, g as i64, class_guess as i64, ligature as i32, component as i32) as void {
    let is *buffer.Info as cur = buffer.cur(c.b, 0);
    let is i64 as p with mut = props.glyph_props(cur) | props.SUBSTITUTED;
    if (ligature == 1) {
        p = p | props.LIGATED;
        p = p & (65535 - props.MULTIPLIED);
    }
    if (component == 1) { p = p | props.MULTIPLIED; }
    let is i64 as keep = props.SUBSTITUTED | props.LIGATED | props.MULTIPLIED;
    if (c.has_glyph_classes == 1) {
        props.set_glyph_props(cur, (p & keep) | ot.glyph_props(c.f, g));
    } else if (class_guess != 0) {
        props.set_glyph_props(cur, (p & keep) | class_guess);
    } else {
        props.set_glyph_props(cur, p);
    }
}

fn replace_glyph(c as *Ctx, g as i64) as void {
    set_glyph_class(c, g, 0, 0, 0);
    buffer.replace_glyph(c.b, g);
}

fn replace_glyph_inplace(c as *Ctx, g as i64) as void {
    set_glyph_class(c, g, 0, 0, 0);
    buffer.cur(c.b, 0).cp = cast(u32, g);
}

fn replace_glyph_with_ligature(c as *Ctx, g as i64, class_guess as i64) as void {
    set_glyph_class(c, g, class_guess, 1, 0);
    buffer.replace_glyph(c.b, g);
}

fn output_glyph_for_component(c as *Ctx, g as i64, class_guess as i64) as void {
    set_glyph_class(c, g, class_guess, 0, 1);
    buffer.output_glyph(c.b, g);
}

// --- Matching ---

fn _lig_num_comps_in_ligation(i as *buffer.Info) as i64 {
    if ((props.glyph_props(i) & props.MULTIPLIED) != 0 && props.lig_comp(i) != 0) { return 0; }
    return props.lig_num_comps(i);
}

// The input of a rule, count glyphs with the current one, the rest matched
// against the values at data by kind and base: 1, with *end where the match
// ends and the glyphs' positions in c.positions; or 0, with *end where the
// text stopped matching. Ligatures are not formed across marks attached to
// other ligatures' components. *components, when not null, counts the
// components the glyphs matched hold.
fn match_input(c as *Ctx, count as i64, kind as i64, base as i64, data as i64, end as *i64, components as *i64) as i32 {
    let is *buffer.Buffer as b = c.b;
    if (count == 1) {
        *end = b.idx + 1;
        c.positions[0] = b.idx;
        if (cast(i64, components) != 0) { *components = props.lig_num_comps(buffer.cur(b, 0)); }
        return 1;
    }
    if (count > MAX_CONTEXT) { return 0; }
    let is *Iter as it = &c.iter_input;
    reset(c, it, b.idx);
    set_match(it, kind, base, data);
    let is i64 as total with mut = 0;
    let is i64 as first_id = props.lig_id(buffer.cur(b, 0));
    let is i64 as first_comp = props.lig_comp(buffer.cur(b, 0));
    let is i64 as ligbase with mut = 0;   // 0 not checked, 1 may not skip, 2 may skip
    let is i64 as i with mut = 1;
    while (i < count) {
        let is i64 as unsafe_to with mut = 0;
        if (next(c, it, &unsafe_to) == 0) {
            *end = unsafe_to;
            return 0;
        }
        c.positions[i] = it.idx;
        let is *buffer.Info as here = &b.info[it.idx];
        let is i64 as this_id = props.lig_id(here);
        let is i64 as this_comp = props.lig_comp(here);
        if (first_id != 0 && first_comp != 0) {
            if (first_id != this_id || first_comp != this_comp) {
                if (ligbase == 0) {
                    let is i32 as found with mut = 0;
                    let is i64 as j with mut = b.out_len;
                    let is i32 as searching with mut = 1;
                    while (searching == 1 && j > 0 && props.lig_id(&b.out[j - 1]) == first_id) {
                        if (props.lig_comp(&b.out[j - 1]) == 0) {
                            found = 1;
                            searching = 0;
                        }
                        j = j - 1;
                    }
                    if (found == 1 && may_skip(c, it, &b.out[j]) == SKIP_YES) { ligbase = 2; } else { ligbase = 1; }
                }
                if (ligbase == 1) { return 0; }
            }
        } else {
            if (this_id != 0 && this_comp != 0 && this_id != first_id) { return 0; }
        }
        total = total + _lig_num_comps_in_ligation(here);
        i = i + 1;
    }
    *end = it.idx + 1;
    if (cast(i64, components) != 0) { *components = total + props.lig_num_comps(buffer.cur(b, 0)); }
    c.positions[0] = b.idx;
    return 1;
}

// HarfBuzz's allocation of a ligature id: the buffer's next serial number,
// in three bits, never 0.
fn _allocate_lig_id(b as *buffer.Buffer) as i64 {
    let is i64 as id with mut = buffer.next_serial(b) & 7;
    while (id == 0) { id = buffer.next_serial(b) & 7; }
    return id;
}

// The input matched replaced by the ligature glyph lig, the marks among it
// kept and given the component they were on.
fn ligate_input(c as *Ctx, count as i64, match_end as i64, lig as i64, total as i64) as void {
    let is *buffer.Buffer as b = c.b;
    buffer.merge_clusters(b, b.idx, match_end);
    let is i32 as is_base with mut = props.is_base_glyph(&b.info[c.positions[0]]);
    let is i32 as is_mark with mut = props.is_mark(&b.info[c.positions[0]]);
    let is i64 as i with mut = 1;
    while (i < count) {
        if (props.is_mark(&b.info[c.positions[i]]) == 0) {
            is_base = 0;
            is_mark = 0;
            i = count;
        }
        i = i + 1;
    }
    let is i32 as is_ligature = cast(i32, is_base == 0 && is_mark == 0);
    let is i64 as klass with mut = 0;
    let is i64 as lig_id with mut = 0;
    if (is_ligature == 1) {
        klass = props.LIGATURE;
        lig_id = _allocate_lig_id(b);
    }
    let is i64 as last_id with mut = props.lig_id(buffer.cur(b, 0));
    let is i64 as last_comps with mut = props.lig_num_comps(buffer.cur(b, 0));
    let is i64 as so_far with mut = last_comps;
    if (is_ligature == 1) {
        props.set_lig_props_for_ligature(buffer.cur(b, 0), lig_id, total);
        if (props.category(buffer.cur(b, 0)) == props.NON_SPACING_MARK) {
            props.set_category(buffer.cur(b, 0), props.OTHER_LETTER);
        }
    }
    replace_glyph_with_ligature(c, lig, klass);
    i = 1;
    while (i < count) {
        while (b.idx < c.positions[i] && b.successful == 1) {
            if (is_ligature == 1) {
                let is i64 as this_comp with mut = props.lig_comp(buffer.cur(b, 0));
                if (this_comp == 0) { this_comp = last_comps; }
                let is i64 as m with mut = this_comp;
                if (last_comps < m) { m = last_comps; }
                props.set_lig_props_for_mark(buffer.cur(b, 0), lig_id, so_far - last_comps + m);
            }
            buffer.next_glyph(b);
        }
        last_id = props.lig_id(buffer.cur(b, 0));
        last_comps = _lig_num_comps_in_ligation(buffer.cur(b, 0));
        so_far = so_far + last_comps;
        // Skip the component itself.
        b.idx = b.idx + 1;
        i = i + 1;
    }
    if (is_mark == 0 && last_id != 0) {
        // Re-adjust components for any marks following.
        let is i64 as k with mut = b.idx;
        let is i32 as going with mut = 1;
        while (going == 1 && k < b.len) {
            if (last_id != props.lig_id(&b.info[k])) {
                going = 0;
            } else {
                let is i64 as this_comp = props.lig_comp(&b.info[k]);
                if (this_comp == 0) {
                    going = 0;
                } else {
                    let is i64 as m with mut = this_comp;
                    if (last_comps < m) { m = last_comps; }
                    props.set_lig_props_for_mark(&b.info[k], lig_id, so_far - last_comps + m);
                    k = k + 1;
                }
            }
        }
    }
}

// The backtrack, count glyphs before the current one among those written:
// 1, with *start where it begins; or 0, with *start where it stopped
// matching.
fn match_backtrack(c as *Ctx, count as i64, kind as i64, base as i64, data as i64, start as *i64) as i32 {
    if (count == 0) {
        *start = buffer.backtrack_len(c.b);
        return 1;
    }
    let is *Iter as it = &c.iter_context;
    reset_back(c, it, buffer.backtrack_len(c.b));
    set_match(it, kind, base, data);
    let is i64 as i with mut = 0;
    while (i < count) {
        let is i64 as unsafe_from with mut = 0;
        if (prev(c, it, &unsafe_from) == 0) {
            *start = unsafe_from;
            return 0;
        }
        i = i + 1;
    }
    *start = it.idx;
    return 1;
}

// The lookahead, count glyphs from start_index on: 1, with *end where it
// ends; or 0, with *end where it stopped matching.
fn match_lookahead(c as *Ctx, count as i64, kind as i64, base as i64, data as i64, start_index as i64, end as *i64) as i32 {
    if (count == 0) {
        *end = start_index;
        return 1;
    }
    let is *Iter as it = &c.iter_context;
    reset(c, it, start_index - 1);
    set_match(it, kind, base, data);
    let is i64 as i with mut = 0;
    while (i < count) {
        let is i64 as unsafe_to with mut = 0;
        if (next(c, it, &unsafe_to) == 0) {
            *end = unsafe_to;
            return 0;
        }
        i = i + 1;
    }
    *end = it.idx + 1;
    return 1;
}

// --- Nested lookups ---

// Lookup index applied at the current glyph, one level deeper, with its own
// props and positions.
fn recurse(c as *Ctx, index as i64) as i32 {
    if (c.nesting_left == 0) {
        c.b.successful = 0;
        return 0;
    }
    c.b.max_ops = c.b.max_ops - 1;
    if (c.b.max_ops < 0) {
        c.b.successful = 0;
        return 0;
    }
    c.nesting_left = c.nesting_left - 1;
    let is i64 as saved_props = c.lookup_props;
    let is i64 as saved_index = c.lookup_index;
    let is *i64 as saved_positions = c.positions;
    c.depth = c.depth + 1;
    c.positions = cast(*i64, cast(i64, &c.stack) + c.depth * MAX_CONTEXT * 8);
    c.lookup_index = index;
    let is i64 as lk = ot.lookup(c.f, c.l, index);
    set_lookup_props(c, ot.lookup_props(c.f, c.l, lk));
    let is i32 as ret = call(c.recurse, c, index);
    c.lookup_index = saved_index;
    set_lookup_props(c, saved_props);
    c.positions = saved_positions;
    c.depth = c.depth - 1;
    c.nesting_left = c.nesting_left + 1;
    return ret;
}

// The lookup records at records — count of them, four bytes each — applied
// to the input matched, count glyphs ending at match_end; the positions of
// the rest kept up with as nested lookups add and remove glyphs.
fn apply_lookup(c as *Ctx, count0 as i64, nrecords as i64, records as i64, match_end as i64) as void {
    let is *buffer.Buffer as b = c.b;
    let is i64 as count with mut = count0;
    let is i64 as bl = buffer.backtrack_len(b);
    let is i64 as end with mut = bl + match_end - b.idx;
    let is i64 as delta0 = bl - b.idx;
    let is i64 as j with mut = 0;
    while (j < count) {
        c.positions[j] = c.positions[j] + delta0;
        j = j + 1;
    }
    let is i64 as i with mut = 0;
    let is i32 as going with mut = 1;
    while (going == 1 && i < nrecords && b.successful == 1) {
        let is i64 as idx = ot.u16(c.f, c.l.t, records + i * 4);
        let is i64 as lookup_index = ot.u16(c.f, c.l.t, records + i * 4 + 2);
        i = i + 1;
        if (idx < count) {
            let is i64 as orig_len = buffer.backtrack_len(b) + buffer.lookahead_len(b);
            if (c.positions[idx] < orig_len) {
                if (buffer.move_to(b, c.positions[idx]) == 0) {
                    going = 0;
                } else if (b.max_ops <= 0) {
                    going = 0;
                } else if (recurse(c, lookup_index) == 1) {
                    let is i64 as new_len = buffer.backtrack_len(b) + buffer.lookahead_len(b);
                    let is i64 as delta with mut = new_len - orig_len;
                    if (delta != 0) {
                        end = end + delta;
                        if (end < c.positions[idx]) {
                            delta = delta + c.positions[idx] - end;
                            end = c.positions[idx];
                        }
                        let is i64 as nxt with mut = idx + 1;
                        let is i32 as ok with mut = 1;
                        if (delta > 0) {
                            if (delta + count > MAX_CONTEXT) {
                                ok = 0;
                                going = 0;
                            }
                        } else {
                            if (delta < nxt - count) { delta = nxt - count; }
                            nxt = nxt - delta;
                        }
                        if (ok == 1) {
                            // Shift.
                            if (delta > 0) {
                                let is i64 as k with mut = count - 1;
                                while (k >= nxt) {
                                    c.positions[k + delta] = c.positions[k];
                                    k = k - 1;
                                }
                            } else if (delta < 0) {
                                let is i64 as k with mut = nxt;
                                while (k < count) {
                                    c.positions[k + delta] = c.positions[k];
                                    k = k + 1;
                                }
                            }
                            nxt = nxt + delta;
                            count = count + delta;
                            // Fill in new entries.
                            let is i64 as k with mut = idx + 1;
                            while (k < nxt) {
                                c.positions[k] = c.positions[k - 1] + 1;
                                k = k + 1;
                            }
                            // And fix up the rest.
                            while (nxt < count) {
                                c.positions[nxt] = c.positions[nxt] + delta;
                                nxt = nxt + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    buffer.move_to(b, end);
}

// --- Context and chained context: GSUB's types 5 and 6, GPOS's 7 and 8 ---

fn _u16(c as *Ctx, at as i64) as i64 { return ot.u16(c.f, c.l.t, at); }

// The offset at offsets + 2 * i of a list of n, from base; 0 for one past
// the list or null.
fn _offset(c as *Ctx, base as i64, n as i64, offsets as i64, i as i64) as i64 {
    if (i < 0 || i >= n) { return 0; }
    let is i64 as o = _u16(c, offsets + i * 2);
    if (o == 0) { return 0; }
    return base + o;
}

// A context rule at rule: its input matched by kind and base, its lookups
// applied.
fn _context_rule(c as *Ctx, rule as i64, kind as i64, base as i64) as i32 {
    let is i64 as count = _u16(c, rule);
    let is i64 as nrec = _u16(c, rule + 2);
    let is i64 as input = rule + 4;
    let is i64 as records with mut = input;
    if (count > 0) { records = input + (count - 1) * 2; }
    return context_apply(c, count, kind, base, input, nrec, records);
}

fn context_apply(c as *Ctx, count as i64, kind as i64, base as i64, input as i64, nrec as i64, records as i64) as i32 {
    if (count > MAX_CONTEXT) { return 0; }
    let is i64 as end with mut = 0;
    if (match_input(c, count, kind, base, input, &end, cast(*i64, 0)) == 1) {
        buffer.unsafe_to_break(c.b, c.b.idx, end);
        apply_lookup(c, count, nrec, records, end);
        return 1;
    }
    return 0;
}

fn _context_ruleset(c as *Ctx, set as i64, kind as i64, base as i64) as i32 {
    if (set == 0) { return 0; }
    let is i64 as n = _u16(c, set);
    let is i64 as i with mut = 0;
    while (i < n) {
        // A null rule reads as zeros: an empty input, which matches.
        if (_context_rule(c, _offset(c, set, n, set + 2, i), kind, base) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// A context subtable at st, applied at the current glyph.
fn context(c as *Ctx, st as i64) as i32 {
    let is i64 as fmt = _u16(c, st);
    let is i64 as g = cast(i64, buffer.cur(c.b, 0).cp);
    if (fmt == 1) {
        let is i64 as index = ot.coverage(c.f, c.l.t, st + _u16(c, st + 2), g);
        if (index == ot.NOT_COVERED) { return 0; }
        let is i64 as n = _u16(c, st + 4);
        return _context_ruleset(c, _offset(c, st, n, st + 6, index), MATCH_GLYPH, 0);
    }
    if (fmt == 2) {
        let is i64 as index = ot.coverage(c.f, c.l.t, st + _u16(c, st + 2), g);
        if (index == ot.NOT_COVERED) { return 0; }
        let is i64 as cd = st + _u16(c, st + 4);
        let is i64 as klass = ot.class_of(c.f, c.l.t, cd, g);
        let is i64 as n = _u16(c, st + 6);
        return _context_ruleset(c, _offset(c, st, n, st + 8, klass), MATCH_CLASS, cd);
    }
    if (fmt == 3) {
        let is i64 as count = _u16(c, st + 2);
        let is i64 as nrec = _u16(c, st + 4);
        let is i64 as first = _u16(c, st + 6);
        if (first == 0 || ot.coverage(c.f, c.l.t, st + first, g) == ot.NOT_COVERED) { return 0; }
        return context_apply(c, count, MATCH_COVERAGE, st, st + 8, nrec, st + 6 + count * 2);
    }
    return 0;
}

// The chained rule's parts: backtrack, input and lookahead matched by kind,
// each against its own base, then its lookups applied.
fn chain_apply(c as *Ctx, nback as i64, back as i64, ninput as i64, input as i64, nahead as i64, ahead as i64,
               nrec as i64, records as i64, kind as i64, bbase as i64, ibase as i64, abase as i64) as i32 {
    if (ninput > MAX_CONTEXT) { return 0; }
    let is i64 as start with mut = c.b.out_len;
    let is i64 as end with mut = c.b.idx;
    let is i64 as match_end with mut = 0;
    if (match_input(c, ninput, kind, ibase, input, &match_end, cast(*i64, 0)) == 0) { return 0; }
    end = match_end;
    if (match_lookahead(c, nahead, kind, abase, ahead, match_end, &end) == 0) { return 0; }
    if (match_backtrack(c, nback, kind, bbase, back, &start) == 0) { return 0; }
    buffer.unsafe_to_break_from_outbuffer(c.b, start, end);
    apply_lookup(c, ninput, nrec, records, match_end);
    return 1;
}

fn _chain_rule(c as *Ctx, rule as i64, kind as i64, bbase as i64, ibase as i64, abase as i64) as i32 {
    let is i64 as nback = _u16(c, rule);
    let is i64 as back = rule + 2;
    let is i64 as at with mut = back + nback * 2;
    let is i64 as ninput = _u16(c, at);
    let is i64 as input = at + 2;
    at = input;
    if (ninput > 0) { at = input + (ninput - 1) * 2; }
    let is i64 as nahead = _u16(c, at);
    let is i64 as ahead = at + 2;
    at = ahead + nahead * 2;
    let is i64 as nrec = _u16(c, at);
    return chain_apply(c, nback, back, ninput, input, nahead, ahead, nrec, at + 2, kind, bbase, ibase, abase);
}

fn _chain_ruleset(c as *Ctx, set as i64, kind as i64, bbase as i64, ibase as i64, abase as i64) as i32 {
    if (set == 0) { return 0; }
    let is i64 as n = _u16(c, set);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as rule = _offset(c, set, n, set + 2, i);
        if (_chain_rule(c, rule, kind, bbase, ibase, abase) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// A chained context subtable at st, applied at the current glyph.
fn chain_context(c as *Ctx, st as i64) as i32 {
    let is i64 as fmt = _u16(c, st);
    let is i64 as g = cast(i64, buffer.cur(c.b, 0).cp);
    if (fmt == 1) {
        let is i64 as index = ot.coverage(c.f, c.l.t, st + _u16(c, st + 2), g);
        if (index == ot.NOT_COVERED) { return 0; }
        let is i64 as n = _u16(c, st + 4);
        return _chain_ruleset(c, _offset(c, st, n, st + 6, index), MATCH_GLYPH, 0, 0, 0);
    }
    if (fmt == 2) {
        let is i64 as index = ot.coverage(c.f, c.l.t, st + _u16(c, st + 2), g);
        if (index == ot.NOT_COVERED) { return 0; }
        let is i64 as bcd = st + _u16(c, st + 4);
        let is i64 as icd = st + _u16(c, st + 6);
        let is i64 as acd = st + _u16(c, st + 8);
        let is i64 as klass = ot.class_of(c.f, c.l.t, icd, g);
        let is i64 as n = _u16(c, st + 10);
        return _chain_ruleset(c, _offset(c, st, n, st + 12, klass), MATCH_CLASS, bcd, icd, acd);
    }
    if (fmt == 3) {
        let is i64 as nback = _u16(c, st + 2);
        let is i64 as back = st + 4;
        let is i64 as at with mut = back + nback * 2;
        let is i64 as ninput = _u16(c, at);
        let is i64 as input = at + 2;
        let is i64 as first = _u16(c, input);
        if (ninput == 0 || first == 0 || ot.coverage(c.f, c.l.t, st + first, g) == ot.NOT_COVERED) { return 0; }
        at = input + ninput * 2;
        let is i64 as nahead = _u16(c, at);
        let is i64 as ahead = at + 2;
        at = ahead + nahead * 2;
        let is i64 as nrec = _u16(c, at);
        return chain_apply(c, nback, back, ninput, input + 2, nahead, ahead, nrec, at + 2, MATCH_COVERAGE, st, st, st);
    }
    return 0;
}
