// text/shape/tag.cst — scripts and languages, as tags: ISO 15924's four
// letters for a script, as HarfBuzz names scripts, and OpenType's for the
// script and language systems a font's GSUB and GPOS are arranged by.
use "buffer.cst" as buffer;
use "languages.cst" as languages;

// A tag from its four characters, the first in the high byte.
fn of(s as *u8) as i64 {
    return (cast(i64, s[0]) << 24) | (cast(i64, s[1]) << 16) | (cast(i64, s[2]) << 8) | cast(i64, s[3]);
}

// Whether tag t is one of the tags in list, written one after another.
fn _among(t as i64, list as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (list[i] != 0) {
        if (of(cast(*u8, cast(i64, list) + i)) == t) { return 1; }
        i = i + 4;
    }
    return 0;
}

// The direction script is written in when set horizontally: RTL for the
// scripts written right to left, 0 for those written either way, LTR for
// every other — HarfBuzz's list.
fn direction(script as i64) as i64 {
    if (_among(script, "ArabHebrSyrcThaaCprtKharPhnxNkooLydiAvstArmiPhliPrtiSarbOrkhSamrMandMercMeroManiMendNbatNarbPalmPhlpHatrAdlmRohgSogoSogdElymChrsYeziOugrGaraSidt") == 1) {
        return buffer.RTL;
    }
    if (_among(script, "HungItalRunrTfng") == 1) { return 0; }
    return buffer.LTR;
}

// --- OpenType's tags ---

let is i64 as DFLT with imut = 1145457748;   // 'DFLT', the default script
let is i64 as DFLT_LANG with imut = 1684434036;  // 'dflt'
let is i64 as LATN with imut = 1818326126;   // 'latn'
let is i64 as MAX_TAGS with imut = 3;

// The script tag of the Indic scripts' second shaping model, and Myanmar's;
// DFLT for the others.
fn _new_tag(script as i64) as i64 {
    if (script == of("Beng")) { return of("bng2"); }
    if (script == of("Deva")) { return of("dev2"); }
    if (script == of("Gujr")) { return of("gjr2"); }
    if (script == of("Guru")) { return of("gur2"); }
    if (script == of("Knda")) { return of("knd2"); }
    if (script == of("Mlym")) { return of("mlm2"); }
    if (script == of("Orya")) { return of("ory2"); }
    if (script == of("Taml")) { return of("tml2"); }
    if (script == of("Telu")) { return of("tel2"); }
    if (script == of("Mymr")) { return of("mym2"); }
    return DFLT;
}

// The ISO tag lowercased — but kana for both kanas, and the short ones'
// spaces kept.
fn _old_tag(script as i64) as i64 {
    if (script == 0) { return DFLT; }
    if (script == of("Zmth")) { return of("math"); }
    if (script == of("Hira") || script == of("Hrkt")) { return of("kana"); }
    if (script == of("Laoo")) { return of("lao "); }
    if (script == of("Yiii")) { return of("yi  "); }
    if (script == of("Nkoo")) { return of("nko "); }
    if (script == of("Vaii")) { return of("vai "); }
    return script | 536870912;
}

// The script tags a font may file script under, best first: the third and
// second Indic models and the first; at most *count, which is set to how
// many.
fn script_tags(script as i64, tags as *i64, count as *i64) as void {
    let is i64 as i with mut = 0;
    let is i64 as t = _new_tag(script);
    if (t != DFLT) {
        if (t != of("mym2")) {
            tags[i] = t | 51;
            i = i + 1;
        }
        if (*count > i) {
            tags[i] = t;
            i = i + 1;
        }
    }
    if (*count > i) {
        let is i64 as old = _old_tag(script);
        if (old != DFLT) {
            tags[i] = old;
            i = i + 1;
        }
    }
    *count = i;
}

fn _hex(c as i64) as i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

fn _alnum(c as i64) as i32 { return languages._alnum(c); }

fn _alpha(c as i64) as i32 {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { return 1; }
    return 0;
}

// A tag in a private-use subtag — "-hbsc" for a script, "-hbot" for a
// language — after s[from]: four letters, or eight hex digits after a
// hyphen. upper says which case the letters are made.
fn _private(s as *u8, from as i64, prefix as *u8, upper as i32, out as *i64) as i32 {
    if (from < 0) { return 0; }
    let is i64 as f with mut = languages._find(s, from, prefix);
    if (f < 0) { return 0; }
    f = f + languages._len(prefix);
    let is i64 as t with mut = 0;
    let is i64 as i with mut = 0;
    if (s[f] == 45) {
        f = f + 1;
        while (i < 8 && _hex(cast(i64, s[f + i])) >= 0) {
            t = (t << 4) | _hex(cast(i64, s[f + i]));
            i = i + 1;
        }
        if (i != 8) { return 0; }
    } else {
        while (i < 4 && _alnum(cast(i64, s[f + i])) == 1) {
            let is i64 as c with mut = cast(i64, s[f + i]);
            if (upper == 1 && c >= 97 && c <= 122) { c = c - 32; }
            if (upper == 0 && c >= 65 && c <= 90) { c = c + 32; }
            t = (t << 8) | c;
            i = i + 1;
        }
        if (i == 0) { return 0; }
        while (i < 4) {
            t = (t << 8) | 32;
            i = i + 1;
        }
    }
    if ((t & 3755991007) == DFLT) { t = t ^ 538976288; }
    *out = t;
    return 1;
}

// HarfBuzz's hb_tag_from_string: up to four characters, padded with spaces.
fn _tag_from(s as *u8, at as i64, n as i64) as i64 {
    if (n <= 0 || s[at] == 0) { return 0; }
    let is i64 as len with mut = n;
    if (len > 4) { len = 4; }
    let is i64 as t with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len && s[at + i] != 0) {
        t = (t << 8) | cast(i64, s[at + i]);
        i = i + 1;
    }
    while (i < 4) {
        t = (t << 8) | 32;
        i = i + 1;
    }
    return t;
}

fn _entry(table as *u8, i as i64, at as i64) as i64 { return of(cast(*u8, cast(i64, table) + i * 8 + at)); }

// Where key is among the n entries of table, eight characters each; -1 for
// nowhere.
fn _bfind(table as *u8, n as i64, key as i64) as i64 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = n;
    while (lo < hi) {
        let is i64 as mid = lo + (hi - lo) / 2;
        let is i64 as v = _entry(table, mid, 0);
        if (key < v) { hi = mid; } else if (key > v) { lo = mid + 1; } else { return mid; }
    }
    return 0 - 1;
}

fn _blocked(key as i64) as i32 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = languages.BLOCKED_N;
    while (lo < hi) {
        let is i64 as mid = lo + (hi - lo) / 2;
        let is i64 as v = of(cast(*u8, cast(i64, languages.BLOCKED) + mid * 4));
        if (key < v) { hi = mid; } else if (key > v) { lo = mid + 1; } else { return 1; }
    }
    return 0;
}

fn _strchr(s as *u8, from as i64, c as i64) as i64 {
    let is i64 as i with mut = from;
    while (s[i] != 0) {
        if (cast(i64, s[i]) == c) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// HarfBuzz's hb_ot_tags_from_language, for s up to limit.
fn _from_language(s as *u8, limit as i64, count as *i64, tags as *i64) as void {
    if (languages.complex(s, limit, count, tags) == 1) { return; }
    let is i64 as dash1 = _strchr(s, 0, 45);
    let is i64 as start with mut = 0;
    if (dash1 >= 0 && limit >= 6) {
        let is i64 as ext_end = _strchr(s, dash1 + 1, 45);
        let is i64 as ext_len with mut = languages._len(cast(*u8, cast(i64, s) + dash1 + 1));
        if (ext_end >= 0) { ext_len = ext_end - dash1 - 1; }
        if (ext_len == 3 && _alpha(cast(i64, s[dash1 + 1])) == 1) { start = dash1 + 1; }
    }
    let is i64 as dash = _strchr(s, start, 45);
    let is i64 as first_len with mut = limit - start;
    if (dash >= 0) { first_len = dash - start; }
    let is i64 as lang = _tag_from(s, start, first_len);
    if (first_len == 2) {
        let is i64 as k with mut = _bfind(languages.LANG2, languages.LANG2_N, lang);
        if (k >= 0) {
            while (k > 0 && _entry(languages.LANG2, k, 0) == _entry(languages.LANG2, k - 1, 0)) { k = k - 1; }
            let is i64 as i with mut = 0;
            while (i < *count && k + i < languages.LANG2_N && _entry(languages.LANG2, k + i, 0) == lang) {
                tags[i] = _entry(languages.LANG2, k + i, 4);
                i = i + 1;
            }
            *count = i;
            return;
        }
    } else if (first_len == 3) {
        let is i64 as k = _bfind(languages.LANG3, languages.LANG3_N, lang);
        if (k >= 0) {
            if (*count > 0) {
                tags[0] = _entry(languages.LANG3, k, 4);
                *count = 1;
            }
            return;
        }
        let is i64 as m = _bfind(languages.MULTI, languages.MULTI_N, lang);
        if (m >= 0) {
            let is *u8 as e = cast(*u8, cast(i64, languages.MULTI) + m * 8);
            let is i64 as off = (cast(i64, e[4]) - 48) * 100 + (cast(i64, e[5]) - 48) * 10 + cast(i64, e[6]) - 48;
            let is i64 as n = cast(i64, e[7]) - 48;
            let is i64 as i with mut = 0;
            while (i < *count && i < n) {
                tags[i] = of(cast(*u8, cast(i64, languages.MULTI_VALUES) + (off + i) * 4));
                i = i + 1;
            }
            *count = i;
            return;
        }
        if (_blocked(lang) == 1) {
            *count = 0;
            return;
        }
        // Taken to be ISO 639-3, and used uppercased.
        tags[0] = lang & 4292861919;
        *count = 1;
        return;
    }
    let is i64 as d with mut = dash1;
    if (d < 0) { d = languages._len(s); }
    if (d - start == 3) {
        tags[0] = _tag_from(s, 0, d) & 4292861919;
        *count = 1;
        return;
    }
    *count = 0;
}

// HarfBuzz's hb_ot_tags_from_script_and_language: the script tags (at most
// *scount) and language tags (at most *lcount) to look for in a font, best
// first, for an ISO 15924 script and a BCP 47 language — null for none. The
// language is read as HarfBuzz reads it: lowercased, "_" as "-", ending at
// any other character that is not a letter, digit or hyphen, and at 63
// characters.
fn from_script_and_language(script as i64, lang as *u8, stags as *i64, scount as *i64,
                            ltags as *i64, lcount as *i64) as void {
    let is i32 as needs_script with mut = 1;
    if (cast(i64, lang) == 0 || lang[0] == 0) {
        *lcount = 0;
    } else {
        let is [64]u8 as buf;
        let is i64 as n with mut = 0;
        let is i32 as going with mut = 1;
        while (going == 1 && n < 63) {
            let is i64 as c with mut = cast(i64, lang[n]);
            if (c >= 65 && c <= 90) { c = c + 32; }
            else if (c == 95) { c = 45; }
            else if (c != 45 && _alnum(c) == 0) { c = 0; }
            buf[n] = cast(u8, c);
            if (c == 0) { going = 0; } else { n = n + 1; }
        }
        buf[n] = 0;
        let is *u8 as s = cast(*u8, &buf);
        let is i64 as private with mut = 0 - 1;
        let is i64 as limit with mut = 0 - 1;
        if (s[0] == 120 && s[1] == 45) {
            private = 0;
        } else if (s[0] != 0) {
            let is i64 as i with mut = 1;
            let is i32 as scanning with mut = 1;
            while (scanning == 1 && s[i] != 0) {
                if (s[i - 1] == 45 && s[i + 1] == 45) {
                    if (s[i] == 120) {
                        private = i;
                        if (limit < 0) { limit = i - 1; }
                        scanning = 0;
                    } else if (limit < 0) {
                        limit = i - 1;
                    }
                }
                if (scanning == 1) { i = i + 1; }
            }
            if (limit < 0) { limit = i; }
        }
        let is i64 as t with mut = 0;
        if (*scount > 0 && _private(s, private, "-hbsc", 0, &t) == 1) {
            stags[0] = t;
            *scount = 1;
            needs_script = 0;
        }
        let is i32 as needs_language with mut = 1;
        if (*lcount > 0 && _private(s, private, "-hbot", 1, &t) == 1) {
            ltags[0] = t;
            *lcount = 1;
            needs_language = 0;
        }
        if (needs_language == 1 && *lcount > 0) { _from_language(s, limit, lcount, ltags); }
    }
    if (needs_script == 1 && *scount > 0) { script_tags(script, stags, scount); }
}
