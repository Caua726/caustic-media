// text/shape/khmer.cst — Khmer, as Microsoft's "Creating and supporting OpenType
// fonts for the Khmer script" gives it.
//
// Syllables are found; then, before the features that form subscripts, the
// left-hand vowels and a subscript ro (COENG RO), which draws in front of the
// base, are moved to the front of the syllable.
use "caustic-unicode/src/ucd/props.cst" as ucd;
use "caustic-unicode/src/ucd/tables/isc.cst" as isc;
use "glyphs.cst" as glyphs;
use "chars.cst" as chars;
use "compose.cst" as compose;
use "plan.cst" as plan;
use "work.cst" as work;
use "indic.cst" as indic;
use "syllable.cst" as syllable;
use "caustic-unicode/src/normalize/normalize.cst" as norm;

let is i64 as CAT_RA with imut = 82;          // R
let is i64 as CAT_COENG with imut = 72;       // H
let is i64 as CAT_ROBATIC with imut = 111;    // o
let is i64 as CAT_X with imut = 120;          // x
let is i64 as CAT_Y with imut = 121;          // y
let is i64 as CAT_VPRE with imut = 112;       // p
let is i64 as CAT_VABV with imut = 97;        // a
let is i64 as CAT_VBLW with imut = 98;        // b
let is i64 as CAT_VPST with imut = 113;       // q
let is i64 as CAT_CIRCLE with imut = 68;      // D

let is i64 as S_CONSONANT with imut = 0;
let is i64 as S_BROKEN with imut = 1;
let is i64 as S_OTHER with imut = 2;

let is syllable.Grammar as G_CONSONANT with mut;
let is syllable.Grammar as G_BROKEN with mut;

// Written out from these:
//   c = (C|R|V); cn = c ((J|j)? o)?; joiner = (J|j); x = (joiner* x)*; y = y*
//   matra = p? x b? x (joiner? a)? x q?
//   tail = x matra x (H c)? y
//   broken = o? (H cn)* (H | tail)
//   consonant = (cn|P|D) broken
let is *u8 as W_CONSONANT with imut = "((C|R|V)((J|j)?o)?|P|D)o?(H(C|R|V)((J|j)?o)?)*(H|((J|j)*x)*p?((J|j)*x)*b?((J|j)*x)*((J|j)?a)?((J|j)*x)*q?((J|j)*x)*(H(C|R|V))?y*)";
let is *u8 as W_BROKEN with imut = "o?(H(C|R|V)((J|j)?o)?)*(H|((J|j)*x)*p?((J|j)*x)*b?((J|j)*x)*((J|j)?a)?((J|j)*x)*q?((J|j)*x)*(H(C|R|V))?y*)";

let is i64 as M_PREF with imut = 0;
let is i64 as M_BLWF with imut = 1;
let is i64 as M_ABVF with imut = 2;
let is i64 as M_PSTF with imut = 3;
let is i64 as M_CFAR with imut = 4;

fn _tag(i as i64) as i64 {
    if (i == M_PREF) { return work.tag("pref"); }
    if (i == M_BLWF) { return work.tag("blwf"); }
    if (i == M_ABVF) { return work.tag("abvf"); }
    if (i == M_PSTF) { return work.tag("pstf"); }
    return work.tag("cfar");
}

fn collect(w as *work.Work) as void {
    let is *plan.Plan as p = w.plan;
    plan.pause(p, fn_ptr(_setup_syllables));
    plan.pause(p, fn_ptr(_reorder));
    plan.on(p, work.tag("locl"), plan.F_PER_SYLLABLE);
    plan.on(p, work.tag("ccmp"), plan.F_PER_SYLLABLE);
    let is i64 as i with mut = 0;
    while (i <= M_CFAR) {
        plan.add(p, _tag(i), plan.F_MANUAL_JOINERS | plan.F_PER_SYLLABLE);
        i = i + 1;
    }
    plan.pause(p, cast(plan.Pause, 0));
    plan.on(p, work.tag("pres"), plan.F_MANUAL_JOINERS);
    plan.on(p, work.tag("abvs"), plan.F_MANUAL_JOINERS);
    plan.on(p, work.tag("blws"), plan.F_MANUAL_JOINERS);
    plan.on(p, work.tag("psts"), plan.F_MANUAL_JOINERS);
}

// The specification has clig among what is required.
fn override(w as *work.Work) as void {
    plan.on(w.plan, work.tag("clig"), 0);
    plan.off(w.plan, work.tag("liga"));
}

fn prepared(w as *work.Work) as void {
    let is i64 as i with mut = 0;
    while (i <= M_CFAR) {
        w.masks[i] = plan.one_of(w.plan, _tag(i));
        i = i + 1;
    }
    syllable.compile(&G_CONSONANT, W_CONSONANT);
    syllable.compile(&G_BROKEN, W_BROKEN);
}

// Vowels split in two that Unicode does not decompose.
fn decompose_rule(u as i64, parts as *i64) as i64 {
    if (u == 6078 || u == 6079 || u == 6080 || u == 6084 || u == 6085) {   // 17BE 17BF 17C0 17C4 17C5
        parts[0] = 6081;                                                    // 17C1
        parts[1] = u;
        return 2;
    }
    return compose.decompose_once(u, parts);
}

fn compose_rule(a as i64, b as i64) as i64 {
    if (chars.is_mark(chars.category(a)) == 1) { return 0; }
    return cast(i64, norm.compose_pair(cast(i32, a), cast(i32, b)));
}

fn ways(w as *work.Work) as void {
    w.zero = work.ZERO_NONE;
    w.fallback = 0;
    w.rules.mode = compose.PARTS;
    w.rules.decompose = fn_ptr(decompose_rule);
    w.rules.compose = fn_ptr(compose_rule);
}

fn _category(u as i64) as i64 {
    if (u == 6042) { return CAT_RA; }                                        // 179A
    if (u == 6089 || u == 6090 || u == 6092) { return CAT_ROBATIC; }         // 17C9 17CA 17CC
    if (u == 6086 || u == 6091 || (u >= 6093 && u <= 6097)) { return CAT_X; }    // 17C6 17CB 17CD..17D1
    if (u == 6087 || u == 6088 || u == 6109 || u == 6099) { return CAT_Y; }  // 17C7 17C8 17DD 17D3
    if (u == 9676) { return CAT_CIRCLE; }
    if (indic.is_more_base(u) == 1) { return indic.CAT_PLACEHOLDER; }
    let is i64 as cat = indic.syllabic_category(u);
    if (cat == isc.ISC_Vowel_Dependent) {
        let is i64 as pos = indic.base_position(ucd.indic_positional_category(cast(i32, u)));
        if (pos == indic.POS_PRE_C) { return CAT_VPRE; }
        if (pos == indic.POS_ABOVE_C) { return CAT_VABV; }
        if (pos == indic.POS_BELOW_C) { return CAT_VBLW; }
        if (pos == indic.POS_POST_C) { return CAT_VPST; }
    }
    return indic.base_category(cat);
}

fn setup(w as *work.Work) as void {
    let is *glyphs.Run as run = w.run;
    let is i64 as i with mut = 0;
    while (i < run.len) {
        run.src[i].scat = cast(u8, _category(cast(i64, run.src[i].id)));
        i = i + 1;
    }
}

fn _setup_syllables(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is [2]*syllable.Grammar as gs;
    gs[S_CONSONANT] = &G_CONSONANT;
    gs[S_BROKEN] = &G_BROKEN;
    w.values[0] = cast(i64, syllable.find(w.run, cast(**syllable.Grammar, &gs), 2, S_OTHER, S_BROKEN));
}

// Record from moved to to, before it, what is between shifted up; one cluster.
fn _to_front(run as *glyphs.Run, to as i64, from as i64, count as i64) as void {
    glyphs.join(run, to, from + count);
    let is [2]glyphs.Glyph as t;
    let is i64 as k with mut = 0;
    while (k < count) {
        t[k] = run.src[from + k];
        k = k + 1;
    }
    k = from - 1;
    while (k >= to) {
        run.src[k + count] = run.src[k];
        k = k - 1;
    }
    k = 0;
    while (k < count) {
        run.src[to + k] = t[k];
        k = k + 1;
    }
}

fn _reorder_syllable(w as *work.Work, start as i64, end as i64) as void {
    let is *glyphs.Run as run = w.run;
    let is i64 as post = w.masks[M_BLWF] | w.masks[M_ABVF] | w.masks[M_PSTF];
    let is i64 as i with mut = start + 1;
    while (i < end) {
        run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | post);
        i = i + 1;
    }
    let is i64 as coengs with mut = 0;
    i = start + 1;
    while (i < end) {
        let is i64 as c = cast(i64, run.src[i].scat);
        if (c == CAT_COENG && coengs <= 2 && i + 1 < end) {
            coengs = coengs + 1;
            if (cast(i64, run.src[i + 1].scat) == CAT_RA) {
                // A subscript ro goes in front; what is after it asks for cfar,
                // so a font can tell it from a ro written later.
                run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | w.masks[M_PREF]);
                run.src[i + 1].mask = cast(u64, cast(i64, run.src[i + 1].mask) | w.masks[M_PREF]);
                _to_front(run, start, i, 2);
                if (w.masks[M_CFAR] != 0) {
                    let is i64 as j with mut = i + 2;
                    while (j < end) {
                        run.src[j].mask = cast(u64, cast(i64, run.src[j].mask) | w.masks[M_CFAR]);
                        j = j + 1;
                    }
                }
                coengs = 2;
            }
        } else if (c == CAT_VPRE) {
            _to_front(run, start, i, 1);
        }
        i = i + 1;
    }
}

fn _reorder(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is *glyphs.Run as run = w.run;
    if (w.values[0] == 1) { syllable.insert_circles(w, S_BROKEN, CAT_CIRCLE, 0, 0); }
    let is i64 as start with mut = 0;
    while (start < run.len) {
        let is i64 as end = syllable.end_of(run, start);
        if ((cast(i64, run.src[start].syl) & 15) != S_OTHER) { _reorder_syllable(w, start, end); }
        start = end;
    }
}
