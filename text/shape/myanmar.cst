// text/shape/myanmar.cst — Myanmar, as Microsoft's "Creating and supporting
// OpenType fonts for Myanmar" gives it, for fonts with its tag 'mym2'.
//
// Syllables are found, and each put in the order the features expect: a kinzi after
// the base; a medial ra and left vowels before it; the rest by where it goes.
use "caustic-unicode/src/ucd/props.cst" as ucd;
use "caustic-unicode/src/ucd/tables/isc.cst" as isc;
use "glyphs.cst" as glyphs;
use "compose.cst" as compose;
use "plan.cst" as plan;
use "work.cst" as work;
use "indic.cst" as indic;
use "syllable.cst" as syllable;

let is i64 as CAT_C with imut = 67;       // C
let is i64 as CAT_RA with imut = 82;      // R
let is i64 as CAT_V with imut = 86;       // V independent vowels
let is i64 as CAT_GB with imut = 71;      // G a generic base
let is i64 as CAT_CIRCLE with imut = 68;  // D
let is i64 as CAT_H with imut = 72;       // H
let is i64 as CAT_AS with imut = 97;      // a asat
let is i64 as CAT_VS with imut = 115;     // s a variation selector
let is i64 as CAT_MY with imut = 121;     // y
let is i64 as CAT_MR with imut = 114;     // r
let is i64 as CAT_MW with imut = 119;     // w
let is i64 as CAT_MH with imut = 104;     // h
let is i64 as CAT_ML with imut = 108;     // l
let is i64 as CAT_VPRE with imut = 112;   // p
let is i64 as CAT_VABV with imut = 116;   // t
let is i64 as CAT_VBLW with imut = 98;    // b
let is i64 as CAT_A with imut = 65;       // A an anusvara and the like
let is i64 as CAT_DOT with imut = 111;    // o the dot below
let is i64 as CAT_VPST with imut = 113;   // q
let is i64 as CAT_PT with imut = 80;      // P a Pwo tone mark
let is i64 as CAT_SM with imut = 83;      // S
let is i64 as CAT_CS with imut = 84;      // T
let is i64 as CAT_ZWJ with imut = 74;     // J
let is i64 as CAT_ZWNJ with imut = 106;   // j
let is i64 as CAT_X with imut = 88;       // X

let is i64 as S_CONSONANT with imut = 0;
let is i64 as S_JOINER with imut = 1;
let is i64 as S_BROKEN with imut = 2;
let is i64 as S_OTHER with imut = 3;

let is syllable.Grammar as G_CONSONANT with mut;
let is syllable.Grammar as G_JOINER with mut;
let is syllable.Grammar as G_BROKEN with mut;

// Written out from these, where k is a kinzi:
//   k = (R a H); c = (C|R)
//   medial = y? a? r? ((w h? l? | h l? | l) a?)?
//   main = (p s?)* t* b* A* (o a?)?; post = q h? l? a* t* A* (o a?)?; pwo = P A* o? a?
//   complex = a* medial main post* (pwo|S)* (J|j)?
//   tail = (H (c|V) s?)* (H | complex)
//   consonant = (k|T)? (c|V|G|D) s? tail
//   broken = k? s? tail
let is *u8 as W_CONSONANT with imut = "((RaH)|T)?((C|R)|V|G|D)s?(H((C|R)|V)s?)*(H|a*y?a?r?((wh?l?|hl?|l)a?)?(ps?)*t*b*A*(oa?)?(qh?l?a*t*A*(oa?)?)*(PA*o?a?|S)*(J|j)?)";
let is *u8 as W_JOINER with imut = "(J|j)";
let is *u8 as W_BROKEN with imut = "(RaH)?s?(H((C|R)|V)s?)*(H|a*y?a?r?((wh?l?|hl?|l)a?)?(ps?)*t*b*A*(oa?)?(qh?l?a*t*A*(oa?)?)*(PA*o?a?|S)*(J|j)?)";

fn collect(w as *work.Work) as void {
    let is *plan.Plan as p = w.plan;
    plan.pause(p, fn_ptr(_setup_syllables));
    plan.on(p, work.tag("locl"), plan.F_PER_SYLLABLE);
    plan.on(p, work.tag("ccmp"), plan.F_PER_SYLLABLE);
    plan.pause(p, fn_ptr(_reorder));
    let is i64 as flags = plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE;
    plan.on(p, work.tag("rphf"), flags);
    plan.pause(p, cast(plan.Pause, 0));
    plan.on(p, work.tag("pref"), flags);
    plan.pause(p, cast(plan.Pause, 0));
    plan.on(p, work.tag("blwf"), flags);
    plan.pause(p, cast(plan.Pause, 0));
    plan.on(p, work.tag("pstf"), flags);
    plan.pause(p, cast(plan.Pause, 0));
    plan.pause(p, cast(plan.Pause, 0));
    plan.on(p, work.tag("pres"), plan.F_MANUAL_ZWJ);
    plan.on(p, work.tag("abvs"), plan.F_MANUAL_ZWJ);
    plan.on(p, work.tag("blws"), plan.F_MANUAL_ZWJ);
    plan.on(p, work.tag("psts"), plan.F_MANUAL_ZWJ);
}

fn override(w as *work.Work) as void { plan.off(w.plan, work.tag("liga")); }

fn prepared(w as *work.Work) as void {
    syllable.compile(&G_CONSONANT, W_CONSONANT);
    syllable.compile(&G_JOINER, W_JOINER);
    syllable.compile(&G_BROKEN, W_BROKEN);
}

fn ways(w as *work.Work) as void {
    w.zero = work.ZERO_EARLY;
    w.fallback = 0;
    w.rules.mode = compose.PARTS;
}

fn _category(u as i64) as i64 {
    if (u == 4174) { return CAT_C; }                                  // 104E
    if (u == 4100 || u == 4123 || u == 4186) { return CAT_RA; }       // 1004 101B 105A
    if (u == 4146 || u == 4150) { return CAT_A; }                     // 1032 1036
    if (u == 4151) { return CAT_DOT; }                                // 1037
    if (u == 4152 || (u >= 4231 && u <= 4237) || u == 4239 || (u >= 4250 && u <= 4252)) { return CAT_SM; }  // 1038 1087..108D 108F 109A..109C
    if (u == 4153) { return CAT_H; }                                  // 1039
    if (u == 4154) { return CAT_AS; }                                 // 103A
    if (u == 4155 || u == 4190 || u == 4191) { return CAT_MY; }       // 103B 105E 105F
    if (u == 4156) { return CAT_MR; }                                 // 103C
    if (u == 4157 || u == 4226) { return CAT_MW; }                    // 103D 1082
    if (u == 4158) { return CAT_MH; }                                 // 103E
    if (u == 4192) { return CAT_ML; }                                 // 1060
    if (u == 4195 || u == 4196 || (u >= 4201 && u <= 4205) || u == 43643) { return CAT_PT; }  // 1063 1064 1069..106D AA7B
    if (u == 43644 || u == 43645) { return CAT_DOT; }                 // AA7C AA7D
    if (u >= 65024 && u <= 65039) { return CAT_VS; }                  // FE00..FE0F
    if (indic.is_more_base(u) == 1) { return CAT_GB; }
    if (u == 9676) { return CAT_CIRCLE; }
    let is i64 as cat = indic.syllabic_category(u);
    if (cat == isc.ISC_Vowel_Dependent || cat == isc.ISC_Pure_Killer) {
        let is i64 as pos = indic.base_position(ucd.indic_positional_category(cast(i32, u)));
        if (pos == indic.POS_PRE_C || pos == indic.POS_PRE_M) { return CAT_VPRE; }
        if (pos == indic.POS_ABOVE_C) { return CAT_VABV; }
        if (pos == indic.POS_BELOW_C) { return CAT_VBLW; }
        if (pos == indic.POS_POST_C) { return CAT_VPST; }
    }
    if (cat == isc.ISC_Consonant || cat == isc.ISC_Consonant_Dead) { return CAT_C; }
    if (cat == isc.ISC_Vowel_Independent || cat == isc.ISC_Vowel) { return CAT_V; }
    if (cat == isc.ISC_Consonant_Placeholder || cat == isc.ISC_Number || cat == isc.ISC_Number_Joiner) { return CAT_GB; }
    if (cat == isc.ISC_Consonant_With_Stacker) { return CAT_CS; }
    if (cat == isc.ISC_Joiner) { return CAT_ZWJ; }
    if (cat == isc.ISC_Non_Joiner) { return CAT_ZWNJ; }
    if (cat == isc.ISC_Virama || cat == isc.ISC_Invisible_Stacker) { return CAT_H; }
    if (cat == isc.ISC_Bindu || cat == isc.ISC_Cantillation_Mark || cat == isc.ISC_Tone_Mark) { return CAT_A; }
    if (cat == isc.ISC_Visarga || cat == isc.ISC_Syllable_Modifier) { return CAT_SM; }
    if (cat == isc.ISC_Consonant_Medial) { return CAT_MY; }
    return CAT_X;
}

fn setup(w as *work.Work) as void {
    let is *glyphs.Run as run = w.run;
    let is i64 as i with mut = 0;
    while (i < run.len) {
        run.src[i].scat = cast(u8, _category(cast(i64, run.src[i].id)));
        i = i + 1;
    }
}

fn _setup_syllables(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is [3]*syllable.Grammar as gs;
    gs[S_CONSONANT] = &G_CONSONANT;
    gs[S_JOINER] = &G_JOINER;
    gs[S_BROKEN] = &G_BROKEN;
    w.values[0] = cast(i64, syllable.find(w.run, cast(**syllable.Grammar, &gs), 3, S_OTHER, S_BROKEN));
}

fn _is_consonant(g as *glyphs.Glyph) as i32 {
    let is i64 as c = cast(i64, g.scat);
    return cast(i32, (cast(i64, g.made) & glyphs.LIGATED) == 0 &&
                     (c == CAT_C || c == CAT_CS || c == CAT_RA || c == CAT_V || c == CAT_GB || c == CAT_CIRCLE));
}

fn _reverse(run as *glyphs.Run, a as i64, b as i64) as void {
    let is i64 as i with mut = a;
    let is i64 as j with mut = b - 1;
    while (i < j) {
        let is glyphs.Glyph as t = run.src[i];
        run.src[i] = run.src[j];
        run.src[j] = t;
        i = i + 1;
        j = j - 1;
    }
}

fn _reorder_syllable(run as *glyphs.Run, start as i64, end as i64) as void {
    let is i32 as has_reph = cast(i32, start + 3 <= end && cast(i64, run.src[start].scat) == CAT_RA &&
                                       cast(i64, run.src[start + 1].scat) == CAT_AS && cast(i64, run.src[start + 2].scat) == CAT_H);
    let is i64 as limit with mut = start;
    let is i64 as base with mut = start;
    if (has_reph == 1) {
        limit = start + 3;
    } else {
        base = limit;
    }
    let is i64 as k with mut = limit;
    let is i32 as found with mut = 0;
    while (k < end && found == 0) {
        if (_is_consonant(&run.src[k]) == 1) {
            base = k;
            found = 1;
        }
        k = k + 1;
    }
    let is i64 as i with mut = start;
    if (has_reph == 1) {
        while (i < start + 3) {
            run.src[i].spos = cast(u8, indic.POS_AFTER_MAIN);
            i = i + 1;
        }
    }
    while (i < base) {
        run.src[i].spos = cast(u8, indic.POS_PRE_C);
        i = i + 1;
    }
    if (i < end) {
        run.src[i].spos = cast(u8, indic.POS_BASE_C);
        i = i + 1;
    }
    let is i64 as pos with mut = indic.POS_AFTER_MAIN;
    while (i < end) {
        let is i64 as c = cast(i64, run.src[i].scat);
        if (c == CAT_MR) {
            run.src[i].spos = cast(u8, indic.POS_PRE_C);
        } else if (c == CAT_VPRE) {
            run.src[i].spos = cast(u8, indic.POS_PRE_M);
        } else if (c == CAT_VS) {
            run.src[i].spos = run.src[i - 1].spos;
        } else if (pos == indic.POS_AFTER_MAIN && c == CAT_VBLW) {
            pos = indic.POS_BELOW_C;
            run.src[i].spos = cast(u8, pos);
        } else if (pos == indic.POS_BELOW_C && c == CAT_A) {
            run.src[i].spos = cast(u8, indic.POS_BEFORE_SUB);
        } else if (pos == indic.POS_BELOW_C && c == CAT_VBLW) {
            run.src[i].spos = cast(u8, pos);
        } else if (pos == indic.POS_BELOW_C) {
            pos = indic.POS_AFTER_SUB;
            run.src[i].spos = cast(u8, pos);
        } else {
            run.src[i].spos = cast(u8, pos);
        }
        i = i + 1;
    }
    syllable.sort_merging(run, start, end);
    // Left vowels written one after another stay in the order written.
    let is i64 as first with mut = end;
    let is i64 as last with mut = end;
    i = start;
    while (i < end) {
        if (cast(i64, run.src[i].spos) == indic.POS_PRE_M) {
            if (first == end) { first = i; }
            last = i;
        }
        i = i + 1;
    }
    if (first < last) {
        _reverse(run, first, last + 1);
        let is i64 as a with mut = first;
        let is i64 as j with mut = first;
        while (j <= last) {
            if (cast(i64, run.src[j].scat) == CAT_VPRE) {
                _reverse(run, a, j + 1);
                a = j + 1;
            }
            j = j + 1;
        }
    }
}

fn _reorder(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is *glyphs.Run as run = w.run;
    if (w.values[0] == 1) { syllable.insert_circles(w, S_BROKEN, CAT_CIRCLE, indic.POS_BASE_C, 0); }
    let is i64 as start with mut = 0;
    while (start < run.len) {
        let is i64 as end = syllable.end_of(run, start);
        let is i64 as kind = cast(i64, run.src[start].syl) & 15;
        if (kind == S_CONSONANT || kind == S_BROKEN) { _reorder_syllable(run, start, end); }
        start = end;
    }
}
