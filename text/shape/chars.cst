// text/shape/chars.cst — what shaping asks of Unicode about a character:
// its category and combining class from caustic-unicode, and from
// tables.cst whether it draws nothing (a default ignorable). The rest are
// the few facts the steps of shape.md need by name: which characters
// continue a grapheme, which select a variant, which are spaces of a given
// width.
use "caustic-unicode/src/ucd/props.cst" as ucd;
use "caustic-unicode/src/ucd/tables/extpict.cst" as extpict;
use "caustic-unicode/src/bidi/bidi.cst" as bidi;
use "tables.cst" as tables;

fn category(u as i64) as i64 { return ucd.general_category(cast(i32, u)); }
fn combining_class(u as i64) as i64 { return ucd.combining_class(cast(i32, u)); }

let is i64 as OTHER_LETTER with imut = 5;    // ucd.GC_LO
let is i64 as NON_SPACING_MARK with imut = 6;
let is i64 as SPACING_MARK with imut = 7;
let is i64 as ENCLOSING_MARK with imut = 8;
let is i64 as DECIMAL_NUMBER with imut = 9;

fn is_mark(gc as i64) as i32 { return cast(i32, gc == ucd.GC_MN || gc == ucd.GC_MC || gc == ucd.GC_ME); }

let is *u8 as HEBREW_ORDER with imut = "\x16\x0f\x10\x11\x17\x12\x13\x14\x15\x0e\x18\x0c\x19\x0d\x0a\x0b\x1a";

// The class marks are put in order by: the character's own, but where writing
// wants another order than Unicode's numbers give. Hebrew's fixed classes in
// the order the SBL Hebrew manual gives; Arabic's shadda before the vowels;
// Telugu's length marks, Thai's sara u and Tibetan's vowels before the
// virama and what would otherwise come first.
fn order_class(ccc as i64) as i64 {
    if (ccc >= 10 && ccc <= 26) { return cast(i64, HEBREW_ORDER[ccc - 10]); }
    if (ccc >= 27 && ccc <= 32) { return ccc + 1; }
    if (ccc == 33) { return 27; }
    if (ccc == 84) { return 4; }
    if (ccc == 91) { return 5; }
    if (ccc == 103) { return 3; }
    if (ccc == 130) { return 132; }
    if (ccc == 132) { return 131; }
    return ccc;
}

// The class a character is sorted by. Three go by other than Unicode's: Tibetan's
// tsa-phru before the vowels, its padma after them, and Tai Tham's sakot after
// the tone marks, as fonts for those scripts expect.
fn shaping_class(u as i64) as i64 {
    if (u == 3897) { return 127; }                 // 0F39
    if (u == 4038 || u == 6752) { return 254; }    // 0FC6 1A60
    return combining_class(u);
}

// Characters that begin a grapheme whatever comes before them: letters
// other than modifiers, and spaces.
fn begins_grapheme(gc as i64) as i32 {
    return cast(i32, gc == ucd.GC_LU || gc == ucd.GC_LL || gc == ucd.GC_LT || gc == ucd.GC_LO || gc == ucd.GC_ZS);
}

fn _hexval(s as *u8, at as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < 6) {
        let is i64 as c = cast(i64, s[at + i]);
        let is i64 as d with mut = c - 48;
        if (c >= 65) { d = c - 55; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

// Whether u is a default ignorable code point: drawn as nothing.
fn is_ignorable(u as i64) as i32 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = tables.IGNORABLE_COUNT - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        if (u < _hexval(tables.IGNORABLE, mid * 12)) { hi = mid - 1; }
        else if (u > _hexval(tables.IGNORABLE, mid * 12 + 6)) { lo = mid + 1; }
        else { return 1; }
    }
    return 0;
}

let is i64 as ZWNJ with imut = 8204;
let is i64 as ZWJ with imut = 8205;
let is i64 as CGJ with imut = 847;
let is i64 as DOTTED_CIRCLE with imut = 9676;
let is i64 as FRACTION_SLASH with imut = 8260;
let is i64 as REPLACEMENT with imut = 65533;

// Default ignorables that substitutions must still see, being there to tell
// the font something: Mongolian free variation selectors, the letters of a
// tag sequence, and a grapheme joiner (shape.cst lets one go where it blocks
// no reordering). The other default ignorables — the variation selectors
// among them, which choose glyphs through the cmap — are passed over by
// substitutions and positioning alike.
fn is_hidden(u as i64) as i32 {
    if (u >= 6155 && u <= 6159 && u != 6158) { return 1; }   // Mongolian free variation selectors
    if (u >= 917536 && u <= 917631) { return 1; }      // tags E0020..E007F
    return cast(i32, u == CGJ);
}

fn is_variation_selector(u as i64) as i32 {
    return cast(i32, (u >= 65024 && u <= 65039) || (u >= 917760 && u <= 917999));
}

fn is_regional_indicator(u as i64) as i32 { return cast(i32, u >= 127462 && u <= 127487); }
fn is_emoji_modifier(u as i64) as i32 { return cast(i32, u >= 127995 && u <= 127999); }
fn is_pictographic(u as i64) as i32 { return cast(i32, extpict.extpict_get(cast(i32, u)) != 0); }

// The character drawn in u's place right to left; u itself for none.
fn mirror(u as i64) as i64 { return cast(i64, bidi.mirror(cast(i32, u))); }

// --- Spaces ---

// How wide a space is when the font has no glyph for it and its own space
// is drawn instead: a share of the em, or as wide as something else.
let is i64 as NOT_SPACE with imut = 0;
let is i64 as SPACE_EM with imut = 1;          // the em divided by the kind: 1, 2, 3, 4, 5, 6
let is i64 as SPACE_EM_16 with imut = 16;      // a sixteenth of the em
let is i64 as SPACE_4_EM_18 with imut = 17;    // four eighteenths of the em
let is i64 as SPACE_SPACE with imut = 18;      // as wide as the space
let is i64 as SPACE_FIGURE with imut = 19;     // as a digit
let is i64 as SPACE_PUNCTUATION with imut = 20;   // as a full stop
let is i64 as SPACE_NARROW with imut = 21;     // a narrow no-break space

fn space_kind(u as i64) as i64 {
    if (u == 32 || u == 160) { return SPACE_SPACE; }
    if (u == 8192 || u == 8194) { return 2; }        // en quad, en space
    if (u == 8193 || u == 8195) { return 1; }        // em quad, em space
    if (u == 8196) { return 3; }                     // three-per-em
    if (u == 8197) { return 4; }                     // four-per-em
    if (u == 8198) { return 6; }                     // six-per-em
    if (u == 8199) { return SPACE_FIGURE; }
    if (u == 8200) { return SPACE_PUNCTUATION; }
    if (u == 8201) { return 5; }                     // thin
    if (u == 8202) { return SPACE_EM_16; }           // hair
    if (u == 8239) { return SPACE_NARROW; }
    if (u == 8287) { return SPACE_4_EM_18; }         // medium mathematical
    if (u == 12288) { return 1; }                    // ideographic
    return NOT_SPACE;
}
