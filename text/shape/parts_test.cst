// text/shape/parts_test.cst — the shaper's parts held to their sources, where
// shaping whole texts does not reach them: the characters Unicode names; the
// script and language tags OpenType's registries give; UTF-8 as RFC 3629
// reads it; Hangul's decomposition; where a combining class puts a mark; the
// run's bounds and the way a pass seeks; how many features a plan can give
// bits to; and where the shaper says text is unsafe to break — no wider than
// the lookups that matched.
//
// Run from the repository's root, where text/testdata is.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../sfnt/sfnt.cst" as sfnt;
use "../sfnt/table.cst" as table;
use "../sfnt/var.cst" as var;
use "../outline/outline.cst" as outline;
use "chars.cst" as chars;
use "scripts.cst" as scripts;
use "tables.cst" as tables;
use "langs.cst" as langs;
use "glyphs.cst" as glyphs;
use "compose.cst" as compose;
use "fallback.cst" as fallback;
use "otl.cst" as otl;
use "plan.cst" as plan;
use "shape.cst" as shape;

let is i32 as fails with mut = 0;
let is i32 as checks with mut = 0;

fn check(what as *u8, ok as i32) as void {
    checks = checks + 1;
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

let is i64 as loaded with mut = 0;

fn load(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    loaded = 0;
    if (fd < 0) { return cast(*u8, 0); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as p = mem.core.mmap_anon(size + 4096);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, p) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    loaded = n;
    return p;
}

// --- Characters ---

fn characters() as void {
    check("FE0F, a variation selector, is not hidden", chars.is_hidden(65039) == 0);
    check("E0100, a variation selector, is not hidden", chars.is_hidden(917760) == 0);
    check("Mongolian FVS1 (180B) is hidden", chars.is_hidden(6155) == 1);
    check("Mongolian FVS4 (180F) is hidden", chars.is_hidden(6159) == 1);
    check("the Mongolian vowel separator (180E) is not", chars.is_hidden(6158) == 0);
    check("the first tag (E0020) is hidden", chars.is_hidden(917536) == 1);
    check("the cancel tag (E007F) is hidden", chars.is_hidden(917631) == 1);
    check("E0080, past the tags, is not", chars.is_hidden(917632) == 0);
    check("the grapheme joiner is hidden", chars.is_hidden(847) == 1);
    check("1F1E6 is a regional indicator", chars.is_regional_indicator(127462) == 1);
    check("1F1E5 is not", chars.is_regional_indicator(127461) == 0);
    check("FE00 and FE0F are variation selectors", chars.is_variation_selector(65024) == 1 &&
          chars.is_variation_selector(65039) == 1);
    check("FDFF and FE10 are not", chars.is_variation_selector(65023) == 0 && chars.is_variation_selector(65040) == 0);
    check("E0100 and E01EF are", chars.is_variation_selector(917760) == 1 && chars.is_variation_selector(917999) == 1);
    check("E00FF and E01F0 are not", chars.is_variation_selector(917759) == 0 &&
          chars.is_variation_selector(918000) == 0);
    check("1F1FF is a regional indicator", chars.is_regional_indicator(127487) == 1);
    check("1F200 is not", chars.is_regional_indicator(127488) == 0);
    check("1F3FF is an emoji modifier", chars.is_emoji_modifier(127999) == 1);
    check("1F400 is not", chars.is_emoji_modifier(128000) == 0);
}

// --- Scripts ---

fn script_tags_are(script as *u8, n as i64, first as *u8, second as *u8) as i32 {
    let is [2]i64 as out;
    let is i64 as k = scripts.tags(scripts.of(script), cast(*i64, &out));
    if (k != n) { return 0; }
    if (n >= 1 && out[0] != scripts.of(first)) { return 0; }
    if (n >= 2 && out[1] != scripts.of(second)) { return 0; }
    return 1;
}

fn script_tags() as void {
    check("Bengali: bng2, then beng", script_tags_are("Beng", 2, "bng2", "beng"));
    check("Devanagari: dev2, then deva", script_tags_are("Deva", 2, "dev2", "deva"));
    check("Gujarati: gjr2, then gujr", script_tags_are("Gujr", 2, "gjr2", "gujr"));
    check("Gurmukhi: gur2, then guru", script_tags_are("Guru", 2, "gur2", "guru"));
    check("Kannada: knd2, then knda", script_tags_are("Knda", 2, "knd2", "knda"));
    check("Malayalam: mlm2, then mlym", script_tags_are("Mlym", 2, "mlm2", "mlym"));
    check("Odia: ory2, then orya", script_tags_are("Orya", 2, "ory2", "orya"));
    check("Tamil: tml2, then taml", script_tags_are("Taml", 2, "tml2", "taml"));
    check("Telugu: tel2, then telu", script_tags_are("Telu", 2, "tel2", "telu"));
    check("Myanmar: mym2, then mymr", script_tags_are("Mymr", 2, "mym2", "mymr"));
    check("Latin: latn alone", script_tags_are("Latn", 1, "latn", "latn"));
    check("Hiragana: kana", script_tags_are("Hira", 1, "kana", "kana"));
    check("Lao: 'lao '", script_tags_are("Laoo", 1, "lao ", "lao "));
    check("Zanabazar Square: zanb", script_tags_are("Zanb", 1, "zanb", "zanb"));
    check("N'Ko: 'nko '", script_tags_are("Nkoo", 1, "nko ", "nko "));
    check("Vai: 'vai '", script_tags_are("Vaii", 1, "vai ", "vai "));
    check("Yi: 'yi  '", script_tags_are("Yiii", 1, "yi  ", "yi  "));
    check("mathematical notation: math", script_tags_are("Zmth", 1, "math", "math"));
    check("Adlam: adlm, its capital lowered", script_tags_are("Adlm", 1, "adlm", "adlm"));
    check("common: none", script_tags_are("Zyyy", 0, "", ""));
    check("Adlam is written right to left", scripts.direction(scripts.of("Adlm")) == scripts.RTL);
    check("Yezidi is written right to left", scripts.direction(scripts.of("Yezi")) == scripts.RTL);
    check("Thaana is written right to left", scripts.direction(scripts.of("Thaa")) == scripts.RTL);
    check("Latin is written left to right", scripts.direction(scripts.of("Latn")) == scripts.LTR);
    check("Zanabazar Square, after every right-to-left script: left to right", scripts.direction(scripts.of("Zanb")) == scripts.LTR);
    check("common has no direction of its own", scripts.direction(scripts.of("Zyyy")) == 0);
    // Every script the table lists, found in it.
    let is i32 as all_rtl with mut = 1;
    let is i64 as k with mut = 0;
    while (k < tables.RTL_COUNT) {
        let is i64 as t = scripts.of(cast(*u8, cast(i64, tables.RTL) + k * 4));
        if (scripts.direction(t) != scripts.RTL) { all_rtl = 0; }
        k = k + 1;
    }
    check("each of the 36 right-to-left scripts", all_rtl == 1 && tables.RTL_COUNT == 36);
}

// --- Languages ---

fn lang_tags_are(lang as *u8, max as i64, n as i64, first as *u8, second as *u8) as i32 {
    let is [8]i64 as out;
    let is i64 as k = langs.tags(lang, cast(*i64, &out), max);
    if (k != n) { return 0; }
    if (n >= 1 && out[0] != scripts.of(first)) { return 0; }
    if (n >= 2 && out[1] != scripts.of(second)) { return 0; }
    return 1;
}

fn language_tags() as void {
    let is [8]i64 as tags_out;
    check("en: ENG", lang_tags_are("en", 8, 1, "ENG ", ""));
    check("EN, in capitals: ENG", lang_tags_are("EN", 8, 1, "ENG ", ""));
    check("eng: ENG", lang_tags_are("eng", 8, 1, "ENG ", ""));
    check("tr: TRK", lang_tags_are("tr", 8, 1, "TRK ", ""));
    check("aa, the first two-letter code: AFR", lang_tags_are("aa", 8, 1, "AFR ", ""));
    check("zu, the last two-letter code: ZUL", lang_tags_are("zu", 8, 1, "ZUL ", ""));
    check("aaq, the registry's first: AAQ", lang_tags_are("aaq", 8, 1, "AAQ ", ""));
    check("ZZA, the registry's last, in capitals: ZZA", lang_tags_are("ZZA", 8, 1, "ZZA ", ""));
    check("arb, a member of Arabic: ARA", lang_tags_are("arb", 8, 1, "ARA ", ""));
    check("aae, the first member listed: SQI", lang_tags_are("aae", 8, 1, "SQI ", ""));
    check("aao, a member of Arabic listed second: ARA", lang_tags_are("aao", 8, 1, "ARA ", ""));
    check("pes, a member of Persian: FAR", lang_tags_are("pes", 8, 1, "FAR ", ""));
    check("no: NOR, then NYN", lang_tags_are("no", 8, 2, "NOR ", "NYN "));
    check("nb: NOR", lang_tags_are("nb", 8, 1, "NOR ", ""));
    check("ko: KOR before Old Hangul's KOH", lang_tags_are("ko", 8, 2, "KOR ", "KOH "));
    check("ko with room for one: KOR", lang_tags_are("ko", 1, 1, "KOR ", ""));
    check("zh: ZHS", lang_tags_are("zh", 8, 1, "ZHS ", ""));
    check("cmn: ZHS", lang_tags_are("cmn", 8, 1, "ZHS ", ""));
    check("zh-HK: ZHH", lang_tags_are("zh-HK", 8, 1, "ZHH ", ""));
    check("zh-hk: ZHH", lang_tags_are("zh-hk", 8, 1, "ZHH ", ""));
    check("zh-MO: ZHTM, then ZHH", lang_tags_are("zh-MO", 8, 2, "ZHTM", "ZHH "));
    check("zh-MO with room for one: ZHTM", lang_tags_are("zh-MO", 1, 1, "ZHTM", ""));
    check("zh-TW: ZHT", lang_tags_are("zh-TW", 8, 1, "ZHT ", ""));
    check("zh-Hant: ZHT", lang_tags_are("zh-Hant", 8, 1, "ZHT ", ""));
    check("zh_Hant, with an underscore: ZHT", lang_tags_are("zh_Hant", 8, 1, "ZHT ", ""));
    check("zh-Hant-1994, a variant after: ZHT", lang_tags_are("zh-Hant-1994", 8, 1, "ZHT ", ""));
    check("zh-Hans-HK: ZHH", lang_tags_are("zh-Hans-HK", 8, 1, "ZHH ", ""));
    check("zh-Hans: ZHS", lang_tags_are("zh-Hans", 8, 1, "ZHS ", ""));
    check("zh-TWN, not a region: ZHS", lang_tags_are("zh-TWN", 8, 1, "ZHS ", ""));
    check("en-fonipa: IPPH, then ENG", lang_tags_are("en-fonipa", 8, 2, "IPPH", "ENG "));
    check("en-fonipa-fonipa: each tag once", lang_tags_are("en-fonipa-fonipa", 8, 2, "IPPH", "ENG "));
    check("en-fonupa-fonipa-fonipa: each once, the second too",
          langs.tags("en-fonupa-fonipa-fonipa", cast(*i64, &tags_out), 8) == 3);
    check("und-fonnapa: APPH", lang_tags_are("und-fonnapa", 8, 1, "APPH", ""));
    check("en-US-fonupa: UPPH, then ENG", lang_tags_are("en-US-fonupa", 8, 2, "UPPH", "ENG "));
    check("en-x-fonipa, private use: ENG alone", lang_tags_are("en-x-fonipa", 8, 1, "ENG ", ""));
    check("en-a-bcd-fonipa, an extension: ENG alone", lang_tags_are("en-a-bcd-fonipa", 8, 1, "ENG ", ""));
    check("sr-Latn-RS: SRB", lang_tags_are("sr-Latn-RS", 8, 1, "SRB ", ""));
    check("e: none", lang_tags_are("e", 8, 0, "", ""));
    check("english: none", lang_tags_are("english", 8, 0, "", ""));
    check("qq, no such code: none", lang_tags_are("qq", 8, 0, "", ""));
    check("empty: none", lang_tags_are("", 8, 0, "", ""));
    check("none at all: none", langs.tags(cast(*u8, 0), cast(*i64, 0), 8) == 0);
}

// --- UTF-8 ---

fn decodes(bytes as *u8, n as i64, want as i64, next as i64) as i32 {
    let is i64 as u with mut = 0;
    let is i64 as k = shape.decode(bytes, 0, n, &u);
    return cast(i32, u == want && k == next);
}

fn utf8() as void {
    check("7F: U+007F", decodes("\x7f", 1, 127, 1));
    check("C2 80: U+0080", decodes("\xc2\x80", 2, 128, 2));
    check("DF BF: U+07FF", decodes("\xdf\xbf", 2, 2047, 2));
    check("C1 BF, too long a form", decodes("\xc1\xbf", 2, 65533, 1));
    check("E0 A0 80: U+0800", decodes("\xe0\xa0\x80", 3, 2048, 3));
    check("E0 9F BF, too long a form", decodes("\xe0\x9f\xbf", 3, 65533, 1));
    check("ED 9F BF: U+D7FF", decodes("\xed\x9f\xbf", 3, 55295, 3));
    check("ED A0 80, a surrogate", decodes("\xed\xa0\x80", 3, 65533, 1));
    check("EF BF BF: U+FFFF", decodes("\xef\xbf\xbf", 3, 65535, 3));
    check("F0 90 80 80: U+10000", decodes("\xf0\x90\x80\x80", 4, 65536, 4));
    check("F0 8F BF BF, too long a form", decodes("\xf0\x8f\xbf\xbf", 4, 65533, 1));
    check("F1 80 80 80: U+40000", decodes("\xf1\x80\x80\x80", 4, 262144, 4));
    check("F4 8F BF BF: U+10FFFF", decodes("\xf4\x8f\xbf\xbf", 4, 1114111, 4));
    check("F4 90 80 80, past U+10FFFF", decodes("\xf4\x90\x80\x80", 4, 65533, 1));
    check("F5, never a lead", decodes("\xf5\x80\x80\x80", 4, 65533, 1));
    check("80, a continuation alone", decodes("\x80", 1, 65533, 1));
    check("E2 82 cut short by the end", decodes("\xe2\x82\xac", 2, 65533, 1));
    check("E2 82 41, a letter too soon", decodes("\xe2\x82\x41", 3, 65533, 1));
}

// --- Hangul ---

fn decomposes(u as i64, n as i64, a as i64, b as i64) as i32 {
    let is [2]i64 as parts;
    parts[0] = 0;
    parts[1] = 0;
    let is i64 as k = compose.decompose_once(u, cast(*i64, &parts));
    if (k != n) { return 0; }
    if (n == 0) { return 1; }
    return cast(i32, parts[0] == a && parts[1] == b);
}

fn hangul() as void {
    check("AC00 is 1100 1161", decomposes(44032, 2, 4352, 4449));
    check("AC01 is AC00 11A8", decomposes(44033, 2, 44032, 4520));
    check("AE68 is 1101 1162", decomposes(44648, 2, 4353, 4450));
    check("D7A3 is D788 11C2", decomposes(55203, 2, 55176, 4546));
    check("D7A4 is not a syllable", decomposes(55204, 0, 0, 0));
    check("ABFF is not a syllable", decomposes(44031, 0, 0, 0));
    check("e acute is e and the acute", decomposes(233, 2, 101, 769));
}

// --- Where marks go ---

fn mark_places() as void {
    check("class 1: through", fallback.where_class(1) == fallback.THROUGH);
    check("class 202: below, attached", fallback.where_class(202) == (fallback.BELOW | fallback.ATTACHED));
    check("class 214: above, attached", fallback.where_class(214) == (fallback.ABOVE | fallback.ATTACHED));
    check("class 216: above right, attached",
          fallback.where_class(216) == (fallback.ABOVE | fallback.RIGHT | fallback.ATTACHED));
    check("class 218: below left", fallback.where_class(218) == (fallback.BELOW | fallback.LEFT));
    check("class 220: below", fallback.where_class(220) == fallback.BELOW);
    check("class 222: below right", fallback.where_class(222) == (fallback.BELOW | fallback.RIGHT));
    check("class 228: above left", fallback.where_class(228) == (fallback.ABOVE | fallback.LEFT));
    check("class 230: above", fallback.where_class(230) == fallback.ABOVE);
    check("class 232: above right", fallback.where_class(232) == (fallback.ABOVE | fallback.RIGHT));
    check("class 233: below", fallback.where_class(233) == fallback.BELOW);
    check("class 234: above", fallback.where_class(234) == fallback.ABOVE);
    check("class 240: below", fallback.where_class(240) == fallback.BELOW);
    check("class 0: by its ink", fallback.where_class(0) == 0);
    check("class 9, a virama's: by its ink", fallback.where_class(9) == 0);
    check("class 224, spacing marks': by its ink", fallback.where_class(224) == 0);
}

// --- The run ---

fn record(r as *glyphs.Run, k as i64) as i64 { return cast(i64, glyphs.at(r, k).id); }

fn run_bounds() as void {
    let is glyphs.Run as r with mut = glyphs.open();
    let is glyphs.Glyph as g;
    mem.memzero(cast(*u8, &g), sizeof(glyphs.Glyph));

    // A text of one character may grow to 16384 records, no more.
    glyphs.reset(&r, 1);
    let is i32 as ok with mut = 1;
    let is i64 as i with mut = 0;
    while (i < 16384) {
        g.id = cast(u32, i);
        if (glyphs.push(&r, &g) == 0) { ok = 0; }
        i = i + 1;
    }
    check("one character's run holds 16384 records", ok == 1 && r.len == 16384);
    check("each as it was put", r.src[100].id == cast(u32, 100) && r.src[16383].id == cast(u32, 16383));
    check("and not one more", glyphs.push(&r, &g) == 0 && r.ok == 0);

    // And may take 65536 steps of work, no more.
    glyphs.reset(&r, 1);
    check("65536 steps of work", glyphs.step(&r, 65536) == 1);
    check("and not one more", glyphs.step(&r, 1) == 0);

    // Writing more than was read grows what is written.
    glyphs.reset(&r, 1);
    g.id = cast(u32, 7);
    glyphs.push(&r, &g);
    glyphs.begin(&r);
    i = 0;
    while (i < 300) {
        g.id = cast(u32, 1000 + i);
        glyphs.put(&r, &g);
        i = i + 1;
    }
    glyphs.keep(&r);
    glyphs.end(&r);
    check("300 written before the one read", r.len == 301 && r.src[0].id == cast(u32, 1000) &&
          r.src[299].id == cast(u32, 1299) && r.src[300].id == cast(u32, 7));

    // A pass that ends with more than there is room for: 8192 read, none of
    // them yet, and 8192 written before them — 16384, the most there may be.
    // Each from a run of its own, its room as small as it starts.
    glyphs.close(&r);
    r = glyphs.open();
    glyphs.reset(&r, 1);
    i = 0;
    while (i < 8192) {
        g.id = cast(u32, i);
        glyphs.push(&r, &g);
        i = i + 1;
    }
    let is i64 as cap0 = r.cap;
    glyphs.begin(&r);
    i = 0;
    while (i < 8192) {
        g.id = cast(u32, 20000 + i);
        glyphs.put(&r, &g);
        i = i + 1;
    }
    glyphs.end(&r);
    check("8192 written and 8192 left: room made at the end", cap0 == 8192 && r.ok == 1 && r.len == 16384 &&
          r.cap >= 16384);
    check("the written, then the left", r.src[0].id == cast(u32, 20000) && r.src[8191].id == cast(u32, 28191) &&
          r.src[8192].id == cast(u32, 0) && r.src[16383].id == cast(u32, 8191));

    // Seeking back past what was read when that needs more room: 64 read,
    // one of them kept and 62 put after it; back to the start, the 62 go in
    // front of the 63 still to read.
    glyphs.close(&r);
    r = glyphs.open();
    glyphs.reset(&r, 1);
    i = 0;
    while (i < 64) {
        g.id = cast(u32, 100 + i);
        glyphs.push(&r, &g);
        i = i + 1;
    }
    let is i64 as cap1 = r.cap;
    glyphs.begin(&r);
    glyphs.keep(&r);
    i = 0;
    while (i < 62) {
        g.id = cast(u32, 500 + i);
        glyphs.put(&r, &g);
        i = i + 1;
    }
    check("seeking back over 63 of 64", cap1 == 64 && glyphs.seek(&r, 0) == 1 && glyphs.here(&r) == 0 &&
          glyphs.total(&r) == 126 && r.cap >= 126);
    check("kept, put, then left, in order", record(&r, 0) == 100 && record(&r, 1) == 500 && record(&r, 62) == 561 &&
          record(&r, 63) == 101 && record(&r, 125) == 163);
    glyphs.end(&r);

    // The same with no more room to be had: the seek fails, and the run.
    glyphs.close(&r);
    r = glyphs.open();
    glyphs.reset(&r, 1);
    i = 0;
    while (i < 64) {
        g.id = cast(u32, 100 + i);
        glyphs.push(&r, &g);
        i = i + 1;
    }
    glyphs.begin(&r);
    glyphs.keep(&r);
    i = 0;
    while (i < 62) {
        g.id = cast(u32, 500 + i);
        glyphs.put(&r, &g);
        i = i + 1;
    }
    r.most = 100;
    check("seeking back with no room left fails", glyphs.seek(&r, 0) == 0 && r.ok == 0);
    glyphs.end(&r);

    // Seeking back past what was read: A kept, B taken out, X and Y put; then
    // back to the start, the sequence as it was.
    glyphs.reset(&r, 3);
    i = 1;
    while (i <= 3) {
        g.id = cast(u32, i);
        glyphs.push(&r, &g);
        i = i + 1;
    }
    glyphs.begin(&r);
    glyphs.keep(&r);
    glyphs.drop(&r);
    g.id = cast(u32, 10);
    glyphs.put(&r, &g);
    g.id = cast(u32, 11);
    glyphs.put(&r, &g);
    check("A X Y C, written and to read", glyphs.total(&r) == 4 && record(&r, 0) == 1 && record(&r, 1) == 10 &&
          record(&r, 2) == 11 && record(&r, 3) == 3);
    check("seeking back to the start", glyphs.seek(&r, 0) == 1 && glyphs.here(&r) == 0);
    check("A X Y C, all to read again", glyphs.total(&r) == 4 && record(&r, 0) == 1 && record(&r, 1) == 10 &&
          record(&r, 2) == 11 && record(&r, 3) == 3);
    check("seeking forward over two", glyphs.seek(&r, 2) == 1 && glyphs.here(&r) == 2 && record(&r, 2) == 11);
    glyphs.end(&r);
    check("the pass ended: A X Y C", r.len == 4 && r.src[0].id == cast(u32, 1) && r.src[1].id == cast(u32, 10) &&
          r.src[2].id == cast(u32, 11) && r.src[3].id == cast(u32, 3));

    // Seeking back within what was read.
    glyphs.begin(&r);
    glyphs.keep(&r);
    glyphs.keep(&r);
    glyphs.keep(&r);
    check("back one of three kept", glyphs.seek(&r, 2) == 1 && glyphs.here(&r) == 2 && record(&r, 2) == 11 &&
          glyphs.total(&r) == 4);
    glyphs.end(&r);

    // Ligature numbers: never 0.
    r.serial = 254;
    check("after 254, 255", glyphs.next_ligature(&r) == 255);
    check("after 255, 1", glyphs.next_ligature(&r) == 1);
    glyphs.close(&r);
}

// --- Plans ---

fn tag_of(i as i64) as i64 {
    let is [4]u8 as t;
    t[0] = cast(u8, 122);
    t[1] = cast(u8, 48 + i / 10);
    t[2] = cast(u8, 48 + i % 10);
    t[3] = cast(u8, 122);
    return scripts.of(cast(*u8, &t));
}

// Bits 1 to 61 are features' (bit 0 is for what applies everywhere): 61
// features of one bit each are given them, the 62nd none.
fn plan_bits(f as *table.Face) as void {
    let is plan.Plan as p with mut = plan.open();
    check("a plan begun", plan.begin(&p, f, scripts.of("Latn"), cast(*u8, 0), 70) == 1);
    let is i64 as i with mut = 0;
    while (i < 62) {
        plan.want(&p, tag_of(i), 1, 0, 10, plan.STAGE_MAIN, plan.F_KEEP);
        i = i + 1;
    }
    let is var.Coords as c = var.default_coords();
    check("the plan made", plan.compile(f, &p, &c) == 1);
    check("the first feature: bit 1", plan.mask_of(&p, tag_of(0)) == 2);
    check("the 61st: bit 61", plan.mask_of(&p, tag_of(60)) == (1 << 61));
    check("the 62nd: none", cast(i64, plan.feature(&p, tag_of(61))) == 0);
    check("a feature not in the plan: no mask, no bits", plan.mask_of(&p, tag_of(61)) == 0 &&
          plan.one_of(&p, tag_of(61)) == 0);
    plan.close(&p);
}

// Steps sorted by lookup within their stage, and one lookup kept once.
fn merging() as void {
    let is plan.Plan as p with mut = plan.open();
    let is [8]plan.Step as steps;
    p.steps = cast(*plan.Step, &steps);
    p.cap_steps = 8;
    let is [5]i64 as order;
    order[0] = 9;    // the stage before
    order[1] = 5;
    order[2] = 3;
    order[3] = 7;
    order[4] = 3;
    let is i64 as i with mut = 0;
    while (i < 5) {
        steps[i].lookup = order[i];
        steps[i].mask = 1 << i;
        steps[i].flags = 0;
        i = i + 1;
    }
    p.nsteps = 5;
    plan._merge(&p, 1);
    check("merged: the stage before untouched", steps[0].lookup == 9);
    check("merged: sorted, each once", p.nsteps == 4 && steps[1].lookup == 3 && steps[2].lookup == 5 &&
          steps[3].lookup == 7);
    check("merged: the masks of both", steps[1].mask == 20 && steps[2].mask == 2 && steps[3].mask == 8);
}

// A script's second tag and a language's, when the font has only those.
fn second_tags(f as *table.Face) as void {
    let is plan.Plan as p with mut = plan.open();
    check("Deva planned", plan.begin(&p, f, scripts.of("Deva"), cast(*u8, 0), 4) == 1);
    check("deva's language system, dev2 missing",
          otl.find_feature(f, &p.gsub, p.langsys0, scripts.of("ss06")) != otl.NONE);
    plan.close(&p);
    p = plan.open();
    check("ko planned", plan.begin(&p, f, scripts.of("Latn"), "ko", 4) == 1);
    check("KOH, KOR missing", otl.find_feature(f, &p.gsub, p.langsys0, scripts.of("ss06")) != otl.NONE);
    plan.close(&p);
    p = plan.open();
    check("Latn planned", plan.begin(&p, f, scripts.of("Latn"), cast(*u8, 0), 4) == 1);
    check("not in the default", otl.find_feature(f, &p.gsub, p.langsys0, scripts.of("ss06")) == otl.NONE);
    plan.close(&p);
}

// --- Where text is unsafe to break ---

let is shape.Shaper as sh;

// utf8 shaped from start, length bytes (-1: to its end), with ss03 when
// ss03 is 1: how many glyphs, or -1 when the shaping failed.
fn shaped_with(r as *outline.Reader, utf8 as *u8, start as i64, length as i64, ss03 as i64) as i64 {
    let is shape.Feature as ft;
    ft.tag = scripts.of("ss03");
    ft.value = 1;
    ft.start = 0;
    ft.end = shape.ALL;
    let is shape.Text as t;
    let is i64 as n with mut = 0;
    while (utf8[n] != 0) { n = n + 1; }
    t.bytes = utf8;
    t.n = n;
    t.start = start;
    t.length = length;
    t.dir = shape.LTR;
    t.script = scripts.of("Latn");
    t.lang = cast(*u8, 0);
    t.features = &ft;
    t.nfeatures = ss03;
    t.flags = 0;
    if (shape.shape(&sh, r, &t) == 0) { return 0 - 1; }
    return shape.count(&sh);
}

fn shaped(r as *outline.Reader, utf8 as *u8, start as i64, length as i64) as i64 {
    return shaped_with(r, utf8, start, length, 0);
}

// The glyphs' unsafe flags as want spells them, '0' and '1'.
fn unsafe_is(r as *outline.Reader, utf8 as *u8, want as *u8) as i32 {
    let is i64 as n = shaped(r, utf8, 0, 0 - 1);
    let is i64 as i with mut = 0;
    while (i < n) {
        if (want[i] == 0) { return 0; }
        if (cast(i64, shape.glyph(&sh, i).unsafe) != cast(i64, want[i]) - 48) { return 0; }
        i = i + 1;
    }
    return cast(i32, want[n] == 0);
}

fn unsafe_breaks(plain as *outline.Reader, lookups as *outline.Reader) as void {
    check("AVo, kerned by the kern table: before V, not before o", unsafe_is(plain, "AVo", "010"));
    check("klx, k and l joined: before l, not before x", unsafe_is(lookups, "klx", "010"));
    check("a acute c, the mark on a: never", unsafe_is(lookups, "a\xcc\x81c", "000"));
    check("AVx, a pair adjusted: before V, not before x", unsafe_is(lookups, "AVx", "010"));
    check("nothing of abc when none of it is asked for", shaped(lookups, "abc", 0, 0) == 0);
    check("abc from 1, to its end: two glyphs", shaped(lookups, "abc", 1, 0 - 1) == 2);
}

// Lookups nested 64 deep are shaped (shape_test holds the result to
// HarfBuzz's); 65 deep, the shaping fails, as HarfBuzz's does.
fn nesting(lookups as *outline.Reader) as void {
    check("nested 64 deep: n and 64 y", shaped_with(lookups, "n", 0, 0 - 1, 1) == 65);
    check("nested 65 deep: the shaping fails", shaped_with(lookups, "u", 0, 0 - 1, 1) == 0 - 1);
}

fn main() as i32 {
    characters();
    script_tags();
    language_tags();
    utf8();
    hangul();
    mark_places();
    run_bounds();
    let is *u8 as lk_data = load("text/testdata/lookups.ttf");
    let is i64 as lk_size = loaded;
    let is *u8 as pl_data = load("text/testdata/shape-plain.ttf");
    let is i64 as pl_size = loaded;
    if (cast(i64, lk_data) == 0 || cast(i64, pl_data) == 0) {
        io.printf("FAIL: cannot read the test fonts\n");
        return 1;
    }
    let is table.Face as lk = sfnt.open(lk_data, lk_size, 0);
    let is table.Face as pl = sfnt.open(pl_data, pl_size, 0);
    let is outline.Reader as lr = outline.open(&lk);
    let is outline.Reader as pr = outline.open(&pl);
    shape.open(&sh);
    plan_bits(&lk);
    merging();
    second_tags(&lk);
    unsafe_breaks(&pr, &lr);
    nesting(&lr);
    shape.close(&sh);
    outline.close(&lr);
    outline.close(&pr);
    if (fails > 0) {
        io.printf("parts: %d of %d checks failed\n", fails, checks);
        return 1;
    }
    io.printf("parts: all %d checks hold\n", checks);
    return 0;
}
