// text/shape/pos.cst — GPOS: the nine positioning types, and attachments
// resolved into offsets.
//
// Positioning never changes the glyphs, so a lookup walks the run where it
// is. Single and pair adjustments add to advances and offsets; cursive
// attachment joins one glyph's exit point to the next one's entry; mark
// attachment puts a mark's anchor on its base's — a base, a ligature's
// component, another mark. Attached glyphs remember what they are attached
// to, and once every lookup has run, each takes its parent's offset and the
// advances between them, so that it lands where its anchor said.
//
// Values are font units. At a variable font's instance, a device table that
// is a variation index adds GDEF's delta, rounded halves up; the others are
// for hinting at a size, which positions in font units have none of.
use "../sfnt/table.cst" as table;
use "../sfnt/var.cst" as var;
use "glyphs.cst" as glyphs;
use "otl.cst" as otl;
use "plan.cst" as plan;
use "seq.cst" as seq;
use "scripts.cst" as scripts;

let is i64 as SINGLE with imut = 1;
let is i64 as PAIR with imut = 2;
let is i64 as CURSIVE with imut = 3;
let is i64 as MARK_BASE with imut = 4;
let is i64 as MARK_LIGATURE with imut = 5;
let is i64 as MARK_MARK with imut = 6;
let is i64 as CONTEXT with imut = 7;
let is i64 as CHAIN with imut = 8;
let is i64 as EXTENSION with imut = 9;

let is i64 as MAX_CHAIN with imut = 64;

fn _u16(c as *seq.Ctx, at as i64) as i64 { return seq.u16(c, at); }
fn _i16(c as *seq.Ctx, at as i64) as i64 { return otl.i16(c.f, c.l.t, at); }

fn _sat(v as i64) as i32 {
    if (v > 2147483647) { return cast(i32, 2147483647); }
    if (v < 0 - 2147483648) { return cast(i32, 0 - 2147483648); }
    return cast(i32, v);
}

// x rounded to a whole unit, halves up, as single-precision arithmetic
// rounds it: x plus a half is taken to single precision first.
fn round_half_up(x as f64) as i64 {
    let is [2]f32 as t;
    t[0] = cast(f32, x + 0.5);
    let is f64 as y = cast(f64, t[0]);
    let is i64 as k = cast(i64, y);
    if (cast(f64, k) > y) { return k - 1; }
    return k;
}

fn _place(c as *seq.Ctx, k as i64) as *glyphs.Place { return &c.run.place[k]; }

// The delta of the device or variation index table at dev, 0 for none.
fn device(c as *seq.Ctx, dev as i64) as i64 {
    if (dev == 0 || var.is_default(&c.r.coords) == 1) { return 0; }
    if (_u16(c, dev + 4) != 32768) { return 0; }
    let is i64 as idx = (_u16(c, dev) << 16) | _u16(c, dev + 2);
    return round_half_up(var.delta(c.f, &c.store, idx, &c.r.coords));
}

fn value_size(format as i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as k with mut = 0;
    while (k < 8) {
        if (((format >> k) & 1) != 0) { n = n + 1; }
        k = k + 1;
    }
    return n * 2;
}

// The value record at at, of format, added to p; its devices are found from
// base. 1 when it holds anything for horizontal text — a value that is not
// 0, a device at an instance it applies at.
fn apply_value(c as *seq.Ctx, base as i64, at as i64, format as i64, p as *glyphs.Place) as i32 {
    let is i32 as worked with mut = 0;
    let is i64 as k with mut = at;
    if ((format & 1) != 0) {
        let is i64 as v = _i16(c, k);
        if (v != 0) { worked = 1; }
        p.xo = _sat(cast(i64, p.xo) + v);
        k = k + 2;
    }
    if ((format & 2) != 0) {
        let is i64 as v = _i16(c, k);
        if (v != 0) { worked = 1; }
        p.yo = _sat(cast(i64, p.yo) + v);
        k = k + 2;
    }
    if ((format & 4) != 0) {
        let is i64 as v = _i16(c, k);
        if (v != 0) { worked = 1; }
        p.xa = _sat(cast(i64, p.xa) + v);
        k = k + 2;
    }
    // A vertical advance is for vertical text.
    if ((format & 8) != 0) { k = k + 2; }
    if ((format & 240) == 0 || var.is_default(&c.r.coords) == 1) { return worked; }
    if ((format & 16) != 0) {
        let is i64 as dev = otl.off16(c.f, c.l.t, base, k);
        if (dev != 0) { worked = 1; }
        p.xo = _sat(cast(i64, p.xo) + device(c, dev));
        k = k + 2;
    }
    if ((format & 32) != 0) {
        let is i64 as dev = otl.off16(c.f, c.l.t, base, k);
        if (dev != 0) { worked = 1; }
        p.yo = _sat(cast(i64, p.yo) + device(c, dev));
        k = k + 2;
    }
    if ((format & 64) != 0) {
        let is i64 as dev = otl.off16(c.f, c.l.t, base, k);
        if (dev != 0) { worked = 1; }
        p.xa = _sat(cast(i64, p.xa) + device(c, dev));
        k = k + 2;
    }
    return worked;
}

// The anchor at at into *x, *y: its point, with its devices' deltas.
fn anchor(c as *seq.Ctx, at as i64, x as *i64, y as *i64) as void {
    *x = 0;
    *y = 0;
    let is i64 as format = _u16(c, at);
    if (format < 1 || format > 3) { return; }
    *x = _i16(c, at + 2);
    *y = _i16(c, at + 4);
    if (format == 3) {
        *x = *x + device(c, otl.off16(c.f, c.l.t, at, at + 6));
        *y = *y + device(c, otl.off16(c.f, c.l.t, at, at + 8));
    }
}

fn _covered(c as *seq.Ctx, st as i64, at as i64, g as i64) as i64 {
    return otl.coverage(c.f, c.l.t, otl.off16(c.f, c.l.t, st, at), g);
}

// --- Single and pair adjustment ---

fn _single(c as *seq.Ctx, st as i64) as i32 {
    let is i64 as format = _u16(c, st);
    let is i64 as h = seq.here(c);
    let is i64 as index = _covered(c, st, st + 2, cast(i64, seq.cur(c).id));
    if (index == otl.NONE) { return 0; }
    let is i64 as vf = _u16(c, st + 4);
    if (format == 1) {
        apply_value(c, st, st + 6, vf, _place(c, h));
    } else if (format == 2) {
        if (index >= _u16(c, st + 6)) { return 0; }
        apply_value(c, st, st + 8 + index * value_size(vf), vf, _place(c, h));
    } else {
        return 0;
    }
    seq.go(c, h + 1);
    return 1;
}

// The pair record for second glyph g in the pair set at set; 0 for none.
fn _pair_record(c as *seq.Ctx, set as i64, size as i64, g as i64) as i64 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = _u16(c, set) - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is i64 as rec = set + 2 + mid * size;
        let is i64 as v = _u16(c, rec);
        if (g < v) { hi = mid - 1; } else if (g > v) { lo = mid + 1; } else { return rec; }
    }
    return 0;
}

// The current glyph and the next one the lookup sees, adjusted as a pair.
// When the second has a value of its own it is done with; otherwise it may
// begin the next pair.
fn _pair(c as *seq.Ctx, st as i64) as i32 {
    let is i64 as format = _u16(c, st);
    let is i64 as h = seq.here(c);
    let is i64 as index = _covered(c, st, st + 2, cast(i64, seq.cur(c).id));
    if (index == otl.NONE) { return 0; }
    let is i64 as second = seq.find_next(c, h, seq.INPUT, seq.BY_ANY, 0, 0);
    if (second == otl.NONE) { return 0; }
    let is i64 as vf1 = _u16(c, st + 4);
    let is i64 as vf2 = _u16(c, st + 6);
    let is i64 as s1 = value_size(vf1);
    let is i64 as s2 = value_size(vf2);
    let is i64 as base with mut = st;
    let is i64 as rec with mut = 0;
    if (format == 1) {
        let is i64 as set = seq.offset(c, st, _u16(c, st + 8), st + 10, index);
        if (set == 0) { return 0; }
        rec = _pair_record(c, set, 2 + s1 + s2, cast(i64, seq.at(c, second).id));
        if (rec == 0) { return 0; }
        rec = rec + 2;
        base = set;
    } else if (format == 2) {
        let is i64 as k1 = otl.class_of(c.f, c.l.t, otl.off16(c.f, c.l.t, st, st + 8), cast(i64, seq.cur(c).id));
        let is i64 as k2 = otl.class_of(c.f, c.l.t, otl.off16(c.f, c.l.t, st, st + 10), cast(i64, seq.at(c, second).id));
        let is i64 as n1 = _u16(c, st + 12);
        let is i64 as n2 = _u16(c, st + 14);
        if (k1 >= n1 || k2 >= n2) { return 0; }
        rec = st + 16 + (k1 * n2 + k2) * (s1 + s2);
    } else {
        return 0;
    }
    let is i32 as w1 with mut = 0;
    let is i32 as w2 with mut = 0;
    if (s1 > 0) { w1 = apply_value(c, base, rec, vf1, _place(c, h)); }
    if (s2 > 0) { w2 = apply_value(c, base, rec + s1, vf2, _place(c, second)); }
    if (w1 == 1 || w2 == 1) { glyphs.mark_unsafe(c.run, h, second + 1); }
    if (s2 > 0) { seq.go(c, second + 1); } else { seq.go(c, second); }
    return 1;
}

// --- Cursive attachment ---

// Glyph i, which was attached to another, made the other's parent instead —
// and so on along the chain — so that a glyph about to be attached elsewhere
// takes what hung from it along.
fn _turn(c as *seq.Ctx, i as i64, new_parent as i64, depth as i64) as void {
    if (depth > MAX_CHAIN) { return; }
    let is *glyphs.Place as p = _place(c, i);
    if (p.link == cast(i32, 0) || p.kind != cast(i32, glyphs.ATTACH_CURSIVE)) { return; }
    let is i64 as link = cast(i64, p.link);
    p.link = cast(i32, 0);
    let is i64 as j = i + link;
    if (j < 0 || j >= c.run.len || j == new_parent) { return; }
    _turn(c, j, new_parent, depth + 1);
    let is *glyphs.Place as q = _place(c, j);
    q.yo = _sat(0 - cast(i64, p.yo));
    q.link = cast(i32, 0 - link);
    q.kind = cast(i32, glyphs.ATTACH_CURSIVE);
}

fn _cursive(c as *seq.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as j = seq.here(c);
    let is i64 as n = _u16(c, st + 4);
    let is i64 as ij = _covered(c, st, st + 2, cast(i64, seq.cur(c).id));
    if (ij == otl.NONE || ij >= n) { return 0; }
    let is i64 as entry = otl.off16(c.f, c.l.t, st, st + 6 + ij * 4);
    if (entry == 0) { return 0; }
    let is i64 as i = seq.find_prev(c, j, seq.INPUT, seq.BY_ANY, 0, 0);
    if (i == otl.NONE) { return 0; }
    let is i64 as ii = _covered(c, st, st + 2, cast(i64, seq.at(c, i).id));
    if (ii == otl.NONE || ii >= n) { return 0; }
    let is i64 as exit = otl.off16(c.f, c.l.t, st, st + 6 + ii * 4 + 2);
    if (exit == 0) { return 0; }
    glyphs.mark_unsafe(c.run, i, j + 1);
    let is i64 as ex with mut = 0;
    let is i64 as ey with mut = 0;
    let is i64 as nx with mut = 0;
    let is i64 as ny with mut = 0;
    anchor(c, exit, &ex, &ey);
    anchor(c, entry, &nx, &ny);
    let is *glyphs.Place as pi = _place(c, i);
    let is *glyphs.Place as pj = _place(c, j);
    // Along the line: i's advance ends at its exit, where j's entry begins.
    if (c.dir == scripts.RTL) {
        let is i64 as d = ex + cast(i64, pi.xo);
        pi.xa = _sat(cast(i64, pi.xa) - d);
        pi.xo = _sat(cast(i64, pi.xo) - d);
        pj.xa = _sat(nx + cast(i64, pj.xo));
    } else {
        pi.xa = _sat(ex + cast(i64, pi.xo));
        let is i64 as d = nx + cast(i64, pj.xo);
        pj.xa = _sat(cast(i64, pj.xa) - d);
        pj.xo = _sat(cast(i64, pj.xo) - d);
    }
    // Across it: one hangs from the other — the later from the earlier,
    // unless the lookup says right to left.
    let is i64 as child with mut = j;
    let is i64 as parent with mut = i;
    let is i64 as dy with mut = ey - ny;
    if ((c.flag & seq.RIGHT_TO_LEFT) != 0) {
        child = i;
        parent = j;
        dy = ny - ey;
    }
    _turn(c, child, parent, 0);
    let is *glyphs.Place as pc = _place(c, child);
    pc.link = cast(i32, parent - child);
    pc.kind = cast(i32, glyphs.ATTACH_CURSIVE);
    pc.yo = _sat(dy);
    let is *glyphs.Place as pp = _place(c, parent);
    if (cast(i64, pp.link) == child - parent) {
        pp.link = cast(i32, 0);
        pp.yo = cast(i32, 0);
    }
    seq.go(c, j + 1);
    return 1;
}

// --- Mark attachment ---

// The mark at the current glyph, of mark array marks and index, put on the
// glyph at k by the anchor its class has in the matrix at matrix (rows of
// count anchors, offsets from base): 1, or 0 when it has none there.
fn _attach(c as *seq.Ctx, marks as i64, index as i64, k as i64, matrix as i64, base as i64, row as i64,
           count as i64) as i32 {
    let is i64 as h = seq.here(c);
    let is i64 as rec = marks + 2 + index * 4;
    let is i64 as klass = _u16(c, rec);
    if (klass >= count) { return 0; }
    let is i64 as banchor = otl.off16(c.f, c.l.t, base, matrix + (row * count + klass) * 2);
    if (banchor == 0) { return 0; }
    let is i64 as manchor = otl.off16(c.f, c.l.t, marks, rec + 2);
    glyphs.mark_unsafe(c.run, k, h + 1);
    let is i64 as mx with mut = 0;
    let is i64 as my with mut = 0;
    let is i64 as bx with mut = 0;
    let is i64 as by with mut = 0;
    anchor(c, manchor, &mx, &my);
    anchor(c, banchor, &bx, &by);
    let is *glyphs.Place as p = _place(c, h);
    p.xo = _sat(bx - mx);
    p.yo = _sat(by - my);
    p.link = cast(i32, k - h);
    p.kind = cast(i32, glyphs.ATTACH_MARK);
    seq.go(c, h + 1);
    return 1;
}

// The nearest glyph before the current one that is not a mark, default
// ignorables passed over — not a ZWJ, for the features that handle joiners
// themselves; otl.NONE for none. For mark-to-base subtable st (0 for none),
// a glyph a multiple substitution split into pieces takes marks on its first
// piece — a later one is passed over when st has no anchor on it anyway.
fn _base_before(c as *seq.Ctx, st as i64) as i64 {
    let is i64 as k with mut = seq.here(c) - 1;
    while (k >= 0) {
        let is *glyphs.Glyph as g = seq.at(c, k);
        let is i32 as skip with mut = 0;
        if (g.cls == cast(u8, glyphs.MARK) || seq.passable(c, g, seq.INPUT) == 1) { skip = 1; }
        if (skip == 0 && st != 0 && (cast(i64, g.made) & glyphs.MULTIPLIED) != 0 && g.comp != cast(u8, 0) && k > 0) {
            let is *glyphs.Glyph as before = seq.at(c, k - 1);
            if ((cast(i64, before.made) & glyphs.MULTIPLIED) != 0 && before.cls != cast(u8, glyphs.MARK) &&
                before.lig == g.lig && cast(i64, before.comp) + 1 == cast(i64, g.comp) &&
                _covered(c, st, st + 4, cast(i64, g.id)) == otl.NONE) {
                skip = 1;
            }
        }
        if (skip == 0) { return k; }
        k = k - 1;
    }
    return otl.NONE;
}

fn _mark_base(c as *seq.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as mi = _covered(c, st, st + 2, cast(i64, seq.cur(c).id));
    if (mi == otl.NONE) { return 0; }
    let is i64 as k = _base_before(c, st);
    if (k == otl.NONE) { return 0; }
    let is i64 as bi = _covered(c, st, st + 4, cast(i64, seq.at(c, k).id));
    if (bi == otl.NONE) { return 0; }
    let is i64 as count = _u16(c, st + 6);
    let is i64 as marks = otl.off16(c.f, c.l.t, st, st + 8);
    let is i64 as bases = otl.off16(c.f, c.l.t, st, st + 10);
    if (marks == 0 || bases == 0 || mi >= _u16(c, marks) || bi >= _u16(c, bases)) { return 0; }
    return _attach(c, marks, mi, k, bases + 2, bases, bi, count);
}

fn _mark_ligature(c as *seq.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as mi = _covered(c, st, st + 2, cast(i64, seq.cur(c).id));
    if (mi == otl.NONE) { return 0; }
    let is i64 as k = _base_before(c, 0);
    if (k == otl.NONE) { return 0; }
    let is i64 as li = _covered(c, st, st + 4, cast(i64, seq.at(c, k).id));
    if (li == otl.NONE) { return 0; }
    let is i64 as count = _u16(c, st + 6);
    let is i64 as marks = otl.off16(c.f, c.l.t, st, st + 8);
    let is i64 as ligs = otl.off16(c.f, c.l.t, st, st + 10);
    if (marks == 0 || ligs == 0 || mi >= _u16(c, marks)) { return 0; }
    let is i64 as attach = seq.offset(c, ligs, _u16(c, ligs), ligs + 2, li);
    if (attach == 0) { return 0; }
    let is i64 as comps = _u16(c, attach);
    if (comps == 0) { return 0; }
    // The component the mark follows, if it was on this ligature; the last
    // one otherwise.
    let is *glyphs.Glyph as lig = seq.at(c, k);
    let is *glyphs.Glyph as mark = seq.cur(c);
    let is i64 as comp with mut = comps - 1;
    if (lig.lig != cast(u8, 0) && lig.lig == mark.lig && mark.comp != cast(u8, 0)) {
        comp = cast(i64, mark.comp);
        if (comp > comps) { comp = comps; }
        comp = comp - 1;
    }
    return _attach(c, marks, mi, k, attach + 2, attach, comp, count);
}

// The glyph before the current one that the lookup sees past its flags'
// ignoring — its filter and attachment class still apply — and default
// ignorables.
fn _mark_before(c as *seq.Ctx) as i64 {
    let is i64 as saved = c.flag;
    c.flag = c.flag & (65535 - seq.IGNORE_BASES - seq.IGNORE_LIGATURES - seq.IGNORE_MARKS);
    let is i64 as k with mut = seq.here(c) - 1;
    let is i64 as found with mut = otl.NONE;
    while (k >= 0 && found == otl.NONE) {
        let is *glyphs.Glyph as g = seq.at(c, k);
        if (seq.ignored(c, g) == 0 && seq.passable(c, g, seq.INPUT) == 0) { found = k; }
        k = k - 1;
    }
    c.flag = saved;
    return found;
}

fn _mark_mark(c as *seq.Ctx, st as i64) as i32 {
    if (_u16(c, st) != 1) { return 0; }
    let is i64 as mi = _covered(c, st, st + 2, cast(i64, seq.cur(c).id));
    if (mi == otl.NONE) { return 0; }
    let is i64 as k = _mark_before(c);
    if (k == otl.NONE) { return 0; }
    let is *glyphs.Glyph as m1 = seq.cur(c);
    let is *glyphs.Glyph as m2 = seq.at(c, k);
    if (m2.cls != cast(u8, glyphs.MARK)) { return 0; }
    // Marks go on marks that sit on the same thing: neither on a ligature,
    // or both on the same component of one; or on a mark that is itself a
    // ligature of marks.
    let is i32 as same with mut = 0;
    if (m1.lig == m2.lig) {
        if (m1.lig == cast(u8, 0) || m1.comp == m2.comp) { same = 1; }
    } else if ((m1.lig != cast(u8, 0) && m1.comp == cast(u8, 0)) || (m2.lig != cast(u8, 0) && m2.comp == cast(u8, 0))) {
        same = 1;
    }
    if (same == 0) { return 0; }
    let is i64 as m2i = _covered(c, st, st + 4, cast(i64, m2.id));
    if (m2i == otl.NONE) { return 0; }
    let is i64 as count = _u16(c, st + 6);
    let is i64 as marks = otl.off16(c.f, c.l.t, st, st + 8);
    let is i64 as marks2 = otl.off16(c.f, c.l.t, st, st + 10);
    if (marks == 0 || marks2 == 0 || mi >= _u16(c, marks) || m2i >= _u16(c, marks2)) { return 0; }
    return _attach(c, marks, mi, k, marks2 + 2, marks2, m2i, count);
}

// --- Lookups ---

fn subtable(c as *seq.Ctx, kind as i64, st as i64) as i32 {
    if (st == 0) { return 0; }
    if (kind == SINGLE) { return _single(c, st); }
    if (kind == PAIR) { return _pair(c, st); }
    if (kind == CURSIVE) { return _cursive(c, st); }
    if (kind == MARK_BASE) { return _mark_base(c, st); }
    if (kind == MARK_LIGATURE) { return _mark_ligature(c, st); }
    if (kind == MARK_MARK) { return _mark_mark(c, st); }
    if (kind == CONTEXT) { return seq.context(c, st); }
    if (kind == CHAIN) { return seq.chain(c, st); }
    if (kind == EXTENSION) {
        let is i64 as inner = _u16(c, st + 2);
        if (_u16(c, st) != 1 || inner == EXTENSION) { return 0; }
        return subtable(c, inner, otl.off32(c.f, c.l.t, st, st + 4));
    }
    return 0;
}

fn apply_at(c as *seq.Ctx, index as i64) as i32 {
    let is i64 as lk = otl.lookup(c.f, c.l, index);
    if (lk == 0) { return 0; }
    let is i64 as kind = otl.lookup_type(c.f, c.l, lk);
    let is i64 as n = otl.subtable_count(c.f, c.l, lk);
    let is i64 as i with mut = 0;
    while (i < n) {
        if (subtable(c, kind, otl.subtable(c.f, c.l, lk, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// The plan's step applied along the run.
fn apply_step(c as *seq.Ctx, s as *plan.Step) as void {
    let is *glyphs.Run as r = c.run;
    let is i64 as lk = otl.lookup(c.f, c.l, s.lookup);
    if (lk == 0) { return; }
    seq.set_lookup(c, s.lookup, lk);
    c.mask = s.mask;
    c.flags = s.flags;
    r.i = 0;
    while (r.i < r.len && r.ok == 1) {
        let is i64 as at = r.i;
        let is *glyphs.Glyph as g = &r.src[at];
        let is i32 as done with mut = 0;
        if ((cast(i64, g.mask) & c.mask) != 0 && seq.ignored(c, g) == 0) { done = apply_at(c, s.lookup); }
        if (done == 0 || r.i <= at) { r.i = at + 1; }
        glyphs.step(r, 1);
    }
    r.i = 0;
}

// --- Attachments resolved ---

// Glyph i's offset made final: its parent's first, then its own added to
// it — and for a mark, the advances between them taken back, so that it is
// drawn where it was put relative to the parent. dir is the run's.
fn _settle(r as *glyphs.Run, i as i64, dir as i64, depth as i64) as void {
    let is *glyphs.Place as p = &r.place[i];
    let is i64 as link = cast(i64, p.link);
    if (link == 0) { return; }
    p.link = cast(i32, 0);
    let is i64 as j = i + link;
    if (j < 0 || j >= r.len) { return; }
    // A chain longer than MAX_CHAIN: what hangs that far down keeps its own
    // offset alone.
    if (depth >= MAX_CHAIN) { return; }
    _settle(r, j, dir, depth + 1);
    let is *glyphs.Place as q = &r.place[j];
    if (p.kind == cast(i32, glyphs.ATTACH_CURSIVE)) {
        p.yo = _sat(cast(i64, p.yo) + cast(i64, q.yo));
        return;
    }
    let is i64 as x with mut = cast(i64, p.xo) + cast(i64, q.xo);
    p.yo = _sat(cast(i64, p.yo) + cast(i64, q.yo));
    if (dir == scripts.RTL) {
        let is i64 as k with mut = j + 1;
        while (k <= i) {
            x = x + cast(i64, r.place[k].xa);
            k = k + 1;
        }
    } else {
        let is i64 as k with mut = j;
        while (k < i) {
            x = x - cast(i64, r.place[k].xa);
            k = k + 1;
        }
    }
    p.xo = _sat(x);
}

fn resolve(r as *glyphs.Run, dir as i64) as void {
    let is i64 as i with mut = 0;
    while (i < r.len) {
        _settle(r, i, dir, 0);
        i = i + 1;
    }
}
