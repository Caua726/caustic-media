// text/shape/indic.cst — the major Indic scripts: Devanagari, Bengali, Gurmukhi,
// Gujarati, Oriya, Tamil, Telugu, Kannada and Malayalam, as Microsoft's
// "Creating and supporting OpenType fonts for Indic scripts" and its pages for
// each script give them: both the tags from before (deva) and those after (dev2).
//
// The text is cut into syllables; then, before the basic features, each is put in
// the order they expect — the base consonant found, a left matra in front, what
// comes after the base by where it goes — and each glyph told which features may
// touch it; those features apply one stage at a time; and then, with half forms
// and the rest made, the matra and the reph go where they end up and the remaining
// features apply. A syllable with nothing to carry its marks gets a dotted circle.
use "caustic-unicode/src/ucd/props.cst" as ucd;
use "caustic-unicode/src/ucd/tables/isc.cst" as isc;
use "caustic-unicode/src/ucd/tables/ipc.cst" as ipc;
use "../sfnt/cmap.cst" as cmap;
use "glyphs.cst" as glyphs;
use "chars.cst" as chars;
use "compose.cst" as compose;
use "plan.cst" as plan;
use "scripts.cst" as scripts;
use "work.cst" as work;
use "would.cst" as would;
use "syllable.cst" as syllable;
use "caustic-unicode/src/normalize/normalize.cst" as norm;

// Categories, as letters of the grammars.
let is i64 as CAT_C with imut = 67;      // C a consonant
let is i64 as CAT_RA with imut = 82;     // R ra
let is i64 as CAT_V with imut = 86;      // V a vowel
let is i64 as CAT_N with imut = 78;      // N a nukta
let is i64 as CAT_H with imut = 72;      // H a halant
let is i64 as CAT_ZWJ with imut = 74;    // J
let is i64 as CAT_ZWNJ with imut = 106;  // j
let is i64 as CAT_M with imut = 77;      // M a matra
let is i64 as CAT_SM with imut = 83;     // S a syllable modifier
let is i64 as CAT_A with imut = 65;      // A a Vedic accent
let is i64 as CAT_PLACEHOLDER with imut = 80;   // P
let is i64 as CAT_CIRCLE with imut = 68; // D
let is i64 as CAT_RS with imut = 114;    // r a register shifter
let is i64 as CAT_REPHA with imut = 101; // e
let is i64 as CAT_CM with imut = 75;     // K a medial consonant
let is i64 as CAT_SYMBOL with imut = 89; // Y
let is i64 as CAT_CS with imut = 84;     // T a consonant with a stacker
let is i64 as CAT_X with imut = 88;      // X anything else

// Where a character goes in its syllable.
let is i64 as POS_START with imut = 0;
let is i64 as POS_RA_TO_BECOME_REPH with imut = 1;
let is i64 as POS_PRE_M with imut = 2;
let is i64 as POS_PRE_C with imut = 3;
let is i64 as POS_BASE_C with imut = 4;
let is i64 as POS_AFTER_MAIN with imut = 5;
let is i64 as POS_ABOVE_C with imut = 6;
let is i64 as POS_BEFORE_SUB with imut = 7;
let is i64 as POS_BELOW_C with imut = 8;
let is i64 as POS_AFTER_SUB with imut = 9;
let is i64 as POS_BEFORE_POST with imut = 10;
let is i64 as POS_POST_C with imut = 11;
let is i64 as POS_AFTER_POST with imut = 12;
let is i64 as POS_SMVD with imut = 13;
let is i64 as POS_END with imut = 14;

// Kinds of syllable, in the order the grammars are tried.
let is i64 as S_CONSONANT with imut = 0;
let is i64 as S_VOWEL with imut = 1;
let is i64 as S_STANDALONE with imut = 2;
let is i64 as S_SYMBOL with imut = 3;
let is i64 as S_BROKEN with imut = 4;
let is i64 as S_OTHER with imut = 5;

let is syllable.Grammar as G_CONSONANT with mut;
let is syllable.Grammar as G_VOWEL with mut;
let is syllable.Grammar as G_STANDALONE with mut;
let is syllable.Grammar as G_SYMBOL with mut;
let is syllable.Grammar as G_BROKEN with mut;

// Written out from these:
//   c = (C|R); n = ((j?r)?(NN?)?); z = (J|j); reph = (RH|e); cn = c J? n?
//   matra = z* M N? H?; tail = (z? S S? j?)? A*; halant = (z? H (J N?)?)
//   tails = (halant cn)* K? ((halant | H j) | matra*) tail
//   consonant = (e|T)? cn tails
//   vowel = reph? V n? (J | tails)
//   standalone = ((e|T)? P | reph? D) n? tails
//   symbol = Y N? tail
//   broken = reph? n? tails
let is *u8 as W_CONSONANT with imut = "(e|T)?(C|R)J?((j?r)?(NN?)?)?(((J|j)?H(JN?)?)(C|R)J?((j?r)?(NN?)?)?)*K?((((J|j)?H(JN?)?)|Hj)|((J|j)*MN?H?)*)((J|j)?SS?j?)?A*";
let is *u8 as W_VOWEL with imut = "(RH|e)?V((j?r)?(NN?)?)?(J|(((J|j)?H(JN?)?)(C|R)J?((j?r)?(NN?)?)?)*K?((((J|j)?H(JN?)?)|Hj)|((J|j)*MN?H?)*)((J|j)?SS?j?)?A*)";
let is *u8 as W_STANDALONE with imut = "((e|T)?P|(RH|e)?D)((j?r)?(NN?)?)?(((J|j)?H(JN?)?)(C|R)J?((j?r)?(NN?)?)?)*K?((((J|j)?H(JN?)?)|Hj)|((J|j)*MN?H?)*)((J|j)?SS?j?)?A*";
let is *u8 as W_SYMBOL with imut = "YN?((J|j)?SS?j?)?A*";
let is *u8 as W_BROKEN with imut = "(RH|e)?((j?r)?(NN?)?)?(((J|j)?H(JN?)?)(C|R)J?((j?r)?(NN?)?)?)*K?((((J|j)?H(JN?)?)|Hj)|((J|j)*MN?H?)*)((J|j)?SS?j?)?A*";

// The basic features, in order, one stage each; then the rest.
let is i64 as F_NUKT with imut = 0;
let is i64 as F_AKHN with imut = 1;
let is i64 as F_RPHF with imut = 2;
let is i64 as F_RKRF with imut = 3;
let is i64 as F_PREF with imut = 4;
let is i64 as F_BLWF with imut = 5;
let is i64 as F_ABVF with imut = 6;
let is i64 as F_HALF with imut = 7;
let is i64 as F_PSTF with imut = 8;
let is i64 as F_VATU with imut = 9;
let is i64 as F_CJCT with imut = 10;
let is i64 as F_INIT with imut = 11;
let is i64 as F_PRES with imut = 12;
let is i64 as F_ABVS with imut = 13;
let is i64 as F_BLWS with imut = 14;
let is i64 as F_PSTS with imut = 15;
let is i64 as F_HALN with imut = 16;
let is i64 as NBASIC with imut = 11;
let is i64 as NFEATURES with imut = 17;

// What the script does: work.values.
let is i64 as V_OLD_SPEC with imut = 0;     // the font uses the tag from before
let is i64 as V_ZERO_CONTEXT with imut = 1; // a rule that needs context does not count when asking
let is i64 as V_VIRAMA with imut = 2;       // the virama's glyph
let is i64 as V_REPH_POS with imut = 3;
let is i64 as V_REPH_MODE with imut = 4;
let is i64 as V_BLWF_MODE with imut = 5;
let is i64 as V_VIRAMA_CHAR with imut = 6;
let is i64 as V_BROKEN with imut = 7;       // a broken syllable was found

let is i64 as REPH_AFTER_MAIN with imut = 0;
let is i64 as REPH_BEFORE_SUB with imut = 1;
let is i64 as REPH_AFTER_SUB with imut = 2;
let is i64 as REPH_BEFORE_POST with imut = 3;
let is i64 as REPH_AFTER_POST with imut = 4;
let is i64 as REPH_IMPLICIT with imut = 0;  // Ra,H
let is i64 as REPH_EXPLICIT with imut = 1;  // Ra,H,ZWJ
let is i64 as REPH_LOG_REPHA with imut = 2; // a character of its own
let is i64 as BLWF_PRE_AND_POST with imut = 0;
let is i64 as BLWF_POST_ONLY with imut = 1;

fn is_script(s as i64) as i32 {
    return cast(i32, s == scripts.of("Deva") || s == scripts.of("Beng") || s == scripts.of("Guru") ||
                     s == scripts.of("Gujr") || s == scripts.of("Orya") || s == scripts.of("Taml") ||
                     s == scripts.of("Telu") || s == scripts.of("Knda") || s == scripts.of("Mlym"));
}

// --- Characters ---

// The syllabic category as a letter of the grammars, before what is particular
// to a script. Also for the shapers that share these names.
fn base_category(cat as i64) as i64 {
    if (cat == isc.ISC_Avagraha) { return CAT_SYMBOL; }
    if (cat == isc.ISC_Bindu || cat == isc.ISC_Gemination_Mark || cat == isc.ISC_Syllable_Modifier ||
        cat == isc.ISC_Visarga) { return CAT_SM; }
    if (cat == isc.ISC_Brahmi_Joining_Number || cat == isc.ISC_Consonant_Placeholder ||
        cat == isc.ISC_Number || cat == isc.ISC_Number_Joiner) { return CAT_PLACEHOLDER; }
    if (cat == isc.ISC_Cantillation_Mark) { return CAT_A; }
    if (cat == isc.ISC_Consonant || cat == isc.ISC_Consonant_Dead || cat == isc.ISC_Consonant_Head_Letter ||
        cat == isc.ISC_Consonant_Initial_Postfixed) { return CAT_C; }
    if (cat == isc.ISC_Consonant_Final || cat == isc.ISC_Consonant_Medial || cat == isc.ISC_Consonant_Subjoined ||
        cat == isc.ISC_Consonant_Succeeding_Repha) { return CAT_CM; }
    if (cat == isc.ISC_Consonant_Killer || cat == isc.ISC_Pure_Killer || cat == isc.ISC_Reordering_Killer ||
        cat == isc.ISC_Vowel_Dependent) { return CAT_M; }
    if (cat == isc.ISC_Consonant_Preceding_Repha) { return CAT_REPHA; }
    if (cat == isc.ISC_Consonant_With_Stacker) { return CAT_CS; }
    if (cat == isc.ISC_Invisible_Stacker || cat == isc.ISC_Virama) { return CAT_H; }
    if (cat == isc.ISC_Joiner) { return CAT_ZWJ; }
    if (cat == isc.ISC_Non_Joiner) { return CAT_ZWNJ; }
    if (cat == isc.ISC_Nukta || cat == isc.ISC_Tone_Mark) { return CAT_N; }
    if (cat == isc.ISC_Register_Shifter) { return CAT_RS; }
    if (cat == isc.ISC_Vowel || cat == isc.ISC_Vowel_Independent) { return CAT_V; }
    return CAT_X;
}

// What all these scripts take as a base beyond what Unicode's file of categories
// has: 104A 17D9 2015 2022 25FB..25FE.
// The syllabic category these shapers go by: only in the blocks they take for theirs,
// with no superscript or subscript digit among them. Another script's character in a
// run of one of them is nothing to it.
fn syllabic_category(u as i64) as i64 {
    if ((u >= 40 && u <= 63) || u == 160 || u == 215 || (u >= 2304 && u <= 3575) ||         // 0028 00A0 00D7 0900..0DF7
        (u >= 4096 && u <= 4255) || (u >= 6016 && u <= 6127) || (u >= 7376 && u <= 7423) || // 1000 1780 1CD0
        (u >= 8200 && u <= 8215) || (u >= 9720 && u <= 9727) ||                             // 2008 25F8
        (u >= 43232 && u <= 43263) || (u >= 43488 && u <= 43519) ||                         // A8E0 A9E0
        (u >= 43616 && u <= 43647) || (u >= 65024 && u <= 65039) ||                         // AA60 FE00
        (u >= 70400 && u <= 70407) || (u >= 71376 && u <= 71399)) {                         // 11300 116D0
        return ucd.indic_syllabic_category(cast(i32, u));
    }
    return isc.ISC_Other;
}

fn is_more_base(u as i64) as i32 {
    return cast(i32, u == 4170 || u == 6105 || u == 8213 || u == 8226 || (u >= 9723 && u <= 9726));
}

// The positional category as a position, before anything that depends on what
// it is: the last part of one split in several.
fn base_position(p as i64) as i64 {
    if (p == ipc.IPC_Left) { return POS_PRE_C; }
    if (p == ipc.IPC_Top || p == ipc.IPC_Top_And_Left) { return POS_ABOVE_C; }
    if (p == ipc.IPC_Bottom || p == ipc.IPC_Top_And_Bottom || p == ipc.IPC_Top_And_Bottom_And_Left || p == ipc.IPC_Bottom_And_Left) { return POS_BELOW_C; }
    if (p == ipc.IPC_Right || p == ipc.IPC_Bottom_And_Right || p == ipc.IPC_Left_And_Right || p == ipc.IPC_Top_And_Bottom_And_Right ||
        p == ipc.IPC_Top_And_Left_And_Right || p == ipc.IPC_Top_And_Right) { return POS_POST_C; }
    if (p == ipc.IPC_Overstruck) { return POS_AFTER_MAIN; }
    if (p == ipc.IPC_Visual_Order_Left) { return POS_PRE_M; }
    return POS_END;
}

let is i64 as B_DEVA with imut = 0;
let is i64 as B_BENG with imut = 1;
let is i64 as B_GURU with imut = 2;
let is i64 as B_GUJR with imut = 3;
let is i64 as B_ORYA with imut = 4;
let is i64 as B_TAML with imut = 5;
let is i64 as B_TELU with imut = 6;
let is i64 as B_KNDA with imut = 7;
let is i64 as B_MLYM with imut = 8;
let is i64 as B_OTHER with imut = 9;

fn _block(u as i64) as i64 {
    if (u >= 2304 && u <= 2431) { return B_DEVA; }
    if (u >= 2432 && u <= 2559) { return B_BENG; }
    if (u >= 2560 && u <= 2687) { return B_GURU; }
    if (u >= 2688 && u <= 2815) { return B_GUJR; }
    if (u >= 2816 && u <= 2943) { return B_ORYA; }
    if (u >= 2944 && u <= 3071) { return B_TAML; }
    if (u >= 3072 && u <= 3199) { return B_TELU; }
    if (u >= 3200 && u <= 3327) { return B_KNDA; }
    if (u >= 3328 && u <= 3455) { return B_MLYM; }
    return B_OTHER;
}

// Where a matra goes among what follows the base, in each script's own way.
fn _matra_position(u as i64, pos as i64) as i64 {
    let is i64 as b = _block(u);
    if (pos == POS_PRE_C) { return POS_PRE_M; }
    if (pos == POS_POST_C) {
        if (b == B_BENG || b == B_GURU || b == B_GUJR || b == B_ORYA || b == B_TAML || b == B_MLYM) { return POS_AFTER_POST; }
        if (b == B_TELU) {
            if (u <= 3138) { return POS_BEFORE_SUB; }
            return POS_AFTER_SUB;
        }
        if (b == B_KNDA) {
            if (u < 3267 || u > 3286) { return POS_BEFORE_SUB; }
            return POS_AFTER_SUB;
        }
        return POS_AFTER_SUB;
    }
    if (pos == POS_ABOVE_C) {
        if (b == B_GURU) { return POS_AFTER_POST; }
        if (b == B_ORYA) { return POS_AFTER_MAIN; }
        if (b == B_TELU || b == B_KNDA) { return POS_BEFORE_SUB; }
        return POS_AFTER_SUB;
    }
    if (pos == POS_BELOW_C) {
        if (b == B_GURU || b == B_GUJR || b == B_TAML || b == B_MLYM) { return POS_AFTER_POST; }
        if (b == B_TELU || b == B_KNDA) { return POS_BEFORE_SUB; }
        return POS_AFTER_SUB;
    }
    return pos;
}

fn _is_ra(u as i64) as i32 {
    return cast(i32, u == 2352 || u == 2480 || u == 2544 || u == 2608 || u == 2736 || u == 2864 || u == 2992 ||
                     u == 3120 || u == 3248 || u == 3376);
}

fn _is_consonant_cat(c as i64) as i32 {
    return cast(i32, c == CAT_C || c == CAT_CS || c == CAT_RA || c == CAT_CM || c == CAT_V || c == CAT_PLACEHOLDER || c == CAT_CIRCLE);
}

fn _set_properties(g as *glyphs.Glyph) as void {
    let is i64 as u = cast(i64, g.id);
    let is i64 as cat with mut = base_category(syllabic_category(u));
    let is i64 as pos with mut = base_position(ucd.indic_positional_category(cast(i32, u)));
    if (u == 2387 || u == 2388) { cat = CAT_SM; }                          // 0953 0954: as Bindus
    else if (u == 2674 || u == 2675) { cat = CAT_C; }                      // 0A72 0A73
    else if ((u >= 7394 && u <= 7400) || u == 7405) { cat = CAT_A; }       // 1CE2..1CE8 1CED
    else if ((u >= 43250 && u <= 43255) || (u >= 7401 && u <= 7404) || (u >= 7406 && u <= 7409)) { cat = CAT_SYMBOL; }
    else if (u == 2641) {                                                  // 0A51
        cat = CAT_M;
        pos = POS_BELOW_C;
    }
    else if (u == 70401 || u == 70402 || u == 70403) { cat = CAT_SM; }     // Grantha's, used in Tamil
    else if (u == 70459 || u == 70460) { cat = CAT_N; }
    else if (u == 2811 || u == 2901) { cat = CAT_N; }                      // 0AFB 0B55
    else if (u == 2432 || u == 2556 || u == 3200 || u == 3332 || u == 8208 || u == 8209) { cat = CAT_PLACEHOLDER; }  // 0980 09FC 0C80 0D04 2010 2011
    else if (is_more_base(u) == 1) { cat = CAT_PLACEHOLDER; }
    else if (u == 9676) { cat = CAT_CIRCLE; }
    else if (u == 2386) { cat = CAT_A; }                                   // 0952
    else if (u == 2673) { cat = CAT_SM; }                                  // 0A71
    if (_is_consonant_cat(cat) == 1) {
        pos = POS_BASE_C;
        if (_is_ra(u) == 1) { cat = CAT_RA; }
    } else if (cat == CAT_M && u != 2641) {
        pos = _matra_position(u, pos);
    } else if (cat == CAT_SM || cat == CAT_A || cat == CAT_SYMBOL) {
        pos = POS_SMVD;
    }
    if (u == 2817) { pos = POS_BEFORE_SUB; }                               // 0B01
    g.scat = cast(u8, cat);
    g.spos = cast(u8, pos);
}

fn setup(w as *work.Work) as void {
    let is *glyphs.Run as run = w.run;
    let is i64 as i with mut = 0;
    while (i < run.len) {
        _set_properties(&run.src[i]);
        i = i + 1;
    }
}

// --- Normalization ---

// What is written is decomposed as Unicode says, but for a few the scripts need
// whole.
fn decompose_rule(u as i64, parts as *i64) as i64 {
    if (u == 2353 || u == 2524 || u == 2525 || u == 2964) { return 0; }    // 0931 09DC 09DD 0B94
    return compose.decompose_once(u, parts);
}

// A split matra is not put back together; and one composition Unicode excludes,
// YYA, is wanted.
fn compose_rule(a as i64, b as i64) as i64 {
    if (chars.is_mark(chars.category(a)) == 1) { return 0; }
    if (a == 2479 && b == 2492) { return 2527; }                           // 09AF 09BC: 09DF
    return cast(i64, norm.compose_pair(cast(i32, a), cast(i32, b)));
}

fn ways(w as *work.Work) as void {
    w.zero = work.ZERO_NONE;
    w.fallback = 0;
    w.rules.mode = compose.PARTS;
    w.rules.decompose = fn_ptr(decompose_rule);
    w.rules.compose = fn_ptr(compose_rule);
}

// --- Features ---

fn _feature_tag(i as i64) as i64 {
    if (i == F_NUKT) { return work.tag("nukt"); }
    if (i == F_AKHN) { return work.tag("akhn"); }
    if (i == F_RPHF) { return work.tag("rphf"); }
    if (i == F_RKRF) { return work.tag("rkrf"); }
    if (i == F_PREF) { return work.tag("pref"); }
    if (i == F_BLWF) { return work.tag("blwf"); }
    if (i == F_ABVF) { return work.tag("abvf"); }
    if (i == F_HALF) { return work.tag("half"); }
    if (i == F_PSTF) { return work.tag("pstf"); }
    if (i == F_VATU) { return work.tag("vatu"); }
    if (i == F_CJCT) { return work.tag("cjct"); }
    if (i == F_INIT) { return work.tag("init"); }
    if (i == F_PRES) { return work.tag("pres"); }
    if (i == F_ABVS) { return work.tag("abvs"); }
    if (i == F_BLWS) { return work.tag("blws"); }
    if (i == F_PSTS) { return work.tag("psts"); }
    return work.tag("haln");
}

// Whether a feature is for all of a syllable, or only the glyphs the reordering
// says.
fn _is_global(i as i64) as i32 {
    return cast(i32, i == F_NUKT || i == F_AKHN || i == F_RKRF || i == F_VATU || i == F_CJCT ||
                     i == F_PRES || i == F_ABVS || i == F_BLWS || i == F_PSTS || i == F_HALN);
}

fn _want(p as *plan.Plan, i as i64) as void {
    let is i64 as flags = plan.F_MANUAL_JOINERS | plan.F_PER_SYLLABLE;
    if (_is_global(i) == 1) { plan.on(p, _feature_tag(i), flags); } else { plan.add(p, _feature_tag(i), flags); }
}

fn collect(w as *work.Work) as void {
    let is *plan.Plan as p = w.plan;
    plan.pause(p, fn_ptr(_setup_syllables));
    plan.on(p, work.tag("locl"), plan.F_PER_SYLLABLE);
    plan.on(p, work.tag("ccmp"), plan.F_PER_SYLLABLE);
    plan.pause(p, fn_ptr(_initial_reordering));
    let is i64 as i with mut = 0;
    while (i < NBASIC) {
        _want(p, i);
        plan.pause(p, cast(plan.Pause, 0));
        i = i + 1;
    }
    plan.pause(p, fn_ptr(_final_reordering));
    while (i < NFEATURES) {
        _want(p, i);
        i = i + 1;
    }
}

// Uniscribe's are off here.
fn override(w as *work.Work) as void { plan.off(w.plan, work.tag("liga")); }

fn _config(w as *work.Work) as void {
    let is i64 as s = w.script;
    let is i64 as virama with mut = 0;
    let is i64 as pos with mut = REPH_BEFORE_POST;
    let is i64 as mode with mut = REPH_IMPLICIT;
    let is i64 as blwf with mut = BLWF_PRE_AND_POST;
    if (s == scripts.of("Deva")) { virama = 2381; }
    if (s == scripts.of("Beng")) { virama = 2509; pos = REPH_AFTER_SUB; }
    if (s == scripts.of("Guru")) { virama = 2637; pos = REPH_BEFORE_SUB; }
    if (s == scripts.of("Gujr")) { virama = 2765; }
    if (s == scripts.of("Orya")) { virama = 2893; pos = REPH_AFTER_MAIN; }
    if (s == scripts.of("Taml")) { virama = 3021; pos = REPH_AFTER_SUB; }
    if (s == scripts.of("Telu")) { virama = 3149; pos = REPH_AFTER_POST; mode = REPH_EXPLICIT; blwf = BLWF_POST_ONLY; }
    if (s == scripts.of("Knda")) { virama = 3277; pos = REPH_AFTER_POST; blwf = BLWF_POST_ONLY; }
    if (s == scripts.of("Mlym")) { virama = 3405; pos = REPH_AFTER_MAIN; mode = REPH_LOG_REPHA; }
    w.values[V_VIRAMA_CHAR] = virama;
    w.values[V_REPH_POS] = pos;
    w.values[V_REPH_MODE] = mode;
    w.values[V_BLWF_MODE] = blwf;
}

fn prepared(w as *work.Work) as void {
    let is i64 as tag = w.plan.chosen0;
    _config(w);
    w.values[V_OLD_SPEC] = cast(i64, (tag & 255) != 50);    // not a tag ending in '2'
    // The specifications for the second tags say a rule with context does not
    // count; Windows, trying Malayalam, says it does there.
    w.values[V_ZERO_CONTEXT] = cast(i64, w.values[V_OLD_SPEC] == 0 && w.script != scripts.of("Mlym"));
    w.values[V_VIRAMA] = 0;
    if (w.values[V_VIRAMA_CHAR] != 0) { w.values[V_VIRAMA] = cmap.glyph(w.f, w.values[V_VIRAMA_CHAR]); }
    let is i64 as i with mut = 0;
    while (i < NFEATURES) {
        if (_is_global(i) == 1) { w.masks[i] = 0; } else { w.masks[i] = plan.one_of(w.plan, _feature_tag(i)); }
        i = i + 1;
    }
    syllable.compile(&G_CONSONANT, W_CONSONANT);
    syllable.compile(&G_VOWEL, W_VOWEL);
    syllable.compile(&G_STANDALONE, W_STANDALONE);
    syllable.compile(&G_SYMBOL, W_SYMBOL);
    syllable.compile(&G_BROKEN, W_BROKEN);
}

fn _would(w as *work.Work, tag as i64, g as *i64, n as i64) as i32 {
    return would.would_substitute(w.f, w.plan, tag, g, n, cast(i32, w.values[V_ZERO_CONTEXT]));
}

// --- What a glyph still is ---

// A glyph that has ligated has stopped being any of these.
fn _is(g as *glyphs.Glyph, cat as i64) as i32 {
    return cast(i32, cast(i64, g.scat) == cat && (cast(i64, g.made) & glyphs.LIGATED) == 0);
}

fn is_halant(g as *glyphs.Glyph) as i32 { return _is(g, CAT_H); }

fn is_joiner(g as *glyphs.Glyph) as i32 {
    return cast(i32, (cast(i64, g.scat) == CAT_ZWJ || cast(i64, g.scat) == CAT_ZWNJ) && (cast(i64, g.made) & glyphs.LIGATED) == 0);
}

fn is_consonant(g as *glyphs.Glyph) as i32 {
    return cast(i32, _is_consonant_cat(cast(i64, g.scat)) == 1 && (cast(i64, g.made) & glyphs.LIGATED) == 0);
}

fn _ligated_only(g as *glyphs.Glyph) as i32 {
    let is i64 as m = cast(i64, g.made);
    return cast(i32, (m & glyphs.LIGATED) != 0 && (m & glyphs.MULTIPLIED) == 0);
}

// --- Syllables ---

fn _setup_syllables(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is [5]*syllable.Grammar as gs;
    gs[S_CONSONANT] = &G_CONSONANT;
    gs[S_VOWEL] = &G_VOWEL;
    gs[S_STANDALONE] = &G_STANDALONE;
    gs[S_SYMBOL] = &G_SYMBOL;
    gs[S_BROKEN] = &G_BROKEN;
    w.values[V_BROKEN] = cast(i64, syllable.find(w.run, cast(**syllable.Grammar, &gs), 5, S_OTHER, S_BROKEN));
}

// Where a consonant's form goes, as the font says it has one.
fn _position_from_font(w as *work.Work, consonant as i64, virama as i64) as i64 {
    let is [3]i64 as g;
    g[0] = virama;
    g[1] = consonant;
    g[2] = virama;
    let is *i64 as a = cast(*i64, &g);
    let is *i64 as b = cast(*i64, cast(i64, &g) + 8);
    let is i64 as blwf = work.tag("blwf");
    let is i64 as vatu = work.tag("vatu");
    let is i64 as pstf = work.tag("pstf");
    let is i64 as pref = work.tag("pref");
    if (_would(w, blwf, a, 2) == 1 || _would(w, blwf, b, 2) == 1 ||
        _would(w, vatu, a, 2) == 1 || _would(w, vatu, b, 2) == 1) { return POS_BELOW_C; }
    if (_would(w, pstf, a, 2) == 1 || _would(w, pstf, b, 2) == 1) { return POS_POST_C; }
    if (_would(w, pref, a, 2) == 1 || _would(w, pref, b, 2) == 1) { return POS_POST_C; }
    return POS_BASE_C;
}

fn _consonant_positions(w as *work.Work) as void {
    let is i64 as virama = w.values[V_VIRAMA];
    if (virama == 0) { return; }
    let is *glyphs.Run as run = w.run;
    let is i64 as i with mut = 0;
    while (i < run.len) {
        if (cast(i64, run.src[i].spos) == POS_BASE_C) {
            run.src[i].spos = cast(u8, _position_from_font(w, cast(i64, run.src[i].id), virama));
        }
        i = i + 1;
    }
}

fn _swap(run as *glyphs.Run, a as i64, b as i64) as void {
    let is glyphs.Glyph as t = run.src[a];
    run.src[a] = run.src[b];
    run.src[b] = t;
}

// Record from moved to to: what is between shifted over.
fn _move(run as *glyphs.Run, from as i64, to as i64) as void {
    let is glyphs.Glyph as t = run.src[from];
    let is i64 as k with mut = from;
    while (k < to) {
        run.src[k] = run.src[k + 1];
        k = k + 1;
    }
    while (k > to) {
        run.src[k] = run.src[k - 1];
        k = k - 1;
    }
    run.src[to] = t;
}

// Reversed, a .. b of the run.
fn _reverse(run as *glyphs.Run, a as i64, b as i64) as void {
    let is i64 as i with mut = a;
    let is i64 as j with mut = b - 1;
    while (i < j) {
        _swap(run, i, j);
        i = i + 1;
        j = j - 1;
    }
}

// The reph's sequence, if the syllable starts with one the font forms; the base
// looked for from the end of the syllable, whatever has a form below or after
// it passed over. The base's index, into *has_reph whether a reph formed.
fn _find_base(w as *work.Work, run as *glyphs.Run, start as i64, end as i64, has_reph as *i32) as i64 {
    let is i64 as base with mut = end;
    let is i64 as limit with mut = start;
    let is i64 as mode = w.values[V_REPH_MODE];
    *has_reph = 0;
    if (w.masks[F_RPHF] != 0 && start + 3 <= end &&
        ((mode == REPH_IMPLICIT && is_joiner(&run.src[start + 2]) == 0) ||
         (mode == REPH_EXPLICIT && cast(i64, run.src[start + 2].scat) == CAT_ZWJ))) {
        let is [3]i64 as g;
        g[0] = cast(i64, run.src[start].id);
        g[1] = cast(i64, run.src[start + 1].id);
        g[2] = 0;
        if (mode == REPH_EXPLICIT) { g[2] = cast(i64, run.src[start + 2].id); }
        let is i64 as rphf = work.tag("rphf");
        if (_would(w, rphf, cast(*i64, &g), 2) == 1 || (mode == REPH_EXPLICIT && _would(w, rphf, cast(*i64, &g), 3) == 1)) {
            limit = limit + 2;
            while (limit < end && is_joiner(&run.src[limit]) == 1) { limit = limit + 1; }
            base = start;
            *has_reph = 1;
        }
    } else if (mode == REPH_LOG_REPHA && cast(i64, run.src[start].scat) == CAT_REPHA) {
        limit = limit + 1;
        while (limit < end && is_joiner(&run.src[limit]) == 1) { limit = limit + 1; }
        base = start;
        *has_reph = 1;
    }
    let is i64 as i with mut = end;
    let is i32 as seen_below with mut = 0;
    let is i32 as going with mut = 1;
    while (going == 1) {
        i = i - 1;
        if (is_consonant(&run.src[i]) == 1) {
            let is i64 as pos = cast(i64, run.src[i].spos);
            if (pos != POS_BELOW_C && (pos != POS_POST_C || seen_below == 1)) {
                base = i;
                going = 0;
            } else {
                if (pos == POS_BELOW_C) { seen_below = 1; }
                base = i;
            }
        } else if (start < i && cast(i64, run.src[i].scat) == CAT_ZWJ && cast(i64, run.src[i - 1].scat) == CAT_H) {
            // A ZWJ after a halant asks for a half form: the search stops. One
            // before it asks for a subjoined form, and it goes on.
            going = 0;
        }
        if (i <= limit) { going = 0; }
    }
    // No other consonant: no reph either, and ra is the base.
    if (*has_reph == 1 && base == start && limit - base <= 2) { *has_reph = 0; }
    return base;
}

// What belongs with what is before it goes where that goes; what is after the
// base and before a consonant goes where that consonant does.
fn _settle_positions(run as *glyphs.Run, start as i64, end as i64, base as i64) as void {
    let is i64 as last_pos with mut = POS_START;
    let is i64 as i with mut = start;
    while (i < end) {
        let is i64 as c = cast(i64, run.src[i].scat);
        if (c == CAT_ZWJ || c == CAT_ZWNJ || c == CAT_N || c == CAT_RS || c == CAT_CM || c == CAT_H) {
            run.src[i].spos = cast(u8, last_pos);
            if (c == CAT_H && last_pos == POS_PRE_M) {
                // A halant does not go with a left matra.
                let is i64 as j with mut = i;
                while (j > start) {
                    if (cast(i64, run.src[j - 1].spos) != POS_PRE_M) {
                        run.src[i].spos = run.src[j - 1].spos;
                        j = start;
                    } else {
                        j = j - 1;
                    }
                }
            }
        } else if (cast(i64, run.src[i].spos) != POS_SMVD) {
            last_pos = cast(i64, run.src[i].spos);
        }
        i = i + 1;
    }
    let is i64 as last with mut = base;
    i = base + 1;
    while (i < end) {
        if (is_consonant(&run.src[i]) == 1) {
            let is i64 as j with mut = last + 1;
            while (j < i) {
                if (cast(i64, run.src[j].spos) < POS_SMVD) { run.src[j].spos = run.src[i].spos; }
                j = j + 1;
            }
            last = i;
        } else if (cast(i64, run.src[i].scat) == CAT_M) {
            last = i;
        }
        i = i + 1;
    }
}

// Sorted by position; those that moved past the base, and whatever moved around
// each other after it, made one cluster. The left matras' order flipped back. The
// base's new index.
fn _sort_syllable(w as *work.Work, run as *glyphs.Run, start as i64, end as i64) as i64 {
    let is u8 as syl = run.src[start].syl;
    let is i64 as i with mut = start;
    while (i < end) {
        run.src[i].syl = cast(u8, i - start);
        i = i + 1;
    }
    syllable.sort_range(run, start, end);
    let is i64 as first_left with mut = end;
    let is i64 as last_left with mut = end;
    let is i64 as base with mut = end;
    i = start;
    while (i < end && base == end) {
        let is i64 as pos = cast(i64, run.src[i].spos);
        if (pos == POS_BASE_C) {
            base = i;
        } else if (pos == POS_PRE_M) {
            if (first_left == end) { first_left = i; }
            last_left = i;
        }
        i = i + 1;
    }
    if (first_left < last_left) {
        _reverse(run, first_left, last_left + 1);
        let is i64 as a with mut = first_left;
        let is i64 as j with mut = first_left;
        while (j <= last_left) {
            if (cast(i64, run.src[j].scat) == CAT_M) {
                _reverse(run, a, j + 1);
                a = j + 1;
            }
            j = j + 1;
        }
    }
    if (w.values[V_OLD_SPEC] == 1 || end - start > 127) {
        glyphs.join(run, base, end);
    } else {
        // Each cycle of what moved where, made one cluster.
        i = base;
        while (i < end) {
            if (cast(i64, run.src[i].syl) != 255) {
                let is i64 as low with mut = i;
                let is i64 as high with mut = i;
                let is i64 as j with mut = start + cast(i64, run.src[i].syl);
                while (j != i) {
                    if (j < low) { low = j; }
                    if (j > high) { high = j; }
                    let is i64 as next = start + cast(i64, run.src[j].syl);
                    run.src[j].syl = cast(u8, 255);
                    j = next;
                }
                if (low < base) { low = base; }
                glyphs.join(run, low, high + 1);
            }
            i = i + 1;
        }
    }
    i = start;
    while (i < end) {
        run.src[i].syl = syl;
        i = i + 1;
    }
    return base;
}

// Each glyph told what may touch it.
fn _reordered_masks(w as *work.Work, run as *glyphs.Run, start as i64, end as i64, base as i64) as void {
    let is i64 as i with mut = start;
    while (i < end && cast(i64, run.src[i].spos) == POS_RA_TO_BECOME_REPH) {
        run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | w.masks[F_RPHF]);
        i = i + 1;
    }
    let is i64 as pre with mut = w.masks[F_HALF];
    if (w.values[V_OLD_SPEC] == 0 && w.values[V_BLWF_MODE] == BLWF_PRE_AND_POST) { pre = pre | w.masks[F_BLWF]; }
    i = start;
    while (i < base) {
        run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | pre);
        i = i + 1;
    }
    let is i64 as post = w.masks[F_BLWF] | w.masks[F_ABVF] | w.masks[F_PSTF];
    i = base + 1;
    while (i < end) {
        run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | post);
        i = i + 1;
    }
    // Old-spec Devanagari's eyelash ra: below half forms too, but as Ra,H,ZWJ.
    if (w.values[V_OLD_SPEC] == 1 && w.script == scripts.of("Deva")) {
        i = start;
        while (i + 1 < base) {
            if (cast(i64, run.src[i].scat) == CAT_RA && cast(i64, run.src[i + 1].scat) == CAT_H &&
                (i + 2 == base || cast(i64, run.src[i + 2].scat) != CAT_ZWJ)) {
                run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | w.masks[F_BLWF]);
                run.src[i + 1].mask = cast(u64, cast(i64, run.src[i + 1].mask) | w.masks[F_BLWF]);
            }
            i = i + 1;
        }
    }
    // A halant and ra with a pre-base form, for it to be moved later.
    if (w.masks[F_PREF] != 0 && base + 2 < end) {
        i = base + 1;
        while (i + 1 < end) {
            let is [2]i64 as g;
            g[0] = cast(i64, run.src[i].id);
            g[1] = cast(i64, run.src[i + 1].id);
            if (_would(w, work.tag("pref"), cast(*i64, &g), 2) == 1) {
                run.src[i].mask = cast(u64, cast(i64, run.src[i].mask) | w.masks[F_PREF]);
                run.src[i + 1].mask = cast(u64, cast(i64, run.src[i + 1].mask) | w.masks[F_PREF]);
                i = end;
            } else {
                i = i + 1;
            }
        }
    }
    // A ZWNJ keeps what is before it, back to a consonant, from a half form.
    i = start + 1;
    while (i < end) {
        if (is_joiner(&run.src[i]) == 1 && cast(i64, run.src[i].scat) == CAT_ZWNJ) {
            let is i64 as j with mut = i;
            let is i32 as going with mut = 1;
            while (going == 1) {
                j = j - 1;
                run.src[j].mask = cast(u64, cast(i64, run.src[j].mask) & (0 - 1 - w.masks[F_HALF]));
                if (j <= start || is_consonant(&run.src[j]) == 1) { going = 0; }
            }
        }
        i = i + 1;
    }
}

fn _reorder_consonant_syllable(w as *work.Work, start as i64, end as i64) as void {
    let is *glyphs.Run as run = w.run;
    // In Kannada, by old custom, Ra,H,ZWJ behaves as Ra,ZWJ,H.
    if (w.script == scripts.of("Knda") && start + 3 <= end && cast(i64, run.src[start].scat) == CAT_RA &&
        cast(i64, run.src[start + 1].scat) == CAT_H && cast(i64, run.src[start + 2].scat) == CAT_ZWJ) {
        glyphs.join(run, start + 1, start + 3);
        _swap(run, start + 1, start + 2);
    }
    let is i32 as has_reph with mut = 0;
    let is i64 as base with mut = _find_base(w, run, start, end, &has_reph);
    let is i64 as i with mut = start;
    while (i < base) {
        if (cast(i64, run.src[i].spos) > POS_PRE_C) { run.src[i].spos = cast(u8, POS_PRE_C); }
        i = i + 1;
    }
    if (base < end) { run.src[base].spos = cast(u8, POS_BASE_C); }
    if (has_reph == 1) { run.src[start].spos = cast(u8, POS_RA_TO_BECOME_REPH); }
    // The tags from before move the first halant after the base to after the last
    // consonant; in Kannada, unless there is already one there.
    if (w.values[V_OLD_SPEC] == 1) {
        let is i32 as no_double = cast(i32, w.script == scripts.of("Knda"));
        i = base + 1;
        while (i < end) {
            if (cast(i64, run.src[i].scat) == CAT_H) {
                let is i64 as j with mut = end - 1;
                while (j > i && is_consonant(&run.src[j]) == 0 && (no_double == 0 || cast(i64, run.src[j].scat) != CAT_H)) { j = j - 1; }
                if (cast(i64, run.src[j].scat) != CAT_H && j > i) { _move(run, i, j); }
                i = end;
            } else {
                i = i + 1;
            }
        }
    }
    _settle_positions(run, start, end, base);
    base = _sort_syllable(w, run, start, end);
    _reordered_masks(w, run, start, end, base);
}

fn _initial_reordering(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is *glyphs.Run as run = w.run;
    _consonant_positions(w);
    if (w.values[V_BROKEN] == 1) { syllable.insert_circles(w, S_BROKEN, CAT_CIRCLE, POS_END, CAT_REPHA); }
    let is i64 as start with mut = 0;
    while (start < run.len) {
        let is i64 as end = syllable.end_of(run, start);
        let is i64 as kind = cast(i64, run.src[start].syl) & 15;
        if (kind == S_VOWEL || kind == S_CONSONANT || kind == S_BROKEN || kind == S_STANDALONE) {
            _reorder_consonant_syllable(w, start, end);
        }
        start = end;
    }
}

// --- After the basic features ---

// Where a left matra ends up: after the last halant before the base that stayed,
// but not one with a ZWJ after it; if none, it stays. Moved there, its cluster
// joined up to the base. The base's new index.
fn _final_matras(w as *work.Work, run as *glyphs.Run, start as i64, end as i64, base0 as i64) as i64 {
    let is i64 as base with mut = base0;
    if (start + 1 >= end || start >= base) { return base; }
    let is i64 as new_pos with mut = base - 1;
    if (base == end) { new_pos = base - 2; }
    if (w.script != scripts.of("Mlym") && w.script != scripts.of("Taml")) {
        let is i32 as searching with mut = 1;
        while (searching == 1) {
            searching = 0;
            while (new_pos > start && (_is(&run.src[new_pos], CAT_M) == 0 && _is(&run.src[new_pos], CAT_H) == 0)) { new_pos = new_pos - 1; }
            if (is_halant(&run.src[new_pos]) == 1 && cast(i64, run.src[new_pos].spos) != POS_PRE_M) {
                if (new_pos + 1 < end && cast(i64, run.src[new_pos + 1].scat) == CAT_ZWJ && new_pos > start) {
                    new_pos = new_pos - 1;
                    searching = 1;
                }
            } else {
                new_pos = start;
            }
        }
    }
    if (start < new_pos && cast(i64, run.src[new_pos].spos) != POS_PRE_M) {
        let is i64 as i with mut = new_pos;
        while (i > start) {
            if (cast(i64, run.src[i - 1].spos) == POS_PRE_M) {
                let is i64 as old = i - 1;
                if (old < base && base <= new_pos) { base = base - 1; }
                _move(run, old, new_pos);
                let is i64 as upto with mut = base + 1;
                if (upto > end) { upto = end; }
                glyphs.join(run, new_pos, upto);
                new_pos = new_pos - 1;
            }
            i = i - 1;
        }
    } else {
        let is i64 as i with mut = start;
        while (i < base) {
            if (cast(i64, run.src[i].spos) == POS_PRE_M) {
                let is i64 as upto with mut = base + 1;
                if (upto > end) { upto = end; }
                glyphs.join(run, i, upto);
                i = base;
            } else {
                i = i + 1;
            }
        }
    }
    return base;
}

// Where a reph is first looked for: after the first halant before the base, or
// after a joiner following it; -1 when there is none.
fn _reph_after_halant(run as *glyphs.Run, start as i64, base as i64) as i64 {
    let is i64 as p with mut = start + 1;
    while (p < base && is_halant(&run.src[p]) == 0) { p = p + 1; }
    if (p < base && is_halant(&run.src[p]) == 1) {
        if (p + 1 < base && is_joiner(&run.src[p + 1]) == 1) { p = p + 1; }
        return p;
    }
    return 0 - 1;
}

// Where the reph goes, step by step as the specification says.
fn _reph_target(w as *work.Work, run as *glyphs.Run, start as i64, end as i64, base as i64) as i64 {
    let is i64 as reph_pos = w.values[V_REPH_POS];
    let is i64 as p with mut = 0 - 1;
    if (reph_pos != REPH_AFTER_POST) {
        p = _reph_after_halant(run, start, base);
        if (p >= 0) { return p; }
        if (reph_pos == REPH_AFTER_MAIN) {
            p = base;
            while (p + 1 < end && cast(i64, run.src[p + 1].spos) <= POS_AFTER_MAIN) { p = p + 1; }
            if (p < end) { return p; }
        }
        if (reph_pos == REPH_AFTER_SUB) {
            p = base;
            let is i32 as going with mut = 1;
            while (going == 1 && p + 1 < end) {
                let is i64 as np = cast(i64, run.src[p + 1].spos);
                if (np == POS_POST_C || np == POS_AFTER_POST || np == POS_SMVD) { going = 0; } else { p = p + 1; }
            }
            if (p < end) { return p; }
        }
    }
    p = _reph_after_halant(run, start, base);
    if (p >= 0) { return p; }
    // Otherwise the end of the syllable, before what is after everything; not past
    // a halant of a matra, so it can act on the matra.
    p = end - 1;
    while (p > start && cast(i64, run.src[p].spos) == POS_SMVD) { p = p - 1; }
    if (is_halant(&run.src[p]) == 1) {
        let is i64 as i with mut = base + 1;
        while (i < p) {
            if (cast(i64, run.src[i].scat) == CAT_M) { p = p - 1; }
            i = i + 1;
        }
    }
    return p;
}

fn _final_syllable(w as *work.Work, start as i64, end as i64) as void {
    let is *glyphs.Run as run = w.run;
    // A halant may have been lost to a ligature and got back: it counts.
    let is i64 as virama = w.values[V_VIRAMA];
    if (virama != 0) {
        let is i64 as k with mut = start;
        while (k < end) {
            let is i64 as m = cast(i64, run.src[k].made);
            if (cast(i64, run.src[k].id) == virama && (m & glyphs.LIGATED) != 0 && (m & glyphs.MULTIPLIED) != 0) {
                run.src[k].scat = cast(u8, CAT_H);
                run.src[k].made = cast(u8, m & (255 - glyphs.LIGATED - glyphs.MULTIPLIED));
            }
            k = k + 1;
        }
    }
    let is i32 as try_pref with mut = cast(i32, w.masks[F_PREF] != 0);
    let is i64 as base with mut = start;
    let is i32 as found with mut = 0;
    while (base < end && found == 0) {
        if (cast(i64, run.src[base].spos) >= POS_BASE_C) {
            found = 1;
            if (try_pref == 1 && base + 1 < end) {
                let is i64 as i with mut = base + 1;
                while (i < end) {
                    if ((cast(i64, run.src[i].mask) & w.masks[F_PREF]) != 0) {
                        if (((cast(i64, run.src[i].made) & glyphs.SUBSTITUTED) != 0 && _ligated_only(&run.src[i]) == 1) == 0) {
                            // Asked for a pre-base form and did not get one: the base is
                            // around here.
                            base = i;
                            while (base < end && is_halant(&run.src[base]) == 1) { base = base + 1; }
                            if (base < end) { run.src[base].spos = cast(u8, POS_BASE_C); }
                            try_pref = 0;
                        }
                        i = end;
                    } else {
                        i = i + 1;
                    }
                }
            }
            if (base < end) {
                // Malayalam: over below-forms that did not form.
                if (w.script == scripts.of("Mlym")) {
                    let is i64 as i with mut = base + 1;
                    let is i32 as on with mut = 1;
                    while (on == 1 && i < end) {
                        while (i < end && is_joiner(&run.src[i]) == 1) { i = i + 1; }
                        if (i == end || is_halant(&run.src[i]) == 0) {
                            on = 0;
                        } else {
                            i = i + 1;
                            while (i < end && is_joiner(&run.src[i]) == 1) { i = i + 1; }
                            if (i < end && is_consonant(&run.src[i]) == 1 && cast(i64, run.src[i].spos) == POS_BELOW_C) {
                                base = i;
                                run.src[base].spos = cast(u8, POS_BASE_C);
                            }
                            i = i + 1;
                        }
                    }
                }
                if (start < base && cast(i64, run.src[base].spos) > POS_BASE_C) { base = base - 1; }
            }
        } else {
            base = base + 1;
        }
    }
    if (base == end && start < base && _is(&run.src[base - 1], CAT_ZWJ) == 1) { base = base - 1; }
    if (base < end) {
        while (start < base && (_is(&run.src[base], CAT_N) == 1 || _is(&run.src[base], CAT_H) == 1)) { base = base - 1; }
    }
    base = _final_matras(w, run, start, end, base);

    // The reph: if a sequence, moved only if it ligated into one; if a character
    // of its own, only if it did not, the font having done it some other way.
    if (start + 1 < end && cast(i64, run.src[start].spos) == POS_RA_TO_BECOME_REPH) {
        let is i32 as own = cast(i32, cast(i64, run.src[start].scat) == CAT_REPHA);
        if (own != _ligated_only(&run.src[start])) {
            let is i64 as target = _reph_target(w, run, start, end, base);
            glyphs.join(run, start, target + 1);
            _move(run, start, target);
            if (start < base && base <= target) { base = base - 1; }
        }
    }

    // A pre-base reordering consonant: if the pref feature ligated it, before the
    // base; or, as a matra goes, after a halant.
    if (try_pref == 1 && base + 1 < end) {
        let is i64 as i with mut = base + 1;
        while (i < end) {
            if ((cast(i64, run.src[i].mask) & w.masks[F_PREF]) != 0) {
                if (_ligated_only(&run.src[i]) == 1) {
                    let is i64 as new_pos with mut = base;
                    if (w.script != scripts.of("Mlym") && w.script != scripts.of("Taml")) {
                        while (new_pos > start && _is(&run.src[new_pos - 1], CAT_M) == 0 && _is(&run.src[new_pos - 1], CAT_H) == 0) { new_pos = new_pos - 1; }
                    }
                    if (new_pos > start && is_halant(&run.src[new_pos - 1]) == 1) {
                        if (new_pos < end && is_joiner(&run.src[new_pos]) == 1) { new_pos = new_pos + 1; }
                    }
                    glyphs.join(run, new_pos, i + 1);
                    _move(run, i, new_pos);
                    if (new_pos <= base && base < i) { base = base + 1; }
                }
                i = end;
            } else {
                i = i + 1;
            }
        }
    }

    // A left matra starting a word.
    if (cast(i64, run.src[start].spos) == POS_PRE_M) {
        let is i32 as in_word with mut = 0;
        if (start > 0) {
            let is i64 as gc = cast(i64, run.src[start - 1].cat);
            in_word = cast(i32, gc <= 8 || gc == 27 || gc == 28 || gc == 29);
        }
        if (in_word == 0) {
            run.src[start].mask = cast(u64, cast(i64, run.src[start].mask) | w.masks[F_INIT]);
        } else {
            glyphs.mark_unsafe(run, start - 1, start + 1);
        }
    }
}

fn _final_reordering(user as *u8) as void {
    let is *work.Work as w = cast(*work.Work, user);
    let is *glyphs.Run as run = w.run;
    let is i64 as start with mut = 0;
    while (start < run.len) {
        let is i64 as end = syllable.end_of(run, start);
        let is i64 as kind = cast(i64, run.src[start].syl) & 15;
        if (kind != S_OTHER && kind != S_SYMBOL) { _final_syllable(w, start, end); }
        start = end;
    }
}
