// text/shape/scripts.cst — scripts as OpenType names them, and the way each
// is written.
//
// A script comes as its ISO 15924 code, packed as a tag (of("Latn")).
// OpenType's script tag is that code in lower case, but for the exceptions
// its registry lists: the kana share 'kana'; Lao, N'Ko, Vai and Yi are padded
// with spaces; the Indic scripts and Myanmar have a second version of their
// shaping, whose tag ('dev2', 'mym2') a font made for it uses, and which is
// tried before the first ('deva', 'mymr').
use "tables.cst" as tables;

fn of(s as *u8) as i64 {
    return (cast(i64, s[0]) << 24) | (cast(i64, s[1]) << 16) | (cast(i64, s[2]) << 8) | cast(i64, s[3]);
}

let is i64 as DFLT with imut = 1145457748;   // 'DFLT'
let is i64 as DFLT_LOWER with imut = 1684434036;   // 'dflt'
let is i64 as LATN with imut = 1818326126;   // 'latn'

let is i64 as LTR with imut = 4;
let is i64 as RTL with imut = 5;

// Most tags a script has.
let is i64 as MAX_TAGS with imut = 2;

fn _lower(t as i64) as i64 {
    let is i64 as out with mut = 0;
    let is i64 as k with mut = 24;
    while (k >= 0) {
        let is i64 as c with mut = (t >> k) & 255;
        if (c >= 65 && c <= 90) { c = c + 32; }
        out = out | (c << k);
        k = k - 8;
    }
    return out;
}

// Whether a script names no script of its own: common, inherited, unknown.
fn is_none(script as i64) as i32 {
    return cast(i32, script == 0 || script == of("Zyyy") || script == of("Zinh") || script == of("Zzzz"));
}

// The second version's tag of an Indic script or Myanmar; 0 for none.
fn _second(script as i64) as i64 {
    if (script == of("Beng")) { return of("bng2"); }
    if (script == of("Deva")) { return of("dev2"); }
    if (script == of("Gujr")) { return of("gjr2"); }
    if (script == of("Guru")) { return of("gur2"); }
    if (script == of("Knda")) { return of("knd2"); }
    if (script == of("Mlym")) { return of("mlm2"); }
    if (script == of("Orya")) { return of("ory2"); }
    if (script == of("Taml")) { return of("tml2"); }
    if (script == of("Telu")) { return of("tel2"); }
    if (script == of("Mymr")) { return of("mym2"); }
    return 0;
}

// The script's OpenType tags into out, the one to try first first; how many.
fn tags(script as i64, out as *i64) as i64 {
    if (is_none(script) == 1) { return 0; }
    if (script == of("Hira") || script == of("Kana") || script == of("Hrkt")) {
        out[0] = of("kana");
        return 1;
    }
    if (script == of("Laoo")) { out[0] = of("lao "); return 1; }
    if (script == of("Nkoo")) { out[0] = of("nko "); return 1; }
    if (script == of("Vaii")) { out[0] = of("vai "); return 1; }
    if (script == of("Yiii")) { out[0] = of("yi  "); return 1; }
    if (script == of("Zmth")) { out[0] = of("math"); return 1; }
    let is i64 as second = _second(script);
    if (second != 0) {
        out[0] = second;
        out[1] = _lower(script);
        return 2;
    }
    out[0] = _lower(script);
    return 1;
}

// The direction the script is written in: RTL, LTR, or 0 for a script of
// its own that has none (common, inherited, unknown).
fn direction(script as i64) as i64 {
    if (is_none(script) == 1) { return 0; }
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = tables.RTL_COUNT - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is i64 as t = of(cast(*u8, cast(i64, tables.RTL) + mid * 4));
        if (script < t) { hi = mid - 1; } else if (script > t) { lo = mid + 1; } else { return RTL; }
    }
    return LTR;
}
