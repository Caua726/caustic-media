// text/shape/fallback.cst — what the font does not do, done for it: spaces it
// has no glyph for given their width, and marks placed by a font that has
// no GPOS to place them.
//
// A mark goes where its combining class says (Unicode's classes 200 to 240:
// above or below, attached or not), around the ink of the glyph it follows
// in its grapheme — centred over it, or on its left or right edge; clear of
// it by a sixteenth of the em unless attached; marks on the same side
// stacking outward; an overlay through its middle. A mark of a class that
// names no position goes above when its own ink is above the baseline and
// below when it is not. Only the classes some non-spacing or enclosing mark
// has are named: the side classes (208, 210, 224, 226) hold spacing marks
// alone, which keep their advance and are not placed.
use "../outline/outline.cst" as outline;
use "../sfnt/cmap.cst" as cmap;
use "glyphs.cst" as glyphs;
use "chars.cst" as chars;
use "scripts.cst" as scripts;

fn _first_advance(r as *outline.Reader, chars0 as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (chars0[i] != 0) {
        let is i64 as g = cmap.glyph(r.face, cast(i64, chars0[i]));
        if (g != 0) { return outline.advance_rounded(r, g); }
        i = i + 1;
    }
    return 0 - 1;
}

// The spaces drawn with the font's space given their own width.
fn spaces(r as *outline.Reader, run as *glyphs.Run) as void {
    let is i64 as em = r.face.upem;
    let is i64 as figure = _first_advance(r, "0123456789");
    let is i64 as stop with mut = _first_advance(r, ".");
    if (stop < 0) { stop = _first_advance(r, ","); }
    let is i64 as i with mut = 0;
    while (i < run.len) {
        let is *glyphs.Glyph as g = &run.src[i];
        if ((cast(i64, g.uflags) & glyphs.U_FALLBACK_SPACE) != 0) {
            let is *glyphs.Place as p = &run.place[i];
            let is i64 as kind = cast(i64, g.space);
            if (kind >= 1 && kind <= 6) { p.xa = cast(i32, (em + kind / 2) / kind); }
            else if (kind == chars.SPACE_EM_16) { p.xa = cast(i32, (em + 8) / 16); }
            else if (kind == chars.SPACE_4_EM_18) { p.xa = cast(i32, em * 4 / 18); }
            else if (kind == chars.SPACE_FIGURE && figure >= 0) { p.xa = cast(i32, figure); }
            else if (kind == chars.SPACE_PUNCTUATION && stop >= 0) { p.xa = cast(i32, stop); }
            else if (kind == chars.SPACE_NARROW) { p.xa = cast(i32, cast(i64, p.xa) / 2); }
        }
        i = i + 1;
    }
}

// --- Marks ---

let is i64 as ABOVE with imut = 1;
let is i64 as BELOW with imut = 2;
let is i64 as LEFT with imut = 4;      // on the base's left edge
let is i64 as RIGHT with imut = 8;     // on its right edge
let is i64 as ATTACHED with imut = 16; // touching it
let is i64 as THROUGH with imut = 64;  // through its middle

// Where a combining class puts a mark; 0 for a class that does not say.
fn where_class(ccc as i64) as i64 {
    if (ccc == 1) { return THROUGH; }
    if (ccc == 202) { return BELOW | ATTACHED; }
    if (ccc == 214) { return ABOVE | ATTACHED; }
    if (ccc == 216) { return ABOVE | RIGHT | ATTACHED; }
    if (ccc == 218) { return BELOW | LEFT; }
    if (ccc == 220 || ccc == 233 || ccc == 240) { return BELOW; }
    if (ccc == 222) { return BELOW | RIGHT; }
    if (ccc == 228) { return ABOVE | LEFT; }
    if (ccc == 230 || ccc == 234) { return ABOVE; }
    if (ccc == 232) { return ABOVE | RIGHT; }
    return 0;
}

struct Box {
    x0 as i64;
    y0 as i64;
    x1 as i64;
    y1 as i64;
}

fn _box(r as *outline.Reader, g as i64, b as *Box) as i32 {
    let is outline.Extents as e;
    if (outline.extents(r, g, &e) == 0) { return 0; }
    b.x0 = e.x_bearing;
    b.x1 = e.x_bearing + e.width;
    b.y1 = e.y_bearing;
    b.y0 = e.y_bearing + e.height;
    return 1;
}

// The marks after base, up to end, placed around it.
fn _cluster(r as *outline.Reader, run as *glyphs.Run, base as i64, end as i64, dir as i64) as void {
    let is Box as bb;
    if (_box(r, cast(i64, run.src[base].id), &bb) == 0) { return; }
    let is i64 as gap = r.face.upem / 16;
    // The base's ink where the marks see it: from the pen after the base,
    // which is where an advance-less mark is drawn. (Without GPOS nothing
    // moves a base up or down; the legacy kern table moves it along.)
    let is i64 as adv = cast(i64, run.place[base].xa);
    let is i64 as shift with mut = 0 - adv;
    if (dir == scripts.RTL) { shift = 0; }
    bb.x0 = bb.x0 + shift + cast(i64, run.place[base].xo);
    bb.x1 = bb.x1 + shift + cast(i64, run.place[base].xo);
    let is i64 as top with mut = bb.y1;
    let is i64 as bottom with mut = bb.y0;
    let is i64 as i with mut = base + 1;
    while (i < end) {
        let is *glyphs.Glyph as g = &run.src[i];
        let is i64 as ccc = cast(i64, g.ccc);
        let is Box as mb;
        let is i64 as gc = cast(i64, g.cat);
        let is i32 as placed = cast(i32, (gc == chars.NON_SPACING_MARK || gc == chars.ENCLOSING_MARK) &&
                                         (cast(i64, g.uflags) & glyphs.U_IGNORABLE) == 0);
        if (placed == 1 && _box(r, cast(i64, g.id), &mb) == 1) {
            let is i64 as w with mut = where_class(ccc);
            if (w == 0) {
                if (mb.y0 + mb.y1 > 0) { w = ABOVE; } else { w = BELOW; }
            }
            let is *glyphs.Place as p = &run.place[i];
            let is i64 as x with mut = (bb.x0 + bb.x1) / 2 - (mb.x0 + mb.x1) / 2;
            if ((w & LEFT) != 0) { x = bb.x0 - mb.x0; }
            if ((w & RIGHT) != 0) { x = bb.x1 - mb.x1; }
            let is i64 as clear with mut = gap;
            if ((w & ATTACHED) != 0) { clear = 0; }
            let is i64 as y with mut = 0;
            if ((w & ABOVE) != 0) {
                y = top + clear - mb.y0;
                top = y + mb.y1;
            } else if ((w & BELOW) != 0) {
                y = bottom - clear - mb.y1;
                bottom = y + mb.y0;
            } else if ((w & THROUGH) != 0) {
                y = (bb.y0 + bb.y1) / 2 - (mb.y0 + mb.y1) / 2;
            }
            p.xo = cast(i32, x);
            p.yo = cast(i32, y);
        }
        i = i + 1;
    }
}

// Each grapheme's marks placed around the glyph they follow. dir is the run's.
fn position_marks(r as *outline.Reader, run as *glyphs.Run, dir as i64) as void {
    let is i64 as i with mut = 0;
    while (i < run.len) {
        let is i64 as end with mut = i + 1;
        while (end < run.len && run.src[end].cluster == run.src[i].cluster) { end = end + 1; }
        // The first glyph that is not a mark is the base.
        let is i64 as base with mut = i;
        while (base < end && chars.is_mark(cast(i64, run.src[base].cat)) == 1) { base = base + 1; }
        if (base < end) { _cluster(r, run, base, end, dir); }
        i = end;
    }
}
