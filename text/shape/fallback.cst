// text/shape/fallback.cst — what shaping does when the font does not:
// spaces the font lacks, given the width their names promise; and marks a
// font with no GPOS cannot place, put where their classes say by the boxes
// of their outlines.
//
// Normalization draws a space the font does not have with the font's own
// space (normalize.cst); here it is given its width: a fraction of the em,
// a figure's or a full stop's advance, or half the space's own.
use "../outline/outline.cst" as outline;
use "buffer.cst" as buffer;
use "props.cst" as props;

// The combining classes marks are placed by.
let is i64 as ATTACHED_BELOW_LEFT with imut = 200;
let is i64 as ATTACHED_BELOW with imut = 202;
let is i64 as ATTACHED_ABOVE with imut = 214;
let is i64 as ATTACHED_ABOVE_RIGHT with imut = 216;
let is i64 as BELOW_LEFT with imut = 218;
let is i64 as BELOW with imut = 220;
let is i64 as BELOW_RIGHT with imut = 222;
let is i64 as ABOVE_LEFT with imut = 228;
let is i64 as ABOVE with imut = 230;
let is i64 as ABOVE_RIGHT with imut = 232;
let is i64 as DOUBLE_BELOW with imut = 233;
let is i64 as DOUBLE_ABOVE with imut = 234;

// The spaces in the buffer made from the font's space, given their widths:
// figure and punct are the advances of the font's first digit and of its
// full stop or comma, -1 when it has none.
fn spaces(b as *buffer.Buffer, upem as i64, figure as i64, punct as i64) as void {
    let is i64 as i with mut = 0;
    while (i < b.len) {
        let is *buffer.Info as info = &b.info[i];
        if (props.is_unicode_space(info) == 1 && (props.glyph_props(info) & props.LIGATED) == 0) {
            let is i64 as kind = props.space_fallback_of(info);
            if (kind == props.SPACE_EM || kind == props.SPACE_EM_2 || kind == props.SPACE_EM_3 ||
                kind == props.SPACE_EM_4 || kind == props.SPACE_EM_5 || kind == props.SPACE_EM_6 ||
                kind == props.SPACE_EM_16) {
                b.pos[i].xa = cast(i32, (upem + kind / 2) / kind);
            } else if (kind == props.SPACE_4_EM_18) {
                b.pos[i].xa = cast(i32, upem * 4 / 18);
            } else if (kind == props.SPACE_FIGURE) {
                if (figure >= 0) { b.pos[i].xa = cast(i32, figure); }
            } else if (kind == props.SPACE_PUNCTUATION) {
                if (punct >= 0) { b.pos[i].xa = cast(i32, punct); }
            } else if (kind == props.SPACE_NARROW) {
                b.pos[i].xa = cast(i32, cast(i64, b.pos[i].xa) / 2);
            }
        }
        i = i + 1;
    }
}

// --- Marks ---

// The class mark u is placed by, from its modified class: the classes of
// Hebrew, Arabic, Syriac, Thai, Lao and Tibetan, which say how marks sort,
// made the classes that say where they go.
fn _recategorize(u as i64, klass as i64) as i64 {
    if (klass >= 200) { return klass; }
    let is i64 as k with mut = klass;
    if ((u >> 8) == 14) {
        if (k == 0) {
            if (u == 3633 || u == 3636 || u == 3637 || u == 3638 || u == 3639 || u == 3655 ||
                u == 3660 || u == 3661 || u == 3662) {
                k = ABOVE_RIGHT;
            } else if (u == 3761 || u == 3764 || u == 3765 || u == 3766 || u == 3767 || u == 3771 ||
                       u == 3788 || u == 3789) {
                k = ABOVE;
            } else if (u == 3772) {
                k = BELOW;
            }
        } else if (u == 3642) {
            k = BELOW_RIGHT;
        }
    }
    // Hebrew: sheva .. qamats, qubuts, meteg below; rafe attached above; shin
    // dot above right; sin dot, holam above left; varika above; dagesh stays.
    if (k == 22 || k == 15 || k == 16 || k == 17 || k == 23 || k == 18 || k == 19 || k == 20 ||
        k == 21 || k == 24 || k == 25) { return BELOW; }
    if (k == 13) { return ATTACHED_ABOVE; }
    if (k == 10) { return ABOVE_RIGHT; }
    if (k == 11 || k == 14) { return ABOVE_LEFT; }
    if (k == 26) { return ABOVE; }
    // Arabic and Syriac: kasratan and kasra below, the rest above.
    if (k == 28 || k == 29 || k == 31 || k == 32 || k == 27 || k == 34 || k == 35 || k == 36) { return ABOVE; }
    if (k == 30 || k == 33) { return BELOW; }
    // Thai, Lao, Tibetan.
    if (k == 3) { return BELOW_RIGHT; }
    if (k == 107) { return ABOVE_RIGHT; }
    if (k == 118) { return BELOW; }
    if (k == 122) { return ABOVE; }
    if (k == 129) { return BELOW; }
    if (k == 132) { return ABOVE; }
    if (k == 131) { return BELOW; }
    return k;
}

// Before glyphs are chosen: each non-spacing mark given the class it is
// placed by.
fn recategorize_marks(b as *buffer.Buffer) as void {
    let is i64 as i with mut = 0;
    while (i < b.len) {
        let is *buffer.Info as info = &b.info[i];
        if (props.category(info) == props.NON_SPACING_MARK) {
            props.set_modified_class(info, _recategorize(cast(i64, info.cp), props.modified_class_of(info)));
        }
        i = i + 1;
    }
}

fn _sat(v as i64) as i32 {
    if (v > 2147483647) { return cast(i32, 2147483647); }
    if (v < 0 - 2147483648) { return cast(i32, 0 - 2147483648); }
    return cast(i32, v);
}

fn _sat64(v as i64) as i64 { return cast(i64, _sat(v)); }

fn _zero_advances(b as *buffer.Buffer, start as i64, end as i64, adjust as i32) as void {
    let is i64 as i with mut = start;
    while (i < end) {
        if (props.category(&b.info[i]) == props.NON_SPACING_MARK) {
            if (adjust == 1) {
                b.pos[i].xo = _sat(cast(i64, b.pos[i].xo) - cast(i64, b.pos[i].xa));
                b.pos[i].yo = _sat(cast(i64, b.pos[i].yo) - cast(i64, b.pos[i].ya));
            }
            b.pos[i].xa = cast(i32, 0);
            b.pos[i].ya = cast(i32, 0);
        }
        i = i + 1;
    }
}

// Mark i placed against base — the box of the base, or of the marks of
// its class already placed on it, which grows by this one.
fn _position_mark(r as *outline.Reader, b as *buffer.Buffer, base as *outline.Extents, i as i64, klass as i64) as void {
    let is outline.Extents as m;
    if (outline.extents(r, cast(i64, b.info[i].cp), &m) == 0) { return; }
    let is i64 as gap = r.face.upem / 16;
    let is i64 as xo with mut = 0;
    let is i64 as yo with mut = 0;
    let is i32 as done with mut = 0;
    if (klass == DOUBLE_BELOW || klass == DOUBLE_ABOVE) {
        if (b.dir == buffer.LTR) {
            xo = base.x_bearing + base.width - m.width / 2 - m.x_bearing;
            done = 1;
        } else if (b.dir == buffer.RTL) {
            xo = base.x_bearing - m.width / 2 - m.x_bearing;
            done = 1;
        }
    }
    if (done == 0) {
        if (klass == ATTACHED_BELOW_LEFT || klass == BELOW_LEFT || klass == ABOVE_LEFT) {
            xo = base.x_bearing - m.x_bearing;
        } else if (klass == ATTACHED_ABOVE_RIGHT || klass == BELOW_RIGHT || klass == ABOVE_RIGHT) {
            xo = base.x_bearing + base.width - m.width - m.x_bearing;
        } else {
            xo = base.x_bearing + (base.width - m.width) / 2 - m.x_bearing;
        }
    }
    if (klass == DOUBLE_BELOW || klass == BELOW_LEFT || klass == BELOW || klass == BELOW_RIGHT ||
        klass == ATTACHED_BELOW_LEFT || klass == ATTACHED_BELOW) {
        if (klass != ATTACHED_BELOW_LEFT && klass != ATTACHED_BELOW) {
            base.height = _sat64(base.height - gap);
        }
        yo = base.y_bearing + base.height - m.y_bearing;
        // Never shift up "below" marks.
        if ((gap > 0) == (yo > 0)) {
            base.height = _sat64(base.height - yo);
            yo = 0;
        }
        base.height = _sat64(base.height + m.height);
    } else if (klass == DOUBLE_ABOVE || klass == ABOVE_LEFT || klass == ABOVE || klass == ABOVE_RIGHT ||
               klass == ATTACHED_ABOVE || klass == ATTACHED_ABOVE_RIGHT) {
        if (klass != ATTACHED_ABOVE && klass != ATTACHED_ABOVE_RIGHT) {
            base.y_bearing = _sat64(base.y_bearing + gap);
            base.height = _sat64(base.height - gap);
        }
        yo = base.y_bearing - m.y_bearing - m.height;
        // Don't shift down "above" marks too much.
        if ((gap > 0) != (yo > 0)) {
            let is i64 as correction = 0 - yo / 2;
            base.y_bearing = _sat64(base.y_bearing + correction);
            base.height = _sat64(base.height - correction);
            yo = _sat64(yo + correction);
        }
        base.y_bearing = _sat64(base.y_bearing - m.height);
        base.height = _sat64(base.height + m.height);
    }
    b.pos[i].xo = _sat(xo);
    b.pos[i].yo = _sat(yo);
}

// The marks after base, up to end, placed on it — on a ligature, on the
// component each belongs to.
fn _position_around_base(r as *outline.Reader, b as *buffer.Buffer, target as i64, base as i64, end as i64, adjust as i32) as void {
    buffer.unsafe_to_break(b, base, end);
    let is outline.Extents as be;
    if (outline.extents(r, cast(i64, b.info[base].cp), &be) == 0) {
        _zero_advances(b, base + 1, end, adjust);
        return;
    }
    be.y_bearing = _sat64(be.y_bearing + cast(i64, b.pos[base].yo));
    be.x_bearing = 0;
    be.width = outline.advance_rounded(r, cast(i64, b.info[base].cp));
    let is i64 as lig_id = props.lig_id(&b.info[base]);
    let is i64 as num = props.lig_num_comps(&b.info[base]);
    let is i64 as xoff with mut = 0;
    let is i64 as yoff with mut = 0;
    if (b.dir == buffer.LTR) {
        xoff = 0 - cast(i64, b.pos[base].xa);
        yoff = 0 - cast(i64, b.pos[base].ya);
    }
    let is outline.Extents as comp with mut = be;
    let is outline.Extents as cluster with mut = be;
    let is i64 as last_comp with mut = 0 - 1;
    let is i64 as last_class with mut = 255;
    let is i64 as i with mut = base + 1;
    while (i < end) {
        let is i64 as klass = props.modified_class_of(&b.info[i]);
        if (klass != 0) {
            if (num > 1) {
                let is i64 as this_id = props.lig_id(&b.info[i]);
                let is i64 as this_comp with mut = props.lig_comp(&b.info[i]) - 1;
                if (lig_id == 0 || lig_id != this_id || this_comp >= num) { this_comp = num - 1; }
                if (last_comp != this_comp) {
                    last_comp = this_comp;
                    last_class = 255;
                    comp = be;
                    if (target == buffer.LTR) {
                        comp.x_bearing = _sat64(comp.x_bearing + this_comp * comp.width / num);
                    } else {
                        comp.x_bearing = _sat64(comp.x_bearing + (num - 1 - this_comp) * comp.width / num);
                    }
                    comp.width = comp.width / num;
                }
            }
            if (last_class != klass) {
                last_class = klass;
                cluster = comp;
            }
            _position_mark(r, b, &cluster, i, klass);
            b.pos[i].xa = cast(i32, 0);
            b.pos[i].ya = cast(i32, 0);
            b.pos[i].xo = _sat(cast(i64, b.pos[i].xo) + xoff);
            b.pos[i].yo = _sat(cast(i64, b.pos[i].yo) + yoff);
        } else if (b.dir == buffer.LTR) {
            xoff = _sat64(xoff - cast(i64, b.pos[i].xa));
            yoff = _sat64(yoff - cast(i64, b.pos[i].ya));
        } else {
            xoff = _sat64(xoff + cast(i64, b.pos[i].xa));
            yoff = _sat64(yoff + cast(i64, b.pos[i].ya));
        }
        i = i + 1;
    }
}

fn _skipped(i as *buffer.Info) as i32 {
    if (props.is_hidden(i) == 1 || props.is_default_ignorable_of(i) == 1) { return 1; }
    return 0;
}

fn _position_cluster(r as *outline.Reader, b as *buffer.Buffer, target as i64, start as i64, end as i64, adjust as i32) as void {
    if (end - start < 2) { return; }
    let is i64 as i with mut = start;
    while (i < end) {
        if (props.is_unicode_mark(&b.info[i]) == 0) {
            let is i64 as j with mut = i + 1;
            while (j < end && (_skipped(&b.info[j]) == 1 || props.is_unicode_mark(&b.info[j]) == 1)) { j = j + 1; }
            _position_around_base(r, b, target, i, j, adjust);
            i = j - 1;
        }
        i = i + 1;
    }
}

// Marks placed by their outlines, for a font that does not place them:
// each cluster's marks around its base. target is the run's direction;
// adjust whether marks were moved back by their advances when those were
// taken away.
fn position_marks(r as *outline.Reader, b as *buffer.Buffer, target as i64, adjust as i32) as void {
    let is i64 as start with mut = 0;
    let is i64 as i with mut = 1;
    while (i < b.len) {
        let is *buffer.Info as info = &b.info[i];
        if (props.is_unicode_mark(info) == 0 && _skipped(info) == 0) {
            _position_cluster(r, b, target, start, i, adjust);
            start = i;
        }
        i = i + 1;
    }
    _position_cluster(r, b, target, start, b.len, adjust);
}
