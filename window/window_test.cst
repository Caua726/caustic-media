// window/window_test.cst — tests for the portable window layer.

use "std/io.cst" as io;
use "window.cst" as window;
use "native.cst" as native;
use "../gpu/software/target.cst" as tgt;
use "x11/x11.cst" as x11;
use "x11/bind/x.cst" as x;
use "x11/bind/xlib.cst" as xlib;
use "x11/bind/xevent.cst" as xev;
use "std/time.cst" as time;
use "event.cst" as event;

fn test_static() as i32 {
    if (window.AUTO != cast(i32, 0 - 1)) { return 1; }
    if (window.X11 != 0) { return 2; }
    if (window.WAYLAND != 1) { return 3; }
    if (window.KMS != 2) { return 4; }
    if (window.WIN32 != 3) { return 5; }

    if (window.available(window.X11) != 1) { return 6; }

    let is window.device.Config as c = window.config("test", 640, 480);
    if (c.width != 640 || c.height != 480) { return 7; }
    if (c.resizable != 1) { return 8; }

    let is window.device.Config as cf = window.config_fixed("test", 320, 240);
    if (cf.width != 320 || cf.height != 240) { return 9; }
    if (cf.resizable != 0) { return 10; }

    return 0;
}

fn test_functional() as i32 {
    let is window.device.Window as w = window.open("portable test", 320, 240);
    if (window.is_open(&w) == 0) {
        io.printf("FAIL: window.open returned non-open window\n");
        return 1;
    }

    if (window.width(&w) <= 0 || window.height(&w) <= 0) {
        io.printf("FAIL: invalid window dimensions\n");
        window.close(&w);
        return 2;
    }

    // Check native handles
    if (cast(i64, native.x11_display(&w)) == 0) {
        io.printf("FAIL: native x11_display is null\n");
        window.close(&w);
        return 3;
    }

    if (native.x11_xid(&w) == 0) {
        io.printf("FAIL: native x11_xid is zero\n");
        window.close(&w);
        return 4;
    }

    // Advance one frame
    if (window.next_frame(&w) != 1) {
        io.printf("FAIL: next_frame returned 0\n");
        window.close(&w);
        return 5;
    }

    let is tgt.Target as t = window.acquire(&w);
    if (t.width <= 0 || t.height <= 0 || cast(i64, t.color) == 0) {
        io.printf("FAIL: acquire returned invalid target\n");
        window.close(&w);
        return 6;
    }

    window.submit(&w);
    window.close(&w);

    if (window.is_open(&w) != 0) {
        io.printf("FAIL: window still open after close\n");
        return 7;
    }

    return 0;
}

// A dialog: owned by another window, of the dialog type, modal — what the
// platform's window says of it.
fn test_dialog() as i32 {
    let is window.device.Config as plain = window.config("plain", 100, 80);
    if (cast(i64, plain.owner) != 0 || plain.dialog != 0 || plain.modal != 0) { return 1; }
    let is window.device.Window as owner = window.open("owner", 200, 150);
    let is window.device.Config as c with mut = window.config("dialog", 120, 90);
    c.owner = &owner;
    c.dialog = 1;
    c.modal = 1;
    let is window.device.Window as d = window.open_config(&c);
    if (window.is_open(&d) == 0) { return 2; }
    if (x11.transient_for(&d.x11_win) != native.x11_xid(&owner)) { return 3; }
    if (x11.modal(&d.x11_win) != 1) { return 4; }
    if (x11.transient_for(&owner.x11_win) != 0 || x11.modal(&owner.x11_win) != 0) { return 5; }
    if (window.set_modal(&d, 0) != 1 || x11.modal(&d.x11_win) != 0) { return 6; }
    if (window.set_modal(&d, 1) != 1 || x11.modal(&d.x11_win) != 1) { return 7; }
    window.close(&d);
    if (window.set_modal(&d, 0) != 0) { return 8; }
    window.close(&owner);
    return 0;
}

// Something dragged over the window from another program: heard as events,
// answered, its text read — the X11 conversation itself is dnd_test's.
let is xev.XEvent as _msg;
let is xev.XEvent as _in;

fn tell(d as *u8, to as i64, t as i64, from as i64, d1 as i64, d2 as i64, d3 as i64) as void {
    xev.clear(&_msg);
    let is *xev.XClientMessageEvent as c = xev.client(&_msg);
    c.kind = x.ClientMessage;
    c.send_event = 1;
    c.window = to;
    c.message_type = t;
    c.format = 32;
    c.data[0] = from;
    c.data[1] = d1;
    c.data[2] = d2;
    c.data[3] = d3;
    c.data[4] = 0;
    xlib.XSendEvent(d, to, 0, 0, cast(*u8, &_msg));
    xlib.XFlush(d);
}

let is [8]event.Event as heard;
let is i64 as nheard with mut = 0;

// Both sides pumped for ms; the source answers a request for the selection
// with text.
fn both(w as *window.device.Window, sd as *u8, ms as i64) as void {
    let is i64 as deadline = time.now_ns() + ms * 1000000;
    while (time.now_ns() < deadline) {
        window.next_frame(w);
        let is event.Event as e;
        while (window.poll_event(w, &e) == 1) {
            if (e.kind >= event.DND_ENTER && e.kind <= event.DND_DROP && nheard < 8) {
                heard[nheard] = e;
                nheard = nheard + 1;
            }
        }
        while (xlib.XPending(sd) > 0) {
            xlib.XNextEvent(sd, cast(*u8, &_in));
            if (xev.kind(&_in) == x.SelectionRequest) {
                let is *xev.XSelectionRequestEvent as r = xev.selection_request(&_in);
                if (r.target == xlib.XInternAtom(sd, "text/uri-list", 0)) {
                    xlib.XChangeProperty(sd, r.requestor, r.property, r.target, 8, x.PropModeReplace, "file:///tmp/f\r\n", 15);
                } else {
                    xlib.XChangeProperty(sd, r.requestor, r.property, r.target, 8, x.PropModeReplace, "dropped", 7);
                }
                xev.clear(&_msg);
                let is *xev.XSelectionEvent as sn = xev.selection(&_msg);
                sn.kind = x.SelectionNotify;
                sn.requestor = r.requestor;
                sn.selection = r.selection;
                sn.target = r.target;
                sn.property = r.property;
                sn.time = r.time;
                xlib.XSendEvent(sd, r.requestor, 0, 0, cast(*u8, &_msg));
                xlib.XFlush(sd);
            }
        }
        time.sleep_ms(2);
    }
}

fn test_drop() as i32 {
    let is window.device.Window as w = window.open("drop", 200, 150);
    let is i64 as k with mut = 0;
    while (k < 8) { window.next_frame(&w); k = k + 1; }
    let is *u8 as sd = xlib.XOpenDisplay(cast(*u8, 0));
    let is i64 as src = xlib.XCreateSimpleWindow(sd, xlib.XDefaultRootWindow(sd), 0, 0, 1, 1, 0, 0, 0);
    xlib.XSetSelectionOwner(sd, xlib.XInternAtom(sd, "XdndSelection", 0), src, 0);
    let is i64 as to = native.x11_xid(&w);
    if (window.drop_answer(&w, window.DROP_TEXT) != 0) { return 1; }
    tell(sd, to, xlib.XInternAtom(sd, "XdndEnter", 0), src, 5 << 24, xlib.XInternAtom(sd, "UTF8_STRING", 0), 0);
    tell(sd, to, xlib.XInternAtom(sd, "XdndPosition", 0), src, 0, (12 << 16) | 34, 0);
    both(&w, sd, 300);
    if (nheard < 2 || heard[0].kind != event.DND_ENTER || heard[0].drop != window.DROP_TEXT) { return 2; }
    if (heard[1].kind != event.DND_MOVE || heard[1].x != 12 || heard[1].y != 34) { return 3; }
    if (window.drop_answer(&w, window.DROP_TEXT) != 1) { return 4; }
    tell(sd, to, xlib.XInternAtom(sd, "XdndDrop", 0), src, 0, 0, 0);
    both(&w, sd, 500);
    if (nheard < 3 || heard[2].kind != event.DND_DROP || heard[2].drop != window.DROP_TEXT) { return 5; }
    let is *u8 as got = window.dropped_text(&w);
    if (window.dropped_text_length(&w) != 7 || cast(i64, got) == 0 || got[0] != 100 || got[6] != 100) { return 6; }
    if (window.dropped_files(&w) != 0 || cast(i64, window.dropped_file(&w, 0)) != 0) { return 7; }
    window.clear_drop(&w);
    if (window.dropped_text_length(&w) != 0) { return 8; }
    tell(sd, to, xlib.XInternAtom(sd, "XdndEnter", 0), src, 5 << 24, xlib.XInternAtom(sd, "UTF8_STRING", 0), 0);
    tell(sd, to, xlib.XInternAtom(sd, "XdndLeave", 0), src, 0, 0, 0);
    both(&w, sd, 300);
    if (nheard < 5 || heard[4].kind != event.DND_LEAVE) { return 9; }
    // Files.
    tell(sd, to, xlib.XInternAtom(sd, "XdndEnter", 0), src, 5 << 24, xlib.XInternAtom(sd, "text/uri-list", 0), 0);
    tell(sd, to, xlib.XInternAtom(sd, "XdndPosition", 0), src, 0, (12 << 16) | 34, 0);
    both(&w, sd, 300);
    tell(sd, to, xlib.XInternAtom(sd, "XdndDrop", 0), src, 0, 0, 0);
    both(&w, sd, 500);
    let is *u8 as f = window.dropped_file(&w, 0);
    if (window.dropped_files(&w) != 1 || cast(i64, f) == 0 || f[0] != 47 || f[4] != 47 || f[5] != 102 || f[6] != 0) { return 11; }
    xlib.XDestroyWindow(sd, src);
    xlib.XCloseDisplay(sd);
    window.close(&w);
    if (window.drop_answer(&w, 0) != 0 || window.dropped_text_length(&w) != 0) { return 10; }
    if (window.dropped_files(&w) != 0 || cast(i64, window.dropped_file(&w, 0)) != 0 ||
        cast(i64, window.dropped_text(&w)) != 0) { return 12; }
    window.clear_drop(&w);
    return 0;
}

fn main() as i32 {
    let is i32 as stat = test_static();
    if (stat != 0) {
        io.printf("FAIL: static checks failed with code %d\n", stat);
        return 1;
    }

    // Functional test under X11 / Xvfb
    let is i32 as func = test_functional();
    if (func != 0) {
        io.printf("FAIL: functional checks failed with code %d\n", func);
        return 2;
    }

    let is i32 as dlg = test_dialog();
    if (dlg != 0) {
        io.printf("FAIL: dialog checks failed with code %d\n", dlg);
        return 3;
    }

    let is i32 as dropt = test_drop();
    if (dropt != 0) {
        io.printf("FAIL: drop checks failed with code %d\n", dropt);
        return 4;
    }

    io.printf("portable window layer: all checks passed\n");
    return 0;
}
