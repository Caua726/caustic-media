// window/window_test.cst — tests for the portable window layer.

use "std/io.cst" as io;
use "window.cst" as window;
use "native.cst" as native;
use "../gpu/software/target.cst" as tgt;
use "x11/x11.cst" as x11;

fn test_static() as i32 {
    if (window.AUTO != cast(i32, 0 - 1)) { return 1; }
    if (window.X11 != 0) { return 2; }
    if (window.WAYLAND != 1) { return 3; }
    if (window.KMS != 2) { return 4; }
    if (window.WIN32 != 3) { return 5; }

    if (window.available(window.X11) != 1) { return 6; }

    let is window.device.Config as c = window.config("test", 640, 480);
    if (c.width != 640 || c.height != 480) { return 7; }
    if (c.resizable != 1) { return 8; }

    let is window.device.Config as cf = window.config_fixed("test", 320, 240);
    if (cf.width != 320 || cf.height != 240) { return 9; }
    if (cf.resizable != 0) { return 10; }

    return 0;
}

fn test_functional() as i32 {
    let is window.device.Window as w = window.open("portable test", 320, 240);
    if (window.is_open(&w) == 0) {
        io.printf("FAIL: window.open returned non-open window\n");
        return 1;
    }

    if (window.width(&w) <= 0 || window.height(&w) <= 0) {
        io.printf("FAIL: invalid window dimensions\n");
        window.close(&w);
        return 2;
    }

    // Check native handles
    if (cast(i64, native.x11_display(&w)) == 0) {
        io.printf("FAIL: native x11_display is null\n");
        window.close(&w);
        return 3;
    }

    if (native.x11_xid(&w) == 0) {
        io.printf("FAIL: native x11_xid is zero\n");
        window.close(&w);
        return 4;
    }

    // Advance one frame
    if (window.next_frame(&w) != 1) {
        io.printf("FAIL: next_frame returned 0\n");
        window.close(&w);
        return 5;
    }

    let is tgt.Target as t = window.acquire(&w);
    if (t.width <= 0 || t.height <= 0 || cast(i64, t.color) == 0) {
        io.printf("FAIL: acquire returned invalid target\n");
        window.close(&w);
        return 6;
    }

    window.submit(&w);
    window.close(&w);

    if (window.is_open(&w) != 0) {
        io.printf("FAIL: window still open after close\n");
        return 7;
    }

    return 0;
}

// A dialog: owned by another window, of the dialog type, modal — what the
// platform's window says of it.
fn test_dialog() as i32 {
    let is window.device.Config as plain = window.config("plain", 100, 80);
    if (cast(i64, plain.owner) != 0 || plain.dialog != 0 || plain.modal != 0) { return 1; }
    let is window.device.Window as owner = window.open("owner", 200, 150);
    let is window.device.Config as c with mut = window.config("dialog", 120, 90);
    c.owner = &owner;
    c.dialog = 1;
    c.modal = 1;
    let is window.device.Window as d = window.open_config(&c);
    if (window.is_open(&d) == 0) { return 2; }
    if (x11.transient_for(&d.x11_win) != native.x11_xid(&owner)) { return 3; }
    if (x11.modal(&d.x11_win) != 1) { return 4; }
    if (x11.transient_for(&owner.x11_win) != 0 || x11.modal(&owner.x11_win) != 0) { return 5; }
    if (window.set_modal(&d, 0) != 1 || x11.modal(&d.x11_win) != 0) { return 6; }
    if (window.set_modal(&d, 1) != 1 || x11.modal(&d.x11_win) != 1) { return 7; }
    window.close(&d);
    if (window.set_modal(&d, 0) != 0) { return 8; }
    window.close(&owner);
    return 0;
}

fn main() as i32 {
    let is i32 as stat = test_static();
    if (stat != 0) {
        io.printf("FAIL: static checks failed with code %d\n", stat);
        return 1;
    }

    // Functional test under X11 / Xvfb
    let is i32 as func = test_functional();
    if (func != 0) {
        io.printf("FAIL: functional checks failed with code %d\n", func);
        return 2;
    }

    let is i32 as dlg = test_dialog();
    if (dlg != 0) {
        io.printf("FAIL: dialog checks failed with code %d\n", dlg);
        return 3;
    }

    io.printf("portable window layer: all checks passed\n");
    return 0;
}
