// window/transparent_win32_test.cst — a Windows window seen through where
// its alpha says, as a compositor blends it. Wine's Wayland driver presents
// it to a Weston nested in Xvfb, whose desktop is blue; win32/tools/
// alpha_check reads the screen back, then writes the file this waits for:
//   env CAUSTIC_WINE_GRAPHICS=wayland WESTON_CONFIG=window/win32/testdata/blue-desktop.ini \
//       sh tools/wine_session.sh sh window/win32/tools/run_alpha.sh
// The window: an opaque green square, half-seen red (its colour premultiplied
// by its alpha) to its right, clear further right. alpha_check finds the
// green square and wants the red blended over the blue, and the blue itself
// through the clear part.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/time.cst" as time;
use "device.cst" as device;
use "../gpu/software/target.cst" as tgt;
use "win32/bind/types.cst" as t;
use "win32/bind/kernel32.cst" as k;

// Colours as the software target packs them: 0xAABBGGRR, premultiplied.
let is u32 as GREEN    with imut = 4278255360;   // 0xFF00FF00
let is u32 as HALF_RED with imut = 2147483776;   // 0x80000080

fn main() as i32 {
    let is *u8 as done = env.getenv("CAUSTIC_ALPHA_DONE");
    if (cast(i64, done) == 0 || done[0] == 0) { io.printf("FAIL: CAUSTIC_ALPHA_DONE not set\n"); return 1; }
    let is [520]u16 as done_w;
    if (k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, done), cast(i32, 0 - 1), &done_w[0], 520) <= 0) {
        io.printf("FAIL: no Windows path\n");
        return 1;
    }
    let is device.Config as c with mut = device.config("seen through", 240, 120);
    c.decorated = 0;
    c.transparent = 1;
    let is device.Window as w = device.open_config(&c);
    if (device.is_open(&w) == 0) { io.printf("FAIL: no window\n"); return 1; }
    if (device.transparent(&w) == 0) { io.printf("FAIL: not seen through\n"); return 1; }
    device.next_frame(&w);
    let is tgt.Target as f = device.acquire(&w);
    if (cast(i64, f.color) == 0) { io.printf("FAIL: no frame\n"); return 1; }
    let is i64 as y with mut = 0;
    while (y < f.height) {
        let is i64 as x with mut = 0;
        while (x < f.width) {
            let is u32 as v with mut = cast(u32, 0);
            if (x < 160) { v = HALF_RED; }
            if (x >= 20 && x < 40 && y >= 20 && y < 40) { v = GREEN; }
            tgt.put(&f, x, y, v);
            x = x + 1;
        }
        y = y + 1;
    }
    device.submit(&w);
    // Up until the screen has been read, or a minute.
    let is i64 as until = time.now_ms() + 60000;
    while (k.GetFileAttributesW(&done_w[0]) == cast(u32, 4294967295) && time.now_ms() < until) {
        device.pump(&w);
        time.sleep_ms(20);
    }
    device.close(&w);
    return 0;
}
