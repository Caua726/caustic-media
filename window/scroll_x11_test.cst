// window/scroll_x11_test.cst — the pointer on X with smooth scrolling on
// (XI 2.1, x11/xinput.cst), from XTest:
//   sh window/x11/tools/run_headless.sh ./build/scroll_x11_test
// The window takes XI_Motion instead of MotionNotify: the pointer's motion
// still said, at its place, from XI2's reports; XTest's pointer has no scroll
// valuators, so its buttons 4–7 are a wheel's notches as ever and are not
// taken for an emulation; the device behind them learned once. Scroll
// valuators themselves need a device that has them (smooth_test reads them
// as the server reports them).
use "std/io.cst" as io;
use "std/time.cst" as time;
use "std/env.cst" as env;
use "device.cst" as device;
use "../input/event.cst" as ie;
use "../gpu/software/target.cst" as tgt;
use "x11/bind/xlib.cst" as xlib;
use "x11/xinput.cst" as xinput;
use "x11/window.cst" as xwindow;
use "x11/smooth.cst" as smooth;

extern "libXtst.so.6" fn XTestFakeButtonEvent(display as *u8, button as u32, is_press as i32, delay as u64) as i32;
extern "libXtst.so.6" fn XTestFakeMotionEvent(display as *u8, screen as i32, x as i32, y as i32, delay as u64) as i32;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is device.Window as win with mut;
let is *u8 as xd with mut;

fn settle(ms as i64) as void {
    let is i64 as until = time.now_ms() + ms;
    while (time.now_ms() < until) {
        device.pump(&win);
        time.sleep_ms(5);
    }
}

// The first input of kind within two seconds, into out: 1, or 0 for none.
fn next(kind as i32, out as *ie.Event) as i32 {
    let is i64 as until = time.now_ms() + 2000;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_input(&win, out) == 1) {
            if (out.kind == kind) { return 1; }
        }
        time.sleep_ms(5);
    }
    return 0;
}

fn drain() as void {
    let is ie.Event as e;
    settle(100);
    while (device.poll_input(&win, &e) == 1) { }
}

fn click(b as u32) as void {
    drain();
    XTestFakeButtonEvent(xd, b, 1, cast(u64, 0));
    XTestFakeButtonEvent(xd, b, 0, cast(u64, 0));
    xlib.XFlush(xd);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    win = device.open("smooth", 300, 200);
    if (device.is_open(&win) == 0 || win.backend != device.X11) {
        io.printf("FAIL: no X11 window\n");
        return 1;
    }
    device.next_frame(&win);
    let is tgt.Target as t = device.acquire(&win);
    if (cast(i64, t.color) != 0) { device.submit(&win); }
    settle(200);
    check("smooth scrolling on: XI 2.1 spoken", xinput.smooth_scrolling(&win.x11_win) == 1);
    xd = xlib.XOpenDisplay(cast(*u8, 0));
    if (cast(i64, xd) == 0) { io.printf("FAIL: no X display to send input through\n"); return 1; }
    let is i32 as wx with mut = 0;
    let is i32 as wy with mut = 0;
    let is i64 as child with mut = 0;
    xlib.XTranslateCoordinates(xd, xwindow.xid(&win.x11_win), xlib.XDefaultRootWindow(xd), 0, 0,
                               cast(*u8, &wx), cast(*u8, &wy), cast(*u8, &child));
    drain();
    let is ie.Event as e;
    XTestFakeMotionEvent(xd, 0 - 1, wx + 30, wy + 40, cast(u64, 0));
    xlib.XFlush(xd);
    check("the pointer moved over it: said, at its place", next(ie.MOTION, &e) == 1 && e.x == 30 && e.y == 40);
    XTestFakeMotionEvent(xd, 0 - 1, wx + 31, wy + 44, cast(u64, 0));
    xlib.XFlush(xd);
    check("and again", next(ie.MOTION, &e) == 1 && e.x == 31 && e.y == 44);
    click(5);
    check("XTest's wheel down: a notch, not an emulation", next(ie.SCROLL, &e) == 1 && e.source == ie.SCROLL_WHEEL &&
          e.dy == 1.0 && e.steps_y == 1 && e.x == 31 && e.y == 44);
    click(4);
    check("up", next(ie.SCROLL, &e) == 1 && e.dy == 0.0 - 1.0);
    click(7);
    check("right", next(ie.SCROLL, &e) == 1 && e.dx == 1.0 && e.steps_x == 1);
    check("the device behind XTest's pointer learned: no scroll axes",
          smooth.knows(xwindow.smooth_state(), 0 - 1) == 0 && xwindow.smooth_state().ndevices >= 1);
    // A press still a press, at its place, released.
    click(1);
    check("a button: down", next(ie.BUTTON_DOWN, &e) == 1 && e.button == 1 && e.x == 31 && e.y == 44);
    check("and up", next(ie.BUTTON_UP, &e) == 1);
    device.close(&win);
    if (fails != 0) {
        io.printf("scroll x11: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("scroll x11: all checks passed\n");
    return 0;
}
