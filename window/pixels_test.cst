// window/pixels.to_bgra against the conversion one pixel and one byte at a
// time that the X11 and Wayland surfaces each did before: every alpha, odd
// and even counts, rows starting off an eight-byte boundary.
use "std/io.cst" as io;
use "pixels.cst" as pixels;
use "../gpu/bgra.cst" as bgra;

let is i32 as fails with mut = 0;
fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { io.printf("FAIL: %s\n", name); fails = fails + 1; }
}

let is [4100]u8 as got with mut;
let is [4100]u8 as want with mut;

// Wayland's _to_argb as it was: bytes, divided.
fn reference(p as *u8, n as i64, premultiply as i32) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is *u8 as q = cast(*u8, cast(i64, p) + i * 4);
        let is i64 as a = cast(i64, q[3]);
        let is i64 as r with mut = cast(i64, q[0]);
        let is i64 as g with mut = cast(i64, q[1]);
        let is i64 as b with mut = cast(i64, q[2]);
        if (premultiply == 1 && a < 255) {
            r = (r * a + 127) / 255;
            g = (g * a + 127) / 255;
            b = (b * a + 127) / 255;
        }
        q[0] = cast(u8, b); q[1] = cast(u8, g); q[2] = cast(u8, r);
        i = i + 1;
    }
}

let is i64 as seed with mut = 12345;
fn rnd() as i64 {
    seed = (seed * 6364136223846793005 + 1442695040888963407);
    return (seed >> 33) & 255;
}

// n pixels from byte offset off, alpha chosen by mode: 0 every value in turn,
// 1 opaque, 2 opaque with a translucent pixel every seventh.
fn round(n as i64, off as i64, mode as i32, premultiply as i32) as i32 {
    let is i64 as i with mut = 0;
    while (i < 4100) { got[i] = cast(u8, rnd()); want[i] = got[i]; i = i + 1; }
    i = 0;
    while (i < n) {
        let is i64 as a with mut = (i * 37) & 255;
        if (mode >= 1) { a = 255; }
        if (mode == 2 && i % 7 == 3) { a = (i * 11) & 255; }
        got[off + i * 4 + 3] = cast(u8, a);
        want[off + i * 4 + 3] = cast(u8, a);
        i = i + 1;
    }
    pixels.to_bgra(cast(i64, &got) + off, n, premultiply);
    reference(cast(*u8, cast(i64, &want) + off), n, premultiply);
    i = 0;
    while (i < 4100) {
        if (got[i] != want[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() as i32 {
    let is i32 as ok with mut = 1;
    let is i64 as n with mut = 0;
    while (n < 1000) {
        let is i32 as mode with mut = 0;
        while (mode < 3) {
            ok = ok & round(n, 4, mode, 1) & round(n, 8, mode, 1) & round(n, 4, mode, 0) & round(n, 0, mode, 0);
            mode = mode + 1;
        }
        n = n + 37;
    }
    check("the same bytes as one pixel at a time, every alpha, any count and start", ok);
    // Every channel and alpha: a product's rounding.
    let is i32 as all with mut = 1;
    let is i64 as a with mut = 0;
    while (a < 256) {
        let is i64 as c with mut = 0;
        while (c < 256) {
            got[0] = cast(u8, c); got[1] = cast(u8, c); got[2] = cast(u8, 255 - c); got[3] = cast(u8, a);
            got[4] = cast(u8, 255); got[5] = 0; got[6] = 0; got[7] = 255;
            want[0] = got[0]; want[1] = got[1]; want[2] = got[2]; want[3] = got[3];
            want[4] = got[4]; want[5] = 0; want[6] = 0; want[7] = 255;
            pixels.to_bgra(cast(i64, &got), 2, 1);
            reference(cast(*u8, &want), 2, 1);
            let is i64 as k with mut = 0;
            while (k < 8) { if (got[k] != want[k]) { all = 0; } k = k + 1; }
            c = c + 1;
        }
        a = a + 1;
    }
    check("every channel at every alpha, beside an opaque pixel", all);
    // And the other way round: the opaque one first, in the pair's low half.
    all = 1;
    a = 0;
    while (a < 256) {
        let is i64 as c with mut = 0;
        while (c < 256) {
            got[4] = cast(u8, 255 - c); got[5] = cast(u8, c); got[6] = cast(u8, c); got[7] = cast(u8, a);
            got[0] = 0; got[1] = cast(u8, 255); got[2] = 0; got[3] = cast(u8, 255);
            let is i64 as k with mut = 0;
            while (k < 8) { want[k] = got[k]; k = k + 1; }
            pixels.to_bgra(cast(i64, &got), 2, 1);
            reference(cast(*u8, &want), 2, 1);
            k = 0;
            while (k < 8) { if (got[k] != want[k]) { all = 0; } k = k + 1; }
            c = c + 1;
        }
        a = a + 1;
    }
    check("every channel at every alpha, after an opaque pixel", all);
    // Pixels already in BGRA order (a BGRA8 texture's), only premultiplied:
    // what converting their RGBA selves gives, every channel at every alpha,
    // three to a call (a pair and the odd one).
    all = 1;
    a = 0;
    while (a < 256) {
        let is i64 as c with mut = 0;
        while (c < 256) {
            let is [3]i32 as rgba;
            let is [3]i32 as bgr;
            let is [3]i32 as want3;
            let is [3]i32 as got3;
            let is i64 as j with mut = 0;
            while (j < 3) {
                let is i64 as r = (c + j * 85) & 255;
                let is i64 as g = (c * 7 + j) & 255;
                let is i64 as b = 255 - c;
                let is i64 as al with mut = a;
                if (j == 1) { al = (a + 128) & 255; }
                rgba[j] = cast(i32, (al << 24) | (b << 16) | (g << 8) | r);
                bgr[j] = cast(i32, (al << 24) | (r << 16) | (g << 8) | b);
                j = j + 1;
            }
            bgra.convert(cast(i64, &want3), cast(i64, &rgba), 3, 1);
            bgra.premultiply(cast(i64, &got3), cast(i64, &bgr), 3);
            j = 0;
            while (j < 3) { if (got3[j] != want3[j]) { all = 0; } j = j + 1; }
            c = c + 1;
        }
        a = a + 1;
    }
    check("BGRA pixels premultiplied where they are: as RGBA ones converted", all);
    if (fails == 0) {
        io.printf("window pixels: all checks passed\n");
        return 0;
    }
    io.printf("window pixels: %d failures\n", fails);
    return 1;
}
