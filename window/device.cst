// window/device.cst — the portable window device.
//
// Backends:
//   X11      Linux / BSD via libX11 and MIT-SHM
//   WAYLAND  Linux, the compositor's socket spoken directly
//   KMS      Linux console / DRM direct (designed)
//   WIN32    Windows user32 / gdi32
//
// The interface is pull:
//
//   let is window.device.Window as w = window.open("title", 1280, 720);
//   while (window.next_frame(&w) == 1) {
//       let is tgt.Target as t = window.acquire(&w);
//       if (t.width == 0) { continue; }
//       // draw into t
//       window.submit(&w);
//   }
//   window.close(&w);
//
// Every operation dispatches on the target's operating system first — a
// constant the compiler folds — and only then on the window's backend, so a
// Linux program carries no Win32 import and a Windows one no libX11 or
// Linux system call.

use "../gpu/software/target.cst" as tgt;
use "../gpu/swapchain.cst" as swapchain;
use "x11/x11.cst" as x11;
use "wayland/backend.cst" as wayland;
use "win32/backend.cst" as win32;
use "std/os.cst" as os;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "event.cst" as event;
use "../input/event.cst" as ie;
use "settings.cst" as settings;
use "linux/gtk_ini.cst" as gtk_ini;
use "locale.cst" as locale;
use "positioner.cst" as positioner;
use "../math/math.cst" as math;

// --- Backends ---

let is i32 as AUTO    with imut = cast(i32, 0 - 1);
let is i32 as X11     with imut = 0;
let is i32 as WAYLAND with imut = 1;
let is i32 as KMS     with imut = 2;
let is i32 as WIN32   with imut = 3;

fn backend_name(id as i32) as *u8 {
    if (id == AUTO)    { return "auto"; }
    if (id == X11)     { return "x11"; }
    if (id == WAYLAND) { return "wayland"; }
    if (id == KMS)     { return "kms"; }
    if (id == WIN32)   { return "win32"; }
    return "unknown";
}

fn available(id as i32) as i32 {
    if (os.current() == os.OS_LINUX && (id == X11 || id == WAYLAND)) { return 1; }
    if (os.current() == os.OS_WINDOWS && id == WIN32) { return 1; }
    return 0;
}

// --- Errors ---

let is i32 as OK           with imut = 0;
let is i32 as NO_BACKEND   with imut = 1;
let is i32 as NO_DISPLAY   with imut = 2;
let is i32 as NO_VISUAL    with imut = 3;
let is i32 as NO_WINDOW    with imut = 4;
let is i32 as NO_GC        with imut = 5;
let is i32 as NO_MEMORY    with imut = 6;
let is i32 as NO_SURFACE   with imut = 7;
let is i32 as BAD_ARGUMENT with imut = 8;
let is i32 as CLOSED       with imut = 9;

fn error_name(code as i32) as *u8 {
    if (code == OK)           { return "ok"; }
    if (code == NO_BACKEND)   { return "no backend available"; }
    if (code == NO_DISPLAY)   { return "no display (is DISPLAY set?)"; }
    if (code == NO_VISUAL)    { return "no truecolor visual"; }
    if (code == NO_WINDOW)    { return "could not create the window"; }
    if (code == NO_GC)        { return "could not create a graphics context"; }
    if (code == NO_MEMORY)    { return "out of memory"; }
    if (code == NO_SURFACE)   { return "could not create the framebuffer"; }
    if (code == BAD_ARGUMENT) { return "bad argument"; }
    if (code == CLOSED)       { return "window is closed"; }
    return "unknown error";
}

// --- Config ---

struct Config {
    title      as *u8;
    // The application's identity: WM_CLASS on X11, app_id on Wayland, the
    // process's AppUserModelID on Windows.
    class_name as *u8;
    width      as i64;
    height     as i64;
    resizable  as i32;
    backend    as i32;
    // A dialog: the window it belongs to (kept above it, no taskbar entry of
    // its own), null for none; placed and decorated as a dialog; modal, its
    // owner taking no input while it is up. On X11 all three are on the window
    // before it is first mapped.
    owner      as *Window;
    dialog     as i32;
    modal      as i32;
    // Drawn to be seen through where it leaves alpha 0 — the shadow round a
    // frame of the program's own — when the platform has pixels with alpha.
    transparent as i32;
    // The platform's own title bar and borders round it; 0 for a window that
    // draws its own frame, told before it is first mapped.
    decorated   as i32;
    // A popup — POPUP_MENU, POPUP_LIST, POPUP_TOOLTIP; 0 for a window — over
    // owner, which it must have: undecorated, in no taskbar, never placed by
    // the program at a point of the screen but by place against a rectangle
    // of the owner's client, physical pixels (place's own size is width and
    // height). grab 1: it takes the pointer and the keyboard while it is up,
    // and a press outside the program's popups takes it down (POPUP_DONE).
    popup       as i32;
    grab        as i32;
    place       as positioner.Positioner;
}

let is i32 as POPUP_MENU    with imut = 1;
let is i32 as POPUP_LIST    with imut = 2;
let is i32 as POPUP_TOOLTIP with imut = 3;

fn config(title as *u8, width as i64, height as i64) as Config {
    let is Config as c;
    c.title = title;
    c.class_name = cast(*u8, 0);
    c.width = width;
    c.height = height;
    c.resizable = 1;
    c.backend = AUTO;
    c.owner = cast(*Window, 0);
    c.dialog = 0;
    c.modal = 0;
    c.transparent = 0;
    c.decorated = 1;
    c.popup = 0;
    c.grab = 0;
    c.place = positioner.make(0.0, 0.0, math.rect.rect_zero());
    return c;
}

fn config_fixed(title as *u8, width as i64, height as i64) as Config {
    let is Config as c = config(title, width, height);
    c.resizable = 0;
    return c;
}

// --- Portable Window Struct ---

struct Window {
    backend as i32;
    ok      as i32;
    err     as i32;
    transparent as i32;
    x11_win     as x11.window.Window;
    wayland_win as *wayland.Window;
    win32_win   as win32.Window;
    // A popup's kind, 0 for a window; where it was put, relative to its
    // owner's client; and its owner, kept where the program keeps it.
    popup       as i32;
    _pad0       as i32;
    popup_x     as i64;
    popup_y     as i64;
    popup_owner as *Window;
}

// The owner's client on the screen and the room a popup has there, both in
// screen pixels: x11 the root, Win32 the monitor's work area. 1 when known.
fn _room(owner as *Window, ox as *i64, oy as *i64, room as *math.rect.Rect) as i32 {
    if (owner.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX && owner.backend == X11) {
        let is i64 as sw with mut = 0;
        let is i64 as sh with mut = 0;
        if (x11.position(&owner.x11_win, ox, oy) == 0 || x11.screen_size(&owner.x11_win, &sw, &sh) == 0) { return 0; }
        *room = math.rect.rect(0.0, 0.0, cast(f64, sw), cast(f64, sh));
        return 1;
    }
    if (os.current() == os.OS_WINDOWS && owner.backend == WIN32) {
        let is i64 as l with mut = 0; let is i64 as t with mut = 0;
        let is i64 as r with mut = 0; let is i64 as b with mut = 0;
        if (win32.popup_room(&owner.win32_win, ox, oy, &l, &t, &r, &b) == 0) { return 0; }
        *room = math.rect.rect(cast(f64, l), cast(f64, t), cast(f64, r - l), cast(f64, b - t));
        return 1;
    }
    return 0;
}

// Where place puts a popup of width by height over owner, relative to the
// owner's client, and the owner's client on the screen: the positioner kept
// within the room the owner has. 1 when it could be placed.
fn _placed(owner as *Window, place as *positioner.Positioner, width as i64, height as i64,
           out as *math.rect.Rect, ox as *i64, oy as *i64) as i32 {
    let is math.rect.Rect as room;
    if (_room(owner, ox, oy, &room) == 0) { return 0; }
    let is positioner.Positioner as p with mut = *place;
    p.w = cast(f64, width);
    p.h = cast(f64, height);
    let is math.rect.Rect as bounds = math.rect.rect(room.x - cast(f64, *ox), room.y - cast(f64, *oy), room.w, room.h);
    *out = positioner.place(&p, bounds);
    return 1;
}

// --- Opening and Lifecycle ---

fn _open_win32(w as *Window, c as *Config) as void {
    let is win32.Config as wc with mut = win32.config(c.title, c.width, c.height);
    wc.resizable = c.resizable;
    wc.dialog = c.dialog;
    wc.modal = c.modal;
    wc.decorated = c.decorated;
    wc.transparent = c.transparent;
    wc.app_id = c.class_name;
    if (cast(i64, c.owner) != 0 && c.owner.backend == WIN32 && c.owner.ok == 1) {
        wc.owner = win32.hwnd(&c.owner.win32_win);
    }
    if (c.popup != 0) {
        let is math.rect.Rect as at;
        let is i64 as ox with mut = 0;
        let is i64 as oy with mut = 0;
        if (wc.owner == 0 || _placed(c.owner, &c.place, c.width, c.height, &at, &ox, &oy) == 0) {
            w.ok = 0; w.err = BAD_ARGUMENT;
            return;
        }
        wc.popup = c.popup;
        wc.grab = c.grab;
        wc.x = ox + cast(i64, at.x);
        wc.y = oy + cast(i64, at.y);
        wc.width = cast(i64, at.w);
        wc.height = cast(i64, at.h);
        w.popup_x = cast(i64, at.x);
        w.popup_y = cast(i64, at.y);
    }
    w.win32_win = win32.open_config(&wc);
    w.ok = w.win32_win.ok;
    let is i32 as e = w.win32_win.err;
    if (e == win32.OK) { w.err = OK; }
    else if (e == win32.NO_MEMORY) { w.err = NO_MEMORY; }
    else if (e == win32.NO_SURFACE) { w.err = NO_SURFACE; }
    else if (e == win32.BAD_ARGUMENT) { w.err = BAD_ARGUMENT; }
    else { w.err = NO_WINDOW; }
}

fn open_config(c as *Config) as Window {
    let is Window as w;
    w.backend = c.backend;
    w.transparent = c.transparent;
    w.popup = c.popup; w._pad0 = 0; w.popup_x = 0; w.popup_y = 0; w.popup_owner = c.owner;
    w.wayland_win = cast(*wayland.Window, 0);
    if (w.backend == AUTO) {
        if (os.current() == os.OS_WINDOWS) {
            w.backend = WIN32;
        } else {
            let is *u8 as display = env.getenv("WAYLAND_DISPLAY");
            if (cast(i64, display) != 0 && display[0] != 0) { w.backend = WAYLAND; }
            else { w.backend = X11; }
        }
    }
    if (os.current() == os.OS_LINUX && w.backend == X11) {
        let is x11.window.Config as xc with mut;
        if (c.resizable == 0) {
            xc = x11.config_fixed(c.title, c.width, c.height);
        } else {
            xc = x11.config(c.title, c.width, c.height);
        }
        xc.class_name = c.class_name;
        if (cast(i64, c.owner) != 0 && c.owner.backend == X11 && c.owner.ok == 1) {
            xc.transient_for = x11.xid(&c.owner.x11_win);
        }
        xc.dialog = c.dialog;
        xc.modal = c.modal;
        xc.transparent = c.transparent;
        xc.decorated = c.decorated;
        if (c.popup != 0) {
            let is math.rect.Rect as at;
            let is i64 as ox with mut = 0;
            let is i64 as oy with mut = 0;
            if (xc.transient_for == 0 || _placed(c.owner, &c.place, c.width, c.height, &at, &ox, &oy) == 0) {
                w.ok = 0; w.err = BAD_ARGUMENT;
                return w;
            }
            xc.popup = c.popup;
            xc.grab = c.grab;
            xc.x = ox + cast(i64, at.x);
            xc.y = oy + cast(i64, at.y);
            xc.width = cast(i64, at.w);
            xc.height = cast(i64, at.h);
            w.popup_x = cast(i64, at.x);
            w.popup_y = cast(i64, at.y);
        }
        w.x11_win = x11.open_with(&xc);
        w.ok = x11.is_open(&w.x11_win);
        w.err = x11.last_error(&w.x11_win);
        return w;
    }

    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) {
        let is *u8 as title with mut = c.title;
        if (cast(i64, title) == 0) { title = ""; }
        let is wayland.Options as wo with mut = wayland.options();
        if (cast(i64, c.class_name) != 0 && c.class_name[0] != 0) { wo.app_id = c.class_name; }
        if (cast(i64, c.owner) != 0 && c.owner.backend == WAYLAND && c.owner.ok == 1) {
            wo.parent = wayland.native_toplevel(c.owner.wayland_win);
        }
        wo.resizable = c.resizable;
        wo.dialog = c.dialog;
        wo.modal = c.modal;
        wo.decorated = c.decorated;
        let is i64 as popup_w with mut = c.width;
        let is i64 as popup_h with mut = c.height;
        if (c.popup != 0) {
            if (cast(i64, c.owner) == 0 || c.owner.backend != WAYLAND || c.owner.ok == 0 ||
                _wayland_place(c.owner.wayland_win, &c.place, c.width, c.height, &wo) == 0) {
                w.ok = 0; w.err = BAD_ARGUMENT;
                return w;
            }
            wo.popup = c.popup;
            wo.grab = c.grab;
            popup_w = _logical(c.width, wayland.scale(c.owner.wayland_win));
            popup_h = _logical(c.height, wayland.scale(c.owner.wayland_win));
        }
        w.wayland_win = cast(*wayland.Window, mem.core.mmap_anon(sizeof(wayland.Window)));
        if (cast(i64, w.wayland_win) <= 0) {
            w.wayland_win = cast(*wayland.Window, 0);
            w.ok = 0; w.err = NO_MEMORY;
            return w;
        }
        w.ok = wayland.open_config(w.wayland_win, title, popup_w, popup_h, &wo);
        let is i32 as e = wayland.error(w.wayland_win);
        if (e == wayland.OK) { w.err = OK; }
        else if (e == wayland.NO_MEMORY) { w.err = NO_MEMORY; }
        else if (e == wayland.NO_RUNTIME || e == wayland.NO_SOCKET) { w.err = NO_DISPLAY; }
        else if (e == wayland.NO_CONFIGURE) { w.err = BAD_ARGUMENT; }
        else { w.err = NO_WINDOW; }
        if (w.ok == 0) {
            wayland.close(w.wayland_win);
            mem.core.munmap(cast(*u8, w.wayland_win), sizeof(wayland.Window));
            w.wayland_win = cast(*wayland.Window, 0);
        }
        return w;
    }

    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) {
        _open_win32(&w, c);
        return w;
    }

    w.ok = 0;
    w.err = NO_BACKEND;
    return w;
}

fn open(title as *u8, width as i64, height as i64) as Window {
    let is Config as c = config(title, width, height);
    return open_config(&c);
}

fn open_with(backend as i32, title as *u8, width as i64, height as i64) as Window {
    let is Config as c = config(title, width, height);
    c.backend = backend;
    return open_config(&c);
}

fn close(w as *Window) as void {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { x11.close(&w.x11_win); }
        if (w.backend == WAYLAND && cast(i64, w.wayland_win) != 0) {
            wayland.close(w.wayland_win);
            mem.core.munmap(cast(*u8, w.wayland_win), sizeof(wayland.Window));
            w.wayland_win = cast(*wayland.Window, 0);
        }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { win32.close(&w.win32_win); }
    w.ok = 0;
}

// Modal (1) or not (0), asked of the platform once open: 1 when asked.
fn set_modal(w as *Window, on as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.set_modal(&w.x11_win, on); }
        if (w.backend == WAYLAND) { return wayland.set_modal(w.wayland_win, on); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_modal(&w.win32_win, on); }
    return 0;
}

fn is_open(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.is_open(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { return wayland.is_open(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.is_open(&w.win32_win); }
    return 0;
}

fn last_error(w as *Window) as i32 {
    return w.err;
}

// --- Frame lifecycle ---

fn next_frame(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.next_frame(&w.x11_win); }
        if (w.backend == WAYLAND) { return wayland.next_frame(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.next_frame(&w.win32_win); }
    return 0;
}

// --- Waiting (wait.cst) ---

// Every event that can be read without waiting, given to the windows it
// belongs to: for a loop that sleeps by itself, in place of next_frame.
fn pump(w as *Window) as void {
    if (w.ok == 0) { return; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { x11.pump(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { wayland.pump(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { win32.pump(&w.win32_win); }
}

// Whether an event is there to be read, so sleeping now would miss it.
fn pending(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.pending(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { return wayland.pending(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.pending(&w.win32_win); }
    return 0;
}

// The descriptor the platform's events arrive on, -1 for none: every window
// of the program shares it. Windows has none: its messages arrive in the
// thread's queue.
fn connection_fd(w as *Window) as i64 {
    if (w.ok == 0) { return 0 - 1; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return cast(i64, x11.connection_fd(&w.x11_win)); }
        if (w.backend == WAYLAND) { return wayland.native_fd(w.wayland_win); }
    }
    return 0 - 1;
}

fn _no_target() as tgt.Target {
    let is tgt.Target as t;
    t.width = 0; t.height = 0;
    t.color = cast(*u8, 0);
    t.depth = cast(*u8, 0);
    return t;
}

fn acquire(w as *Window) as tgt.Target {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.acquire(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { return wayland.acquire(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.acquire(&w.win32_win); }
    return _no_target();
}

fn submit(w as *Window) as void {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { x11.submit(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { wayland.submit(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { win32.submit(&w.win32_win); }
}

// --- Geometry and State ---

fn width(w as *Window) as i64 {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.width(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { return wayland.width(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.width(&w.win32_win); }
    return 0;
}

fn height(w as *Window) as i64 {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.height(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { return wayland.height(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.height(&w.win32_win); }
    return 0;
}

fn resized(w as *Window) as i32 {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.resized(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { return wayland.resized(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.resized(&w.win32_win); }
    return 0;
}

fn should_close(w as *Window) as i32 {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.should_close(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { return wayland.should_close(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.should_close(&w.win32_win); }
    return 1;
}

// Asked to close by the platform — its close button — and kept open: the
// program said no, as a dialog asking first does. next_frame goes on.
fn keep_open(w as *Window) as void {
    if (w.ok == 0) { return; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { x11.keep_open(&w.x11_win); }
        if (w.backend == WAYLAND) { wayland.keep_open(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { win32.keep_open(&w.win32_win); }
}

fn request_close(w as *Window) as void {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { x11.request_close(&w.x11_win); }
        if (w.backend == WAYLAND && w.ok == 1) { wayland.request_close(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { win32.request_close(&w.win32_win); }
}

fn transport_name(w as *Window) as *u8 {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.transport_name(&w.x11_win); }
        if (w.backend == WAYLAND) { return "wayland"; }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.transport_name(&w.win32_win); }
    return backend_name(w.backend);
}

// --- Events ---

fn _x11_event(w as *Window, out as *event.Event) as i32 {
    let is x11.events.Event as xev;
    let is i32 as got = x11.poll_event(&w.x11_win, &xev);
    if (got == 0) { return 0; }
    event.clear(out);
    out.kind = xev.kind;
    out.raw_kind = xev.xkind;
    out.x = xev.x;
    out.y = xev.y;
    out.width = xev.width;
    out.height = xev.height;
    out.drop = xev.drop;
    out.state = xev.state;
    return 1;
}

// What happened to the window, oldest first: 1, or 0 when nothing waits.
fn poll_event(w as *Window, out as *event.Event) as i32 {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return _x11_event(w, out); }
        if (w.backend == WAYLAND && w.ok == 1) { return wayland.poll_event(w.wayland_win, out); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.poll_event(&w.win32_win, out); }
    return 0;
}

// What a person did — keys, text, the pointer, scrolling — oldest first, as
// input/event.cst's cooked events: 1, or 0 when nothing waits. Text an event
// carries stays valid until the next call.
fn poll_input(w as *Window, out as *ie.Event) as i32 {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.poll_input(&w.x11_win, out); }
        if (w.backend == WAYLAND && w.ok == 1) { return wayland.poll_input(w.wayland_win, out); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.poll_input(&w.win32_win, out); }
    return 0;
}

// Milliseconds until the window's backend has input of its own to say — a
// held key's next repeat where the platform leaves repeating to the client
// (Wayland) — 0 when due, -1 for none. wait.cst sleeps no longer than this.
fn input_due(w as *Window) as i64 {
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND && w.ok == 1) { return wayland.input_due(w.wayland_win); }
    return 0 - 1;
}

// --- What the window is ---

// Its title, n bytes of UTF-8.
fn set_title(w as *Window, s as *u8, n as i64) as void {
    if (w.ok == 0) { return; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { x11.set_title_utf8(&w.x11_win, s, n); }
        if (w.backend == WAYLAND) { wayland.set_title(w.wayland_win, s, n); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { win32.set_title(&w.win32_win, s, n); }
}

fn show(w as *Window) as void {
    if (w.ok == 0) { return; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { x11.show(&w.x11_win); }
        if (w.backend == WAYLAND) { wayland.show(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { win32.show(&w.win32_win); }
}

fn hide(w as *Window) as void {
    if (w.ok == 0) { return; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { x11.hide(&w.x11_win); }
        if (w.backend == WAYLAND) { wayland.hide(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { win32.hide(&w.win32_win); }
}

// --- A frame of the program's own ---
//
// A window drawing its own title bar, edges and shadow (ui/widgets/
// decoration.cst) tells the platform it needs none of its own, where the
// window really is inside the shadow, and where it takes the pointer; and
// hands it the moving and resizing a press begins, its menu, minimizing and
// maximizing. What the platform says of its state comes back as STATE events
// and state(). On X11: Motif's hints, _GTK_FRAME_EXTENTS, the SHAPE input
// region, _NET_WM_MOVERESIZE, _GTK_SHOW_WINDOW_MENU (x11/frame.cst). On
// Windows: the window style, hit-testing and the system's own move, size and
// menu loops.

// How a press moves or resizes it (begin_move_resize): from an edge or a
// corner, numbered as EWMH numbers them, or moved whole.
let is i64 as RESIZE_NW with imut = 0;
let is i64 as RESIZE_N  with imut = 1;
let is i64 as RESIZE_NE with imut = 2;
let is i64 as RESIZE_E  with imut = 3;
let is i64 as RESIZE_SE with imut = 4;
let is i64 as RESIZE_S  with imut = 5;
let is i64 as RESIZE_SW with imut = 6;
let is i64 as RESIZE_W  with imut = 7;
let is i64 as MOVE      with imut = 8;

// Whether its pixels' alpha shows what is behind it (Config.transparent,
// granted).
fn transparent(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.transparent(&w.x11_win); }
        if (w.backend == WAYLAND) { return 1; }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.transparent(&w.win32_win); }
    return 0;
}

// Wayland compositors always composite surfaces.
fn composited(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.composited(&w.x11_win); }
        if (w.backend == WAYLAND) { return 1; }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.composited(&w.win32_win); }
    return 0;
}

// The platform's own decoration on it (1) or not (0): 1 when told.
fn set_decorated(w as *Window, on as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.set_decorated(&w.x11_win, on); }
        if (w.backend == WAYLAND) { return wayland.set_decorated(w.wayland_win, on); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_decorated(&w.win32_win, on); }
    return 0;
}

fn decorated(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.decorated(&w.x11_win); }
        if (w.backend == WAYLAND) { return wayland.decorated(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.decorated(&w.win32_win); }
    return 0;
}

// The shadow round the window, in physical pixels each side: the window as
// the desktop counts it is inside it. 1 when told.
fn set_frame_extents(w as *Window, left as i64, right as i64, top as i64, bottom as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.set_client_extents(&w.x11_win, left, right, top, bottom); }
        if (w.backend == WAYLAND) { return wayland.set_frame_extents(w.wayland_win, left, right, top, bottom); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_frame_extents(&w.win32_win, left, right, top, bottom); }
    return 0;
}

// Where it takes the pointer, in physical pixels: 1 when told.
fn set_input_region(w as *Window, x as i64, y as i64, rw as i64, rh as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.set_input_region(&w.x11_win, x, y, rw, rh); }
        if (w.backend == WAYLAND) { return wayland.set_input_region(w.wayland_win, x, y, rw, rh); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_input_region(&w.win32_win, x, y, rw, rh); }
    return 0;
}

// The input region as last told: 1, or 0 for none.
fn input_region(w as *Window, x as *i64, y as *i64, rw as *i64, rh as *i64) as i32 {
    if (w.ok == 0) { return 0; }
    *x = 0; *y = 0; *rw = 0; *rh = 0;
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.input_region(&w.x11_win, x, y, rw, rh); }
        if (w.backend == WAYLAND) { return wayland.input_region(w.wayland_win, x, y, rw, rh); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.input_region(&w.win32_win, x, y, rw, rh); }
    return 0;
}

// Moved (MOVE) or resized from an edge (RESIZE_*) by the platform from a
// press of button at x, y in the window, following the pointer from there.
// 1 when asked. Windows' own loop follows the left button only.
fn begin_move_resize(w as *Window, x as i64, y as i64, how as i64, button as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.begin_move_resize(&w.x11_win, x, y, how, button); }
        if (w.backend == WAYLAND) { return wayland.begin_move_resize(w.wayland_win, x, y, how, button); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.begin_move_resize(&w.win32_win, x, y, how, button); }
    return 0;
}

// Its own menu — move, resize, minimize, on top, close — at x, y in the
// window: 1 when asked.
fn show_window_menu(w as *Window, x as i64, y as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.show_window_menu(&w.x11_win, x, y); }
        if (w.backend == WAYLAND) { return wayland.show_window_menu(w.wayland_win, x, y); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.show_window_menu(&w.win32_win, x, y); }
    return 0;
}

// Minimized, as its title bar's button would: 1 when asked.
fn minimize(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.minimize(&w.x11_win); }
        if (w.backend == WAYLAND) { return wayland.minimize(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.minimize(&w.win32_win); }
    return 0;
}

// Where a popup was put, relative to its owner's client, physical pixels:
// 1, or 0 for a window that is not a popup.
fn popup_position(w as *Window, x as *i64, y as *i64) as i32 {
    if (w.ok == 0 || w.popup == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) {
        if (cast(i64, w.popup_owner) == 0 || w.popup_owner.ok == 0) { return 0; }
        return wayland.popup_position(w.wayland_win, w.popup_owner.wayland_win, x, y);
    }
    *x = w.popup_x;
    *y = w.popup_y;
    return 1;
}

// Whether the popup holds the pointer and keyboard grab it asked for: not
// where it could not be had — another client holds it, a Wayland compositor
// with no seat.
fn grabbing(w as *Window) as i32 {
    if (w.ok == 0 || w.popup == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == X11) { return x11.grabbing(&w.x11_win); }
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) { return wayland.grabbing(w.wayland_win); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.grabbing(&w.win32_win); }
    return 0;
}

// Whether the window system took the popup down — a press outside the
// program's popups, the compositor's popup_done; POPUP_DONE says so as it
// happens. The program closes it.
fn popup_done(w as *Window) as i32 {
    if (w.ok == 0 || w.popup == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == X11) { return x11.popup_done(&w.x11_win); }
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) { return wayland.popup_done(w.wayland_win); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.popup_done(&w.win32_win); }
    return 0;
}

// The popup placed again by place — what it is anchored to moved, or its size
// changed — kept within the room its owner has. 1 when moved.
fn reposition(w as *Window, place as *positioner.Positioner) as i32 {
    if (w.ok == 0 || w.popup == 0 || cast(i64, w.popup_owner) == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) {
        // The compositor places it, and answers with a configure.
        let is wayland.Options as wo with mut = wayland.options();
        if (w.popup_owner.ok == 0 || _wayland_place(w.popup_owner.wayland_win, place, cast(i64, place.w), cast(i64, place.h), &wo) == 0) { return 0; }
        let is i32 as s = wayland.scale(w.popup_owner.wayland_win);
        return wayland.reposition(w.wayland_win, &wo, _logical(cast(i64, place.w), s), _logical(cast(i64, place.h), s));
    }
    let is math.rect.Rect as at;
    let is i64 as ox with mut = 0;
    let is i64 as oy with mut = 0;
    if (_placed(w.popup_owner, place, cast(i64, place.w), cast(i64, place.h), &at, &ox, &oy) == 0) { return 0; }
    let is i32 as moved with mut = 0;
    if (os.current() == os.OS_LINUX && w.backend == X11) {
        moved = x11.move_resize(&w.x11_win, ox + cast(i64, at.x), oy + cast(i64, at.y), cast(i64, at.w), cast(i64, at.h));
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) {
        moved = win32.move_resize(&w.win32_win, ox + cast(i64, at.x), oy + cast(i64, at.y), cast(i64, at.w), cast(i64, at.h));
    }
    if (moved == 1) {
        w.popup_x = cast(i64, at.x);
        w.popup_y = cast(i64, at.y);
    }
    return moved;
}

// Physical pixels of a window at scale120 as logical ones, never below 1.
fn _logical(v as i64, scale120 as i32) as i64 {
    if (scale120 <= 0) { return v; }
    let is i64 as l = (v * 120 + scale120 / 2) / scale120;
    if (l < 1) { return 1; }
    return l;
}

// A positioner in the owner's physical client pixels as Wayland's: logical,
// relative to the owner's window geometry, the owner's xdg_surface its
// parent, the owner's last press or key the serial a grab is asked under.
fn _wayland_place(owner as *wayland.Window, place as *positioner.Positioner, width as i64, height as i64,
                  wo as *wayland.Options) as i32 {
    if (cast(i64, owner) == 0 || width <= 0 || height <= 0) { return 0; }
    let is i32 as s = wayland.scale(owner);
    let is i64 as gx with mut = 0;
    let is i64 as gy with mut = 0;
    wayland.geometry_origin(owner, &gx, &gy);
    let is math.rect.Rect as r = place.anchor_rect;
    wo.parent_surface = wayland.native_xdg_surface(owner);
    wo.serial = wayland.grab_serial(owner);
    let is i64 as ax = _logical_floor(cast(i64, r.x), s) - gx;
    let is i64 as ay = _logical_floor(cast(i64, r.y), s) - gy;
    wo.anchor_x = cast(i32, ax);
    wo.anchor_y = cast(i32, ay);
    wo.anchor_w = cast(i32, _logical(cast(i64, r.x + r.w), s) - _logical_floor(cast(i64, r.x), s));
    wo.anchor_h = cast(i32, _logical(cast(i64, r.y + r.h), s) - _logical_floor(cast(i64, r.y), s));
    wo.anchor = place.anchor;
    wo.gravity = place.gravity;
    wo.adjust = place.adjust;
    wo.off_x = cast(i32, _logical_floor(cast(i64, place.off_x), s));
    wo.off_y = cast(i32, _logical_floor(cast(i64, place.off_y), s));
    return cast(i32, wo.parent_surface != 0);
}

fn _logical_floor(v as i64, scale120 as i32) as i64 {
    if (scale120 <= 0) { return v; }
    if (v >= 0) { return v * 120 / scale120; }
    return 0 - ((0 - v) * 120 + scale120 - 1) / scale120;
}

// The client asked to be width by height physical pixels: 1 when asked. The
// window system decides, and the size arrives as a RESIZE. A Wayland client
// sizes itself as it draws: 0 there, as anywhere it cannot be asked.
fn set_size(w as *Window, width as i64, height as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == X11) { return x11.set_size(&w.x11_win, width, height); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_size(&w.win32_win, width, height); }
    return 0;
}

// The smallest the window may be made, physical pixels — what its content
// cannot be laid out in less of — 0 by 0 for no floor; asked of the window
// manager again whenever it changes. A fixed window keeps its size: 0. 1
// when asked.
fn set_min_size(w as *Window, width as i64, height as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.set_min_size(&w.x11_win, width, height); }
        if (w.backend == WAYLAND) { return wayland.set_min_size(w.wayland_win, width, height); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_min_size(&w.win32_win, width, height); }
    return 0;
}

fn min_size(w as *Window, width as *i64, height as *i64) as i32 {
    *width = 0; *height = 0;
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.min_size(&w.x11_win, width, height); }
        if (w.backend == WAYLAND) { return wayland.min_size(w.wayland_win, width, height); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.min_size(&w.win32_win, width, height); }
    return 0;
}

// The largest it may be made, physical pixels, 0 by 0 for no ceiling (0 on
// one axis for none along it): 1 when asked. A fixed window keeps its size.
fn set_max_size(w as *Window, width as i64, height as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.set_max_size(&w.x11_win, width, height); }
        if (w.backend == WAYLAND) { return wayland.set_max_size(w.wayland_win, width, height); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_max_size(&w.win32_win, width, height); }
    return 0;
}

// Maximized, or back from it: 1 when asked.
fn set_maximized(w as *Window, on as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.set_maximized(&w.x11_win, on); }
        if (w.backend == WAYLAND) { return wayland.set_maximized(w.wayland_win, on); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_maximized(&w.win32_win, on); }
    return 0;
}

fn set_fullscreen(w as *Window, on as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.set_fullscreen(&w.x11_win, on); }
        if (w.backend == WAYLAND) { return wayland.set_fullscreen(w.wayland_win, on); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_fullscreen(&w.win32_win, on); }
    return 0;
}

// Its state as the platform keeps it: event.STATE_* bits.
fn state(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.state(&w.x11_win); }
        if (w.backend == WAYLAND) { return wayland.state(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.state(&w.win32_win); }
    return 0;
}

// The keyboard asked for it — granted or not as the window manager decides.
fn activate(w as *Window) as void {
    if (w.ok == 0) { return; }
    if (os.current() == os.OS_LINUX && w.backend == X11) { x11.activate(&w.x11_win); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { win32.activate(&w.win32_win); }
}

// Where its inside's top left is on the screen, in physical pixels: 1, or 0
// where the platform does not say (Wayland never does).
fn position(w as *Window, x as *i64, y as *i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == X11) { return x11.position(&w.x11_win, x, y); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.position(&w.win32_win, x, y); }
    return 0;
}

// Its icon: argb, iw by ih, 0xAARRGGBB a pixel.
fn set_icon(w as *Window, argb as *u8, iw as i64, ih as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == X11) { return x11.set_icon(&w.x11_win, argb, iw, ih); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_icon(&w.win32_win, argb, iw, ih); }
    return 0;
}

fn cursor_set(w as *Window, shape as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) { return wayland.set_cursor(w.wayland_win, shape); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.set_cursor(&w.win32_win, shape); }
    return 0;
}

fn scale_120(w as *Window) as i32 {
    if (w.ok == 0) { return 120; }
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) { return wayland.scale(w.wayland_win); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.scale_120(&w.win32_win); }
    return 120;
}

// Text input focus and candidate placement. Coordinates are device pixels;
// the backend converts them to its surface's logical coordinate system.
fn text_input_enable(w as *Window, on as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) { return wayland.text_input_enable(w.wayland_win, on); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.text_input_enable(&w.win32_win, on); }
    return 0;
}

fn text_input_active(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) { return wayland.text_input_active(w.wayland_win); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.text_input_active(&w.win32_win); }
    return 0;
}

fn text_input_rect(w as *Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == WAYLAND) { return wayland.text_input_rect(w.wayland_win, x, y, width, height); }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.text_input_rect(&w.win32_win, x, y, width, height); }
    return 0;
}

// --- The clipboard ---
//
// CLIPBOARD, what copying fills, and PRIMARY, what selecting fills where the
// platform has one (X11, Wayland; not Windows). Text set is served by the
// window while it lives; text asked for arrives as the events are pumped:
// ready, then read. Windows answers at once.

let is i32 as CLIPBOARD with imut = 0;
let is i32 as PRIMARY   with imut = 1;

fn clipboard_set(w as *Window, which as i32, s as *u8, n as i64) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.selection_set_text(&w.x11_win, which, s, n); }
        if (w.backend == WAYLAND) { return wayland.clipboard_set(w.wayland_win, which, s, n); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.clipboard_set(&w.win32_win, which, s, n); }
    return 0;
}

fn clipboard_request(w as *Window, which as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.selection_request_text(&w.x11_win, which); }
        if (w.backend == WAYLAND) { return wayland.clipboard_request(w.wayland_win, which); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.clipboard_request(&w.win32_win, which); }
    return 0;
}

// Whether what was asked for came: then clipboard_text has it (empty when
// there was none to have).
fn clipboard_ready(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.selection_ready(&w.x11_win); }
        if (w.backend == WAYLAND) { return wayland.clipboard_ready(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.clipboard_ready(&w.win32_win); }
    return 0;
}

// Whether an answer is still awaited.
fn clipboard_pending(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.selection_pending(&w.x11_win); }
        if (w.backend == WAYLAND) { return wayland.clipboard_pending(w.wayland_win); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.clipboard_pending(&w.win32_win); }
    return 0;
}

fn clipboard_text(w as *Window, buf as *u8, cap as i64) as i64 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.clipboard_text(&w.x11_win, buf, cap); }
        if (w.backend == WAYLAND) { return wayland.clipboard_text(w.wayland_win, buf, cap); }
    }
    if (os.current() == os.OS_WINDOWS && w.backend == WIN32) { return win32.clipboard_text(&w.win32_win, buf, cap); }
    return 0;
}

// --- Dropped on the window ---
//
// What another program drags over the window is heard as event.DND_* events;
// what the program takes where the pointer is, drop_answer says to the source
// (event.DROP_FILES, DROP_TEXT, 0) — until it does, everything offered is
// taken. What arrived stays readable until clear_drop.

fn drop_answer(w as *Window, takes as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.drop_answer(&w.x11_win, takes); }
        if (w.backend == WAYLAND) { return wayland.drop_answer(w.wayland_win, takes); }
    }
    return 0;
}

fn dropped_files(w as *Window) as i64 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.dropped_files(&w.x11_win); }
        if (w.backend == WAYLAND) { return wayland.dropped_files(w.wayland_win); }
    }
    return 0;
}

// The i-th path, zero-terminated; null for none.
fn dropped_file(w as *Window, i as i64) as *u8 {
    if (w.ok == 0) { return cast(*u8, 0); }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.dropped_file(&w.x11_win, i); }
        if (w.backend == WAYLAND) { return wayland.dropped_file(w.wayland_win, i); }
    }
    return cast(*u8, 0);
}

// The text dropped, UTF-8, dropped_text_length bytes, not terminated.
fn dropped_text(w as *Window) as *u8 {
    if (w.ok == 0) { return cast(*u8, 0); }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.dropped_text(&w.x11_win); }
        if (w.backend == WAYLAND) { return wayland.dropped_text(w.wayland_win); }
    }
    return cast(*u8, 0);
}

fn dropped_text_length(w as *Window) as i64 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { return x11.dropped_text_length(&w.x11_win); }
        if (w.backend == WAYLAND) { return wayland.dropped_text_length(w.wayland_win); }
    }
    return 0;
}

fn clear_drop(w as *Window) as void {
    if (w.ok == 0) { return; }
    if (os.current() == os.OS_LINUX) {
        if (w.backend == X11) { x11.clear_drop(&w.x11_win); }
        if (w.backend == WAYLAND) { wayland.clear_drop(w.wayland_win); }
    }
}

// --- The desktop's settings ---

// What this backend can read of them, into out. On Linux: GTK's settings.ini
// and the language from the environment, then XSETTINGS on X11 — after which
// a SETTINGS event says they changed; the portal needs a D-Bus connection and
// is linux/portal.cst's, for whoever holds one. On Windows: the registry and
// SystemParametersInfo. How many sources answered.
fn read_settings(w as *Window, out as *settings.Settings) as i32 {
    *out = settings.defaults();
    if (os.current() == os.OS_WINDOWS) {
        if (w.backend == WIN32) { return win32.read_settings(&w.win32_win, out); }
        return 0;
    }
    let is settings.Settings as files with mut = settings.defaults();
    let is i32 as n with mut = gtk_ini.read_user(&files);
    settings.merge(out, &files);
    locale.read(out);
    if (w.backend == X11) { n = n + x11.read_settings(&w.x11_win, out); }
    return n;
}

// --- GPU Presentation surfaces ---

fn surface_for_gpu(w as *Window, present as *u8, user as *u8) as swapchain.Surface {
    if (os.current() == os.OS_LINUX && w.backend == X11) {
        return x11.surface_for_gpu(&w.x11_win, present, user);
    }
    return swapchain.surface_headless();
}

fn surface_for_gpu_shared(w as *Window) as swapchain.Surface {
    if (os.current() == os.OS_LINUX && w.backend == X11) {
        return x11.surface_for_gpu_shared(&w.x11_win);
    }
    return swapchain.surface_headless();
}
