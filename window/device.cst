// window/device.cst — the portable window device.
//
// Backends:
//   X11      Linux / BSD via libX11 and MIT-SHM
//   WAYLAND  Linux native (designed)
//   KMS      Linux console / DRM direct (designed)
//   WIN32    Windows user32 / gdi32 (designed)
//
// The interface is pull:
//
//   let is window.device.Window as w = window.open("title", 1280, 720);
//   while (window.next_frame(&w) == 1) {
//       let is tgt.Target as t = window.acquire(&w);
//       if (t.width == 0) { continue; }
//       // draw into t
//       window.submit(&w);
//   }
//   window.close(&w);

use "../gpu/software/target.cst" as tgt;
use "../gpu/swapchain.cst" as swapchain;
use "x11/x11.cst" as x11;
use "event.cst" as event;
use "settings.cst" as settings;
use "linux/gtk_ini.cst" as gtk_ini;
use "locale.cst" as locale;

// --- Backends ---

let is i32 as AUTO    with imut = cast(i32, 0 - 1);
let is i32 as X11     with imut = 0;
let is i32 as WAYLAND with imut = 1;
let is i32 as KMS     with imut = 2;
let is i32 as WIN32   with imut = 3;

fn backend_name(id as i32) as *u8 {
    if (id == AUTO)    { return "auto"; }
    if (id == X11)     { return "x11"; }
    if (id == WAYLAND) { return "wayland"; }
    if (id == KMS)     { return "kms"; }
    if (id == WIN32)   { return "win32"; }
    return "unknown";
}

fn available(id as i32) as i32 {
    if (id == X11) { return 1; }
    return 0;
}

// --- Errors ---

let is i32 as OK           with imut = 0;
let is i32 as NO_BACKEND   with imut = 1;
let is i32 as NO_DISPLAY   with imut = 2;
let is i32 as NO_VISUAL    with imut = 3;
let is i32 as NO_WINDOW    with imut = 4;
let is i32 as NO_GC        with imut = 5;
let is i32 as NO_MEMORY    with imut = 6;
let is i32 as NO_SURFACE   with imut = 7;
let is i32 as BAD_ARGUMENT with imut = 8;
let is i32 as CLOSED       with imut = 9;

fn error_name(code as i32) as *u8 {
    if (code == OK)           { return "ok"; }
    if (code == NO_BACKEND)   { return "no backend available"; }
    if (code == NO_DISPLAY)   { return "no display (is DISPLAY set?)"; }
    if (code == NO_VISUAL)    { return "no truecolor visual"; }
    if (code == NO_WINDOW)    { return "could not create the window"; }
    if (code == NO_GC)        { return "could not create a graphics context"; }
    if (code == NO_MEMORY)    { return "out of memory"; }
    if (code == NO_SURFACE)   { return "could not create the framebuffer"; }
    if (code == BAD_ARGUMENT) { return "bad argument"; }
    if (code == CLOSED)       { return "window is closed"; }
    return "unknown error";
}

// --- Config ---

struct Config {
    title      as *u8;
    class_name as *u8;
    width      as i64;
    height     as i64;
    resizable  as i32;
    backend    as i32;
    // A dialog: the window it belongs to (kept above it, no taskbar entry of
    // its own), null for none; placed and decorated as a dialog; modal, its
    // owner taking no input while it is up. On X11 all three are on the window
    // before it is first mapped.
    owner      as *Window;
    dialog     as i32;
    modal      as i32;
}

fn config(title as *u8, width as i64, height as i64) as Config {
    let is Config as c;
    c.title = title;
    c.class_name = cast(*u8, 0);
    c.width = width;
    c.height = height;
    c.resizable = 1;
    c.backend = AUTO;
    c.owner = cast(*Window, 0);
    c.dialog = 0;
    c.modal = 0;
    return c;
}

fn config_fixed(title as *u8, width as i64, height as i64) as Config {
    let is Config as c = config(title, width, height);
    c.resizable = 0;
    return c;
}

// --- Portable Window Struct ---

struct Window {
    backend as i32;
    ok      as i32;
    err     as i32;
    _pad0   as i32;
    x11_win as x11.window.Window;
}

// --- Opening and Lifecycle ---

fn open_config(c as *Config) as Window {
    let is Window as w;
    w.backend = c.backend;
    if (w.backend == AUTO) {
        w.backend = X11;
    }

    if (w.backend == X11) {
        let is x11.window.Config as xc with mut;
        if (c.resizable == 0) {
            xc = x11.config_fixed(c.title, c.width, c.height);
        } else {
            xc = x11.config(c.title, c.width, c.height);
        }
        xc.class_name = c.class_name;
        if (cast(i64, c.owner) != 0 && c.owner.backend == X11 && c.owner.ok == 1) {
            xc.transient_for = x11.xid(&c.owner.x11_win);
        }
        xc.dialog = c.dialog;
        xc.modal = c.modal;
        w.x11_win = x11.open_with(&xc);
        w.ok = x11.is_open(&w.x11_win);
        w.err = x11.last_error(&w.x11_win);
        return w;
    }

    w.ok = 0;
    w.err = NO_BACKEND;
    return w;
}

fn open(title as *u8, width as i64, height as i64) as Window {
    let is Config as c = config(title, width, height);
    return open_config(&c);
}

fn open_with(backend as i32, title as *u8, width as i64, height as i64) as Window {
    let is Config as c = config(title, width, height);
    c.backend = backend;
    return open_config(&c);
}

fn close(w as *Window) as void {
    if (w.backend == X11) {
        x11.close(&w.x11_win);
    }
    w.ok = 0;
}

// Modal (1) or not (0), asked of the platform once open: 1 when asked.
fn set_modal(w as *Window, on as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (w.backend == X11) { return x11.set_modal(&w.x11_win, on); }
    return 0;
}

fn is_open(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (w.backend == X11) {
        return x11.is_open(&w.x11_win);
    }
    return 0;
}

fn last_error(w as *Window) as i32 {
    return w.err;
}

// --- Frame lifecycle ---

fn next_frame(w as *Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (w.backend == X11) {
        return x11.next_frame(&w.x11_win);
    }
    return 0;
}

fn acquire(w as *Window) as tgt.Target {
    if (w.backend == X11) {
        return x11.acquire(&w.x11_win);
    }
    let is tgt.Target as t;
    t.width = 0; t.height = 0;
    t.color = cast(*u8, 0);
    t.depth = cast(*u8, 0);
    return t;
}

fn submit(w as *Window) as void {
    if (w.backend == X11) {
        x11.submit(&w.x11_win);
    }
}

// --- Geometry and State ---

fn width(w as *Window) as i64 {
    if (w.backend == X11) { return x11.width(&w.x11_win); }
    return 0;
}

fn height(w as *Window) as i64 {
    if (w.backend == X11) { return x11.height(&w.x11_win); }
    return 0;
}

fn resized(w as *Window) as i32 {
    if (w.backend == X11) { return x11.resized(&w.x11_win); }
    return 0;
}

fn should_close(w as *Window) as i32 {
    if (w.backend == X11) { return x11.should_close(&w.x11_win); }
    return 1;
}

fn request_close(w as *Window) as void {
    if (w.backend == X11) { x11.request_close(&w.x11_win); }
}

fn transport_name(w as *Window) as *u8 {
    if (w.backend == X11) { return x11.transport_name(&w.x11_win); }
    return backend_name(w.backend);
}

// --- Sampled Input ---

fn key_down(w as *Window, key as i32) as i32 {
    if (w.backend == X11) { return x11.key_down(&w.x11_win, key); }
    return 0;
}

fn button_down(w as *Window, button as i32) as i32 {
    if (w.backend == X11) { return x11.button_down(&w.x11_win, button); }
    return 0;
}

fn mouse_x(w as *Window) as i64 {
    if (w.backend == X11) { return x11.mouse_x(&w.x11_win); }
    return 0;
}

fn mouse_y(w as *Window) as i64 {
    if (w.backend == X11) { return x11.mouse_y(&w.x11_win); }
    return 0;
}

fn mouse_dx(w as *Window) as i64 {
    if (w.backend == X11) { return x11.mouse_dx(&w.x11_win); }
    return 0;
}

fn mouse_dy(w as *Window) as i64 {
    if (w.backend == X11) { return x11.mouse_dy(&w.x11_win); }
    return 0;
}

fn wheel(w as *Window) as i64 {
    if (w.backend == X11) { return x11.wheel(&w.x11_win); }
    return 0;
}

// --- Events ---

fn poll_event(w as *Window, out as *event.Event) as i32 {
    if (w.backend == X11) {
        let is x11.events.Event as xev;
        let is i32 as got = x11.poll_event(&w.x11_win, &xev);
        if (got == 0) { return 0; }
        out.kind = xev.kind;
        out.key = xev.key;
        out.keycode = xev.keycode;
        out.modifiers = xev.modifiers;
        out.button = xev.button;
        out.wheel = xev.wheel;
        out.x = xev.x;
        out.y = xev.y;
        out.width = xev.width;
        out.height = xev.height;
        out.raw_kind = xev.xkind;
        out.drop = xev.drop;
        return 1;
    }
    return 0;
}

// --- Dropped on the window ---
//
// What another program drags over the window is heard as event.DND_* events;
// what the program takes where the pointer is, drop_answer says to the source
// (event.DROP_FILES, DROP_TEXT, 0) — until it does, everything offered is
// taken. What arrived stays readable until clear_drop.

fn drop_answer(w as *Window, takes as i32) as i32 {
    if (w.ok == 0) { return 0; }
    if (w.backend == X11) { return x11.drop_answer(&w.x11_win, takes); }
    return 0;
}

fn dropped_files(w as *Window) as i64 {
    if (w.ok == 0) { return 0; }
    if (w.backend == X11) { return x11.dropped_files(&w.x11_win); }
    return 0;
}

// The i-th path, zero-terminated; null for none.
fn dropped_file(w as *Window, i as i64) as *u8 {
    if (w.ok == 0) { return cast(*u8, 0); }
    if (w.backend == X11) { return x11.dropped_file(&w.x11_win, i); }
    return cast(*u8, 0);
}

// The text dropped, UTF-8, dropped_text_length bytes, not terminated.
fn dropped_text(w as *Window) as *u8 {
    if (w.ok == 0) { return cast(*u8, 0); }
    if (w.backend == X11) { return x11.dropped_text(&w.x11_win); }
    return cast(*u8, 0);
}

fn dropped_text_length(w as *Window) as i64 {
    if (w.ok == 0) { return 0; }
    if (w.backend == X11) { return x11.dropped_text_length(&w.x11_win); }
    return 0;
}

fn clear_drop(w as *Window) as void {
    if (w.ok == 0) { return; }
    if (w.backend == X11) { x11.clear_drop(&w.x11_win); }
}

// --- The desktop's settings ---

// What this backend can read of them, into out: GTK's settings.ini and the
// language from the environment, then XSETTINGS on X11 — after which a
// SETTINGS event says they changed. The
// portal needs a D-Bus connection and is linux/portal.cst's, for whoever holds
// one. How many sources answered.
fn read_settings(w as *Window, out as *settings.Settings) as i32 {
    *out = settings.defaults();
    let is settings.Settings as files with mut = settings.defaults();
    let is i32 as n with mut = gtk_ini.read_user(&files);
    settings.merge(out, &files);
    locale.read(out);
    if (w.backend == X11) { n = n + x11.read_settings(&w.x11_win, out); }
    return n;
}

// --- GPU Presentation surfaces ---

fn surface_for_gpu(w as *Window, present as *u8, user as *u8) as swapchain.Surface {
    if (w.backend == X11) {
        return x11.surface_for_gpu(&w.x11_win, present, user);
    }
    return swapchain.surface_headless();
}

fn surface_for_gpu_shared(w as *Window) as swapchain.Surface {
    if (w.backend == X11) {
        return x11.surface_for_gpu_shared(&w.x11_win);
    }
    return swapchain.surface_headless();
}
