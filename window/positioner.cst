// window/positioner.cst — where a popup goes.
//
// Wayland's xdg_positioner, the most constrained of the three platforms'
// models, and so the one the toolkit speaks everywhere: a popup is never put
// at a point of the screen — Wayland gives no such thing — but against an
// anchor rectangle of its parent. A point of that rectangle (the anchor), the
// way the popup grows from it (the gravity), an offset; then, on an axis
// where that leaves the bounds, the adjustments allowed are tried in the
// spec's order: flipped to the other side — anchor and gravity both — when
// that fits, else left as it was; slid back inside; cut to fit, unless that
// leaves nothing. Menus, submenus, combo boxes' lists and popovers are all
// placed through it; on Wayland the same numbers go to the compositor, which
// knows the screen.
use "../math/math.cst" as math;

// Anchors and gravities: xdg_positioner's values.
let is i32 as NONE         with imut = 0;   // the centre
let is i32 as TOP          with imut = 1;
let is i32 as BOTTOM       with imut = 2;
let is i32 as LEFT         with imut = 3;
let is i32 as RIGHT        with imut = 4;
let is i32 as TOP_LEFT     with imut = 5;
let is i32 as BOTTOM_LEFT  with imut = 6;
let is i32 as TOP_RIGHT    with imut = 7;
let is i32 as BOTTOM_RIGHT with imut = 8;

// Adjustments, bits: xdg_positioner's constraint_adjustment values.
let is i32 as SLIDE_X  with imut = 1;
let is i32 as SLIDE_Y  with imut = 2;
let is i32 as FLIP_X   with imut = 4;
let is i32 as FLIP_Y   with imut = 8;
let is i32 as RESIZE_X with imut = 16;
let is i32 as RESIZE_Y with imut = 32;

struct Positioner {
    w           as f64;   // the popup's size
    h           as f64;
    anchor_rect as math.rect.Rect;
    anchor      as i32;   // which point of anchor_rect
    gravity     as i32;   // which way the popup grows from it
    adjust      as i32;   // what may be done when it does not fit
    _pad0       as i32;
    off_x       as f64;
    off_y       as f64;
}

// A popup w by h centred on the centre of rect, with no adjustment allowed.
fn make(w as f64, h as f64, rect as math.rect.Rect) as Positioner {
    let is Positioner as p;
    p.w = w;
    p.h = h;
    p.anchor_rect = rect;
    p.anchor = NONE;
    p.gravity = NONE;
    p.adjust = 0;
    p._pad0 = 0;
    p.off_x = 0.0;
    p.off_y = 0.0;
    return p;
}

// Across: -1 the left, 0 the middle, 1 the right of an anchor or gravity.
fn _across(e as i32) as i32 {
    if (e == LEFT || e == TOP_LEFT || e == BOTTOM_LEFT) { return 0 - 1; }
    if (e == RIGHT || e == TOP_RIGHT || e == BOTTOM_RIGHT) { return 1; }
    return 0;
}

// Down: -1 the top, 0 the middle, 1 the bottom.
fn _down(e as i32) as i32 {
    if (e == TOP || e == TOP_LEFT || e == TOP_RIGHT) { return 0 - 1; }
    if (e == BOTTOM || e == BOTTOM_LEFT || e == BOTTOM_RIGHT) { return 1; }
    return 0;
}

// Where the popup starts along one axis: the anchor's point on the anchor
// rectangle, a, at start s and length n; growing from it by g; size w.
fn _start(s as f64, n as f64, a as i32, g as i32, w as f64, off as f64) as f64 {
    let is f64 as at = s + n * cast(f64, a + 1) / 2.0 + off;
    if (g > 0) { return at; }
    if (g < 0) { return at - w; }
    return at - w / 2.0;
}

fn _fits(x as f64, w as f64, lo as f64, hi as f64) as i32 { return cast(i32, x >= lo && x + w <= hi); }

// One axis: the start and size of the popup there, through the adjustments
// allowed, into *x and *w.
fn _axis(s as f64, n as f64, a as i32, g as i32, w as f64, off as f64, lo as f64, hi as f64,
         flip as i32, slide as i32, resize as i32, x as *f64, len as *f64) as void {
    let is f64 as at with mut = _start(s, n, a, g, w, off);
    let is f64 as size with mut = w;
    if (_fits(at, size, lo, hi) == 0 && flip == 1) {
        let is f64 as other = _start(s, n, 0 - a, 0 - g, w, off);
        if (_fits(other, size, lo, hi) == 1) { at = other; }
    }
    if (_fits(at, size, lo, hi) == 0 && slide == 1) {
        if (at + size > hi) { at = hi - size; }
        if (at < lo) { at = lo; }
    }
    if (_fits(at, size, lo, hi) == 0 && resize == 1) {
        let is f64 as a0 with mut = at;
        let is f64 as s0 with mut = size;
        if (a0 < lo) {
            s0 = s0 - (lo - a0);
            a0 = lo;
        }
        if (a0 + s0 > hi) { s0 = hi - a0; }
        if (s0 > 0.0) {
            at = a0;
            size = s0;
        }
    }
    *x = at;
    *len = size;
}

// Where the popup goes inside bounds.
fn place(p as *Positioner, bounds as math.rect.Rect) as math.rect.Rect {
    let is f64 as x with mut = 0.0;
    let is f64 as w with mut = 0.0;
    let is f64 as y with mut = 0.0;
    let is f64 as h with mut = 0.0;
    let is math.rect.Rect as r = p.anchor_rect;
    let is i32 as adj = p.adjust;
    _axis(r.x, r.w, _across(p.anchor), _across(p.gravity), p.w, p.off_x, bounds.x, bounds.x + bounds.w,
          cast(i32, (adj & FLIP_X) != 0), cast(i32, (adj & SLIDE_X) != 0), cast(i32, (adj & RESIZE_X) != 0), &x, &w);
    _axis(r.y, r.h, _down(p.anchor), _down(p.gravity), p.h, p.off_y, bounds.y, bounds.y + bounds.h,
          cast(i32, (adj & FLIP_Y) != 0), cast(i32, (adj & SLIDE_Y) != 0), cast(i32, (adj & RESIZE_Y) != 0), &y, &h);
    return math.rect.rect(x, y, w, h);
}
