// window/scroll_wayland_test.cst — a wheel turned on a compositor: Weston
// nested in Xvfb, its buttons from XTest,
//   sh window/x11/tools/run_headless.sh env WESTON_BACKEND=x11 WESTON_SHELL=kiosk \
//       sh window/wayland/tools/run_wayland.sh ./build/scroll_wayland_test
// which turns the X server's buttons 4–7 into its wheel's frames: one SCROLL a
// notch, from a wheel, down, up, left and right, in whole notches and 120ths
// of one, at the pointer. And KWin, its fake input's axis (kwin_input.cst) —
// KWin 6.8 nests only in a server with DRI3, which Xvfb is not —
//   sh window/wayland/tools/run_kwin.sh ./build/scroll_wayland_test
// which it says is a continuous device's: a line a turn, no notches.
use "std/io.cst" as io;
use "std/time.cst" as time;
use "std/env.cst" as env;
use "device.cst" as device;
use "wayland/backend.cst" as wl;
use "../input/event.cst" as ie;
use "../gpu/software/target.cst" as tgt;
use "wayland/kwin_input.cst" as kwin_input;
use "x11/bind/xlib.cst" as xlib;

extern "libXtst.so.6" fn XTestFakeButtonEvent(display as *u8, button as u32, is_press as i32, delay as u64) as i32;
extern "libXtst.so.6" fn XTestFakeMotionEvent(display as *u8, screen as i32, x as i32, y as i32, delay as u64) as i32;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is device.Window as win with mut;
let is i32 as on_kwin with mut = 0;
let is *u8 as xd with mut;

fn settle(ms as i64) as void {
    let is i64 as until = time.now_ms() + ms;
    while (time.now_ms() < until) {
        device.pump(&win);
        time.sleep_ms(5);
    }
}

fn drain() as void {
    let is ie.Event as e;
    settle(100);
    while (device.poll_input(&win, &e) == 1) { }
}

// The X server's button b clicked; the scroll it made, within two seconds,
// into out: 1, or 0 for none.
fn turned(b as u32, out as *ie.Event) as i32 {
    drain();
    if (on_kwin == 1) {
        // KWin's fake input has no buttons 4-7: its wheel turned a notch,
        // 15 logical pixels, down, up, left or right.
        if (b == cast(u32, 4)) { kwin_input.axis(cast(u32, 0), 0.0 - 15.0); }
        if (b == cast(u32, 5)) { kwin_input.axis(cast(u32, 0), 15.0); }
        if (b == cast(u32, 6)) { kwin_input.axis(cast(u32, 1), 0.0 - 15.0); }
        if (b == cast(u32, 7)) { kwin_input.axis(cast(u32, 1), 15.0); }
    } else {
        XTestFakeButtonEvent(xd, b, 1, cast(u64, 0));
        XTestFakeButtonEvent(xd, b, 0, cast(u64, 0));
        xlib.XFlush(xd);
    }
    let is i64 as until = time.now_ms() + 2000;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_input(&win, out) == 1) {
            if (out.kind == ie.SCROLL) { return 1; }
        }
        time.sleep_ms(5);
    }
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    win = device.open("scroll", 400, 300);
    if (device.is_open(&win) == 0 || win.backend != device.WAYLAND) {
        io.printf("FAIL: no Wayland window\n");
        return 1;
    }
    device.next_frame(&win);
    let is tgt.Target as t = device.acquire(&win);
    if (cast(i64, t.color) != 0) { device.submit(&win); }
    settle(300);
    // On KWin (run_kwin.sh says where its log is): its fake input; on a
    // compositor nested in an X server, XTest through that server.
    on_kwin = cast(i32, cast(i64, env.getenv("CAUSTIC_KWIN_LOG")) != 0);
    if (on_kwin == 1) {
        if (kwin_input.open() == 0) { io.printf("FAIL: no fake input of KWin's to send input through\n"); return 1; }
        kwin_input.move(640.0, 480.0);
    } else {
        xd = xlib.XOpenDisplay(cast(*u8, 0));
        if (cast(i64, xd) == 0) { io.printf("FAIL: no X display to send input through\n"); return 1; }
        // Over the window, wherever the compositor put it: the middle of the
        // screen, nested.
        XTestFakeMotionEvent(xd, 0 - 1, 640, 480, cast(u64, 0));
        xlib.XFlush(xd);
    }
    settle(300);
    let is ie.Event as e;
    if (on_kwin == 1) {
        // KWin's fake input scrolls as a continuous device does: no notches,
        // no 120ths, a line a turn.
        check("down: a continuous device's, a line", turned(5, &e) == 1 && e.source == ie.SCROLL_CONTINUOUS && e.dy == 1.0 &&
              e.steps_y == 0 && e.value120_y == 0 && e.dx == 0.0);
        check("up", turned(4, &e) == 1 && e.dy == 0.0 - 1.0 && e.dx == 0.0);
        check("left", turned(6, &e) == 1 && e.dx == 0.0 - 1.0 && e.dy == 0.0);
        check("right", turned(7, &e) == 1 && e.dx == 1.0 && e.dy == 0.0);
    } else {
        check("down a notch: a wheel's, one step, 120ths",
              turned(5, &e) == 1 && e.source == ie.SCROLL_WHEEL && e.dy == 1.0 && e.steps_y == 1 &&
              e.value120_y == 120 && e.dx == 0.0);
        check("up a notch", turned(4, &e) == 1 && e.dy == 0.0 - 1.0 && e.steps_y == 0 - 1 && e.value120_y == 0 - 120);
        check("left a notch", turned(6, &e) == 1 && e.dx == 0.0 - 1.0 && e.steps_x == 0 - 1 && e.dy == 0.0);
        check("right a notch", turned(7, &e) == 1 && e.dx == 1.0 && e.steps_x == 1 && e.value120_x == 120);
    }
    let is i32 as offered = wl._globals.seat_version;
    io.printf("  wl_seat offered at %d, the pointer bound at %d\n", cast(i64, offered),
              cast(i64, win.wayland_win.pointer_version));
    check("the pointer bound at what the compositor offers, up to 9 (120ths from 8)",
          (offered >= 9 && win.wayland_win.pointer_version == 9) ||
          (offered < 9 && win.wayland_win.pointer_version == offered));
    check("at the pointer, in the window", e.x > 0 && e.y > 0 && e.x < device.width(&win) && e.y < device.height(&win));
    device.close(&win);
    if (fails != 0) {
        io.printf("scroll wayland: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("scroll wayland: all checks passed\n");
    return 0;
}
