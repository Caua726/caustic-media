// window/touch_kwin_test.cst — a touchscreen's fingers through a real
// compositor: KWin's own fake input (org_kde_kwin_fake_input, which KWin
// turns into a touch device of its seat) sets fingers down on a window
// filling the screen, as a Wayland client and as an X client of Xwayland:
//   sh window/wayland/tools/run_kwin.sh ./build/touch_kwin_test
//   env KWIN_XWAYLAND=1 sh window/wayland/tools/run_kwin.sh ./build/touch_kwin_test x11
// Each finger by its own contact from its down to its up, where it is in the
// window, moved; two at once; a cancel ending them; and no pointer event
// besides — on X, no button the server makes up from the touch.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/env.cst" as env;
use "std/os/linux.cst" as linux;
use "../sys/linux.cst" as sys;
use "device.cst" as device;
use "../input/event.cst" as ie;
use "../gpu/software/target.cst" as tgt;
use "x11/xinput.cst" as xinput;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is device.Window as win with mut;

// --- KWin's fake input, spoken on a connection of its own ---

let is i64 as fi_fd with mut = 0 - 1;
let is i32 as fi with imut = 4;   // the fake input's object
let is [8192]u8 as rbuf;
let is i64 as rlen with mut = 0;

fn _put(p as *u8, at as i64, v as u32) as void { *cast(*u32, cast(i64, p) + at) = v; }
fn _word(p as *u8, at as i64) as u32 { return *cast(*u32, cast(i64, p) + at); }

fn _send(obj as i32, op as i32, args as *u8, n as i64) as void {
    let is [256]u8 as m;
    _put(&m[0], 0, cast(u32, obj));
    _put(&m[0], 4, cast(u32, ((8 + n) << 16) | op));
    if (n > 0) { mem.memcpy(&m[8], args, n); }
    linux.write(fi_fd, &m[0], 8 + n);
}

// A string argument at p: its bytes on the wire.
fn _string(p as *u8, s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    _put(p, 0, cast(u32, n + 1));
    mem.memset(cast(*u8, cast(i64, p) + 4), 0, ((n + 1 + 3) / 4) * 4);
    mem.memcpy(cast(*u8, cast(i64, p) + 4), s, n);
    return 4 + ((n + 1 + 3) / 4) * 4;
}

fn fixed(v as f64) as u32 { return cast(u32, cast(i32, v * 256.0)); }

// Connected and the fake input bound and authenticated: 1, or 0 when KWin
// offers none.
fn fake_input() as i32 {
    let is *u8 as rt = env.getenv("XDG_RUNTIME_DIR");
    let is *u8 as name = env.getenv("WAYLAND_DISPLAY");
    if (cast(i64, rt) == 0 || cast(i64, name) == 0) { return 0; }
    let is [256]u8 as path;
    let is i64 as n with mut = 0;
    while (rt[n] != 0) { path[n] = rt[n]; n = n + 1; }
    path[n] = cast(u8, 47);
    n = n + 1;
    let is i64 as k with mut = 0;
    while (name[k] != 0) { path[n] = name[k]; n = n + 1; k = k + 1; }
    path[n] = cast(u8, 0);
    fi_fd = sys.connect_unix(&path[0], n, 0);
    if (fi_fd < 0) { return 0; }
    let is [16]u8 as a;
    _put(&a[0], 0, 2);
    _send(1, 1, &a[0], 4);      // get_registry → 2
    _put(&a[0], 0, 3);
    _send(1, 0, &a[0], 4);      // sync → 3
    let is u32 as global with mut = cast(u32, 0);
    let is u32 as version with mut = cast(u32, 0);
    let is i32 as synced with mut = 0;
    let is i64 as until = time.now_ms() + 3000;
    while (synced == 0 && time.now_ms() < until) {
        if (sys.wait_readable(fi_fd, 50) <= 0) { continue; }
        let is i64 as r = linux.read(fi_fd, cast(*u8, cast(i64, &rbuf[0]) + rlen), 8192 - rlen);
        if (r <= 0) { return 0; }
        rlen = rlen + r;
        let is i64 as at with mut = 0;
        while (at + 8 <= rlen) {
            let is u32 as head = _word(&rbuf[0], at + 4);
            let is i64 as size = cast(i64, head >> 16);
            if (size < 8 || at + size > rlen) { break; }
            let is u32 as obj = _word(&rbuf[0], at);
            let is u32 as op = head & cast(u32, 65535);
            if (obj == cast(u32, 2) && op == cast(u32, 0)) {
                let is *u8 as iface = cast(*u8, cast(i64, &rbuf[0]) + at + 16);
                let is i64 as ilen = cast(i64, _word(&rbuf[0], at + 12));
                if (ilen == 24 && mem.memcmp(iface, "org_kde_kwin_fake_input", 23) == 0) {
                    global = _word(&rbuf[0], at + 8);
                    version = _word(&rbuf[0], at + 16 + ((ilen + 3) / 4) * 4);
                }
            }
            if (obj == cast(u32, 3) && op == cast(u32, 0)) { synced = 1; }
            at = at + size;
        }
        if (at > 0) {
            let is i64 as i with mut = 0;
            while (i < rlen - at) {
                rbuf[i] = rbuf[at + i];
                i = i + 1;
            }
            rlen = rlen - at;
        }
    }
    if (global == cast(u32, 0)) { return 0; }
    // bind(name, "org_kde_kwin_fake_input", version, new id 4)
    let is [64]u8 as b;
    _put(&b[0], 0, global);
    let is i64 as m = 4 + _string(cast(*u8, cast(i64, &b[0]) + 4), "org_kde_kwin_fake_input");
    let is u32 as v with mut = version;
    if (v > cast(u32, 4)) { v = cast(u32, 4); }
    _put(&b[0], m, v);
    _put(&b[0], m + 4, cast(u32, fi));
    _send(2, 0, &b[0], m + 8);
    let is [96]u8 as auth;
    let is i64 as n1 = _string(&auth[0], "caustic touch test");
    let is i64 as n2 = _string(cast(*u8, cast(i64, &auth[0]) + n1), "fingers set down by a test");
    _send(fi, 0, &auth[0], n1 + n2);
    return 1;
}

fn touch(op as i32, id as i32, x as f64, y as f64) as void {
    let is [12]u8 as a;
    _put(&a[0], 0, cast(u32, id));
    _put(&a[0], 4, fixed(x));
    _put(&a[0], 8, fixed(y));
    if (op == 6) { _send(fi, op, &a[0], 4); } else { _send(fi, op, &a[0], 12); }
    _send(fi, 8, cast(*u8, 0), 0);   // touch_frame
}

fn touch_cancel() as void { _send(fi, 7, cast(*u8, 0), 0); }

// --- The window's side ---

fn settle(ms as i64) as void {
    let is ie.Event as e;
    let is i64 as until = time.now_ms() + ms;
    while (time.now_ms() < until) {
        device.pump(&win);
        time.sleep_ms(5);
    }
}

// The next touch event within two seconds, into out: its kind, NONE for
// none; pointers counts the pointer's events seen meanwhile.
let is i32 as pointers with mut = 0;
fn next(out as *ie.Event) as i32 {
    let is i64 as until = time.now_ms() + 2000;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_input(&win, out) == 1) {
            if (out.kind >= ie.TOUCH_DOWN && out.kind <= ie.TOUCH_CANCEL) { return out.kind; }
            if (out.kind == ie.BUTTON_DOWN || out.kind == ie.BUTTON_UP) { pointers = pointers + 1; }
        }
        time.sleep_ms(5);
    }
    return ie.NONE;
}

fn near(a as i64, b as i64) as i32 { return cast(i32, a - b <= 2 && b - a <= 2); }

// inject <file>: no window of its own — once file exists (the program
// touched writes it when it fills the screen), the same fingers set down for
// it: down at 100,120, moved to 140,160, a second down at 300,300 and up, the
// first up; then down at 200,200 and cancelled.
fn inject(ready as *u8) as i32 {
    let is i64 as until = time.now_ms() + 30000;
    while (time.now_ms() < until && linux.open(ready, 0, 0) < 0) { time.sleep_ms(50); }
    if (fake_input() == 0) {
        io.printf("FAIL: no fake input to inject with\n");
        return 1;
    }
    time.sleep_ms(500);
    touch(4, 1, 100.0, 120.0);
    time.sleep_ms(300);
    touch(5, 1, 140.0, 160.0);
    time.sleep_ms(300);
    touch(4, 2, 300.0, 300.0);
    time.sleep_ms(300);
    touch(6, 2, 0.0, 0.0);
    time.sleep_ms(300);
    touch(6, 1, 0.0, 0.0);
    time.sleep_ms(300);
    touch(4, 3, 200.0, 200.0);
    time.sleep_ms(300);
    touch_cancel();
    time.sleep_ms(500);
    linux.close(fi_fd);
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (env.argc() > 2) { return inject(env.argv(2)); }
    let is i32 as x11 = cast(i32, env.argc() > 1);
    let is device.Config as c = device.config("touch", 400, 300);
    if (x11 == 1) { c.backend = device.X11; }
    win = device.open_config(&c);
    if (device.is_open(&win) == 0) {
        io.printf("FAIL: no window\n");
        return 1;
    }
    if (x11 == 1) {
        check("XI 2.2 on: touches selected", xinput.enable(&win.x11_win) == 1 && xinput.minor() >= 2);
    }
    device.set_fullscreen(&win, 1);
    let is i64 as until = time.now_ms() + 3000;
    while (device.width(&win) < 1000 && time.now_ms() < until) {
        device.next_frame(&win);
        let is tgt.Target as t = device.acquire(&win);
        if (cast(i64, t.color) != 0) { device.submit(&win); }
        settle(50);
    }
    check("filling the screen", device.width(&win) >= 1000);
    // A frame at that size, so the surface covers the screen where it is
    // touched.
    device.next_frame(&win);
    let is tgt.Target as full = device.acquire(&win);
    if (cast(i64, full.color) != 0) { device.submit(&win); }
    check("KWin's fake input bound", fake_input() == 1);
    settle(500);
    if (x11 == 0) {
        check("the seat a touchscreen's now: the window's touch object",
              win.wayland_win.touch != 0);
    }
    let is ie.Event as e;

    touch(4, 1, 100.0, 120.0);
    check("a finger down: its contact, where it is", next(&e) == ie.TOUCH_DOWN && near(e.x, 100) == 1 &&
          near(e.y, 120) == 1);
    let is i32 as first = e.contact;
    touch(5, 1, 140.0, 160.0);
    check("moved", next(&e) == ie.TOUCH_MOTION && e.contact == first && near(e.x, 140) == 1 && near(e.y, 160) == 1);
    touch(4, 2, 300.0, 300.0);
    check("a second, its own contact", next(&e) == ie.TOUCH_DOWN && e.contact != first && near(e.x, 300) == 1);
    let is i32 as second = e.contact;
    touch(6, 2, 0.0, 0.0);
    check("the second lifted", next(&e) == ie.TOUCH_UP && e.contact == second);
    touch(6, 1, 0.0, 0.0);
    check("the first lifted", next(&e) == ie.TOUCH_UP && e.contact == first);
    if (x11 == 0) {
        // X has no cancel a client can be sent: a touch another client takes
        // ends, and Xwayland sends nothing of KWin's cancel.
        touch(4, 3, 200.0, 200.0);
        check("down again", next(&e) == ie.TOUCH_DOWN);
        touch_cancel();
        check("cancelled: every finger gone", next(&e) == ie.TOUCH_CANCEL);
    }
    settle(300);
    check("no pointer button besides", pointers == 0);
    device.close(&win);
    if (fi_fd >= 0) { linux.close(fi_fd); }
    if (fails != 0) {
        io.printf("touch kwin (%d = on Xwayland): %d failures\n", cast(i64, x11), cast(i64, fails));
        return 1;
    }
    if (x11 == 1) { io.printf("touch kwin xwayland: all checks passed\n"); }
    else { io.printf("touch kwin: all checks passed\n"); }
    return 0;
}
