// window/keyboard_win32_test.cst — keys as a user presses them on Windows
// (here: an isolated Wine), sent with SendInput as a keyboard's:
//   sh window/win32/tools/run_native.sh build/keyboard_win32_test.exe
// The key a virtual key names, its place (the scan code), the system's repeat
// (a key down again while down), the text TranslateMessage makes of it, Caps
// Lock, Alt as WM_SYSKEYDOWN, Control's letter a command, and a Russian
// layout loaded and in use: the key and its shortcut stay the virtual key's
// Latin letter, so Ctrl+C is Ctrl+C. Wine translates SendInput's keys to
// text through the X server's keymap whatever layout is loaded, so the text
// a Russian or German layout types (AltGr's included) is left to real
// Windows; X11 and Wayland prove it through their own keyboards.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "device.cst" as device;
use "../input/event.cst" as ie;
use "../input/keys.cst" as keys;
use "win32/bind/types.cst" as t;
use "win32/bind/user32.cst" as u;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is device.Window as win with mut;
let is i64 as hwnd with mut = 0;
// The letters' virtual keys are their capitals' codes; winuser.h names none.
let is i64 as VK_A with imut = 65;
let is i64 as VK_C with imut = 67;
let is i64 as VK_F with imut = 70;
let is i64 as VK_Q with imut = 81;

// A key down (up 0) or up (1), by virtual key, as the keyboard sends it: its
// scan code with it, extended where the key is.
fn keybd(vk as i64, up as i32) as void {
    let is t.INPUT as in;
    mem.memzero(cast(*u8, &in), sizeof(t.INPUT));
    in.c_type = cast(u32, t.INPUT_KEYBOARD);
    let is *t.KEYBDINPUT as k = cast(*t.KEYBDINPUT, &in._anon1);
    k.wVk = cast(u16, vk);
    k.wScan = cast(u16, u.MapVirtualKeyW(cast(u32, vk), cast(u32, t.MAPVK_VK_TO_VSC)));
    let is i64 as flags with mut = 0;
    if (up == 1) { flags = flags | t.KEYEVENTF_KEYUP; }
    if (vk == t.VK_RMENU || vk == t.VK_RCONTROL) { flags = flags | t.KEYEVENTF_EXTENDEDKEY; }
    k.dwFlags = cast(u32, flags);
    u.SendInput(1, &in, cast(i32, sizeof(t.INPUT)));
}

fn tap(vk as i64) as void {
    keybd(vk, 0);
    keybd(vk, 1);
}

// The next input that is not a modifier key's, within a second: its kind,
// NONE for none.
fn next(out as *ie.Event) as i32 {
    let is i64 as until = time.now_ms() + 1000;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_input(&win, out) == 1) {
            let is i32 as k = out.key;
            if ((out.kind == ie.KEY_DOWN || out.kind == ie.KEY_UP) &&
                (k == keys.CONTROL_L || k == keys.CONTROL_R || k == keys.SHIFT_L || k == keys.ALT_L ||
                 k == keys.ALT_R || k == keys.CAPS_LOCK)) { continue; }
            if (out.kind == ie.MOTION || out.kind == ie.ENTER || out.kind == ie.LEAVE) { continue; }
            return out.kind;
        }
        time.sleep_ms(5);
    }
    return ie.NONE;
}

// No key down and no text within 200 ms: 1.
fn quiet() as i32 {
    let is ie.Event as e;
    let is i64 as until = time.now_ms() + 200;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_input(&win, &e) == 1) {
            if (e.kind == ie.TEXT) { return 0; }
        }
        time.sleep_ms(5);
    }
    return 1;
}

fn drain() as void {
    let is ie.Event as e;
    let is i64 as until = time.now_ms() + 200;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_input(&win, &e) == 1) { }
        time.sleep_ms(5);
    }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as k with mut = 0;
    while (b[k] != 0) { k = k + 1; }
    if (n != k) { return 0; }
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

// A keyboard layout loaded and put in use: KLID as Windows names it.
fn layout(klid as *u8) as i64 {
    let is [9]u16 as w;
    let is i64 as i with mut = 0;
    while (i < 8) { w[i] = cast(u16, klid[i]); i = i + 1; }
    w[8] = cast(u16, 0);
    let is i64 as hkl = u.LoadKeyboardLayoutW(&w[0], cast(u32, t.KLF_ACTIVATE));
    if (hkl != 0) { u.ActivateKeyboardLayout(hkl, 0); }
    drain();
    return hkl;
}

fn main() as i32 {
    win = device.open("keyboard", 200, 100);
    if (device.is_open(&win) == 0) {
        io.printf("FAIL: no window\n");
        return 1;
    }
    hwnd = win.win32_win.hwnd;
    device.next_frame(&win);
    u.SetForegroundWindow(hwnd);
    u.SetFocus(hwnd);
    drain();
    let is ie.Event as e;
    let is i64 as us = layout("00000409");
    check("US layout", us != 0);

    // --- A key: its name, its place, its text, its release ---
    keybd(VK_C, 0);
    let is i32 as scan = cast(i32, u.MapVirtualKeyW(cast(u32, VK_C), cast(u32, t.MAPVK_VK_TO_VSC)));
    check("c: the key c at its scan code", next(&e) == ie.KEY_DOWN && e.key == keys.C && e.shortcut == keys.C &&
          e.physical == scan && e.repeat == 0);
    check("typing c, the key's", next(&e) == ie.TEXT && e.from_key == 1 && same(e.text, e.text_len, "c") == 1);
    // Down again while down: the system's repeat (bit 30).
    keybd(VK_C, 0);
    check("down again while down: a repeat", next(&e) == ie.KEY_DOWN && e.key == keys.C && e.repeat == 1);
    check("typing again", next(&e) == ie.TEXT && same(e.text, e.text_len, "c") == 1);
    keybd(VK_C, 1);
    check("let go", next(&e) == ie.KEY_UP && e.key == keys.C);

    // --- Caps Lock ---
    tap(t.VK_CAPITAL);
    drain();
    tap(VK_A);
    check("Caps Lock on: the key a, locked", next(&e) == ie.KEY_DOWN && e.key == keys.A && (e.modifiers & keys.MOD_LOCK) != 0);
    check("typing A", next(&e) == ie.TEXT && same(e.text, e.text_len, "A") == 1);
    tap(t.VK_CAPITAL);
    drain();

    // --- Alt: WM_SYSKEYDOWN, a command ---
    keybd(t.VK_MENU, 0);
    tap(VK_F);
    keybd(t.VK_MENU, 1);
    check("Alt and f: the key f, Alt held", next(&e) == ie.KEY_DOWN && e.key == keys.F && (e.modifiers & keys.MOD_ALT) != 0);
    check("a command: no text", quiet() == 1);

    // --- Control and a letter: a command ---
    keybd(t.VK_CONTROL, 0);
    tap(VK_C);
    keybd(t.VK_CONTROL, 1);
    check("Ctrl+C", next(&e) == ie.KEY_DOWN && e.shortcut == keys.C && (e.modifiers & keys.MOD_CONTROL) != 0);
    check("no control character for text", quiet() == 1);

    // --- Russian: the virtual key's Latin letter, Ctrl+C still Ctrl+C ---
    let is i64 as ru = layout("00000419");
    check("a Russian layout", ru != 0 && u.GetKeyboardLayout(0) == ru);
    keybd(t.VK_CONTROL, 0);
    tap(VK_C);
    keybd(t.VK_CONTROL, 1);
    check("Ctrl+C in Russian: the shortcut c", next(&e) == ie.KEY_DOWN && e.key == keys.C && e.shortcut == keys.C &&
          (e.modifiers & keys.MOD_CONTROL) != 0);
    drain();
    tap(VK_C);
    check("c's key in Russian: the virtual key's, the shortcut c", next(&e) == ie.KEY_DOWN && e.key == keys.C &&
          e.shortcut == keys.C);
    drain();
    layout("00000409");

    device.close(&win);
    if (fails == 0) {
        io.printf("keyboard win32: all checks passed\n");
        return 0;
    }
    io.printf("keyboard win32: %d failures\n", fails);
    return 1;
}
