// window/cursor.cst — the pointer's shape over a window, portable.
//
// The shapes are CSS's, in the order Wayland's cursor-shape-v1 numbers them
// — the toolkit's tree.SHAPE_* are the same numbers — and NONE hides the
// pointer. Each platform gives each its own: on X11 the cursor of that name
// in the user's theme (the freedesktop cursor spec's names are CSS's), or
// the X cursor font's nearest glyph where the theme has none; on Wayland and
// Windows the device's own (cursor-shape-v1, the system cursors).
//
// Not imported by device.cst, as x11/cursor.cst is not by the X11 window:
// a program that sets the pointer's shape links libXcursor, libXfixes and
// libXi for it, and one that does not, does not. The X11 calls are Linux's
// only: a Windows build has none of them.
use "std/os.cst" as os;
use "device.cst" as device;
use "x11/x11.cst" as x11;
use "x11/cursor.cst" as xcursor;
use "xcursor.cst" as themes;
use "std/mem.cst" as mem;

let is i32 as DEFAULT       with imut = 1;
let is i32 as CONTEXT_MENU  with imut = 2;
let is i32 as HELP          with imut = 3;
let is i32 as POINTER       with imut = 4;
let is i32 as PROGRESS      with imut = 5;
let is i32 as WAIT          with imut = 6;
let is i32 as CELL          with imut = 7;
let is i32 as CROSSHAIR     with imut = 8;
let is i32 as TEXT          with imut = 9;
let is i32 as VERTICAL_TEXT with imut = 10;
let is i32 as ALIAS         with imut = 11;
let is i32 as COPY          with imut = 12;
let is i32 as MOVE          with imut = 13;
let is i32 as NO_DROP       with imut = 14;
let is i32 as NOT_ALLOWED   with imut = 15;
let is i32 as GRAB          with imut = 16;
let is i32 as GRABBING      with imut = 17;
let is i32 as E_RESIZE      with imut = 18;
let is i32 as N_RESIZE      with imut = 19;
let is i32 as NE_RESIZE     with imut = 20;
let is i32 as NW_RESIZE     with imut = 21;
let is i32 as S_RESIZE      with imut = 22;
let is i32 as SE_RESIZE     with imut = 23;
let is i32 as SW_RESIZE     with imut = 24;
let is i32 as W_RESIZE      with imut = 25;
let is i32 as EW_RESIZE     with imut = 26;
let is i32 as NS_RESIZE     with imut = 27;
let is i32 as NESW_RESIZE   with imut = 28;
let is i32 as NWSE_RESIZE   with imut = 29;
let is i32 as COL_RESIZE    with imut = 30;
let is i32 as ROW_RESIZE    with imut = 31;
let is i32 as ALL_SCROLL    with imut = 32;
let is i32 as ZOOM_IN       with imut = 33;
let is i32 as ZOOM_OUT      with imut = 34;
let is i32 as NONE          with imut = 35;

struct Cursors {
    x      as xcursor.State;
    shape  as i32;
    hidden as i32;
    // The theme and size last set (set_theme): the same again does nothing.
    theme  as [64]u8;
    size   as i64;
}

fn open(w as *device.Window) as Cursors {
    let is Cursors as c;
    c.shape = DEFAULT;
    c.hidden = 0;
    c.theme[0] = 0;
    c.size = 0;
    if (os.current() == os.OS_LINUX) {
        if (w.backend == device.X11) { xcursor.init(&c.x, x11.display(&w.x11_win)); }
    }
    return c;
}

fn close(c as *Cursors, w as *device.Window) as void {
    if (os.current() == os.OS_LINUX) {
        if (w.backend == device.X11) { xcursor.close(&c.x, x11.display(&w.x11_win)); }
    }
}

// The theme's name for shape: CSS's.
fn name(shape as i32) as *u8 { return themes.shape_name(shape); }

// The X cursor font's glyph (cursorfont.h) that is shape, for a theme that
// has it under neither of its names; 0 where no glyph is the same thing —
// progress, vertical text, alias, copy, no-drop, not-allowed, grab,
// grabbing, the diagonal two-way resizes, zoom — the shape then not there,
// said, rather than drawn as another.
fn glyph(shape as i32) as u32 {
    if (shape == DEFAULT) { return cast(u32, 68); }          // left_ptr
    if (shape == HELP) { return cast(u32, 92); }             // question_arrow
    if (shape == POINTER) { return cast(u32, 60); }          // hand2
    if (shape == WAIT) { return cast(u32, 150); }            // watch
    if (shape == CELL) { return cast(u32, 90); }             // plus
    if (shape == CROSSHAIR) { return cast(u32, 34); }        // crosshair
    if (shape == TEXT) { return cast(u32, 152); }            // xterm
    if (shape == MOVE || shape == ALL_SCROLL) { return cast(u32, 52); }   // fleur
    if (shape == E_RESIZE) { return cast(u32, 96); }         // right_side
    if (shape == N_RESIZE) { return cast(u32, 138); }        // top_side
    if (shape == NE_RESIZE) { return cast(u32, 136); }       // top_right_corner
    if (shape == NW_RESIZE) { return cast(u32, 134); }       // top_left_corner
    if (shape == S_RESIZE) { return cast(u32, 16); }         // bottom_side
    if (shape == SE_RESIZE) { return cast(u32, 14); }        // bottom_right_corner
    if (shape == SW_RESIZE) { return cast(u32, 12); }        // bottom_left_corner
    if (shape == W_RESIZE) { return cast(u32, 70); }         // left_side
    if (shape == EW_RESIZE || shape == COL_RESIZE) { return cast(u32, 108); }   // sb_h_double_arrow
    if (shape == NS_RESIZE || shape == ROW_RESIZE) { return cast(u32, 116); }   // sb_v_double_arrow
    return cast(u32, 0);
}

// The pointer over w in shape from now on: 1, or 0 when the platform has no
// such shape — the caller chooses another, nothing is put in its place here.
fn set(c as *Cursors, w as *device.Window, shape as i32) as i32 {
    if (shape < DEFAULT || shape > NONE) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == device.X11) { return _set_x11(c, w, shape); }
    if (device.cursor_set(w, shape) == 0) { return 0; }
    c.shape = shape;
    c.hidden = cast(i32, shape == NONE);
    return 1;
}

// The desktop's cursor theme and size (logical pixels; 0 or empty: the
// environment's) from now on, the pointer shown again from it: X11's made
// again through libXcursor; Wayland's, where the window draws it, from the
// theme's files; Windows' is the system's own.
fn set_theme(c as *Cursors, w as *device.Window, theme as *u8, size as i64) as void {
    // The same as before: nothing to make again.
    let is i64 as i with mut = 0;
    let is i32 as same with mut = cast(i32, size == c.size);
    while (same == 1 && i < 63) {
        let is u8 as a with mut = cast(u8, 0);
        if (cast(i64, theme) != 0) { a = theme[i]; }
        if (a != c.theme[i]) { same = 0; }
        if (a == cast(u8, 0)) { break; }
        i = i + 1;
    }
    if (same == 1) { return; }
    mem.memzero(cast(*u8, &c.theme[0]), 64);
    i = 0;
    while (cast(i64, theme) != 0 && i < 63 && theme[i] != 0) { c.theme[i] = theme[i]; i = i + 1; }
    c.size = size;
    if (os.current() == os.OS_LINUX && w.backend == device.X11) {
        xcursor.retheme(&c.x, x11.display(&w.x11_win), theme, size);
        if (c.hidden == 0) { _set_x11(c, w, c.shape); }
        return;
    }
    device.cursor_theme(w, theme, size);
}

fn _set_x11(c as *Cursors, w as *device.Window, shape as i32) as i32 {
    let is *u8 as d = x11.display(&w.x11_win);
    let is i64 as xid = x11.xid(&w.x11_win);
    if (shape == NONE) {
        xcursor.show(&c.x, d, xid, 0);
        c.shape = NONE;
        c.hidden = 1;
        return 1;
    }
    if (c.hidden == 1) {
        xcursor.show(&c.x, d, xid, 1);
        c.hidden = 0;
    }
    // The theme's CSS name, else its older X name, else the font's glyph.
    let is i64 as slot = cast(i64, shape - 1);
    if (xcursor.set_named(&c.x, d, xid, slot, name(shape), cast(u32, 0)) == 0) {
        let is *u8 as old = themes.legacy_name(shape);
        if (cast(i64, old) == 0 || xcursor.set_named(&c.x, d, xid, slot, old, cast(u32, 0)) == 0) {
            if (xcursor.set_named(&c.x, d, xid, slot, cast(*u8, 0), glyph(shape)) == 0) { return 0; }
        }
    }
    c.shape = shape;
    return 1;
}

fn shape(c as *Cursors) as i32 { return c.shape; }

fn hidden(c as *Cursors) as i32 { return c.hidden; }
