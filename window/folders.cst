// window/folders.cst — the user's folders as the platform names them.
//
//   Windows   its known folders (win32/known_folders.cst): moved by the
//             user, redirected to a server, named in the user's language
//   Linux     none here: they are in user-dirs.dirs, which
//             linux/user_dirs.cst reads against the home and config
//             folders the caller gives — so that a test can give its own —
//             and path answers 0
//
// A path comes back as UTF-8 with '/' between its parts, the toolkit's path
// everywhere (sys/file.cst): "C:/Users/me/Documents". A caller tests
// os.current() itself where it does more on one platform than another.
use "std/os.cst" as os;
use "win32/known_folders.cst" as known;

let is i32 as PROFILE      with imut = 0;
let is i32 as DESKTOP      with imut = 1;
let is i32 as DOCUMENTS    with imut = 2;
let is i32 as DOWNLOADS    with imut = 3;
let is i32 as MUSIC        with imut = 4;
let is i32 as PICTURES     with imut = 5;
let is i32 as VIDEOS       with imut = 6;
let is i32 as LOCAL_DATA   with imut = 7;   // a program's state on this computer
let is i32 as ROAMING_DATA with imut = 8;   // its settings, which follow the user

// Folder which into out, cap bytes with the NUL: its length, or 0 for none.
fn path(which as i32, out as *u8, cap as i64) as i64 {
    if (os.current() == os.OS_WINDOWS) { return known.path(which, out, cap); }
    return 0;
}

// The drive the system is on, "C:/", into out (cap bytes): its length, or 0
// where there are no drives.
fn system_drive(out as *u8, cap as i64) as i64 {
    if (os.current() == os.OS_WINDOWS) { return known.system_drive(out, cap); }
    return 0;
}
