// window/instance.cst — one instance of a program, where the platform's
// window system is how a later start finds the first.
//
//   Windows   a named mutex and a message-only window (win32/instance.cst)
//   Linux     none here: the session bus does it (ui/instance.cst asks for
//             the program's id there), so claim and send answer 0
//
// What is carried is a kind — a number the caller gives meaning to — and
// its bytes.
use "std/os.cst" as os;
use "win32/instance.cst" as w32;

// Heard by the instance: cb(user, kind, s, n), the n bytes at s valid only
// during the call.
type ReceiveFn = fn(*u8, u64, *u8, i64) as void;

struct Claim {
    native as w32.Claim;
}

// The instance of id, n bytes of UTF-8, claimed into c, which must not move
// while it is held: 1 when this start is it — what later starts send handed
// to on(user, …) — 0 when another start is, it could not be made, or the
// platform has no such thing. A caller tests os.current() itself, which the
// compiler folds, so that what it does on the other platforms is left out.
fn claim(c as *Claim, id as *u8, n as i64, on as ReceiveFn, user as *u8) as i32 {
    if (os.current() == os.OS_WINDOWS) { return w32.claim(&c.native, id, n, on, user); }
    return 0;
}

fn release(c as *Claim) as void {
    if (os.current() == os.OS_WINDOWS) { w32.release(&c.native); }
}

// kind, with the n bytes at s, sent to the instance of id (idn bytes): 1
// when it heard it, 0 when there is none.
fn send(id as *u8, idn as i64, kind as u64, s as *u8, n as i64) as i32 {
    if (os.current() == os.OS_WINDOWS) { return w32.send(id, idn, kind, s, n); }
    return 0;
}
