// window/display.cst — the screen a window is on: how many physical pixels
// a logical one is.
//
// The toolkit lays out in logical pixels, 96 to the inch, and draws at the
// window's scale. On X11 there is one DPI for the whole screen, as every X
// toolkit has it: Xft.dpi from the session's resources when the desktop sets
// it, else the primary monitor's physical size, else 96. (A live change
// comes through XSETTINGS' Xft/DPI, in the desktop's settings.) Wayland's
// scale is the output's the window is on, and Windows' the DPI of the
// monitor the window is on (per-monitor aware): both the device's.
// And whether a compositing manager shows what a window leaves transparent:
// once follow has been told of a window, a compositing manager starting or
// stopping on X11 arrives as a COMPOSITOR event (x11/compositor.cst); a
// connection opened anew, after every window closed, is followed with the
// next window told. Wayland's always composites, and Windows says so itself.
//
// Not imported by device.cst: reading the monitors links libXrandr, and
// following the compositor libXfixes, on Linux.
use "std/os.cst" as os;
use "device.cst" as device;
use "monitor.cst" as monitor;
use "x11/x11.cst" as x11;
use "x11/monitors.cst" as monitors;
use "x11/compositor.cst" as compositor;
use "wayland/backend.cst" as wayland;
use "win32/backend.cst" as win32;

struct Display {
    st as monitors.State;
}

fn open(w as *device.Window) as Display {
    let is Display as d;
    d.st.dpi = 96;
    refresh(&d, w);
    follow(&d, w);
    return d;
}

// Its compositing manager followed, with w's connection's: 1 when it is.
fn follow(d as *Display, w as *device.Window) as i32 {
    if (os.current() == os.OS_LINUX && w.ok == 1 && w.backend == device.X11) { return compositor.follow(&w.x11_win); }
    return 0;
}

fn close(d as *Display) as void { }

// The monitors and the DPI read again: the screen changed.
fn refresh(d as *Display, w as *device.Window) as void {
    if (os.current() == os.OS_WINDOWS) { d.st.dpi = cast(i64, device.scale_120(w)) * 96 / 120; }
    if (os.current() == os.OS_LINUX && w.backend == device.X11) {
        let is *u8 as xd = x11.display(&w.x11_win);
        monitors.refresh(&d.st, xd, x11.root(&w.x11_win));
        monitors.compute_dpi(&d.st, xd);
    }
}

fn dpi(d as *Display) as i64 { return monitors.dpi(&d.st); }

// Physical pixels per logical one in window w.
fn scale(d as *Display, w as *device.Window) as f64 {
    if (os.current() == os.OS_WINDOWS || w.backend == device.WAYLAND) { return cast(f64, device.scale_120(w)) / 120.0; }
    return monitors.scale(&d.st);
}

// The monitor window w is on, as its platform says it (monitor.cst): on X11
// the one showing most of it, its work area the window manager's
// (_NET_WORKAREA) within it; Wayland's the output the compositor says it
// entered; Windows' the one it is most on. 1 when known.
fn monitor_of(d as *Display, w as *device.Window, out as *monitor.Monitor) as i32 {
    monitor.clear(out);
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_WINDOWS && w.backend == device.WIN32) { return win32.monitor_of(&w.win32_win, out); }
    if (os.current() != os.OS_LINUX) { return 0; }
    if (w.backend == device.WAYLAND) { return wayland.monitor_of(w.wayland_win, out); }
    let is i64 as wx with mut = 0;
    let is i64 as wy with mut = 0;
    if (x11.position(&w.x11_win, &wx, &wy) == 0) { return 0; }
    let is monitors.Monitor as m;
    if (monitors.for_rect(&d.st, wx, wy, device.width(w), device.height(w), &m) == 0) { return 0; }
    out.x = m.x;
    out.y = m.y;
    out.width = m.width;
    out.height = m.height;
    monitor.work_is_whole(out);
    let is i64 as ax with mut = 0;
    let is i64 as ay with mut = 0;
    let is i64 as aw with mut = 0;
    let is i64 as ah with mut = 0;
    if (monitors.work_area(x11.display(&w.x11_win), x11.root(&w.x11_win), &ax, &ay, &aw, &ah) == 1) {
        // The desktop's, across every monitor: this one's part of it.
        let is i64 as left with mut = ax;
        if (m.x > left) { left = m.x; }
        let is i64 as top with mut = ay;
        if (m.y > top) { top = m.y; }
        let is i64 as right with mut = ax + aw;
        if (m.x + m.width < right) { right = m.x + m.width; }
        let is i64 as bottom with mut = ay + ah;
        if (m.y + m.height < bottom) { bottom = m.y + m.height; }
        if (right > left && bottom > top) {
            out.work_x = left;
            out.work_y = top;
            out.work_width = right - left;
            out.work_height = bottom - top;
        }
    }
    out.scale120 = cast(i32, monitors.scale(&d.st) * 120.0 + 0.5);
    out.primary = m.primary;
    out.refresh_mhz = m.refresh_mhz;
    monitor.set_name(out, &m.name[0], 32);
    return 1;
}
