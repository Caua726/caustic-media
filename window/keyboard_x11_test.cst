// window/keyboard_x11_test.cst — keys as a user presses them, through XTest
// (the server's own keyboard), in three layouts at once:
//   env X_LAYOUTS=us,ru,de sh window/x11/tools/run_headless.sh ./build/keyboard_x11_test
// Each layout an XKB group, locked in turn as a user switches layouts: the key
// is the layout's, the key a shortcut is matched against the Latin letter of
// the same key (Ctrl+C in Russian is Ctrl+C), Caps Lock types capitals,
// AltGr types its character with neither Control nor Alt held, and every
// press has its release.
use "std/io.cst" as io;
use "std/time.cst" as time;
use "device.cst" as device;
use "../input/event.cst" as ie;
use "../input/keys.cst" as keys;
use "x11/x11.cst" as x11;
use "x11/bind/xlib.cst" as xlib;
use "x11/bind/xkblib.cst" as xkblib;

extern "libXtst.so.6" fn XTestFakeKeyEvent(display as *u8, keycode as u32, is_press as i32, delay as u64) as i32;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is device.Window as win with mut;
let is *u8 as other with mut;

// The next input that is not a modifier key's, within a second: its kind,
// NONE for none.
fn next(out as *ie.Event) as i32 {
    let is i64 as until = time.now_ms() + 1000;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_input(&win, out) == 1) {
            let is i32 as k = out.key;
            if ((out.kind == ie.KEY_DOWN || out.kind == ie.KEY_UP) &&
                (k == keys.CONTROL_L || k == keys.SHIFT_L || k == keys.CAPS_LOCK || k == 65027)) { continue; }
            return out.kind;
        }
        time.sleep_ms(5);
    }
    return ie.NONE;
}

// Nothing more within 150 ms: 1.
fn quiet() as i32 {
    let is ie.Event as e;
    let is i64 as until = time.now_ms() + 150;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_input(&win, &e) == 1) {
            if (e.kind != ie.KEY_UP) { return 0; }
        }
        time.sleep_ms(5);
    }
    return 1;
}

fn drain() as void {
    let is ie.Event as e;
    let is i64 as until = time.now_ms() + 150;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_input(&win, &e) == 1) { }
        time.sleep_ms(5);
    }
}

fn code(keysym as i64) as u32 { return cast(u32, xlib.XKeysymToKeycode(other, keysym)); }

fn key(kc as u32, down as i32) as void {
    XTestFakeKeyEvent(other, kc, down, cast(u64, 0));
    xlib.XFlush(other);
}

fn group(g as u32) as void {
    xkblib.XkbLockGroup(other, cast(u32, 256), g);
    xlib.XSync(other, 0);
    drain();
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as k with mut = 0;
    while (b[k] != 0) { k = k + 1; }
    if (n != k) { return 0; }
    let is i64 as i with mut = 0;
    while (i < n) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() as i32 {
    win = device.open("keyboard", 200, 100);
    if (device.is_open(&win) == 0) {
        io.printf("FAIL: no window\n");
        return 1;
    }
    other = xlib.XOpenDisplay(cast(*u8, 0));
    let is u32 as c = code(99);
    let is u32 as a = code(97);
    let is u32 as q = code(113);
    check("three layouts loaded (setxkbmap -layout us,ru,de)",
          xkblib.XkbKeycodeToKeysym(other, cast(u8, c), 1, 0) == 1747 &&
          xkblib.XkbKeycodeToKeysym(other, cast(u8, q), 2, 0) == 113);
    xlib.XSetInputFocus(other, x11.xid(&win.x11_win), 1, 0);
    xlib.XSync(other, 0);
    drain();
    let is ie.Event as e;

    // --- US: the key, its text, its release ---
    group(cast(u32, 0));
    key(c, 1);
    check("c in US: the key c", next(&e) == ie.KEY_DOWN && e.key == keys.C && e.shortcut == keys.C &&
          e.physical == cast(i32, c) && e.repeat == 0);
    check("typing c", next(&e) == ie.TEXT && e.from_key == 1 && same(e.text, e.text_len, "c") == 1);
    key(c, 0);
    check("let go", next(&e) == ie.KEY_UP && e.key == keys.C);

    // --- Russian: the layout's key, the Latin shortcut ---
    group(cast(u32, 1));
    key(c, 1);
    check("c's key in Russian: Cyrillic es, its shortcut still c", next(&e) == ie.KEY_DOWN && e.key == 1747 &&
          e.shortcut == keys.C && e.physical == cast(i32, c));
    key(c, 0);
    check("its release, the same key", next(&e) == ie.KEY_UP && e.key == 1747 && e.shortcut == keys.C);
    let is u32 as ctrl = code(65507);
    key(ctrl, 1);
    key(c, 1);
    check("Control and it: Ctrl+C", next(&e) == ie.KEY_DOWN && e.key == 1747 && e.shortcut == keys.C &&
          (e.modifiers & keys.MOD_CONTROL) != 0);
    key(c, 0);
    key(ctrl, 0);
    check("a command: no text", quiet() == 1);
    key(a, 1);
    key(a, 0);
    check("a's key in Russian: Cyrillic ef, shortcut a", next(&e) == ie.KEY_DOWN && e.key == 1734 && e.shortcut == keys.A);
    drain();
    let is u32 as f1 = code(65470);
    key(f1, 1);
    key(f1, 0);
    check("a function key: itself in any layout", next(&e) == ie.KEY_DOWN && e.key == keys.F1 && e.shortcut == keys.F1);
    drain();

    // --- Caps Lock, in US ---
    group(cast(u32, 0));
    let is u32 as caps = code(65509);
    key(caps, 1);
    key(caps, 0);
    drain();
    key(a, 1);
    check("Caps Lock on: the key a, locked", next(&e) == ie.KEY_DOWN && e.key == keys.A && (e.modifiers & keys.MOD_LOCK) != 0);
    check("typing A", next(&e) == ie.TEXT && same(e.text, e.text_len, "A") == 1);
    key(a, 0);
    key(caps, 1);
    key(caps, 0);
    drain();

    // --- German: AltGr, level 3, is neither Control nor Alt ---
    group(cast(u32, 2));
    let is u32 as altgr = code(65027);
    check("AltGr in German", altgr != 0);
    key(altgr, 1);
    key(q, 1);
    check("AltGr and q: the q key, no command held", next(&e) == ie.KEY_DOWN && e.key == keys.Q &&
          (e.modifiers & (keys.MOD_CONTROL | keys.MOD_ALT | keys.MOD_SUPER)) == 0);
    check("typing @", next(&e) == ie.TEXT && same(e.text, e.text_len, "@") == 1);
    key(q, 0);
    key(altgr, 0);
    drain();
    group(cast(u32, 0));

    device.close(&win);
    xlib.XCloseDisplay(other);
    if (fails == 0) {
        io.printf("keyboard x11: all checks passed\n");
        return 0;
    }
    io.printf("keyboard x11: %d failures\n", fails);
    return 1;
}
