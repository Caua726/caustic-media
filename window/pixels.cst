// The software target's pixels turned, in place, into what a platform's
// 32-bit buffer reads: BGRA, premultiplied when it is read that way
// (gpu/bgra.cst). In place, a pixel must go through once only: twice swaps
// red and blue back.
use "../gpu/bgra.cst" as bgra;

fn to_bgra(base as i64, n as i64, premultiply as i32) as void { bgra.convert(base, base, n, premultiply); }
