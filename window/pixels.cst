// The software target's pixels, RGBA bytes with straight alpha, turned into
// what a platform's 32-bit buffer reads: BGRA bytes (0xAARRGGBB words), their
// colour premultiplied by alpha when the buffer is read that way. In place,
// so a pixel must go through once only: twice swaps red and blue back.
//
// Two pixels a word: alpha and green stay, red and blue trade places, and an
// opaque pair needs nothing more — premultiplied, it is what it was. Pixels
// that are not opaque, and the last of an odd count, go one at a time, each
// channel c * a / 255 rounded to nearest.

fn to_bgra(base as i64, n as i64, premultiply as i32) as void {
    let is i64 as ag = (4278255360 << 32) | 4278255360;   // 0xFF00FF00 in each half
    let is i64 as rb = (255 << 32) | 255;
    let is i64 as alphas = (4278190080 << 32) | 4278190080; // 0xFF000000 in each half
    let is i64 as i with mut = 0;
    while (i + 1 < n) {
        let is *i64 as at = cast(*i64, base + i * 4);
        let is i64 as p = *at;
        if (premultiply == 0 || (p & alphas) == alphas) {
            *at = (p & ag) | ((p & rb) << 16) | ((p >> 16) & rb);
        } else {
            _one(base + i * 4, premultiply);
            _one(base + i * 4 + 4, premultiply);
        }
        i = i + 2;
    }
    if (i < n) { _one(base + i * 4, premultiply); }
}

fn _one(at as i64, premultiply as i32) as void {
    let is i64 as p = cast(i64, *cast(*i32, at)) & 4294967295;
    let is i64 as r with mut = p & 255;
    let is i64 as g with mut = (p >> 8) & 255;
    let is i64 as bl with mut = (p >> 16) & 255;
    let is i64 as a = (p >> 24) & 255;
    if (premultiply == 1 && a < 255) {
        r = (r * a + 127) / 255;
        g = (g * a + 127) / 255;
        bl = (bl * a + 127) / 255;
    }
    *cast(*i32, at) = cast(i32, (a << 24) | (r << 16) | (g << 8) | bl);
}
