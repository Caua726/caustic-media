// window/xcursor_test.cst — the own Xcursor reader (xcursor.cst) against
// libXcursor: every installed theme's cursors, by every CSS and X core name,
// at many sizes — the file found, the nominal size taken, each frame's size,
// hot spot, delay and pixels — and then themes written here to inherit one
// another, the order a name is looked for in. Run with the system's themes
// and the ones written here alone on the path:
//   env XCURSOR_PATH=/usr/share/icons:$PWD/build/xcursor-themes HOME=/nonexistent ./build/xcursor_test
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/env.cst" as env;
use "xcursor.cst" as xcursor;
use "cursor_files.cst" as files;
use "x11/bind/xcursor.cst" as xc;

let is i32 as fails with mut = 0;
let is i32 as shown with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

// libXcursor's XcursorImage and XcursorImages.
struct XImage {
    version as u32;
    size    as u32;
    width   as u32;
    height  as u32;
    xhot    as u32;
    yhot    as u32;
    delay   as u32;
    _pad    as u32;
    pixels  as *u32;
}

struct XImages {
    nimage as i32;
    _pad   as i32;
    images as **XImage;
    name   as *u8;
}

let is i64 as compared with mut = 0;

// Both readers' cursor name of theme at size: 1 when they agree.
fn same(theme as *u8, name as *u8, size as i32) as i32 {
    let is xcursor.Cursor as own with mut;
    let is i32 as got = xcursor.load(theme, name, size, &own);
    let is *XImages as ref = cast(*XImages, xc.XcursorLibraryLoadImages(name, theme, size));
    let is i32 as ok with mut = 1;
    if ((got == 1) != (cast(i64, ref) != 0)) {
        ok = 0;
    } else if (got == 1) {
        if (own.count != ref.nimage) { ok = 0; }
        let is i32 as i with mut = 0;
        while (ok == 1 && i < own.count) {
            let is *xcursor.Frame as f = &own.frames[i];
            let is *XImage as r = ref.images[i];
            if (cast(u32, f.width) != r.width || cast(u32, f.height) != r.height || cast(u32, f.xhot) != r.xhot ||
                cast(u32, f.yhot) != r.yhot || cast(u32, f.delay) != r.delay || cast(u32, f.size) != r.size ||
                mem.memcmp(cast(*u8, f.pixels), cast(*u8, r.pixels), cast(i64, r.width) * cast(i64, r.height) * 4) != 0) {
                ok = 0;
            }
            i = i + 1;
        }
        compared = compared + 1;
    }
    if (ok == 0) {
        fails = fails + 1;
        if (shown < 20) {
            io.printf("  differ: %s in %s at %d (own %d frames, libXcursor %d)\n", name, theme, cast(i64, size),
                      cast(i64, own.count), cast(i64, ref) != 0);
            shown = shown + 1;
        }
    }
    if (got == 1) { xcursor.free(&own); }
    if (cast(i64, ref) != 0) { xc.XcursorImagesDestroy(cast(*u8, ref)); }
    return ok;
}

// --- Themes written here ---

// A cursor file of one 4x4 image of argb at nominal size 24, hot spot 1, 2.
fn write_cursor(path as *u8, argb as u32) as void {
    files.image(24, 4, 1, 2, 50, argb);
    files.save(path);
}

// The written themes' root: the XCURSOR_PATH entry after the first.
let is [512]u8 as root with mut;

fn at(rel as *u8) as *u8 { return files.under(&root[0], rel); }

fn written_themes() as void {
    let is *u8 as path = env.getenv("XCURSOR_PATH");
    if (cast(i64, path) == 0) { check("XCURSOR_PATH set", 0); return; }
    let is i64 as i with mut = 0;
    while (path[i] != 0 && path[i] != 58) { i = i + 1; }
    if (path[i] != 58) { check("a second XCURSOR_PATH entry for written themes", 0); return; }
    let is i64 as n with mut = 0;
    i = i + 1;
    while (path[i] != 0 && path[i] != 58 && n < 500) { root[n] = path[i]; n = n + 1; i = i + 1; }
    root[n] = 0;
    // child inherits parenta then parentb, written with separators and
    // spaces; parenta inherits grand. "g" is grand's and parentb's: depth
    // first, grand's.
    files.theme_dirs(&root[0], "child");
    files.theme_dirs(&root[0], "parenta");
    files.theme_dirs(&root[0], "parentb");
    files.theme_dirs(&root[0], "grand");
    files.write_text(at("child/index.theme"), "[Icon Theme]\nName=child\nInherits = parenta ;parentb,\n");
    files.write_text(at("parenta/index.theme"), "[Icon Theme]\nInherits=grand\n");
    write_cursor(at("child/cursors/c"), 4278190335);
    write_cursor(at("parenta/cursors/a"), 4278255360);
    write_cursor(at("parentb/cursors/b"), 4294901760);
    write_cursor(at("parentb/cursors/g"), 4294967295);
    write_cursor(at("grand/cursors/g"), 4278255615);
    let is i32 as before = fails;
    check("a theme's own cursor", same("child", "c", 24));
    check("its first parent's", same("child", "a", 24));
    check("its second parent's", same("child", "b", 24));
    check("depth first: the grandparent's before the second parent's", same("child", "g", 24));
    check("none of them: the default theme's", same("child", "default", 24));
    check("an unknown theme: the default theme's", same("no-such-theme", "text", 24));
    let is xcursor.Cursor as g with mut;
    check("the grandparent's colour, not the second parent's",
          xcursor.load("child", "g", 24, &g) == 1 && g.frames[0].pixels[0] == cast(u32, 4278255615) &&
          g.frames[0].xhot == 1 && g.frames[0].yhot == 2 && g.frames[0].delay == 50);
    xcursor.free(&g);
    check("written themes as libXcursor reads them", cast(i32, fails == before));
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i32 as before = fails;
    let is *u8 as themes = "breeze_cursors Breeze_Light KDE_Classic Oxygen_White elementary default";
    let is [16]i32 as sizes with mut;
    sizes[0] = 16; sizes[1] = 24; sizes[2] = 30; sizes[3] = 32; sizes[4] = 48; sizes[5] = 64; sizes[6] = 96;
    let is i64 as t with mut = 0;
    while (themes[t] != 0) {
        let is [64]u8 as theme with mut;
        let is i64 as n with mut = 0;
        while (themes[t] != 0 && themes[t] != 32) { theme[n] = themes[t]; n = n + 1; t = t + 1; }
        theme[n] = 0;
        if (themes[t] == 32) { t = t + 1; }
        let is i32 as shape with mut = 1;
        while (shape <= 34) {
            let is i32 as s with mut = 0;
            while (s < 7) {
                same(&theme[0], xcursor.shape_name(shape), sizes[s]);
                let is *u8 as old = xcursor.legacy_name(shape);
                if (cast(i64, old) != 0) { same(&theme[0], old, sizes[s]); }
                s = s + 1;
            }
            shape = shape + 1;
        }
    }
    io.printf("  %d cursors compared\n", compared);
    check("every installed theme's cursors as libXcursor reads them", cast(i32, fails == before && compared > 1000));
    written_themes();
    if (fails == 0) {
        io.printf("xcursor: all checks passed\n");
        return 0;
    }
    io.printf("xcursor: %d failures\n", fails);
    return 1;
}
