// window/window.cst — hub for the portable window layer.
//
//   use "caustic-media/window/window.cst" as window;
//   use "caustic-media/gpu/software/target.cst" as tgt;
//
//   let is window.device.Window as w = window.open("App", 1280, 720);
//   while (window.next_frame(&w) == 1) {
//       let is tgt.Target as t = window.acquire(&w);
//       if (t.width == 0) { continue; }
//       // draw into t
//       window.submit(&w);
//   }
//   window.close(&w);
//
// Submodules:
//   device    the portable window struct, lifecycle, and sampled state
//   keys      key constants and modifier masks
//   event     portable event types and queue decoding
//   native    raw handles for swapchain / Vulkan / OpenGL integration

use "../gpu/software/target.cst" as tgt;
use "../gpu/swapchain.cst" as swapchain;
use "device.cst" as device;
use "keys.cst" as keys;
use "event.cst" as event;
use "settings.cst" as settings;
use "native.cst" as native;

// --- Backends ---

let is i32 as AUTO    with imut = cast(i32, 0 - 1);
let is i32 as X11     with imut = 0;
let is i32 as WAYLAND with imut = 1;
let is i32 as KMS     with imut = 2;
let is i32 as WIN32   with imut = 3;

fn backend_name(id as i32) as *u8 { return device.backend_name(id); }
fn available(id as i32) as i32 { return device.available(id); }

// --- Errors ---

let is i32 as OK           with imut = 0;
let is i32 as NO_BACKEND   with imut = 1;
let is i32 as NO_DISPLAY   with imut = 2;
let is i32 as NO_VISUAL    with imut = 3;
let is i32 as NO_WINDOW    with imut = 4;
let is i32 as NO_GC        with imut = 5;
let is i32 as NO_MEMORY    with imut = 6;
let is i32 as NO_SURFACE   with imut = 7;
let is i32 as BAD_ARGUMENT with imut = 8;
let is i32 as CLOSED       with imut = 9;

fn error_name(code as i32) as *u8 { return device.error_name(code); }

// --- Opening & Configuration ---

fn config(title as *u8, width as i64, height as i64) as device.Config {
    return device.config(title, width, height);
}

fn config_fixed(title as *u8, width as i64, height as i64) as device.Config {
    return device.config_fixed(title, width, height);
}

fn open(title as *u8, width as i64, height as i64) as device.Window {
    return device.open(title, width, height);
}

fn open_with(backend as i32, title as *u8, width as i64, height as i64) as device.Window {
    return device.open_with(backend, title, width, height);
}

fn open_config(c as *device.Config) as device.Window {
    return device.open_config(c);
}

fn close(w as *device.Window) as void { device.close(w); }
fn is_open(w as *device.Window) as i32 { return device.is_open(w); }
fn last_error(w as *device.Window) as i32 { return device.last_error(w); }

// --- Frame lifecycle ---

fn next_frame(w as *device.Window) as i32 { return device.next_frame(w); }
fn acquire(w as *device.Window) as tgt.Target { return device.acquire(w); }
fn submit(w as *device.Window) as void { device.submit(w); }

// --- Geometry and State ---

fn width(w as *device.Window) as i64 { return device.width(w); }
fn height(w as *device.Window) as i64 { return device.height(w); }
fn resized(w as *device.Window) as i32 { return device.resized(w); }
fn should_close(w as *device.Window) as i32 { return device.should_close(w); }
fn request_close(w as *device.Window) as void { device.request_close(w); }
fn transport_name(w as *device.Window) as *u8 { return device.transport_name(w); }

// --- Sampled Input ---

fn key_down(w as *device.Window, key as i32) as i32 { return device.key_down(w, key); }
fn button_down(w as *device.Window, button as i32) as i32 { return device.button_down(w, button); }
fn mouse_x(w as *device.Window) as i64 { return device.mouse_x(w); }
fn mouse_y(w as *device.Window) as i64 { return device.mouse_y(w); }
fn mouse_dx(w as *device.Window) as i64 { return device.mouse_dx(w); }
fn mouse_dy(w as *device.Window) as i64 { return device.mouse_dy(w); }
fn wheel(w as *device.Window) as i64 { return device.wheel(w); }

// --- Event Queue ---

fn poll_event(w as *device.Window, out as *event.Event) as i32 {
    return device.poll_event(w, out);
}

// The desktop's settings; see device.read_settings.
fn read_settings(w as *device.Window, out as *settings.Settings) as i32 {
    return device.read_settings(w, out);
}

// --- GPU Surface Integration ---

fn surface_for_gpu(w as *device.Window, present as *u8, user as *u8) as swapchain.Surface {
    return device.surface_for_gpu(w, present, user);
}

fn surface_for_gpu_shared(w as *device.Window) as swapchain.Surface {
    return device.surface_for_gpu_shared(w);
}
