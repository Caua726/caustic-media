// window/open.cst — a link or a file opened the platform's own way, with no
// portal between: the program the desktop has for it.
//
//   Windows   the shell (win32/shell_open.cst), above the asking window
//   Linux     xdg-open, the freedesktop command for it, run with the link
//             as one argument, never read by a shell as words
//
// The asking window is named as a portal names it — "win32:<HWND>" on
// Windows (ui/host.cst's parent_handle) — and only Windows' shell uses it.
// A caller tests os.current() itself where it does more on one platform
// than another, as ui/open_uri.cst asks the portal first on Linux.
use "std/os.cst" as os;
use "std/env.cst" as env;
use "std/os/linux.cst" as linux;
use "win32/shell_open.cst" as w32;

fn _hex(c as u8) as i64 {
    if (c >= 48 && c <= 57) { return cast(i64, c) - 48; }
    if (c >= 97 && c <= 102) { return cast(i64, c) - 87; }
    if (c >= 65 && c <= 70) { return cast(i64, c) - 55; }
    return 0 - 1;
}

// The HWND named by parent, pn bytes, "win32:<hex>": 0 for none or another.
fn hwnd_of(parent as *u8, pn as i64) as i64 {
    if (pn <= 6 || pn > 22) { return 0; }
    if (parent[0] != 119 || parent[1] != 105 || parent[2] != 110 || parent[3] != 51 || parent[4] != 50 || parent[5] != 58) {
        return 0;
    }
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 6;
    while (i < pn) {
        let is i64 as d = _hex(parent[i]);
        if (d < 0) { return 0; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

// what, zero-terminated — a URI, or on Windows a file's own path — opened
// for the window parent names (pn bytes; 0 for none): 1 when it was handed
// over, 0 when there was nobody to hand it to.
fn open(what as *u8, parent as *u8, pn as i64) as i32 {
    if (os.current() == os.OS_WINDOWS) { return w32.open(what, hwnd_of(parent, pn)); }
    if (os.current() == os.OS_LINUX) { return _xdg_open(what); }
    return 0;
}

// Handed to xdg-open, if there is one, which goes on alone.
fn _xdg_open(what as *u8) as i32 {
    // The shell only finds it and leaves it running: the link is its first
    // argument, "$1", never part of the command.
    let is [6]*u8 as argv;
    argv[0] = "sh";
    argv[1] = "-c";
    argv[2] = "command -v xdg-open >/dev/null 2>&1 || exit 127; xdg-open \"$1\" </dev/null & exit 0";
    argv[3] = "sh";
    argv[4] = what;
    argv[5] = cast(*u8, 0);
    let is i64 as pid = linux.fork();
    if (pid == 0) {
        linux.execve("/bin/sh", cast(*u8, &argv), env.envp());
        linux.exit(126);
    }
    if (pid < 0) { return 0; }
    let is i32 as status with mut = 0 - 1;
    linux.wait4(pid, &status, 0, cast(*u8, 0));
    return cast(i32, status == 0);
}
