// window/device_x11_test.cst — what the toolkit's loop asks of a window,
// through the portable device, under Xvfb:
//   sh window/x11/tools/run_headless.sh ./build/device_x11_test
// The text a key press types, the title in UTF-8, shown and hidden, where it
// is on the screen, the clipboard and the primary selection, the window
// manager's state of it. Another client plays the user and the window
// manager on a connection of its own.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "window.cst" as window;
use "device.cst" as device;
use "event.cst" as event;
use "keys.cst" as keys;
use "x11/x11.cst" as x11;
use "x11/bind/xlib.cst" as xlib;
use "x11/bind/x.cst" as x;
use "x11/bind/xevent.cst" as xev;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as k with mut = 0;
    while (b[k] != 0) { k = k + 1; }
    if (n != k) { return 0; }
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

let is device.Window as win with mut;
let is *u8 as other with mut;
let is i64 as xid with mut = 0;

// The next event of kind, within a second, into out: 1 when there was one.
fn next(kind as i32, out as *event.Event) as i32 {
    let is i64 as until = time.now_ms() + 1000;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_event(&win, out) == 1) {
            if (out.kind == kind) { return 1; }
        }
        time.sleep_ms(5);
    }
    return 0;
}

fn drain() as void {
    let is i64 as until = time.now_ms() + 200;
    let is event.Event as e;
    while (time.now_ms() < until) {
        device.pump(&win);
        while (device.poll_event(&win, &e) == 1) { }
        time.sleep_ms(5);
    }
}

// A key pressed by the user: keysym, with the modifier state.
fn press(keysym as i64, state as u32) as void {
    let is xev.XEvent as m;
    xev.clear(&m);
    let is *xev.XKeyEvent as k = xev.key(&m);
    k.kind = x.KeyPress;
    k.display = other;
    k.window = xid;
    k.root = xlib.XDefaultRootWindow(other);
    k.x = 5; k.y = 5;
    k.state = state;
    k.keycode = cast(u32, xlib.XKeysymToKeycode(other, keysym));
    k.same_screen = 1;
    xlib.XSendEvent(other, xid, 0, x.KeyPressMask, cast(*u8, &m));
    xlib.XFlush(other);
}

// A button pressed by the user at 5, 5, with the modifier state.
fn click(button as u32, state as u32) as void {
    let is xev.XEvent as m;
    xev.clear(&m);
    let is *xev.XButtonEvent as b = xev.button(&m);
    b.kind = x.ButtonPress;
    b.display = other;
    b.window = xid;
    b.root = xlib.XDefaultRootWindow(other);
    b.x = 5; b.y = 5;
    b.state = state;
    b.button = button;
    b.same_screen = 1;
    xlib.XSendEvent(other, xid, 0, x.ButtonPressMask, cast(*u8, &m));
    xlib.XFlush(other);
}

let is i64 as _type with mut = 0;
let is i32 as _format with mut = 0;
let is i64 as _n with mut = 0;
let is i64 as _after with mut = 0;
let is *u8 as _data with mut;

// Property p of the window as another client reads it, as bytes: whether it
// is want, of type ty. The window's own connection is synced first: the
// server answers two clients in no order of theirs, so a request flushed on
// one is not yet done when the other asks.
fn prop_is(p as *u8, ty as *u8, want as *u8, wn as i64) as i32 {
    _data = cast(*u8, 0);
    xlib.XSync(win.x11_win.display, 0);
    let is i64 as pa = xlib.XInternAtom(other, p, 0);
    if (xlib.XGetWindowProperty(other, xid, pa, 0, 64, 0, 0, cast(*u8, &_type), cast(*u8, &_format), cast(*u8, &_n),
                                cast(*u8, &_after), cast(*u8, &_data)) != 0) { return 0; }
    if (cast(i64, _data) == 0) { return 0; }
    let is i32 as ok = cast(i32, _type == xlib.XInternAtom(other, ty, 0) && _format == 8 && _n == wn &&
                       mem.memcmp(_data, want, wn) == 0);
    xlib.XFree(_data);
    return ok;
}

fn mapped() as i32 {
    let is xlib.XWindowAttributes as wa;
    xlib.XSync(win.x11_win.display, 0);
    xlib.XSync(other, 0);
    xlib.XGetWindowAttributes(other, xid, cast(*u8, &wa));
    return cast(i32, wa.map_state != 0);
}


// A client message of kind the window manager — the other client — was sent
// about window w, its five longs into longs: 1, or 0 when none came.
let is [5]i64 as longs with mut;

fn told_wm(kind as *u8, w as i64) as i32 {
    let is i64 as want = xlib.XInternAtom(other, kind, 0);
    xlib.XSync(other, 0);
    let is i64 as until = time.now_ms() + 1000;
    while (time.now_ms() < until) {
        while (xlib.XPending(other) > 0) {
            let is xev.XEvent as ce;
            xlib.XNextEvent(other, cast(*u8, &ce));
            if (xev.kind(&ce) == x.ClientMessage && xev.client(&ce).message_type == want && xev.client(&ce).window == w) {
                let is i64 as k with mut = 0;
                while (k < 5) {
                    longs[k] = xev.client(&ce).data[k];
                    k = k + 1;
                }
                return 1;
            }
        }
        time.sleep_ms(5);
    }
    return 0;
}

// Window w's map held by the window manager — the other client — and
// asked of it: 1 when it was, within a second.
fn map_held(w as i64) as i32 {
    xlib.XSync(other, 0);
    let is i64 as until = time.now_ms() + 1000;
    while (time.now_ms() < until) {
        while (xlib.XPending(other) > 0) {
            let is xev.XEvent as ce;
            xlib.XNextEvent(other, cast(*u8, &ce));
            if (xev.kind(&ce) == x.MapRequest && xev.map_request(&ce).window == w) { return 1; }
        }
        time.sleep_ms(5);
    }
    return 0;
}

// The longs of property p of window w, into longs: how many. Every window of
// the program shares win's connection: synced first, as in prop_is.
fn longs_of(w as i64, p as *u8) as i64 {
    _data = cast(*u8, 0);
    xlib.XSync(win.x11_win.display, 0);
    xlib.XSync(other, 0);
    xlib.XGetWindowProperty(other, w, xlib.XInternAtom(other, p, 0), 0, 5, 0, 0, cast(*u8, &_type), cast(*u8, &_format),
                            cast(*u8, &_n), cast(*u8, &_after), cast(*u8, &_data));
    let is i64 as k with mut = 0;
    while (k < _n && k < 5) {
        longs[k] = *cast(*i64, cast(i64, _data) + k * 8);
        k = k + 1;
    }
    if (cast(i64, _data) != 0) { xlib.XFree(_data); }
    return _n;
}

fn main() as i32 {
    win = window.open("devices", 200, 100);
    if (window.is_open(&win) == 0) {
        io.printf("FAIL: no window\n");
        return 1;
    }
    xid = x11.xid(&win.x11_win);
    other = xlib.XOpenDisplay(cast(*u8, 0));
    drain();

    // --- Text a key types ---
    let is event.Event as e;
    press(97, cast(u32, 0));
    check("a key press: the text it types", next(event.KEY_DOWN, &e) == 1 && same(e.text, e.text_len, "a") == 1);
    press(97, cast(u32, 1));
    check("shifted", next(event.KEY_DOWN, &e) == 1 && same(e.text, e.text_len, "A") == 1);
    press(65361, cast(u32, 0));
    check("an arrow: no text", next(event.KEY_DOWN, &e) == 1 && e.text_len == 0);
    press(233, cast(u32, 0));
    check("é: its UTF-8", next(event.KEY_DOWN, &e) == 1 && (xlib.XKeysymToKeycode(other, 233) == 0 ||
          same(e.text, e.text_len, "é") == 1));
    // The modifiers held, as the portable keys name them, whatever X's bits.
    press(97, cast(u32, x.ControlMask));
    check("Control", next(event.KEY_DOWN, &e) == 1 && e.modifiers == keys.MOD_CONTROL);
    press(97, cast(u32, x.ControlMask | x.ShiftMask));
    check("Control and Shift", next(event.KEY_DOWN, &e) == 1 && e.modifiers == (keys.MOD_CONTROL | keys.MOD_SHIFT));
    press(97, cast(u32, x.Mod1Mask));
    check("Alt", next(event.KEY_DOWN, &e) == 1 && e.modifiers == keys.MOD_ALT);
    press(97, cast(u32, x.Mod4Mask));
    check("Super", next(event.KEY_DOWN, &e) == 1 && e.modifiers == keys.MOD_SUPER);
    press(97, cast(u32, x.LockMask));
    check("Caps Lock", next(event.KEY_DOWN, &e) == 1 && e.modifiers == keys.MOD_LOCK);
    press(97, cast(u32, x.Mod2Mask));
    check("Num Lock: none of them", next(event.KEY_DOWN, &e) == 1 && e.modifiers == 0);
    click(cast(u32, 1), cast(u32, x.ControlMask | x.Mod1Mask));
    check("a press, with Control and Alt", next(event.MOUSE_DOWN, &e) == 1 && e.modifiers == (keys.MOD_CONTROL | keys.MOD_ALT));
    click(cast(u32, 5), cast(u32, x.ShiftMask | x.Mod4Mask));
    check("the wheel, with Shift and Super", next(event.WHEEL, &e) == 1 && e.wheel == 0 - 1 &&
          e.modifiers == (keys.MOD_SHIFT | keys.MOD_SUPER));

    // --- Its title, in UTF-8 ---
    check("titled as it was opened", prop_is("_NET_WM_NAME", "UTF8_STRING", "devices", 7) == 1 &&
          prop_is("WM_NAME", "STRING", "devices", 7) == 1);
    device.set_title(&win, "", 0);
    check("an empty title", prop_is("_NET_WM_NAME", "UTF8_STRING", "", 0) == 1);
    device.set_title(&win, "Área de trabalho", 17);
    xlib.XSync(other, 0);
    check("the title as UTF-8", prop_is("_NET_WM_NAME", "UTF8_STRING", "Área de trabalho", 17) == 1);
    let is [16]u8 as latin;
    latin[0] = cast(u8, 193);
    mem.memcpy(cast(*u8, cast(i64, &latin) + 1), "rea de trabalho", 15);
    check("and as Latin-1 for an older window manager", prop_is("WM_NAME", "STRING", cast(*u8, &latin), 16) == 1);
    device.set_title(&win, "日本", 6);
    let is [2]u8 as q;
    q[0] = cast(u8, 63);
    q[1] = cast(u8, 63);
    check("what Latin-1 has not: asked", prop_is("WM_NAME", "STRING", cast(*u8, &q), 2) == 1 &&
          prop_is("_NET_WM_NAME", "UTF8_STRING", "日本", 6) == 1);
    // Each sequence whole or a '?': two bytes past Latin-1, four, a lone
    // continuation, a lead cut short, an overlong form, one at the end.
    let is [16]u8 as odd;
    odd[0] = cast(u8, 196); odd[1] = cast(u8, 129);                          // ā
    odd[2] = cast(u8, 240); odd[3] = cast(u8, 159); odd[4] = cast(u8, 152); odd[5] = cast(u8, 128);   // an emoji
    odd[6] = cast(u8, 128);                                                  // a lone continuation
    odd[7] = cast(u8, 195); odd[8] = cast(u8, 65);                           // a lead, then not a continuation
    odd[9] = cast(u8, 193); odd[10] = cast(u8, 129);                         // overlong
    odd[11] = cast(u8, 195); odd[12] = cast(u8, 169);                        // é
    odd[13] = cast(u8, 226); odd[14] = cast(u8, 130);                        // three bytes cut short
    device.set_title(&win, cast(*u8, &odd), 15);
    let is [16]u8 as want;
    mem.memcpy(cast(*u8, &want), "????A??", 7);
    want[7] = cast(u8, 233);
    want[8] = cast(u8, 63);
    want[9] = cast(u8, 63);
    check("in Latin-1, sequence by sequence", prop_is("WM_NAME", "STRING", cast(*u8, &want), 10) == 1);
    // The first two-byte lead, the first three-byte one, one past the last
    // four-byte one, a three-byte sequence whose second continuation is not.
    let is [12]u8 as more;
    more[0] = cast(u8, 194); more[1] = cast(u8, 176);                          // °
    more[2] = cast(u8, 224); more[3] = cast(u8, 160); more[4] = cast(u8, 128); // U+0800
    more[5] = cast(u8, 245); more[6] = cast(u8, 128); more[7] = cast(u8, 128); more[8] = cast(u8, 128);
    more[9] = cast(u8, 226); more[10] = cast(u8, 130); more[11] = cast(u8, 65);
    device.set_title(&win, cast(*u8, &more), 12);
    let is [10]u8 as want2;
    want2[0] = cast(u8, 176);
    mem.memcpy(cast(*u8, cast(i64, &want2) + 1), "???????A", 8);
    check("each lead as long as it says", prop_is("WM_NAME", "STRING", cast(*u8, &want2), 9) == 1);
    device.set_title(&win, cast(*u8, &odd), 15);

    // --- Shown, hidden ---
    check("shown at first", mapped() == 1);
    device.hide(&win);
    check("hidden", mapped() == 0);
    device.show(&win);
    check("shown again", mapped() == 1);
    drain();

    // --- Where it is ---
    xlib.XMoveWindow(other, xid, 40, 30);
    xlib.XSync(other, 0);
    drain();
    let is i64 as px with mut = 0;
    let is i64 as py with mut = 0;
    check("where it is on the screen", device.position(&win, &px, &py) == 1 && px == 40 && py == 30);

    // --- The clipboard and the primary selection ---
    check("copied", device.clipboard_set(&win, device.CLIPBOARD, "olá", 4) == 1);
    check("asked for", device.clipboard_request(&win, device.CLIPBOARD) == 1 && device.clipboard_pending(&win) == 1 &&
          device.clipboard_ready(&win) == 0);
    let is i64 as until with mut = time.now_ms() + 1000;
    while (device.clipboard_ready(&win) == 0 && time.now_ms() < until) {
        device.pump(&win);
        time.sleep_ms(5);
    }
    let is [16]u8 as got;
    let is i64 as gn with mut = device.clipboard_text(&win, cast(*u8, &got), 16);
    check("and there", device.clipboard_ready(&win) == 1 && same(cast(*u8, &got), gn, "olá") == 1);
    device.clipboard_set(&win, device.PRIMARY, "sel", 3);
    device.clipboard_request(&win, device.PRIMARY);
    until = time.now_ms() + 1000;
    while (device.clipboard_ready(&win) == 0 && time.now_ms() < until) {
        device.pump(&win);
        time.sleep_ms(5);
    }
    gn = device.clipboard_text(&win, cast(*u8, &got), 16);
    check("the primary selection apart", same(cast(*u8, &got), gn, "sel") == 1);

    // --- The smallest it may be made ---
    let is i64 as mw with mut = 0;
    let is i64 as mh with mut = 0;
    check("a floor asked, read back", device.set_min_size(&win, 260, 180) == 1 && device.min_size(&win, &mw, &mh) == 1 &&
          mw == 260 && mh == 180);
    check("and none", device.set_min_size(&win, 0, 0) == 1 && device.min_size(&win, &mw, &mh) == 0 && mw == 0 && mh == 0);
    check("the largest asked, read back", device.set_max_size(&win, 640, 480) == 1 &&
          x11.max_size(&win.x11_win, &mw, &mh) == 1 && mw == 640 && mh == 480);
    check("and none", device.set_max_size(&win, 0, 0) == 1 && x11.max_size(&win.x11_win, &mw, &mh) == 0);

    // --- A size asked of it: with no window manager here, the server's ---
    let is event.Event as sized;
    check("a size asked", device.set_size(&win, 300, 220) == 1 && next(event.RESIZE, &sized) == 1 &&
          device.width(&win) == 300 && device.height(&win) == 220);
    check("no size: not asked", device.set_size(&win, 0, 220) == 0 && device.set_size(&win, 300, 0) == 0);

    // --- Its icon, and asked to be the active window ---
    let is [4]u32 as icon;
    icon[0] = cast(u32, 4278190335);
    icon[1] = cast(u32, 4278255360);
    icon[2] = cast(u32, 4294901760);
    icon[3] = cast(u32, 0);
    check("an icon", device.set_icon(&win, cast(*u8, &icon), 2, 2) == 1);
    _data = cast(*u8, 0);
    xlib.XSync(win.x11_win.display, 0);
    xlib.XSync(other, 0);
    xlib.XGetWindowProperty(other, xid, xlib.XInternAtom(other, "_NET_WM_ICON", 0), 0, 64, 0, 0, cast(*u8, &_type),
                            cast(*u8, &_format), cast(*u8, &_n), cast(*u8, &_after), cast(*u8, &_data));
    check("its size and pixels", cast(i64, _data) != 0 && _n == 6 && *cast(*i64, _data) == 2 &&
          *cast(*i64, cast(i64, _data) + 8) == 2 && (*cast(*i64, cast(i64, _data) + 16) & 4294967295) == 4278190335);
    if (cast(i64, _data) != 0) { xlib.XFree(_data); }
    let is i64 as root = xlib.XDefaultRootWindow(other);
    xlib.XSelectInput(other, root, x.SubstructureRedirectMask | x.SubstructureNotifyMask);
    xlib.XSync(other, 0);
    device.activate(&win);
    let is i64 as asked with mut = 0;
    let is i64 as until2 = time.now_ms() + 1000;
    while (asked == 0 && time.now_ms() < until2) {
        while (xlib.XPending(other) > 0) {
            let is xev.XEvent as ce;
            xlib.XNextEvent(other, cast(*u8, &ce));
            if (xev.kind(&ce) == x.ClientMessage && xev.client(&ce).message_type == xlib.XInternAtom(other, "_NET_ACTIVE_WINDOW", 0) &&
                xev.client(&ce).window == xid) { asked = 1; }
        }
        time.sleep_ms(5);
    }
    check("asked of the window manager", asked == 1);
    xlib.XSelectInput(other, root, 0);
    xlib.XSync(other, 0);

    // --- Not open: nothing ---
    let is device.Window as bad with mut = win;
    bad.ok = 0;
    let is i64 as bx with mut = 7;
    let is i64 as by with mut = 7;
    check("a window not open: nothing of it", device.pending(&bad) == 0 && device.connection_fd(&bad) == 0 - 1 &&
          device.position(&bad, &bx, &by) == 0 && device.set_icon(&bad, cast(*u8, &icon), 2, 2) == 0 &&
          device.clipboard_set(&bad, device.CLIPBOARD, "x", 1) == 0 && device.clipboard_request(&bad, device.CLIPBOARD) == 0 &&
          device.clipboard_ready(&bad) == 0 && device.clipboard_pending(&bad) == 0 &&
          device.clipboard_text(&bad, cast(*u8, &got), 16) == 0 && bx == 7 && by == 7);
    device.set_title(&bad, "never", 5);
    device.hide(&bad);
    device.activate(&bad);
    device.pump(&bad);
    check("nor changed", mapped() == 1 && prop_is("WM_NAME", "STRING", cast(*u8, &want), 10) == 1);

    // --- Asked to close: told, and kept open when the program says ---
    let is xev.XEvent as del;
    xev.clear(&del);
    xev.any(&del).kind = x.ClientMessage;
    xev.any(&del).window = xid;
    xev.client(&del).message_type = xlib.XInternAtom(other, "WM_PROTOCOLS", 0);
    xev.client(&del).format = 32;
    xev.client(&del).data[0] = xlib.XInternAtom(other, "WM_DELETE_WINDOW", 0);
    xlib.XSendEvent(other, xid, 0, 0, cast(*u8, &del));
    xlib.XFlush(other);
    check("asked to close: told", next(event.CLOSE, &e) == 1 && device.should_close(&win) == 1);
    device.keep_open(&win);
    check("kept open", device.should_close(&win) == 0 && device.next_frame(&win) == 1);
    device.keep_open(&bad);

    // --- The window manager's state ---
    drain();
    let is [2]i64 as st;
    st[0] = xlib.XInternAtom(other, "_NET_WM_STATE_MAXIMIZED_VERT", 0);
    st[1] = xlib.XInternAtom(other, "_NET_WM_STATE_MAXIMIZED_HORZ", 0);
    xlib.XChangeProperty(other, xid, xlib.XInternAtom(other, "_NET_WM_STATE", 0), 4, 32, 0, cast(*u8, &st), 2);
    xlib.XFlush(other);
    check("maximized by the window manager: told", next(event.STATE, &e) == 1 && (e.state & event.STATE_MAXIMIZED) != 0 &&
          (e.state & event.STATE_FULLSCREEN) == 0);
    st[0] = xlib.XInternAtom(other, "_NET_WM_STATE_FULLSCREEN", 0);
    xlib.XChangeProperty(other, xid, xlib.XInternAtom(other, "_NET_WM_STATE", 0), 4, 32, 0, cast(*u8, &st), 1);
    xlib.XFlush(other);
    check("full screen", next(event.STATE, &e) == 1 && e.state == event.STATE_FULLSCREEN);

    // --- A frame of the program's own ---
    // Opened without the window manager's decoration: told before it is
    // first mapped, as the other client, holding the map, sees.
    let is i64 as wroot = xlib.XDefaultRootWindow(other);
    xlib.XSelectInput(other, wroot, x.SubstructureRedirectMask | x.SubstructureNotifyMask);
    xlib.XSync(other, 0);
    let is device.Config as tc with mut = device.config("framed", 120, 80);
    check("a window decorated unless told", tc.decorated == 1);
    tc.transparent = 1;
    tc.decorated = 0;
    let is device.Window as fw with mut = device.open_config(&tc);
    let is i64 as fxid = x11.xid(&fw.x11_win);
    check("undecorated before it is mapped", map_held(fxid) == 1 && longs_of(fxid, "_MOTIF_WM_HINTS") == 5 &&
          (longs[0] & 2) != 0 && longs[2] == 0);
    xlib.XMapWindow(other, fxid);
    xlib.XSync(other, 0);
    check("a window to be seen through: alpha in its pixels", device.transparent(&fw) == 1 && device.transparent(&win) == 0);
    // Whether what is behind shows through: a compositing manager, which
    // the other client plays by owning its selection.
    check("no compositing manager: nothing seen through", device.composited(&fw) == 0);
    let is i64 as cm = xlib.XInternAtom(other, "_NET_WM_CM_S0", 0);
    xlib.XSetSelectionOwner(other, cm, wroot, 0);
    xlib.XSync(other, 0);
    check("one there: seen through", device.composited(&fw) == 1 && device.composited(&win) == 1);
    xlib.XSetSelectionOwner(other, cm, 0, 0);
    xlib.XSync(other, 0);
    check("gone: not", device.composited(&fw) == 0);
    check("no decoration of the window manager's", device.decorated(&fw) == 0 && longs_of(xid, "_MOTIF_WM_HINTS") == 0);
    check("decorated again", device.set_decorated(&fw, 1) == 1 && device.decorated(&fw) == 1);
    check("and not", device.set_decorated(&fw, 0) == 1 && device.decorated(&fw) == 0 &&
          longs_of(fxid, "_MOTIF_WM_HINTS") == 5 && (longs[0] & 2) != 0 && longs[2] == 0);
    check("where it really is: the shadow round it", device.set_frame_extents(&fw, 10, 12, 8, 14) == 1 &&
          longs_of(fxid, "_GTK_FRAME_EXTENTS") == 4 && longs[0] == 10 && longs[1] == 12 && longs[2] == 8 && longs[3] == 14);
    let is i64 as rx0 with mut = 0;
    let is i64 as ry0 with mut = 0;
    let is i64 as rw0 with mut = 0;
    let is i64 as rh0 with mut = 0;
    check("where it takes the pointer", device.set_input_region(&fw, 6, 4, 108, 72) == 1 &&
          device.input_region(&fw, &rx0, &ry0, &rw0, &rh0) == 1 && rx0 == 6 && ry0 == 4 && rw0 == 108 && rh0 == 72);
    // Moved, resized, its menu, minimized, maximized: asked of the window
    // manager, which the other client plays a moment still.
    let is i64 as fx with mut = 0;
    let is i64 as fy with mut = 0;
    device.position(&fw, &fx, &fy);
    device.begin_move_resize(&fw, 30, 20, device.MOVE, 1);
    check("moved from a press: asked, where on the screen, how, which button", told_wm("_NET_WM_MOVERESIZE", fxid) == 1 &&
          longs[0] == fx + 30 && longs[1] == fy + 20 && longs[2] == 8 && longs[3] == 1);
    device.begin_move_resize(&fw, 0, 0, device.RESIZE_SE, 1);
    let is i64 as se = cast(i64, told_wm("_NET_WM_MOVERESIZE", fxid) == 1 && longs[2] == 4);
    device.begin_move_resize(&fw, 0, 0, device.RESIZE_NW, 1);
    let is i64 as nw = cast(i64, told_wm("_NET_WM_MOVERESIZE", fxid) == 1 && longs[2] == 0);
    device.begin_move_resize(&fw, 0, 0, device.RESIZE_W, 1);
    check("resized from a corner and a side, as EWMH numbers them", se == 1 && nw == 1 && told_wm("_NET_WM_MOVERESIZE", fxid) == 1 &&
          longs[2] == 7);
    device.show_window_menu(&fw, 15, 10);
    check("its menu, at the press", told_wm("_GTK_SHOW_WINDOW_MENU", fxid) == 1 && longs[1] == fx + 15 && longs[2] == fy + 10);
    device.minimize(&fw);
    check("minimized", told_wm("WM_CHANGE_STATE", fxid) == 1 && longs[0] == 3);
    device.set_maximized(&fw, 1);
    check("maximized: asked", told_wm("_NET_WM_STATE", fxid) == 1 && longs[0] == 1);
    xlib.XSelectInput(other, wroot, 0);
    xlib.XSync(other, 0);
    // Its state as the window manager keeps it.
    st[0] = xlib.XInternAtom(other, "_NET_WM_STATE_MAXIMIZED_VERT", 0);
    st[1] = xlib.XInternAtom(other, "_NET_WM_STATE_MAXIMIZED_HORZ", 0);
    xlib.XChangeProperty(other, fxid, xlib.XInternAtom(other, "_NET_WM_STATE", 0), 4, 32, 0, cast(*u8, &st), 2);
    let is i64 as edges = 1 | 4;
    xlib.XChangeProperty(other, fxid, xlib.XInternAtom(other, "_GTK_EDGE_CONSTRAINTS", 0), 6, 32, 0, cast(*u8, &edges), 1);
    xlib.XSync(other, 0);
    check("its state: maximized, tiled at the top and the right", device.state(&fw) ==
          (event.STATE_MAXIMIZED | event.STATE_TILED_TOP | event.STATE_TILED_RIGHT));
    let is device.Window as gone with mut = fw;
    gone.ok = 0;
    let is i64 as gx with mut = 7;
    check("a window not open: none of it", device.set_decorated(&gone, 0) == 0 && device.decorated(&gone) == 0 &&
          device.set_frame_extents(&gone, 1, 1, 1, 1) == 0 && device.set_input_region(&gone, 0, 0, 1, 1) == 0 &&
          device.input_region(&gone, &gx, &gx, &gx, &gx) == 0 && device.begin_move_resize(&gone, 0, 0, device.MOVE, 1) == 0 &&
          device.show_window_menu(&gone, 0, 0) == 0 && device.minimize(&gone) == 0 && device.set_maximized(&gone, 1) == 0 &&
          device.state(&gone) == 0 && device.transparent(&gone) == 0 && device.composited(&gone) == 0 && gx == 7 &&
          device.set_min_size(&gone, 1, 1) == 0 && device.min_size(&gone, &gx, &gx) == 0 && gx == 0);
    window.close(&fw);

    xlib.XCloseDisplay(other);
    window.close(&win);
    if (fails == 0) {
        io.printf("window device x11: all checks passed\n");
        return 0;
    }
    io.printf("window device x11: %d failures\n", fails);
    return 1;
}
