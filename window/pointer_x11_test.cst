// window/pointer_x11_test.cst — the pointer's shape and the window's scale,
// through the portable layer, under Xvfb:
//   sh window/x11/tools/run_headless.sh ./build/pointer_x11_test
// Every shape CSS names is set, and reaches the server: the cursor over the
// window is a different image for different shapes. The scale comes from the
// DPI the desktop gives in Xft.dpi, set here before the window's connection
// is opened, as a session's resources are.
use "std/io.cst" as io;
use "window.cst" as window;
use "device.cst" as device;
use "cursor.cst" as cursor;
use "display.cst" as display;
use "x11/x11.cst" as x11;
use "x11/bind/xlib.cst" as xlib;
use "x11/bind/x.cst" as x;
use "x11/bind/xfixes.cst" as xfixes;
use "x11/cursor.cst" as xcursor;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is *u8 as other with mut;

fn same(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    return cast(i32, a[i] == b[i]);
}

// The cursor the server shows where the pointer is: its size and hot spot,
// as one number.
fn shown() as i64 {
    xlib.XSync(other, 0);
    let is *u8 as im = xfixes.XFixesGetCursorImage(other);
    if (cast(i64, im) == 0) { return 0 - 1; }
    let is i64 as w = cast(i64, *cast(*u16, cast(i64, im) + 4));
    let is i64 as h = cast(i64, *cast(*u16, cast(i64, im) + 6));
    let is i64 as hx = cast(i64, *cast(*u16, cast(i64, im) + 8));
    let is i64 as hy = cast(i64, *cast(*u16, cast(i64, im) + 10));
    xlib.XFree(im);
    return ((w * 1000 + h) * 1000 + hx) * 1000 + hy;
}

fn main() as i32 {
    other = xlib.XOpenDisplay(cast(*u8, 0));
    let is *u8 as res = "Xft.dpi:\t144\n";
    xlib.XChangeProperty(other, xlib.XDefaultRootWindow(other), xlib.XInternAtom(other, "RESOURCE_MANAGER", 0), 31, 8, 0, res, 13);
    xlib.XSync(other, 0);

    let is device.Window as win = window.open("pointer", 200, 100);
    if (window.is_open(&win) == 0) {
        io.printf("FAIL: no window\n");
        return 1;
    }
    let is i64 as xid = x11.xid(&win.x11_win);
    xlib.XSync(other, 0);
    xlib.XWarpPointer(other, 0, xid, 0, 0, cast(u32, 0), cast(u32, 0), 50, 50);
    xlib.XSync(other, 0);

    // --- Its shape ---
    let is cursor.Cursors as c with mut = cursor.open(&win);
    let is i32 as all with mut = 1;
    let is i32 as s with mut = cursor.DEFAULT;
    while (s <= cursor.ZOOM_OUT) {
        if (cursor.set(&c, &win, s) == 0 || cursor.shape(&c) != s) { all = 0; }
        s = s + 1;
    }
    check("every shape CSS names", all == 1);
    cursor.set(&c, &win, cursor.DEFAULT);
    let is i64 as arrow = shown();
    cursor.set(&c, &win, cursor.TEXT);
    let is i64 as beam = shown();
    cursor.set(&c, &win, cursor.POINTER);
    let is i64 as hand = shown();
    check("on the server: a different cursor for each", arrow > 0 && beam > 0 && hand > 0 && arrow != beam && beam != hand);
    cursor.set(&c, &win, cursor.DEFAULT);
    check("set again: the same", shown() == arrow);
    check("none: hidden", cursor.set(&c, &win, cursor.NONE) == 1 && cursor.hidden(&c) == 1);
    check("another: shown again", cursor.set(&c, &win, cursor.TEXT) == 1 && cursor.hidden(&c) == 0 && shown() == beam);
    check("no such shape: refused", cursor.set(&c, &win, 0) == 0 && cursor.set(&c, &win, cursor.NONE + 1) == 0 &&
          cursor.shape(&c) == cursor.TEXT);
    // Hidden and shown again by the window's own layer: the shape last set.
    cursor.set(&c, &win, cursor.POINTER);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 0);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 1);
    check("shown again as it was", shown() == hand);
    // Set while hidden: taken, and shown once it is.
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 0);
    check("named while hidden: taken", xcursor.set_named(&c.x, x11.display(&win.x11_win), xid, 8, "text", cast(u32, 152)) == 1);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 1);
    check("then shown", shown() == beam);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 0);
    check("by number while hidden: taken", xcursor.set_shape(&c.x, x11.display(&win.x11_win), xid, xcursor.CROSSHAIR) == 1);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 1);
    check("then shown too", shown() != beam && shown() != hand);
    // The older shapes by number too.
    xcursor.set_shape(&c.x, x11.display(&win.x11_win), xid, xcursor.IBEAM);
    let is i64 as ibeam = shown();
    xcursor.set_shape(&c.x, x11.display(&win.x11_win), xid, xcursor.ARROW);
    check("the older shapes, on the server", ibeam > 0 && shown() != ibeam);
    // A name no theme has: the cursor font's glyph; slots in range only.
    let is *u8 as xd = x11.display(&win.x11_win);
    check("a name no theme has: its glyph", xcursor.set_named(&c.x, xd, xid, 40, "caustic-no-such-cursor", cast(u32, 152)) == 1);
    let is i64 as g1 = shown();
    xcursor.set_named(&c.x, xd, xid, 41, "caustic-no-such-either", cast(u32, 152));
    check("the same glyph, the same cursor", shown() == g1);
    check("slots in range only", xcursor.set_named(&c.x, xd, xid, 0 - 1, "default", cast(u32, 68)) == 0 &&
          xcursor.set_named(&c.x, xd, xid, xcursor.NAMED, "default", cast(u32, 68)) == 0 &&
          xcursor.set_named(&c.x, xd, xid, xcursor.NAMED - 1, "default", cast(u32, 68)) == 1);
    cursor.close(&c, &win);

    // --- Every shape's name, CSS's, and the cursor font's stand-ins ---
    check("names", same(cursor.name(cursor.DEFAULT), "default") == 1 && same(cursor.name(cursor.CONTEXT_MENU), "context-menu") == 1 &&
          same(cursor.name(cursor.HELP), "help") == 1 && same(cursor.name(cursor.POINTER), "pointer") == 1 &&
          same(cursor.name(cursor.PROGRESS), "progress") == 1 && same(cursor.name(cursor.WAIT), "wait") == 1 &&
          same(cursor.name(cursor.CELL), "cell") == 1 && same(cursor.name(cursor.CROSSHAIR), "crosshair") == 1 &&
          same(cursor.name(cursor.TEXT), "text") == 1 && same(cursor.name(cursor.VERTICAL_TEXT), "vertical-text") == 1 &&
          same(cursor.name(cursor.ALIAS), "alias") == 1 && same(cursor.name(cursor.COPY), "copy") == 1 &&
          same(cursor.name(cursor.MOVE), "move") == 1 && same(cursor.name(cursor.NO_DROP), "no-drop") == 1 &&
          same(cursor.name(cursor.NOT_ALLOWED), "not-allowed") == 1 && same(cursor.name(cursor.GRAB), "grab") == 1 &&
          same(cursor.name(cursor.GRABBING), "grabbing") == 1);
    check("the resizing ones", same(cursor.name(cursor.E_RESIZE), "e-resize") == 1 && same(cursor.name(cursor.N_RESIZE), "n-resize") == 1 &&
          same(cursor.name(cursor.NE_RESIZE), "ne-resize") == 1 && same(cursor.name(cursor.NW_RESIZE), "nw-resize") == 1 &&
          same(cursor.name(cursor.S_RESIZE), "s-resize") == 1 && same(cursor.name(cursor.SE_RESIZE), "se-resize") == 1 &&
          same(cursor.name(cursor.SW_RESIZE), "sw-resize") == 1 && same(cursor.name(cursor.W_RESIZE), "w-resize") == 1 &&
          same(cursor.name(cursor.EW_RESIZE), "ew-resize") == 1 && same(cursor.name(cursor.NS_RESIZE), "ns-resize") == 1 &&
          same(cursor.name(cursor.NESW_RESIZE), "nesw-resize") == 1 && same(cursor.name(cursor.NWSE_RESIZE), "nwse-resize") == 1 &&
          same(cursor.name(cursor.COL_RESIZE), "col-resize") == 1 && same(cursor.name(cursor.ROW_RESIZE), "row-resize") == 1 &&
          same(cursor.name(cursor.ALL_SCROLL), "all-scroll") == 1 && same(cursor.name(cursor.ZOOM_IN), "zoom-in") == 1 &&
          same(cursor.name(cursor.ZOOM_OUT), "zoom-out") == 1);

    // --- Its scale ---
    let is display.Display as d with mut = display.open(&win);
    check("the DPI the desktop gives, over 96", display.dpi(&d) == 144 && display.scale(&d, &win) == 1.5);
    display.close(&d);

    xlib.XCloseDisplay(other);
    window.close(&win);
    if (fails == 0) {
        io.printf("window pointer x11: all checks passed\n");
        return 0;
    }
    io.printf("window pointer x11: %d failures\n", fails);
    return 1;
}
