// window/pointer_x11_test.cst — the pointer's shape and the window's scale,
// through the portable layer, under Xvfb:
//   env XCURSOR_PATH=/usr/share/icons:$PWD/build/cursor-themes-x11 \
//       sh window/x11/tools/run_headless.sh ./build/pointer_x11_test
// Every shape CSS names is set, and reaches the server: the cursor over the
// window is a different image for different shapes. A theme written under
// XCURSOR_PATH's second entry is taken live, as the desktop's settings say
// it, and its size; then none said, the environment's again. The scale
// comes from the DPI the desktop gives in Xft.dpi, set here before the
// window's connection is opened, as a session's resources are. With
// "alone" and XCURSOR_PATH one directory, no theme but one written there: a
// shape by its older X name, the cursor font's glyph that is a shape, and
// the shapes no glyph is refused, the cursor shown kept.
use "std/io.cst" as io;
use "window.cst" as window;
use "device.cst" as device;
use "cursor.cst" as cursor;
use "display.cst" as display;
use "x11/x11.cst" as x11;
use "x11/bind/xlib.cst" as xlib;
use "x11/bind/x.cst" as x;
use "x11/bind/xfixes.cst" as xfixes;
use "x11/cursor.cst" as xcursor;
use "cursor_files.cst" as files;
use "std/env.cst" as env;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is *u8 as other with mut;
// The window's own connection: what it asked done before the cursor is read.
let is *u8 as mine with mut;

// The cursor the server shows where the pointer is: its size and hot spot,
// as one number.
fn shown() as i64 {
    xlib.XSync(mine, 0);
    xlib.XSync(other, 0);
    let is *u8 as im = xfixes.XFixesGetCursorImage(other);
    if (cast(i64, im) == 0) { return 0 - 1; }
    let is i64 as w = cast(i64, *cast(*u16, cast(i64, im) + 4));
    let is i64 as h = cast(i64, *cast(*u16, cast(i64, im) + 6));
    let is i64 as hx = cast(i64, *cast(*u16, cast(i64, im) + 8));
    let is i64 as hy = cast(i64, *cast(*u16, cast(i64, im) + 10));
    xlib.XFree(im);
    return image_id(w, h, hx, hy);
}

fn image_id(w as i64, h as i64, hx as i64, hy as i64) as i64 { return ((w * 1000 + h) * 1000 + hx) * 1000 + hy; }

// XCURSOR_PATH's second entry, where themes are written; null for none.
let is [512]u8 as _root with mut;

fn themes_root() as *u8 {
    let is *u8 as path = env.getenv("XCURSOR_PATH");
    if (cast(i64, path) == 0) { return cast(*u8, 0); }
    let is i64 as i with mut = 0;
    while (path[i] != 0 && path[i] != 58) { i = i + 1; }
    if (path[i] != 58 || path[i + 1] != 47) { return cast(*u8, 0); }
    i = i + 1;
    let is i64 as n with mut = 0;
    while (path[i] != 0 && path[i] != 58 && n < 500) { _root[n] = path[i]; n = n + 1; i = i + 1; }
    _root[n] = 0;
    return &_root[0];
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    other = xlib.XOpenDisplay(cast(*u8, 0));
    let is *u8 as res = "Xft.dpi:\t144\n";
    xlib.XChangeProperty(other, xlib.XDefaultRootWindow(other), xlib.XInternAtom(other, "RESOURCE_MANAGER", 0), 31, 8, 0, res, 13);
    xlib.XSync(other, 0);

    let is device.Window as win = window.open("pointer", 200, 100);
    if (window.is_open(&win) == 0) {
        io.printf("FAIL: no window\n");
        return 1;
    }
    let is i64 as xid = x11.xid(&win.x11_win);
    mine = x11.display(&win.x11_win);
    xlib.XSync(other, 0);
    xlib.XWarpPointer(other, 0, xid, 0, 0, cast(u32, 0), cast(u32, 0), 50, 50);
    xlib.XSync(other, 0);

    // --- Its shape ---
    let is cursor.Cursors as c with mut = cursor.open(&win);
    // "alone": XCURSOR_PATH the written themes' directory only — no theme
    // but caustic-old, which has progress by its older X name alone.
    if (env.argc() > 1) {
        let is *u8 as dir = env.getenv("XCURSOR_PATH");
        files.theme_dirs(dir, "caustic-old");
        files.image(30, 30, 2, 3, 0, cast(u32, 4294901760));
        files.save(files.under(dir, "caustic-old/cursors/left_ptr_watch"));
        cursor.set_theme(&c, &win, "caustic-old", 30);
        check("by its older X name", cursor.set(&c, &win, cursor.PROGRESS) == 1 && shown() == image_id(30, 30, 2, 3));
        check("in no theme: the cursor font's glyph that is it", cursor.set(&c, &win, cursor.TEXT) == 1);
        let is i64 as beam_glyph = shown();
        check("not the theme's", beam_glyph > 0 && beam_glyph != image_id(30, 30, 2, 3));
        check("no glyph is it: refused, the one shown kept", cursor.set(&c, &win, cursor.CONTEXT_MENU) == 0 &&
              cursor.set(&c, &win, cursor.NESW_RESIZE) == 0 && cursor.set(&c, &win, cursor.GRABBING) == 0 &&
              cursor.shape(&c) == cursor.TEXT && shown() == beam_glyph);
        cursor.close(&c, &win);
        xlib.XCloseDisplay(other);
        window.close(&win);
        if (fails == 0) { io.printf("window pointer x11, no theme but one: all checks passed\n"); return 0; }
        io.printf("window pointer x11, no theme but one: %d failures\n", fails);
        return 1;
    }
    let is i32 as all with mut = 1;
    let is i32 as s with mut = cursor.DEFAULT;
    while (s <= cursor.ZOOM_OUT) {
        if (cursor.set(&c, &win, s) == 0 || cursor.shape(&c) != s) { all = 0; }
        s = s + 1;
    }
    check("every shape CSS names", all == 1);
    cursor.set(&c, &win, cursor.DEFAULT);
    let is i64 as arrow = shown();
    cursor.set(&c, &win, cursor.TEXT);
    let is i64 as beam = shown();
    cursor.set(&c, &win, cursor.POINTER);
    let is i64 as hand = shown();
    check("on the server: a different cursor for each", arrow > 0 && beam > 0 && hand > 0 && arrow != beam && beam != hand);
    cursor.set(&c, &win, cursor.DEFAULT);
    check("set again: the same", shown() == arrow);
    check("none: hidden", cursor.set(&c, &win, cursor.NONE) == 1 && cursor.hidden(&c) == 1);
    check("another: shown again", cursor.set(&c, &win, cursor.TEXT) == 1 && cursor.hidden(&c) == 0 && shown() == beam);
    check("no such shape: refused", cursor.set(&c, &win, 0) == 0 && cursor.set(&c, &win, cursor.NONE + 1) == 0 &&
          cursor.shape(&c) == cursor.TEXT);
    // Hidden and shown again by the window's own layer: the shape last set.
    cursor.set(&c, &win, cursor.POINTER);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 0);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 1);
    check("shown again as it was", shown() == hand);
    // Set while hidden: taken, and shown once it is.
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 0);
    check("named while hidden: taken", xcursor.set_named(&c.x, x11.display(&win.x11_win), xid, 8, "text", cast(u32, 152)) == 1);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 1);
    check("then shown", shown() == beam);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 0);
    check("by number while hidden: taken", xcursor.set_shape(&c.x, x11.display(&win.x11_win), xid, xcursor.CROSSHAIR) == 1);
    xcursor.show(&c.x, x11.display(&win.x11_win), xid, 1);
    check("then shown too", shown() != beam && shown() != hand);
    // The older shapes by number too.
    xcursor.set_shape(&c.x, x11.display(&win.x11_win), xid, xcursor.IBEAM);
    let is i64 as ibeam = shown();
    xcursor.set_shape(&c.x, x11.display(&win.x11_win), xid, xcursor.ARROW);
    check("the older shapes, on the server", ibeam > 0 && shown() != ibeam);
    // A name no theme has: the cursor font's glyph; slots in range only.
    let is *u8 as xd = x11.display(&win.x11_win);
    check("a name no theme has: its glyph", xcursor.set_named(&c.x, xd, xid, 40, "caustic-no-such-cursor", cast(u32, 152)) == 1);
    let is i64 as g1 = shown();
    xcursor.set_named(&c.x, xd, xid, 41, "caustic-no-such-either", cast(u32, 152));
    check("the same glyph, the same cursor", shown() == g1);
    check("slots in range only", xcursor.set_named(&c.x, xd, xid, 0 - 1, "default", cast(u32, 68)) == 0 &&
          xcursor.set_named(&c.x, xd, xid, xcursor.NAMED, "default", cast(u32, 68)) == 0 &&
          xcursor.set_named(&c.x, xd, xid, xcursor.NAMED - 1, "default", cast(u32, 68)) == 1);

    // --- The theme and size, live (the desktop's settings) ---
    // caustic-x, under XCURSOR_PATH's second entry: "default" at nominal 40
    // (40 by 40, hot spot 7, 9) and 64 (64 by 64, 11, 13), "text" at 40 (40 by
    // 40, 20, 20).
    let is *u8 as root = themes_root();
    check("XCURSOR_PATH: the system's themes, then a directory for written ones", cast(i32, cast(i64, root) != 0));
    if (cast(i64, root) != 0) {
        files.theme_dirs(root, "caustic-x");
        files.image(40, 40, 7, 9, 0, cast(u32, 4294901760));
        files.image(64, 64, 11, 13, 0, cast(u32, 4278255360));
        files.save(files.under(root, "caustic-x/cursors/default"));
        files.image(40, 40, 20, 20, 0, cast(u32, 4278190335));
        files.save(files.under(root, "caustic-x/cursors/text"));
        cursor.set(&c, &win, cursor.DEFAULT);
        let is i64 as before = shown();
        cursor.set_theme(&c, &win, "caustic-x", 40);
        check("another theme, live: its cursor shown", shown() == image_id(40, 40, 7, 9));
        cursor.set_theme(&c, &win, "caustic-x", 64);
        check("another size, live", shown() == image_id(64, 64, 11, 13));
        // Hidden when the theme changes: shown from it when set.
        cursor.set(&c, &win, cursor.NONE);
        cursor.set_theme(&c, &win, "caustic-x", 40);
        check("changed while hidden: shown from it", cursor.set(&c, &win, cursor.TEXT) == 1 && shown() == image_id(40, 40, 20, 20));
        cursor.set_theme(&c, &win, cast(*u8, 0), 0);
        cursor.set(&c, &win, cursor.DEFAULT);
        check("none said: the environment's again", shown() == before && before != image_id(40, 40, 7, 9));
    }
    cursor.close(&c, &win);

    // --- Its scale ---
    let is display.Display as d with mut = display.open(&win);
    check("the DPI the desktop gives, over 96", display.dpi(&d) == 144 && display.scale(&d, &win) == 1.5);
    display.close(&d);

    xlib.XCloseDisplay(other);
    window.close(&win);
    if (fails == 0) {
        io.printf("window pointer x11: all checks passed\n");
        return 0;
    }
    io.printf("window pointer x11: %d failures\n", fails);
    return 1;
}
