// window/wayland/selection_test.cst — the clipboard and the primary selection
// against other programs, wl-copy and wl-paste (wl-clipboard), on a KWin of
// its own (it has the primary selection; Weston has not), the keys and
// pointer KWin's fake input (kwin_input.cst). A selection is owned by an input event's serial:
// the keyboard's enter, a key's (as Ctrl+C), a press's (as a selection made
// with the mouse) — KWin refuses one older than the selection's own.
//   sh window/wayland/tools/run_kwin.sh ./build/wayland_selection_test
// Owned here and read by wl-paste: text, its types, a PNG beside it, 3 MB
// (written as the reader takes it, never blocking the window), the primary
// selection apart; a reader that stops early let go of. Owned by wl-copy and
// asked for here: text, 3 MB, a PNG, the formats offered, a format not
// offered (none), the primary selection; an owner that goes. Ours, its
// window closed: nothing to paste.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/env.cst" as env;
use "std/process.cst" as process;
use "std/os/linux.cst" as linux;
use "backend.cst" as wayland;
use "../../sys/linux.cst" as sys;
use "../transfer.cst" as transfer;
use "../../gpu/software/target.cst" as tgt;
use "kwin_input.cst" as kwin_input;


let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("FAIL: %s\n", name); }
}

let is wayland.Window as win with mut;

fn pump(ms as i64) as void {
    let is i64 as until = time.now_ms() + ms;
    while (time.now_ms() < until) {
        wayland.pump(&win);
        time.sleep_ms(2);
    }
}

// Owned as Ctrl+C would: Control and C pressed and let go, the selection set
// by the press's serial.
fn own(which as i32, o as *transfer.Offer) as i32 {
    let is u32 as was = win.input_serial;
    kwin_input.key_sym(65507, 1);
    kwin_input.key_sym(99, 1);
    kwin_input.key_sym(99, 0);
    kwin_input.key_sym(65507, 0);
    let is i64 as until = time.now_ms() + 2000;
    while (time.now_ms() < until && win.input_serial == was) { pump(5); }
    pump(20);
    return wayland.clipboard_set(&win, which, o);
}

// Owned as a selection made with the mouse is: pressed in the window (placed
// at the top left by testdata/kwin/place-selections.js), the selection set
// by the press's serial.
fn own_by_click(which as i32, o as *transfer.Offer) as i32 {
    let is u32 as was = win.input_serial;
    kwin_input.move(100.0, 90.0);
    kwin_input.button(kwin_input.BTN_LEFT, 1);
    let is i64 as until = time.now_ms() + 2000;
    while (time.now_ms() < until && win.input_serial == was) { pump(5); }
    let is i32 as set = wayland.clipboard_set(&win, which, o);
    kwin_input.button(kwin_input.BTN_LEFT, 0);
    pump(20);
    return set;
}

// sh -c cmd, the window pumped meanwhile: the exit status, -1 when it took
// longer than 20 seconds.
fn run(cmd as *u8) as i32 {
    let is [4]i64 as argv;
    argv[0] = cast(i64, "sh"); argv[1] = cast(i64, "-c"); argv[2] = cast(i64, cmd); argv[3] = 0;
    let is i64 as pid = process.spawnp("sh", cast(*u8, &argv[0]));
    if (pid <= 0) { return 0 - 1; }
    let is i32 as status with mut = 0;
    let is i64 as until = time.now_ms() + 20000;
    while (time.now_ms() < until) {
        wayland.pump(&win);
        if (linux.wait4(pid, &status, 1, cast(*u8, 0)) == pid) { return process.exit_code_of(status); }
        time.sleep_ms(2);
    }
    return 0 - 1;
}

// sh -c "exec cmd", left running: its process.
fn spawn_owner(cmd as *u8) as i64 {
    let is [96]u8 as line with mut;
    let is *u8 as head = "exec ";
    let is i64 as n with mut = 0;
    while (head[n] != 0) { line[n] = head[n]; n = n + 1; }
    let is i64 as i with mut = 0;
    while (cmd[i] != 0 && n < 94) { line[n] = cmd[i]; n = n + 1; i = i + 1; }
    line[n] = 0;
    let is [4]i64 as argv;
    argv[0] = cast(i64, "sh"); argv[1] = cast(i64, "-c"); argv[2] = cast(i64, &line[0]); argv[3] = 0;
    return process.spawnp("sh", cast(*u8, &argv[0]));
}

fn stop(pid as i64) as void {
    sys.kill(pid, 15);
    let is i32 as status with mut = 0;
    linux.wait4(pid, &status, 0, cast(*u8, 0));
}

// The descriptors this process holds open (fcntl F_GETFD answers).
fn open_fds() as i64 {
    let is i64 as n with mut = 0;
    let is i64 as fd with mut = 0;
    while (fd < 1024) {
        if (syscall(72, fd, 1) >= 0) { n = n + 1; }
        fd = fd + 1;
    }
    return n;
}

fn read_file(path as *u8, out as *transfer.Bytes) as i32 {
    transfer.bytes_clear(out);
    let is i64 as fd = linux.open(path, linux.O_RDONLY, 0);
    if (fd < 0) { return 0; }
    let is [65536]u8 as buf with mut;
    while (1 == 1) {
        let is i64 as n = linux.read(fd, &buf[0], 65536);
        if (n <= 0) { break; }
        transfer.append(out, &buf[0], n);
    }
    linux.close(fd);
    return 1;
}

fn write_file(path as *u8, p as *u8, n as i64) as void {
    let is i64 as fd = linux.open(path, 577, 420);
    if (fd < 0) { return; }
    let is i64 as at with mut = 0;
    while (at < n) {
        let is i64 as w = linux.write(fd, cast(*u8, cast(i64, p) + at), n - at);
        if (w <= 0) { break; }
        at = at + w;
    }
    linux.close(fd);
}

fn same(b as *transfer.Bytes, p as *u8, n as i64) as i32 {
    if (b.len != n) { io.printf("  %d bytes, want %d\n", b.len, n); return 0; }
    return cast(i32, mem.memcmp(b.data, p, n) == 0);
}

fn contains(b as *transfer.Bytes, s as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    let is i64 as i with mut = 0;
    while (i + n <= b.len) {
        if (mem.memcmp(cast(*u8, cast(i64, b.data) + i), s, n) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

// The selection asked for as format, waited for: what came, into out; the
// format that came.
fn ask(which as i32, format as i32, out as *transfer.Bytes) as i32 {
    transfer.bytes_clear(out);
    if (wayland.clipboard_request(&win, which, format) == 0) { return 0 - 1; }
    let is i64 as until = time.now_ms() + 15000;
    while (time.now_ms() < until && wayland.clipboard_ready(&win) == 0) {
        wayland.pump(&win);
        time.sleep_ms(2);
    }
    if (wayland.clipboard_ready(&win) == 0) { return 0 - 2; }
    transfer.bytes_set(out, wayland.clipboard_data(&win), wayland.clipboard_length(&win));
    return wayland.clipboard_format(&win);
}

// The selection which offered by another program, as this window hears it.
fn offered_by_them(which as i32) as i32 {
    let is i64 as until = time.now_ms() + 3000;
    while (time.now_ms() < until) {
        pump(20);
        if (win.selection_offer[which] != 0 && win.selection_source[which] == 0) { return 1; }
    }
    return 0;
}

fn big_text(out as *transfer.Bytes) as void {
    transfer.bytes_clear(out);
    let is *u8 as line = "caustic ação — 3 MB through a pipe ✓ ";
    let is i64 as n with mut = 0;
    while (line[n] != 0) { n = n + 1; }
    while (out.len < 3145728) { transfer.append(out, line, n); }
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (kwin_input.open() == 0) { io.printf("FAIL: no fake input of KWin's to press keys with\n"); return 1; }
    if (wayland.open(&win, "selections", 200, 100) == 0) { io.printf("FAIL: no window\n"); return 1; }
    let is tgt.Target as t = wayland.acquire(&win);
    if (cast(i64, t.color) != 0) { wayland.submit(&win); }
    // The keyboard's focus, the window where the pointer will find it.
    let is i64 as until = time.now_ms() + 5000;
    while (time.now_ms() < until && win.keyboard_focus == 0) { pump(20); }
    check("the keyboard's focus", win.keyboard_focus == 1);
    check("placed", run("sh window/wayland/tools/kwin_script.sh window/wayland/testdata/kwin/place-selections.js") == 0);
    pump(200);
    linux.mkdir("build/selection-test", 493);
    let is transfer.Bytes as got with mut;
    transfer.bytes_init(&got);
    let is transfer.Offer as o with mut;
    transfer.offer_init(&o);

    // --- Owned here, read by wl-paste ---
    transfer.offer_text(&o, "héllo ✓ wörld", 17);
    check("the clipboard owned by the serial the keyboard came with", wayland.clipboard_set(&win, 0, &o) == 1);
    pump(100);
    check("read by wl-paste", run("wl-paste --no-newline > build/selection-test/a") == 0 &&
          read_file("build/selection-test/a", &got) == 1 && same(&got, "héllo ✓ wörld", 17) == 1);
    check("its types", run("wl-paste --list-types > build/selection-test/a") == 0 &&
          read_file("build/selection-test/a", &got) == 1 && contains(&got, "text/plain;charset=utf-8") == 1 &&
          contains(&got, "UTF8_STRING") == 1 && contains(&got, "image/png") == 0);
    let is transfer.Bytes as png with mut;
    transfer.bytes_init(&png);
    check("a PNG to offer", read_file("image/testdata/rgba.png", &png) == 1 && png.len > 8);
    transfer.offer_png(&o, png.data, png.len);
    check("text and a PNG owned", own(0, &o) == 1);
    pump(100);
    check("the PNG read as image/png", run("wl-paste --type image/png > build/selection-test/a") == 0 &&
          read_file("build/selection-test/a", &got) == 1 && same(&got, png.data, png.len) == 1);
    let is transfer.Bytes as big with mut;
    transfer.bytes_init(&big);
    big_text(&big);
    transfer.offer_free(&o);
    transfer.offer_init(&o);
    transfer.offer_text(&o, big.data, big.len);
    check("3 MB owned", own(0, &o) == 1);
    pump(100);
    check("3 MB read whole, the window writing as wl-paste reads", run("wl-paste --no-newline > build/selection-test/a") == 0 &&
          read_file("build/selection-test/a", &got) == 1 && same(&got, big.data, big.len) == 1);
    let is transfer.Offer as p with mut;
    transfer.offer_init(&p);
    transfer.offer_text(&p, "primary only", 12);
    check("the primary selection owned by a press's serial", own_by_click(1, &p) == 1);
    pump(100);
    check("the primary read", run("wl-paste --primary --no-newline > build/selection-test/a") == 0 &&
          read_file("build/selection-test/a", &got) == 1 && same(&got, "primary only", 12) == 1);
    check("the clipboard apart from it", run("wl-paste --no-newline > build/selection-test/a") == 0 &&
          read_file("build/selection-test/a", &got) == 1 && same(&got, big.data, big.len) == 1);
    check("ours asked for: what we offer, as it is", ask(0, transfer.TEXT, &got) == transfer.TEXT && same(&got, big.data, big.len) == 1);

    // --- Owned by wl-copy, asked for here ---
    write_file("build/selection-test/in", "from wl-copy: ação", 19);
    check("wl-copy takes the clipboard", run("wl-copy < build/selection-test/in") == 0);
    check("offered here", offered_by_them(0) == 1);
    check("its text asked for", ask(0, transfer.TEXT, &got) == transfer.TEXT && same(&got, "from wl-copy: ação", 19) == 1);
    check("a format not offered: none", ask(0, transfer.PNG, &got) == 0 && got.len == 0);
    write_file("build/selection-test/big", big.data, big.len);
    check("wl-copy takes it with 3 MB", run("wl-copy < build/selection-test/big") == 0);
    check("offered here again", offered_by_them(0) == 1);
    pump(200);
    check("3 MB asked for, read as it comes", ask(0, transfer.TEXT, &got) == transfer.TEXT && same(&got, big.data, big.len) == 1);
    check("wl-copy offers a PNG", run("wl-copy --type image/png < image/testdata/rgba.png") == 0);
    pump(300);
    check("what is offered: a PNG, no text", ask(0, 0, &got) == 0 && wayland.clipboard_offered(&win) == transfer.PNG);
    check("the PNG asked for", ask(0, transfer.PNG, &got) == transfer.PNG && same(&got, png.data, png.len) == 1);
    check("text not offered: none", ask(0, transfer.TEXT, &got) == 0);
    write_file("build/selection-test/primary", "wl-copy's primary", 17);
    check("wl-copy takes the primary selection", run("wl-copy --primary < build/selection-test/primary") == 0);
    check("the primary offered here", offered_by_them(1) == 1);
    check("the primary asked for", ask(1, transfer.TEXT, &got) == transfer.TEXT && same(&got, "wl-copy's primary", 17) == 1);
    check("the clipboard still the PNG", ask(0, transfer.PNG, &got) == transfer.PNG && same(&got, png.data, png.len) == 1);
    // Taken back with the mouse: a press newer than wl-copy's selection.
    check("the primary taken back by a press", own_by_click(1, &p) == 1);
    pump(100);
    check("and read as ours", run("wl-paste --primary --no-newline > build/selection-test/a") == 0 &&
          read_file("build/selection-test/a", &got) == 1 && same(&got, "primary only", 12) == 1);

    // A reader that stops early: the descriptor written to let go, the
    // window serving the next one whole.
    transfer.offer_free(&o);
    transfer.offer_init(&o);
    transfer.offer_text(&o, big.data, big.len);
    check("3 MB owned again", own(0, &o) == 1);
    pump(100);
    let is i64 as fds = open_fds();
    check("a reader that stops after 10 bytes", run("wl-paste --no-newline | head -c 10 > build/selection-test/a") == 0 &&
          read_file("build/selection-test/a", &got) == 1 && same(&got, big.data, 10) == 1);
    pump(300);
    check("its descriptor let go", open_fds() == fds);
    check("the next reader served whole", run("wl-paste --no-newline > build/selection-test/a") == 0 &&
          read_file("build/selection-test/a", &got) == 1 && same(&got, big.data, big.len) == 1);

    // An owner that goes: nothing offered.
    let is i64 as owner = spawn_owner("wl-copy --foreground < build/selection-test/in");
    check("a wl-copy owning it in the foreground", owner > 0 && offered_by_them(0) == 1 &&
          ask(0, transfer.TEXT, &got) == transfer.TEXT && same(&got, "from wl-copy: ação", 19) == 1);
    stop(owner);
    pump(300);
    check("that owner gone: nothing offered", win.selection_offer[0] == 0 &&
          ask(0, transfer.TEXT, &got) == 0 && got.len == 0 && wayland.clipboard_offered(&win) == 0);

    // Ours, the window that owns it gone: nothing to paste.
    transfer.offer_free(&o);
    transfer.offer_init(&o);
    transfer.offer_text(&o, "end", 3);
    check("owned once more", own(0, &o) == 1 && own(1, &o) == 1);
    pump(100);
    wayland.close(&win);
    check("its owner closed: nothing to paste", run("wl-paste --no-newline > build/selection-test/a 2>/dev/null") != 0 &&
          run("wl-paste --primary --no-newline > build/selection-test/a 2>/dev/null") != 0);
    transfer.offer_free(&o);
    transfer.offer_free(&p);
    if (fails == 0) { io.printf("wayland selections: all checks passed\n"); return 0; }
    io.printf("wayland selections: %d failures\n", fails);
    return 1;
}
