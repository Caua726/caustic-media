// The Wayland keyboard keymap is an XKB text-v1 file sent by the compositor.
// xkbcommon owns parsing and state; this binding keeps the ABI opaque.
extern "libxkbcommon.so.0" fn xkb_context_new(flags as i32) as *u8;
extern "libxkbcommon.so.0" fn xkb_context_unref(context as *u8) as void;
extern "libxkbcommon.so.0" fn xkb_keymap_new_from_string(context as *u8, text as *u8, format as i32, flags as i32) as *u8;
extern "libxkbcommon.so.0" fn xkb_keymap_new_from_names(context as *u8, names as *u8, flags as i32) as *u8;
extern "libxkbcommon.so.0" fn xkb_keymap_unref(keymap as *u8) as void;
extern "libxkbcommon.so.0" fn xkb_state_new(keymap as *u8) as *u8;
extern "libxkbcommon.so.0" fn xkb_state_unref(state as *u8) as void;
extern "libxkbcommon.so.0" fn xkb_state_update_key(state as *u8, key as u32, direction as i32) as u32;
extern "libxkbcommon.so.0" fn xkb_state_update_mask(state as *u8, depressed as u32, latched as u32, locked as u32, depressed_layout as u32, latched_layout as u32, locked_layout as u32) as u32;
extern "libxkbcommon.so.0" fn xkb_state_key_get_one_sym(state as *u8, key as u32) as u32;
extern "libxkbcommon.so.0" fn xkb_state_key_get_utf8(state as *u8, key as u32, buffer as *u8, size as u64) as i32;
extern "libxkbcommon.so.0" fn xkb_state_mod_name_is_active(state as *u8, name as *u8, components as i32) as i32;
extern "libxkbcommon.so.0" fn xkb_compose_table_new_from_locale(context as *u8, locale as *u8, flags as i32) as *u8;
extern "libxkbcommon.so.0" fn xkb_compose_table_unref(table as *u8) as void;
extern "libxkbcommon.so.0" fn xkb_compose_state_new(table as *u8, flags as i32) as *u8;
extern "libxkbcommon.so.0" fn xkb_compose_state_unref(state as *u8) as void;
extern "libxkbcommon.so.0" fn xkb_compose_state_feed(state as *u8, keysym as u32) as i32;
extern "libxkbcommon.so.0" fn xkb_compose_state_get_status(state as *u8) as i32;
extern "libxkbcommon.so.0" fn xkb_compose_state_get_utf8(state as *u8, buffer as *u8, size as u64) as i32;
extern "libxkbcommon.so.0" fn xkb_compose_state_reset(state as *u8) as void;
