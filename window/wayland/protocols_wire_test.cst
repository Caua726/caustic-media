// window/wayland/protocols_wire_test.cst — the optional protocols on the
// wire, a compositor played by hand over a socket: what each event says read
// to its boundaries — a token, an exported handle, the presentation clock,
// presented and discarded frames — and what each request carries. What
// KWin and Weston do with them is protocols_test's.
//   ./build/wayland_protocols_wire_test
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../../sys/linux.cst" as sys;
use "backend.cst" as wayland;

let is i32 as failures with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("  FAIL: %s\n", name);
        failures = failures + 1;
    }
}

fn put(p as *u8, offset as i64, value as u32) as void {
    *cast(*u32, cast(i64, p) + offset) = value;
}

fn word(p as *u8, offset as i64) as u32 { return *cast(*u32, cast(i64, p) + offset); }

let is i64 as server with mut = 0 - 1;
let is wayland.Window as w with mut;

// An event for obj, its opcode op, the payload's first n bytes: sent, and
// the window handed it.
fn event(obj as i32, op as i32, payload as *u8, n as i64) as i32 {
    let is [600]u8 as m;
    put(&m[0], 0, cast(u32, obj));
    put(&m[0], 4, cast(u32, ((8 + n) << 16) | op));
    mem.memcpy(&m[8], payload, n);
    if (linux.write(server, &m[0], 8 + n) != 8 + n) { return 0; }
    return wayland._pump_one(&w, 0);
}

// A string event's payload: the length said (len), then n bytes of s, the
// rest of a padded string zero: its size.
fn string_payload(out as *u8, len as u32, s as *u8, n as i64) as i64 {
    mem.memzero(out, 600);
    put(out, 0, len);
    mem.memcpy(cast(*u8, cast(i64, out) + 4), s, n);
    return 4 + ((n + 1 + 3) / 4) * 4;
}

// The next request the window sent: its object, opcode and payload, the
// payload's size; -1 when there was none.
let is [600]u8 as req with mut;
let is i32 as req_obj with mut = 0;
let is i32 as req_op with mut = 0;

fn request() as i64 {
    if (sys.wait_readable(server, 0) <= 0) { return 0 - 1; }
    let is [8]u8 as head;
    if (linux.read(server, &head[0], 8) != 8) { return 0 - 1; }
    req_obj = cast(i32, word(&head[0], 0));
    req_op = cast(i32, word(&head[0], 4) & 65535);
    let is i64 as size = cast(i64, word(&head[0], 4) >> 16) - 8;
    if (size < 0 || size > 600) { return 0 - 1; }
    if (size > 0 && linux.read(server, &req[0], size) != size) { return 0 - 1; }
    return size;
}

fn token_is(s as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return cast(i32, cast(i64, w.token_len) == n && mem.memcmp(&w.token[0], s, n + 1) == 0);
}

// A token said for a token object made a moment ago: what the window kept.
fn token_said(payload as *u8, n as i64) as void {
    w.token_object = 30;
    w.token_len = 0 - 1;
    event(30, 0, payload, n);
}

fn main() as i32 {
    let is [2]i32 as pair;
    if (sys.socketpair(sys.AF_UNIX, sys.SOCK_STREAM | sys.SOCK_CLOEXEC, 0, &pair[0]) < 0) {
        io.printf("FAIL: socketpair\n");
        return 1;
    }
    wayland._zero(&w);
    // Objects free and unowned: events for the ids below go to the window.
    wayland._object_pool();
    w.fd = pair[0]; w.opened = 1;
    w.surface = 5; w.toplevel = 6;
    server = cast(i64, pair[1]);
    let is [600]u8 as p;

    // --- xdg_activation_token_v1.done ---
    let is i64 as n with mut = string_payload(&p[0], 4, "abc", 3);
    token_said(&p[0], n);
    check("a token said: kept", token_is("abc") == 1);
    check("its object let go, and destroyed", w.token_object == 0 && request() == 0 && req_obj == 30 && req_op == 4);
    // A string whose padding ends where the message does: whole.
    n = string_payload(&p[0], 8, "1234567", 7);
    check("one that fills the message exactly", n == 12);
    token_said(&p[0], n);
    check("kept whole", token_is("1234567") == 1);
    request();
    // Said to be longer than the message: none.
    n = string_payload(&p[0], 9, "1234567", 7);
    token_said(&p[0], n);
    check("one longer than its message: none", w.token_len == 0 && w.token_object == 0);
    request();
    n = string_payload(&p[0], 0, "", 0);
    token_said(&p[0], n);
    check("a null string: none", w.token_len == 0);
    request();
    // The longest kept: 255 bytes and its zero; one more, none.
    let is [300]u8 as long with mut;
    mem.memset(&long[0], 116, 300);
    n = string_payload(&p[0], 256, &long[0], 255);
    token_said(&p[0], n);
    check("255 bytes: kept", w.token_len == 255 && w.token[254] == 116 && w.token[255] == 0);
    request();
    n = string_payload(&p[0], 257, &long[0], 256);
    token_said(&p[0], n);
    check("256: none", w.token_len == 0);
    request();
    check("a done for an object not a token's: not taken as one", w.token_object == 0);
    w.token_len = 0 - 1;
    n = string_payload(&p[0], 4, "xyz", 3);
    event(31, 0, &p[0], n);
    check("left waiting", w.token_len == 0 - 1);

    // --- zxdg_exported_v2.handle ---
    w.exported = 33;
    w.export_len = 0 - 1;
    n = string_payload(&p[0], 9, "handle-1", 8);
    event(33, 0, &p[0], n);
    check("a handle said: kept", w.export_len == 8 && mem.memcmp(&w.export_handle[0], "handle-1", 9) == 0);
    w.export_len = 0 - 1;
    n = string_payload(&p[0], 128, &long[0], 127);
    event(33, 0, &p[0], n);
    check("127 bytes: kept", w.export_len == 127 && w.export_handle[127] == 0);
    w.export_len = 0 - 1;
    n = string_payload(&p[0], 129, &long[0], 128);
    event(33, 0, &p[0], n);
    check("128: none", w.export_len == 0);
    let is [200]u8 as out;
    w.export_len = 8;
    mem.memcpy(&w.export_handle[0], "handle-1", 9);
    w.exporter = 34;
    check("given where it fits with its zero", wayland.export_handle(&w, &out[0], 9) == 8 &&
          mem.memcmp(&out[0], "handle-1", 9) == 0);
    out[8] = 120;
    check("not where its zero would not fit, nothing written there", wayland.export_handle(&w, &out[0], 8) == 0 && out[8] == 120);
    check("no request for a handle already said", request() < 0);

    // --- wp_presentation ---
    let is i64 as none_at with mut = 0;
    let is i64 as none_refresh with mut = 0;
    check("without wp_presentation: none said", wayland.presentation_times(&w, &none_at, &none_refresh) == 0 - 1);
    w.presentation = 35;
    let is [40]u8 as f;
    mem.memzero(&f[0], 40);
    put(&f[0], 0, 1);
    event(35, 0, &f[0], 4);
    check("the clock said: CLOCK_MONOTONIC", wayland.presentation_clock() == 1);
    put(&f[0], 0, 4);
    event(35, 0, &f[0], 4);
    check("CLOCK_MONOTONIC_RAW", wayland.presentation_clock() == 4);
    // Feedback asked with each frame, eight outstanding at most.
    let is i32 as k with mut = 0;
    while (k < 9) { wayland._feedback_ask(&w); k = k + 1; }
    let is i32 as asked with mut = 0;
    while (request() == 8 && req_obj == 35 && req_op == 1 && word(&req[0], 0) == 5) { asked = asked + 1; }
    check("feedback asked for the surface, eight at most", asked == 8 && w.feedback[0] != 0 && w.feedback[7] != 0);
    let is i32 as first = w.feedback[0];
    let is i32 as second = w.feedback[1];
    let is i32 as third = w.feedback[2];
    // presented: the seconds in two words, the nanoseconds, the refresh.
    mem.memzero(&f[0], 40);
    put(&f[0], 0, 1); put(&f[0], 4, 5); put(&f[0], 8, 7); put(&f[0], 12, 16666666);
    event(first, 1, &f[0], 28);
    let is i64 as at with mut = 0;
    let is i64 as refresh with mut = 0;
    check("the first frame's presented: counted, when, the refresh",
          wayland.presentation_times(&w, &at, &refresh) == 1 && at == (cast(i64, 1) << 32) * 1000000000 + 5000000007 &&
          refresh == 16666666);
    check("its feedback over, its place free", w.feedback[0] == 0);
    event(second, 2, &f[0], 0);
    check("a discarded one: counted, not as shown", wayland.frames_discarded(&w) == 1 &&
          wayland.presentation_times(&w, &at, &refresh) == 1 && w.feedback[1] == 0);
    event(third, 0, &f[0], 4);
    check("its output said: still outstanding", w.feedback[2] == third && wayland.presentation_times(&w, &at, &refresh) == 1);
    event(third, 1, &f[0], 24);
    check("a presented too short: not taken", w.feedback[2] == third && wayland.presentation_times(&w, &at, &refresh) == 1);
    wayland._feedback_ask(&w);
    check("a freed place asked again", w.feedback[0] != 0 && request() == 8);
    wayland._feedback_ask(&w);
    check("the other freed place too", w.feedback[1] != 0 && request() == 8);
    // Eight outstanding again, the times already said kept beside them.
    wayland._feedback_ask(&w);
    check("a ninth not asked, what was said untouched", request() < 0 &&
          wayland.presentation_times(&w, &at, &refresh) == 1 && at == (cast(i64, 1) << 32) * 1000000000 + 5000000007 &&
          refresh == 16666666 && wayland.frames_discarded(&w) == 1);

    // --- Requests ---
    w.activation = 20;
    check("activation with a token", wayland.activate_with(&w, "tok", 3) == 1 && request() == 12 && req_obj == 20 &&
          req_op == 2 && word(&req[0], 0) == 4 && mem.memcmp(&req[4], "tok", 4) == 0 && word(&req[0], 8) == 5);
    mem.memset(&long[0], 107, 300);
    check("a token of 240 bytes: asked", wayland.activate_with(&w, &long[0], 240) == 1 && request() == 4 + 244 + 4 &&
          word(&req[0], 0) == 241 && req[4 + 239] == 107 && req[4 + 240] == 0 && word(&req[0], 248) == 5);
    check("of 241: not", wayland.activate_with(&w, &long[0], 241) == 0 && request() < 0);
    check("of none: not", wayland.activate_with(&w, &long[0], 0) == 0 && request() < 0);
    w.bell = 21;
    check("the bell rung for the surface", wayland.bell(&w) == 1 && request() == 4 && req_obj == 21 && req_op == 1 &&
          word(&req[0], 0) == 5);
    w.bell = 0;
    check("no bell: none rung", wayland.bell(&w) == 0 && request() < 0);

    linux.close(cast(i64, pair[0]));
    linux.close(server);
    if (failures == 0) { io.printf("wayland protocols wire: all checks passed\n"); return 0; }
    io.printf("wayland protocols wire: %d failures\n", failures);
    return 1;
}
