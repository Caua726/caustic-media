// Wire metadata checked at runtime against stable core and xdg protocol facts.
use "std/io.cst" as io;
use "protocol.cst" as p;
let is i64 as failures with mut = 0;
fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { io.printf("FAIL %s\n", name); failures = failures + 1; }
}
fn same(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, a[i] == b[i]);
}
fn iface(id as i64, name as *u8, version as i64, requests as i64, events as i64) as void {
    let is p.Interface as d = p.interface(id);
    if (d.id != id || same(d.name, name) != 1 || d.version != version || d.request_count != requests || d.event_count != events) {
        io.printf("interface %s got id=%d version=%d requests=%d events=%d name=%s\n", name, d.id, d.version, d.request_count, d.event_count, d.name);
        failures = failures + 1;
    }
}
fn request(id as i64, opcode as i64, name as *u8, since as i64, args as i64, sig as *u8, destructor as i64) as void {
    let is p.Message as m = p.request_message(id, opcode);
    if (m.opcode != opcode || m.since != since || m.arg_count != args || same(m.name, name) != 1 || same(m.signature, sig) != 1 || m.destructor != destructor) {
        io.printf("request %s got opcode=%d since=%d args=%d name=%s signature=%s destructor=%d\n", name, m.opcode, m.since, m.arg_count, m.name, m.signature, m.destructor);
        failures = failures + 1;
    }
}
fn main() as i32 {
    iface(0, "wl_display", 1, 2, 2);
    iface(1, "wl_registry", 1, 1, 2);
    iface(3, "wl_compositor", 7, 3, 0);
    iface(5, "wl_shm", 3, 2, 1);
    iface(13, "wl_surface", 7, 12, 4);
    iface(23, "xdg_wm_base", 7, 4, 1);
    iface(26, "xdg_toplevel", 7, 14, 4);
    iface(30, "zxdg_decoration_manager_v1", 2, 2, 0);
    iface(32, "zwp_text_input_v3", 2, 11, 9);
    iface(35, "zwp_primary_selection_device_v1", 1, 2, 2);
    iface(38, "wp_fractional_scale_manager_v1", 1, 2, 0);
    iface(40, "wp_cursor_shape_manager_v1", 2, 3, 0);
    iface(42, "xdg_activation_v1", 1, 3, 0);
    iface(45, "xdg_dialog_v1", 1, 3, 0);
    request(1, 0, "bind", 1, 4, "usun", 0);
    request(5, 0, "create_pool", 1, 3, "nhi", 0);
    request(13, 9, "damage_buffer", 4, 4, "4:iiii", 0);
    request(23, 3, "pong", 1, 1, "u", 0);
    request(26, 8, "set_min_size", 1, 2, "ii", 0);
    request(32, 3, "set_surrounding_text", 1, 3, "sii", 0);
    request(32, 6, "set_cursor_rectangle", 1, 4, "iiii", 0);
    request(40, 1, "get_pointer", 1, 2, "no", 0);
    request(45, 1, "set_modal", 1, 0, "", 0);
    let is p.Message as absent = p.request_message(13, 99);
    check("unknown request refused", absent.opcode == 0 - 1);
    let is p.Interface as missing = p.interface(999);
    check("unknown interface refused", missing.id == 0 - 1);
    if (failures != 0) { return 1; }
    io.printf("wayland protocol: all checks passed\n");
    return 0;
}
