use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "xkb.cst" as xkb;
use "backend.cst" as wayland;
use "../../input/keys.cst" as keys;
use "../event.cst" as event;
use "../../input/event.cst" as ie;

struct RuleNames {
    rules as *u8;
    model as *u8;
    layout as *u8;
    variant as *u8;
    options as *u8;
}

let is i32 as failures with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("  FAIL: %s\n", name);
        failures = failures + 1;
    }
}

fn put(p as *u8, offset as i64, value as u32) as void {
    *cast(*u32, cast(i64, p) + offset) = value;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is *u8 as context = xkb.xkb_context_new(0);
    let is RuleNames as rules;
    rules.rules = "evdev"; rules.model = "pc105"; rules.layout = "us";
    rules.variant = ""; rules.options = "";
    let is *u8 as keymap = xkb.xkb_keymap_new_from_names(context, cast(*u8, &rules), 0);
    let is *u8 as state with mut = cast(*u8, 0);
    if (cast(i64, keymap) != 0) { state = xkb.xkb_state_new(keymap); }
    check("xkbcommon loads a US evdev keymap", cast(i64, context) != 0 && cast(i64, keymap) != 0 && cast(i64, state) != 0);
    if (cast(i64, state) == 0) { return 1; }

    let is wayland.Window as w;
    mem.memzero(cast(*u8, &w), sizeof(wayland.Window));
    w.xkb_state = state; w.keyboard_focus = 1; w.surface = 99; w.pointer_version = 7; w.scale120 = 240;
    w.input = ie.create();
    check("fractional scale rounds pixels and reverses coordinates", wayland._scale_up(101, 150) == 127 && wayland._scale_down(127, 150) == 101);
    let is [16]u8 as p;
    put(&p[0], 8, 30); put(&p[0], 12, 1);
    wayland._keyboard_event(&w, 3, &p[0]);
    put(&p[0], 12, 0);
    wayland._keyboard_event(&w, 3, &p[0]);
    put(&p[0], 8, 42); put(&p[0], 12, 1);
    wayland._keyboard_event(&w, 3, &p[0]);
    put(&p[0], 8, 30); put(&p[0], 12, 1);
    wayland._keyboard_event(&w, 3, &p[0]);

    let is ie.Event as e;
    check("first key is a, at its place", wayland.poll_input(&w, &e) == 1 && e.kind == ie.KEY_DOWN && e.key == keys.A &&
          e.physical == 38 && e.repeat == 0);
    check("then the text it typed, copied when queued", wayland.poll_input(&w, &e) == 1 && e.kind == ie.TEXT &&
          e.from_key == 1 && e.text_len == 1 && e.text[0] == 97);
    check("key release retains its key identity", wayland.poll_input(&w, &e) == 1 && e.kind == ie.KEY_UP && e.key == keys.A);
    check("shift key has portable identity and modifier", wayland.poll_input(&w, &e) == 1 && e.kind == ie.KEY_DOWN &&
          e.key == keys.SHIFT_L && (e.modifiers & keys.MOD_SHIFT) != 0);
    check("shifted key keeps its physical place", wayland.poll_input(&w, &e) == 1 && e.kind == ie.KEY_DOWN && e.key == keys.A &&
          e.physical == 38);
    check("and types uppercase", wayland.poll_input(&w, &e) == 1 && e.kind == ie.TEXT && e.text_len == 1 && e.text[0] == 65);
    // The compositor's own repeat (wl_keyboard 10): state 2.
    put(&p[0], 8, 30); put(&p[0], 12, 2);
    wayland._keyboard_event(&w, 3, &p[0]);
    check("a repeat the compositor sends: a repeat", wayland.poll_input(&w, &e) == 1 && e.kind == ie.KEY_DOWN && e.repeat == 1 &&
          e.key == keys.A);
    check("typing again", wayland.poll_input(&w, &e) == 1 && e.kind == ie.TEXT && e.text[0] == 65);

    put(&p[0], 8, 30); put(&p[0], 12, 0);
    wayland._keyboard_event(&w, 3, &p[0]);
    put(&p[0], 8, 42); put(&p[0], 12, 0);
    wayland._keyboard_event(&w, 3, &p[0]);
    check("released keys leave no modifier", w.modifiers == 0);
    while (wayland.poll_input(&w, &e) == 1) { }
    // Control held: the letter's key a command, its control character no text.
    put(&p[0], 8, 29); put(&p[0], 12, 1);
    wayland._keyboard_event(&w, 3, &p[0]);
    put(&p[0], 8, 30); put(&p[0], 12, 1);
    wayland._keyboard_event(&w, 3, &p[0]);
    check("Control's key", wayland.poll_input(&w, &e) == 1 && e.kind == ie.KEY_DOWN && e.key == keys.CONTROL_L);
    check("a letter with Control: a command", wayland.poll_input(&w, &e) == 1 && e.kind == ie.KEY_DOWN && e.key == keys.A &&
          (e.modifiers & keys.MOD_CONTROL) != 0);
    check("and no text", wayland.poll_input(&w, &e) == 0);
    put(&p[0], 8, 30); put(&p[0], 12, 0);
    wayland._keyboard_event(&w, 3, &p[0]);
    put(&p[0], 8, 29); put(&p[0], 12, 0);
    wayland._keyboard_event(&w, 3, &p[0]);
    while (wayland.poll_input(&w, &e) == 1) { }

    put(&p[0], 0, 7); put(&p[0], 4, 99); put(&p[0], 8, 2688); put(&p[0], 12, 5184);
    wayland._pointer_event(&w, 0, &p[0]);
    check("pointer enter scales surface coordinates to buffer pixels", wayland.poll_input(&w, &e) == 1 && e.kind == ie.ENTER && e.x == 20 && e.y == 40);
    put(&p[0], 0, 1); put(&p[0], 4, 3200); put(&p[0], 8, 5696);
    wayland._pointer_event(&w, 2, &p[0]);
    check("pointer motion scales positions", wayland.poll_input(&w, &e) == 1 && e.kind == ie.MOTION && e.x == 24 && e.y == 44);

    put(&p[0], 0, 11); put(&p[0], 8, 272); put(&p[0], 12, 1);
    wayland._pointer_event(&w, 3, &p[0]);
    check("left pointer button press", wayland.poll_input(&w, &e) == 1 && e.kind == ie.BUTTON_DOWN && e.button == 1 &&
          e.x == 24 && e.y == 44);
    // As they come off the wire: axis 20 bytes, axis_discrete 16.
    wayland._wire_size = 20;
    put(&p[0], 4, 0); put(&p[0], 8, 2560);
    wayland._pointer_event(&w, 4, &p[0]);
    wayland._wire_size = 16;
    put(&p[0], 0, 0); put(&p[0], 4, 1);
    wayland._pointer_event(&w, 8, &p[0]);
    wayland._pointer_event(&w, 5, &p[0]);
    check("a wheel's notch down: positive, one step", wayland.poll_input(&w, &e) == 1 && e.kind == ie.SCROLL &&
          e.dy == 1.0 && e.steps_y == 1 && e.value120_y == 120 && e.source == ie.SCROLL_WHEEL);
    // The keyboard's focus leaving: everything held let go, the pressed
    // button too, and its release after says nothing.
    put(&p[0], 0, 12); put(&p[0], 4, 99);
    wayland._keyboard_event(&w, 2, &p[0]);
    check("focus left: a cancel", wayland.poll_input(&w, &e) == 1 && e.kind == ie.CANCEL && e.detail == ie.CANCEL_FOCUS);
    put(&p[0], 0, 13); put(&p[0], 8, 272); put(&p[0], 12, 0);
    wayland._pointer_event(&w, 3, &p[0]);
    check("the release after it says nothing", wayland.poll_input(&w, &e) == 0);

    let is *u8 as table = xkb.xkb_compose_table_new_from_locale(context, "C.UTF-8", 0);
    let is *u8 as compose with mut = cast(*u8, 0);
    if (cast(i64, table) != 0) { compose = xkb.xkb_compose_state_new(table, 0); }
    w.compose_state = compose;
    let is i32 as dead = wayland._key_text(&w, 65105, 34);
    let is i32 as composed = wayland._key_text(&w, 101, 34);
    check("dead acute composes with e as UTF-8 é", cast(i64, compose) != 0 && dead == 0 && composed == 2 && w.text_buf[0] == 195 && w.text_buf[1] == 169);

    w.toplevel = 77; w.state = event.STATE_MAXIMIZED;
    wayland._wire_size = 20;
    put(&wayland._wire[0], 0, 77); put(&wayland._wire[0], 4, 20 << 16);
    put(&wayland._wire[0], 8, 0); put(&wayland._wire[0], 12, 0); put(&wayland._wire[0], 16, 0);
    wayland._dispatch(&w, 77);
    check("empty xdg state list clears maximized", w.state == 0);
    wayland._wire_size = 24;
    put(&wayland._wire[0], 4, 24 << 16);
    put(&wayland._wire[0], 16, 4); put(&wayland._wire[0], 20, 1);
    wayland._dispatch(&w, 77);
    check("xdg configure restores maximized bit", w.state == event.STATE_MAXIMIZED);

    if (cast(i64, compose) != 0) { xkb.xkb_compose_state_unref(compose); }
    if (cast(i64, table) != 0) { xkb.xkb_compose_table_unref(table); }
    xkb.xkb_state_unref(state); xkb.xkb_keymap_unref(keymap); xkb.xkb_context_unref(context);
    if (failures == 0) { io.printf("wayland input: all checks passed\n"); }
    return cast(i32, failures != 0);
}
