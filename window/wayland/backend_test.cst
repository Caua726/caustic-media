use "std/io.cst" as io;
use "std/env.cst" as env;
use "../event.cst" as event;
use "backend.cst" as wayland;
use "../../gpu/software/target.cst" as tgt;

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is wayland.Window as w = wayland.open("wayland backend test", 320, 200);
    if (wayland.is_open(&w) == 0) {
        io.printf("FAIL: Wayland open, error %d\n", wayland.error(&w));
        wayland.close(&w);
        return 1;
    }
    if (wayland.native_fd(&w) < 0 || wayland.native_surface(&w) == 0) {
        io.printf("FAIL: native handles\n");
        wayland.close(&w);
        return 1;
    }
    if (wayland.next_frame(&w) != 1) {
        io.printf("FAIL: first frame\n");
        wayland.close(&w);
        return 1;
    }
    let is tgt.Target as t = wayland.acquire(&w);
    if (t.width < 1 || t.height < 1 || cast(i64, t.color) == 0) {
        io.printf("FAIL: acquired shm buffer %d x %d\n", t.width, t.height);
        wayland.close(&w);
        return 1;
    }
    tgt.put(&t, 0, 0, 4294901760);
    tgt.put(&t, t.width - 1, t.height - 1, 4278255360);
    wayland.submit(&w);
    if (tgt.get(&t, 0, 0) != 4278190335 ||
        tgt.get(&t, t.width - 1, t.height - 1) != 4278255360) {
        io.printf("FAIL: shm pixel channel order\n");
        wayland.close(&w);
        return 1;
    }
    if (wayland.next_frame(&w) != 1) {
        io.printf("FAIL: compositor frame callback\n");
        wayland.close(&w);
        return 1;
    }
    let is event.Event as e;
    while (wayland.poll_event(&w, &e) == 1) { }
    wayland.set_title(&w, "Wayland title changed", 21);
    let is i64 as min_w with mut = 0; let is i64 as min_h with mut = 0;
    if (wayland.set_min_size(&w, 100, 80) != 1 ||
        wayland.min_size(&w, &min_w, &min_h) != 1 || min_w != 100 || min_h != 80 ||
        wayland.set_max_size(&w, 800, 600) != 1) {
        io.printf("FAIL: size constraints\n");
        wayland.close(&w);
        return 1;
    }
    if (wayland.set_maximized(&w, 1) != 1 || wayland.set_maximized(&w, 0) != 1 ||
        wayland.set_fullscreen(&w, 1) != 1 || wayland.set_fullscreen(&w, 0) != 1 ||
        wayland.minimize(&w) != 1) {
        io.printf("FAIL: toplevel state requests\n");
        wayland.close(&w);
        return 1;
    }
    wayland.close(&w);
    if (wayland.is_open(&w) != 0) { return 1; }
    io.printf("wayland backend: all checks passed\n");
    return 0;
}
