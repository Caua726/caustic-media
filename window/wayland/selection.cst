// window/wayland/selection.cst — selections and drag and drop: the
// compositor's offers and ours, read and written through descriptors from
// the pump. The public calls (clipboard_*, drag_begin, drop_*) are
// backend.cst's.
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "std/time.cst" as time;
use "../../sys/linux.cst" as sys;
use "../event.cst" as event;
use "../transfer.cst" as transfer;
use "state.cst" as st;

// --- Selections and drag and drop ---
//
// The compositor's offers (wl_data_offer, the primary selection's) say their
// MIME types; ours (DataSource) carry a transfer.Offer, copied. Data moves
// through descriptors: a Reader reads an offer's into its bytes — PASTE for
// the clipboard or the primary selection asked for, DROP for a drop — and a
// Writer writes ours to whoever asked; both without blocking, from the pump,
// so that a transfer this program makes to itself (a drag onto its own
// window) cannot wait on itself.

fn _offer_index(w as *st.Window, object as i32, primary as i32, create as i32) as i32 {
    let is i32 as free_slot with mut = 0 - 1;
    let is i32 as i with mut = 0;
    while (i < st.MAX_DATA) {
        if (w.offers[i].object == object && object != 0) { return i; }
        if (w.offers[i].object == 0 && free_slot < 0) { free_slot = i; }
        i = i + 1;
    }
    if (create == 0 || free_slot < 0) { return 0 - 1; }
    mem.memzero(cast(*u8, &w.offers[free_slot]), sizeof(st.DataOffer));
    w.offers[free_slot].object = object;
    w.offers[free_slot].primary = primary;
    w.offers[free_slot].text_rank = 9;
    return free_slot;
}

fn _offer_release(w as *st.Window, index as i32, destroy as i32) as void {
    let is i32 as object = w.offers[index].object;
    if (object == 0) { return; }
    if (destroy == 1) {
        let is [0]u8 as empty;
        let is i32 as opcode with mut = 2;
        if (w.offers[index].primary == 1) { opcode = 1; }
        st._send(w, object, opcode, &empty[0], 0, 0 - 1);
    }
    if (w.selection_offer[0] == object) { w.selection_offer[0] = 0; }
    if (w.selection_offer[1] == object) { w.selection_offer[1] = 0; }
    if (w.drop_offer == object) { w.drop_offer = 0; }
    transfer.names_free(&w.offers[index].names);
    mem.memzero(cast(*u8, &w.offers[index]), sizeof(st.DataOffer));
}

fn _source_index(w as *st.Window, object as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < st.MAX_DATA) {
        if (w.sources[i].object == object && object != 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn _source_slot(w as *st.Window) as i32 {
    let is i32 as i with mut = 0;
    while (i < st.MAX_DATA) {
        if (w.sources[i].object == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// An offer's event: a MIME type it has (0), on the data device's the actions
// its source allows (1) and the one the compositor chose (2).
fn _data_offer_event(w as *st.Window, object as i32, op as i32, p as *u8) as void {
    let is i32 as index = _offer_index(w, object, 0, 0);
    if (index < 0) { return; }
    let is *st.DataOffer as o = &w.offers[index];
    if (op == 0) {
        if (st._wire_size < 16) { return; }
        let is i32 as len = cast(i32, st._word(p));
        let is i32 as padded = ((len + 3) / 4) * 4;
        if (len <= 1 || len > 256 || 12 + padded > st._wire_size) { return; }
        let is *u8 as mime = cast(*u8, cast(i64, p) + 4);
        let is i32 as f = transfer.format_of(mime, cast(i64, len - 1));
        o.formats = o.formats | f;
        // Any other by its name.
        if (f == 0 && transfer.names_add(&o.names, mime, cast(i64, len - 1)) == 1) { o.formats = o.formats | transfer.NAMED; }
        if (f == transfer.TEXT) {
            let is i32 as rank = transfer.text_rank(mime, cast(i64, len - 1));
            if (rank < o.text_rank) { o.text_rank = rank; }
        }
        return;
    }
    if (o.primary == 1 || st._wire_size < 12) { return; }
    if (op == 1) { o.source_actions = cast(i32, st._word(p)) & (transfer.COPY | transfer.MOVE); return; }
    if (op == 2) { o.action = cast(i32, st._word(p)) & (transfer.COPY | transfer.MOVE); return; }
}

// The MIME type an offer is asked for format by: the best text type it has.
fn _offer_mime(o as *st.DataOffer, format as i32) as *u8 {
    if (format == transfer.FILES) { return transfer.MIME_URIS; }
    if (format == transfer.PNG) { return transfer.MIME_PNG; }
    if (o.text_rank == 0) { return transfer.MIME_UTF8; }
    if (o.text_rank == 1) { return "UTF8_STRING"; }
    return "text/plain";
}

// --- Readers ---

// Offer index's data as format read into slot from now on, through a
// descriptor the source writes: 1 when asked.
fn _read_start(w as *st.Window, slot as i32, index as i32, format as i32) as i32 {
    let is *st.Reader as r = &w.reading[slot];
    _read_cancel(w, slot);
    let is *st.DataOffer as o = &w.offers[index];
    let is [2]i32 as fds;
    if (sys.socketpair(sys.AF_UNIX, sys.SOCK_STREAM | sys.SOCK_CLOEXEC, 0, &fds[0]) < 0) { return 0; }
    if (linux.fcntl(fds[0], 4, 2048) < 0) { linux.close(fds[0]); linux.close(fds[1]); return 0; }
    let is i32 as opcode with mut = 1;
    if (o.primary == 1) { opcode = 0; }
    // A named format by its own name, set in the reader before.
    let is *u8 as mime with mut = _offer_mime(o, format);
    if (format == transfer.NAMED) { mime = &r.named[0]; }
    if (st._send_string_fd(w, o.object, opcode, mime, fds[1]) == 0) {
        linux.close(fds[0]); linux.close(fds[1]);
        return 0;
    }
    linux.close(fds[1]);
    r.fd = fds[0];
    r.offer = o.object;
    r.format = format;
    r.failed = 0;
    r.last_ms = time.now_ms();
    transfer.bytes_clear(&r.data);
    return 1;
}

fn _read_cancel(w as *st.Window, slot as i32) as void {
    let is *st.Reader as r = &w.reading[slot];
    if (r.fd >= 0) { linux.close(r.fd); }
    r.fd = 0 - 1;
    r.offer = 0;
}

// What can be read of slot now: 1 when its source has said all (or failed,
// or gone quiet past the time), 0 while more may come.
fn _read_some(w as *st.Window, slot as i32) as i32 {
    let is *st.Reader as r = &w.reading[slot];
    if (r.fd < 0) { return 0; }
    let is [65536]u8 as chunk;
    while (1 == 1) {
        let is i64 as n = linux.read(r.fd, &chunk[0], 65536);
        if (n > 0) {
            r.last_ms = time.now_ms();
            if (transfer.append(&r.data, &chunk[0], n) == 0) { r.failed = 1; _read_cancel(w, slot); return 1; }
            continue;
        }
        if (n == 0) { _read_cancel(w, slot); return 1; }
        if (n == 0 - sys.EINTR) { continue; }
        if (n == 0 - 11) {   // EAGAIN: not yet
            if (time.now_ms() - r.last_ms > st.TRANSFER_TIMEOUT_MS) { r.failed = 1; _read_cancel(w, slot); return 1; }
            return 0;
        }
        r.failed = 1;
        _read_cancel(w, slot);
        return 1;
    }
    return 0;
}

// Both readers advanced: a paste made ready, a drop finished.
fn _readers(w as *st.Window) as void {
    let is i32 as offer = w.reading[st.PASTE].offer;
    if (w.reading[st.PASTE].fd >= 0 && _read_some(w, st.PASTE) == 1) {
        w.paste_state = st._PASTE_READY;
        w.paste_got = w.reading[st.PASTE].format;
        if (w.reading[st.PASTE].failed == 1) { w.paste_got = 0; transfer.bytes_clear(&w.reading[st.PASTE].data); }
        w.frame_ready = 1;
        // An offer replaced while it was read: let go now.
        if (offer != w.selection_offer[0] && offer != w.selection_offer[1]) {
            let is i32 as index = _offer_index(w, offer, 0, 0);
            if (index >= 0) { _offer_release(w, index, 1); }
        }
    }
    if (w.reading[st.DROP].fd >= 0 && _read_some(w, st.DROP) == 1) { _drop_finish(w); }
}

// --- Writers ---

// bytes written to fd from now on (a copy: what is offered may change
// meanwhile), the descriptor closed when all is written or the reader went.
fn _write_start(w as *st.Window, fd as i64, bytes as *transfer.Bytes) as void {
    let is i32 as k with mut = 0;
    while (k < st.MAX_WRITERS && w.writing[k].fd >= 0) { k = k + 1; }
    if (k == st.MAX_WRITERS || linux.fcntl(fd, 4, 2048) < 0 || transfer.bytes_set(&w.writing[k].data, bytes.data, bytes.len) == 0) {
        linux.close(fd);
        return;
    }
    w.writing[k].fd = fd;
    w.writing[k].sent = 0;
    w.writing[k].last_ms = time.now_ms();
    _write_some(w, k);
}

fn _write_end(w as *st.Window, k as i32) as void {
    if (w.writing[k].fd >= 0) { linux.close(w.writing[k].fd); }
    w.writing[k].fd = 0 - 1;
    transfer.bytes_free(&w.writing[k].data);
}

fn _write_some(w as *st.Window, k as i32) as void {
    let is *st.Writer as wr = &w.writing[k];
    while (wr.fd >= 0) {
        if (wr.sent >= wr.data.len) { _write_end(w, k); return; }
        let is i64 as n = linux.write(wr.fd, cast(*u8, cast(i64, wr.data.data) + wr.sent), wr.data.len - wr.sent);
        if (n > 0) { wr.sent = wr.sent + n; wr.last_ms = time.now_ms(); continue; }
        if (n == 0 - sys.EINTR) { continue; }
        if (n == 0 - 11 && time.now_ms() - wr.last_ms <= st.TRANSFER_TIMEOUT_MS) { return; }
        // The reader went (EPIPE), or stopped reading for good.
        _write_end(w, k);
    }
}

fn _writers(w as *st.Window) as void {
    let is i32 as k with mut = 0;
    while (k < st.MAX_WRITERS) {
        if (w.writing[k].fd >= 0) { _write_some(w, k); }
        k = k + 1;
    }
}

// Whether a transfer is under way: the pump is then to come back soon.
fn _transferring(w as *st.Window) as i32 {
    if (w.reading[st.PASTE].fd >= 0 || w.reading[st.DROP].fd >= 0) { return 1; }
    let is i32 as k with mut = 0;
    while (k < st.MAX_WRITERS) {
        if (w.writing[k].fd >= 0) { return 1; }
        k = k + 1;
    }
    return 0;
}

// --- Dropped on ---

// What the program takes where the pointer is, told the offer: the MIME type
// it would read (none: refused) and, with version 3, the actions it would
// do and the one it prefers.
fn _drop_accept(w as *st.Window) as void {
    if (w.drop_offer == 0) { return; }
    let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
    if (index < 0) { return; }
    let is *st.DataOffer as o = &w.offers[index];
    let is i32 as takes = w.drop_answer & w.drop_offered;
    let is *u8 as mime with mut = cast(*u8, 0);
    if ((takes & transfer.FILES) != 0) { mime = transfer.MIME_URIS; }
    else if ((takes & transfer.NAMED) != 0) { mime = &w.drop_name[0]; }
    else if ((takes & transfer.PNG) != 0) { mime = transfer.MIME_PNG; }
    else if ((takes & transfer.TEXT) != 0) { mime = _offer_mime(o, transfer.TEXT); }
    let is [256]u8 as p;
    st._put(&p[0], w.drop_serial);
    let is i32 as n with mut = 8;
    if (cast(i64, mime) != 0) {
        let is i32 as len with mut = 1;
        while (mime[len - 1] != 0) { len = len + 1; }
        let is i32 as padded = ((len + 3) / 4) * 4;
        st._put(&p[4], cast(u32, len));
        mem.memcpy(&p[8], mime, len);
        if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[8]) + len), 0, padded - len); }
        n = 8 + padded;
    } else { st._put(&p[4], 0); }
    st._send(w, w.drop_offer, 0, &p[0], n, 0 - 1);
    if (st._bounded(st._globals.data_manager_version, 3) >= 3) {
        let is i32 as actions with mut = transfer.COPY | transfer.MOVE;
        if (w.drop_want_action != 0) { actions = w.drop_want_action; }
        if (cast(i64, mime) == 0) { actions = 0; }
        let is i32 as preferred with mut = w.drop_want_action;
        if (preferred == 0) { preferred = transfer.COPY; }
        if ((actions & preferred) == 0) { preferred = actions & transfer.MOVE; }
        let is [8]u8 as a;
        st._put(&a[0], cast(u32, actions)); st._put(&a[4], cast(u32, preferred));
        st._send(w, w.drop_offer, 4, &a[0], 8, 0 - 1);
    }
}

// The drop's data came: read as files or text, the offer finished, the
// program told DND_DROP with the action the compositor chose — or DND_LEAVE
// when nothing came.
fn _drop_finish(w as *st.Window) as void {
    if (w.drop_pending == 0) { return; }
    w.drop_pending = 0;
    let is *st.Reader as r = &w.reading[st.DROP];
    w.drop_count = 0;
    transfer.bytes_clear(&w.drop_text);
    transfer.bytes_clear(&w.drop_paths);
    transfer.bytes_clear(&w.drop_data);
    if (r.failed == 0) {
        if (w.drop_kind == transfer.FILES) {
            w.drop_count = transfer.parse_uri_list(r.data.data, r.data.len, &w.drop_paths);
            if (w.drop_count > 0) { w.drop_ready = 1; }
        } else if (w.drop_kind == transfer.PNG || w.drop_kind == transfer.NAMED) {
            if (transfer.bytes_set(&w.drop_data, r.data.data, r.data.len) == 1) { w.drop_ready = 1; }
        } else if (transfer.bytes_set(&w.drop_text, r.data.data, r.data.len) == 1) {
            w.drop_ready = 1;
        }
    }
    transfer.bytes_clear(&r.data);
    let is i32 as action with mut = transfer.COPY;
    let is i32 as offer = w.drop_offer;
    if (offer != 0) {
        let is i32 as index = _offer_index(w, offer, 0, 0);
        if (index >= 0 && w.offers[index].action != 0) { action = w.offers[index].action; }
        let is [0]u8 as empty;
        if (w.drop_ready == 1 && st._bounded(st._globals.data_manager_version, 3) >= 3) { st._send(w, offer, 3, &empty[0], 0, 0 - 1); }
        if (index >= 0) { _offer_release(w, index, 1); }
    }
    w.drop_offer = 0; w.drop_offered = 0; w.drop_answer = 0;
    let is event.Event as e;
    event.clear(&e);
    e.x = w.drop_x; e.y = w.drop_y;
    if (w.drop_ready == 1) { e.kind = event.DND_DROP; e.drop = w.drop_kind; e.action = action; }
    else { e.kind = event.DND_LEAVE; }
    w.frame_ready = 1;
    st._queue(w, &e);
}

fn _drop_reject(w as *st.Window) as void {
    w.drop_answer = 0;
    _drop_accept(w);
    if (w.drop_offer != 0) {
        let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
        if (index >= 0) { _offer_release(w, index, 1); }
    }
    w.drop_offer = 0; w.drop_offered = 0; w.drop_answer = 0; w.drop_pending = 0;
    let is event.Event as e;
    event.clear(&e); e.kind = event.DND_LEAVE; e.x = w.drop_x; e.y = w.drop_y;
    st._queue(w, &e);
}

// Dropped: what is taken read — files when they are.
fn _drop_start(w as *st.Window) as void {
    let is i32 as takes = w.drop_answer & w.drop_offered;
    let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
    if (takes == 0 || index < 0) { _drop_reject(w); return; }
    let is i32 as kind with mut = transfer.TEXT;
    if ((takes & transfer.FILES) != 0) { kind = transfer.FILES; }
    else if ((takes & transfer.NAMED) != 0) {
        kind = transfer.NAMED;
        mem.memcpy(&w.reading[st.DROP].named[0], &w.drop_name[0], w.drop_name_n + 1);
    }
    else if ((takes & transfer.PNG) != 0) { kind = transfer.PNG; }
    if (_read_start(w, st.DROP, index, kind) == 0) { _drop_reject(w); return; }
    w.drop_ready = 0; w.drop_count = 0;
    w.drop_kind = kind;
    w.drop_pending = 1;
}

fn _data_device_event(w as *st.Window, op as i32, p as *u8) as void {
    if (op == 0) {
        _offer_index(w, cast(i32, st._word(p)), 0, 1);
        return;
    }
    if (op == 1 && st._wire_size >= 28) {
        let is i32 as surface = cast(i32, st._word(cast(*u8, cast(i64, p) + 4)));
        if (surface != w.surface) { return; }
        if (w.drop_offer != 0 && w.drop_pending == 0) { _drop_reject(w); }
        w.drop_serial = st._word(p); w.input_serial = w.drop_serial;
        w.drop_x = st._scale_up(cast(i64, cast(i32, st._word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        w.drop_y = st._scale_up(cast(i64, cast(i32, st._word(cast(*u8, cast(i64, p) + 12))) / 256), w.scale120);
        w.drop_offer = cast(i32, st._word(cast(*u8, cast(i64, p) + 16)));
        w.drop_offered = 0; w.drop_answer = 0; w.drop_want_action = 0; w.drop_actions = 0;
        let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
        if (index >= 0) {
            w.drop_offered = w.offers[index].formats & (transfer.FILES | transfer.TEXT | transfer.PNG | transfer.NAMED);
            w.drop_actions = w.offers[index].source_actions;
            if (w.drop_actions == 0) { w.drop_actions = transfer.COPY; }
            // Until the program says otherwise, its files and text are taken.
            w.drop_answer = w.drop_offered & (transfer.FILES | transfer.TEXT);
            _drop_accept(w);
        }
        let is event.Event as e;
        event.clear(&e); e.kind = event.DND_ENTER; e.drop = w.drop_offered; e.action = w.drop_actions;
        e.x = w.drop_x; e.y = w.drop_y;
        st._queue(w, &e);
        return;
    }
    if (op == 2) {
        if (w.drop_pending == 1) { return; }
        let is i64 as x = w.drop_x; let is i64 as y = w.drop_y;
        if (w.drop_offer != 0) {
            let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
            if (index >= 0) { _offer_release(w, index, 1); }
        }
        w.drop_offer = 0; w.drop_offered = 0; w.drop_answer = 0;
        let is event.Event as e;
        event.clear(&e); e.kind = event.DND_LEAVE; e.x = x; e.y = y;
        st._queue(w, &e);
        return;
    }
    if (op == 3 && st._wire_size >= 20) {
        w.drop_x = st._scale_up(cast(i64, cast(i32, st._word(cast(*u8, cast(i64, p) + 4))) / 256), w.scale120);
        w.drop_y = st._scale_up(cast(i64, cast(i32, st._word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        if (w.drop_offer != 0 && w.drop_pending == 0) {
            let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
            if (index >= 0 && w.offers[index].source_actions != 0) { w.drop_actions = w.offers[index].source_actions; }
            let is event.Event as e;
            event.clear(&e); e.kind = event.DND_MOVE; e.x = w.drop_x; e.y = w.drop_y; e.action = w.drop_actions;
            st._queue(w, &e);
        }
        return;
    }
    if (op == 4) { _drop_start(w); return; }
    if (op == 5) { _selection_offer(w, 0, cast(i32, st._word(p))); }
}

fn _primary_device_event(w as *st.Window, op as i32, p as *u8) as void {
    if (op == 0) {
        _offer_index(w, cast(i32, st._word(p)), 1, 1);
        return;
    }
    if (op == 1) { _selection_offer(w, 1, cast(i32, st._word(p))); }
}

// A selection now offered as next (0: none): the one before let go, unless
// it is still being read.
fn _selection_offer(w as *st.Window, which as i32, next as i32) as void {
    let is i32 as previous = w.selection_offer[which];
    w.selection_offer[which] = next;
    if (previous != 0 && previous != next && previous != w.reading[st.PASTE].offer) {
        let is i32 as index = _offer_index(w, previous, which, 0);
        if (index >= 0) { _offer_release(w, index, 1); }
    }
    // Told the program: the selection changed hands, and what it offers —
    // its MIME types came before it was named the selection; none for a
    // selection emptied (0).
    let is event.Event as e;
    event.clear(&e);
    e.kind = event.CLIPBOARD_CHANGED;
    e.state = which;
    let is i32 as now = _offer_index(w, next, which, 0);
    if (next != 0 && now >= 0) { e.drop = w.offers[now].formats; }
    w.frame_ready = 1;
    st._queue(w, &e);
}

// --- Ours: sources ---

fn _source_release(w as *st.Window, index as i32, destroy as i32) as void {
    let is *st.DataSource as s = &w.sources[index];
    if (destroy == 1 && s.object != 0) {
        let is [0]u8 as empty;
        st._send(w, s.object, 1, &empty[0], 0, 0 - 1);
    }
    transfer.offer_free(&s.offer);
    if (w.selection_source[0] == s.object) { w.selection_source[0] = 0; }
    if (w.selection_source[1] == s.object) { w.selection_source[1] = 0; }
    if (w.drag_source == s.object) { w.drag_source = 0; }
    if (s.object >= 2 && s.object < st.MAX_OBJECTS) { st._objects[s.object].owner = cast(*st.Window, 0); }
    mem.memzero(cast(*u8, s), sizeof(st.DataSource));
}

// A source of what o offers (copied), for purpose, its MIME types told: its
// index, -1 when it could not be made.
fn _source_new(w as *st.Window, purpose as i32, o as *transfer.Offer) as i32 {
    let is i32 as manager with mut = w.data_manager;
    if (purpose == st._FOR_PRIMARY) { manager = w.primary_manager; }
    if (manager == 0 || o.formats == 0) { return 0 - 1; }
    let is i32 as index = _source_slot(w);
    if (index < 0) { return 0 - 1; }
    let is *st.DataSource as s = &w.sources[index];
    mem.memzero(cast(*u8, s), sizeof(st.DataSource));
    transfer.offer_init(&s.offer);
    if (transfer.offer_copy(&s.offer, o) == 0) { return 0 - 1; }
    let is i32 as object = st._id(w);
    if (object == 0) { transfer.offer_free(&s.offer); return 0 - 1; }
    // The event that carries a descriptor: send, 1 on wl_data_source, 0 on
    // the primary selection's source.
    st._objects[object].fd_opcode = 1;
    if (purpose == st._FOR_PRIMARY) { st._objects[object].fd_opcode = 0; }
    s.object = object;
    s.purpose = purpose;
    let is [4]u8 as idp;
    st._put(&idp[0], cast(u32, object));
    let is i32 as ok with mut = st._send(w, manager, 0, &idp[0], 4, 0 - 1);
    if (ok == 1 && (o.formats & transfer.FILES) != 0) { ok = st._send_string(w, object, 0, transfer.MIME_URIS); }
    if (ok == 1 && (o.formats & transfer.TEXT) != 0) {
        ok = st._send_string(w, object, 0, transfer.MIME_UTF8);
        if (ok == 1) { ok = st._send_string(w, object, 0, "UTF8_STRING"); }
        if (ok == 1) { ok = st._send_string(w, object, 0, "text/plain"); }
    }
    if (ok == 1 && (o.formats & transfer.PNG) != 0) { ok = st._send_string(w, object, 0, transfer.MIME_PNG); }
    // Every named one by its name.
    let is i64 as k with mut = 0;
    while (ok == 1 && k < s.offer.named_n) {
        ok = st._send_string(w, object, 0, transfer.named_name(&s.offer, k));
        k = k + 1;
    }
    if (ok == 0) { _source_release(w, index, 1); return 0 - 1; }
    return index;
}

// One of our sources' events: wl_data_source's target (0), send (1),
// cancelled (2), dnd_drop_performed (3), dnd_finished (4), action (5); the
// primary selection source's send (0), cancelled (1).
fn _source_event(w as *st.Window, object as i32, op as i32, p as *u8) as void {
    let is i32 as index = _source_index(w, object);
    if (index < 0) { return; }
    let is *st.DataSource as s = &w.sources[index];
    let is i32 as primary = cast(i32, s.purpose == st._FOR_PRIMARY);
    if ((primary == 0 && op == 1) || (primary == 1 && op == 0)) {
        let is i64 as fd = st._take_recv_fd();
        if (fd < 0) { return; }
        let is i32 as len = cast(i32, st._word(p));
        let is i32 as f with mut = 0;
        let is i64 as named with mut = 0 - 1;
        if (len > 1 && len <= 256 && st._wire_size >= 12 + len) {
            f = transfer.format_of(cast(*u8, cast(i64, p) + 4), cast(i64, len - 1));
            if (f == 0) { named = transfer.offer_find(&s.offer, cast(*u8, cast(i64, p) + 4), cast(i64, len - 1)); }
        }
        if (named >= 0) { _write_start(w, fd, transfer.named_bytes(&s.offer, named)); return; }
        if (f == 0 || (s.offer.formats & f) == 0) { linux.close(fd); return; }
        _write_start(w, fd, transfer.offer_bytes(&s.offer, f));
        return;
    }
    if ((primary == 0 && op == 2) || (primary == 1 && op == 1)) {
        // Cancelled: a selection another took; a drag refused or cancelled.
        if (s.purpose == st._FOR_DRAG) { _drag_done(w, 0); }
        _source_release(w, index, 1);
        return;
    }
    if (primary == 1) { return; }
    if (op == 3) { s.dropped = 1; return; }
    if (op == 4) {
        let is i32 as done with mut = s.action;
        if (done == 0) { done = transfer.COPY; }
        _drag_done(w, done);
        _source_release(w, index, 1);
        return;
    }
    if (op == 5 && st._wire_size >= 12) { s.action = cast(i32, st._word(p)) & (transfer.COPY | transfer.MOVE); }
}

fn _drag_done(w as *st.Window, action as i32) as void {
    // The image it carried: gone with it.
    if (w.drag_icon != 0) { st._send(w, w.drag_icon, 0, cast(*u8, 0), 0, 0 - 1); w.drag_icon = 0; }
    if (w.drag_icon_buffer != 0) { st._send(w, w.drag_icon_buffer, 0, cast(*u8, 0), 0, 0 - 1); w.drag_icon_buffer = 0; }
    if (cast(i64, w.drag_icon_map) != 0) { linux.munmap(w.drag_icon_map, w.drag_icon_bytes); w.drag_icon_map = cast(*u8, 0); }
    // A toplevel carried by the drag: let go of, where the drag left it.
    if (w.toplevel_drag != 0) { st._send(w, w.toplevel_drag, 0, cast(*u8, 0), 0, 0 - 1); w.toplevel_drag = 0; }
    let is event.Event as e;
    event.clear(&e); e.kind = event.DRAG_DONE; e.action = action;
    w.frame_ready = 1;
    st._queue(w, &e);
}

// Whether a reader's descriptor has something to read, or a writer's room to
// write, now.
fn _transfer_ready(w as *st.Window) as i32 {
    if (w.reading[st.PASTE].fd >= 0 && sys.wait_readable(w.reading[st.PASTE].fd, 0) > 0) { return 1; }
    if (w.reading[st.DROP].fd >= 0 && sys.wait_readable(w.reading[st.DROP].fd, 0) > 0) { return 1; }
    let is i32 as k with mut = 0;
    while (k < st.MAX_WRITERS) {
        if (w.writing[k].fd >= 0 && sys.wait_writable(w.writing[k].fd, 0) > 0) { return 1; }
        k = k + 1;
    }
    return 0;
}

// Every transfer moved on as far as it can now: what is read read, what is
// written written.
fn _transfers(w as *st.Window) as void {
    _readers(w);
    _writers(w);
}

// Both readers and every writer stopped, their descriptors closed.
fn _transfers_end(w as *st.Window) as void {
    _read_cancel(w, st.PASTE);
    _read_cancel(w, st.DROP);
    transfer.bytes_free(&w.reading[st.PASTE].data);
    transfer.bytes_free(&w.reading[st.DROP].data);
    let is i32 as k with mut = 0;
    while (k < st.MAX_WRITERS) {
        _write_end(w, k);
        transfer.bytes_free(&w.writing[k].data);
        k = k + 1;
    }
    transfer.bytes_free(&w.drop_paths);
    transfer.bytes_free(&w.drop_text);
    transfer.bytes_free(&w.drop_data);
    transfer.names_free(&w.paste_names);
    w.paste_state = st._PASTE_IDLE;
}
