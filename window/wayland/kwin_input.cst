// window/wayland/kwin_input.cst — a user's pointer, buttons, wheel, keys and
// fingers, made up for a KWin of the tests' own.
//
// The KWin tests drove the pointer and the keyboard through the X server
// KWin was nested in (XTest). KWin 6.8 nests only in a server with DRI3
// 1.2, which Xvfb is not, so they run on its virtual backend, where the only
// way in is KWin's own fake input: org_kde_kwin_fake_input, bound on a
// Wayland connection of its own and turned by KWin into devices of its seat
// (run_kwin.sh starts it with KWIN_WAYLAND_NO_PERMISSION_CHECKS, or KWin
// ignores what an unknown client asks). Spoken on the wire here, test
// support, not library. Positions are KWin's global logical pixels.
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/env.cst" as env;
use "std/os/linux.cst" as linux;
use "../../sys/linux.cst" as sys;

// Linux's evdev codes for the buttons (linux/input-event-codes.h).
let is u32 as BTN_LEFT   with imut = 272;
let is u32 as BTN_RIGHT  with imut = 273;
let is u32 as BTN_MIDDLE with imut = 274;

// org_kde_kwin_fake_input's requests.
let is i32 as _AUTHENTICATE     with imut = 0;
let is i32 as _BUTTON           with imut = 2;
let is i32 as _AXIS             with imut = 3;
let is i32 as _TOUCH_DOWN       with imut = 4;
let is i32 as _TOUCH_MOTION     with imut = 5;
let is i32 as _TOUCH_UP         with imut = 6;
let is i32 as _TOUCH_CANCEL     with imut = 7;
let is i32 as _TOUCH_FRAME      with imut = 8;
let is i32 as _MOTION_ABSOLUTE  with imut = 9;
let is i32 as _KEYBOARD_KEY     with imut = 10;

let is i32 as _FI with imut = 4;   // the fake input's object

let is i64 as _fd with mut = 0 - 1;
let is u32 as _version with mut = cast(u32, 0);
let is [8192]u8 as _rbuf;
let is i64 as _rlen with mut = 0;

fn _put(p as *u8, at as i64, v as u32) as void { *cast(*u32, cast(i64, p) + at) = v; }
fn _word(p as *u8, at as i64) as u32 { return *cast(*u32, cast(i64, p) + at); }

fn _send(obj as i32, op as i32, args as *u8, n as i64) as void {
    let is [256]u8 as m;
    _put(&m[0], 0, cast(u32, obj));
    _put(&m[0], 4, cast(u32, ((8 + n) << 16) | op));
    if (n > 0) { mem.memcpy(&m[8], args, n); }
    linux.write(_fd, &m[0], 8 + n);
}

// A string argument at p: its bytes on the wire.
fn _string(p as *u8, s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    _put(p, 0, cast(u32, n + 1));
    mem.memset(cast(*u8, cast(i64, p) + 4), 0, ((n + 1 + 3) / 4) * 4);
    mem.memcpy(cast(*u8, cast(i64, p) + 4), s, n);
    return 4 + ((n + 1 + 3) / 4) * 4;
}

fn _fixed(v as f64) as u32 { return cast(u32, cast(i32, v * 256.0)); }

// The bytes past at moved to the buffer's start.
fn _shift(at as i64) as void {
    let is i64 as i with mut = 0;
    while (i < _rlen) {
        _rbuf[i] = _rbuf[at + i];
        i = i + 1;
    }
}

// A sync on the connection answered: what was sent before it is KWin's.
fn _sync(id as u32) as i32 {
    let is [4]u8 as a;
    _put(&a[0], 0, id);
    _send(1, 0, &a[0], 4);
    let is i64 as until = time.now_ms() + 3000;
    while (time.now_ms() < until) {
        if (sys.wait_readable(_fd, 50) <= 0) { continue; }
        let is i64 as r = linux.read(_fd, cast(*u8, cast(i64, &_rbuf[0]) + _rlen), 8192 - _rlen);
        if (r <= 0) { return 0; }
        _rlen = _rlen + r;
        let is i32 as done with mut = 0;
        let is i64 as at with mut = 0;
        while (at + 8 <= _rlen) {
            let is u32 as head = _word(&_rbuf[0], at + 4);
            let is i64 as size = cast(i64, head >> 16);
            if (size < 8 || at + size > _rlen) { break; }
            if (_word(&_rbuf[0], at) == id && (head & cast(u32, 65535)) == cast(u32, 0)) { done = 1; }
            at = at + size;
        }
        _rlen = _rlen - at;
        _shift(at);
        if (done == 1) { return 1; }
    }
    return 0;
}

// Connected, the fake input bound and authenticated: 1, or 0 when KWin
// offers none.
fn open() as i32 {
    if (_fd >= 0) { return 1; }
    let is *u8 as rt = env.getenv("XDG_RUNTIME_DIR");
    let is *u8 as name = env.getenv("WAYLAND_DISPLAY");
    if (cast(i64, rt) == 0 || cast(i64, name) == 0) { return 0; }
    let is [256]u8 as path;
    let is i64 as n with mut = 0;
    while (rt[n] != 0 && n < 200) { path[n] = rt[n]; n = n + 1; }
    path[n] = cast(u8, 47);
    n = n + 1;
    let is i64 as k with mut = 0;
    while (name[k] != 0 && n < 254) { path[n] = name[k]; n = n + 1; k = k + 1; }
    path[n] = cast(u8, 0);
    _fd = sys.connect_unix(&path[0], n, 0);
    if (_fd < 0) { return 0; }
    _rlen = 0;
    let is [16]u8 as a;
    _put(&a[0], 0, 2);
    _send(1, 1, &a[0], 4);      // get_registry → 2
    _put(&a[0], 0, 3);
    _send(1, 0, &a[0], 4);      // sync → 3
    let is u32 as global with mut = cast(u32, 0);
    let is i32 as synced with mut = 0;
    let is i64 as until = time.now_ms() + 3000;
    while (synced == 0 && time.now_ms() < until) {
        if (sys.wait_readable(_fd, 50) <= 0) { continue; }
        let is i64 as r = linux.read(_fd, cast(*u8, cast(i64, &_rbuf[0]) + _rlen), 8192 - _rlen);
        if (r <= 0) { break; }
        _rlen = _rlen + r;
        let is i64 as at with mut = 0;
        while (at + 8 <= _rlen) {
            let is u32 as head = _word(&_rbuf[0], at + 4);
            let is i64 as size = cast(i64, head >> 16);
            if (size < 8 || at + size > _rlen) { break; }
            let is u32 as obj = _word(&_rbuf[0], at);
            let is u32 as op = head & cast(u32, 65535);
            if (obj == cast(u32, 2) && op == cast(u32, 0)) {
                let is *u8 as iface = cast(*u8, cast(i64, &_rbuf[0]) + at + 16);
                let is i64 as ilen = cast(i64, _word(&_rbuf[0], at + 12));
                if (ilen == 24 && mem.memcmp(iface, "org_kde_kwin_fake_input", 23) == 0) {
                    global = _word(&_rbuf[0], at + 8);
                    _version = _word(&_rbuf[0], at + 16 + ((ilen + 3) / 4) * 4);
                }
            }
            if (obj == cast(u32, 3) && op == cast(u32, 0)) { synced = 1; }
            at = at + size;
        }
        _rlen = _rlen - at;
        _shift(at);
    }
    if (global == cast(u32, 0)) {
        linux.close(_fd);
        _fd = 0 - 1;
        return 0;
    }
    // bind(name, "org_kde_kwin_fake_input", version, new id 4)
    let is [64]u8 as b;
    _put(&b[0], 0, global);
    let is i64 as m = 4 + _string(cast(*u8, cast(i64, &b[0]) + 4), "org_kde_kwin_fake_input");
    if (_version > cast(u32, 4)) { _version = cast(u32, 4); }
    _put(&b[0], m, _version);
    _put(&b[0], m + 4, cast(u32, _FI));
    _send(2, 0, &b[0], m + 8);
    let is [96]u8 as auth;
    let is i64 as n1 = _string(&auth[0], "caustic test");
    let is i64 as n2 = _string(cast(*u8, cast(i64, &auth[0]) + n1), "input made up by a test");
    _send(_FI, _AUTHENTICATE, &auth[0], n1 + n2);
    return _sync(cast(u32, 5));
}

fn close() as void {
    if (_fd >= 0) { linux.close(_fd); }
    _fd = 0 - 1;
}

// What was sent so far taken by KWin: 1, or 0 when it did not answer.
fn flush() as i32 {
    if (_fd < 0) { return 0; }
    return _sync(cast(u32, 5));
}

// The pointer to x, y.
fn move(x as f64, y as f64) as void {
    if (_fd < 0) { return; }
    let is [8]u8 as a;
    _put(&a[0], 0, _fixed(x));
    _put(&a[0], 4, _fixed(y));
    _send(_FI, _MOTION_ABSOLUTE, &a[0], 8);
    flush();
}

// Button (BTN_*) pressed (1) or let go (0).
fn button(b as u32, down as i32) as void {
    if (_fd < 0) { return; }
    let is [8]u8 as a;
    _put(&a[0], 0, b);
    _put(&a[0], 4, cast(u32, down));
    _send(_FI, _BUTTON, &a[0], 8);
    flush();
}

// The wheel along axis (0 down the screen, 1 across) by value, in the
// logical pixels a notch of 15 is.
fn axis(which as u32, value as f64) as void {
    if (_fd < 0) { return; }
    let is [8]u8 as a;
    _put(&a[0], 0, which);
    _put(&a[0], 4, _fixed(value));
    _send(_FI, _AXIS, &a[0], 8);
    flush();
}

// Evdev key code pressed (1) or let go (0) — an X keycode less 8.
fn key(code as u32, down as i32) as void {
    if (_fd < 0 || _version < cast(u32, 4)) { return; }
    let is [8]u8 as a;
    _put(&a[0], 0, code);
    _put(&a[0], 4, cast(u32, down));
    _send(_FI, _KEYBOARD_KEY, &a[0], 8);
    flush();
}

// A finger: down, moved, up (op _TOUCH_*), each followed by a frame.
fn touch(op as i32, id as i32, x as f64, y as f64) as void {
    if (_fd < 0) { return; }
    let is [12]u8 as a;
    _put(&a[0], 0, cast(u32, id));
    _put(&a[0], 4, _fixed(x));
    _put(&a[0], 8, _fixed(y));
    if (op == _TOUCH_UP) { _send(_FI, op, &a[0], 4); } else { _send(_FI, op, &a[0], 12); }
    _send(_FI, _TOUCH_FRAME, cast(*u8, 0), 0);
    flush();
}

fn touch_down(id as i32, x as f64, y as f64) as void { touch(_TOUCH_DOWN, id, x, y); }
fn touch_move(id as i32, x as f64, y as f64) as void { touch(_TOUCH_MOTION, id, x, y); }
fn touch_up(id as i32) as void { touch(_TOUCH_UP, id, 0.0, 0.0); }

fn touch_cancel() as void {
    if (_fd < 0) { return; }
    _send(_FI, _TOUCH_CANCEL, cast(*u8, 0), 0);
    flush();
}

// The evdev code of X keysym ks on a US layout — what the tests press — or
// 0 for one not here.
fn code_of(ks as i64) as u32 {
    if (ks == 65505) { return cast(u32, 42); }    // Shift_L
    if (ks == 65506) { return cast(u32, 54); }    // Shift_R
    if (ks == 65507) { return cast(u32, 29); }    // Control_L
    if (ks == 65513) { return cast(u32, 56); }    // Alt_L
    if (ks == 65515) { return cast(u32, 125); }   // Super_L
    if (ks == 65307) { return cast(u32, 1); }     // Escape
    if (ks == 65293) { return cast(u32, 28); }    // Return
    if (ks == 65288) { return cast(u32, 14); }    // BackSpace
    if (ks == 65289) { return cast(u32, 15); }    // Tab
    if (ks == 65535) { return cast(u32, 111); }   // Delete
    if (ks == 65360) { return cast(u32, 102); }   // Home
    if (ks == 65367) { return cast(u32, 107); }   // End
    if (ks == 65361) { return cast(u32, 105); }   // Left
    if (ks == 65362) { return cast(u32, 103); }   // Up
    if (ks == 65363) { return cast(u32, 106); }   // Right
    if (ks == 65364) { return cast(u32, 108); }   // Down
    if (ks == 32) { return cast(u32, 57); }       // space
    if (ks >= 65 && ks <= 90) { return code_of(ks + 32); }
    if (ks >= 97 && ks <= 122) {
        // qwertyuiop, asdfghjkl, zxcvbnm rows, by letter.
        let is *u8 as codes = "\x1e\x30\x2e\x20\x12\x21\x22\x23\x17\x24\x25\x26\x32\x31\x18\x19\x10\x13\x1f\x14\x16\x2f\x11\x2d\x15\x2c";
        return cast(u32, codes[ks - 97]);
    }
    if (ks == 48) { return cast(u32, 11); }
    if (ks >= 49 && ks <= 57) { return cast(u32, ks - 49 + 2); }
    return cast(u32, 0);
}

// The key of X keysym ks pressed (1) or let go (0).
fn key_sym(ks as i64, down as i32) as void {
    let is u32 as c = code_of(ks);
    if (c != cast(u32, 0)) { key(c, down); }
}
