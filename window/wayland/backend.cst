    cursor_shape_manager as i32;
    cursor_shape_device as i32;
    viewporter as i32;
    viewport as i32;
    fractional_manager as i32;
    fractional_surface as i32;
    data_manager as i32;
    data_device as i32;
    primary_manager as i32;
    primary_device as i32;
    text_input_manager as i32;
    text_input as i32;
    dialog as i32;
    parent_toplevel as i32;
    surface as i32;
    xdg_surface as i32;
    toplevel as i32;
    pool as i32;
    callback as i32;
    output_count as i32;
    outputs as [8]Output;
    active_output as i32;
    scale as i32;
    scale120 as i32;
    fractional_active as i32;
    seat_version as i32;
    seat as i32;
    pointer as i32;
