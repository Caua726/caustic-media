    drop_storage as *u8;
    drop_len as i64;
    drop_file_count as i64;
    drop_truncated as i32;
    drop_kind as i32;
    drop_ready as i32;
    drop_offer as i32;
    drop_offered as i32;
    drop_answer as i32;
    drop_pending as i32;
    drop_serial as u32;
    drop_x as i64;
    drop_y as i64;
    received_len as i64;
    sources as [8]DataSource;
    offers as [8]DataOffer;
    xkb_context as *u8;
    xkb_keymap as *u8;
    xkb_state as *u8;
    compose_table as *u8;
    compose_state as *u8;
    min_width as i64;
    min_height as i64;
    max_width as i64;
    max_height as i64;
    ext_left as i64;
    ext_right as i64;
    ext_top as i64;
    ext_bottom as i64;
