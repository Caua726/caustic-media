}

let is [4096]u8 as _wire with mut;
let is i32 as _wire_size with mut = 0;
let is i32 as MAX_WINDOWS with imut = 64;
let is i32 as MAX_OBJECTS with imut = 8192;
struct ObjectSlot {
    owner as *Window;
    next as i32;
    fd_opcode as i32; // retained until delete_id, including after owner closes
}
struct Binding {
    global as u32;
    object as i32;
}
let is [8192]ObjectSlot as _objects with mut;
let is [64]*Window as _windows with mut;
let is [32]Binding as _bindings with mut;
let is Globals as _globals with mut;
let is i32 as _registry with mut = 0;
let is i32 as _objects_ready with mut = 0;
let is i32 as _free_object with mut = 0;
let is i64 as _connection_fd with mut = 0 - 1;
let is i32 as _connection_refs with mut = 0;
let is [16]i32 as _recv_fds with mut;
let is i32 as _recv_fd_count with mut = 0;
let is i32 as _recv_fd_head with mut = 0;

fn _object_pool() as void {
    let is i32 as i with mut = 2;
    while (i < MAX_OBJECTS) {
        _objects[i].owner = cast(*Window, 0);
        _objects[i].next = i + 1;
        _objects[i].fd_opcode = 0 - 1;
        i = i + 1;
    }
    _objects[MAX_OBJECTS - 1].next = 0;
    _free_object = 2; _objects_ready = 1;
}

fn _release_object(id as i32) as void {
    if (id < 2 || id >= MAX_OBJECTS || _objects[id].next != 0 - 1) { return; }
    _objects[id].owner = cast(*Window, 0);
    _objects[id].fd_opcode = 0 - 1;
    _objects[id].next = _free_object;
    _free_object = id;
}

fn _attach(w as *Window) as i32 {
    let is i32 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        if (cast(i64, _windows[i]) == 0) {
            _windows[i] = w; w.connection_slot = i;
            _connection_refs = _connection_refs + 1;
            return 1;
        }
        i = i + 1;
    }
    w.fd = 0 - 1;
    return 0;
}

fn _disconnect(w as *Window) as void {
    let is i32 as i with mut = 2;
    while (i < MAX_OBJECTS) {
        if (_objects[i].owner == w) { _objects[i].owner = cast(*Window, 0); }
        i = i + 1;
    }
    if (w.connection_slot >= 0) {
        _windows[w.connection_slot] = cast(*Window, 0);
        _connection_refs = _connection_refs - 1;
    }
    if (_connection_refs == 0 && _connection_fd >= 0) {
        _close_recv_fds();
        linux.close(_connection_fd);
        _connection_fd = 0 - 1; _objects_ready = 0;
        mem.memzero(cast(*u8, &_bindings[0]), 32 * sizeof(Binding));
        mem.memzero(cast(*u8, &_globals), sizeof(Globals));
        _registry = 0;
    }
    w.fd = 0 - 1; w.connection_slot = 0 - 1;
}

fn _zero(w as *Window) as void {
    mem.memzero(cast(*u8, w), sizeof(Window));
    w.fd = 0 - 1; w.memfd = 0 - 1; w.connection_slot = 0 - 1;
    w.registry = 0; w.compositor = 0; w.shm = 0; w.wm_base = 0;
    w.surface = 0; w.xdg_surface = 0; w.toplevel = 0; w.pool = 0;
    w.callback = 0;
    w.width = 0; w.height = 0; w.logical_width = 0; w.logical_height = 0;
    w.configured_width = 0; w.configured_height = 0;
    w.scale = 1; w.scale120 = 120; w.fractional_active = 0;
    w.active_output = 0 - 1; w.output_count = 0;
    w.buffer_width = 0; w.buffer_height = 0; w.resize_detached = 0;
    w.buffers[0].object = 0; w.buffers[0].busy = 0;
    w.buffers[1].object = 0; w.buffers[1].busy = 0; w.current = 0 - 1;
    w.last_buffer = 0 - 1; w.visible = 0;
    w.event_head = 0; w.event_len = 0;
    w.state = 0; w.old_state = 0; w.err = OK; w.opened = 0; w.mapped = 0;
    w.resized = 0; w.frame_ready = 0; w.close_requested = 0; w.acked = 0;
    w.transfer_fd = 0 - 1; w.drop_storage = cast(*u8, 0);
    w.ime_rect_x = 0 - 1; w.ime_rect_y = 0 - 1;
    w.ime_rect_w = 0 - 1; w.ime_rect_h = 0 - 1;

}
fn _queue(w as *Window, e as *event.Event) as void {
    if (w.event_len == MAX_EVENTS) {
        w.event_head = (w.event_head + 1) % MAX_EVENTS;
        w.event_len = w.event_len - 1;
    }
    let is i32 as at = (w.event_head + w.event_len) % MAX_EVENTS;
    w.events[at] = *e;
    if (e.text_len > 0 && e.text_len < 256) {
        let is *u8 as text = cast(*u8, cast(i64, &w.event_text[0]) + at * 256);
        mem.memcpy(text, e.text, e.text_len);
        text[e.text_len] = 0;
        w.events[at].text = text;
    }
    w.event_len = w.event_len + 1;
}

fn _event(w as *Window, kind as i32) as void {
    let is event.Event as e;
    event.clear(&e);
    e.kind = kind;
    _queue(w, &e);
}

fn _id(w as *Window) as i32 {
    if (_objects_ready == 0) { _object_pool(); }
    let is i32 as id = _free_object;
    if (id == 0) { w.err = NO_MEMORY; return 0; }
    _free_object = _objects[id].next;
    _objects[id].next = 0 - 1;
    _objects[id].owner = w;
    _objects[id].fd_opcode = 0 - 1;
    return id;
}

fn _word(p as *u8) as u32 { return *cast(*u32, p); }
fn _put(p as *u8, value as u32) as void { *cast(*u32, p) = value; }

fn _write_all(fd as i64, p as *u8, n as i64) as i32 {
    let is i64 as sent with mut = 0;
    while (sent < n) {
        let is i64 as r = linux.sendto(fd, cast(*u8, cast(i64, p) + sent), n - sent, sys.MSG_NOSIGNAL, cast(*u8, 0), 0);
        if (r <= 0) { return 0; }
        sent = sent + r;
    }
    return 1;
}

fn _read_all(fd as i64, p as *u8, n as i64) as i32 {
    let is i64 as got with mut = 0;
    while (got < n) {
        let is i64 as r = linux.read(fd, cast(*u8, cast(i64, p) + got), n - got);
        if (r <= 0) { return 0; }
        got = got + r;
    }
    return 1;
}

fn _send(w as *Window, object as i32, opcode as i32, body as *u8, n as i32, pass_fd as i64) as i32 {
    if (w.fd < 0) { return 0; }
    if (n < 0 || n > MAX_WIRE - 8) { return 0; }
    if (w.err == NO_MEMORY) { return 0; }
    let is [4096]u8 as packet;
    _put(&packet[0], cast(u32, object));
    _put(&packet[4], cast(u32, ((n + 8) << 16) | opcode));
    if (n > 0) { mem.memcpy(cast(*u8, cast(i64, &packet) + 8), body, n); }
    let is i64 as total = n + 8;
    if (pass_fd >= 0) {
        let is i32 as fd = cast(i32, pass_fd);
        let is i64 as sent = sys.send_fds(w.fd, cast(*u8, &packet), total, &fd, 1);
        if (sent <= 0) { return 0; }
        if (sent < total) { return _write_all(w.fd, cast(*u8, cast(i64, &packet) + sent), total - sent); }
        return 1;
    }
    return _write_all(w.fd, cast(*u8, &packet), total);
}

fn _surface_commit(w as *Window) as i32 {
    if (w.surface == 0) { return 0; }
    return _send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1);
}

// SCM_RIGHTS is an ordered stream independent of message byte boundaries:
// a descriptor received with an earlier event waits for its FD argument.
fn _take_recv_fd() as i64 {
    if (_recv_fd_count == 0) { return 0 - 1; }
    let is i32 as index = _recv_fd_head;
    let is i64 as fd = _recv_fds[index];
    _recv_fds[index] = 0 - 1;
    _recv_fd_head = (index + 1) & 15;
    _recv_fd_count = _recv_fd_count - 1;
    return fd;
}

fn _close_recv_fds() as void {
    while (_recv_fd_count > 0) {
        let is i64 as fd = _take_recv_fd();
        if (fd >= 0) { linux.close(fd); }
    }
}

fn _recv_part(w as *Window, p as *u8, n as i64) as i32 {
    let is i64 as got with mut = 0;
    while (got < n) {
        let is [16]i32 as fds;
        let is i64 as count with mut = 0;
        let is i64 as r = sys.recv_fds(w.fd, cast(*u8, cast(i64, p) + got), n - got,
                                        &fds[0], &count, 1);
        if (r <= 0) {
            let is i64 as j with mut = 0;
            while (j < count) { linux.close(fds[j]); j = j + 1; }
            _close_recv_fds();
            return 0;
        }
        let is i64 as j with mut = 0;
        while (j < count) {
            if (_recv_fd_count < 16) {
                _recv_fds[(_recv_fd_head + _recv_fd_count) & 15] = fds[j];
                _recv_fd_count = _recv_fd_count + 1;
            } else {
                while (j < count) { linux.close(fds[j]); j = j + 1; }
                _close_recv_fds();
                return 0;
            }
            j = j + 1;
        }
        got = got + r;
    }
    return 1;
}

fn _recv(w as *Window) as i32 {
    if (_recv_part(w, &_wire[0], 8) == 0) { return 0; }
    let is u32 as obj = _word(&_wire[0]);
    let is u32 as oh = _word(&_wire[4]);
    let is i32 as size = cast(i32, oh >> 16);
    if (size < 8 || size > MAX_WIRE || (size & 3) != 0) { return 0; }
    if (_recv_part(w, &_wire[8], size - 8) == 0) { return 0; }
    _wire_size = size;
    return cast(i32, obj);
}

fn _same(p as *u8, n as i32, s as *u8) as i32 {
    let is i32 as k with mut = 0;
    while (s[k] != 0) { k = k + 1; }
    if (k != n) { return 0; }
    return cast(i32, mem.memcmp(p, s, n) == 0);
}

fn _bounded(a as i32, b as i32) as i32 {
    if (a < b) { return a; }
    return b;
}

// Guard the raw opcode constants used below against the XML-generated catalog.
fn _protocol_ready() as i32 {
    let is protocol.Message as compositor = protocol.request_message(3, 0);
    let is protocol.Message as shm = protocol.request_message(5, 0);
    let is protocol.Message as seat_pointer = protocol.request_message(14, 0);
    let is protocol.Message as seat_keyboard = protocol.request_message(14, 1);
    let is protocol.Message as surface_commit = protocol.request_message(13, 6);
    let is protocol.Message as xdg_surface = protocol.request_message(23, 2);
    let is protocol.Message as ack = protocol.request_message(25, 4);
    let is protocol.Message as title = protocol.request_message(26, 2);
    let is protocol.Message as parent = protocol.request_message(26, 1);
    let is protocol.Message as min_size = protocol.request_message(26, 8);
    let is protocol.Message as max_size = protocol.request_message(26, 7);
    let is protocol.Message as maximize = protocol.request_message(26, 9);
    let is protocol.Message as unmaximize = protocol.request_message(26, 10);
    let is protocol.Message as fullscreen = protocol.request_message(26, 11);
    let is protocol.Message as unfullscreen = protocol.request_message(26, 12);
    let is protocol.Message as minimize = protocol.request_message(26, 13);
    let is protocol.Message as menu = protocol.request_message(26, 4);
    let is protocol.Message as move = protocol.request_message(26, 5);
    let is protocol.Message as resize = protocol.request_message(26, 6);
    let is protocol.Message as region_create = protocol.request_message(3, 1);
    let is protocol.Message as input_region = protocol.request_message(13, 5);
    let is protocol.Message as region_destroy = protocol.request_message(19, 0);
    let is protocol.Message as region_add = protocol.request_message(19, 1);
    let is protocol.Message as decoration_get = protocol.request_message(30, 1);
    let is protocol.Message as decoration_mode = protocol.request_message(31, 1);
    let is protocol.Message as dialog_get = protocol.request_message(44, 1);
    let is protocol.Message as dialog_modal = protocol.request_message(45, 1);
    let is protocol.Message as dialog_unmodal = protocol.request_message(45, 2);
    let is protocol.Message as buffer_scale = protocol.request_message(13, 8);
    let is protocol.Message as get_viewport = protocol.request_message(28, 1);
    let is protocol.Message as set_destination = protocol.request_message(29, 2);
    let is protocol.Message as get_fractional = protocol.request_message(38, 1);
    let is protocol.Message as preferred_scale = protocol.event_message(39, 0);
    let is protocol.Message as manager_source = protocol.request_message(10, 0);
    let is protocol.Message as manager_device = protocol.request_message(10, 1);
    let is protocol.Message as source_offer = protocol.request_message(8, 0);
    let is protocol.Message as device_selection = protocol.request_message(9, 1);
    let is protocol.Message as data_offer_receive = protocol.request_message(7, 1);
    let is protocol.Message as text_manager_input = protocol.request_message(33, 1);
    let is protocol.Message as text_destroy = protocol.request_message(32, 0);
    let is protocol.Message as text_enable = protocol.request_message(32, 1);
    let is protocol.Message as text_disable = protocol.request_message(32, 2);
    let is protocol.Message as text_content_type = protocol.request_message(32, 5);
    let is protocol.Message as text_cursor = protocol.request_message(32, 6);
    let is protocol.Message as text_commit = protocol.request_message(32, 7);
    let is protocol.Message as text_preedit = protocol.event_message(32, 2);
    let is protocol.Message as text_commit_event = protocol.event_message(32, 3);
    let is protocol.Message as text_delete = protocol.event_message(32, 4);
    let is protocol.Message as text_done = protocol.event_message(32, 5);
    let is protocol.Message as text_enter = protocol.event_message(32, 0);
    let is protocol.Message as text_leave = protocol.event_message(32, 1);
    let is protocol.Message as primary_get_device = protocol.request_message(34, 1);
    let is protocol.Message as primary_selection = protocol.request_message(35, 0);
    let is protocol.Message as primary_source_offer = protocol.request_message(37, 0);
    let is protocol.Message as primary_offer_receive = protocol.request_message(36, 0);
    let is protocol.Message as registry_event = protocol.event_message(1, 0);
    let is protocol.Message as seat_caps = protocol.event_message(14, 0);
    let is protocol.Message as pointer_enter = protocol.event_message(15, 0);
    let is protocol.Message as pointer_motion = protocol.event_message(15, 2);
    let is protocol.Message as pointer_button = protocol.event_message(15, 3);
    let is protocol.Message as pointer_axis = protocol.event_message(15, 4);
    let is protocol.Message as keyboard_keymap = protocol.event_message(16, 0);
    let is protocol.Message as keyboard_key = protocol.event_message(16, 3);
    let is protocol.Message as keyboard_modifiers = protocol.event_message(16, 4);
    let is protocol.Message as configure_event = protocol.event_message(25, 0);
    let is protocol.Message as toplevel_event = protocol.event_message(26, 0);
    return cast(i32, compositor.opcode == 0 && compositor.arg_count == 1 &&
                     shm.opcode == 0 && shm.arg_count == 3 &&
                     seat_pointer.opcode == 0 && seat_pointer.arg_count == 1 &&
                     seat_keyboard.opcode == 1 && seat_keyboard.arg_count == 1 &&
                     surface_commit.opcode == 6 && surface_commit.arg_count == 0 &&
                     xdg_surface.opcode == 2 && xdg_surface.arg_count == 2 &&
                     ack.opcode == 4 && ack.arg_count == 1 &&
                     title.opcode == 2 && title.arg_count == 1 &&
                     parent.opcode == 1 && parent.arg_count == 1 &&
                     min_size.opcode == 8 && min_size.arg_count == 2 &&
                     max_size.opcode == 7 && max_size.arg_count == 2 &&
                     maximize.opcode == 9 && maximize.arg_count == 0 &&
                     unmaximize.opcode == 10 && unmaximize.arg_count == 0 &&
                     fullscreen.opcode == 11 && fullscreen.arg_count == 1 &&
                     unfullscreen.opcode == 12 && unfullscreen.arg_count == 0 &&
                     minimize.opcode == 13 && minimize.arg_count == 0 &&
                     menu.opcode == 4 && menu.arg_count == 4 &&
                     move.opcode == 5 && move.arg_count == 2 &&
                     resize.opcode == 6 && resize.arg_count == 3 &&
                     region_create.opcode == 1 && region_create.arg_count == 1 &&
                     input_region.opcode == 5 && input_region.arg_count == 1 &&
                     region_destroy.opcode == 0 && region_destroy.arg_count == 0 &&
                     region_add.opcode == 1 && region_add.arg_count == 4 &&
                     decoration_get.opcode == 1 && decoration_get.arg_count == 2 &&
                     decoration_mode.opcode == 1 && decoration_mode.arg_count == 1 &&
                     dialog_get.opcode == 1 && dialog_get.arg_count == 2 &&
                     dialog_modal.opcode == 1 && dialog_modal.arg_count == 0 &&
                     dialog_unmodal.opcode == 2 && dialog_unmodal.arg_count == 0 &&
                     buffer_scale.opcode == 8 && buffer_scale.arg_count == 1 &&
                     get_viewport.opcode == 1 && get_viewport.arg_count == 2 &&
                     set_destination.opcode == 2 && set_destination.arg_count == 2 &&
                     get_fractional.opcode == 1 && get_fractional.arg_count == 2 &&
                     preferred_scale.opcode == 0 && preferred_scale.arg_count == 1 &&
                     manager_source.opcode == 0 && manager_source.arg_count == 1 &&
                     manager_device.opcode == 1 && manager_device.arg_count == 2 &&
                     source_offer.opcode == 0 && source_offer.arg_count == 1 &&
                     device_selection.opcode == 1 && device_selection.arg_count == 2 &&
                     data_offer_receive.opcode == 1 && data_offer_receive.arg_count == 2 &&
                     primary_get_device.opcode == 1 && primary_get_device.arg_count == 2 &&
                     primary_selection.opcode == 0 && primary_selection.arg_count == 2 &&
                     primary_source_offer.opcode == 0 && primary_source_offer.arg_count == 1 &&
                     primary_offer_receive.opcode == 0 && primary_offer_receive.arg_count == 2 &&
                     text_manager_input.opcode == 1 && text_manager_input.arg_count == 2 &&
                     text_destroy.opcode == 0 && text_destroy.arg_count == 0 &&
                     text_enable.opcode == 1 && text_enable.arg_count == 0 &&
                     text_disable.opcode == 2 && text_disable.arg_count == 0 &&
                     text_cursor.opcode == 6 && text_cursor.arg_count == 4 &&
                     text_content_type.opcode == 5 && text_content_type.arg_count == 2 &&
                     text_commit.opcode == 7 && text_commit.arg_count == 0 &&
                     text_preedit.opcode == 2 && text_preedit.arg_count == 3 &&
                     text_commit_event.opcode == 3 && text_commit_event.arg_count == 1 &&
                     text_delete.opcode == 4 && text_delete.arg_count == 2 &&
                     text_done.opcode == 5 && text_done.arg_count == 1 &&
                     text_enter.opcode == 0 && text_enter.arg_count == 1 &&
                     text_leave.opcode == 1 && text_leave.arg_count == 1 &&
                     registry_event.opcode == 0 && registry_event.arg_count == 3 &&
                     seat_caps.opcode == 0 && seat_caps.arg_count == 1 &&
                     pointer_enter.opcode == 0 && pointer_enter.arg_count == 4 &&
                     pointer_motion.opcode == 2 && pointer_motion.arg_count == 3 &&
                     pointer_button.opcode == 3 && pointer_button.arg_count == 4 &&
                     pointer_axis.opcode == 4 && pointer_axis.arg_count == 3 &&
                     keyboard_keymap.opcode == 0 && keyboard_keymap.arg_count == 3 &&
                     keyboard_key.opcode == 3 && keyboard_key.arg_count == 4 &&
                     keyboard_modifiers.opcode == 4 && keyboard_modifiers.arg_count == 5 &&
                     configure_event.opcode == 0 && configure_event.arg_count == 1 &&
                     toplevel_event.opcode == 0 && toplevel_event.arg_count == 3);
}
fn _bind(w as *Window, name as u32, iface as *u8, version as i32, id as i32) as i32 {
    let is [256]u8 as p;
    let is i32 as n with mut = 0;
    _put(&p[n], name); n = n + 4;
    let is i32 as len with mut = 1;
    while (iface[len - 1] != 0) { len = len + 1; }
    let is i32 as padded = ((len + 3) / 4) * 4;
    _put(&p[n], cast(u32, len)); n = n + 4;
    mem.memcpy(&p[n], iface, len);
    if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[n]) + len), 0, padded - len); }
    n = n + padded;
    _put(&p[n], cast(u32, version)); n = n + 4;
    _put(&p[n], cast(u32, id)); n = n + 4;
    return _send(w, w.registry, 0, &p[0], n, 0 - 1);
}

// Globals with no per-window event stream live until the shared connection
// closes. Seat and output objects remain per-window and are released there.
fn _binding(w as *Window, name as u32, iface as *u8, version as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < 32) {
        if (_bindings[i].object != 0 && _bindings[i].global == name) { return _bindings[i].object; }
        if (_bindings[i].object == 0) {
            let is i32 as id = _id(w);
            if (id == 0 || _bind(w, name, iface, version, id) == 0) { return 0; }
            _bindings[i].global = name; _bindings[i].object = id;
            return id;
        }
        i = i + 1;
    }
    w.err = NO_MEMORY;
    return 0;
}

fn _registry_global() as void {
    if (_wire_size < 20) { return; }
    let is u32 as name = _word(&_wire[8]);
    let is i32 as len = cast(i32, _word(&_wire[12]));
    if (len <= 1 || len > 128 || 16 + len > _wire_size) { return; }
    let is *u8 as text = &_wire[16];
    let is i32 as padded = ((len + 3) / 4) * 4;
    let is i32 as version_at = 16 + padded;
    if (version_at + 4 > _wire_size) { return; }
    let is i32 as version = cast(i32, _word(&_wire[version_at]));
    if (_same(text, len - 1, "wl_compositor") == 1 && _globals.compositor_global == 0) {
        _globals.compositor_global = cast(i32, name); _globals.compositor_version = version;
    }
    if (_same(text, len - 1, "wl_shm") == 1 && _globals.shm_global == 0) {
        _globals.shm_global = cast(i32, name);
    }
    if (_same(text, len - 1, "xdg_wm_base") == 1 && _globals.shell_global == 0) {
        _globals.shell_global = cast(i32, name); _globals.shell_version = version;
    }
    if (_same(text, len - 1, "wl_seat") == 1 && _globals.seat_global == 0) {
        _globals.seat_global = cast(i32, name); _globals.seat_version = version;
    }
    if (_same(text, len - 1, "zxdg_decoration_manager_v1") == 1 && _globals.decoration_global == 0) {
        _globals.decoration_global = cast(i32, name); _globals.decoration_version = version;
    }
    if (_same(text, len - 1, "xdg_wm_dialog_v1") == 1 && _globals.dialog_global == 0) {
        _globals.dialog_global = cast(i32, name); _globals.dialog_version = version;
    }
    if (_same(text, len - 1, "wp_cursor_shape_manager_v1") == 1 &&
        _globals.cursor_shape_global == 0) {
        _globals.cursor_shape_global = cast(i32, name); _globals.cursor_shape_version = version;
    }
    if (_same(text, len - 1, "wl_output") == 1 && _globals.output_count < 8) {
        let is i32 as i = _globals.output_count;
        _globals.outputs[i].global = cast(i32, name);
        _globals.outputs[i].version = version;
        _globals.output_count = _globals.output_count + 1;
    }
    if (_same(text, len - 1, "wp_viewporter") == 1 && _globals.viewporter_global == 0) {
        _globals.viewporter_global = cast(i32, name); _globals.viewporter_version = version;
    }
    if (_same(text, len - 1, "wp_fractional_scale_manager_v1") == 1 &&
        _globals.fractional_global == 0) {
        _globals.fractional_global = cast(i32, name); _globals.fractional_version = version;
    }
    if (_same(text, len - 1, "wl_data_device_manager") == 1 && _globals.data_manager_global == 0) {
        _globals.data_manager_global = cast(i32, name); _globals.data_manager_version = version;
    }
    if (_same(text, len - 1, "zwp_primary_selection_device_manager_v1") == 1 &&
        _globals.primary_manager_global == 0) {
        _globals.primary_manager_global = cast(i32, name); _globals.primary_manager_version = version;
    }
    if (_same(text, len - 1, "zwp_text_input_manager_v3") == 1 &&
        _globals.text_input_manager_global == 0) {
        _globals.text_input_manager_global = cast(i32, name);
        _globals.text_input_manager_version = version;
    }
}

fn _scale_up(value as i64, factor as i32) as i64 {
    return (value * factor + 119) / 120;
}

fn _scale_down(value as i64, factor as i32) as i64 {
    if (factor <= 0) { return 0; }
    return value * 120 / factor;
}

fn _set_scale120(w as *Window, preferred as i32, buffer_scale as i32) as void {
    let is i32 as factor with mut = preferred;
    let is i32 as buffer with mut = buffer_scale;
    if (factor < 120) { factor = 120; }
    if (factor > 1920) { factor = 1920; }
    if (w.fractional_active == 1) { buffer = 1; }
    let is i32 as changed = cast(i32, factor != w.scale120);
    let is i32 as buffer_changed = cast(i32, buffer != w.scale);
    w.scale120 = factor;
    w.scale = buffer;
    if (buffer_changed == 1 && w.surface != 0) {
        let is [4]u8 as p;
        _put(&p[0], cast(u32, buffer));
        _send(w, w.surface, 8, &p[0], 4, 0 - 1);
    }
    if (changed == 0 || w.logical_width <= 0 || w.logical_height <= 0) { return; }
    w.width = _scale_up(w.logical_width, factor);
    w.height = _scale_up(w.logical_height, factor);
    w.resized = 1;
    let is event.Event as e;
    event.clear(&e); e.kind = event.RESIZE; e.width = w.width; e.height = w.height;
    _queue(w, &e);
    event.clear(&e); e.kind = event.SETTINGS;
    _queue(w, &e);
}

fn _set_scale(w as *Window, scale as i32) as void {
    let is i32 as factor with mut = scale;
    if (factor < 1) { factor = 1; }
    if (factor > 16) { factor = 16; }
    _set_scale120(w, factor * 120, factor);
}
fn _surface_output(w as *Window, object as i32, entering as i32) as void {
    let is i32 as i with mut = 0;
    while (i < w.output_count) {
        if (w.outputs[i].object == object) {
            w.outputs[i].entered = entering;
            if (entering == 1) {
                w.active_output = i;
                _set_scale(w, w.outputs[i].scale);
            } else if (w.active_output == i) {
                w.active_output = 0 - 1;
                let is i32 as other with mut = 0;
                while (other < w.output_count && w.active_output < 0) {
                    if (w.outputs[other].entered == 1) { w.active_output = other; }
                    other = other + 1;
                }
                if (w.active_output >= 0) { _set_scale(w, w.outputs[w.active_output].scale); }
                else { _set_scale(w, 1); }
            }
            return;
        }
        i = i + 1;
    }
}

fn _output_event(w as *Window, obj as i32, op as i32, p as *u8) as void {
    if (op != 3) { return; }
    let is i32 as scale = cast(i32, _word(p));
    if (scale < 1) { return; }
    let is i32 as i with mut = 0;
    while (i < w.output_count) {
        if (w.outputs[i].object == obj) {
            w.outputs[i].scale = scale;
            if (w.active_output == i) { _set_scale(w, scale); }
            return;
        }
        i = i + 1;
    }
}
fn _offer_index(w as *Window, object as i32, primary as i32, create as i32) as i32 {
    let is i32 as free_slot with mut = 0 - 1;
    let is i32 as i with mut = 0;
    while (i < MAX_DATA) {
        if (w.offers[i].object == object && object != 0) { return i; }
        if (w.offers[i].object == 0 && free_slot < 0) { free_slot = i; }
        i = i + 1;
    }
    if (create == 0 || free_slot < 0) { return 0 - 1; }
    w.offers[free_slot].object = object;
    w.offers[free_slot].primary = primary;
    w.offers[free_slot].text_mime = 0;
    w.offers[free_slot].files = 0;
    return free_slot;
}
fn _offer_release(w as *Window, index as i32, destroy as i32) as void {
    let is i32 as object = w.offers[index].object;
    if (object == 0) { return; }
    if (destroy == 1) {
        let is [0]u8 as empty;
        let is i32 as opcode with mut = 2;
        if (w.offers[index].primary == 1) { opcode = 1; }
        _send(w, object, opcode, &empty[0], 0, 0 - 1);
    }
    if (w.clipboard_offer == object) { w.clipboard_offer = 0; }
    if (w.primary_offer == object) { w.primary_offer = 0; }
    mem.memzero(cast(*u8, &w.offers[index]), sizeof(DataOffer));
}


fn _source_index(w as *Window, object as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < MAX_DATA) {
        if (w.sources[i].object == object && object != 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn _data_offer_event(w as *Window, object as i32, p as *u8) as void {
    if (_wire_size < 16) { return; }
    let is i32 as len = cast(i32, _word(p));
    let is i32 as padded = ((len + 3) / 4) * 4;
    if (len <= 1 || len > 256 || 12 + padded > _wire_size) { return; }
    let is i32 as index = _offer_index(w, object, 0, 0);
    if (index < 0) { return; }
    let is *u8 as mime = cast(*u8, cast(i64, p) + 4);
    if (_same(mime, len - 1, "text/uri-list") == 1) { w.offers[index].files = 1; }
    if (_same(mime, len - 1, "UTF8_STRING") == 1 && w.offers[index].text_mime == 0) {
        w.offers[index].text_mime = 1;
    }
    if (_same(mime, len - 1, "text/plain;charset=utf-8") == 1 &&
        (w.offers[index].text_mime == 0 || w.offers[index].text_mime > 2)) {
        w.offers[index].text_mime = 2;
    }
    if (_same(mime, len - 1, "text/plain") == 1 && w.offers[index].text_mime == 0) {
        w.offers[index].text_mime = 3;
    }
}

fn _drop_accept(w as *Window) as void {
    if (w.drop_offer == 0) { return; }
    let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
    if (index < 0) { return; }
    let is *u8 as mime with mut = cast(*u8, 0);
    if ((w.drop_answer & event.DROP_FILES) != 0 && w.offers[index].files == 1) {
        mime = "text/uri-list";
    } else if ((w.drop_answer & event.DROP_TEXT) != 0 && w.offers[index].text_mime == 1) {
        mime = "UTF8_STRING";
    } else if ((w.drop_answer & event.DROP_TEXT) != 0 && w.offers[index].text_mime == 2) {
        mime = "text/plain;charset=utf-8";
    } else if ((w.drop_answer & event.DROP_TEXT) != 0 && w.offers[index].text_mime == 3) {
        mime = "text/plain";
    }
    let is [256]u8 as p;
    _put(&p[0], w.drop_serial);
    let is i32 as n with mut = 8;
    if (cast(i64, mime) != 0) {
        let is i32 as len with mut = 1;
        while (mime[len - 1] != 0) { len = len + 1; }
        let is i32 as padded = ((len + 3) / 4) * 4;
        _put(&p[4], cast(u32, len));
        mem.memcpy(&p[8], mime, len);
        if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[8]) + len), 0, padded - len); }
        n = 8 + padded;
    } else { _put(&p[4], 0); }
    _send(w, w.drop_offer, 0, &p[0], n, 0 - 1);
}

fn _drop_hex(c as i64) as i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

fn _drop_path(w as *Window, src as *u8, from as i64, to as i64, slot as i64) as i32 {
    let is i64 as i with mut = from;
    if (to - i > 7 && src[i] == 102 && src[i + 1] == 105 && src[i + 2] == 108 &&
        src[i + 3] == 101 && src[i + 4] == 58 && src[i + 5] == 47 && src[i + 6] == 47) {
        i = i + 7;
        while (i < to && src[i] != 47) { i = i + 1; }
    }
    if (i >= to) { return 0; }
    let is *u8 as dst = cast(*u8, cast(i64, w.drop_storage) + slot * DROPPED_PATH_BYTES);
    let is i64 as out with mut = 0;
    while (i < to && out < DROPPED_PATH_BYTES - 1) {
        let is i64 as c = cast(i64, src[i]) & 255;
        if (c == 37 && i + 2 < to) {
            let is i64 as hi = _drop_hex(cast(i64, src[i + 1]) & 255);
            let is i64 as lo = _drop_hex(cast(i64, src[i + 2]) & 255);
            if (hi >= 0 && lo >= 0) {
                dst[out] = cast(u8, hi * 16 + lo);
                out = out + 1; i = i + 3;
                continue;
            }
        }
        dst[out] = cast(u8, c);
        out = out + 1; i = i + 1;
    }
    dst[out] = 0;
    return 1;
}

fn _drop_parse_files(w as *Window) as void {
    let is *u8 as src = cast(*u8, cast(i64, w.drop_storage) + 65536);
    let is i64 as i with mut = 0;
    w.drop_file_count = 0;
    while (i < w.drop_len && w.drop_file_count < MAX_DROPPED_FILES) {
        while (i < w.drop_len && (src[i] == 13 || src[i] == 10 || src[i] == 32 || src[i] == 9)) {
            i = i + 1;
        }
        if (i >= w.drop_len) { break; }
        let is i64 as start = i;
        while (i < w.drop_len && src[i] != 13 && src[i] != 10) { i = i + 1; }
        if (src[start] != 35 &&
            _drop_path(w, src, start, i, w.drop_file_count) == 1) {
            w.drop_file_count = w.drop_file_count + 1;
        }
    }
}

fn _drop_finish(w as *Window) as void {
    if (w.drop_pending == 0) { return; }
    w.drop_pending = 0;
    let is *u8 as data = cast(*u8, cast(i64, w.drop_storage) + 65536);
    if (w.drop_kind == event.DROP_TEXT && w.drop_truncated == 1 &&
        cast(i64, w.drop_storage) != 0) {
        let is i64 as n with mut = MAX_DND_TEXT;
        while (n > 0 && ((cast(i64, data[n]) & 192) == 128)) { n = n - 1; }
        w.drop_len = n;
    }
    if (cast(i64, w.drop_storage) != 0) { data[w.drop_len] = 0; }
    w.drop_ready = 1;
    if (w.drop_kind == event.DROP_FILES) { _drop_parse_files(w); }
    let is i32 as offer = w.drop_offer;
    if (offer != 0) {
        let is [0]u8 as empty;
        _send(w, offer, 3, &empty[0], 0, 0 - 1);
        let is i32 as index = _offer_index(w, offer, 0, 0);
        if (index >= 0) { _offer_release(w, index, 1); }
    }
    w.drop_offer = 0; w.drop_offered = 0; w.drop_answer = 0;
    let is event.Event as e;
    event.clear(&e); e.kind = event.DND_DROP; e.drop = w.drop_kind;
    e.x = w.drop_x; e.y = w.drop_y;
    _queue(w, &e);
}

fn _drop_reject(w as *Window) as void {
    w.drop_answer = 0;
    _drop_accept(w);
    if (w.drop_offer != 0) {
        let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
        if (index >= 0) { _offer_release(w, index, 1); }
    }
    w.drop_offer = 0; w.drop_offered = 0; w.drop_answer = 0; w.drop_pending = 0;
    let is event.Event as e;
    event.clear(&e); e.kind = event.DND_LEAVE; e.x = w.drop_x; e.y = w.drop_y;
    _queue(w, &e);
}

fn _drop_start(w as *Window) as void {
    let is i32 as takes = w.drop_answer & w.drop_offered;
    let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
    if (takes == 0 || index < 0 || w.transfer_fd >= 0) { _drop_reject(w); return; }
    let is *u8 as mime with mut = cast(*u8, 0);
    let is i32 as kind with mut = event.DROP_TEXT;
    let is i32 as offered_files = cast(i32, (takes & event.DROP_FILES) != 0 && w.offers[index].files == 1);
    if (offered_files == 1) { mime = "text/uri-list"; kind = event.DROP_FILES; }
    else if (w.offers[index].text_mime == 1) { mime = "UTF8_STRING"; }
    else if (w.offers[index].text_mime == 2) { mime = "text/plain;charset=utf-8"; }
    else if (w.offers[index].text_mime == 3) { mime = "text/plain"; }
    if (cast(i64, mime) == 0) { _drop_reject(w); return; }
    if (cast(i64, w.drop_storage) == 0) {
        w.drop_storage = mem.core.mmap_anon(DROP_STORAGE_BYTES);
        if (cast(i64, w.drop_storage) == 0) { _drop_reject(w); return; }
    }
    let is [2]i32 as fds;
    if (sys.socketpair(sys.AF_UNIX, sys.SOCK_STREAM | sys.SOCK_CLOEXEC, 0, &fds[0]) < 0) {
        _drop_reject(w); return;
    }
    if (linux.fcntl(fds[0], 4, 2048) < 0 ||
        _send_string_fd(w, w.drop_offer, 1, mime, fds[1]) == 0) {
        linux.close(fds[0]); linux.close(fds[1]); _drop_reject(w); return;
    }
    linux.close(fds[1]);
    w.drop_len = 0; w.drop_file_count = 0; w.drop_ready = 0; w.drop_truncated = 0;
    w.drop_kind = kind; w.drop_pending = 1;
    w.transfer_fd = fds[0]; w.transfer_offer = w.drop_offer;
    w.transfer_primary = 0; w.transfer_mime = w.offers[index].text_mime;
    w.transfer_purpose = 2;
}

fn _data_device_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0) {
        _offer_index(w, cast(i32, _word(p)), 0, 1);
        return;
    }
    if (op == 1 && _wire_size >= 28) {
        let is i32 as surface = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
        if (surface != w.surface) { return; }
        if (w.drop_offer != 0 && w.drop_pending == 0) { _drop_reject(w); }
        w.drop_serial = _word(p); w.input_serial = w.drop_serial;
        w.drop_x = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        w.drop_y = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 12))) / 256), w.scale120);
        w.drop_offer = cast(i32, _word(cast(*u8, cast(i64, p) + 16)));
        w.drop_offered = 0; w.drop_answer = 0; w.drop_ready = 0;
        w.drop_len = 0; w.drop_file_count = 0;
        let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
        if (index >= 0) {
            if (w.offers[index].files == 1) { w.drop_offered = w.drop_offered | event.DROP_FILES; }
            if (w.offers[index].text_mime != 0) { w.drop_offered = w.drop_offered | event.DROP_TEXT; }
            w.drop_answer = w.drop_offered;
            let is [8]u8 as actions;
            _put(&actions[0], 1); _put(&actions[4], 1);
            _send(w, w.drop_offer, 4, &actions[0], 8, 0 - 1);
            _drop_accept(w);
        }
        let is event.Event as e;
        event.clear(&e); e.kind = event.DND_ENTER; e.drop = w.drop_offered;
        e.x = w.drop_x; e.y = w.drop_y;
        _queue(w, &e);
        return;
    }
    if (op == 2) {
        if (w.drop_pending == 1) { return; }
        let is i64 as x = w.drop_x; let is i64 as y = w.drop_y;
        if (w.drop_offer != 0) {
            let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
            if (index >= 0) { _offer_release(w, index, 1); }
        }
        w.drop_offer = 0; w.drop_offered = 0; w.drop_answer = 0;
        let is event.Event as e;
        event.clear(&e); e.kind = event.DND_LEAVE; e.x = x; e.y = y;
        _queue(w, &e);
        return;
    }
    if (op == 3 && _wire_size >= 20) {
        w.drop_x = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 4))) / 256), w.scale120);
        w.drop_y = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        if (w.drop_offer != 0 && w.drop_pending == 0) {
            let is event.Event as e;
            event.clear(&e); e.kind = event.DND_MOVE; e.x = w.drop_x; e.y = w.drop_y;
            _queue(w, &e);
        }
        return;
    }
    if (op == 4) { _drop_start(w); return; }
    if (op == 5) {
        let is i32 as next = cast(i32, _word(p));
        let is i32 as previous = w.clipboard_offer;
        if (previous != 0 && previous != next && previous != w.transfer_offer) {
            let is i32 as index = _offer_index(w, previous, 0, 0);
            if (index >= 0) { _offer_release(w, index, 1); }
        }
        w.clipboard_offer = next;
    }
}

fn _primary_device_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0) {
        _offer_index(w, cast(i32, _word(p)), 1, 1);
        return;
    }
    if (op == 1) {
        let is i32 as next = cast(i32, _word(p));
        let is i32 as previous = w.primary_offer;
        if (previous != 0 && previous != next && previous != w.transfer_offer) {
            let is i32 as index = _offer_index(w, previous, 1, 0);
            if (index >= 0) { _offer_release(w, index, 1); }
        }
        w.primary_offer = next;
    }
}


fn _source_release(w as *Window, index as i32, destroy as i32) as void {
    let is *DataSource as s = &w.sources[index];
    if (destroy == 1 && s.object != 0) {
        let is [0]u8 as empty;
        if (s.primary == 1) { _send(w, s.object, 1, &empty[0], 0, 0 - 1); }
        else { _send(w, s.object, 1, &empty[0], 0, 0 - 1); }
    }
    if (cast(i64, s.data) != 0) { mem.core.munmap(s.data, s.bytes); }
    if (w.clip_source == s.object) { w.clip_source = 0; }
    if (w.primary_source == s.object) { w.primary_source = 0; }
    if (s.object >= 2 && s.object < MAX_OBJECTS) { _objects[s.object].owner = cast(*Window, 0); }
    mem.memzero(cast(*u8, s), sizeof(DataSource));
}

fn _source_event(w as *Window, object as i32, op as i32, primary as i32) as void {
    let is i32 as index = _source_index(w, object);
    if (index < 0 || w.sources[index].primary != primary) { return; }
    if ((primary == 0 && op == 1) || (primary == 1 && op == 0)) {
        let is i64 as fd = _take_recv_fd();
        if (fd < 0) { return; }
        let is i64 as sent with mut = 0;
        while (w.sources[index].data != cast(*u8, 0) && sent < w.sources[index].length) {
            let is i64 as n = linux.write(fd, cast(*u8, cast(i64, w.sources[index].data) + sent),
                                         w.sources[index].length - sent);
            if (n <= 0) { break; }
            sent = sent + n;
        }
        linux.close(fd);
        return;
    }
    if ((primary == 0 && op == 2) || (primary == 1 && op == 1)) {
        _source_release(w, index, 1);
    }
}

fn _ime_string(p as *u8, dst as *u8, out_len as *i64) as i64 {
    if (_wire_size < 12) { return 0 - 1; }
    let is u32 as wire_len = _word(p);
    if (wire_len == cast(u32, 0 - 1)) { *out_len = 0; return 4; }
    if (wire_len == 0 || wire_len > 4096) { return 0 - 1; }
    let is i32 as padded = cast(i32, (wire_len + 3) & 0xfffffffc);
    if (12 + padded > _wire_size) { return 0 - 1; }
    let is i64 as len with mut = cast(i64, wire_len) - 1;
    if (len > 255) { len = 255; }
    let is *u8 as src = cast(*u8, cast(i64, p) + 4);
    while (len > 0 && (cast(i64, src[len]) & 192) == 128) { len = len - 1; }
    if (len > 0) { mem.memcpy(dst, src, len); }
    dst[len] = 0;
    *out_len = len;
    return 4 + padded;
}

fn _text_input_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0 && _wire_size >= 12) {
        if (cast(i32, _word(p)) == w.surface) { w.text_input_entered = 1; }
        return;
    }
    if (op == 1 && _wire_size >= 12) {
        if (cast(i32, _word(p)) == w.surface && w.text_input_entered == 1) {
            w.text_input_entered = 0;
            w.ime_preedit_len = 0; w.ime_cursor = 0;
            let is event.Event as e;
            event.clear(&e); e.kind = event.PREEDIT; e.text = &w.ime_preedit[0];
            _queue(w, &e);
        }
        return;
    }
    if (op == 2) {
        let is i64 as used = _ime_string(p, &w.ime_preedit[0], &w.ime_preedit_len);
        if (used < 0 || 8 + used + 8 > _wire_size) { return; }
        w.ime_cursor = cast(i32, _word(cast(*u8, cast(i64, p) + used)));
        if (w.ime_cursor < 0) { w.ime_cursor = w.ime_preedit_len; }
        if (w.ime_cursor > w.ime_preedit_len) { w.ime_cursor = w.ime_preedit_len; }
        w.ime_preedit_changed = 1;
        return;
    }
    if (op == 3) {
        if (_ime_string(p, &w.ime_commit[0], &w.ime_commit_len) >= 0) {
            w.ime_commit_changed = 1;
        }
        return;
    }
    if (op == 4 && _wire_size >= 16) {
        w.ime_delete_before = cast(i64, _word(p));
        w.ime_delete_after = cast(i64, _word(cast(*u8, cast(i64, p) + 4)));
        w.ime_delete_changed = 1;
        return;
    }
    if (op != 5 || _wire_size < 12) { return; }
    let is event.Event as e;
    if (w.ime_delete_changed == 1) {
        event.clear(&e); e.kind = event.DELETE_SURROUNDING;
        e.delete_before = w.ime_delete_before; e.delete_after = w.ime_delete_after;
        _queue(w, &e);
    }
    if (w.ime_commit_changed == 1) {
        event.clear(&e); e.kind = event.TEXT; e.text = &w.ime_commit[0];
        e.text_len = w.ime_commit_len;
        _queue(w, &e);
    }
    if (w.ime_preedit_changed == 1) {
        event.clear(&e); e.kind = event.PREEDIT; e.text = &w.ime_preedit[0];
        e.text_len = w.ime_preedit_len; e.cursor = w.ime_cursor;
        _queue(w, &e);
    }
    w.ime_delete_changed = 0; w.ime_commit_changed = 0; w.ime_preedit_changed = 0;
    w.ime_delete_before = 0; w.ime_delete_after = 0;
    w.ime_commit_len = 0; w.ime_preedit_len = 0; w.ime_cursor = 0;
}


// Process one complete server message. The generated catalog supplies the
// opcode/signature contract used for the core and xdg messages below.
fn _cursor_shape_pointer(w as *Window) as void {
    if (w.cursor_shape_manager == 0 || w.pointer == 0 || w.cursor_shape_device != 0) { return; }
    w.cursor_shape_device = _id(w);
    let is [8]u8 as p;
    _put(&p[0], cast(u32, w.cursor_shape_device));
    _put(&p[4], cast(u32, w.pointer));
    if (_send(w, w.cursor_shape_manager, 1, &p[0], 8, 0 - 1) == 0) {
        w.cursor_shape_device = 0;
    }
}

fn _seat_capabilities(w as *Window, caps as u32) as void {
    let is [4]u8 as body;
    if ((caps & 1) != 0 && w.pointer == 0) {
        w.pointer = _id(w);
        _put(&body[0], cast(u32, w.pointer));
        _send(w, w.seat, 0, &body[0], 4, 0 - 1);
        w.pointer_version = _bounded(w.seat_version, 7);
        _cursor_shape_pointer(w);
    } else if ((caps & 1) == 0 && w.pointer != 0) {
        if (w.cursor_shape_device != 0) {
            _send(w, w.cursor_shape_device, 0, cast(*u8, 0), 0, 0 - 1);
            w.cursor_shape_device = 0;
        }
        if (w.pointer_version >= 3) { _send(w, w.pointer, 1, cast(*u8, 0), 0, 0 - 1); }
        w.pointer = 0; w.pointer_inside = 0; w.pointer_serial = 0;
    }
    if ((caps & 2) != 0 && w.keyboard == 0) {
        w.keyboard = _id(w);
        if (w.keyboard != 0) { _objects[w.keyboard].fd_opcode = 0; }
        _put(&body[0], cast(u32, w.keyboard));
        _send(w, w.seat, 1, &body[0], 4, 0 - 1);
    } else if ((caps & 2) == 0 && w.keyboard != 0) {
        if (w.keyboard_focus == 1) { _event(w, event.FOCUS_OUT); }
        if (w.seat_version >= 3) { _send(w, w.keyboard, 0, cast(*u8, 0), 0, 0 - 1); }
        if (w.keyboard != 0) { _objects[w.keyboard].owner = cast(*Window, 0); }
        w.keyboard = 0; w.keyboard_focus = 0;
        mem.memzero(cast(*u8, &w.key_down[0]), 256 * 4);
        mem.memzero(cast(*u8, &w.key_syms[0]), 256 * 4);
    }
}

fn _key_id(sym as u32) as i32 {
    if (sym >= 65 && sym <= 90) { return cast(i32, sym + 32); }
    if ((sym >= 32 && sym <= 126) || (sym >= 160 && sym <= 255) ||
        (sym >= 65280 && sym <= 65535)) { return cast(i32, sym); }
    return keys.UNKNOWN;
}

fn _load_keymap(w as *Window, fd as i64, size as i64) as void {
    if (fd < 0 || size < 1 || size > 16777216) { return; }
    let is *u8 as map = linux.mmap(cast(*u8, 0), size, linux.PROT_READ, linux.MAP_PRIVATE, fd, 0);
    if (cast(i64, map) == linux.MAP_FAILED) { return; }
    if (map[size - 1] != 0) { linux.munmap(map, size); return; }
    if (cast(i64, w.xkb_context) == 0) { w.xkb_context = xkb.xkb_context_new(0); }
    if (cast(i64, w.xkb_context) == 0) { linux.munmap(map, size); return; }
    let is *u8 as keymap = xkb.xkb_keymap_new_from_string(w.xkb_context, map, 1, 0);
    if (cast(i64, keymap) == 0) { linux.munmap(map, size); return; }
    let is *u8 as state = xkb.xkb_state_new(keymap);
    if (cast(i64, state) == 0) {
        xkb.xkb_keymap_unref(keymap);
        linux.munmap(map, size);
        return;
    }
    let is *u8 as locale with mut = env.getenv("LC_ALL");
    if (cast(i64, locale) == 0 || locale[0] == 0) { locale = env.getenv("LC_CTYPE"); }
    if (cast(i64, locale) == 0 || locale[0] == 0) { locale = env.getenv("LANG"); }
    if (cast(i64, locale) == 0 || locale[0] == 0) { locale = "C.UTF-8"; }
    let is *u8 as table = xkb.xkb_compose_table_new_from_locale(w.xkb_context, locale, 0);
    let is *u8 as compose with mut = cast(*u8, 0);
    if (cast(i64, table) != 0) { compose = xkb.xkb_compose_state_new(table, 0); }
    if (cast(i64, w.xkb_state) != 0) { xkb.xkb_state_unref(w.xkb_state); }
    if (cast(i64, w.xkb_keymap) != 0) { xkb.xkb_keymap_unref(w.xkb_keymap); }
    if (cast(i64, w.compose_state) != 0) { xkb.xkb_compose_state_unref(w.compose_state); }
    if (cast(i64, w.compose_table) != 0) { xkb.xkb_compose_table_unref(w.compose_table); }
    w.xkb_keymap = keymap; w.xkb_state = state;
    w.compose_table = table; w.compose_state = compose;
    linux.munmap(map, size);
}

fn _xkb_modifiers(w as *Window) as i32 {
    if (cast(i64, w.xkb_state) == 0) { return 0; }
    let is i32 as flags with imut = 8;
    let is i32 as out with mut = 0;
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Shift", flags) != 0) { out = out | keys.MOD_SHIFT; }
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Lock", flags) != 0) { out = out | keys.MOD_LOCK; }
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Control", flags) != 0) { out = out | keys.MOD_CONTROL; }
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Mod1", flags) != 0) { out = out | keys.MOD_ALT; }
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Mod4", flags) != 0) { out = out | keys.MOD_SUPER; }
    return out;
}

fn _key_text(w as *Window, sym as u32, keycode as u32) as i32 {
    w.text_len = 0;
    mem.memzero(cast(*u8, &w.text_buf[0]), 256);
    if (cast(i64, w.compose_state) != 0 && sym != 0) {
        xkb.xkb_compose_state_feed(w.compose_state, sym);
        let is i32 as status = xkb.xkb_compose_state_get_status(w.compose_state);
        if (status == 1) { return 0; }
        if (status == 2) {
            w.text_len = xkb.xkb_compose_state_get_utf8(w.compose_state, &w.text_buf[0], 256);
            xkb.xkb_compose_state_reset(w.compose_state);
            if (w.text_len > 255) { w.text_len = 255; }
            return w.text_len;
        }
        if (status == 3) { xkb.xkb_compose_state_reset(w.compose_state); return 0; }
    }
    if (cast(i64, w.xkb_state) != 0) {
        w.text_len = xkb.xkb_state_key_get_utf8(w.xkb_state, keycode, &w.text_buf[0], 256);
    }
    if (w.text_len > 255) { w.text_len = 255; }
    return w.text_len;
}

fn _keyboard_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0) {
        let is i64 as fd = _take_recv_fd();
        if (fd < 0) { return; }
        if (_wire_size >= 16) {
            let is u32 as format = _word(p);
            let is i64 as size = cast(i64, _word(cast(*u8, cast(i64, p) + 4)));
            if (format == 1) { _load_keymap(w, fd, size); }
        }
        linux.close(fd);
        return;
    }
    if (op == 1) {
        if (_wire_size < 20 || _word(cast(*u8, cast(i64, p) + 4)) != cast(u32, w.surface)) { return; }
        w.keyboard_focus = 1;
        let is i32 as bytes = cast(i32, _word(cast(*u8, cast(i64, p) + 8)));
        if (bytes >= 0 && (bytes & 3) == 0 && 20 + bytes <= _wire_size && cast(i64, w.xkb_state) != 0) {
            let is i32 as i with mut = 0;
            while (i < bytes / 4) {
                let is i32 as code = cast(i32, _word(cast(*u8, cast(i64, p) + 12 + i * 4)));
                if (code >= 0 && code < 256) {
                    let is u32 as xcode = cast(u32, code + 8);
                    xkb.xkb_state_update_key(w.xkb_state, xcode, 1);
                    w.key_down[code] = 1;
                    w.key_syms[code] = _key_id(xkb.xkb_state_key_get_one_sym(w.xkb_state, xcode));
                }
                i = i + 1;
            }
        }
        let is event.Event as e;
        event.clear(&e); e.kind = event.FOCUS_IN; e.modifiers = w.modifiers; e.raw_kind = op;
        _queue(w, &e);
        return;
    }
    if (op == 2) {
        if (w.keyboard_focus == 1) {
            if (cast(i64, w.xkb_state) != 0) {
                let is i32 as i with mut = 0;
                while (i < 256) {
                    if (w.key_down[i] == 1) { xkb.xkb_state_update_key(w.xkb_state, cast(u32, i + 8), 0); }
                    i = i + 1;
                }
            }
            w.keyboard_focus = 0; w.modifiers = 0;
            mem.memzero(cast(*u8, &w.key_down[0]), 256 * 4);
            mem.memzero(cast(*u8, &w.key_syms[0]), 256 * 4);
            if (cast(i64, w.compose_state) != 0) { xkb.xkb_compose_state_reset(w.compose_state); }
            let is event.Event as e;
            event.clear(&e); e.kind = event.FOCUS_OUT; e.raw_kind = op;
            _queue(w, &e);
        }
        return;
    }
    if (op == 3 && _wire_size >= 24) { w.input_serial = _word(p); }
    if (op == 3) {
        if (w.keyboard_focus == 0) { return; }
        let is i32 as code = cast(i32, _word(cast(*u8, cast(i64, p) + 8)));
        let is i32 as state = cast(i32, _word(cast(*u8, cast(i64, p) + 12)));
        let is i32 as down = cast(i32, state != 0);
        if (code < 0 || code >= 256) { return; }
        let is u32 as xcode = cast(u32, code + 8);
        let is u32 as sym with mut = 0;
        let is i32 as id with mut = 0;
        if (down == 1) {
            if (state == 1 && cast(i64, w.xkb_state) != 0) {
                xkb.xkb_state_update_key(w.xkb_state, xcode, 1);
                sym = xkb.xkb_state_key_get_one_sym(w.xkb_state, xcode);
                id = _key_id(sym);
                w.key_syms[code] = id; w.key_down[code] = 1;
            } else {
                id = w.key_syms[code];
                if (cast(i64, w.xkb_state) != 0) { sym = xkb.xkb_state_key_get_one_sym(w.xkb_state, xcode); }
            }
        } else {
            id = w.key_syms[code];
            if (cast(i64, w.xkb_state) != 0) {
                sym = xkb.xkb_state_key_get_one_sym(w.xkb_state, xcode);
                xkb.xkb_state_update_key(w.xkb_state, xcode, 0);
            }
            w.key_down[code] = 0; w.key_syms[code] = 0;
        }
        w.modifiers = _xkb_modifiers(w);
        let is event.Event as e;
        event.clear(&e);
        e.kind = event.KEY_UP;
        if (down == 1) { e.kind = event.KEY_DOWN; }
        e.key = id; e.keycode = code; e.modifiers = w.modifiers; e.raw_kind = op;
        if (down == 1) {
            if (w.text_input_enabled == 1 && w.text_input_entered == 1) {
                e.text_len = 0;
            } else {
                e.text_len = _key_text(w, sym, xcode);
                if (e.text_len > 0) { e.text = &w.text_buf[0]; }
            }
        }
        _queue(w, &e);
        return;
    }
    if (op == 4 && cast(i64, w.xkb_state) != 0) {
        xkb.xkb_state_update_mask(w.xkb_state, _word(cast(*u8, cast(i64, p) + 4)),
                                  _word(cast(*u8, cast(i64, p) + 8)),
                                  _word(cast(*u8, cast(i64, p) + 12)), 0, 0,
                                  _word(cast(*u8, cast(i64, p) + 16)));
        w.modifiers = _xkb_modifiers(w);
    }
}

fn _button_id(code as i32) as i32 {
    if (code == 272) { return 1; }
    if (code == 274) { return 2; }
    if (code == 273) { return 3; }
    if (code >= 275 && code <= 279) { return code - 271; }
    return 0;
}

fn _pointer_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0) {
        if (_word(cast(*u8, cast(i64, p) + 4)) != cast(u32, w.surface)) { return; }
        w.pointer_serial = _word(p);
        w.pointer_inside = 1;
        w.pointer_x = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        w.pointer_y = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 12))) / 256), w.scale120);
        let is event.Event as e;
        event.clear(&e); e.kind = event.ENTER; e.x = w.pointer_x; e.y = w.pointer_y; e.raw_kind = op;
        _queue(w, &e);
        return;
    }
    if (op == 1) {
        w.pointer_serial = _word(p); w.pointer_inside = 0;
        let is event.Event as e;
        event.clear(&e); e.kind = event.LEAVE; e.raw_kind = op;
        _queue(w, &e);
        return;
    }
    if (w.pointer_inside == 0) { return; }
    if (op == 2) {
        let is i64 as x = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 4))) / 256), w.scale120);
        let is i64 as y = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        w.pointer_dx = x - w.pointer_x; w.pointer_dy = y - w.pointer_y;
        w.pointer_x = x; w.pointer_y = y;
        let is event.Event as e;
        event.clear(&e); e.kind = event.MOUSE_MOVE; e.x = x; e.y = y; e.modifiers = w.modifiers; e.raw_kind = op;
        _queue(w, &e);
        return;
    }
    if (op == 3) {
        w.pointer_serial = _word(p);
        let is i32 as button = _button_id(cast(i32, _word(cast(*u8, cast(i64, p) + 8))));
        if (button <= 0 || button >= 8) { return; }
        let is i32 as down = cast(i32, _word(cast(*u8, cast(i64, p) + 12)) == 1);
        w.pointer_buttons[button] = down;
        let is event.Event as e;
        event.clear(&e); e.kind = event.MOUSE_UP;
        if (down == 1) { e.kind = event.MOUSE_DOWN; }
        e.button = button; e.x = w.pointer_x; e.y = w.pointer_y; e.modifiers = w.modifiers; e.raw_kind = op;
        _queue(w, &e);
        return;
    }
    if (op == 4) {
        if (_word(cast(*u8, cast(i64, p) + 4)) == 0) {
            w.scroll_y = w.scroll_y + cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))));
            if (w.pointer_version < 5) {
                let is event.Event as e;
                event.clear(&e); e.kind = event.WHEEL;
                if (w.scroll_y < 0) { e.wheel = 1; } else if (w.scroll_y > 0) { e.wheel = 0 - 1; }
                e.x = w.pointer_x; e.y = w.pointer_y; e.modifiers = w.modifiers; e.raw_kind = op;
                w.wheel = e.wheel; _queue(w, &e); w.scroll_y = 0;
            }
        }
        return;
    }
    if (op == 8) {
        if (_word(p) == 0) { w.scroll_discrete = w.scroll_discrete + cast(i32, _word(cast(*u8, cast(i64, p) + 4))); }
        return;
    }
    if (op == 5 && w.pointer_version >= 5 && (w.scroll_discrete != 0 || w.scroll_y != 0)) {
        let is event.Event as e;
        event.clear(&e); e.kind = event.WHEEL;
        if (w.scroll_discrete != 0) { e.wheel = 0 - w.scroll_discrete; }
        else if (w.scroll_y < 0) { e.wheel = 1; }
        else { e.wheel = 0 - 1; }
        e.x = w.pointer_x; e.y = w.pointer_y; e.modifiers = w.modifiers; e.raw_kind = op;
        w.wheel = e.wheel; _queue(w, &e);
        w.scroll_discrete = 0; w.scroll_y = 0;
    }
}
fn _reap_retired(w as *Window) as void {
    let is i32 as i with mut = 0;
    let is [0]u8 as empty;
    while (i < RETIRED_COUNT) {
        if (w.retired[i].used == 1 && w.retired[i].buffers[0].busy == 0 &&
            w.retired[i].buffers[1].busy == 0) {
            if (w.retired[i].buffers[0].object != 0) {
                _send(w, w.retired[i].buffers[0].object, 0, &empty[0], 0, 0 - 1);
            }
            if (w.retired[i].buffers[1].object != 0) {
                _send(w, w.retired[i].buffers[1].object, 0, &empty[0], 0, 0 - 1);
            }
            if (cast(i64, w.retired[i].pixels) != 0) {
                linux.munmap(w.retired[i].pixels, w.retired[i].bytes * BUFFER_COUNT);
            }
            mem.memzero(cast(*u8, &w.retired[i]), sizeof(BufferSet));
        }
        i = i + 1;
    }
}

fn _retire_current(w as *Window) as i32 {
    _reap_retired(w);
    let is i32 as slot with mut = 0;
    while (slot < RETIRED_COUNT && w.retired[slot].used == 1) { slot = slot + 1; }
    if (slot >= RETIRED_COUNT) { return 0; }
    w.retired[slot].pixels = w.pixels;
    w.retired[slot].bytes = w.bytes;
    w.retired[slot].buffers[0] = w.buffers[0];
    w.retired[slot].buffers[1] = w.buffers[1];
    w.retired[slot].used = 1;
    w.pixels = cast(*u8, 0);
    w.bytes = 0; w.stride = 0; w.buffer_width = 0; w.buffer_height = 0;
    w.buffers[0].object = 0; w.buffers[0].busy = 0;
    w.buffers[1].object = 0; w.buffers[1].busy = 0;
    w.current = 0 - 1; w.last_buffer = 0 - 1;
    return 1;
}


fn _dispatch(w as *Window, obj as i32) as void {
    let is u32 as h = _word(&_wire[4]);
    let is i32 as op = cast(i32, h & 65535);
    let is *u8 as p = &_wire[8];
    if (obj == 1 && op == 0) { w.err = NO_COMPOSITOR; w.opened = 0; return; }
    
    if (obj == w.registry && op == 0) { _registry_global(); return; }
    if (obj == w.surface && (op == 0 || op == 1)) {
        _surface_output(w, cast(i32, _word(p)), cast(i32, op == 0));
        return;
    }
    let is i32 as output_i with mut = 0;
    while (output_i < w.output_count) {
        if (obj == w.outputs[output_i].object) {
            _output_event(w, obj, op, p);
            return;
        }
        output_i = output_i + 1;
    }
    if (obj == w.fractional_surface && op == 0 && w.fractional_active == 1) {
        _set_scale120(w, cast(i32, _word(p)), 1);
        return;
    }
    if (obj == w.data_device) { _data_device_event(w, op, p); return; }
    if (obj == w.primary_device) { _primary_device_event(w, op, p); return; }
    if (obj == w.text_input) { _text_input_event(w, op, p); return; }
    if (_offer_index(w, obj, 0, 0) >= 0) { _data_offer_event(w, obj, p); return; }
    if (_offer_index(w, obj, 1, 0) >= 0) { _data_offer_event(w, obj, p); return; }
    if (_source_index(w, obj) >= 0) {
        let is i32 as source_i = _source_index(w, obj);
        _source_event(w, obj, op, w.sources[source_i].primary);
        return;
    }
    if (obj == w.seat && op == 0) { _seat_capabilities(w, _word(p)); return; }
    if (obj == w.keyboard) { _keyboard_event(w, op, p); return; }
    if (obj == w.pointer) { _pointer_event(w, op, p); return; }
    if (obj == w.registry_sync && op == 0) { w.registry_sync = 0; w.acked = 1; return; }
    if (obj == w.wm_base && op == 0) {
        let is [4]u8 as b;
        _put(&b[0], _word(p));
        _send(w, w.wm_base, 3, &b[0], 4, 0 - 1);
        return;
    }
    if (obj == w.xdg_surface && op == 0) {
        let is [4]u8 as b;
        _put(&b[0], _word(p));
        _send(w, w.xdg_surface, 4, &b[0], 4, 0 - 1);
        w.acked = 2;
        return;
    }
    if (obj == w.toplevel && op == 0) {
        let is i32 as nw = cast(i32, _word(p));
        let is i32 as nh = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
        // Zero means the client chooses this axis; do not keep maximized size.
        w.configured_width = nw;
        w.configured_height = nh;
        let is i32 as bytes = cast(i32, _word(cast(*u8, cast(i64, p) + 8)));
        if (bytes >= 0 && (bytes & 3) == 0 && 20 + bytes <= _wire_size) {
            let is i32 as count = bytes / 4;
            let is i32 as i with mut = 0;
            let is i32 as state with mut = 0;
            while (i < count) {
                let is u32 as s = _word(cast(*u8, cast(i64, p) + 12 + i * 4));
                if (s == 1) { state = state | event.STATE_MAXIMIZED; }
                if (s == 2) { state = state | event.STATE_FULLSCREEN; }
                if (s == 5) { state = state | event.STATE_TILED_LEFT; }
                if (s == 6) { state = state | event.STATE_TILED_RIGHT; }
                if (s == 7) { state = state | event.STATE_TILED_TOP; }
                if (s == 8) { state = state | event.STATE_TILED_BOTTOM; }
                i = i + 1;
            }
            if (w.state == 0 && state != 0) {
                w.normal_width = w.logical_width;
                w.normal_height = w.logical_height;
            }
            w.state = state;
        }
        return;
    }
    if (obj == w.toplevel && op == 1) {
        w.close_requested = 1;
        _event(w, event.CLOSE);
        return;
    }
    if (obj == w.toplevel_decoration && op == 0) {
        w.server_decorated = cast(i32, _word(p) == 2);
        return;
    }
    if (obj == w.surface && op == 0) { return; }
    if (obj == w.callback && op == 0) {
        w.callback = 0;
        w.frame_ready = 1;
        return;
    }
    if ((obj == w.buffers[0].object || obj == w.buffers[1].object) && op == 0) {
        if (obj == w.buffers[0].object) { w.buffers[0].busy = 0; }
        if (obj == w.buffers[1].object) { w.buffers[1].busy = 0; }
        w.frame_ready = 1;
        return;
    }
    let is i32 as i with mut = 0;
    while (i < RETIRED_COUNT) {
        if (w.retired[i].used == 1 && op == 0) {
            if (obj == w.retired[i].buffers[0].object) {
                w.retired[i].buffers[0].busy = 0; w.frame_ready = 1;
            }
            if (obj == w.retired[i].buffers[1].object) {
                w.retired[i].buffers[1].busy = 0; w.frame_ready = 1;
            }
        }
        i = i + 1;
    }
    _reap_retired(w);
}

fn _pump_one(w as *Window, wait as i32) as i32 {
    if (wait == 1) {
        let is i64 as timeout with mut = 5000;
        if (w.transfer_fd >= 0) { timeout = 10; }
        if (sys.wait_readable(w.fd, timeout) <= 0) {
            if (w.transfer_fd < 0) { return 0; }
            if (sys.wait_readable(w.transfer_fd, 0) > 0) { _read_transfer(w); }
            return 2;
        }
    } else if (sys.wait_readable(w.fd, 0) <= 0) { return 0; }
    let is i32 as obj = _recv(w);
    if (obj == 0) { _close_recv_fds(); return 0; }
    if (obj == 1 && (_word(&_wire[4]) & 65535) == 1 && _wire_size == 12) {
        _release_object(cast(i32, _word(&_wire[8])));
        return 1;
    }
    let is i32 as op = cast(i32, _word(&_wire[4]) & 65535);
    if (obj >= 2 && obj < MAX_OBJECTS && cast(i64, _objects[obj].owner) == 0 &&
        _objects[obj].fd_opcode == op) {
        let is i64 as abandoned = _take_recv_fd();
        if (abandoned >= 0) { linux.close(abandoned); }
        return 1;
    }
    let is *Window as target with mut = w;
    if (obj >= 2 && obj < MAX_OBJECTS && cast(i64, _objects[obj].owner) != 0) {
        target = _objects[obj].owner;
    } else if (cast(u32, obj) >= 0xff000000) {
        let is i32 as i with mut = 0;
        while (i < MAX_WINDOWS) {
            let is *Window as candidate = _windows[i];
            if (cast(i64, candidate) != 0 &&
                (_offer_index(candidate, obj, 0, 0) >= 0 || _offer_index(candidate, obj, 1, 0) >= 0)) {
                target = candidate; break;
            }
            i = i + 1;
        }
    }
    _dispatch(target, obj);
    return 1;
}

fn _send_string(w as *Window, object as i32, opcode as i32, text as *u8) as i32 {
    let is [2048]u8 as p;
    let is i32 as len with mut = 1;
    while (text[len - 1] != 0 && len < 2000) { len = len + 1; }
    if (len >= 2000) { return 0; }
    _put(&p[0], cast(u32, len));
    let is i32 as padded = ((len + 3) / 4) * 4;
    mem.memcpy(&p[4], text, len);
    if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[4]) + len), 0, padded - len); }
    return _send(w, object, opcode, &p[0], 4 + padded, 0 - 1);
}
fn _send_string_n(w as *Window, object as i32, opcode as i32, text as *u8, n as i64) as i32 {
    if (n < 0 || n >= 2000) { return 0; }
    let is [2048]u8 as p;
    let is i64 as len = n + 1;
    _put(&p[0], cast(u32, len));
    if (n > 0) { mem.memcpy(&p[4], text, n); }
    p[4 + n] = 0;
    let is i64 as padded = ((len + 3) / 4) * 4;
    if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[4]) + len), 0, padded - len); }
    return _send(w, object, opcode, &p[0], cast(i32, 4 + padded), 0 - 1);
}
fn _send_string_fd(w as *Window, object as i32, opcode as i32, text as *u8, fd as i64) as i32 {
    let is [256]u8 as p;
    let is i32 as len with mut = 1;
    while (text[len - 1] != 0 && len < 240) { len = len + 1; }
    if (len >= 240) { return 0; }
    _put(&p[0], cast(u32, len));
    let is i32 as padded = ((len + 3) / 4) * 4;
    mem.memcpy(&p[4], text, len);
    if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[4]) + len), 0, padded - len); }
    return _send(w, object, opcode, &p[0], 4 + padded, fd);
}

fn _read_transfer(w as *Window) as void {
    if (w.transfer_fd < 0) { return; }
    if (w.transfer_purpose == 1 && cast(i64, w.received_text) == 0) { return; }
    if (w.transfer_purpose == 2 && cast(i64, w.drop_storage) == 0) { return; }
    let is [4096]u8 as chunk;
    while (1 == 1) {
        let is i64 as n = linux.read(w.transfer_fd, &chunk[0], 4096);
        if (n > 0) {
            let is i64 as room with mut = MAX_TEXT - w.received_len;
            let is *u8 as dst with mut = w.received_text;
            if (w.transfer_purpose == 2) {
                room = MAX_DND_TEXT - w.drop_len;
                dst = cast(*u8, cast(i64, w.drop_storage) + 65536);
            }
            let is i64 as count with mut = n;
            let is i64 as used with mut = w.received_len;
            if (w.transfer_purpose == 2) { used = w.drop_len; }
            if (count > room) { count = room; }
            if (w.transfer_purpose == 2 && n > room && w.drop_truncated == 0) {
                dst[used + room] = chunk[room];
                w.drop_truncated = 1;
            }
            if (count > 0) {
                mem.memcpy(cast(*u8, cast(i64, dst) + used), &chunk[0], count);
                if (w.transfer_purpose == 2) { w.drop_len = w.drop_len + count; }
                else { w.received_len = w.received_len + count; }
            }
            continue;
        }
        if (n == 0) {
            let is i32 as offer = w.transfer_offer;
            let is i32 as primary = w.transfer_primary;
            let is i32 as purpose = w.transfer_purpose;
            linux.close(w.transfer_fd);
            w.transfer_fd = 0 - 1;
            w.transfer_offer = 0; w.transfer_primary = 0; w.transfer_mime = 0;
            w.transfer_purpose = 0; w.frame_ready = 1;
            if (purpose == 1) {
                w.clipboard_pending = 0; w.clipboard_ready = 1;
                w.received_text[w.received_len] = 0;
                let is i32 as index = _offer_index(w, offer, primary, 0);
                if (index >= 0) { _offer_release(w, index, 1); }
            } else { _drop_finish(w); }
            return;
        }
        if (n == 0 - sys.EINTR) { continue; }
        return;
    }
}

fn _cancel_transfer(w as *Window) as void {
    if (w.transfer_fd >= 0) { linux.close(w.transfer_fd); }
    w.transfer_fd = 0 - 1; w.transfer_offer = 0;
    w.transfer_purpose = 0;
    w.transfer_primary = 0; w.transfer_mime = 0;
    w.clipboard_pending = 0;
}

fn _source_slot(w as *Window) as i32 {
    let is i32 as i with mut = 0;
    while (i < MAX_DATA) {
        if (w.sources[i].object == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn clipboard_set(w as *Window, which as i32, text as *u8, n as i64) as i32 {
    if (w.opened == 0 || (which != 0 && which != 1) || n < 0 || n > MAX_TEXT ||
        (n > 0 && cast(i64, text) == 0) || w.input_serial == 0) { return 0; }
    let is i32 as primary = which;
    let is i32 as manager with mut = w.data_manager;
    let is i32 as device with mut = w.data_device;
    if (primary == 1) { manager = w.primary_manager; device = w.primary_device; }
    if (manager == 0 || device == 0) { return 0; }
    let is i32 as index = _source_slot(w);
    if (index < 0) { return 0; }
    let is i64 as bytes = n + 1;
    let is *u8 as copy = mem.core.mmap_anon(bytes);
    if (cast(i64, copy) == 0) { return 0; }
    if (n > 0) { mem.memcpy(copy, text, n); }
    copy[n] = 0;
    let is i32 as object = _id(w);
    if (object != 0) {
        _objects[object].fd_opcode = 1;
        if (primary == 1) { _objects[object].fd_opcode = 0; }
    }
    w.sources[index].object = object;
    w.sources[index].primary = primary;
    w.sources[index].which = which;
    w.sources[index].data = copy;
    w.sources[index].bytes = bytes;
    w.sources[index].length = n;
    let is [8]u8 as p;
    _put(&p[0], cast(u32, object));
    if (_send(w, manager, 0, &p[0], 4, 0 - 1) == 0 ||
        _send_string(w, object, 0, "UTF8_STRING") == 0 ||
        _send_string(w, object, 0, "text/plain;charset=utf-8") == 0 ||
        _send_string(w, object, 0, "text/plain") == 0) {
        _source_release(w, index, 1);
        return 0;
    }
    _put(&p[0], cast(u32, object));
    _put(&p[4], w.input_serial);
    let is i32 as opcode with mut = 1;
    if (primary == 1) { opcode = 0; }
    if (_send(w, device, opcode, &p[0], 8, 0 - 1) == 0) {
        _source_release(w, index, 1);
        return 0;
    }
    if (primary == 1) { w.primary_source = object; }
    else { w.clip_source = object; }
    return 1;
}

fn clipboard_request(w as *Window, which as i32) as i32 {
    if (w.opened == 0 || (which != 0 && which != 1) ||
        w.clipboard_pending == 1 || w.transfer_fd >= 0) { return 0; }
    let is i32 as primary = which;
    let is i32 as device with mut = w.data_device;
    let is i32 as offer with mut = w.clipboard_offer;
    let is i32 as source with mut = w.clip_source;
    if (primary == 1) {
        device = w.primary_device; offer = w.primary_offer; source = w.primary_source;
    }
    if (device == 0) { return 0; }
    _cancel_transfer(w);
    w.clipboard_ready = 0; w.received_len = 0;
    if (cast(i64, w.received_text) == 0) {
        w.received_text = mem.core.mmap_anon(MAX_TEXT + 1);
        if (cast(i64, w.received_text) == 0) { return 0; }
    }
    if (source != 0) {
        let is i32 as source_i = _source_index(w, source);
        if (source_i >= 0) {
            let is i64 as n = w.sources[source_i].length;
            if (n > 0) { mem.memcpy(w.received_text, w.sources[source_i].data, n); }
            w.received_len = n; w.received_text[n] = 0; w.clipboard_ready = 1;
            return 1;
        }
    }
    if (offer == 0) { w.received_text[0] = 0; w.clipboard_ready = 1; return 1; }
    let is i32 as offer_i = _offer_index(w, offer, primary, 0);
    if (offer_i < 0 || w.offers[offer_i].text_mime == 0) {
        w.received_text[0] = 0; w.clipboard_ready = 1; return 1;
    }
    let is *u8 as mime with mut = "text/plain";
    if (w.offers[offer_i].text_mime == 1) { mime = "UTF8_STRING"; }
    if (w.offers[offer_i].text_mime == 2) { mime = "text/plain;charset=utf-8"; }
    let is [8]i32 as fds;
    if (sys.socketpair(sys.AF_UNIX, sys.SOCK_STREAM | sys.SOCK_CLOEXEC, 0, &fds[0]) < 0) { return 0; }
    if (linux.fcntl(fds[0], 4, 2048) < 0) {
        linux.close(fds[0]); linux.close(fds[1]); return 0;
    }
    let is i32 as opcode with mut = 1;
    if (primary == 1) { opcode = 0; }
    if (_send_string_fd(w, offer, opcode, mime, fds[1]) == 0) {
        linux.close(fds[0]); linux.close(fds[1]); return 0;
    }
    linux.close(fds[1]);
    w.transfer_fd = fds[0]; w.transfer_offer = offer;
    w.transfer_primary = primary; w.transfer_mime = w.offers[offer_i].text_mime;
    w.transfer_purpose = 1;
    w.clipboard_pending = 1;
    return 1;
}

fn clipboard_ready(w as *Window) as i32 {
    if (w.transfer_fd >= 0 && sys.wait_readable(w.transfer_fd, 0) > 0) { _read_transfer(w); }
    return w.clipboard_ready;
}

fn clipboard_pending(w as *Window) as i32 { return w.clipboard_pending; }

fn clipboard_text(w as *Window, buf as *u8, cap as i64) as i64 {
    if (w.clipboard_ready == 0) { return 0 - 1; }
    if (cap <= 0 || cast(i64, buf) == 0) { return 0; }
    let is i64 as n with mut = w.received_len;
    if (n > cap - 1) { n = cap - 1; }
    if (n < 0) { n = 0; }
    if (n > 0) { mem.memcpy(buf, w.received_text, n); }
    buf[n] = 0;
    return n;
}
fn drop_answer(w as *Window, takes as i32) as i32 {
    if (w.opened == 0 || w.drop_offer == 0 || w.drop_pending == 1) { return 0; }
    w.drop_answer = takes & w.drop_offered;
    _drop_accept(w);
    return 1;
}

fn dropped_files(w as *Window) as i64 {
    if (w.drop_ready == 0 || w.drop_kind != event.DROP_FILES) { return 0; }
    return w.drop_file_count;
}

fn dropped_file(w as *Window, i as i64) as *u8 {
    if (w.drop_ready == 0 || w.drop_kind != event.DROP_FILES ||
        i < 0 || i >= w.drop_file_count || cast(i64, w.drop_storage) == 0) {
        return cast(*u8, 0);
    }
    return cast(*u8, cast(i64, w.drop_storage) + i * DROPPED_PATH_BYTES);
}

fn dropped_text(w as *Window) as *u8 {
    if (w.drop_ready == 0 || w.drop_kind != event.DROP_TEXT || w.drop_len == 0 ||
        cast(i64, w.drop_storage) == 0) { return cast(*u8, 0); }
    return cast(*u8, cast(i64, w.drop_storage) + 65536);
}

fn dropped_text_length(w as *Window) as i64 {
    if (w.drop_ready == 0 || w.drop_kind != event.DROP_TEXT) { return 0; }
    return w.drop_len;
}

fn clear_drop(w as *Window) as void {
    w.drop_ready = 0; w.drop_file_count = 0; w.drop_len = 0; w.drop_kind = 0; w.drop_truncated = 0;
}




fn _runtime_socket(w as *Window) as i32 {
    if (_connection_fd >= 0) { w.fd = _connection_fd; return _attach(w); }
    let is *u8 as display with mut = env.getenv("WAYLAND_DISPLAY");
    let is *u8 as runtime = env.getenv("XDG_RUNTIME_DIR");
    if (cast(i64, display) == 0 || display[0] == 0) { display = "wayland-0"; }
    if (cast(i64, runtime) == 0) { return 0; }
    let is [256]u8 as path;
    let is i32 as n with mut = 0;
    if (display[0] == cast(u8, 47)) {
        while (display[n] != 0 && n < 240) { path[n] = display[n]; n = n + 1; }
    } else {
        while (runtime[n] != 0 && n < 180) { path[n] = runtime[n]; n = n + 1; }
        if (n == 0 || n >= 180) { return 0; }
        path[n] = cast(u8, 47); n = n + 1;
        let is i32 as j with mut = 0;
        while (display[j] != 0 && j < 64) { path[n] = display[j]; n = n + 1; j = j + 1; }
        if (display[j] != 0) { return 0; }
    }
    if (n <= 0 || n >= 240) { return 0; }
    path[n] = 0;
    w.fd = sys.connect_unix(&path[0], n, 0);
    if (w.fd < 0) { return 0; }
    _connection_fd = w.fd;
    return _attach(w);
}

fn _init_protocol(w as *Window, title as *u8, app_id as *u8) as i32 {
    let is [8]u8 as idbody;
    if (_registry == 0) {
        _registry = _id(w);
        _put(&idbody[0], cast(u32, _registry));
        if (_send(w, 1, 1, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    }
    w.registry = _registry;
    w.registry_sync = _id(w);
    _put(&idbody[0], cast(u32, w.registry_sync));
    if (_send(w, 1, 0, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    let is i32 as waited with mut = 0;
    while (w.acked == 0 && waited < 200) {
        if (_pump_one(w, 1) == 0) { return 0; }
        waited = waited + 1;
    }
    if (_globals.compositor_global == 0 || _globals.shm_global == 0 || _globals.shell_global == 0) { return 0; }
    w.compositor = _binding(w, cast(u32, _globals.compositor_global), "wl_compositor", _bounded(_globals.compositor_version, 4));
    w.shm = _binding(w, cast(u32, _globals.shm_global), "wl_shm", 1);
    w.wm_base = _binding(w, cast(u32, _globals.shell_global), "xdg_wm_base", _bounded(_globals.shell_version, 6));
    if (w.compositor == 0 || w.shm == 0 || w.wm_base == 0) { return 0; }
    if (_globals.seat_global != 0) {
        w.seat = _id(w);
        w.seat_version = _bounded(_globals.seat_version, 7);
        if (_bind(w, cast(u32, _globals.seat_global), "wl_seat", w.seat_version, w.seat) == 0) { return 0; }
    }
    w.output_count = _globals.output_count;
    let is i32 as output_i with mut = 0;
    while (output_i < w.output_count) {
        w.outputs[output_i].global = _globals.outputs[output_i].global;
        w.outputs[output_i].version = _globals.outputs[output_i].version;
        w.outputs[output_i].scale = 1;
        w.outputs[output_i].object = _id(w);
        if (_bind(w, cast(u32, w.outputs[output_i].global), "wl_output",
                    _bounded(w.outputs[output_i].version, 4), w.outputs[output_i].object) == 0) { return 0; }
        output_i = output_i + 1;
    }
    if (_globals.viewporter_global != 0 && _globals.fractional_global != 0) {
        w.viewporter = _binding(w, cast(u32, _globals.viewporter_global), "wp_viewporter", _bounded(_globals.viewporter_version, 1));
        w.fractional_manager = _binding(w, cast(u32, _globals.fractional_global), "wp_fractional_scale_manager_v1", _bounded(_globals.fractional_version, 1));
        if (w.viewporter == 0 || w.fractional_manager == 0) { return 0; }
    }
    if (_globals.decoration_global != 0) {
        w.decoration_manager = _binding(w, cast(u32, _globals.decoration_global), "zxdg_decoration_manager_v1", _bounded(_globals.decoration_version, 2));
        if (w.decoration_manager == 0) { return 0; }
    }
    if (_globals.dialog_global != 0) {
        w.dialog_manager = _binding(w, cast(u32, _globals.dialog_global), "xdg_wm_dialog_v1", _bounded(_globals.dialog_version, 1));
        if (w.dialog_manager == 0) { return 0; }
    }
    if (_globals.cursor_shape_global != 0) {
        w.cursor_shape_manager = _binding(w, cast(u32, _globals.cursor_shape_global), "wp_cursor_shape_manager_v1", _bounded(_globals.cursor_shape_version, 1));
        if (w.cursor_shape_manager == 0) { return 0; }
    }
    if (_globals.data_manager_global != 0) {
        w.data_manager = _binding(w, cast(u32, _globals.data_manager_global), "wl_data_device_manager", _bounded(_globals.data_manager_version, 3));
        if (w.data_manager == 0) { return 0; }
    }
    if (_globals.primary_manager_global != 0) {
        w.primary_manager = _binding(w, cast(u32, _globals.primary_manager_global), "zwp_primary_selection_device_manager_v1", _bounded(_globals.primary_manager_version, 1));
        if (w.primary_manager == 0) { return 0; }
    }
    if (_globals.text_input_manager_global != 0) {
        w.text_input_manager = _binding(w, cast(u32, _globals.text_input_manager_global), "zwp_text_input_manager_v3", _bounded(_globals.text_input_manager_version, 1));
        if (w.text_input_manager == 0) { return 0; }
    }
    if (w.seat != 0 && w.data_manager != 0) {
        w.data_device = _id(w);
        _put(&idbody[0], cast(u32, w.data_device));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (_send(w, w.data_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    if (w.seat != 0 && w.primary_manager != 0) {
        w.primary_device = _id(w);
        _put(&idbody[0], cast(u32, w.primary_device));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (_send(w, w.primary_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    if (w.seat != 0 && w.text_input_manager != 0) {
        w.text_input = _id(w);
        _put(&idbody[0], cast(u32, w.text_input));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (_send(w, w.text_input_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    while (_pump_one(w, 0) == 1) { }
    w.surface = _id(w);
    _put(&idbody[0], cast(u32, w.surface));
    if (_send(w, w.compositor, 0, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    w.xdg_surface = _id(w);
    if (w.viewporter != 0 && w.fractional_manager != 0) {
        w.viewport = _id(w);
        _put(&idbody[0], cast(u32, w.viewport));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.surface));
        if (_send(w, w.viewporter, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
        w.fractional_surface = _id(w);
        _put(&idbody[0], cast(u32, w.fractional_surface));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.surface));
        if (_send(w, w.fractional_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
        w.fractional_active = 1;
    }
    _put(&idbody[0], cast(u32, w.xdg_surface));
    _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.surface));
    if (_send(w, w.wm_base, 2, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    w.toplevel = _id(w);
    _put(&idbody[0], cast(u32, w.toplevel));
    if (_send(w, w.xdg_surface, 1, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    if (w.decoration_manager != 0) {
        w.toplevel_decoration = _id(w);
        _put(&idbody[0], cast(u32, w.toplevel_decoration));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.toplevel));
        if (_send(w, w.decoration_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
        let is [4]u8 as mode;
        if (w.decorated_wanted != 0) { _put(&mode[0], 2); }
        else { _put(&mode[0], 1); }
        if (_send(w, w.toplevel_decoration, 1, &mode[0], 4, 0 - 1) == 0) { return 0; }
    }
    if (_send_string(w, w.toplevel, 2, title) == 0) { return 0; }
    if (_send_string(w, w.toplevel, 3, app_id) == 0) { return 0; }
    // Request the initial configure; the xdg-shell role is not usable until
    // the compositor configures the surface and the client acknowledges it.
    if (_send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    waited = 0;
    while (w.acked != 2 && waited < 200) {
        if (_pump_one(w, 1) == 0) { return 0; }
        waited = waited + 1;
    }
    if (w.acked != 2) { return 0; }
    if (w.configured_width > 0) { w.logical_width = w.configured_width; }
    else { w.logical_width = w.width; }
    if (w.configured_height > 0) { w.logical_height = w.configured_height; }
    else { w.logical_height = w.height; }
    w.width = _scale_up(w.logical_width, w.scale120);
    w.height = _scale_up(w.logical_height, w.scale120);
    if (w.width <= 0 || w.height <= 0) { return 0; }
    w.resized = 0;
    return 1;
}

fn _make_buffers(w as *Window) as i32 {
    if (w.bytes <= 0 || w.bytes > 1073741824) { return 0; }
    w.memfd = sys.memfd_create("caustic-wayland-buffer", 1);
    if (w.memfd < 0) { return 0; }
    if (linux.ftruncate(w.memfd, w.bytes * BUFFER_COUNT) != 0) { return 0; }
    w.pixels = linux.mmap(cast(*u8, 0), w.bytes * BUFFER_COUNT, linux.PROT_READ | linux.PROT_WRITE,
                          linux.MAP_SHARED, w.memfd, 0);
    if (cast(i64, w.pixels) == linux.MAP_FAILED) { w.pixels = cast(*u8, 0); return 0; }
    w.pool = _id(w);
    let is [24]u8 as p;
    _put(&p[0], cast(u32, w.pool)); _put(&p[4], cast(u32, w.bytes * BUFFER_COUNT));
    if (_send(w, w.shm, 0, &p[0], 8, w.memfd) == 0) { return 0; }
    w.buffers[0].object = _id(w); w.buffers[1].object = _id(w);
    let is i32 as i with mut = 0;
    while (i < BUFFER_COUNT) {
        let is i64 as off = i * w.bytes;
        _put(&p[0], cast(u32, w.buffers[i].object));
        _put(cast(*u8, cast(i64, &p[0]) + 4), cast(u32, off));
        _put(cast(*u8, cast(i64, &p[0]) + 8), cast(u32, w.width));
        _put(cast(*u8, cast(i64, &p[0]) + 12), cast(u32, w.height));
        _put(cast(*u8, cast(i64, &p[0]) + 16), cast(u32, w.stride));
        _put(cast(*u8, cast(i64, &p[0]) + 20), FORMAT_ARGB8888);
        if (_send(w, w.pool, 0, &p[0], 24, 0 - 1) == 0) { return 0; }
        w.buffers[i].busy = 0;
        i = i + 1;
    }
    let is [0]u8 as empty;
    if (_send(w, w.pool, 1, &empty[0], 0, 0 - 1) == 0) { return 0; }
    linux.close(w.memfd);
    w.memfd = 0 - 1;
    w.pool = 0;
    w.buffer_width = w.width; w.buffer_height = w.height;
    return 1;
}

fn _destroy_buffers(w as *Window) as void {
    let is [0]u8 as empty;
    let is i32 as i with mut = 0;
    while (i < BUFFER_COUNT) {
        if (w.buffers[i].object != 0) {
            _send(w, w.buffers[i].object, 0, &empty[0], 0, 0 - 1);
            w.buffers[i].object = 0;
        }
        i = i + 1;
    }
    if (cast(i64, w.pixels) != 0) {
        linux.munmap(w.pixels, w.bytes * BUFFER_COUNT);
        w.pixels = cast(*u8, 0);
    }
    w.last_buffer = 0 - 1;
    w.current = 0 - 1;
    w.buffer_width = 0; w.buffer_height = 0;
}

fn _discard(w as *Window) as void { close(w); }
// The caller owns the storage and keeps it at this address until close.
fn open_config(w as *Window, title as *u8, width as i64, height as i64, options as *Options) as i32 {
    _zero(w);
    let is Options as o with mut = options();
    if (cast(i64, options) != 0) { o = *options; }
    w.width = width; w.height = height; w.decorated_wanted = o.decorated;
    if (width <= 0 || height <= 0) { w.err = NO_CONFIGURE; return 0; }
    if (_protocol_ready() == 0) { w.err = NO_PROTOCOL; return 0; }
    if (_runtime_socket(w) == 0) { w.err = NO_RUNTIME; return 0; }
    if (_init_protocol(w, title, o.app_id) == 0) { w.err = NO_COMPOSITOR; _discard(w); return 0; }
    w.opened = 1;
    if (o.parent != 0 && set_parent(w, o.parent) == 0) {
        w.err = NO_SHELL; _discard(w); return 0;
    }
    if (o.resizable == 0) {
        if (set_min_size(w, width, height) == 0 || set_max_size(w, width, height) == 0) {
            w.err = NO_SHELL; _discard(w); return 0;
        }
    }
    if (o.modal != 0) { set_modal(w, 1); }
    w.stride = w.width * 4; w.bytes = w.stride * w.height;
    if (_make_buffers(w) == 0) { w.err = NO_MEMORY; _discard(w); return 0; }
    let is i32 as id = _id(w);
    let is [4]u8 as p;
    _put(&p[0], cast(u32, id));
    if (_send(w, w.surface, 3, &p[0], 4, 0 - 1) == 0) { w.err = NO_SHELL; _discard(w); return 0; }
    if (_send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { w.err = NO_SHELL; _discard(w); return 0; }
    w.callback = id;
    w.err = OK; w.mapped = 0;
    return 1;
}

fn open(w as *Window, title as *u8, width as i64, height as i64) as i32 {
    let is Options as o = options();
    return open_config(w, title, width, height, &o);
}

fn error(w as *Window) as i32 { return w.err; }
fn is_open(w as *Window) as i32 { return w.opened; }
fn should_close(w as *Window) as i32 { return w.close_requested; }
fn width(w as *Window) as i64 { return w.width; }
fn height(w as *Window) as i64 { return w.height; }
fn scale(w as *Window) as i32 { return w.scale120; }
fn state(w as *Window) as i32 { return w.state; }
fn native_fd(w as *Window) as i64 { return w.fd; }
fn native_surface(w as *Window) as i32 { return w.surface; }
fn native_toplevel(w as *Window) as i32 { return w.toplevel; }
fn key_down(w as *Window, key as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < 256) {
        if (w.key_down[i] == 1 && w.key_syms[i] == key) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn button_down(w as *Window, button as i32) as i32 {
    if (button <= 0 || button >= 8) { return 0; }
    return w.pointer_buttons[button];
}

fn mouse_x(w as *Window) as i64 { return w.pointer_x; }
fn mouse_y(w as *Window) as i64 { return w.pointer_y; }

fn mouse_dx(w as *Window) as i64 {
    let is i64 as dx = w.pointer_dx;
    w.pointer_dx = 0;
    return dx;
}

fn mouse_dy(w as *Window) as i64 {
    let is i64 as dy = w.pointer_dy;
    w.pointer_dy = 0;
    return dy;
}

fn wheel(w as *Window) as i64 {
    let is i64 as value = w.wheel;
    w.wheel = 0;
    return value;
}



fn _apply_configure(w as *Window) as void {
    let is i64 as logical_w with mut = w.logical_width;
    let is i64 as logical_h with mut = w.logical_height;
    let is i64 as shadow_w with mut = 0;
    let is i64 as shadow_h with mut = 0;
    if (w.state == 0) {
        shadow_w = _scale_down(w.ext_left + w.ext_right, w.scale120);
        shadow_h = _scale_down(w.ext_top + w.ext_bottom, w.scale120);
    }
    if (w.configured_width > 0) { logical_w = w.configured_width + shadow_w; }
    else if (w.state == 0 && w.old_state != 0 && w.normal_width > 0) { logical_w = w.normal_width; }
    if (w.configured_height > 0) { logical_h = w.configured_height + shadow_h; }
    else if (w.state == 0 && w.old_state != 0 && w.normal_height > 0) { logical_h = w.normal_height; }
    let is i64 as width with mut = _scale_up(logical_w, w.scale120);
    let is i64 as height with mut = _scale_up(logical_h, w.scale120);
    // A compositor may leave the size to the client, including after the
    // toolkit publishes a larger minimum for its client-side frame.
    if (w.state == 0 && width < w.min_width) {
        logical_w = (w.min_width * 120 + w.scale120 - 1) / w.scale120;
        width = _scale_up(logical_w, w.scale120);
    }
    if (w.state == 0 && height < w.min_height) {
        logical_h = (w.min_height * 120 + w.scale120 - 1) / w.scale120;
        height = _scale_up(logical_h, w.scale120);
    }
    if (logical_w > 0 && logical_h > 0 &&
        (w.logical_width != logical_w || w.logical_height != logical_h ||
         w.width != width || w.height != height)) {
        w.logical_width = logical_w;
        w.logical_height = logical_h;
        w.width = width; w.height = height;
        w.resized = 1;
        let is event.Event as e;
        event.clear(&e); e.kind = event.RESIZE; e.width = w.width; e.height = w.height;
        _queue(w, &e);
    }
    if (w.state != w.old_state) {
        w.old_state = w.state;
        let is event.Event as e;
        event.clear(&e); e.kind = event.STATE; e.state = w.state;
        _queue(w, &e);
    }
}

fn resized(w as *Window) as i32 { return w.resized; }

fn next_frame(w as *Window) as i32 {
    if (w.opened == 0) { return 0; }
    if (w.mapped == 0) { w.mapped = 1; w.frame_ready = 1; return 1; }
    if (w.event_len > 0) { return 1; }
    if (w.frame_ready == 1) { w.resized = 0; return 1; }
    w.resized = 0;
    if (w.close_requested == 1) { return 0; }
    while (w.frame_ready == 0 && w.resized == 0 && w.event_len == 0 && w.close_requested == 0) {
        if (_pump_one(w, 1) == 0) { w.err = NO_SOCKET; w.opened = 0; return 0; }
        _apply_configure(w);
    }
    if (w.resized == 1 || w.event_len > 0) { return 1; }
    if (w.frame_ready == 1) { return 1; }
    return cast(i32, w.close_requested == 0);
}

fn pending(w as *Window) as i32 {
    if (w.event_len > 0) { return 1; }
    if (w.fd < 0) { return 0; }
    if (w.transfer_fd >= 0 && sys.wait_readable(w.transfer_fd, 0) > 0) { return 1; }
    return cast(i32, sys.wait_readable(w.fd, 0) > 0);
}

fn keep_open(w as *Window) as void { w.close_requested = 0; }
fn request_close(w as *Window) as void {
    if (w.opened == 0 || w.close_requested == 1) { return; }
    w.close_requested = 1;
    let is event.Event as e;
    event.clear(&e); e.kind = event.CLOSE;
    _queue(w, &e);
}




fn acquire(w as *Window) as tgt.Target {
    let is tgt.Target as t;
    t.color = cast(*u8, 0); t.depth = cast(*u8, 0); t.width = 0; t.height = 0;
    w.current = 0 - 1;
    if (w.opened == 0) { return t; }
    if (w.buffer_width != w.width || w.buffer_height != w.height) {
        pump(w);
        if (w.buffers[0].busy == 1 || w.buffers[1].busy == 1) {
            if (_retire_current(w) == 0) {
                if (w.resize_detached == 0) {
                    let is [12]u8 as p;
                    _put(&p[0], 0); _put(&p[4], 0); _put(&p[8], 0);
                    if (_send(w, w.surface, 1, &p[0], 12, 0 - 1) == 0 ||
                        _surface_commit(w) == 0) { return t; }
                    w.resize_detached = 1; w.visible = 0;
                }
                return t;
            }
        } else { _destroy_buffers(w); }
        w.stride = w.width * 4; w.bytes = w.stride * w.height;
        if (_make_buffers(w) == 0) { w.err = NO_MEMORY; return t; }
        w.resize_detached = 0;
    }
    let is i32 as i with mut = 0;
    while (i < BUFFER_COUNT && w.buffers[i].busy == 1) { i = i + 1; }
    if (i >= BUFFER_COUNT) { return t; }
    w.current = i;
    t.color = cast(*u8, cast(i64, w.pixels) + i * w.bytes);
    t.width = w.width; t.height = w.height;
    return t;
}

fn _set_window_geometry(w as *Window, with_extents as i32) as i32 {
    if (w.logical_width <= 0 || w.logical_height <= 0 || w.scale120 <= 0) { return 0; }
    let is i64 as left with mut = _scale_down(w.ext_left, w.scale120);
    let is i64 as right with mut = _scale_down(w.ext_right, w.scale120);
    let is i64 as top with mut = _scale_down(w.ext_top, w.scale120);
    let is i64 as bottom with mut = _scale_down(w.ext_bottom, w.scale120);
    if (with_extents == 0) {
        left = 0; right = 0; top = 0; bottom = 0;
    } else {
        if (left + right >= w.logical_width) { left = 0; right = 0; }
        if (top + bottom >= w.logical_height) { top = 0; bottom = 0; }
    }
    let is [16]u8 as p;
    _put(&p[0], cast(u32, left)); _put(&p[4], cast(u32, top));
    _put(&p[8], cast(u32, w.logical_width - left - right));
    _put(&p[12], cast(u32, w.logical_height - top - bottom));
    return _send(w, w.xdg_surface, 3, &p[0], 16, 0 - 1);
}


fn submit(w as *Window) as void {
    if (w.opened == 0 || w.current < 0 || w.buffers[w.current].busy == 1) { return; }
    if (_set_window_geometry(w, cast(i32, (w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN |
        event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT | event.STATE_TILED_TOP |
        event.STATE_TILED_BOTTOM)) == 0)) == 0) { return; }
    // Caustic's software target is RGBA bytes; WL_SHM_FORMAT_ARGB8888 uses
    // BGRA bytes on little-endian hosts. Convert the owned back buffer in place.
    let is i64 as count = w.width * w.height;
    let is i64 as i with mut = 0;
    while (i < count) {
        let is *u8 as p = cast(*u8, cast(i64, w.pixels) + w.current * w.bytes + i * 4);
        let is u8 as r = p[0]; p[0] = p[2]; p[2] = r;
        i = i + 1;
    }
    let is i32 as id = _id(w);
    let is [16]u8 as p;
    _put(&p[0], cast(u32, w.scale));
    if (_send(w, w.surface, 8, &p[0], 4, 0 - 1) == 0) { return; }
    if (w.fractional_active == 1 && w.viewport != 0) {
        _put(&p[0], cast(u32, w.logical_width));
        _put(&p[4], cast(u32, w.logical_height));
        if (_send(w, w.viewport, 2, &p[0], 8, 0 - 1) == 0) { return; }
    }
    _put(&p[0], cast(u32, w.buffers[w.current].object));
    _put(cast(*u8, cast(i64, &p) + 4), 0);
    _put(cast(*u8, cast(i64, &p) + 8), 0);
    _send(w, w.surface, 1, &p[0], 12, 0 - 1);
    _put(&p[0], 0); _put(cast(*u8, cast(i64, &p) + 4), 0);
    _put(cast(*u8, cast(i64, &p) + 8), cast(u32, w.logical_width));
    _put(cast(*u8, cast(i64, &p) + 12), cast(u32, w.logical_height));
    if (_send(w, w.surface, 2, &p[0], 16, 0 - 1) == 0) { return; }
    _put(&p[0], cast(u32, id));
    _send(w, w.surface, 3, &p[0], 4, 0 - 1);
    _send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1);
    w.callback = id;
    w.buffers[w.current].busy = 1;
    w.last_buffer = w.current;
    w.visible = 1; w.resize_detached = 0;
    w.frame_ready = 0;
    w.current = 0 - 1;
}

fn hide(w as *Window) as void {
    if (w.opened == 0 || w.visible == 0) { return; }
    let is [12]u8 as p;
    _put(&p[0], 0); _put(&p[4], 0); _put(&p[8], 0);
    if (_send(w, w.surface, 1, &p[0], 12, 0 - 1) == 0) { return; }
    if (_send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { return; }
    w.visible = 0;
}

fn show(w as *Window) as void {
    if (w.opened == 0 || w.visible == 1 || w.resize_detached == 1 ||
        w.buffer_width != w.width || w.buffer_height != w.height) { return; }
    if (w.last_buffer < 0 || w.buffers[w.last_buffer].object == 0) {
        w.visible = 1;
        return;
    }
    if (_set_window_geometry(w, cast(i32, (w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN |
        event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT | event.STATE_TILED_TOP |
        event.STATE_TILED_BOTTOM)) == 0)) == 0) { return; }
    let is [16]u8 as p;
    _put(&p[0], cast(u32, w.scale));
    if (_send(w, w.surface, 8, &p[0], 4, 0 - 1) == 0) { return; }
    if (w.fractional_active == 1 && w.viewport != 0) {
        _put(&p[0], cast(u32, w.logical_width));
        _put(&p[4], cast(u32, w.logical_height));
        if (_send(w, w.viewport, 2, &p[0], 8, 0 - 1) == 0) { return; }
    }
    _put(&p[0], cast(u32, w.buffers[w.last_buffer].object));
    _put(&p[4], 0); _put(&p[8], 0);
    if (_send(w, w.surface, 1, &p[0], 12, 0 - 1) == 0) { return; }
    _put(&p[0], 0); _put(&p[4], 0);
    _put(&p[8], cast(u32, w.logical_width)); _put(&p[12], cast(u32, w.logical_height));
    if (_send(w, w.surface, 2, &p[0], 16, 0 - 1) == 0) { return; }
    let is i32 as callback = _id(w);
    _put(&p[0], cast(u32, callback));
    if (_send(w, w.surface, 3, &p[0], 4, 0 - 1) == 0) { return; }
    if (_send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { return; }
    w.callback = callback;
    w.buffers[w.last_buffer].busy = 1;
    w.visible = 1;
}

fn pump(w as *Window) as void {
    if (w.opened == 0) { return; }
    if (w.transfer_fd >= 0 && sys.wait_readable(w.transfer_fd, 0) > 0) { _read_transfer(w); }
    while (_pump_one(w, 0) == 1) { }
    if (w.transfer_fd >= 0 && sys.wait_readable(w.transfer_fd, 0) > 0) { _read_transfer(w); }
    _apply_configure(w);
}

fn poll_event(w as *Window, out as *event.Event) as i32 {
    if (w.event_len == 0) { return 0; }
    *out = w.events[w.event_head];
    w.event_head = (w.event_head + 1) % MAX_EVENTS;
    w.event_len = w.event_len - 1;
    return 1;
}

fn set_title(w as *Window, title as *u8, n as i64) as void {
    if (w.opened == 0) { return; }
    _send_string_n(w, w.toplevel, 2, title, n);
}

fn set_parent(w as *Window, parent as i32) as i32 {
    if (w.opened == 0) { return 0; }
    let is [4]u8 as p;
    _put(&p[0], cast(u32, parent));
    if (_send(w, w.toplevel, 1, &p[0], 4, 0 - 1) == 0) { return 0; }
    w.parent_toplevel = parent;
    return 1;
}

fn set_modal(w as *Window, on as i32) as i32 {
    if (w.opened == 0 || w.parent_toplevel == 0 || w.dialog_manager == 0) { return 0; }
    if (w.dialog == 0) {
        w.dialog = _id(w);
        let is [8]u8 as p;
        _put(&p[0], cast(u32, w.dialog));
        _put(&p[4], cast(u32, w.toplevel));
        if (_send(w, w.dialog_manager, 1, &p[0], 8, 0 - 1) == 0) {
            w.dialog = 0;
            return 0;
        }
    }
    let is i32 as op with mut = 2;
    if (on != 0) { op = 1; }
    return _send(w, w.dialog, op, cast(*u8, 0), 0, 0 - 1);
}

fn set_decorated(w as *Window, on as i32) as i32 {
    if (w.opened == 0 || w.toplevel_decoration == 0) { return 0; }
    let is [4]u8 as p;
    let is i32 as mode with mut = 1;
    if (on != 0) { mode = 2; }
    _put(&p[0], cast(u32, mode));
    if (_send(w, w.toplevel_decoration, 1, &p[0], 4, 0 - 1) == 0) { return 0; }
    w.decorated_wanted = on;
    return 1;
}

fn decorated(w as *Window) as i32 { return w.server_decorated; }

fn set_frame_extents(w as *Window, left as i64, right as i64, top as i64, bottom as i64) as i32 {
    if (w.opened == 0 || left < 0 || right < 0 || top < 0 || bottom < 0 ||
        left + right >= w.width || top + bottom >= w.height) { return 0; }
    w.ext_left = left; w.ext_right = right; w.ext_top = top; w.ext_bottom = bottom;
    _apply_configure(w);
    return _set_window_geometry(w, cast(i32, (w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN |
        event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT | event.STATE_TILED_TOP |
        event.STATE_TILED_BOTTOM)) == 0));
}

fn set_input_region(w as *Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    if (w.opened == 0 || width < 0 || height < 0) { return 0; }
    let is i32 as region = _id(w);
    let is [16]u8 as p;
    _put(&p[0], cast(u32, region));
    if (_send(w, w.compositor, 1, &p[0], 4, 0 - 1) == 0) { return 0; }
    _put(&p[0], cast(u32, _scale_down(x, w.scale120)));
    _put(&p[4], cast(u32, _scale_down(y, w.scale120)));
    _put(&p[8], cast(u32, _scale_down(width, w.scale120)));
    _put(&p[12], cast(u32, _scale_down(height, w.scale120)));
    let is i32 as added = _send(w, region, 1, &p[0], 16, 0 - 1);
    _put(&p[0], cast(u32, region));
    let is i32 as set = _send(w, w.surface, 5, &p[0], 4, 0 - 1);
    let is [0]u8 as empty;
    _send(w, region, 0, &empty[0], 0, 0 - 1);
    if (added == 0 || set == 0) { return 0; }
    w.input_x = x; w.input_y = y; w.input_width = width; w.input_height = height;
    w.input_region_set = 1;
    return 1;
}

fn input_region(w as *Window, x as *i64, y as *i64, width as *i64, height as *i64) as i32 {
    *x = 0; *y = 0; *width = 0; *height = 0;
    if (w.opened == 0 || w.input_region_set == 0) { return 0; }
    *x = w.input_x; *y = w.input_y; *width = w.input_width; *height = w.input_height;
    return 1;
}

fn begin_move_resize(w as *Window, x as i64, y as i64, how as i64, button as i64) as i32 {
    if (w.opened == 0 || w.seat == 0 || w.pointer_serial == 0) { return 0; }
    let is [12]u8 as p;
    _put(&p[0], cast(u32, w.seat)); _put(&p[4], w.pointer_serial);
    if (how == 8) { return _send(w, w.toplevel, 5, &p[0], 8, 0 - 1); }
    if (how < 0 || how > 7) { return 0; }
    _put(&p[8], cast(u32, how + 1));
    return _send(w, w.toplevel, 6, &p[0], 12, 0 - 1);
}

fn show_window_menu(w as *Window, x as i64, y as i64) as i32 {
    if (w.opened == 0 || w.seat == 0 || w.pointer_serial == 0) { return 0; }
    let is [16]u8 as p;
    _put(&p[0], cast(u32, w.seat)); _put(&p[4], w.pointer_serial);
    _put(&p[8], cast(u32, _scale_down(x, w.scale120)));
    _put(&p[12], cast(u32, _scale_down(y, w.scale120)));
    return _send(w, w.toplevel, 4, &p[0], 16, 0 - 1);
}

fn set_cursor(w as *Window, shape as i32) as i32 {
    if (w.opened == 0 || w.pointer == 0 || w.pointer_inside == 0 ||
        w.pointer_serial == 0 || shape < 1 || shape > 35) { return 0; }
    let is [16]u8 as p;
    if (shape == 35) {
        _put(&p[0], w.pointer_serial); _put(&p[4], 0);
        _put(&p[8], 0); _put(&p[12], 0);
        return _send(w, w.pointer, 0, &p[0], 16, 0 - 1);
    }
    if (w.cursor_shape_device == 0) { return 0; }
    _put(&p[0], w.pointer_serial); _put(&p[4], cast(u32, shape));
    return _send(w, w.cursor_shape_device, 1, &p[0], 8, 0 - 1);
}

fn set_min_size(w as *Window, width as i64, height as i64) as i32 {
    if (w.opened == 0 || width < 0 || height < 0) { return 0; }
    let is [8]u8 as p;
    _put(&p[0], cast(u32, (width * 120 + w.scale120 - 1) / w.scale120));
    _put(&p[4], cast(u32, (height * 120 + w.scale120 - 1) / w.scale120));
    if (_send(w, w.toplevel, 8, &p[0], 8, 0 - 1) == 0 || _surface_commit(w) == 0) { return 0; }
    w.min_width = width; w.min_height = height;
    _apply_configure(w);
    return 1;
}

fn min_size(w as *Window, width as *i64, height as *i64) as i32 {
    *width = 0; *height = 0;
    if (w.opened == 0) { return 0; }
    *width = w.min_width; *height = w.min_height;
    return cast(i32, w.min_width > 0 || w.min_height > 0);
}

fn set_max_size(w as *Window, width as i64, height as i64) as i32 {
    if (w.opened == 0 || width < 0 || height < 0) { return 0; }
    let is [8]u8 as p;
    _put(&p[0], cast(u32, width * 120 / w.scale120));
    _put(&p[4], cast(u32, height * 120 / w.scale120));
    if (_send(w, w.toplevel, 7, &p[0], 8, 0 - 1) == 0 || _surface_commit(w) == 0) { return 0; }
    w.max_width = width; w.max_height = height;
    return 1;
}

fn set_maximized(w as *Window, on as i32) as i32 {
    if (w.opened == 0) { return 0; }
    let is i32 as op with mut = 10;
    if (on != 0) { op = 9; }
    if (_send(w, w.toplevel, op, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    return _surface_commit(w);
}

fn set_fullscreen(w as *Window, on as i32) as i32 {
    if (w.opened == 0) { return 0; }
    if (on == 0) {
        if (_send(w, w.toplevel, 12, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
        return _surface_commit(w);
    }
    let is [4]u8 as p;
    _put(&p[0], 0);
    if (_send(w, w.toplevel, 11, &p[0], 4, 0 - 1) == 0) { return 0; }
    return _surface_commit(w);
}

fn minimize(w as *Window) as i32 {
    if (w.opened == 0 || _send(w, w.toplevel, 13, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    return _surface_commit(w);
}

fn text_input_enable(w as *Window, on as i32) as i32 {
    if (w.opened == 0 || w.text_input == 0) { return 0; }
    let is i32 as enabled = cast(i32, on != 0);
    if (enabled == w.text_input_enabled) { return 1; }
    let is i32 as op with mut = 2;
    let is [8]u8 as p;
    if (enabled == 1) {
        op = 1;
        _put(&p[0], 0); _put(&p[4], 0);
        if (_send(w, w.text_input, 5, &p[0], 8, 0 - 1) == 0) { return 0; }
    }
    if (_send(w, w.text_input, op, cast(*u8, 0), 0, 0 - 1) == 0 ||
        _send(w, w.text_input, 7, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    w.text_input_enabled = enabled;
    if (enabled == 0) {
        w.text_input_entered = 0;
        w.ime_preedit_len = 0; w.ime_cursor = 0;
        let is event.Event as e;
        event.clear(&e); e.kind = event.PREEDIT; e.text = &w.ime_preedit[0];
        _queue(w, &e);
    }
    return 1;
}

fn text_input_active(w as *Window) as i32 {
    return cast(i32, w.text_input_enabled == 1 && w.text_input_entered == 1);
}

fn text_input_rect(w as *Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    if (w.opened == 0 || w.text_input == 0 || w.text_input_enabled == 0 ||
        width < 0 || height < 0) { return 0; }
    if (x == w.ime_rect_x && y == w.ime_rect_y && width == w.ime_rect_w && height == w.ime_rect_h) {
        return 1;
    }
    let is [16]u8 as p;
    _put(&p[0], cast(u32, _scale_down(x, w.scale120)));
    _put(&p[4], cast(u32, _scale_down(y, w.scale120)));
    _put(&p[8], cast(u32, _scale_down(width, w.scale120)));
    _put(&p[12], cast(u32, _scale_down(height, w.scale120)));
    if (_send(w, w.text_input, 6, &p[0], 16, 0 - 1) == 0 ||
        _send(w, w.text_input, 7, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    w.ime_rect_x = x; w.ime_rect_y = y; w.ime_rect_w = width; w.ime_rect_h = height;
    return 1;
}


fn close(w as *Window) as void {
    let is [0]u8 as empty;
    _cancel_transfer(w);
    let is i32 as data_i with mut = 0;
    while (data_i < MAX_DATA) {
        if (w.offers[data_i].object != 0) { _offer_release(w, data_i, 1); }
        if (w.sources[data_i].object != 0) { _source_release(w, data_i, 1); }
        data_i = data_i + 1;
    }
    if (w.data_device != 0) { _send(w, w.data_device, 2, &empty[0], 0, 0 - 1); }
    if (w.primary_device != 0) { _send(w, w.primary_device, 1, &empty[0], 0, 0 - 1); }
    if (w.text_input != 0) { _send(w, w.text_input, 0, &empty[0], 0, 0 - 1); }
    if (w.cursor_shape_device != 0) {
        _send(w, w.cursor_shape_device, 0, &empty[0], 0, 0 - 1);
    }
    if (w.viewport != 0) { _send(w, w.viewport, 0, &empty[0], 0, 0 - 1); }
    if (w.fractional_surface != 0) { _send(w, w.fractional_surface, 0, &empty[0], 0, 0 - 1); }
    if (w.toplevel_decoration != 0) { _send(w, w.toplevel_decoration, 0, &empty[0], 0, 0 - 1); }
    if (w.dialog != 0) { _send(w, w.dialog, 0, &empty[0], 0, 0 - 1); }
    if (w.toplevel != 0) { _send(w, w.toplevel, 0, &empty[0], 0, 0 - 1); }
    if (w.xdg_surface != 0) { _send(w, w.xdg_surface, 0, &empty[0], 0, 0 - 1); }
    if (w.surface != 0) { _send(w, w.surface, 0, &empty[0], 0, 0 - 1); }
    if (w.pool != 0) { _send(w, w.pool, 1, &empty[0], 0, 0 - 1); w.pool = 0; }
    if (w.memfd >= 0) { linux.close(w.memfd); w.memfd = 0 - 1; }
    _destroy_buffers(w);
    if (cast(i64, w.received_text) != 0) { mem.core.munmap(w.received_text, MAX_TEXT + 1); }
    if (cast(i64, w.drop_storage) != 0) { mem.core.munmap(w.drop_storage, DROP_STORAGE_BYTES); }
    w.received_text = cast(*u8, 0); w.drop_storage = cast(*u8, 0);
    if (w.pointer != 0 && w.pointer_version >= 3) { _send(w, w.pointer, 1, &empty[0], 0, 0 - 1); }
    if (w.keyboard != 0 && w.seat_version >= 3) { _send(w, w.keyboard, 0, &empty[0], 0, 0 - 1); }
    if (w.seat != 0 && w.seat_version >= 5) { _send(w, w.seat, 3, &empty[0], 0, 0 - 1); }
    let is i32 as output_i with mut = 0;
    while (output_i < w.output_count) {
        if (w.outputs[output_i].object != 0 && w.outputs[output_i].version >= 3) {
            _send(w, w.outputs[output_i].object, 0, &empty[0], 0, 0 - 1);
        }
        output_i = output_i + 1;
    }
    if (cast(i64, w.compose_state) != 0) { xkb.xkb_compose_state_unref(w.compose_state); }
    if (cast(i64, w.compose_table) != 0) { xkb.xkb_compose_table_unref(w.compose_table); }
    if (cast(i64, w.xkb_state) != 0) { xkb.xkb_state_unref(w.xkb_state); }
    if (cast(i64, w.xkb_keymap) != 0) { xkb.xkb_keymap_unref(w.xkb_keymap); }
    if (cast(i64, w.xkb_context) != 0) { xkb.xkb_context_unref(w.xkb_context); }
    w.compose_state = cast(*u8, 0); w.compose_table = cast(*u8, 0);
    w.xkb_state = cast(*u8, 0); w.xkb_keymap = cast(*u8, 0); w.xkb_context = cast(*u8, 0);
    let is i32 as i with mut = 0;
    while (i < RETIRED_COUNT) {
        if (cast(i64, w.retired[i].pixels) != 0) {
            let is i32 as retired_i with mut = 0;
            while (retired_i < BUFFER_COUNT) {
                if (w.retired[i].buffers[retired_i].object != 0) {
                    _send(w, w.retired[i].buffers[retired_i].object, 0, &empty[0], 0, 0 - 1);
                }
                retired_i = retired_i + 1;
            }
            linux.munmap(w.retired[i].pixels, w.retired[i].bytes * BUFFER_COUNT);
        }
        mem.memzero(cast(*u8, &w.retired[i]), sizeof(BufferSet));
        i = i + 1;
    }
    _disconnect(w);
    w.fd = 0 - 1; w.opened = 0;
}
