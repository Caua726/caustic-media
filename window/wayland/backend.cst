                     get_viewport.opcode == 1 && get_viewport.arg_count == 2 &&
                     set_destination.opcode == 2 && set_destination.arg_count == 2 &&
                     get_fractional.opcode == 1 && get_fractional.arg_count == 2 &&
                     preferred_scale.opcode == 0 && preferred_scale.arg_count == 1 &&
                     manager_source.opcode == 0 && manager_source.arg_count == 1 &&
                     manager_device.opcode == 1 && manager_device.arg_count == 2 &&
                     source_offer.opcode == 0 && source_offer.arg_count == 1 &&
                     device_selection.opcode == 1 && device_selection.arg_count == 2 &&
                     data_offer_receive.opcode == 1 && data_offer_receive.arg_count == 2 &&
                     primary_get_device.opcode == 1 && primary_get_device.arg_count == 2 &&
                     primary_selection.opcode == 0 && primary_selection.arg_count == 2 &&
                     primary_source_offer.opcode == 0 && primary_source_offer.arg_count == 1 &&
                     primary_offer_receive.opcode == 0 && primary_offer_receive.arg_count == 2 &&
                     text_manager_input.opcode == 1 && text_manager_input.arg_count == 2 &&
                     text_destroy.opcode == 0 && text_destroy.arg_count == 0 &&
                     text_enable.opcode == 1 && text_enable.arg_count == 0 &&
                     text_disable.opcode == 2 && text_disable.arg_count == 0 &&
                     text_cursor.opcode == 6 && text_cursor.arg_count == 4 &&
                     text_content_type.opcode == 5 && text_content_type.arg_count == 2 &&
                     text_commit.opcode == 7 && text_commit.arg_count == 0 &&
                     text_preedit.opcode == 2 && text_preedit.arg_count == 3 &&
                     text_commit_event.opcode == 3 && text_commit_event.arg_count == 1 &&
                     text_delete.opcode == 4 && text_delete.arg_count == 2 &&
                     text_done.opcode == 5 && text_done.arg_count == 1 &&
                     text_enter.opcode == 0 && text_enter.arg_count == 1 &&
                     text_leave.opcode == 1 && text_leave.arg_count == 1 &&
                     registry_event.opcode == 0 && registry_event.arg_count == 3 &&
                     seat_caps.opcode == 0 && seat_caps.arg_count == 1 &&
                     pointer_enter.opcode == 0 && pointer_enter.arg_count == 4 &&
                     pointer_motion.opcode == 2 && pointer_motion.arg_count == 3 &&
                     pointer_button.opcode == 3 && pointer_button.arg_count == 4 &&
                     pointer_axis.opcode == 4 && pointer_axis.arg_count == 3 &&
                     pointer_frame.opcode == 5 && pointer_frame.arg_count == 0 &&
                     axis_source.opcode == 6 && axis_source.arg_count == 1 &&
                     axis_stop.opcode == 7 && axis_stop.arg_count == 2 &&
                     axis_discrete.opcode == 8 && axis_discrete.arg_count == 2 &&
                     axis_value120.opcode == 9 && axis_value120.arg_count == 2 && axis_value120.since == 8 &&
                     keyboard_keymap.opcode == 0 && keyboard_keymap.arg_count == 3 &&
                     keyboard_key.opcode == 3 && keyboard_key.arg_count == 4 &&
                     keyboard_modifiers.opcode == 4 && keyboard_modifiers.arg_count == 5 &&
                     configure_event.opcode == 0 && configure_event.arg_count == 1 &&
                     toplevel_event.opcode == 0 && toplevel_event.arg_count == 3);
}
fn _bind(w as *Window, name as u32, iface as *u8, version as i32, id as i32) as i32 {
    let is [256]u8 as p;
    let is i32 as n with mut = 0;
    _put(&p[n], name); n = n + 4;
    let is i32 as len with mut = 1;
    while (iface[len - 1] != 0) { len = len + 1; }
    let is i32 as padded = ((len + 3) / 4) * 4;
    _put(&p[n], cast(u32, len)); n = n + 4;
    mem.memcpy(&p[n], iface, len);
    if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[n]) + len), 0, padded - len); }
    n = n + padded;
    _put(&p[n], cast(u32, version)); n = n + 4;
    _put(&p[n], cast(u32, id)); n = n + 4;
    return _send(w, w.registry, 0, &p[0], n, 0 - 1);
}

// Globals with no per-window event stream live until the shared connection
// closes. Seat and output objects remain per-window and are released there.
fn _binding(w as *Window, name as u32, iface as *u8, version as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < 32) {
        if (_bindings[i].object != 0 && _bindings[i].global == name) { return _bindings[i].object; }
        if (_bindings[i].object == 0) {
            let is i32 as id = _id(w);
            if (id == 0 || _bind(w, name, iface, version, id) == 0) { return 0; }
            _bindings[i].global = name; _bindings[i].object = id;
            return id;
        }
        i = i + 1;
    }
    w.err = NO_MEMORY;
    return 0;
}

fn _registry_global() as void {
    if (_wire_size < 20) { return; }
    let is u32 as name = _word(&_wire[8]);
    let is i32 as len = cast(i32, _word(&_wire[12]));
    if (len <= 1 || len > 128 || 16 + len > _wire_size) { return; }
    let is *u8 as text = &_wire[16];
    let is i32 as padded = ((len + 3) / 4) * 4;
    let is i32 as version_at = 16 + padded;
    if (version_at + 4 > _wire_size) { return; }
    let is i32 as version = cast(i32, _word(&_wire[version_at]));
    if (_same(text, len - 1, "wl_compositor") == 1 && _globals.compositor_global == 0) {
        _globals.compositor_global = cast(i32, name); _globals.compositor_version = version;
    }
    if (_same(text, len - 1, "wl_shm") == 1 && _globals.shm_global == 0) {
        _globals.shm_global = cast(i32, name);
    }
    if (_same(text, len - 1, "xdg_wm_base") == 1 && _globals.shell_global == 0) {
        _globals.shell_global = cast(i32, name); _globals.shell_version = version;
    }
    if (_same(text, len - 1, "wl_seat") == 1 && _globals.seat_global == 0) {
        _globals.seat_global = cast(i32, name); _globals.seat_version = version;
    }
    if (_same(text, len - 1, "zxdg_decoration_manager_v1") == 1 && _globals.decoration_global == 0) {
        _globals.decoration_global = cast(i32, name); _globals.decoration_version = version;
    }
    if (_same(text, len - 1, "xdg_wm_dialog_v1") == 1 && _globals.dialog_global == 0) {
        _globals.dialog_global = cast(i32, name); _globals.dialog_version = version;
    }
    // CAUSTIC_WAYLAND_CURSOR_SHAPE=0: the client draws the pointer itself,
    // as with a compositor without cursor-shape-v1.
    if (_same(text, len - 1, "wp_cursor_shape_manager_v1") == 1 &&
        _globals.cursor_shape_global == 0 && _cursor_shape_wanted() == 1) {
        _globals.cursor_shape_global = cast(i32, name); _globals.cursor_shape_version = version;
    }
    if (_same(text, len - 1, "wl_output") == 1 && _globals.output_count < 8) {
        let is i32 as i = _globals.output_count;
        _globals.outputs[i].global = cast(i32, name);
        _globals.outputs[i].version = version;
        _globals.output_count = _globals.output_count + 1;
    }
    if (_same(text, len - 1, "wp_viewporter") == 1 && _globals.viewporter_global == 0) {
        _globals.viewporter_global = cast(i32, name); _globals.viewporter_version = version;
    }
    if (_same(text, len - 1, "wp_fractional_scale_manager_v1") == 1 &&
        _globals.fractional_global == 0) {
        _globals.fractional_global = cast(i32, name); _globals.fractional_version = version;
    }
    if (_same(text, len - 1, "wl_data_device_manager") == 1 && _globals.data_manager_global == 0) {
        _globals.data_manager_global = cast(i32, name); _globals.data_manager_version = version;
    }
    if (_same(text, len - 1, "zwp_primary_selection_device_manager_v1") == 1 &&
        _globals.primary_manager_global == 0) {
        _globals.primary_manager_global = cast(i32, name); _globals.primary_manager_version = version;
    }
    if (_same(text, len - 1, "zwp_text_input_manager_v3") == 1 &&
        _globals.text_input_manager_global == 0) {
        _globals.text_input_manager_global = cast(i32, name);
        _globals.text_input_manager_version = version;
    }
    if (_same(text, len - 1, "wl_subcompositor") == 1 && _globals.subcompositor_global == 0) {
        _globals.subcompositor_global = cast(i32, name);
    }
    if (_same(text, len - 1, "zwp_tablet_manager_v2") == 1 && _globals.tablet_manager_global == 0) {
        _globals.tablet_manager_global = cast(i32, name);
    }
    if (_same(text, len - 1, "zwp_pointer_gestures_v1") == 1 && _globals.gestures_global == 0) {
        _globals.gestures_global = cast(i32, name); _globals.gestures_version = version;
    }
    if (_same(text, len - 1, "xdg_activation_v1") == 1 && _globals.activation_global == 0) {
        _globals.activation_global = cast(i32, name);
    }
    if (_same(text, len - 1, "zxdg_exporter_v2") == 1 && _globals.exporter_global == 0) {
        _globals.exporter_global = cast(i32, name);
    }
    if (_same(text, len - 1, "xdg_toplevel_icon_manager_v1") == 1 && _globals.icon_global == 0) {
        _globals.icon_global = cast(i32, name);
    }
    if (_same(text, len - 1, "wp_presentation") == 1 && _globals.presentation_global == 0) {
        _globals.presentation_global = cast(i32, name);
    }
    if (_same(text, len - 1, "wp_single_pixel_buffer_manager_v1") == 1 && _globals.single_pixel_global == 0) {
        _globals.single_pixel_global = cast(i32, name);
    }
    if (_same(text, len - 1, "xdg_system_bell_v1") == 1 && _globals.bell_global == 0) {
        _globals.bell_global = cast(i32, name);
    }
    if (_same(text, len - 1, "xdg_toplevel_drag_manager_v1") == 1 && _globals.toplevel_drag_global == 0) {
        _globals.toplevel_drag_global = cast(i32, name);
    }
}

fn _scale_up(value as i64, factor as i32) as i64 {
    return (value * factor + 119) / 120;
}

fn _scale_down(value as i64, factor as i32) as i64 {
    if (factor <= 0) { return 0; }
    return value * 120 / factor;
}

fn _set_scale120(w as *Window, preferred as i32, buffer_scale as i32) as void {
    let is i32 as factor with mut = preferred;
    let is i32 as buffer with mut = buffer_scale;
    if (factor < 120) { factor = 120; }
    if (factor > 1920) { factor = 1920; }
    if (w.fractional_active == 1) { buffer = 1; }
    let is i32 as changed = cast(i32, factor != w.scale120);
    let is i32 as buffer_changed = cast(i32, buffer != w.scale);
    w.scale120 = factor;
    w.scale = buffer;
    if (buffer_changed == 1 && w.surface != 0) {
        let is [4]u8 as p;
        _put(&p[0], cast(u32, buffer));
        _send(w, w.surface, 8, &p[0], 4, 0 - 1);
    }
    if (changed == 0 || w.logical_width <= 0 || w.logical_height <= 0) { return; }
    w.width = _scale_up(w.logical_width, factor);
    w.height = _scale_up(w.logical_height, factor);
    w.resized = 1;
    let is event.Event as e;
    event.clear(&e); e.kind = event.RESIZE; e.width = w.width; e.height = w.height;
    _queue(w, &e);
    event.clear(&e); e.kind = event.SETTINGS;
    _queue(w, &e);
}

// The integer scale of the output the window is on — unless the compositor
// says a fractional one for the surface (wp_fractional_scale), which is the
// one its buffer is drawn at, whichever of the two arrives first.
fn _set_scale(w as *Window, scale as i32) as void {
    if (w.fractional_active == 1) { return; }
    let is i32 as factor with mut = scale;
    if (factor < 1) { factor = 1; }
    if (factor > 16) { factor = 16; }
    _set_scale120(w, factor * 120, factor);
}
fn _surface_output(w as *Window, object as i32, entering as i32) as void {
    let is i32 as i with mut = 0;
    while (i < w.output_count) {
        if (w.outputs[i].object == object) {
            w.outputs[i].entered = entering;
            if (entering == 1) {
                w.active_output = i;
                _set_scale(w, w.outputs[i].scale);
            } else if (w.active_output == i) {
                w.active_output = 0 - 1;
                let is i32 as other with mut = 0;
                while (other < w.output_count && w.active_output < 0) {
                    if (w.outputs[other].entered == 1) { w.active_output = other; }
                    other = other + 1;
                }
                if (w.active_output >= 0) { _set_scale(w, w.outputs[w.active_output].scale); }
                else { _set_scale(w, 1); }
            }
            return;
        }
        i = i + 1;
    }
}

// What a wl_output says of itself: its place (geometry), its current mode,
// its scale, its name.
fn _output_event(w as *Window, obj as i32, op as i32, p as *u8) as void {
    let is i32 as i with mut = 0;
    while (i < w.output_count && w.outputs[i].object != obj) { i = i + 1; }
    if (i == w.output_count) { return; }
    let is *Output as o = &w.outputs[i];
    if (op == 0 && _wire_size >= 16) {
        o.x = cast(i32, _word(p));
        o.y = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
        return;
    }
    if (op == 1 && _wire_size >= 24) {
        if ((_word(p) & cast(u32, 1)) != cast(u32, 0)) {
            o.mode_width = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
            o.mode_height = cast(i32, _word(cast(*u8, cast(i64, p) + 8)));
            o.refresh_mhz = cast(i32, _word(cast(*u8, cast(i64, p) + 12)));
        }
        return;
    }
    if (op == 3 && _wire_size >= 12) {
        let is i32 as scale = cast(i32, _word(p));
        if (scale < 1) { return; }
        o.scale = scale;
        if (w.active_output == i) { _set_scale(w, scale); }
        return;
    }
    if (op == 4 && _wire_size >= 12) {
        let is i32 as len = cast(i32, _word(p));
        let is i32 as padded = ((len + 3) / 4) * 4;
        if (len < 1 || 12 + padded > _wire_size) { return; }
        let is *u8 as s = cast(*u8, cast(i64, p) + 4);
        let is i32 as k with mut = 0;
        while (k < len - 1 && k < 31) {
            o.name[k] = s[k];
            k = k + 1;
        }
        o.name[k] = cast(u8, 0);
    }
}
// --- Selections and drag and drop ---
//
// The compositor's offers (wl_data_offer, the primary selection's) say their
// MIME types; ours (DataSource) carry a transfer.Offer, copied. Data moves
// through descriptors: a Reader reads an offer's into its bytes — PASTE for
// the clipboard or the primary selection asked for, DROP for a drop — and a
// Writer writes ours to whoever asked; both without blocking, from the pump,
// so that a transfer this program makes to itself (a drag onto its own
// window) cannot wait on itself.

let is i32 as PASTE with imut = 0;
let is i32 as DROP  with imut = 1;
let is i32 as MAX_WRITERS with imut = 8;
let is i64 as TRANSFER_TIMEOUT_MS with imut = 10000;

// A source's purpose.
let is i32 as _FOR_CLIPBOARD with imut = 0;
let is i32 as _FOR_PRIMARY   with imut = 1;
let is i32 as _FOR_DRAG      with imut = 2;

// A paste's state.
let is i32 as _PASTE_IDLE    with imut = 0;
let is i32 as _PASTE_PENDING with imut = 1;
let is i32 as _PASTE_READY   with imut = 2;

fn _offer_index(w as *Window, object as i32, primary as i32, create as i32) as i32 {
    let is i32 as free_slot with mut = 0 - 1;
    let is i32 as i with mut = 0;
    while (i < MAX_DATA) {
        if (w.offers[i].object == object && object != 0) { return i; }
        if (w.offers[i].object == 0 && free_slot < 0) { free_slot = i; }
        i = i + 1;
    }
    if (create == 0 || free_slot < 0) { return 0 - 1; }
    mem.memzero(cast(*u8, &w.offers[free_slot]), sizeof(DataOffer));
    w.offers[free_slot].object = object;
    w.offers[free_slot].primary = primary;
    w.offers[free_slot].text_rank = 9;
    return free_slot;
}

fn _offer_release(w as *Window, index as i32, destroy as i32) as void {
    let is i32 as object = w.offers[index].object;
    if (object == 0) { return; }
    if (destroy == 1) {
        let is [0]u8 as empty;
        let is i32 as opcode with mut = 2;
        if (w.offers[index].primary == 1) { opcode = 1; }
        _send(w, object, opcode, &empty[0], 0, 0 - 1);
    }
    if (w.selection_offer[0] == object) { w.selection_offer[0] = 0; }
    if (w.selection_offer[1] == object) { w.selection_offer[1] = 0; }
    if (w.drop_offer == object) { w.drop_offer = 0; }
    mem.memzero(cast(*u8, &w.offers[index]), sizeof(DataOffer));
}

fn _source_index(w as *Window, object as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < MAX_DATA) {
        if (w.sources[i].object == object && object != 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn _source_slot(w as *Window) as i32 {
    let is i32 as i with mut = 0;
    while (i < MAX_DATA) {
        if (w.sources[i].object == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// An offer's event: a MIME type it has (0), on the data device's the actions
// its source allows (1) and the one the compositor chose (2).
fn _data_offer_event(w as *Window, object as i32, op as i32, p as *u8) as void {
    let is i32 as index = _offer_index(w, object, 0, 0);
    if (index < 0) { return; }
    let is *DataOffer as o = &w.offers[index];
    if (op == 0) {
        if (_wire_size < 16) { return; }
        let is i32 as len = cast(i32, _word(p));
        let is i32 as padded = ((len + 3) / 4) * 4;
        if (len <= 1 || len > 256 || 12 + padded > _wire_size) { return; }
        let is *u8 as mime = cast(*u8, cast(i64, p) + 4);
        let is i32 as f = transfer.format_of(mime, cast(i64, len - 1));
        o.formats = o.formats | f;
        if (f == transfer.TEXT) {
            let is i32 as rank = transfer.text_rank(mime, cast(i64, len - 1));
            if (rank < o.text_rank) { o.text_rank = rank; }
        }
        return;
    }
    if (o.primary == 1 || _wire_size < 12) { return; }
    if (op == 1) { o.source_actions = cast(i32, _word(p)) & (transfer.COPY | transfer.MOVE); return; }
    if (op == 2) { o.action = cast(i32, _word(p)) & (transfer.COPY | transfer.MOVE); return; }
}

// The MIME type an offer is asked for format by: the best text type it has.
fn _offer_mime(o as *DataOffer, format as i32) as *u8 {
    if (format == transfer.FILES) { return transfer.MIME_URIS; }
    if (format == transfer.PNG) { return transfer.MIME_PNG; }
    if (o.text_rank == 0) { return transfer.MIME_UTF8; }
    if (o.text_rank == 1) { return "UTF8_STRING"; }
    return "text/plain";
}

// --- Readers ---

// Offer index's data as format read into slot from now on, through a
// descriptor the source writes: 1 when asked.
fn _read_start(w as *Window, slot as i32, index as i32, format as i32) as i32 {
    let is *Reader as r = &w.reading[slot];
    _read_cancel(w, slot);
    let is *DataOffer as o = &w.offers[index];
    let is [2]i32 as fds;
    if (sys.socketpair(sys.AF_UNIX, sys.SOCK_STREAM | sys.SOCK_CLOEXEC, 0, &fds[0]) < 0) { return 0; }
    if (linux.fcntl(fds[0], 4, 2048) < 0) { linux.close(fds[0]); linux.close(fds[1]); return 0; }
    let is i32 as opcode with mut = 1;
    if (o.primary == 1) { opcode = 0; }
    if (_send_string_fd(w, o.object, opcode, _offer_mime(o, format), fds[1]) == 0) {
        linux.close(fds[0]); linux.close(fds[1]);
        return 0;
    }
    linux.close(fds[1]);
    r.fd = fds[0];
    r.offer = o.object;
    r.format = format;
    r.failed = 0;
    r.last_ms = time.now_ms();
    transfer.bytes_clear(&r.data);
    return 1;
}

fn _read_cancel(w as *Window, slot as i32) as void {
    let is *Reader as r = &w.reading[slot];
    if (r.fd >= 0) { linux.close(r.fd); }
    r.fd = 0 - 1;
    r.offer = 0;
}

// What can be read of slot now: 1 when its source has said all (or failed,
// or gone quiet past the time), 0 while more may come.
fn _read_some(w as *Window, slot as i32) as i32 {
    let is *Reader as r = &w.reading[slot];
    if (r.fd < 0) { return 0; }
    let is [65536]u8 as chunk;
    while (1 == 1) {
        let is i64 as n = linux.read(r.fd, &chunk[0], 65536);
        if (n > 0) {
            r.last_ms = time.now_ms();
            if (transfer.append(&r.data, &chunk[0], n) == 0) { r.failed = 1; _read_cancel(w, slot); return 1; }
            continue;
        }
        if (n == 0) { _read_cancel(w, slot); return 1; }
        if (n == 0 - sys.EINTR) { continue; }
        if (n == 0 - 11) {   // EAGAIN: not yet
            if (time.now_ms() - r.last_ms > TRANSFER_TIMEOUT_MS) { r.failed = 1; _read_cancel(w, slot); return 1; }
            return 0;
        }
        r.failed = 1;
        _read_cancel(w, slot);
        return 1;
    }
    return 0;
}

// Both readers advanced: a paste made ready, a drop finished.
fn _readers(w as *Window) as void {
    let is i32 as offer = w.reading[PASTE].offer;
    if (w.reading[PASTE].fd >= 0 && _read_some(w, PASTE) == 1) {
        w.paste_state = _PASTE_READY;
        w.paste_got = w.reading[PASTE].format;
        if (w.reading[PASTE].failed == 1) { w.paste_got = 0; transfer.bytes_clear(&w.reading[PASTE].data); }
        w.frame_ready = 1;
        // An offer replaced while it was read: let go now.
        if (offer != w.selection_offer[0] && offer != w.selection_offer[1]) {
            let is i32 as index = _offer_index(w, offer, 0, 0);
            if (index >= 0) { _offer_release(w, index, 1); }
        }
    }
    if (w.reading[DROP].fd >= 0 && _read_some(w, DROP) == 1) { _drop_finish(w); }
}

// --- Writers ---

// bytes written to fd from now on (a copy: what is offered may change
// meanwhile), the descriptor closed when all is written or the reader went.
fn _write_start(w as *Window, fd as i64, bytes as *transfer.Bytes) as void {
    let is i32 as k with mut = 0;
    while (k < MAX_WRITERS && w.writing[k].fd >= 0) { k = k + 1; }
    if (k == MAX_WRITERS || linux.fcntl(fd, 4, 2048) < 0 || transfer.bytes_set(&w.writing[k].data, bytes.data, bytes.len) == 0) {
        linux.close(fd);
        return;
    }
    w.writing[k].fd = fd;
    w.writing[k].sent = 0;
    w.writing[k].last_ms = time.now_ms();
    _write_some(w, k);
}

fn _write_end(w as *Window, k as i32) as void {
    if (w.writing[k].fd >= 0) { linux.close(w.writing[k].fd); }
    w.writing[k].fd = 0 - 1;
    transfer.bytes_free(&w.writing[k].data);
}

fn _write_some(w as *Window, k as i32) as void {
    let is *Writer as wr = &w.writing[k];
    while (wr.fd >= 0) {
        if (wr.sent >= wr.data.len) { _write_end(w, k); return; }
        let is i64 as n = linux.write(wr.fd, cast(*u8, cast(i64, wr.data.data) + wr.sent), wr.data.len - wr.sent);
        if (n > 0) { wr.sent = wr.sent + n; wr.last_ms = time.now_ms(); continue; }
        if (n == 0 - sys.EINTR) { continue; }
        if (n == 0 - 11 && time.now_ms() - wr.last_ms <= TRANSFER_TIMEOUT_MS) { return; }
        // The reader went (EPIPE), or stopped reading for good.
        _write_end(w, k);
    }
}

fn _writers(w as *Window) as void {
    let is i32 as k with mut = 0;
    while (k < MAX_WRITERS) {
        if (w.writing[k].fd >= 0) { _write_some(w, k); }
        k = k + 1;
    }
}

// Whether a transfer is under way: the pump is then to come back soon.
fn _transferring(w as *Window) as i32 {
    if (w.reading[PASTE].fd >= 0 || w.reading[DROP].fd >= 0) { return 1; }
    let is i32 as k with mut = 0;
    while (k < MAX_WRITERS) {
        if (w.writing[k].fd >= 0) { return 1; }
        k = k + 1;
    }
    return 0;
}

// --- Dropped on ---

// What the program takes where the pointer is, told the offer: the MIME type
// it would read (none: refused) and, with version 3, the actions it would
// do and the one it prefers.
fn _drop_accept(w as *Window) as void {
    if (w.drop_offer == 0) { return; }
    let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
    if (index < 0) { return; }
    let is *DataOffer as o = &w.offers[index];
    let is i32 as takes = w.drop_answer & w.drop_offered;
    let is *u8 as mime with mut = cast(*u8, 0);
    if ((takes & transfer.FILES) != 0) { mime = transfer.MIME_URIS; }
    else if ((takes & transfer.TEXT) != 0) { mime = _offer_mime(o, transfer.TEXT); }
    let is [256]u8 as p;
    _put(&p[0], w.drop_serial);
    let is i32 as n with mut = 8;
    if (cast(i64, mime) != 0) {
        let is i32 as len with mut = 1;
        while (mime[len - 1] != 0) { len = len + 1; }
        let is i32 as padded = ((len + 3) / 4) * 4;
        _put(&p[4], cast(u32, len));
        mem.memcpy(&p[8], mime, len);
        if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[8]) + len), 0, padded - len); }
        n = 8 + padded;
    } else { _put(&p[4], 0); }
    _send(w, w.drop_offer, 0, &p[0], n, 0 - 1);
    if (_bounded(_globals.data_manager_version, 3) >= 3) {
        let is i32 as actions with mut = transfer.COPY | transfer.MOVE;
        if (w.drop_want_action != 0) { actions = w.drop_want_action; }
        if (cast(i64, mime) == 0) { actions = 0; }
        let is i32 as preferred with mut = w.drop_want_action;
        if (preferred == 0) { preferred = transfer.COPY; }
        if ((actions & preferred) == 0) { preferred = actions & transfer.MOVE; }
        let is [8]u8 as a;
        _put(&a[0], cast(u32, actions)); _put(&a[4], cast(u32, preferred));
        _send(w, w.drop_offer, 4, &a[0], 8, 0 - 1);
    }
}

// The drop's data came: read as files or text, the offer finished, the
// program told DND_DROP with the action the compositor chose — or DND_LEAVE
// when nothing came.
fn _drop_finish(w as *Window) as void {
    if (w.drop_pending == 0) { return; }
    w.drop_pending = 0;
    let is *Reader as r = &w.reading[DROP];
    w.drop_count = 0;
    transfer.bytes_clear(&w.drop_text);
    transfer.bytes_clear(&w.drop_paths);
    if (r.failed == 0) {
        if (w.drop_kind == transfer.FILES) {
            w.drop_count = transfer.parse_uri_list(r.data.data, r.data.len, &w.drop_paths);
            if (w.drop_count > 0) { w.drop_ready = 1; }
        } else if (transfer.bytes_set(&w.drop_text, r.data.data, r.data.len) == 1) {
            w.drop_ready = 1;
        }
    }
    transfer.bytes_clear(&r.data);
    let is i32 as action with mut = transfer.COPY;
    let is i32 as offer = w.drop_offer;
    if (offer != 0) {
        let is i32 as index = _offer_index(w, offer, 0, 0);
        if (index >= 0 && w.offers[index].action != 0) { action = w.offers[index].action; }
        let is [0]u8 as empty;
        if (w.drop_ready == 1 && _bounded(_globals.data_manager_version, 3) >= 3) { _send(w, offer, 3, &empty[0], 0, 0 - 1); }
        if (index >= 0) { _offer_release(w, index, 1); }
    }
    w.drop_offer = 0; w.drop_offered = 0; w.drop_answer = 0;
    let is event.Event as e;
    event.clear(&e);
    e.x = w.drop_x; e.y = w.drop_y;
    if (w.drop_ready == 1) { e.kind = event.DND_DROP; e.drop = w.drop_kind; e.action = action; }
    else { e.kind = event.DND_LEAVE; }
    w.frame_ready = 1;
    _queue(w, &e);
}

fn _drop_reject(w as *Window) as void {
    w.drop_answer = 0;
    _drop_accept(w);
    if (w.drop_offer != 0) {
        let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
        if (index >= 0) { _offer_release(w, index, 1); }
    }
    w.drop_offer = 0; w.drop_offered = 0; w.drop_answer = 0; w.drop_pending = 0;
    let is event.Event as e;
    event.clear(&e); e.kind = event.DND_LEAVE; e.x = w.drop_x; e.y = w.drop_y;
    _queue(w, &e);
}

// Dropped: what is taken read — files when they are.
fn _drop_start(w as *Window) as void {
    let is i32 as takes = w.drop_answer & w.drop_offered;
    let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
    if (takes == 0 || index < 0) { _drop_reject(w); return; }
    let is i32 as kind with mut = transfer.TEXT;
    if ((takes & transfer.FILES) != 0) { kind = transfer.FILES; }
    if (_read_start(w, DROP, index, kind) == 0) { _drop_reject(w); return; }
    w.drop_ready = 0; w.drop_count = 0;
    w.drop_kind = kind;
    w.drop_pending = 1;
}

fn _data_device_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0) {
        _offer_index(w, cast(i32, _word(p)), 0, 1);
        return;
    }
    if (op == 1 && _wire_size >= 28) {
        let is i32 as surface = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
        if (surface != w.surface) { return; }
        if (w.drop_offer != 0 && w.drop_pending == 0) { _drop_reject(w); }
        w.drop_serial = _word(p); w.input_serial = w.drop_serial;
        w.drop_x = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        w.drop_y = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 12))) / 256), w.scale120);
        w.drop_offer = cast(i32, _word(cast(*u8, cast(i64, p) + 16)));
        w.drop_offered = 0; w.drop_answer = 0; w.drop_want_action = 0; w.drop_actions = 0;
        let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
        if (index >= 0) {
            w.drop_offered = w.offers[index].formats & (transfer.FILES | transfer.TEXT);
            w.drop_actions = w.offers[index].source_actions;
            if (w.drop_actions == 0) { w.drop_actions = transfer.COPY; }
            w.drop_answer = w.drop_offered;
            _drop_accept(w);
        }
        let is event.Event as e;
        event.clear(&e); e.kind = event.DND_ENTER; e.drop = w.drop_offered; e.action = w.drop_actions;
        e.x = w.drop_x; e.y = w.drop_y;
        _queue(w, &e);
        return;
    }
    if (op == 2) {
        if (w.drop_pending == 1) { return; }
        let is i64 as x = w.drop_x; let is i64 as y = w.drop_y;
        if (w.drop_offer != 0) {
            let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
            if (index >= 0) { _offer_release(w, index, 1); }
        }
        w.drop_offer = 0; w.drop_offered = 0; w.drop_answer = 0;
        let is event.Event as e;
        event.clear(&e); e.kind = event.DND_LEAVE; e.x = x; e.y = y;
        _queue(w, &e);
        return;
    }
    if (op == 3 && _wire_size >= 20) {
        w.drop_x = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 4))) / 256), w.scale120);
        w.drop_y = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        if (w.drop_offer != 0 && w.drop_pending == 0) {
            let is i32 as index = _offer_index(w, w.drop_offer, 0, 0);
            if (index >= 0 && w.offers[index].source_actions != 0) { w.drop_actions = w.offers[index].source_actions; }
            let is event.Event as e;
            event.clear(&e); e.kind = event.DND_MOVE; e.x = w.drop_x; e.y = w.drop_y; e.action = w.drop_actions;
            _queue(w, &e);
        }
        return;
    }
    if (op == 4) { _drop_start(w); return; }
    if (op == 5) { _selection_offer(w, 0, cast(i32, _word(p))); }
}

fn _primary_device_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0) {
        _offer_index(w, cast(i32, _word(p)), 1, 1);
        return;
    }
    if (op == 1) { _selection_offer(w, 1, cast(i32, _word(p))); }
}

// A selection now offered as next (0: none): the one before let go, unless
// it is still being read.
fn _selection_offer(w as *Window, which as i32, next as i32) as void {
    let is i32 as previous = w.selection_offer[which];
    w.selection_offer[which] = next;
    if (previous != 0 && previous != next && previous != w.reading[PASTE].offer) {
        let is i32 as index = _offer_index(w, previous, which, 0);
        if (index >= 0) { _offer_release(w, index, 1); }
    }
}

// --- Ours: sources ---

fn _source_release(w as *Window, index as i32, destroy as i32) as void {
    let is *DataSource as s = &w.sources[index];
    if (destroy == 1 && s.object != 0) {
        let is [0]u8 as empty;
        _send(w, s.object, 1, &empty[0], 0, 0 - 1);
    }
    transfer.offer_free(&s.offer);
    if (w.selection_source[0] == s.object) { w.selection_source[0] = 0; }
    if (w.selection_source[1] == s.object) { w.selection_source[1] = 0; }
    if (w.drag_source == s.object) { w.drag_source = 0; }
    if (s.object >= 2 && s.object < MAX_OBJECTS) { _objects[s.object].owner = cast(*Window, 0); }
    mem.memzero(cast(*u8, s), sizeof(DataSource));
}

// A source of what o offers (copied), for purpose, its MIME types told: its
// index, -1 when it could not be made.
fn _source_new(w as *Window, purpose as i32, o as *transfer.Offer) as i32 {
    let is i32 as manager with mut = w.data_manager;
    if (purpose == _FOR_PRIMARY) { manager = w.primary_manager; }
    if (manager == 0 || o.formats == 0) { return 0 - 1; }
    let is i32 as index = _source_slot(w);
    if (index < 0) { return 0 - 1; }
    let is *DataSource as s = &w.sources[index];
    mem.memzero(cast(*u8, s), sizeof(DataSource));
    transfer.offer_init(&s.offer);
    if (((o.formats & transfer.TEXT) != 0 && transfer.offer_text(&s.offer, o.text.data, o.text.len) == 0) ||
        ((o.formats & transfer.PNG) != 0 && transfer.offer_png(&s.offer, o.png.data, o.png.len) == 0) ||
        ((o.formats & transfer.FILES) != 0 && transfer.offer_files(&s.offer, o.paths.data, o.count) == 0)) {
        transfer.offer_free(&s.offer);
        return 0 - 1;
    }
    let is i32 as object = _id(w);
    if (object == 0) { transfer.offer_free(&s.offer); return 0 - 1; }
    // The event that carries a descriptor: send, 1 on wl_data_source, 0 on
    // the primary selection's source.
    _objects[object].fd_opcode = 1;
    if (purpose == _FOR_PRIMARY) { _objects[object].fd_opcode = 0; }
    s.object = object;
    s.purpose = purpose;
    let is [4]u8 as idp;
    _put(&idp[0], cast(u32, object));
    let is i32 as ok with mut = _send(w, manager, 0, &idp[0], 4, 0 - 1);
    if (ok == 1 && (o.formats & transfer.FILES) != 0) { ok = _send_string(w, object, 0, transfer.MIME_URIS); }
    if (ok == 1 && (o.formats & transfer.TEXT) != 0) {
        ok = _send_string(w, object, 0, transfer.MIME_UTF8);
        if (ok == 1) { ok = _send_string(w, object, 0, "UTF8_STRING"); }
        if (ok == 1) { ok = _send_string(w, object, 0, "text/plain"); }
    }
    if (ok == 1 && (o.formats & transfer.PNG) != 0) { ok = _send_string(w, object, 0, transfer.MIME_PNG); }
    if (ok == 0) { _source_release(w, index, 1); return 0 - 1; }
    return index;
}

// One of our sources' events: wl_data_source's target (0), send (1),
// cancelled (2), dnd_drop_performed (3), dnd_finished (4), action (5); the
// primary selection source's send (0), cancelled (1).
fn _source_event(w as *Window, object as i32, op as i32, p as *u8) as void {
    let is i32 as index = _source_index(w, object);
    if (index < 0) { return; }
    let is *DataSource as s = &w.sources[index];
    let is i32 as primary = cast(i32, s.purpose == _FOR_PRIMARY);
    if ((primary == 0 && op == 1) || (primary == 1 && op == 0)) {
        let is i64 as fd = _take_recv_fd();
        if (fd < 0) { return; }
        let is i32 as len = cast(i32, _word(p));
        let is i32 as f with mut = 0;
        if (len > 1 && len <= 256 && _wire_size >= 12 + len) { f = transfer.format_of(cast(*u8, cast(i64, p) + 4), cast(i64, len - 1)); }
        if (f == 0 || (s.offer.formats & f) == 0) { linux.close(fd); return; }
        _write_start(w, fd, transfer.offer_bytes(&s.offer, f));
        return;
    }
    if ((primary == 0 && op == 2) || (primary == 1 && op == 1)) {
        // Cancelled: a selection another took; a drag refused or cancelled.
        if (s.purpose == _FOR_DRAG) { _drag_done(w, 0); }
        _source_release(w, index, 1);
        return;
    }
    if (primary == 1) { return; }
    if (op == 3) { s.dropped = 1; return; }
    if (op == 4) {
        let is i32 as done with mut = s.action;
        if (done == 0) { done = transfer.COPY; }
        _drag_done(w, done);
        _source_release(w, index, 1);
        return;
    }
    if (op == 5 && _wire_size >= 12) { s.action = cast(i32, _word(p)) & (transfer.COPY | transfer.MOVE); }
}

fn _drag_done(w as *Window, action as i32) as void {
    // A toplevel carried by the drag: let go of, where the drag left it.
    if (w.toplevel_drag != 0) { _send(w, w.toplevel_drag, 0, cast(*u8, 0), 0, 0 - 1); w.toplevel_drag = 0; }
    let is event.Event as e;
    event.clear(&e); e.kind = event.DRAG_DONE; e.action = action;
    w.frame_ready = 1;
    _queue(w, &e);
}

// A string argument of a text-input event at p into dst (IME_TEXT bytes):
// the bytes it takes on the wire, its length in *out_len — 0 for null — or
// -1 for one malformed: longer than the message, not ended by its NUL, not
// UTF-8. A method's text is never cut.
fn _ime_string(p as *u8, dst as *u8, out_len as *i64) as i64 {
    if (_wire_size < 12) { return 0 - 1; }
    let is u32 as wire_len = _word(p);
    if (wire_len == cast(u32, 0)) { *out_len = 0; return 4; }
    if (wire_len > cast(u32, IME_TEXT)) { return 0 - 1; }
    let is i32 as padded = cast(i32, (wire_len + 3) & 0xfffffffc);
    if (12 + padded > _wire_size) { return 0 - 1; }
    let is i64 as len = cast(i64, wire_len) - 1;
    let is *u8 as src = cast(*u8, cast(i64, p) + 4);
    if (src[len] != 0 || utf8.validate(src, len) != 0) { return 0 - 1; }
    if (len > 0) { mem.memcpy(dst, src, len); }
    dst[len] = 0;
    *out_len = len;
    return 4 + padded;
}

// A byte offset into a composition of n bytes, as the method said it: -1
// for none, past the end the end, inside a character that character's start.
fn _ime_offset(s as *u8, n as i64, at as i64) as i64 {
    if (at < 0) { return 0 - 1; }
    let is i64 as o with mut = at;
    if (o > n) { o = n; }
    while (o > 0 && o < n && (cast(i64, s[o]) & 192) == 128) { o = o - 1; }
    return o;
}

// What enter..done said and done has not applied, forgotten.
fn _ime_pending_clear(w as *Window) as void {
    w.ime_delete_changed = 0; w.ime_commit_changed = 0; w.ime_preedit_changed = 0;
    w.ime_delete_before = 0; w.ime_delete_after = 0;
    w.ime_commit_len = 0; w.ime_preedit_len = 0; w.ime_cursor = 0; w.ime_cursor_end = 0;
}

// The composition said gone, once, if one was said.
fn _ime_unshow(w as *Window) as void {
    if (w.ime_shown == 0) { return; }
    w.ime_shown = 0;
    let is ie.Event as e = _input(w, ie.PREEDIT);
    e.cursor = 0;
    _push(w, &e, cast(*u8, 0), 0);
}

fn _text_input_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0 && _wire_size >= 12) {
        if (cast(i32, _word(p)) != w.surface) { return; }
        w.text_input_entered = 1;
        // What was told before is forgotten across leave: told again.
        if (w.text_input_enabled == 1) { _ti_enable(w); }
        return;
    }
    if (op == 1 && _wire_size >= 12) {
        if (cast(i32, _word(p)) != w.surface || w.text_input_entered == 0) { return; }
        w.text_input_entered = 0;
        _ime_pending_clear(w);
        _ime_unshow(w);
        return;
    }
    if (op == 2) {
        let is i64 as used = _ime_string(p, &w.ime_preedit[0], &w.ime_preedit_len);
        if (used < 0 || 8 + used + 8 > _wire_size) {
            w.ime_preedit_len = 0;
            return;
        }
        let is i64 as n = w.ime_preedit_len;
        let is i64 as begin = cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + used))));
        let is i64 as end = cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + used + 4))));
        // The caret at begin, begin to end the part being converted, both
        // byte offsets into the text; -1 hides the caret, so it goes at the end.
        w.ime_cursor = _ime_offset(&w.ime_preedit[0], n, begin);
        w.ime_cursor_end = _ime_offset(&w.ime_preedit[0], n, end);
        if (w.ime_cursor < 0 || w.ime_cursor_end < 0) {
            w.ime_cursor = n;
            w.ime_cursor_end = n;
        }
        if (w.ime_cursor_end < w.ime_cursor) { w.ime_cursor_end = w.ime_cursor; }
        w.ime_preedit_changed = 1;
        return;
    }
    if (op == 3) {
        if (_ime_string(p, &w.ime_commit[0], &w.ime_commit_len) >= 0) { w.ime_commit_changed = 1; }
        return;
    }
    if (op == 4 && _wire_size >= 16) {
        w.ime_delete_before = cast(i64, _word(p));
        w.ime_delete_after = cast(i64, _word(cast(*u8, cast(i64, p) + 4)));
        w.ime_delete_changed = 1;
        return;
    }
    if (op != 5 || _wire_size < 12) { return; }
    // done: applied in the protocol's order — the composition out, the text
    // around deleted, the commit in, the new composition at the caret. A
    // composition not sent again is gone.
    let is u32 as serial = _word(p);
    let is i32 as by_method = cast(i32, w.ime_delete_changed == 1 || w.ime_commit_changed == 1);
    if (w.ime_delete_changed == 1 && (w.ime_delete_before > 0 || w.ime_delete_after > 0)) {
        let is ie.Event as e = _input(w, ie.DELETE_SURROUNDING);
        e.delete_before = w.ime_delete_before; e.delete_after = w.ime_delete_after;
        _push(w, &e, cast(*u8, 0), 0);
    }
    if (w.ime_commit_changed == 1 && w.ime_commit_len > 0) {
        let is ie.Event as e = _input(w, ie.TEXT);
        _push(w, &e, &w.ime_commit[0], w.ime_commit_len);
    }
    if (w.ime_preedit_changed == 1 && w.ime_preedit_len > 0) {
        let is ie.Event as e = _input(w, ie.PREEDIT);
        e.cursor = w.ime_cursor;
        if (w.ime_cursor_end > w.ime_cursor) {
            e.hl_start = w.ime_cursor;
            e.hl_end = w.ime_cursor_end;
        }
        _push(w, &e, &w.ime_preedit[0], w.ime_preedit_len);
        w.ime_shown = 1;
    } else {
        _ime_unshow(w);
    }
    _ime_pending_clear(w);
    // A done that had not seen every commit: the method worked on older
    // text, and nothing more is told until a done that has. One that had:
    // what waited is told now.
    w.ti_hold = cast(i32, serial != w.ti_commits);
    _ti_flush(w);
    if (by_method == 1) { w.ti_by_method = 1; }
}

// --- What the method is told: text-input-v3's requests ---
//
// 1 enable, 2 disable, 3 set_surrounding_text, 4 set_text_change_cause,
// 5 set_content_type, 6 set_cursor_rectangle, 7 commit. All but enable and
// disable are double-buffered state, applied on commit; enable resets it,
// and nothing sent between leave and enter counts.
let is i32 as TI_TEXT with imut = 1;
let is i32 as TI_TYPE with imut = 2;
let is i32 as TI_RECT with imut = 4;

fn _ti_commit(w as *Window) as i32 {
    if (_send(w, w.text_input, 7, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    w.ti_commits = w.ti_commits + cast(u32, 1);
    return 1;
}

// The parts what says sent, uncommitted.
fn _ti_state(w as *Window, what as i32) as i32 {
    if ((what & TI_TEXT) != 0 && w.ti_text_len >= 0) {
        let is [4016]u8 as s;
        let is i64 as n = w.ti_text_len;
        let is i64 as padded = ((n + 1 + 3) / 4) * 4;
        mem.memset(&s[0], 0, 4 + padded + 8);
        _put(&s[0], cast(u32, n + 1));
        if (n > 0) { mem.memcpy(&s[4], &w.ti_text[0], n); }
        _put(cast(*u8, cast(i64, &s[0]) + 4 + padded), cast(u32, w.ti_caret));
        _put(cast(*u8, cast(i64, &s[0]) + 8 + padded), cast(u32, w.ti_anchor));
        if (_send(w, w.text_input, 3, &s[0], cast(i32, 12 + padded), 0 - 1) == 0) { return 0; }
        // input_method 0, other 1.
        let is [4]u8 as cause;
        _put(&cause[0], cast(u32, 1 - w.ti_by_method));
        if (_send(w, w.text_input, 4, &cause[0], 4, 0 - 1) == 0) { return 0; }
        w.ti_by_method = 0;
    }
    if ((what & TI_TYPE) != 0) {
        let is [8]u8 as ct;
        _put(&ct[0], cast(u32, w.ti_hints));
        _put(&ct[4], cast(u32, w.ti_purpose));
        if (_send(w, w.text_input, 5, &ct[0], 8, 0 - 1) == 0) { return 0; }
    }
    if ((what & TI_RECT) != 0 && w.ime_rect_w >= 0) {
        let is [16]u8 as r;
        _put(&r[0], cast(u32, _scale_down(w.ime_rect_x, w.scale120)));
        _put(&r[4], cast(u32, _scale_down(w.ime_rect_y, w.scale120)));
        _put(&r[8], cast(u32, _scale_down(w.ime_rect_w, w.scale120)));
        _put(&r[12], cast(u32, _scale_down(w.ime_rect_h, w.scale120)));
        if (_send(w, w.text_input, 6, &r[0], 16, 0 - 1) == 0) { return 0; }
    }
    return 1;
}

// What changed told and committed — with the text-input focus, the program
// wanting it, and no done behind; otherwise kept for then.
fn _ti_flush(w as *Window) as i32 {
    if (w.text_input_entered == 0 || w.text_input_enabled == 0 || w.ti_hold == 1 || w.ti_dirty == 0) { return 1; }
    let is i32 as what = w.ti_dirty;
    w.ti_dirty = 0;
    if (_ti_state(w, what) == 0) { return 0; }
    return _ti_commit(w);
}

// Enabled, everything told again, committed.
fn _ti_enable(w as *Window) as i32 {
    w.ti_hold = 0;
    w.ti_dirty = 0;
    if (_send(w, w.text_input, 1, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    if (_ti_state(w, TI_TEXT | TI_TYPE | TI_RECT) == 0) { return 0; }
    return _ti_commit(w);
}


// Process one complete server message. The generated catalog supplies the
// opcode/signature contract used for the core and xdg messages below.
fn _cursor_shape_pointer(w as *Window) as void {
    if (w.cursor_shape_manager == 0 || w.pointer == 0 || w.cursor_shape_device != 0) { return; }
    w.cursor_shape_device = _id(w);
    let is [8]u8 as p;
    _put(&p[0], cast(u32, w.cursor_shape_device));
    _put(&p[4], cast(u32, w.pointer));
    if (_send(w, w.cursor_shape_manager, 1, &p[0], 8, 0 - 1) == 0) {
        w.cursor_shape_device = 0;
    }
}

fn _seat_capabilities(w as *Window, caps as u32) as void {
    let is [4]u8 as body;
    if ((caps & 1) != 0 && w.pointer == 0) {
        w.pointer = _id(w);
        _put(&body[0], cast(u32, w.pointer));
        _send(w, w.seat, 0, &body[0], 4, 0 - 1);
        w.pointer_version = w.seat_version;
        _cursor_shape_pointer(w);
        _gesture_objects(w);
    } else if ((caps & 1) == 0 && w.pointer != 0) {
        if (w.cursor_shape_device != 0) {
            _send(w, w.cursor_shape_device, 0, cast(*u8, 0), 0, 0 - 1);
            w.cursor_shape_device = 0;
        }
        _drop_gestures(w);
        if (w.pointer_version >= 3) { _send(w, w.pointer, 1, cast(*u8, 0), 0, 0 - 1); }
        w.pointer = 0; w.pointer_inside = 0; w.pointer_serial = 0;
    }
    if ((caps & 4) != 0 && w.touch == 0) {
        w.touch = _id(w);
        _put(&body[0], cast(u32, w.touch));
        _send(w, w.seat, 2, &body[0], 4, 0 - 1);
    } else if ((caps & 4) == 0 && w.touch != 0) {
        _touch_cancel(w);
        if (w.seat_version >= 3) { _send(w, w.touch, 0, cast(*u8, 0), 0, 0 - 1); }
        w.touch = 0;
    }
    if ((caps & 2) != 0 && w.keyboard == 0) {
        w.keyboard = _id(w);
        if (w.keyboard != 0) { _objects[w.keyboard].fd_opcode = 0; }
        _put(&body[0], cast(u32, w.keyboard));
        _send(w, w.seat, 1, &body[0], 4, 0 - 1);
    } else if ((caps & 2) == 0 && w.keyboard != 0) {
        if (w.keyboard_focus == 1) {
            _event(w, event.FOCUS_OUT);
            _cancel_input(w);
        }
        if (w.seat_version >= 3) { _send(w, w.keyboard, 0, cast(*u8, 0), 0, 0 - 1); }
        if (w.keyboard != 0) { _objects[w.keyboard].owner = cast(*Window, 0); }
        w.keyboard = 0; w.keyboard_focus = 0;
        mem.memzero(cast(*u8, &w.key_down[0]), 256 * 4);
        mem.memzero(cast(*u8, &w.key_syms[0]), 256 * 4);
        mem.memzero(cast(*u8, &w.key_cuts[0]), 256 * 4);
        w.repeat_code = 0 - 1;
    }
}

// A keysym as input/keys.cst names keys: what the keysym is, a Latin
// capital as its small letter.
fn _key_id(sym as u32) as i32 {
    if (sym >= 65 && sym <= 90) { return cast(i32, sym + 32); }
    if (sym == 0 || sym > 2147483647) { return keys.UNKNOWN; }
    return cast(i32, sym);
}

// Whether key id is the same key whatever the layout says: a Latin letter,
// digit or punctuation, or a function key's (the 0xff.. keysyms).
fn _latin(id as i32) as i32 {
    return cast(i32, (id >= 32 && id <= 126) || (id >= 65280 && id <= 65535));
}

// --- The keymap's reader: libxkbcommon, or with keymap_kind KEYMAP_CAUSTIC
// the own interpreter (input/xkb), behind the same few questions. ---

fn _own(w as *Window) as i32 { return cast(i32, w.keymap_kind == KEYMAP_CAUSTIC); }

fn _kb_ready(w as *Window) as i32 {
    if (_own(w) == 1) { return cast(i32, cast(i64, w.own_state) != 0); }
    return cast(i32, cast(i64, w.xkb_state) != 0);
}

fn _kb_update_key(w as *Window, xcode as u32, down as i32) as void {
    if (_kb_ready(w) == 0) { return; }
    if (_own(w) == 1) { xkbstate.update_key(w.own_state, cast(i64, xcode), down); return; }
    xkb.xkb_state_update_key(w.xkb_state, xcode, down);
}

fn _kb_update_mask(w as *Window, depressed as u32, latched as u32, locked as u32, group as u32) as void {
    if (_kb_ready(w) == 0) { return; }
    if (_own(w) == 1) {
        xkbstate.update_mask(w.own_state, depressed, latched, locked, 0, 0, cast(i32, group));
        return;
    }
    xkb.xkb_state_update_mask(w.xkb_state, depressed, latched, locked, 0, 0, group);
}

fn _kb_one_sym(w as *Window, xcode as u32) as u32 {
    if (_kb_ready(w) == 0) { return 0; }
    if (_own(w) == 1) { return xkbstate.key_one_sym(w.own_state, cast(i64, xcode)); }
    return xkb.xkb_state_key_get_one_sym(w.xkb_state, xcode);
}

fn _kb_layout(w as *Window, xcode as u32) as u32 {
    if (_own(w) == 1) { return cast(u32, xkbstate.key_layout(w.own_state, cast(i64, xcode))); }
    return xkb.xkb_state_key_get_layout(w.xkb_state, xcode);
}

fn _kb_num_layouts(w as *Window, xcode as u32) as u32 {
    if (_own(w) == 1) {
        if (cast(i64, w.own_keymap) == 0) { return 0; }
        return cast(u32, xkbkeymap.num_layouts_for_key(w.own_keymap, cast(i64, xcode)));
    }
    if (cast(i64, w.xkb_keymap) == 0) { return 0; }
    return xkb.xkb_keymap_num_layouts_for_key(w.xkb_keymap, xcode);
}

// The keysym at key xcode's first level in layout: 0 for none.
fn _kb_first_sym(w as *Window, xcode as u32, layout as u32) as u32 {
    let is *u32 as syms with mut = cast(*u32, 0);
    let is i32 as n with mut = 0;
    if (_own(w) == 1) {
        if (cast(i64, w.own_keymap) == 0) { return 0; }
        n = xkbkeymap.key_syms(w.own_keymap, cast(i64, xcode), cast(i32, layout), 0, &syms);
    } else {
        if (cast(i64, w.xkb_keymap) == 0) { return 0; }
        n = xkb.xkb_keymap_key_get_syms_by_level(w.xkb_keymap, xcode, layout, 0, cast(*u8, &syms));
    }
    if (n < 1 || cast(i64, syms) == 0) { return 0; }
    return syms[0];
}

fn _kb_utf8(w as *Window, xcode as u32, out as *u8, size as i64) as i32 {
    if (_kb_ready(w) == 0) { return 0; }
    if (_own(w) == 1) { return cast(i32, xkbstate.key_utf8(w.own_state, cast(i64, xcode), out, size)); }
    return xkb.xkb_state_key_get_utf8(w.xkb_state, xcode, out, cast(u64, size));
}

fn _kb_repeats(w as *Window, xcode as u32) as i32 {
    if (_own(w) == 1) {
        if (cast(i64, w.own_keymap) == 0) { return 0; }
        return xkbkeymap.key_repeats(w.own_keymap, cast(i64, xcode));
    }
    if (cast(i64, w.xkb_keymap) == 0) { return 0; }
    return xkb.xkb_keymap_key_repeats(w.xkb_keymap, xcode);
}

// keys.MOD_* of the effective modifiers.
fn _kb_modifiers(w as *Window) as i32 {
    if (_kb_ready(w) == 0) { return 0; }
    let is i32 as out with mut = 0;
    if (_own(w) == 1) {
        let is *xkbstate.State as s = w.own_state;
        let is i32 as e = xkbstate.MODS_EFFECTIVE;
        if (xkbstate.mod_active(s, xkbkeymap.MOD_SHIFT, e) == 1) { out = out | keys.MOD_SHIFT; }
        if (xkbstate.mod_active(s, xkbkeymap.MOD_LOCK, e) == 1) { out = out | keys.MOD_LOCK; }
        if (xkbstate.mod_active(s, xkbkeymap.MOD_CONTROL, e) == 1) { out = out | keys.MOD_CONTROL; }
        if (xkbstate.mod_active(s, xkbkeymap.MOD_MOD1, e) == 1) { out = out | keys.MOD_ALT; }
        if (xkbstate.mod_active(s, xkbkeymap.MOD_MOD4, e) == 1) { out = out | keys.MOD_SUPER; }
        return out;
    }
    let is i32 as flags with imut = 8;
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Shift", flags) != 0) { out = out | keys.MOD_SHIFT; }
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Lock", flags) != 0) { out = out | keys.MOD_LOCK; }
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Control", flags) != 0) { out = out | keys.MOD_CONTROL; }
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Mod1", flags) != 0) { out = out | keys.MOD_ALT; }
    if (xkb.xkb_state_mod_name_is_active(w.xkb_state, "Mod4", flags) != 0) { out = out | keys.MOD_SUPER; }
    return out;
}

// A keysym fed to the Compose state: its status after (both readers say
// NOTHING 0, COMPOSING 1, COMPOSED 2, CANCELLED 3), -1 without a table.
fn _kb_compose(w as *Window, sym as u32) as i32 {
    if (_own(w) == 1) {
        if (cast(i64, w.own_compose) == 0) { return 0 - 1; }
        xcompose.feed(w.own_compose, sym);
        return xcompose.status(w.own_compose);
    }
    if (cast(i64, w.compose_state) == 0) { return 0 - 1; }
    xkb.xkb_compose_state_feed(w.compose_state, sym);
    return xkb.xkb_compose_state_get_status(w.compose_state);
}

fn _kb_compose_utf8(w as *Window, out as *u8, size as i64) as i32 {
    if (_own(w) == 1) { return cast(i32, xcompose.utf8(w.own_compose, out, size)); }
    return xkb.xkb_compose_state_get_utf8(w.compose_state, out, cast(u64, size));
}

fn _kb_compose_reset(w as *Window) as void {
    if (_own(w) == 1) {
        if (cast(i64, w.own_compose) != 0) { xcompose.reset(w.own_compose); }
        return;
    }
    if (cast(i64, w.compose_state) != 0) { xkb.xkb_compose_state_reset(w.compose_state); }
}

fn _kb_free_own(w as *Window) as void {
    if (cast(i64, w.own_compose) != 0) { xcompose.state_free(w.own_compose); }
    if (cast(i64, w.own_compose_table) != 0) { xcompose.free_table(w.own_compose_table); }
    if (cast(i64, w.own_state) != 0) { xkbstate.free(w.own_state); }
    if (cast(i64, w.own_keymap) != 0) { xkbkeymap.free(w.own_keymap); }
    w.own_compose = cast(*xcompose.State, 0); w.own_compose_table = cast(*xcompose.Table, 0);
    w.own_state = cast(*xkbstate.State, 0); w.own_keymap = cast(*xkbkeymap.Keymap, 0);
}

// Where the chosen reader refused the compositor's last keymap, -1 when it
// took it: the own interpreter's byte; libxkbcommon says no byte (0).
fn keymap_refused(w as *Window) as i64 { return w.keymap_refused_at; }

// Which key xcode is in the layout in use, at its first level — a, not A —
// into *key; and the key a shortcut is matched against into *shortcut: the
// same where it is Latin, else the key's Latin letter in the first layout
// that has one, so Ctrl+C is Ctrl+C in a Cyrillic layout. Nothing guessed:
// a key no layout gives a Latin letter keeps its own.
fn _key_ids(w as *Window, xcode as u32, key as *i32, shortcut as *i32) as void {
    *key = keys.UNKNOWN;
    *shortcut = keys.UNKNOWN;
    if (_kb_ready(w) == 0) { return; }
    let is u32 as sym with mut = _kb_first_sym(w, xcode, _kb_layout(w, xcode));
    if (sym == 0) { sym = _kb_one_sym(w, xcode); }
    *key = _key_id(sym);
    *shortcut = *key;
    if (_latin(*key) == 1) { return; }
    let is u32 as layouts = _kb_num_layouts(w, xcode);
    let is u32 as l with mut = 0;
    while (l < layouts) {
        let is i32 as other = _key_id(_kb_first_sym(w, xcode, l));
        if (other >= 32 && other <= 126) {
            *shortcut = other;
            return;
        }
        l = l + 1;
    }
}

// Key code (evdev's) went down or up: the key, as its press said it, and the
// text it typed — repeat 1 for a repeat of a held key.
fn _key_input(w as *Window, down as i32, code as i32, repeat as i32) as void {
    let is u32 as xcode = cast(u32, code + 8);
    let is ie.Event as e = _input(w, ie.KEY_UP);
    if (down == 1) {
        e.kind = ie.KEY_DOWN;
        e.repeat = repeat;
    }
    e.key = w.key_syms[code];
    e.shortcut = w.key_cuts[code];
    e.physical = cast(i32, xcode);
    _push(w, &e, cast(*u8, 0), 0);
    // What it typed. Control characters are not text, and neither is what a
    // key held with Control, Alt or Super types: that key is a command.
    // Looked up all the same — a compose sequence moves with each key. With
    // text input on too: a compositor's input method grabs the keys it
    // composes with, so the ones that arrive here are the ones nobody did —
    // and with no method at all, every key.
    if (down == 0 || _kb_ready(w) == 0) { return; }
    let is i32 as typed = _key_text(w, _kb_one_sym(w, xcode), xcode);
    let is i32 as command = cast(i32, (w.modifiers & (keys.MOD_CONTROL | keys.MOD_ALT | keys.MOD_SUPER)) != 0);
    if (typed > 0 && command == 0 && w.text_buf[0] >= cast(u8, 32) && w.text_buf[0] != cast(u8, 127)) {
        let is ie.Event as t = _input(w, ie.TEXT);
        t.from_key = 1;
        _push(w, &t, &w.text_buf[0], cast(i64, typed));
    }
}

// The held key repeating, as of now (the monotonic clock, ms): its repeat
// when one is due — one at most, so a loop late to pump catches up rather
// than flooding — the next due a period after.
fn _repeat_keys(w as *Window, now as i64) as void {
    if (w.repeat_code < 0 || w.repeat_rate <= 0 || w.keyboard_focus == 0) { return; }
    if (now < w.repeat_next) { return; }
    _key_input(w, 1, w.repeat_code, 1);
    let is i64 as period with mut = 1000 / cast(i64, w.repeat_rate);
    if (period < 1) { period = 1; }
    w.repeat_next = w.repeat_next + period;
    if (w.repeat_next <= now) { w.repeat_next = now + period; }
}

// Milliseconds until the input layer wants a turn — the held key's next
// repeat, the drawn pointer's next frame — 0 when due; -1 for none.
fn input_due(w as *Window) as i64 {
    if (w.opened == 0) { return 0 - 1; }
    let is i64 as now = time.now_ms();
    let is i64 as due with mut = 0 - 1;
    if (w.repeat_code >= 0 && w.repeat_rate > 0 && w.keyboard_focus == 1) {
        due = w.repeat_next - now;
        if (due < 0) { due = 0; }
    }
    if (w.pointer_inside == 1 && w.cursor_next >= 0) {
        let is i64 as c with mut = w.cursor_next - now;
        if (c < 0) { c = 0; }
        if (due < 0 || c < due) { due = c; }
    }
    // A transfer under way: due now when its descriptor is ready, else soon
    // — a source or a reader in another program may take its time.
    if (_transferring(w) == 1) {
        let is i64 as t with mut = 10;
        if (_transfer_ready(w) == 1) { t = 0; }
        if (due < 0 || t < due) { due = t; }
    }
    return due;
}

// Whether a reader's descriptor has something to read, or a writer's room to
// write, now.
fn _transfer_ready(w as *Window) as i32 {
    if (w.reading[PASTE].fd >= 0 && sys.wait_readable(w.reading[PASTE].fd, 0) > 0) { return 1; }
    if (w.reading[DROP].fd >= 0 && sys.wait_readable(w.reading[DROP].fd, 0) > 0) { return 1; }
    let is i32 as k with mut = 0;
    while (k < MAX_WRITERS) {
        if (w.writing[k].fd >= 0 && sys.wait_writable(w.writing[k].fd, 0) > 0) { return 1; }
        k = k + 1;
    }
    return 0;
}

// The locale whose Compose file a keymap's keyboard composes with.
fn _locale() as *u8 {
    let is *u8 as locale with mut = env.getenv("LC_ALL");
    if (cast(i64, locale) == 0 || locale[0] == 0) { locale = env.getenv("LC_CTYPE"); }
    if (cast(i64, locale) == 0 || locale[0] == 0) { locale = env.getenv("LANG"); }
    if (cast(i64, locale) == 0 || locale[0] == 0) { locale = "C.UTF-8"; }
    return locale;
}

// The keymap text read by the own interpreter: the old keyboard kept when
// it refuses it, keymap_refused saying where.
fn _load_own_keymap(w as *Window, map as *u8, size as i64) as void {
    let is i64 as where with mut = 0 - 1;
    let is *xkbkeymap.Keymap as km = xkbkeymap.parse(map, size, &where);
    if (cast(i64, km) == 0) { w.keymap_refused_at = where; return; }
    let is *xkbstate.State as s = xkbstate.new(km);
    if (cast(i64, s) == 0) { xkbkeymap.free(km); return; }
    let is *xcompose.Table as table = xcompose.table_from_locale(_locale());
    let is *xcompose.State as compose with mut = cast(*xcompose.State, 0);
    if (cast(i64, table) != 0) { compose = xcompose.state_new(table); }
    _kb_free_own(w);
    w.own_keymap = km; w.own_state = s;
    w.own_compose_table = table; w.own_compose = compose;
    w.keymap_refused_at = 0 - 1;
    w.repeat_code = 0 - 1;
}

fn _load_keymap(w as *Window, fd as i64, size as i64) as void {
    if (fd < 0 || size < 1 || size > 16777216) { return; }
    let is *u8 as map = linux.mmap(cast(*u8, 0), size, linux.PROT_READ, linux.MAP_PRIVATE, fd, 0);
    if (cast(i64, map) == linux.MAP_FAILED) { return; }
    if (map[size - 1] != 0) { linux.munmap(map, size); return; }
    if (_own(w) == 1) {
        _load_own_keymap(w, map, size);
        linux.munmap(map, size);
        return;
    }
    if (cast(i64, w.xkb_context) == 0) { w.xkb_context = xkb.xkb_context_new(0); }
    if (cast(i64, w.xkb_context) == 0) { linux.munmap(map, size); return; }
    let is *u8 as keymap = xkb.xkb_keymap_new_from_string(w.xkb_context, map, 1, 0);
    if (cast(i64, keymap) == 0) { w.keymap_refused_at = 0; linux.munmap(map, size); return; }
    let is *u8 as state = xkb.xkb_state_new(keymap);
    if (cast(i64, state) == 0) {
        xkb.xkb_keymap_unref(keymap);
        linux.munmap(map, size);
        return;
    }
    let is *u8 as table = xkb.xkb_compose_table_new_from_locale(w.xkb_context, _locale(), 0);
    let is *u8 as compose with mut = cast(*u8, 0);
    if (cast(i64, table) != 0) { compose = xkb.xkb_compose_state_new(table, 0); }
    if (cast(i64, w.xkb_state) != 0) { xkb.xkb_state_unref(w.xkb_state); }
    if (cast(i64, w.xkb_keymap) != 0) { xkb.xkb_keymap_unref(w.xkb_keymap); }
    if (cast(i64, w.compose_state) != 0) { xkb.xkb_compose_state_unref(w.compose_state); }
    if (cast(i64, w.compose_table) != 0) { xkb.xkb_compose_table_unref(w.compose_table); }
    w.xkb_keymap = keymap; w.xkb_state = state;
    w.compose_table = table; w.compose_state = compose;
    w.keymap_refused_at = 0 - 1;
    // A key repeating under the old keymap is not the new one's.
    w.repeat_code = 0 - 1;
    linux.munmap(map, size);
}

fn _key_text(w as *Window, sym as u32, keycode as u32) as i32 {
    w.text_len = 0;
    mem.memzero(cast(*u8, &w.text_buf[0]), 256);
    if (sym != 0) {
        let is i32 as status = _kb_compose(w, sym);
        if (status == 1) { return 0; }
        if (status == 2) {
            w.text_len = _kb_compose_utf8(w, &w.text_buf[0], 256);
            _kb_compose_reset(w);
            if (w.text_len > 255) { w.text_len = 255; }
            return w.text_len;
        }
        if (status == 3) { _kb_compose_reset(w); return 0; }
    }
    w.text_len = _kb_utf8(w, keycode, &w.text_buf[0], 256);
    if (w.text_len > 255) { w.text_len = 255; }
    return w.text_len;
}

fn _keyboard_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0) {
        let is i64 as fd = _take_recv_fd();
        if (fd < 0) { return; }
        if (_wire_size >= 16) {
            let is u32 as format = _word(p);
            let is i64 as size = cast(i64, _word(cast(*u8, cast(i64, p) + 4)));
            if (format == 1) { _load_keymap(w, fd, size); }
        }
        linux.close(fd);
        return;
    }
    if (op == 1) {
        if (_wire_size < 20 || _word(cast(*u8, cast(i64, p) + 4)) != cast(u32, w.surface)) { return; }
        w.keyboard_focus = 1;
        // The enter's serial: what a selection set before a key is pressed —
        // a paste menu's copy — is owned by.
        w.input_serial = _word(p);
        let is i32 as bytes = cast(i32, _word(cast(*u8, cast(i64, p) + 8)));
        if (bytes >= 0 && (bytes & 3) == 0 && 20 + bytes <= _wire_size && _kb_ready(w) == 1) {
            let is i32 as i with mut = 0;
            while (i < bytes / 4) {
                let is i32 as code = cast(i32, _word(cast(*u8, cast(i64, p) + 12 + i * 4)));
                if (code >= 0 && code < 256) {
                    let is u32 as xcode = cast(u32, code + 8);
                    _kb_update_key(w, xcode, 1);
                    w.key_down[code] = 1;
                    _key_ids(w, xcode, &w.key_syms[code], &w.key_cuts[code]);
                }
                i = i + 1;
            }
        }
        let is event.Event as e;
        event.clear(&e); e.kind = event.FOCUS_IN; e.raw_kind = op;
        _queue(w, &e);
        return;
    }
    if (op == 2) {
        if (w.keyboard_focus == 1) {
            let is i32 as i with mut = 0;
            while (i < 256) {
                if (w.key_down[i] == 1) { _kb_update_key(w, cast(u32, i + 8), 0); }
                i = i + 1;
            }
            w.keyboard_focus = 0; w.modifiers = 0;
            mem.memzero(cast(*u8, &w.key_down[0]), 256 * 4);
            mem.memzero(cast(*u8, &w.key_syms[0]), 256 * 4);
            mem.memzero(cast(*u8, &w.key_cuts[0]), 256 * 4);
            _kb_compose_reset(w);
            let is event.Event as e;
            event.clear(&e); e.kind = event.FOCUS_OUT; e.raw_kind = op;
            _queue(w, &e);
            // The keys it held are let go where this window cannot hear it.
            _cancel_input(w);
        }
        return;
    }
    if (op == 3 && _wire_size >= 24) {
        w.input_serial = _word(p);
        if (_word(cast(*u8, cast(i64, p) + 12)) != 0) { w.grab_serial = w.input_serial; }
    }
    if (op == 3) {
        if (w.keyboard_focus == 0) { return; }
        let is i32 as code = cast(i32, _word(cast(*u8, cast(i64, p) + 8)));
        let is i32 as state = cast(i32, _word(cast(*u8, cast(i64, p) + 12)));
        let is i32 as down = cast(i32, state != 0);
        if (code < 0 || code >= 256) { return; }
        let is u32 as xcode = cast(u32, code + 8);
        if (down == 1) {
            _kb_update_key(w, xcode, 1);
            _key_ids(w, xcode, &w.key_syms[code], &w.key_cuts[code]);
            w.key_down[code] = 1;
            // The key held repeats, from here, if the keymap says it does.
            if (w.repeat_rate > 0 && _kb_repeats(w, xcode) == 1) {
                w.repeat_code = code;
                w.repeat_next = time.now_ms() + cast(i64, w.repeat_delay);
            }
        } else {
            _kb_update_key(w, xcode, 0);
            w.key_down[code] = 0;
            if (code == w.repeat_code) { w.repeat_code = 0 - 1; }
        }
        w.modifiers = _kb_modifiers(w);
        _key_input(w, down, code, 0);
        if (down == 0) { w.key_syms[code] = 0; w.key_cuts[code] = 0; }
        return;
    }
    if (op == 5 && _wire_size >= 16) {
        // repeat_info: so many repeats a second (0: none), after so many ms.
        w.repeat_rate = cast(i32, _word(p));
        w.repeat_delay = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
        if (w.repeat_rate <= 0) { w.repeat_rate = 0; w.repeat_code = 0 - 1; }
        if (w.repeat_delay < 0) { w.repeat_delay = 0; }
        return;
    }
    if (op == 4 && _kb_ready(w) == 1) {
        _kb_update_mask(w, _word(cast(*u8, cast(i64, p) + 4)), _word(cast(*u8, cast(i64, p) + 8)),
                        _word(cast(*u8, cast(i64, p) + 12)), _word(cast(*u8, cast(i64, p) + 16)));
        w.modifiers = _kb_modifiers(w);
    }
}

fn _button_id(code as i32) as i32 {
    if (code == 272) { return 1; }
    if (code == 274) { return 2; }
    if (code == 273) { return 3; }
    if (code >= 275 && code <= 279) { return code - 271; }
    return 0;
}

// Whole notches in 120ths given, the rest kept for the next: toward zero, so
// a turn back starts from what is left.
fn _notches(v120 as i32, rest as *i32) as i32 {
    *rest = *rest + v120;
    let is i32 as whole = *rest / 120;
    *rest = *rest - whole * 120;
    return whole;
}

// A pointer frame's scrolling, said as one SCROLL. Where it came from as the
// compositor said (axis_source; a frame with notches and no source a
// wheel's). A wheel's in notches — 120ths where it says them (value120, 8),
// whole ones before (axis_discrete), whole notches counted from what is left
// between frames; fingers' and continuous devices' in lines of LINE_PIXELS
// of the compositor's motion, and the axes they stopped on (axis_stop).
// Before version 5 there are no frames: each axis event a wheel's notch.
fn _scroll(w as *Window) as void {
    if (w.scroll_x == 0 && w.scroll_y == 0 && w.scroll_discrete == 0 && w.scroll_discrete_x == 0 &&
        w.scroll_v120_x == 0 && w.scroll_v120_y == 0 && w.scroll_stop == 0) { return; }
    let is ie.Event as e = _input(w, ie.SCROLL);
    e.x = w.pointer_x;
    e.y = w.pointer_y;
    let is i32 as notched = cast(i32, w.scroll_v120_x != 0 || w.scroll_v120_y != 0 ||
                                     w.scroll_discrete != 0 || w.scroll_discrete_x != 0);
    e.source = ie.SCROLL_CONTINUOUS;
    if (w.scroll_source == 0 || (w.scroll_source < 0 && notched == 1)) { e.source = ie.SCROLL_WHEEL; }
    if (w.scroll_source == 1) { e.source = ie.SCROLL_FINGER; }
    if (w.scroll_source == 3) { e.source = ie.SCROLL_TILT; }
    if (w.pointer_version < 5) {
        e.source = ie.SCROLL_WHEEL;
        if (w.scroll_y > 0) { e.steps_y = 1; } else if (w.scroll_y < 0) { e.steps_y = 0 - 1; }
        if (w.scroll_x > 0) { e.steps_x = 1; } else if (w.scroll_x < 0) { e.steps_x = 0 - 1; }
        e.dx = cast(f64, e.steps_x);
        e.dy = cast(f64, e.steps_y);
        e.value120_x = e.steps_x * 120;
        e.value120_y = e.steps_y * 120;
    } else if (e.source == ie.SCROLL_WHEEL || e.source == ie.SCROLL_TILT) {
        let is i32 as vx with mut = w.scroll_v120_x;
        let is i32 as vy with mut = w.scroll_v120_y;
        if (notched == 0) {
            // A wheel the compositor gives no notches for: its motion, a
            // notch every LINE_PIXELS.
            vx = cast(i32, w.scroll_x * 120 / 256 / 15);
            vy = cast(i32, w.scroll_y * 120 / 256 / 15);
        } else if (vx == 0 && vy == 0) {
            vx = w.scroll_discrete_x * 120;
            vy = w.scroll_discrete * 120;
        }
        e.value120_x = vx;
        e.value120_y = vy;
        e.dx = cast(f64, vx) / 120.0;
        e.dy = cast(f64, vy) / 120.0;
        e.steps_x = _notches(vx, &w.v120_rest_x);
        e.steps_y = _notches(vy, &w.v120_rest_y);
    } else {
        e.dx = cast(f64, w.scroll_x) / 256.0 / ie.LINE_PIXELS;
        e.dy = cast(f64, w.scroll_y) / 256.0 / ie.LINE_PIXELS;
        e.stop = w.scroll_stop;
    }
    _push(w, &e, cast(*u8, 0), 0);
    w.scroll_x = 0; w.scroll_y = 0; w.scroll_discrete = 0; w.scroll_discrete_x = 0;
    w.scroll_v120_x = 0; w.scroll_v120_y = 0; w.scroll_source = 0 - 1; w.scroll_stop = 0;
}

fn _pointer_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0) {
        if (_word(cast(*u8, cast(i64, p) + 4)) != cast(u32, w.surface)) { return; }
        w.pointer_serial = _word(p);
        w.pointer_inside = 1;
        w.pointer_x = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        w.pointer_y = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 12))) / 256), w.scale120);
        _pointer_input(w, ie.ENTER, 0);
        // Each enter is a new serial the pointer's shape is set under.
        _cursor_apply(w);
        return;
    }
    if (op == 1) {
        w.pointer_serial = _word(p); w.pointer_inside = 0;
        // What a wheel turned short of a notch is not carried to another
        // visit, nor a frame left unended.
        w.scroll_x = 0; w.scroll_y = 0; w.scroll_discrete = 0; w.scroll_discrete_x = 0;
        w.scroll_v120_x = 0; w.scroll_v120_y = 0; w.scroll_source = 0 - 1; w.scroll_stop = 0;
        w.v120_rest_x = 0; w.v120_rest_y = 0;
        _pointer_input(w, ie.LEAVE, 0);
        return;
    }
    if (w.pointer_inside == 0) { return; }
    if (op == 2) {
        w.pointer_x = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 4))) / 256), w.scale120);
        w.pointer_y = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))) / 256), w.scale120);
        _pointer_input(w, ie.MOTION, 0);
        return;
    }
    if (op == 3) {
        w.pointer_serial = _word(p);
        if (_word(cast(*u8, cast(i64, p) + 12)) == 1) { w.grab_serial = w.pointer_serial; w.input_serial = w.pointer_serial; }
        let is i32 as button = _button_id(cast(i32, _word(cast(*u8, cast(i64, p) + 8))));
        if (button <= 0 || button >= 8) { return; }
        let is i32 as down = cast(i32, _word(cast(*u8, cast(i64, p) + 12)) == 1);
        // A release of a button not held says nothing: its press was taken
        // by the compositor to move or resize from, or let go by a CANCEL.
        if (down == 0 && w.pointer_buttons[button] == 0 && (w.swallowed & cast(i32, 1 << button)) == 0) { return; }
        let is i32 as bit = cast(i32, 1 << button);
        if (down == 1) { w.swallowed = w.swallowed & cast(i32, 0 - 1 - bit); }
        if (down == 1 && w.xdg_popup == 0 && _ngrabbers > 0) {
            let is *Window as top = _grabbers[_ngrabbers - 1];
            if (top.popup_done == 0) {
                top.popup_done = 1;
                _event(top, event.POPUP_DONE);
            }
            w.swallowed = w.swallowed | bit;
            return;
        }
        if (down == 0 && (w.swallowed & bit) != 0) {
            w.swallowed = w.swallowed & cast(i32, 0 - 1 - bit);
            return;
        }
        w.pointer_buttons[button] = down;
        if (down == 1) { _pointer_input(w, ie.BUTTON_DOWN, button); }
        else { _pointer_input(w, ie.BUTTON_UP, button); }
        return;
    }
    if (op == 4 && _wire_size >= 20) {
        let is i64 as value = cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8))));
        if (_word(cast(*u8, cast(i64, p) + 4)) == 0) { w.scroll_y = w.scroll_y + value; }
        else { w.scroll_x = w.scroll_x + value; }
        if (w.pointer_version < 5) { _scroll(w); }
        return;
    }
    if (op == 6 && _wire_size >= 12) {
        let is u32 as source = _word(p);
        if (source <= cast(u32, 3)) { w.scroll_source = cast(i32, source); }
        return;
    }
    if (op == 7 && _wire_size >= 16) {
        if (_word(cast(*u8, cast(i64, p) + 4)) == 0) { w.scroll_stop = w.scroll_stop | ie.STOP_Y; }
        else { w.scroll_stop = w.scroll_stop | ie.STOP_X; }
        return;
    }
    if (op == 8 && _wire_size >= 16) {
        let is i32 as steps = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
        if (_word(p) == 0) { w.scroll_discrete = w.scroll_discrete + steps; }
        else { w.scroll_discrete_x = w.scroll_discrete_x + steps; }
        return;
    }
    if (op == 9 && _wire_size >= 16) {
        let is i32 as v120 = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
        if (_word(p) == 0) { w.scroll_v120_y = w.scroll_v120_y + v120; }
        else { w.scroll_v120_x = w.scroll_v120_x + v120; }
        return;
    }
    if (op == 5 && w.pointer_version >= 5) { _scroll(w); }
}

// --- Touch (wl_touch) ---
//
// A point is this window's from its down on this surface to its up: the
// compositor sends a client's every touch object the points on any of its
// surfaces. Coordinates as the pointer's, buffer pixels.

fn _touch_slot(w as *Window, id as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < 10) {
        if (w.touch_used[i] == 1 && w.touch_ids[i] == id) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn _touch_input(w as *Window, kind as i32, slot as i32, time as u32) as void {
    let is ie.Event as e = _input(w, kind);
    e.contact = w.touch_ids[slot];
    e.x = w.touch_x[slot];
    e.y = w.touch_y[slot];
    e.time_ms = cast(i64, time);
    _push(w, &e, cast(*u8, 0), 0);
}

// Every point this window had, gone without lifting: one TOUCH_CANCEL.
fn _touch_cancel(w as *Window) as void {
    let is i32 as had with mut = 0;
    let is i32 as i with mut = 0;
    while (i < 10) {
        if (w.touch_used[i] == 1) { had = 1; }
        w.touch_used[i] = 0;
        i = i + 1;
    }
    if (had == 0) { return; }
    let is ie.Event as e = _input(w, ie.TOUCH_CANCEL);
    _push(w, &e, cast(*u8, 0), 0);
}

fn _touch_event(w as *Window, op as i32, p as *u8) as void {
    if (op == 0 && _wire_size >= 32) {
        // down: serial, time, surface, id, x, y
        if (cast(i32, _word(cast(*u8, cast(i64, p) + 8))) != w.surface) { return; }
        let is i32 as id = cast(i32, _word(cast(*u8, cast(i64, p) + 12)));
        let is i32 as slot with mut = _touch_slot(w, id);
        if (slot < 0) {
            slot = 0;
            // More fingers than kept: the eleventh is not said, nor its up.
            while (slot < 10 && w.touch_used[slot] == 1) { slot = slot + 1; }
            if (slot == 10) { return; }
        }
        w.touch_used[slot] = 1;
        w.touch_ids[slot] = id;
        w.touch_x[slot] = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 16)))) / 256, w.scale120);
        w.touch_y[slot] = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 20)))) / 256, w.scale120);
        _touch_input(w, ie.TOUCH_DOWN, slot, _word(cast(*u8, cast(i64, p) + 4)));
        return;
    }
    if (op == 1 && _wire_size >= 20) {
        // up: serial, time, id
        let is i32 as slot = _touch_slot(w, cast(i32, _word(cast(*u8, cast(i64, p) + 8))));
        if (slot < 0) { return; }
        _touch_input(w, ie.TOUCH_UP, slot, _word(cast(*u8, cast(i64, p) + 4)));
        w.touch_used[slot] = 0;
        return;
    }
    if (op == 2 && _wire_size >= 24) {
        // motion: time, id, x, y
        let is i32 as slot = _touch_slot(w, cast(i32, _word(cast(*u8, cast(i64, p) + 4))));
        if (slot < 0) { return; }
        w.touch_x[slot] = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 8)))) / 256, w.scale120);
        w.touch_y[slot] = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 12)))) / 256, w.scale120);
        _touch_input(w, ie.TOUCH_MOTION, slot, _word(p));
        return;
    }
    if (op == 4) { _touch_cancel(w); }
}

// --- Pens (tablet-v2) ---
//
// The tablet seat says each tablet and tool as it comes, as an object of the
// compositor's; a tool's events are gathered until its frame and said then,
// in order: in range, down or moved, its buttons, up, out of range. A tool
// is this window's from its proximity_in on this surface to its
// proximity_out. Pads (a tablet's own buttons and rings) are not said.

let is i32 as CAP_PRESSURE with imut = 2;
let is i32 as CAP_DISTANCE with imut = 3;

fn _tablet_index(w as *Window, obj as i32) as i32 {
    if (obj == 0) { return 0 - 1; }
    let is i32 as i with mut = 0;
    while (i < 4) {
        if (w.tablets[i] == obj) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn _tool_index(w as *Window, obj as i32) as i32 {
    if (obj == 0) { return 0 - 1; }
    let is i32 as i with mut = 0;
    while (i < 8) {
        if (w.tools[i].object == obj) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn _tablet_seat_event(w as *Window, op as i32, p as *u8) as void {
    if (_wire_size < 12) { return; }
    let is i32 as obj = cast(i32, _word(p));
    if (op == 0) {
        let is i32 as free with mut = 0;
        while (free < 4 && w.tablets[free] != 0) { free = free + 1; }
        if (free < 4) { w.tablets[free] = obj; } else { _send(w, obj, 0, cast(*u8, 0), 0, 0 - 1); }
        return;
    }
    if (op == 1) {
        let is i32 as free with mut = 0;
        while (free < 8 && w.tools[free].object != 0) { free = free + 1; }
        if (free == 8) {
            _send(w, obj, 1, cast(*u8, 0), 0, 0 - 1);
            return;
        }
        let is *Tool as t = &w.tools[free];
        mem.memzero(cast(*u8, t), sizeof(Tool));
        t.object = obj;
        t.kind = ie.TOOL_PEN;
        w.tool_serial = w.tool_serial + 1;
        t.contact = w.tool_serial;
        t.pressure = 0.0 - 1.0;
        t.tilt_x = 0.0;
        t.tilt_y = 0.0;
        t.distance = 0.0 - 1.0;
        return;
    }
    // A pad: its own buttons, not said here; let go of at once.
    if (op == 2) { _send(w, obj, 1, cast(*u8, 0), 0, 0 - 1); }
}

fn _tablet_event(w as *Window, i as i32, op as i32) as void {
    if (op != 4) { return; }
    _send(w, w.tablets[i], 0, cast(*u8, 0), 0, 0 - 1);
    w.tablets[i] = 0;
}

fn _pen(w as *Window, t as *Tool, kind as i32) as ie.Event {
    let is ie.Event as e = _input(w, kind);
    e.contact = t.contact;
    e.x = t.x;
    e.y = t.y;
    e.pressure = t.pressure;
    e.tilt_x = t.tilt_x;
    e.tilt_y = t.tilt_y;
    e.distance = t.distance;
    e.time_ms = t.time;
    return e;
}

fn _tool_frame(w as *Window, t as *Tool) as void {
    if (t.f_in == 1) {
        let is ie.Event as e = _pen(w, t, ie.PEN_IN);
        e.detail = t.kind;
        _push(w, &e, cast(*u8, 0), 0);
    }
    if (t.f_down == 1 && t.down == 0) {
        t.down = 1;
        let is ie.Event as e = _pen(w, t, ie.PEN_DOWN);
        _push(w, &e, cast(*u8, 0), 0);
    } else if (t.f_moved == 1 && t.f_in == 0) {
        let is ie.Event as e = _pen(w, t, ie.PEN_MOTION);
        _push(w, &e, cast(*u8, 0), 0);
    }
    let is i32 as b with mut = 0;
    while (b < t.nbuttons) {
        let is ie.Event as e = _pen(w, t, ie.PEN_BUTTON);
        e.button = t.buttons[b] >> 1;
        e.detail = t.buttons[b] & 1;
        _push(w, &e, cast(*u8, 0), 0);
        b = b + 1;
    }
    if ((t.f_up == 1 || t.f_out == 1) && t.down == 1) {
        t.down = 0;
        let is ie.Event as e = _pen(w, t, ie.PEN_UP);
        _push(w, &e, cast(*u8, 0), 0);
    }
    if (t.f_out == 1) {
        t.inside = 0;
        let is ie.Event as e = _pen(w, t, ie.PEN_OUT);
        _push(w, &e, cast(*u8, 0), 0);
    }
    t.f_in = 0; t.f_out = 0; t.f_down = 0; t.f_up = 0; t.f_moved = 0; t.nbuttons = 0;
}

fn _tool_event(w as *Window, i as i32, op as i32, p as *u8) as void {
    let is *Tool as t = &w.tools[i];
    if (op == 0 && _wire_size >= 12) {
        // type: pen 0x140, eraser 0x141, pencil 0x143; brush, airbrush,
        // finger, mouse and lens are other tools.
        let is u32 as kind = _word(p);
        t.kind = ie.TOOL_OTHER;
        if (kind == cast(u32, 320) || kind == cast(u32, 323)) { t.kind = ie.TOOL_PEN; }
        if (kind == cast(u32, 321)) { t.kind = ie.TOOL_ERASER; }
        return;
    }
    if (op == 3 && _wire_size >= 12) {
        let is u32 as cap = _word(p);
        if (cap < cast(u32, 31)) { t.caps = t.caps | cast(i32, 1 << cap); }
        return;
    }
    if (op == 4) {
        // done: what it can say starts at rest.
        if ((t.caps & (1 << CAP_PRESSURE)) != 0) { t.pressure = 0.0; }
        if ((t.caps & (1 << CAP_DISTANCE)) != 0) { t.distance = 0.0; }
        return;
    }
    if (op == 5) {
        // removed: out of range first if it was in it.
        if (t.inside == 1) {
            t.f_out = 1;
            _tool_frame(w, t);
        }
        _send(w, t.object, 1, cast(*u8, 0), 0, 0 - 1);
        t.object = 0;
        return;
    }
    if (op == 6 && _wire_size >= 20) {
        // proximity_in: serial, tablet, surface
        if (cast(i32, _word(cast(*u8, cast(i64, p) + 8))) == w.surface) {
            t.inside = 1;
            t.f_in = 1;
            t.down = 0;
        }
        return;
    }
    if (t.inside == 0) { return; }
    if (op == 7) { t.f_out = 1; return; }
    if (op == 8) { t.f_down = 1; return; }
    if (op == 9) { t.f_up = 1; return; }
    if (op == 10 && _wire_size >= 16) {
        t.x = _scale_up(cast(i64, cast(i32, _word(p))) / 256, w.scale120);
        t.y = _scale_up(cast(i64, cast(i32, _word(cast(*u8, cast(i64, p) + 4)))) / 256, w.scale120);
        t.f_moved = 1;
        return;
    }
    if (op == 11 && _wire_size >= 12) {
        t.pressure = cast(f64, _word(p)) / 65535.0;
        t.f_moved = 1;
        return;
    }
    if (op == 12 && _wire_size >= 12) {
        t.distance = cast(f64, _word(p)) / 65535.0;
        t.f_moved = 1;
        return;
    }
    if (op == 13 && _wire_size >= 16) {
        t.tilt_x = cast(f64, cast(i32, _word(p))) / 256.0;
        t.tilt_y = cast(f64, cast(i32, _word(cast(*u8, cast(i64, p) + 4)))) / 256.0;
        t.f_moved = 1;
        return;
    }
    if (op == 17 && _wire_size >= 20) {
        // button: serial, button (BTN_STYLUS 0x14b, BTN_STYLUS2 0x14c,
        // BTN_STYLUS3 0x149), state
        let is u32 as code = _word(cast(*u8, cast(i64, p) + 4));
        let is i32 as button with mut = 0;
        if (code == cast(u32, 331)) { button = 1; }
        if (code == cast(u32, 332)) { button = 2; }
        if (code == cast(u32, 329)) { button = 3; }
        if (button != 0 && t.nbuttons < 4) {
            t.buttons[t.nbuttons] = (button << 1) | cast(i32, _word(cast(*u8, cast(i64, p) + 8)) != 0);
            t.nbuttons = t.nbuttons + 1;
        }
        return;
    }
    if (op == 18 && _wire_size >= 12) {
        t.time = cast(i64, _word(p));
        _tool_frame(w, t);
    }
}

// The tablets and tools let go of: a tool in range said out of it.
fn _drop_tablets(w as *Window) as void {
    let is i32 as i with mut = 0;
    while (i < 8) {
        let is *Tool as t = &w.tools[i];
        if (t.object != 0) {
            if (t.inside == 1) {
                t.f_out = 1;
                _tool_frame(w, t);
            }
            _send(w, t.object, 1, cast(*u8, 0), 0, 0 - 1);
            t.object = 0;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        if (w.tablets[i] != 0) { _send(w, w.tablets[i], 0, cast(*u8, 0), 0, 0 - 1); }
        w.tablets[i] = 0;
        i = i + 1;
    }
    if (w.tablet_seat != 0) { _send(w, w.tablet_seat, 0, cast(*u8, 0), 0, 0 - 1); }
    if (w.tablet_manager != 0) { _send(w, w.tablet_manager, 1, cast(*u8, 0), 0, 0 - 1); }
    w.tablet_seat = 0;
    w.tablet_manager = 0;
}

// --- Touchpad gestures (pointer-gestures) ---

fn _gesture_objects(w as *Window) as void {
    if (w.gestures == 0 || w.pointer == 0) { return; }
    let is [8]u8 as b;
    if (w.swipe == 0) {
        w.swipe = _id(w);
        _put(&b[0], cast(u32, w.swipe)); _put(&b[4], cast(u32, w.pointer));
        _send(w, w.gestures, 0, &b[0], 8, 0 - 1);
    }
    if (w.pinch == 0) {
        w.pinch = _id(w);
        _put(&b[0], cast(u32, w.pinch)); _put(&b[4], cast(u32, w.pointer));
        _send(w, w.gestures, 1, &b[0], 8, 0 - 1);
    }
    if (w.hold == 0 && w.gestures_version >= 3) {
        w.hold = _id(w);
        _put(&b[0], cast(u32, w.hold)); _put(&b[4], cast(u32, w.pointer));
        _send(w, w.gestures, 3, &b[0], 8, 0 - 1);
    }
}

// The gesture objects let go of with their pointer: one going on said
// cancelled.
fn _drop_gestures(w as *Window) as void {
    if (w.gesture_kind != 0) {
        let is ie.Event as e = _input(w, ie.GESTURE_END);
        e.gesture = w.gesture_kind;
        e.fingers = w.gesture_fingers;
        e.detail = ie.CANCELLED;
        _push(w, &e, cast(*u8, 0), 0);
        w.gesture_kind = 0;
    }
    if (w.swipe != 0) { _send(w, w.swipe, 0, cast(*u8, 0), 0, 0 - 1); }
    if (w.pinch != 0) { _send(w, w.pinch, 0, cast(*u8, 0), 0, 0 - 1); }
    if (w.hold != 0) { _send(w, w.hold, 0, cast(*u8, 0), 0, 0 - 1); }
    w.swipe = 0; w.pinch = 0; w.hold = 0;
}

// begin (serial, time, surface, fingers) on this surface starts one; its
// updates — a swipe's motion, a pinch's motion, scale and rotation — and its
// end (serial, time, cancelled) are said while it goes on.
fn _gesture_event(w as *Window, obj as i32, op as i32, p as *u8) as void {
    let is i32 as kind with mut = ie.SWIPE;
    if (obj == w.pinch) { kind = ie.PINCH; }
    if (obj == w.hold) { kind = ie.HOLD; }
    if (op == 0) {
        if (_wire_size < 24 || cast(i32, _word(cast(*u8, cast(i64, p) + 8))) != w.surface) { return; }
        w.gesture_kind = kind;
        w.gesture_fingers = cast(i32, _word(cast(*u8, cast(i64, p) + 12)));
        let is ie.Event as e = _input(w, ie.GESTURE_BEGIN);
        e.gesture = kind;
        e.fingers = w.gesture_fingers;
        e.x = w.pointer_x;
        e.y = w.pointer_y;
        e.time_ms = cast(i64, _word(cast(*u8, cast(i64, p) + 4)));
        _push(w, &e, cast(*u8, 0), 0);
        return;
    }
    if (w.gesture_kind != kind) { return; }
    let is i32 as ending = cast(i32, (kind == ie.HOLD && op == 1) || (kind != ie.HOLD && op == 2));
    if (ending == 1) {
        if (_wire_size < 20) { return; }
        let is ie.Event as e = _input(w, ie.GESTURE_END);
        e.gesture = kind;
        e.fingers = w.gesture_fingers;
        e.x = w.pointer_x;
        e.y = w.pointer_y;
        e.time_ms = cast(i64, _word(cast(*u8, cast(i64, p) + 4)));
        if (_word(cast(*u8, cast(i64, p) + 8)) != 0) { e.detail = ie.CANCELLED; }
        _push(w, &e, cast(*u8, 0), 0);
        w.gesture_kind = 0;
        return;
    }
    if (op != 1 || kind == ie.HOLD) { return; }
    if (_wire_size < 20 || (kind == ie.PINCH && _wire_size < 28)) { return; }
    let is ie.Event as e = _input(w, ie.GESTURE_UPDATE);
    e.gesture = kind;
    e.fingers = w.gesture_fingers;
    e.x = w.pointer_x;
    e.y = w.pointer_y;
    e.time_ms = cast(i64, _word(p));
    // In the window's pixels, as positions are: the surface's units scaled.
    e.dx = cast(f64, cast(i32, _word(cast(*u8, cast(i64, p) + 4)))) / 256.0 * cast(f64, w.scale120) / 120.0;
    e.dy = cast(f64, cast(i32, _word(cast(*u8, cast(i64, p) + 8)))) / 256.0 * cast(f64, w.scale120) / 120.0;
    if (kind == ie.PINCH) {
        e.scale = cast(f64, cast(i32, _word(cast(*u8, cast(i64, p) + 12)))) / 256.0;
        e.rotation = cast(f64, cast(i32, _word(cast(*u8, cast(i64, p) + 16)))) / 256.0;
    }
    _push(w, &e, cast(*u8, 0), 0);
}
fn _reap_retired(w as *Window) as void {
    let is i32 as i with mut = 0;
    let is [0]u8 as empty;
    while (i < RETIRED_COUNT) {
        if (w.retired[i].used == 1 && w.retired[i].buffers[0].busy == 0 &&
            w.retired[i].buffers[1].busy == 0) {
            if (w.retired[i].buffers[0].object != 0) {
                _send(w, w.retired[i].buffers[0].object, 0, &empty[0], 0, 0 - 1);
            }
            if (w.retired[i].buffers[1].object != 0) {
                _send(w, w.retired[i].buffers[1].object, 0, &empty[0], 0, 0 - 1);
            }
            if (cast(i64, w.retired[i].pixels) != 0) {
                linux.munmap(w.retired[i].pixels, w.retired[i].bytes * BUFFER_COUNT);
            }
            mem.memzero(cast(*u8, &w.retired[i]), sizeof(BufferSet));
        }
        i = i + 1;
    }
}

fn _retire_current(w as *Window) as i32 {
    _reap_retired(w);
    let is i32 as slot with mut = 0;
    while (slot < RETIRED_COUNT && w.retired[slot].used == 1) { slot = slot + 1; }
    if (slot >= RETIRED_COUNT) { return 0; }
    w.retired[slot].pixels = w.pixels;
    w.retired[slot].bytes = w.bytes;
    w.retired[slot].buffers[0] = w.buffers[0];
    w.retired[slot].buffers[1] = w.buffers[1];
    w.retired[slot].used = 1;
    w.pixels = cast(*u8, 0);
    w.bytes = 0; w.stride = 0; w.buffer_width = 0; w.buffer_height = 0;
    w.buffers[0].object = 0; w.buffers[0].busy = 0;
    w.buffers[1].object = 0; w.buffers[1].busy = 0;
    w.current = 0 - 1; w.last_buffer = 0 - 1;
    return 1;
}


fn _dispatch(w as *Window, obj as i32) as void {
    let is u32 as h = _word(&_wire[4]);
    let is i32 as op = cast(i32, h & 65535);
    let is *u8 as p = &_wire[8];
    if (obj == 1 && op == 0) { w.err = NO_COMPOSITOR; w.opened = 0; return; }
    
    if (obj == w.registry && op == 0) { _registry_global(); return; }
    if (obj == w.surface && (op == 0 || op == 1)) {
        _surface_output(w, cast(i32, _word(p)), cast(i32, op == 0));
        return;
    }
    let is i32 as output_i with mut = 0;
    while (output_i < w.output_count) {
        if (obj == w.outputs[output_i].object) {
            _output_event(w, obj, op, p);
            return;
        }
        output_i = output_i + 1;
    }
    if (obj == w.fractional_surface && op == 0 && w.fractional_active == 1) {
        _set_scale120(w, cast(i32, _word(p)), 1);
        return;
    }
    if (obj == w.token_object && obj != 0 && op == 0) { _token_done(w, p); return; }
    if (obj == w.exported && obj != 0 && op == 0) { _export_said(w, p); return; }
    if (obj == w.presentation && obj != 0 && op == 0) { _globals.presentation_clock = cast(i32, _word(p)); return; }
    if (_feedback_index(w, obj) >= 0) { _feedback_event(w, _feedback_index(w, obj), op, p); return; }
    if (obj == w.data_device) { _data_device_event(w, op, p); return; }
    if (obj == w.primary_device) { _primary_device_event(w, op, p); return; }
    if (obj == w.text_input) { _text_input_event(w, op, p); return; }
    if (_offer_index(w, obj, 0, 0) >= 0) { _data_offer_event(w, obj, op, p); return; }
    if (_source_index(w, obj) >= 0) { _source_event(w, obj, op, p); return; }
    if (obj == w.seat && op == 0) { _seat_capabilities(w, _word(p)); return; }
    if (obj == w.keyboard) { _keyboard_event(w, op, p); return; }
    if (obj == w.pointer) { _pointer_event(w, op, p); return; }
    if (obj == w.touch) { _touch_event(w, op, p); return; }
    if (obj == w.tablet_seat) { _tablet_seat_event(w, op, p); return; }
    if (obj != 0 && (obj == w.swipe || obj == w.pinch || obj == w.hold)) { _gesture_event(w, obj, op, p); return; }
    if (_tool_index(w, obj) >= 0) { _tool_event(w, _tool_index(w, obj), op, p); return; }
    if (_tablet_index(w, obj) >= 0) { _tablet_event(w, _tablet_index(w, obj), op); return; }
    if (obj == w.registry_sync && op == 0) { w.registry_sync = 0; w.acked = 1; return; }
    if (obj == w.wm_base && op == 0) {
        let is [4]u8 as b;
        _put(&b[0], _word(p));
        _send(w, w.wm_base, 3, &b[0], 4, 0 - 1);
        return;
    }
    if (obj == w.xdg_surface && op == 0) {
        let is [4]u8 as b;
        _put(&b[0], _word(p));
        _send(w, w.xdg_surface, 4, &b[0], 4, 0 - 1);
        w.acked = 2;
        return;
    }
    if (obj == w.toplevel && op == 0) {
        let is i32 as nw = cast(i32, _word(p));
        let is i32 as nh = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
        // Zero means the client chooses this axis; do not keep maximized size.
        w.configured_width = nw;
        w.configured_height = nh;
        let is i32 as bytes = cast(i32, _word(cast(*u8, cast(i64, p) + 8)));
        if (bytes >= 0 && (bytes & 3) == 0 && 20 + bytes <= _wire_size) {
            let is i32 as count = bytes / 4;
            let is i32 as i with mut = 0;
            let is i32 as state with mut = 0;
            while (i < count) {
                let is u32 as s = _word(cast(*u8, cast(i64, p) + 12 + i * 4));
                if (s == 1) { state = state | event.STATE_MAXIMIZED; }
                if (s == 2) { state = state | event.STATE_FULLSCREEN; }
                if (s == 5) { state = state | event.STATE_TILED_LEFT; }
                if (s == 6) { state = state | event.STATE_TILED_RIGHT; }
                if (s == 7) { state = state | event.STATE_TILED_TOP; }
                if (s == 8) { state = state | event.STATE_TILED_BOTTOM; }
                // xdg_toplevel 6: not shown — minimized, or as good as.
                if (s == 9) { state = state | event.STATE_MINIMIZED; }
                i = i + 1;
            }
            // The size it had as a normal window, kept while it is not one;
            // shown or not is no part of that.
            if (_floating(w.state) == 1 && _floating(state) == 0) {
                w.normal_width = w.logical_width;
                w.normal_height = w.logical_height;
            }
            w.state = state;
        }
        return;
    }
    if (obj == w.xdg_popup && w.xdg_popup != 0 && op == 0) {
        w.popup_x = cast(i32, _word(p));
        w.popup_y = cast(i32, _word(cast(*u8, cast(i64, p) + 4)));
        w.configured_width = cast(i32, _word(cast(*u8, cast(i64, p) + 8)));
        w.configured_height = cast(i32, _word(cast(*u8, cast(i64, p) + 12)));
        return;
    }
    if (obj == w.xdg_popup && w.xdg_popup != 0 && op == 1) {
        w.popup_done = 1;
        _event(w, event.POPUP_DONE);
        return;
    }
    if (obj == w.xdg_popup && w.xdg_popup != 0 && op == 2) { return; }
    if (obj == w.toplevel && op == 1) {
        w.close_requested = 1;
        _event(w, event.CLOSE);
        return;
    }
    if (obj == w.toplevel_decoration && op == 0) {
        w.server_decorated = cast(i32, _word(p) == 2);
        return;
    }
    if (obj == w.surface && op == 0) { return; }
    if (obj == w.callback && op == 0) {
        w.callback = 0;
        w.frame_ready = 1;
        return;
    }
    if ((obj == w.buffers[0].object || obj == w.buffers[1].object) && op == 0) {
        if (obj == w.buffers[0].object) { w.buffers[0].busy = 0; }
        if (obj == w.buffers[1].object) { w.buffers[1].busy = 0; }
        w.frame_ready = 1;
        return;
    }
    let is i32 as i with mut = 0;
    while (i < RETIRED_COUNT) {
        if (w.retired[i].used == 1 && op == 0) {
            if (obj == w.retired[i].buffers[0].object) {
                w.retired[i].buffers[0].busy = 0; w.frame_ready = 1;
            }
            if (obj == w.retired[i].buffers[1].object) {
                w.retired[i].buffers[1].busy = 0; w.frame_ready = 1;
            }
        }
        i = i + 1;
    }
    _reap_retired(w);
}

fn _pump_one(w as *Window, wait as i32) as i32 {
    if (wait == 1) {
        // A transfer under way: back soon to move it on.
        let is i64 as timeout with mut = 5000;
        if (_transferring(w) == 1) { timeout = 10; }
        if (sys.wait_readable(w.fd, timeout) <= 0) {
            if (_transferring(w) == 0) { return 0; }
            _transfers(w);
            return 2;
        }
    } else if (sys.wait_readable(w.fd, 0) <= 0) { return 0; }
    let is i32 as obj = _recv(w);
    if (obj == 0) { _close_recv_fds(); return 0; }
    if (obj == 1 && (_word(&_wire[4]) & 65535) == 1 && _wire_size == 12) {
        _release_object(cast(i32, _word(&_wire[8])));
        return 1;
    }
    let is i32 as op = cast(i32, _word(&_wire[4]) & 65535);
    if (obj >= 2 && obj < MAX_OBJECTS && cast(i64, _objects[obj].owner) == 0 &&
        _objects[obj].fd_opcode == op) {
        let is i64 as abandoned = _take_recv_fd();
        if (abandoned >= 0) { linux.close(abandoned); }
        return 1;
    }
    let is *Window as target with mut = w;
    if (obj >= 2 && obj < MAX_OBJECTS && cast(i64, _objects[obj].owner) != 0) {
        target = _objects[obj].owner;
    } else if (cast(u32, obj) >= 0xff000000) {
        let is i32 as i with mut = 0;
        while (i < MAX_WINDOWS) {
            let is *Window as candidate = _windows[i];
            if (cast(i64, candidate) != 0 &&
                (_offer_index(candidate, obj, 0, 0) >= 0 || _offer_index(candidate, obj, 1, 0) >= 0 ||
                 _tool_index(candidate, obj) >= 0 || _tablet_index(candidate, obj) >= 0)) {
                target = candidate; break;
            }
            i = i + 1;
        }
    }
    _dispatch(target, obj);
    return 1;
}

fn _send_string(w as *Window, object as i32, opcode as i32, text as *u8) as i32 {
    let is [2048]u8 as p;
    let is i32 as len with mut = 1;
    while (text[len - 1] != 0 && len < 2000) { len = len + 1; }
    if (len >= 2000) { return 0; }
    _put(&p[0], cast(u32, len));
    let is i32 as padded = ((len + 3) / 4) * 4;
    mem.memcpy(&p[4], text, len);
    if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[4]) + len), 0, padded - len); }
    return _send(w, object, opcode, &p[0], 4 + padded, 0 - 1);
}
fn _send_string_n(w as *Window, object as i32, opcode as i32, text as *u8, n as i64) as i32 {
    if (n < 0 || n >= 2000) { return 0; }
    let is [2048]u8 as p;
    let is i64 as len = n + 1;
    _put(&p[0], cast(u32, len));
    if (n > 0) { mem.memcpy(&p[4], text, n); }
    p[4 + n] = 0;
    let is i64 as padded = ((len + 3) / 4) * 4;
    if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[4]) + len), 0, padded - len); }
    return _send(w, object, opcode, &p[0], cast(i32, 4 + padded), 0 - 1);
}
fn _send_string_fd(w as *Window, object as i32, opcode as i32, text as *u8, fd as i64) as i32 {
    let is [256]u8 as p;
    let is i32 as len with mut = 1;
    while (text[len - 1] != 0 && len < 240) { len = len + 1; }
    if (len >= 240) { return 0; }
    _put(&p[0], cast(u32, len));
    let is i32 as padded = ((len + 3) / 4) * 4;
    mem.memcpy(&p[4], text, len);
    if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[4]) + len), 0, padded - len); }
    return _send(w, object, opcode, &p[0], 4 + padded, fd);
}

// Every transfer moved on as far as it can now: what is read read, what is
// written written.
fn _transfers(w as *Window) as void {
    _readers(w);
    _writers(w);
}

// Both readers and every writer stopped, their descriptors closed.
fn _transfers_end(w as *Window) as void {
    _read_cancel(w, PASTE);
    _read_cancel(w, DROP);
    transfer.bytes_free(&w.reading[PASTE].data);
    transfer.bytes_free(&w.reading[DROP].data);
    let is i32 as k with mut = 0;
    while (k < MAX_WRITERS) {
        _write_end(w, k);
        transfer.bytes_free(&w.writing[k].data);
        k = k + 1;
    }
    transfer.bytes_free(&w.drop_paths);
    transfer.bytes_free(&w.drop_text);
    w.paste_state = _PASTE_IDLE;
}

// --- The clipboard and the primary selection ---

// The selection which (0 the clipboard, 1 the primary) ours, with what o
// offers (copied), under the last input's serial: 1, or 0 when there is no
// such selection here or no input yet to own it by.
fn clipboard_set(w as *Window, which as i32, o as *transfer.Offer) as i32 {
    if (w.opened == 0 || (which != 0 && which != 1) || w.input_serial == 0) { return 0; }
    let is i32 as device with mut = w.data_device;
    let is i32 as purpose with mut = _FOR_CLIPBOARD;
    if (which == 1) { device = w.primary_device; purpose = _FOR_PRIMARY; }
    if (device == 0) { return 0; }
    let is i32 as index = _source_new(w, purpose, o);
    if (index < 0) { return 0; }
    let is i32 as object = w.sources[index].object;
    let is [8]u8 as p;
    _put(&p[0], cast(u32, object));
    _put(&p[4], w.input_serial);
    let is i32 as opcode with mut = 1;
    if (which == 1) { opcode = 0; }
    if (_send(w, device, opcode, &p[0], 8, 0 - 1) == 0) {
        _source_release(w, index, 1);
        return 0;
    }
    // The one before: the compositor cancels it, which lets it go.
    w.selection_source[which] = object;
    return 1;
}

// The selection which asked for as format — transfer.TEXT, PNG, or 0 for
// which formats it offers — what came before forgotten. It arrives as the
// pump runs (clipboard_ready); at once when the selection is ours, or has
// none of it. 1 when asked.
fn clipboard_request(w as *Window, which as i32, format as i32) as i32 {
    if (w.opened == 0 || (which != 0 && which != 1)) { return 0; }
    if (format != 0 && format != transfer.TEXT && format != transfer.PNG) { return 0; }
    let is i32 as device with mut = w.data_device;
    if (which == 1) { device = w.primary_device; }
    if (device == 0) { return 0; }
    _read_cancel(w, PASTE);
    let is *Reader as r = &w.reading[PASTE];
    transfer.bytes_clear(&r.data);
    w.paste_state = _PASTE_READY;
    w.paste_got = 0;
    w.paste_offered = 0;
    // Ours: what we offer, as it is.
    let is i32 as source_i = _source_index(w, w.selection_source[which]);
    if (source_i >= 0) {
        let is *transfer.Offer as o = &w.sources[source_i].offer;
        w.paste_offered = o.formats & (transfer.TEXT | transfer.PNG);
        if (format != 0 && (o.formats & format) != 0) {
            let is *transfer.Bytes as b = transfer.offer_bytes(o, format);
            if (transfer.bytes_set(&r.data, b.data, b.len) == 1) { w.paste_got = format; }
        }
        return 1;
    }
    let is i32 as offer_i = _offer_index(w, w.selection_offer[which], which, 0);
    if (w.selection_offer[which] == 0 || offer_i < 0) { return 1; }
    w.paste_offered = w.offers[offer_i].formats & (transfer.TEXT | transfer.PNG);
    if (format == 0 || (w.offers[offer_i].formats & format) == 0) { return 1; }
    if (_read_start(w, PASTE, offer_i, format) == 0) { return 0; }
    w.paste_state = _PASTE_PENDING;
    return 1;
}

// Whether what was asked for came (then clipboard_format and the rest have it).
fn clipboard_ready(w as *Window) as i32 {
    _readers(w);
    return cast(i32, w.paste_state == _PASTE_READY);
}

// Whether an answer is still awaited.
fn clipboard_pending(w as *Window) as i32 {
    _readers(w);
    return cast(i32, w.paste_state == _PASTE_PENDING);
}

// The format that came — what was asked, 0 for none — and its bytes.
fn clipboard_format(w as *Window) as i32 {
    if (w.paste_state != _PASTE_READY) { return 0; }
    return w.paste_got;
}
fn clipboard_data(w as *Window) as *u8 {
    if (w.paste_state != _PASTE_READY || w.paste_got == 0) { return cast(*u8, 0); }
    return w.reading[PASTE].data.data;
}
fn clipboard_length(w as *Window) as i64 {
    if (w.paste_state != _PASTE_READY || w.paste_got == 0) { return 0; }
    return w.reading[PASTE].data.len;
}
// The formats the selection offered when it was asked for.
fn clipboard_offered(w as *Window) as i32 {
    if (w.paste_state != _PASTE_READY) { return 0; }
    return w.paste_offered;
}

// --- Drag and drop ---

// What the program takes of the drag over the window where the pointer is
// (transfer.FILES, TEXT, 0) and how (transfer.COPY, MOVE; 0 for either, a
// copy preferred — the compositor itself makes it a move while Shift is
// held, the keyboard its during a drag): told the compositor at once. 1 when
// a drag is there.
fn drop_answer(w as *Window, takes as i32, action as i32) as i32 {
    if (w.opened == 0 || w.drop_offer == 0 || w.drop_pending == 1) { return 0; }
    w.drop_answer = takes & w.drop_offered;
    w.drop_want_action = action & (transfer.COPY | transfer.MOVE);
    _drop_accept(w);
    return 1;
}

fn dropped_files(w as *Window) as i64 {
    if (w.drop_ready == 0 || w.drop_kind != transfer.FILES) { return 0; }
    return w.drop_count;
}

fn dropped_file(w as *Window, i as i64) as *u8 {
    if (w.drop_ready == 0 || w.drop_kind != transfer.FILES) { return cast(*u8, 0); }
    return transfer.path_at(&w.drop_paths, w.drop_count, i);
}

fn dropped_text(w as *Window) as *u8 {
    if (w.drop_ready == 0 || w.drop_kind != transfer.TEXT || w.drop_text.len == 0) { return cast(*u8, 0); }
    return w.drop_text.data;
}

fn dropped_text_length(w as *Window) as i64 {
    if (w.drop_ready == 0 || w.drop_kind != transfer.TEXT) { return 0; }
    return w.drop_text.len;
}

fn clear_drop(w as *Window) as void {
    w.drop_ready = 0; w.drop_count = 0; w.drop_kind = 0;
    transfer.bytes_clear(&w.drop_paths);
    transfer.bytes_clear(&w.drop_text);
}

// A drag of what o offers out of the window, the actions allowed
// (transfer.COPY, MOVE), from the press of a button still held: the
// compositor runs it, and its end is a DRAG_DONE event with the action the
// target did, 0 for none. 1 when it began.
fn drag_begin(w as *Window, o as *transfer.Offer, actions as i32) as i32 {
    return drag_begin_carrying(w, o, actions, cast(*Window, 0), 0, 0);
}

// The same, carried's toplevel moving with the pointer while it lasts, the
// pointer at x_off, y_off of it (logical) — a tab torn off into a window of
// its own (xdg-toplevel-drag): left where the drag ends. 0 without the
// toplevel drag manager when a toplevel is to be carried.
fn drag_begin_carrying(w as *Window, o as *transfer.Offer, actions as i32, carried as *Window, x_off as i64, y_off as i64) as i32 {
    if (w.opened == 0 || w.data_device == 0 || w.grab_serial == 0 || w.drag_source != 0 ||
        (actions & (transfer.COPY | transfer.MOVE)) == 0) { return 0; }
    if (cast(i64, carried) != 0 && (w.toplevel_drag_manager == 0 || carried.toplevel == 0)) { return 0; }
    let is i32 as held with mut = 0;
    let is i32 as b with mut = 1;
    while (b < 8) { held = held + w.pointer_buttons[b]; b = b + 1; }
    if (held == 0) { return 0; }
    let is i32 as index = _source_new(w, _FOR_DRAG, o);
    if (index < 0) { return 0; }
    let is i32 as object = w.sources[index].object;
    let is [16]u8 as p;
    if (_bounded(_globals.data_manager_version, 3) >= 3) {
        _put(&p[0], cast(u32, actions & (transfer.COPY | transfer.MOVE)));
        _send(w, object, 2, &p[0], 4, 0 - 1);
    }
    if (cast(i64, carried) != 0) {
        w.toplevel_drag = _id(w);
        _put(&p[0], cast(u32, w.toplevel_drag)); _put(&p[4], cast(u32, object));
        _send(w, w.toplevel_drag_manager, 1, &p[0], 8, 0 - 1);
        _put(&p[0], cast(u32, carried.toplevel)); _put(&p[4], cast(u32, x_off)); _put(&p[8], cast(u32, y_off));
        _send(w, w.toplevel_drag, 1, &p[0], 12, 0 - 1);
    }
    _put(&p[0], cast(u32, object)); _put(&p[4], cast(u32, w.surface)); _put(&p[8], 0); _put(&p[12], w.grab_serial);
    if (_send(w, w.data_device, 0, &p[0], 16, 0 - 1) == 0) { _source_release(w, index, 1); return 0; }
    w.drag_source = object;
    // The compositor has the pointer from here: the release is its, so the
    // input says every held button is up, taken.
    b = 1;
    while (b < 8) {
        if (w.pointer_buttons[b] == 1) {
            w.pointer_buttons[b] = 0;
            let is ie.Event as up = _input(w, ie.BUTTON_UP);
            up.button = b;
            up.detail = ie.BUTTON_TAKEN;
            up.x = w.pointer_x;
            up.y = w.pointer_y;
            _push(w, &up, cast(*u8, 0), 0);
        }
        b = b + 1;
    }
    return 1;
}

fn _runtime_socket(w as *Window) as i32 {
    if (_connection_fd >= 0) { w.fd = _connection_fd; return _attach(w); }
    let is *u8 as display with mut = env.getenv("WAYLAND_DISPLAY");
    let is *u8 as runtime = env.getenv("XDG_RUNTIME_DIR");
    if (cast(i64, display) == 0 || display[0] == 0) { display = "wayland-0"; }
    if (cast(i64, runtime) == 0) { return 0; }
    let is [256]u8 as path;
    let is i32 as n with mut = 0;
    if (display[0] == cast(u8, 47)) {
        while (display[n] != 0 && n < 240) { path[n] = display[n]; n = n + 1; }
    } else {
        while (runtime[n] != 0 && n < 180) { path[n] = runtime[n]; n = n + 1; }
        if (n == 0 || n >= 180) { return 0; }
        path[n] = cast(u8, 47); n = n + 1;
        let is i32 as j with mut = 0;
        while (display[j] != 0 && j < 64) { path[n] = display[j]; n = n + 1; j = j + 1; }
        if (display[j] != 0) { return 0; }
    }
    if (n <= 0 || n >= 240) { return 0; }
    path[n] = 0;
    w.fd = sys.connect_unix(&path[0], n, 0);
    if (w.fd < 0) { return 0; }
    _connection_fd = w.fd;
    // Clipboards and drops are written to other programs' pipes: one that
    // went away is an error to see, not a signal that ends this one.
    sys.ignore_sigpipe();
    return _attach(w);
}

// A positioner made from pos — the popup's own size w by h, logical — and
// its id; 0 when it could not be sent.
fn _positioner(w as *Window, pos as *Options, pw as i64, ph as i64) as i32 {
    let is i32 as id = _id(w);
    if (id == 0) { return 0; }
    let is [16]u8 as b;
    _put(&b[0], cast(u32, id));
    if (_send(w, w.wm_base, 1, &b[0], 4, 0 - 1) == 0) { return 0; }
    _put(&b[0], cast(u32, pw)); _put(&b[4], cast(u32, ph));
    if (_send(w, id, 1, &b[0], 8, 0 - 1) == 0) { return 0; }
    let is i32 as aw with mut = pos.anchor_w;
    let is i32 as ah with mut = pos.anchor_h;
    if (aw < 1) { aw = 1; }
    if (ah < 1) { ah = 1; }
    _put(&b[0], cast(u32, pos.anchor_x)); _put(&b[4], cast(u32, pos.anchor_y));
    _put(&b[8], cast(u32, aw)); _put(&b[12], cast(u32, ah));
    if (_send(w, id, 2, &b[0], 16, 0 - 1) == 0) { return 0; }
    _put(&b[0], cast(u32, pos.anchor));
    if (_send(w, id, 3, &b[0], 4, 0 - 1) == 0) { return 0; }
    _put(&b[0], cast(u32, pos.gravity));
    if (_send(w, id, 4, &b[0], 4, 0 - 1) == 0) { return 0; }
    _put(&b[0], cast(u32, pos.adjust));
    if (_send(w, id, 5, &b[0], 4, 0 - 1) == 0) { return 0; }
    _put(&b[0], cast(u32, pos.off_x)); _put(&b[4], cast(u32, pos.off_y));
    if (_send(w, id, 6, &b[0], 8, 0 - 1) == 0) { return 0; }
    return id;
}

// The wl_subsurface role, of the parent surface, at its place. A subsurface
// has no configure: its size is the one asked, at the parent's scale.
fn _init_subsurface(w as *Window) as i32 {
    if (_globals.subcompositor_global == 0) { return 0; }
    w.subcompositor = _binding(w, cast(u32, _globals.subcompositor_global), "wl_subcompositor", 1);
    if (w.subcompositor == 0) { return 0; }
    w.subsurface = _id(w);
    let is [12]u8 as b;
    _put(&b[0], cast(u32, w.subsurface)); _put(&b[4], cast(u32, w.surface)); _put(&b[8], cast(u32, w.pos.subsurface_of));
    if (_send(w, w.subcompositor, 1, &b[0], 12, 0 - 1) == 0) { return 0; }
    _put(&b[0], cast(u32, w.pos.sub_x)); _put(&b[4], cast(u32, w.pos.sub_y));
    if (_send(w, w.subsurface, 1, &b[0], 8, 0 - 1) == 0) { return 0; }
    w.sub_sync = 1;
    _set_scale120(w, w.pos.sub_scale120, w.pos.sub_scale);
    w.logical_width = w.width;
    w.logical_height = w.height;
    w.width = _scale_up(w.logical_width, w.scale120);
    w.height = _scale_up(w.logical_height, w.scale120);
    w.acked = 2;
    w.resized = 0;
    return 1;
}

// The xdg_popup role on the xdg_surface: of the parent's, placed by the
// positioner, with the seat's grab when asked — before the first commit, as
// the protocol wants it.
fn _init_popup(w as *Window) as i32 {
    let is i32 as pos = _positioner(w, &w.pos, w.width, w.height);
    if (pos == 0) { return 0; }
    let is [12]u8 as b;
    w.xdg_popup = _id(w);
    _put(&b[0], cast(u32, w.xdg_popup)); _put(&b[4], cast(u32, w.pos.parent_surface)); _put(&b[8], cast(u32, pos));
    if (_send(w, w.xdg_surface, 2, &b[0], 12, 0 - 1) == 0) { return 0; }
    if (w.pos.grab == 1 && w.seat != 0) {
        _put(&b[0], cast(u32, w.seat)); _put(&b[4], w.pos.serial);
        if (_send(w, w.xdg_popup, 1, &b[0], 8, 0 - 1) == 0) { return 0; }
        if (_ngrabbers < 16) {
            _grabbers[_ngrabbers] = w;
            _ngrabbers = _ngrabbers + 1;
        }
    }
    let is [0]u8 as empty;
    return _send(w, pos, 0, &empty[0], 0, 0 - 1);
}

fn _init_protocol(w as *Window, title as *u8, app_id as *u8) as i32 {
    let is [8]u8 as idbody;
    if (_registry == 0) {
        _registry = _id(w);
        _put(&idbody[0], cast(u32, _registry));
        if (_send(w, 1, 1, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    }
    w.registry = _registry;
    w.registry_sync = _id(w);
    _put(&idbody[0], cast(u32, w.registry_sync));
    if (_send(w, 1, 0, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    let is i32 as waited with mut = 0;
    while (w.acked == 0 && waited < 200) {
        if (_pump_one(w, 1) == 0) { return 0; }
        waited = waited + 1;
    }
    if (_globals.compositor_global == 0 || _globals.shm_global == 0 || _globals.shell_global == 0) { return 0; }
    w.compositor = _binding(w, cast(u32, _globals.compositor_global), "wl_compositor", _bounded(_globals.compositor_version, 4));
    w.shm = _binding(w, cast(u32, _globals.shm_global), "wl_shm", 1);
    w.wm_base = _binding(w, cast(u32, _globals.shell_global), "xdg_wm_base", _bounded(_globals.shell_version, 6));
    if (w.compositor == 0 || w.shm == 0 || w.wm_base == 0) { return 0; }
    if (_globals.seat_global != 0) {
        w.seat = _id(w);
        // 9: axis_value120 (8) and axis_relative_direction; not 10, whose
        // keyboard repeats keys itself — the repeat here is this client's.
        w.seat_version = _bounded(_globals.seat_version, 9);
        if (_bind(w, cast(u32, _globals.seat_global), "wl_seat", w.seat_version, w.seat) == 0) { return 0; }
    }
    w.output_count = _globals.output_count;
    let is i32 as output_i with mut = 0;
    while (output_i < w.output_count) {
        w.outputs[output_i].global = _globals.outputs[output_i].global;
        w.outputs[output_i].version = _globals.outputs[output_i].version;
        w.outputs[output_i].scale = 1;
        w.outputs[output_i].entered = 0;
        w.outputs[output_i].x = 0;
        w.outputs[output_i].y = 0;
        w.outputs[output_i].mode_width = 0;
        w.outputs[output_i].mode_height = 0;
        w.outputs[output_i].refresh_mhz = 0;
        w.outputs[output_i].name[0] = cast(u8, 0);
        w.outputs[output_i].object = _id(w);
        if (_bind(w, cast(u32, w.outputs[output_i].global), "wl_output",
                    _bounded(w.outputs[output_i].version, 4), w.outputs[output_i].object) == 0) { return 0; }
        output_i = output_i + 1;
    }
    if (_globals.viewporter_global != 0 && _globals.fractional_global != 0) {
        w.viewporter = _binding(w, cast(u32, _globals.viewporter_global), "wp_viewporter", _bounded(_globals.viewporter_version, 1));
        w.fractional_manager = _binding(w, cast(u32, _globals.fractional_global), "wp_fractional_scale_manager_v1", _bounded(_globals.fractional_version, 1));
        if (w.viewporter == 0 || w.fractional_manager == 0) { return 0; }
    }
    if (_globals.decoration_global != 0) {
        w.decoration_manager = _binding(w, cast(u32, _globals.decoration_global), "zxdg_decoration_manager_v1", _bounded(_globals.decoration_version, 2));
        if (w.decoration_manager == 0) { return 0; }
    }
    if (_globals.dialog_global != 0) {
        w.dialog_manager = _binding(w, cast(u32, _globals.dialog_global), "xdg_wm_dialog_v1", _bounded(_globals.dialog_version, 1));
        if (w.dialog_manager == 0) { return 0; }
    }
    if (_globals.cursor_shape_global != 0) {
        w.cursor_shape_manager = _binding(w, cast(u32, _globals.cursor_shape_global), "wp_cursor_shape_manager_v1", _bounded(_globals.cursor_shape_version, 1));
        if (w.cursor_shape_manager == 0) { return 0; }
    }
    if (_globals.data_manager_global != 0) {
        w.data_manager = _binding(w, cast(u32, _globals.data_manager_global), "wl_data_device_manager", _bounded(_globals.data_manager_version, 3));
        if (w.data_manager == 0) { return 0; }
    }
    if (_globals.primary_manager_global != 0) {
        w.primary_manager = _binding(w, cast(u32, _globals.primary_manager_global), "zwp_primary_selection_device_manager_v1", _bounded(_globals.primary_manager_version, 1));
        if (w.primary_manager == 0) { return 0; }
    }
    if (_globals.text_input_manager_global != 0) {
        w.text_input_manager = _binding(w, cast(u32, _globals.text_input_manager_global), "zwp_text_input_manager_v3", _bounded(_globals.text_input_manager_version, 1));
        if (w.text_input_manager == 0) { return 0; }
    }
    if (w.seat != 0 && w.data_manager != 0) {
        w.data_device = _id(w);
        _put(&idbody[0], cast(u32, w.data_device));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (_send(w, w.data_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    if (w.seat != 0 && w.primary_manager != 0) {
        w.primary_device = _id(w);
        _put(&idbody[0], cast(u32, w.primary_device));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (_send(w, w.primary_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    if (w.seat != 0 && w.text_input_manager != 0) {
        w.text_input = _id(w);
        _put(&idbody[0], cast(u32, w.text_input));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (_send(w, w.text_input_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    // Pens: the seat's tablets and tools, said as they come (version 1:
    // what pens say; later versions add pads' dials).
    if (w.seat != 0 && _globals.tablet_manager_global != 0) {
        w.tablet_manager = _binding(w, cast(u32, _globals.tablet_manager_global), "zwp_tablet_manager_v2", 1);
        if (w.tablet_manager == 0) { return 0; }
        w.tablet_seat = _id(w);
        _put(&idbody[0], cast(u32, w.tablet_seat));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (_send(w, w.tablet_manager, 0, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    // Touchpad gestures: swipe and pinch (1), hold (3).
    if (w.seat != 0 && _globals.gestures_global != 0) {
        w.gestures_version = _bounded(_globals.gestures_version, 3);
        w.gestures = _binding(w, cast(u32, _globals.gestures_global), "zwp_pointer_gestures_v1", w.gestures_version);
        if (w.gestures == 0) { return 0; }
        _gesture_objects(w);
    }
    // The optional protocols the window's calls use where the compositor has
    // them (activation, exporting, the icon, presentation times, one-pixel
    // buffers, the bell, toplevel drags); without one, what uses it answers
    // 0.
    if (_globals.activation_global != 0) {
        w.activation = _binding(w, cast(u32, _globals.activation_global), "xdg_activation_v1", 1);
    }
    if (_globals.exporter_global != 0) {
        w.exporter = _binding(w, cast(u32, _globals.exporter_global), "zxdg_exporter_v2", 1);
    }
    if (_globals.icon_global != 0) {
        w.icon_manager = _binding(w, cast(u32, _globals.icon_global), "xdg_toplevel_icon_manager_v1", 1);
    }
    if (_globals.presentation_global != 0) {
        w.presentation = _binding(w, cast(u32, _globals.presentation_global), "wp_presentation", 1);
    }
    if (_globals.single_pixel_global != 0) {
        w.single_pixel = _binding(w, cast(u32, _globals.single_pixel_global), "wp_single_pixel_buffer_manager_v1", 1);
    }
    if (_globals.bell_global != 0) {
        w.bell = _binding(w, cast(u32, _globals.bell_global), "xdg_system_bell_v1", 1);
    }
    if (_globals.toplevel_drag_global != 0) {
        w.toplevel_drag_manager = _binding(w, cast(u32, _globals.toplevel_drag_global), "xdg_toplevel_drag_manager_v1", 1);
    }
    while (_pump_one(w, 0) == 1) { }
    w.surface = _id(w);
    _put(&idbody[0], cast(u32, w.surface));
    if (_send(w, w.compositor, 0, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    // Each new id is allocated where the request that creates it is sent:
    // a server takes new ids in the order they were handed out (libwayland's
    // "not a valid new object id"), so none may be held back past another.
    if (w.viewporter != 0 && w.fractional_manager != 0) {
        w.viewport = _id(w);
        _put(&idbody[0], cast(u32, w.viewport));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.surface));
        if (_send(w, w.viewporter, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
        w.fractional_surface = _id(w);
        _put(&idbody[0], cast(u32, w.fractional_surface));
        _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.surface));
        if (_send(w, w.fractional_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
        w.fractional_active = 1;
    }
    if (w.pos.subsurface_of != 0) { return _init_subsurface(w); }
    w.xdg_surface = _id(w);
    _put(&idbody[0], cast(u32, w.xdg_surface));
    _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.surface));
    if (_send(w, w.wm_base, 2, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    if (w.popup_kind != 0) {
        if (_init_popup(w) == 0) { return 0; }
    } else {
        w.toplevel = _id(w);
        _put(&idbody[0], cast(u32, w.toplevel));
        if (_send(w, w.xdg_surface, 1, &idbody[0], 4, 0 - 1) == 0) { return 0; }
        if (w.decoration_manager != 0) {
            w.toplevel_decoration = _id(w);
            _put(&idbody[0], cast(u32, w.toplevel_decoration));
            _put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.toplevel));
            if (_send(w, w.decoration_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
            let is [4]u8 as mode;
            if (w.decorated_wanted != 0) { _put(&mode[0], 2); }
            else { _put(&mode[0], 1); }
            if (_send(w, w.toplevel_decoration, 1, &mode[0], 4, 0 - 1) == 0) { return 0; }
        }
        if (_send_string(w, w.toplevel, 2, title) == 0) { return 0; }
        if (_send_string(w, w.toplevel, 3, app_id) == 0) { return 0; }
    }
    // Request the initial configure; the xdg-shell role is not usable until
    // the compositor configures the surface and the client acknowledges it.
    if (_send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    waited = 0;
    while (w.acked != 2 && waited < 200) {
        if (_pump_one(w, 1) == 0) { return 0; }
        waited = waited + 1;
    }
    if (w.acked != 2) { return 0; }
    if (w.configured_width > 0) { w.logical_width = w.configured_width; }
    else { w.logical_width = w.width; }
    if (w.configured_height > 0) { w.logical_height = w.configured_height; }
    else { w.logical_height = w.height; }
    w.width = _scale_up(w.logical_width, w.scale120);
    w.height = _scale_up(w.logical_height, w.scale120);
    if (w.width <= 0 || w.height <= 0) { return 0; }
    w.resized = 0;
    return 1;
}

fn _make_buffers(w as *Window) as i32 {
    if (w.bytes <= 0 || w.bytes > 1073741824) { return 0; }
    w.memfd = sys.memfd_create("caustic-wayland-buffer", 1);
    if (w.memfd < 0) { return 0; }
    if (linux.ftruncate(w.memfd, w.bytes * BUFFER_COUNT) != 0) { return 0; }
    w.pixels = linux.mmap(cast(*u8, 0), w.bytes * BUFFER_COUNT, linux.PROT_READ | linux.PROT_WRITE,
                          linux.MAP_SHARED, w.memfd, 0);
    if (cast(i64, w.pixels) == linux.MAP_FAILED) { w.pixels = cast(*u8, 0); return 0; }
    w.pool = _id(w);
    let is [24]u8 as p;
    _put(&p[0], cast(u32, w.pool)); _put(&p[4], cast(u32, w.bytes * BUFFER_COUNT));
    if (_send(w, w.shm, 0, &p[0], 8, w.memfd) == 0) { return 0; }
    w.buffers[0].object = _id(w); w.buffers[1].object = _id(w);
    let is i32 as i with mut = 0;
    while (i < BUFFER_COUNT) {
        let is i64 as off = i * w.bytes;
        _put(&p[0], cast(u32, w.buffers[i].object));
        _put(cast(*u8, cast(i64, &p[0]) + 4), cast(u32, off));
        _put(cast(*u8, cast(i64, &p[0]) + 8), cast(u32, w.width));
        _put(cast(*u8, cast(i64, &p[0]) + 12), cast(u32, w.height));
        _put(cast(*u8, cast(i64, &p[0]) + 16), cast(u32, w.stride));
        _put(cast(*u8, cast(i64, &p[0]) + 20), FORMAT_ARGB8888);
        if (_send(w, w.pool, 0, &p[0], 24, 0 - 1) == 0) { return 0; }
        w.buffers[i].busy = 0;
        w.buffers[i].at = 0;
        i = i + 1;
    }
    let is [0]u8 as empty;
    if (_send(w, w.pool, 1, &empty[0], 0, 0 - 1) == 0) { return 0; }
    linux.close(w.memfd);
    w.memfd = 0 - 1;
    w.pool = 0;
    w.buffer_width = w.width; w.buffer_height = w.height;
    return 1;
}

fn _destroy_buffers(w as *Window) as void {
    let is [0]u8 as empty;
    let is i32 as i with mut = 0;
    while (i < BUFFER_COUNT) {
        if (w.buffers[i].object != 0) {
            _send(w, w.buffers[i].object, 0, &empty[0], 0, 0 - 1);
            w.buffers[i].object = 0;
        }
        i = i + 1;
    }
    if (cast(i64, w.pixels) != 0) {
        linux.munmap(w.pixels, w.bytes * BUFFER_COUNT);
        w.pixels = cast(*u8, 0);
    }
    w.last_buffer = 0 - 1;
    w.current = 0 - 1;
    w.buffer_width = 0; w.buffer_height = 0;
}

fn _discard(w as *Window) as void { close(w); }
// The caller owns the storage and keeps it at this address until close.
fn open_config(w as *Window, title as *u8, width as i64, height as i64, options as *Options) as i32 {
    _zero(w);
    let is Options as o with mut = options();
    if (cast(i64, options) != 0) { o = *options; }
    w.width = width; w.height = height; w.decorated_wanted = o.decorated;
    w.popup_kind = o.popup; w.pos = o;
    w.keymap_kind = o.keymap;
    if (o.popup != 0 && o.parent_surface == 0) { w.err = NO_CONFIGURE; return 0; }
    if (width <= 0 || height <= 0) { w.err = NO_CONFIGURE; return 0; }
    if (_protocol_ready() == 0) { w.err = NO_PROTOCOL; return 0; }
    if (_runtime_socket(w) == 0) { w.err = NO_RUNTIME; return 0; }
    // Its input's queue, there before the first event can come.
    w.input = ie.create();
    if (cast(i64, w.input) == 0) { w.err = NO_MEMORY; _discard(w); return 0; }
    if (_init_protocol(w, title, o.app_id) == 0) { w.err = NO_COMPOSITOR; _discard(w); return 0; }
    w.opened = 1;
    if (o.popup == 0 && o.parent != 0 && set_parent(w, o.parent) == 0) {
        w.err = NO_SHELL; _discard(w); return 0;
    }
    if (o.popup == 0 && o.resizable == 0) {
        if (set_min_size(w, width, height) == 0 || set_max_size(w, width, height) == 0) {
            w.err = NO_SHELL; _discard(w); return 0;
        }
    }
    if (o.popup == 0 && o.modal != 0) { set_modal(w, 1); }
    w.stride = w.width * 4; w.bytes = w.stride * w.height;
    if (_make_buffers(w) == 0) { w.err = NO_MEMORY; _discard(w); return 0; }
    let is i32 as id = _id(w);
    let is [4]u8 as p;
    _put(&p[0], cast(u32, id));
    if (_send(w, w.surface, 3, &p[0], 4, 0 - 1) == 0) { w.err = NO_SHELL; _discard(w); return 0; }
    if (_send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { w.err = NO_SHELL; _discard(w); return 0; }
    w.callback = id;
    w.err = OK; w.mapped = 0;
    return 1;
}

fn open(w as *Window, title as *u8, width as i64, height as i64) as i32 {
    let is Options as o = options();
    return open_config(w, title, width, height, &o);
}

fn error(w as *Window) as i32 { return w.err; }
fn is_open(w as *Window) as i32 { return w.opened; }
fn should_close(w as *Window) as i32 { return w.close_requested; }
fn width(w as *Window) as i64 { return w.width; }
fn height(w as *Window) as i64 { return w.height; }
fn scale(w as *Window) as i32 { return w.scale120; }
fn state(w as *Window) as i32 { return w.state; }

// The output the window is on, as wl_output says it: its place in the
// compositor's space, its mode, the window's scale there, its name. No work
// area on Wayland: the whole output. 1 once the window has entered one.
fn monitor_of(w as *Window, out as *monitor.Monitor) as i32 {
    monitor.clear(out);
    if (w.opened == 0 || w.active_output < 0) { return 0; }
    let is *Output as o = &w.outputs[w.active_output];
    out.x = cast(i64, o.x);
    out.y = cast(i64, o.y);
    out.width = cast(i64, o.mode_width);
    out.height = cast(i64, o.mode_height);
    monitor.work_is_whole(out);
    out.scale120 = w.scale120;
    out.refresh_mhz = cast(i64, o.refresh_mhz);
    monitor.set_name(out, &o.name[0], 32);
    return 1;
}
fn native_fd(w as *Window) as i64 { return w.fd; }
fn native_surface(w as *Window) as i32 { return w.surface; }
fn native_toplevel(w as *Window) as i32 { return w.toplevel; }
fn native_xdg_surface(w as *Window) as i32 { return w.xdg_surface; }
fn grab_serial(w as *Window) as u32 { return w.grab_serial; }
fn popup_done(w as *Window) as i32 { return w.popup_done; }
// Whether the popup holds the seat's grab: asked with a seat to ask it of,
// and not refused (a refused grab takes the popup down).
fn grabbing(w as *Window) as i32 {
    return cast(i32, w.opened == 1 && w.xdg_popup != 0 && w.pos.grab == 1 && w.seat != 0 && w.popup_done == 0);
}

// --- Subsurfaces ---

// w opened as a subsurface of parent: width by height logical pixels, its top
// left at x, y of the parent's surface. Synchronized at first: what it
// commits is shown with its parent's next commit. 1 when opened; the caller
// keeps w where it is until close. Closing the parent leaves it inert, its
// own close still due.
fn open_subsurface(w as *Window, parent as *Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    if (parent.opened == 0 || parent.surface == 0) {
        _zero(w);
        w.err = NO_CONFIGURE;
        return 0;
    }
    let is Options as o with mut = options();
    o.subsurface_of = parent.surface;
    o.sub_x = cast(i32, x);
    o.sub_y = cast(i32, y);
    o.sub_scale120 = parent.scale120;
    o.sub_scale = parent.scale;
    return open_config(w, "", width, height, &o);
}

fn is_subsurface(w as *Window) as i32 { return cast(i32, w.opened == 1 && w.subsurface != 0); }

// Its place in the parent's surface, logical: taken with the parent's next
// commit, whatever the subsurface's mode.
fn sub_set_position(w as *Window, x as i64, y as i64) as i32 {
    if (is_subsurface(w) == 0) { return 0; }
    let is [8]u8 as b;
    _put(&b[0], cast(u32, x)); _put(&b[4], cast(u32, y));
    return _send(w, w.subsurface, 1, &b[0], 8, 0 - 1);
}

// Just above (or below) sibling — another subsurface of the same parent, or
// the parent itself — with the parent's next commit.
fn sub_place_above(w as *Window, sibling as *Window) as i32 {
    if (is_subsurface(w) == 0 || sibling.opened == 0 || sibling.surface == 0) { return 0; }
    let is [4]u8 as b;
    _put(&b[0], cast(u32, sibling.surface));
    return _send(w, w.subsurface, 2, &b[0], 4, 0 - 1);
}

fn sub_place_below(w as *Window, sibling as *Window) as i32 {
    if (is_subsurface(w) == 0 || sibling.opened == 0 || sibling.surface == 0) { return 0; }
    let is [4]u8 as b;
    _put(&b[0], cast(u32, sibling.surface));
    return _send(w, w.subsurface, 3, &b[0], 4, 0 - 1);
}

// Synchronized (1): its commits wait for its parent's. Desynchronized (0):
// they are shown as they come — while no ancestor is synchronized.
fn sub_set_sync(w as *Window, on as i32) as i32 {
    if (is_subsurface(w) == 0) { return 0; }
    let is [0]u8 as empty;
    let is i32 as op with mut = 5;
    if (on != 0) { op = 4; }
    if (_send(w, w.subsurface, op, &empty[0], 0, 0 - 1) == 0) { return 0; }
    w.sub_sync = cast(i32, on != 0);
    return 1;
}

fn sub_sync(w as *Window) as i32 { return w.sub_sync; }

// The surface's pending state committed with no new content: what a parent
// does to apply its subsurfaces' places, order and cached commits.
fn commit(w as *Window) as i32 {
    if (w.opened == 0) { return 0; }
    return _surface_commit(w);
}

// Where the window geometry starts in the surface, logical pixels: past the
// shadow of a frame of the program's own while it is a floating window, as
// _set_window_geometry tells the compositor. A popup's positioner is in these.
fn geometry_origin(w as *Window, x as *i64, y as *i64) as void {
    *x = 0; *y = 0;
    if ((w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN | event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT |
        event.STATE_TILED_TOP | event.STATE_TILED_BOTTOM)) != 0) { return; }
    let is i64 as left = _scale_down(w.ext_left, w.scale120);
    let is i64 as right = _scale_down(w.ext_right, w.scale120);
    let is i64 as top = _scale_down(w.ext_top, w.scale120);
    let is i64 as bottom = _scale_down(w.ext_bottom, w.scale120);
    if (left + right < w.logical_width) { *x = left; }
    if (top + bottom < w.logical_height) { *y = top; }
}

// Where the compositor put the popup, relative to its parent's client in the
// parent's physical pixels: 1, or 0 for a window that is not a popup.
fn popup_position(w as *Window, parent as *Window, x as *i64, y as *i64) as i32 {
    if (w.opened == 0 || w.xdg_popup == 0) { return 0; }
    let is i64 as gx with mut = 0;
    let is i64 as gy with mut = 0;
    geometry_origin(parent, &gx, &gy);
    *x = _scale_up(cast(i64, w.popup_x) + gx, parent.scale120);
    *y = _scale_up(cast(i64, w.popup_y) + gy, parent.scale120);
    return 1;
}

// The popup placed again by pos, its size pw by ph logical: the compositor
// answers with a configure. xdg_popup 3 and later; 0 where it cannot be asked.
fn reposition(w as *Window, pos as *Options, pw as i64, ph as i64) as i32 {
    if (w.opened == 0 || w.xdg_popup == 0 || _bounded(_globals.shell_version, 6) < 3 || pw <= 0 || ph <= 0) { return 0; }
    let is i32 as id = _positioner(w, pos, pw, ph);
    if (id == 0) { return 0; }
    let is [8]u8 as b;
    w.reposition_token = w.reposition_token + 1;
    _put(&b[0], cast(u32, id)); _put(&b[4], cast(u32, w.reposition_token));
    if (_send(w, w.xdg_popup, 2, &b[0], 8, 0 - 1) == 0) { return 0; }
    let is [0]u8 as empty;
    if (_send(w, id, 0, &empty[0], 0, 0 - 1) == 0) { return 0; }
    w.pos = *pos;
    return 1;
}


// Whether state is a normal window's — not maximized, full screen or tiled —
// shown or not: its size its own, its shadow round it.
fn _floating(state as i32) as i32 { return cast(i32, (state & cast(i32, 0 - 1 - event.STATE_MINIMIZED)) == 0); }

fn _apply_configure(w as *Window) as void {
    let is i64 as logical_w with mut = w.logical_width;
    let is i64 as logical_h with mut = w.logical_height;
    let is i64 as shadow_w with mut = 0;
    let is i64 as shadow_h with mut = 0;
    let is i32 as floating = _floating(w.state);
    let is i32 as restored = cast(i32, floating == 1 && _floating(w.old_state) == 0);
    if (floating == 1) {
        shadow_w = _scale_down(w.ext_left + w.ext_right, w.scale120);
        shadow_h = _scale_down(w.ext_top + w.ext_bottom, w.scale120);
    }
    if (w.configured_width > 0) { logical_w = w.configured_width + shadow_w; }
    else if (restored == 1 && w.normal_width > 0) { logical_w = w.normal_width; }
    if (w.configured_height > 0) { logical_h = w.configured_height + shadow_h; }
    else if (restored == 1 && w.normal_height > 0) { logical_h = w.normal_height; }
    let is i64 as width with mut = _scale_up(logical_w, w.scale120);
    let is i64 as height with mut = _scale_up(logical_h, w.scale120);
    // A compositor may leave the size to the client, including after the
    // toolkit publishes a larger minimum for its client-side frame.
    if (floating == 1 && width < w.min_width) {
        logical_w = (w.min_width * 120 + w.scale120 - 1) / w.scale120;
        width = _scale_up(logical_w, w.scale120);
    }
    if (floating == 1 && height < w.min_height) {
        logical_h = (w.min_height * 120 + w.scale120 - 1) / w.scale120;
        height = _scale_up(logical_h, w.scale120);
    }
    if (logical_w > 0 && logical_h > 0 &&
        (w.logical_width != logical_w || w.logical_height != logical_h ||
         w.width != width || w.height != height)) {
        w.logical_width = logical_w;
        w.logical_height = logical_h;
        w.width = width; w.height = height;
        w.resized = 1;
        let is event.Event as e;
        event.clear(&e); e.kind = event.RESIZE; e.width = w.width; e.height = w.height;
        _queue(w, &e);
    }
    if (w.state != w.old_state) {
        w.old_state = w.state;
        let is event.Event as e;
        event.clear(&e); e.kind = event.STATE; e.state = w.state;
        _queue(w, &e);
    }
}

fn resized(w as *Window) as i32 { return w.resized; }

fn next_frame(w as *Window) as i32 {
    if (w.opened == 0) { return 0; }
    _repeat_keys(w, time.now_ms());
    _cursor_tick(w, time.now_ms());
    if (w.mapped == 0) { w.mapped = 1; w.frame_ready = 1; return 1; }
    if (w.event_len > 0) { return 1; }
    if (w.frame_ready == 1) { w.resized = 0; return 1; }
    w.resized = 0;
    if (w.close_requested == 1) { return 0; }
    while (w.frame_ready == 0 && w.resized == 0 && w.event_len == 0 && w.close_requested == 0) {
        if (_pump_one(w, 1) == 0) { w.err = NO_SOCKET; w.opened = 0; return 0; }
        _apply_configure(w);
    }
    if (w.resized == 1 || w.event_len > 0) { return 1; }
    if (w.frame_ready == 1) { return 1; }
    return cast(i32, w.close_requested == 0);
}

fn pending(w as *Window) as i32 {
    if (_transferring(w) == 1) { _transfers(w); }
    if (w.event_len > 0) { return 1; }
    if (cast(i64, w.input) != 0 && ie.pending(w.input) == 1) { return 1; }
    if (input_due(w) == 0) { return 1; }
    if (w.fd < 0) { return 0; }
    return cast(i32, sys.wait_readable(w.fd, 0) > 0);
}

fn keep_open(w as *Window) as void { w.close_requested = 0; }
fn request_close(w as *Window) as void {
    if (w.opened == 0 || w.close_requested == 1) { return; }
    w.close_requested = 1;
    let is event.Event as e;
    event.clear(&e); e.kind = event.CLOSE;
    _queue(w, &e);
}




fn acquire(w as *Window) as tgt.Target {
    let is tgt.Target as t;
    t.color = cast(*u8, 0); t.depth = cast(*u8, 0); t.width = 0; t.height = 0;
    w.current = 0 - 1;
    if (w.opened == 0) { return t; }
    if (w.buffer_width != w.width || w.buffer_height != w.height) {
        pump(w);
        if (w.buffers[0].busy == 1 || w.buffers[1].busy == 1) {
            if (_retire_current(w) == 0) {
                if (w.resize_detached == 0) {
                    let is [12]u8 as p;
                    _put(&p[0], 0); _put(&p[4], 0); _put(&p[8], 0);
                    if (_send(w, w.surface, 1, &p[0], 12, 0 - 1) == 0 ||
                        _surface_commit(w) == 0) { return t; }
                    w.resize_detached = 1; w.visible = 0;
                }
                return t;
            }
        } else { _destroy_buffers(w); }
        w.stride = w.width * 4; w.bytes = w.stride * w.height;
        if (_make_buffers(w) == 0) { w.err = NO_MEMORY; return t; }
        w.resize_detached = 0;
    }
    let is i32 as i with mut = 0;
    while (i < BUFFER_COUNT && w.buffers[i].busy == 1) { i = i + 1; }
    if (i >= BUFFER_COUNT) { return t; }
    w.current = i;
    t.color = cast(*u8, cast(i64, w.pixels) + i * w.bytes);
    t.width = w.width; t.height = w.height;
    return t;
}

fn _set_window_geometry(w as *Window, with_extents as i32) as i32 {
    if (w.logical_width <= 0 || w.logical_height <= 0 || w.scale120 <= 0) { return 0; }
    // A subsurface has no window geometry: it is part of its parent's.
    if (w.xdg_surface == 0) { return 1; }
    let is i64 as left with mut = _scale_down(w.ext_left, w.scale120);
    let is i64 as right with mut = _scale_down(w.ext_right, w.scale120);
    let is i64 as top with mut = _scale_down(w.ext_top, w.scale120);
    let is i64 as bottom with mut = _scale_down(w.ext_bottom, w.scale120);
    if (with_extents == 0) {
        left = 0; right = 0; top = 0; bottom = 0;
    } else {
        if (left + right >= w.logical_width) { left = 0; right = 0; }
        if (top + bottom >= w.logical_height) { top = 0; bottom = 0; }
    }
    let is [16]u8 as p;
    _put(&p[0], cast(u32, left)); _put(&p[4], cast(u32, top));
    _put(&p[8], cast(u32, w.logical_width - left - right));
    _put(&p[12], cast(u32, w.logical_height - top - bottom));
    return _send(w, w.xdg_surface, 3, &p[0], 16, 0 - 1);
}


// How old acquire's buffer is: 1 when it holds the frame committed last, 2
// the one before; 0 when it holds none since it was made.
fn buffer_age(w as *Window) as i32 {
    if (w.opened == 0 || w.current < 0) { return 0; }
    let is i64 as at = w.buffers[w.current].at;
    if (at == 0) { return 0; }
    return cast(i32, w.presents - at + 1);
}

// n pixels at p from the software target's RGBA to WL_SHM_FORMAT_ARGB8888's
// BGRA bytes (little-endian), premultiplied as the format is read.
fn _to_argb(p as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is *u8 as q = cast(*u8, cast(i64, p) + i * 4);
        let is i64 as a = cast(i64, q[3]);
        let is i64 as r with mut = cast(i64, q[0]);
        let is i64 as g with mut = cast(i64, q[1]);
        let is i64 as b with mut = cast(i64, q[2]);
        if (a < 255) {
            r = (r * a + 127) / 255;
            g = (g * a + 127) / 255;
            b = (b * a + 127) / 255;
        }
        q[0] = cast(u8, b); q[1] = cast(u8, g); q[2] = cast(u8, r);
        i = i + 1;
    }
}

fn submit(w as *Window) as void { _present(w, cast(*damage.List, 0)); }

// The frame presented by the rectangles of l, the only ones drawn into the
// buffer since its age: those converted and told the compositor as damage.
fn submit_region(w as *Window, l as *damage.List) as void { _present(w, l); }

fn _present(w as *Window, l as *damage.List) as void {
    if (w.opened == 0 || w.current < 0 || w.buffers[w.current].busy == 1) { return; }
    if (_set_window_geometry(w, cast(i32, (w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN |
        event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT | event.STATE_TILED_TOP |
        event.STATE_TILED_BOTTOM)) == 0)) == 0) { return; }
    let is i32 as whole = cast(i32, cast(i64, l) == 0 || l.whole == 1);
    // Caustic's software target is RGBA bytes: converted in place, the whole
    // buffer for a whole frame, else only the rectangles drawn — converting a
    // pixel twice would undo it.
    let is i64 as base = cast(i64, w.pixels) + w.current * w.bytes;
    if (whole == 1) {
        _to_argb(cast(*u8, base), w.width * w.height);
    } else {
        let is i32 as k with mut = 0;
        while (k < l.n) {
            let is *damage.Rect as r = &l.rects[k];
            let is i64 as row with mut = 0;
            while (row < cast(i64, r.h)) {
                _to_argb(cast(*u8, base + (cast(i64, r.y) + row) * w.stride + cast(i64, r.x) * 4), cast(i64, r.w));
                row = row + 1;
            }
            k = k + 1;
        }
    }
    let is i32 as id = _id(w);
    let is [16]u8 as p;
    _put(&p[0], cast(u32, w.scale));
    if (_send(w, w.surface, 8, &p[0], 4, 0 - 1) == 0) { return; }
    if (w.fractional_active == 1 && w.viewport != 0) {
        _put(&p[0], cast(u32, w.logical_width));
        _put(&p[4], cast(u32, w.logical_height));
        if (_send(w, w.viewport, 2, &p[0], 8, 0 - 1) == 0) { return; }
    }
    _put(&p[0], cast(u32, w.buffers[w.current].object));
    _put(cast(*u8, cast(i64, &p) + 4), 0);
    _put(cast(*u8, cast(i64, &p) + 8), 0);
    _send(w, w.surface, 1, &p[0], 12, 0 - 1);
    if (whole == 1) {
        _put(&p[0], 0); _put(cast(*u8, cast(i64, &p) + 4), 0);
        _put(cast(*u8, cast(i64, &p) + 8), cast(u32, w.logical_width));
        _put(cast(*u8, cast(i64, &p) + 12), cast(u32, w.logical_height));
        if (_send(w, w.surface, 2, &p[0], 16, 0 - 1) == 0) { return; }
    } else if (_bounded(_globals.compositor_version, 4) >= 4) {
        // damage_buffer: the rectangles as they are, in the buffer's pixels.
        let is i32 as k with mut = 0;
        while (k < l.n) {
            let is *damage.Rect as r = &l.rects[k];
            _put(&p[0], cast(u32, r.x)); _put(&p[4], cast(u32, r.y));
            _put(&p[8], cast(u32, r.w)); _put(&p[12], cast(u32, r.h));
            if (_send(w, w.surface, 9, &p[0], 16, 0 - 1) == 0) { return; }
            k = k + 1;
        }
    } else {
        // damage, before wl_surface 4: in surface coordinates, rounded out.
        let is i32 as k with mut = 0;
        while (k < l.n) {
            let is *damage.Rect as r = &l.rects[k];
            let is i64 as x0 = (cast(i64, r.x) * 120) / w.scale120;
            let is i64 as y0 = (cast(i64, r.y) * 120) / w.scale120;
            let is i64 as x1 = ((cast(i64, r.x + r.w)) * 120 + w.scale120 - 1) / w.scale120;
            let is i64 as y1 = ((cast(i64, r.y + r.h)) * 120 + w.scale120 - 1) / w.scale120;
            _put(&p[0], cast(u32, x0)); _put(&p[4], cast(u32, y0));
            _put(&p[8], cast(u32, x1 - x0)); _put(&p[12], cast(u32, y1 - y0));
            if (_send(w, w.surface, 2, &p[0], 16, 0 - 1) == 0) { return; }
            k = k + 1;
        }
    }
    _put(&p[0], cast(u32, id));
    _send(w, w.surface, 3, &p[0], 4, 0 - 1);
    _feedback_ask(w);
    _send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1);
    w.callback = id;
    w.buffers[w.current].busy = 1;
    w.presents = w.presents + 1;
    w.buffers[w.current].at = w.presents;
    w.last_buffer = w.current;
    w.visible = 1; w.resize_detached = 0;
    w.frame_ready = 0;
    w.current = 0 - 1;
    if (w.presents == 1) { _startup_activation(w); }
}

fn hide(w as *Window) as void {
    if (w.opened == 0 || w.visible == 0) { return; }
    let is [12]u8 as p;
    _put(&p[0], 0); _put(&p[4], 0); _put(&p[8], 0);
    if (_send(w, w.surface, 1, &p[0], 12, 0 - 1) == 0) { return; }
    if (_send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { return; }
    w.visible = 0;
}

fn show(w as *Window) as void {
    if (w.opened == 0 || w.visible == 1 || w.resize_detached == 1 ||
        w.buffer_width != w.width || w.buffer_height != w.height) { return; }
    if (w.last_buffer < 0 || w.buffers[w.last_buffer].object == 0) {
        w.visible = 1;
        return;
    }
    if (_set_window_geometry(w, cast(i32, (w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN |
        event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT | event.STATE_TILED_TOP |
        event.STATE_TILED_BOTTOM)) == 0)) == 0) { return; }
    let is [16]u8 as p;
    _put(&p[0], cast(u32, w.scale));
    if (_send(w, w.surface, 8, &p[0], 4, 0 - 1) == 0) { return; }
    if (w.fractional_active == 1 && w.viewport != 0) {
        _put(&p[0], cast(u32, w.logical_width));
        _put(&p[4], cast(u32, w.logical_height));
        if (_send(w, w.viewport, 2, &p[0], 8, 0 - 1) == 0) { return; }
    }
    _put(&p[0], cast(u32, w.buffers[w.last_buffer].object));
    _put(&p[4], 0); _put(&p[8], 0);
    if (_send(w, w.surface, 1, &p[0], 12, 0 - 1) == 0) { return; }
    _put(&p[0], 0); _put(&p[4], 0);
    _put(&p[8], cast(u32, w.logical_width)); _put(&p[12], cast(u32, w.logical_height));
    if (_send(w, w.surface, 2, &p[0], 16, 0 - 1) == 0) { return; }
    let is i32 as callback = _id(w);
    _put(&p[0], cast(u32, callback));
    if (_send(w, w.surface, 3, &p[0], 4, 0 - 1) == 0) { return; }
    if (_send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { return; }
    w.callback = callback;
    w.buffers[w.last_buffer].busy = 1;
    w.visible = 1;
}

fn pump(w as *Window) as void {
    if (w.opened == 0) { return; }
    _transfers(w);
    while (_pump_one(w, 0) == 1) { }
    _transfers(w);
    _apply_configure(w);
    _repeat_keys(w, time.now_ms());
    _cursor_tick(w, time.now_ms());
}

fn poll_event(w as *Window, out as *event.Event) as i32 {
    if (w.event_len == 0) { return 0; }
    *out = w.events[w.event_head];
    w.event_head = (w.event_head + 1) % MAX_EVENTS;
    w.event_len = w.event_len - 1;
    return 1;
}

// Its cooked input, oldest first (input/event.cst): 1, or 0 when none waits.
fn poll_input(w as *Window, out as *ie.Event) as i32 {
    if (cast(i64, w.input) == 0) { return 0; }
    return ie.next(w.input, out);
}

fn set_title(w as *Window, title as *u8, n as i64) as void {
    if (w.opened == 0) { return; }
    _send_string_n(w, w.toplevel, 2, title, n);
}

fn set_parent(w as *Window, parent as i32) as i32 {
    if (w.opened == 0) { return 0; }
    let is [4]u8 as p;
    _put(&p[0], cast(u32, parent));
    if (_send(w, w.toplevel, 1, &p[0], 4, 0 - 1) == 0) { return 0; }
    w.parent_toplevel = parent;
    return 1;
}

fn set_modal(w as *Window, on as i32) as i32 {
    if (w.opened == 0 || w.parent_toplevel == 0 || w.dialog_manager == 0) { return 0; }
    if (w.dialog == 0) {
        w.dialog = _id(w);
        let is [8]u8 as p;
        _put(&p[0], cast(u32, w.dialog));
        _put(&p[4], cast(u32, w.toplevel));
        if (_send(w, w.dialog_manager, 1, &p[0], 8, 0 - 1) == 0) {
            w.dialog = 0;
            return 0;
        }
    }
    let is i32 as op with mut = 2;
    if (on != 0) { op = 1; }
    return _send(w, w.dialog, op, cast(*u8, 0), 0, 0 - 1);
}

fn set_decorated(w as *Window, on as i32) as i32 {
    if (w.opened == 0 || w.toplevel_decoration == 0) { return 0; }
    let is [4]u8 as p;
    let is i32 as mode with mut = 1;
    if (on != 0) { mode = 2; }
    _put(&p[0], cast(u32, mode));
    if (_send(w, w.toplevel_decoration, 1, &p[0], 4, 0 - 1) == 0) { return 0; }
    w.decorated_wanted = on;
    return 1;
}

fn decorated(w as *Window) as i32 { return w.server_decorated; }

fn set_frame_extents(w as *Window, left as i64, right as i64, top as i64, bottom as i64) as i32 {
    if (w.opened == 0 || left < 0 || right < 0 || top < 0 || bottom < 0 ||
        left + right >= w.width || top + bottom >= w.height) { return 0; }
    w.ext_left = left; w.ext_right = right; w.ext_top = top; w.ext_bottom = bottom;
    _apply_configure(w);
    return _set_window_geometry(w, cast(i32, (w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN |
        event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT | event.STATE_TILED_TOP |
        event.STATE_TILED_BOTTOM)) == 0));
}

fn set_input_region(w as *Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    if (w.opened == 0 || width < 0 || height < 0) { return 0; }
    let is i32 as region = _id(w);
    let is [16]u8 as p;
    _put(&p[0], cast(u32, region));
    if (_send(w, w.compositor, 1, &p[0], 4, 0 - 1) == 0) { return 0; }
    _put(&p[0], cast(u32, _scale_down(x, w.scale120)));
    _put(&p[4], cast(u32, _scale_down(y, w.scale120)));
    _put(&p[8], cast(u32, _scale_down(width, w.scale120)));
    _put(&p[12], cast(u32, _scale_down(height, w.scale120)));
    let is i32 as added = _send(w, region, 1, &p[0], 16, 0 - 1);
    _put(&p[0], cast(u32, region));
    let is i32 as set = _send(w, w.surface, 5, &p[0], 4, 0 - 1);
    let is [0]u8 as empty;
    _send(w, region, 0, &empty[0], 0, 0 - 1);
    if (added == 0 || set == 0) { return 0; }
    w.input_x = x; w.input_y = y; w.input_width = width; w.input_height = height;
    w.input_region_set = 1;
    return 1;
}

fn input_region(w as *Window, x as *i64, y as *i64, width as *i64, height as *i64) as i32 {
    *x = 0; *y = 0; *width = 0; *height = 0;
    if (w.opened == 0 || w.input_region_set == 0) { return 0; }
    *x = w.input_x; *y = w.input_y; *width = w.input_width; *height = w.input_height;
    return 1;
}

fn begin_move_resize(w as *Window, x as i64, y as i64, how as i64, button as i64) as i32 {
    if (w.opened == 0 || w.seat == 0 || w.pointer_serial == 0) { return 0; }
    if (how < 0 || how > 8) { return 0; }
    let is [12]u8 as p;
    _put(&p[0], cast(u32, w.seat)); _put(&p[4], w.pointer_serial);
    let is i32 as sent with mut = 0;
    if (how == 8) { sent = _send(w, w.toplevel, 5, &p[0], 8, 0 - 1); }
    else {
        _put(&p[8], cast(u32, how + 1));
        sent = _send(w, w.toplevel, 6, &p[0], 12, 0 - 1);
    }
    // The compositor follows the pointer from the press on: its release is
    // the compositor's, so the input says the button is up, taken.
    if (sent == 1 && button >= 1 && button < 8 && w.pointer_buttons[button] == 1) {
        w.pointer_buttons[button] = 0;
        let is ie.Event as up = _input(w, ie.BUTTON_UP);
        up.button = cast(i32, button);
        up.detail = ie.BUTTON_TAKEN;
        up.x = w.pointer_x;
        up.y = w.pointer_y;
        _push(w, &up, cast(*u8, 0), 0);
    }
    return sent;
}

fn _cursor_shape_wanted() as i32 {
    let is *u8 as v = env.getenv("CAUSTIC_WAYLAND_CURSOR_SHAPE");
    return cast(i32, cast(i64, v) == 0 || v[0] != 48);
}

// The pointer over the window in shape (1..35, 35 hiding it) from now on, set
// now when the pointer is in and at each enter: 1, or 0 for a shape neither
// the compositor nor the theme has.
fn set_cursor(w as *Window, shape as i32) as i32 {
    if (w.opened == 0 || shape < 1 || shape > 35) { return 0; }
    if (shape != 35 && w.cursor_shape_device == 0 && w.cursor_shape_manager != 0) { return 0; }
    if (shape != 35 && w.cursor_shape_manager == 0 && _cursor_load(w, shape) == 0) { return 0; }
    w.cursor_want = shape;
    _cursor_apply(w);
    return 1;
}

// The theme and size the client draws the pointer from (theme empty or null:
// XCURSOR_THEME's; size 0: XCURSOR_SIZE's): drawn again when it is in.
fn cursor_theme(w as *Window, theme as *u8, size as i64) as void {
    mem.memzero(cast(*u8, &w.cursor_theme[0]), 64);
    if (cast(i64, theme) != 0) {
        let is i64 as i with mut = 0;
        while (i < 63 && theme[i] != 0) { w.cursor_theme[i] = theme[i]; i = i + 1; }
    }
    w.cursor_size = cast(i32, size);
    _cursor_unload(w);
    if (w.cursor_want != 0 && w.cursor_want != 35) { _cursor_apply(w); }
}

fn _cursor_scale(w as *Window) as i32 { return (w.scale120 + 119) / 120; }

fn _cursor_free_slot(w as *Window, k as i32) as void {
    let is *CursorSlot as s = &w.cursor_slots[k];
    if (s.shape == 0) { return; }
    let is i32 as i with mut = 0;
    while (i < s.images.count) {
        if (s.buffers[i] != 0) { _send(w, s.buffers[i], 0, cast(*u8, 0), 0, 0 - 1); s.buffers[i] = 0; }
        i = i + 1;
    }
    xcursor.free(&s.images);
    if (cast(i64, s.map) != 0) { linux.munmap(s.map, s.map_bytes); }
    s.map = cast(*u8, 0); s.map_bytes = 0;
    s.shape = 0; s.scale = 0;
    if (w.cursor_slot == k) { w.cursor_slot = 0 - 1; w.cursor_next = 0 - 1; }
}

fn _cursor_unload(w as *Window) as void {
    let is i32 as k with mut = 0;
    while (k < 4) { _cursor_free_slot(w, k); k = k + 1; }
}

// The shape's images, from the theme at the size times the surface's scale,
// in shm buffers of their own — kept from before, or read into the slot
// least recently used: 1, the slot the one shown, or 0 when the theme has no
// such cursor.
fn _cursor_load(w as *Window, shape as i32) as i32 {
    let is i32 as scale = _cursor_scale(w);
    w.cursor_uses = w.cursor_uses + 1;
    let is i32 as k with mut = 0;
    while (k < 4) {
        if (w.cursor_slots[k].shape == shape && w.cursor_slots[k].scale == scale) {
            w.cursor_slots[k].used = w.cursor_uses;
            w.cursor_slot = k;
            return 1;
        }
        k = k + 1;
    }
    let is i64 as size with mut = cast(i64, w.cursor_size);
    if (size <= 0) {
        let is *u8 as env_size = env.getenv("XCURSOR_SIZE");
        size = 0;
        if (cast(i64, env_size) != 0) {
            let is i64 as i with mut = 0;
            while (env_size[i] >= 48 && env_size[i] <= 57) { size = size * 10 + cast(i64, env_size[i] - 48); i = i + 1; }
        }
        if (size <= 0) { size = 24; }
    }
    let is *u8 as theme with mut = &w.cursor_theme[0];
    if (theme[0] == 0) { theme = env.getenv("XCURSOR_THEME"); }
    let is xcursor.Cursor as c with mut;
    if (xcursor.load_shape(theme, shape, cast(i32, size) * scale, &c) == 0) { return 0; }
    // The slot: an empty one, else the least recently used.
    let is i32 as v with mut = 0;
    k = 1;
    while (k < 4) {
        if (w.cursor_slots[v].shape != 0 && (w.cursor_slots[k].shape == 0 || w.cursor_slots[k].used < w.cursor_slots[v].used)) { v = k; }
        k = k + 1;
    }
    _cursor_free_slot(w, v);
    let is *CursorSlot as s = &w.cursor_slots[v];
    // One pool for every frame's pixels, a buffer for each.
    let is i64 as bytes = c.bytes;
    let is i64 as fd = sys.memfd_create("caustic-wayland-cursor", 1);
    if (fd < 0) { xcursor.free(&c); return 0; }
    if (linux.ftruncate(fd, bytes) != 0) { linux.close(fd); xcursor.free(&c); return 0; }
    let is *u8 as map = linux.mmap(cast(*u8, 0), bytes, linux.PROT_READ | linux.PROT_WRITE, linux.MAP_SHARED, fd, 0);
    if (cast(i64, map) == linux.MAP_FAILED) { linux.close(fd); xcursor.free(&c); return 0; }
    mem.memcpy(map, c.data, bytes);
    let is i32 as pool = _id(w);
    let is [24]u8 as p;
    _put(&p[0], cast(u32, pool)); _put(&p[4], cast(u32, bytes));
    let is i32 as sent = _send(w, w.shm, 0, &p[0], 8, fd);
    linux.close(fd);
    if (sent == 0) { linux.munmap(map, bytes); xcursor.free(&c); return 0; }
    s.images = c;
    s.map = map; s.map_bytes = bytes;
    let is i32 as i with mut = 0;
    while (i < c.count) {
        let is *xcursor.Frame as f = &s.images.frames[i];
        s.buffers[i] = _id(w);
        _put(&p[0], cast(u32, s.buffers[i]));
        _put(&p[4], cast(u32, cast(i64, f.pixels) - cast(i64, s.images.data)));
        _put(&p[8], cast(u32, f.width)); _put(&p[12], cast(u32, f.height));
        _put(&p[16], cast(u32, f.width * 4)); _put(&p[20], FORMAT_ARGB8888);
        _send(w, pool, 0, &p[0], 24, 0 - 1);
        i = i + 1;
    }
    _send(w, pool, 1, cast(*u8, 0), 0, 0 - 1);
    if (w.cursor_surface == 0) {
        w.cursor_surface = _id(w);
        _put(&p[0], cast(u32, w.cursor_surface));
        _send(w, w.compositor, 0, &p[0], 4, 0 - 1);
    }
    s.shape = shape;
    s.scale = scale;
    s.used = w.cursor_uses;
    w.cursor_slot = v;
    return 1;
}

// Frame i of the slot shown on the cursor surface, the pointer told its hot
// spot when told to or when it moved.
fn _cursor_show(w as *Window, i as i32, tell as i32) as void {
    let is *CursorSlot as s = &w.cursor_slots[w.cursor_slot];
    let is *xcursor.Frame as f = &s.images.frames[i];
    let is i32 as scale = s.scale;
    let is [16]u8 as p;
    if (tell == 1 || f.xhot != s.images.frames[w.cursor_frame].xhot || f.yhot != s.images.frames[w.cursor_frame].yhot) {
        _put(&p[0], w.pointer_serial); _put(&p[4], cast(u32, w.cursor_surface));
        _put(&p[8], cast(u32, f.xhot / scale)); _put(&p[12], cast(u32, f.yhot / scale));
        _send(w, w.pointer, 0, &p[0], 16, 0 - 1);
    }
    if (w.cursor_set_scale != scale && _bounded(_globals.compositor_version, 4) >= 3) {
        _put(&p[0], cast(u32, scale));
        _send(w, w.cursor_surface, 8, &p[0], 4, 0 - 1);
        w.cursor_set_scale = scale;
    }
    _put(&p[0], cast(u32, s.buffers[i])); _put(&p[4], 0); _put(&p[8], 0);
    _send(w, w.cursor_surface, 1, &p[0], 12, 0 - 1);
    _put(&p[0], 0); _put(&p[4], 0); _put(&p[8], cast(u32, f.width)); _put(&p[12], cast(u32, f.height));
    if (_bounded(_globals.compositor_version, 4) >= 4) { _send(w, w.cursor_surface, 9, &p[0], 16, 0 - 1); }
    else { _send(w, w.cursor_surface, 2, &p[0], 16, 0 - 1); }
    _send(w, w.cursor_surface, 6, cast(*u8, 0), 0, 0 - 1);
    w.cursor_frame = i;
}

// The shape asked for, set over the window now that the pointer is in.
fn _cursor_apply(w as *Window) as void {
    if (w.pointer == 0 || w.pointer_inside == 0 || w.pointer_serial == 0 || w.cursor_want == 0) { return; }
    let is [16]u8 as p;
    w.cursor_next = 0 - 1;
    if (w.cursor_want == 35) {
        _put(&p[0], w.pointer_serial); _put(&p[4], 0); _put(&p[8], 0); _put(&p[12], 0);
        _send(w, w.pointer, 0, &p[0], 16, 0 - 1);
        return;
    }
    if (w.cursor_shape_device != 0) {
        _put(&p[0], w.pointer_serial); _put(&p[4], cast(u32, w.cursor_want));
        _send(w, w.cursor_shape_device, 1, &p[0], 8, 0 - 1);
        return;
    }
    if (w.cursor_shape_manager != 0 || _cursor_load(w, w.cursor_want) == 0) { return; }
    let is *CursorSlot as s = &w.cursor_slots[w.cursor_slot];
    w.cursor_started = time.now_ms();
    _cursor_show(w, 0, 1);
    if (s.images.count > 1) { w.cursor_next = w.cursor_started + cast(i64, s.images.frames[0].delay); }
}

// The drawn pointer as of now: its next frame when one is due, its images
// again at a scale the window moved to.
fn _cursor_tick(w as *Window, now as i64) as void {
    if (w.pointer_inside == 0 || w.cursor_slot < 0 || w.cursor_shape_manager != 0 || w.cursor_want == 35) { return; }
    let is *CursorSlot as s = &w.cursor_slots[w.cursor_slot];
    if (s.scale != _cursor_scale(w)) { _cursor_apply(w); return; }
    if (w.cursor_next < 0 || now < w.cursor_next) { return; }
    let is i32 as i = xcursor.frame_at(&s.images, now - w.cursor_started);
    if (i != w.cursor_frame) { _cursor_show(w, i, 0); }
    // The next change: the end of this frame in its cycle.
    let is i64 as cycle with mut = 0;
    let is i32 as k with mut = 0;
    while (k < s.images.count) { cycle = cycle + cast(i64, s.images.frames[k].delay); k = k + 1; }
    if (cycle <= 0) { w.cursor_next = 0 - 1; return; }
    let is i64 as into = (now - w.cursor_started) % cycle;
    let is i64 as end with mut = 0;
    k = 0;
    while (k <= i) { end = end + cast(i64, s.images.frames[k].delay); k = k + 1; }
    w.cursor_next = now + (end - into);
}

fn set_min_size(w as *Window, width as i64, height as i64) as i32 {
    if (w.opened == 0 || width < 0 || height < 0) { return 0; }
    let is [8]u8 as p;
    _put(&p[0], cast(u32, (width * 120 + w.scale120 - 1) / w.scale120));
    _put(&p[4], cast(u32, (height * 120 + w.scale120 - 1) / w.scale120));
    if (_send(w, w.toplevel, 8, &p[0], 8, 0 - 1) == 0 || _surface_commit(w) == 0) { return 0; }
    w.min_width = width; w.min_height = height;
    _apply_configure(w);
    return 1;
}

fn min_size(w as *Window, width as *i64, height as *i64) as i32 {
    *width = 0; *height = 0;
    if (w.opened == 0) { return 0; }
    *width = w.min_width; *height = w.min_height;
    return cast(i32, w.min_width > 0 || w.min_height > 0);
}

fn set_max_size(w as *Window, width as i64, height as i64) as i32 {
    if (w.opened == 0 || width < 0 || height < 0) { return 0; }
    let is [8]u8 as p;
    _put(&p[0], cast(u32, width * 120 / w.scale120));
    _put(&p[4], cast(u32, height * 120 / w.scale120));
    if (_send(w, w.toplevel, 7, &p[0], 8, 0 - 1) == 0 || _surface_commit(w) == 0) { return 0; }
    w.max_width = width; w.max_height = height;
    return 1;
}

fn set_maximized(w as *Window, on as i32) as i32 {
    if (w.opened == 0) { return 0; }
    let is i32 as op with mut = 10;
    if (on != 0) { op = 9; }
    if (_send(w, w.toplevel, op, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    return _surface_commit(w);
}

fn set_fullscreen(w as *Window, on as i32) as i32 {
    if (w.opened == 0) { return 0; }
    if (on == 0) {
        if (_send(w, w.toplevel, 12, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
        return _surface_commit(w);
    }
    let is [4]u8 as p;
    _put(&p[0], 0);
    if (_send(w, w.toplevel, 11, &p[0], 4, 0 - 1) == 0) { return 0; }
    return _surface_commit(w);
}

fn minimize(w as *Window) as i32 {
    if (w.opened == 0 || _send(w, w.toplevel, 13, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    return _surface_commit(w);
}

// Text input wanted (a text field has the keyboard) or not. Told the
// compositor while the surface has its text-input focus, and again each time
// it gets it back; off, what was composing ends.
fn text_input_enable(w as *Window, on as i32) as i32 {
    if (w.opened == 0 || w.text_input == 0) { return 0; }
    let is i32 as enabled = cast(i32, on != 0);
    if (enabled == w.text_input_enabled) { return 1; }
    w.text_input_enabled = enabled;
    if (enabled == 1) {
        if (w.text_input_entered == 1) { return _ti_enable(w); }
        return 1;
    }
    _ime_pending_clear(w);
    _ime_unshow(w);
    if (w.text_input_entered == 0) { return 1; }
    if (_send(w, w.text_input, 2, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    return _ti_commit(w);
}

fn text_input_active(w as *Window) as i32 {
    return cast(i32, w.text_input_enabled == 1 && w.text_input_entered == 1);
}

// The caret, in device pixels: told in surface units, where the method puts
// its candidates.
fn text_input_rect(w as *Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    if (w.opened == 0 || w.text_input == 0 || w.text_input_enabled == 0 ||
        width < 0 || height < 0) { return 0; }
    if (x == w.ime_rect_x && y == w.ime_rect_y && width == w.ime_rect_w && height == w.ime_rect_h) {
        return 1;
    }
    w.ime_rect_x = x; w.ime_rect_y = y; w.ime_rect_w = width; w.ime_rect_h = height;
    w.ti_dirty = w.ti_dirty | TI_RECT;
    return _ti_flush(w);
}

// The field's text around the caret (n bytes of UTF-8, at most
// content.CONTEXT_MAX), the caret and the selection's other end in it, what
// it is for and how its text goes: told when any of it changed, as changed
// by the method's last commit or by something else. A secret field's text
// is not told, its purpose is.
fn text_input_context(w as *Window, text as *u8, n as i64, caret as i64, anchor as i64,
                      purpose as i32, hints as i32) as i32 {
    if (w.opened == 0 || w.text_input == 0 || w.text_input_enabled == 0) { return 0; }
    if (n < 0 || n > content.CONTEXT_MAX || caret < 0 || caret > n || anchor < 0 || anchor > n) { return 0; }
    let is i64 as len with mut = n;
    let is i64 as at with mut = caret;
    let is i64 as other with mut = anchor;
    if (content.secret(purpose) == 1) {
        len = 0;
        at = 0;
        other = 0;
    }
    let is i32 as what with mut = 0;
    if (purpose != w.ti_purpose || hints != w.ti_hints) {
        w.ti_purpose = purpose;
        w.ti_hints = hints;
        what = what | TI_TYPE;
    }
    if (len != w.ti_text_len || at != w.ti_caret || other != w.ti_anchor ||
        (len > 0 && mem.memcmp(text, &w.ti_text[0], len) != 0)) {
        if (len > 0) { mem.memcpy(&w.ti_text[0], text, len); }
        w.ti_text_len = len;
        w.ti_caret = at;
        w.ti_anchor = other;
        what = what | TI_TEXT;
    }
    if (what == 0) { return 1; }
    w.ti_dirty = w.ti_dirty | what;
    return _ti_flush(w);
}

// The composition abandoned: said gone here, and the method let go and taken
// again — text-input-v3 has no reset, and focus moving between fields is
// how a method learns its composition is over.
fn text_input_reset(w as *Window) as i32 {
    if (w.opened == 0 || w.text_input == 0 || w.text_input_enabled == 0) { return 0; }
    _ime_pending_clear(w);
    _ime_unshow(w);
    if (w.text_input_entered == 0) { return 1; }
    if (_send(w, w.text_input, 2, cast(*u8, 0), 0, 0 - 1) == 0 || _ti_commit(w) == 0) { return 0; }
    return _ti_enable(w);
}


fn close(w as *Window) as void {
    let is [0]u8 as empty;
    _transfers_end(w);
    let is i32 as data_i with mut = 0;
    while (data_i < MAX_DATA) {
        if (w.offers[data_i].object != 0) { _offer_release(w, data_i, 1); }
        if (w.sources[data_i].object != 0) { _source_release(w, data_i, 1); }
        data_i = data_i + 1;
    }
    if (w.data_device != 0) { _send(w, w.data_device, 2, &empty[0], 0, 0 - 1); }
    if (w.primary_device != 0) { _send(w, w.primary_device, 1, &empty[0], 0, 0 - 1); }
    if (w.text_input != 0) { _send(w, w.text_input, 0, &empty[0], 0, 0 - 1); }
    if (w.cursor_shape_device != 0) {
        _send(w, w.cursor_shape_device, 0, &empty[0], 0, 0 - 1);
    }
    if (w.viewport != 0) { _send(w, w.viewport, 0, &empty[0], 0, 0 - 1); }
    if (w.fractional_surface != 0) { _send(w, w.fractional_surface, 0, &empty[0], 0, 0 - 1); }
    if (w.toplevel_decoration != 0) { _send(w, w.toplevel_decoration, 0, &empty[0], 0, 0 - 1); }
    if (w.dialog != 0) { _send(w, w.dialog, 0, &empty[0], 0, 0 - 1); }
    _ungrabber(w);
    if (w.subsurface != 0) { _send(w, w.subsurface, 0, &empty[0], 0, 0 - 1); w.subsurface = 0; }
    if (w.xdg_popup != 0) { _send(w, w.xdg_popup, 0, &empty[0], 0, 0 - 1); w.xdg_popup = 0; }
    if (w.toplevel != 0) { _send(w, w.toplevel, 0, &empty[0], 0, 0 - 1); }
    if (w.xdg_surface != 0) { _send(w, w.xdg_surface, 0, &empty[0], 0, 0 - 1); }
    if (w.surface != 0) { _send(w, w.surface, 0, &empty[0], 0, 0 - 1); }
    if (w.pool != 0) { _send(w, w.pool, 1, &empty[0], 0, 0 - 1); w.pool = 0; }
    if (w.memfd >= 0) { linux.close(w.memfd); w.memfd = 0 - 1; }
    _destroy_buffers(w);
    ie.destroy(w.input);
    w.input = cast(*ie.Queue, 0);
    _touch_cancel(w);
    if (w.touch != 0 && w.seat_version >= 3) { _send(w, w.touch, 0, &empty[0], 0, 0 - 1); }
    _drop_gestures(w);
    if (w.gestures != 0 && w.gestures_version >= 2) { _send(w, w.gestures, 2, &empty[0], 0, 0 - 1); }
    _drop_tablets(w);
    if (w.pointer != 0 && w.pointer_version >= 3) { _send(w, w.pointer, 1, &empty[0], 0, 0 - 1); }
    if (w.keyboard != 0 && w.seat_version >= 3) { _send(w, w.keyboard, 0, &empty[0], 0, 0 - 1); }
    if (w.seat != 0 && w.seat_version >= 5) { _send(w, w.seat, 3, &empty[0], 0, 0 - 1); }
    let is i32 as output_i with mut = 0;
    while (output_i < w.output_count) {
        if (w.outputs[output_i].object != 0 && w.outputs[output_i].version >= 3) {
            _send(w, w.outputs[output_i].object, 0, &empty[0], 0, 0 - 1);
        }
        output_i = output_i + 1;
    }
    if (cast(i64, w.compose_state) != 0) { xkb.xkb_compose_state_unref(w.compose_state); }
    if (cast(i64, w.compose_table) != 0) { xkb.xkb_compose_table_unref(w.compose_table); }
    if (cast(i64, w.xkb_state) != 0) { xkb.xkb_state_unref(w.xkb_state); }
    if (cast(i64, w.xkb_keymap) != 0) { xkb.xkb_keymap_unref(w.xkb_keymap); }
    if (cast(i64, w.xkb_context) != 0) { xkb.xkb_context_unref(w.xkb_context); }
    w.compose_state = cast(*u8, 0); w.compose_table = cast(*u8, 0);
    w.xkb_state = cast(*u8, 0); w.xkb_keymap = cast(*u8, 0); w.xkb_context = cast(*u8, 0);
    _kb_free_own(w);
    _cursor_unload(w);
    if (w.cursor_surface != 0) { _send(w, w.cursor_surface, 0, cast(*u8, 0), 0, 0 - 1); w.cursor_surface = 0; }
    let is i32 as i with mut = 0;
    while (i < RETIRED_COUNT) {
        if (cast(i64, w.retired[i].pixels) != 0) {
            let is i32 as retired_i with mut = 0;
            while (retired_i < BUFFER_COUNT) {
                if (w.retired[i].buffers[retired_i].object != 0) {
                    _send(w, w.retired[i].buffers[retired_i].object, 0, &empty[0], 0, 0 - 1);
                }
                retired_i = retired_i + 1;
            }
            linux.munmap(w.retired[i].pixels, w.retired[i].bytes * BUFFER_COUNT);
        }
        mem.memzero(cast(*u8, &w.retired[i]), sizeof(BufferSet));
        i = i + 1;
    }
    _disconnect(w);
    w.fd = 0 - 1; w.opened = 0;
}

// --- Optional protocols ---

// A string argument at p, its bytes into out (cap, zero-terminated): its
// length, -1 when it is not there whole or does not fit.
fn _string_arg(p as *u8, out as *u8, cap as i64) as i64 {
    let is i64 as len = cast(i64, _word(p));
    if (len <= 0 || 8 + 4 + len > cast(i64, _wire_size) || len > cap) { return 0 - 1; }
    let is i64 as n = len - 1;
    mem.memcpy(out, cast(*u8, cast(i64, p) + 4), n);
    out[n] = 0;
    return n;
}

fn _token_done(w as *Window, p as *u8) as void {
    let is i64 as n = _string_arg(p, &w.token[0], 256);
    if (n < 0) { w.token_len = 0; } else { w.token_len = cast(i32, n); }
    _send(w, w.token_object, 4, cast(*u8, 0), 0, 0 - 1);
    w.token_object = 0;
}

fn _export_said(w as *Window, p as *u8) as void {
    let is i64 as n = _string_arg(p, &w.export_handle[0], 128);
    if (n < 0) { w.export_len = 0; } else { w.export_len = cast(i32, n); }
}

// Events until done() says *flag is no longer negative, a second at most.
fn _until_said(w as *Window, flag as *i32) as void {
    let is i64 as until = time.now_ms() + 1000;
    while (*flag < 0 && time.now_ms() < until) {
        if (_pump_one(w, 1) == 0) { return; }
    }
}

// xdg-activation: a token made for this window under its latest input — the
// key or press the user just gave it — for this window's activate or for a
// program started from here to come forward with (XDG_ACTIVATION_TOKEN). Its
// length into out (cap bytes, zero-terminated); 0 when the compositor has no
// xdg_activation_v1 or said none.
fn activation_token(w as *Window, out as *u8, cap as i64) as i64 {
    if (w.opened == 0 || w.activation == 0 || cap <= 1 || w.token_object != 0) { return 0; }
    let is [8]u8 as p;
    w.token_object = _id(w);
    w.token_len = 0 - 1;
    _put(&p[0], cast(u32, w.token_object));
    if (_send(w, w.activation, 1, &p[0], 4, 0 - 1) == 0) { w.token_object = 0; return 0; }
    if (w.input_serial != 0 && w.seat != 0) {
        _put(&p[0], w.input_serial); _put(&p[4], cast(u32, w.seat));
        _send(w, w.token_object, 0, &p[0], 8, 0 - 1);
    }
    _put(&p[0], cast(u32, w.surface));
    _send(w, w.token_object, 2, &p[0], 4, 0 - 1);
    _send(w, w.token_object, 3, cast(*u8, 0), 0, 0 - 1);
    _until_said(w, &w.token_len);
    if (w.token_len <= 0 || cast(i64, w.token_len) >= cap) { return 0; }
    mem.memcpy(out, &w.token[0], cast(i64, w.token_len));
    out[w.token_len] = 0;
    return cast(i64, w.token_len);
}

// Brought forward with token, n bytes — one another program gave, or one of
// this window's: 1 when asked; the compositor grants it or not.
fn activate_with(w as *Window, token as *u8, n as i64) as i32 {
    if (w.opened == 0 || w.activation == 0 || n <= 0 || n > 240) { return 0; }
    let is [256]u8 as p;
    let is i64 as len = n + 1;
    let is i64 as padded = ((len + 3) / 4) * 4;
    mem.memzero(&p[0], 256);
    _put(&p[0], cast(u32, len));
    mem.memcpy(&p[4], token, n);
    _put(cast(*u8, cast(i64, &p[0]) + 4 + padded), cast(u32, w.surface));
    return _send(w, w.activation, 2, &p[0], cast(i32, 8 + padded), 0 - 1);
}

// Brought forward: a token of its own made and used. 0 without xdg-activation.
fn activate(w as *Window) as i32 {
    let is [256]u8 as token;
    let is i64 as n = activation_token(w, &token[0], 256);
    if (n <= 0) { return 0; }
    return activate_with(w, &token[0], n);
}

// Started by another program with a token for its first window: brought
// forward with it, the token taken from what this one passes on.
fn _startup_activation(w as *Window) as void {
    if (w.popup_kind != 0 || w.subsurface != 0 || w.activation == 0) { return; }
    let is [256]u8 as token;
    let is i64 as n = launch.take("XDG_ACTIVATION_TOKEN", &token[0], 256);
    if (n > 0) { activate_with(w, &token[0], n); }
}

// xdg-foreign: the handle another program — a portal's dialog — makes a
// window of its own this one's child by. Its length into out (cap bytes,
// zero-terminated); 0 without zxdg_exporter_v2. Exported once, kept while the
// window is.
fn export_handle(w as *Window, out as *u8, cap as i64) as i64 {
    if (w.opened == 0 || w.exporter == 0 || w.toplevel == 0 || cap <= 1) { return 0; }
    if (w.exported == 0) {
        let is [8]u8 as p;
        w.exported = _id(w);
        w.export_len = 0 - 1;
        _put(&p[0], cast(u32, w.exported)); _put(&p[4], cast(u32, w.surface));
        if (_send(w, w.exporter, 1, &p[0], 8, 0 - 1) == 0) { w.exported = 0; return 0; }
    }
    _until_said(w, &w.export_len);
    if (w.export_len <= 0 || cast(i64, w.export_len) >= cap) { return 0; }
    mem.memcpy(out, &w.export_handle[0], cast(i64, w.export_len));
    out[w.export_len] = 0;
    return cast(i64, w.export_len);
}

// The system bell rung for this window: 1, 0 without xdg_system_bell_v1.
fn bell(w as *Window) as i32 {
    if (w.opened == 0 || w.bell == 0) { return 0; }
    let is [4]u8 as p;
    _put(&p[0], cast(u32, w.surface));
    return _send(w, w.bell, 1, &p[0], 4, 0 - 1);
}

// Its icon (xdg_toplevel_icon_v1): argb, iw by ih, 0xAARRGGBB a pixel,
// centred in a square as the protocol has icons, premultiplied in a buffer
// of its own kept while it is shown. 0 without the icon manager.
fn set_icon(w as *Window, argb as *u8, iw as i64, ih as i64) as i32 {
    if (w.opened == 0 || w.icon_manager == 0 || w.toplevel == 0 || iw <= 0 || ih <= 0 || iw > 1024 || ih > 1024) { return 0; }
    let is i64 as side with mut = iw;
    if (ih > side) { side = ih; }
    let is i64 as bytes = side * side * 4;
    let is i64 as fd = sys.memfd_create("caustic-wayland-icon", 1);
    if (fd < 0) { return 0; }
    if (linux.ftruncate(fd, bytes) != 0) { linux.close(fd); return 0; }
    let is *u8 as map = linux.mmap(cast(*u8, 0), bytes, linux.PROT_READ | linux.PROT_WRITE, linux.MAP_SHARED, fd, 0);
    if (cast(i64, map) == linux.MAP_FAILED) { linux.close(fd); return 0; }
    mem.memzero(map, bytes);
    let is i64 as ox = (side - iw) / 2;
    let is i64 as oy = (side - ih) / 2;
    let is i64 as y with mut = 0;
    while (y < ih) {
        let is i64 as x with mut = 0;
        while (x < iw) {
            let is u32 as c = *cast(*u32, cast(i64, argb) + (y * iw + x) * 4);
            let is u32 as a = (c >> 24) & 255;
            let is u32 as r = (((c >> 16) & 255) * a + 127) / 255;
            let is u32 as g = (((c >> 8) & 255) * a + 127) / 255;
            let is u32 as b = ((c & 255) * a + 127) / 255;
            *cast(*u32, cast(i64, map) + ((oy + y) * side + ox + x) * 4) = (a << 24) | (r << 16) | (g << 8) | b;
            x = x + 1;
        }
        y = y + 1;
    }
    let is [24]u8 as p;
    let is i32 as pool = _id(w);
    _put(&p[0], cast(u32, pool)); _put(&p[4], cast(u32, bytes));
    let is i32 as sent = _send(w, w.shm, 0, &p[0], 8, fd);
    linux.close(fd);
    if (sent == 0) { linux.munmap(map, bytes); return 0; }
    let is i32 as buffer = _id(w);
    _put(&p[0], cast(u32, buffer)); _put(&p[4], 0);
    _put(&p[8], cast(u32, side)); _put(&p[12], cast(u32, side));
    _put(&p[16], cast(u32, side * 4)); _put(&p[20], cast(u32, FORMAT_ARGB8888));
    _send(w, pool, 0, &p[0], 24, 0 - 1);
    _send(w, pool, 1, cast(*u8, 0), 0, 0 - 1);
    let is i32 as icon = _id(w);
    _put(&p[0], cast(u32, icon));
    _send(w, w.icon_manager, 1, &p[0], 4, 0 - 1);
    _put(&p[0], cast(u32, buffer)); _put(&p[4], 1);
    _send(w, icon, 2, &p[0], 8, 0 - 1);
    _put(&p[0], cast(u32, w.toplevel)); _put(&p[4], cast(u32, icon));
    _send(w, w.icon_manager, 2, &p[0], 8, 0 - 1);
    _send(w, icon, 0, cast(*u8, 0), 0, 0 - 1);
    // The icon before it, no longer shown: let go.
    if (w.icon_buffer != 0) { _send(w, w.icon_buffer, 0, cast(*u8, 0), 0, 0 - 1); linux.munmap(w.icon_map, w.icon_bytes); }
    w.icon_buffer = buffer; w.icon_map = map; w.icon_bytes = bytes;
    return 1;
}

// presentation-time: feedback asked of the frame about to be committed, a
// slot of its own while it is in flight (none free: not asked).
fn _feedback_ask(w as *Window) as void {
    if (w.presentation == 0) { return; }
    let is i32 as k with mut = 0;
    while (k < 8 && w.feedback[k] != 0) { k = k + 1; }
    if (k == 8) { return; }
    let is [8]u8 as p;
    w.feedback[k] = _id(w);
    _put(&p[0], cast(u32, w.surface)); _put(&p[4], cast(u32, w.feedback[k]));
    _send(w, w.presentation, 1, &p[0], 8, 0 - 1);
}

fn _feedback_index(w as *Window, obj as i32) as i32 {
    if (obj == 0) { return 0 - 1; }
    let is i32 as k with mut = 0;
    while (k < 8) {
        if (w.feedback[k] == obj) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

// presented: tv_sec_hi, tv_sec_lo, tv_nsec, refresh, seq_hi, seq_lo, flags;
// discarded. Either ends the feedback (the server destroys it).
fn _feedback_event(w as *Window, k as i32, op as i32, p as *u8) as void {
    if (op == 1 && _wire_size >= 8 + 28) {
        let is i64 as sec = (cast(i64, _word(p)) << 32) | cast(i64, _word(cast(*u8, cast(i64, p) + 4)));
        let is i64 as nsec = cast(i64, _word(cast(*u8, cast(i64, p) + 8)));
        w.presented_ns = sec * 1000000000 + nsec;
        w.refresh_ns = cast(i64, _word(cast(*u8, cast(i64, p) + 12)));
        w.presented = w.presented + 1;
        w.feedback[k] = 0;
    } else if (op == 2) {
        w.discarded = w.discarded + 1;
        w.feedback[k] = 0;
    }
}

// What presentation-time said of the frames: how many were shown (-1
// without wp_presentation), when the last was (ns of presentation_clock's
// clock) and the refresh then (ns, 0 unknown).
fn presentation_times(w as *Window, presented_ns as *i64, refresh_ns as *i64) as i64 {
    if (w.presentation == 0) { return 0 - 1; }
    *presented_ns = w.presented_ns;
    *refresh_ns = w.refresh_ns;
    return w.presented;
}

fn presentation_clock() as i32 { return _globals.presentation_clock; }
fn frames_discarded(w as *Window) as i64 { return w.discarded; }

// The window shown as one colour, argb (0xAARRGGBB), with no buffer of its
// size: wp_single_pixel_buffer_v1's one pixel stretched over it by the
// viewport, until the next frame — which sets the viewport's size again, as
// every frame with fractional scaling does. 1, or 0 without the single-pixel
// buffer or fractional scaling's viewport.
fn fill(w as *Window, argb as u32) as i32 {
    if (w.opened == 0 || w.single_pixel == 0 || w.viewport == 0 || w.fractional_active == 0 || w.logical_width <= 0) { return 0; }
    let is u32 as a = (argb >> 24) & 255;
    // Premultiplied, each channel scaled to the whole of a u32.
    let is u32 as r = (((argb >> 16) & 255) * a + 127) / 255;
    let is u32 as g = (((argb >> 8) & 255) * a + 127) / 255;
    let is u32 as b = ((argb & 255) * a + 127) / 255;
    let is [20]u8 as p;
    let is i32 as buffer = _id(w);
    _put(&p[0], cast(u32, buffer));
    _put(&p[4], r * 16843009); _put(&p[8], g * 16843009); _put(&p[12], b * 16843009); _put(&p[16], a * 16843009);
    if (_send(w, w.single_pixel, 1, &p[0], 20, 0 - 1) == 0) { return 0; }
    _put(&p[0], 1);
    _send(w, w.surface, 8, &p[0], 4, 0 - 1);
    _put(&p[0], cast(u32, w.logical_width)); _put(&p[4], cast(u32, w.logical_height));
    _send(w, w.viewport, 2, &p[0], 8, 0 - 1);
    _put(&p[0], cast(u32, buffer)); _put(&p[4], 0); _put(&p[8], 0);
    _send(w, w.surface, 1, &p[0], 12, 0 - 1);
    _put(&p[0], 0); _put(&p[4], 0); _put(&p[8], 2147483647); _put(&p[12], 2147483647);
    _send(w, w.surface, 2, &p[0], 16, 0 - 1);
    _send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1);
    if (w.fill_buffer != 0) { _send(w, w.fill_buffer, 0, cast(*u8, 0), 0, 0 - 1); }
    w.fill_buffer = buffer;
    return 1;
}
