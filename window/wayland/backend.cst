// A direct Wayland client. All windows share a connection and protocol IDs;
// each owns its event queue, shm buffers and xdg_toplevel.
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "std/env.cst" as env;
use "std/time.cst" as time;
use "../../sys/linux.cst" as sys;
use "../../gpu/software/target.cst" as tgt;
use "../event.cst" as event;
use "../../input/event.cst" as ie;
use "protocol.cst" as protocol;
use "xkb.cst" as xkb;
use "../monitor.cst" as monitor;
use "../damage.cst" as damage;
use "../transfer.cst" as transfer;
use "../../input/text.cst" as content;
use "../linux/launch.cst" as launch;
use "keyboard.cst" as kb;
use "pointer.cst" as ptr;
use "selection.cst" as sel;
use "state.cst" as st;
use "text_input.cst" as ti;

let is i32 as OK with imut = st.OK;
let is i32 as NO_RUNTIME with imut = st.NO_RUNTIME;
let is i32 as NO_SOCKET with imut = st.NO_SOCKET;
let is i32 as NO_COMPOSITOR with imut = st.NO_COMPOSITOR;
let is i32 as NO_SHELL with imut = st.NO_SHELL;
let is i32 as NO_MEMORY with imut = st.NO_MEMORY;
let is i32 as NO_CONFIGURE with imut = st.NO_CONFIGURE;
let is i32 as NO_PROTOCOL with imut = st.NO_PROTOCOL;
let is i32 as KEYMAP_XKBCOMMON with imut = st.KEYMAP_XKBCOMMON;
let is i32 as KEYMAP_CAUSTIC with imut = st.KEYMAP_CAUSTIC;

fn options() as st.Options {
    let is st.Options as o;
    o.app_id = "caustic-media"; o.parent = 0; o.resizable = 1;
    o.dialog = 0; o.modal = 0; o.decorated = 1;
    o.popup = 0; o.grab = 0; o.serial = cast(u32, 0); o.parent_surface = 0;
    o.anchor_x = 0; o.anchor_y = 0; o.anchor_w = 1; o.anchor_h = 1;
    o.anchor = 0; o.gravity = 0; o.adjust = 0; o.off_x = 0; o.off_y = 0;
    o.subsurface_of = 0; o.sub_x = 0; o.sub_y = 0; o.sub_scale120 = 120; o.sub_scale = 1;
    o.keymap = st.KEYMAP_XKBCOMMON;
    return o;
}

// Guard the raw opcode constants used below against the XML-generated catalog.
fn _protocol_ready() as i32 {
    let is protocol.Message as compositor = protocol.request_message(3, 0);
    let is protocol.Message as shm = protocol.request_message(5, 0);
    let is protocol.Message as seat_pointer = protocol.request_message(14, 0);
    let is protocol.Message as seat_keyboard = protocol.request_message(14, 1);
    let is protocol.Message as surface_commit = protocol.request_message(13, 6);
    let is protocol.Message as xdg_surface = protocol.request_message(23, 2);
    let is protocol.Message as ack = protocol.request_message(25, 4);
    let is protocol.Message as title = protocol.request_message(26, 2);
    let is protocol.Message as parent = protocol.request_message(26, 1);
    let is protocol.Message as min_size = protocol.request_message(26, 8);
    let is protocol.Message as max_size = protocol.request_message(26, 7);
    let is protocol.Message as maximize = protocol.request_message(26, 9);
    let is protocol.Message as unmaximize = protocol.request_message(26, 10);
    let is protocol.Message as fullscreen = protocol.request_message(26, 11);
    let is protocol.Message as unfullscreen = protocol.request_message(26, 12);
    let is protocol.Message as minimize = protocol.request_message(26, 13);
    let is protocol.Message as menu = protocol.request_message(26, 4);
    let is protocol.Message as move = protocol.request_message(26, 5);
    let is protocol.Message as resize = protocol.request_message(26, 6);
    let is protocol.Message as region_create = protocol.request_message(3, 1);
    let is protocol.Message as input_region = protocol.request_message(13, 5);
    let is protocol.Message as region_destroy = protocol.request_message(19, 0);
    let is protocol.Message as region_add = protocol.request_message(19, 1);
    let is protocol.Message as decoration_get = protocol.request_message(30, 1);
    let is protocol.Message as decoration_mode = protocol.request_message(31, 1);
    let is protocol.Message as dialog_get = protocol.request_message(44, 1);
    let is protocol.Message as dialog_modal = protocol.request_message(45, 1);
    let is protocol.Message as dialog_unmodal = protocol.request_message(45, 2);
    let is protocol.Message as buffer_scale = protocol.request_message(13, 8);
    let is protocol.Message as get_viewport = protocol.request_message(28, 1);
    let is protocol.Message as set_destination = protocol.request_message(29, 2);
    let is protocol.Message as get_fractional = protocol.request_message(38, 1);
    let is protocol.Message as preferred_scale = protocol.event_message(39, 0);
    let is protocol.Message as manager_source = protocol.request_message(10, 0);
    let is protocol.Message as manager_device = protocol.request_message(10, 1);
    let is protocol.Message as source_offer = protocol.request_message(8, 0);
    let is protocol.Message as device_selection = protocol.request_message(9, 1);
    let is protocol.Message as data_offer_receive = protocol.request_message(7, 1);
    let is protocol.Message as text_manager_input = protocol.request_message(33, 1);
    let is protocol.Message as text_destroy = protocol.request_message(32, 0);
    let is protocol.Message as text_enable = protocol.request_message(32, 1);
    let is protocol.Message as text_disable = protocol.request_message(32, 2);
    let is protocol.Message as text_content_type = protocol.request_message(32, 5);
    let is protocol.Message as text_cursor = protocol.request_message(32, 6);
    let is protocol.Message as text_commit = protocol.request_message(32, 7);
    let is protocol.Message as text_preedit = protocol.event_message(32, 2);
    let is protocol.Message as text_commit_event = protocol.event_message(32, 3);
    let is protocol.Message as text_delete = protocol.event_message(32, 4);
    let is protocol.Message as text_done = protocol.event_message(32, 5);
    let is protocol.Message as text_enter = protocol.event_message(32, 0);
    let is protocol.Message as text_leave = protocol.event_message(32, 1);
    let is protocol.Message as primary_get_device = protocol.request_message(34, 1);
    let is protocol.Message as primary_selection = protocol.request_message(35, 0);
    let is protocol.Message as primary_source_offer = protocol.request_message(37, 0);
    let is protocol.Message as primary_offer_receive = protocol.request_message(36, 0);
    let is protocol.Message as registry_event = protocol.event_message(1, 0);
    let is protocol.Message as seat_caps = protocol.event_message(14, 0);
    let is protocol.Message as pointer_enter = protocol.event_message(15, 0);
    let is protocol.Message as pointer_motion = protocol.event_message(15, 2);
    let is protocol.Message as pointer_button = protocol.event_message(15, 3);
    let is protocol.Message as pointer_axis = protocol.event_message(15, 4);
    let is protocol.Message as pointer_frame = protocol.event_message(15, 5);
    let is protocol.Message as axis_source = protocol.event_message(15, 6);
    let is protocol.Message as axis_stop = protocol.event_message(15, 7);
    let is protocol.Message as axis_discrete = protocol.event_message(15, 8);
    let is protocol.Message as axis_value120 = protocol.event_message(15, 9);
    let is protocol.Message as keyboard_keymap = protocol.event_message(16, 0);
    let is protocol.Message as keyboard_key = protocol.event_message(16, 3);
    let is protocol.Message as keyboard_modifiers = protocol.event_message(16, 4);
    let is protocol.Message as configure_event = protocol.event_message(25, 0);
    let is protocol.Message as toplevel_event = protocol.event_message(26, 0);
    return cast(i32, compositor.opcode == 0 && compositor.arg_count == 1 &&
                     shm.opcode == 0 && shm.arg_count == 3 &&
                     seat_pointer.opcode == 0 && seat_pointer.arg_count == 1 &&
                     seat_keyboard.opcode == 1 && seat_keyboard.arg_count == 1 &&
                     surface_commit.opcode == 6 && surface_commit.arg_count == 0 &&
                     xdg_surface.opcode == 2 && xdg_surface.arg_count == 2 &&
                     ack.opcode == 4 && ack.arg_count == 1 &&
                     title.opcode == 2 && title.arg_count == 1 &&
                     parent.opcode == 1 && parent.arg_count == 1 &&
                     min_size.opcode == 8 && min_size.arg_count == 2 &&
                     max_size.opcode == 7 && max_size.arg_count == 2 &&
                     maximize.opcode == 9 && maximize.arg_count == 0 &&
                     unmaximize.opcode == 10 && unmaximize.arg_count == 0 &&
                     fullscreen.opcode == 11 && fullscreen.arg_count == 1 &&
                     unfullscreen.opcode == 12 && unfullscreen.arg_count == 0 &&
                     minimize.opcode == 13 && minimize.arg_count == 0 &&
                     menu.opcode == 4 && menu.arg_count == 4 &&
                     move.opcode == 5 && move.arg_count == 2 &&
                     resize.opcode == 6 && resize.arg_count == 3 &&
                     region_create.opcode == 1 && region_create.arg_count == 1 &&
                     input_region.opcode == 5 && input_region.arg_count == 1 &&
                     region_destroy.opcode == 0 && region_destroy.arg_count == 0 &&
                     region_add.opcode == 1 && region_add.arg_count == 4 &&
                     decoration_get.opcode == 1 && decoration_get.arg_count == 2 &&
                     decoration_mode.opcode == 1 && decoration_mode.arg_count == 1 &&
                     dialog_get.opcode == 1 && dialog_get.arg_count == 2 &&
                     dialog_modal.opcode == 1 && dialog_modal.arg_count == 0 &&
                     dialog_unmodal.opcode == 2 && dialog_unmodal.arg_count == 0 &&
                     buffer_scale.opcode == 8 && buffer_scale.arg_count == 1 &&
                     get_viewport.opcode == 1 && get_viewport.arg_count == 2 &&
                     set_destination.opcode == 2 && set_destination.arg_count == 2 &&
                     get_fractional.opcode == 1 && get_fractional.arg_count == 2 &&
                     preferred_scale.opcode == 0 && preferred_scale.arg_count == 1 &&
                     manager_source.opcode == 0 && manager_source.arg_count == 1 &&
                     manager_device.opcode == 1 && manager_device.arg_count == 2 &&
                     source_offer.opcode == 0 && source_offer.arg_count == 1 &&
                     device_selection.opcode == 1 && device_selection.arg_count == 2 &&
                     data_offer_receive.opcode == 1 && data_offer_receive.arg_count == 2 &&
                     primary_get_device.opcode == 1 && primary_get_device.arg_count == 2 &&
                     primary_selection.opcode == 0 && primary_selection.arg_count == 2 &&
                     primary_source_offer.opcode == 0 && primary_source_offer.arg_count == 1 &&
                     primary_offer_receive.opcode == 0 && primary_offer_receive.arg_count == 2 &&
                     text_manager_input.opcode == 1 && text_manager_input.arg_count == 2 &&
                     text_destroy.opcode == 0 && text_destroy.arg_count == 0 &&
                     text_enable.opcode == 1 && text_enable.arg_count == 0 &&
                     text_disable.opcode == 2 && text_disable.arg_count == 0 &&
                     text_cursor.opcode == 6 && text_cursor.arg_count == 4 &&
                     text_content_type.opcode == 5 && text_content_type.arg_count == 2 &&
                     text_commit.opcode == 7 && text_commit.arg_count == 0 &&
                     text_preedit.opcode == 2 && text_preedit.arg_count == 3 &&
                     text_commit_event.opcode == 3 && text_commit_event.arg_count == 1 &&
                     text_delete.opcode == 4 && text_delete.arg_count == 2 &&
                     text_done.opcode == 5 && text_done.arg_count == 1 &&
                     text_enter.opcode == 0 && text_enter.arg_count == 1 &&
                     text_leave.opcode == 1 && text_leave.arg_count == 1 &&
                     registry_event.opcode == 0 && registry_event.arg_count == 3 &&
                     seat_caps.opcode == 0 && seat_caps.arg_count == 1 &&
                     pointer_enter.opcode == 0 && pointer_enter.arg_count == 4 &&
                     pointer_motion.opcode == 2 && pointer_motion.arg_count == 3 &&
                     pointer_button.opcode == 3 && pointer_button.arg_count == 4 &&
                     pointer_axis.opcode == 4 && pointer_axis.arg_count == 3 &&
                     pointer_frame.opcode == 5 && pointer_frame.arg_count == 0 &&
                     axis_source.opcode == 6 && axis_source.arg_count == 1 &&
                     axis_stop.opcode == 7 && axis_stop.arg_count == 2 &&
                     axis_discrete.opcode == 8 && axis_discrete.arg_count == 2 &&
                     axis_value120.opcode == 9 && axis_value120.arg_count == 2 && axis_value120.since == 8 &&
                     keyboard_keymap.opcode == 0 && keyboard_keymap.arg_count == 3 &&
                     keyboard_key.opcode == 3 && keyboard_key.arg_count == 4 &&
                     keyboard_modifiers.opcode == 4 && keyboard_modifiers.arg_count == 5 &&
                     configure_event.opcode == 0 && configure_event.arg_count == 1 &&
                     toplevel_event.opcode == 0 && toplevel_event.arg_count == 3);
}
fn _bind(w as *st.Window, name as u32, iface as *u8, version as i32, id as i32) as i32 {
    let is [256]u8 as p;
    let is i32 as n with mut = 0;
    st._put(&p[n], name); n = n + 4;
    let is i32 as len with mut = 1;
    while (iface[len - 1] != 0) { len = len + 1; }
    let is i32 as padded = ((len + 3) / 4) * 4;
    st._put(&p[n], cast(u32, len)); n = n + 4;
    mem.memcpy(&p[n], iface, len);
    if (padded > len) { mem.memset(cast(*u8, cast(i64, &p[n]) + len), 0, padded - len); }
    n = n + padded;
    st._put(&p[n], cast(u32, version)); n = n + 4;
    st._put(&p[n], cast(u32, id)); n = n + 4;
    return st._send(w, w.registry, 0, &p[0], n, 0 - 1);
}

// Globals with no per-window event stream live until the shared connection
// closes. Seat and output objects remain per-window and are released there.
fn _binding(w as *st.Window, name as u32, iface as *u8, version as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < 32) {
        if (st._bindings[i].object != 0 && st._bindings[i].global == name) { return st._bindings[i].object; }
        if (st._bindings[i].object == 0) {
            let is i32 as id = st._id(w);
            if (id == 0 || _bind(w, name, iface, version, id) == 0) { return 0; }
            st._bindings[i].global = name; st._bindings[i].object = id;
            return id;
        }
        i = i + 1;
    }
    w.err = st.NO_MEMORY;
    return 0;
}

fn _registry_global() as void {
    if (st._wire_size < 20) { return; }
    let is u32 as name = st._word(&st._wire[8]);
    let is i32 as len = cast(i32, st._word(&st._wire[12]));
    if (len <= 1 || len > 128 || 16 + len > st._wire_size) { return; }
    let is *u8 as text = &st._wire[16];
    let is i32 as padded = ((len + 3) / 4) * 4;
    let is i32 as version_at = 16 + padded;
    if (version_at + 4 > st._wire_size) { return; }
    let is i32 as version = cast(i32, st._word(&st._wire[version_at]));
    if (st._same(text, len - 1, "wl_compositor") == 1 && st._globals.compositor_global == 0) {
        st._globals.compositor_global = cast(i32, name); st._globals.compositor_version = version;
    }
    if (st._same(text, len - 1, "wl_shm") == 1 && st._globals.shm_global == 0) {
        st._globals.shm_global = cast(i32, name);
    }
    if (st._same(text, len - 1, "xdg_wm_base") == 1 && st._globals.shell_global == 0) {
        st._globals.shell_global = cast(i32, name); st._globals.shell_version = version;
    }
    if (st._same(text, len - 1, "wl_seat") == 1 && st._globals.seat_global == 0) {
        st._globals.seat_global = cast(i32, name); st._globals.seat_version = version;
    }
    if (st._same(text, len - 1, "zxdg_decoration_manager_v1") == 1 && st._globals.decoration_global == 0) {
        st._globals.decoration_global = cast(i32, name); st._globals.decoration_version = version;
    }
    if (st._same(text, len - 1, "xdg_wm_dialog_v1") == 1 && st._globals.dialog_global == 0) {
        st._globals.dialog_global = cast(i32, name); st._globals.dialog_version = version;
    }
    // CAUSTIC_WAYLAND_CURSOR_SHAPE=0: the client draws the pointer itself,
    // as with a compositor without cursor-shape-v1.
    if (st._same(text, len - 1, "wp_cursor_shape_manager_v1") == 1 &&
        st._globals.cursor_shape_global == 0 && ptr._cursor_shape_wanted() == 1) {
        st._globals.cursor_shape_global = cast(i32, name); st._globals.cursor_shape_version = version;
    }
    if (st._same(text, len - 1, "wl_output") == 1 && st._globals.output_count < 8) {
        let is i32 as i = st._globals.output_count;
        st._globals.outputs[i].global = cast(i32, name);
        st._globals.outputs[i].version = version;
        st._globals.output_count = st._globals.output_count + 1;
    }
    if (st._same(text, len - 1, "wp_viewporter") == 1 && st._globals.viewporter_global == 0) {
        st._globals.viewporter_global = cast(i32, name); st._globals.viewporter_version = version;
    }
    if (st._same(text, len - 1, "wp_fractional_scale_manager_v1") == 1 &&
        st._globals.fractional_global == 0) {
        st._globals.fractional_global = cast(i32, name); st._globals.fractional_version = version;
    }
    if (st._same(text, len - 1, "wl_data_device_manager") == 1 && st._globals.data_manager_global == 0) {
        st._globals.data_manager_global = cast(i32, name); st._globals.data_manager_version = version;
    }
    if (st._same(text, len - 1, "zwp_primary_selection_device_manager_v1") == 1 &&
        st._globals.primary_manager_global == 0) {
        st._globals.primary_manager_global = cast(i32, name); st._globals.primary_manager_version = version;
    }
    if (st._same(text, len - 1, "zwp_text_input_manager_v3") == 1 &&
        st._globals.text_input_manager_global == 0) {
        st._globals.text_input_manager_global = cast(i32, name);
        st._globals.text_input_manager_version = version;
    }
    if (st._same(text, len - 1, "wl_subcompositor") == 1 && st._globals.subcompositor_global == 0) {
        st._globals.subcompositor_global = cast(i32, name);
    }
    if (st._same(text, len - 1, "zwp_tablet_manager_v2") == 1 && st._globals.tablet_manager_global == 0) {
        st._globals.tablet_manager_global = cast(i32, name);
    }
    if (st._same(text, len - 1, "zwp_pointer_gestures_v1") == 1 && st._globals.gestures_global == 0) {
        st._globals.gestures_global = cast(i32, name); st._globals.gestures_version = version;
    }
    if (st._same(text, len - 1, "xdg_activation_v1") == 1 && st._globals.activation_global == 0) {
        st._globals.activation_global = cast(i32, name);
    }
    if (st._same(text, len - 1, "zxdg_exporter_v2") == 1 && st._globals.exporter_global == 0) {
        st._globals.exporter_global = cast(i32, name);
    }
    if (st._same(text, len - 1, "xdg_toplevel_icon_manager_v1") == 1 && st._globals.icon_global == 0) {
        st._globals.icon_global = cast(i32, name);
    }
    if (st._same(text, len - 1, "wp_presentation") == 1 && st._globals.presentation_global == 0) {
        st._globals.presentation_global = cast(i32, name);
    }
    if (st._same(text, len - 1, "wp_single_pixel_buffer_manager_v1") == 1 && st._globals.single_pixel_global == 0) {
        st._globals.single_pixel_global = cast(i32, name);
    }
    if (st._same(text, len - 1, "xdg_system_bell_v1") == 1 && st._globals.bell_global == 0) {
        st._globals.bell_global = cast(i32, name);
    }
    if (st._same(text, len - 1, "xdg_toplevel_drag_manager_v1") == 1 && st._globals.toplevel_drag_global == 0) {
        st._globals.toplevel_drag_global = cast(i32, name);
    }
}

fn _set_scale120(w as *st.Window, preferred as i32, buffer_scale as i32) as void {
    let is i32 as factor with mut = preferred;
    let is i32 as buffer with mut = buffer_scale;
    if (factor < 120) { factor = 120; }
    if (factor > 1920) { factor = 1920; }
    if (w.fractional_active == 1) { buffer = 1; }
    let is i32 as changed = cast(i32, factor != w.scale120);
    let is i32 as buffer_changed = cast(i32, buffer != w.scale);
    w.scale120 = factor;
    w.scale = buffer;
    if (buffer_changed == 1 && w.surface != 0) {
        let is [4]u8 as p;
        st._put(&p[0], cast(u32, buffer));
        st._send(w, w.surface, 8, &p[0], 4, 0 - 1);
    }
    if (changed == 0 || w.logical_width <= 0 || w.logical_height <= 0) { return; }
    w.width = st._scale_up(w.logical_width, factor);
    w.height = st._scale_up(w.logical_height, factor);
    w.resized = 1;
    let is event.Event as e;
    event.clear(&e); e.kind = event.RESIZE; e.width = w.width; e.height = w.height;
    st._queue(w, &e);
    event.clear(&e); e.kind = event.SETTINGS;
    st._queue(w, &e);
}

// The integer scale of the output the window is on — unless the compositor
// says a fractional one for the surface (wp_fractional_scale), which is the
// one its buffer is drawn at, whichever of the two arrives first.
fn _set_scale(w as *st.Window, scale as i32) as void {
    if (w.fractional_active == 1) { return; }
    let is i32 as factor with mut = scale;
    if (factor < 1) { factor = 1; }
    if (factor > 16) { factor = 16; }
    _set_scale120(w, factor * 120, factor);
}
fn _surface_output(w as *st.Window, object as i32, entering as i32) as void {
    let is i32 as i with mut = 0;
    while (i < w.output_count) {
        if (w.outputs[i].object == object) {
            w.outputs[i].entered = entering;
            if (entering == 1) {
                w.active_output = i;
                _set_scale(w, w.outputs[i].scale);
            } else if (w.active_output == i) {
                w.active_output = 0 - 1;
                let is i32 as other with mut = 0;
                while (other < w.output_count && w.active_output < 0) {
                    if (w.outputs[other].entered == 1) { w.active_output = other; }
                    other = other + 1;
                }
                if (w.active_output >= 0) { _set_scale(w, w.outputs[w.active_output].scale); }
                else { _set_scale(w, 1); }
            }
            return;
        }
        i = i + 1;
    }
}

// What a wl_output says of itself: its place (geometry), its current mode,
// its scale, its name.
fn _output_event(w as *st.Window, obj as i32, op as i32, p as *u8) as void {
    let is i32 as i with mut = 0;
    while (i < w.output_count && w.outputs[i].object != obj) { i = i + 1; }
    if (i == w.output_count) { return; }
    let is *st.Output as o = &w.outputs[i];
    if (op == 0 && st._wire_size >= 16) {
        o.x = cast(i32, st._word(p));
        o.y = cast(i32, st._word(cast(*u8, cast(i64, p) + 4)));
        return;
    }
    if (op == 1 && st._wire_size >= 24) {
        if ((st._word(p) & cast(u32, 1)) != cast(u32, 0)) {
            o.mode_width = cast(i32, st._word(cast(*u8, cast(i64, p) + 4)));
            o.mode_height = cast(i32, st._word(cast(*u8, cast(i64, p) + 8)));
            o.refresh_mhz = cast(i32, st._word(cast(*u8, cast(i64, p) + 12)));
        }
        return;
    }
    if (op == 3 && st._wire_size >= 12) {
        let is i32 as scale = cast(i32, st._word(p));
        if (scale < 1) { return; }
        o.scale = scale;
        if (w.active_output == i) { _set_scale(w, scale); }
        return;
    }
    if (op == 4 && st._wire_size >= 12) {
        let is i32 as len = cast(i32, st._word(p));
        let is i32 as padded = ((len + 3) / 4) * 4;
        if (len < 1 || 12 + padded > st._wire_size) { return; }
        let is *u8 as s = cast(*u8, cast(i64, p) + 4);
        let is i32 as k with mut = 0;
        while (k < len - 1 && k < 31) {
            o.name[k] = s[k];
            k = k + 1;
        }
        o.name[k] = cast(u8, 0);
    }
}

// Process one complete server message. The generated catalog supplies the
// opcode/signature contract used for the core and xdg messages below.
fn _cursor_shape_pointer(w as *st.Window) as void {
    if (w.cursor_shape_manager == 0 || w.pointer == 0 || w.cursor_shape_device != 0) { return; }
    w.cursor_shape_device = st._id(w);
    let is [8]u8 as p;
    st._put(&p[0], cast(u32, w.cursor_shape_device));
    st._put(&p[4], cast(u32, w.pointer));
    if (st._send(w, w.cursor_shape_manager, 1, &p[0], 8, 0 - 1) == 0) {
        w.cursor_shape_device = 0;
    }
}

fn _seat_capabilities(w as *st.Window, caps as u32) as void {
    let is [4]u8 as body;
    if ((caps & 1) != 0 && w.pointer == 0) {
        w.pointer = st._id(w);
        st._put(&body[0], cast(u32, w.pointer));
        st._send(w, w.seat, 0, &body[0], 4, 0 - 1);
        w.pointer_version = w.seat_version;
        _cursor_shape_pointer(w);
        ptr._gesture_objects(w);
    } else if ((caps & 1) == 0 && w.pointer != 0) {
        if (w.cursor_shape_device != 0) {
            st._send(w, w.cursor_shape_device, 0, cast(*u8, 0), 0, 0 - 1);
            w.cursor_shape_device = 0;
        }
        ptr._drop_gestures(w);
        if (w.pointer_version >= 3) { st._send(w, w.pointer, 1, cast(*u8, 0), 0, 0 - 1); }
        w.pointer = 0; w.pointer_inside = 0; w.pointer_serial = 0;
    }
    if ((caps & 4) != 0 && w.touch == 0) {
        w.touch = st._id(w);
        st._put(&body[0], cast(u32, w.touch));
        st._send(w, w.seat, 2, &body[0], 4, 0 - 1);
    } else if ((caps & 4) == 0 && w.touch != 0) {
        ptr._touch_cancel(w);
        if (w.seat_version >= 3) { st._send(w, w.touch, 0, cast(*u8, 0), 0, 0 - 1); }
        w.touch = 0;
    }
    if ((caps & 2) != 0 && w.keyboard == 0) {
        w.keyboard = st._id(w);
        if (w.keyboard != 0) { st._objects[w.keyboard].fd_opcode = 0; }
        st._put(&body[0], cast(u32, w.keyboard));
        st._send(w, w.seat, 1, &body[0], 4, 0 - 1);
    } else if ((caps & 2) == 0 && w.keyboard != 0) {
        if (w.keyboard_focus == 1) {
            st._event(w, event.FOCUS_OUT);
            st._cancel_input(w);
        }
        if (w.seat_version >= 3) { st._send(w, w.keyboard, 0, cast(*u8, 0), 0, 0 - 1); }
        if (w.keyboard != 0) { st._objects[w.keyboard].owner = cast(*st.Window, 0); }
        w.keyboard = 0; w.keyboard_focus = 0;
        mem.memzero(cast(*u8, &w.key_down[0]), 256 * 4);
        mem.memzero(cast(*u8, &w.key_syms[0]), 256 * 4);
        mem.memzero(cast(*u8, &w.key_cuts[0]), 256 * 4);
        w.repeat_code = 0 - 1;
    }
}

// Where the chosen reader refused the compositor's last keymap, -1 when it
// took it: the own interpreter's byte; libxkbcommon says no byte (0).
fn keymap_refused(w as *st.Window) as i64 { return w.keymap_refused_at; }

// Milliseconds until the input layer wants a turn — the held key's next
// repeat, the drawn pointer's next frame — 0 when due; -1 for none.
fn input_due(w as *st.Window) as i64 {
    if (w.opened == 0) { return 0 - 1; }
    let is i64 as now = time.now_ms();
    let is i64 as due with mut = 0 - 1;
    if (w.repeat_code >= 0 && w.repeat_rate > 0 && w.keyboard_focus == 1) {
        due = w.repeat_next - now;
        if (due < 0) { due = 0; }
    }
    if (w.pointer_inside == 1 && w.cursor_next >= 0) {
        let is i64 as c with mut = w.cursor_next - now;
        if (c < 0) { c = 0; }
        if (due < 0 || c < due) { due = c; }
    }
    // A transfer under way: due now when its descriptor is ready, else soon
    // — a source or a reader in another program may take its time.
    if (sel._transferring(w) == 1) {
        let is i64 as t with mut = 10;
        if (sel._transfer_ready(w) == 1) { t = 0; }
        if (due < 0 || t < due) { due = t; }
    }
    return due;
}
fn _reap_retired(w as *st.Window) as void {
    let is i32 as i with mut = 0;
    let is [0]u8 as empty;
    while (i < st.RETIRED_COUNT) {
        if (w.retired[i].used == 1 && w.retired[i].buffers[0].busy == 0 &&
            w.retired[i].buffers[1].busy == 0) {
            if (w.retired[i].buffers[0].object != 0) {
                st._send(w, w.retired[i].buffers[0].object, 0, &empty[0], 0, 0 - 1);
            }
            if (w.retired[i].buffers[1].object != 0) {
                st._send(w, w.retired[i].buffers[1].object, 0, &empty[0], 0, 0 - 1);
            }
            if (cast(i64, w.retired[i].pixels) != 0) {
                linux.munmap(w.retired[i].pixels, w.retired[i].bytes * st.BUFFER_COUNT);
            }
            mem.memzero(cast(*u8, &w.retired[i]), sizeof(st.BufferSet));
        }
        i = i + 1;
    }
}

fn _retire_current(w as *st.Window) as i32 {
    _reap_retired(w);
    let is i32 as slot with mut = 0;
    while (slot < st.RETIRED_COUNT && w.retired[slot].used == 1) { slot = slot + 1; }
    if (slot >= st.RETIRED_COUNT) { return 0; }
    w.retired[slot].pixels = w.pixels;
    w.retired[slot].bytes = w.bytes;
    w.retired[slot].buffers[0] = w.buffers[0];
    w.retired[slot].buffers[1] = w.buffers[1];
    w.retired[slot].used = 1;
    w.pixels = cast(*u8, 0);
    w.bytes = 0; w.stride = 0; w.buffer_width = 0; w.buffer_height = 0;
    w.buffers[0].object = 0; w.buffers[0].busy = 0;
    w.buffers[1].object = 0; w.buffers[1].busy = 0;
    w.current = 0 - 1; w.last_buffer = 0 - 1;
    return 1;
}

fn _dispatch(w as *st.Window, obj as i32) as void {
    let is u32 as h = st._word(&st._wire[4]);
    let is i32 as op = cast(i32, h & 65535);
    let is *u8 as p = &st._wire[8];
    if (obj == 1 && op == 0) { w.err = st.NO_COMPOSITOR; w.opened = 0; return; }
    
    if (obj == w.registry && op == 0) { _registry_global(); return; }
    if (obj == w.surface && (op == 0 || op == 1)) {
        _surface_output(w, cast(i32, st._word(p)), cast(i32, op == 0));
        return;
    }
    let is i32 as output_i with mut = 0;
    while (output_i < w.output_count) {
        if (obj == w.outputs[output_i].object) {
            _output_event(w, obj, op, p);
            return;
        }
        output_i = output_i + 1;
    }
    if (obj == w.fractional_surface && op == 0 && w.fractional_active == 1) {
        _set_scale120(w, cast(i32, st._word(p)), 1);
        return;
    }
    if (obj == w.token_object && obj != 0 && op == 0) { _token_done(w, p); return; }
    if (obj == w.exported && obj != 0 && op == 0) { _export_said(w, p); return; }
    if (obj == w.presentation && obj != 0 && op == 0) { st._globals.presentation_clock = cast(i32, st._word(p)); return; }
    if (_feedback_index(w, obj) >= 0) { _feedback_event(w, _feedback_index(w, obj), op, p); return; }
    if (obj == w.data_device) { sel._data_device_event(w, op, p); return; }
    if (obj == w.primary_device) { sel._primary_device_event(w, op, p); return; }
    if (obj == w.text_input) { ti._text_input_event(w, op, p); return; }
    if (sel._offer_index(w, obj, 0, 0) >= 0) { sel._data_offer_event(w, obj, op, p); return; }
    if (sel._source_index(w, obj) >= 0) { sel._source_event(w, obj, op, p); return; }
    if (obj == w.seat && op == 0) { _seat_capabilities(w, st._word(p)); return; }
    if (obj == w.keyboard) { kb._keyboard_event(w, op, p); return; }
    if (obj == w.pointer) { ptr._pointer_event(w, op, p); return; }
    if (obj == w.touch) { ptr._touch_event(w, op, p); return; }
    if (obj == w.tablet_seat) { ptr._tablet_seat_event(w, op, p); return; }
    if (obj != 0 && (obj == w.swipe || obj == w.pinch || obj == w.hold)) { ptr._gesture_event(w, obj, op, p); return; }
    if (ptr._tool_index(w, obj) >= 0) { ptr._tool_event(w, ptr._tool_index(w, obj), op, p); return; }
    if (ptr._tablet_index(w, obj) >= 0) { ptr._tablet_event(w, ptr._tablet_index(w, obj), op); return; }
    if (obj == w.registry_sync && op == 0) { w.registry_sync = 0; w.acked = 1; return; }
    if (obj == w.wm_base && op == 0) {
        let is [4]u8 as b;
        st._put(&b[0], st._word(p));
        st._send(w, w.wm_base, 3, &b[0], 4, 0 - 1);
        return;
    }
    if (obj == w.xdg_surface && op == 0) {
        let is [4]u8 as b;
        st._put(&b[0], st._word(p));
        st._send(w, w.xdg_surface, 4, &b[0], 4, 0 - 1);
        w.acked = 2;
        return;
    }
    if (obj == w.toplevel && op == 0) {
        let is i32 as nw = cast(i32, st._word(p));
        let is i32 as nh = cast(i32, st._word(cast(*u8, cast(i64, p) + 4)));
        // Zero means the client chooses this axis; do not keep maximized size.
        w.configured_width = nw;
        w.configured_height = nh;
        let is i32 as bytes = cast(i32, st._word(cast(*u8, cast(i64, p) + 8)));
        if (bytes >= 0 && (bytes & 3) == 0 && 20 + bytes <= st._wire_size) {
            let is i32 as count = bytes / 4;
            let is i32 as i with mut = 0;
            let is i32 as state with mut = 0;
            while (i < count) {
                let is u32 as s = st._word(cast(*u8, cast(i64, p) + 12 + i * 4));
                if (s == 1) { state = state | event.STATE_MAXIMIZED; }
                if (s == 2) { state = state | event.STATE_FULLSCREEN; }
                if (s == 5) { state = state | event.STATE_TILED_LEFT; }
                if (s == 6) { state = state | event.STATE_TILED_RIGHT; }
                if (s == 7) { state = state | event.STATE_TILED_TOP; }
                if (s == 8) { state = state | event.STATE_TILED_BOTTOM; }
                // xdg_toplevel 6: not shown — minimized, or as good as.
                if (s == 9) { state = state | event.STATE_MINIMIZED; }
                i = i + 1;
            }
            // The size it had as a normal window, kept while it is not one;
            // shown or not is no part of that.
            if (_floating(w.state) == 1 && _floating(state) == 0) {
                w.normal_width = w.logical_width;
                w.normal_height = w.logical_height;
            }
            w.state = state;
        }
        return;
    }
    if (obj == w.xdg_popup && w.xdg_popup != 0 && op == 0) {
        w.popup_x = cast(i32, st._word(p));
        w.popup_y = cast(i32, st._word(cast(*u8, cast(i64, p) + 4)));
        w.configured_width = cast(i32, st._word(cast(*u8, cast(i64, p) + 8)));
        w.configured_height = cast(i32, st._word(cast(*u8, cast(i64, p) + 12)));
        return;
    }
    if (obj == w.xdg_popup && w.xdg_popup != 0 && op == 1) {
        w.popup_done = 1;
        st._event(w, event.POPUP_DONE);
        return;
    }
    if (obj == w.xdg_popup && w.xdg_popup != 0 && op == 2) { return; }
    if (obj == w.toplevel && op == 1) {
        w.close_requested = 1;
        st._event(w, event.CLOSE);
        return;
    }
    if (obj == w.toplevel_decoration && op == 0) {
        w.server_decorated = cast(i32, st._word(p) == 2);
        return;
    }
    if (obj == w.surface && op == 0) { return; }
    if (obj == w.callback && op == 0) {
        w.callback = 0;
        w.frame_ready = 1;
        return;
    }
    if ((obj == w.buffers[0].object || obj == w.buffers[1].object) && op == 0) {
        if (obj == w.buffers[0].object) { w.buffers[0].busy = 0; }
        if (obj == w.buffers[1].object) { w.buffers[1].busy = 0; }
        w.frame_ready = 1;
        return;
    }
    let is i32 as i with mut = 0;
    while (i < st.RETIRED_COUNT) {
        if (w.retired[i].used == 1 && op == 0) {
            if (obj == w.retired[i].buffers[0].object) {
                w.retired[i].buffers[0].busy = 0; w.frame_ready = 1;
            }
            if (obj == w.retired[i].buffers[1].object) {
                w.retired[i].buffers[1].busy = 0; w.frame_ready = 1;
            }
        }
        i = i + 1;
    }
    _reap_retired(w);
}

fn _pump_one(w as *st.Window, wait as i32) as i32 {
    if (wait == 1) {
        // A transfer under way: back soon to move it on.
        let is i64 as timeout with mut = 5000;
        if (sel._transferring(w) == 1) { timeout = 10; }
        if (sys.wait_readable(w.fd, timeout) <= 0) {
            if (sel._transferring(w) == 0) { return 0; }
            sel._transfers(w);
            return 2;
        }
    } else if (sys.wait_readable(w.fd, 0) <= 0) { return 0; }
    let is i32 as obj = st._recv(w);
    if (obj == 0) { st._close_recv_fds(); return 0; }
    if (obj == 1 && (st._word(&st._wire[4]) & 65535) == 1 && st._wire_size == 12) {
        st._release_object(cast(i32, st._word(&st._wire[8])));
        return 1;
    }
    let is i32 as op = cast(i32, st._word(&st._wire[4]) & 65535);
    if (obj >= 2 && obj < st.MAX_OBJECTS && cast(i64, st._objects[obj].owner) == 0 &&
        st._objects[obj].fd_opcode == op) {
        let is i64 as abandoned = st._take_recv_fd();
        if (abandoned >= 0) { linux.close(abandoned); }
        return 1;
    }
    let is *st.Window as target with mut = w;
    if (obj >= 2 && obj < st.MAX_OBJECTS && cast(i64, st._objects[obj].owner) != 0) {
        target = st._objects[obj].owner;
    } else if (cast(u32, obj) >= 0xff000000) {
        let is i32 as i with mut = 0;
        while (i < st.MAX_WINDOWS) {
            let is *st.Window as candidate = st._windows[i];
            if (cast(i64, candidate) != 0 &&
                (sel._offer_index(candidate, obj, 0, 0) >= 0 || sel._offer_index(candidate, obj, 1, 0) >= 0 ||
                 ptr._tool_index(candidate, obj) >= 0 || ptr._tablet_index(candidate, obj) >= 0)) {
                target = candidate; break;
            }
            i = i + 1;
        }
    }
    _dispatch(target, obj);
    return 1;
}

// --- The clipboard and the primary selection ---

// The selection which (0 the clipboard, 1 the primary) ours, with what o
// offers (copied), under the last input's serial: 1, or 0 when there is no
// such selection here or no input yet to own it by.
fn clipboard_set(w as *st.Window, which as i32, o as *transfer.Offer) as i32 {
    if (w.opened == 0 || (which != 0 && which != 1) || w.input_serial == 0) { return 0; }
    let is i32 as device with mut = w.data_device;
    let is i32 as purpose with mut = st._FOR_CLIPBOARD;
    if (which == 1) { device = w.primary_device; purpose = st._FOR_PRIMARY; }
    if (device == 0) { return 0; }
    let is i32 as index = sel._source_new(w, purpose, o);
    if (index < 0) { return 0; }
    let is i32 as object = w.sources[index].object;
    let is [8]u8 as p;
    st._put(&p[0], cast(u32, object));
    st._put(&p[4], w.input_serial);
    let is i32 as opcode with mut = 1;
    if (which == 1) { opcode = 0; }
    if (st._send(w, device, opcode, &p[0], 8, 0 - 1) == 0) {
        sel._source_release(w, index, 1);
        return 0;
    }
    // The one before: the compositor cancels it, which lets it go.
    w.selection_source[which] = object;
    return 1;
}

// The selection which asked for as format — transfer.TEXT, PNG, or 0 for
// which formats it offers — what came before forgotten. It arrives as the
// pump runs (clipboard_ready); at once when the selection is ours, or has
// none of it. 1 when asked.
fn clipboard_request(w as *st.Window, which as i32, format as i32) as i32 {
    if (w.opened == 0 || (which != 0 && which != 1)) { return 0; }
    if (format != 0 && format != transfer.TEXT && format != transfer.PNG) { return 0; }
    let is i32 as device with mut = w.data_device;
    if (which == 1) { device = w.primary_device; }
    if (device == 0) { return 0; }
    sel._read_cancel(w, st.PASTE);
    let is *st.Reader as r = &w.reading[st.PASTE];
    transfer.bytes_clear(&r.data);
    w.paste_state = st._PASTE_READY;
    w.paste_got = 0;
    w.paste_offered = 0;
    // Ours: what we offer, as it is.
    let is i32 as source_i = sel._source_index(w, w.selection_source[which]);
    if (source_i >= 0) {
        let is *transfer.Offer as o = &w.sources[source_i].offer;
        w.paste_offered = o.formats & (transfer.TEXT | transfer.PNG);
        if (format != 0 && (o.formats & format) != 0) {
            let is *transfer.Bytes as b = transfer.offer_bytes(o, format);
            if (transfer.bytes_set(&r.data, b.data, b.len) == 1) { w.paste_got = format; }
        }
        return 1;
    }
    let is i32 as offer_i = sel._offer_index(w, w.selection_offer[which], which, 0);
    if (w.selection_offer[which] == 0 || offer_i < 0) { return 1; }
    w.paste_offered = w.offers[offer_i].formats & (transfer.TEXT | transfer.PNG);
    if (format == 0 || (w.offers[offer_i].formats & format) == 0) { return 1; }
    if (sel._read_start(w, st.PASTE, offer_i, format) == 0) { return 0; }
    w.paste_state = st._PASTE_PENDING;
    return 1;
}

// Whether what was asked for came (then clipboard_format and the rest have it).
fn clipboard_ready(w as *st.Window) as i32 {
    sel._readers(w);
    return cast(i32, w.paste_state == st._PASTE_READY);
}

// Whether an answer is still awaited.
fn clipboard_pending(w as *st.Window) as i32 {
    sel._readers(w);
    return cast(i32, w.paste_state == st._PASTE_PENDING);
}

// The format that came — what was asked, 0 for none — and its bytes.
fn clipboard_format(w as *st.Window) as i32 {
    if (w.paste_state != st._PASTE_READY) { return 0; }
    return w.paste_got;
}
fn clipboard_data(w as *st.Window) as *u8 {
    if (w.paste_state != st._PASTE_READY || w.paste_got == 0) { return cast(*u8, 0); }
    return w.reading[st.PASTE].data.data;
}
fn clipboard_length(w as *st.Window) as i64 {
    if (w.paste_state != st._PASTE_READY || w.paste_got == 0) { return 0; }
    return w.reading[st.PASTE].data.len;
}
// The formats the selection offered when it was asked for.
fn clipboard_offered(w as *st.Window) as i32 {
    if (w.paste_state != st._PASTE_READY) { return 0; }
    return w.paste_offered;
}

// --- Drag and drop ---

// What the program takes of the drag over the window where the pointer is
// (transfer.FILES, TEXT, 0) and how (transfer.COPY, MOVE; 0 for either, a
// copy preferred — the compositor itself makes it a move while Shift is
// held, the keyboard its during a drag): told the compositor at once. 1 when
// a drag is there.
fn drop_answer(w as *st.Window, takes as i32, action as i32) as i32 {
    if (w.opened == 0 || w.drop_offer == 0 || w.drop_pending == 1) { return 0; }
    w.drop_answer = takes & w.drop_offered;
    w.drop_want_action = action & (transfer.COPY | transfer.MOVE);
    sel._drop_accept(w);
    return 1;
}

fn dropped_files(w as *st.Window) as i64 {
    if (w.drop_ready == 0 || w.drop_kind != transfer.FILES) { return 0; }
    return w.drop_count;
}

fn dropped_file(w as *st.Window, i as i64) as *u8 {
    if (w.drop_ready == 0 || w.drop_kind != transfer.FILES) { return cast(*u8, 0); }
    return transfer.path_at(&w.drop_paths, w.drop_count, i);
}

fn dropped_text(w as *st.Window) as *u8 {
    if (w.drop_ready == 0 || w.drop_kind != transfer.TEXT || w.drop_text.len == 0) { return cast(*u8, 0); }
    return w.drop_text.data;
}

fn dropped_text_length(w as *st.Window) as i64 {
    if (w.drop_ready == 0 || w.drop_kind != transfer.TEXT) { return 0; }
    return w.drop_text.len;
}

fn clear_drop(w as *st.Window) as void {
    w.drop_ready = 0; w.drop_count = 0; w.drop_kind = 0;
    transfer.bytes_clear(&w.drop_paths);
    transfer.bytes_clear(&w.drop_text);
}

// A drag of what o offers out of the window, the actions allowed
// (transfer.COPY, MOVE), from the press of a button still held: the
// compositor runs it, and its end is a DRAG_DONE event with the action the
// target did, 0 for none. 1 when it began.
fn drag_begin(w as *st.Window, o as *transfer.Offer, actions as i32) as i32 {
    return drag_begin_carrying(w, o, actions, cast(*st.Window, 0), 0, 0);
}

// The same, carried's toplevel moving with the pointer while it lasts, the
// pointer at x_off, y_off of it (logical) — a tab torn off into a window of
// its own (xdg-toplevel-drag): left where the drag ends. 0 without the
// toplevel drag manager when a toplevel is to be carried.
fn drag_begin_carrying(w as *st.Window, o as *transfer.Offer, actions as i32, carried as *st.Window, x_off as i64, y_off as i64) as i32 {
    if (w.opened == 0 || w.data_device == 0 || w.grab_serial == 0 || w.drag_source != 0 ||
        (actions & (transfer.COPY | transfer.MOVE)) == 0) { return 0; }
    if (cast(i64, carried) != 0 && (w.toplevel_drag_manager == 0 || carried.toplevel == 0)) { return 0; }
    let is i32 as held with mut = 0;
    let is i32 as b with mut = 1;
    while (b < 8) { held = held + w.pointer_buttons[b]; b = b + 1; }
    if (held == 0) { return 0; }
    let is i32 as index = sel._source_new(w, st._FOR_DRAG, o);
    if (index < 0) { return 0; }
    let is i32 as object = w.sources[index].object;
    let is [16]u8 as p;
    if (st._bounded(st._globals.data_manager_version, 3) >= 3) {
        st._put(&p[0], cast(u32, actions & (transfer.COPY | transfer.MOVE)));
        st._send(w, object, 2, &p[0], 4, 0 - 1);
    }
    if (cast(i64, carried) != 0) {
        w.toplevel_drag = st._id(w);
        st._put(&p[0], cast(u32, w.toplevel_drag)); st._put(&p[4], cast(u32, object));
        st._send(w, w.toplevel_drag_manager, 1, &p[0], 8, 0 - 1);
        st._put(&p[0], cast(u32, carried.toplevel)); st._put(&p[4], cast(u32, x_off)); st._put(&p[8], cast(u32, y_off));
        st._send(w, w.toplevel_drag, 1, &p[0], 12, 0 - 1);
    }
    st._put(&p[0], cast(u32, object)); st._put(&p[4], cast(u32, w.surface)); st._put(&p[8], 0); st._put(&p[12], w.grab_serial);
    if (st._send(w, w.data_device, 0, &p[0], 16, 0 - 1) == 0) { sel._source_release(w, index, 1); return 0; }
    w.drag_source = object;
    // The compositor has the pointer from here: the release is its, so the
    // input says every held button is up, taken.
    b = 1;
    while (b < 8) {
        if (w.pointer_buttons[b] == 1) {
            w.pointer_buttons[b] = 0;
            let is ie.Event as up = st._input(w, ie.BUTTON_UP);
            up.button = b;
            up.detail = ie.BUTTON_TAKEN;
            up.x = w.pointer_x;
            up.y = w.pointer_y;
            st._push(w, &up, cast(*u8, 0), 0);
        }
        b = b + 1;
    }
    return 1;
}

fn _runtime_socket(w as *st.Window) as i32 {
    if (st._connection_fd >= 0) { w.fd = st._connection_fd; return st._attach(w); }
    let is *u8 as display with mut = env.getenv("WAYLAND_DISPLAY");
    let is *u8 as runtime = env.getenv("XDG_RUNTIME_DIR");
    if (cast(i64, display) == 0 || display[0] == 0) { display = "wayland-0"; }
    if (cast(i64, runtime) == 0) { return 0; }
    let is [256]u8 as path;
    let is i32 as n with mut = 0;
    if (display[0] == cast(u8, 47)) {
        while (display[n] != 0 && n < 240) { path[n] = display[n]; n = n + 1; }
    } else {
        while (runtime[n] != 0 && n < 180) { path[n] = runtime[n]; n = n + 1; }
        if (n == 0 || n >= 180) { return 0; }
        path[n] = cast(u8, 47); n = n + 1;
        let is i32 as j with mut = 0;
        while (display[j] != 0 && j < 64) { path[n] = display[j]; n = n + 1; j = j + 1; }
        if (display[j] != 0) { return 0; }
    }
    if (n <= 0 || n >= 240) { return 0; }
    path[n] = 0;
    w.fd = sys.connect_unix(&path[0], n, 0);
    if (w.fd < 0) { return 0; }
    st._connection_fd = w.fd;
    // Clipboards and drops are written to other programs' pipes: one that
    // went away is an error to see, not a signal that ends this one.
    sys.ignore_sigpipe();
    return st._attach(w);
}

// A positioner made from pos — the popup's own size w by h, logical — and
// its id; 0 when it could not be sent.
fn _positioner(w as *st.Window, pos as *st.Options, pw as i64, ph as i64) as i32 {
    let is i32 as id = st._id(w);
    if (id == 0) { return 0; }
    let is [16]u8 as b;
    st._put(&b[0], cast(u32, id));
    if (st._send(w, w.wm_base, 1, &b[0], 4, 0 - 1) == 0) { return 0; }
    st._put(&b[0], cast(u32, pw)); st._put(&b[4], cast(u32, ph));
    if (st._send(w, id, 1, &b[0], 8, 0 - 1) == 0) { return 0; }
    let is i32 as aw with mut = pos.anchor_w;
    let is i32 as ah with mut = pos.anchor_h;
    if (aw < 1) { aw = 1; }
    if (ah < 1) { ah = 1; }
    st._put(&b[0], cast(u32, pos.anchor_x)); st._put(&b[4], cast(u32, pos.anchor_y));
    st._put(&b[8], cast(u32, aw)); st._put(&b[12], cast(u32, ah));
    if (st._send(w, id, 2, &b[0], 16, 0 - 1) == 0) { return 0; }
    st._put(&b[0], cast(u32, pos.anchor));
    if (st._send(w, id, 3, &b[0], 4, 0 - 1) == 0) { return 0; }
    st._put(&b[0], cast(u32, pos.gravity));
    if (st._send(w, id, 4, &b[0], 4, 0 - 1) == 0) { return 0; }
    st._put(&b[0], cast(u32, pos.adjust));
    if (st._send(w, id, 5, &b[0], 4, 0 - 1) == 0) { return 0; }
    st._put(&b[0], cast(u32, pos.off_x)); st._put(&b[4], cast(u32, pos.off_y));
    if (st._send(w, id, 6, &b[0], 8, 0 - 1) == 0) { return 0; }
    return id;
}

// The wl_subsurface role, of the parent surface, at its place. A subsurface
// has no configure: its size is the one asked, at the parent's scale.
fn _init_subsurface(w as *st.Window) as i32 {
    if (st._globals.subcompositor_global == 0) { return 0; }
    w.subcompositor = _binding(w, cast(u32, st._globals.subcompositor_global), "wl_subcompositor", 1);
    if (w.subcompositor == 0) { return 0; }
    w.subsurface = st._id(w);
    let is [12]u8 as b;
    st._put(&b[0], cast(u32, w.subsurface)); st._put(&b[4], cast(u32, w.surface)); st._put(&b[8], cast(u32, w.pos.subsurface_of));
    if (st._send(w, w.subcompositor, 1, &b[0], 12, 0 - 1) == 0) { return 0; }
    st._put(&b[0], cast(u32, w.pos.sub_x)); st._put(&b[4], cast(u32, w.pos.sub_y));
    if (st._send(w, w.subsurface, 1, &b[0], 8, 0 - 1) == 0) { return 0; }
    w.sub_sync = 1;
    _set_scale120(w, w.pos.sub_scale120, w.pos.sub_scale);
    w.logical_width = w.width;
    w.logical_height = w.height;
    w.width = st._scale_up(w.logical_width, w.scale120);
    w.height = st._scale_up(w.logical_height, w.scale120);
    w.acked = 2;
    w.resized = 0;
    return 1;
}

// The xdg_popup role on the xdg_surface: of the parent's, placed by the
// positioner, with the seat's grab when asked — before the first commit, as
// the protocol wants it.
fn _init_popup(w as *st.Window) as i32 {
    let is i32 as pos = _positioner(w, &w.pos, w.width, w.height);
    if (pos == 0) { return 0; }
    let is [12]u8 as b;
    w.xdg_popup = st._id(w);
    st._put(&b[0], cast(u32, w.xdg_popup)); st._put(&b[4], cast(u32, w.pos.parent_surface)); st._put(&b[8], cast(u32, pos));
    if (st._send(w, w.xdg_surface, 2, &b[0], 12, 0 - 1) == 0) { return 0; }
    if (w.pos.grab == 1 && w.seat != 0) {
        st._put(&b[0], cast(u32, w.seat)); st._put(&b[4], w.pos.serial);
        if (st._send(w, w.xdg_popup, 1, &b[0], 8, 0 - 1) == 0) { return 0; }
        if (st._ngrabbers < 16) {
            st._grabbers[st._ngrabbers] = w;
            st._ngrabbers = st._ngrabbers + 1;
        }
    }
    let is [0]u8 as empty;
    return st._send(w, pos, 0, &empty[0], 0, 0 - 1);
}

fn _init_protocol(w as *st.Window, title as *u8, app_id as *u8) as i32 {
    let is [8]u8 as idbody;
    if (st._registry == 0) {
        st._registry = st._id(w);
        st._put(&idbody[0], cast(u32, st._registry));
        if (st._send(w, 1, 1, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    }
    w.registry = st._registry;
    w.registry_sync = st._id(w);
    st._put(&idbody[0], cast(u32, w.registry_sync));
    if (st._send(w, 1, 0, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    let is i32 as waited with mut = 0;
    while (w.acked == 0 && waited < 200) {
        if (_pump_one(w, 1) == 0) { return 0; }
        waited = waited + 1;
    }
    if (st._globals.compositor_global == 0 || st._globals.shm_global == 0 || st._globals.shell_global == 0) { return 0; }
    w.compositor = _binding(w, cast(u32, st._globals.compositor_global), "wl_compositor", st._bounded(st._globals.compositor_version, 4));
    w.shm = _binding(w, cast(u32, st._globals.shm_global), "wl_shm", 1);
    w.wm_base = _binding(w, cast(u32, st._globals.shell_global), "xdg_wm_base", st._bounded(st._globals.shell_version, 6));
    if (w.compositor == 0 || w.shm == 0 || w.wm_base == 0) { return 0; }
    if (st._globals.seat_global != 0) {
        w.seat = st._id(w);
        // 9: axis_value120 (8) and axis_relative_direction; not 10, whose
        // keyboard repeats keys itself — the repeat here is this client's.
        w.seat_version = st._bounded(st._globals.seat_version, 9);
        if (_bind(w, cast(u32, st._globals.seat_global), "wl_seat", w.seat_version, w.seat) == 0) { return 0; }
    }
    w.output_count = st._globals.output_count;
    let is i32 as output_i with mut = 0;
    while (output_i < w.output_count) {
        w.outputs[output_i].global = st._globals.outputs[output_i].global;
        w.outputs[output_i].version = st._globals.outputs[output_i].version;
        w.outputs[output_i].scale = 1;
        w.outputs[output_i].entered = 0;
        w.outputs[output_i].x = 0;
        w.outputs[output_i].y = 0;
        w.outputs[output_i].mode_width = 0;
        w.outputs[output_i].mode_height = 0;
        w.outputs[output_i].refresh_mhz = 0;
        w.outputs[output_i].name[0] = cast(u8, 0);
        w.outputs[output_i].object = st._id(w);
        if (_bind(w, cast(u32, w.outputs[output_i].global), "wl_output",
                    st._bounded(w.outputs[output_i].version, 4), w.outputs[output_i].object) == 0) { return 0; }
        output_i = output_i + 1;
    }
    if (st._globals.viewporter_global != 0 && st._globals.fractional_global != 0) {
        w.viewporter = _binding(w, cast(u32, st._globals.viewporter_global), "wp_viewporter", st._bounded(st._globals.viewporter_version, 1));
        w.fractional_manager = _binding(w, cast(u32, st._globals.fractional_global), "wp_fractional_scale_manager_v1", st._bounded(st._globals.fractional_version, 1));
        if (w.viewporter == 0 || w.fractional_manager == 0) { return 0; }
    }
    if (st._globals.decoration_global != 0) {
        w.decoration_manager = _binding(w, cast(u32, st._globals.decoration_global), "zxdg_decoration_manager_v1", st._bounded(st._globals.decoration_version, 2));
        if (w.decoration_manager == 0) { return 0; }
    }
    if (st._globals.dialog_global != 0) {
        w.dialog_manager = _binding(w, cast(u32, st._globals.dialog_global), "xdg_wm_dialog_v1", st._bounded(st._globals.dialog_version, 1));
        if (w.dialog_manager == 0) { return 0; }
    }
    if (st._globals.cursor_shape_global != 0) {
        w.cursor_shape_manager = _binding(w, cast(u32, st._globals.cursor_shape_global), "wp_cursor_shape_manager_v1", st._bounded(st._globals.cursor_shape_version, 1));
        if (w.cursor_shape_manager == 0) { return 0; }
    }
    if (st._globals.data_manager_global != 0) {
        w.data_manager = _binding(w, cast(u32, st._globals.data_manager_global), "wl_data_device_manager", st._bounded(st._globals.data_manager_version, 3));
        if (w.data_manager == 0) { return 0; }
    }
    if (st._globals.primary_manager_global != 0) {
        w.primary_manager = _binding(w, cast(u32, st._globals.primary_manager_global), "zwp_primary_selection_device_manager_v1", st._bounded(st._globals.primary_manager_version, 1));
        if (w.primary_manager == 0) { return 0; }
    }
    if (st._globals.text_input_manager_global != 0) {
        w.text_input_manager = _binding(w, cast(u32, st._globals.text_input_manager_global), "zwp_text_input_manager_v3", st._bounded(st._globals.text_input_manager_version, 1));
        if (w.text_input_manager == 0) { return 0; }
    }
    if (w.seat != 0 && w.data_manager != 0) {
        w.data_device = st._id(w);
        st._put(&idbody[0], cast(u32, w.data_device));
        st._put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (st._send(w, w.data_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    if (w.seat != 0 && w.primary_manager != 0) {
        w.primary_device = st._id(w);
        st._put(&idbody[0], cast(u32, w.primary_device));
        st._put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (st._send(w, w.primary_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    if (w.seat != 0 && w.text_input_manager != 0) {
        w.text_input = st._id(w);
        st._put(&idbody[0], cast(u32, w.text_input));
        st._put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (st._send(w, w.text_input_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    // Pens: the seat's tablets and tools, said as they come (version 1:
    // what pens say; later versions add pads' dials).
    if (w.seat != 0 && st._globals.tablet_manager_global != 0) {
        w.tablet_manager = _binding(w, cast(u32, st._globals.tablet_manager_global), "zwp_tablet_manager_v2", 1);
        if (w.tablet_manager == 0) { return 0; }
        w.tablet_seat = st._id(w);
        st._put(&idbody[0], cast(u32, w.tablet_seat));
        st._put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.seat));
        if (st._send(w, w.tablet_manager, 0, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    }
    // Touchpad gestures: swipe and pinch (1), hold (3).
    if (w.seat != 0 && st._globals.gestures_global != 0) {
        w.gestures_version = st._bounded(st._globals.gestures_version, 3);
        w.gestures = _binding(w, cast(u32, st._globals.gestures_global), "zwp_pointer_gestures_v1", w.gestures_version);
        if (w.gestures == 0) { return 0; }
        ptr._gesture_objects(w);
    }
    // The optional protocols the window's calls use where the compositor has
    // them (activation, exporting, the icon, presentation times, one-pixel
    // buffers, the bell, toplevel drags); without one, what uses it answers
    // 0.
    if (st._globals.activation_global != 0) {
        w.activation = _binding(w, cast(u32, st._globals.activation_global), "xdg_activation_v1", 1);
    }
    if (st._globals.exporter_global != 0) {
        w.exporter = _binding(w, cast(u32, st._globals.exporter_global), "zxdg_exporter_v2", 1);
    }
    if (st._globals.icon_global != 0) {
        w.icon_manager = _binding(w, cast(u32, st._globals.icon_global), "xdg_toplevel_icon_manager_v1", 1);
    }
    if (st._globals.presentation_global != 0) {
        w.presentation = _binding(w, cast(u32, st._globals.presentation_global), "wp_presentation", 1);
    }
    if (st._globals.single_pixel_global != 0) {
        w.single_pixel = _binding(w, cast(u32, st._globals.single_pixel_global), "wp_single_pixel_buffer_manager_v1", 1);
    }
    if (st._globals.bell_global != 0) {
        w.bell = _binding(w, cast(u32, st._globals.bell_global), "xdg_system_bell_v1", 1);
    }
    if (st._globals.toplevel_drag_global != 0) {
        w.toplevel_drag_manager = _binding(w, cast(u32, st._globals.toplevel_drag_global), "xdg_toplevel_drag_manager_v1", 1);
    }
    while (_pump_one(w, 0) == 1) { }
    w.surface = st._id(w);
    st._put(&idbody[0], cast(u32, w.surface));
    if (st._send(w, w.compositor, 0, &idbody[0], 4, 0 - 1) == 0) { return 0; }
    // Each new id is allocated where the request that creates it is sent:
    // a server takes new ids in the order they were handed out (libwayland's
    // "not a valid new object id"), so none may be held back past another.
    if (w.viewporter != 0 && w.fractional_manager != 0) {
        w.viewport = st._id(w);
        st._put(&idbody[0], cast(u32, w.viewport));
        st._put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.surface));
        if (st._send(w, w.viewporter, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
        w.fractional_surface = st._id(w);
        st._put(&idbody[0], cast(u32, w.fractional_surface));
        st._put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.surface));
        if (st._send(w, w.fractional_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
        w.fractional_active = 1;
    }
    if (w.pos.subsurface_of != 0) { return _init_subsurface(w); }
    w.xdg_surface = st._id(w);
    st._put(&idbody[0], cast(u32, w.xdg_surface));
    st._put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.surface));
    if (st._send(w, w.wm_base, 2, &idbody[0], 8, 0 - 1) == 0) { return 0; }
    if (w.popup_kind != 0) {
        if (_init_popup(w) == 0) { return 0; }
    } else {
        w.toplevel = st._id(w);
        st._put(&idbody[0], cast(u32, w.toplevel));
        if (st._send(w, w.xdg_surface, 1, &idbody[0], 4, 0 - 1) == 0) { return 0; }
        if (w.decoration_manager != 0) {
            w.toplevel_decoration = st._id(w);
            st._put(&idbody[0], cast(u32, w.toplevel_decoration));
            st._put(cast(*u8, cast(i64, &idbody) + 4), cast(u32, w.toplevel));
            if (st._send(w, w.decoration_manager, 1, &idbody[0], 8, 0 - 1) == 0) { return 0; }
            let is [4]u8 as mode;
            if (w.decorated_wanted != 0) { st._put(&mode[0], 2); }
            else { st._put(&mode[0], 1); }
            if (st._send(w, w.toplevel_decoration, 1, &mode[0], 4, 0 - 1) == 0) { return 0; }
        }
        if (st._send_string(w, w.toplevel, 2, title) == 0) { return 0; }
        if (st._send_string(w, w.toplevel, 3, app_id) == 0) { return 0; }
    }
    // Request the initial configure; the xdg-shell role is not usable until
    // the compositor configures the surface and the client acknowledges it.
    if (st._send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    waited = 0;
    while (w.acked != 2 && waited < 200) {
        if (_pump_one(w, 1) == 0) { return 0; }
        waited = waited + 1;
    }
    if (w.acked != 2) { return 0; }
    if (w.configured_width > 0) { w.logical_width = w.configured_width; }
    else { w.logical_width = w.width; }
    if (w.configured_height > 0) { w.logical_height = w.configured_height; }
    else { w.logical_height = w.height; }
    w.width = st._scale_up(w.logical_width, w.scale120);
    w.height = st._scale_up(w.logical_height, w.scale120);
    if (w.width <= 0 || w.height <= 0) { return 0; }
    w.resized = 0;
    return 1;
}

fn _make_buffers(w as *st.Window) as i32 {
    if (w.bytes <= 0 || w.bytes > 1073741824) { return 0; }
    w.memfd = sys.memfd_create("caustic-wayland-buffer", 1);
    if (w.memfd < 0) { return 0; }
    if (linux.ftruncate(w.memfd, w.bytes * st.BUFFER_COUNT) != 0) { return 0; }
    w.pixels = linux.mmap(cast(*u8, 0), w.bytes * st.BUFFER_COUNT, linux.PROT_READ | linux.PROT_WRITE,
                          linux.MAP_SHARED, w.memfd, 0);
    if (cast(i64, w.pixels) == linux.MAP_FAILED) { w.pixels = cast(*u8, 0); return 0; }
    w.pool = st._id(w);
    let is [24]u8 as p;
    st._put(&p[0], cast(u32, w.pool)); st._put(&p[4], cast(u32, w.bytes * st.BUFFER_COUNT));
    if (st._send(w, w.shm, 0, &p[0], 8, w.memfd) == 0) { return 0; }
    w.buffers[0].object = st._id(w); w.buffers[1].object = st._id(w);
    let is i32 as i with mut = 0;
    while (i < st.BUFFER_COUNT) {
        let is i64 as off = i * w.bytes;
        st._put(&p[0], cast(u32, w.buffers[i].object));
        st._put(cast(*u8, cast(i64, &p[0]) + 4), cast(u32, off));
        st._put(cast(*u8, cast(i64, &p[0]) + 8), cast(u32, w.width));
        st._put(cast(*u8, cast(i64, &p[0]) + 12), cast(u32, w.height));
        st._put(cast(*u8, cast(i64, &p[0]) + 16), cast(u32, w.stride));
        st._put(cast(*u8, cast(i64, &p[0]) + 20), st.FORMAT_ARGB8888);
        if (st._send(w, w.pool, 0, &p[0], 24, 0 - 1) == 0) { return 0; }
        w.buffers[i].busy = 0;
        w.buffers[i].at = 0;
        i = i + 1;
    }
    let is [0]u8 as empty;
    if (st._send(w, w.pool, 1, &empty[0], 0, 0 - 1) == 0) { return 0; }
    linux.close(w.memfd);
    w.memfd = 0 - 1;
    w.pool = 0;
    w.buffer_width = w.width; w.buffer_height = w.height;
    return 1;
}

fn _destroy_buffers(w as *st.Window) as void {
    let is [0]u8 as empty;
    let is i32 as i with mut = 0;
    while (i < st.BUFFER_COUNT) {
        if (w.buffers[i].object != 0) {
            st._send(w, w.buffers[i].object, 0, &empty[0], 0, 0 - 1);
            w.buffers[i].object = 0;
        }
        i = i + 1;
    }
    if (cast(i64, w.pixels) != 0) {
        linux.munmap(w.pixels, w.bytes * st.BUFFER_COUNT);
        w.pixels = cast(*u8, 0);
    }
    w.last_buffer = 0 - 1;
    w.current = 0 - 1;
    w.buffer_width = 0; w.buffer_height = 0;
}

fn _discard(w as *st.Window) as void { close(w); }
// The caller owns the storage and keeps it at this address until close.
fn open_config(w as *st.Window, title as *u8, width as i64, height as i64, options as *st.Options) as i32 {
    st._zero(w);
    let is st.Options as o with mut = options();
    if (cast(i64, options) != 0) { o = *options; }
    w.width = width; w.height = height; w.decorated_wanted = o.decorated;
    w.popup_kind = o.popup; w.pos = o;
    w.keymap_kind = o.keymap;
    if (o.popup != 0 && o.parent_surface == 0) { w.err = st.NO_CONFIGURE; return 0; }
    if (width <= 0 || height <= 0) { w.err = st.NO_CONFIGURE; return 0; }
    if (_protocol_ready() == 0) { w.err = st.NO_PROTOCOL; return 0; }
    if (_runtime_socket(w) == 0) { w.err = st.NO_RUNTIME; return 0; }
    // Its input's queue, there before the first event can come.
    w.input = ie.create();
    if (cast(i64, w.input) == 0) { w.err = st.NO_MEMORY; _discard(w); return 0; }
    if (_init_protocol(w, title, o.app_id) == 0) { w.err = st.NO_COMPOSITOR; _discard(w); return 0; }
    w.opened = 1;
    if (o.popup == 0 && o.parent != 0 && set_parent(w, o.parent) == 0) {
        w.err = st.NO_SHELL; _discard(w); return 0;
    }
    if (o.popup == 0 && o.resizable == 0) {
        if (set_min_size(w, width, height) == 0 || set_max_size(w, width, height) == 0) {
            w.err = st.NO_SHELL; _discard(w); return 0;
        }
    }
    if (o.popup == 0 && o.modal != 0) { set_modal(w, 1); }
    // A tooltip takes no input: the pointer goes through it to whatever lies
    // beneath. Told before the frame callback's commit below.
    if (o.popup == 3 && set_input_region(w, 0, 0, 0, 0) == 0) { w.err = st.NO_SHELL; _discard(w); return 0; }
    w.stride = w.width * 4; w.bytes = w.stride * w.height;
    if (_make_buffers(w) == 0) { w.err = st.NO_MEMORY; _discard(w); return 0; }
    let is i32 as id = st._id(w);
    let is [4]u8 as p;
    st._put(&p[0], cast(u32, id));
    if (st._send(w, w.surface, 3, &p[0], 4, 0 - 1) == 0) { w.err = st.NO_SHELL; _discard(w); return 0; }
    if (st._send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { w.err = st.NO_SHELL; _discard(w); return 0; }
    w.callback = id;
    w.err = st.OK; w.mapped = 0;
    return 1;
}

fn open(w as *st.Window, title as *u8, width as i64, height as i64) as i32 {
    let is st.Options as o = options();
    return open_config(w, title, width, height, &o);
}

fn error(w as *st.Window) as i32 { return w.err; }
fn is_open(w as *st.Window) as i32 { return w.opened; }
fn should_close(w as *st.Window) as i32 { return w.close_requested; }
fn width(w as *st.Window) as i64 { return w.width; }
fn height(w as *st.Window) as i64 { return w.height; }
fn scale(w as *st.Window) as i32 { return w.scale120; }
fn state(w as *st.Window) as i32 { return w.state; }

// The output the window is on, as wl_output says it: its place in the
// compositor's space, its mode, the window's scale there, its name. No work
// area on Wayland: the whole output. 1 once the window has entered one.
fn monitor_of(w as *st.Window, out as *monitor.Monitor) as i32 {
    monitor.clear(out);
    if (w.opened == 0 || w.active_output < 0) { return 0; }
    let is *st.Output as o = &w.outputs[w.active_output];
    out.x = cast(i64, o.x);
    out.y = cast(i64, o.y);
    out.width = cast(i64, o.mode_width);
    out.height = cast(i64, o.mode_height);
    monitor.work_is_whole(out);
    out.scale120 = w.scale120;
    out.refresh_mhz = cast(i64, o.refresh_mhz);
    monitor.set_name(out, &o.name[0], 32);
    return 1;
}
fn native_fd(w as *st.Window) as i64 { return w.fd; }
fn native_surface(w as *st.Window) as i32 { return w.surface; }
fn native_toplevel(w as *st.Window) as i32 { return w.toplevel; }
fn native_xdg_surface(w as *st.Window) as i32 { return w.xdg_surface; }
fn grab_serial(w as *st.Window) as u32 { return w.grab_serial; }
fn popup_done(w as *st.Window) as i32 { return w.popup_done; }
// Whether the popup holds the seat's grab: asked with a seat to ask it of,
// and not refused (a refused grab takes the popup down).
fn grabbing(w as *st.Window) as i32 {
    return cast(i32, w.opened == 1 && w.xdg_popup != 0 && w.pos.grab == 1 && w.seat != 0 && w.popup_done == 0);
}

// --- Subsurfaces ---

// w opened as a subsurface of parent: width by height logical pixels, its top
// left at x, y of the parent's surface. Synchronized at first: what it
// commits is shown with its parent's next commit. 1 when opened; the caller
// keeps w where it is until close. Closing the parent leaves it inert, its
// own close still due.
fn open_subsurface(w as *st.Window, parent as *st.Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    if (parent.opened == 0 || parent.surface == 0) {
        st._zero(w);
        w.err = st.NO_CONFIGURE;
        return 0;
    }
    let is st.Options as o with mut = options();
    o.subsurface_of = parent.surface;
    o.sub_x = cast(i32, x);
    o.sub_y = cast(i32, y);
    o.sub_scale120 = parent.scale120;
    o.sub_scale = parent.scale;
    return open_config(w, "", width, height, &o);
}

fn is_subsurface(w as *st.Window) as i32 { return cast(i32, w.opened == 1 && w.subsurface != 0); }

// Its place in the parent's surface, logical: taken with the parent's next
// commit, whatever the subsurface's mode.
fn sub_set_position(w as *st.Window, x as i64, y as i64) as i32 {
    if (is_subsurface(w) == 0) { return 0; }
    let is [8]u8 as b;
    st._put(&b[0], cast(u32, x)); st._put(&b[4], cast(u32, y));
    return st._send(w, w.subsurface, 1, &b[0], 8, 0 - 1);
}

// Just above (or below) sibling — another subsurface of the same parent, or
// the parent itself — with the parent's next commit.
fn sub_place_above(w as *st.Window, sibling as *st.Window) as i32 {
    if (is_subsurface(w) == 0 || sibling.opened == 0 || sibling.surface == 0) { return 0; }
    let is [4]u8 as b;
    st._put(&b[0], cast(u32, sibling.surface));
    return st._send(w, w.subsurface, 2, &b[0], 4, 0 - 1);
}

fn sub_place_below(w as *st.Window, sibling as *st.Window) as i32 {
    if (is_subsurface(w) == 0 || sibling.opened == 0 || sibling.surface == 0) { return 0; }
    let is [4]u8 as b;
    st._put(&b[0], cast(u32, sibling.surface));
    return st._send(w, w.subsurface, 3, &b[0], 4, 0 - 1);
}

// Synchronized (1): its commits wait for its parent's. Desynchronized (0):
// they are shown as they come — while no ancestor is synchronized.
fn sub_set_sync(w as *st.Window, on as i32) as i32 {
    if (is_subsurface(w) == 0) { return 0; }
    let is [0]u8 as empty;
    let is i32 as op with mut = 5;
    if (on != 0) { op = 4; }
    if (st._send(w, w.subsurface, op, &empty[0], 0, 0 - 1) == 0) { return 0; }
    w.sub_sync = cast(i32, on != 0);
    return 1;
}

fn sub_sync(w as *st.Window) as i32 { return w.sub_sync; }

// The surface's pending state committed with no new content: what a parent
// does to apply its subsurfaces' places, order and cached commits.
fn commit(w as *st.Window) as i32 {
    if (w.opened == 0) { return 0; }
    return st._surface_commit(w);
}

// Where the window geometry starts in the surface, logical pixels: past the
// shadow of a frame of the program's own while it is a floating window, as
// _set_window_geometry tells the compositor. A popup's positioner is in these.
fn geometry_origin(w as *st.Window, x as *i64, y as *i64) as void {
    *x = 0; *y = 0;
    if ((w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN | event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT |
        event.STATE_TILED_TOP | event.STATE_TILED_BOTTOM)) != 0) { return; }
    let is i64 as left = st._scale_down(w.ext_left, w.scale120);
    let is i64 as right = st._scale_down(w.ext_right, w.scale120);
    let is i64 as top = st._scale_down(w.ext_top, w.scale120);
    let is i64 as bottom = st._scale_down(w.ext_bottom, w.scale120);
    if (left + right < w.logical_width) { *x = left; }
    if (top + bottom < w.logical_height) { *y = top; }
}

// Where the compositor put the popup, relative to its parent's client in the
// parent's physical pixels: 1, or 0 for a window that is not a popup.
fn popup_position(w as *st.Window, parent as *st.Window, x as *i64, y as *i64) as i32 {
    if (w.opened == 0 || w.xdg_popup == 0) { return 0; }
    let is i64 as gx with mut = 0;
    let is i64 as gy with mut = 0;
    geometry_origin(parent, &gx, &gy);
    *x = st._scale_up(cast(i64, w.popup_x) + gx, parent.scale120);
    *y = st._scale_up(cast(i64, w.popup_y) + gy, parent.scale120);
    return 1;
}

// The size the compositor gave the popup in its last configure — cut where
// the room was short and the positioner let it — in its parent's physical
// pixels, as popup_position is: 1, or 0 for a window that is not a popup.
fn popup_size(w as *st.Window, parent as *st.Window, pw as *i64, ph as *i64) as i32 {
    if (w.opened == 0 || w.xdg_popup == 0) { return 0; }
    let is i64 as lw with mut = w.logical_width;
    let is i64 as lh with mut = w.logical_height;
    if (w.configured_width > 0) { lw = w.configured_width; }
    if (w.configured_height > 0) { lh = w.configured_height; }
    *pw = st._scale_up(lw, parent.scale120);
    *ph = st._scale_up(lh, parent.scale120);
    return 1;
}

// The popup placed again by pos, its size pw by ph logical: the compositor
// answers with a configure. xdg_popup 3 and later; 0 where it cannot be asked.
fn reposition(w as *st.Window, pos as *st.Options, pw as i64, ph as i64) as i32 {
    if (w.opened == 0 || w.xdg_popup == 0 || st._bounded(st._globals.shell_version, 6) < 3 || pw <= 0 || ph <= 0) { return 0; }
    let is i32 as id = _positioner(w, pos, pw, ph);
    if (id == 0) { return 0; }
    let is [8]u8 as b;
    w.reposition_token = w.reposition_token + 1;
    st._put(&b[0], cast(u32, id)); st._put(&b[4], cast(u32, w.reposition_token));
    if (st._send(w, w.xdg_popup, 2, &b[0], 8, 0 - 1) == 0) { return 0; }
    let is [0]u8 as empty;
    if (st._send(w, id, 0, &empty[0], 0, 0 - 1) == 0) { return 0; }
    w.pos = *pos;
    return 1;
}

// Whether state is a normal window's — not maximized, full screen or tiled —
// shown or not: its size its own, its shadow round it.
fn _floating(state as i32) as i32 { return cast(i32, (state & cast(i32, 0 - 1 - event.STATE_MINIMIZED)) == 0); }

fn _apply_configure(w as *st.Window) as void {
    let is i64 as logical_w with mut = w.logical_width;
    let is i64 as logical_h with mut = w.logical_height;
    let is i64 as shadow_w with mut = 0;
    let is i64 as shadow_h with mut = 0;
    let is i32 as floating = _floating(w.state);
    let is i32 as restored = cast(i32, floating == 1 && _floating(w.old_state) == 0);
    if (floating == 1) {
        shadow_w = st._scale_down(w.ext_left + w.ext_right, w.scale120);
        shadow_h = st._scale_down(w.ext_top + w.ext_bottom, w.scale120);
    }
    if (w.configured_width > 0) { logical_w = w.configured_width + shadow_w; }
    else if (restored == 1 && w.normal_width > 0) { logical_w = w.normal_width; }
    if (w.configured_height > 0) { logical_h = w.configured_height + shadow_h; }
    else if (restored == 1 && w.normal_height > 0) { logical_h = w.normal_height; }
    let is i64 as width with mut = st._scale_up(logical_w, w.scale120);
    let is i64 as height with mut = st._scale_up(logical_h, w.scale120);
    // A compositor may leave the size to the client, including after the
    // toolkit publishes a larger minimum for its client-side frame.
    if (floating == 1 && width < w.min_width) {
        logical_w = (w.min_width * 120 + w.scale120 - 1) / w.scale120;
        width = st._scale_up(logical_w, w.scale120);
    }
    if (floating == 1 && height < w.min_height) {
        logical_h = (w.min_height * 120 + w.scale120 - 1) / w.scale120;
        height = st._scale_up(logical_h, w.scale120);
    }
    if (logical_w > 0 && logical_h > 0 &&
        (w.logical_width != logical_w || w.logical_height != logical_h ||
         w.width != width || w.height != height)) {
        w.logical_width = logical_w;
        w.logical_height = logical_h;
        w.width = width; w.height = height;
        w.resized = 1;
        let is event.Event as e;
        event.clear(&e); e.kind = event.RESIZE; e.width = w.width; e.height = w.height;
        st._queue(w, &e);
    }
    if (w.state != w.old_state) {
        w.old_state = w.state;
        let is event.Event as e;
        event.clear(&e); e.kind = event.STATE; e.state = w.state;
        st._queue(w, &e);
    }
}

fn resized(w as *st.Window) as i32 { return w.resized; }

fn next_frame(w as *st.Window) as i32 {
    if (w.opened == 0) { return 0; }
    kb._repeat_keys(w, time.now_ms());
    ptr._cursor_tick(w, time.now_ms());
    if (w.mapped == 0) { w.mapped = 1; w.frame_ready = 1; return 1; }
    if (w.event_len > 0) { return 1; }
    if (w.frame_ready == 1) { w.resized = 0; return 1; }
    w.resized = 0;
    if (w.close_requested == 1) { return 0; }
    while (w.frame_ready == 0 && w.resized == 0 && w.event_len == 0 && w.close_requested == 0) {
        if (_pump_one(w, 1) == 0) { w.err = st.NO_SOCKET; w.opened = 0; return 0; }
        _apply_configure(w);
    }
    if (w.resized == 1 || w.event_len > 0) { return 1; }
    if (w.frame_ready == 1) { return 1; }
    return cast(i32, w.close_requested == 0);
}

fn pending(w as *st.Window) as i32 {
    if (sel._transferring(w) == 1) { sel._transfers(w); }
    if (w.event_len > 0) { return 1; }
    if (cast(i64, w.input) != 0 && ie.pending(w.input) == 1) { return 1; }
    if (input_due(w) == 0) { return 1; }
    if (w.fd < 0) { return 0; }
    return cast(i32, sys.wait_readable(w.fd, 0) > 0);
}

fn keep_open(w as *st.Window) as void { w.close_requested = 0; }
fn request_close(w as *st.Window) as void {
    if (w.opened == 0 || w.close_requested == 1) { return; }
    w.close_requested = 1;
    let is event.Event as e;
    event.clear(&e); e.kind = event.CLOSE;
    st._queue(w, &e);
}

fn acquire(w as *st.Window) as tgt.Target {
    let is tgt.Target as t;
    t.color = cast(*u8, 0); t.depth = cast(*u8, 0); t.width = 0; t.height = 0;
    w.current = 0 - 1;
    if (w.opened == 0) { return t; }
    if (w.buffer_width != w.width || w.buffer_height != w.height) {
        pump(w);
        if (w.buffers[0].busy == 1 || w.buffers[1].busy == 1) {
            if (_retire_current(w) == 0) {
                if (w.resize_detached == 0) {
                    let is [12]u8 as p;
                    st._put(&p[0], 0); st._put(&p[4], 0); st._put(&p[8], 0);
                    if (st._send(w, w.surface, 1, &p[0], 12, 0 - 1) == 0 ||
                        st._surface_commit(w) == 0) { return t; }
                    w.resize_detached = 1; w.visible = 0;
                }
                return t;
            }
        } else { _destroy_buffers(w); }
        w.stride = w.width * 4; w.bytes = w.stride * w.height;
        if (_make_buffers(w) == 0) { w.err = st.NO_MEMORY; return t; }
        w.resize_detached = 0;
    }
    let is i32 as i with mut = 0;
    while (i < st.BUFFER_COUNT && w.buffers[i].busy == 1) { i = i + 1; }
    if (i >= st.BUFFER_COUNT) { return t; }
    w.current = i;
    t.color = cast(*u8, cast(i64, w.pixels) + i * w.bytes);
    t.width = w.width; t.height = w.height;
    return t;
}

fn _set_window_geometry(w as *st.Window, with_extents as i32) as i32 {
    if (w.logical_width <= 0 || w.logical_height <= 0 || w.scale120 <= 0) { return 0; }
    // A subsurface has no window geometry: it is part of its parent's.
    if (w.xdg_surface == 0) { return 1; }
    let is i64 as left with mut = st._scale_down(w.ext_left, w.scale120);
    let is i64 as right with mut = st._scale_down(w.ext_right, w.scale120);
    let is i64 as top with mut = st._scale_down(w.ext_top, w.scale120);
    let is i64 as bottom with mut = st._scale_down(w.ext_bottom, w.scale120);
    if (with_extents == 0) {
        left = 0; right = 0; top = 0; bottom = 0;
    } else {
        if (left + right >= w.logical_width) { left = 0; right = 0; }
        if (top + bottom >= w.logical_height) { top = 0; bottom = 0; }
    }
    let is [16]u8 as p;
    st._put(&p[0], cast(u32, left)); st._put(&p[4], cast(u32, top));
    st._put(&p[8], cast(u32, w.logical_width - left - right));
    st._put(&p[12], cast(u32, w.logical_height - top - bottom));
    return st._send(w, w.xdg_surface, 3, &p[0], 16, 0 - 1);
}

// How old acquire's buffer is: 1 when it holds the frame committed last, 2
// the one before; 0 when it holds none since it was made.
fn buffer_age(w as *st.Window) as i32 {
    if (w.opened == 0 || w.current < 0) { return 0; }
    let is i64 as at = w.buffers[w.current].at;
    if (at == 0) { return 0; }
    return cast(i32, w.presents - at + 1);
}

// n pixels at p from the software target's RGBA to WL_SHM_FORMAT_ARGB8888's
// BGRA bytes (little-endian), premultiplied as the format is read.
fn _to_argb(p as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is *u8 as q = cast(*u8, cast(i64, p) + i * 4);
        let is i64 as a = cast(i64, q[3]);
        let is i64 as r with mut = cast(i64, q[0]);
        let is i64 as g with mut = cast(i64, q[1]);
        let is i64 as b with mut = cast(i64, q[2]);
        if (a < 255) {
            r = (r * a + 127) / 255;
            g = (g * a + 127) / 255;
            b = (b * a + 127) / 255;
        }
        q[0] = cast(u8, b); q[1] = cast(u8, g); q[2] = cast(u8, r);
        i = i + 1;
    }
}

fn submit(w as *st.Window) as void { _present(w, cast(*damage.List, 0)); }

// The frame presented by the rectangles of l, the only ones drawn into the
// buffer since its age: those converted and told the compositor as damage.
fn submit_region(w as *st.Window, l as *damage.List) as void { _present(w, l); }

fn _present(w as *st.Window, l as *damage.List) as void {
    if (w.opened == 0 || w.current < 0 || w.buffers[w.current].busy == 1) { return; }
    if (_set_window_geometry(w, cast(i32, (w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN |
        event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT | event.STATE_TILED_TOP |
        event.STATE_TILED_BOTTOM)) == 0)) == 0) { return; }
    let is i32 as whole = cast(i32, cast(i64, l) == 0 || l.whole == 1);
    // Caustic's software target is RGBA bytes: converted in place, the whole
    // buffer for a whole frame, else only the rectangles drawn — converting a
    // pixel twice would undo it.
    let is i64 as base = cast(i64, w.pixels) + w.current * w.bytes;
    if (whole == 1) {
        _to_argb(cast(*u8, base), w.width * w.height);
    } else {
        let is i32 as k with mut = 0;
        while (k < l.n) {
            let is *damage.Rect as r = &l.rects[k];
            let is i64 as row with mut = 0;
            while (row < cast(i64, r.h)) {
                _to_argb(cast(*u8, base + (cast(i64, r.y) + row) * w.stride + cast(i64, r.x) * 4), cast(i64, r.w));
                row = row + 1;
            }
            k = k + 1;
        }
    }
    let is i32 as id = st._id(w);
    let is [16]u8 as p;
    st._put(&p[0], cast(u32, w.scale));
    if (st._send(w, w.surface, 8, &p[0], 4, 0 - 1) == 0) { return; }
    if (w.fractional_active == 1 && w.viewport != 0) {
        st._put(&p[0], cast(u32, w.logical_width));
        st._put(&p[4], cast(u32, w.logical_height));
        if (st._send(w, w.viewport, 2, &p[0], 8, 0 - 1) == 0) { return; }
    }
    st._put(&p[0], cast(u32, w.buffers[w.current].object));
    st._put(cast(*u8, cast(i64, &p) + 4), 0);
    st._put(cast(*u8, cast(i64, &p) + 8), 0);
    st._send(w, w.surface, 1, &p[0], 12, 0 - 1);
    if (whole == 1) {
        st._put(&p[0], 0); st._put(cast(*u8, cast(i64, &p) + 4), 0);
        st._put(cast(*u8, cast(i64, &p) + 8), cast(u32, w.logical_width));
        st._put(cast(*u8, cast(i64, &p) + 12), cast(u32, w.logical_height));
        if (st._send(w, w.surface, 2, &p[0], 16, 0 - 1) == 0) { return; }
    } else if (st._bounded(st._globals.compositor_version, 4) >= 4) {
        // damage_buffer: the rectangles as they are, in the buffer's pixels.
        let is i32 as k with mut = 0;
        while (k < l.n) {
            let is *damage.Rect as r = &l.rects[k];
            st._put(&p[0], cast(u32, r.x)); st._put(&p[4], cast(u32, r.y));
            st._put(&p[8], cast(u32, r.w)); st._put(&p[12], cast(u32, r.h));
            if (st._send(w, w.surface, 9, &p[0], 16, 0 - 1) == 0) { return; }
            k = k + 1;
        }
    } else {
        // damage, before wl_surface 4: in surface coordinates, rounded out.
        let is i32 as k with mut = 0;
        while (k < l.n) {
            let is *damage.Rect as r = &l.rects[k];
            let is i64 as x0 = (cast(i64, r.x) * 120) / w.scale120;
            let is i64 as y0 = (cast(i64, r.y) * 120) / w.scale120;
            let is i64 as x1 = ((cast(i64, r.x + r.w)) * 120 + w.scale120 - 1) / w.scale120;
            let is i64 as y1 = ((cast(i64, r.y + r.h)) * 120 + w.scale120 - 1) / w.scale120;
            st._put(&p[0], cast(u32, x0)); st._put(&p[4], cast(u32, y0));
            st._put(&p[8], cast(u32, x1 - x0)); st._put(&p[12], cast(u32, y1 - y0));
            if (st._send(w, w.surface, 2, &p[0], 16, 0 - 1) == 0) { return; }
            k = k + 1;
        }
    }
    st._put(&p[0], cast(u32, id));
    st._send(w, w.surface, 3, &p[0], 4, 0 - 1);
    _feedback_ask(w);
    st._send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1);
    w.callback = id;
    w.buffers[w.current].busy = 1;
    w.presents = w.presents + 1;
    w.buffers[w.current].at = w.presents;
    w.last_buffer = w.current;
    w.visible = 1; w.resize_detached = 0;
    w.frame_ready = 0;
    w.current = 0 - 1;
    if (w.presents == 1) { _startup_activation(w); }
}

fn hide(w as *st.Window) as void {
    if (w.opened == 0 || w.visible == 0) { return; }
    let is [12]u8 as p;
    st._put(&p[0], 0); st._put(&p[4], 0); st._put(&p[8], 0);
    if (st._send(w, w.surface, 1, &p[0], 12, 0 - 1) == 0) { return; }
    if (st._send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { return; }
    w.visible = 0;
}

fn show(w as *st.Window) as void {
    if (w.opened == 0 || w.visible == 1 || w.resize_detached == 1 ||
        w.buffer_width != w.width || w.buffer_height != w.height) { return; }
    if (w.last_buffer < 0 || w.buffers[w.last_buffer].object == 0) {
        w.visible = 1;
        return;
    }
    if (_set_window_geometry(w, cast(i32, (w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN |
        event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT | event.STATE_TILED_TOP |
        event.STATE_TILED_BOTTOM)) == 0)) == 0) { return; }
    let is [16]u8 as p;
    st._put(&p[0], cast(u32, w.scale));
    if (st._send(w, w.surface, 8, &p[0], 4, 0 - 1) == 0) { return; }
    if (w.fractional_active == 1 && w.viewport != 0) {
        st._put(&p[0], cast(u32, w.logical_width));
        st._put(&p[4], cast(u32, w.logical_height));
        if (st._send(w, w.viewport, 2, &p[0], 8, 0 - 1) == 0) { return; }
    }
    st._put(&p[0], cast(u32, w.buffers[w.last_buffer].object));
    st._put(&p[4], 0); st._put(&p[8], 0);
    if (st._send(w, w.surface, 1, &p[0], 12, 0 - 1) == 0) { return; }
    st._put(&p[0], 0); st._put(&p[4], 0);
    st._put(&p[8], cast(u32, w.logical_width)); st._put(&p[12], cast(u32, w.logical_height));
    if (st._send(w, w.surface, 2, &p[0], 16, 0 - 1) == 0) { return; }
    let is i32 as callback = st._id(w);
    st._put(&p[0], cast(u32, callback));
    if (st._send(w, w.surface, 3, &p[0], 4, 0 - 1) == 0) { return; }
    if (st._send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1) == 0) { return; }
    w.callback = callback;
    w.buffers[w.last_buffer].busy = 1;
    w.visible = 1;
}

fn pump(w as *st.Window) as void {
    if (w.opened == 0) { return; }
    sel._transfers(w);
    while (_pump_one(w, 0) == 1) { }
    sel._transfers(w);
    _apply_configure(w);
    kb._repeat_keys(w, time.now_ms());
    ptr._cursor_tick(w, time.now_ms());
}

fn poll_event(w as *st.Window, out as *event.Event) as i32 {
    if (w.event_len == 0) { return 0; }
    *out = w.events[w.event_head];
    w.event_head = (w.event_head + 1) % st.MAX_EVENTS;
    w.event_len = w.event_len - 1;
    return 1;
}

// Its cooked input, oldest first (input/event.cst): 1, or 0 when none waits.
fn poll_input(w as *st.Window, out as *ie.Event) as i32 {
    if (cast(i64, w.input) == 0) { return 0; }
    return ie.next(w.input, out);
}

fn set_title(w as *st.Window, title as *u8, n as i64) as void {
    if (w.opened == 0) { return; }
    st._send_string_n(w, w.toplevel, 2, title, n);
}

fn set_parent(w as *st.Window, parent as i32) as i32 {
    if (w.opened == 0) { return 0; }
    let is [4]u8 as p;
    st._put(&p[0], cast(u32, parent));
    if (st._send(w, w.toplevel, 1, &p[0], 4, 0 - 1) == 0) { return 0; }
    w.parent_toplevel = parent;
    return 1;
}

fn set_modal(w as *st.Window, on as i32) as i32 {
    if (w.opened == 0 || w.parent_toplevel == 0 || w.dialog_manager == 0) { return 0; }
    if (w.dialog == 0) {
        w.dialog = st._id(w);
        let is [8]u8 as p;
        st._put(&p[0], cast(u32, w.dialog));
        st._put(&p[4], cast(u32, w.toplevel));
        if (st._send(w, w.dialog_manager, 1, &p[0], 8, 0 - 1) == 0) {
            w.dialog = 0;
            return 0;
        }
    }
    let is i32 as op with mut = 2;
    if (on != 0) { op = 1; }
    return st._send(w, w.dialog, op, cast(*u8, 0), 0, 0 - 1);
}

fn set_decorated(w as *st.Window, on as i32) as i32 {
    if (w.opened == 0 || w.toplevel_decoration == 0) { return 0; }
    let is [4]u8 as p;
    let is i32 as mode with mut = 1;
    if (on != 0) { mode = 2; }
    st._put(&p[0], cast(u32, mode));
    if (st._send(w, w.toplevel_decoration, 1, &p[0], 4, 0 - 1) == 0) { return 0; }
    w.decorated_wanted = on;
    return 1;
}

fn decorated(w as *st.Window) as i32 { return w.server_decorated; }

fn set_frame_extents(w as *st.Window, left as i64, right as i64, top as i64, bottom as i64) as i32 {
    if (w.opened == 0 || left < 0 || right < 0 || top < 0 || bottom < 0 ||
        left + right >= w.width || top + bottom >= w.height) { return 0; }
    w.ext_left = left; w.ext_right = right; w.ext_top = top; w.ext_bottom = bottom;
    _apply_configure(w);
    return _set_window_geometry(w, cast(i32, (w.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN |
        event.STATE_TILED_LEFT | event.STATE_TILED_RIGHT | event.STATE_TILED_TOP |
        event.STATE_TILED_BOTTOM)) == 0));
}

fn set_input_region(w as *st.Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    if (w.opened == 0 || width < 0 || height < 0) { return 0; }
    let is i32 as region = st._id(w);
    let is [16]u8 as p;
    st._put(&p[0], cast(u32, region));
    if (st._send(w, w.compositor, 1, &p[0], 4, 0 - 1) == 0) { return 0; }
    st._put(&p[0], cast(u32, st._scale_down(x, w.scale120)));
    st._put(&p[4], cast(u32, st._scale_down(y, w.scale120)));
    st._put(&p[8], cast(u32, st._scale_down(width, w.scale120)));
    st._put(&p[12], cast(u32, st._scale_down(height, w.scale120)));
    let is i32 as added = st._send(w, region, 1, &p[0], 16, 0 - 1);
    st._put(&p[0], cast(u32, region));
    let is i32 as set = st._send(w, w.surface, 5, &p[0], 4, 0 - 1);
    let is [0]u8 as empty;
    st._send(w, region, 0, &empty[0], 0, 0 - 1);
    if (added == 0 || set == 0) { return 0; }
    w.input_x = x; w.input_y = y; w.input_width = width; w.input_height = height;
    w.input_region_set = 1;
    return 1;
}

fn input_region(w as *st.Window, x as *i64, y as *i64, width as *i64, height as *i64) as i32 {
    *x = 0; *y = 0; *width = 0; *height = 0;
    if (w.opened == 0 || w.input_region_set == 0) { return 0; }
    *x = w.input_x; *y = w.input_y; *width = w.input_width; *height = w.input_height;
    return 1;
}

fn begin_move_resize(w as *st.Window, x as i64, y as i64, how as i64, button as i64) as i32 {
    if (w.opened == 0 || w.seat == 0 || w.pointer_serial == 0) { return 0; }
    if (how < 0 || how > 8) { return 0; }
    let is [12]u8 as p;
    st._put(&p[0], cast(u32, w.seat)); st._put(&p[4], w.pointer_serial);
    let is i32 as sent with mut = 0;
    if (how == 8) { sent = st._send(w, w.toplevel, 5, &p[0], 8, 0 - 1); }
    else {
        st._put(&p[8], cast(u32, how + 1));
        sent = st._send(w, w.toplevel, 6, &p[0], 12, 0 - 1);
    }
    // The compositor follows the pointer from the press on: its release is
    // the compositor's, so the input says the button is up, taken.
    if (sent == 1 && button >= 1 && button < 8 && w.pointer_buttons[button] == 1) {
        w.pointer_buttons[button] = 0;
        let is ie.Event as up = st._input(w, ie.BUTTON_UP);
        up.button = cast(i32, button);
        up.detail = ie.BUTTON_TAKEN;
        up.x = w.pointer_x;
        up.y = w.pointer_y;
        st._push(w, &up, cast(*u8, 0), 0);
    }
    return sent;
}

// The pointer over the window in shape (1..35, 35 hiding it) from now on, set
// now when the pointer is in and at each enter: 1, or 0 for a shape neither
// the compositor nor the theme has.
fn set_cursor(w as *st.Window, shape as i32) as i32 {
    if (w.opened == 0 || shape < 1 || shape > 35) { return 0; }
    if (shape != 35 && w.cursor_shape_device == 0 && w.cursor_shape_manager != 0) { return 0; }
    if (shape != 35 && w.cursor_shape_manager == 0 && ptr._cursor_load(w, shape) == 0) { return 0; }
    w.cursor_want = shape;
    ptr._cursor_apply(w);
    return 1;
}

// The theme and size the client draws the pointer from (theme empty or null:
// XCURSOR_THEME's; size 0: XCURSOR_SIZE's): drawn again when it is in.
fn cursor_theme(w as *st.Window, theme as *u8, size as i64) as void {
    mem.memzero(cast(*u8, &w.cursor_theme[0]), 64);
    if (cast(i64, theme) != 0) {
        let is i64 as i with mut = 0;
        while (i < 63 && theme[i] != 0) { w.cursor_theme[i] = theme[i]; i = i + 1; }
    }
    w.cursor_size = cast(i32, size);
    ptr._cursor_unload(w);
    if (w.cursor_want != 0 && w.cursor_want != 35) { ptr._cursor_apply(w); }
}

fn set_min_size(w as *st.Window, width as i64, height as i64) as i32 {
    if (w.opened == 0 || width < 0 || height < 0) { return 0; }
    let is [8]u8 as p;
    st._put(&p[0], cast(u32, (width * 120 + w.scale120 - 1) / w.scale120));
    st._put(&p[4], cast(u32, (height * 120 + w.scale120 - 1) / w.scale120));
    if (st._send(w, w.toplevel, 8, &p[0], 8, 0 - 1) == 0 || st._surface_commit(w) == 0) { return 0; }
    w.min_width = width; w.min_height = height;
    _apply_configure(w);
    return 1;
}

fn min_size(w as *st.Window, width as *i64, height as *i64) as i32 {
    *width = 0; *height = 0;
    if (w.opened == 0) { return 0; }
    *width = w.min_width; *height = w.min_height;
    return cast(i32, w.min_width > 0 || w.min_height > 0);
}

fn set_max_size(w as *st.Window, width as i64, height as i64) as i32 {
    if (w.opened == 0 || width < 0 || height < 0) { return 0; }
    let is [8]u8 as p;
    st._put(&p[0], cast(u32, width * 120 / w.scale120));
    st._put(&p[4], cast(u32, height * 120 / w.scale120));
    if (st._send(w, w.toplevel, 7, &p[0], 8, 0 - 1) == 0 || st._surface_commit(w) == 0) { return 0; }
    w.max_width = width; w.max_height = height;
    return 1;
}

fn set_maximized(w as *st.Window, on as i32) as i32 {
    if (w.opened == 0) { return 0; }
    let is i32 as op with mut = 10;
    if (on != 0) { op = 9; }
    if (st._send(w, w.toplevel, op, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    return st._surface_commit(w);
}

fn set_fullscreen(w as *st.Window, on as i32) as i32 {
    if (w.opened == 0) { return 0; }
    if (on == 0) {
        if (st._send(w, w.toplevel, 12, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
        return st._surface_commit(w);
    }
    let is [4]u8 as p;
    st._put(&p[0], 0);
    if (st._send(w, w.toplevel, 11, &p[0], 4, 0 - 1) == 0) { return 0; }
    return st._surface_commit(w);
}

fn minimize(w as *st.Window) as i32 {
    if (w.opened == 0 || st._send(w, w.toplevel, 13, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    return st._surface_commit(w);
}

// Text input wanted (a text field has the keyboard) or not. Told the
// compositor while the surface has its text-input focus, and again each time
// it gets it back; off, what was composing ends.
fn text_input_enable(w as *st.Window, on as i32) as i32 {
    if (w.opened == 0 || w.text_input == 0) { return 0; }
    let is i32 as enabled = cast(i32, on != 0);
    if (enabled == w.text_input_enabled) { return 1; }
    w.text_input_enabled = enabled;
    if (enabled == 1) {
        if (w.text_input_entered == 1) { return ti._ti_enable(w); }
        return 1;
    }
    ti._ime_pending_clear(w);
    ti._ime_unshow(w);
    if (w.text_input_entered == 0) { return 1; }
    if (st._send(w, w.text_input, 2, cast(*u8, 0), 0, 0 - 1) == 0) { return 0; }
    return ti._ti_commit(w);
}

fn text_input_active(w as *st.Window) as i32 {
    return cast(i32, w.text_input_enabled == 1 && w.text_input_entered == 1);
}

// The caret, in device pixels: told in surface units, where the method puts
// its candidates.
fn text_input_rect(w as *st.Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    if (w.opened == 0 || w.text_input == 0 || w.text_input_enabled == 0 ||
        width < 0 || height < 0) { return 0; }
    if (x == w.ime_rect_x && y == w.ime_rect_y && width == w.ime_rect_w && height == w.ime_rect_h) {
        return 1;
    }
    w.ime_rect_x = x; w.ime_rect_y = y; w.ime_rect_w = width; w.ime_rect_h = height;
    w.ti_dirty = w.ti_dirty | st.TI_RECT;
    return ti._ti_flush(w);
}

// The field's text around the caret (n bytes of UTF-8, at most
// content.CONTEXT_MAX), the caret and the selection's other end in it, what
// it is for and how its text goes: told when any of it changed, as changed
// by the method's last commit or by something else. A secret field's text
// is not told, its purpose is.
fn text_input_context(w as *st.Window, text as *u8, n as i64, caret as i64, anchor as i64,
                      purpose as i32, hints as i32) as i32 {
    if (w.opened == 0 || w.text_input == 0 || w.text_input_enabled == 0) { return 0; }
    if (n < 0 || n > content.CONTEXT_MAX || caret < 0 || caret > n || anchor < 0 || anchor > n) { return 0; }
    let is i64 as len with mut = n;
    let is i64 as at with mut = caret;
    let is i64 as other with mut = anchor;
    if (content.secret(purpose) == 1) {
        len = 0;
        at = 0;
        other = 0;
    }
    let is i32 as what with mut = 0;
    if (purpose != w.ti_purpose || hints != w.ti_hints) {
        w.ti_purpose = purpose;
        w.ti_hints = hints;
        what = what | st.TI_TYPE;
    }
    if (len != w.ti_text_len || at != w.ti_caret || other != w.ti_anchor ||
        (len > 0 && mem.memcmp(text, &w.ti_text[0], len) != 0)) {
        if (len > 0) { mem.memcpy(&w.ti_text[0], text, len); }
        w.ti_text_len = len;
        w.ti_caret = at;
        w.ti_anchor = other;
        what = what | st.TI_TEXT;
    }
    if (what == 0) { return 1; }
    w.ti_dirty = w.ti_dirty | what;
    return ti._ti_flush(w);
}

// The composition abandoned: said gone here, and the method let go and taken
// again — text-input-v3 has no reset, and focus moving between fields is
// how a method learns its composition is over.
fn text_input_reset(w as *st.Window) as i32 {
    if (w.opened == 0 || w.text_input == 0 || w.text_input_enabled == 0) { return 0; }
    ti._ime_pending_clear(w);
    ti._ime_unshow(w);
    if (w.text_input_entered == 0) { return 1; }
    if (st._send(w, w.text_input, 2, cast(*u8, 0), 0, 0 - 1) == 0 || ti._ti_commit(w) == 0) { return 0; }
    return ti._ti_enable(w);
}

fn close(w as *st.Window) as void {
    let is [0]u8 as empty;
    sel._transfers_end(w);
    let is i32 as data_i with mut = 0;
    while (data_i < st.MAX_DATA) {
        if (w.offers[data_i].object != 0) { sel._offer_release(w, data_i, 1); }
        if (w.sources[data_i].object != 0) { sel._source_release(w, data_i, 1); }
        data_i = data_i + 1;
    }
    if (w.data_device != 0) { st._send(w, w.data_device, 2, &empty[0], 0, 0 - 1); }
    if (w.primary_device != 0) { st._send(w, w.primary_device, 1, &empty[0], 0, 0 - 1); }
    if (w.text_input != 0) { st._send(w, w.text_input, 0, &empty[0], 0, 0 - 1); }
    if (w.cursor_shape_device != 0) {
        st._send(w, w.cursor_shape_device, 0, &empty[0], 0, 0 - 1);
    }
    if (w.viewport != 0) { st._send(w, w.viewport, 0, &empty[0], 0, 0 - 1); }
    if (w.fractional_surface != 0) { st._send(w, w.fractional_surface, 0, &empty[0], 0, 0 - 1); }
    if (w.toplevel_decoration != 0) { st._send(w, w.toplevel_decoration, 0, &empty[0], 0, 0 - 1); }
    if (w.dialog != 0) { st._send(w, w.dialog, 0, &empty[0], 0, 0 - 1); }
    st._ungrabber(w);
    if (w.subsurface != 0) { st._send(w, w.subsurface, 0, &empty[0], 0, 0 - 1); w.subsurface = 0; }
    if (w.xdg_popup != 0) { st._send(w, w.xdg_popup, 0, &empty[0], 0, 0 - 1); w.xdg_popup = 0; }
    if (w.toplevel != 0) { st._send(w, w.toplevel, 0, &empty[0], 0, 0 - 1); }
    if (w.xdg_surface != 0) { st._send(w, w.xdg_surface, 0, &empty[0], 0, 0 - 1); }
    if (w.surface != 0) { st._send(w, w.surface, 0, &empty[0], 0, 0 - 1); }
    if (w.pool != 0) { st._send(w, w.pool, 1, &empty[0], 0, 0 - 1); w.pool = 0; }
    if (w.memfd >= 0) { linux.close(w.memfd); w.memfd = 0 - 1; }
    _destroy_buffers(w);
    ie.destroy(w.input);
    w.input = cast(*ie.Queue, 0);
    ptr._touch_cancel(w);
    if (w.touch != 0 && w.seat_version >= 3) { st._send(w, w.touch, 0, &empty[0], 0, 0 - 1); }
    ptr._drop_gestures(w);
    if (w.gestures != 0 && w.gestures_version >= 2) { st._send(w, w.gestures, 2, &empty[0], 0, 0 - 1); }
    ptr._drop_tablets(w);
    if (w.pointer != 0 && w.pointer_version >= 3) { st._send(w, w.pointer, 1, &empty[0], 0, 0 - 1); }
    if (w.keyboard != 0 && w.seat_version >= 3) { st._send(w, w.keyboard, 0, &empty[0], 0, 0 - 1); }
    if (w.seat != 0 && w.seat_version >= 5) { st._send(w, w.seat, 3, &empty[0], 0, 0 - 1); }
    let is i32 as output_i with mut = 0;
    while (output_i < w.output_count) {
        if (w.outputs[output_i].object != 0 && w.outputs[output_i].version >= 3) {
            st._send(w, w.outputs[output_i].object, 0, &empty[0], 0, 0 - 1);
        }
        output_i = output_i + 1;
    }
    if (cast(i64, w.compose_state) != 0) { xkb.xkb_compose_state_unref(w.compose_state); }
    if (cast(i64, w.compose_table) != 0) { xkb.xkb_compose_table_unref(w.compose_table); }
    if (cast(i64, w.xkb_state) != 0) { xkb.xkb_state_unref(w.xkb_state); }
    if (cast(i64, w.xkb_keymap) != 0) { xkb.xkb_keymap_unref(w.xkb_keymap); }
    if (cast(i64, w.xkb_context) != 0) { xkb.xkb_context_unref(w.xkb_context); }
    w.compose_state = cast(*u8, 0); w.compose_table = cast(*u8, 0);
    w.xkb_state = cast(*u8, 0); w.xkb_keymap = cast(*u8, 0); w.xkb_context = cast(*u8, 0);
    kb._kb_free_own(w);
    ptr._cursor_unload(w);
    if (w.cursor_surface != 0) { st._send(w, w.cursor_surface, 0, cast(*u8, 0), 0, 0 - 1); w.cursor_surface = 0; }
    let is i32 as i with mut = 0;
    while (i < st.RETIRED_COUNT) {
        if (cast(i64, w.retired[i].pixels) != 0) {
            let is i32 as retired_i with mut = 0;
            while (retired_i < st.BUFFER_COUNT) {
                if (w.retired[i].buffers[retired_i].object != 0) {
                    st._send(w, w.retired[i].buffers[retired_i].object, 0, &empty[0], 0, 0 - 1);
                }
                retired_i = retired_i + 1;
            }
            linux.munmap(w.retired[i].pixels, w.retired[i].bytes * st.BUFFER_COUNT);
        }
        mem.memzero(cast(*u8, &w.retired[i]), sizeof(st.BufferSet));
        i = i + 1;
    }
    st._disconnect(w);
    w.fd = 0 - 1; w.opened = 0;
}

// --- Optional protocols ---

// A string argument at p, its bytes into out (cap, zero-terminated): its
// length, -1 when it is not there whole or does not fit.
fn _string_arg(p as *u8, out as *u8, cap as i64) as i64 {
    let is i64 as len = cast(i64, st._word(p));
    if (len <= 0 || 8 + 4 + len > cast(i64, st._wire_size) || len > cap) { return 0 - 1; }
    let is i64 as n = len - 1;
    mem.memcpy(out, cast(*u8, cast(i64, p) + 4), n);
    out[n] = 0;
    return n;
}

fn _token_done(w as *st.Window, p as *u8) as void {
    let is i64 as n = _string_arg(p, &w.token[0], 256);
    if (n < 0) { w.token_len = 0; } else { w.token_len = cast(i32, n); }
    st._send(w, w.token_object, 4, cast(*u8, 0), 0, 0 - 1);
    w.token_object = 0;
}

fn _export_said(w as *st.Window, p as *u8) as void {
    let is i64 as n = _string_arg(p, &w.export_handle[0], 128);
    if (n < 0) { w.export_len = 0; } else { w.export_len = cast(i32, n); }
}

// Events until done() says *flag is no longer negative, a second at most.
fn _until_said(w as *st.Window, flag as *i32) as void {
    let is i64 as until = time.now_ms() + 1000;
    while (*flag < 0 && time.now_ms() < until) {
        if (_pump_one(w, 1) == 0) { return; }
    }
}

// xdg-activation: a token made for this window under its latest input — the
// key or press the user just gave it — for this window's activate or for a
// program started from here to come forward with (XDG_ACTIVATION_TOKEN). Its
// length into out (cap bytes, zero-terminated); 0 when the compositor has no
// xdg_activation_v1 or said none.
fn activation_token(w as *st.Window, out as *u8, cap as i64) as i64 {
    if (w.opened == 0 || w.activation == 0 || cap <= 1 || w.token_object != 0) { return 0; }
    let is [8]u8 as p;
    w.token_object = st._id(w);
    w.token_len = 0 - 1;
    st._put(&p[0], cast(u32, w.token_object));
    if (st._send(w, w.activation, 1, &p[0], 4, 0 - 1) == 0) { w.token_object = 0; return 0; }
    if (w.input_serial != 0 && w.seat != 0) {
        st._put(&p[0], w.input_serial); st._put(&p[4], cast(u32, w.seat));
        st._send(w, w.token_object, 0, &p[0], 8, 0 - 1);
    }
    st._put(&p[0], cast(u32, w.surface));
    st._send(w, w.token_object, 2, &p[0], 4, 0 - 1);
    st._send(w, w.token_object, 3, cast(*u8, 0), 0, 0 - 1);
    _until_said(w, &w.token_len);
    if (w.token_len <= 0 || cast(i64, w.token_len) >= cap) { return 0; }
    mem.memcpy(out, &w.token[0], cast(i64, w.token_len));
    out[w.token_len] = 0;
    return cast(i64, w.token_len);
}

// Brought forward with token, n bytes — one another program gave, or one of
// this window's: 1 when asked; the compositor grants it or not.
fn activate_with(w as *st.Window, token as *u8, n as i64) as i32 {
    if (w.opened == 0 || w.activation == 0 || n <= 0 || n > 240) { return 0; }
    let is [256]u8 as p;
    let is i64 as len = n + 1;
    let is i64 as padded = ((len + 3) / 4) * 4;
    mem.memzero(&p[0], 256);
    st._put(&p[0], cast(u32, len));
    mem.memcpy(&p[4], token, n);
    st._put(cast(*u8, cast(i64, &p[0]) + 4 + padded), cast(u32, w.surface));
    return st._send(w, w.activation, 2, &p[0], cast(i32, 8 + padded), 0 - 1);
}

// Brought forward: a token of its own made and used. 0 without xdg-activation.
fn activate(w as *st.Window) as i32 {
    let is [256]u8 as token;
    let is i64 as n = activation_token(w, &token[0], 256);
    if (n <= 0) { return 0; }
    return activate_with(w, &token[0], n);
}

// Started by another program with a token for its first window: brought
// forward with it, the token taken from what this one passes on.
fn _startup_activation(w as *st.Window) as void {
    if (w.popup_kind != 0 || w.subsurface != 0 || w.activation == 0) { return; }
    let is [256]u8 as token;
    let is i64 as n = launch.take("XDG_ACTIVATION_TOKEN", &token[0], 256);
    if (n > 0) { activate_with(w, &token[0], n); }
}

// xdg-foreign: the handle another program — a portal's dialog — makes a
// window of its own this one's child by. Its length into out (cap bytes,
// zero-terminated); 0 without zxdg_exporter_v2. Exported once, kept while the
// window is.
fn export_handle(w as *st.Window, out as *u8, cap as i64) as i64 {
    if (w.opened == 0 || w.exporter == 0 || w.toplevel == 0 || cap <= 1) { return 0; }
    if (w.exported == 0) {
        let is [8]u8 as p;
        w.exported = st._id(w);
        w.export_len = 0 - 1;
        st._put(&p[0], cast(u32, w.exported)); st._put(&p[4], cast(u32, w.surface));
        if (st._send(w, w.exporter, 1, &p[0], 8, 0 - 1) == 0) { w.exported = 0; return 0; }
    }
    _until_said(w, &w.export_len);
    if (w.export_len <= 0 || cast(i64, w.export_len) >= cap) { return 0; }
    mem.memcpy(out, &w.export_handle[0], cast(i64, w.export_len));
    out[w.export_len] = 0;
    return cast(i64, w.export_len);
}

// The system bell rung for this window: 1, 0 without xdg_system_bell_v1.
fn bell(w as *st.Window) as i32 {
    if (w.opened == 0 || w.bell == 0) { return 0; }
    let is [4]u8 as p;
    st._put(&p[0], cast(u32, w.surface));
    return st._send(w, w.bell, 1, &p[0], 4, 0 - 1);
}

// Its icon (xdg_toplevel_icon_v1): argb, iw by ih, 0xAARRGGBB a pixel,
// centred in a square as the protocol has icons, premultiplied in a buffer
// of its own kept while it is shown. 0 without the icon manager.
fn set_icon(w as *st.Window, argb as *u8, iw as i64, ih as i64) as i32 {
    if (w.opened == 0 || w.icon_manager == 0 || w.toplevel == 0 || iw <= 0 || ih <= 0 || iw > 1024 || ih > 1024) { return 0; }
    let is i64 as side with mut = iw;
    if (ih > side) { side = ih; }
    let is i64 as bytes = side * side * 4;
    let is i64 as fd = sys.memfd_create("caustic-wayland-icon", 1);
    if (fd < 0) { return 0; }
    if (linux.ftruncate(fd, bytes) != 0) { linux.close(fd); return 0; }
    let is *u8 as map = linux.mmap(cast(*u8, 0), bytes, linux.PROT_READ | linux.PROT_WRITE, linux.MAP_SHARED, fd, 0);
    if (cast(i64, map) == linux.MAP_FAILED) { linux.close(fd); return 0; }
    mem.memzero(map, bytes);
    let is i64 as ox = (side - iw) / 2;
    let is i64 as oy = (side - ih) / 2;
    let is i64 as y with mut = 0;
    while (y < ih) {
        let is i64 as x with mut = 0;
        while (x < iw) {
            let is u32 as c = *cast(*u32, cast(i64, argb) + (y * iw + x) * 4);
            let is u32 as a = (c >> 24) & 255;
            let is u32 as r = (((c >> 16) & 255) * a + 127) / 255;
            let is u32 as g = (((c >> 8) & 255) * a + 127) / 255;
            let is u32 as b = ((c & 255) * a + 127) / 255;
            *cast(*u32, cast(i64, map) + ((oy + y) * side + ox + x) * 4) = (a << 24) | (r << 16) | (g << 8) | b;
            x = x + 1;
        }
        y = y + 1;
    }
    let is [24]u8 as p;
    let is i32 as pool = st._id(w);
    st._put(&p[0], cast(u32, pool)); st._put(&p[4], cast(u32, bytes));
    let is i32 as sent = st._send(w, w.shm, 0, &p[0], 8, fd);
    linux.close(fd);
    if (sent == 0) { linux.munmap(map, bytes); return 0; }
    let is i32 as buffer = st._id(w);
    st._put(&p[0], cast(u32, buffer)); st._put(&p[4], 0);
    st._put(&p[8], cast(u32, side)); st._put(&p[12], cast(u32, side));
    st._put(&p[16], cast(u32, side * 4)); st._put(&p[20], cast(u32, st.FORMAT_ARGB8888));
    st._send(w, pool, 0, &p[0], 24, 0 - 1);
    st._send(w, pool, 1, cast(*u8, 0), 0, 0 - 1);
    let is i32 as icon = st._id(w);
    st._put(&p[0], cast(u32, icon));
    st._send(w, w.icon_manager, 1, &p[0], 4, 0 - 1);
    st._put(&p[0], cast(u32, buffer)); st._put(&p[4], 1);
    st._send(w, icon, 2, &p[0], 8, 0 - 1);
    st._put(&p[0], cast(u32, w.toplevel)); st._put(&p[4], cast(u32, icon));
    st._send(w, w.icon_manager, 2, &p[0], 8, 0 - 1);
    st._send(w, icon, 0, cast(*u8, 0), 0, 0 - 1);
    // The icon before it, no longer shown: let go.
    if (w.icon_buffer != 0) { st._send(w, w.icon_buffer, 0, cast(*u8, 0), 0, 0 - 1); linux.munmap(w.icon_map, w.icon_bytes); }
    w.icon_buffer = buffer; w.icon_map = map; w.icon_bytes = bytes;
    return 1;
}

// presentation-time: feedback asked of the frame about to be committed, a
// slot of its own while it is in flight (none free: not asked).
fn _feedback_ask(w as *st.Window) as void {
    if (w.presentation == 0) { return; }
    let is i32 as k with mut = 0;
    while (k < 8 && w.feedback[k] != 0) { k = k + 1; }
    if (k == 8) { return; }
    let is [8]u8 as p;
    w.feedback[k] = st._id(w);
    st._put(&p[0], cast(u32, w.surface)); st._put(&p[4], cast(u32, w.feedback[k]));
    st._send(w, w.presentation, 1, &p[0], 8, 0 - 1);
}

fn _feedback_index(w as *st.Window, obj as i32) as i32 {
    if (obj == 0) { return 0 - 1; }
    let is i32 as k with mut = 0;
    while (k < 8) {
        if (w.feedback[k] == obj) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

// presented: tv_sec_hi, tv_sec_lo, tv_nsec, refresh, seq_hi, seq_lo, flags;
// discarded. Either ends the feedback (the server destroys it).
fn _feedback_event(w as *st.Window, k as i32, op as i32, p as *u8) as void {
    if (op == 1 && st._wire_size >= 8 + 28) {
        let is i64 as sec = (cast(i64, st._word(p)) << 32) | cast(i64, st._word(cast(*u8, cast(i64, p) + 4)));
        let is i64 as nsec = cast(i64, st._word(cast(*u8, cast(i64, p) + 8)));
        w.presented_ns = sec * 1000000000 + nsec;
        w.refresh_ns = cast(i64, st._word(cast(*u8, cast(i64, p) + 12)));
        w.presented = w.presented + 1;
        w.feedback[k] = 0;
    } else if (op == 2) {
        w.discarded = w.discarded + 1;
        w.feedback[k] = 0;
    }
}

// What presentation-time said of the frames: how many were shown (-1
// without wp_presentation), when the last was (ns of presentation_clock's
// clock) and the refresh then (ns, 0 unknown).
fn presentation_times(w as *st.Window, presented_ns as *i64, refresh_ns as *i64) as i64 {
    if (w.presentation == 0) { return 0 - 1; }
    *presented_ns = w.presented_ns;
    *refresh_ns = w.refresh_ns;
    return w.presented;
}

fn presentation_clock() as i32 { return st._globals.presentation_clock; }
fn frames_discarded(w as *st.Window) as i64 { return w.discarded; }

// The window shown as one colour, argb (0xAARRGGBB), with no buffer of its
// size: wp_single_pixel_buffer_v1's one pixel stretched over it by the
// viewport, until the next frame — which sets the viewport's size again, as
// every frame with fractional scaling does. 1, or 0 without the single-pixel
// buffer or fractional scaling's viewport.
fn fill(w as *st.Window, argb as u32) as i32 {
    if (w.opened == 0 || w.single_pixel == 0 || w.viewport == 0 || w.fractional_active == 0 || w.logical_width <= 0) { return 0; }
    let is u32 as a = (argb >> 24) & 255;
    // Premultiplied, each channel scaled to the whole of a u32.
    let is u32 as r = (((argb >> 16) & 255) * a + 127) / 255;
    let is u32 as g = (((argb >> 8) & 255) * a + 127) / 255;
    let is u32 as b = ((argb & 255) * a + 127) / 255;
    let is [20]u8 as p;
    let is i32 as buffer = st._id(w);
    st._put(&p[0], cast(u32, buffer));
    st._put(&p[4], r * 16843009); st._put(&p[8], g * 16843009); st._put(&p[12], b * 16843009); st._put(&p[16], a * 16843009);
    if (st._send(w, w.single_pixel, 1, &p[0], 20, 0 - 1) == 0) { return 0; }
    st._put(&p[0], 1);
    st._send(w, w.surface, 8, &p[0], 4, 0 - 1);
    st._put(&p[0], cast(u32, w.logical_width)); st._put(&p[4], cast(u32, w.logical_height));
    st._send(w, w.viewport, 2, &p[0], 8, 0 - 1);
    st._put(&p[0], cast(u32, buffer)); st._put(&p[4], 0); st._put(&p[8], 0);
    st._send(w, w.surface, 1, &p[0], 12, 0 - 1);
    st._put(&p[0], 0); st._put(&p[4], 0); st._put(&p[8], 2147483647); st._put(&p[12], 2147483647);
    st._send(w, w.surface, 2, &p[0], 16, 0 - 1);
    st._send(w, w.surface, 6, cast(*u8, 0), 0, 0 - 1);
    if (w.fill_buffer != 0) { st._send(w, w.fill_buffer, 0, cast(*u8, 0), 0, 0 - 1); }
    w.fill_buffer = buffer;
    return 1;
}
