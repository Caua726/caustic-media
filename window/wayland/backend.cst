    logical_height as i64;
    normal_width as i64;
    normal_height as i64;
    configured_width as i64;
    last_buffer as i32;
    visible as i32;
    configured_height as i64;
    stride as i64;
    bytes as i64;
    buffer_width as i64;
    buffer_height as i64;
    resize_detached as i32;
    pixels as *u8;
    buffers as [2]Buffer;
    retired as [4]BufferSet;
    current as i32;
    event_head as i32;
    event_len as i32;
