// window/settings_test.cst — the desktop's settings: fonts, theme names,
// merging sources, and GTK's settings.ini.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "settings.cst" as settings;
use "linux/gtk_ini.cst" as gtk_ini;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return n;
}

fn eq(a as *u8, b as *u8) as i32 {
    let is i64 as n = len(b);
    if (len(a) != n || mem.memcmp(a, b, n) != 0) { return 0; }
    return 1;
}

let is [128]u8 as fam with mut;

// The family and size desc parses to.
fn font(desc as *u8, family as *u8, size as f64) as i32 {
    let is f64 as got with mut = 0.0 - 5.0;
    let is i32 as r = settings.parse_font(desc, len(desc), cast(*u8, &fam), 128, &got);
    if (r != 1 || eq(cast(*u8, &fam), family) == 0 || got != size) {
        io.printf("  '%s' gave '%s' at %d/100\n", desc, cast(*u8, &fam), cast(i64, got * 100.0));
        return 0;
    }
    return 1;
}

fn write_file(path as *u8, text as *u8) as void {
    let is i64 as fd = linux.open(path, 577, 420);   // O_WRONLY|O_CREAT|O_TRUNC, 0644
    linux.write(fd, text, len(text));
    linux.close(fd);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);

    // --- Defaults ---
    let is settings.Settings as d = settings.defaults();
    check("nothing known", d.known == 0);
    check("light, animated, blinking", d.dark == 0 && d.high_contrast == 0 && d.animations == 1 && d.blink == 1);
    check("GTK's timings", d.double_click_ms == 400 && d.double_click_px == 5 && d.blink_ms == 1200);
    check("no scaling", d.text_scale == 1.0 && d.dpi == 96.0 && d.cursor_size == 24 && d.drag_px == 8);
    check("Adwaita's blue", d.accent_b > 0.89 && d.accent_r < 0.21);
    check("no fonts", d.font[0] == 0 && d.mono[0] == 0 && d.font_size == 0.0);

    // --- Font descriptions ---
    check("family and size", font("Cantarell 11", "Cantarell", 11.0) == 1);
    check("a comma before the size", font("Noto Sans,  10", "Noto Sans", 10.0) == 1);
    check("a comma and no space", font("Noto Sans,10", "Noto Sans", 10.0) == 1);
    check("style words dropped", font("Source Code Pro Bold Italic 10", "Source Code Pro", 10.0) == 1);
    check("a weight word", font("Inter Variable Medium 10.5", "Inter Variable", 10.5) == 1);
    check("hyphenated styles, any case", font("Fira Sans SEMI-BOLD Condensed 9", "Fira Sans", 9.0) == 1);
    check("pixels", font("Segoe UI 16px", "Segoe UI", 12.0) == 1);
    check("no size", font("Monospace", "Monospace", 0.0) == 1);
    check("the first of several families", font("Cantarell,Noto Sans 11", "Cantarell", 11.0) == 1);
    check("spaces around", font("  Noto Sans   12  ", "Noto Sans", 12.0) == 1);
    check("a number in the name", font("Noto Sans CJK JP 10", "Noto Sans CJK JP", 10.0) == 1);
    check("not a number", font("Font 1.2.3", "Font 1.2.3", 0.0) == 1);
    let is f64 as sz with mut = 0.0;
    check("only a size is no family", settings.parse_font("12", 2, cast(*u8, &fam), 128, &sz) == 0 && sz == 12.0);
    check("only a style is no family", settings.parse_font("Bold 12", 7, cast(*u8, &fam), 128, &sz) == 0);
    check("cut to fit", settings.parse_font("Cantarell 11", 12, cast(*u8, &fam), 5, &sz) == 1 && eq(cast(*u8, &fam), "Cant") == 1);

    // --- Theme names ---
    let is settings.Settings as t with mut = settings.defaults();
    settings.theme_name(&t, "Adwaita", 7);
    check("Adwaita is light", t.dark == 0 && t.known == 0);
    settings.theme_name(&t, "Breeze-Dark", 11);
    check("-Dark is dark", t.dark == 1 && t.known == settings.K_DARK);
    t = settings.defaults();
    settings.theme_name(&t, "Adwaita:dark", 12);
    check(":dark is dark", t.dark == 1);
    t = settings.defaults();
    settings.theme_name(&t, "HighContrast", 12);
    check("high contrast", t.high_contrast == 1 && t.dark == 0 && t.known == settings.K_HIGH_CONTRAST);
    t = settings.defaults();
    settings.theme_name(&t, "HighContrastInverse", 19);
    check("inverse is dark too", t.high_contrast == 1 && t.dark == 1);
    t = settings.defaults();
    settings.theme_name(&t, "Yaru-high-contrast", 18);
    check("high-contrast spelt out", t.high_contrast == 1);

    // --- Merging: what a source reported, field by field ---
    let is settings.Settings as a with mut = settings.defaults();
    let is settings.Settings as b with mut = settings.defaults();
    b.dark = 1;
    b.double_click_ms = 250;
    b.animations = 0;
    b.known = settings.K_DARK | settings.K_DOUBLE_CLICK_MS;
    settings.merge(&a, &b);
    check("merged what was known", a.dark == 1 && a.double_click_ms == 250);
    check("and nothing else", a.animations == 1);
    check("known grows", a.known == (settings.K_DARK | settings.K_DOUBLE_CLICK_MS));
    let is settings.Settings as untouched with mut = settings.defaults();
    let is settings.Settings as said_nothing with mut = settings.defaults();
    mem.memset(cast(*u8, &said_nothing), 1, sizeof(settings.Settings));
    said_nothing.known = 0;
    settings.merge(&untouched, &said_nothing);
    let is settings.Settings as fresh = settings.defaults();
    check("a source that said nothing changes nothing", mem.memcmp(cast(*u8, &untouched), cast(*u8, &fresh), sizeof(settings.Settings)) == 0);
    let is settings.Settings as e with mut = settings.defaults();
    e.dark = 1; e.high_contrast = 1; e.animations = 0; e.blink = 0;
    e.accent_r = 0.1; e.accent_g = 0.2; e.accent_b = 0.3;
    settings.set_font(&e, "Inter 9", 7, 0);
    settings.set_font(&e, "Hack 8", 6, 1);
    e.text_scale = 1.25; e.dpi = 120.0;
    e.double_click_ms = 300; e.double_click_px = 9; e.blink_ms = 900; e.drag_px = 12;
    settings.set_text(cast(*u8, &e.cursor_theme), 64, "breeze_cursors", 14);
    e.cursor_size = 32;
    settings.set_text(cast(*u8, &e.button_layout), 96, "close:", 6);
    e.known = 65535;
    let is settings.Settings as all with mut = settings.defaults();
    settings.merge(&all, &e);
    check("every field merges", all.dark == 1 && all.high_contrast == 1 && all.animations == 0 && all.blink == 0
          && all.accent_r == 0.1 && all.accent_g == 0.2 && all.accent_b == 0.3
          && eq(cast(*u8, &all.font), "Inter") == 1 && all.font_size == 9.0
          && eq(cast(*u8, &all.mono), "Hack") == 1 && all.mono_size == 8.0
          && all.text_scale == 1.25 && all.dpi == 120.0
          && all.double_click_ms == 300 && all.double_click_px == 9 && all.blink_ms == 900 && all.drag_px == 12
          && eq(cast(*u8, &all.cursor_theme), "breeze_cursors") == 1 && all.cursor_size == 32
          && eq(cast(*u8, &all.button_layout), "close:") == 1);
    check("set_font says so", (e.known & settings.K_FONT) != 0);
    let is settings.Settings as nf with mut = settings.defaults();
    settings.set_font(&nf, "Bold 10", 7, 0);
    settings.set_font(&nf, "Bold 10", 7, 1);
    check("no family, nothing said", nf.known == 0);

    // --- GTK's settings.ini ---
    let is *u8 as ini = "# a comment\n[Unrelated]\ngtk-font-name=Wrong 99\n\n[Settings]\r\ngtk-application-prefer-dark-theme=true\ngtk-theme-name=Adwaita\ngtk-font-name = Noto Sans,  10\n; another comment\ngtk-enable-animations=0\ngtk-cursor-blink=false\ngtk-cursor-blink-time=1000\ngtk-double-click-time = 350\ngtk-dnd-drag-threshold=6\ngtk-font=Wrong 9\ngtk-double-click-distance=7\ngtk-cursor-theme-name=\"breeze_cursors\"\ngtk-cursor-theme-size=24\ngtk-decoration-layout=icon:minimize,maximize,close\ngtk-xft-dpi=98304\ngtk-unknown-key=whatever\nno equals sign here\n# gtk-cursor-theme-size=99\n[Later]\ngtk-cursor-theme-size=77\n";
    let is settings.Settings as g with mut = settings.defaults();
    gtk_ini.parse(ini, len(ini), &g);
    check("prefer dark", g.dark == 1);
    check("the font, not the other section's", eq(cast(*u8, &g.font), "Noto Sans") == 1 && g.font_size == 10.0);
    check("animations off", g.animations == 0);
    check("no blinking", g.blink == 0 && g.blink_ms == 1000);
    check("double click, spaces around =", g.double_click_ms == 350 && g.double_click_px == 7);
    check("the drag threshold", g.drag_px == 6);
    check("the cursor theme, unquoted", eq(cast(*u8, &g.cursor_theme), "breeze_cursors") == 1 && g.cursor_size == 24);
    check("the buttons", eq(cast(*u8, &g.button_layout), "icon:minimize,maximize,close") == 1);
    check("the DPI, in 1024ths", g.dpi == 96.0);
    check("what it said", g.known == (settings.K_DARK | settings.K_FONT | settings.K_ANIMATIONS | settings.K_BLINK
          | settings.K_BLINK_MS | settings.K_DOUBLE_CLICK_MS | settings.K_DOUBLE_CLICK_PX | settings.K_CURSOR_THEME
          | settings.K_CURSOR_SIZE | settings.K_BUTTON_LAYOUT | settings.K_DPI | settings.K_DRAG));
    check("not another section's, nor a comment's", g.cursor_size == 24);
    let is *u8 as odd = "[Settings]\ngtk-application-prefer-dark-theme=1\ngtk-cursor-blink=True\ngtk-double-click-time=abc\ngtk-cursor-theme-size=-3\ngtk-xft-dpi=-1\ngtk-double-click-distance=\ngtk-cursor-blink-time=-5\ngtk-dnd-drag-threshold=0\n";
    let is settings.Settings as o with mut = settings.defaults();
    gtk_ini.parse(odd, len(odd), &o);
    check("1 and True", o.dark == 1 && o.blink == 1);
    check("numbers that are not taken", o.double_click_ms == 400 && o.cursor_size == 24 && o.dpi == 96.0
          && o.double_click_px == 5 && o.blink_ms == 1200 && o.drag_px == 8
          && (o.known & (settings.K_DOUBLE_CLICK_MS | settings.K_CURSOR_SIZE | settings.K_DPI | settings.K_DOUBLE_CLICK_PX
                         | settings.K_BLINK_MS | settings.K_DRAG)) == 0);
    let is settings.Settings as th with mut = settings.defaults();
    let is *u8 as dark_theme = "[Settings]\ngtk-theme-name=Breeze-Dark\n";
    gtk_ini.parse(dark_theme, len(dark_theme), &th);
    check("a dark theme's name", th.dark == 1);

    // The files: gtk-4.0's over gtk-3.0's.
    linux.mkdir("/tmp/caustic_settings_test", 493);
    linux.mkdir("/tmp/caustic_settings_test/gtk-3.0", 493);
    linux.mkdir("/tmp/caustic_settings_test/gtk-4.0", 493);
    write_file("/tmp/caustic_settings_test/gtk-3.0/settings.ini", "[Settings]\ngtk-double-click-time=300\ngtk-cursor-theme-size=30\n");
    write_file("/tmp/caustic_settings_test/gtk-4.0/settings.ini", "[Settings]\ngtk-double-click-time=500\n");
    let is settings.Settings as f with mut = settings.defaults();
    check("two files", gtk_ini.read_from("/tmp/caustic_settings_test", &f) == 2);
    check("4.0 over 3.0", f.double_click_ms == 500 && f.cursor_size == 30);
    linux.unlink("/tmp/caustic_settings_test/gtk-4.0/settings.ini");
    let is settings.Settings as f3 with mut = settings.defaults();
    check("one file", gtk_ini.read_from("/tmp/caustic_settings_test", &f3) == 1 && f3.double_click_ms == 300);
    linux.unlink("/tmp/caustic_settings_test/gtk-3.0/settings.ini");
    linux.rmdir("/tmp/caustic_settings_test/gtk-3.0");
    linux.rmdir("/tmp/caustic_settings_test/gtk-4.0");
    linux.rmdir("/tmp/caustic_settings_test");
    check("no files", gtk_ini.read_from("/tmp/caustic_settings_test", &f3) == 0);
    check("no directory", gtk_ini.read_from(cast(*u8, 0), &f3) == 0 && gtk_ini.read_from("", &f3) == 0);
    let is [601]u8 as deep;
    mem.memset(cast(*u8, &deep), 120, 600);
    deep[0] = 47;
    deep[600] = 0;
    check("a directory too long for a path", gtk_ini.read_from(cast(*u8, &deep), &f3) == 0);
    let is settings.Settings as u with mut = settings.defaults();
    gtk_ini.read_user(&u);   // whatever this machine has; it must not fail

    if (fails > 0) {
        io.printf("window settings: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("window settings: all checks passed\n");
    return 0;
}
