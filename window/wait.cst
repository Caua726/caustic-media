// window/wait.cst — the loop's one place to sleep.
//
// A program with windows on the screen and nothing to do must not spin: it
// sleeps until something happens — an event for one of its windows, a
// descriptor it watches becoming readable (its D-Bus connections: the
// accessibility bridge, a portal), another thread waking it (wake), or the
// time its next timer is due. wait() sleeps until the first of those, in one
// poll over all of them, and says which.
//
// The platform's events come in on one connection that every window of the
// program shares; a window names it. Some may already have been read off it
// into the window system's own queue, where the descriptor no longer shows
// them, so wait() looks there first and does not sleep when one is waiting.
//
// Linux (poll, eventfd) for now: Windows' MsgWaitForMultipleObjectsEx comes
// with its backend.
use "std/os/linux.cst" as linux;
use "../sys/linux.cst" as sys;
use "device.cst" as device;

// The most descriptors watched at once, besides the connection and the
// wake-up.
let is i64 as MAX_FDS with imut = 16;

// What woke it: bits, 0 for its time.
let is i32 as TIMEOUT    with imut = 0;
let is i32 as WINDOW     with imut = 1;   // an event for a window
let is i32 as DESCRIPTOR with imut = 2;   // a watched descriptor readable (readable says which)
let is i32 as WOKEN      with imut = 4;   // wake, from any thread

// poll's bits.
let is i64 as _POLLIN  with imut = 1;
let is i64 as _POLLERR with imut = 8;
let is i64 as _POLLHUP with imut = 16;

struct Wait {
    ok    as i32;
    _pad0 as i32;
    wake  as i64;                // the eventfd another thread adds to
    n     as i64;
    fds   as [16]i64;
    ready as [16]i32;
}

// A new one, with nothing watched: is_open says whether it could be made.
fn open() as Wait {
    let is Wait as w;
    w.n = 0;
    w.wake = sys.eventfd(0, sys.EFD_NONBLOCK | sys.EFD_CLOEXEC);
    w.ok = cast(i32, w.wake >= 0);
    return w;
}

fn is_open(w as *Wait) as i32 { return w.ok; }

fn close(w as *Wait) as void {
    if (w.ok == 0) { return; }
    sys.close(w.wake);
    w.ok = 0;
    w.n = 0;
}

fn _find(w as *Wait, fd as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < w.n) {
        if (w.fds[i] == fd) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// fd watched from now on: 1, or 0 when MAX_FDS are already. Watching one
// twice watches it once.
fn watch(w as *Wait, fd as i64) as i32 {
    if (fd < 0) { return 0; }
    if (_find(w, fd) >= 0) { return 1; }
    if (w.n == MAX_FDS) { return 0; }
    w.fds[w.n] = fd;
    w.ready[w.n] = 0;
    w.n = w.n + 1;
    return 1;
}

fn unwatch(w as *Wait, fd as i64) as void {
    let is i64 as i = _find(w, fd);
    if (i < 0) { return; }
    w.n = w.n - 1;
    w.fds[i] = w.fds[w.n];
    w.ready[i] = w.ready[w.n];
}

fn watching(w as *Wait, fd as i64) as i32 { return cast(i32, _find(w, fd) >= 0); }

fn count(w as *Wait) as i64 { return w.n; }

// Whether fd was readable when wait last returned.
fn readable(w as *Wait, fd as i64) as i32 {
    let is i64 as i = _find(w, fd);
    if (i < 0) { return 0; }
    return w.ready[i];
}

// The sleeping wait woken, or the next one not sleeping: from any thread.
fn wake(w as *Wait) as void {
    if (w.ok == 0) { return; }
    sys.event_add(w.wake, 1);
}

fn _put(p as *u8, i as i64, fd as i64) as void {
    let is *u8 as at = cast(*u8, cast(i64, p) + i * 8);
    *cast(*i32, at) = cast(i32, fd);
    *cast(*i16, cast(i64, at) + 4) = cast(i16, _POLLIN);
    *cast(*i16, cast(i64, at) + 6) = cast(i16, 0);
}

fn _got(p as *u8, i as i64) as i32 {
    let is i64 as r = cast(i64, *cast(*i16, cast(i64, p) + i * 8 + 6));
    return cast(i32, (r & (_POLLIN | _POLLERR | _POLLHUP)) != 0);
}

// Sleeps until an event waits for a window of the program — win, any of
// them; null for none — a watched descriptor is readable, wake was called,
// or timeout_ms pass (negative: no time). What woke it, as bits; TIMEOUT
// when nothing did.
fn wait(w as *Wait, win as *device.Window, timeout_ms as i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < w.n) {
        w.ready[i] = 0;
        i = i + 1;
    }
    if (w.ok == 0) { return TIMEOUT; }
    let is i32 as got with mut = TIMEOUT;
    let is i64 as t with mut = timeout_ms;
    let is i64 as conn with mut = 0 - 1;
    if (cast(i64, win) != 0) {
        conn = device.connection_fd(win);
        // Read off the connection already: there, and no sleeping on it.
        if (device.pending(win) == 1) {
            got = WINDOW;
            t = 0;
        }
    }
    // The connection, the wake-up, then what is watched.
    let is [18]i64 as raw;
    let is *u8 as p = cast(*u8, &raw);
    _put(p, 0, conn);
    _put(p, 1, w.wake);
    i = 0;
    while (i < w.n) {
        _put(p, 2 + i, w.fds[i]);
        i = i + 1;
    }
    let is i64 as r with mut = 0 - sys.EINTR;
    while (r == 0 - sys.EINTR) { r = linux.poll(p, 2 + w.n, t); }
    if (r <= 0) { return got; }
    if (conn >= 0 && _got(p, 0) == 1) { got = got | WINDOW; }
    if (_got(p, 1) == 1) {
        sys.event_take(w.wake);
        got = got | WOKEN;
    }
    i = 0;
    while (i < w.n) {
        if (_got(p, 2 + i) == 1) {
            w.ready[i] = 1;
            got = got | DESCRIPTOR;
        }
        i = i + 1;
    }
    return got;
}
