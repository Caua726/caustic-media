// window/display_x11_test.cst — the monitor a window is on, on X11, as
// display.cst reads it: Xvfb's RandR monitor, the work area a window manager
// says (played on a second connection, as frame_test plays one), the
// screen's scale.
//   sh window/x11/tools/run_headless.sh ./build/display_x11_test
use "std/io.cst" as io;
use "std/time.cst" as time;
use "device.cst" as device;
use "display.cst" as display;
use "monitor.cst" as monitor;
use "x11/x11.cst" as x11;
use "x11/monitors.cst" as monitors;
use "x11/bind/x.cst" as x;
use "x11/bind/xlib.cst" as xlib;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn main() as i32 {
    let is device.Window as w = device.open_with(device.X11, "display", 200, 120);
    if (device.is_open(&w) == 0) { io.printf("FAIL: no window\n"); return 1; }
    let is i64 as until = time.now_ms() + 300;
    while (time.now_ms() < until) { device.pump(&w); time.sleep_ms(10); }
    let is display.Display as d = display.open(&w);
    let is monitors.Monitor as rr;
    check("the server's monitors read", monitors.count(&d.st) >= 1 && monitors.get(&d.st, 0, &rr) == 1);
    let is monitor.Monitor as m;
    check("the window's monitor", display.monitor_of(&d, &w, &m) == 1);
    check("where RandR has it, as large", m.x == rr.x && m.y == rr.y && m.width == rr.width && m.height == rr.height &&
          m.width > 0 && m.height > 0);
    check("named as RandR names it", m.name[0] != 0 && m.name[0] == rr.name[0]);
    check("at the screen's scale", cast(f64, m.scale120) == monitors.scale(&d.st) * 120.0);
    check("no window manager to say: its work area all of it", m.work_x == m.x && m.work_y == m.y &&
          m.work_width == m.width && m.work_height == m.height);

    // A window manager's panels: 30 pixels along the top, on the second of
    // two desktops, which is the current one.
    let is *u8 as wm = xlib.XOpenDisplay(cast(*u8, 0));
    let is i64 as root = xlib.XDefaultRootWindow(wm);
    let is [8]i64 as area;
    area[0] = 0; area[1] = 0; area[2] = m.width; area[3] = m.height;
    area[4] = 0; area[5] = 30; area[6] = m.width; area[7] = m.height - 30;
    xlib.XChangeProperty(wm, root, xlib.XInternAtom(wm, "_NET_WORKAREA", 0), xlib.XInternAtom(wm, "CARDINAL", 0), 32,
                         x.PropModeReplace, cast(*u8, &area), 8);
    let is i64 as current with mut = 1;
    xlib.XChangeProperty(wm, root, xlib.XInternAtom(wm, "_NET_CURRENT_DESKTOP", 0), xlib.XInternAtom(wm, "CARDINAL", 0), 32,
                         x.PropModeReplace, cast(*u8, &current), 1);
    xlib.XSync(wm, 0);
    check("the window manager's work area: the current desktop's", display.monitor_of(&d, &w, &m) == 1 &&
          m.work_x == m.x && m.work_y == m.y + 30 && m.work_width == m.width && m.work_height == m.height - 30);
    current = 0;
    xlib.XChangeProperty(wm, root, xlib.XInternAtom(wm, "_NET_CURRENT_DESKTOP", 0), xlib.XInternAtom(wm, "CARDINAL", 0), 32,
                         x.PropModeReplace, cast(*u8, &current), 1);
    xlib.XSync(wm, 0);
    check("another desktop, another work area", display.monitor_of(&d, &w, &m) == 1 && m.work_y == m.y &&
          m.work_height == m.height);
    // One wider than the monitor: only the monitor's part of it.
    area[0] = 0 - 100; area[1] = 10; area[2] = m.width + 400; area[3] = m.height;
    xlib.XChangeProperty(wm, root, xlib.XInternAtom(wm, "_NET_WORKAREA", 0), xlib.XInternAtom(wm, "CARDINAL", 0), 32,
                         x.PropModeReplace, cast(*u8, &area), 4);
    xlib.XSync(wm, 0);
    check("a work area across monitors: this one's part", display.monitor_of(&d, &w, &m) == 1 && m.work_x == m.x &&
          m.work_y == m.y + 10 && m.work_width == m.width && m.work_height == m.height - 10);
    // Desktops the work area does not list: none said.
    current = 5;
    xlib.XChangeProperty(wm, root, xlib.XInternAtom(wm, "_NET_CURRENT_DESKTOP", 0), xlib.XInternAtom(wm, "CARDINAL", 0), 32,
                         x.PropModeReplace, cast(*u8, &current), 1);
    xlib.XSync(wm, 0);
    check("a desktop it does not list: all of it", display.monitor_of(&d, &w, &m) == 1 && m.work_y == m.y &&
          m.work_height == m.height);
    xlib.XDeleteProperty(wm, root, xlib.XInternAtom(wm, "_NET_WORKAREA", 0));
    xlib.XDeleteProperty(wm, root, xlib.XInternAtom(wm, "_NET_CURRENT_DESKTOP", 0));
    xlib.XCloseDisplay(wm);

    device.close(&w);
    check("closed: none", display.monitor_of(&d, &w, &m) == 0 && m.width == 0 && m.scale120 == 120);
    if (fails == 0) {
        io.printf("display x11: all checks passed\n");
        return 0;
    }
    io.printf("display x11: %d failures\n", fails);
    return 1;
}
