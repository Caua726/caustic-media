// window/input_extras.cst — what a toolkit turns on for input beyond the
// window itself, on whichever backend the window has.
//
//   input_locale   the C library's locale for characters taken from the
//                  environment: X11's input methods compose in it, and in
//                  "C" can commit nothing past ASCII (x11/locale.cst). The
//                  other backends compose in UTF-8 whatever it says; nothing
//                  to do there.
//   fine_pointer   the pointer in full: on X11, XInput 2 turned on for the
//                  window (x11/xinput.cst) — a touchpad's and a fine wheel's
//                  scrolling not in whole notches, a pen's pressure, a
//                  touchscreen's fingers, a touchpad's gestures. Wayland's
//                  and Windows' windows report all of it already.
//
// Kept out of device.cst, as cursor.cst and display.cst are: it links libXi
// and the C library on Linux, which a program that only opens a window and
// reads its core events does not need.
use "std/os.cst" as os;
use "device.cst" as device;
use "x11/locale.cst" as xlocale;
use "x11/xinput.cst" as xinput;

// Once, before the first window: 1, or 0 where the locale the environment
// names could not be set (not installed) and input methods may compose only
// ASCII.
fn input_locale() as i32 {
    if (os.current() != os.OS_LINUX) { return 1; }
    return cast(i32, cast(i64, xlocale.use_environment()) != 0);
}

// For each window as it opens: 1 when the window reports the pointer in full,
// 0 on an X server without XInput 2.1, where the core events go on.
fn fine_pointer(w as *device.Window) as i32 {
    if (os.current() == os.OS_LINUX && w.backend == device.X11) { return xinput.enable(&w.x11_win); }
    return 1;
}
