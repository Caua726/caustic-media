// window/fonts.cst — where the platform keeps fonts, for text/fonts to find
// them, and where the index text/fonts makes of them is kept between runs.
//
//   Linux     /usr/share/fonts, /usr/local/share/fonts, then the user's:
//             $XDG_DATA_HOME/fonts (~/.local/share/fonts when unset) and
//             ~/.fonts, the older place many still use
//   Windows   %WINDIR%\Fonts, then the fonts a user installs without being
//             an administrator, %LOCALAPPDATA%\Microsoft\Windows\Fonts
//
// The index: $XDG_CACHE_HOME/caustic-media/fonts.index (~/.cache when
// unset) on Linux, %LOCALAPPDATA%\caustic-media\fonts.index on Windows.
//
// An XDG variable that is not an absolute path is ignored, as the
// specification says. A path longer than PATH_MAX - 1 bytes is left out
// rather than cut, which would name some other place.
use "std/mem.cst" as mem;
use "std/env.cst" as env;

let is i64 as MAX_DIRS with imut = 4;   // the most either platform lists
let is i64 as PATH_MAX with imut = 512;

struct Dirs {
    n    as i64;
    path as [2048]u8;   // MAX_DIRS paths of PATH_MAX bytes, NUL-terminated
}

fn _len(s as *u8) as i64 {
    if (cast(i64, s) == 0) { return 0; }
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return n;
}

fn dir(d as *Dirs, i as i64) as *u8 { return cast(*u8, cast(i64, &d.path) + i * PATH_MAX); }

// a and b joined into out, cap bytes with the NUL; the length, or 0 when it
// does not fit and nothing is written.
fn _join(out as *u8, cap as i64, a as *u8, b as *u8) as i64 {
    let is i64 as na = _len(a);
    let is i64 as nb = _len(b);
    if (na + nb + 1 > cap) { return 0; }
    mem.memcpy(out, a, na);
    mem.memcpy(cast(*u8, cast(i64, out) + na), b, nb);
    *cast(*u8, cast(i64, out) + na + nb) = cast(u8, 0);
    return na + nb;
}

fn _add(d as *Dirs, a as *u8, b as *u8) as void {
    if (_join(dir(d, d.n), PATH_MAX, a, b) > 0) { d.n = d.n + 1; }
}

fn _absolute(s as *u8) as i32 {
    if (_len(s) > 0 && *s == 47) { return 1; }
    return 0;
}

// Linux's directories, from HOME and XDG_DATA_HOME; either may be null.
fn linux_dirs(home as *u8, data_home as *u8, d as *Dirs) as void {
    d.n = 0;
    _add(d, "/usr/share/fonts", "");
    _add(d, "/usr/local/share/fonts", "");
    if (_absolute(data_home) == 1) {
        _add(d, data_home, "/fonts");
    } else if (_len(home) > 0) {
        _add(d, home, "/.local/share/fonts");
    }
    if (_len(home) > 0) { _add(d, home, "/.fonts"); }
}

// Windows's, from WINDIR and LOCALAPPDATA; either may be null, and without
// WINDIR the system's are where Windows puts them unless told otherwise.
fn windows_dirs(windir as *u8, local as *u8, d as *Dirs) as void {
    d.n = 0;
    if (_len(windir) > 0) { _add(d, windir, "\\Fonts"); } else { _add(d, "C:\\Windows", "\\Fonts"); }
    if (_len(local) > 0) { _add(d, local, "\\Microsoft\\Windows\\Fonts"); }
}

// out left "" — when there is room for that — and 0: nowhere.
fn _nowhere(out as *u8, cap as i64) as i64 {
    if (cap > 0) { *out = cast(u8, 0); }
    return 0;
}

// Where Linux keeps the index, into out; its length, or 0 and "" for
// nowhere.
fn linux_index(home as *u8, cache_home as *u8, out as *u8, cap as i64) as i64 {
    let is i64 as n with mut = 0;
    if (_absolute(cache_home) == 1) { n = _join(out, cap, cache_home, "/caustic-media/fonts.index"); }
    else if (_len(home) > 0) { n = _join(out, cap, home, "/.cache/caustic-media/fonts.index"); }
    if (n == 0) { return _nowhere(out, cap); }
    return n;
}

fn windows_index(local as *u8, out as *u8, cap as i64) as i64 {
    let is i64 as n with mut = 0;
    if (_len(local) > 0) { n = _join(out, cap, local, "\\caustic-media\\fonts.index"); }
    if (n == 0) { return _nowhere(out, cap); }
    return n;
}

// This system's directories. std/env's environment, so the program must
// have called env.init. Windows's getenv answers in one buffer, reused, so
// the first value is copied before the second is asked for.
fn system(d as *Dirs) as void {
    let is [512]u8 as a;
    let is *u8 as pa with mut = cast(*u8, 0);
    let is *u8 as first with mut = cast(*u8, 0);
    if (__target_is_windows == 1) { first = env.getenv("WINDIR"); } else { first = env.getenv("HOME"); }
    if (_join(cast(*u8, &a), 512, first, "") > 0) { pa = cast(*u8, &a); }
    if (__target_is_windows == 1) {
        windows_dirs(pa, env.getenv("LOCALAPPDATA"), d);
    } else {
        linux_dirs(pa, env.getenv("XDG_DATA_HOME"), d);
    }
}

// Where this system keeps the index; its length, 0 for nowhere.
fn index_path(out as *u8, cap as i64) as i64 {
    if (__target_is_windows == 1) { return windows_index(env.getenv("LOCALAPPDATA"), out, cap); }
    return linux_index(env.getenv("HOME"), env.getenv("XDG_CACHE_HOME"), out, cap);
}
