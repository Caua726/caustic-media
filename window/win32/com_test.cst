// The generated inherited slots exercised on the shell's real dialog object.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "bind/types.cst" as t;
use "bind/guids.cst" as ids;
use "bind/ole32.cst" as ole;
use "bind/com.cst" as com;

let is i64 as failures with mut = 0;
fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { io.printf("FAIL %%s\n", name); failures = failures + 1; }
}

fn main() as i32 {
    check("COM initialized", ole.CoInitializeEx(cast(*u8, 0), cast(u32, t.COINIT_APARTMENTTHREADED)) >= 0);
    let is t.GUID as cls = ids.CLSID_FileOpenDialog();
    let is t.GUID as iid = ids.IID_IFileOpenDialog();
    let is *u8 as ptr with mut = cast(*u8, 0);
    let is i32 as made = ole.CoCreateInstance(&cls, cast(*t.IUnknown, 0), cast(u32, t.CLSCTX_INPROC_SERVER), &iid, &ptr);
    check("shell's file dialog", made >= 0 && cast(i64, ptr) != 0);
    if (made >= 0 && cast(i64, ptr) != 0) {
        let is *t.IFileOpenDialog as dlg = cast(*t.IFileOpenDialog, ptr);
        let is u32 as opts with mut = 0;
        check("inherited GetOptions", com.IFileOpenDialog_GetOptions(dlg, &opts) >= 0);
        let is u32 as changed = opts | cast(u32, t.FOS_PICKFOLDERS | t.FOS_FORCEFILESYSTEM);
        check("inherited SetOptions", com.IFileOpenDialog_SetOptions(dlg, changed) >= 0);
        opts = 0;
        check("folder options read back", com.IFileOpenDialog_GetOptions(dlg, &opts) >= 0 && opts == changed);
        let is t.GUID as unknown = ids.IID_IUnknown();
        let is *u8 as queried with mut = cast(*u8, 0);
        check("IUnknown identity", com.IFileOpenDialog_QueryInterface(dlg, &unknown, &queried) >= 0 && cast(i64, queried) != 0);
        if (cast(i64, queried) != 0) { com.IUnknown_Release(cast(*t.IUnknown, queried)); }
        com.IFileOpenDialog_Release(dlg);
    }
    ole.CoUninitialize();
    if (failures != 0) { return 1; }
    io.printf("win32 COM: all checks passed\n");
    return 0;
}
