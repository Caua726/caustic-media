// CF_UNICODETEXT ownership belongs to Windows after SetClipboardData succeeds.
use "std/mem.cst" as mem;
use "bind/user32.cst" as u;
use "bind/kernel32.cst" as k;
use "bind/types.cst" as t;

struct State {
    text as *u8;
    length as i64;
    bytes as i64;
    ready as i32;
}

fn clear(s as *State) as void {
    if (cast(i64, s.text) != 0) { mem.core.munmap(s.text, s.bytes); }
    mem.memzero(cast(*u8, s), sizeof(State));
}

fn set(hwnd as i64, text as *u8, length as i64) as i32 {
    if (length < 0 || length > 2147483646 || (length > 0 && cast(i64, text) == 0)) { return 0; }
    let is i32 as units with mut = 0;
    if (length > 0) {
        units = k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 8, cast(*i8, text), cast(i32, length), cast(*u16, 0), 0);
        if (units <= 0) { return 0; }
    }
    let is i64 as block = k.GlobalAlloc(cast(u32, t.GMEM_MOVEABLE), cast(u64, (cast(i64, units) + 1) * 2));
    if (block == 0) { return 0; }
    let is *u16 as wide = cast(*u16, k.GlobalLock(block));
    if (cast(i64, wide) == 0) { k.GlobalFree(block); return 0; }
    if (units > 0) {
        if (k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 8, cast(*i8, text), cast(i32, length), wide, units) != units) {
            k.GlobalUnlock(block); k.GlobalFree(block); return 0;
        }
    }
    wide[units] = cast(u16, 0);
    k.GlobalUnlock(block);
    if (u.OpenClipboard(hwnd) == 0) { k.GlobalFree(block); return 0; }
    let is i32 as ok with mut = 0;
    if (u.EmptyClipboard() != 0 && u.SetClipboardData(cast(u32, t.CF_UNICODETEXT), block) != 0) { ok = 1; }
    u.CloseClipboard();
    if (ok == 0) { k.GlobalFree(block); }
    return ok;
}

fn request(s as *State, hwnd as i64) as i32 {
    clear(s);
    if (u.OpenClipboard(hwnd) == 0) { return 0; }
    if (u.IsClipboardFormatAvailable(cast(u32, t.CF_UNICODETEXT)) == 0) {
        u.CloseClipboard(); s.ready = 1; return 1;
    }
    let is i64 as block = u.GetClipboardData(cast(u32, t.CF_UNICODETEXT));
    let is i64 as capacity = cast(i64, k.GlobalSize(block)) / 2;
    let is *u16 as wide = cast(*u16, k.GlobalLock(block));
    if (cast(i64, wide) == 0) { u.CloseClipboard(); return 0; }
    let is i64 as units with mut = 0;
    while (units < capacity && wide[units] != 0) { units = units + 1; }
    let is i32 as size with mut = 0;
    if (units > 0 && units <= 2147483647) {
        size = k.WideCharToMultiByte(cast(u32, t.CP_UTF8), 0, wide, cast(i32, units), cast(*i8, 0), 0,
                                   cast(*i8, 0), cast(*i32, 0));
    }
    let is i32 as ok with mut = 1;
    if (size > 0) {
        s.bytes = cast(i64, size) + 1;
        s.text = mem.core.mmap_anon(s.bytes);
        if (cast(i64, s.text) == 0) { ok = 0; }
        else {
            s.length = cast(i64, k.WideCharToMultiByte(cast(u32, t.CP_UTF8), 0, wide, cast(i32, units),
                                                      cast(*i8, s.text), size, cast(*i8, 0), cast(*i32, 0)));
            s.text[s.length] = cast(u8, 0);
        }
    }
    k.GlobalUnlock(block); u.CloseClipboard();
    s.ready = ok;
    return ok;
}

fn read(s as *State, out as *u8, cap as i64) as i64 {
    if (cap <= 0 || cast(i64, out) == 0) { return 0; }
    let is i64 as length with mut = s.length;
    if (length >= cap) { length = cap - 1; }
    if (length > 0) { mem.memcpy(out, s.text, length); }
    out[length] = cast(u8, 0);
    return length;
}
