// window/win32/named_test.cst — formats by name, HTML Format and the DIB on the
// Windows clipboard against another program, the independent peer
// window/win32/tools/clipboard_peer.c (mingw-w64), in the same Wine prefix:
//   sh window/win32/tools/run_native.sh build/win32_named_test.exe
// Owned here and read by the peer: a registered format by its name; HTML as
// "HTML Format", its header's offsets right; a PNG's DIB as CF_DIB. Owned by the
// peer and asked for here: by name; "HTML Format" in a page of its own making,
// the fragment what comes; CF_DIBV5, made a PNG. What is offered on demand made
// when the peer asks (WM_RENDERFORMAT), once, and as the window closes
// (WM_RENDERALLFORMATS). And the change heard as each takes it.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "../transfer.cst" as transfer;
use "../event.cst" as event;
use "../../image/dib.cst" as dib;
use "caustic-compact/core/bytes.cst" as cb;
use "bind/types.cst" as t;
use "bind/kernel32.cst" as k;
use "backend.cst" as win;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("FAIL: %s\n", name); }
}

let is win.Window as w with mut;

// The last change heard of the clipboard: its formats; -1 for none yet.
let is i32 as changed with mut = 0 - 1;

fn pump(ms as i64) as void {
    let is i64 as until = time.now_ms() + ms;
    while (1 == 1) {
        win.pump(&w);
        let is event.Event as e;
        while (win.poll_event(&w, &e) == 1) {
            if (e.kind == event.CLIPBOARD_CHANGED) { changed = e.drop; }
        }
        if (time.now_ms() >= until) { return; }
        time.sleep_ms(2);
    }
}

// An ASCII string as UTF-16, '/' as '\'.
fn wide(s as *u8, out as *u16, cap as i64) as void {
    let is i64 as i with mut = 0;
    while (s[i] != 0 && i < cap - 1) {
        let is u16 as c with mut = cast(u16, s[i]);
        if (c == cast(u16, 47)) { c = cast(u16, 92); }
        out[i] = c;
        i = i + 1;
    }
    out[i] = cast(u16, 0);
}

// The peer run with args, this window pumped meanwhile: its exit code, -1
// when it did not start or took longer than 20 seconds.
fn peer(args as *u8) as i32 {
    let is [512]u8 as line with mut;
    let is *u8 as head = "build\\clipboard_peer.exe ";
    let is i64 as n with mut = 0;
    while (head[n] != 0) { line[n] = head[n]; n = n + 1; }
    let is i64 as i with mut = 0;
    while (args[i] != 0 && n < 510) { line[n] = args[i]; n = n + 1; i = i + 1; }
    line[n] = 0;
    let is [512]u16 as cmd with mut;
    let is i64 as j with mut = 0;
    while (line[j] != 0) { cmd[j] = cast(u16, line[j]); j = j + 1; }
    cmd[j] = cast(u16, 0);
    let is t.STARTUPINFOW as si;
    mem.memzero(cast(*u8, &si), sizeof(t.STARTUPINFOW));
    si.cb = cast(u32, sizeof(t.STARTUPINFOW));
    let is t.PROCESS_INFORMATION as pi;
    mem.memzero(cast(*u8, &pi), sizeof(t.PROCESS_INFORMATION));
    if (k.CreateProcessW(cast(*u16, 0), &cmd[0], cast(*u8, 0), cast(*u8, 0), 0, cast(u32, 0), cast(*u8, 0),
                         cast(*u16, 0), &si, &pi) == 0) { return 0 - 1; }
    let is i64 as until = time.now_ms() + 20000;
    let is i32 as code with mut = 0 - 1;
    while (time.now_ms() < until) {
        win.pump(&w);
        if (k.WaitForSingleObject(pi.hProcess, cast(u32, 5)) == cast(u32, 0)) {
            let is u32 as status with mut = cast(u32, 0);
            k.GetExitCodeProcess(pi.hProcess, &status);
            code = cast(i32, status);
            break;
        }
    }
    if (code < 0) { k.TerminateProcess(pi.hProcess, cast(u32, 9)); }
    k.CloseHandle(pi.hThread);
    k.CloseHandle(pi.hProcess);
    return code;
}

fn read_file(path as *u8, out as *transfer.Bytes) as i32 {
    transfer.bytes_clear(out);
    let is [256]u16 as name;
    wide(path, &name[0], 256);
    let is i64 as h = k.CreateFileW(&name[0], cast(u32, t.GENERIC_READ), cast(u32, t.FILE_SHARE_READ), cast(*u8, 0),
                                    cast(u32, t.OPEN_EXISTING), cast(u32, t.FILE_ATTRIBUTE_NORMAL), 0);
    if (h == t.INVALID_HANDLE_VALUE) { return 0; }
    let is [65536]u8 as buf with mut;
    while (1 == 1) {
        let is u32 as got with mut = cast(u32, 0);
        if (k.ReadFile(h, &buf[0], cast(u32, 65536), &got, cast(*u8, 0)) == 0 || got == cast(u32, 0)) { break; }
        transfer.append(out, &buf[0], cast(i64, got));
    }
    k.CloseHandle(h);
    return 1;
}

fn write_file(path as *u8, p as *u8, n as i64) as i32 {
    let is [256]u16 as name;
    wide(path, &name[0], 256);
    let is i64 as h = k.CreateFileW(&name[0], cast(u32, t.GENERIC_WRITE), 0, cast(*u8, 0), cast(u32, t.CREATE_ALWAYS),
                                    cast(u32, t.FILE_ATTRIBUTE_NORMAL), 0);
    if (h == t.INVALID_HANDLE_VALUE) { return 0; }
    let is i64 as at with mut = 0;
    while (at < n) {
        let is u32 as put with mut = cast(u32, 0);
        let is i64 as part with mut = n - at;
        if (part > 1048576) { part = 1048576; }
        if (k.WriteFile(h, cast(*u8, cast(i64, p) + at), cast(u32, part), &put, cast(*u8, 0)) == 0 || put == cast(u32, 0)) { break; }
        at = at + cast(i64, put);
    }
    k.CloseHandle(h);
    return cast(i32, at == n);
}

fn same(b as *transfer.Bytes, p as *u8, n as i64) as i32 {
    if (b.len != n) { io.printf("  %d bytes, want %d\n", b.len, n); return 0; }
    return cast(i32, mem.memcmp(b.data, p, n) == 0);
}

fn contains(b as *transfer.Bytes, s as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    let is i64 as i with mut = 0;
    while (i + n <= b.len) {
        if (mem.memcmp(cast(*u8, cast(i64, b.data) + i), s, n) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

// The clipboard asked for as format: what came, into out; the format that
// came.
fn ask(format as i32, out as *transfer.Bytes) as i32 {
    transfer.bytes_clear(out);
    if (win.clipboard_request(&w, 0, format) == 0 || win.clipboard_ready(&w) == 0) { return 0 - 1; }
    transfer.bytes_set(out, win.clipboard_data(&w), win.clipboard_length(&w));
    return win.clipboard_format(&w);
}

fn big_text(out as *transfer.Bytes) as void {
    transfer.bytes_clear(out);
    let is *u8 as line = "caustic ação — 3 MB through a global ✓ ";
    let is i64 as n with mut = 0;
    while (line[n] != 0) { n = n + 1; }
    while (out.len < 3145728) { transfer.append(out, line, n); }
}

// The named format asked for: the format that came.
fn ask_named(name as *u8, n as i64, out as *transfer.Bytes) as i32 {
    transfer.bytes_clear(out);
    if (win.clipboard_request_named(&w, 0, name, n) == 0) { return 0; }
    pump(1);
    let is i32 as f = win.clipboard_format(&w);
    if (f != 0) { transfer.bytes_set(out, win.clipboard_data(&w), win.clipboard_length(&w)); }
    return f;
}

// The number of the 10 digits after what, in b; -1 for none.
fn offset_of(b as *transfer.Bytes, what as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (what[n] != 0) { n = n + 1; }
    let is i64 as i with mut = 0;
    while (i + n + 10 <= b.len) {
        if (mem.memcmp(cast(*u8, cast(i64, b.data) + i), what, n) == 0) {
            let is i64 as v with mut = 0;
            let is i64 as d with mut = 0;
            while (d < 10) {
                v = v * 10 + cast(i64, b.data[i + n + d]) - 48;
                d = d + 1;
            }
            return v;
        }
        i = i + 1;
    }
    return 0 - 1;
}

let is i32 as made with mut = 0;
let is i32 as made_format with mut = 0;

fn provide(user as *u8, format as i32, name as *u8, n as i64, out as *transfer.Bytes) as i32 {
    made = made + 1;
    made_format = format;
    if (format == transfer.NAMED) { return transfer.bytes_set(out, "made now", 8); }
    return transfer.bytes_set(out, "text made now", 13);
}

fn change_seen(ms as i64) as i32 {
    let is i64 as until = time.now_ms() + ms;
    while (changed < 0 && time.now_ms() < until) { pump(5); }
    return changed;
}

fn main() as i32 {
    let is win.Config as c = win.config("named", 200, 100);
    w = win.open_config(&c);
    if (w.ok == 0) { io.printf("FAIL: no window\n"); return 1; }
    pump(100);
    let is transfer.Bytes as got with mut;
    transfer.bytes_init(&got);
    let is transfer.Offer as o with mut;
    transfer.offer_init(&o);
    let is *u8 as own = "application/x-caustic-test";
    check("the clipboard followed", win.follow_clipboard(&w) == 1);

    // --- Owned here ---
    transfer.offer_text(&o, "plain", 5);
    transfer.offer_named(&o, transfer.MIME_HTML, 9, "<i>rich</i>", 11);
    transfer.offer_named(&o, own, 26, "own bytes", 9);
    changed = 0 - 1;
    check("owned", win.clipboard_set(&w, 0, &o) == 1);
    let is i32 as ch with mut = change_seen(3000);
    check("our own taking it: said, text and HTML", ch >= 0 && (ch & transfer.TEXT) != 0 && (ch & transfer.HTML) != 0);
    check("the formats named", peer("formats build/sel-a") == 0 && read_file("build/sel-a", &got) == 1 &&
          contains(&got, "HTML Format") == 1 && contains(&got, own) == 1 && contains(&got, "CF_UNICODETEXT") == 1);
    check("its own read by name", peer("get-named application/x-caustic-test build/sel-a") == 0 && read_file("build/sel-a", &got) == 1 &&
          got.len >= 9 && mem.memcmp(got.data, "own bytes", 9) == 0);
    check("HTML Format read", peer("get-named \"HTML Format\" build/sel-a") == 0 && read_file("build/sel-a", &got) == 1);
    let is i64 as fa = offset_of(&got, "StartFragment:");
    let is i64 as fb = offset_of(&got, "EndFragment:");
    let is i64 as ha = offset_of(&got, "StartHTML:");
    check("its header's offsets: the fragment", fa > 0 && fb - fa == 11 && ha > 0 && ha < fa && fb <= got.len &&
          mem.memcmp(cast(*u8, cast(i64, got.data) + fa), "<i>rich</i>", 11) == 0);

    // --- A PNG's DIB ---
    let is transfer.Bytes as png with mut;
    transfer.bytes_init(&png);
    check("a PNG to offer", read_file("image/testdata/rgba.png", &png) == 1);
    let is cb.Bytes as made_dib with mut = cb.bytes_new(0);
    let is i64 as dn = dib.dib_from_png(png.data, png.len, &made_dib);
    check("its DIB made", dn >= 40);
    transfer.offer_free(&o);
    transfer.offer_init(&o);
    transfer.offer_png(&o, png.data, png.len);
    transfer.offer_dib(&o, made_dib.ptr, dn);
    check("owned with a PNG and its DIB", win.clipboard_set(&w, 0, &o) == 1);
    check("CF_DIB read", peer("get-cf 8 build/sel-a") == 0 && read_file("build/sel-a", &got) == 1 && got.len >= dn &&
          mem.memcmp(got.data, made_dib.ptr, dn) == 0);

    // --- Owned by the peer ---
    write_file("build/sel-in", "<u>theirs</u>", 13);
    changed = 0 - 1;
    check("the peer takes it with HTML Format", peer("put-html build/sel-in") == 0);
    ch = change_seen(3000);
    check("said: HTML there", ch >= 0 && (ch & transfer.HTML) != 0);
    check("what it offers: named, by name", win.clipboard_request(&w, 0, 0) == 1 && (win.clipboard_offered(&w) & transfer.NAMED) != 0 &&
          transfer.names_has(win.clipboard_offered_names(&w), transfer.MIME_HTML, 9) == 1);
    check("the fragment what comes", ask_named(transfer.MIME_HTML, 9, &got) == transfer.NAMED && same(&got, "<u>theirs</u>", 13) == 1);
    write_file("build/sel-in", "their own", 9);
    check("the peer takes it with its own", peer("put-named application/x-caustic-test build/sel-in") == 0);
    check("its own asked for by name", ask_named(own, 26, &got) == transfer.NAMED && got.len >= 9 && mem.memcmp(got.data, "their own", 9) == 0);
    check("a name not there: none", ask_named("application/x-absent", 20, &got) == 0 && got.len == 0);
    // CF_DIBV5, by hand: a 124-byte header, BI_BITFIELDS, 2 by 1, bottom-up.
    let is [132]u8 as v5 with mut;
    mem.memzero(&v5[0], 132);
    v5[0] = cast(u8, 124);          // bV5Size
    v5[4] = cast(u8, 2);            // width
    v5[8] = cast(u8, 1);            // height
    v5[12] = cast(u8, 1);           // planes
    v5[14] = cast(u8, 32);          // bits
    v5[16] = cast(u8, 3);           // BI_BITFIELDS
    v5[42] = cast(u8, 255);         // red mask 0x00FF0000
    v5[45] = cast(u8, 255);         // green mask 0x0000FF00
    v5[48] = cast(u8, 255);         // blue mask 0x000000FF
    v5[55] = cast(u8, 255);         // alpha mask 0xFF000000
    // Blue, then red: B, G, R, A.
    v5[124] = cast(u8, 255); v5[127] = cast(u8, 255);
    v5[130] = cast(u8, 255); v5[131] = cast(u8, 255);
    write_file("build/sel-in", &v5[0], 132);
    check("the peer takes it with CF_DIBV5", peer("put-cf 17 build/sel-in") == 0);
    check("offered as a DIB", win.clipboard_request(&w, 0, 0) == 1 && (win.clipboard_offered(&w) & transfer.DIB) != 0);
    check("the DIB asked for", win.clipboard_request(&w, 0, transfer.DIB) == 1 && win.clipboard_format(&w) == transfer.DIB);
    let is cb.Bytes as out_png with mut = cb.bytes_new(0);
    let is i64 as pn = dib.png_from_dib(win.clipboard_data(&w), win.clipboard_length(&w), &out_png);
    check("made a PNG", pn > 8);
    let is cb.Bytes as back with mut = cb.bytes_new(0);
    let is i64 as bn = dib.dib_from_png(out_png.ptr, pn, &back);
    check("the same pixels, through it", bn >= 48);
    if (bn >= 48) {
        let is *u8 as rows = cast(*u8, cast(i64, back.ptr) + 40);
        check("blue, then red", rows[0] == cast(u8, 255) && rows[2] == cast(u8, 0) && rows[3] == cast(u8, 255) &&
              rows[4] == cast(u8, 0) && rows[6] == cast(u8, 255) && rows[7] == cast(u8, 255));
    }

    // --- Made on demand: when asked, once ---
    transfer.offer_free(&o);
    transfer.offer_init(&o);
    transfer.offer_lazy(&o, transfer.TEXT, fn_ptr(provide), cast(*u8, 0));
    check("named on demand: said", transfer.offer_lazy_named(&o, own, 26, fn_ptr(provide), cast(*u8, 0)) == 1);
    made = 0;
    check("owned, nothing made", win.clipboard_set(&w, 0, &o) == 1 && made == 0);
    check("listed: still nothing made", peer("formats build/sel-a") == 0 && made == 0 && read_file("build/sel-a", &got) == 1 &&
          contains(&got, own) == 1);
    check("its text asked for: made", peer("get-text build/sel-a") == 0 && made == 1 && made_format == transfer.TEXT &&
          read_file("build/sel-a", &got) == 1 && same(&got, "text made now", 13) == 1);
    check("and again: made once", peer("get-text build/sel-a") == 0 && made == 1);
    // Taken by ourselves again: what was offered before let go, what is new served.
    transfer.offer_free(&o);
    transfer.offer_init(&o);
    transfer.offer_lazy(&o, transfer.TEXT, fn_ptr(provide), cast(*u8, 0));
    check("named on demand again", transfer.offer_lazy_named(&o, own, 26, fn_ptr(provide), cast(*u8, 0)) == 1);
    made = 0;
    check("owned again", win.clipboard_set(&w, 0, &o) == 1);
    check("served after taking it from itself", peer("get-named application/x-caustic-test build/sel-a") == 0 && made == 1 &&
          read_file("build/sel-a", &got) == 1 && got.len >= 8 && mem.memcmp(got.data, "made now", 8) == 0);
    // Its window closed: what was put off made now, to stay.
    win.close(&w);
    check("closed: the rest made", made == 2);
    check("and still there", peer("get-text build/sel-a") == 0 && read_file("build/sel-a", &got) == 1 && same(&got, "text made now", 13) == 1);
    transfer.offer_free(&o);
    if (fails == 0) { io.printf("win32 named formats: all checks passed\n"); return 0; }
    io.printf("win32 named formats: %d failures\n", fails);
    return 1;
}
