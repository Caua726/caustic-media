// The oracle is native C compiled for Win64: different calling conventions,
// stack arguments, mixed doubles and every full-width nonvolatile XMM register.
use "std/io.cst" as io;
use "abi.cst" as abi;
extern "abi_oracle.dll" fn WideAddress() as *u8;
extern "abi_oracle.dll" fn MixedAddress() as *u8;
extern "abi_oracle.dll" fn ExerciseWide(cb as *u8) as u64;
extern "abi_oracle.dll" fn ExerciseMixed(cb as *u8) as u64;
extern "abi_oracle.dll" fn ExercisePreserved(cb as *u8) as u64;

let is i64 as failures with mut = 0;
fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { io.printf("FAIL %%s\n", name); failures = failures + 1; }
}
fn wide(ctx as *u8, slots as *u64) as i64 {
    // pxor xmm6..15: all volatile under Caustic's SysV ABI.
    asm(".byte 102,15,239,246,102,15,239,255,102,69,15,239,192,102,69,15,239,201,102,69,15,239,210,102,69,15,239,219,102,69,15,239,228,102,69,15,239,237,102,69,15,239,246,102,69,15,239,255\n");
    if (cast(i64, ctx) != 123456) { return 0; }
    let is i64 as i with mut = 0;
    while (i < 16) {
        if (slots[i] != 12379813811299811328 + cast(u64, i)) { return 0; }
        i = i + 1;
    }
    return 1311768467463790320;
}
fn mixed(ctx as *u8, slots as *u64) as i64 {
    return cast(i64, slots[0] == 31 && *cast(*f64, &slots[1]) == 1.25 &&
        slots[2] == 33 && *cast(*f64, &slots[3]) == 0.0 - 2.5 &&
        slots[4] == 35 && *cast(*f64, &slots[5]) == 3.75);
}
fn main() as i32 {
    let is [16]u64 as slots;
    let is i64 as i with mut = 0;
    while (i < 16) { slots[i] = 12379813811299811328 + cast(u64, i); i = i + 1; }
    check("native's 16 slots", abi.invoke(WideAddress(), cast(*u64, &slots), 16) == 1311768467463790320);
    slots[0] = 31; *cast(*f64, &slots[1]) = 1.25; slots[2] = 33;
    *cast(*f64, &slots[3]) = 0.0 - 2.5; slots[4] = 35; *cast(*f64, &slots[5]) = 3.75;
    check("native mixed slots", abi.invoke(MixedAddress(), cast(*u64, &slots), 6) == 1);
    let is abi.Callbacks as cb = abi.open(2);
    check("callback pool", cast(i64, cb.code) != 0);
    check("no callable writable code", cast(i64, abi.address(&cb, 0)) == 0);
    check("first callback", abi.put(&cb, 0, fn_ptr(wide), cast(*u8, 123456), 16, 0) == 1);
    check("second callback", abi.put(&cb, 1, fn_ptr(mixed), cast(*u8, 0), 6, 10) == 1);
    check("sealed pool", abi.seal(&cb) == 1);
    check("callback immutable", abi.put(&cb, 0, fn_ptr(mixed), cast(*u8, 0), 6, 10) == 0);
    check("callback's 16 slots", ExerciseWide(abi.address(&cb, 0)) == 1311768467463790320);
    check("callback mixed slots", ExerciseMixed(abi.address(&cb, 1)) == 1);
    check("full nonvolatile registers", ExercisePreserved(abi.address(&cb, 0)) == 1);
    check("outside callback pool", cast(i64, abi.address(&cb, 2)) == 0);
    abi.close(&cb);
    check("closed callback pool", cast(i64, abi.address(&cb, 0)) == 0);
    if (failures != 0) { return 1; }
    io.printf("win32 ABI: all checks passed\n");
    return 0;
}
