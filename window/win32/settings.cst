// Windows desktop preferences. Failed queries leave the portable default unknown.
use "std/mem.cst" as mem;
use "../settings.cst" as settings;
use "bind/types.cst" as t;
use "bind/user32.cst" as u;
use "bind/kernel32.cst" as k;
use "bind/advapi32.cst" as registry;
use "bind/dwmapi.cst" as dwm;

fn _dword(path as *u8, name as *u8, value as *u32) as i32 {
    let is [256]u16 as wide_path;
    let is [64]u16 as wide_name;
    if (k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, path), cast(i32, 0 - 1),
                             cast(*u16, &wide_path), 256) == 0 ||
        k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, name), cast(i32, 0 - 1),
                             cast(*u16, &wide_name), 64) == 0) { return 0; }
    let is u32 as bytes with mut = 4;
    return cast(i32, registry.RegGetValueW(0 - 2147483647, cast(*u16, &wide_path), cast(*u16, &wide_name),
                                          cast(u32, t.RRF_RT_REG_DWORD), cast(*u32, 0), cast(*u8, value), &bytes) == 0);
}

fn read() as settings.Settings {
    let is settings.Settings as s = settings.defaults();
    let is u32 as value;
    if (_dword("Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "AppsUseLightTheme", &value) == 1) {
        s.dark = cast(i32, value == 0); s.known = s.known | settings.K_DARK;
    }
    if (_dword("Software\\Microsoft\\Accessibility", "TextScaleFactor", &value) == 1 && value > 0) {
        s.text_scale = cast(f64, value) / 100.0; s.known = s.known | settings.K_TEXT_SCALE;
    }
    let is t.HIGHCONTRASTW as contrast;
    mem.memzero(cast(*u8, &contrast), sizeof(t.HIGHCONTRASTW)); contrast.cbSize = cast(u32, sizeof(t.HIGHCONTRASTW));
    if (u.SystemParametersInfoW(cast(u32, t.SPI_GETHIGHCONTRAST), contrast.cbSize, cast(*u8, &contrast), 0) != 0) {
        s.high_contrast = cast(i32, (contrast.dwFlags & cast(u32, t.HCF_HIGHCONTRASTON)) != 0);
        s.known = s.known | settings.K_HIGH_CONTRAST;
    }
    let is i32 as animations;
    if (u.SystemParametersInfoW(cast(u32, t.SPI_GETCLIENTAREAANIMATION), 0, cast(*u8, &animations), 0) != 0) {
        s.animations = cast(i32, animations != 0); s.known = s.known | settings.K_ANIMATIONS;
    }
    let is u32 as color;
    let is i32 as opaque;
    if (dwm.DwmGetColorizationColor(&color, &opaque) == 0) {
        s.accent_r = cast(f64, (color >> 16) & 255) / 255.0;
        s.accent_g = cast(f64, (color >> 8) & 255) / 255.0;
        s.accent_b = cast(f64, color & 255) / 255.0;
        s.known = s.known | settings.K_ACCENT;
    }
    let is u32 as dpi = u.GetDpiForSystem();
    if (dpi > 0) { s.dpi = cast(f64, dpi); s.known = s.known | settings.K_DPI; }
    let is t.NONCLIENTMETRICSW as metrics;
    mem.memzero(cast(*u8, &metrics), sizeof(t.NONCLIENTMETRICSW)); metrics.cbSize = cast(u32, sizeof(t.NONCLIENTMETRICSW));
    if (u.SystemParametersInfoW(cast(u32, t.SPI_GETNONCLIENTMETRICS), metrics.cbSize, cast(*u8, &metrics), 0) != 0) {
        let is i32 as units with mut = 0;
        while (units < 32 && metrics.lfMessageFont.lfFaceName[units] != 0) { units = units + 1; }
        let is i32 as length = k.WideCharToMultiByte(cast(u32, t.CP_UTF8), 0, &metrics.lfMessageFont.lfFaceName[0], units,
                                                   cast(*i8, &s.font[0]), 127, cast(*i8, 0), cast(*i32, 0));
        if (length > 0) {
            s.font[length] = cast(u8, 0);
            let is i32 as height with mut = metrics.lfMessageFont.lfHeight;
            if (height < 0) { height = 0 - height; }
            s.font_size = cast(f64, height) * 72.0 / s.dpi;
            s.known = s.known | settings.K_FONT;
        }
    }
    s.double_click_ms = cast(i64, u.GetDoubleClickTime());
    s.double_click_px = cast(i64, u.GetSystemMetrics(cast(i32, t.SM_CXDOUBLECLK))) / 2;
    s.drag_px = cast(i64, u.GetSystemMetrics(cast(i32, t.SM_CXDRAG))) / 2;
    s.known = s.known | settings.K_DOUBLE_CLICK_MS | settings.K_DOUBLE_CLICK_PX | settings.K_DRAG;
    let is u32 as blink = u.GetCaretBlinkTime();
    if (blink != 0) {
        s.blink = cast(i32, blink != 4294967295); s.blink_ms = cast(i64, blink) * 2;
        s.known = s.known | settings.K_BLINK | settings.K_BLINK_MS;
    }
    let is [85]u16 as locale;
    let is i32 as locale_units = k.GetUserDefaultLocaleName(cast(*u16, &locale), 85);
    if (locale_units > 1) {
        let is i32 as locale_bytes = k.WideCharToMultiByte(cast(u32, t.CP_UTF8), 0, cast(*u16, &locale), locale_units - 1,
                                                         cast(*i8, &s.locale[0]), 31, cast(*i8, 0), cast(*i32, 0));
        if (locale_bytes > 0) { s.locale[locale_bytes] = cast(u8, 0); s.known = s.known | settings.K_LOCALE; }
    }
    settings.set_text(cast(*u8, &s.button_layout), 96, ":minimize,maximize,close", 24);
    s.known = s.known | settings.K_BUTTON_LAYOUT;
    return s;
}
