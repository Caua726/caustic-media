// window/win32/filedialog_test.cst — Windows' own file dialog (under Wine in
// test-win32): IFileOpenDialog and IFileSaveDialog shown, answered by a timer
// running inside their modal loop — a name set in the name box, then OK or
// Cancel, the dialog's controls worked as an accessibility tool works them
// (Wine's dialog takes no SendInput keys there) — and the answer read back:
// files, a folder, a name to save to, the filter chosen, or nothing when
// cancelled.
use "std/io.cst" as io;
use "std/os.cst" as os;
use "std/mem.cst" as mem;
use "std/env.cst" as env;
use "../../sys/file.cst" as file;
use "abi.cst" as abi;
use "bind/types.cst" as t;
use "bind/user32.cst" as u;
use "filedialog.cst" as filedialog;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn ends(s as *u8, n as i64, tail as *u8) as i32 {
    let is i64 as k = _len(tail);
    return cast(i32, n >= k && mem.memcmp(cast(*u8, cast(i64, s) + n - k), tail, k) == 0);
}

// What the timer gives the dialog once it is up, the dialog's title it
// waits for, and how far it got: 0 looking, 1 found and brought forward, 2
// answered.
let is [256]u8 as typing with mut;
let is [64]u16 as awaited with mut;
let is i64 as finish with mut = 0;   // what ends it: IDOK or IDCANCEL
let is i32 as phase with mut = 0;

fn step(ctx as *u8, args as *u64) as i64 {
    if (phase == 0) {
        let is i64 as dlg = u.FindWindowExW(0, 0, cast(*u16, 0), &awaited[0]);
        if (dlg != 0) {
            u.SetForegroundWindow(dlg);
            phase = 1;
        }
        return 0;
    }
    if (phase != 1) { return 0; }
    phase = 2;
    // Its name box given the name, and the dialog's own OK or Cancel — its
    // controls worked as an accessibility tool works them. The name box is
    // edt1 in Wine's dialog, the edit in cmb13 in Windows'.
    let is i64 as dlg = u.GetForegroundWindow();
    let is i64 as name_box with mut = u.GetDlgItem(dlg, 1152);
    if (name_box == 0) {
        let is [8]u16 as edit_class;
        let is *u8 as ec = "Edit";
        let is i64 as e with mut = 0;
        while (e < 5) {
            edit_class[e] = cast(u16, ec[e]);
            e = e + 1;
        }
        name_box = u.FindWindowExW(u.GetDlgItem(dlg, 1148), 0, &edit_class[0], cast(*u16, 0));
    }
    if (finish == t.IDOK) {
        let is [256]u16 as w;
        let is i64 as i with mut = 0;
        while (typing[i] != 0) {
            w[i] = cast(u16, typing[i]);
            i = i + 1;
        }
        w[i] = cast(u16, 0);
        u.SetWindowTextW(name_box, &w[0]);
    }
    u.PostMessageW(dlg, cast(u32, t.WM_COMMAND), cast(u64, finish), 0);
    return 0;
}

let is abi.Callbacks as timers with mut;

// The next dialog, titled title, answered with the name s and fin.
fn answer(title as *u8, s as *u8, fin as i64) as u64 {
    let is i64 as n = _len(s);
    mem.memcpy(cast(*u8, &typing), s, n + 1);
    let is i64 as i with mut = 0;
    while (title[i] != 0 && i < 63) {
        awaited[i] = cast(u16, title[i]);
        i = i + 1;
    }
    awaited[i] = cast(u16, 0);
    finish = fin;
    phase = 0;
    return u.SetTimer(0, 0, 150, abi.address(&timers, 0));
}

let is [512]u8 as root with mut;
let is i64 as root_n with mut = 0;
let is [600]u8 as joined with mut;

fn at(rel as *u8) as *u8 {
    let is i64 as k = _len(rel);
    mem.memcpy(cast(*u8, &joined), cast(*u8, &root), root_n);
    joined[root_n] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &joined) + root_n + 1), rel, k + 1);
    return cast(*u8, &joined);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    timers = abi.open(1);
    abi.put(&timers, 0, fn_ptr(step), cast(*u8, 0), 4, 0);
    abi.seal(&timers);

    let is [512]u8 as here;
    let is i64 as hn = file.cwd(cast(*u8, &here), 512);
    root_n = io.sprintf(cast(*u8, &root), 512, "%s/build/filedialog.%d", cast(*u8, &here), os.pid());
    file.make_dir(cast(*u8, &root), 0);
    file.write_atomic(at("one.txt"), "1", 1, 0);
    file.write_atomic(at("two.md"), "2", 1, 0);
    file.make_dir(at("sub"), 0);
    check("a folder of files to choose from", hn > 0);

    // --- A file opened ---
    let is filedialog.Options as o = filedialog.options();
    o.folder = cast(*u8, &root);
    o.folder_len = root_n;
    check("filters added", filedialog.add_filter(&o, "Text", 4, "*.txt", 5) == 0 && filedialog.add_filter(&o, "All", 3, "*", 1) == 1);
    let is filedialog.Request as q;
    let is u64 as tm with mut = answer("Open a file", "one.txt", t.IDOK);
    check("opened: chosen", filedialog.open_file(0, "Open a file", 11, &o, &q) == 1 && filedialog.state(&q) == filedialog.CHOSEN);
    u.KillTimer(0, tm);
    let is [1024]u8 as p;
    let is i64 as pn with mut = filedialog.path(&q, 0, cast(*u8, &p), 1024);
    check("opened: the one file, its whole path with '/'", filedialog.count(&q) == 1 && ends(cast(*u8, &p), pn, "/one.txt") == 1 &&
          p[1] == cast(u8, 58) && p[2] == cast(u8, 47));
    check("opened: the first filter left chosen", filedialog.filter_index(&q) == 0);
    check("a path beyond the answer: none", filedialog.path(&q, 1, cast(*u8, &p), 1024) == 0);

    // --- Cancelled ---
    tm = answer("Open", "", t.IDCANCEL);
    check("cancelled: nothing chosen", filedialog.open_file(0, "Open", 4, &o, &q) == 1 && filedialog.state(&q) == filedialog.CANCELLED &&
          filedialog.count(&q) == 0);
    u.KillTimer(0, tm);

    // --- Two files at once ---
    let is filedialog.Options as many = filedialog.options();
    many.folder = cast(*u8, &root);
    many.folder_len = root_n;
    many.multiple = 1;
    tm = answer("Open files", "\"one.txt\" \"two.md\"", t.IDOK);
    check("several: chosen", filedialog.open_file(0, "Open files", 10, &many, &q) == 1 && filedialog.state(&q) == filedialog.CHOSEN);
    u.KillTimer(0, tm);
    let is i32 as seen with mut = 0;
    let is i64 as i with mut = 0;
    while (i < filedialog.count(&q)) {
        pn = filedialog.path(&q, i, cast(*u8, &p), 1024);
        if (ends(cast(*u8, &p), pn, "/one.txt") == 1) { seen = seen | 1; }
        if (ends(cast(*u8, &p), pn, "/two.md") == 1) { seen = seen | 2; }
        i = i + 1;
    }
    check("several: both files", filedialog.count(&q) == 2 && seen == 3);

    // --- A folder ---
    let is filedialog.Options as dir = filedialog.options();
    dir.folder = cast(*u8, &root);
    dir.folder_len = root_n;
    dir.directory = 1;
    tm = answer("Choose a folder", "sub", t.IDOK);
    check("a folder: chosen", filedialog.open_file(0, "Choose a folder", 15, &dir, &q) == 1 && filedialog.state(&q) == filedialog.CHOSEN);
    u.KillTimer(0, tm);
    pn = filedialog.path(&q, 0, cast(*u8, &p), 1024);
    check("a folder: its path", filedialog.count(&q) == 1 && ends(cast(*u8, &p), pn, "/sub") == 1);

    // --- Saved to ---
    let is filedialog.Options as sv = filedialog.options();
    sv.folder = cast(*u8, &root);
    sv.folder_len = root_n;
    sv.name = "notes.txt";
    sv.name_len = 9;
    filedialog.add_filter(&sv, "Text", 4, "*.txt", 5);
    tm = answer("Save as", "new.txt", t.IDOK);
    check("saved: chosen", filedialog.save_file(0, "Save as", 7, &sv, &q) == 1 && filedialog.state(&q) == filedialog.CHOSEN);
    u.KillTimer(0, tm);
    pn = filedialog.path(&q, 0, cast(*u8, &p), 1024);
    check("saved: the name typed, in the folder", filedialog.count(&q) == 1 && ends(cast(*u8, &p), pn, "/new.txt") == 1);

    file.remove(at("one.txt"));
    file.remove(at("two.md"));
    file.remove(at("sub"));
    file.remove(cast(*u8, &root));
    if (fails != 0) {
        io.printf("file dialog win32: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("file dialog win32: all checks passed\n");
    return 0;
}
