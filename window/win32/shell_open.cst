// window/win32/shell_open.cst — a link or a file opened by Windows' shell.
//
// ShellExecuteW with the "open" verb: the browser for a link, the program a
// file's type is associated with for a file, the window owner — when there
// is one — what its windows are put above. The shell answers at once.
use "bind/types.cst" as t;
use "bind/kernel32.cst" as k32;
use "bind/shell32.cst" as shell;

// what, zero-terminated UTF-8 — a URI, or a file's own path — opened with
// owner (an HWND, 0 for none): 1, or 0 when the shell could not.
fn open(what as *u8, owner as i64) as i32 {
    let is [4100]u16 as wide;
    if (k32.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, what), cast(i32, 0 - 1), &wide[0], 4100) <= 0) { return 0; }
    let is [8]u16 as verb;
    k32.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, "open"), cast(i32, 0 - 1), &verb[0], 8);
    // Above 32 is done; at most 32 an error.
    let is i64 as r = shell.ShellExecuteW(owner, &verb[0], &wide[0], cast(*u16, 0), cast(*u16, 0), cast(i32, t.SW_SHOWNORMAL));
    return cast(i32, r > 32);
}
