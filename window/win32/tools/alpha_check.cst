// window/win32/tools/alpha_check.cst — the screen read back while
// transparent_win32_test's window is up (see there): its green square found,
// the half-seen red beside it blended over the desktop's blue, the blue
// itself through its clear part. Then the file named by CAUSTIC_ALPHA_DONE is
// written, which ends the window. 0 when the compositor showed it so.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/time.cst" as time;
use "../../x11/bind/xlib.cst" as xlib;

let is *u8 as xd with mut;
let is *u8 as shot with mut;

fn at(x as i64, y as i64) as i64 { return xlib.XGetPixel(shot, cast(i32, x), cast(i32, y)) & 16777215; }

fn channel(v as i64, shift as i64) as i64 { return (v >> shift) & 255; }

fn near(got as i64, want as i64) as i32 { return cast(i32, got >= want - 2 && got <= want + 2); }

fn finish(done as *u8, status as i32) as i32 {
    if (shot != cast(*u8, 0)) { xlib.XDestroyImage(shot); }
    io.write_file_atomic(done, "done\n", 5);
    xlib.XCloseDisplay(xd);
    return status;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is *u8 as done = env.getenv("CAUSTIC_ALPHA_UNIX_DONE");
    if (cast(i64, done) == 0 || done[0] == 0) { io.printf("FAIL: CAUSTIC_ALPHA_UNIX_DONE not set\n"); return 1; }
    xd = xlib.XOpenDisplay(cast(*u8, 0));
    if (cast(i64, xd) == 0) { io.printf("FAIL: no X screen\n"); return 1; }
    let is i64 as root = xlib.XDefaultRootWindow(xd);
    let is i64 as sw = cast(i64, xlib.XDisplayWidth(xd, 0));
    let is i64 as sh = cast(i64, xlib.XDisplayHeight(xd, 0));
    shot = cast(*u8, 0);
    // The green square's top left, once the window is up.
    let is i64 as gx with mut = 0 - 1;
    let is i64 as gy with mut = 0 - 1;
    let is i64 as until = time.now_ms() + 50000;
    while (gx < 0 && time.now_ms() < until) {
        if (shot != cast(*u8, 0)) { xlib.XDestroyImage(shot); }
        shot = xlib.XGetImage(xd, root, 0, 0, cast(u32, sw), cast(u32, sh), 0 - 1, 2);
        if (shot != cast(*u8, 0)) {
            let is i64 as y with mut = 0;
            while (y < sh && gx < 0) {
                let is i64 as x with mut = 0;
                while (x < sw && gx < 0) {
                    if (at(x, y) == 65280) { gx = x; gy = y; }
                    x = x + 4;
                }
                y = y + 4;
            }
        }
        if (gx < 0) { time.sleep_ms(200); }
    }
    if (gx < 0) { io.printf("FAIL: the window never showed\n"); return finish(done, 1); }
    // A moment more: the frame the scan caught may have been a partial one.
    time.sleep_ms(300);
    xlib.XDestroyImage(shot);
    shot = xlib.XGetImage(xd, root, 0, 0, cast(u32, sw), cast(u32, sh), 0 - 1, 2);
    while (gx > 0 && at(gx - 1, gy) == 65280) { gx = gx - 1; }
    while (gy > 0 && at(gx, gy - 1) == 65280) { gy = gy - 1; }
    let is i32 as fails with mut = 0;
    // The window's top left is 20 up and left of the square.
    let is i64 as wx = gx - 20;
    let is i64 as wy = gy - 20;
    let is i64 as square = at(gx + 10, gy + 10);
    let is i64 as half = at(wx + 100, wy + 60);
    let is i64 as clear = at(wx + 200, wy + 60);
    let is i64 as edge = at(wx + 2, wy + 2);
    io.printf("square %x, half-seen red %x, clear %x, its corner %x\n", square, half, clear, edge);
    if (square != 65280) { io.printf("FAIL: the opaque square not as drawn\n"); fails = fails + 1; }
    // 0x80 red over 0xff blue: red 128, blue 255 * (1 - 128/255).
    if (near(channel(half, 16), 128) == 0 || channel(half, 8) != 0 || near(channel(half, 0), 127) == 0) {
        io.printf("FAIL: the half-seen red not blended over the blue\n"); fails = fails + 1;
    }
    if (edge != half) { io.printf("FAIL: the half-seen red not up to its corner\n"); fails = fails + 1; }
    if (clear != 255) { io.printf("FAIL: the blue not seen through the clear part\n"); fails = fails + 1; }
    if (fails == 0) { io.printf("win32 alpha under a compositor: all checks passed\n"); }
    return finish(done, cast(i32, fails != 0));
}
