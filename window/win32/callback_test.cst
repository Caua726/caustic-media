// A real foreign callback, including reentry while the window is being made.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "bind/types.cst" as t;
use "bind/user32.cst" as u;
use "bind/kernel32.cst" as k;
use "abi.cst" as abi;

let is i64 as failures with mut = 0;
let is i64 as created with mut = 0;
let is i64 as called with mut = 0;
let is i64 as nested with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { io.printf("FAIL %%s\n", name); failures = failures + 1; }
}

fn procedure(ctx as *u8, args as *u64) as i64 {
    let is i64 as hwnd = cast(i64, args[0]);
    let is u32 as msg = cast(u32, args[1]);
    if (cast(i64, msg) == t.WM_NCCREATE) {
        created = created + 1;
        return 1;
    }
    if (cast(i64, msg) == t.WM_APP + 1) {
        check("callback context", cast(i64, ctx) == 9876);
        check("first argument", u.IsWindow(hwnd) == 1);
        check("third argument", args[2] == 123456789);
        check("fourth argument signed", cast(i64, args[3]) == 0 - 3456);
        called = called + 1;
        let is i64 as result = u.SendMessageW(hwnd, cast(u32, t.WM_APP + 2), 5678, 9012);
        check("reentrant result", result == 7654321);
        return 1234567890;
    }
    if (cast(i64, msg) == t.WM_APP + 2) {
        check("reentrant arguments", args[2] == 5678 && args[3] == 9012);
        nested = nested + 1;
        return 7654321;
    }
    return u.DefWindowProcW(hwnd, msg, args[2], cast(i64, args[3]));
}

fn main() as i32 {
    let is abi.Callbacks as cb = abi.open(1);
    check("callback storage", cast(i64, cb.code) != 0);
    if (cast(i64, cb.code) == 0) { return 1; }
    check("callback defined", abi.put(&cb, 0, fn_ptr(procedure), cast(*u8, 9876), 4, 0) == 1);
    check("callback sealed", abi.seal(&cb) == 1);
    let is [32]u16 as class_name;
    k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, "CausticCallbackCheck", cast(i32, 0 - 1), cast(*u16, &class_name), 32);
    let is t.WNDCLASSEXW as wc;
    mem.memzero(cast(*u8, &wc), sizeof(t.WNDCLASSEXW));
    wc.cbSize = cast(u32, sizeof(t.WNDCLASSEXW));
    wc.lpfnWndProc = abi.address(&cb, 0);
    wc.hInstance = k.GetModuleHandleW(cast(*u16, 0));
    wc.lpszClassName = cast(*u16, &class_name);
    check("window class", u.RegisterClassExW(&wc) != 0);
    let is i64 as hwnd = u.CreateWindowExW(0, cast(*u16, &class_name), cast(*u16, &class_name), cast(u32, t.WS_OVERLAPPEDWINDOW), 0, 0, 160, 120, 0, 0, wc.hInstance, cast(*u8, 0));
    check("window made", hwnd != 0);
    if (hwnd != 0) {
        check("creation callback", created == 1);
        check("native result", u.SendMessageW(hwnd, cast(u32, t.WM_APP + 1), 123456789, 0 - 3456) == 1234567890);
        check("callback count", called == 1 && nested == 1);
        check("window destroyed", u.DestroyWindow(hwnd) == 1);
    }
    check("class unregistered", u.UnregisterClassW(cast(*u16, &class_name), wc.hInstance) == 1);
    abi.close(&cb);
    if (failures != 0) { return 1; }
    io.printf("win32 callback: all checks passed\n");
    return 0;
}
