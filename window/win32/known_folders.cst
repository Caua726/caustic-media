// window/win32/known_folders.cst — the user's folders as Windows names them.
//
// Windows keeps a user's profile, desktop, documents and downloads where its
// known folders say — moved by the user, redirected to a server, named in the
// user's language — and its programs' state under the local application
// data. SHGetKnownFolderPath says each, in UTF-16 with '\' between its parts;
// here it comes back as UTF-8 with '/', the toolkit's path everywhere
// (sys/file.cst): "C:/Users/me/Documents". Linux's own are
// window/linux/user_dirs.cst.
use "bind/types.cst" as t;
use "bind/guids.cst" as guids;
use "bind/kernel32.cst" as k;
use "bind/shell32.cst" as shell;
use "bind/ole32.cst" as ole;

let is i32 as PROFILE    with imut = 0;
let is i32 as DESKTOP    with imut = 1;
let is i32 as DOCUMENTS  with imut = 2;
let is i32 as DOWNLOADS  with imut = 3;
let is i32 as MUSIC      with imut = 4;
let is i32 as PICTURES   with imut = 5;
let is i32 as VIDEOS     with imut = 6;
let is i32 as LOCAL_DATA with imut = 7;   // %LOCALAPPDATA%: a program's state on this computer
let is i32 as ROAMING_DATA with imut = 8; // %APPDATA%: its settings, which follow the user

fn _id(which as i32) as t.GUID {
    if (which == DESKTOP) { return guids.FOLDERID_Desktop(); }
    if (which == DOCUMENTS) { return guids.FOLDERID_Documents(); }
    if (which == DOWNLOADS) { return guids.FOLDERID_Downloads(); }
    if (which == MUSIC) { return guids.FOLDERID_Music(); }
    if (which == PICTURES) { return guids.FOLDERID_Pictures(); }
    if (which == VIDEOS) { return guids.FOLDERID_Videos(); }
    if (which == LOCAL_DATA) { return guids.FOLDERID_LocalAppData(); }
    if (which == ROAMING_DATA) { return guids.FOLDERID_RoamingAppData(); }
    return guids.FOLDERID_Profile();
}

// The folder which — PROFILE … ROAMING_DATA — into out, cap bytes with its
// NUL: its length, or 0 when Windows has none or it does not fit. Only what
// is there: a folder not made yet is not made here.
fn path(which as i32, out as *u8, cap as i64) as i64 {
    let is t.GUID as id = _id(which);
    let is *u16 as wide with mut = cast(*u16, 0);
    let is i32 as hr = shell.SHGetKnownFolderPath(&id, cast(u32, t.KF_FLAG_DEFAULT), 0, &wide);
    // The text is the caller's to free, failure or not.
    if (hr != 0 || cast(i64, wide) == 0) {
        if (cast(i64, wide) != 0) { ole.CoTaskMemFree(cast(*u8, wide)); }
        return 0;
    }
    let is i32 as n = k.WideCharToMultiByte(cast(u32, t.CP_UTF8), 0, wide, cast(i32, 0 - 1), cast(*i8, out), cast(i32, cap),
                                            cast(*i8, 0), cast(*i32, 0));
    ole.CoTaskMemFree(cast(*u8, wide));
    if (n <= 1) { return 0; }
    let is i64 as len = cast(i64, n) - 1;
    let is i64 as i with mut = 0;
    while (i < len) {
        if (out[i] == cast(u8, 92)) { out[i] = cast(u8, 47); }
        i = i + 1;
    }
    return len;
}

// The top of the drive the profile is on — "C:/" — into out, cap bytes
// with its NUL: 3, or 0 when the profile is not on a lettered drive.
fn system_drive(out as *u8, cap as i64) as i64 {
    let is [1024]u8 as p;
    let is i64 as n = path(PROFILE, cast(*u8, &p), 1024);
    if (n < 3 || cap < 4 || p[1] != cast(u8, 58) || p[2] != cast(u8, 47)) { return 0; }
    out[0] = p[0];
    out[1] = cast(u8, 58);
    out[2] = cast(u8, 47);
    out[3] = cast(u8, 0);
    return 3;
}
