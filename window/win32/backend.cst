}
fn _vk(key as i32) as i32 {
    if (key >= keys.A && key <= keys.Z) { return 65 + key - keys.A; }
    if (key >= keys.NUM_0 && key <= keys.NUM_9) { return 48 + key - keys.NUM_0; }
    if (key >= keys.F1 && key <= keys.F12) { return cast(i32, t.VK_F1) + key - keys.F1; }
    let is i64 as v with mut = 0;
    if (key == keys.SPACE) { v = t.VK_SPACE; }
    else if (key == keys.BACKSPACE) { v = t.VK_BACK; }
    else if (key == keys.TAB) { v = t.VK_TAB; }
    else if (key == keys.RETURN) { v = t.VK_RETURN; }
    else if (key == keys.ESCAPE) { v = t.VK_ESCAPE; }
    else if (key == keys.PAUSE) { v = t.VK_PAUSE; }
    else if (key == keys.LEFT) { v = t.VK_LEFT; }
    else if (key == keys.UP) { v = t.VK_UP; }
    else if (key == keys.RIGHT) { v = t.VK_RIGHT; }
    else if (key == keys.DOWN) { v = t.VK_DOWN; }
    else if (key == keys.HOME) { v = t.VK_HOME; }
    else if (key == keys.END) { v = t.VK_END; }
    else if (key == keys.PAGE_UP) { v = t.VK_PRIOR; }
    else if (key == keys.PAGE_DOWN) { v = t.VK_NEXT; }
    else if (key == keys.INSERT) { v = t.VK_INSERT; }
    else if (key == keys.DELETE) { v = t.VK_DELETE; }
    else if (key == keys.SHIFT_L) { v = t.VK_LSHIFT; }
    else if (key == keys.SHIFT_R) { v = t.VK_RSHIFT; }
    else if (key == keys.CONTROL_L) { v = t.VK_LCONTROL; }
    else if (key == keys.CONTROL_R) { v = t.VK_RCONTROL; }
    else if (key == keys.ALT_L) { v = t.VK_LMENU; }
    else if (key == keys.ALT_R) { v = t.VK_RMENU; }
    else if (key == keys.SUPER_L) { v = t.VK_LWIN; }
    else if (key == keys.SUPER_R) { v = t.VK_RWIN; }
    else if (key == keys.SEMICOLON) { v = t.VK_OEM_1; }
    else if (key == keys.EQUAL) { v = t.VK_OEM_PLUS; }
    else if (key == keys.COMMA) { v = t.VK_OEM_COMMA; }
    else if (key == keys.MINUS) { v = t.VK_OEM_MINUS; }
    else if (key == keys.PERIOD) { v = t.VK_OEM_PERIOD; }
    else if (key == keys.SLASH) { v = t.VK_OEM_2; }
    else if (key == keys.GRAVE) { v = t.VK_OEM_3; }
    else if (key == keys.LEFT_BRACKET) { v = t.VK_OEM_4; }
    else if (key == keys.BACKSLASH) { v = t.VK_OEM_5; }
    else if (key == keys.RIGHT_BRACKET) { v = t.VK_OEM_6; }
    else if (key == keys.APOSTROPHE) { v = t.VK_OEM_7; }
    return cast(i32, v);
}

fn key_down(w as *Window, key as i32) as i32 {
    let is *Native as n = _native(w); let is i32 as vk = _vk(key);
    if (cast(i64, n) == 0 || vk <= 0 || vk >= 256) { return 0; }
    return cast(i32, n.key_down[vk] != 0);
}
fn button_down(w as *Window, button as i32) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0 || button < 1 || button > 3) { return 0; } return (n.buttons >> (button - 1)) & 1; }
fn mouse_x(w as *Window) as i64 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.mouse_x; }
fn mouse_y(w as *Window) as i64 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.mouse_y; }
fn mouse_dx(w as *Window) as i64 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.mouse_dx; }
fn mouse_dy(w as *Window) as i64 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.mouse_dy; }
fn wheel(w as *Window) as i64 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.wheel_y; }

fn text_input_enable(w as *Window, on as i32) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } n.text_enabled = cast(i32, on != 0); return 1; }
fn text_input_active(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return cast(i32, n.text_enabled == 1 && n.focused == 1); }
fn text_input_rect(w as *Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    n.caret_x = x; n.caret_y = y; n.caret_w = width; n.caret_h = height;
    if (n.focused == 1) { _position_ime(n); } return 1;
}

fn set_modal(w as *Window, on as i32) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0 || n.owner == 0) { return 0; }
    n.modal = cast(i32, on != 0); if (u.IsWindow(n.owner) == 1) { u.EnableWindow(n.owner, cast(i32, n.modal == 0)); } return 1;
}
fn activate(w as *Window) as void { if (is_open(w) == 1) { u.SetForegroundWindow(w.hwnd); u.SetFocus(w.hwnd); } }
fn set_decorated(w as *Window, on as i32) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    let is i64 as style = u.GetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE));
    let is i64 as next with mut = style;
    if (on == 0) { next = next & (0 - 12582913); }
    else { next = next | t.WS_CAPTION | t.WS_SYSMENU; }
    u.SetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE), next);
    u.SetWindowPos(w.hwnd, 0, 0, 0, 0, 0, cast(u32, t.SWP_NOMOVE | t.SWP_NOSIZE | t.SWP_NOZORDER | t.SWP_FRAMECHANGED));
    n.decorated = cast(i32, on != 0); return 1;
}
fn decorated(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.decorated; }
fn set_maximized(w as *Window, on as i32) as i32 { if (is_open(w) == 0) { return 0; } if (on != 0) { u.ShowWindow(w.hwnd, cast(i32, t.SW_MAXIMIZE)); } else { u.ShowWindow(w.hwnd, cast(i32, t.SW_RESTORE)); } return 1; }
fn set_fullscreen(w as *Window, on as i32) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0) { return 0; }
    let is i32 as full = cast(i32, (n.state & event.STATE_FULLSCREEN) != 0);
    if (full == cast(i32, on != 0)) { return 1; }
    if (on != 0) {
        let is t.MONITORINFO as monitor;
        mem.memzero(cast(*u8, &monitor), sizeof(t.MONITORINFO));
        monitor.cbSize = cast(u32, sizeof(t.MONITORINFO));
        if (u.GetMonitorInfoW(u.MonitorFromWindow(w.hwnd, cast(u32, t.MONITOR_DEFAULTTONEAREST)), &monitor) == 0 ||
            u.GetWindowRect(w.hwnd, &n.restore_rect) == 0) { return 0; }
        n.restore_style = u.GetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE));
        u.SetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE), n.restore_style & (0 - 13565953));
        u.SetWindowPos(w.hwnd, 0, monitor.rcMonitor.left, monitor.rcMonitor.top,
                       monitor.rcMonitor.right - monitor.rcMonitor.left,
                       monitor.rcMonitor.bottom - monitor.rcMonitor.top,
                       cast(u32, t.SWP_NOZORDER | t.SWP_FRAMECHANGED));
        n.state = n.state | event.STATE_FULLSCREEN;
    } else {
        u.SetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE), n.restore_style);
        u.SetWindowPos(w.hwnd, 0, n.restore_rect.left, n.restore_rect.top,
                       n.restore_rect.right - n.restore_rect.left, n.restore_rect.bottom - n.restore_rect.top,
                       cast(u32, t.SWP_NOZORDER | t.SWP_FRAMECHANGED));
        n.state = n.state & cast(i32, 0 - 3);
    }
    _emit(n, event.STATE, 0, 0, 0, n.state);
    return 1;
}
fn minimize(w as *Window) as i32 { if (is_open(w) == 0) { return 0; } u.ShowWindow(w.hwnd, cast(i32, t.SW_MINIMIZE)); return 1; }
fn composited(w as *Window) as i32 {
    let is i32 as enabled with mut = 0;
