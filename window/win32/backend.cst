// window/win32/backend.cst — HWND, messages, and the software presentation surface.
use "std/mem.cst" as mem;
use "../../gpu/software/target.cst" as tgt;
use "../event.cst" as event;
use "../../input/event.cst" as ie;
use "../../input/keys.cst" as keys;
use "bind/types.cst" as t;
use "bind/user32.cst" as u;
use "bind/gdi32.cst" as g;
use "bind/kernel32.cst" as k;
use "bind/imm32.cst" as ime;
use "../../input/text.cst" as content;
use "abi.cst" as abi;
use "clipboard.cst" as clipboard;
use "bind/dwmapi.cst" as dwm;
use "bind/shell32.cst" as shell;
use "bind/shcore.cst" as sh;
use "settings.cst" as desktop_settings;
use "../monitor.cst" as monitor;

let is i32 as OK with imut = 0;
let is i32 as NO_WINDOW with imut = 1;
let is i32 as NO_MEMORY with imut = 2;
let is i32 as NO_SURFACE with imut = 3;
let is i32 as BAD_ARGUMENT with imut = 4;
let is i64 as MAX_WINDOWS with imut = 32;
let is i64 as MAX_EVENTS with imut = 128;

// Asks the window's own thread to show the system menu: TrackPopupMenu runs
// its modal loop from the window procedure, not from the caller.
let is i64 as _WM_WINDOW_MENU with imut = t.WM_APP + 256;

struct DIBInfo {
    header as t.BITMAPINFOHEADER;
    masks as [3]u32;
}


struct Native {
    hwnd as i64;
    owner as i64;
    used as i32;
    alive as i32;
    asked as i32;
    fixed as i32;
    modal as i32;
    decorated as i32;
    popup as i32;           // a popup's kind (device.POPUP_*), 0 for a window
    popup_done as i32;      // taken down by a press outside the program's popups
    dpi as i32;
    width as i64;
    height as i64;
    min_width as i64;
    min_height as i64;
    max_width as i64;
    max_height as i64;
    restore_rect as t.RECT;
    restore_style as i64;
    resized as i32;
    state as i32;
    focused as i32;
    // The pointer as the translator last said it, and the buttons it holds:
    // where a LEAVE is, and whether the capture is still wanted.
    mouse_x as i64;
    mouse_y as i64;
    buttons as i32;
    // Wheel motion short of a notch, kept for the next message.
    wheel_remainder as i32;
    wheel_x_remainder as i32;
    entered as i32;
    text_enabled as i32;
    composition_on as i32;
    caret_x as i64;
    caret_y as i64;
    caret_w as i64;
    caret_h as i64;
    // Whether the window has an input context — the method gets its keys —
    // and what the field with the keyboard said of itself: its purpose, its
    // text around the caret in UTF-8 (-1: none said), the caret in it.
    ime_on as i32;
    ime_purpose as i32;
    ime_text_len as i64;
    ime_caret as i64;
    ime_text as [4000]u8;
    high_surrogate as u16;
    after_key as i32;       // a key went down, and nothing let it go since: a WM_CHAR now is its
    cursor as i64;
    icon as i64;            // given to the window for both icon sizes
    extent_left as i64;
    extent_right as i64;
    extent_top as i64;
    extent_bottom as i64;
    region_on as i32;
    region_x as i64;
    region_y as i64;
    region_w as i64;
    region_h as i64;
    hdc as i64;
    bitmap as i64;
    pixels as *u8;
    dib as DIBInfo;
    // Seen through where its alpha says (WS_EX_LAYERED): each frame given to
    // the system with UpdateLayeredWindow from a second DIB, the frame's
    // premultiplied RGBA as the BGRA the system blends.
    layered as i32;
    layer_dc as i64;
    layer_bitmap as i64;
    layer_pixels as *u8;
    layer_width as i64;
    layer_height as i64;
    clip as clipboard.State;
    // Cooked input, as this file's translator says it (input/event.cst).
    input as *ie.Queue;
    // The window's own events: resized, closed, its state.
    event_head as i64;
    event_len as i64;
    events as [128]event.Event;
}

struct Config {
    title as *u8;
    width as i64;
    height as i64;
    resizable as i32;
    owner as i64;
    dialog as i32;
    modal as i32;
    decorated as i32;
    // The application's identity for the taskbar (AppUserModelID), UTF-8;
    // null for none. Windows keeps it per process.
    app_id as *u8;
    // A popup (1 menu, 2 list, 3 tooltip), 0 for a window: WS_POPUP, a tool
    // window never activated, its client at x, y of the screen, owned by
    // owner. grab 1 captures the pointer and takes the owner's keys while it
    // is up; a press outside the program's popups then takes it down.
    popup as i32;
    grab as i32;
    x as i64;
    y as i64;
    // Seen through where its pixels' alpha is below 255 — the shadow round a
    // frame of the program's own: an undecorated window or a popup only.
    transparent as i32;
}

struct Window {
    hwnd as i64;
    slot as i32;
    ok as i32;
    err as i32;
    dpi as i32;
}

let is [32]Native as _windows with mut;

// The popups holding the capture, innermost last, as slots of _windows: a
// submenu's capture replaces its menu's, which gets it back when the submenu
// goes.
let is [16]i32 as _grab_slot with mut;
let is i64 as _ngrab with mut = 0;
let is abi.Callbacks as _callbacks with mut;
let is i32 as _class_ready with mut = 0;
let is i32 as _dpi_ready with mut = 0;
let is i64 as _instance with mut = 0;
let is [32]u16 as _class_name with mut;

fn _mods() as i32 {
    let is i32 as m with mut = 0;
    if ((cast(i32, u.GetKeyState(cast(i32, t.VK_SHIFT))) & 32768) != 0) { m = m | keys.MOD_SHIFT; }
    if ((cast(i32, u.GetKeyState(cast(i32, t.VK_CONTROL))) & 32768) != 0) { m = m | keys.MOD_CONTROL; }
    if ((cast(i32, u.GetKeyState(cast(i32, t.VK_MENU))) & 32768) != 0) { m = m | keys.MOD_ALT; }
    if ((cast(i32, u.GetKeyState(cast(i32, t.VK_CAPITAL))) & 1) != 0) { m = m | keys.MOD_LOCK; }
    if ((cast(i32, u.GetKeyState(cast(i32, t.VK_LWIN))) & 32768) != 0 ||
        (cast(i32, u.GetKeyState(cast(i32, t.VK_RWIN))) & 32768) != 0) {
        m = m | keys.MOD_SUPER;
    }
    return m;
}

// Letters and digits are their ASCII codes; the SDK names no VK_ for them.
fn _key(vk as u32) as i32 {
    let is i64 as v = cast(i64, vk);
    if (v >= 65 && v <= 90) { return keys.A + cast(i32, v) - 65; }
    if (v >= 48 && v <= 57) { return keys.NUM_0 + cast(i32, v) - 48; }
    if (v >= t.VK_F1 && v <= t.VK_F12) { return keys.F1 + cast(i32, v - t.VK_F1); }
    if (v == t.VK_SPACE) { return keys.SPACE; }
    if (v == t.VK_BACK) { return keys.BACKSPACE; }
    if (v == t.VK_TAB) { return keys.TAB; }
    if (v == t.VK_RETURN) { return keys.RETURN; }
    if (v == t.VK_PAUSE) { return keys.PAUSE; }
    if (v == t.VK_ESCAPE) { return keys.ESCAPE; }
    if (v == t.VK_PRIOR) { return keys.PAGE_UP; }
    if (v == t.VK_NEXT) { return keys.PAGE_DOWN; }
    if (v == t.VK_END) { return keys.END; }
    if (v == t.VK_HOME) { return keys.HOME; }
    if (v == t.VK_LEFT) { return keys.LEFT; }
    if (v == t.VK_UP) { return keys.UP; }
    if (v == t.VK_RIGHT) { return keys.RIGHT; }
    if (v == t.VK_DOWN) { return keys.DOWN; }
    if (v == t.VK_INSERT) { return keys.INSERT; }
    if (v == t.VK_DELETE) { return keys.DELETE; }
    if (v == t.VK_NUMLOCK) { return keys.NUM_LOCK; }
    if (v == t.VK_LSHIFT) { return keys.SHIFT_L; }
    if (v == t.VK_RSHIFT) { return keys.SHIFT_R; }
    if (v == t.VK_LCONTROL) { return keys.CONTROL_L; }
    if (v == t.VK_RCONTROL) { return keys.CONTROL_R; }
    if (v == t.VK_LMENU) { return keys.ALT_L; }
    if (v == t.VK_RMENU) { return keys.ALT_R; }
    if (v == t.VK_LWIN) { return keys.SUPER_L; }
    if (v == t.VK_RWIN) { return keys.SUPER_R; }
    if (v == t.VK_CAPITAL) { return keys.CAPS_LOCK; }
    if (v == t.VK_OEM_1) { return keys.SEMICOLON; }
    if (v == t.VK_OEM_PLUS) { return keys.EQUAL; }
    if (v == t.VK_OEM_COMMA) { return keys.COMMA; }
    if (v == t.VK_OEM_MINUS) { return keys.MINUS; }
    if (v == t.VK_OEM_PERIOD) { return keys.PERIOD; }
    if (v == t.VK_OEM_2) { return keys.SLASH; }
    if (v == t.VK_OEM_3) { return keys.GRAVE; }
    if (v == t.VK_OEM_4) { return keys.LEFT_BRACKET; }
    if (v == t.VK_OEM_5) { return keys.BACKSLASH; }
    if (v == t.VK_OEM_6) { return keys.RIGHT_BRACKET; }
    if (v == t.VK_OEM_7) { return keys.APOSTROPHE; }
    return keys.UNKNOWN;
}

fn _signed16(v as u64) as i64 {
    let is i64 as n with mut = cast(i64, v & 65535);
    if (n >= 32768) { n = n - 65536; }
    return n;
}

// A window event at the end of its queue, the oldest let go when it is full.
fn _enqueue(n as *Native, e as *event.Event) as void {
    if (n.event_len == MAX_EVENTS) {
        n.event_head = (n.event_head + 1) % MAX_EVENTS;
        n.event_len = n.event_len - 1;
    }
    n.events[(n.event_head + n.event_len) % MAX_EVENTS] = *e;
    n.event_len = n.event_len + 1;
}

fn _emit(n as *Native, kind as i32, raw as i32, x as i64, y as i64, value as i64) as void {
    let is event.Event as e;
    event.clear(&e);
    e.kind = kind;
    e.raw_kind = raw;
    e.x = x;
    e.y = y;
    if (kind == event.RESIZE) { e.width = n.width; e.height = n.height; }
    if (kind == event.STATE) { e.state = cast(i32, value); }
    _enqueue(n, &e);
}

// --- The translator: messages as cooked input ---

fn _input(kind as i32) as ie.Event {
    let is ie.Event as e;
    ie.clear(&e);
    e.kind = kind;
    e.modifiers = _mods();
    e.time_ms = cast(i64, u.GetMessageTime()) & 4294967295;
    return e;
}

fn _push(n as *Native, e as *ie.Event, text as *u8, len as i64) as void {
    if (cast(i64, n.input) != 0) { ie.push(n.input, e, text, len); }
}

// A key down or up: vk the virtual key (sides told apart), lp the message's.
fn _key_event(n as *Native, kind as i32, vk as i64, lp as i64) as void {
    let is ie.Event as e = _input(kind);
    e.key = _key(cast(u32, vk));
    e.shortcut = e.key;
    // The scan code, bit 7 the extended flag: the key's place.
    e.physical = cast(i32, ((lp >> 16) & 255) | (((lp >> 24) & 1) << 7));
    if (e.physical == 0) { e.physical = cast(i32, vk); }
    // Bit 30: down before this message — the system's repeat.
    if (kind == ie.KEY_DOWN) { e.repeat = cast(i32, ((lp >> 30) & 1) != 0); }
    _push(n, &e, cast(*u8, 0), 0);
}

// A pointer event at x, y of the client.
fn _pointer(n as *Native, kind as i32, x as i64, y as i64, button as i32) as void {
    let is ie.Event as e = _input(kind);
    e.x = x;
    e.y = y;
    e.button = button;
    _push(n, &e, cast(*u8, 0), 0);
}

// What was typed: one code point, as UTF-8 — the key's when one just went
// down (TranslateMessage posts its WM_CHAR before the next key's message),
// another program's or an input method's otherwise.
fn _typed(n as *Native, code as i64) as void {
    if (code <= 0) { return; }
    let is [4]u8 as b;
    let is i64 as count with mut = 0;
    if (code <= 127) { b[0] = cast(u8, code); count = 1; }
    else if (code <= 2047) {
        b[0] = cast(u8, 192 | (code >> 6));
        b[1] = cast(u8, 128 | (code & 63));
        count = 2;
    } else if (code <= 65535) {
        b[0] = cast(u8, 224 | (code >> 12));
        b[1] = cast(u8, 128 | ((code >> 6) & 63));
        b[2] = cast(u8, 128 | (code & 63));
        count = 3;
    } else {
        b[0] = cast(u8, 240 | (code >> 18));
        b[1] = cast(u8, 128 | ((code >> 12) & 63));
        b[2] = cast(u8, 128 | ((code >> 6) & 63));
        b[3] = cast(u8, 128 | (code & 63));
        count = 4;
    }
    let is ie.Event as e = _input(ie.TEXT);
    e.from_key = n.after_key;
    _push(n, &e, &b[0], count);
}

// The composition said gone, once, if one was said.
fn _empty_preedit(n as *Native) as void {
    if (n.composition_on == 0) { return; }
    n.composition_on = 0;
    let is ie.Event as e = _input(ie.PREEDIT);
    _push(n, &e, cast(*u8, 0), 0);
}


fn _dib(n as *Native, width as i64, height as i64) as i32 {
    if (width == n.width && height == n.height && cast(i64, n.pixels) != 0) { return 1; }
    if (width < 0 || height < 0 || width > 16384 || height > 16384 || width * height > 67108864) { return 0; }
    if (n.hdc != 0) { g.DeleteDC(n.hdc); n.hdc = 0; }
    if (n.bitmap != 0) { g.DeleteObject(n.bitmap); n.bitmap = 0; }
    n.pixels = cast(*u8, 0);
    n.width = width;
    n.height = height;
    if (width == 0 || height == 0) { return 1; }
    mem.memset(cast(*u8, &n.dib), 0, sizeof(DIBInfo));
    n.dib.header.biSize = cast(u32, sizeof(t.BITMAPINFOHEADER));
    n.dib.header.biWidth = cast(i32, width);
    n.dib.header.biHeight = cast(i32, 0 - height);
    n.dib.header.biPlanes = cast(u16, 1);
    n.dib.header.biBitCount = cast(u16, 32);
    n.dib.header.biCompression = cast(u32, t.BI_BITFIELDS);
    n.dib.header.biSizeImage = cast(u32, width * height * 4);
    n.dib.masks[0] = cast(u32, 255);
    n.dib.masks[1] = cast(u32, 65280);
    n.dib.masks[2] = cast(u32, 16711680);
    n.bitmap = g.CreateDIBSection(0, cast(*t.BITMAPINFO, &n.dib), cast(u32, t.DIB_RGB_COLORS), &n.pixels, 0, 0);
    if (n.bitmap == 0 || cast(i64, n.pixels) == 0) {
        if (n.bitmap != 0) { g.DeleteObject(n.bitmap); }
        n.bitmap = 0; n.pixels = cast(*u8, 0); return 0;
    }
    n.hdc = g.CreateCompatibleDC(0);
    if (n.hdc == 0) { g.DeleteObject(n.bitmap); n.bitmap = 0; n.pixels = cast(*u8, 0); return 0; }
    g.SelectObject(n.hdc, n.bitmap);
    mem.memset(n.pixels, 0, width * height * 4);
    return 1;
}

fn _paint(n as *Native) as void {
    let is t.PAINTSTRUCT as ps;
    let is i64 as dc = u.BeginPaint(n.hwnd, &ps);
    if (dc != 0 && n.hdc != 0 && n.width > 0 && n.height > 0) {
        g.BitBlt(dc, 0, 0, cast(i32, n.width), cast(i32, n.height), n.hdc, 0, 0, cast(u32, t.SRCCOPY));
    }
    u.EndPaint(n.hwnd, &ps);
}

fn _drop_layer(n as *Native) as void {
    if (n.layer_dc != 0) { g.DeleteDC(n.layer_dc); n.layer_dc = 0; }
    if (n.layer_bitmap != 0) { g.DeleteObject(n.layer_bitmap); n.layer_bitmap = 0; }
    n.layer_pixels = cast(*u8, 0);
    n.layer_width = 0;
    n.layer_height = 0;
}

// The frame given to the system to blend over what is behind the window: its
// premultiplied RGBA as the premultiplied BGRA UpdateLayeredWindow takes, the
// whole window (a layered window here has no frame of the system's round it).
// 1 when given.
fn _present_layer(n as *Native) as i32 {
    if (n.width <= 0 || n.height <= 0 || cast(i64, n.pixels) == 0) { return 0; }
    if (n.layer_width != n.width || n.layer_height != n.height || cast(i64, n.layer_pixels) == 0) {
        _drop_layer(n);
        let is t.BITMAPINFO as bmi;
        mem.memzero(cast(*u8, &bmi), sizeof(t.BITMAPINFO));
        bmi.bmiHeader.biSize = cast(u32, sizeof(t.BITMAPINFOHEADER));
        bmi.bmiHeader.biWidth = cast(i32, n.width);
        bmi.bmiHeader.biHeight = cast(i32, 0 - n.height);
        bmi.bmiHeader.biPlanes = cast(u16, 1);
        bmi.bmiHeader.biBitCount = cast(u16, 32);
        bmi.bmiHeader.biCompression = cast(u32, t.BI_RGB);
        n.layer_bitmap = g.CreateDIBSection(0, &bmi, cast(u32, t.DIB_RGB_COLORS), &n.layer_pixels, 0, 0);
        if (n.layer_bitmap == 0 || cast(i64, n.layer_pixels) == 0) { _drop_layer(n); return 0; }
        n.layer_dc = g.CreateCompatibleDC(0);
        if (n.layer_dc == 0) { _drop_layer(n); return 0; }
        g.SelectObject(n.layer_dc, n.layer_bitmap);
        n.layer_width = n.width;
        n.layer_height = n.height;
    }
    let is *u32 as from = cast(*u32, n.pixels);
    let is *u32 as to = cast(*u32, n.layer_pixels);
    let is i64 as count = n.width * n.height;
    let is i64 as i with mut = 0;
    while (i < count) {
        let is u32 as v = from[i];
        // Alpha and green stay; red and blue change places.
        to[i] = (v & cast(u32, 4278255360)) | ((v & cast(u32, 255)) << 16) | ((v >> 16) & cast(u32, 255));
        i = i + 1;
    }
    let is [2]i32 as size;
    size[0] = cast(i32, n.width);
    size[1] = cast(i32, n.height);
    let is t.POINT as origin;
    origin.x = 0;
    origin.y = 0;
    let is t.BLENDFUNCTION as blend;
    blend.BlendOp = cast(u8, t.AC_SRC_OVER);
    blend.BlendFlags = cast(u8, 0);
    blend.SourceConstantAlpha = cast(u8, 255);
    blend.AlphaFormat = cast(u8, t.AC_SRC_ALPHA);
    return cast(i32, u.UpdateLayeredWindow(n.hwnd, 0, cast(*t.POINT, 0), cast(*u8, &size), n.layer_dc, &origin,
                                           cast(u32, 0), &blend, cast(u32, t.ULW_ALPHA)) != 0);
}

// What a press at hx, hy of the client resizes, as WM_NCHITTEST answers it,
// for a frame of the program's own: between the window as the desktop counts
// it (inside the frame extents) and the edge of the input region — its edges'
// reach beyond it. A corner takes twice that reach along each side, as the
// toolkit's frame does. 0 elsewhere, and for a window the system frames, a
// popup, one of fixed size, or one maximized or full screen.
fn _edge(n as *Native, hx as i64, hy as i64) as i64 {
    if (n.decorated != 0 || n.popup != 0 || n.fixed == 1 ||
        (n.state & (event.STATE_MAXIMIZED | event.STATE_FULLSCREEN)) != 0) { return 0; }
    let is i64 as left = n.extent_left;
    let is i64 as right = n.width - n.extent_right;
    let is i64 as top = n.extent_top;
    let is i64 as bottom = n.height - n.extent_bottom;
    if (hx >= left && hx < right && hy >= top && hy < bottom) { return 0; }
    let is i32 as west with mut = cast(i32, hx < left);
    let is i32 as east with mut = cast(i32, hx >= right);
    let is i32 as north with mut = cast(i32, hy < top);
    let is i32 as south with mut = cast(i32, hy >= bottom);
    if (west == 1 || east == 1) {
        if (hy < top + 2 * (top - n.region_y)) { north = 1; }
        if (hy >= bottom - 2 * (n.region_y + n.region_h - bottom)) { south = 1; }
    }
    if (north == 1 || south == 1) {
        if (hx < left + 2 * (left - n.region_x)) { west = 1; }
        if (hx >= right - 2 * (n.region_x + n.region_w - right)) { east = 1; }
    }
    if (north == 1 && west == 1) { return t.HTTOPLEFT; }
    if (north == 1 && east == 1) { return t.HTTOPRIGHT; }
    if (south == 1 && west == 1) { return t.HTBOTTOMLEFT; }
    if (south == 1 && east == 1) { return t.HTBOTTOMRIGHT; }
    if (north == 1) { return t.HTTOP; }
    if (south == 1) { return t.HTBOTTOM; }
    if (west == 1) { return t.HTLEFT; }
    return t.HTRIGHT;
}

// Bytes of UTF-8 the first count UTF-16 units of wide make.
fn _utf8_of(wide as *u16, count as i64) as i64 {
    if (count <= 0) { return 0; }
    return cast(i64, k.WideCharToMultiByte(cast(u32, t.CP_UTF8), 0, wide, cast(i32, count),
                                           cast(*i8, 0), 0, cast(*i8, 0), cast(*i32, 0)));
}

// The part of the composition being converted — the target clause, its
// units ATTR_TARGET_* in attr, one attribute a UTF-16 unit of wide — as
// UTF-8 offsets into e, whole characters; none when no unit is.
fn _target_bytes(attr as *u8, wide as *u16, units as i64, e as *ie.Event) as void {
    let is i64 as first with mut = 0 - 1;
    let is i64 as last with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < units) {
        let is i64 as a = cast(i64, attr[i]);
        if (a == t.ATTR_TARGET_CONVERTED || a == t.ATTR_TARGET_NOTCONVERTED) {
            if (first < 0) { first = i; }
            last = i + 1;
        }
        i = i + 1;
    }
    if (first < 0) { return; }
    if (first > 0 && wide[first] >= 56320 && wide[first] <= 57343) { first = first - 1; }
    if (last < units && wide[last] >= 56320 && wide[last] <= 57343) { last = last + 1; }
    e.hl_start = _utf8_of(wide, first);
    e.hl_end = _utf8_of(wide, last);
}

// GCS_COMPATTR read for the composition in wide (units long): its target
// clause into e (_target_bytes).
fn _ime_target(h as i64, wide as *u16, units as i64, e as *ie.Event) as void {
    let is i32 as count = ime.ImmGetCompositionStringW(h, cast(u32, t.GCS_COMPATTR), cast(*u8, 0), 0);
    if (count <= 0 || cast(i64, count) != units) { return; }
    let is [512]u8 as short_attr;
    let is *u8 as attr with mut = &short_attr[0];
    if (count > 512) {
        attr = mem.core.mmap_anon(cast(i64, count));
        if (cast(i64, attr) == 0) { return; }
    }
    if (ime.ImmGetCompositionStringW(h, cast(u32, t.GCS_COMPATTR), attr, cast(u32, count)) == count) {
        _target_bytes(attr, wide, units, e);
    }
    if (count > 512) { mem.core.munmap(attr, cast(i64, count)); }
}

// The composition string index says (GCS_RESULTSTR, GCS_COMPSTR) as kind
// (TEXT, PREEDIT), UTF-8: a preedit with its caret and the part being
// converted, said empty only when one was said before.
fn _ime_text(n as *Native, h as i64, index as i32, kind as i32) as void {
    let is i32 as bytes = ime.ImmGetCompositionStringW(h, cast(u32, index), cast(*u8, 0), 0);
    if (bytes < 0 || (bytes % 2) != 0) { return; }
    let is [256]u16 as short_wide;
    let is *u8 as storage with mut = cast(*u8, &short_wide[0]);
    if (bytes > 512) {
        storage = mem.core.mmap_anon(bytes);
        if (cast(i64, storage) == 0) { return; }
    }
    if (bytes > 0 && ime.ImmGetCompositionStringW(h, cast(u32, index), storage, cast(u32, bytes)) != bytes) {
        if (bytes > 512) { mem.core.munmap(storage, bytes); }
        return;
    }
    let is *u16 as wide = cast(*u16, storage);
    let is i64 as units = cast(i64, bytes / 2);
    let is i64 as len = _utf8_of(wide, units);
    if (kind == ie.PREEDIT && len == 0) {
        _empty_preedit(n);
    } else if (len > 0) {
        let is ie.Event as e = _input(kind);
        if (kind == ie.PREEDIT) {
            let is i64 as pos with mut = cast(i64, ime.ImmGetCompositionStringW(h, cast(u32, t.GCS_CURSORPOS), cast(*u8, 0), 0));
            if (pos < 0) { pos = 0; }
            if (pos > units) { pos = units; }
            if (pos > 0 && pos < units && wide[pos] >= 56320 && wide[pos] <= 57343) { pos = pos - 1; }
            e.cursor = _utf8_of(wide, pos);
            _ime_target(h, wide, units, &e);
            n.composition_on = 1;
        }
        // Longer than one event's text: the queue refuses it, and says so.
        let is [4096]u8 as utf8;
        if (len <= ie.TEXT_MAX) {
            k.WideCharToMultiByte(cast(u32, t.CP_UTF8), 0, wide, cast(i32, units), cast(*i8, &utf8[0]), cast(i32, len),
                                  cast(*i8, 0), cast(*i32, 0));
        }
        _push(n, &e, &utf8[0], len);
    }
    if (bytes > 512) { mem.core.munmap(storage, bytes); }
}

fn _composition(n as *Native, flags as i64) as void {
    let is i64 as h = ime.ImmGetContext(n.hwnd);
    if (h == 0) { return; }
    if ((flags & t.GCS_RESULTSTR) != 0) {
        _ime_text(n, h, cast(i32, t.GCS_RESULTSTR), ie.TEXT);
        if ((flags & t.GCS_COMPSTR) == 0) { _empty_preedit(n); }
    }
    if ((flags & t.GCS_COMPSTR) != 0) { _ime_text(n, h, cast(i32, t.GCS_COMPSTR), ie.PREEDIT); }
    ime.ImmReleaseContext(n.hwnd, h);
}

// Where the caret is, told the method: the composition there (a method
// drawing its own starts at the caret's top left), the candidates below it
// and never over it (CFS_EXCLUDE: above when there is no room below).
fn _position_ime(n as *Native) as void {
    let is i64 as h = ime.ImmGetContext(n.hwnd);
    if (h == 0) { return; }
    let is t.COMPOSITIONFORM as cf;
    mem.memset(cast(*u8, &cf), 0, sizeof(t.COMPOSITIONFORM));
    cf.dwStyle = cast(u32, t.CFS_POINT);
    cf.ptCurrentPos.x = cast(i32, n.caret_x);
    cf.ptCurrentPos.y = cast(i32, n.caret_y);
    ime.ImmSetCompositionWindow(h, &cf);
    let is t.CANDIDATEFORM as candidate;
    mem.memset(cast(*u8, &candidate), 0, sizeof(t.CANDIDATEFORM));
    candidate.dwIndex = 0;
    candidate.dwStyle = cast(u32, t.CFS_EXCLUDE);
    candidate.ptCurrentPos.x = cast(i32, n.caret_x);
    candidate.ptCurrentPos.y = cast(i32, n.caret_y + n.caret_h);
    candidate.rcArea.left = cast(i32, n.caret_x);
    candidate.rcArea.top = cast(i32, n.caret_y);
    candidate.rcArea.right = cast(i32, n.caret_x + n.caret_w);
    candidate.rcArea.bottom = cast(i32, n.caret_y + n.caret_h);
    ime.ImmSetCandidateWindow(h, &candidate);
    ime.ImmReleaseContext(n.hwnd, h);
}

// The composition abandoned: the method told to drop it, and it said gone.
fn _ime_cancel(n as *Native) as void {
    let is i64 as h = ime.ImmGetContext(n.hwnd);
    if (h != 0) {
        ime.ImmNotifyIME(h, cast(u32, t.NI_COMPOSITIONSTR), cast(u32, t.CPS_CANCEL), 0);
        ime.ImmReleaseContext(n.hwnd, h);
    }
    _empty_preedit(n);
}

// The method gets the window's keys only while a field that keeps nothing
// secret has them: otherwise the window has no input context, and its keys
// type themselves (WM_CHAR), as in Windows' own password fields.
fn _ime_associate(n as *Native) as void {
    let is i32 as want = cast(i32, n.text_enabled == 1 && content.secret(n.ime_purpose) == 0);
    if (want == n.ime_on) { return; }
    if (want == 0) {
        _ime_cancel(n);
        ime.ImmAssociateContextEx(n.hwnd, 0, 0);
    } else {
        ime.ImmAssociateContextEx(n.hwnd, 0, cast(u32, t.IACE_DEFAULT));
    }
    n.ime_on = want;
    if (want == 1) { _position_ime(n); }
}

// IMR_DOCUMENTFEED: the field's text around the caret, the composition at
// the caret in it, for a method that predicts from what is written. The
// size wanted when asked with no buffer; 0 with nothing to say.
fn _document_feed(n as *Native, rs as *t.RECONVERTSTRING) as i64 {
    if (n.ime_on == 0 || n.ime_text_len < 0) { return 0; }
    let is *u8 as text = &n.ime_text[0];
    let is i64 as before with mut = 0;
    let is i64 as after with mut = 0;
    if (n.ime_caret > 0) {
        before = cast(i64, k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, text), cast(i32, n.ime_caret), cast(*u16, 0), 0));
    }
    if (n.ime_text_len > n.ime_caret) {
        after = cast(i64, k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, cast(i64, text) + n.ime_caret),
                                                cast(i32, n.ime_text_len - n.ime_caret), cast(*u16, 0), 0));
    }
    let is i64 as h = ime.ImmGetContext(n.hwnd);
    let is i64 as composing with mut = 0;
    if (h != 0 && n.composition_on == 1) {
        let is i32 as cb = ime.ImmGetCompositionStringW(h, cast(u32, t.GCS_COMPSTR), cast(*u8, 0), 0);
        if (cb > 0) { composing = cast(i64, cb / 2); }
    }
    let is i64 as head = cast(i64, sizeof(t.RECONVERTSTRING));
    let is i64 as units = before + composing + after;
    let is i64 as size = head + (units + 1) * 2;
    if (cast(i64, rs) == 0 || rs.dwSize < cast(u32, size)) {
        if (h != 0) { ime.ImmReleaseContext(n.hwnd, h); }
        if (cast(i64, rs) == 0) { return size; }
        return 0;
    }
    let is *u16 as s = cast(*u16, cast(i64, rs) + head);
    if (before > 0) {
        k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, text), cast(i32, n.ime_caret), s, cast(i32, before));
    }
    if (composing > 0) {
        ime.ImmGetCompositionStringW(h, cast(u32, t.GCS_COMPSTR), cast(*u8, cast(i64, s) + before * 2), cast(u32, composing * 2));
    }
    if (after > 0) {
        k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, cast(i64, text) + n.ime_caret),
                              cast(i32, n.ime_text_len - n.ime_caret), cast(*u16, cast(i64, s) + (before + composing) * 2),
                              cast(i32, after));
    }
    *cast(*u16, cast(i64, s) + units * 2) = cast(u16, 0);
    if (h != 0) { ime.ImmReleaseContext(n.hwnd, h); }
    rs.dwSize = cast(u32, size);
    rs.dwVersion = 0;
    rs.dwStrLen = cast(u32, units);
    rs.dwStrOffset = cast(u32, head);
    rs.dwCompStrLen = cast(u32, composing);
    rs.dwCompStrOffset = cast(u32, before * 2);
    rs.dwTargetStrLen = cast(u32, composing);
    rs.dwTargetStrOffset = cast(u32, before * 2);
    return size;
}

// IMR_QUERYCHARPOSITION: where the composition is on the screen — the
// caret's place, whichever of its characters is asked — and the window's
// client area as the document, for a method placing its own windows.
fn _char_position(n as *Native, cp as *t.IMECHARPOSITION) as i64 {
    if (n.ime_on == 0 || cast(i64, cp) == 0) { return 0; }
    let is t.POINT as at;
    at.x = cast(i32, n.caret_x);
    at.y = cast(i32, n.caret_y);
    u.ClientToScreen(n.hwnd, &at);
    cp.pt = at;
    cp.cLineHeight = cast(u32, n.caret_h);
    let is t.RECT as client;
    u.GetClientRect(n.hwnd, &client);
    let is t.POINT as corner;
    corner.x = 0;
    corner.y = 0;
    u.ClientToScreen(n.hwnd, &corner);
    cp.rcDocument.left = corner.x;
    cp.rcDocument.top = corner.y;
    cp.rcDocument.right = corner.x + client.right;
    cp.rcDocument.bottom = corner.y + client.bottom;
    return 1;
}

// The open window of hwnd, null for none of the program's.
fn _native_of(hwnd as i64) as *Native {
    if (hwnd == 0) { return cast(*Native, 0); }
    let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) {
        if (_windows[i].used == 1 && _windows[i].hwnd == hwnd) { return &_windows[i]; }
        i = i + 1;
    }
    return cast(*Native, 0);
}

fn _top_grab() as *Native {
    if (_ngrab == 0) { return cast(*Native, 0); }
    return &_windows[_grab_slot[_ngrab - 1]];
}

fn _grabbed(n as *Native) as i32 {
    let is i64 as i with mut = 0;
    while (i < _ngrab) {
        if (&_windows[_grab_slot[i]] == n) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Taken down: told once, as POPUP_DONE.
fn _dismiss(n as *Native) as void {
    if (n.popup_done == 1) { return; }
    n.popup_done = 1;
    _emit(n, event.POPUP_DONE, cast(i32, t.WM_CAPTURECHANGED), 0, 0, 0);
}

fn _grab_popup(n as *Native, slot as i64) as void {
    if (_ngrab >= 16) { return; }
    _grab_slot[_ngrab] = cast(i32, slot);
    _ngrab = _ngrab + 1;
    u.SetCapture(n.hwnd);
}

// Out of the stack; the capture given back to the popup under it when this
// one held it.
fn _ungrab(n as *Native) as void {
    let is i64 as i with mut = 0;
    while (i < _ngrab && &_windows[_grab_slot[i]] != n) { i = i + 1; }
    if (i == _ngrab) { return; }
    let is i32 as top = cast(i32, i == _ngrab - 1);
    while (i < _ngrab - 1) {
        _grab_slot[i] = _grab_slot[i + 1];
        i = i + 1;
    }
    _ngrab = _ngrab - 1;
    if (top == 0) { return; }
    if (_ngrab > 0) { u.SetCapture(_top_grab().hwnd); }
    else if (u.GetCapture() == n.hwnd) { u.ReleaseCapture(); }
}

fn _is_key(m as i64) as i32 {
    return cast(i32, m == t.WM_KEYDOWN || m == t.WM_KEYUP || m == t.WM_SYSKEYDOWN || m == t.WM_SYSKEYUP || m == t.WM_CHAR);
}

fn _is_press(m as i64) as i32 { return cast(i32, m == t.WM_LBUTTONDOWN || m == t.WM_MBUTTONDOWN || m == t.WM_RBUTTONDOWN); }

fn _is_pointer(m as i64) as i32 {
    return cast(i32, m == t.WM_MOUSEMOVE || _is_press(m) == 1 || m == t.WM_LBUTTONUP || m == t.WM_MBUTTONUP || m == t.WM_RBUTTONUP);
}

// While a popup holds the capture every pointer message comes to it, in its
// client's coordinates. One outside it is for the window of the program's
// beneath: another popup takes presses and motion, a window motion only, as
// an X server reports a grabbing client's own windows. A press over anything
// else takes the popup down and goes no further. -1: not decided here.
fn _grab_route(n as *Native, hwnd as i64, m as i64, wp as u64, lp as i64) as i64 {
    let is i64 as px = _signed16(cast(u64, lp));
    let is i64 as py = _signed16(cast(u64, lp) >> 16);
    if (px >= 0 && py >= 0 && px < n.width && py < n.height) { return 0 - 1; }
    let is t.POINT as sp; sp.x = cast(i32, px); sp.y = cast(i32, py);
    u.ClientToScreen(hwnd, &sp);
    let is *Native as under = _native_of(u.WindowFromPoint((cast(u64, sp.x) & 4294967295) | (cast(u64, sp.y) << 32)));
    if (cast(i64, under) != 0 && under != n && (under.popup != 0 || m == t.WM_MOUSEMOVE)) {
        u.ScreenToClient(under.hwnd, &sp);
        return u.SendMessageW(under.hwnd, cast(u32, m), wp, (cast(i64, sp.x) & 65535) | ((cast(i64, sp.y) & 65535) << 16));
    }
    if (m == t.WM_MOUSEMOVE) { return 0 - 1; }
    if (_is_press(m) == 1) { _dismiss(n); }
    return 0;
}

fn _window_proc(ctx as *u8, args as *u64) as i64 {
    let is i64 as hwnd = cast(i64, args[0]);
    let is u32 as msg = cast(u32, args[1]);
    let is u64 as wp = args[2];
    let is i64 as lp = cast(i64, args[3]);
    if (cast(i64, msg) == t.WM_NCCREATE) {
        let is *t.CREATESTRUCTW as cs = cast(*t.CREATESTRUCTW, lp);
        let is *Native as n = cast(*Native, cs.lpCreateParams);
        n.hwnd = hwnd; n.alive = 1;
        u.SetWindowLongPtrW(hwnd, cast(i32, t.GWLP_USERDATA), cast(i64, n));
        // The default procedure is what stores the creation title.
        return u.DefWindowProcW(hwnd, msg, wp, lp);
    }
    let is *Native as n = cast(*Native, u.GetWindowLongPtrW(hwnd, cast(i32, t.GWLP_USERDATA)));
    if (cast(i64, n) == 0) { return u.DefWindowProcW(hwnd, msg, wp, lp); }
    if (cast(i64, msg) == t.WM_NCHITTEST && n.region_on == 1) {
        let is t.POINT as hit;
        hit.x = cast(i32, _signed16(cast(u64, lp))); hit.y = cast(i32, _signed16(cast(u64, lp) >> 16));
        u.ScreenToClient(hwnd, &hit);
        let is i64 as hx = cast(i64, hit.x); let is i64 as hy = cast(i64, hit.y);
        if (hx < n.region_x || hy < n.region_y || hx >= n.region_x + n.region_w || hy >= n.region_y + n.region_h) {
            return t.HTTRANSPARENT;
        }
        // An edge of a frame of its own: the system's to resize from.
        let is i64 as edge = _edge(n, hx, hy);
        if (edge != 0) { return edge; }
    }
    if (cast(i64, msg) == _WM_WINDOW_MENU) { _window_menu(n, lp); return 0; }
    if (_ngrab > 0) {
        let is *Native as top = _top_grab();
        // The owner's keys are the grabbing popup's.
        if (top != n && _is_key(cast(i64, msg)) == 1) { return u.SendMessageW(top.hwnd, msg, wp, lp); }
        if (top == n && _is_pointer(cast(i64, msg)) == 1) {
            let is i64 as routed = _grab_route(n, hwnd, cast(i64, msg), wp, lp);
            if (routed >= 0) { return routed; }
        }
    }
    if (cast(i64, msg) == t.WM_MOUSEACTIVATE && n.popup != 0) { return t.MA_NOACTIVATE; }
    if (cast(i64, msg) == t.WM_CAPTURECHANGED && _grabbed(n) == 1) {
        // Taken by a window not of this popup chain: the system's, another
        // program's — the popup goes, as a menu does.
        let is *Native as to = _native_of(lp);
        if (cast(i64, to) == 0 || _grabbed(to) == 0) { _dismiss(n); }
        return 0;
    }
    if (cast(i64, msg) == t.WM_ACTIVATEAPP && wp == 0) {
        let is i64 as gi with mut = 0;
        while (gi < _ngrab) {
            _dismiss(&_windows[_grab_slot[gi]]);
            gi = gi + 1;
        }
    }
    if (cast(i64, msg) == t.WM_SETCURSOR && (lp & 65535) == t.HTCLIENT) {
        u.SetCursor(n.cursor); return 1;
    }
    if (cast(i64, msg) == t.WM_GETMINMAXINFO) {
        let is *t.MINMAXINFO as limits = cast(*t.MINMAXINFO, lp);
        let is t.RECT as outer;
        outer.left = 0; outer.top = 0; outer.right = 0; outer.bottom = 0;
        u.AdjustWindowRectExForDpi(&outer, cast(u32, u.GetWindowLongPtrW(hwnd, cast(i32, t.GWL_STYLE))),
                                  0, 0, cast(u32, n.dpi));
        let is i32 as border_w = outer.right - outer.left;
        let is i32 as border_h = outer.bottom - outer.top;
        if (n.min_width > 0) { limits.ptMinTrackSize.x = cast(i32, n.min_width) + border_w; }
        if (n.min_height > 0) { limits.ptMinTrackSize.y = cast(i32, n.min_height) + border_h; }
        if (n.max_width > 0) { limits.ptMaxTrackSize.x = cast(i32, n.max_width) + border_w; }
        if (n.max_height > 0) { limits.ptMaxTrackSize.y = cast(i32, n.max_height) + border_h; }
        return 0;
    }
    if (cast(i64, msg) == t.WM_PAINT) { _paint(n); return 0; }
    if (cast(i64, msg) == t.WM_ERASEBKGND) { return 1; }
    if (cast(i64, msg) == t.WM_CLOSE) { n.asked = 1; _emit(n, event.CLOSE, cast(i32, msg), 0, 0, 0); return 0; }
    if (cast(i64, msg) == t.WM_SIZE) {
        let is i32 as was = n.state;
        if (wp == cast(u64, t.SIZE_MINIMIZED)) {
            // Not shown: the size it says is no size, and is not taken.
            n.state = n.state | event.STATE_MINIMIZED;
            if (n.state != was) { _emit(n, event.STATE, cast(i32, msg), 0, 0, n.state); }
            return 0;
        }
        let is i64 as nw = cast(i64, lp & 65535);
        let is i64 as nh = cast(i64, (lp >> 16) & 65535);
        let is i64 as ow = n.width; let is i64 as oh = n.height;
        if (_dib(n, nw, nh) == 0) { n.width = 0; n.height = 0; }
        if (ow != n.width || oh != n.height) { n.resized = 1; _emit(n, event.RESIZE, cast(i32, msg), 0, 0, 0); }
        if (wp == cast(u64, t.SIZE_MAXIMIZED)) {
            n.state = (n.state | event.STATE_MAXIMIZED) & cast(i32, 0 - 1 - event.STATE_MINIMIZED);
        } else if (wp == cast(u64, t.SIZE_RESTORED)) {
            n.state = n.state & cast(i32, 0 - 1 - event.STATE_MAXIMIZED - event.STATE_MINIMIZED);
        }
        if (n.state != was) { _emit(n, event.STATE, cast(i32, msg), 0, 0, n.state); }
        return 0;
    }
    if (cast(i64, msg) == t.WM_DPICHANGED) {
        n.dpi = cast(i32, wp & 65535);
        let is *t.RECT as suggested = cast(*t.RECT, lp);
        u.SetWindowPos(hwnd, 0, suggested.left, suggested.top, suggested.right - suggested.left,
                       suggested.bottom - suggested.top, cast(u32, t.SWP_NOZORDER | t.SWP_NOACTIVATE));
        let is event.Event as e; event.clear(&e); e.kind = event.RESIZE; e.raw_kind = cast(i32, msg);
        e.width = n.width; e.height = n.height; _enqueue(n, &e);
        n.resized = 1;
        // Its scale changed: what reads it is to read it again, as on Wayland.
        _emit(n, event.SETTINGS, cast(i32, msg), 0, 0, 0);
        return 0;
    }
    if (cast(i64, msg) == t.WM_SETTINGCHANGE) { _emit(n, event.SETTINGS, cast(i32, msg), 0, 0, 0); return 0; }
    // Desktop composition turned on or off (Windows 7; always on since 8).
    if (cast(i64, msg) == t.WM_DWMCOMPOSITIONCHANGED) { _emit(n, event.COMPOSITOR, cast(i32, msg), 0, 0, 0); return 0; }
    if (cast(i64, msg) == t.WM_SETFOCUS) { n.focused = 1; _emit(n, event.FOCUS_IN, cast(i32, msg), 0, 0, 0); return 0; }
    if (cast(i64, msg) == t.WM_KILLFOCUS) {
        n.focused = 0; n.high_surrogate = 0; n.after_key = 0;
        _empty_preedit(n);
        // A key let go while another window has the focus is never said
        // here: everything held — keys and buttons — is let go now.
        if (n.buttons != 0 && _ngrab == 0 && u.GetCapture() == hwnd) { u.ReleaseCapture(); }
        n.buttons = 0;
        if (cast(i64, n.input) != 0) { ie.cancel(n.input, ie.CANCEL_FOCUS); }
        _emit(n, event.FOCUS_OUT, cast(i32, msg), 0, 0, 0); return 0;
    }
    if (cast(i64, msg) == t.WM_KEYDOWN || cast(i64, msg) == t.WM_SYSKEYDOWN ||
        cast(i64, msg) == t.WM_KEYUP || cast(i64, msg) == t.WM_SYSKEYUP) {
        let is i32 as key_kind with mut = ie.KEY_DOWN;
        if (cast(i64, msg) == t.WM_KEYUP || cast(i64, msg) == t.WM_SYSKEYUP) { key_kind = ie.KEY_UP; }
        let is i64 as vk with mut = cast(i64, wp);
        let is i64 as scan = (lp >> 16) & 255;
        let is i64 as extended = (lp >> 24) & 1;
        if (vk == t.VK_SHIFT) { vk = cast(i64, u.MapVirtualKeyW(cast(u32, scan), cast(u32, t.MAPVK_VSC_TO_VK_EX))); }
        else if (vk == t.VK_CONTROL) { vk = t.VK_LCONTROL + extended; }
        else if (vk == t.VK_MENU) { vk = t.VK_LMENU + extended; }
        _key_event(n, key_kind, vk, lp);
        n.after_key = cast(i32, key_kind == ie.KEY_DOWN);
        if (cast(i64, msg) == t.WM_SYSKEYDOWN || cast(i64, msg) == t.WM_SYSKEYUP) { return u.DefWindowProcW(hwnd, msg, wp, lp); }
        return 0;
    }
    if (cast(i64, msg) == t.WM_CHAR) {
        let is i64 as unit = cast(i64, wp & 65535);
        if (unit < 32 || unit == 127) { return 0; }
        if (unit >= 55296 && unit <= 56319) { n.high_surrogate = cast(u16, unit); return 0; }
        if (unit >= 56320 && unit <= 57343) {
            if (n.high_surrogate != 0) {
                _typed(n, 65536 + ((cast(i64, n.high_surrogate) - 55296) << 10) + unit - 56320);
                n.high_surrogate = 0;
            }
            return 0;
        }
        if (n.high_surrogate != 0) { _typed(n, 65533); n.high_surrogate = 0; }
        _typed(n, unit);
        return 0;
    }
    if (cast(i64, msg) == t.WM_IME_COMPOSITION) { _composition(n, lp); return 0; }
    if (cast(i64, msg) == t.WM_IME_ENDCOMPOSITION) { _empty_preedit(n); return 0; }
    // The composition is drawn in the field: the method's own composition
    // window is not shown, and not started; its candidates and status are.
    if (cast(i64, msg) == t.WM_IME_SETCONTEXT) {
        return u.DefWindowProcW(hwnd, msg, wp, lp & (0 - 1 - t.ISC_SHOWUICOMPOSITIONWINDOW));
    }
    if (cast(i64, msg) == t.WM_IME_STARTCOMPOSITION) { _position_ime(n); return 0; }
    if (cast(i64, msg) == t.WM_IME_REQUEST) {
        if (cast(i64, wp) == t.IMR_DOCUMENTFEED) { return _document_feed(n, cast(*t.RECONVERTSTRING, lp)); }
        if (cast(i64, wp) == t.IMR_QUERYCHARPOSITION) { return _char_position(n, cast(*t.IMECHARPOSITION, lp)); }
        return 0;
    }
    if (cast(i64, msg) == t.WM_MOUSEMOVE) {
        let is i64 as mx = _signed16(cast(u64, lp));
        let is i64 as my = _signed16(cast(u64, lp) >> 16);
        n.mouse_x = mx; n.mouse_y = my;
        if (n.entered == 0) {
            n.entered = 1; _pointer(n, ie.ENTER, mx, my, 0);
            let is t.TRACKMOUSEEVENT as track; mem.memset(cast(*u8, &track), 0, sizeof(t.TRACKMOUSEEVENT));
            track.cbSize = cast(u32, sizeof(t.TRACKMOUSEEVENT)); track.dwFlags = cast(u32, t.TME_LEAVE);
            track.hwndTrack = hwnd; u.TrackMouseEvent(&track);
        }
        _pointer(n, ie.MOTION, mx, my, 0); return 0;
    }
    if (cast(i64, msg) == t.WM_MOUSELEAVE) { n.entered = 0; _pointer(n, ie.LEAVE, n.mouse_x, n.mouse_y, 0); return 0; }
    if (cast(i64, msg) == t.WM_LBUTTONDOWN || cast(i64, msg) == t.WM_LBUTTONUP ||
        cast(i64, msg) == t.WM_MBUTTONDOWN || cast(i64, msg) == t.WM_MBUTTONUP ||
        cast(i64, msg) == t.WM_RBUTTONDOWN || cast(i64, msg) == t.WM_RBUTTONUP) {
        let is i32 as button with mut = 1; let is i32 as down with mut = 1;
        if (cast(i64, msg) == t.WM_MBUTTONDOWN || cast(i64, msg) == t.WM_MBUTTONUP) { button = 2; }
        if (cast(i64, msg) == t.WM_RBUTTONDOWN || cast(i64, msg) == t.WM_RBUTTONUP) { button = 3; }
        if (cast(i64, msg) == t.WM_LBUTTONUP || cast(i64, msg) == t.WM_MBUTTONUP || cast(i64, msg) == t.WM_RBUTTONUP) { down = 0; }
        n.mouse_x = _signed16(cast(u64, lp)); n.mouse_y = _signed16(cast(u64, lp) >> 16);
        let is i32 as mask = cast(i32, 1 << (button - 1));
        // A release of a button not held says nothing: its press was taken
        // by the system to move or resize from, or let go by a CANCEL.
        if (down == 0 && (n.buttons & mask) == 0) { return 0; }
        if (down == 1) { n.buttons = n.buttons | mask; if (_ngrab == 0) { u.SetCapture(hwnd); } }
        else { n.buttons = n.buttons & cast(i32, 0 - 1 - mask); if (n.buttons == 0 && _ngrab == 0) { u.ReleaseCapture(); } }
        let is i32 as mouse_kind with mut = ie.BUTTON_DOWN; if (down == 0) { mouse_kind = ie.BUTTON_UP; }
        _pointer(n, mouse_kind, n.mouse_x, n.mouse_y, button); return 0;
    }
    if (cast(i64, msg) == t.WM_MOUSEWHEEL || cast(i64, msg) == t.WM_MOUSEHWHEEL) {
        let is i64 as wx = _signed16(cast(u64, lp)); let is i64 as wy = _signed16(cast(u64, lp) >> 16);
        let is t.POINT as p; p.x = cast(i32, wx); p.y = cast(i32, wy); u.ScreenToClient(hwnd, &p);
        let is i32 as delta with mut = cast(i32, (wp >> 16) & 65535); if (delta >= 32768) { delta = delta - 65536; }
        // As much as the wheel says, 120 a notch, finer where it is finer;
        // whole notches counted from what is left over between messages.
        let is ie.Event as e = _input(ie.SCROLL);
        e.x = cast(i64, p.x);
        e.y = cast(i64, p.y);
        e.source = ie.SCROLL_WHEEL;
        if (cast(i64, msg) == t.WM_MOUSEHWHEEL) {
            n.wheel_x_remainder = n.wheel_x_remainder + delta;
            let is i32 as sideways = n.wheel_x_remainder / 120;
            n.wheel_x_remainder = n.wheel_x_remainder - sideways * 120;
            // Positive is to the right.
            e.value120_x = delta;
            e.dx = cast(f64, delta) / 120.0;
            e.steps_x = sideways;
        } else {
            n.wheel_remainder = n.wheel_remainder + delta;
            let is i32 as notch = n.wheel_remainder / 120;
            n.wheel_remainder = n.wheel_remainder - notch * 120;
            // Positive is away from the user: up, so towards the start.
            e.value120_y = 0 - delta;
            e.dy = cast(f64, 0 - delta) / 120.0;
            e.steps_y = 0 - notch;
        }
        _push(n, &e, cast(*u8, 0), 0);
        return 0;
    }
    if (cast(i64, msg) == t.WM_NCDESTROY) {
        n.alive = 0; u.SetWindowLongPtrW(hwnd, cast(i32, t.GWLP_USERDATA), 0);
        return u.DefWindowProcW(hwnd, msg, wp, lp);
    }
    return u.DefWindowProcW(hwnd, msg, wp, lp);
}

fn _ensure_class() as i32 {
    if (_class_ready == 1) { return 1; }
    if (_dpi_ready == 0) { u.SetProcessDpiAwarenessContext(t.DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2); _dpi_ready = 1; }
    _instance = k.GetModuleHandleW(cast(*u16, 0));
    k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, "CausticMediaWindow"), cast(i32, 0 - 1), &_class_name[0], 32);
    _callbacks = abi.open(1);
    if (cast(i64, _callbacks.code) == 0) { return 0; }
    if (abi.put(&_callbacks, 0, fn_ptr(_window_proc), cast(*u8, 0), 4, 0) == 0 || abi.seal(&_callbacks) == 0) {
        abi.close(&_callbacks); return 0;
    }
    let is t.WNDCLASSEXW as wc; mem.memset(cast(*u8, &wc), 0, sizeof(t.WNDCLASSEXW));
    wc.cbSize = cast(u32, sizeof(t.WNDCLASSEXW));
    wc.style = cast(u32, t.CS_HREDRAW | t.CS_VREDRAW | t.CS_DBLCLKS);
    wc.lpfnWndProc = abi.address(&_callbacks, 0); wc.hInstance = _instance; wc.lpszClassName = &_class_name[0];
    wc.hCursor = u.LoadCursorW(0, cast(*u16, t.IDC_ARROW));
    if (u.RegisterClassExW(&wc) == 0) { abi.close(&_callbacks); return 0; }
    _class_ready = 1; return 1;
}

fn config(title as *u8, width as i64, height as i64) as Config {
    let is Config as c; c.title = title; c.width = width; c.height = height;
    c.resizable = 1; c.owner = 0; c.dialog = 0; c.modal = 0; c.decorated = 1; c.app_id = cast(*u8, 0);
    c.popup = 0; c.grab = 0; c.x = 0; c.y = 0; c.transparent = 0;
    return c;
}

fn open_config(c as *Config) as Window {
    let is Window as w; mem.memzero(cast(*u8, &w), sizeof(Window));
    w.slot = 0 - 1; w.err = BAD_ARGUMENT;
    if (c.width <= 0 || c.height <= 0 || c.width > 16384 || c.height > 16384) { return w; }
    if (_ensure_class() == 0) { w.err = NO_WINDOW; return w; }
    if (cast(i64, c.app_id) != 0 && c.app_id[0] != 0) {
        let is [256]u16 as app;
        if (k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, c.app_id), cast(i32, 0 - 1), &app[0], 256) > 0) {
            shell.SetCurrentProcessExplicitAppUserModelID(&app[0]);
        }
    }
    let is i64 as slot with mut = 0 - 1; let is i64 as i with mut = 0;
    while (i < MAX_WINDOWS) { if (_windows[i].used == 0) { slot = i; break; } i = i + 1; }
    if (slot < 0) { w.err = NO_MEMORY; return w; }
    let is *Native as n = &_windows[slot]; mem.memset(cast(*u8, n), 0, sizeof(Native));
    n.used = 1; n.owner = c.owner; n.fixed = cast(i32, c.resizable == 0); n.modal = c.modal;
    n.decorated = c.decorated; n.dpi = cast(i32, u.GetDpiForSystem()); if (n.dpi < 96) { n.dpi = 96; }
    n.popup = c.popup;
    if (c.popup != 0 && c.owner == 0) { n.used = 0; return w; }
    // Its input's queue, there before the window is: creating it already
    // sends it messages.
    n.input = ie.create();
    if (cast(i64, n.input) == 0) { n.used = 0; w.err = NO_MEMORY; return w; }
    n.cursor = u.LoadCursorW(0, cast(*u16, t.IDC_ARROW));
    if (n.fixed == 1) {
        n.min_width = c.width; n.max_width = c.width;
        n.min_height = c.height; n.max_height = c.height;
    }
    let is u32 as style with mut = cast(u32, t.WS_OVERLAPPEDWINDOW);
    if (c.decorated == 0) { style = cast(u32, t.WS_POPUP | t.WS_VISIBLE); }
    if (c.resizable == 0) { style = cast(u32, cast(i64, style) & (0 - 262145)); }
    // A dialog the system frames: a caption and a close button, no more. One
    // drawing its own frame is as frameless as any such window.
    if (c.dialog == 1 && c.decorated != 0) { style = cast(u32, t.WS_CAPTION | t.WS_SYSMENU | t.WS_VISIBLE); }
    // A popup: no frame, no taskbar entry, never activated — the owner keeps
    // the focus, and its keys come to the popup while it holds the capture.
    let is u32 as ex with mut = 0;
    if (c.popup != 0) {
        style = cast(u32, t.WS_POPUP);
        ex = cast(u32, t.WS_EX_TOOLWINDOW | t.WS_EX_NOACTIVATE);
    }
    // Seen through where its alpha says: only where the system draws no frame
    // round it, for a layered window is all its own pixels.
    if (c.transparent == 1 && (cast(i64, style) & t.WS_CAPTION) == 0) {
        ex = ex | cast(u32, t.WS_EX_LAYERED);
        n.layered = 1;
    }
    let is t.RECT as r; r.left = 0; r.top = 0; r.right = cast(i32, c.width); r.bottom = cast(i32, c.height);
    if (u.AdjustWindowRectExForDpi(&r, style, 0, ex, cast(u32, n.dpi)) == 0) { u.AdjustWindowRectEx(&r, style, 0, ex); }
    let is [512]u16 as title; title[0] = cast(u16, 0);
    if (cast(i64, c.title) != 0) { k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, c.title), cast(i32, 0 - 1), &title[0], 512); }
    let is i32 as outer_width = r.right - r.left;
    let is i32 as outer_height = r.bottom - r.top;
    let is i32 as at_x with mut = cast(i32, t.CW_USEDEFAULT);
    let is i32 as at_y with mut = cast(i32, t.SW_SHOW);
    if (c.popup != 0) { at_x = cast(i32, c.x) + r.left; at_y = cast(i32, c.y) + r.top; }
    let is i64 as hwnd = u.CreateWindowExW(ex, &_class_name[0], &title[0], style,
        at_x, at_y, outer_width, outer_height, c.owner, 0, _instance, cast(*u8, n));
    if (hwnd == 0) { ie.destroy(n.input); n.input = cast(*ie.Queue, 0); n.used = 0; w.err = NO_WINDOW; return w; }
    n.hwnd = hwnd; n.alive = 1; n.dpi = cast(i32, u.GetDpiForWindow(hwnd)); if (n.dpi < 96) { n.dpi = 96; }
    // Created with the thread's input context; it has none until a text
    // field has the keyboard (text_input_enable).
    n.ime_on = 1; n.ime_text_len = 0 - 1;
    _ime_associate(n);
    let is t.RECT as client; u.GetClientRect(hwnd, &client);
    if (_dib(n, cast(i64, client.right - client.left), cast(i64, client.bottom - client.top)) == 0) {
        u.DestroyWindow(hwnd); ie.destroy(n.input); n.input = cast(*ie.Queue, 0); n.used = 0; w.err = NO_SURFACE; return w;
    }
    if (n.modal == 1 && n.owner != 0) { u.EnableWindow(n.owner, 0); }
    if (c.popup != 0) { u.ShowWindow(hwnd, cast(i32, t.SW_SHOWNOACTIVATE)); }
    else { u.ShowWindow(hwnd, cast(i32, t.SW_SHOW)); }
    u.UpdateWindow(hwnd);
    if (c.popup != 0 && c.grab == 1) { _grab_popup(n, slot); }
    w.hwnd = hwnd; w.slot = cast(i32, slot); w.ok = 1; w.err = OK; w.dpi = n.dpi; return w;
}

fn open(title as *u8, width as i64, height as i64) as Window {
    let is Config as c = config(title, width, height); return open_config(&c);
}

fn _native(w as *Window) as *Native {
    if (w.ok != 1 || w.slot < 0 || w.slot >= MAX_WINDOWS) { return cast(*Native, 0); }
    let is *Native as n = &_windows[w.slot];
    if (n.used != 1 || n.hwnd != w.hwnd) { return cast(*Native, 0); }
    return n;
}

fn close(w as *Window) as void {
    let is *Native as n = _native(w); if (cast(i64, n) == 0 || n.used == 0) { w.ok = 0; return; }
    if (n.modal == 1 && n.owner != 0 && u.IsWindow(n.owner) == 1) { u.EnableWindow(n.owner, 1); }
    _ungrab(n);
    if (n.hwnd != 0 && u.IsWindow(n.hwnd) == 1) { u.DestroyWindow(n.hwnd); }
    if (n.hdc != 0) { g.DeleteDC(n.hdc); n.hdc = 0; }
    if (n.bitmap != 0) { g.DeleteObject(n.bitmap); n.bitmap = 0; }
    _drop_layer(n);
    clipboard.clear(&n.clip);
    if (n.icon != 0) { u.DestroyIcon(n.icon); n.icon = 0; }
    ie.destroy(n.input);
    n.input = cast(*ie.Queue, 0);
    n.pixels = cast(*u8, 0); n.used = 0; n.alive = 0; w.ok = 0;
}

fn is_open(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return cast(i32, n.used == 1 && n.alive == 1 && u.IsWindow(n.hwnd) == 1); }
fn hwnd(w as *Window) as i64 { return w.hwnd; }
fn width(w as *Window) as i64 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.width; }
fn height(w as *Window) as i64 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.height; }
fn scale_120(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0 || n.dpi < 96) { return 120; } return n.dpi * 120 / 96; }
fn resized(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.resized; }
fn should_close(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.asked; }
fn keep_open(w as *Window) as void { let is *Native as n = _native(w); if (cast(i64, n) != 0) { n.asked = 0; } }
fn request_close(w as *Window) as void { let is *Native as n = _native(w); if (cast(i64, n) == 0 || n.asked == 1) { return; } n.asked = 1; _emit(n, event.CLOSE, cast(i32, t.WM_CLOSE), 0, 0, 0); }
fn state(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.state; }
fn focused(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.focused; }

fn pump(w as *Window) as void {
    if (is_open(w) == 0) { return; }
    let is t.MSG as msg;
    while (u.PeekMessageW(&msg, 0, 0, 0, cast(u32, t.PM_REMOVE)) == 1) {
        u.TranslateMessage(&msg); u.DispatchMessageW(&msg);
    }
}
// A frame begins: resized is an edge, not a level, and starts again.
fn next_frame(w as *Window) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0 || is_open(w) == 0) { return 0; }
    n.resized = 0;
    pump(w);
    return 1;
}
// Whether an event waits, of the window's own or of its input.
fn pending(w as *Window) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    return cast(i32, n.event_len > 0 || ie.pending(n.input) == 1);
}
fn connection_fd(w as *Window) as i64 { return 0 - 1; }
fn poll_event(w as *Window, out as *event.Event) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0 || n.event_len == 0) { return 0; }
    *out = n.events[n.event_head];
    n.event_head = (n.event_head + 1) % MAX_EVENTS; n.event_len = n.event_len - 1;
    return 1;
}
// Its cooked input, oldest first (input/event.cst): 1, or 0 when none waits.
fn poll_input(w as *Window, out as *ie.Event) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    return ie.next(n.input, out);
}
fn acquire(w as *Window) as tgt.Target {
    let is *Native as n = _native(w); let is tgt.Target as out;
    if (cast(i64, n) == 0 || is_open(w) == 0) { out.color = cast(*u8, 0); out.depth = cast(*u8, 0); out.width = 0; out.height = 0; return out; }
    out.color = n.pixels; out.depth = cast(*u8, 0); out.width = n.width; out.height = n.height; return out;
}
// The frame drawn into acquire's target shown: painted from the DIB, or, for
// a layered window, given to the system to blend.
fn submit(w as *Window) as void {
    let is *Native as n = _native(w); if (cast(i64, n) == 0 || n.used == 0 || n.hwnd == 0) { return; }
    if (n.layered == 1) { _present_layer(n); return; }
    u.InvalidateRect(n.hwnd, cast(*t.RECT, 0), 0); u.UpdateWindow(n.hwnd);
}
fn show(w as *Window) as void { if (is_open(w) == 1) { u.ShowWindow(w.hwnd, cast(i32, t.SW_SHOW)); } }
fn hide(w as *Window) as void { if (is_open(w) == 1) { u.ShowWindow(w.hwnd, cast(i32, t.SW_HIDE)); } }
fn set_title(w as *Window, s as *u8, nbytes as i64) as void {
    if (is_open(w) == 0) { return; }
    let is [512]u16 as wide;
    mem.memzero(cast(*u8, &wide[0]), 1024);
    if (cast(i64, s) != 0 && nbytes > 0) {
        let is i32 as units = k.MultiByteToWideChar(cast(u32, t.CP_UTF8), 0, cast(*i8, s), cast(i32, nbytes), &wide[0], 511);
        if (units > 0) { wide[units] = cast(u16, 0); }
    }
    u.SetWindowTextW(w.hwnd, &wide[0]);
}

// Text input wanted (a text field has the keyboard) or not: the window's
// input context given or taken away (_ime_associate).
fn text_input_enable(w as *Window, on as i32) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    n.text_enabled = cast(i32, on != 0);
    if (n.text_enabled == 0) {
        n.ime_purpose = content.PURPOSE_NORMAL;
        n.ime_text_len = 0 - 1;
    }
    _ime_associate(n);
    return 1;
}
fn text_input_active(w as *Window) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    return cast(i32, n.ime_on == 1 && n.focused == 1);
}
// The caret, in client pixels: told the method when it moved.
fn text_input_rect(w as *Window, x as i64, y as i64, width as i64, height as i64) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    if (x == n.caret_x && y == n.caret_y && width == n.caret_w && height == n.caret_h) { return 1; }
    n.caret_x = x; n.caret_y = y; n.caret_w = width; n.caret_h = height;
    if (n.focused == 1 && n.ime_on == 1) { _position_ime(n); }
    return 1;
}
// What the field with the keyboard is and holds (input/text.cst): kept for
// the method to ask (IMR_DOCUMENTFEED); a secret one takes the input context
// away. IMM32 has no purpose but that.
fn text_input_context(w as *Window, text as *u8, nbytes as i64, caret as i64, anchor as i64,
                      purpose as i32, hints as i32) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0 || n.text_enabled == 0) { return 0; }
    if (nbytes < 0 || nbytes > content.CONTEXT_MAX || caret < 0 || caret > nbytes || anchor < 0 || anchor > nbytes) { return 0; }
    n.ime_purpose = purpose;
    if (content.secret(purpose) == 1) {
        n.ime_text_len = 0 - 1;
    } else {
        if (nbytes > 0) { mem.memcpy(&n.ime_text[0], text, nbytes); }
        n.ime_text_len = nbytes;
        n.ime_caret = caret;
    }
    _ime_associate(n);
    return 1;
}
// The composition abandoned (CPS_CANCEL) and said gone.
fn text_input_reset(w as *Window) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    if (n.ime_on == 1) { _ime_cancel(n); }
    return 1;
}

fn set_modal(w as *Window, on as i32) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0 || n.owner == 0) { return 0; }
    n.modal = cast(i32, on != 0); if (u.IsWindow(n.owner) == 1) { u.EnableWindow(n.owner, cast(i32, n.modal == 0)); } return 1;
}
fn activate(w as *Window) as void { if (is_open(w) == 1) { u.SetForegroundWindow(w.hwnd); u.SetFocus(w.hwnd); } }
fn set_decorated(w as *Window, on as i32) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    let is i64 as style = u.GetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE));
    let is i64 as next with mut = style;
    if (on == 0) { next = next & (0 - 12582913); }
    else { next = next | t.WS_CAPTION | t.WS_SYSMENU; }
    u.SetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE), next);
    // Framed by the system, it is not seen through: its frame is not its own
    // pixels. Shown as painted from its next frame on.
    if (on != 0 && n.layered == 1) {
        u.SetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_EXSTYLE),
                            u.GetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_EXSTYLE)) & (0 - 1 - t.WS_EX_LAYERED));
        n.layered = 0;
        _drop_layer(n);
    }
    u.SetWindowPos(w.hwnd, 0, 0, 0, 0, 0, cast(u32, t.SWP_NOMOVE | t.SWP_NOSIZE | t.SWP_NOZORDER | t.SWP_FRAMECHANGED));
    n.decorated = cast(i32, on != 0); return 1;
}
fn decorated(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.decorated; }
fn set_maximized(w as *Window, on as i32) as i32 { if (is_open(w) == 0) { return 0; } if (on != 0) { u.ShowWindow(w.hwnd, cast(i32, t.SW_MAXIMIZE)); } else { u.ShowWindow(w.hwnd, cast(i32, t.SW_RESTORE)); } return 1; }
fn set_fullscreen(w as *Window, on as i32) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0) { return 0; }
    let is i32 as full = cast(i32, (n.state & event.STATE_FULLSCREEN) != 0);
    if (full == cast(i32, on != 0)) { return 1; }
    if (on != 0) {
        let is t.MONITORINFO as monitor;
        mem.memzero(cast(*u8, &monitor), sizeof(t.MONITORINFO));
        monitor.cbSize = cast(u32, sizeof(t.MONITORINFO));
        if (u.GetMonitorInfoW(u.MonitorFromWindow(w.hwnd, cast(u32, t.MONITOR_DEFAULTTONEAREST)), &monitor) == 0 ||
            u.GetWindowRect(w.hwnd, &n.restore_rect) == 0) { return 0; }
        n.restore_style = u.GetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE));
        u.SetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE), n.restore_style & (0 - 13565953));
        u.SetWindowPos(w.hwnd, 0, monitor.rcMonitor.left, monitor.rcMonitor.top,
                       monitor.rcMonitor.right - monitor.rcMonitor.left,
                       monitor.rcMonitor.bottom - monitor.rcMonitor.top,
                       cast(u32, t.SWP_NOZORDER | t.SWP_FRAMECHANGED));
        n.state = n.state | event.STATE_FULLSCREEN;
    } else {
        u.SetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE), n.restore_style);
        u.SetWindowPos(w.hwnd, 0, n.restore_rect.left, n.restore_rect.top,
                       n.restore_rect.right - n.restore_rect.left, n.restore_rect.bottom - n.restore_rect.top,
                       cast(u32, t.SWP_NOZORDER | t.SWP_FRAMECHANGED));
        n.state = n.state & cast(i32, 0 - 3);
    }
    _emit(n, event.STATE, 0, 0, 0, n.state);
    return 1;
}
fn minimize(w as *Window) as i32 { if (is_open(w) == 0) { return 0; } u.ShowWindow(w.hwnd, cast(i32, t.SW_MINIMIZE)); return 1; }
fn composited(w as *Window) as i32 {
    let is i32 as enabled with mut = 0;
    if (is_open(w) == 0 || dwm.DwmIsCompositionEnabled(&enabled) != 0) { return 0; }
    return cast(i32, enabled != 0);
}
// Whether its pixels' alpha shows what is behind it: Config.transparent, on a
// window the system draws no frame round.
fn transparent(w as *Window) as i32 { let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.layered; }

fn set_cursor(w as *Window, shape as i32) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0 || shape < 1 || shape > 35) { return 0; }
    let is i64 as id with mut = t.IDC_ARROW;
    if (shape == 3) { id = t.IDC_HELP; }
    else if (shape == 4 || shape == 16 || shape == 17) { id = t.IDC_HAND; }
    else if (shape == 5) { id = t.IDC_APPSTARTING; }
    else if (shape == 6) { id = t.IDC_WAIT; }
    else if (shape == 7 || shape == 8) { id = t.IDC_CROSS; }
    else if (shape == 9 || shape == 10) { id = t.IDC_IBEAM; }
    else if (shape == 13 || shape == 32) { id = t.IDC_SIZEALL; }
    else if (shape == 14 || shape == 15) { id = t.IDC_NO; }
    else if (shape == 18 || shape == 25 || shape == 26 || shape == 30) { id = t.IDC_SIZEWE; }
    else if (shape == 19 || shape == 22 || shape == 27 || shape == 31) { id = t.IDC_SIZENS; }
    else if (shape == 20 || shape == 24 || shape == 28) { id = t.IDC_SIZENESW; }
    else if (shape == 21 || shape == 23 || shape == 29) { id = t.IDC_SIZENWSE; }
    let is i64 as cursor with mut = 0;
    if (shape != 35) { cursor = u.LoadCursorW(0, cast(*u16, id)); if (cursor == 0) { return 0; } }
    n.cursor = cursor;
    if (n.entered == 1) { u.SetCursor(cursor); }
    return 1;
}

fn set_min_size(w as *Window, width as i64, height as i64) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0 || n.fixed == 1 || width < 0 || height < 0) { return 0; }
    n.min_width = width; n.min_height = height; return 1;
}
fn min_size(w as *Window, width as *i64, height as *i64) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    *width = n.min_width; *height = n.min_height; return 1;
}
fn set_max_size(w as *Window, width as i64, height as i64) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0 || n.fixed == 1 || width < 0 || height < 0) { return 0; }
    n.max_width = width; n.max_height = height; return 1;
}

// The client asked to be cw by ch physical pixels, the frame round it as the
// window's style and DPI make it; a window of fixed size is fixed at that
// size from now. 1 when asked: the size arrives as a RESIZE.
fn set_size(w as *Window, cw as i64, ch as i64) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0 || cw <= 0 || ch <= 0 || cw > 16384 || ch > 16384) { return 0; }
    if (n.fixed == 1) { n.min_width = cw; n.max_width = cw; n.min_height = ch; n.max_height = ch; }
    let is t.RECT as r; r.left = 0; r.top = 0; r.right = cast(i32, cw); r.bottom = cast(i32, ch);
    let is u32 as style = cast(u32, u.GetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE)));
    let is u32 as ex = cast(u32, u.GetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_EXSTYLE)));
    if (u.AdjustWindowRectExForDpi(&r, style, 0, ex, cast(u32, n.dpi)) == 0) { return 0; }
    return cast(i32, u.SetWindowPos(w.hwnd, 0, 0, 0, r.right - r.left, r.bottom - r.top,
                                    cast(u32, t.SWP_NOMOVE | t.SWP_NOZORDER | t.SWP_NOACTIVATE)) != 0);
}

// The client's top left on the screen, and the work area of the monitor the
// window is on — where a popup of it has room. 1 when both are known.
fn popup_room(w as *Window, ox as *i64, oy as *i64, l as *i64, t_ as *i64, r as *i64, b as *i64) as i32 {
    if (is_open(w) == 0) { return 0; }
    let is t.POINT as p; p.x = 0; p.y = 0;
    if (u.ClientToScreen(w.hwnd, &p) == 0) { return 0; }
    let is t.MONITORINFO as monitor;
    mem.memzero(cast(*u8, &monitor), sizeof(t.MONITORINFO));
    monitor.cbSize = cast(u32, sizeof(t.MONITORINFO));
    if (u.GetMonitorInfoW(u.MonitorFromWindow(w.hwnd, cast(u32, t.MONITOR_DEFAULTTONEAREST)), &monitor) == 0) { return 0; }
    *ox = p.x; *oy = p.y;
    *l = monitor.rcWork.left; *t_ = monitor.rcWork.top; *r = monitor.rcWork.right; *b = monitor.rcWork.bottom;
    return 1;
}

// The monitor the window is most on: where it is on the virtual desktop, its
// work area, its DPI (Per-Monitor V2: what the window is drawn at there), its
// refresh rate and its device name. 1 when the system said.
fn monitor_of(w as *Window, out as *monitor.Monitor) as i32 {
    monitor.clear(out);
    if (is_open(w) == 0) { return 0; }
    let is i64 as hm = u.MonitorFromWindow(w.hwnd, cast(u32, t.MONITOR_DEFAULTTONEAREST));
    let is t.MONITORINFOEXW as info;
    mem.memzero(cast(*u8, &info), sizeof(t.MONITORINFOEXW));
    info._anon0.cbSize = cast(u32, sizeof(t.MONITORINFOEXW));
    if (hm == 0 || u.GetMonitorInfoW(hm, cast(*t.MONITORINFO, &info)) == 0) { return 0; }
    out.x = info._anon0.rcMonitor.left;
    out.y = info._anon0.rcMonitor.top;
    out.width = info._anon0.rcMonitor.right - info._anon0.rcMonitor.left;
    out.height = info._anon0.rcMonitor.bottom - info._anon0.rcMonitor.top;
    out.work_x = info._anon0.rcWork.left;
    out.work_y = info._anon0.rcWork.top;
    out.work_width = info._anon0.rcWork.right - info._anon0.rcWork.left;
    out.work_height = info._anon0.rcWork.bottom - info._anon0.rcWork.top;
    out.primary = cast(i32, (cast(i64, info._anon0.dwFlags) & t.MONITORINFOF_PRIMARY) != 0);
    let is u32 as dx with mut = cast(u32, 0);
    let is u32 as dy with mut = cast(u32, 0);
    if (sh.GetDpiForMonitor(hm, cast(u32, t.MDT_EFFECTIVE_DPI), &dx, &dy) == 0 && dx >= cast(u32, 96)) {
        out.scale120 = cast(i32, cast(i64, dx) * 120 / 96);
    }
    let is [32]u8 as name;
    let is i32 as bytes = k.WideCharToMultiByte(cast(u32, t.CP_UTF8), 0, &info.szDevice[0], cast(i32, 0 - 1), cast(*i8, &name[0]), 32,
                                                cast(*i8, 0), cast(*i32, 0));
    if (bytes > 0) { monitor.set_name(out, &name[0], cast(i64, bytes)); }
    let is t.DEVMODEW as mode;
    mem.memzero(cast(*u8, &mode), sizeof(t.DEVMODEW));
    mode.dmSize = cast(u16, sizeof(t.DEVMODEW));
    if (u.EnumDisplaySettingsW(&info.szDevice[0], cast(u32, t.ENUM_CURRENT_SETTINGS), &mode) != 0 && mode.dmDisplayFrequency > cast(u32, 1)) {
        out.refresh_mhz = cast(i64, mode.dmDisplayFrequency) * 1000;
    }
    return 1;
}

fn popup_done(w as *Window) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    return n.popup_done;
}

// Whether the popup holds the capture's place in the grab stack.
fn grabbing(w as *Window) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; }
    return _grabbed(n);
}

// The client put at x, y of the screen and made cw by ch, the frame round it
// as the window's style and DPI make it. 1 when moved.
fn move_resize(w as *Window, x as i64, y as i64, cw as i64, ch as i64) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0 || cw <= 0 || ch <= 0 || cw > 16384 || ch > 16384) { return 0; }
    if (n.fixed == 1) { n.min_width = cw; n.max_width = cw; n.min_height = ch; n.max_height = ch; }
    let is t.RECT as r; r.left = 0; r.top = 0; r.right = cast(i32, cw); r.bottom = cast(i32, ch);
    let is u32 as style = cast(u32, u.GetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_STYLE)));
    let is u32 as ex = cast(u32, u.GetWindowLongPtrW(w.hwnd, cast(i32, t.GWL_EXSTYLE)));
    if (u.AdjustWindowRectExForDpi(&r, style, 0, ex, cast(u32, n.dpi)) == 0) { return 0; }
    return cast(i32, u.SetWindowPos(w.hwnd, 0, cast(i32, x) + r.left, cast(i32, y) + r.top, r.right - r.left, r.bottom - r.top,
                                    cast(u32, t.SWP_NOZORDER | t.SWP_NOACTIVATE)) != 0);
}

fn position(w as *Window, x as *i64, y as *i64) as i32 {
    if (is_open(w) == 0) { return 0; }
    let is t.POINT as p; p.x = 0; p.y = 0;
    if (u.ClientToScreen(w.hwnd, &p) == 0) { return 0; }
    *x = p.x; *y = p.y; return 1;
}

fn clipboard_set(w as *Window, which as i32, text as *u8, length as i64) as i32 {
    if (is_open(w) == 0 || which != 0) { return 0; }
    return clipboard.set(w.hwnd, text, length);
}
fn clipboard_request(w as *Window, which as i32) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0 || which != 0) { return 0; }
    return clipboard.request(&n.clip, w.hwnd);
}
fn clipboard_ready(w as *Window) as i32 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return n.clip.ready;
}
fn clipboard_text(w as *Window, out as *u8, cap as i64) as i64 {
    let is *Native as n = _native(w); if (cast(i64, n) == 0) { return 0; } return clipboard.read(&n.clip, out, cap);
}
// The Windows clipboard answers request() at once: nothing is ever awaited.
fn clipboard_pending(w as *Window) as i32 { return 0; }

fn transport_name(w as *Window) as *u8 { return "win32"; }

// Its icon: argb, iw by ih, 0xAARRGGBB a pixel — the byte order a top-down
// 32-bit DIB keeps in memory — given for both icon sizes. 1 when set.
fn set_icon(w as *Window, argb as *u8, iw as i64, ih as i64) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0 || cast(i64, argb) == 0 || iw <= 0 || ih <= 0 || iw > 256 || ih > 256) { return 0; }
    let is t.BITMAPINFO as bmi;
    mem.memzero(cast(*u8, &bmi), sizeof(t.BITMAPINFO));
    bmi.bmiHeader.biSize = cast(u32, sizeof(t.BITMAPINFOHEADER));
    bmi.bmiHeader.biWidth = cast(i32, iw);
    bmi.bmiHeader.biHeight = cast(i32, 0 - ih);
    bmi.bmiHeader.biPlanes = cast(u16, 1);
    bmi.bmiHeader.biBitCount = cast(u16, 32);
    bmi.bmiHeader.biCompression = cast(u32, t.BI_RGB);
    let is *u8 as bits with mut = cast(*u8, 0);
    let is i64 as color = g.CreateDIBSection(0, &bmi, cast(u32, t.DIB_RGB_COLORS), &bits, 0, 0);
    if (color == 0 || cast(i64, bits) == 0) { if (color != 0) { g.DeleteObject(color); } return 0; }
    mem.memcpy(bits, argb, iw * ih * 4);
    // The mask is unused where the colour bitmap has alpha; it must exist.
    let is i64 as mask = g.CreateBitmap(cast(i32, iw), cast(i32, ih), 1, 1, cast(*u8, 0));
    let is t.ICONINFO as info;
    mem.memzero(cast(*u8, &info), sizeof(t.ICONINFO));
    info.fIcon = 1;
    info.hbmMask = mask;
    info.hbmColor = color;
    let is i64 as icon = u.CreateIconIndirect(&info);
    g.DeleteObject(color);
    if (mask != 0) { g.DeleteObject(mask); }
    if (icon == 0) { return 0; }
    u.SendMessageW(w.hwnd, cast(u32, t.WM_SETICON), cast(u64, t.ICON_BIG), icon);
    u.SendMessageW(w.hwnd, cast(u32, t.WM_SETICON), cast(u64, t.ICON_SMALL), icon);
    if (n.icon != 0) { u.DestroyIcon(n.icon); }
    n.icon = icon;
    return 1;
}

// The shadow round a frame of the program's own, physical pixels each side:
// what the window really is lies inside it. 1 when told.
fn set_frame_extents(w as *Window, left as i64, right as i64, top as i64, bottom as i64) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0 || left < 0 || right < 0 || top < 0 || bottom < 0) { return 0; }
    n.extent_left = left; n.extent_right = right; n.extent_top = top; n.extent_bottom = bottom;
    return 1;
}

// Where it takes the pointer, client pixels: elsewhere hit-testing answers
// HTTRANSPARENT and the press goes to what lies beneath. 1 when told.
fn set_input_region(w as *Window, x as i64, y as i64, rw as i64, rh as i64) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0 || rw < 0 || rh < 0) { return 0; }
    n.region_on = 1; n.region_x = x; n.region_y = y; n.region_w = rw; n.region_h = rh;
    return 1;
}

fn input_region(w as *Window, x as *i64, y as *i64, rw as *i64, rh as *i64) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0 || n.region_on == 0) { return 0; }
    *x = n.region_x; *y = n.region_y; *rw = n.region_w; *rh = n.region_h;
    return 1;
}

// Moved (8) or resized from an edge (0 NW … 7 W, numbered as EWMH numbers
// them) by the system's own loop, from a left-button press at x, y in the
// window. The press is the system's from here: the button is no longer held
// for the program. 1 when asked.
fn begin_move_resize(w as *Window, x as i64, y as i64, how as i64, button as i64) as i32 {
    let is *Native as n = _native(w);
    if (cast(i64, n) == 0 || button != 1 || how < 0 || how > 8) { return 0; }
    let is i64 as command with mut = t.SC_MOVE | t.HTCAPTION;
    if (how == 0) { command = t.SC_SIZE | t.WMSZ_TOPLEFT; }
    else if (how == 1) { command = t.SC_SIZE | t.WMSZ_TOP; }
    else if (how == 2) { command = t.SC_SIZE | t.WMSZ_TOPRIGHT; }
    else if (how == 3) { command = t.SC_SIZE | t.WMSZ_RIGHT; }
    else if (how == 4) { command = t.SC_SIZE | t.WMSZ_BOTTOMRIGHT; }
    else if (how == 5) { command = t.SC_SIZE | t.WMSZ_BOTTOM; }
    else if (how == 6) { command = t.SC_SIZE | t.WMSZ_BOTTOMLEFT; }
    else if (how == 7) { command = t.SC_SIZE | t.WMSZ_LEFT; }
    let is t.POINT as p; p.x = cast(i32, x); p.y = cast(i32, y);
    u.ClientToScreen(w.hwnd, &p);
    let is i64 as at = (cast(i64, p.x) & 65535) | ((cast(i64, p.y) & 65535) << 16);
    if (u.PostMessageW(w.hwnd, cast(u32, t.WM_SYSCOMMAND), cast(u64, command), at) == 0) { return 0; }
    // The press is the system's from here: no release will come, so the
    // input says the button is up, taken. The capture is let go before the
    // posted command runs: the system's move takes the pointer itself.
    if ((n.buttons & 1) != 0) {
        let is ie.Event as up = _input(ie.BUTTON_UP);
        up.button = 1;
        up.detail = ie.BUTTON_TAKEN;
        up.x = x;
        up.y = y;
        _push(n, &up, cast(*u8, 0), 0);
    }
    n.buttons = n.buttons & cast(i32, 0 - 2);
    u.ReleaseCapture();
    return 1;
}

// The system menu — restore, move, size, minimize, maximize, close — at x, y
// in the window, shown from its own thread's next dispatch. 1 when asked.
fn show_window_menu(w as *Window, x as i64, y as i64) as i32 {
    if (is_open(w) == 0) { return 0; }
    let is t.POINT as p; p.x = cast(i32, x); p.y = cast(i32, y);
    u.ClientToScreen(w.hwnd, &p);
    let is i64 as at = (cast(i64, p.x) & 65535) | ((cast(i64, p.y) & 65535) << 16);
    return cast(i32, u.PostMessageW(w.hwnd, cast(u32, _WM_WINDOW_MENU), 0, at) != 0);
}

fn _window_menu(n as *Native, at as i64) as void {
    let is i64 as menu = u.GetSystemMenu(n.hwnd, 0);
    if (menu == 0) { return; }
    u.SetForegroundWindow(n.hwnd);
    let is i32 as chosen = u.TrackPopupMenu(menu, cast(u32, t.TPM_RETURNCMD | t.TPM_RIGHTBUTTON),
                                           cast(i32, _signed16(cast(u64, at))), cast(i32, _signed16(cast(u64, at) >> 16)),
                                           0, n.hwnd, cast(*t.RECT, 0));
    if (chosen != 0) { u.PostMessageW(n.hwnd, cast(u32, t.WM_SYSCOMMAND), cast(u64, chosen), 0); }
}

fn read_settings(w as *Window, out as *desktop_settings.settings.Settings) as i32 {
    *out = desktop_settings.read();
    return 1;
}
