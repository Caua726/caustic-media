// window/win32/bell_test.cst — a Windows window's bell, rung through the
// portable device (MessageBeep). Heard where Wine draws, on its X server, by
// a watcher of the server's bells:
//   sh tools/wine_session.sh sh window/win32/tools/bell_heard.sh build/win32_bell_test.exe
// Exit 0 when the window opened and the bell was rung.
use "std/io.cst" as io;
use "../device.cst" as device;

fn main() as i32 {
    let is device.Window as w with mut = device.open("bell", 160, 100);
    if (device.is_open(&w) == 0) {
        io.printf("FAIL: no window\n");
        return 1;
    }
    let is i32 as rung = device.bell(&w);
    device.close(&w);
    if (rung == 1) { io.printf("win32 bell: rung\n"); return 0; }
    io.printf("FAIL: the bell not rung\n");
    return 1;
}
