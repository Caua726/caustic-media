use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "device.cst" as device;
use "event.cst" as event;
use "../gpu/software/target.cst" as tgt;

let is i32 as failures with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("  FAIL: %s\n", name);
        failures = failures + 1;
    }
}

fn same(a as *u8, b as *u8, n as i64) as i32 {
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

fn wait_maximized(w as *device.Window, want as i32) as i32 {
    let is i32 as tries with mut = 0;
    let is i32 as resize_pending with mut = 0;
    let is event.Event as e;
    while (tries < 16) {
        let is i32 as next = device.next_frame(w);
        if (next == 0) { return 0; }
        device.pump(w);
        if (device.resized(w) == 1) { resize_pending = 1; }
        if (resize_pending == 1) {
            let is tgt.Target as t = device.acquire(w);
            if (cast(i64, t.color) != 0) {
                device.submit(w);
                resize_pending = 0;
            }
        }
        while (device.poll_event(w, &e) == 1) { }
        let is i32 as current_state with mut = 0;
        if ((device.state(w) & event.STATE_MAXIMIZED) != 0) { current_state = 1; }
        if (current_state == want && resize_pending == 0) { return 1; }
        tries = tries + 1;
    }
    let is i32 as final_state with mut = 0;
    if ((device.state(w) & event.STATE_MAXIMIZED) != 0) { final_state = 1; }
    return final_state == want && resize_pending == 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is *u8 as requested_scale = env.getenv("WESTON_SCALE");
    let is i32 as expected_scale with mut = 1;
    if (cast(i64, requested_scale) != 0 && requested_scale[0] == 50) { expected_scale = 2; }
    check("Wayland backend is available", device.available(device.WAYLAND) == 1);
    let is device.Window as w = device.open("device Wayland test", 320, 200);
    check("AUTO selects the Wayland socket", w.ok == 1 && w.backend == device.WAYLAND);
    check("the public transport and descriptor", same(device.transport_name(&w), "wayland", 8) == 1 && device.connection_fd(&w) >= 0);
    check("configured dimensions", device.width(&w) > 0 && device.height(&w) > 0);
    check("first frame", device.next_frame(&w) == 1);
    let is tgt.Target as t = device.acquire(&w);
    check("software target dimensions", t.width == device.width(&w) && t.height == device.height(&w) && cast(i64, t.color) != 0);
    if (cast(i64, t.color) != 0) { tgt.put(&t, 3, 4, 4294901760); }
    device.submit(&w);
    check("compositor frame callback", device.next_frame(&w) == 1);
    device.pump(&w);
    check("entered output scale is applied", device.scale_120(&w) == expected_scale * 120);
    check("buffer dimensions follow output scale",
          device.width(&w) == 320 * expected_scale && device.height(&w) == 200 * expected_scale);
    if (device.width(&w) != t.width || device.height(&w) != t.height) {
        let is tgt.Target as scaled = device.acquire(&w);
        check("scaled software target dimensions",
              scaled.width == device.width(&w) && scaled.height == device.height(&w) && cast(i64, scaled.color) != 0);
        if (cast(i64, scaled.color) != 0) {
            device.submit(&w);
            check("scaled frame callback", device.next_frame(&w) == 1);
            device.pump(&w);
        }
    }
    device.hide(&w);
    device.show(&w);
    check("hide and show keep the surface usable", device.next_frame(&w) == 1 && device.is_open(&w) == 1);
    device.set_title(&w, "Updated", 7);
    check("visible frame geometry request", device.set_frame_extents(&w, 4, 4, 24, 4) == 1);
    check("input region request", device.set_input_region(&w, 0, 24, 320, 176) == 1);
    let is i64 as rx with mut = 0; let is i64 as ry with mut = 0;
    let is i64 as rw with mut = 0; let is i64 as rh with mut = 0;
    check("input region query", device.input_region(&w, &rx, &ry, &rw, &rh) == 1 && rx == 0 && ry == 24 && rw == 320 && rh == 176);
    check("move needs compositor input serial", device.begin_move_resize(&w, 0, 0, device.MOVE, 1) == 0);
    check("window menu needs compositor input serial", device.show_window_menu(&w, 0, 0) == 0);
    check("cursor waits for a pointer enter serial", device.cursor_set(&w, 4) == 0);
    check("minimum size request", device.set_min_size(&w, 120, 90) == 1);
    let is i64 as min_w with mut = 0; let is i64 as min_h with mut = 0;
    check("minimum size query", device.min_size(&w, &min_w, &min_h) == 1 && min_w == 120 && min_h == 90);
    check("maximum size request", device.set_max_size(&w, 640, 480) == 1);
    check("maximize request", device.set_maximized(&w, 1) == 1);
    check("maximized state is reported", wait_maximized(&w, 1) == 1);
    check("restore request", device.set_maximized(&w, 0) == 1);
    check("maximized state clears", wait_maximized(&w, 0) == 1);
    check("fullscreen and restore requests", device.set_fullscreen(&w, 1) == 1 && device.set_fullscreen(&w, 0) == 1);

    let is device.Config as c = device.config("dialog", 200, 100);
    c.backend = device.WAYLAND;
    c.owner = &w;
    c.dialog = 1;
    c.modal = 1;
    c.resizable = 0;
    let is device.Window as child = device.open_config(&c);
    check("transient child opens", child.ok == 1);
    check("child's fixed initial frame", device.next_frame(&child) == 1);
    let is tgt.Target as ct = device.acquire(&child);
    check("child uses configured shm dimensions", ct.width == 200 && ct.height == 100 && cast(i64, ct.color) != 0);
    device.submit(&child);
    check("child frame is accepted by compositor", device.next_frame(&child) == 1);
    device.pump(&child);
    check("child remains connected after parent and size requests", device.is_open(&child) == 1);

    device.request_close(&child);
    check("programmatic close request is visible", device.should_close(&child) == 1);
    let is event.Event as e;
    let is i32 as saw_close with mut = 0;
    while (device.poll_event(&child, &e) == 1) {
        if (e.kind == event.CLOSE) { saw_close = 1; }
    }
    check("programmatic close event", saw_close == 1);
    device.keep_open(&child);
    check("close request can be kept open", device.should_close(&child) == 0);

    device.close(&child);
    check("minimize request", device.minimize(&w) == 1);
    device.close(&w);
    check("windows close", device.is_open(&child) == 0 && device.is_open(&w) == 0);
    if (failures == 0) { io.printf("device Wayland: all checks passed\n"); }
    return cast(i32, failures != 0);
}
