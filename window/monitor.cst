// window/monitor.cst — the monitor a window is on, as its platform says it
// (display.monitor_of fills it in).
//
// Places and sizes are physical pixels on the plane the platform lays its
// monitors out on: the X screen's, the Windows virtual desktop's, the
// Wayland compositor's (whose wl_output places them; a compositor may say
// 0, 0 for each). The work area is where windows are put — no panel or
// taskbar over it; where the platform does not say (Wayland), the whole
// monitor.
struct Monitor {
    x as i64;
    y as i64;
    width as i64;
    height as i64;
    work_x as i64;
    work_y as i64;
    work_width as i64;
    work_height as i64;
    scale120 as i32;     // physical pixels per logical one, times 120
    primary as i32;      // the platform's primary monitor (never on Wayland)
    refresh_mhz as i64;  // millihertz: 59940 is 59.94 Hz; 0 unknown
    name as [32]u8;      // "HDMI-1", "\\.\DISPLAY1": NUL-terminated, cut short if longer
}

fn clear(m as *Monitor) as void {
    m.x = 0; m.y = 0; m.width = 0; m.height = 0;
    m.work_x = 0; m.work_y = 0; m.work_width = 0; m.work_height = 0;
    m.scale120 = 120;
    m.primary = 0;
    m.refresh_mhz = 0;
    m.name[0] = cast(u8, 0);
}

// Its name: n bytes of s, cut at 31.
fn set_name(m as *Monitor, s as *u8, n as i64) as void {
    let is i64 as k with mut = 0;
    while (k < n && k < 31 && s[k] != 0) {
        m.name[k] = s[k];
        k = k + 1;
    }
    m.name[k] = cast(u8, 0);
}

// The work area the whole monitor, where the platform says none.
fn work_is_whole(m as *Monitor) as void {
    m.work_x = m.x;
    m.work_y = m.y;
    m.work_width = m.width;
    m.work_height = m.height;
}
