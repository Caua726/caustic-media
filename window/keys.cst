// window/keys.cst — portable key definitions across all backends.
//
// Printable ASCII values for letters, digits and punctuation, plus the standard
// named keys (ESCAPE, RETURN, TAB, ARROWS, MODIFIERS, FUNCTION KEYS).

let is i32 as UNKNOWN with imut = 0;

// Latin-1 printable (ASCII in this range)
let is i32 as SPACE         with imut = 32;
let is i32 as APOSTROPHE    with imut = 39;
let is i32 as COMMA         with imut = 44;
let is i32 as MINUS         with imut = 45;
let is i32 as PERIOD        with imut = 46;
let is i32 as SLASH         with imut = 47;
let is i32 as NUM_0         with imut = 48;
let is i32 as NUM_1         with imut = 49;
let is i32 as NUM_2         with imut = 50;
let is i32 as NUM_3         with imut = 51;
let is i32 as NUM_4         with imut = 52;
let is i32 as NUM_5         with imut = 53;
let is i32 as NUM_6         with imut = 54;
let is i32 as NUM_7         with imut = 55;
let is i32 as NUM_8         with imut = 56;
let is i32 as NUM_9         with imut = 57;
let is i32 as SEMICOLON     with imut = 59;
let is i32 as EQUAL         with imut = 61;
let is i32 as LEFT_BRACKET  with imut = 91;
let is i32 as BACKSLASH     with imut = 92;
let is i32 as RIGHT_BRACKET with imut = 93;
let is i32 as GRAVE         with imut = 96;

let is i32 as A with imut = 97;
let is i32 as B with imut = 98;
let is i32 as C with imut = 99;
let is i32 as D with imut = 100;
let is i32 as E with imut = 101;
let is i32 as F with imut = 102;
let is i32 as G with imut = 103;
let is i32 as H with imut = 104;
let is i32 as I with imut = 105;
let is i32 as J with imut = 106;
let is i32 as K with imut = 107;
let is i32 as L with imut = 108;
let is i32 as M with imut = 109;
let is i32 as N with imut = 110;
let is i32 as O with imut = 111;
let is i32 as P with imut = 112;
let is i32 as Q with imut = 113;
let is i32 as R with imut = 114;
let is i32 as S with imut = 115;
let is i32 as T with imut = 116;
let is i32 as U with imut = 117;
let is i32 as V with imut = 118;
let is i32 as W with imut = 119;
let is i32 as X with imut = 120;
let is i32 as Y with imut = 121;
let is i32 as Z with imut = 122;

// Special keys
let is i32 as BACKSPACE with imut = 65288;
let is i32 as TAB       with imut = 65289;
let is i32 as RETURN    with imut = 65293;
let is i32 as PAUSE     with imut = 65299;
let is i32 as ESCAPE    with imut = 65307;
let is i32 as HOME      with imut = 65360;
let is i32 as LEFT      with imut = 65361;
let is i32 as UP        with imut = 65362;
let is i32 as RIGHT     with imut = 65363;
let is i32 as DOWN      with imut = 65364;
let is i32 as PAGE_UP   with imut = 65365;
let is i32 as PAGE_DOWN with imut = 65366;
let is i32 as END       with imut = 65367;
let is i32 as INSERT    with imut = 65379;
let is i32 as MENU      with imut = 65383;
let is i32 as NUM_LOCK  with imut = 65407;

// Function keys
let is i32 as F1  with imut = 65470;
let is i32 as F2  with imut = 65471;
let is i32 as F3  with imut = 65472;
let is i32 as F4  with imut = 65473;
let is i32 as F5  with imut = 65474;
let is i32 as F6  with imut = 65475;
let is i32 as F7  with imut = 65476;
let is i32 as F8  with imut = 65477;
let is i32 as F9  with imut = 65478;
let is i32 as F10 with imut = 65479;
let is i32 as F11 with imut = 65480;
let is i32 as F12 with imut = 65481;

// Modifiers
let is i32 as SHIFT_L   with imut = 65505;
let is i32 as SHIFT_R   with imut = 65506;
let is i32 as CONTROL_L with imut = 65507;
let is i32 as CONTROL_R with imut = 65508;
let is i32 as CAPS_LOCK with imut = 65509;
let is i32 as ALT_L     with imut = 65513;
let is i32 as ALT_R     with imut = 65514;
let is i32 as SUPER_L   with imut = 65515;
let is i32 as SUPER_R   with imut = 65516;
let is i32 as DELETE    with imut = 65535;

// Modifier masks
let is i32 as MOD_SHIFT   with imut = 1;
let is i32 as MOD_LOCK    with imut = 2;
let is i32 as MOD_CONTROL with imut = 4;
let is i32 as MOD_ALT     with imut = 8;
let is i32 as MOD_SUPER   with imut = 64;
