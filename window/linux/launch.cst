// window/linux/launch.cst — what the program that started this one left in
// its environment for its first window: XDG_ACTIVATION_TOKEN (Wayland's
// xdg-activation) or DESKTOP_STARTUP_ID (X11's startup notification). Taken
// once — read and removed — so the programs this one starts in turn do not
// inherit a token that is not theirs.
use "std/env.cst" as env;
use "std/mem.cst" as mem;

// name's value into out (cap bytes, zero-terminated) and the variable gone
// from the environment: its length, 0 when it was not there, was empty or
// did not fit — gone all the same, since nobody else may use it.
fn take(name as *u8, out as *u8, cap as i64) as i64 {
    let is *u8 as value = env.getenv(name);
    if (cast(i64, value) == 0) { return 0; }
    let is i64 as n with mut = 0;
    while (value[n] != 0) { n = n + 1; }
    // Only the environment's array changes: the value's bytes stay where
    // they are, read below.
    _remove(name);
    if (n == 0 || n >= cap) { return 0; }
    mem.memcpy(out, value, n);
    out[n] = 0;
    return n;
}

// The entry "name=..." taken out of the environment's array, those after it
// moved down.
fn _remove(name as *u8) as void {
    let is *u8 as base = env.envp();
    if (cast(i64, base) == 0) { return; }
    let is *i64 as ptrs = cast(*i64, base);
    let is i64 as len with mut = 0;
    while (name[len] != 0) { len = len + 1; }
    let is i64 as i with mut = 0;
    while (ptrs[i] != 0) {
        let is *u8 as entry = cast(*u8, ptrs[i]);
        if (mem.memcmp(entry, name, len) == 0 && entry[len] == 61) {
            let is i64 as j with mut = i;
            while (ptrs[j] != 0) { ptrs[j] = ptrs[j + 1]; j = j + 1; }
            return;
        }
        i = i + 1;
    }
}
