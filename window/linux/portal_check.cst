// window/linux/portal_check.cst — what this desktop's settings are, read the
// way a program would: settings.ini, then the portal over the session bus.
// Read-only; run by hand, since a machine without a desktop has no portal.
//
//   caustic window/linux/portal_check.cst -o build/portal_check && ./build/portal_check
use "std/io.cst" as io;
use "std/env.cst" as env;
use "../../dbus/dbus.cst" as dbus;
use "../settings.cst" as settings;
use "gtk_ini.cst" as gtk_ini;
use "portal.cst" as portal;

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is settings.Settings as s with mut = settings.defaults();
    let is settings.Settings as files with mut = settings.defaults();
    io.printf("settings.ini files: %d\n", cast(i64, gtk_ini.read_user(&files)));
    settings.merge(&s, &files);
    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    let is dbus.conn.Conn as c with mut = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&c) == 0) {
        io.printf("no session bus (error %d)\n", cast(i64, dbus.conn.last_error(&c)));
    } else {
        io.printf("session bus: connected as %s\n", dbus.conn.unique_name(&c));
        io.printf("portal: %d\n", cast(i64, portal.read(&c, portal.DESKTOP, &s)));
        dbus.conn.close(&c);
    }
    io.printf("dark %d, high contrast %d, animations %d, blink %d every %d ms\n", cast(i64, s.dark),
              cast(i64, s.high_contrast), cast(i64, s.animations), cast(i64, s.blink), s.blink_ms);
    io.printf("accent %d %d %d (of 1000)\n", cast(i64, s.accent_r * 1000.0), cast(i64, s.accent_g * 1000.0),
              cast(i64, s.accent_b * 1000.0));
    io.printf("font '%s' %d/10 pt, mono '%s' %d/10 pt, text scale %d/100\n", cast(*u8, &s.font),
              cast(i64, s.font_size * 10.0), cast(*u8, &s.mono), cast(i64, s.mono_size * 10.0),
              cast(i64, s.text_scale * 100.0));
    io.printf("double click %d ms, drag %d px, cursor '%s' %d, buttons '%s'\n", s.double_click_ms, s.drag_px,
              cast(*u8, &s.cursor_theme), s.cursor_size, cast(*u8, &s.button_layout));
    io.printf("known: %d\n", s.known);
    return 0;
}
