// window/linux/filechooser_test.cst — the desktop's file chooser through
// the XDG portal, played by a child process on a private bus
// (dbus/tools/run_dbus.sh), never the desktop's.
//
// The child owns org.freedesktop.portal.Desktop and answers OpenFile and
// SaveFile as the portal does: a request's path back, then a Response signal
// on it — later, at once (before the reply, which a client subscribed in
// time still hears), or on a path of its own, as portals older than
// handle_token have it. It writes down what it was asked, for the test to
// compare.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "std/time.cst" as time;
use "../../dbus/dbus.cst" as dbus;
use "portal.cst" as portal;
use "filechooser.cst" as files;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(a as *u8, b as *u8) as i32 { return dbus.message.named(a, b); }

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (b[i] == 0 || a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, b[n] == 0);
}

// --- The fake portal ---

// How it answers: 0 later, 1 at once, 2 later on a path of its own, 3 never.
let is i64 as answer with mut = 0;
let is i64 as code with mut = 0;      // the response: 0 chosen, 1 cancelled, 2 other
// What it gives back: 0 two files, 1 odd ones, 2 more than a request keeps,
// 3 a filter left chosen and keys it does not know, 4 results of the wrong
// types, 5 more bytes than a request keeps, 6 and 7 a filter named with 64
// and 65 bytes left chosen.
let is i64 as gives with mut = 0;
let is i32 as quit with mut = 0;
let is i64 as closed with mut = 0;

// What it was asked, last.
let is [2048]u8 as asked with mut;
let is i64 as an with mut = 0;

fn put(s as *u8, n as i64) as void {
    if (an + n >= 2048) { return; }
    mem.memcpy(cast(*u8, cast(i64, &asked) + an), s, n);
    an = an + n;
    asked[an] = cast(u8, 0);
}

fn puts(s as *u8) as void { put(s, len(s)); }

fn putu(v as i64) as void {
    let is [24]u8 as b;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    if (x == 0) { puts("0"); return; }
    let is [24]u8 as rev;
    while (x > 0) {
        rev[n] = cast(u8, 48 + x % 10);
        n = n + 1;
        x = x / 10;
    }
    let is i64 as k with mut = 0;
    while (n > 0) {
        n = n - 1;
        b[k] = rev[n];
        k = k + 1;
    }
    put(cast(*u8, &b), k);
}

// A filter, (sa(us)): "name:0*.txt 0*.md".
fn put_filter(r as *dbus.wire.Reader) as void {
    let is i64 as n with mut = 0;
    dbus.wire.get_struct(r);
    let is *u8 as name = dbus.wire.get_string(r, &n);
    put(name, n);
    puts(":");
    let is i64 as end = dbus.wire.get_array(r, 8);
    let is i32 as first with mut = 1;
    while (r.err == 0 && r.pos < end) {
        dbus.wire.get_struct(r);
        let is i64 as kind = dbus.wire.get_u32(r);
        let is *u8 as pat = dbus.wire.get_string(r, &n);
        if (first == 0) { puts(" "); }
        putu(kind);
        put(pat, n);
        first = 0;
    }
}

let is [256]u8 as token with mut;
let is i64 as token_len with mut = 0;

// The options, a{sv}, written down as "key=value," in the order sent.
fn put_options(r as *dbus.wire.Reader) as void {
    let is i64 as n with mut = 0;
    let is i64 as end = dbus.wire.get_array(r, 8);
    token_len = 0;
    while (r.err == 0 && r.pos < end) {
        dbus.wire.get_struct(r);
        let is *u8 as key = dbus.wire.get_string(r, &n);
        put(key, n);
        puts("=");
        let is i64 as sn with mut = 0;
        let is *u8 as sig = dbus.wire.get_variant(r, &sn);
        if (eq(sig, "s") == 1) {
            let is *u8 as v = dbus.wire.get_string(r, &n);
            put(v, n);
            if (eq(key, "handle_token") == 1 && n < 255) {
                mem.memcpy(cast(*u8, &token), v, n);
                token[n] = cast(u8, 0);
                token_len = n;
            }
        } else if (eq(sig, "b") == 1) {
            if (dbus.wire.get_bool(r) == 1) { puts("true"); } else { puts("false"); }
        } else if (eq(sig, "ay") == 1) {
            let is i64 as e = dbus.wire.get_array(r, 1);
            while (r.err == 0 && r.pos < e) {
                let is i64 as b = dbus.wire.get_byte(r);
                if (b == 0) { puts("\\0"); } else {
                    let is [1]u8 as one;
                    one[0] = cast(u8, b);
                    put(cast(*u8, &one), 1);
                }
            }
        } else if (eq(sig, "a(sa(us))") == 1) {
            let is i64 as e = dbus.wire.get_array(r, 8);
            while (r.err == 0 && r.pos < e) {
                puts("[");
                put_filter(r);
                puts("]");
            }
        } else if (eq(sig, "(sa(us))") == 1) {
            put_filter(r);
        } else {
            puts("?");
            dbus.wire.skip(r, sig, sn);
        }
        puts(",");
    }
}

// The request's path: the caller's unique name without its ':' and with
// '_' for '.', and the token it chose.
let is [512]u8 as request with mut;
let is i64 as pending with mut = 0;
let is i64 as pending_at with mut = 0;   // not before then: a person takes a while

fn request_path(sender as *u8) as void {
    let is *u8 as base = "/org/freedesktop/portal/desktop/request/";
    let is i64 as k with mut = len(base);
    mem.memcpy(cast(*u8, &request), base, k);
    let is i64 as i with mut = 1;
    while (sender[i] != 0) {
        if (sender[i] == cast(u8, 46)) { request[k] = cast(u8, 95); } else { request[k] = sender[i]; }
        k = k + 1;
        i = i + 1;
    }
    request[k] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &request) + k + 1), cast(*u8, &token), token_len + 1);
}

fn uri_list(w as *dbus.wire.Writer) as void {
    let is i64 as a = dbus.wire.put_array(w, 4);
    if (gives == 0 || gives == 3) {
        dbus.wire.put_string(w, "file:///tmp/one%20two/three.txt");
        dbus.wire.put_string(w, "file://localhost/srv/caf%C3%A9.md");
    } else if (gives == 1) {
        dbus.wire.put_string(w, "https://example.com/a");
        dbus.wire.put_string(w, "file://elsewhere/x");
        dbus.wire.put_string(w, "file:///bad%zz");
        dbus.wire.put_string(w, "file:///nul%00x");
        dbus.wire.put_string(w, "file:///cut%4");
        dbus.wire.put_string(w, "file:///a%2Fb%2fc");
        dbus.wire.put_string(w, "file:///");
        dbus.wire.put_string(w, "file://localhost");
        dbus.wire.put_string(w, "file:///x%3ay%09z");
        dbus.wire.put_string(w, "file:///ab%41");
    } else if (gives == 2) {
        let is i64 as i with mut = 0;
        while (i < 200) {
            dbus.wire.put_string(w, "file:///tmp/many");
            i = i + 1;
        }
    } else if (gives == 5) {
        // 65 of 256 bytes: 64 fill a request's bytes exactly.
        let is [256]u8 as big;
        mem.memcpy(cast(*u8, &big), "file:///", 8);
        mem.memset(cast(*u8, cast(i64, &big) + 8), 98, 248);
        let is i64 as i with mut = 0;
        while (i < 65) {
            dbus.wire.put_string_n(w, cast(*u8, &big), 256);
            i = i + 1;
        }
    }
    dbus.wire.put_array_end(w, a, 4);
}

let is [65]u8 as long_name with mut;

fn respond(c as *dbus.conn.Conn) as void {
    mem.memset(cast(*u8, &long_name), 70, 65);
    let is *dbus.wire.Writer as w = dbus.conn.body(c);
    dbus.wire.put_u32(w, code);
    let is i64 as all = dbus.wire.put_array(w, 8);
    if (gives == 4) {
        dbus.wire.put_struct(w);
        dbus.wire.put_string(w, "uris");
        dbus.wire.put_variant(w, "s");
        dbus.wire.put_string(w, "file:///not/a/list");
        dbus.wire.put_struct(w);
        dbus.wire.put_string(w, "current_filter");
        dbus.wire.put_variant(w, "s");
        dbus.wire.put_string(w, "Text");
    } else {
        if (gives == 3) {
            // Choices, which nothing here asks for, before the files.
            dbus.wire.put_struct(w);
            dbus.wire.put_string(w, "choices");
            dbus.wire.put_variant(w, "a(ss)");
            let is i64 as ch = dbus.wire.put_array(w, 8);
            dbus.wire.put_struct(w);
            dbus.wire.put_string(w, "encoding");
            dbus.wire.put_string(w, "utf8");
            dbus.wire.put_array_end(w, ch, 8);
        }
        dbus.wire.put_struct(w);
        dbus.wire.put_string(w, "uris");
        dbus.wire.put_variant(w, "as");
        uri_list(w);
        if (gives == 3 || gives == 6 || gives == 7) {
            dbus.wire.put_struct(w);
            dbus.wire.put_string(w, "current_filter");
            dbus.wire.put_variant(w, "(sa(us))");
            dbus.wire.put_struct(w);
            if (gives == 3) { dbus.wire.put_string(w, "Markdown"); }
            if (gives == 6) { dbus.wire.put_string_n(w, cast(*u8, &long_name), 64); }
            if (gives == 7) { dbus.wire.put_string_n(w, cast(*u8, &long_name), 65); }
            let is i64 as pa = dbus.wire.put_array(w, 8);
            dbus.wire.put_struct(w);
            dbus.wire.put_u32(w, 0);
            dbus.wire.put_string(w, "*.md");
            dbus.wire.put_array_end(w, pa, 8);
        }
    }
    dbus.wire.put_array_end(w, all, 8);
    dbus.conn.emit(c, cast(*u8, &request), "org.freedesktop.portal.Request", "Response", "ua{sv}");
}

fn chooser(c as *dbus.conn.Conn, k as *dbus.conn.Call, method as *u8) as void {
    an = 0;
    asked[0] = cast(u8, 0);
    let is i64 as n with mut = 0;
    puts(method);
    puts("|");
    let is *u8 as parent = dbus.wire.get_string(&k.args, &n);
    put(parent, n);
    puts("|");
    let is *u8 as title = dbus.wire.get_string(&k.args, &n);
    put(title, n);
    puts("|");
    put_options(&k.args);
    request_path(k.msg.sender);
    if (answer == 2) {
        let is *u8 as old = "/org/freedesktop/portal/desktop/request/old/7";
        mem.memcpy(cast(*u8, &request), old, len(old) + 1);
    }
    dbus.wire.put_path(k.reply, cast(*u8, &request));
    if (answer == 1) {
        respond(c);
    } else if (answer != 3) {
        pending = 1;
        pending_at = time.now_ms();
        // On a path the client learns from the reply: time for it to listen.
        if (answer == 2) { pending_at = pending_at + 300; }
    }
}

fn m_open(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { chooser(c, k, "OpenFile"); }
fn m_save(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { chooser(c, k, "SaveFile"); }

// Set(what, value): 1 answer, 2 code, 3 gives.
fn m_set(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is i64 as what = dbus.wire.get_u32(&k.args);
    let is i64 as v = dbus.wire.get_u32(&k.args);
    if (what == 1) { answer = v; }
    if (what == 2) { code = v; }
    if (what == 3) { gives = v; }
}
fn m_asked(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { dbus.wire.put_string(k.reply, cast(*u8, &asked)); }
fn m_closed(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { dbus.wire.put_u32(k.reply, closed); }
fn m_quit(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { quit = 1; }

// A request's Close: the dialog gone, nothing said.
fn m_close(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    if (eq(k.msg.path, cast(*u8, &request)) == 1) { closed = closed + 1; }
}

let is [2]dbus.conn.Method as chooser_methods with mut;
let is [4]dbus.conn.Method as fake_methods with mut;
let is [1]dbus.conn.Method as request_methods with mut;
let is [2]dbus.conn.Interface as ifaces with mut;
let is [1]dbus.conn.Interface as request_ifaces with mut;

fn method(t as *dbus.conn.Method, name as *u8, ins as *u8, outs as *u8, h as dbus.conn.MethodFn) as void {
    t.name = name;
    t.in_sig = ins;
    t.out_sig = outs;
    t.handler = h;
    t.in_names = cast(*u8, 0);
    t.out_names = cast(*u8, 0);
}

fn iface(f as *dbus.conn.Interface, name as *u8, m as *dbus.conn.Method, n as i64) as void {
    f.name = name;
    f.methods = m;
    f.nmethods = n;
    f.props = cast(*dbus.conn.Property, 0);
    f.nprops = 0;
    f.signals = cast(*dbus.conn.SignalDecl, 0);
    f.nsignals = 0;
}

fn serve() as i64 {
    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    let is dbus.conn.Conn as c with mut = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&c) == 0) { return 2; }
    method(&chooser_methods[0], "OpenFile", "ssa{sv}", "o", fn_ptr(m_open));
    method(&chooser_methods[1], "SaveFile", "ssa{sv}", "o", fn_ptr(m_save));
    method(&fake_methods[0], "Set", "uu", "", fn_ptr(m_set));
    method(&fake_methods[1], "Asked", "", "s", fn_ptr(m_asked));
    method(&fake_methods[2], "Closed", "", "u", fn_ptr(m_closed));
    method(&fake_methods[3], "Quit", "", "", fn_ptr(m_quit));
    method(&request_methods[0], "Close", "", "", fn_ptr(m_close));
    iface(&ifaces[0], files.IFACE, cast(*dbus.conn.Method, &chooser_methods), 2);
    iface(&ifaces[1], "org.caustic.FakePortal", cast(*dbus.conn.Method, &fake_methods), 4);
    iface(&request_ifaces[0], files.REQUEST, cast(*dbus.conn.Method, &request_methods), 1);
    dbus.conn.export(&c, portal.PATH, cast(*dbus.conn.Interface, &ifaces), 2, cast(*u8, 0));
    if (dbus.conn.request_name(&c, portal.DESKTOP, 4) != 1) { return 3; }
    let is i64 as until = time.now_ms() + 20000;
    let is i32 as exported with mut = 0;
    while (quit == 0 && time.now_ms() < until) {
        if (dbus.conn.dispatch(&c, 50) < 0) { return 4; }
        // The request object, for Close; then the answer, after the reply.
        if (answer == 3 && token_len > 0 && exported == 0) {
            dbus.conn.export(&c, cast(*u8, &request), cast(*dbus.conn.Interface, &request_ifaces), 1, cast(*u8, 0));
            exported = 1;
        }
        if (pending == 1 && time.now_ms() >= pending_at) {
            pending = 0;
            respond(&c);
        }
    }
    dbus.conn.close(&c);
    return 0;
}

// --- The client ---

fn set(c as *dbus.conn.Conn, what as i64, v as i64) as void {
    let is dbus.message.Message as m with mut = dbus.message.method_call(portal.DESKTOP, portal.PATH,
                                                                        "org.caustic.FakePortal", "Set");
    m.signature = "uu";
    let is *dbus.wire.Writer as w = dbus.conn.body(c);
    dbus.wire.put_u32(w, what);
    dbus.wire.put_u32(w, v);
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    dbus.conn.call_method(c, &m, 2000, &rep);
}

// What the portal was asked, last, is s.
fn told(c as *dbus.conn.Conn, s as *u8) as i32 {
    let is dbus.message.Message as m with mut = dbus.message.method_call(portal.DESKTOP, portal.PATH,
                                                                        "org.caustic.FakePortal", "Asked");
    dbus.conn.body(c);
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    if (dbus.conn.call_method(c, &m, 2000, &rep) != dbus.conn.OK) { return 0; }
    let is dbus.wire.Reader as r with mut = dbus.message.body(&rep);
    let is i64 as n with mut = 0;
    let is *u8 as got = dbus.wire.get_string(&r, &n);
    if (same(got, n, s) == 0) {
        io.printf("  told: %s\n", got);
        return 0;
    }
    return 1;
}

fn closes(c as *dbus.conn.Conn) as i64 {
    let is dbus.message.Message as m with mut = dbus.message.method_call(portal.DESKTOP, portal.PATH,
                                                                        "org.caustic.FakePortal", "Closed");
    dbus.conn.body(c);
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    dbus.conn.call_method(c, &m, 2000, &rep);
    let is dbus.wire.Reader as r with mut = dbus.message.body(&rep);
    return dbus.wire.get_u32(&r);
}

fn has_owner(c as *dbus.conn.Conn) as i32 {
    let is dbus.message.Message as m with mut = dbus.message.method_call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                                                        "org.freedesktop.DBus", "NameHasOwner");
    m.signature = "s";
    dbus.wire.put_string(dbus.conn.body(c), portal.DESKTOP);
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    if (dbus.conn.call_method(c, &m, 1000, &rep) != dbus.conn.OK) { return 0; }
    let is dbus.wire.Reader as r with mut = dbus.message.body(&rep);
    return dbus.wire.get_bool(&r);
}

// Dispatches until the request is answered, or a second passes.
fn wait(c as *dbus.conn.Conn, q as *files.Request) as void {
    let is i64 as until = time.now_ms() + 1000;
    while (q.state == files.WAITING && time.now_ms() < until) { dbus.conn.dispatch(c, 20); }
}

fn path_is(q as *files.Request, i as i64, s as *u8) as i32 {
    let is [256]u8 as out;
    let is i64 as n = files.path(q, i, cast(*u8, &out), 256);
    return cast(i32, n > 0 && same(cast(*u8, &out), n, s) == 1);
}

fn no_path(q as *files.Request, i as i64) as i32 {
    let is [256]u8 as out;
    return cast(i32, files.path(q, i, cast(*u8, &out), 256) == 0);
}

let is files.Request as q with mut;

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i64 as pid = linux.fork();
    if (pid == 0) { linux.exit(serve()); }

    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    let is dbus.conn.Conn as c with mut = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&c) == 0) {
        io.printf("filechooser: no bus — run inside dbus/tools/run_dbus.sh\n");
        return 1;
    }
    let is i64 as until = time.now_ms() + 5000;
    while (has_owner(&c) == 0 && time.now_ms() < until) { dbus.conn.dispatch(&c, 20); }

    // --- Nobody there (a token used all the same) ---
    let is files.Options as o with mut = files.options();
    check("no portal: not asked", files.open_file(&c, "org.caustic.NoPortal", "", 0, "Open", 4, &o, &q) == 0 &&
          q.state == files.FAILED);
    files.close(&q);

    // --- Opening files: what the portal is told, and its answer ---
    o.accept = "_Choose";
    o.accept_len = 7;
    o.multiple = 1;
    o.folder = "/tmp/a";
    o.folder_len = 6;
    check("filters", files.add_filter(&o, "Text", 4, "*.txt;*.md", 10) == 0 && files.add_filter(&o, "All files", 9, "", 0) == 1);
    o.current = 0;
    check("asked", files.open_file(&c, portal.DESKTOP, "x11:2a", 6, "Pick some", 9, &o, &q) == 1 && q.state == files.WAITING);
    check("what the portal was told",
          told(&c, "OpenFile|x11:2a|Pick some|handle_token=caustic2,accept_label=_Choose,modal=true,multiple=true,directory=false,filters=[Text:0*.txt 0*.md][All files:0*],current_filter=Text:0*.txt 0*.md,current_folder=/tmp/a\\0,") == 1);
    wait(&c, &q);
    check("chosen", q.state == files.CHOSEN && files.count(&q) == 2 && q.more == 0);
    check("their paths, unescaped", path_is(&q, 0, "/tmp/one two/three.txt") == 1 && path_is(&q, 1, "/srv/caf\xc3\xa9.md") == 1);
    let is i64 as un with mut = 0;
    let is *u8 as u = files.uri(&q, 1, &un);
    check("and their URIs", same(u, un, "file://localhost/srv/caf%C3%A9.md") == 1 && cast(i64, files.uri(&q, 2, &un)) == 0 && un == 0);
    let is [8]u8 as tiny;
    let is [32]u8 as exact;
    check("a path that does not fit: none", files.path(&q, 0, cast(*u8, &tiny), 8) == 0 && no_path(&q, 2) == 1 &&
          no_path(&q, 0 - 1) == 1 && files.path(&q, 0, cast(*u8, &exact), 22) == 22 && files.path(&q, 0, cast(*u8, &exact), 21) == 0);
    check("no filter said", files.filter_index(&q, &o) == 0 - 1);
    files.close(&q);
    check("closed once answered: the portal not told", closes(&c) == 0);

    // --- Defaults; a folder; a title and a parent cut where they say ---
    let is files.Options as d with mut = files.options();
    d.directory = 1;
    check("a folder asked", files.open_file(&c, portal.DESKTOP, "", 0, "Folder", 6, &d, &q) == 1);
    check("told only what was set", told(&c, "OpenFile||Folder|handle_token=caustic3,modal=true,multiple=false,directory=true,") == 1);
    wait(&c, &q);
    files.close(&q);
    d.directory = 0;
    d.modal = 0;
    files.open_file(&c, portal.DESKTOP, "x11:2axx", 6, "Openxx", 4, &d, &q);
    check("modal or not", told(&c, "OpenFile|x11:2a|Open|handle_token=caustic4,modal=false,multiple=false,directory=false,") == 1);
    wait(&c, &q);
    files.close(&q);
    // Empty texts not told; empty patterns left out; no filter chosen at first.
    let is files.Options as e with mut = files.options();
    e.accept = "x";
    e.accept_len = 0;
    e.folder = "/x";
    e.folder_len = 0;
    files.add_filter(&e, "Two", 3, ";*.a;; *.b ", 11);
    files.add_filter(&e, "Other", 5, "*.c", 3);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &e, &q);
    check("empty texts and patterns: not told", told(&c,
          "OpenFile||Open|handle_token=caustic5,modal=true,multiple=false,directory=false,filters=[Two:0*.a 0*.b][Other:0*.c],") == 1);
    wait(&c, &q);
    files.close(&q);

    // --- Saving ---
    let is files.Options as s with mut = files.options();
    s.name = "new.txt";
    s.name_len = 7;
    s.folder = "/home/u";
    s.folder_len = 7;
    files.add_filter(&s, "Text", 4, "*.txt", 5);
    s.current = 1;
    check("saving asked", files.save_file(&c, portal.DESKTOP, "", 0, "Save", 4, &s, &q) == 1);
    check("what saving tells, not a filter past the last",
          told(&c, "SaveFile||Save|handle_token=caustic6,modal=true,filters=[Text:0*.txt],current_name=new.txt,current_folder=/home/u\\0,") == 1);
    wait(&c, &q);
    check("saved", q.state == files.CHOSEN && files.count(&q) == 2);
    files.close(&q);
    let is files.Options as s2 with mut = files.options();
    s2.name = "x";
    s2.name_len = 0;
    files.save_file(&c, portal.DESKTOP, "", 0, "Save", 4, &s2, &q);
    check("an empty name: not told", told(&c, "SaveFile||Save|handle_token=caustic7,modal=true,") == 1);
    wait(&c, &q);
    files.close(&q);

    // --- Answered at once, before the reply ---
    set(&c, 1, 1);
    check("answered at once: heard", files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q) == 1 && q.state == files.CHOSEN &&
          files.count(&q) == 2);
    files.close(&q);

    // --- A portal before handle_token: a path of its own ---
    set(&c, 1, 2);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    wait(&c, &q);
    check("on the portal's own path: heard", q.state == files.CHOSEN && files.count(&q) == 2);
    files.close(&q);
    set(&c, 1, 0);

    // --- Cancelled, failed ---
    set(&c, 2, 1);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &d, &q);
    check("tokens past nine", told(&c, "OpenFile||Open|handle_token=caustic10,modal=false,multiple=false,directory=false,") == 1);
    wait(&c, &q);
    check("cancelled: no files, whatever came with it", q.state == files.CANCELLED && q.response == 1 && files.count(&q) == 0);
    files.close(&q);
    set(&c, 2, 2);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    wait(&c, &q);
    check("ended some other way: failed", q.state == files.FAILED && q.response == 2);
    files.close(&q);
    set(&c, 2, 0);

    // --- Odd URIs, into a request not zeroed first ---
    set(&c, 3, 1);
    mem.memset(cast(*u8, &q), 255, sizeof(files.Request));
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    wait(&c, &q);
    check("ten URIs", q.state == files.CHOSEN && files.count(&q) == 10 && q.more == 0 && files.filter_index(&q, &o) == 0 - 1);
    check("not a file, another host, a bad escape, a zero byte, an escape cut short: no path", no_path(&q, 0) == 1 &&
          no_path(&q, 1) == 1 && no_path(&q, 2) == 1 && no_path(&q, 3) == 1 && no_path(&q, 4) == 1);
    check("escaped slashes, either case", path_is(&q, 5, "/a/b/c") == 1);
    check("the top; a host and no path", path_is(&q, 6, "/") == 1 && no_path(&q, 7) == 1);
    check("escapes: a to f, a zero first, one at the end", path_is(&q, 8, "/x:y\tz") == 1 && path_is(&q, 9, "/abA") == 1);
    files.close(&q);

    // --- More than a request keeps ---
    set(&c, 3, 2);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    wait(&c, &q);
    check("more than it keeps: those that fit, and said", q.state == files.CHOSEN && files.count(&q) == files.MAX_URIS &&
          q.more == 1 && path_is(&q, files.MAX_URIS - 1, "/tmp/many") == 1);
    files.close(&q);
    set(&c, 3, 5);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    wait(&c, &q);
    let is i64 as un2 with mut = 0;
    files.uri(&q, 63, &un2);
    check("more bytes than it keeps: those that fill it, and said", q.state == files.CHOSEN && files.count(&q) == 64 &&
          q.more == 1 && un2 == 256);
    files.close(&q);

    // --- The filter left chosen; what it does not know ---
    set(&c, 3, 3);
    files.add_filter(&o, "Images", 6, "*.png", 5);
    files.add_filter(&o, "Markdown", 8, "*.md", 4);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    wait(&c, &q);
    check("the filter left chosen", q.state == files.CHOSEN && files.filter_index(&q, &o) == 3 && files.count(&q) == 2);
    let is files.Options as fewer with mut = o;
    fewer.nf = 3;
    check("not one of those asked: none", files.filter_index(&q, &d) == 0 - 1 && files.filter_index(&q, &fewer) == 0 - 1);
    files.close(&q);
    let is [65]u8 as fs;
    mem.memset(cast(*u8, &fs), 70, 65);
    files.add_filter(&o, cast(*u8, &fs), 64, "*", 1);
    files.add_filter(&o, cast(*u8, &fs), 65, "*", 1);
    set(&c, 3, 6);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    wait(&c, &q);
    check("a filter named with 64 bytes: kept", files.filter_index(&q, &o) == 4);
    files.close(&q);
    set(&c, 3, 7);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    wait(&c, &q);
    check("with 65: not", q.state == files.CHOSEN && files.filter_index(&q, &o) == 0 - 1);
    files.close(&q);

    // --- Results of the wrong types: skipped ---
    set(&c, 3, 4);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    wait(&c, &q);
    check("the wrong types: nothing taken", q.state == files.CHOSEN && files.count(&q) == 0 && files.filter_index(&q, &o) == 0 - 1);
    files.close(&q);
    set(&c, 3, 0);

    // --- Closed before an answer ---
    set(&c, 1, 3);
    files.open_file(&c, portal.DESKTOP, "", 0, "Open", 4, &o, &q);
    dbus.conn.dispatch(&c, 200);
    files.close(&q);
    check("closed while waiting: the portal told", closes(&c) == 1 && q.state == files.CANCELLED);
    set(&c, 1, 0);

    // --- Filters past what fits ---
    let is files.Options as f with mut = files.options();
    let is i64 as k with mut = 0;
    while (k < files.MAX_FILTERS) {
        files.add_filter(&f, "x", 1, "*", 1);
        k = k + 1;
    }
    check("filters past the last: none", files.add_filter(&f, "x", 1, "*", 1) == 0 - 1);

    let is dbus.message.Message as bye with mut = dbus.message.method_call(portal.DESKTOP, portal.PATH,
                                                                          "org.caustic.FakePortal", "Quit");
    dbus.conn.body(&c);
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    dbus.conn.call_method(&c, &bye, 2000, &rep);
    let is i32 as status with mut = 0;
    linux.wait4(pid, &status, 0, cast(*u8, 0));
    dbus.conn.close(&c);
    if (fails == 0) {
        io.printf("filechooser portal: all checks passed\n");
        return 0;
    }
    io.printf("filechooser portal: %d checks failed\n", fails);
    return 1;
}
