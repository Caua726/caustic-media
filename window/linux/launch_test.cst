// window/linux/launch_test.cst — a launcher's token taken from the
// environment: read, and removed from the array every later getenv and
// every program started after reads, the rest of it as it was.
//   ./build/launch_test
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "launch.cst" as launch;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("FAIL: %s\n", name); }
}

fn same(a as *u8, b as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (b[n] != 0) { n = n + 1; }
    return cast(i32, mem.memcmp(a, b, n + 1) == 0);
}

// The process's arguments and environment as the kernel lays them out:
// argc's pointers, a null, the environment's, a null.
let is [16]i64 as block with mut;

// The environment entries now, back to back, a line each.
fn listed(out as *u8) as *u8 {
    let is *i64 as e = cast(*i64, env.envp());
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    while (e[i] != 0) {
        let is *u8 as s = cast(*u8, e[i]);
        let is i64 as j with mut = 0;
        while (s[j] != 0) { out[k] = s[j]; k = k + 1; j = j + 1; }
        out[k] = 10;
        k = k + 1;
        i = i + 1;
    }
    out[k] = 0;
    return out;
}

fn main() as i32 {
    let is [300]u8 as long with mut;
    mem.memcpy(&long[0], "LONG=", 5);
    mem.memset(&long[5], 120, 256);
    long[261] = 0;
    let is [300]u8 as most with mut;
    mem.memcpy(&most[0], "MOST=", 5);
    mem.memset(&most[5], 121, 255);
    most[260] = 0;
    block[0] = cast(i64, "prog");
    block[1] = 0;
    block[2] = cast(i64, "A=1");
    block[3] = cast(i64, "XDG_ACTIVATION_TOKEN_OTHER=no");
    block[4] = cast(i64, "XDG_ACTIVATION_TOKEN=tok-123");
    block[5] = cast(i64, "ABC=odd");
    block[6] = cast(i64, "DESKTOP_STARTUP_ID=");
    block[7] = cast(i64, &long[0]);
    block[8] = cast(i64, &most[0]);
    block[9] = cast(i64, "B=2");
    block[10] = 0;
    env.init(1, cast(*u8, &block[0]));
    let is [256]u8 as out;
    let is [2048]u8 as text;

    // The array is changed where it is: its entries kept aside to compare.
    let is [16]i64 as was;
    mem.memcpy(cast(*u8, &was[0]), cast(*u8, &block[0]), 128);
    check("a token: read", launch.take("XDG_ACTIVATION_TOKEN", &out[0], 256) == 7 && same(&out[0], "tok-123") == 1);
    // The same entries, in order, the token's gone and the end moved up.
    let is *i64 as e = cast(*i64, env.envp());
    check("gone, the rest as it was, in order",
          e[0] == was[2] && e[1] == was[3] && e[2] == was[5] && e[3] == was[6] && e[4] == was[7] &&
          e[5] == was[8] && e[6] == was[9] && e[7] == 0);
    check("taken once: not there again", launch.take("XDG_ACTIVATION_TOKEN", &out[0], 256) == 0 &&
          cast(i64, env.getenv("XDG_ACTIVATION_TOKEN")) == 0);
    check("a name that only begins another's: not that one", launch.take("XDG_ACTIVATION", &out[0], 256) == 0 &&
          cast(i64, env.getenv("XDG_ACTIVATION_TOKEN_OTHER")) != 0);
    check("an odd name's length: read and gone", launch.take("ABC", &out[0], 256) == 3 && same(&out[0], "odd") == 1 &&
          cast(i64, env.getenv("ABC")) == 0);
    check("empty: none, and gone", launch.take("DESKTOP_STARTUP_ID", &out[0], 256) == 0 &&
          cast(i64, env.getenv("DESKTOP_STARTUP_ID")) == 0);
    out[0] = 0;
    check("one that does not fit with its zero: none, untouched, and gone", launch.take("LONG", &out[0], 256) == 0 &&
          out[0] == 0 && cast(i64, env.getenv("LONG")) == 0);
    check("the longest that fits: whole", launch.take("MOST", &out[0], 256) == 255 && out[254] == 121 && out[255] == 0);
    check("the first and last left, the end still marked",
          same(listed(&text[0]), "A=1\nXDG_ACTIVATION_TOKEN_OTHER=no\nB=2\n") == 1);
    check("the last taken: the end marked", launch.take("B", &out[0], 256) == 1 &&
          same(listed(&text[0]), "A=1\nXDG_ACTIVATION_TOKEN_OTHER=no\n") == 1);
    check("the first taken", launch.take("A", &out[0], 256) == 1 && same(listed(&text[0]), "XDG_ACTIVATION_TOKEN_OTHER=no\n") == 1);
    if (fails == 0) { io.printf("launch: all checks passed\n"); return 0; }
    io.printf("launch: %d failures\n", fails);
    return 1;
}
