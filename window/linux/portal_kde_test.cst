// window/linux/portal_kde_test.cst — the desktop's settings from the
// installed settings portal, xdg-desktop-portal with its KDE backend, on a
// bus and in a configuration of their own (tools/run_portal_kde.sh), the
// configuration testdata/kdeglobals as the portal starts:
//   sh window/linux/tools/run_portal_kde.sh window/linux/testdata/kdeglobals \
//       ./build/portal_kde_test
// Read: the interface and monospace fonts, double-click time, drag
// distance, the caret's blink, the icon theme, animations — KDE's portal
// says them all as strings — and the appearance standard's keys. Followed: a
// setting changed as System Settings does (kwriteconfig6 --notify), the
// SettingChanged signal heard and the new value read.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/time.cst" as time;
use "std/process.cst" as process;
use "std/os/linux.cst" as linux;
use "../../dbus/dbus.cst" as dbus;
use "../settings.cst" as settings;
use "portal.cst" as portal;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("FAIL: %s\n", name); }
}

fn same(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (b[i] != 0 && a[i] == b[i]) { i = i + 1; }
    return cast(i32, a[i] == b[i]);
}

// kwriteconfig6 --notify --file kdeglobals --group g --key k v: its status.
fn kde_set(group as *u8, key as *u8, value as *u8) as i32 {
    let is [10]i64 as argv;
    argv[0] = cast(i64, "kwriteconfig6"); argv[1] = cast(i64, "--notify");
    argv[2] = cast(i64, "--file"); argv[3] = cast(i64, "kdeglobals");
    argv[4] = cast(i64, "--group"); argv[5] = cast(i64, group);
    argv[6] = cast(i64, "--key"); argv[7] = cast(i64, key);
    argv[8] = cast(i64, value); argv[9] = 0;
    let is i64 as pid = process.spawnp("kwriteconfig6", cast(*u8, &argv[0]));
    if (pid <= 0) { return 0 - 1; }
    let is i32 as status with mut = 0;
    linux.wait4(pid, &status, 0, cast(*u8, 0));
    return process.exit_code_of(status);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    let is dbus.conn.Conn as c with mut = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&c) == 0) { io.printf("FAIL: no session bus\n"); return 1; }

    // --- Read ---
    let is settings.Settings as s with mut = settings.defaults();
    check("the portal answered", portal.read(&c, portal.DESKTOP, &s) == 1);
    check("the interface font", (s.known & settings.K_FONT) != 0 && same(&s.font[0], "Noto Sans") == 1 &&
          s.font_size > 10.9 && s.font_size < 11.1);
    check("the monospace font", (s.known & settings.K_MONO) != 0 && same(&s.mono[0], "Hack") == 1 &&
          s.mono_size > 9.9 && s.mono_size < 10.1);
    check("double-click time, said as a string", (s.known & settings.K_DOUBLE_CLICK_MS) != 0 && s.double_click_ms == 600);
    check("drag distance, said as a string", (s.known & settings.K_DRAG) != 0 && s.drag_px == 12);
    check("the caret's blink", (s.known & settings.K_BLINK) != 0 && s.blink == 1 &&
          (s.known & settings.K_BLINK_MS) != 0 && s.blink_ms == 900);
    check("the icon theme", (s.known & settings.K_ICON_THEME) != 0 && same(&s.icon_theme[0], "breeze-dark") == 1);
    check("animations on", (s.known & settings.K_ANIMATIONS) != 0 && s.animations == 1);
    check("light, as its colours are", (s.known & settings.K_DARK) != 0 && s.dark == 0);

    // --- Followed ---
    let is i32 as changed with mut = 0;
    check("watched", portal.watch(&c, portal.DESKTOP, &changed) >= 0);
    check("animations turned off in System Settings", kde_set("KDE", "AnimationDurationFactor", "0") == 0);
    let is i64 as until = time.now_ms() + 5000;
    while (changed == 0 && time.now_ms() < until) { dbus.conn.dispatch(&c, 50); }
    check("the portal said a setting changed", changed == 1);
    s = settings.defaults();
    check("read again", portal.read(&c, portal.DESKTOP, &s) == 1);
    check("animations off", (s.known & settings.K_ANIMATIONS) != 0 && s.animations == 0);

    dbus.conn.close(&c);
    if (fails == 0) { io.printf("portal kde: all checks passed\n"); return 0; }
    io.printf("portal kde: %d failures\n", fails);
    return 1;
}
