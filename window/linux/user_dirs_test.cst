// window/linux/user_dirs_test.cst — the user's folders as xdg-user-dirs names
// them: in the user's language ("Área de trabalho"), under home or anywhere,
// the lines it writes and no others.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "user_dirs.cst" as user_dirs;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    if (n != _len(b)) { return 0; }
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

let is [1024]u8 as out with mut;

// Folder key in text, home /home/ana: whether it is want ("" for none said,
// "-" for said as home itself).
fn says(text as *u8, key as *u8, want as *u8) as i32 {
    let is i64 as n = user_dirs.parse(text, _len(text), key, _len(key), "/home/ana", 9, cast(*u8, &out), 1024);
    if (want[0] == 0) { return cast(i32, n == 0 - 1); }
    if (want[0] == 45 && want[1] == 0) { return cast(i32, n == 0); }
    return same(cast(*u8, &out), n, want);
}

fn main() as i32 {
    // --- The file's lines ---
    let is *u8 as file = "# This file is written by xdg-user-dirs-update\nXDG_DESKTOP_DIR=\"$HOME/Área de trabalho\"\nXDG_DOWNLOAD_DIR=\"$HOME/Downloads\"\nXDG_DOCUMENTS_DIR=\"$HOME/Documentos\"\n";
    check("under home, in the user's language", says(file, "DESKTOP", "/home/ana/Área de trabalho") == 1);
    check("each its own", says(file, "DOCUMENTS", "/home/ana/Documentos") == 1 && says(file, "DOWNLOAD", "/home/ana/Downloads") == 1);
    check("one not said: none", says(file, "MUSIC", "") == 1 && says(file, "DESK", "") == 1 && says(file, "DESKTOPS", "") == 1);
    check("anywhere", says("XDG_MUSIC_DIR=\"/srv/música\"\n", "MUSIC", "/srv/música") == 1);
    check("spaces about the =, before the line", says("  \tXDG_MUSIC_DIR = \"$HOME/M\"", "MUSIC", "/home/ana/M") == 1);
    check("the last line saying it", says("XDG_MUSIC_DIR=\"$HOME/A\"\nXDG_MUSIC_DIR=\"$HOME/B\"\n", "MUSIC", "/home/ana/B") == 1);
    check("a backslash keeping the next", says("XDG_MUSIC_DIR=\"$HOME/a \\\"b\\\\\"", "MUSIC", "/home/ana/a \"b\\") == 1);
    check("its slashes at the end left out", says("XDG_MUSIC_DIR=\"$HOME/M//\"", "MUSIC", "/home/ana/M") == 1 &&
          says("XDG_MUSIC_DIR=\"/\"", "MUSIC", "/") == 1);
    check("home itself: said, as none", says("XDG_MUSIC_DIR=\"$HOME/\"", "MUSIC", "-") == 1 &&
          says("XDG_MUSIC_DIR=\"$HOME//\"", "MUSIC", "-") == 1);
    check("lines it does not write: passed over", says("XDG_MUSIC_DIR=\"M\"", "MUSIC", "") == 1 &&
          says("XDG_MUSIC_DIR=\"$HOME\"", "MUSIC", "") == 1 && says("XDG_MUSIC_DIR=$HOME/M", "MUSIC", "") == 1 &&
          says("# XDG_MUSIC_DIR=\"$HOME/M\"", "MUSIC", "") == 1 && says("XDG_MUSIC_DIR=\"$HOME/M", "MUSIC", "") == 1 &&
          says("XDG_MUSIC_DIR", "MUSIC", "") == 1 && says("XDG_MUSIC_DIR=\"$HOMES/M\"", "MUSIC", "") == 1 &&
          says("xdg_MUSIC_DIR=\"$HOME/M\"", "MUSIC", "") == 1 && says("XDG_MUSIC_DIR=\"\"", "MUSIC", "") == 1);
    check("a line passed over, the next read", says("XDG_MUSIC_DIR=\"M\"\nXDG_MUSIC_DIR=\"/m\"", "MUSIC", "/m") == 1);
    let is i64 as small = user_dirs.parse(file, _len(file), "DESKTOP", 7, "/home/ana", 9, cast(*u8, &out), 20);
    check("no room: none", small == 0 - 1);
    check("a quote kept at the line's end: never closed", says("XDG_MUSIC_DIR=\"$HOME/a\\\"", "MUSIC", "") == 1);
    // Room just enough, and a byte short; nothing written past it.
    mem.memset(cast(*u8, &out), 120, 1024);
    let is i64 as just = user_dirs.parse("XDG_MUSIC_DIR=\"/m/n\"", 20, "MUSIC", 5, "/home/ana", 9, cast(*u8, &out), 5);
    check("room for it and its NUL", just == 4 && same(cast(*u8, &out), 4, "/m/n") == 1 && out[4] == 0 && out[5] == 120);
    check("a byte short", user_dirs.parse("XDG_MUSIC_DIR=\"/m/n\"", 20, "MUSIC", 5, "/home/ana", 9, cast(*u8, &out), 4) == 0 - 1);
    // A path as long as a line can say, and one longer; a home as long.
    let is *u8 as big = mem.core.mmap_anon(16384);
    mem.memcpy(big, "XDG_MUSIC_DIR=\"", 15);
    mem.memset(cast(*u8, cast(i64, big) + 15), 47, 1);
    mem.memset(cast(*u8, cast(i64, big) + 16), 109, 4094);
    big[4110] = cast(u8, 34);
    let is *u8 as wide = mem.core.mmap_anon(16384);
    check("a path of 4095 bytes", user_dirs.parse(big, 4111, "MUSIC", 5, "/home/ana", 9, wide, 16384) == 4095);
    big[4110] = cast(u8, 109);
    big[4111] = cast(u8, 34);
    check("of 4096: not", user_dirs.parse(big, 4112, "MUSIC", 5, "/home/ana", 9, wide, 16384) == 0 - 1);
    let is *u8 as home = mem.core.mmap_anon(8192);
    mem.memset(home, 104, 4096);
    check("a home of 4095 bytes, said as the folder", user_dirs.parse("XDG_MUSIC_DIR=\"$HOME/\"", 22, "MUSIC", 5, home, 4095, wide, 16384) == 0);
    check("of 4096: no room", user_dirs.parse("XDG_MUSIC_DIR=\"$HOME/\"", 22, "MUSIC", 5, home, 4096, wide, 16384) == 0 - 1);

    // --- Where the file is ---
    let is i64 as c with mut = user_dirs.config_folder("/etc/xdg-cfg", "/home/ana", 9, cast(*u8, &out), 1024);
    check("XDG_CONFIG_HOME", same(cast(*u8, &out), c, "/etc/xdg-cfg") == 1 && out[c] == 0);
    c = user_dirs.config_folder(cast(*u8, 0), "/home/ana", 9, cast(*u8, &out), 1024);
    check("unset: home's .config", same(cast(*u8, &out), c, "/home/ana/.config") == 1 && out[c] == 0);
    c = user_dirs.config_folder("", "/home/ana", 9, cast(*u8, &out), 1024);
    let is i32 as empty = same(cast(*u8, &out), c, "/home/ana/.config");
    c = user_dirs.config_folder("cfg", "/home/ana", 9, cast(*u8, &out), 1024);
    check("empty or not absolute: passed over", empty == 1 && same(cast(*u8, &out), c, "/home/ana/.config") == 1);
    check("no home: none", user_dirs.config_folder(cast(*u8, 0), "", 0, cast(*u8, &out), 1024) == 0);
    check("room just enough", user_dirs.config_folder("/etc/x", "/h", 2, cast(*u8, &out), 7) == 6 &&
          user_dirs.config_folder(cast(*u8, 0), "/h", 2, cast(*u8, &out), 11) == 10 && same(cast(*u8, &out), 10, "/h/.config") == 1);
    mem.memset(cast(*u8, &out), 120, 16);
    check("an odd length, nothing past its NUL", user_dirs.config_folder("/etc/xy", "/h", 2, cast(*u8, &out), 8) == 7 &&
          same(cast(*u8, &out), 7, "/etc/xy") == 1 && out[7] == 0 && out[8] == 120);
    check("a byte short: none", user_dirs.config_folder("/etc/x", "/h", 2, cast(*u8, &out), 6) == 0 &&
          user_dirs.config_folder(cast(*u8, 0), "/h", 2, cast(*u8, &out), 10) == 0);

    // --- The user's file ---
    let is i64 as n with mut = user_dirs.lookup("window/testdata/xdg", 19, "DOCUMENTS", 9, "Documents", 9, "/home/ana", 9,
                                                cast(*u8, &out), 1024);
    check("read from the config folder", same(cast(*u8, &out), n, "/home/ana/Documentos") == 1);
    n = user_dirs.lookup("window/testdata/xdg", 19, "MUSIC", 5, "Music", 5, "/home/ana", 9, cast(*u8, &out), 1024);
    check("not said: its English name under home", same(cast(*u8, &out), n, "/home/ana/Music") == 1);
    n = user_dirs.lookup("window/testdata/xdg", 19, "PUBLICSHARE", 11, "Public", 6, "/home/ana", 9, cast(*u8, &out), 1024);
    check("said as home: none", n == 0);
    n = user_dirs.lookup("window/testdata/none", 20, "DOCUMENTS", 9, "Documents", 9, "/home/ana", 9, cast(*u8, &out), 1024);
    check("no file: the English name", same(cast(*u8, &out), n, "/home/ana/Documents") == 1);
    n = user_dirs.lookup("window/testdata/none", 20, "DOCUMENTS", 9, "Documents", 9, "/home/ana", 9, cast(*u8, &out), 19);
    check("no room for it: none", n == 0);
    mem.memset(cast(*u8, &out), 120, 1024);
    n = user_dirs.lookup("window/testdata/none", 20, "DOCUMENTS", 9, "Documents", 9, "/home/ana", 9, cast(*u8, &out), 20);
    check("room just enough, its NUL there", same(cast(*u8, &out), n, "/home/ana/Documents") == 1 && out[19] == 0);

    if (fails == 0) {
        io.printf("window user dirs: all checks passed\n");
        return 0;
    }
    io.printf("window user dirs: %d failures\n", fails);
    return 1;
}
