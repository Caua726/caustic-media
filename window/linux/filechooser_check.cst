// window/linux/filechooser_check.cst — this desktop's own file chooser,
// asked through the portal the way a program would, and what was chosen.
// Run by hand: it opens a dialog for a person to answer.
//
//   caustic window/linux/filechooser_check.cst -o build/filechooser_check && ./build/filechooser_check
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/time.cst" as time;
use "../../dbus/dbus.cst" as dbus;
use "portal.cst" as portal;
use "filechooser.cst" as files;

let is files.Request as q with mut;

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    let is dbus.conn.Conn as c with mut = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&c) == 0) {
        io.printf("no session bus (error %d)\n", cast(i64, dbus.conn.last_error(&c)));
        return 1;
    }
    let is files.Options as o with mut = files.options();
    o.multiple = 1;
    files.add_filter(&o, "Text", 4, "*.txt;*.md", 10);
    files.add_filter(&o, "All files", 9, "", 0);
    if (files.open_file(&c, portal.DESKTOP, "", 0, "Choose some files", 17, &o, &q) == 0) {
        io.printf("the portal was not asked (error %d)\n", cast(i64, dbus.conn.last_error(&c)));
        return 1;
    }
    let is i64 as until = time.now_ms() + 300000;
    while (q.state == files.WAITING && time.now_ms() < until) { dbus.conn.dispatch(&c, 100); }
    io.printf("state %d, response %d, %d chosen, more left out %d, filter %d\n", cast(i64, q.state), cast(i64, q.response),
              files.count(&q), cast(i64, q.more), files.filter_index(&q, &o));
    let is [4096]u8 as p;
    let is i64 as i with mut = 0;
    while (i < files.count(&q)) {
        let is i64 as n = files.path(&q, i, cast(*u8, &p), 4095);
        p[n] = cast(u8, 0);
        let is i64 as un with mut = 0;
        files.uri(&q, i, &un);
        io.printf("  %s (%d bytes of URI)\n", cast(*u8, &p), un);
        i = i + 1;
    }
    files.close(&q);
    dbus.conn.close(&c);
    return 0;
}
