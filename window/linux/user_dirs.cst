// window/linux/user_dirs.cst — the user's folders as xdg-user-dirs names them.
//
// A desktop in Portuguese keeps its documents in ~/Documentos and its desktop
// in "~/Área de trabalho": the names are chosen in the user's language, once,
// by xdg-user-dirs-update, and written to user-dirs.dirs in the config folder
// (XDG_CONFIG_HOME, or ~/.config) as lines of
//
//     XDG_DESKTOP_DIR="$HOME/Área de trabalho"
//     XDG_MUSIC_DIR="/srv/music"
//
// — the path under home or absolute, shell-escaped inside its double quotes.
// "No other format is supported", the file says, and no other is read here:
// a line of any other shape is passed over. A folder said to be home itself
// is one the user turned off. Windows' known folders come with its backend.
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;

// Not said, or no room for it.
let is i64 as NONE with imut = 0 - 1;

fn _space(c as u8) as i32 { return cast(i32, c == 32 || c == 9); }

// Whether the m bytes at s + i are word's.
fn _is(s as *u8, n as i64, i as i64, word as *u8, m as i64) as i32 {
    if (i + m > n) { return 0; }
    return cast(i32, mem.memcmp(cast(*u8, cast(i64, s) + i), word, m) == 0);
}

// The line from i to e: the folder into out when it names XDG_<key>_DIR, its
// length with its slashes at the end left out — 0 when it is home itself;
// -1 when the line does not say it, or it does not fit.
fn _line(s as *u8, i0 as i64, e as i64, key as *u8, keyn as i64, home as *u8, homen as i64, out as *u8, cap as i64) as i64 {
    let is i64 as i with mut = i0;
    while (i < e && _space(s[i]) == 1) { i = i + 1; }
    if (_is(s, e, i, "XDG_", 4) == 0) { return NONE; }
    i = i + 4;
    if (_is(s, e, i, key, keyn) == 0) { return NONE; }
    i = i + keyn;
    if (_is(s, e, i, "_DIR", 4) == 0) { return NONE; }
    i = i + 4;
    while (i < e && _space(s[i]) == 1) { i = i + 1; }
    if (i >= e || s[i] != 61) { return NONE; }
    i = i + 1;
    while (i < e && _space(s[i]) == 1) { i = i + 1; }
    if (i >= e || s[i] != 34) { return NONE; }
    i = i + 1;
    let is i64 as o with mut = 0;
    if (_is(s, e, i, "$HOME/", 6) == 1) {
        if (homen + 1 > cap) { return NONE; }
        mem.memcpy(out, home, homen);
        out[homen] = cast(u8, 47);
        o = homen + 1;
        i = i + 6;
    } else if (i >= e || s[i] != 47) {
        return NONE;
    }
    let is i32 as closed with mut = 0;
    while (i < e && closed == 0) {
        let is u8 as c with mut = s[i];
        if (c == 34) {
            closed = 1;
        } else {
            if (c == 92 && i + 1 < e) {
                i = i + 1;
                c = s[i];
            }
            if (o + 1 >= cap) { return NONE; }
            out[o] = c;
            o = o + 1;
        }
        i = i + 1;
    }
    if (closed == 0) { return NONE; }
    while (o > 1 && out[o - 1] == 47) { o = o - 1; }
    out[o] = cast(u8, 0);
    if (o == homen && mem.memcmp(out, home, homen) == 0) { return 0; }
    return o;
}

// The folder XDG_<key>_DIR (key keyn bytes: "DESKTOP", "DOCUMENTS",
// "DOWNLOAD"…) in user-dirs.dirs's text, n bytes, $HOME being home: into
// out, cap bytes with the NUL; its length. 0 when said as home itself — turned
// off — and -1 when not said, or it does not fit. The last line saying it
// counts, as with xdg-user-dirs' own reader.
fn parse(text as *u8, n as i64, key as *u8, keyn as i64, home as *u8, homen as i64, out as *u8, cap as i64) as i64 {
    let is [4096]u8 as one;
    let is i64 as found with mut = NONE;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as e with mut = i;
        while (e < n && text[e] != 10) { e = e + 1; }
        let is i64 as k = _line(text, i, e, key, keyn, home, homen, cast(*u8, &one), 4096);
        if (k >= 0) {
            if (k + 1 > cap) {
                found = NONE;
            } else {
                mem.memcpy(out, cast(*u8, &one), k + 1);
                found = k;
            }
        }
        i = e + 1;
    }
    return found;
}

// The config folder, where user-dirs.dirs is: xdg — XDG_CONFIG_HOME's value,
// null when unset — when it is an absolute path, else home's .config (home
// homen bytes). Into out, cap bytes with the NUL; its length, 0 for none or
// no room.
fn config_folder(xdg as *u8, home as *u8, homen as i64, out as *u8, cap as i64) as i64 {
    if (cast(i64, xdg) != 0 && xdg[0] == 47) {
        let is i64 as n with mut = 0;
        while (xdg[n] != 0) { n = n + 1; }
        if (n + 1 > cap) { return 0; }
        mem.memcpy(out, xdg, n + 1);
        return n;
    }
    if (homen == 0 || homen + 9 > cap) { return 0; }
    mem.memcpy(out, home, homen);
    mem.memcpy(cast(*u8, cast(i64, out) + homen), "/.config", 9);
    return homen + 8;
}

// The folder XDG_<key>_DIR from config/user-dirs.dirs (config cn bytes: the
// config folder), or home/fallback — its English name, xdg-user-dirs' own
// default — when the file does not say it or there is none. Into out, cap
// bytes with the NUL; its length, or 0: turned off, or no room.
fn lookup(config as *u8, cn as i64, key as *u8, keyn as i64, fallback as *u8, fbn as i64, home as *u8, homen as i64,
          out as *u8, cap as i64) as i64 {
    let is i64 as k with mut = NONE;
    if (cn > 0 && cn < 4000) {
        let is [4096]u8 as path;
        mem.memcpy(cast(*u8, &path), config, cn);
        mem.memcpy(cast(*u8, cast(i64, &path) + cn), "/user-dirs.dirs", 16);
        let is i64 as fd = linux.open(cast(*u8, &path), 0, 0);
        if (fd >= 0) {
            let is [16384]u8 as buf;
            let is i64 as n with mut = 0;
            let is i64 as r with mut = 1;
            while (r > 0 && n < 16384) {
                r = linux.read(fd, cast(*u8, cast(i64, &buf) + n), 16384 - n);
                if (r > 0) { n = n + r; }
            }
            linux.close(fd);
            k = parse(cast(*u8, &buf), n, key, keyn, home, homen, out, cap);
        }
    }
    if (k >= 0) { return k; }
    if (homen + 1 + fbn + 1 > cap) { return 0; }
    mem.memcpy(out, home, homen);
    out[homen] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, out) + homen + 1), fallback, fbn);
    out[homen + 1 + fbn] = cast(u8, 0);
    return homen + 1 + fbn;
}
