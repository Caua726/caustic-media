// window/linux/portal_test.cst — the settings portal, played by a child
// process on a private bus (dbus/tools/run_dbus.sh), never the desktop's.
//
// The child owns org.freedesktop.portal.Desktop and answers ReadAll from one
// of two sets of settings — GNOME's keys and KDE's — with only the
// namespaces asked for, and sends SettingChanged when told to.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "std/time.cst" as time;
use "../../dbus/dbus.cst" as dbus;
use "../settings.cst" as settings;
use "portal.cst" as portal;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn eq(a as *u8, b as *u8) as i32 { return dbus.message.named(a, b); }

// --- The fake portal ---

let is i64 as mode with mut = 0;
let is i64 as scheme with mut = 2;        // org.freedesktop.appearance color-scheme
let is i64 as gscheme with mut = 1;       // GNOME's: 0 default, 1 prefer-dark, 2 prefer-light
let is i64 as gtheme_dark with mut = 1;   // gtk-theme Adwaita-dark, or Adwaita
let is i64 as app_rm with mut = 1;        // appearance reduced-motion
let is i64 as g_anim with mut = 1;        // GNOME's enable-animations
let is i64 as a11y_reduce with mut = 0;   // GNOME's a11y reduced-motion "reduce"
let is i32 as quit with mut = 0;
let is i64 as asked_privacy with mut = 0;

// Whether the namespaces asked for (an "as" in r, len bytes) include ns.
fn asked(c as *dbus.conn.Conn, k as *dbus.conn.Call, ns as *u8) as i32 {
    let is dbus.wire.Reader as r with mut = dbus.message.body(k.msg);
    let is i64 as n with mut = 0;
    let is i64 as end = dbus.wire.get_array(&r, 4);
    while (r.err == 0 && r.pos < end) {
        if (eq(dbus.wire.get_string(&r, &n), ns) == 1) { return 1; }
    }
    return 0;
}

fn ns_begin(w as *dbus.wire.Writer, ns as *u8) as i64 {
    dbus.wire.put_struct(w);
    dbus.wire.put_string(w, ns);
    return dbus.wire.put_array(w, 8);
}

fn key(w as *dbus.wire.Writer, k as *u8, sig as *u8) as void {
    dbus.wire.put_struct(w);
    dbus.wire.put_string(w, k);
    dbus.wire.put_variant(w, sig);
}

fn ks(w as *dbus.wire.Writer, k as *u8, v as *u8) as void { key(w, k, "s"); dbus.wire.put_string(w, v); }
fn ku(w as *dbus.wire.Writer, k as *u8, v as i64) as void { key(w, k, "u"); dbus.wire.put_u32(w, v); }
fn ki(w as *dbus.wire.Writer, k as *u8, v as i64) as void { key(w, k, "i"); dbus.wire.put_i32(w, v); }
fn kb(w as *dbus.wire.Writer, k as *u8, v as i32) as void { key(w, k, "b"); dbus.wire.put_bool(w, v); }
fn kd(w as *dbus.wire.Writer, k as *u8, v as f64) as void { key(w, k, "d"); dbus.wire.put_double(w, v); }
fn kc(w as *dbus.wire.Writer, k as *u8, r as f64, g as f64, b as f64) as void {
    key(w, k, "(ddd)");
    dbus.wire.put_struct(w);
    dbus.wire.put_double(w, r);
    dbus.wire.put_double(w, g);
    dbus.wire.put_double(w, b);
}

fn m_read_all(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is *dbus.wire.Writer as w = k.reply;
    if (asked(c, k, "org.gnome.desktop.privacy") == 1) { asked_privacy = 1; }
    let is i64 as all = dbus.wire.put_array(w, 8);
    let is i64 as a with mut = 0;
    if (asked(c, k, "org.freedesktop.appearance") == 1) {
        a = ns_begin(w, "org.freedesktop.appearance");
        if (mode == 0) {
            ku(w, "color-scheme", scheme);
            ku(w, "contrast", 1);
            ku(w, "reduced-motion", app_rm);
            kc(w, "accent-color", 0.2, 0.5, 0.9);
        } else if (mode == 1) {
            ku(w, "color-scheme", 0);
            ks(w, "contrast", "high");   // the wrong type: skipped
            ku(w, "reduced-motion", 0);
            kc(w, "accent-color", 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0);   // no accent
        }
        dbus.wire.put_array_end(w, a, 8);
    }
    if (asked(c, k, "org.gnome.desktop.interface") == 1) {
        a = ns_begin(w, "org.gnome.desktop.interface");
        if (mode == 0) {
            // The colour scheme before the theme's name, so a name read into
            // the wrong tier would win.
            if (gscheme == 0) { ks(w, "color-scheme", "default"); }
            if (gscheme == 1) { ks(w, "color-scheme", "prefer-dark"); }
            if (gscheme == 2) { ks(w, "color-scheme", "prefer-light"); }
            if (gtheme_dark == 1) { ks(w, "gtk-theme", "Adwaita-dark"); } else { ks(w, "gtk-theme", "Adwaita"); }
            ks(w, "font-name", "Noto Sans  10");
            ks(w, "monospace-font-name", "Hack  10");
            kd(w, "text-scaling-factor", 1.25);
            kb(w, "enable-animations", cast(i32, g_anim));
            kb(w, "cursor-blink", 0);
            ki(w, "cursor-blink-time", 1000);
            ks(w, "cursor-theme", "breeze_cursors");
            ks(w, "icon-theme", "Papirus-Dark");
            ki(w, "cursor-size", 32);
            ks(w, "accent-color", "blue");
            kb(w, "toolkit-accessibility", 0);
        } else if (mode == 1) {
            ks(w, "gtk-theme", "Breeze-Dark");
            ks(w, "icon-theme", "");   // none said
            ks(w, "cursor-size", "big");   // the wrong type: skipped
        }
        dbus.wire.put_array_end(w, a, 8);
    }
    if (asked(c, k, "org.gnome.desktop.a11y.interface") == 1) {
        a = ns_begin(w, "org.gnome.desktop.a11y.interface");
        if (mode == 0) {
            kb(w, "high-contrast", 0);
            if (a11y_reduce == 1) { ks(w, "reduced-motion", "reduce"); } else { ks(w, "reduced-motion", "no-preference"); }
        } else if (mode == 1) {
            kb(w, "high-contrast", 1);
            ks(w, "reduced-motion", "reduce");
        }
        dbus.wire.put_array_end(w, a, 8);
    }
    if (asked(c, k, "org.gnome.desktop.peripherals.mouse") == 1 && mode == 0) {
        a = ns_begin(w, "org.gnome.desktop.peripherals.mouse");
        ki(w, "double-click", 300);
        ki(w, "drag-threshold", 6);
        kb(w, "left-handed", 0);
        dbus.wire.put_array_end(w, a, 8);
    }
    if (asked(c, k, "org.gnome.desktop.wm.preferences") == 1 && mode == 0) {
        a = ns_begin(w, "org.gnome.desktop.wm.preferences");
        ks(w, "button-layout", "appmenu:minimize,maximize,close");
        dbus.wire.put_array_end(w, a, 8);
    }
    if (asked(c, k, "org.kde.kdeglobals.General") == 1 && mode == 2) {
        a = ns_begin(w, "org.kde.kdeglobals.General");
        ks(w, "font", ",10,-1,5,50,0,0,0,0,0");   // no family
        dbus.wire.put_array_end(w, a, 8);
    }
    if (asked(c, k, "org.kde.kdeglobals.General") == 1 && mode == 1) {
        a = ns_begin(w, "org.kde.kdeglobals.General");
        ks(w, "font", "Noto Sans,10,-1,5,50,0,0,0,0,0");
        ks(w, "fixed", "Hack,9.5,-1,5,50,0,0,0,0,0");
        ks(w, "ColorScheme", "BreezeDark");
        dbus.wire.put_array_end(w, a, 8);
    }
    if (asked(c, k, "org.kde.kdeglobals.KDE") == 1 && mode == 1) {
        a = ns_begin(w, "org.kde.kdeglobals.KDE");
        kd(w, "AnimationDurationFactor", 0.0);
        ki(w, "DoubleClickInterval", 450);
        ki(w, "StartDragDist", 10);
        ks(w, "widgetStyle", "Breeze");
        dbus.wire.put_array_end(w, a, 8);
    }
    dbus.wire.put_array_end(w, all, 8);
}

fn m_change(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    scheme = dbus.wire.get_u32(&k.args);
    let is *dbus.wire.Writer as w = dbus.conn.body(c);
    dbus.wire.put_string(w, "org.freedesktop.appearance");
    dbus.wire.put_string(w, "color-scheme");
    dbus.wire.put_variant(w, "u");
    dbus.wire.put_u32(w, scheme);
    dbus.conn.emit(c, portal.PATH, portal.IFACE, "SettingChanged", "ssv");
}

// Set(what, value): 1 scheme, 2 gscheme, 3 gtheme_dark, 4 app_rm, 5 g_anim,
// 6 a11y_reduce, 7 mode.
fn m_set(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void {
    let is i64 as what = dbus.wire.get_u32(&k.args);
    let is i64 as v = dbus.wire.get_u32(&k.args);
    if (what == 1) { scheme = v; }
    if (what == 2) { gscheme = v; }
    if (what == 3) { gtheme_dark = v; }
    if (what == 4) { app_rm = v; }
    if (what == 5) { g_anim = v; }
    if (what == 6) { a11y_reduce = v; }
    if (what == 7) { mode = v; }
}
fn m_quit(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { quit = 1; }
fn m_asked(c as *dbus.conn.Conn, k as *dbus.conn.Call, user as *u8) as void { dbus.wire.put_u32(k.reply, asked_privacy); }

let is [1]dbus.conn.Method as settings_methods with mut;
let is [4]dbus.conn.Method as fake_methods with mut;
let is [2]dbus.conn.Interface as ifaces with mut;

fn method(t as *dbus.conn.Method, name as *u8, ins as *u8, outs as *u8, h as dbus.conn.MethodFn) as void {
    t.name = name;
    t.in_sig = ins;
    t.out_sig = outs;
    t.handler = h;
    t.in_names = cast(*u8, 0);
    t.out_names = cast(*u8, 0);
}

fn serve() as i64 {
    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    let is dbus.conn.Conn as c with mut = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&c) == 0) { return 2; }
    method(&settings_methods[0], "ReadAll", "as", "a{sa{sv}}", fn_ptr(m_read_all));
    method(&fake_methods[0], "Change", "u", "", fn_ptr(m_change));
    method(&fake_methods[1], "Set", "uu", "", fn_ptr(m_set));
    method(&fake_methods[2], "Quit", "", "", fn_ptr(m_quit));
    method(&fake_methods[3], "AskedPrivacy", "", "u", fn_ptr(m_asked));
    ifaces[0].name = portal.IFACE;
    ifaces[0].methods = cast(*dbus.conn.Method, &settings_methods);
    ifaces[0].nmethods = 1;
    ifaces[0].props = cast(*dbus.conn.Property, 0);
    ifaces[0].nprops = 0;
    ifaces[0].signals = cast(*dbus.conn.SignalDecl, 0);
    ifaces[0].nsignals = 0;
    ifaces[1].name = "org.caustic.FakePortal";
    ifaces[1].methods = cast(*dbus.conn.Method, &fake_methods);
    ifaces[1].nmethods = 4;
    ifaces[1].props = cast(*dbus.conn.Property, 0);
    ifaces[1].nprops = 0;
    ifaces[1].signals = cast(*dbus.conn.SignalDecl, 0);
    ifaces[1].nsignals = 0;
    dbus.conn.export(&c, portal.PATH, cast(*dbus.conn.Interface, &ifaces), 2, cast(*u8, 0));
    if (dbus.conn.request_name(&c, portal.DESKTOP, 4) != 1) { return 3; }
    let is i64 as until = time.now_ms() + 20000;
    while (quit == 0 && time.now_ms() < until) {
        if (dbus.conn.dispatch(&c, 100) < 0) { return 4; }
    }
    dbus.conn.close(&c);
    return 0;
}

// --- The client ---

fn fake(c as *dbus.conn.Conn, member as *u8, arg as i64) as void {
    let is dbus.message.Message as m with mut = dbus.message.method_call(portal.DESKTOP, portal.PATH,
                                                                        "org.caustic.FakePortal", member);
    if (arg >= 0) {
        m.signature = "u";
        dbus.wire.put_u32(dbus.conn.body(c), arg);
    } else {
        dbus.conn.body(c);
    }
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    dbus.conn.call_method(c, &m, 2000, &rep);
}

fn set(c as *dbus.conn.Conn, what as i64, v as i64) as void {
    let is dbus.message.Message as m with mut = dbus.message.method_call(portal.DESKTOP, portal.PATH,
                                                                        "org.caustic.FakePortal", "Set");
    m.signature = "uu";
    let is *dbus.wire.Writer as w = dbus.conn.body(c);
    dbus.wire.put_u32(w, what);
    dbus.wire.put_u32(w, v);
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    dbus.conn.call_method(c, &m, 2000, &rep);
}

// Dark, as the portal says it with these three: the standard key, GNOME's,
// and the theme's name.
fn dark_with(c as *dbus.conn.Conn, sch as i64, gsch as i64, gdark as i64) as i64 {
    set(c, 1, sch);
    set(c, 2, gsch);
    set(c, 3, gdark);
    let is settings.Settings as s with mut = settings.defaults();
    portal.read(c, portal.DESKTOP, &s);
    if ((s.known & settings.K_DARK) == 0) { return 0 - 1; }
    return cast(i64, s.dark);
}

// Whether things animate, with these three: the standard reduced-motion,
// GNOME's switch, and GNOME's accessibility setting.
fn animates_with(c as *dbus.conn.Conn, rm as i64, anim as i64, reduce as i64) as i64 {
    set(c, 4, rm);
    set(c, 5, anim);
    set(c, 6, reduce);
    let is settings.Settings as s with mut = settings.defaults();
    portal.read(c, portal.DESKTOP, &s);
    return cast(i64, s.animations);
}

fn has_owner(c as *dbus.conn.Conn) as i32 {
    let is dbus.message.Message as m with mut = dbus.message.method_call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                                                        "org.freedesktop.DBus", "NameHasOwner");
    m.signature = "s";
    dbus.wire.put_string(dbus.conn.body(c), portal.DESKTOP);
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    if (dbus.conn.call_method(c, &m, 1000, &rep) != dbus.conn.OK) { return 0; }
    let is dbus.wire.Reader as r with mut = dbus.message.body(&rep);
    return dbus.wire.get_bool(&r);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i64 as pid = linux.fork();
    if (pid == 0) { linux.exit(serve()); }

    let is dbus.conn.Limits as l = dbus.conn.limits_default();
    let is dbus.conn.Conn as c with mut = dbus.conn.open_session(&l);
    if (dbus.conn.is_open(&c) == 0) {
        io.printf("portal: no bus — run inside dbus/tools/run_dbus.sh\n");
        return 1;
    }
    let is settings.Settings as s with mut = settings.defaults();
    check("nobody at another name", portal.read(&c, "org.caustic.NoPortal", &s) == 0 && s.known == 0);
    let is i64 as until = time.now_ms() + 5000;
    while (has_owner(&c) == 0 && time.now_ms() < until) { dbus.conn.dispatch(&c, 20); }

    // --- GNOME's keys, under the standard ones ---
    check("read", portal.read(&c, portal.DESKTOP, &s) == 1);
    check("light: the standard key over GNOME's and over the theme's name", s.dark == 0 && (s.known & settings.K_DARK) != 0);
    check("dark: the standard key alone says so", dark_with(&c, 1, 2, 0) == 1);
    check("GNOME's light over the theme's dark name", dark_with(&c, 0, 2, 1) == 0);
    check("GNOME's dark", dark_with(&c, 0, 1, 0) == 1);
    check("the theme's name when nothing else says", dark_with(&c, 0, 0, 1) == 1);
    check("nothing saying anything", dark_with(&c, 0, 0, 0) == 0 - 1);
    check("reduced motion: the standard key", animates_with(&c, 1, 1, 0) == 0);
    check("no preference there: GNOME's switch, on", animates_with(&c, 0, 1, 0) == 1);
    check("GNOME's switch, off", animates_with(&c, 0, 0, 0) == 0);
    check("GNOME's accessibility over its switch", animates_with(&c, 0, 1, 1) == 0);
    set(&c, 4, 1);
    set(&c, 5, 1);
    set(&c, 6, 0);
    set(&c, 1, 2);
    set(&c, 2, 2);
    set(&c, 3, 0);
    check("high contrast: the standard key over GNOME's", s.high_contrast == 1);
    check("reduced motion: the standard key over the animations switch", s.animations == 0);
    check("the accent", (s.known & settings.K_ACCENT) != 0 && s.accent_r == 0.2 && s.accent_g == 0.5 && s.accent_b == 0.9);
    check("the fonts", eq(cast(*u8, &s.font), "Noto Sans") == 1 && s.font_size == 10.0
          && eq(cast(*u8, &s.mono), "Hack") == 1 && s.mono_size == 10.0);
    check("text scaling", s.text_scale == 1.25);
    check("the caret", s.blink == 0 && s.blink_ms == 1000);
    check("the cursor", eq(cast(*u8, &s.cursor_theme), "breeze_cursors") == 1 && s.cursor_size == 32);
    check("the icon theme", eq(cast(*u8, &s.icon_theme), "Papirus-Dark") == 1);
    check("double click and drag", s.double_click_ms == 300 && s.drag_px == 6);
    check("the buttons", eq(cast(*u8, &s.button_layout), "appmenu:minimize,maximize,close") == 1);
    let is dbus.message.Message as q with mut = dbus.message.method_call(portal.DESKTOP, portal.PATH, "org.caustic.FakePortal", "AskedPrivacy");
    dbus.conn.body(&c);
    let is dbus.message.Message as rep with mut = dbus.message.empty();
    dbus.conn.call_method(&c, &q, 2000, &rep);
    let is dbus.wire.Reader as rr with mut = dbus.message.body(&rep);
    check("only the namespaces it needs", dbus.wire.get_u32(&rr) == 0);

    // --- Following a change ---
    let is i32 as changed with mut = 0;
    check("watching", portal.watch(&c, portal.DESKTOP, &changed) > 0);
    fake(&c, "Change", 1);
    dbus.conn.dispatch(&c, 1000);
    check("a change is noticed", changed == 1);
    s = settings.defaults();
    portal.read(&c, portal.DESKTOP, &s);
    check("and read: dark now", s.dark == 1);
    changed = 0;
    fake(&c, "Change", 0);
    dbus.conn.dispatch(&c, 1000);
    s = settings.defaults();
    portal.read(&c, portal.DESKTOP, &s);
    check("no preference: GNOME's own key decides", changed == 1 && s.dark == 0);

    // --- KDE's keys, no preferences, values of the wrong type ---
    set(&c, 7, 1);
    s = settings.defaults();
    check("read again", portal.read(&c, portal.DESKTOP, &s) == 1);
    check("dark from the theme's name, nothing else saying", s.dark == 1);
    check("no accent", (s.known & settings.K_ACCENT) == 0);
    check("a contrast of the wrong type is skipped: GNOME's accessibility decides", s.high_contrast == 1);
    check("Qt's font form", eq(cast(*u8, &s.font), "Noto Sans") == 1 && s.font_size == 10.0
          && eq(cast(*u8, &s.mono), "Hack") == 1 && s.mono_size == 9.5);
    check("no animating: KDE's factor, and GNOME's a11y", s.animations == 0);
    check("KDE's double click and drag", s.double_click_ms == 450 && s.drag_px == 10);
    check("a size of the wrong type is not taken", s.cursor_size == 24 && (s.known & settings.K_CURSOR_SIZE) == 0);
    check("an icon theme of no name is none", (s.known & settings.K_ICON_THEME) == 0);

    set(&c, 7, 2);
    s = settings.defaults();
    portal.read(&c, portal.DESKTOP, &s);
    check("a Qt font with no family is none", (s.known & settings.K_FONT) == 0);

    // --- Answers that are not one ---
    let is dbus.message.Message as not_all with mut = dbus.message.empty();
    check("no answer", portal.parse_all(&not_all, &s) == 0);
    let is [8]u8 as empty_dict;
    mem.memzero(cast(*u8, &empty_dict), 8);
    not_all.signature = "a{sv}";
    not_all.body = cast(*u8, &empty_dict);
    not_all.body_len = 8;
    check("another signature, even one that reads", portal.parse_all(&not_all, &s) == 0);
    let is [4]u8 as cut;
    cut[0] = 100; cut[1] = 0; cut[2] = 0; cut[3] = 0;
    not_all.signature = "a{sa{sv}}";
    not_all.body = cast(*u8, &cut);
    not_all.body_len = 4;
    check("a body cut short", portal.parse_all(&not_all, &s) == 0);

    fake(&c, "Quit", 0 - 1);
    dbus.conn.close(&c);
    let is i32 as status with mut = 0;
    linux.wait4(pid, &status, 0, cast(*u8, 0));
    check("the fake portal ended well", ((status >> 8) & 255) == 0);
    if (fails > 0) {
        io.printf("portal: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("portal: all checks passed\n");
    return 0;
}
