// window/linux/gtk_ini.cst — GTK's settings.ini, the files desktops without a
// settings daemon or a portal still keep: ~/.config/gtk-3.0/settings.ini and
// gtk-4.0/settings.ini, under XDG_CONFIG_HOME when it is set.
//
// A [Settings] section of key = value lines. What GTK itself would read from
// them is what is read here: the theme's name and whether dark is preferred,
// the interface font, animations, the caret's blink, double-click time and
// distance, the cursor theme and size, the title bar's buttons, the DPI.
// The files are a starting point — XSETTINGS and the portal, when there,
// override them (settings.cst) — and nothing tells a program they changed.
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "../settings.cst" as settings;

fn _at(s as *u8, i as i64) as u8 { return *cast(*u8, cast(i64, s) + i); }
fn _ptr(s as *u8, i as i64) as *u8 { return cast(*u8, cast(i64, s) + i); }

fn _space(c as u8) as i32 {
    if (c == 32 || c == 9 || c == 13) { return 1; }
    return 0;
}

fn _key(s as *u8, n as i64, k as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (_at(k, i) != _at(s, i)) { return 0; }
        i = i + 1;
    }
    if (_at(k, n) == 0) { return 1; }
    return 0;
}

fn _bool(v as *u8, n as i64) as i32 {
    if (n == 1 && _at(v, 0) == 49) { return 1; }
    if (n == 4 && (_at(v, 0) == 116 || _at(v, 0) == 84)) { return 1; }   // true, True
    return 0;
}

// A decimal integer, or -1 when v is not one.
fn _int(v as *u8, n as i64) as i64 {
    if (n == 0 || n > 9) { return 0 - 1; }
    let is i64 as x with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u8 as c = _at(v, i);
        if (c < 48 || c > 57) { return 0 - 1; }
        x = x * 10 + cast(i64, c) - 48;
        i = i + 1;
    }
    return x;
}

fn _value(s as *settings.Settings, k as *u8, kn as i64, v as *u8, vn as i64) as void {
    if (_key(k, kn, "gtk-application-prefer-dark-theme") == 1) {
        s.dark = _bool(v, vn);
        s.known = s.known | settings.K_DARK;
    } else if (_key(k, kn, "gtk-theme-name") == 1) {
        settings.theme_name(s, v, vn);
    } else if (_key(k, kn, "gtk-font-name") == 1) {
        settings.set_font(s, v, vn, 0);
    } else if (_key(k, kn, "gtk-enable-animations") == 1) {
        s.animations = _bool(v, vn);
        s.known = s.known | settings.K_ANIMATIONS;
    } else if (_key(k, kn, "gtk-cursor-blink") == 1) {
        s.blink = _bool(v, vn);
        s.known = s.known | settings.K_BLINK;
    } else if (_key(k, kn, "gtk-cursor-blink-time") == 1) {
        let is i64 as x = _int(v, vn);
        if (x > 0) { s.blink_ms = x; s.known = s.known | settings.K_BLINK_MS; }
    } else if (_key(k, kn, "gtk-double-click-time") == 1) {
        let is i64 as x = _int(v, vn);
        if (x > 0) { s.double_click_ms = x; s.known = s.known | settings.K_DOUBLE_CLICK_MS; }
    } else if (_key(k, kn, "gtk-double-click-distance") == 1) {
        let is i64 as x = _int(v, vn);
        if (x >= 0) { s.double_click_px = x; s.known = s.known | settings.K_DOUBLE_CLICK_PX; }
    } else if (_key(k, kn, "gtk-dnd-drag-threshold") == 1) {
        let is i64 as x = _int(v, vn);
        if (x > 0) { s.drag_px = x; s.known = s.known | settings.K_DRAG; }
    } else if (_key(k, kn, "gtk-cursor-theme-name") == 1) {
        settings.set_text(cast(*u8, &s.cursor_theme), 64, v, vn);
        s.known = s.known | settings.K_CURSOR_THEME;
    } else if (_key(k, kn, "gtk-cursor-theme-size") == 1) {
        let is i64 as x = _int(v, vn);
        if (x > 0) { s.cursor_size = x; s.known = s.known | settings.K_CURSOR_SIZE; }
    } else if (_key(k, kn, "gtk-decoration-layout") == 1) {
        settings.set_text(cast(*u8, &s.button_layout), 96, v, vn);
        s.known = s.known | settings.K_BUTTON_LAYOUT;
    } else if (_key(k, kn, "gtk-xft-dpi") == 1) {
        // In 1024ths of a dot per inch; -1 is "the default".
        let is i64 as x = _int(v, vn);
        if (x > 0) { s.dpi = cast(f64, x) / 1024.0; s.known = s.known | settings.K_DPI; }
    }
}

// The [Settings] section of the n bytes at buf, into s.
fn parse(buf as *u8, n as i64, s as *settings.Settings) as void {
    let is i32 as in_settings with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as eol with mut = i;
        while (eol < n && _at(buf, eol) != 10) { eol = eol + 1; }
        let is i64 as a with mut = i;
        let is i64 as b with mut = eol;
        while (a < b && _space(_at(buf, a)) == 1) { a = a + 1; }
        while (b > a && _space(_at(buf, b - 1)) == 1) { b = b - 1; }
        if (a < b && _at(buf, a) == 91) {   // [section]
            in_settings = 0;
            if (b - a == 10 && _key(_ptr(buf, a), 10, "[Settings]") == 1) { in_settings = 1; }
        // A comment's "key" starts with # or ; and matches nothing.
        } else if (in_settings == 1 && a < b) {
            let is i64 as eq with mut = a;
            while (eq < b && _at(buf, eq) != 61) { eq = eq + 1; }
            if (eq < b) {
                let is i64 as ke with mut = eq;
                while (ke > a && _space(_at(buf, ke - 1)) == 1) { ke = ke - 1; }
                let is i64 as vs with mut = eq + 1;
                while (vs < b && _space(_at(buf, vs)) == 1) { vs = vs + 1; }
                // A value may be quoted.
                let is i64 as ve with mut = b;
                if (ve - vs >= 2 && _at(buf, vs) == 34 && _at(buf, ve - 1) == 34) {
                    vs = vs + 1;
                    ve = ve - 1;
                }
                _value(s, _ptr(buf, a), ke - a, _ptr(buf, vs), ve - vs);
            }
        }
        i = eol + 1;
    }
}

// The file at path into s; 1 when there was one to read.
fn read(path as *u8, s as *settings.Settings) as i32 {
    let is i64 as fd = linux.open(path, 0, 0);
    if (fd < 0) { return 0; }
    let is [16384]u8 as buf;
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < 16384) {
        r = linux.read(fd, cast(*u8, cast(i64, &buf) + n), 16384 - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    parse(cast(*u8, &buf), n, s);
    return 1;
}

// gtk-3.0's file, then gtk-4.0's over it, from config — XDG_CONFIG_HOME, or
// ~/.config when that is null. How many there were.
fn read_from(config as *u8, s as *settings.Settings) as i32 {
    if (cast(i64, config) == 0) { return 0; }
    let is i64 as n with mut = 0;
    while (_at(config, n) != 0) { n = n + 1; }
    if (n == 0 || n > 400) { return 0; }
    let is [512]u8 as path;
    mem.memcpy(cast(*u8, &path), config, n);
    let is i32 as found with mut = 0;
    mem.memcpy(cast(*u8, cast(i64, &path) + n), "/gtk-3.0/settings.ini", 22);
    found = found + read(cast(*u8, &path), s);
    mem.memcpy(cast(*u8, cast(i64, &path) + n), "/gtk-4.0/settings.ini", 22);
    found = found + read(cast(*u8, &path), s);
    return found;
}

// The user's files; see read_from. std/env's environment, so the program
// must have called env.init.
fn read_user(s as *settings.Settings) as i32 {
    let is *u8 as xdg = env.getenv("XDG_CONFIG_HOME");
    if (cast(i64, xdg) != 0 && _at(xdg, 0) != 0) { return read_from(xdg, s); }
    let is *u8 as home = env.getenv("HOME");
    if (cast(i64, home) == 0) { return 0; }
    let is i64 as n with mut = 0;
    while (_at(home, n) != 0) { n = n + 1; }
    if (n == 0 || n > 400) { return 0; }
    let is [512]u8 as cfg;
    mem.memcpy(cast(*u8, &cfg), home, n);
    mem.memcpy(cast(*u8, cast(i64, &cfg) + n), "/.config", 9);
    return read_from(cast(*u8, &cfg), s);
}
