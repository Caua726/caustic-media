// window/causticos/backend.cst's damage: what a frame copies into the buffer
// it writes, and what it tells the window manager changed — rectangles kept
// apart where they are apart, as window/damage.cst keeps them, not the box
// round them all (CausticOS #15). The rest of the backend needs the system.
use "std/io.cst" as io;
use "../damage.cst" as damage;
use "backend.cst" as cos;

let is i32 as fails with mut = 0;
fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { io.printf("FAIL: %s\n", name); fails = fails + 1; }
}

fn has(l as *damage.List, x as i32, y as i32, w as i32, h as i32) as i32 {
    let is i32 as k with mut = 0;
    while (k < l.n) {
        if (l.rects[k].x == x && l.rects[k].y == y && l.rects[k].w == w && l.rects[k].h == h) { return 1; }
        k = k + 1;
    }
    return 0;
}

fn area(l as *damage.List) as i64 {
    let is i64 as a with mut = 0;
    let is i32 as k with mut = 0;
    while (k < l.n) { a = a + cast(i64, l.rects[k].w) * cast(i64, l.rects[k].h); k = k + 1; }
    return a;
}

fn main() as i32 {
    let is damage.List as dmg;
    let is damage.List as old with mut;
    let is damage.List as copy;
    let is damage.List as tell;
    damage.clear(&dmg);
    damage.clear(&old);
    // Two changes in opposite corners of an 800 by 600 window.
    damage.add(&dmg, 10, 10, 20, 12, 800, 600);
    damage.add(&dmg, 760, 570, 30, 20, 800, 600);
    cos._frame_rects(&dmg, &old, 2, 5, 800, 600, &copy, &tell);
    check("two corners: both copied apart, not the window between", copy.whole == 0 && copy.n == 2 &&
          has(&copy, 10, 10, 20, 12) == 1 && has(&copy, 760, 570, 30, 20) == 1 && area(&copy) == 240 + 600);
    check("and told apart", tell.whole == 0 && tell.n == 2 && has(&tell, 10, 10, 20, 12) == 1 &&
          has(&tell, 760, 570, 30, 20) == 1);
    // The next frame: one new change; the buffer it writes lacks the last's.
    old = dmg;
    damage.clear(&dmg);
    damage.add(&dmg, 400, 300, 8, 8, 800, 600);
    cos._frame_rects(&dmg, &old, 2, 5, 800, 600, &copy, &tell);
    check("two buffers: the last frame's copied too, each apart", copy.n == 3 && has(&copy, 400, 300, 8, 8) == 1 &&
          has(&copy, 10, 10, 20, 12) == 1 && has(&copy, 760, 570, 30, 20) == 1);
    check("told only its own", tell.n == 1 && has(&tell, 400, 300, 8, 8) == 1);
    cos._frame_rects(&dmg, &old, 1, 5, 800, 600, &copy, &tell);
    check("one buffer: only its own copied", copy.n == 1 && has(&copy, 400, 300, 8, 8) == 1);
    // Overlapping changes: merged, as damage.cst merges them.
    damage.add(&dmg, 404, 304, 8, 8, 800, 600);
    cos._frame_rects(&dmg, &old, 1, 5, 800, 600, &copy, &tell);
    check("overlapping: one rectangle round both", copy.n == 1 && has(&copy, 400, 300, 12, 12) == 1);
    // Not yet shown twice: all of it copied; not once, all of it told.
    cos._frame_rects(&dmg, &old, 2, 1, 800, 600, &copy, &tell);
    check("shown once: all of it copied, its own told", copy.whole == 1 && tell.whole == 0);
    cos._frame_rects(&dmg, &old, 2, 0, 800, 600, &copy, &tell);
    check("never shown: all of it told", tell.whole == 1);
    damage.clear(&dmg);
    damage.clear(&old);
    cos._frame_rects(&dmg, &old, 2, 5, 800, 600, &copy, &tell);
    check("nothing changed: nothing copied, all of it told as before", copy.whole == 0 && copy.n == 0 && tell.whole == 1);
    // Partly outside the window: clipped to it before it is copied or told.
    damage.clear(&dmg);
    damage.clear(&old);
    damage.add(&dmg, 780, 590, 50, 40, 800, 600);
    cos._frame_rects(&dmg, &old, 2, 5, 800, 600, &copy, &tell);
    check("past the edge: clipped", copy.n == 1 && has(&copy, 780, 590, 20, 10) == 1 && has(&tell, 780, 590, 20, 10) == 1);
    // More apart than a list keeps: the rest go into the nearest, and all
    // of each is still copied — none dropped.
    damage.clear(&dmg);
    let is i64 as g with mut = 0;
    while (g < 20) { damage.add(&dmg, (g % 5) * 150, (g / 5) * 140, 10, 10, 800, 600); g = g + 1; }
    cos._frame_rects(&dmg, &old, 1, 5, 800, 600, &copy, &tell);
    let is i32 as covered with mut = 1;
    g = 0;
    while (g < 20) {
        let is i32 as x = cast(i32, (g % 5) * 150);
        let is i32 as y = cast(i32, (g / 5) * 140);
        let is i32 as inside with mut = 0;
        let is i32 as q with mut = 0;
        while (q < copy.n) {
            let is *damage.Rect as rr = &copy.rects[q];
            if (rr.x <= x && rr.y <= y && rr.x + rr.w >= x + 10 && rr.y + rr.h >= y + 10) { inside = 1; }
            q = q + 1;
        }
        if (inside == 0) { covered = 0; }
        g = g + 1;
    }
    check("twenty apart: sixteen rectangles at most, every change inside one", copy.whole == 1 ||
          (copy.n <= 16 && covered == 1));
    if (fails == 0) {
        io.printf("causticos damage: all checks passed\n");
        return 0;
    }
    io.printf("causticos damage: %d failures\n", fails);
    return 1;
}
