// window/causticos/proto.cst — the CausticOS window manager's protocol, 4.
//
// A window is a channel to the window manager carrying 32-byte messages,
// four i64 {type, a, b, c}, and a shared segment the program draws into. The
// first window's channel is the key the program was started with (KEY_WM);
// every other window is asked for on its owner's channel (MSG_WINDOW_NEW),
// and its channel arrives on that one, sent before the MSG_WINDOW answering.
// An object — a segment — always crosses before the message that names it:
// the channel has one slot for it.
//
// Strings longer than a message cross as MSG_TEXT messages, 24 bytes each,
// ahead of the message that uses them; that message carries the length.
//
// The constants are the protocol's own numbers, the way the causticos
// repository's userspace/lib/wmproto says them; this file speaks it, it does
// not import it.
use "std/os.cst" as os;

let is i64 as VERSION   with imut = 4;
let is i64 as MSG_BYTES with imut = 32;

// The program to the window manager.
let is i64 as HELLO        with imut = 1;    // a pages, b stride, c VERSION | kind << 8 | TWO_BUFFERS
let is i64 as COMMIT       with imut = 2;    // a x, b y, c wh(w, h): this changed
let is i64 as SET_TITLE    with imut = 3;    // a length: <= 16 in b, c; else the TEXT before it
let is i64 as CLOSE        with imut = 4;    // this window goes
let is i64 as CLIP_SET     with imut = 8;    // a length: the clipboard is the segment sent before
let is i64 as CLIP_GET     with imut = 9;    // CLIP_DATA answers
let is i64 as POINTER_TRACK with imut = 26;  // a 1: motion with no button held too
let is i64 as SET_CURSOR   with imut = 33;   // a the shape, 0 the window's default
let is i64 as SIZE_HINTS   with imut = 34;   // a wh(min), b wh(max), c wh(asked now); 0 none
let is i64 as TEXT_INPUT   with imut = 35;   // a 0 off, else 1 | purpose << 8; b xy, c wh: the caret
let is i64 as WINDOW_NEW   with imut = 36;   // a window_a(...), b rect16(anchor), c rect16(w, h, dx, dy)
let is i64 as POPUP_PLACE  with imut = 37;   // the same, on the popup's channel: placed again
let is i64 as PRESENT      with imut = 38;   // a the buffer to show (0, 1; -1 one buffer), b 1: FRAME when shown
let is i64 as DRAG_ANSWER  with imut = 47;   // a the format taken (0 none), b the action
let is i64 as SET_FRAME    with imut = 56;   // a 1 the window manager's frame (the default), 0 none: the program's own
let is i64 as MOVE_RESIZE  with imut = 57;   // a 0 a move, else EDGE_* bits: the press held now is dragged
let is i64 as SET_STATE    with imut = 58;   // a SET_MINIMIZE, SET_MAXIMIZE, SET_RESTORE

// The window manager to the program.
let is i64 as WELCOME      with imut = 16;   // a screen w, b screen h, c wh(the window's)
let is i64 as KEY          with imut = 17;   // a keysym, b mods | pressed << 8 | ext << 9, c scancode
let is i64 as RESIZE       with imut = 18;   // a w, b h
let is i64 as FOCUS        with imut = 19;   // a 0 | 1
let is i64 as CLOSE_REQ    with imut = 20;
let is i64 as MOUSE_BTN    with imut = 21;   // a buttons | mods << 8, b x, c y
let is i64 as MOUSE_WHEEL  with imut = 22;   // a notches, up positive; b x, c y
let is i64 as MOUSE_MOVE   with imut = 24;   // as MOUSE_BTN
let is i64 as CLIP_DATA    with imut = 25;   // a length, the segment before it when > 0
let is i64 as TEXT         with imut = 32;   // both ways: a, b, c 24 more bytes of a string
let is i64 as IME_PREEDIT  with imut = 40;   // a length (TEXT before), b, c the caret's byte range (b -1 hidden)
let is i64 as IME_COMMIT   with imut = 41;   // a length: typed
let is i64 as WINDOW       with imut = 42;   // a the tag asked with, b 0 or an errno; the channel before it
let is i64 as POPUP_PLACED with imut = 43;   // a xy(x, y) in the owner's content, b wh(the size)
let is i64 as POPUP_DONE   with imut = 44;   // dismissed: close it
let is i64 as FRAME        with imut = 45;   // a the buffer free again (-1 one buffer), b when shown, ns
let is i64 as DRAG_ENTER   with imut = 50;   // a formats | actions << 16, b x, c y
let is i64 as DRAG_MOTION  with imut = 51;   // b x, c y
let is i64 as DRAG_LEAVE   with imut = 52;
let is i64 as DROP         with imut = 53;   // a format, b bytes, c action; the segment before it
let is i64 as STATE        with imut = 59;   // a STATE_* bits: window/event.cst's own

let is i64 as TWO_BUFFERS  with imut = 0x10000;   // HELLO's c: the segment holds two
let is i64 as TEXT_MAX     with imut = 255;

let is i64 as ROLE_TOPLEVEL with imut = 0;
let is i64 as ROLE_DIALOG   with imut = 1;
let is i64 as ROLE_MENU     with imut = 2;
let is i64 as ROLE_LIST     with imut = 3;
let is i64 as ROLE_TOOLTIP  with imut = 4;
let is i64 as WF_MODAL      with imut = 1;
let is i64 as WF_GRAB       with imut = 2;

let is i64 as EDGE_N with imut = 1;
let is i64 as EDGE_S with imut = 2;
let is i64 as EDGE_W with imut = 4;
let is i64 as EDGE_E with imut = 8;
let is i64 as SET_MINIMIZE with imut = 1;
let is i64 as SET_MAXIMIZE with imut = 2;
let is i64 as SET_RESTORE  with imut = 3;

let is i64 as DND_FILES with imut = 1;   // absolute paths, one a line
let is i64 as DND_TEXT  with imut = 2;   // UTF-8
let is i64 as DND_COPY  with imut = 1;
let is i64 as DND_MOVE  with imut = 2;

// Keysyms: a character is its code point; the named keys are from KEY_BASE.
let is i64 as KEY_BASE      with imut = 0x1000000;
let is i64 as KEY_ENTER     with imut = 0x1000001;
let is i64 as KEY_BACKSPACE with imut = 0x1000002;
let is i64 as KEY_TAB       with imut = 0x1000003;
let is i64 as KEY_ESC       with imut = 0x1000004;
let is i64 as KEY_UP        with imut = 0x1000005;
let is i64 as KEY_DOWN      with imut = 0x1000006;
let is i64 as KEY_LEFT      with imut = 0x1000007;
let is i64 as KEY_RIGHT     with imut = 0x1000008;
let is i64 as KEY_PGUP      with imut = 0x1000009;
let is i64 as KEY_PGDN      with imut = 0x100000A;
let is i64 as KEY_HOME      with imut = 0x100000B;
let is i64 as KEY_END       with imut = 0x100000C;
let is i64 as KEY_DEL       with imut = 0x100000D;
let is i64 as KEY_INSERT    with imut = 0x100000E;
let is i64 as KEY_F1        with imut = 0x1000011;   // F1 .. F12 one after another
let is i64 as MOD_SHIFT     with imut = 1;
let is i64 as MOD_CTRL      with imut = 2;
let is i64 as MOD_ALT       with imut = 4;
let is i64 as MOD_SUPER     with imut = 8;

// The pointer's buttons.
let is i64 as BTN_LEFT    with imut = 1;
let is i64 as BTN_RIGHT   with imut = 2;
let is i64 as BTN_MIDDLE  with imut = 4;
let is i64 as BTN_BACK    with imut = 8;
let is i64 as BTN_FORWARD with imut = 16;

// --- Packing ---

fn wh(w as i64, h as i64) as i64 { return (w << 32) | (h & 0xFFFFFFFF); }
fn wh_w(v as i64) as i64 { return (v >> 32) & 0xFFFFFFFF; }
fn wh_h(v as i64) as i64 { return v & 0xFFFFFFFF; }

fn _signed32(u as i64) as i64 {
    if (u >= 0x80000000) { return u - 0x100000000; }
    return u;
}
fn xy(x as i64, y as i64) as i64 { return ((x & 0xFFFFFFFF) << 32) | (y & 0xFFFFFFFF); }
fn xy_x(v as i64) as i64 { return _signed32((v >> 32) & 0xFFFFFFFF); }
fn xy_y(v as i64) as i64 { return _signed32(v & 0xFFFFFFFF); }

// Four signed 16-bit values in one word, the first in the low bits.
fn rect16(p0 as i64, p1 as i64, p2 as i64, p3 as i64) as i64 {
    return (p0 & 0xFFFF) | ((p1 & 0xFFFF) << 16) | ((p2 & 0xFFFF) << 32) | ((p3 & 0xFFFF) << 48);
}

fn window_a(tag as i64, role as i64, flags as i64, anchor as i64, gravity as i64, adjust as i64) as i64 {
    return (tag & 0xFFFF) | ((role & 0xFF) << 16) | ((flags & 0xFF) << 24)
         | ((anchor & 0xF) << 32) | ((gravity & 0xF) << 36) | ((adjust & 0xFF) << 40);
}

// --- The channel ---

// The bytes at buf, n of them, all written: 0, or a negative errno. A raw
// write: the std's write() sends a missing descriptor's bytes to the serial
// line, which would eat a message.
fn _write_all(fd as i64, buf as *u8, n as i64) as i64 {
    let is i64 as sent with mut = 0;
    while (sent < n) {
        let is i64 as r = syscall(11, fd, cast(i64, buf) + sent, n - sent);
        if (r < 0) { return r; }
        if (r == 0) { return os.caustic.E_PIPE; }
        sent = sent + r;
    }
    return 0;
}

fn send(fd as i64, kind as i64, a as i64, b as i64, c as i64) as i64 {
    let is [4]i64 as m;
    m[0] = kind; m[1] = a; m[2] = b; m[3] = c;
    return _write_all(fd, cast(*u8, &m[0]), MSG_BYTES);
}

// text, n bytes (cut to TEXT_MAX at a character's start), as TEXT messages
// and then {kind, n, b, c}, in one write: the reader never has the text
// without the message that uses it.
fn send_text(fd as i64, kind as i64, text as *u8, n_in as i64, b as i64, c as i64) as i64 {
    let is i64 as n with mut = n_in;
    if (n < 0) { n = 0; }
    if (n > TEXT_MAX) {
        n = TEXT_MAX;
        while (n > 0 && (cast(i64, text[n]) & 0xC0) == 0x80) { n = n - 1; }
    }
    let is [48]i64 as buf;
    let is i64 as w with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        buf[w] = TEXT;
        let is *u8 as into = cast(*u8, &buf[w + 1]);
        let is i64 as z with mut = 0;
        while (z < 24) {
            if (k + z < n) { into[z] = text[k + z]; } else { into[z] = cast(u8, 0); }
            z = z + 1;
        }
        w = w + 4;
        k = k + 24;
    }
    buf[w] = kind; buf[w + 1] = n; buf[w + 2] = b; buf[w + 3] = c;
    w = w + 4;
    return _write_all(fd, cast(*u8, &buf[0]), w * 8);
}

// Whether fd has bytes to read now, or is closed.
fn readable(fd as i64, timeout_ns as i64) as i32 {
    let is [3]i64 as e;
    e[0] = fd; e[1] = os.caustic.POLL_READABLE; e[2] = 0;
    if (os.caustic.poll(&e[0], 1, timeout_ns) <= 0) { return 0; }
    return cast(i32, e[2] != 0);
}

// What arrives on one channel: a message assembled from as many reads as it
// comes in, and the string of the TEXT messages before the one using it.
struct Reader {
    fill  as i64;
    acc   as [4]i64;
    tn    as i64;
    tover as i64;
    tbuf  as [32]i64;          // TEXT_MAX and a NUL
}

fn reader_init(r as *Reader) as void { r.fill = 0; r.tn = 0; r.tover = 0; }

// One message into out when the channel has one now: 1; 0 when there is
// not a whole one yet; -1 when the channel is closed. TEXT messages are
// gathered here and not handed out.
fn next(fd as i64, r as *Reader, out as *i64) as i32 {
    while (readable(fd, 0) == 1) {
        let is i64 as got = syscall(10, fd, cast(i64, &r.acc[0]) + r.fill, MSG_BYTES - r.fill);
        if (got <= 0) { return 0 - 1; }
        r.fill = r.fill + got;
        if (r.fill < MSG_BYTES) { continue; }
        r.fill = 0;
        if (r.acc[0] == TEXT) {
            let is *u8 as src = cast(*u8, &r.acc[1]);
            let is *u8 as dst = cast(*u8, &r.tbuf[0]);
            let is i64 as z with mut = 0;
            while (z < 24) {
                if (r.tn < TEXT_MAX) { dst[r.tn] = src[z]; r.tn = r.tn + 1; } else { r.tover = 1; }
                z = z + 1;
            }
            continue;
        }
        out[0] = r.acc[0]; out[1] = r.acc[1]; out[2] = r.acc[2]; out[3] = r.acc[3];
        return 1;
    }
    return 0;
}

// The string a message of length n names: cut to what came and to a
// character's start, NUL-ended; its length into *len. The next starts afresh.
fn text_take(r as *Reader, n as i64, len as *i64) as *u8 {
    let is i64 as k with mut = n;
    if (k > r.tn) { k = r.tn; }
    if (k < 0) { k = 0; }
    let is *u8 as b = cast(*u8, &r.tbuf[0]);
    if (k < r.tn || r.tover == 1) {
        while (k > 0 && (cast(i64, b[k]) & 0xC0) == 0x80) { k = k - 1; }
    }
    b[k] = cast(u8, 0);
    *len = k;
    r.tn = 0;
    r.tover = 0;
    return b;
}
