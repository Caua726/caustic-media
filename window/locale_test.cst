// window/locale_test.cst — the language a user reads: from POSIX's names and
// the environment's order of them, as a BCP 47 tag; which are written right
// to left.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "locale.cst" as locale;
use "settings.cst" as settings;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn _len(s as *u8) as i64 {
    if (cast(i64, s) == 0) { return 0; }
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    if (n != _len(b)) { return 0; }
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

let is [32]u8 as tag with mut;

// A POSIX name, as a tag: whether it is want ("" for none).
fn posix(s as *u8, want as *u8) as i32 {
    let is i64 as n = locale.from_posix(s, _len(s), cast(*u8, &tag), 32);
    return same(cast(*u8, &tag), n, want);
}

// The environment's variables (null for unset), as a tag.
fn env(language as *u8, all as *u8, messages as *u8, lang as *u8, want as *u8) as i32 {
    let is i64 as n = locale.messages(language, all, messages, lang, cast(*u8, &tag), 32);
    return same(cast(*u8, &tag), n, want);
}

fn main() as i32 {
    // --- POSIX's names ---
    check("a language and a territory", posix("pt_BR", "pt-BR") == 1);
    check("its encoding left out", posix("pt_BR.UTF-8", "pt-BR") == 1 && posix("en_US.utf8", "en-US") == 1);
    check("a modifier left out", posix("de_DE@euro", "de-DE") == 1 && posix("de_DE.UTF-8@euro", "de-DE") == 1);
    check("a language alone", posix("fr", "fr") == 1 && posix("ar.UTF-8", "ar") == 1);
    check("written as it should be: language lower, territory upper", posix("PT_br", "pt-BR") == 1);
    check("a language of three letters", posix("ast_ES", "ast-ES") == 1);
    check("the first and last letters, either case", posix("az_ZA", "az-ZA") == 1 && posix("ZA_az", "za-AZ") == 1);
    check("a territory of three digits, any of them", posix("es_901", "es-901") == 1 && posix("es_019", "es-019") == 1);
    check("not letters nor digits, all of them", posix("es_ABC", "") == 1 && posix("pt_12", "") == 1 && posix("es_9A1", "") == 1 &&
          posix("pt_1R", "") == 1 && posix("pt_B1", "") == 1 && posix("es_90", "") == 1);
    check("signs beside the letters: not letters", posix("p@", "") == 1 && posix("p[_BR", "") == 1 && posix("p`_BR", "") == 1 &&
          posix("p{_BR", "") == 1 && posix("pt_B/", "") == 1 && posix("es_9:1", "") == 1);
    check("only the bytes said", locale.from_posix("frx", 2, cast(*u8, &tag), 32) == 2 && same(cast(*u8, &tag), 2, "fr") == 1);
    check("C and POSIX: no language", posix("C", "") == 1 && posix("POSIX", "") == 1 && posix("C.UTF-8", "") == 1);
    check("nothing: none", posix("", "") == 1 && locale.from_posix(cast(*u8, 0), 0, cast(*u8, &tag), 32) == 0);
    check("not a name: none", posix("pt-BR", "") == 1 && posix("p", "") == 1 && posix("portugues", "") == 1 &&
          posix("pt_B", "") == 1 && posix("12_BR", "") == 1);
    check("no room: none", locale.from_posix("pt_BR", 5, cast(*u8, &tag), 5) == 0 &&
          locale.from_posix("pt_BR", 5, cast(*u8, &tag), 6) == 5);

    // --- The environment's order ---
    check("LANG alone", env(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), "pt_BR.UTF-8", "pt-BR") == 1);
    check("LC_MESSAGES over LANG", env(cast(*u8, 0), cast(*u8, 0), "de_DE", "pt_BR", "de-DE") == 1);
    check("LC_ALL over both", env(cast(*u8, 0), "fr_FR", "de_DE", "pt_BR", "fr-FR") == 1);
    check("empty ones passed over", env("", "", "", "es_ES", "es-ES") == 1);
    check("LANGUAGE over all of them, its first that is a name", env("x1:it_IT:en", "fr_FR", cast(*u8, 0), cast(*u8, 0), "it-IT") == 1 &&
          env("ja", cast(*u8, 0), cast(*u8, 0), "pt_BR", "ja") == 1);
    check("but not in the C locale", env("it_IT", cast(*u8, 0), cast(*u8, 0), "C", "") == 1 &&
          env("it_IT", "C.UTF-8", cast(*u8, 0), "pt_BR", "") == 1);
    check("nor with none set", env("it_IT", cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), "") == 1);
    check("LANGUAGE of none that are: the locale's", env("::12", cast(*u8, 0), cast(*u8, 0), "pt_BR", "pt-BR") == 1);
    check("nothing set: none", env(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), "") == 1);

    // --- Right to left ---
    check("Arabic, Hebrew, Persian, Urdu: right to left", locale.right_to_left("ar-EG", 5) == 1 && locale.right_to_left("he", 2) == 1 &&
          locale.right_to_left("fa-IR", 5) == 1 && locale.right_to_left("ur", 2) == 1 && locale.right_to_left("iw-IL", 5) == 1 &&
          locale.right_to_left("yi", 2) == 1 && locale.right_to_left("ckb-IQ", 6) == 1);
    check("the rest: left to right", locale.right_to_left("pt-BR", 5) == 0 && locale.right_to_left("en", 2) == 0 &&
          locale.right_to_left("", 0) == 0 && locale.right_to_left("arn", 3) == 0 && locale.right_to_left("a", 1) == 0);

    // Every language of two letters and of three near those: right to left
    // only those that are.
    let is i32 as each with mut = 1;
    let is [2]u8 as two;
    let is i64 as x with mut = 97;
    while (x <= 122) {
        let is i64 as y with mut = 97;
        while (y <= 122) {
            two[0] = cast(u8, x);
            two[1] = cast(u8, y);
            let is i32 as rtl = cast(i32, (x == 97 && y == 114) || (x == 104 && y == 101) || (x == 105 && y == 119) ||
                (x == 102 && y == 97) || (x == 117 && y == 114) || (x == 112 && y == 115) || (x == 115 && y == 100) ||
                (x == 117 && y == 103) || (x == 121 && y == 105) || (x == 100 && y == 118));
            if (locale.right_to_left(cast(*u8, &two), 2) != rtl) { each = 0; }
            y = y + 1;
        }
        x = x + 1;
    }
    check("each language of two letters", each == 1);
    check("Pashto, Sindhi, Uyghur, Divehi, Syriac too", locale.right_to_left("ps", 2) == 1 && locale.right_to_left("sd-PK", 5) == 1 &&
          locale.right_to_left("ug", 2) == 1 && locale.right_to_left("dv", 2) == 1 && locale.right_to_left("syr", 3) == 1 &&
          locale.right_to_left("SYR", 3) == 1 && locale.right_to_left("CKB", 3) == 1);
    check("three letters near them: not", locale.right_to_left("ckx", 3) == 0 && locale.right_to_left("cxb", 3) == 0 &&
          locale.right_to_left("xkb", 3) == 0 && locale.right_to_left("syx", 3) == 0 && locale.right_to_left("sxr", 3) == 0 &&
          locale.right_to_left("xyr", 3) == 0);

    // --- In the desktop's settings ---
    let is settings.Settings as s with mut = settings.defaults();
    check("no language at first", s.locale[0] == 0 && (s.known & settings.K_LOCALE) == 0);
    locale.fill(&s, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), "pt_BR.UTF-8");
    check("one read: there, and known", same(cast(*u8, &s.locale), _len(cast(*u8, &s.locale)), "pt-BR") == 1 &&
          (s.known & settings.K_LOCALE) != 0);
    let is settings.Settings as none with mut = settings.defaults();
    locale.fill(&none, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), "C");
    check("none read: not known", (none.known & settings.K_LOCALE) == 0 && none.locale[0] == 0);
    let is settings.Settings as over with mut = settings.defaults();
    settings.merge(&over, &s);
    check("laid over another", same(cast(*u8, &over.locale), _len(cast(*u8, &over.locale)), "pt-BR") == 1);
    settings.merge(&over, &none);
    check("one that knows none: kept", same(cast(*u8, &over.locale), _len(cast(*u8, &over.locale)), "pt-BR") == 1);

    if (fails == 0) {
        io.printf("window locale: all checks passed\n");
        return 0;
    }
    io.printf("window locale: %d failures\n", fails);
    return 1;
}
