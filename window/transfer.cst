// window/transfer.cst — what moves between programs: the clipboard's and a
// drag's data, by format, and the bytes that carry it.
//
// Three formats, as bits: FILES (paths — text/uri-list on Linux, CF_HDROP on
// Windows), TEXT (UTF-8 — UTF8_STRING and text/plain;charset=utf-8 on Linux,
// CF_UNICODETEXT on Windows) and PNG (image/png's bytes; Windows' registered
// "PNG"). Any other by its MIME type's name — text/html, a program's own
// application/x-… — NAMED, one bit for all of them, each with its name and
// bytes in the offer (an X atom of the name, the name itself on Wayland, a
// clipboard format registered by the name on Windows; text/html there the
// "HTML Format" Windows programs read, cf_html). And DIB, Windows' own image
// beside a PNG — CF_DIB's bytes, a BMP without its file header — which the
// toolkit makes from a PNG and back (image/dib.cst): nothing to Linux. Two
// actions: COPY and MOVE.
//
// An Offer is what this program puts on the clipboard or drags: a copy of the
// data of each format offered, kept by the window until another offer takes
// its place — or, for a format offered on demand (offer_lazy,
// offer_lazy_named), none until another program asks for it: then the
// program's function makes it (offer_fill), once, as X11 asks the owner, a
// Wayland source is sent a descriptor, Windows asks a window that put a
// format off (WM_RENDERFORMAT). Bytes grow as data arrives — a selection's chunks, a pipe's
// reads — up to MAX_BYTES, beyond which a transfer is refused rather than cut
// short.
use "std/mem.cst" as mem;

let is i32 as FILES with imut = 1;
let is i32 as TEXT  with imut = 2;
let is i32 as PNG   with imut = 4;
let is i32 as NAMED with imut = 8;
let is i32 as DIB   with imut = 16;
// Only in what a clipboard's change says it offers (event.CLIPBOARD_CHANGED):
// text/html among its named formats, NAMED with it.
let is i32 as HTML  with imut = 32;

// The most named formats an offer holds, and the longest name (bytes, its
// zero not counted).
let is i64 as MAX_NAMED with imut = 8;
let is i64 as MAX_NAME  with imut = 127;

let is i32 as COPY with imut = 1;
let is i32 as MOVE with imut = 2;

let is i64 as MAX_BYTES with imut = 268435456;   // 256 MB

// --- Bytes ---

struct Bytes {
    data as *u8;
    len  as i64;
    cap  as i64;
}

fn bytes_init(b as *Bytes) as void { b.data = cast(*u8, 0); b.len = 0; b.cap = 0; }

fn bytes_free(b as *Bytes) as void {
    if (cast(i64, b.data) != 0) { mem.core.munmap(b.data, b.cap); }
    bytes_init(b);
}

// Room for n bytes in all, one more kept for a terminating zero: 1, or 0 when
// that is more than MAX_BYTES or memory is refused (what was there kept).
fn reserve(b as *Bytes, n as i64) as i32 {
    if (n < 0 || n > MAX_BYTES) { return 0; }
    if (n + 1 <= b.cap) { return 1; }
    let is i64 as cap with mut = b.cap * 2;
    if (cap < 4096) { cap = 4096; }
    while (cap < n + 1) { cap = cap * 2; }
    let is *u8 as d = mem.core.mmap_anon(cap);
    if (cast(i64, d) == 0) { return 0; }
    if (b.len > 0) { mem.memcpy(d, b.data, b.len); }
    if (cast(i64, b.data) != 0) { mem.core.munmap(b.data, b.cap); }
    b.data = d; b.cap = cap;
    return 1;
}

// n bytes of p after what is there, a zero after them: 1, or 0 when there is
// no room (nothing added).
fn append(b as *Bytes, p as *u8, n as i64) as i32 {
    if (n < 0 || reserve(b, b.len + n) == 0) { return 0; }
    if (n > 0) { mem.memcpy(cast(*u8, cast(i64, b.data) + b.len), p, n); }
    b.len = b.len + n;
    b.data[b.len] = 0;
    return 1;
}

// Emptied, its memory kept.
fn bytes_clear(b as *Bytes) as void {
    b.len = 0;
    if (cast(i64, b.data) != 0) { b.data[0] = 0; }
}

fn bytes_set(b as *Bytes, p as *u8, n as i64) as i32 {
    bytes_clear(b);
    return append(b, p, n);
}

// --- What is offered ---

// A format by its MIME type's name: the name, zero-terminated, and its bytes.
struct Named {
    name as [128]u8;
    n    as i64;
    data as Bytes;
    lazy as i32;        // made on demand, not yet: offer_fill makes it
    _pad as i32;
}

// What makes a format offered on demand: cb(user, format, name, n, out) —
// format one of the bits (NAMED: name, n bytes, which), its bytes into out —
// 1 when made.
type ProvideFn = fn(*u8, i32, *u8, i64, *Bytes) as i32;

struct Offer {
    formats as i32;     // the formats it has, bits
    text    as Bytes;   // TEXT: UTF-8
    png     as Bytes;   // PNG: the file's bytes
    uris    as Bytes;   // FILES: text/uri-list, built from the paths
    paths   as Bytes;   // FILES: the paths, back to back, each zero-terminated
    count   as i64;     // FILES: how many
    named   as [8]Named;   // NAMED: each by its name
    named_n as i64;
    dib     as Bytes;   // DIB: a BITMAPINFOHEADER (or V5), then the rows
    lazy    as i32;     // the formats made on demand, not yet made: TEXT, PNG, DIB bits
    _pad_lazy as i32;
    provide as ProvideFn;   // what makes them; null for none
    provide_user as *u8;
}

fn offer_init(o as *Offer) as void {
    o.formats = 0;
    bytes_init(&o.text); bytes_init(&o.png); bytes_init(&o.uris); bytes_init(&o.paths);
    o.count = 0;
    let is i64 as k with mut = 0;
    while (k < MAX_NAMED) {
        o.named[k].name[0] = 0;
        o.named[k].n = 0;
        bytes_init(&o.named[k].data);
        o.named[k].lazy = 0;
        k = k + 1;
    }
    o.named_n = 0;
    bytes_init(&o.dib);
    o.lazy = 0;
    o.provide = cast(ProvideFn, 0);
    o.provide_user = cast(*u8, 0);
}

fn offer_free(o as *Offer) as void {
    bytes_free(&o.text); bytes_free(&o.png); bytes_free(&o.uris); bytes_free(&o.paths);
    bytes_free(&o.dib);
    let is i64 as k with mut = 0;
    while (k < MAX_NAMED) {
        bytes_free(&o.named[k].data);
        o.named[k].name[0] = 0;
        o.named[k].n = 0;
        o.named[k].lazy = 0;
        k = k + 1;
    }
    o.named_n = 0;
    o.formats = 0; o.count = 0;
    o.lazy = 0;
    o.provide = cast(ProvideFn, 0);
    o.provide_user = cast(*u8, 0);
}

// Formats — TEXT, PNG, DIB bits — offered on demand, made by cb(user, …)
// when asked for: what makes every lazy format of the offer, one cb an offer.
fn offer_lazy(o as *Offer, formats as i32, cb as ProvideFn, user as *u8) as void {
    let is i32 as f = formats & (TEXT | PNG | DIB);
    o.provide = cb;
    o.provide_user = user;
    o.lazy = o.lazy | f;
    o.formats = o.formats | f;
}

// The format named name (n bytes) offered on demand, by the offer's cb
// (offer_lazy's): 1, or 0 for no room or a name too long.
fn offer_lazy_named(o as *Offer, name as *u8, n as i64, cb as ProvideFn, user as *u8) as i32 {
    if (n <= 0 || n > MAX_NAME) { return 0; }
    let is i64 as k with mut = offer_find(o, name, n);
    if (k < 0) {
        if (o.named_n >= MAX_NAMED) { return 0; }
        k = o.named_n;
        o.named_n = o.named_n + 1;
    }
    bytes_clear(&o.named[k].data);
    mem.memcpy(&o.named[k].name[0], name, n);
    o.named[k].name[n] = 0;
    o.named[k].n = n;
    o.named[k].lazy = 1;
    o.provide = cb;
    o.provide_user = user;
    o.formats = o.formats | NAMED;
    return 1;
}

// Format f's bytes made now when it was offered on demand and not made yet
// (NAMED: the i-th named one): 1 when they are there, made or not lazy; 0
// when making them failed, the format then empty.
fn offer_fill(o as *Offer, f as i32, i as i64) as i32 {
    if (f == NAMED) {
        if (i < 0 || i >= o.named_n) { return 0; }
        if (o.named[i].lazy == 0) { return 1; }
        o.named[i].lazy = 0;
        if (cast(i64, o.provide) == 0) { return 0; }
        bytes_clear(&o.named[i].data);
        return call(o.provide, o.provide_user, NAMED, &o.named[i].name[0], o.named[i].n, &o.named[i].data);
    }
    if ((o.lazy & f) == 0) { return 1; }
    o.lazy = o.lazy & (0 - 1 - f);
    if (cast(i64, o.provide) == 0) { return 0; }
    let is *Bytes as b with mut = &o.text;
    if (f == PNG) { b = &o.png; }
    if (f == DIB) { b = &o.dib; }
    bytes_clear(b);
    return call(o.provide, o.provide_user, f, cast(*u8, 0), 0, b);
}

// Whether a format is offered on demand and not made yet.
fn offer_is_lazy(o as *Offer, f as i32, i as i64) as i32 {
    if (f == NAMED) {
        if (i < 0 || i >= o.named_n) { return 0; }
        return o.named[i].lazy;
    }
    return cast(i32, (o.lazy & f) != 0);
}

// Whether name, n bytes, is the one zero-terminated at z.
fn _named_is(z as *u8, name as *u8, n as i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < n && z[i] != 0 && z[i] == name[i]) { i = i + 1; }
    return cast(i32, i == n && z[i] == 0);
}

// The named format name (n bytes) as the offer has it: its index, -1 for none.
fn offer_find(o as *Offer, name as *u8, n as i64) as i64 {
    let is i64 as k with mut = 0;
    while (k < o.named_n) {
        if (_named_is(&o.named[k].name[0], name, n) == 1) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

// The format named name (n bytes, a MIME type: text/html, application/x-…),
// len bytes at p, offered too — in place of what was offered by that name:
// 1, or 0 for a name too long or empty, no room for one more, or bytes not
// kept. The three of transfer's own (text, PNG, files) are offered by theirs.
fn offer_named(o as *Offer, name as *u8, n as i64, p as *u8, len as i64) as i32 {
    if (n <= 0 || n > MAX_NAME) { return 0; }
    let is i64 as k with mut = offer_find(o, name, n);
    if (k < 0) {
        if (o.named_n >= MAX_NAMED) { return 0; }
        k = o.named_n;
    }
    if (bytes_set(&o.named[k].data, p, len) == 0) { return 0; }
    mem.memcpy(&o.named[k].name[0], name, n);
    o.named[k].name[n] = 0;
    o.named[k].n = n;
    if (k == o.named_n) { o.named_n = o.named_n + 1; }
    o.formats = o.formats | NAMED;
    return 1;
}

// The i-th named format's name, zero-terminated; null past the last.
fn named_name(o as *Offer, i as i64) as *u8 {
    if (i < 0 || i >= o.named_n) { return cast(*u8, 0); }
    return &o.named[i].name[0];
}

fn named_length(o as *Offer, i as i64) as i64 {
    if (i < 0 || i >= o.named_n) { return 0; }
    return o.named[i].n;
}

// Its bytes — made now when offered on demand; null past the last.
fn named_bytes(o as *Offer, i as i64) as *Bytes {
    if (i < 0 || i >= o.named_n) { return cast(*Bytes, 0); }
    offer_fill(o, NAMED, i);
    return &o.named[i].data;
}

// dst made a copy of src, every format of it: 1, or 0 (dst then empty) when
// one could not be kept. dst's own let go first.
fn offer_copy(dst as *Offer, src as *Offer) as i32 {
    offer_free(dst);
    offer_init(dst);
    let is i32 as eager = src.formats & (0 - 1 - src.lazy);
    if ((eager & TEXT) != 0 && offer_text(dst, src.text.data, src.text.len) == 0) { offer_free(dst); return 0; }
    if ((eager & PNG) != 0 && offer_png(dst, src.png.data, src.png.len) == 0) { offer_free(dst); return 0; }
    if ((eager & FILES) != 0 && offer_files(dst, src.paths.data, src.count) == 0) { offer_free(dst); return 0; }
    if ((eager & DIB) != 0 && offer_dib(dst, src.dib.data, src.dib.len) == 0) { offer_free(dst); return 0; }
    // What is made on demand: said so again, made by the same function.
    if (src.lazy != 0) { offer_lazy(dst, src.lazy, src.provide, src.provide_user); }
    let is i64 as k with mut = 0;
    while (k < src.named_n) {
        let is i32 as ok with mut = 0;
        if (src.named[k].lazy == 1) {
            ok = offer_lazy_named(dst, &src.named[k].name[0], src.named[k].n, src.provide, src.provide_user);
        } else {
            ok = offer_named(dst, &src.named[k].name[0], src.named[k].n, src.named[k].data.data, src.named[k].data.len);
        }
        if (ok == 0) { offer_free(dst); return 0; }
        k = k + 1;
    }
    return 1;
}

// Text, n bytes of UTF-8 at s, offered too: 1, or 0 when it could not be kept.
fn offer_text(o as *Offer, s as *u8, n as i64) as i32 {
    if (bytes_set(&o.text, s, n) == 0) { return 0; }
    o.formats = o.formats | TEXT;
    return 1;
}

// A PNG image, n bytes at p, offered too.
fn offer_png(o as *Offer, p as *u8, n as i64) as i32 {
    if (n < 8 || bytes_set(&o.png, p, n) == 0) { return 0; }
    o.formats = o.formats | PNG;
    return 1;
}

// The same image as a DIB, n bytes at p — header and rows — offered too:
// Windows' programs that read no PNG read it.
fn offer_dib(o as *Offer, p as *u8, n as i64) as i32 {
    if (n < 40 || bytes_set(&o.dib, p, n) == 0) { return 0; }
    o.formats = o.formats | DIB;
    return 1;
}

// n absolute paths, back to back at paths, each zero-terminated, offered too:
// as text/uri-list, each file:// with its bytes percent-encoded where a URI
// may not hold them. Absolute is "/…", or Windows' "C:\…" (file:///C:/…) or
// "\\host\share\…" (file://host/share/…), their backslashes slashes in the
// URI. 0 for a path that is not absolute.
fn offer_files(o as *Offer, paths as *u8, n as i64) as i32 {
    bytes_clear(&o.uris); bytes_clear(&o.paths);
    o.count = 0;
    let is i64 as at with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        let is *u8 as p = cast(*u8, cast(i64, paths) + at);
        let is i64 as len with mut = 0;
        while (p[len] != 0) { len = len + 1; }
        let is i32 as kind = _absolute(p, len);
        if (kind == 0) { return 0; }
        if (append(&o.paths, p, len + 1) == 0) { return 0; }
        let is *u8 as head with mut = "file://";
        if (kind == _DRIVE) { head = "file:///"; }
        if (kind == _SHARE) { head = "file:"; }
        let is i64 as hn with mut = 0;
        while (head[hn] != 0) { hn = hn + 1; }
        if (append(&o.uris, head, hn) == 0) { return 0; }
        let is i64 as i with mut = 0;
        while (i < len) {
            let is i64 as c with mut = cast(i64, p[i]) & 255;
            if (c == 92 && kind != _POSIX) { c = 47; }
            if (_uri_plain(c) == 1) {
                let is u8 as b = cast(u8, c);
                if (append(&o.uris, &b, 1) == 0) { return 0; }
            } else {
                let is [3]u8 as e;
                e[0] = 37; e[1] = _hex_digit(c >> 4); e[2] = _hex_digit(c & 15);
                if (append(&o.uris, &e[0], 3) == 0) { return 0; }
            }
            i = i + 1;
        }
        if (append(&o.uris, "\r\n", 2) == 0) { return 0; }
        at = at + len + 1;
        k = k + 1;
    }
    o.count = n;
    o.formats = o.formats | FILES;
    return 1;
}

let is i32 as _POSIX with imut = 1;
let is i32 as _DRIVE with imut = 2;
let is i32 as _SHARE with imut = 3;

// What absolute path p (len bytes) is: _POSIX, _DRIVE, _SHARE; 0 for none.
fn _absolute(p as *u8, len as i64) as i32 {
    if (len >= 1 && p[0] == 47) { return _POSIX; }
    let is i64 as c = cast(i64, p[0]) | 32;
    if (len >= 3 && c >= 97 && c <= 122 && p[1] == 58 && (p[2] == 92 || p[2] == 47)) { return _DRIVE; }
    if (len >= 3 && p[0] == 92 && p[1] == 92 && p[2] != 92) { return _SHARE; }
    return 0;
}

// The bytes of format f as they go out: text, the PNG, the uri-list. A named
// one's by named_bytes.
fn offer_bytes(o as *Offer, f as i32) as *Bytes {
    offer_fill(o, f, 0 - 1);
    if (f == PNG) { return &o.png; }
    if (f == DIB) { return &o.dib; }
    if (f == FILES) { return &o.uris; }
    return &o.text;
}

// A path's byte as is in a URI: unreserved, '/', and the sub-delimiters a
// path may hold — the rest percent-encoded.
fn _uri_plain(c as i64) as i32 {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)) { return 1; }
    if (c == 45 || c == 46 || c == 95 || c == 126 || c == 47) { return 1; }   // - . _ ~ /
    if (c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 ||
        c == 43 || c == 44 || c == 59 || c == 61 || c == 58 || c == 64) { return 1; }   // ! $ & ' ( ) * + , ; = : @
    return 0;
}

fn _hex_digit(v as i64) as u8 {
    if (v < 10) { return cast(u8, 48 + v); }
    return cast(u8, 55 + v);
}

fn _hex(c as i64) as i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

// --- text/uri-list ---

// The local files of a text/uri-list, n bytes at src — one URI a line, CRLF
// or LF, '#' a comment — as paths into out, back to back, each
// zero-terminated, percent-escapes decoded; "file:" URIs only, their host
// part skipped ("file://host/path", "file:///path", "file:/path"). How many.
fn parse_uri_list(src as *u8, n as i64, out as *Bytes) as i64 {
    bytes_clear(out);
    let is i64 as count with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        while (i < n && (src[i] == 13 || src[i] == 10 || src[i] == 32 || src[i] == 9)) { i = i + 1; }
        if (i >= n) { break; }
        let is i64 as start = i;
        while (i < n && src[i] != 13 && src[i] != 10) { i = i + 1; }
        let is i64 as end with mut = i;
        while (end > start && (src[end - 1] == 32 || src[end - 1] == 9)) { end = end - 1; }
        if (src[start] != 35 && _take_file_uri(src, start, end, out) == 1) { count = count + 1; }
    }
    return count;
}

fn _take_file_uri(src as *u8, from as i64, to as i64, out as *Bytes) as i32 {
    let is i64 as i with mut = from;
    if (to - i < 6 || src[i] != 102 || src[i + 1] != 105 || src[i + 2] != 108 || src[i + 3] != 101 || src[i + 4] != 58) {
        return 0;
    }
    i = i + 5;
    if (to - i >= 2 && src[i] == 47 && src[i + 1] == 47) {
        // An authority: the path begins at the next '/'.
        i = i + 2;
        while (i < to && src[i] != 47) { i = i + 1; }
    }
    if (i >= to || src[i] != 47) { return 0; }
    let is i64 as mark = out.len;
    while (i < to) {
        let is i64 as c = cast(i64, src[i]) & 255;
        let is [1]u8 as one;
        if (c == 37 && i + 2 < to && _hex(cast(i64, src[i + 1]) & 255) >= 0 && _hex(cast(i64, src[i + 2]) & 255) >= 0) {
            let is i64 as v = _hex(cast(i64, src[i + 1]) & 255) * 16 + _hex(cast(i64, src[i + 2]) & 255);
            if (v == 0) { out.len = mark; return 0; }   // a NUL in a path: not a path
            one[0] = cast(u8, v);
            i = i + 3;
        } else {
            one[0] = cast(u8, c);
            i = i + 1;
        }
        if (append(out, &one[0], 1) == 0) { out.len = mark; return 0; }
    }
    let is [1]u8 as z;
    z[0] = 0;
    if (append(out, &z[0], 1) == 0) { out.len = mark; return 0; }
    return 1;
}

// The i-th of count paths back to back in b; null for none.
fn path_at(b as *Bytes, count as i64, i as i64) as *u8 {
    if (i < 0 || i >= count || cast(i64, b.data) == 0) { return cast(*u8, 0); }
    let is i64 as at with mut = 0;
    let is i64 as k with mut = 0;
    while (k < i) {
        while (b.data[at] != 0) { at = at + 1; }
        at = at + 1;
        k = k + 1;
    }
    return cast(*u8, cast(i64, b.data) + at);
}

// --- Names on Linux ---

let is *u8 as MIME_URIS with imut = "text/uri-list";
let is *u8 as MIME_PNG  with imut = "image/png";
let is *u8 as MIME_UTF8 with imut = "text/plain;charset=utf-8";
let is *u8 as MIME_HTML with imut = "text/html";

// --- A list of names: what another program offers ---
//
// The names of the formats offered, back to back, each zero-terminated, as
// a selection's or a drag's types are learnt: the three of transfer's own
// by their bits, and every other by its name here.
struct Names {
    list as Bytes;
    n    as i64;
}

fn names_init(l as *Names) as void { bytes_init(&l.list); l.n = 0; }
fn names_free(l as *Names) as void { bytes_free(&l.list); l.n = 0; }
fn names_clear(l as *Names) as void { bytes_clear(&l.list); l.n = 0; }

// name, n bytes, added — unless it is there already, empty, too long or
// there are 32: 1 when added.
fn names_add(l as *Names, name as *u8, n as i64) as i32 {
    if (n <= 0 || n > MAX_NAME || l.n >= 32 || names_has(l, name, n) == 1) { return 0; }
    if (append(&l.list, name, n) == 0) { return 0; }
    let is [1]u8 as z;
    z[0] = 0;
    if (append(&l.list, &z[0], 1) == 0) { return 0; }
    l.n = l.n + 1;
    return 1;
}

fn names_has(l as *Names, name as *u8, n as i64) as i32 {
    let is i64 as k with mut = 0;
    while (k < l.n) {
        if (_named_is(path_at(&l.list, l.n, k), name, n) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

// The i-th name, zero-terminated; null past the last.
fn names_at(l as *Names, i as i64) as *u8 { return path_at(&l.list, l.n, i); }

// --- HTML on Windows: "HTML Format" ---
//
// Windows programs put HTML on the clipboard as "HTML Format": a header of
// byte offsets into what follows — Version, StartHTML, EndHTML,
// StartFragment, EndFragment, each a ten-digit decimal — then the document,
// the part copied between <!--StartFragment--> and <!--EndFragment-->.

fn _put_num(out as *u8, at as i64, v as i64) as void {
    let is i64 as k with mut = 9;
    let is i64 as x with mut = v;
    while (k >= 0) {
        out[at + k] = cast(u8, 48 + x % 10);
        x = x / 10;
        k = k - 1;
    }
}

// html, n bytes of UTF-8 — a document or a fragment of one — as HTML Format
// into out: the fragment the whole of it, inside <html><body> when it has
// none of its own. 1, or 0 when it could not be kept.
fn cf_html_wrap(html as *u8, n as i64, out as *Bytes) as i32 {
    let is *u8 as head = "Version:0.9\r\nStartHTML:0000000000\r\nEndHTML:0000000000\r\nStartFragment:0000000000\r\nEndFragment:0000000000\r\n";
    let is *u8 as open = "<html><body>\r\n<!--StartFragment-->";
    let is *u8 as shut = "<!--EndFragment-->\r\n</body></html>";
    let is i64 as hn with mut = 0;
    while (head[hn] != 0) { hn = hn + 1; }
    let is i64 as on with mut = 0;
    while (open[on] != 0) { on = on + 1; }
    let is i64 as sn with mut = 0;
    while (shut[sn] != 0) { sn = sn + 1; }
    bytes_clear(out);
    if (append(out, head, hn) == 0 || append(out, open, on) == 0 || append(out, html, n) == 0 || append(out, shut, sn) == 0) {
        return 0;
    }
    // The offsets: the document from after the header to the end, the
    // fragment between the two markers.
    _put_num(out.data, 23, hn);
    _put_num(out.data, 43, out.len);
    _put_num(out.data, 69, hn + on);
    _put_num(out.data, 93, hn + on + n);
    return 1;
}

// The number after key ("StartFragment:") in HTML Format's header, src n
// bytes; -1 when it is not there.
fn _header_num(src as *u8, n as i64, key as *u8) as i64 {
    let is i64 as kn with mut = 0;
    while (key[kn] != 0) { kn = kn + 1; }
    let is i64 as i with mut = 0;
    while (i + kn <= n) {
        if (src[i] == key[0] && mem.memcmp(cast(*u8, cast(i64, src) + i), key, kn) == 0) {
            let is i64 as j with mut = i + kn;
            let is i64 as v with mut = 0;
            let is i32 as any with mut = 0;
            while (j < n && src[j] >= 48 && src[j] <= 57) {
                v = v * 10 + cast(i64, src[j]) - 48;
                any = 1;
                j = j + 1;
            }
            if (any == 0) { return 0 - 1; }
            return v;
        }
        // The header is over at the first '<'.
        if (src[i] == 60) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}

// What HTML Format src (n bytes) holds, into out: the fragment copied when
// its offsets say where — or the document — as UTF-8. 1, or 0 for a header
// that says neither.
fn cf_html_unwrap(src as *u8, n as i64, out as *Bytes) as i32 {
    let is i64 as a with mut = _header_num(src, n, "StartFragment:");
    let is i64 as b with mut = _header_num(src, n, "EndFragment:");
    if (a < 0 || b < a || b > n) {
        a = _header_num(src, n, "StartHTML:");
        b = _header_num(src, n, "EndHTML:");
    }
    if (a < 0 || b < a || b > n) { bytes_clear(out); return 0; }
    return bytes_set(out, cast(*u8, cast(i64, src) + a), b - a);
}

fn _is(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n && b[i] != 0 && a[i] == b[i]) { i = i + 1; }
    return cast(i32, i == n && b[i] == 0);
}

// The format a MIME type (or X target) name, n bytes, carries; 0 for none of
// ours.
fn format_of(name as *u8, n as i64) as i32 {
    if (_is(name, n, MIME_URIS) == 1) { return FILES; }
    if (_is(name, n, MIME_PNG) == 1) { return PNG; }
    if (text_rank(name, n) < 9) { return TEXT; }
    return 0;
}

// How much a text type is preferred: lower first; 9 for not text. UTF-8 by
// name, then UTF8_STRING, then text/plain (UTF-8 from any current program).
fn text_rank(name as *u8, n as i64) as i32 {
    if (_is(name, n, MIME_UTF8) == 1) { return 0; }
    if (_is(name, n, "UTF8_STRING") == 1) { return 1; }
    if (_is(name, n, "text/plain") == 1) { return 2; }
    return 9;
}

// UTF-8 cut at most max bytes, never inside a character: how many are kept.
fn utf8_cut(s as *u8, n as i64, max as i64) as i64 {
    if (n <= max) { return n; }
    let is i64 as m with mut = max;
    while (m > 0 && (cast(i64, s[m]) & 192) == 128) { m = m - 1; }
    return m;
}
