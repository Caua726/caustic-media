// window/fonts_test.cst — where each platform keeps fonts, and where the
// font index is kept: from the variables the platforms set, given here, and
// from this process's own environment.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "fonts.cst" as fonts;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (*cast(*u8, cast(i64, s) + n) != 0) { n = n + 1; }
    return n;
}

fn eq(a as *u8, b as *u8) as i32 {
    let is i64 as n = len(b);
    if (len(a) != n || mem.memcmp(a, b, n) != 0) {
        io.printf("  '%s', want '%s'\n", a, b);
        return 0;
    }
    return 1;
}

// The directories d holds are exactly a, b, c and e, those not null.
fn dirs_are(d as *fonts.Dirs, a as *u8, b as *u8, c as *u8, e as *u8) as i32 {
    let is [4]*u8 as want;
    want[0] = a;
    want[1] = b;
    want[2] = c;
    want[3] = e;
    let is i64 as n with mut = 0;
    while (n < 4 && cast(i64, want[n]) != 0) { n = n + 1; }
    if (d.n != n) {
        io.printf("  %d directories, want %d\n", d.n, n);
        return 0;
    }
    let is i64 as i with mut = 0;
    while (i < n) {
        if (eq(fonts.dir(d, i), want[i]) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

let is [600]u8 as long_home with mut;
let is [512]u8 as out with mut;

// "x" into out, before a call that should leave it otherwise; 0.
fn fill() as i64 {
    out[0] = cast(u8, 120);
    out[1] = cast(u8, 0);
    return 0;
}

// The index's place as the call left it in out, which held "x" before.
fn index_is(n as i64, want as *u8) as i32 {
    if (cast(i64, want) == 0) {
        if (n != 0 || out[0] != 0) {
            io.printf("  an index at '%s'\n", cast(*u8, &out));
            return 0;
        }
        return 1;
    }
    if (n != len(want)) {
        io.printf("  length %d\n", n);
        return 0;
    }
    return eq(cast(*u8, &out), want);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is *u8 as none = cast(*u8, 0);
    let is fonts.Dirs as d;

    // --- Linux ---
    fonts.linux_dirs("/home/ana", none, &d);
    check("Linux: the system's, then the user's",
          dirs_are(&d, "/usr/share/fonts", "/usr/local/share/fonts", "/home/ana/.local/share/fonts", "/home/ana/.fonts"));
    fonts.linux_dirs("/home/ana", "", &d);
    check("an empty XDG_DATA_HOME is none",
          dirs_are(&d, "/usr/share/fonts", "/usr/local/share/fonts", "/home/ana/.local/share/fonts", "/home/ana/.fonts"));
    fonts.linux_dirs("/home/ana", "/data/ana", &d);
    check("XDG_DATA_HOME in place of ~/.local/share",
          dirs_are(&d, "/usr/share/fonts", "/usr/local/share/fonts", "/data/ana/fonts", "/home/ana/.fonts"));
    fonts.linux_dirs("/home/ana", "data", &d);
    check("a relative XDG_DATA_HOME is ignored",
          dirs_are(&d, "/usr/share/fonts", "/usr/local/share/fonts", "/home/ana/.local/share/fonts", "/home/ana/.fonts"));
    fonts.linux_dirs(none, "/data/ana", &d);
    check("no home: XDG_DATA_HOME still",
          dirs_are(&d, "/usr/share/fonts", "/usr/local/share/fonts", "/data/ana/fonts", none));
    fonts.linux_dirs("", none, &d);
    check("no home at all: the system's alone", dirs_are(&d, "/usr/share/fonts", "/usr/local/share/fonts", none, none));
    // A path too long is left out, not cut: 511 bytes is the longest.
    let is i64 as i with mut = 0;
    long_home[0] = cast(u8, 47);
    i = 1;
    while (i < 505) { long_home[i] = cast(u8, 97); i = i + 1; }
    long_home[505] = cast(u8, 0);
    fonts.linux_dirs(cast(*u8, &long_home), none, &d);
    check("a home too long: left out", dirs_are(&d, "/usr/share/fonts", "/usr/local/share/fonts", none, none));
    long_home[504] = cast(u8, 0);
    fonts.linux_dirs(cast(*u8, &long_home), none, &d);
    check("~/.fonts at the longest", d.n == 3 && len(fonts.dir(&d, 2)) == 511);
    long_home[492] = cast(u8, 0);
    fonts.linux_dirs(cast(*u8, &long_home), none, &d);
    check("both at the longest", d.n == 4 && len(fonts.dir(&d, 2)) == 511 && len(fonts.dir(&d, 3)) == 499);
    long_home[492] = cast(u8, 97);
    long_home[493] = cast(u8, 0);
    fonts.linux_dirs(cast(*u8, &long_home), none, &d);
    check("one past it", d.n == 3 && len(fonts.dir(&d, 2)) == 500);

    // --- Windows ---
    fonts.windows_dirs("C:\\Windows", "C:\\Users\\ana\\AppData\\Local", &d);
    check("Windows: the system's, then the user's",
          dirs_are(&d, "C:\\Windows\\Fonts", "C:\\Users\\ana\\AppData\\Local\\Microsoft\\Windows\\Fonts", none, none));
    fonts.windows_dirs(none, "", &d);
    check("Windows with neither variable", dirs_are(&d, "C:\\Windows\\Fonts", none, none, none));

    // --- The index ---
    check("Linux: ~/.cache", index_is(fill() + fonts.linux_index("/home/ana", none, cast(*u8, &out), 512),
                                       "/home/ana/.cache/caustic-media/fonts.index"));
    check("XDG_CACHE_HOME", index_is(fill() + fonts.linux_index("/home/ana", "/var/cache/ana", cast(*u8, &out), 512),
                                      "/var/cache/ana/caustic-media/fonts.index"));
    check("a relative XDG_CACHE_HOME is ignored", index_is(fill() + fonts.linux_index("/home/ana", "cache", cast(*u8, &out), 512),
                                                           "/home/ana/.cache/caustic-media/fonts.index"));
    check("no home, no cache: none", index_is(fill() + fonts.linux_index(none, "", cast(*u8, &out), 512), none));
    check("no room: none", index_is(fill() + fonts.linux_index("/home/ana", none, cast(*u8, &out), 42), none));
    check("no room at all: nothing written", fill() + fonts.linux_index(none, none, cast(*u8, &out), 0) == 0 && out[0] == 120);
    check("room for it exactly", index_is(fill() + fonts.linux_index("/home/ana", none, cast(*u8, &out), 43),
                                           "/home/ana/.cache/caustic-media/fonts.index"));
    check("Windows: under LOCALAPPDATA", index_is(fill() + fonts.windows_index("C:\\Users\\ana\\AppData\\Local", cast(*u8, &out), 512),
                                                  "C:\\Users\\ana\\AppData\\Local\\caustic-media\\fonts.index"));
    check("Windows without it: none", index_is(fill() + fonts.windows_index(none, cast(*u8, &out), 512), none));

    // --- This process ---
    // Windows's getenv answers in one buffer, so the first value is copied.
    let is fonts.Dirs as mine;
    fonts.system(&mine);
    let is [512]u8 as first;
    let is *u8 as v with mut = cast(*u8, 0);
    if (__target_is_windows == 1) { v = env.getenv("WINDIR"); } else { v = env.getenv("HOME"); }
    let is *u8 as pf with mut = cast(*u8, 0);
    if (cast(i64, v) != 0) {
        mem.memcpy(cast(*u8, &first), v, len(v) + 1);
        pf = cast(*u8, &first);
    }
    if (__target_is_windows == 1) {
        fonts.windows_dirs(pf, env.getenv("LOCALAPPDATA"), &d);
        check("wine sets both", d.n == 2);
    } else {
        fonts.linux_dirs(pf, env.getenv("XDG_DATA_HOME"), &d);
    }
    let is i32 as same with mut = 1;
    if (mine.n != d.n) { same = 0; }
    i = 0;
    while (same == 1 && i < d.n) {
        if (eq(fonts.dir(&mine, i), fonts.dir(&d, i)) == 0) { same = 0; }
        i = i + 1;
    }
    check("this system's, from its environment", same);
    let is [512]u8 as want;
    let is i64 as wn with mut = 0;
    if (__target_is_windows == 1) {
        wn = fonts.windows_index(env.getenv("LOCALAPPDATA"), cast(*u8, &want), 512);
    } else {
        wn = fonts.linux_index(pf, env.getenv("XDG_CACHE_HOME"), cast(*u8, &want), 512);
    }
    let is i64 as n = fonts.index_path(cast(*u8, &out), 512);
    check("its index", n == wn && (n == 0 || eq(cast(*u8, &out), cast(*u8, &want)) == 1));

    if (fails > 0) {
        io.printf("window fonts: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("window fonts: all checks passed\n");
    return 0;
}
