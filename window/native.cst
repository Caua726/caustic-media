// window/native.cst — access to platform native handles.
//
// When Vulkan or OpenGL renders, the swapchain presents directly to the native
// window, bypassing any software blit. The native handles are public contract.

use "device.cst" as device;
use "x11/x11.cst" as x11;

fn x11_display(w as *device.Window) as *u8 {
    if (w.backend == device.X11) {
        return x11.display(&w.x11_win);
    }
    return cast(*u8, 0);
}

fn x11_xid(w as *device.Window) as i64 {
    if (w.backend == device.X11) {
        return x11.xid(&w.x11_win);
    }
    return 0;
}

fn x11_screen(w as *device.Window) as i32 {
    if (w.backend == device.X11) {
        return x11.screen(&w.x11_win);
    }
    return 0;
}

fn x11_visual(w as *device.Window) as *u8 {
    if (w.backend == device.X11) {
        return x11.visual(&w.x11_win);
    }
    return cast(*u8, 0);
}

fn wayland_display(w as *device.Window) as *u8 {
    return cast(*u8, 0);
}

fn wayland_surface(w as *device.Window) as *u8 {
    return cast(*u8, 0);
}

fn win32_hwnd(w as *device.Window) as *u8 {
    return cast(*u8, 0);
}
