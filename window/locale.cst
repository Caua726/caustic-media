// window/locale.cst — the language the user reads, for the toolkit's own
// words and the direction its windows are laid out in.
//
// POSIX says it in the environment, in order of trust: LC_ALL, then
// LC_MESSAGES, then LANG, each a name like pt_BR.UTF-8@euro; and GNU's
// LANGUAGE, a list of them by preference, over all three — except in the C
// locale, where a program speaks no language but its own. What is read is
// turned into a BCP 47 tag, the form Windows and the web use: pt_BR is
// pt-BR. Its encoding and modifier are left out.
//
//   Linux     the environment, as above
//   Windows   GetUserDefaultLocaleName, with the Win32 backend
//
// No libc: x11/locale.cst sets C's locale for an input method, which is
// another matter.
use "std/env.cst" as env;
use "settings.cst" as settings;

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn _letter(c as u8) as i32 { return cast(i32, (c >= 65 && c <= 90) || (c >= 97 && c <= 122)); }

fn _digit(c as u8) as i32 { return cast(i32, c >= 48 && c <= 57); }

fn _lower(c as u8) as u8 {
    if (c >= 65 && c <= 90) { return cast(u8, c + 32); }
    return c;
}

fn _upper(c as u8) as u8 {
    if (c >= 97 && c <= 122) { return cast(u8, c - 32); }
    return c;
}

// The POSIX name of n bytes at s — language[_territory][.encoding][@modifier]
// — as a tag into out, cap bytes with the NUL: its length, or 0 for none: C,
// POSIX, what is no such name, or no room.
fn from_posix(s as *u8, n as i64, out as *u8, cap as i64) as i64 {
    if (cast(i64, s) == 0) { return 0; }
    // The name, up to its encoding or modifier.
    let is i64 as end with mut = 0;
    while (end < n && s[end] != 46 && s[end] != 64) { end = end + 1; }
    let is i64 as lang with mut = 0;
    while (lang < end && _letter(s[lang]) == 1) { lang = lang + 1; }
    if (lang < 2 || lang > 3) { return 0; }
    let is i64 as terr with mut = 0;
    if (lang < end) {
        if (s[lang] != 95) { return 0; }
        terr = end - lang - 1;
        let is i32 as letters with mut = 1;
        let is i32 as digits with mut = 1;
        let is i64 as i with mut = lang + 1;
        while (i < end) {
            if (_letter(s[i]) == 0) { letters = 0; }
            if (_digit(s[i]) == 0) { digits = 0; }
            i = i + 1;
        }
        if ((terr != 2 || letters == 0) && (terr != 3 || digits == 0)) { return 0; }
    }
    let is i64 as total with mut = lang;
    if (terr > 0) { total = lang + 1 + terr; }
    if (total + 1 > cap) { return 0; }
    let is i64 as k with mut = 0;
    while (k < lang) {
        out[k] = _lower(s[k]);
        k = k + 1;
    }
    if (terr > 0) {
        out[lang] = 45;
        let is i64 as j with mut = 0;
        while (j < terr) {
            out[lang + 1 + j] = _upper(s[lang + 1 + j]);
            j = j + 1;
        }
    }
    out[total] = 0;
    return total;
}

fn _set(s as *u8) as i32 { return cast(i32, cast(i64, s) != 0 && s[0] != 0); }

// The language of the messages, from the environment's variables — each null
// when unset — as a tag into out: its length, or 0 for none.
fn messages(language as *u8, all as *u8, messages_var as *u8, lang as *u8, out as *u8, cap as i64) as i64 {
    let is *u8 as base with mut = lang;
    if (_set(messages_var) == 1) { base = messages_var; }
    if (_set(all) == 1) { base = all; }
    if (_set(base) == 0) { return 0; }
    let is i64 as n = from_posix(base, _len(base), out, cap);
    // C's locale: no language, whatever LANGUAGE says.
    if (n == 0) { return 0; }
    if (_set(language) == 0) { return n; }
    let is i64 as ln = _len(language);
    let is i64 as a with mut = 0;
    while (a < ln) {
        let is i64 as b with mut = a;
        while (b < ln && language[b] != 58) { b = b + 1; }
        let is i64 as got = from_posix(cast(*u8, cast(i64, language) + a), b - a, out, cap);
        if (got > 0) { return got; }
        a = b + 1;
    }
    return from_posix(base, _len(base), out, cap);
}

// Whether the language of a tag, n bytes, is written right to left.
fn right_to_left(tag as *u8, n as i64) as i32 {
    let is i64 as k with mut = 0;
    while (k < n && tag[k] != 45) { k = k + 1; }
    if (k == 2) {
        let is u8 as a = _lower(tag[0]);
        let is u8 as b = _lower(tag[1]);
        // ar he iw fa ur ps sd ug yi dv
        if ((a == 97 && b == 114) || (a == 104 && b == 101) || (a == 105 && b == 119) || (a == 102 && b == 97) ||
            (a == 117 && b == 114) || (a == 112 && b == 115) || (a == 115 && b == 100) || (a == 117 && b == 103) ||
            (a == 121 && b == 105) || (a == 100 && b == 118)) { return 1; }
        return 0;
    }
    if (k == 3) {
        // ckb, Central Kurdish; syr, Syriac.
        let is u8 as a = _lower(tag[0]);
        let is u8 as b = _lower(tag[1]);
        let is u8 as c = _lower(tag[2]);
        if ((a == 99 && b == 107 && c == 98) || (a == 115 && b == 121 && c == 114)) { return 1; }
    }
    return 0;
}

// The language read from these variables into s, known when there is one.
fn fill(s as *settings.Settings, language as *u8, all as *u8, messages_var as *u8, lang as *u8) as void {
    let is i64 as n = messages(language, all, messages_var, lang, cast(*u8, &s.locale), 32);
    if (n > 0) { s.known = s.known | settings.K_LOCALE; }
}

// The user's language into s, as the platform says it.
fn read(s as *settings.Settings) as void {
    if (__target_is_windows == 1) { return; }
    fill(s, env.getenv("LANGUAGE"), env.getenv("LC_ALL"), env.getenv("LC_MESSAGES"), env.getenv("LANG"));
}
