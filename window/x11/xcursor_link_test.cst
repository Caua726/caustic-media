// window/x11/xcursor_link_test.cst — every libXcursor.so.1 symbol resolves, or this never runs.
//
// 61 declarations transcribed by hand. The dominant failure mode is not a
// wrong type, it is a wrong NAME: one transposed letter produces a declaration
// that compiles, links against nothing, and fails the first time some program
// far from here calls it.
//
// This catches all of them at once, before main, on every CI run:
//
//   The compiler emits a library import at the CALL SITE, not at the
//   declaration, so a declaration nobody calls is invisible to the linker.
//   Every function therefore has to be called somewhere for this to mean
//   anything — ../tools/check_symbols.sh asserts that none was forgotten.
//
//   The calls sit behind `if (sink != 7777)`, and sink comes from argc. That is
//   not a constant, so the branch survives dead-code elimination and the call
//   sites are emitted — but the condition is never true, so libXcursor.so.1 is never
//   actually entered. Nothing here opens a display or touches the X server.
//
//   caustic-ld turns those imports into DT_NEEDED plus one PLT relocation each,
//   and sets DT_FLAGS = DF_BIND_NOW, so the loader resolves every name at exec.
//   A single misspelling and this process dies before main, which is the loud
//   failure a silent one deserves.
//
// So the assertion is the exit code itself: reaching main at all is the result.
//
// --- Why one binary per shared object ---
//
// Not tidiness. Measured against this toolchain: when a single binary imports
// more than roughly 256 distinct extern symbols, caustic-ld emits the PLT
// relocations for every soname but the DT_NEEDED entry for only the FIRST one.
// The binary then dies at exec with `undefined symbol`, naming a function whose
// library was never recorded.
//
// Bisected: 240 imports across two sonames links and runs; 280 does not. A
// binary with 770 imports and a SINGLE soname is fine, so the count alone is
// not the trigger — it is the count crossing that line with a second library
// present. The 1024-entry cstimport table is not it either; that one fails
// loudly and this is silent.
//
// Splitting by soname keeps each binary under the line and, when one does fail,
// says which library it was.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "bind/xcursor.cst" as xcursor;

// From argc, so the compiler cannot fold the guard away. Written once and never
// 7777, so no call below ever executes.
let is i64 as sink with mut = 0;

fn _touch_0() as void {
    if (sink != 7777) { return; }
    xcursor.XcursorAnimateCreate(cast(*u8, 0));
    xcursor.XcursorAnimateDestroy(cast(*u8, 0));
    xcursor.XcursorAnimateNext(cast(*u8, 0));
    xcursor.XcursorCommentCreate(cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorCommentDestroy(cast(*u8, 0));
    xcursor.XcursorCommentsCreate(cast(i32, 0));
    xcursor.XcursorCommentsDestroy(cast(*u8, 0));
    xcursor.XcursorCursorsCreate(cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorCursorsDestroy(cast(*u8, 0));
    xcursor.XcursorFileLoad(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorFileLoadAllImages(cast(*u8, 0));
    xcursor.XcursorFileLoadImage(cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorFileLoadImages(cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorFileSave(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorFileSaveImages(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorFilenameLoad(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorFilenameLoadAllImages(cast(*u8, 0));
    xcursor.XcursorFilenameLoadCursor(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorFilenameLoadCursors(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorFilenameLoadImage(cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorFilenameLoadImages(cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorFilenameSave(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorFilenameSaveImages(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorGetDefaultSize(cast(*u8, 0));
    xcursor.XcursorGetResizable(cast(*u8, 0));
    xcursor.XcursorGetTheme(cast(*u8, 0));
    xcursor.XcursorGetThemeCore(cast(*u8, 0));
    xcursor.XcursorImageCreate(cast(i32, 0), cast(i32, 0));
    xcursor.XcursorImageDestroy(cast(*u8, 0));
    xcursor.XcursorImageHash(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorImageLoadCursor(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorImagesCreate(cast(i32, 0));
    xcursor.XcursorImagesDestroy(cast(*u8, 0));
    xcursor.XcursorImagesLoadCursor(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorImagesLoadCursors(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorImagesSetName(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorLibraryLoadCursor(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorLibraryLoadCursors(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorLibraryLoadImage(cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorLibraryLoadImages(cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
}

fn _touch_1() as void {
    if (sink != 7777) { return; }
    xcursor.XcursorLibraryPath();
    xcursor.XcursorLibraryShape(cast(*u8, 0));
    xcursor.XcursorNoticeCreateBitmap(cast(*u8, 0), 0, cast(u32, 0), cast(u32, 0));
    xcursor.XcursorNoticePutBitmap(cast(*u8, 0), 0, cast(*u8, 0));
    xcursor.XcursorSetDefaultSize(cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorSetResizable(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorSetTheme(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorSetThemeCore(cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorShapeLoadCursor(cast(*u8, 0), cast(u32, 0));
    xcursor.XcursorShapeLoadCursors(cast(*u8, 0), cast(u32, 0));
    xcursor.XcursorShapeLoadImage(cast(u32, 0), cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorShapeLoadImages(cast(u32, 0), cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorSupportsARGB(cast(*u8, 0));
    xcursor.XcursorSupportsAnim(cast(*u8, 0));
    xcursor.XcursorTryShapeBitmapCursor(cast(*u8, 0), 0, 0, cast(*u8, 0), cast(*u8, 0),
                                        cast(u32, 0), cast(u32, 0));
    xcursor.XcursorTryShapeCursor(cast(*u8, 0), 0, 0, cast(u32, 0), cast(u32, 0), cast(*u8, 0),
                                  cast(*u8, 0));
    xcursor.XcursorXcFileLoad(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xcursor.XcursorXcFileLoadAllImages(cast(*u8, 0));
    xcursor.XcursorXcFileLoadImage(cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorXcFileLoadImages(cast(*u8, 0), cast(i32, 0));
    xcursor.XcursorXcFileSave(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
}
fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    sink = argc;

    // Never true. The point is that the compiler cannot know that.
    if (sink == 7777) {
        _touch_0();
        _touch_1();
    }

    io.printf("libXcursor.so.1: 61 symbols resolved at exec\n");
    return 0;
}
