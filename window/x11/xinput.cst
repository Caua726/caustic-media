// window/x11/xinput.cst — smooth scrolling turned on for a window: what of
// XInput 2.1 asks the server (libXi). window.cst reads the reports
// (smooth.cst) and never calls libXi itself, so a program links it only by
// importing this, as the toolkit does (ui/host.cst).
//
// The window takes XI_Motion instead of MotionNotify — the server sends one
// or the other to a window — and the root XI_DeviceChanged, the device behind
// the master pointer switching. A device is learned the first time it moves:
// its scroll classes, its valuators' values as the baselines, and whether it
// is a touchpad (libinput's or synaptics' own properties say so), whose
// fingers scroll continuously rather than in notches.
use "bind/xlib.cst" as xlib;
use "bind/xinput2.cst" as xi2;
use "window.cst" as window;
use "smooth.cst" as smooth;

let is [4]u8 as _window_mask with mut;
let is [4]u8 as _root_mask with mut;
let is i32 as _asked with mut = 0;      // the version asked: once a connection
let is i32 as _minor with mut = 0;

// Smooth scrolling for w: 1 when the server speaks XI 2.1 and w takes it, 0
// when it does not — then buttons 4–7 scroll in notches as before.
fn smooth_scrolling(w as *window.Window) as i32 {
    let is *u8 as d = window.display(w);
    if (cast(i64, d) == 0) { return 0; }
    let is i32 as op with mut = 0;
    let is i32 as ev with mut = 0;
    let is i32 as er with mut = 0;
    if (xlib.XQueryExtension(d, "XInputExtension", &op, &ev, &er) == 0) { return 0; }
    if (_asked == 0) {
        // 2.2, as cursor.cst asks: a lower version after a higher is refused.
        let is i32 as major with mut = 2;
        let is i32 as minor with mut = 2;
        if (xi2.XIQueryVersion(d, cast(*u8, &major), cast(*u8, &minor)) != 0 || major < 2) { return 0; }
        _asked = 1;
        _minor = minor;
        // The root: which device is behind the master pointer.
        let is xi2.XIEventMask as rm;
        _root_mask[0] = cast(u8, 1 << xi2.XI_DeviceChanged);
        rm.deviceid = xi2.XIAllMasterDevices;
        rm.mask_len = 4;
        rm.mask = &_root_mask[0];
        xi2.XISelectEvents(d, xlib.XDefaultRootWindow(d), cast(*u8, &rm), 1);
    }
    if (_minor < 1) { return 0; }
    let is xi2.XIEventMask as m;
    _window_mask[0] = cast(u8, 1 << xi2.XI_Motion);
    m.deviceid = xi2.XIAllMasterDevices;
    m.mask_len = 4;
    m.mask = &_window_mask[0];
    if (xi2.XISelectEvents(d, window.xid(w), cast(*u8, &m), 1) != 0) { return 0; }
    xlib.XFlush(d);
    window.smooth_enable(op, fn_ptr(_learn));
    return 1;
}

// Device id learned: XIQueryDevice's classes, a touchpad by its properties.
fn _learn(d as *u8, id as i32) as void {
    let is i32 as n with mut = 0;
    let is *xi2.XIDeviceInfo as info = cast(*xi2.XIDeviceInfo, xi2.XIQueryDevice(d, id, cast(*u8, &n)));
    if (cast(i64, info) == 0 || n < 1) {
        smooth.learn(window.smooth_state(), id, cast(**u8, 0), 0, 0);
        return;
    }
    smooth.learn(window.smooth_state(), id, info.classes, info.num_classes, _touchpad(d, id));
    xi2.XIFreeDeviceInfo(cast(*u8, info));
}

fn _touchpad(d as *u8, id as i32) as i32 {
    let is i64 as tapping = xlib.XInternAtom(d, "libinput Tapping Enabled", 1);
    let is i64 as synaptics = xlib.XInternAtom(d, "Synaptics Off", 1);
    if (tapping == 0 && synaptics == 0) { return 0; }
    let is i32 as n with mut = 0;
    let is *i64 as props = cast(*i64, xi2.XIListProperties(d, id, cast(*u8, &n)));
    if (cast(i64, props) == 0) { return 0; }
    let is i32 as found with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) {
        if ((tapping != 0 && props[i] == tapping) || (synaptics != 0 && props[i] == synaptics)) { found = 1; }
        i = i + 1;
    }
    xlib.XFree(cast(*u8, props));
    return found;
}
