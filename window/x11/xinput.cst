// window/x11/xinput.cst — XInput 2 turned on for a window: what of it asks
// the server (libXi). window.cst reads the reports (xidev.cst) and never
// calls libXi itself, so a program links it only by importing this, as the
// toolkit does (ui/host.cst).
//
// The window takes XI_Motion and XI_ButtonPress/Release instead of the core
// pointer events — the server sends one or the other to a window, the core
// ones still while a core grab (a popup's) holds the pointer — a touchscreen's
// touches (XI 2.2) and a touchpad's pinches and swipes (XI 2.4) where the
// server has them, and the root XI_DeviceChanged, the device behind the
// master pointer switching. A device is learned the first time it moves: its
// scroll classes and valuators' values (the baselines), whether it is a
// touchpad (libinput's or synaptics' own properties say so), whose fingers
// scroll continuously rather than in notches, and whether it is a pen (a
// valuator labelled "Abs Pressure").
use "bind/xlib.cst" as xlib;
use "bind/xinput2.cst" as xi2;
use "window.cst" as window;
use "xidev.cst" as xidev;

let is [8]u8 as _window_mask with mut;
let is [8]u8 as _root_mask with mut;
let is i32 as _asked with mut = 0;      // the version asked: once a connection
let is i32 as _minor with mut = 0;

fn _bit(mask as *u8, ev as i32) as void { mask[ev >> 3] = cast(u8, cast(i64, mask[ev >> 3]) | (1 << (ev & 7))); }

// XI2 for w: 1 when the server speaks XI 2.1 or later and w takes it — smooth
// scrolling, pens, and touches (2.2) and gestures (2.4) where spoken — 0
// when it does not, and the core pointer events go on as before.
fn enable(w as *window.Window) as i32 {
    let is *u8 as d = window.display(w);
    if (cast(i64, d) == 0) { return 0; }
    let is i32 as op with mut = 0;
    let is i32 as ev with mut = 0;
    let is i32 as er with mut = 0;
    if (xlib.XQueryExtension(d, "XInputExtension", &op, &ev, &er) == 0) { return 0; }
    if (_asked == 0) {
        // 2.4, as cursor.cst asks: a lower version after a higher is refused.
        let is i32 as major with mut = 2;
        let is i32 as minor with mut = 4;
        if (xi2.XIQueryVersion(d, cast(*u8, &major), cast(*u8, &minor)) != 0 || major < 2) { return 0; }
        _asked = 1;
        _minor = minor;
        // The root: which device is behind the master pointer.
        let is xi2.XIEventMask as rm;
        _bit(&_root_mask[0], xi2.XI_DeviceChanged);
        rm.deviceid = xi2.XIAllMasterDevices;
        rm.mask_len = 8;
        rm.mask = &_root_mask[0];
        xi2.XISelectEvents(d, xlib.XDefaultRootWindow(d), cast(*u8, &rm), 1);
        xidev.set_labels(window.xi_state(), xlib.XInternAtom(d, "Abs Pressure", 0),
                         xlib.XInternAtom(d, "Abs Tilt X", 0), xlib.XInternAtom(d, "Abs Tilt Y", 0));
    }
    if (_minor < 1) { return 0; }
    let is i64 as i with mut = 0;
    while (i < 8) { _window_mask[i] = cast(u8, 0); i = i + 1; }
    _bit(&_window_mask[0], xi2.XI_Motion);
    _bit(&_window_mask[0], xi2.XI_ButtonPress);
    _bit(&_window_mask[0], xi2.XI_ButtonRelease);
    if (_minor >= 2) {
        _bit(&_window_mask[0], xi2.XI_TouchBegin);
        _bit(&_window_mask[0], xi2.XI_TouchUpdate);
        _bit(&_window_mask[0], xi2.XI_TouchEnd);
    }
    if (_minor >= 4) {
        let is i32 as g with mut = xi2.XI_GesturePinchBegin;
        while (g <= xi2.XI_GestureSwipeEnd) {
            _bit(&_window_mask[0], g);
            g = g + 1;
        }
    }
    let is xi2.XIEventMask as m;
    m.deviceid = xi2.XIAllMasterDevices;
    m.mask_len = 8;
    m.mask = &_window_mask[0];
    if (xi2.XISelectEvents(d, window.xid(w), cast(*u8, &m), 1) != 0) { return 0; }
    xlib.XFlush(d);
    window.xi_enable(op, fn_ptr(_learn));
    return 1;
}

// The version the server agreed to, 0 before enable asked: 1 smooth
// scrolling, 2 touches too, 4 gestures too.
fn minor() as i32 { return _minor; }

// Device id learned: XIQueryDevice's classes, a touchpad by its properties.
fn _learn(d as *u8, id as i32) as void {
    let is i32 as n with mut = 0;
    let is *xi2.XIDeviceInfo as info = cast(*xi2.XIDeviceInfo, xi2.XIQueryDevice(d, id, cast(*u8, &n)));
    if (cast(i64, info) == 0 || n < 1) {
        xidev.learn(window.xi_state(), id, cast(**u8, 0), 0, 0);
        return;
    }
    xidev.learn(window.xi_state(), id, info.classes, info.num_classes, _touchpad(d, id));
    xi2.XIFreeDeviceInfo(cast(*u8, info));
}

fn _touchpad(d as *u8, id as i32) as i32 {
    let is i64 as tapping = xlib.XInternAtom(d, "libinput Tapping Enabled", 1);
    let is i64 as synaptics = xlib.XInternAtom(d, "Synaptics Off", 1);
    if (tapping == 0 && synaptics == 0) { return 0; }
    let is i32 as n with mut = 0;
    let is *i64 as props = cast(*i64, xi2.XIListProperties(d, id, cast(*u8, &n)));
    if (cast(i64, props) == 0) { return 0; }
    let is i32 as found with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) {
        if ((tapping != 0 && props[i] == tapping) || (synaptics != 0 && props[i] == synaptics)) { found = 1; }
        i = i + 1;
    }
    xlib.XFree(cast(*u8, props));
    return found;
}
