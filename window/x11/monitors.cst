// window/x11/monitors.cst — where the screens are, and how big a pixel is.
//
// The core protocol's Screen is the whole desktop, however many physical
// displays that spans. It has a width and a height and nothing else: no way to
// ask where the second monitor starts, what refresh rate either runs at, or
// which one a new window should open on. Every one of those answers comes from
// Xrandr.
//
// The name is `monitors` and not `display` on purpose. `x11.display(&w)` is the
// native-handle accessor that both ../window.md and ../x11/x11.md name — the
// Display* that VK_KHR_xlib_surface is built from — and a module alias cannot
// share a name with a hub function. The portable tree in window.md calls this
// file display.cst; here it cannot be.
//
// --- Nothing here allocates ---
//
// libXrandr allocates every structure it returns and each has its own XRRFree*
// call. This module borrows them inside a single function and frees them before
// returning, copying out only the small flat records below. That is why a
// caller gets a Monitor by value and never a pointer into the server's reply:
// the reply is gone by the time the call returns.
//
// --- DPI ---
//
// scale() is the number a program multiplies its layout by, and there are three
// possible sources that disagree:
//
//   Xft.dpi from the resource database. What the desktop environment set, what
//   the user actually chose, and what every toolkit honours. It is the answer
//   when it exists.
//   Physical size from Xrandr. Correct in principle, wrong in practice: a
//   projector reports the size of its case, a TV reports 16x9 inches, and a
//   laptop panel is often simply blank.
//   96, the historical default.
//
// So Xft.dpi first, physical size second, 96 last, and dpi_source() says which
// one answered — because a program showing a scaling setting should be able to
// tell the user where the number came from.
use "std/math.cst" as fm;
use "bind/xlib.cst" as xlib;
use "bind/xrandr.cst" as rr;

let is i64 as MAX_MONITORS with imut = 16;

// Flat, copied out, no pointer into anything the server owns.
struct Monitor {
    x       as i64;
    y       as i64;
    width   as i64;
    height  as i64;
    mm_width  as i64;    // 0 when the display did not say
    mm_height as i64;
    refresh_mhz as i64;  // millihertz: 59940 is 59.94 Hz. 0 when unknown.
    primary as i32;
    _pad0   as i32;
    name    as [32]u8;   // "HDMI-1", NUL-terminated, truncated if longer
}

struct State {
    ready   as i32;      // Xrandr present and answered
    count   as i32;
    dpi     as i64;      // whole DPI, not scaled
    source  as i32;      // where dpi came from
    _pad0   as i32;
    mon     as [16]Monitor;
}

let is i32 as DPI_XFT      with imut = 0;
let is i32 as DPI_PHYSICAL with imut = 1;
let is i32 as DPI_DEFAULT  with imut = 2;

fn dpi_source_name(s as i32) as *u8 {
    if (s == DPI_XFT)      { return "Xft.dpi"; }
    if (s == DPI_PHYSICAL) { return "physical size"; }
    return "default 96";
}

fn _mon(st as *State, i as i64) as *Monitor {
    return cast(*Monitor, cast(i64, &st.mon) + i * sizeof(Monitor));
}

fn _copy_name(m as *Monitor, src as *u8, len as i64) as void {
    let is i64 as n with mut = len;
    if (n > 31) { n = 31; }
    if (n < 0) { n = 0; }
    let is i64 as i with mut = 0;
    while (i < n) { m.name[i] = src[i]; i = i + 1; }
    m.name[n] = cast(u8, 0);
}

// --- Enumeration ---

// Refresh is derived, not reported: dotClock / (hTotal * vTotal). Returned in
// millihertz because 59.94 Hz is a real and common rate that rounds to 60 and
// then stops being 59.94.
fn _refresh_mhz(mode as *rr.XRRModeInfo) as i64 {
    let is i64 as tot = cast(i64, mode.hTotal) * cast(i64, mode.vTotal);
    if (tot == 0) { return 0; }
    return (mode.dotClock * 1000) / tot;
}

fn _find_mode(res as *rr.XRRScreenResources, id as i64) as *rr.XRRModeInfo {
    let is i64 as i with mut = 0;
    while (i < cast(i64, res.nmode)) {
        let is *rr.XRRModeInfo as m =
            cast(*rr.XRRModeInfo, cast(i64, res.modes) + i * sizeof(rr.XRRModeInfo));
        if (m.id == id) { return m; }
        i = i + 1;
    }
    return cast(*rr.XRRModeInfo, 0);
}

// Fills the state from the server. Returns 0 when Xrandr is not there, which is
// not an error — it means one screen, and the caller falls back to the core
// protocol's idea of it.
fn refresh(st as *State, d as *u8, root as i64) as i32 {
    st.ready = 0;
    st.count = 0;

    let is i32 as ev with mut = 0;
    let is i32 as er with mut = 0;
    if (rr.XRRQueryExtension(d, &ev, &er) == 0) { return 0; }

    // Current, not the plain form: the non-Current call makes the server
    // re-probe every output's EDID, which takes milliseconds and is not what a
    // program asking "where are the monitors" wants.
    let is *u8 as raw = rr.XRRGetScreenResourcesCurrent(d, root);
    if (cast(i64, raw) == 0) { return 0; }
    let is *rr.XRRScreenResources as res = cast(*rr.XRRScreenResources, raw);

    let is i64 as primary_id = rr.XRRGetOutputPrimary(d, root);

    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    while (i < cast(i64, res.noutput) && n < MAX_MONITORS) {
        let is i64 as oid = *cast(*i64, cast(i64, res.outputs) + i * 8);
        let is *u8 as oraw = rr.XRRGetOutputInfo(d, raw, oid);
        if (cast(i64, oraw) != 0) {
            let is *rr.XRROutputInfo as oi = cast(*rr.XRROutputInfo, oraw);
            // An output with no CRTC is plugged in but not displaying
            // anything, which is not a monitor a program should lay out on.
            if (oi.connection == rr.RR_Connected && oi.crtc != 0) {
                let is *u8 as craw = rr.XRRGetCrtcInfo(d, raw, oi.crtc);
                if (cast(i64, craw) != 0) {
                    let is *rr.XRRCrtcInfo as ci = cast(*rr.XRRCrtcInfo, craw);
                    let is *Monitor as m = _mon(st, n);
                    m.x = cast(i64, ci.x);
                    m.y = cast(i64, ci.y);
                    m.width = cast(i64, ci.width);
                    m.height = cast(i64, ci.height);
                    m.mm_width = oi.mm_width;
                    m.mm_height = oi.mm_height;
                    m.refresh_mhz = 0;
                    let is *rr.XRRModeInfo as mo = _find_mode(res, ci.mode);
                    if (cast(i64, mo) != 0) { m.refresh_mhz = _refresh_mhz(mo); }
                    m.primary = 0;
                    if (oid == primary_id) { m.primary = 1; }
                    _copy_name(m, oi.name, cast(i64, oi.nameLen));
                    n = n + 1;
                    rr.XRRFreeCrtcInfo(craw);
                }
            }
            rr.XRRFreeOutputInfo(oraw);
        }
        i = i + 1;
    }
    rr.XRRFreeScreenResources(raw);

    st.count = cast(i32, n);
    st.ready = 1;
    // With exactly one output and no primary flag set, it is the primary.
    if (n == 1) { _mon(st, 0).primary = 1; }
    return 1;
}

fn count(st as *State) as i64 { return cast(i64, st.count); }

fn get(st as *State, i as i64, out as *Monitor) as i32 {
    if (i < 0 || i >= cast(i64, st.count)) { return 0; }
    *out = *_mon(st, i);
    return 1;
}

fn primary(st as *State, out as *Monitor) as i32 {
    let is i64 as i with mut = 0;
    while (i < cast(i64, st.count)) {
        if (_mon(st, i).primary == 1) { *out = *_mon(st, i); return 1; }
        i = i + 1;
    }
    return get(st, 0, out);
}

// Which monitor a rectangle is mostly on, which is the question a window that
// wants to go fullscreen is actually asking. Overlap area, not centre point: a
// window straddling two screens belongs to the one showing more of it.
fn for_rect(st as *State, x as i64, y as i64, w as i64, h as i64, out as *Monitor) as i32 {
    let is i64 as best with mut = 0 - 1;
    let is i64 as best_area with mut = 0;
    let is i64 as i with mut = 0;
    while (i < cast(i64, st.count)) {
        let is *Monitor as m = _mon(st, i);
        let is i64 as ox with mut = x;
        if (m.x > ox) { ox = m.x; }
        let is i64 as oy with mut = y;
        if (m.y > oy) { oy = m.y; }
        let is i64 as ex with mut = x + w;
        if (m.x + m.width < ex) { ex = m.x + m.width; }
        let is i64 as ey with mut = y + h;
        if (m.y + m.height < ey) { ey = m.y + m.height; }
        if (ex > ox && ey > oy) {
            let is i64 as area = (ex - ox) * (ey - oy);
            if (area > best_area) { best_area = area; best = i; }
        }
        i = i + 1;
    }
    if (best < 0) { return primary(st, out); }
    return get(st, best, out);
}

// --- DPI ---

// Parses "Xft.dpi:\t96" out of the resource manager string. Hand-rolled rather
// than through XrmGetStringDatabase because the database allocates, and this
// wants one integer out of a string the server already sent.
fn _xft_dpi(d as *u8) as i64 {
    let is *u8 as s = xlib.XResourceManagerString(d);
    if (cast(i64, s) == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (s[i] != cast(u8, 0)) {
        // Match "Xft.dpi" at the start of a line.
        if ((i == 0 || s[i - 1] == cast(u8, 10))
            && s[i]     == cast(u8, 88)     // X
            && s[i + 1] == cast(u8, 102)    // f
            && s[i + 2] == cast(u8, 116)    // t
            && s[i + 3] == cast(u8, 46)     // .
            && s[i + 4] == cast(u8, 100)    // d
            && s[i + 5] == cast(u8, 112)    // p
            && s[i + 6] == cast(u8, 105)) { // i
            let is i64 as j with mut = i + 7;
            // Skip the separator: colon, tabs, spaces.
            while (s[j] == cast(u8, 58) || s[j] == cast(u8, 9) || s[j] == cast(u8, 32)) {
                j = j + 1;
            }
            let is i64 as v with mut = 0;
            let is i32 as any with mut = 0;
            while (s[j] >= cast(u8, 48) && s[j] <= cast(u8, 57)) {
                v = v * 10 + cast(i64, s[j]) - 48;
                any = 1;
                j = j + 1;
            }
            if (any == 1 && v > 0) { return v; }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// Physical DPI of the primary monitor. Returns 0 when the display did not
// report a size, which is common enough that it is a normal answer.
fn _physical_dpi(st as *State) as i64 {
    let is Monitor as m;
    if (primary(st, &m) == 0) { return 0; }
    if (m.mm_width <= 0 || m.width <= 0) { return 0; }
    // 25.4 mm to the inch, in integers: width * 254 / (mm * 10).
    let is i64 as dpi = (m.width * 254) / (m.mm_width * 10);
    // A projector reporting the size of its case gives absurd numbers in both
    // directions. Outside this range the answer is not measurement, it is noise.
    if (dpi < 30 || dpi > 600) { return 0; }
    return dpi;
}

fn compute_dpi(st as *State, d as *u8) as void {
    let is i64 as v with mut = _xft_dpi(d);
    if (v > 0) { st.dpi = v; st.source = DPI_XFT; return; }
    v = _physical_dpi(st);
    if (v > 0) { st.dpi = v; st.source = DPI_PHYSICAL; return; }
    st.dpi = 96;
    st.source = DPI_DEFAULT;
}

fn dpi(st as *State) as i64 { return st.dpi; }
fn dpi_source(st as *State) as i32 { return st.source; }

// What a program multiplies its layout by. 96 DPI is 1.0 by definition.
fn scale(st as *State) as f64 {
    if (st.dpi <= 0) { return 1.0; }
    return cast(f64, st.dpi) / 96.0;
}
