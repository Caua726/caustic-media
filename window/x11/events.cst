// window/x11/events.cst — what happens to a window on X11, two ways.
//
// A frame loop wants to ask "was the window closed, how large is it now" — a
// question about state, answered the same way however many times it is
// asked, and answerable even by a program that never drains a queue. A
// program reacting to the window wants "what happened, in order". Neither
// answers the other, so the pump produces both from one drain.
//
//   State   folded from every event as it arrives, before anything else
//           happens to it. Cannot fail, cannot overflow, cannot be missed.
//   Event   a decoded projection of one raw XEvent, handed out on request.
//
// The order is the load-bearing part. fold() runs before the event reaches the
// ring, so a program that never calls poll_event still gets should_close and
// the window size — and a ring that overflows under load never loses the fact
// that the window was closed.
//
// What a person does with the keyboard and the pointer is not here: the pump
// translates it into input/event.cst's cooked events as it arrives (window.cst,
// poll_input), and input/state.cst samples it for a program that feeds it.
//
// --- Why Event is a projection and not the storage ---
//
// ../../window.md says window/ owns the raw event queue. The queue in
// window.cst therefore holds raw 192-byte XEvents, not this struct: the moment
// window/ decides which fields matter, everything after inherits that
// decision, and an XI2 valuator has nowhere to live. Event is the convenient
// view for programs that want one, produced on demand and costing nothing to
// the programs that do not.
use "bind/x.cst" as x;
use "bind/xevent.cst" as xev;

// --- The decoded view ---

let is i32 as NONE       with imut = 0;
let is i32 as FOCUS_IN   with imut = 9;
let is i32 as FOCUS_OUT  with imut = 10;
let is i32 as RESIZE     with imut = 11;
let is i32 as EXPOSE     with imut = 12;
let is i32 as CLOSE      with imut = 13;
// Everything this file does not name. The raw XEvent is still in the ring, so a
// program that cares reads it with poll_xevent instead.
let is i32 as OTHER      with imut = 14;
// The desktop's settings changed (XSETTINGS): read them again.
let is i32 as SETTINGS   with imut = 15;
// The window manager changed the window's state — maximized, full screen,
// tiled — and state says what it is now (frame.cst's STATE_* bits).
let is i32 as STATE      with imut = 16;
// Something dragged over the window from another program (dnd.cst): it came
// in, with what it offers in drop (dnd.FILES, dnd.TEXT bits); it moved, to x,
// y; it left, or was dropped somewhere it was not taken; it was dropped at x,
// y and what drop says arrived (dropped_files, dropped_text).
let is i32 as DND_ENTER  with imut = 17;
let is i32 as DND_MOVE   with imut = 18;
let is i32 as DND_LEAVE  with imut = 19;
let is i32 as DND_DROP   with imut = 20;

// How a settings change travels through a window's ring of raw events: a type
// of its own, above the core protocol's (GenericEvent is 35, the last) and below
// 64, where the server starts handing types out to extensions.
let is i32 as XSETTINGS_CHANGED with imut = 62;
// And a drag's: a client message's layout, data[0] the DND_* kind, then x, y
// and the drop bits.
let is i32 as DND_NOTE with imut = 63;
// A popup the window system took down — a press outside the program's popups
// while one held the pointer: the program is to close it (POPUP_DONE).
let is i32 as POPUP_NOTE with imut = 61;
let is i32 as POPUP_DONE with imut = 24;
// A compositing manager started or stopped on the screen (frame.cst's
// _NET_WM_CM_S<screen>, followed through XFixes): whether what a window
// leaves transparent shows what is behind it is to be asked again
// (COMPOSITOR).
let is i32 as COMPOSITOR_NOTE with imut = 60;
let is i32 as COMPOSITOR with imut = 25;

struct Event {
    kind      as i32;
    xkind     as i32;   // the raw X event type, always filled
    x         as i64;   // DND_*: the pointer; RESIZE, EXPOSE: the corner
    y         as i64;
    width     as i64;   // RESIZE, EXPOSE
    height    as i64;
    state     as i32;   // STATE: the window's, frame.cst's STATE_* bits
    drop      as i32;   // DND_ENTER: what is offered; DND_DROP: what arrived (dnd.cst's bits)
}

fn clear(e as *Event) as void {
    e.kind = NONE; e.xkind = 0; e.x = 0; e.y = 0;
    e.width = 0; e.height = 0; e.state = 0; e.drop = 0;
}

// --- The sampled state ---
struct State {
    width      as i64;
    height     as i64;
    focused    as i32;
    visible    as i32;
    resized    as i32;      // true for exactly one frame
    exposed    as i32;
    should_close as i32;
    // Counts XI_RawMotion events seen this frame. The deltas themselves are
    // valuators that input/ will decode; window/ only reports that raw motion
    // is arriving, which is what tells a program its relative mode is real.
    raw_motion as i32;
}

fn state_init(s as *State, w as i64, h as i64) as void {
    s.width = w; s.height = h;
    s.focused = 0; s.visible = 0; s.resized = 0; s.exposed = 0;
    s.should_close = 0;
    s.raw_motion = 0;
}

// Per-frame values are edges, not levels: a resize flag that never cleared
// would make every frame look like a resize. next_frame() calls this before
// draining.
fn state_new_frame(s as *State) as void {
    s.resized = 0;
    s.exposed = 0;
    s.raw_motion = 0;
}

// --- Folding ---
//
// Runs on every event, unconditionally, before the ring. Nothing here can fail
// and nothing here allocates.
//
// wm_delete is passed in rather than looked up because the atom belongs to the
// window: interning it per event would be a round trip per event.
fn fold(s as *State, e as *xev.XEvent, wm_delete as i64) as void {
    let is i32 as ty = xev.kind(e);
    if (ty == x.FocusIn)  { s.focused = 1; return; }
    if (ty == x.FocusOut) { s.focused = 0; return; }
    if (ty == x.ConfigureNotify) {
        let is *xev.XConfigureEvent as c = xev.configure(e);
        let is i64 as nw = cast(i64, c.width);
        let is i64 as nh = cast(i64, c.height);
        if (nw != s.width || nh != s.height) {
            s.width = nw;
            s.height = nh;
            s.resized = 1;
        }
        return;
    }
    if (ty == x.Expose)     { s.exposed = 1; return; }
    if (ty == x.MapNotify)  { s.visible = 1; return; }
    if (ty == x.UnmapNotify){ s.visible = 0; return; }
    if (ty == x.ClientMessage) {
        let is *xev.XClientMessageEvent as c = xev.client(e);
        if (c.data[0] == wm_delete) { s.should_close = 1; }
        return;
    }
}

// --- Decoding ---
//
// One raw event to one Event. Returns 0 for events this view has no shape for
// — the keyboard's and the pointer's among them, which are input's — so a
// caller looping on poll_event never sees a half-filled record; the raw XEvent
// is still available through poll_xevent for anything that matters.
fn decode(e as *xev.XEvent, out as *Event) as i32 {
    clear(out);
    let is i32 as ty = xev.kind(e);
    out.xkind = ty;
    if (ty == x.KeyPress || ty == x.KeyRelease || ty == x.ButtonPress || ty == x.ButtonRelease ||
        ty == x.MotionNotify || ty == x.EnterNotify || ty == x.LeaveNotify) { return 0; }
    if (ty == XSETTINGS_CHANGED) { out.kind = SETTINGS; return 1; }
    if (ty == POPUP_NOTE) { out.kind = POPUP_DONE; return 1; }
    if (ty == COMPOSITOR_NOTE) { out.kind = COMPOSITOR; return 1; }
    if (ty == DND_NOTE) {
        let is *xev.XClientMessageEvent as n = xev.client(e);
        out.kind = cast(i32, n.data[0]);
        out.x = n.data[1];
        out.y = n.data[2];
        out.drop = cast(i32, n.data[3]);
        return 1;
    }
    if (ty == x.FocusIn)  { out.kind = FOCUS_IN;  return 1; }
    if (ty == x.FocusOut) { out.kind = FOCUS_OUT; return 1; }
    if (ty == x.ConfigureNotify) {
        let is *xev.XConfigureEvent as c = xev.configure(e);
        out.kind = RESIZE;
        out.width = cast(i64, c.width);
        out.height = cast(i64, c.height);
        out.x = cast(i64, c.x);
        out.y = cast(i64, c.y);
        return 1;
    }
    if (ty == x.Expose) {
        let is *xev.XExposeEvent as ex = xev.expose(e);
        out.kind = EXPOSE;
        out.x = cast(i64, ex.x);
        out.y = cast(i64, ex.y);
        out.width = cast(i64, ex.width);
        out.height = cast(i64, ex.height);
        return 1;
    }
    out.kind = OTHER;
    return 1;
}

fn kind_name(k as i32) as *u8 {
    if (k == NONE)       { return "none"; }
    if (k == FOCUS_IN)   { return "focus in"; }
    if (k == FOCUS_OUT)  { return "focus out"; }
    if (k == RESIZE)     { return "resize"; }
    if (k == EXPOSE)     { return "expose"; }
    if (k == CLOSE)      { return "close"; }
    if (k == SETTINGS)   { return "settings"; }
    if (k == STATE)      { return "state"; }
    if (k == DND_ENTER)  { return "dnd enter"; }
    if (k == DND_MOVE)   { return "dnd move"; }
    if (k == DND_LEAVE)  { return "dnd leave"; }
    if (k == DND_DROP)   { return "dnd drop"; }
    if (k == POPUP_DONE) { return "popup done"; }
    if (k == COMPOSITOR) { return "compositor"; }
    return "other";
}
