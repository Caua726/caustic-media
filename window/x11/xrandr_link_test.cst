// window/x11/xrandr_link_test.cst — every libXrandr.so.2 symbol resolves, or this never runs.
//
// 70 declarations transcribed by hand. The dominant failure mode is not a
// wrong type, it is a wrong NAME: one transposed letter produces a declaration
// that compiles, links against nothing, and fails the first time some program
// far from here calls it.
//
// This catches all of them at once, before main, on every CI run:
//
//   The compiler emits a library import at the CALL SITE, not at the
//   declaration, so a declaration nobody calls is invisible to the linker.
//   Every function therefore has to be called somewhere for this to mean
//   anything — ../tools/check_symbols.sh asserts that none was forgotten.
//
//   The calls sit behind `if (sink != 7777)`, and sink comes from argc. That is
//   not a constant, so the branch survives dead-code elimination and the call
//   sites are emitted — but the condition is never true, so libXrandr.so.2 is never
//   actually entered. Nothing here opens a display or touches the X server.
//
//   caustic-ld turns those imports into DT_NEEDED plus one PLT relocation each,
//   and sets DT_FLAGS = DF_BIND_NOW, so the loader resolves every name at exec.
//   A single misspelling and this process dies before main, which is the loud
//   failure a silent one deserves.
//
// So the assertion is the exit code itself: reaching main at all is the result.
//
// --- Why one binary per shared object ---
//
// Not tidiness. Measured against this toolchain: when a single binary imports
// more than roughly 256 distinct extern symbols, caustic-ld emits the PLT
// relocations for every soname but the DT_NEEDED entry for only the FIRST one.
// The binary then dies at exec with `undefined symbol`, naming a function whose
// library was never recorded.
//
// Bisected: 240 imports across two sonames links and runs; 280 does not. A
// binary with 770 imports and a SINGLE soname is fine, so the count alone is
// not the trigger — it is the count crossing that line with a second library
// present. The 1024-entry cstimport table is not it either; that one fails
// loudly and this is silent.
//
// Splitting by soname keeps each binary under the line and, when one does fail,
// says which library it was.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "bind/xrandr.cst" as xrandr;

// From argc, so the compiler cannot fold the guard away. Written once and never
// 7777, so no call below ever executes.
let is i64 as sink with mut = 0;

fn _touch_0() as void {
    if (sink != 7777) { return; }
    xrandr.XRRAddOutputMode(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRAllocGamma(cast(i32, 0));
    xrandr.XRRAllocModeInfo(cast(*u8, 0), cast(i32, 0));
    xrandr.XRRAllocateMonitor(cast(*u8, 0), cast(i32, 0));
    xrandr.XRRChangeOutputProperty(cast(*u8, 0), cast(*u8, 0), 0, 0, cast(i32, 0), cast(i32, 0),
                                   cast(*u8, 0), cast(i32, 0));
    xrandr.XRRChangeProviderProperty(cast(*u8, 0), cast(*u8, 0), 0, 0, cast(i32, 0), cast(i32, 0),
                                     cast(*u8, 0), cast(i32, 0));
    xrandr.XRRConfigCurrentConfiguration(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRConfigCurrentRate(cast(*u8, 0));
    xrandr.XRRConfigRates(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRConfigRotations(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRConfigSizes(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRConfigTimes(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRConfigureOutputProperty(cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0),
                                      cast(i32, 0), cast(*u8, 0));
    xrandr.XRRConfigureProviderProperty(cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0),
                                        cast(i32, 0), cast(*u8, 0));
    xrandr.XRRCreateMode(cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRDeleteMonitor(cast(*u8, 0), 0, 0);
    xrandr.XRRDeleteOutputMode(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRDeleteOutputProperty(cast(*u8, 0), cast(*u8, 0), 0);
    xrandr.XRRDeleteProviderProperty(cast(*u8, 0), cast(*u8, 0), 0);
    xrandr.XRRDestroyMode(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRFreeCrtcInfo(cast(*u8, 0));
    xrandr.XRRFreeGamma(cast(*u8, 0));
    xrandr.XRRFreeModeInfo(cast(*u8, 0));
    xrandr.XRRFreeMonitors(cast(*u8, 0));
    xrandr.XRRFreeOutputInfo(cast(*u8, 0));
    xrandr.XRRFreePanning(cast(*u8, 0));
    xrandr.XRRFreeProviderInfo(cast(*u8, 0));
    xrandr.XRRFreeProviderResources(cast(*u8, 0));
    xrandr.XRRFreeScreenConfigInfo(cast(*u8, 0));
    xrandr.XRRFreeScreenResources(cast(*u8, 0));
    xrandr.XRRGetCrtcGamma(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRGetCrtcGammaSize(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRGetCrtcInfo(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRGetCrtcTransform(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRGetMonitors(cast(*u8, 0), 0, cast(i32, 0), cast(*u8, 0));
    xrandr.XRRGetOutputInfo(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRGetOutputPrimary(cast(*u8, 0), 0);
    xrandr.XRRGetOutputProperty(cast(*u8, 0), cast(*u8, 0), 0, 0, 0, cast(i32, 0), cast(i32, 0), 0,
                                cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRGetPanning(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRGetProviderInfo(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
}

fn _touch_1() as void {
    if (sink != 7777) { return; }
    xrandr.XRRGetProviderProperty(cast(*u8, 0), cast(*u8, 0), 0, 0, 0, cast(i32, 0), cast(i32, 0),
                                  0, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0),
                                  cast(*u8, 0));
    xrandr.XRRGetProviderResources(cast(*u8, 0), 0);
    xrandr.XRRGetScreenInfo(cast(*u8, 0), 0);
    xrandr.XRRGetScreenResources(cast(*u8, 0), 0);
    xrandr.XRRGetScreenResourcesCurrent(cast(*u8, 0), 0);
    xrandr.XRRGetScreenSizeRange(cast(*u8, 0), 0, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0),
                                 cast(*u8, 0));
    xrandr.XRRListOutputProperties(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRListProviderProperties(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRQueryExtension(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRQueryOutputProperty(cast(*u8, 0), cast(*u8, 0), 0);
    xrandr.XRRQueryProviderProperty(cast(*u8, 0), cast(*u8, 0), 0);
    xrandr.XRRQueryVersion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRRates(cast(*u8, 0), cast(i32, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRRootToScreen(cast(*u8, 0), 0);
    xrandr.XRRRotations(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRSelectInput(cast(*u8, 0), 0, cast(i32, 0));
    xrandr.XRRSetCrtcConfig(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0),
                            cast(i32, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
    xrandr.XRRSetCrtcGamma(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRSetCrtcTransform(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0),
                               cast(*u8, 0), cast(i32, 0));
    xrandr.XRRSetMonitor(cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRSetOutputPrimary(cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRSetPanning(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRSetProviderOffloadSink(cast(*u8, 0), 0, 0);
    xrandr.XRRSetProviderOutputSource(cast(*u8, 0), 0, 0);
    xrandr.XRRSetScreenConfig(cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0), cast(*u8, 0), 0);
    xrandr.XRRSetScreenConfigAndRate(cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0), cast(*u8, 0),
                                     cast(*u8, 0), 0);
    xrandr.XRRSetScreenSize(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0), cast(i32, 0));
    xrandr.XRRSizes(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRTimes(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRUpdateConfiguration(cast(*u8, 0));
}
fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    sink = argc;

    // Never true. The point is that the compiler cannot know that.
    if (sink == 7777) {
        _touch_0();
        _touch_1();
    }

    io.printf("libXrandr.so.2: 70 symbols resolved at exec\n");
    return 0;
}
