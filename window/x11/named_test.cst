// window/x11/named_test.cst — formats by name against another program, xclip,
// under Xvfb:
//   sh window/x11/tools/run_headless.sh ./build/x11_named_test
// Owned here and read by xclip: text/html and a program's own type, the
// TARGETS listing them, an image's PNG made on demand — only when asked for,
// and once. Owned by xclip and asked for here: text/html, a program's own type,
// the names listed. And followed: CLIPBOARD_CHANGED as xclip takes the
// clipboard, and as this window does, with what it offers then.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/process.cst" as process;
use "std/os/linux.cst" as linux;
use "std/env.cst" as env;
use "x11.cst" as x11;
use "clipboard.cst" as clipboard;
use "clipwatch.cst" as clipwatch;
use "events.cst" as events;
use "../transfer.cst" as transfer;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("FAIL: %s\n", name); }
}

let is x11.window.Window as win with mut;

// The last change heard of a selection, by which: its formats; -1 for none yet.
let is [2]i32 as changed with mut;

fn pump(ms as i64) as void {
    let is i64 as until = time.now_ms() + ms;
    while (1 == 1) {
        x11.pump(&win);
        let is events.Event as e;
        while (x11.poll_event(&win, &e) == 1) {
            if (e.kind == events.CLIPBOARD_CHANGED && e.state >= 0 && e.state <= 1) { changed[e.state] = e.drop; }
        }
        if (time.now_ms() >= until) { return; }
        time.sleep_ms(2);
    }
}

// sh -c cmd, the window pumped meanwhile: the exit status, -1 after 20 seconds.
fn run(cmd as *u8) as i32 {
    let is [4]i64 as argv;
    argv[0] = cast(i64, "sh"); argv[1] = cast(i64, "-c"); argv[2] = cast(i64, cmd); argv[3] = 0;
    let is i64 as pid = process.spawnp("sh", cast(*u8, &argv[0]));
    if (pid <= 0) { return 0 - 1; }
    let is i32 as status with mut = 0;
    let is i64 as until = time.now_ms() + 20000;
    while (time.now_ms() < until) {
        pump(2);
        if (linux.wait4(pid, &status, 1, cast(*u8, 0)) == pid) { return process.exit_code_of(status); }
    }
    return 0 - 1;
}

fn read_file(path as *u8, out as *transfer.Bytes) as i32 {
    transfer.bytes_clear(out);
    let is i64 as fd = linux.open(path, linux.O_RDONLY, 0);
    if (fd < 0) { return 0; }
    let is [65536]u8 as buf with mut;
    while (1 == 1) {
        let is i64 as n = linux.read(fd, &buf[0], 65536);
        if (n <= 0) { break; }
        transfer.append(out, &buf[0], n);
    }
    linux.close(fd);
    return 1;
}

fn write_file(path as *u8, p as *u8, n as i64) as void {
    let is i64 as fd = linux.open(path, linux.O_WRONLY | linux.O_CREAT | linux.O_TRUNC, 420);
    if (fd < 0) { return; }
    linux.write(fd, p, n);
    linux.close(fd);
}

fn same(b as *transfer.Bytes, s as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    if (b.len != n) { io.printf("  %d bytes, want %d\n", b.len, n); return 0; }
    return cast(i32, mem.memcmp(b.data, s, n) == 0);
}

fn contains(b as *transfer.Bytes, s as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    let is i64 as i with mut = 0;
    while (i + n <= b.len) {
        if (mem.memcmp(cast(*u8, cast(i64, b.data) + i), s, n) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

// The clipboard's format named name asked for: the format that came.
fn ask_named(name as *u8, n as i64, out as *transfer.Bytes) as i32 {
    transfer.bytes_clear(out);
    if (x11.selection_request_named(&win, clipboard.CLIPBOARD, name, n) == 0) { return 0; }
    let is i64 as until = time.now_ms() + 5000;
    while (x11.selection_pending(&win) == 1 && time.now_ms() < until) { pump(2); }
    let is i32 as f = x11.selection_format(&win);
    if (f != 0) { transfer.bytes_set(out, x11.selection_data(&win), x11.selection_length(&win)); }
    return f;
}

fn offered() as i32 {
    if (x11.selection_request(&win, clipboard.CLIPBOARD, 0) == 0) { return 0; }
    let is i64 as until = time.now_ms() + 5000;
    while (x11.selection_pending(&win) == 1 && time.now_ms() < until) { pump(2); }
    return x11.selection_offered(&win);
}

// What makes a format on demand: how many times it was asked, and which.
let is i32 as made with mut = 0;
let is i32 as made_format with mut = 0;

fn provide(user as *u8, format as i32, name as *u8, n as i64, out as *transfer.Bytes) as i32 {
    made = made + 1;
    made_format = format;
    if (format == transfer.PNG) {
        return read_file("image/testdata/rgba.png", out);
    }
    if (format == transfer.NAMED) { return transfer.bytes_set(out, "made now", 8); }
    return transfer.bytes_set(out, "text made now", 13);
}

// A change heard of which, with what it offers, within 5 seconds: its formats,
// -1 for none.
fn change_of(which as i32) as i32 {
    let is i64 as until = time.now_ms() + 5000;
    while (changed[which] < 0 && time.now_ms() < until) { pump(5); }
    return changed[which];
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    win = x11.open("named", 200, 200);
    if (x11.is_open(&win) == 0) { io.printf("FAIL: no window\n"); return 1; }
    pump(200);
    linux.mkdir("build/named-test", 493);
    changed[0] = 0 - 1;
    changed[1] = 0 - 1;
    check("the clipboard followed", clipwatch.follow(&win) == 1);
    pump(50);
    let is transfer.Bytes as got with mut;
    transfer.bytes_init(&got);
    let is transfer.Offer as o with mut;
    transfer.offer_init(&o);

    // --- Owned here ---
    let is *u8 as own = "application/x-caustic-test";
    check("named: kept", transfer.offer_text(&o, "plain", 5) == 1 && transfer.offer_named(&o, transfer.MIME_HTML, 9, "<i>rich</i>", 11) == 1 &&
          transfer.offer_named(&o, own, 26, "own bytes", 9) == 1);
    changed[0] = 0 - 1;
    check("owned", x11.selection_set(&win, clipboard.CLIPBOARD, &o) == 1);
    let is i32 as ch with mut = change_of(0);
    check("our own taking it: said, with text and text/html", ch >= 0 && (ch & transfer.TEXT) != 0 && (ch & transfer.NAMED) != 0 &&
          (ch & transfer.HTML) != 0);
    check("xclip lists them", run("xclip -o -selection clipboard -t TARGETS > build/named-test/a") == 0 &&
          read_file("build/named-test/a", &got) == 1 && contains(&got, "text/html") == 1 && contains(&got, own) == 1);
    check("xclip reads the HTML", run("xclip -o -selection clipboard -t text/html > build/named-test/a") == 0 &&
          read_file("build/named-test/a", &got) == 1 && same(&got, "<i>rich</i>") == 1);
    check("xclip reads the program's own type", run("xclip -o -selection clipboard -t application/x-caustic-test > build/named-test/a") == 0 &&
          read_file("build/named-test/a", &got) == 1 && same(&got, "own bytes") == 1);
    check("the text beside them", run("xclip -o -selection clipboard > build/named-test/a") == 0 &&
          read_file("build/named-test/a", &got) == 1 && same(&got, "plain") == 1);

    // --- Made on demand ---
    transfer.offer_free(&o);
    transfer.offer_init(&o);
    transfer.offer_lazy(&o, transfer.PNG | transfer.TEXT, fn_ptr(provide), cast(*u8, 0));
    check("named on demand: said", transfer.offer_lazy_named(&o, own, 26, fn_ptr(provide), cast(*u8, 0)) == 1);
    made = 0;
    check("owned, nothing made", x11.selection_set(&win, clipboard.CLIPBOARD, &o) == 1 && made == 0);
    pump(100);
    check("listed: still nothing made", run("xclip -o -selection clipboard -t TARGETS > build/named-test/a") == 0 && made == 0 &&
          read_file("build/named-test/a", &got) == 1 && contains(&got, "image/png") == 1 && contains(&got, own) == 1);
    let is transfer.Bytes as png with mut;
    transfer.bytes_init(&png);
    read_file("image/testdata/rgba.png", &png);
    check("the PNG asked for: made", run("xclip -o -selection clipboard -t image/png > build/named-test/a") == 0 && made == 1 &&
          made_format == transfer.PNG && read_file("build/named-test/a", &got) == 1 && got.len == png.len &&
          mem.memcmp(got.data, png.data, png.len) == 0);
    check("and again: made once", run("xclip -o -selection clipboard -t image/png > build/named-test/a") == 0 && made == 1);
    check("the program's own asked for: made", run("xclip -o -selection clipboard -t application/x-caustic-test > build/named-test/a") == 0 &&
          made == 2 && made_format == transfer.NAMED && read_file("build/named-test/a", &got) == 1 && same(&got, "made now") == 1);
    check("the text asked for: made", run("xclip -o -selection clipboard > build/named-test/a") == 0 && made == 3 &&
          read_file("build/named-test/a", &got) == 1 && same(&got, "text made now") == 1);

    // --- Owned by xclip ---
    write_file("build/named-test/in", "<u>theirs</u>", 13);
    changed[0] = 0 - 1;
    check("xclip takes it with HTML", run("xclip -i -selection clipboard -t text/html build/named-test/in > /dev/null 2>&1") == 0);
    ch = change_of(0);
    check("said: another program took it, HTML there", ch >= 0 && (ch & transfer.NAMED) != 0 && (ch & transfer.HTML) != 0);
    let is i32 as of with mut = offered();
    check("what it offers: named", (of & transfer.NAMED) != 0);
    let is *transfer.Names as names = x11.selection_offered_names(&win);
    check("text/html among the names", transfer.names_has(names, transfer.MIME_HTML, 9) == 1);
    check("asked for by name", ask_named(transfer.MIME_HTML, 9, &got) == transfer.NAMED && same(&got, "<u>theirs</u>") == 1);
    check("a name not there: none", ask_named("application/x-absent", 20, &got) == 0 && got.len == 0);
    write_file("build/named-test/in", "their own", 9);
    check("xclip takes it with its own type", run("xclip -i -selection clipboard -t application/x-caustic-test build/named-test/in > /dev/null 2>&1") == 0);
    pump(200);
    check("its own asked for by name", ask_named(own, 26, &got) == transfer.NAMED && same(&got, "their own") == 1);

    // --- The primary selection followed apart ---
    changed[1] = 0 - 1;
    check("xclip takes the primary selection", run("xclip -i -selection primary build/named-test/in > /dev/null 2>&1") == 0);
    let is i32 as pr = change_of(1);
    check("said of the primary selection, text", pr >= 0 && (pr & transfer.TEXT) != 0);

    transfer.offer_free(&o);
    x11.close(&win);
    if (fails == 0) { io.printf("x11 named formats: all checks passed\n"); return 0; }
    io.printf("x11 named formats: %d failures\n", fails);
    return 1;
}
