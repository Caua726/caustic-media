// window/x11/bind/xscrnsaver.cst — MIT-SCREEN-SAVER.
//
// Eleven functions in libXss, and one of them is the reason this file exists:
// `XScreenSaverSuspend`. A program running fullscreen with a gamepad in hand
// sends no keyboard and no pointer events, so the server's idle timer keeps
// counting and the screen blanks in the middle of it.
//
// --- Why not DPMS ---
//
// bind/xdpms.cst can force the monitor back on, and doing that on a timer is
// the wrong answer twice over: it fights the user's own power settings, and it
// only cures the symptom after the screen has already blanked. Suspend tells
// the server not to start counting in the first place, and the server undoes
// it when the client disconnects — including when it crashes.
//
// --- It is a counter, not a flag ---
//
// `XScreenSaverSuspend(dpy, True)` increments and `False` decrements, per
// client. Calling suspend twice and resume once leaves the screensaver still
// suspended, which is why ../screensaver.cst keeps its own depth rather than a
// boolean and refuses to go below zero.
//
// --- The other ten ---
//
// Querying idle time is the useful one after suspend: `XScreenSaverQueryInfo`
// reports how long the user has been away and whether the saver is on, which
// is what an idle-detecting program wants. `Register`, `Unregister` and
// `SetAttributes` are for writing a screensaver rather than for avoiding one —
// they install an external saver window — and are bound for completeness.

extern "libXss.so.1" fn XScreenSaverQueryExtension(dpy as *u8, event_base as *u8,
                                                   error_base as *u8) as i32;
extern "libXss.so.1" fn XScreenSaverQueryVersion(dpy as *u8, major_version as *u8,
                                                 minor_version as *u8) as i32;
extern "libXss.so.1" fn XScreenSaverAllocInfo() as *u8;
extern "libXss.so.1" fn XScreenSaverQueryInfo(dpy as *u8, drawable as i64,
                                              info as *u8) as i32;
extern "libXss.so.1" fn XScreenSaverSelectInput(dpy as *u8, drawable as i64,
                                                mask as i64) as void;
extern "libXss.so.1" fn XScreenSaverSetAttributes(dpy as *u8, drawable as i64,
                                                  wx as i32, wy as i32,
                                                  width as u32, height as u32,
                                                  border_width as u32, depth as i32,
                                                  class as u32, visual as *u8,
                                                  valuemask as i64, attributes as *u8) as void;
extern "libXss.so.1" fn XScreenSaverUnsetAttributes(dpy as *u8, drawable as i64) as void;
extern "libXss.so.1" fn XScreenSaverRegister(dpy as *u8, screen as i32,
                                             xid as i64, type_ as i64) as i32;
extern "libXss.so.1" fn XScreenSaverUnregister(dpy as *u8, screen as i32) as i32;
extern "libXss.so.1" fn XScreenSaverGetRegistered(dpy as *u8, screen as i32,
                                                  xid as *u8, type_ as *u8) as i32;
extern "libXss.so.1" fn XScreenSaverSuspend(dpy as *u8, suspend as i32) as void;

// --- What QueryInfo fills in ---
//
// `state` is Off, On or Disabled; `kind` is Blanked, Internal or External;
// `til_or_since` is milliseconds until the saver activates or since it did,
// depending on the state; `idle` is milliseconds since the last input.
//
// Packed with explicit pads, and pinned by x11_layout_test.cst like every other
// struct in this directory.
struct XScreenSaverInfo {
    window       as i64;   //  0   the screen saver window
    state        as i32;   //  8
    kind         as i32;   // 12
    til_or_since as i64;   // 16
    idle         as i64;   // 24
    eventMask    as i64;   // 32
}                          // 40

let is i32 as ScreenSaverOff      with imut = 0;
let is i32 as ScreenSaverOn       with imut = 1;
let is i32 as ScreenSaverDisabled with imut = 2;

let is i32 as ScreenSaverBlanked  with imut = 0;
let is i32 as ScreenSaverInternal with imut = 1;
let is i32 as ScreenSaverExternal with imut = 2;

let is i64 as ScreenSaverNotifyMask with imut = 1;
let is i64 as ScreenSaverCycleMask  with imut = 2;
