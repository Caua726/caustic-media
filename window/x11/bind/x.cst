// window/x11/bind/x.cst — X.h, which is the protocol's vocabulary.
//
// Every number the X protocol names: event types and the masks that select
// them, error codes, window and graphics attributes, gravity, visual classes,
// grab modes. Nothing here is libX11's — these are wire protocol values, stable
// since 1987, and they would be identical in a binding that spoke the socket
// directly instead of linking a library.
//
// So this file declares no extern and imports nothing. It costs a binary
// nothing, and it is the one file in bind/ that a future wire-protocol backend
// would keep unchanged.
//
// Types follow X.h rather than convenience. Where the header writes `1L<<n` the
// constant is i64; where it writes `1<<n` or a bare integer it is i32. That
// split looks arbitrary and is: event masks are long because there are 25 of
// them and modifier masks are int because there are 13. Being faithful means
// someone can read X.h and this file side by side and see the same thing, which
// matters more here than saving a cast. The cast that costs is testing a
// modifier: XKeyEvent.state is u32, so it reads
//
//     if ((cast(i64, k.state) & x.ShiftMask) != 0) { ... }
//
// Resource ids, atoms and times are i64 because C makes them `unsigned long`.
// Not u64: nothing in X approaches 2^63, the bit operations are identical
// either way, and one rule beats mixed signedness at a thousand call sites.
//
// Names are X.h's names, unchanged. `None`, `Above`, `Always` and `Success` are
// generic enough to look like they want a prefix, and they do not get one: a
// binding whose names differ from the documentation is a binding you have to
// translate while reading `man XCreateWindow`.

// --- Protocol version ---

let is i32 as X_PROTOCOL          with imut = 11;
let is i32 as X_PROTOCOL_REVISION with imut = 0;

// --- Reserved resource and constant definitions ---
//
// All of these are 0 or 1 as a resource id, which is why they are i64 and why
// the same number means different things in different arguments. `None` is the
// null resource everywhere; `ParentRelative` is only a background pixmap.

let is i64 as None            with imut = 0;
let is i64 as ParentRelative  with imut = 1;
let is i64 as CopyFromParent  with imut = 0;
let is i64 as PointerWindow   with imut = 0;
let is i64 as InputFocus      with imut = 1;
let is i64 as PointerRoot     with imut = 1;
let is i64 as AnyPropertyType with imut = 0;
let is i64 as AnyKey          with imut = 0;
let is i64 as AnyButton       with imut = 0;
let is i64 as AllTemporary    with imut = 0;
let is i64 as CurrentTime     with imut = 0;
let is i64 as NoSymbol        with imut = 0;

// --- Event masks ---
//
// What XSelectInput takes. A window receives only what it asked for, and the
// most common way to lose an event is never to have selected it.

let is i64 as NoEventMask              with imut = 0;
let is i64 as KeyPressMask             with imut = 1;
let is i64 as KeyReleaseMask           with imut = 2;
let is i64 as ButtonPressMask          with imut = 4;
let is i64 as ButtonReleaseMask        with imut = 8;
let is i64 as EnterWindowMask          with imut = 16;
let is i64 as LeaveWindowMask          with imut = 32;
let is i64 as PointerMotionMask        with imut = 64;
let is i64 as PointerMotionHintMask    with imut = 128;
let is i64 as Button1MotionMask        with imut = 256;
let is i64 as Button2MotionMask        with imut = 512;
let is i64 as Button3MotionMask        with imut = 1024;
let is i64 as Button4MotionMask        with imut = 2048;
let is i64 as Button5MotionMask        with imut = 4096;
let is i64 as ButtonMotionMask         with imut = 8192;
let is i64 as KeymapStateMask          with imut = 16384;
let is i64 as ExposureMask             with imut = 32768;
let is i64 as VisibilityChangeMask     with imut = 65536;
let is i64 as StructureNotifyMask      with imut = 131072;
let is i64 as ResizeRedirectMask       with imut = 262144;
let is i64 as SubstructureNotifyMask   with imut = 524288;
let is i64 as SubstructureRedirectMask with imut = 1048576;
let is i64 as FocusChangeMask          with imut = 2097152;
let is i64 as PropertyChangeMask       with imut = 4194304;
let is i64 as ColormapChangeMask       with imut = 8388608;
let is i64 as OwnerGrabButtonMask      with imut = 16777216;

// --- Event types ---
//
// The discriminator in XEvent's first int. Numbering starts at 2 because 0 and
// 1 are the error and reply cases of the wire protocol, which never arrive as
// events.

let is i32 as KeyPress         with imut = 2;
let is i32 as KeyRelease       with imut = 3;
let is i32 as ButtonPress      with imut = 4;
let is i32 as ButtonRelease    with imut = 5;
let is i32 as MotionNotify     with imut = 6;
let is i32 as EnterNotify      with imut = 7;
let is i32 as LeaveNotify      with imut = 8;
let is i32 as FocusIn          with imut = 9;
let is i32 as FocusOut         with imut = 10;
let is i32 as KeymapNotify     with imut = 11;
let is i32 as Expose           with imut = 12;
let is i32 as GraphicsExpose   with imut = 13;
let is i32 as NoExpose         with imut = 14;
let is i32 as VisibilityNotify with imut = 15;
let is i32 as CreateNotify     with imut = 16;
let is i32 as DestroyNotify    with imut = 17;
let is i32 as UnmapNotify      with imut = 18;
let is i32 as MapNotify        with imut = 19;
let is i32 as MapRequest       with imut = 20;
let is i32 as ReparentNotify   with imut = 21;
let is i32 as ConfigureNotify  with imut = 22;
let is i32 as ConfigureRequest with imut = 23;
let is i32 as GravityNotify    with imut = 24;
let is i32 as ResizeRequest    with imut = 25;
let is i32 as CirculateNotify  with imut = 26;
let is i32 as CirculateRequest with imut = 27;
let is i32 as PropertyNotify   with imut = 28;
let is i32 as SelectionClear   with imut = 29;
let is i32 as SelectionRequest with imut = 30;
let is i32 as SelectionNotify  with imut = 31;
let is i32 as ColormapNotify   with imut = 32;
let is i32 as ClientMessage    with imut = 33;
let is i32 as MappingNotify    with imut = 34;
let is i32 as GenericEvent     with imut = 35;
let is i32 as LASTEvent        with imut = 36;

// --- Key and button modifiers ---
//
// The `state` field of a key, button or motion event. Mod1 is conventionally
// Alt and Mod4 conventionally Super, but nothing in the protocol says so — the
// mapping is the keyboard's, read with XGetModifierMapping.

let is i32 as ShiftMask   with imut = 1;
let is i32 as LockMask    with imut = 2;
let is i32 as ControlMask with imut = 4;
let is i32 as Mod1Mask    with imut = 8;
let is i32 as Mod2Mask    with imut = 16;
let is i32 as Mod3Mask    with imut = 32;
let is i32 as Mod4Mask    with imut = 64;
let is i32 as Mod5Mask    with imut = 128;

let is i32 as ShiftMapIndex   with imut = 0;
let is i32 as LockMapIndex    with imut = 1;
let is i32 as ControlMapIndex with imut = 2;
let is i32 as Mod1MapIndex    with imut = 3;
let is i32 as Mod2MapIndex    with imut = 4;
let is i32 as Mod3MapIndex    with imut = 5;
let is i32 as Mod4MapIndex    with imut = 6;
let is i32 as Mod5MapIndex    with imut = 7;

let is i32 as Button1Mask with imut = 256;
let is i32 as Button2Mask with imut = 512;
let is i32 as Button3Mask with imut = 1024;
let is i32 as Button4Mask with imut = 2048;
let is i32 as Button5Mask with imut = 4096;
let is i32 as AnyModifier with imut = 32768;

// Buttons 4 and 5 are the wheel, up and down: X has no scroll event and never
// grew one. Horizontal scroll is buttons 6 and 7 by convention, which the
// protocol does not name at all.
let is i32 as Button1 with imut = 1;
let is i32 as Button2 with imut = 2;
let is i32 as Button3 with imut = 3;
let is i32 as Button4 with imut = 4;
let is i32 as Button5 with imut = 5;

// --- Notify modes and details ---

let is i32 as NotifyNormal       with imut = 0;
let is i32 as NotifyGrab         with imut = 1;
let is i32 as NotifyUngrab       with imut = 2;
let is i32 as NotifyWhileGrabbed with imut = 3;

let is i32 as NotifyHint with imut = 1;

let is i32 as NotifyAncestor         with imut = 0;
let is i32 as NotifyVirtual          with imut = 1;
let is i32 as NotifyInferior         with imut = 2;
let is i32 as NotifyNonlinear        with imut = 3;
let is i32 as NotifyNonlinearVirtual with imut = 4;
let is i32 as NotifyPointer          with imut = 5;
let is i32 as NotifyPointerRoot      with imut = 6;
let is i32 as NotifyDetailNone       with imut = 7;

// --- Visibility, stacking place, host family ---

let is i32 as VisibilityUnobscured        with imut = 0;
let is i32 as VisibilityPartiallyObscured with imut = 1;
let is i32 as VisibilityFullyObscured     with imut = 2;

let is i32 as PlaceOnTop    with imut = 0;
let is i32 as PlaceOnBottom with imut = 1;

let is i32 as FamilyInternet          with imut = 0;
let is i32 as FamilyDECnet            with imut = 1;
let is i32 as FamilyChaos             with imut = 2;
let is i32 as FamilyServerInterpreted with imut = 5;
let is i32 as FamilyInternet6         with imut = 6;

// --- Property and colormap state ---

let is i32 as PropertyNewValue with imut = 0;
let is i32 as PropertyDelete   with imut = 1;

let is i32 as ColormapUninstalled with imut = 0;
let is i32 as ColormapInstalled   with imut = 1;

// --- Grabs ---

let is i32 as GrabModeSync  with imut = 0;
let is i32 as GrabModeAsync with imut = 1;

let is i32 as GrabSuccess     with imut = 0;
let is i32 as AlreadyGrabbed  with imut = 1;
let is i32 as GrabInvalidTime with imut = 2;
let is i32 as GrabNotViewable with imut = 3;
let is i32 as GrabFrozen      with imut = 4;

let is i32 as AsyncPointer   with imut = 0;
let is i32 as SyncPointer    with imut = 1;
let is i32 as ReplayPointer  with imut = 2;
let is i32 as AsyncKeyboard  with imut = 3;
let is i32 as SyncKeyboard   with imut = 4;
let is i32 as ReplayKeyboard with imut = 5;
let is i32 as AsyncBoth      with imut = 6;
let is i32 as SyncBoth       with imut = 7;

// --- Focus revert ---

let is i32 as RevertToNone        with imut = 0;
let is i32 as RevertToPointerRoot with imut = 1;
let is i32 as RevertToParent      with imut = 2;

// --- Error codes ---
//
// What lands in XErrorEvent.error_code. BadAccess is the one MIT-SHM produces
// when a shared segment cannot be attached, and it arrives asynchronously —
// which is why surface.cst installs an error handler and XSyncs rather than
// trusting XShmAttach's return value.

let is i32 as Success             with imut = 0;
let is i32 as BadRequest          with imut = 1;
let is i32 as BadValue            with imut = 2;
let is i32 as BadWindow           with imut = 3;
let is i32 as BadPixmap           with imut = 4;
let is i32 as BadAtom             with imut = 5;
let is i32 as BadCursor           with imut = 6;
let is i32 as BadFont             with imut = 7;
let is i32 as BadMatch            with imut = 8;
let is i32 as BadDrawable         with imut = 9;
let is i32 as BadAccess           with imut = 10;
let is i32 as BadAlloc            with imut = 11;
let is i32 as BadColor            with imut = 12;
let is i32 as BadGC               with imut = 13;
let is i32 as BadIDChoice         with imut = 14;
let is i32 as BadName             with imut = 15;
let is i32 as BadLength           with imut = 16;
let is i32 as BadImplementation   with imut = 17;
let is i32 as FirstExtensionError with imut = 128;
let is i32 as LastExtensionError  with imut = 255;

// --- Window classes ---

let is i32 as InputOutput with imut = 1;
let is i32 as InputOnly   with imut = 2;

// --- Window attribute mask ---
//
// The value_mask of XCreateWindow and XChangeWindowAttributes. Every bit set
// here has to have a corresponding field filled in the XSetWindowAttributes
// passed alongside, and the server reads them in bit order — a mask that
// disagrees with the struct produces a window configured from adjacent memory.

let is i64 as CWBackPixmap       with imut = 1;
let is i64 as CWBackPixel        with imut = 2;
let is i64 as CWBorderPixmap     with imut = 4;
let is i64 as CWBorderPixel      with imut = 8;
let is i64 as CWBitGravity       with imut = 16;
let is i64 as CWWinGravity       with imut = 32;
let is i64 as CWBackingStore     with imut = 64;
let is i64 as CWBackingPlanes    with imut = 128;
let is i64 as CWBackingPixel     with imut = 256;
let is i64 as CWOverrideRedirect with imut = 512;
let is i64 as CWSaveUnder        with imut = 1024;
let is i64 as CWEventMask        with imut = 2048;
let is i64 as CWDontPropagate    with imut = 4096;
let is i64 as CWColormap         with imut = 8192;
let is i64 as CWCursor           with imut = 16384;

// --- Configure window mask ---
//
// A separate namespace from the attribute mask above despite the shared CW
// prefix: this one goes to XConfigureWindow and its bits start over at 1.

let is i32 as CWX           with imut = 1;
let is i32 as CWY           with imut = 2;
let is i32 as CWWidth       with imut = 4;
let is i32 as CWHeight      with imut = 8;
let is i32 as CWBorderWidth with imut = 16;
let is i32 as CWSibling     with imut = 32;
let is i32 as CWStackMode   with imut = 64;

// --- Gravity ---
//
// Where content goes when a window resizes. ForgetGravity and UnmapGravity are
// both 0 because one is a bit gravity and the other a window gravity, and the
// protocol reuses the value in the two different fields.

let is i32 as ForgetGravity    with imut = 0;
let is i32 as NorthWestGravity with imut = 1;
let is i32 as NorthGravity     with imut = 2;
let is i32 as NorthEastGravity with imut = 3;
let is i32 as WestGravity      with imut = 4;
let is i32 as CenterGravity    with imut = 5;
let is i32 as EastGravity      with imut = 6;
let is i32 as SouthWestGravity with imut = 7;
let is i32 as SouthGravity     with imut = 8;
let is i32 as SouthEastGravity with imut = 9;
let is i32 as StaticGravity    with imut = 10;
let is i32 as UnmapGravity     with imut = 0;

// --- Backing store, map state ---

let is i32 as NotUseful   with imut = 0;
let is i32 as WhenMapped  with imut = 1;
let is i32 as Always      with imut = 2;

let is i32 as IsUnmapped   with imut = 0;
let is i32 as IsUnviewable with imut = 1;
let is i32 as IsViewable   with imut = 2;

// --- Colormap and close-down mode ---

let is i32 as SetModeInsert with imut = 0;
let is i32 as SetModeDelete with imut = 1;

let is i32 as DestroyAll      with imut = 0;
let is i32 as RetainPermanent with imut = 1;
let is i32 as RetainTemporary with imut = 2;

// --- Stacking ---

let is i32 as Above    with imut = 0;
let is i32 as Below    with imut = 1;
let is i32 as TopIf    with imut = 2;
let is i32 as BottomIf with imut = 3;
let is i32 as Opposite with imut = 4;

let is i32 as RaiseLowest  with imut = 0;
let is i32 as LowerHighest with imut = 1;

// --- Property mode ---

let is i32 as PropModeReplace with imut = 0;
let is i32 as PropModePrepend with imut = 1;
let is i32 as PropModeAppend  with imut = 2;

// --- Graphics functions ---
//
// The raster op a GC applies. GXcopy is the only one this layer uses, and the
// other fifteen are here because they are the vocabulary, not because anything
// needs them.

let is i32 as GXclear        with imut = 0;
let is i32 as GXand          with imut = 1;
let is i32 as GXandReverse   with imut = 2;
let is i32 as GXcopy         with imut = 3;
let is i32 as GXandInverted  with imut = 4;
let is i32 as GXnoop         with imut = 5;
let is i32 as GXxor          with imut = 6;
let is i32 as GXor           with imut = 7;
let is i32 as GXnor          with imut = 8;
let is i32 as GXequiv        with imut = 9;
let is i32 as GXinvert       with imut = 10;
let is i32 as GXorReverse    with imut = 11;
let is i32 as GXcopyInverted with imut = 12;
let is i32 as GXorInverted   with imut = 13;
let is i32 as GXnand         with imut = 14;
let is i32 as GXset          with imut = 15;

// --- Line, cap, join, fill ---

let is i32 as LineSolid      with imut = 0;
let is i32 as LineOnOffDash  with imut = 1;
let is i32 as LineDoubleDash with imut = 2;

let is i32 as CapNotLast    with imut = 0;
let is i32 as CapButt       with imut = 1;
let is i32 as CapRound      with imut = 2;
let is i32 as CapProjecting with imut = 3;

let is i32 as JoinMiter with imut = 0;
let is i32 as JoinRound with imut = 1;
let is i32 as JoinBevel with imut = 2;

let is i32 as FillSolid          with imut = 0;
let is i32 as FillTiled          with imut = 1;
let is i32 as FillStippled       with imut = 2;
let is i32 as FillOpaqueStippled with imut = 3;

let is i32 as EvenOddRule with imut = 0;
let is i32 as WindingRule with imut = 1;

// --- Subwindow mode, clip ordering, coordinate mode, shape ---

let is i32 as ClipByChildren   with imut = 0;
let is i32 as IncludeInferiors with imut = 1;

let is i32 as Unsorted with imut = 0;
let is i32 as YSorted  with imut = 1;
let is i32 as YXSorted with imut = 2;
let is i32 as YXBanded with imut = 3;

let is i32 as CoordModeOrigin   with imut = 0;
let is i32 as CoordModePrevious with imut = 1;

let is i32 as Complex   with imut = 0;
let is i32 as Nonconvex with imut = 1;
let is i32 as Convex    with imut = 2;

let is i32 as ArcChord    with imut = 0;
let is i32 as ArcPieSlice with imut = 1;

// --- GC value mask ---

let is i64 as GCFunction          with imut = 1;
let is i64 as GCPlaneMask         with imut = 2;
let is i64 as GCForeground        with imut = 4;
let is i64 as GCBackground        with imut = 8;
let is i64 as GCLineWidth         with imut = 16;
let is i64 as GCLineStyle         with imut = 32;
let is i64 as GCCapStyle          with imut = 64;
let is i64 as GCJoinStyle         with imut = 128;
let is i64 as GCFillStyle         with imut = 256;
let is i64 as GCFillRule          with imut = 512;
let is i64 as GCTile              with imut = 1024;
let is i64 as GCStipple           with imut = 2048;
let is i64 as GCTileStipXOrigin   with imut = 4096;
let is i64 as GCTileStipYOrigin   with imut = 8192;
let is i64 as GCFont              with imut = 16384;
let is i64 as GCSubwindowMode     with imut = 32768;
let is i64 as GCGraphicsExposures with imut = 65536;
let is i64 as GCClipXOrigin       with imut = 131072;
let is i64 as GCClipYOrigin       with imut = 262144;
let is i64 as GCClipMask          with imut = 524288;
let is i64 as GCDashOffset        with imut = 1048576;
let is i64 as GCDashList          with imut = 2097152;
let is i64 as GCArcMode           with imut = 4194304;
let is i32 as GCLastBit           with imut = 22;

// --- Fonts ---

let is i32 as FontLeftToRight with imut = 0;
let is i32 as FontRightToLeft with imut = 1;
let is i32 as FontChange      with imut = 255;

// --- Image formats ---
//
// ZPixmap is what a software framebuffer is: one packed value per pixel at the
// drawable's depth. XYPixmap stores one bitplane at a time, which no modern
// path wants and which XPutImage will happily accept and misinterpret.

let is i32 as XYBitmap with imut = 0;
let is i32 as XYPixmap with imut = 1;
let is i32 as ZPixmap  with imut = 2;

// --- Colormap allocation ---

let is i32 as AllocNone with imut = 0;
let is i32 as AllocAll  with imut = 1;

let is i32 as DoRed   with imut = 1;
let is i32 as DoGreen with imut = 2;
let is i32 as DoBlue  with imut = 4;

// --- Cursor ---

let is i32 as CursorShape  with imut = 0;
let is i32 as TileShape    with imut = 1;
let is i32 as StippleShape with imut = 2;

// --- Keyboard and pointer ---

let is i32 as AutoRepeatModeOff     with imut = 0;
let is i32 as AutoRepeatModeOn      with imut = 1;
let is i32 as AutoRepeatModeDefault with imut = 2;

let is i32 as LedModeOff with imut = 0;
let is i32 as LedModeOn  with imut = 1;

let is i64 as KBKeyClickPercent with imut = 1;
let is i64 as KBBellPercent     with imut = 2;
let is i64 as KBBellPitch       with imut = 4;
let is i64 as KBBellDuration    with imut = 8;
let is i64 as KBLed             with imut = 16;
let is i64 as KBLedMode         with imut = 32;
let is i64 as KBKey             with imut = 64;
let is i64 as KBAutoRepeatMode  with imut = 128;

let is i32 as MappingSuccess with imut = 0;
let is i32 as MappingBusy    with imut = 1;
let is i32 as MappingFailed  with imut = 2;

let is i32 as MappingModifier with imut = 0;
let is i32 as MappingKeyboard with imut = 1;
let is i32 as MappingPointer  with imut = 2;

// --- Screen saver ---

let is i32 as DontPreferBlanking with imut = 0;
let is i32 as PreferBlanking     with imut = 1;
let is i32 as DefaultBlanking    with imut = 2;

let is i32 as DisableScreenSaver   with imut = 0;
let is i32 as DisableScreenInterval with imut = 0;

let is i32 as DontAllowExposures with imut = 0;
let is i32 as AllowExposures     with imut = 1;
let is i32 as DefaultExposures   with imut = 2;

let is i32 as ScreenSaverReset  with imut = 0;
let is i32 as ScreenSaverActive with imut = 1;

// --- Hosts and connections ---

let is i32 as HostInsert with imut = 0;
let is i32 as HostDelete with imut = 1;

let is i32 as EnableAccess  with imut = 1;
let is i32 as DisableAccess with imut = 0;

// --- Visual classes ---
//
// TrueColor is what this layer requires: a direct mapping from bits to
// intensity, no colormap lookup. On anything else the framebuffer's packed
// 0xAARRGGBB is not a colour, and picking a visual is the only defence.

let is i32 as StaticGray  with imut = 0;
let is i32 as GrayScale   with imut = 1;
let is i32 as StaticColor with imut = 2;
let is i32 as PseudoColor with imut = 3;
let is i32 as TrueColor   with imut = 4;
let is i32 as DirectColor with imut = 5;

// --- Byte and bit order ---

let is i32 as LSBFirst with imut = 0;
let is i32 as MSBFirst with imut = 1;
