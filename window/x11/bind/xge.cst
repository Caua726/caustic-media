// window/x11/bind/xge.cst — GenericEvent, the escape from 33 event types.
//
// The core protocol has room for 33 event types and they were all used, so
// every extension since XInput2 delivers through one shared type whose payload
// is fetched with XGetEventData. ../window.cst already handles that side; these
// two functions are the extension's own version query.

extern "libXext.so.6" fn XGEQueryExtension(p as *u8, p2 as *u8, p3 as *u8) as i32;
extern "libXext.so.6" fn XGEQueryVersion(p as *u8, p2 as *u8, p3 as *u8) as i32;
