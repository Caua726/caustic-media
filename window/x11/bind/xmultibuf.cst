// window/x11/bind/xmultibuf.cst — the multibuffer extension.
//
// Several buffers per window, displayed in sequence, plus the stereo pair a
// shutter-glasses setup needed. DBE replaced it, and the server dropped the
// implementation; the client stubs remain in libXext.

extern "libXext.so.6" fn XmbufChangeBufferAttributes(dpy as *u8, buffer as i64, mask as i64, p as *u8) as void;
extern "libXext.so.6" fn XmbufChangeWindowAttributes(dpy as *u8, w as i64, mask as i64, p as *u8) as void;
extern "libXext.so.6" fn XmbufClearBufferArea(dpy as *u8, buffer as i64, n as i32, n2 as i32, n3 as u32, n4 as u32, n5 as i32) as void;
extern "libXext.so.6" fn XmbufCreateBuffers(dpy as *u8, w as i64, n as i32, n2 as i32, n3 as i32, p as *u8) as i32;
extern "libXext.so.6" fn XmbufCreateStereoWindow(dpy as *u8, w as i64, n as i32, n2 as i32, n3 as u32, n4 as u32, n5 as u32, n6 as i32, n7 as u32, p as *u8, mask as i64, p2 as *u8, p3 as *u8, p4 as *u8) as i64;
extern "libXext.so.6" fn XmbufDestroyBuffers(dpy as *u8, w as i64) as void;
extern "libXext.so.6" fn XmbufDisplayBuffers(dpy as *u8, n as i32, p as *u8, n2 as i32, n3 as i32) as void;
extern "libXext.so.6" fn XmbufGetBufferAttributes(dpy as *u8, buffer as i64, p as *u8) as i32;
extern "libXext.so.6" fn XmbufGetScreenInfo(dpy as *u8, d as i64, p as *u8, p2 as *u8, p3 as *u8, p4 as *u8) as i32;
extern "libXext.so.6" fn XmbufGetVersion(dpy as *u8, p as *u8, p2 as *u8) as i32;
extern "libXext.so.6" fn XmbufGetWindowAttributes(dpy as *u8, w as i64, p as *u8) as i32;
extern "libXext.so.6" fn XmbufQueryExtension(dpy as *u8, p as *u8, p2 as *u8) as i32;
