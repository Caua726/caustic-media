// window/x11/bind/xext.cst — the extension mechanism itself.
//
// Not an extension: this is the machinery every other one is built on. An
// extension registers itself with XextCreateExtension, keeps per-display state
// through XextAddDisplay and XextFindDisplay, and installs hooks for events,
// errors and display closing.
//
// XSetExtensionErrorHandler is the one a program is likely to want: it decides
// what happens when a request is made for an extension the server does not
// have. The default prints and exits.
//
// A program using these is writing a binding to an extension that has none —
// which is exactly what a library like this one would do rather than link yet
// another shared object.

extern "libXext.so.6" fn XMissingExtension(dpy as *u8, p as *u8) as i32;
extern "libXext.so.6" fn XSetExtensionErrorHandler(handler as *u8) as *u8;
extern "libXext.so.6" fn XextAddDisplay(p as *u8, dpy as *u8, p2 as *u8, p3 as *u8, n as i32, data as *u8) as *u8;
extern "libXext.so.6" fn XextCreateExtension() as *u8;
extern "libXext.so.6" fn XextDestroyExtension(p as *u8) as void;
extern "libXext.so.6" fn XextFindDisplay(p as *u8, dpy as *u8) as *u8;
extern "libXext.so.6" fn XextRemoveDisplay(p as *u8, dpy as *u8) as i32;
