// window/x11/bind/xfixes.cst — Xfixes: two things nothing else can do.
//
// A grab bag of protocol repairs, of which this layer needs exactly two and
// they are the reason it is bound at all.
//
//   XFixesHideCursor / XFixesShowCursor
//     The core protocol has no way to hide the pointer. The trick everyone used
//     was defining a 1x1 fully transparent cursor, which works and leaves a
//     cursor that a compositor may still draw a shadow for. This actually hides
//     it.
//
//   XFixesSelectSelectionInput
//     Tells the server to send an event when a selection's owner changes.
//     Without it, the only way to know the clipboard changed is to ask
//     repeatedly — polling a clipboard, forever, in every program.
//
// The rest — regions, cursor images, save sets — is bound because
// ../../window.md asks for it, not because anything here reaches for it.
//
// XFixesFindDisplay is exported by libXfixes.so.3 but declared only in the
// private Xfixesint.h. Binding it would mean inventing a prototype, so it is
// named here and left out, the same way the four libX11 internals are.

extern "libXfixes.so.3" fn XFixesChangeCursor(dpy as *u8, source as i64, destination as i64) as void;
extern "libXfixes.so.3" fn XFixesChangeCursorByName(dpy as *u8, source as i64, name as *u8) as void;
extern "libXfixes.so.3" fn XFixesChangeSaveSet(dpy as *u8, win as i64, mode as i32,
                                               target as i32, map as i32) as void;
extern "libXfixes.so.3" fn XFixesCopyRegion(dpy as *u8, dst as i64, src as i64) as void;
extern "libXfixes.so.3" fn XFixesCreatePointerBarrier(dpy as *u8, w as i64, x1 as i32,
                                                      y1 as i32, x2 as i32, y2 as i32,
                                                      directions as i32, num_devices as i32,
                                                      devices as *u8) as i64;
extern "libXfixes.so.3" fn XFixesCreateRegion(dpy as *u8, rectangles as *u8, nrectangles as i32) as i64;
extern "libXfixes.so.3" fn XFixesCreateRegionFromBitmap(dpy as *u8, bitmap as i64) as i64;
extern "libXfixes.so.3" fn XFixesCreateRegionFromGC(dpy as *u8, gc as *u8) as i64;
extern "libXfixes.so.3" fn XFixesCreateRegionFromPicture(dpy as *u8, picture as i64) as i64;
extern "libXfixes.so.3" fn XFixesCreateRegionFromWindow(dpy as *u8, window as i64, kind as i32) as i64;
extern "libXfixes.so.3" fn XFixesDestroyPointerBarrier(dpy as *u8, b as i64) as void;
extern "libXfixes.so.3" fn XFixesDestroyRegion(dpy as *u8, region as i64) as void;
extern "libXfixes.so.3" fn XFixesExpandRegion(dpy as *u8, dst as i64, src as i64, left as u32,
                                              right as u32, top as u32, bottom as u32) as void;
extern "libXfixes.so.3" fn XFixesFetchRegion(dpy as *u8, region as i64, nrectanglesRet as *u8) as *u8;
extern "libXfixes.so.3" fn XFixesFetchRegionAndBounds(dpy as *u8, region as i64,
                                                      nrectanglesRet as *u8, bounds as *u8) as *u8;
extern "libXfixes.so.3" fn XFixesGetClientDisconnectMode(dpy as *u8) as i32;
extern "libXfixes.so.3" fn XFixesGetCursorImage(dpy as *u8) as *u8;
extern "libXfixes.so.3" fn XFixesGetCursorName(dpy as *u8, cursor as i64, atom as *u8) as *u8;
extern "libXfixes.so.3" fn XFixesHideCursor(dpy as *u8, win as i64) as void;
extern "libXfixes.so.3" fn XFixesIntersectRegion(dpy as *u8, dst as i64, src1 as i64,
                                                 src2 as i64) as void;
extern "libXfixes.so.3" fn XFixesInvertRegion(dpy as *u8, dst as i64, rect as *u8, src as i64) as void;
extern "libXfixes.so.3" fn XFixesQueryExtension(dpy as *u8, event_base_return as *u8,
                                                error_base_return as *u8) as i32;
extern "libXfixes.so.3" fn XFixesQueryVersion(dpy as *u8, major_version_return as *u8,
                                              minor_version_return as *u8) as i32;
extern "libXfixes.so.3" fn XFixesRegionExtents(dpy as *u8, dst as i64, src as i64) as void;
extern "libXfixes.so.3" fn XFixesSelectCursorInput(dpy as *u8, win as i64, eventMask as i64) as void;
extern "libXfixes.so.3" fn XFixesSelectSelectionInput(dpy as *u8, win as i64, selection as i64,
                                                      eventMask as i64) as void;
extern "libXfixes.so.3" fn XFixesSetClientDisconnectMode(dpy as *u8, disconnect_mode as i32) as void;
extern "libXfixes.so.3" fn XFixesSetCursorName(dpy as *u8, cursor as i64, name as *u8) as void;
extern "libXfixes.so.3" fn XFixesSetGCClipRegion(dpy as *u8, gc as *u8, clip_x_origin as i32,
                                                 clip_y_origin as i32, region as i64) as void;
extern "libXfixes.so.3" fn XFixesSetPictureClipRegion(dpy as *u8, picture as i64,
                                                      clip_x_origin as i32,
                                                      clip_y_origin as i32, region as i64) as void;
extern "libXfixes.so.3" fn XFixesSetRegion(dpy as *u8, region as i64, rectangles as *u8,
                                           nrectangles as i32) as void;
extern "libXfixes.so.3" fn XFixesSetWindowShapeRegion(dpy as *u8, win as i64,
                                                      shape_kind as i32, x_off as i32,
                                                      y_off as i32, region as i64) as void;
extern "libXfixes.so.3" fn XFixesShowCursor(dpy as *u8, win as i64) as void;
extern "libXfixes.so.3" fn XFixesSubtractRegion(dpy as *u8, dst as i64, src1 as i64, src2 as i64) as void;
extern "libXfixes.so.3" fn XFixesTranslateRegion(dpy as *u8, region as i64, dx as i32, dy as i32) as void;
extern "libXfixes.so.3" fn XFixesUnionRegion(dpy as *u8, dst as i64, src1 as i64, src2 as i64) as void;
extern "libXfixes.so.3" fn XFixesVersion() as i32;
