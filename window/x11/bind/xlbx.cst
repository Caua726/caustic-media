// window/x11/bind/xlbx.cst — LBX: Low Bandwidth X.
//
// A proxy that compressed the X protocol over a slow link. Removed from the
// server in X11R7, so these three functions talk to something that no longer
// exists on any current system. Bound because the symbols are still exported.

extern "libXext.so.6" fn XLbxGetEventBase(p as *u8) as i32;
extern "libXext.so.6" fn XLbxQueryExtension(dpy as *u8, p as *u8, p2 as *u8, p3 as *u8) as i32;
extern "libXext.so.6" fn XLbxQueryVersion(dpy as *u8, p as *u8, p2 as *u8) as i32;
