// window/x11/bind/bind.cst — the bindings, and nothing but the bindings.
//
// One module per C header, named after the header, so `man XCreateGC` saying
// `#include <X11/Xlib.h>` is the whole answer to where XCreateGC lives:
//
//     use "…/window/x11/bind/bind.cst" as bind;
//     bind.xlib.XCreateGC(d, win, 0, cast(*u8, 0));
//
// That rule invents no taxonomy and needs no judgement call. Splitting Xlib.h's
// 407 functions by domain instead would make "which module is
// XSetClipRectangles in?" a question every user has to ask, and would put a
// routing table in the way of anyone regenerating this from the headers later.
//
// One exception, and it is about risk rather than size: the 33 event structs
// come out of Xlib.h into xevent.cst. They are the hardest part of the binding,
// the part every consumer reads, and the only part where a wrong byte stays
// silent.
//
// This layer exists because ../../window.md asks for two levels — the bindings,
// and the abstraction built on top of them — so that a program driving X11
// itself never writes an `extern` by hand. The abstraction in ../window.cst is
// a client of these files, not of FFI.
//
// Importing all of them costs a binary nothing. The compiler emits a symbol
// import at the call site rather than at the declaration, so a program that
// opens a window and never asks about monitors links libX11 and nothing else,
// with libXrandr absent from DT_NEEDED even though xrandr.cst was compiled.
// That is what makes a hub over every binding safe rather than expensive.
//
// A program can also skip this hub and take one file directly —
// `use ".../bind/xlib.cst" as xlib;` — which is the same escape hatch the rest
// of the library offers, one level lower.

// The protocol's vocabulary. Imports nothing, declares no extern: these are
// wire values, not libX11's, and a backend speaking the socket directly would
// keep this file unchanged.
use "x.cst" as x;

// Xlib.h, in two pieces.
use "xlib.cst" as xlib;
use "xevent.cst" as xevent;

// The rest of libX11, one module per header.
use "xutil.cst" as xutil;           // the conventions: hints, visuals, regions
use "xresource.cst" as xresource;   // the resource database, and Xft.dpi
use "xcms.cst" as xcms;             // device-independent colour
use "xkblib.cst" as xkblib;         // the keyboard, properly
use "xkbgeom.cst" as xkbgeom;       // and its physical shape
use "xlibint.cst" as xlibint;       // the hooks an extension registers through

// The extensions. Each is its own shared object, and each stays out of a
// binary's DT_NEEDED until something reachable from main calls into it.
use "xshm.cst" as xshm;             // MIT-SHM, and the four shm syscalls
use "xrandr.cst" as xrandr;         // where the monitors are
use "xcursor.cst" as xcursor;       // the pointer the user chose
use "xfixes.cst" as xfixes;         // hiding the cursor, watching a selection
use "xinput2.cst" as xinput2;       // raw motion, sub-pixel, per-device
use "xinput.cst" as xinput;         // XI1, which XI2 replaced but did not remove

// The rest of libXext. One shared object, a dozen extensions, and only the
// first two are on any path this library walks — see each file's header.
use "xsync.cst" as xsync;           // counters, alarms, fences: _NET_WM_SYNC_REQUEST
use "xshape.cst" as xshape;         // windows that are not rectangles
use "xdbe.cst" as xdbe;             // server-side double buffering
use "xdpms.cst" as xdpms;           // monitor power level
use "xge.cst" as xge;               // the GenericEvent version query
use "xext.cst" as xext;             // the mechanism every extension registers through
use "xsecurity.cst" as xsecurity;   // trusted and untrusted connections
use "xcup.cst" as xcup;             // colormap utilization
use "xevi.cst" as xevi;             // extended visual information
use "xag.cst" as xag;               // XC-APPGROUP
use "xmultibuf.cst" as xmultibuf;   // the multibuffer extension, superseded by DBE
use "xmitmisc.cst" as xmitmisc;     // one bug-compatibility switch
use "xlbx.cst" as xlbx;             // Low Bandwidth X, gone from the server
use "xtestext1.cst" as xtestext1;   // XTEST1, superseded by libXtst

// Its own shared object, and the one extension a fullscreen program needs.
use "xscrnsaver.cst" as xscrnsaver;  // MIT-SCREEN-SAVER: do not blank on me
