// window/x11/bind/xrandr.cst — Xrandr: where the monitors are.
//
// The core protocol has one idea of a screen and it is the wrong one: a Screen
// is the whole desktop, however many physical displays that spans, and there is
// no way to ask where one of them starts or what refresh rate it runs at. Every
// multi-monitor answer comes from here.
//
// What ../monitors.cst takes from it:
//
//   XRRGetScreenResourcesCurrent   the outputs and CRTCs, without forcing the
//                                  server to re-probe the hardware, which the
//                                  non-Current form does and which takes
//                                  milliseconds
//   XRRGetCrtcInfo                 x, y, width, height of one monitor — the
//                                  bounds a fullscreen window needs
//   XRRGetOutputInfo               the physical size in millimetres, which is
//                                  what DPI is computed from, and the name
//                                  ("HDMI-1") a program shows a user
//   XRRGetOutputPrimary            which one a new window should prefer
//
// Refresh rate is not a field. It is derived: mode.dotClock divided by
// mode.hTotal * mode.vTotal, which is why monitors.cst does that arithmetic
// rather than reading a number.

// --- The structs the server hands back ---
//
// Every one of these is allocated by libXrandr and freed with its matching
// XRRFree* call, so the sizeof here is not for allocating — it is for walking
// the arrays inside them. Offsets from tools/x11_layout.c; ../x11_layout_test.cst
// asserts them.

struct XRRScreenResources {
    timestamp       as i64;    //  0
    configTimestamp as i64;    //  8
    ncrtc           as i32;    // 16
    _pad0           as i32;    // 20
    crtcs           as *u8;    // 24   RRCrtc[ncrtc]
    noutput         as i32;    // 32
    _pad1           as i32;    // 36
    outputs         as *u8;    // 40   RROutput[noutput]
    nmode           as i32;    // 48
    _pad2           as i32;    // 52
    modes           as *u8;    // 56   XRRModeInfo[nmode]
}                              // 64

// One CRTC is one rectangle of the desktop being scanned out. This is where a
// monitor's position and size actually come from — an output with no CRTC is
// connected but not displaying anything.
struct XRRCrtcInfo {
    timestamp as i64;    //  0
    x         as i32;    //  8
    y         as i32;    // 12
    width     as u32;    // 16
    height    as u32;    // 20
    mode      as i64;    // 24
    rotation  as u16;    // 32
    _pad0     as u16;    // 34
    noutput   as i32;    // 36
    outputs   as *u8;    // 40
    rotations as u16;    // 48
    _pad1     as u16;    // 50
    npossible as i32;    // 52
    possible  as *u8;    // 56
}                        // 64

struct XRROutputInfo {
    timestamp      as i64;    //  0
    crtc           as i64;    //  8
    name           as *u8;    // 16   "HDMI-1", not NUL-terminated
    nameLen        as i32;    // 24
    _pad0          as i32;    // 28
    mm_width       as i64;    // 32   physical size, which is where DPI comes from
    mm_height      as i64;    // 40
    connection     as u16;    // 48   0 connected, 1 disconnected, 2 unknown
    subpixel_order as u16;    // 50
    ncrtc          as i32;    // 52
    crtcs          as *u8;    // 56
    nclone         as i32;    // 64
    _pad1          as i32;    // 68
    clones         as *u8;    // 72
    nmode          as i32;    // 80
    npreferred     as i32;    // 84
    modes          as *u8;    // 88
}                             // 96

// Refresh rate is not a field here. It is dotClock / (hTotal * vTotal), which
// is why monitors.cst does that arithmetic instead of reading a number.
struct XRRModeInfo {
    id         as i64;    //  0
    width      as u32;    //  8
    height     as u32;    // 12
    dotClock   as i64;    // 16
    hSyncStart as u32;    // 24
    hSyncEnd   as u32;    // 28
    hTotal     as u32;    // 32
    hSkew      as u32;    // 36
    vSyncStart as u32;    // 40
    vSyncEnd   as u32;    // 44
    vTotal     as u32;    // 48
    _pad0      as u32;    // 52
    name       as *u8;    // 56
    nameLength as u32;    // 64
    _pad1      as u32;    // 68
    modeFlags  as i64;    // 72
}                         // 80

let is u16 as RR_Connected         with imut = cast(u16, 0);
let is u16 as RR_Disconnected      with imut = cast(u16, 1);
let is u16 as RR_UnknownConnection with imut = cast(u16, 2);

