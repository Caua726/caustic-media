// window/x11/bind/xsync.cst — the SYNC extension: counters, alarms and fences.
//
// The largest thing in libXext by a wide margin — 38 of its 132 functions — and
// the only one on this layer's own path.
//
// --- Why a window layer cares ---
//
// `_NET_WM_SYNC_REQUEST` is how a client and a compositor agree on when a
// resized frame is ready. The compositor sends a counter value with the
// configure, the client draws, then sets the counter to that value plus one;
// until it does, the compositor keeps showing the old frame instead of a
// half-drawn one. Without it a resize flickers, and every toolkit that resizes
// smoothly is doing exactly this.
//
// That makes SYNC the piece ../../window.md's pull model is missing on X11:
// `next_frame` currently returns as soon as a buffer is free, which is honest
// but has no idea whether anyone is going to look at the frame.
//
// --- XSyncValue is 64 bits and arrives in a register ---
//
// `typedef struct { int hi; unsigned int lo; } XSyncValue` — eight bytes, and
// the SysV AMD64 ABI classes an eight-byte struct of two integers as INTEGER,
// so it is passed in one general register exactly like an i64. That is why the
// by-value parameters below are i64 rather than a pointer to a struct: it is
// the same machine convention, not a shortcut.
//
// The helpers that pack and unpack it — XSyncIntToValue, XSyncValueLow32 and
// the rest — are real functions in libXext rather than macros, so they are
// bound like everything else.

extern "libXext.so.6" fn XSyncAwait(dpy as *u8, wait_list as *u8, n_conditions as i32) as i32;
extern "libXext.so.6" fn XSyncAwaitFence(dpy as *u8, fence_list as *u8, n_fences as i32) as i32;
extern "libXext.so.6" fn XSyncChangeAlarm(dpy as *u8, alarm as i64, values_mask as i64, values as *u8) as i32;
extern "libXext.so.6" fn XSyncChangeCounter(dpy as *u8, counter as i64, value as i64) as i32;
extern "libXext.so.6" fn XSyncCreateAlarm(dpy as *u8, values_mask as i64, values as *u8) as i64;
extern "libXext.so.6" fn XSyncCreateCounter(dpy as *u8, initial_value as i64) as i64;
extern "libXext.so.6" fn XSyncCreateFence(dpy as *u8, d as i64, initially_triggered as i32) as i64;
extern "libXext.so.6" fn XSyncDestroyAlarm(dpy as *u8, alarm as i64) as i32;
extern "libXext.so.6" fn XSyncDestroyCounter(dpy as *u8, counter as i64) as i32;
extern "libXext.so.6" fn XSyncDestroyFence(dpy as *u8, fence as i64) as i32;
extern "libXext.so.6" fn XSyncFreeSystemCounterList(list as *u8) as void;
extern "libXext.so.6" fn XSyncGetPriority(dpy as *u8, client_resource_id as i64, return_priority as *u8) as i32;
extern "libXext.so.6" fn XSyncInitialize(dpy as *u8, major_version_return as *u8, minor_version_return as *u8) as i32;
extern "libXext.so.6" fn XSyncIntToValue(pv as *u8, i as i32) as void;
extern "libXext.so.6" fn XSyncIntsToValue(pv as *u8, l as u32, h as i32) as void;
extern "libXext.so.6" fn XSyncListSystemCounters(dpy as *u8, n_counters_return as *u8) as *u8;
extern "libXext.so.6" fn XSyncMaxValue(pv as *u8) as void;
extern "libXext.so.6" fn XSyncMinValue(pv as *u8) as void;
extern "libXext.so.6" fn XSyncQueryAlarm(dpy as *u8, alarm as i64, values_return as *u8) as i32;
extern "libXext.so.6" fn XSyncQueryCounter(dpy as *u8, counter as i64, value_return as *u8) as i32;
extern "libXext.so.6" fn XSyncQueryExtension(dpy as *u8, event_base_return as *u8, error_base_return as *u8) as i32;
extern "libXext.so.6" fn XSyncQueryFence(dpy as *u8, fence as i64, triggered as *u8) as i32;
extern "libXext.so.6" fn XSyncResetFence(dpy as *u8, fence as i64) as i32;
extern "libXext.so.6" fn XSyncSetCounter(dpy as *u8, counter as i64, value as i64) as i32;
extern "libXext.so.6" fn XSyncSetPriority(dpy as *u8, client_resource_id as i64, priority as i32) as i32;
extern "libXext.so.6" fn XSyncTriggerFence(dpy as *u8, fence as i64) as i32;
extern "libXext.so.6" fn XSyncValueAdd(presult as *u8, a as i64, b as i64, poverflow as *u8) as void;
extern "libXext.so.6" fn XSyncValueEqual(a as i64, b as i64) as i32;
extern "libXext.so.6" fn XSyncValueGreaterOrEqual(a as i64, b as i64) as i32;
extern "libXext.so.6" fn XSyncValueGreaterThan(a as i64, b as i64) as i32;
extern "libXext.so.6" fn XSyncValueHigh32(v as i64) as i32;
extern "libXext.so.6" fn XSyncValueIsNegative(v as i64) as i32;
extern "libXext.so.6" fn XSyncValueIsPositive(v as i64) as i32;
extern "libXext.so.6" fn XSyncValueIsZero(v as i64) as i32;
extern "libXext.so.6" fn XSyncValueLessOrEqual(a as i64, b as i64) as i32;
extern "libXext.so.6" fn XSyncValueLessThan(a as i64, b as i64) as i32;
extern "libXext.so.6" fn XSyncValueLow32(v as i64) as u32;
extern "libXext.so.6" fn XSyncValueSubtract(presult as *u8, a as i64, b as i64, poverflow as *u8) as void;
