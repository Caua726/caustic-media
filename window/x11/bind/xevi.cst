// window/x11/bind/xevi.cst — EVI: extended visual information.
//
// What a visual costs beyond what XGetVisualInfo says: which visuals share a
// colormap, how many colours a level really has, whether it is transparent.
// Written for overlay planes on hardware that no longer ships.

extern "libXext.so.6" fn XeviGetVisualInfo(dpy as *u8, p as *u8, n as i32, p2 as *u8, p3 as *u8) as i32;
extern "libXext.so.6" fn XeviQueryExtension(dpy as *u8) as i32;
extern "libXext.so.6" fn XeviQueryVersion(dpy as *u8, p as *u8, p2 as *u8) as i32;
