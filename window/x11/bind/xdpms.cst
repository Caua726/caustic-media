// window/x11/bind/xdpms.cst — DPMS: whether the monitor is awake.
//
// Query and force the display power level, and read the standby, suspend and
// off timeouts.
//
// Note what is NOT here: inhibiting the screensaver, which is what a game
// actually wants. That is the MIT-SCREEN-SAVER extension in libXss, a different
// shared object with no binding yet. Forcing DPMS on to keep a screen alive is
// the wrong tool and fights the user's settings.

extern "libXext.so.6" fn DPMSCapable(dpy as *u8) as i32;
extern "libXext.so.6" fn DPMSDisable(dpy as *u8) as i32;
extern "libXext.so.6" fn DPMSEnable(dpy as *u8) as i32;
extern "libXext.so.6" fn DPMSForceLevel(dpy as *u8, level as u16) as i32;
extern "libXext.so.6" fn DPMSGetTimeouts(dpy as *u8, standby as *u8, suspend as *u8, off as *u8) as i32;
extern "libXext.so.6" fn DPMSGetVersion(dpy as *u8, major_version as *u8, minor_version as *u8) as i32;
extern "libXext.so.6" fn DPMSInfo(dpy as *u8, power_level as *u8, state as *u8) as i32;
extern "libXext.so.6" fn DPMSQueryExtension(dpy as *u8, event_base as *u8, error_base as *u8) as i32;
extern "libXext.so.6" fn DPMSSetTimeouts(dpy as *u8, standby as u16, suspend as u16, off as u16) as i32;
