// window/x11/bind/xdbe.cst — DBE: double buffering, on the server's side.
//
// A back buffer that belongs to a window and swaps atomically, so a program
// draws with server-side primitives without tearing.
//
// This library does not need it and is unlikely to: ../surface.cst owns its own
// buffers because it hands out raw pixels for a rasterizer to fill, and MIT-SHM
// is how those reach the server. DBE only helps a program that draws through
// X's own drawing requests. It is bound because "every function each platform
// exposes" is the rule, and because a program driving X11 itself may want it.

extern "libXext.so.6" fn XdbeAllocateBackBufferName(dpy as *u8, window as i64, swap_action as u8) as i64;
extern "libXext.so.6" fn XdbeBeginIdiom(dpy as *u8) as i32;
extern "libXext.so.6" fn XdbeDeallocateBackBufferName(dpy as *u8, buffer as i64) as i32;
extern "libXext.so.6" fn XdbeEndIdiom(dpy as *u8) as i32;
extern "libXext.so.6" fn XdbeFreeVisualInfo(visual_info as *u8) as void;
extern "libXext.so.6" fn XdbeGetBackBufferAttributes(dpy as *u8, buffer as i64) as *u8;
extern "libXext.so.6" fn XdbeGetVisualInfo(dpy as *u8, screen_specifiers as *u8, num_screens as *u8) as *u8;
extern "libXext.so.6" fn XdbeQueryExtension(dpy as *u8, major_version_return as *u8, minor_version_return as *u8) as i32;
extern "libXext.so.6" fn XdbeSwapBuffers(dpy as *u8, swap_info as *u8, num_windows as i32) as i32;
