// window/x11/bind/xlibint.cst — the hooks an extension hangs itself on.
//
// Xlibint.h is libX11's internal header, and almost everything in it is a macro
// or a `_X`-prefixed private symbol that ../tools/symbols.txt deliberately
// excludes. Seventeen exports are neither: the XESet* family, which is the
// documented way an extension library registers itself with a Display, plus one
// locale helper.
//
// Nothing in this directory calls them. They are here because ../../window.md
// asks for every function libX11 exposes, and because a program implementing an
// X extension in Caustic — which is a reasonable thing to want and which this
// binding otherwise makes impossible — needs exactly these.
//
// --- Every one of them is hand-written, and that is not incidental ---
//
// The rest of bind/ was transcribed from prototypes the C compiler produced.
// That does not work here: each XESet* takes a FUNCTION POINTER as its third
// argument, and `gcc -aux-info` flattens the pointed-to function's parameters
// into the outer signature. Asked about XESetErrorString it reports eleven
// parameters where there are three.
//
// An extern with the wrong arity is not a compile error and not a crash. It is
// a call that pushes the wrong number of registers, and on a function that
// returns the previous handler it means the caller stores garbage and installs
// it. So these were read from the header and written out by hand, and the shape
// below is the same for all sixteen:
//
//     <ret> (*XESetXxx(Display*, int extension, <ret> (*proc)(...)))(...)
//
// which is: take a display, an extension number and a callback; return the
// callback that was there before. Three parameters, one result, all pointers
// except the extension number.
//
// The callbacks are *u8 like every other pointer here. A caller builds one with
// fn_ptr() and is responsible for its signature — unchecked, exactly as
// gpu/device.cst's vtable is, and for the same reason: there is no typed
// function pointer to hand across FFI.

// --- Per-display lifecycle ---

extern "libX11.so.6" fn XESetCloseDisplay(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetBeforeFlush(display as *u8, extension as i32, proc as *u8) as *u8;

// --- Graphics context and font lifecycle ---
//
// Called when libX11 creates, copies, flushes or frees the object, so an
// extension can attach and release its own state alongside.

extern "libX11.so.6" fn XESetCreateGC(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetCopyGC(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetFlushGC(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetFreeGC(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetCreateFont(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetFreeFont(display as *u8, extension as i32, proc as *u8) as *u8;

// --- Wire protocol conversion ---
//
// How an extension's events become XEvents and back. WireToEventCookie and
// CopyEventCookie are the XI2-era pair: a cookie event's payload lives in
// libX11's memory until XFreeEventData, which is why anything that stores one
// has to copy it first.

extern "libX11.so.6" fn XESetWireToEvent(display as *u8, event_number as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetEventToWire(display as *u8, event_number as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetWireToEventCookie(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetCopyEventCookie(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetWireToError(display as *u8, error_number as i32, proc as *u8) as *u8;

// --- Errors ---

extern "libX11.so.6" fn XESetError(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetErrorString(display as *u8, extension as i32, proc as *u8) as *u8;
extern "libX11.so.6" fn XESetPrintErrorValues(display as *u8, extension as i32, proc as *u8) as *u8;

// --- Locale ---
//
// Writes the compiled-in locale directory into a caller-provided buffer. The
// odd one out here in every way, including the lowercase name.

extern "libX11.so.6" fn xlocaledir(buf as *u8, buf_len as i32) as void;
