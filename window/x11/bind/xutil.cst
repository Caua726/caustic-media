// window/x11/bind/xutil.cst — Xutil.h: the conventions on top of the protocol.
//
// Xlib.h is the protocol. This is what clients and window managers agreed to do
// with it, and almost none of it is enforced by the server: size hints are a
// request a window manager may ignore, WM_CLASS is a string a taskbar chooses
// to group by, a standard colormap is a convention for sharing one.
//
// The pieces this layer actually depends on:
//
//   XVisualInfo and XGetVisualInfo   how a TrueColor visual is found, and the
//                                    array whose stride is why sizeof has to be
//                                    right
//   XSizeHints and XSetWMNormalHints minimum and maximum size, which is the
//                                    only way to ask a window manager not to
//                                    resize below something
//   XClassHint                       WM_CLASS, what a compositor matches its
//                                    per-application rules against
//   the region calls                 server-side clip regions, which is also
//                                    the shape a compositor wants for damage
//
// The XImage accessors — XGetPixel, XPutPixel, XSubImage, XAddPixel — are
// macros in the header that expand to a call through the image's own function
// table, but libX11 exports each as a real symbol too. Those live in xlib.cst
// beside XDestroyImage, because they are the XImage API rather than a
// convention.

// --- WM_NORMAL_HINTS ---
//
// The flags word of XSizeHints, from Xutil.h. Which of these are set is the
// whole of what a window manager is told about a window's size, and the pair
// that matters most is PMinSize with PMaxSize: declaring them equal is how a
// window says it cannot be resized.
//
// That is not a cosmetic request on a tiling compositor. niri tiles every
// window to whatever its layout says and floats only windows that have a
// parent or are fixed size, so a window that never sets these is not a window
// on screen — it is a tile the size of the monitor. Same for sway, i3 and
// river, by the same rule.
let is i64 as USPosition  with imut = 1;
let is i64 as USSize      with imut = 2;
let is i64 as PPosition   with imut = 4;
let is i64 as PSize       with imut = 8;
let is i64 as PMinSize    with imut = 16;
let is i64 as PMaxSize    with imut = 32;
let is i64 as PResizeInc  with imut = 64;
let is i64 as PAspect     with imut = 128;
let is i64 as PBaseSize   with imut = 256;
let is i64 as PWinGravity with imut = 512;

// The nested aspect-ratio pair. It is the only place in these bindings where a
// field is itself a struct rather than a scalar, which is why it is named
// rather than flattened into two ints: flattening it would put the pads in a
// place the layout test could not describe.
struct XAspect {
    x as i32;
    y as i32;
}

// A long followed by seventeen ints. The long forces nothing after it —
// everything is 4-byte aligned from offset 8 on — so the only pad is the tail
// one that rounds 76 up to C's 80. x11_layout_test.cst pins every offset.
struct XSizeHints {
    flags       as i64;
    x           as i32;
    y           as i32;
    width       as i32;
    height      as i32;
    min_width   as i32;
    min_height  as i32;
    max_width   as i32;
    max_height  as i32;
    width_inc   as i32;
    height_inc  as i32;
    min_aspect  as XAspect;
    max_aspect  as XAspect;
    base_width  as i32;
    base_height as i32;
    win_gravity as i32;
    _pad0       as i32;
}

