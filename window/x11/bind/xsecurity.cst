// window/x11/bind/xsecurity.cst — SECURITY: trusted and untrusted clients.
//
// Generates an authorization token that marks a connection untrusted, so a
// client using it cannot read another client's input or steal its selections.
// This is what `ssh -X` versus `ssh -Y` selects between.

extern "libXext.so.6" fn XSecurityAllocXauth() as *u8;
extern "libXext.so.6" fn XSecurityFreeXauth(p as *u8) as void;
extern "libXext.so.6" fn XSecurityGenerateAuthorization(p as *u8, p2 as *u8, a as i64, p3 as *u8, p4 as *u8) as *u8;
extern "libXext.so.6" fn XSecurityQueryExtension(p as *u8, p2 as *u8, p3 as *u8) as i32;
extern "libXext.so.6" fn XSecurityRevokeAuthorization(p as *u8, a as i64) as i32;
