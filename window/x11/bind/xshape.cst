// window/x11/bind/xshape.cst — SHAPE: windows that are not rectangles.
//
// A window's visible region and its input region become arbitrary: rounded
// corners without a compositor, a splash screen with a hole in it, a click
// through region. The server does the clipping, so nothing above has to know.
//
// Two regions per window and they are independent. ShapeBounding is what is
// drawn; ShapeInput is what the pointer can hit. Setting only the first gives a
// window with invisible edges that still swallow clicks, which is the mistake
// this extension is famous for.

extern "libXext.so.6" fn XShapeCombineMask(dpy as *u8, dest as i64, dest_kind as i32, x_off as i32, y_off as i32, src as i64, op as i32) as void;
extern "libXext.so.6" fn XShapeCombineRectangles(dpy as *u8, dest as i64, dest_kind as i32, x_off as i32, y_off as i32, rectangles as *u8, n_rects as i32, op as i32, ordering as i32) as void;
extern "libXext.so.6" fn XShapeCombineRegion(dpy as *u8, dest as i64, dest_kind as i32, x_off as i32, y_off as i32, region as *u8, op as i32) as void;
extern "libXext.so.6" fn XShapeCombineShape(dpy as *u8, dest as i64, dest_kind as i32, x_off as i32, y_off as i32, src as i64, src_kind as i32, op as i32) as void;
extern "libXext.so.6" fn XShapeGetRectangles(dpy as *u8, window as i64, kind as i32, count as *u8, ordering as *u8) as *u8;
extern "libXext.so.6" fn XShapeInputSelected(dpy as *u8, window as i64) as i64;
extern "libXext.so.6" fn XShapeOffsetShape(dpy as *u8, dest as i64, dest_kind as i32, x_off as i32, y_off as i32) as void;
extern "libXext.so.6" fn XShapeQueryExtension(dpy as *u8, event_base as *u8, error_base as *u8) as i32;
extern "libXext.so.6" fn XShapeQueryExtents(dpy as *u8, window as i64, bounding_shaped as *u8, x_bounding as *u8, y_bounding as *u8, w_bounding as *u8, h_bounding as *u8, clip_shaped as *u8, x_clip as *u8, y_clip as *u8, w_clip as *u8, h_clip as *u8) as i32;
extern "libXext.so.6" fn XShapeQueryVersion(dpy as *u8, major_version as *u8, minor_version as *u8) as i32;
extern "libXext.so.6" fn XShapeSelectInput(dpy as *u8, window as i64, mask as i64) as void;
