// window/x11/bind/xinput.cst — XInput 1, which XI2 replaced but did not remove.
//
// libXi ships two protocols. XI2 is in xinput2.cst and is what anything written
// today should use. This is XI1: the 1994 extension for graphics tablets and
// dial boxes, where a device is opened like a file, events are allocated event
// types at runtime, and there is no device hierarchy.
//
// Nothing in this directory calls any of it, and nothing should. It is bound
// because ../../window.md asks for every function these libraries expose, and
// because a program maintaining something old is exactly the caller who would
// otherwise have to write 44 externs by hand.
//
// One module per C header is the rule, and XI1 lives in XInput.h while XI2
// lives in XInput2.h — so they are two files even though they are one shared
// object.

extern "libXi.so.6" fn XAllowDeviceEvents(display as *u8, device as *u8, event_mode as i32,
                                          time as i64) as i32;
extern "libXi.so.6" fn XChangeDeviceControl(display as *u8, device as *u8, control as i32,
                                            d as *u8) as i32;
extern "libXi.so.6" fn XChangeDeviceDontPropagateList(display as *u8, window as i64,
                                                      count as i32, events as *u8, mode as i32) as i32;
extern "libXi.so.6" fn XChangeDeviceKeyMapping(display as *u8, device as *u8, first as i32,
                                               syms_per_code as i32, keysyms as *u8,
                                               count as i32) as i32;
extern "libXi.so.6" fn XChangeDeviceProperty(dpy as *u8, dev as *u8, property as i64,
                                             type_ as i64, format as i32, mode as i32,
                                             data as *u8, nelements as i32) as void;
extern "libXi.so.6" fn XChangeFeedbackControl(display as *u8, device as *u8, mask as i64,
                                              f as *u8) as i32;
extern "libXi.so.6" fn XChangeKeyboardDevice(display as *u8, device as *u8) as i32;
extern "libXi.so.6" fn XChangePointerDevice(display as *u8, device as *u8, xaxis as i32,
                                            yaxis as i32) as i32;
extern "libXi.so.6" fn XCloseDevice(display as *u8, device as *u8) as i32;
extern "libXi.so.6" fn XDeleteDeviceProperty(dpy as *u8, dev as *u8, property as i64) as void;
extern "libXi.so.6" fn XDeviceBell(display as *u8, device as *u8, feedbackclass as i64,
                                   feedbackid as i64, percent as i32) as i32;
extern "libXi.so.6" fn XFreeDeviceControl(control as *u8) as void;
extern "libXi.so.6" fn XFreeDeviceList(list as *u8) as void;
extern "libXi.so.6" fn XFreeDeviceMotionEvents(events as *u8) as void;
extern "libXi.so.6" fn XFreeDeviceState(list as *u8) as void;
extern "libXi.so.6" fn XFreeFeedbackList(list as *u8) as void;
extern "libXi.so.6" fn XGetDeviceButtonMapping(display as *u8, device as *u8, nmap as *u8,
                                               a3 as u32) as i32;
extern "libXi.so.6" fn XGetDeviceControl(display as *u8, device as *u8, control as i32) as *u8;
extern "libXi.so.6" fn XGetDeviceDontPropagateList(display as *u8, window as i64, count as *u8) as *u8;
extern "libXi.so.6" fn XGetDeviceFocus(display as *u8, device as *u8, focus as *u8,
                                       revert_to as *u8, time as *u8) as i32;
extern "libXi.so.6" fn XGetDeviceKeyMapping(display as *u8, device as *u8, first as u8,
                                            first as i32, keycount as *u8) as *u8;
extern "libXi.so.6" fn XGetDeviceModifierMapping(display as *u8, device as *u8) as *u8;
extern "libXi.so.6" fn XGetDeviceMotionEvents(display as *u8, device as *u8, start as i64,
                                              stop as i64, nEvents as *u8, mode as *u8,
                                              axis_count as *u8) as *u8;
extern "libXi.so.6" fn XGetDeviceProperty(dpy as *u8, dev as *u8, property as i64,
                                          offset as i64, length as i64, delete as i32,
                                          req_type as i64, actual_type as *u8,
                                          actual_format as *u8, nitems as *u8,
                                          bytes_after as *u8, prop as *u8) as i32;
extern "libXi.so.6" fn XGetExtensionVersion(display as *u8, name as *u8) as *u8;
extern "libXi.so.6" fn XGetFeedbackControl(display as *u8, device as *u8, num_feedbacks as *u8) as *u8;
extern "libXi.so.6" fn XGetSelectedExtensionEvents(display as *u8, w as i64,
                                                   this_client_count as *u8,
                                                   this_client_list as *u8,
                                                   all_clients_count as *u8,
                                                   all_clients_list as *u8) as i32;
extern "libXi.so.6" fn XGrabDevice(display as *u8, device as *u8, grab_window as i64,
                                   ownerEvents as i32, event_list as i32,
                                   this_device_mode as *u8, other_devices_mode as i32,
                                   time as i32, a8 as i64) as i32;
extern "libXi.so.6" fn XGrabDeviceButton(display as *u8, device as *u8, button as u32,
                                         modifiers as u32, modifier_device as *u8,
                                         grab_window as i64, owner_events as i32,
                                         event_count as u32, event_list as *u8,
                                         this_device_mode as i32, other_devices_mode as i32) as i32;
extern "libXi.so.6" fn XGrabDeviceKey(display as *u8, device as *u8, key as u32,
                                      modifiers as u32, modifier_device as *u8,
                                      grab_window as i64, owner_events as i32,
                                      event_count as u32, event_list as *u8,
                                      this_device_mode as i32, other_devices_mode as i32) as i32;
extern "libXi.so.6" fn XListDeviceProperties(dpy as *u8, dev as *u8, nprops_return as *u8) as *u8;
extern "libXi.so.6" fn XListInputDevices(display as *u8, ndevices as *u8) as *u8;
extern "libXi.so.6" fn XOpenDevice(display as *u8, id as i64) as *u8;
extern "libXi.so.6" fn XQueryDeviceState(display as *u8, device as *u8) as *u8;
extern "libXi.so.6" fn XSelectExtensionEvent(display as *u8, w as i64, event_list as *u8,
                                             count as i32) as i32;
extern "libXi.so.6" fn XSendExtensionEvent(display as *u8, device as *u8, dest as i64,
                                           prop as i32, count as i32, list as *u8, event as *u8) as i32;
extern "libXi.so.6" fn XSetDeviceButtonMapping(display as *u8, device as *u8, nmap as *u8,
                                               a3 as i32) as i32;
extern "libXi.so.6" fn XSetDeviceFocus(display as *u8, device as *u8, focus as i64,
                                       revert_to as i32, time as i64) as i32;
extern "libXi.so.6" fn XSetDeviceMode(display as *u8, device as *u8, mode as i32) as i32;
extern "libXi.so.6" fn XSetDeviceModifierMapping(display as *u8, device as *u8, modmap as *u8) as i32;
extern "libXi.so.6" fn XSetDeviceValuators(display as *u8, device as *u8, valuators as *u8,
                                           first_valuator as i32, num_valuators as i32) as i32;
extern "libXi.so.6" fn XUngrabDevice(display as *u8, device as *u8, time as i64) as i32;
extern "libXi.so.6" fn XUngrabDeviceButton(display as *u8, device as *u8, button as u32,
                                           modifiers as u32, modifier_dev as *u8,
                                           grab_window as i64) as i32;
