// window/x11/bind/xag.cst — XC-APPGROUP: windows that belong to another client.
//
// Built for the security extension and for embedding: a group whose members a
// proxy can reparent and control. XagGetApplicationGroupAttributes is variadic,
// so it follows the same rule the eleven variadic functions in xlib.cst do —
// fixed arity, callers pass 0 for the tail, the callee stops at the first null.

extern "libXext.so.6" fn XagCreateAssociation(dpy as *u8, p as *u8, p2 as *u8) as i32;
extern "libXext.so.6" fn XagCreateEmbeddedApplicationGroup(dpy as *u8, visualid as i64, a as i64, mask as i64, mask2 as i64, p as *u8) as i32;
extern "libXext.so.6" fn XagCreateNonembeddedApplicationGroup(dpy as *u8, p as *u8) as i32;
extern "libXext.so.6" fn XagDestroyApplicationGroup(dpy as *u8, app_group as i64) as i32;
extern "libXext.so.6" fn XagDestroyAssociation(dpy as *u8, w as i64) as i32;
extern "libXext.so.6" fn XagGetApplicationGroupAttributes(dpy as *u8, app_group as i64, v0 as *u8, v1 as *u8, v2 as *u8, v3 as *u8, v4 as *u8, v5 as *u8, v6 as *u8, v7 as *u8) as i32;
extern "libXext.so.6" fn XagQueryApplicationGroup(dpy as *u8, a as i64, p as *u8) as i32;
extern "libXext.so.6" fn XagQueryVersion(dpy as *u8, p as *u8, p2 as *u8) as i32;
