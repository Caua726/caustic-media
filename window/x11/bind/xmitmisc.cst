// window/x11/bind/xmitmisc.cst — MIT-MISC: one bug-compatibility switch.
//
// Toggles whether the server tolerates a class of malformed request that
// pre-R4 clients sent. Three functions, and there has been nothing to be
// compatible with for thirty years.

extern "libXext.so.6" fn XMITMiscGetBugMode(dpy as *u8) as i32;
extern "libXext.so.6" fn XMITMiscQueryExtension(dpy as *u8, p as *u8, p2 as *u8) as i32;
extern "libXext.so.6" fn XMITMiscSetBugMode(dpy as *u8, n as i32) as i32;
