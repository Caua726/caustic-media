// window/x11/bind/xtestext1.cst — XTEST1, the first testing extension.
//
// Record and replay input at the server. Superseded by XTEST, which lives in
// libXtst rather than here, and kept alive only because removing an exported
// symbol from a shared object breaks whatever still links it.
//
// Bound for completeness. A program that wants synthetic input today wants
// XTestFakeInput from libXtst.

extern "libXext.so.6" fn XTestFakeInput(p as *u8, p2 as *u8, a as i64, a2 as i64) as i32;
extern "libXext.so.6" fn XTestFlush(p as *u8) as i32;
extern "libXext.so.6" fn XTestGetInput(p as *u8, a as i64) as i32;
extern "libXext.so.6" fn XTestMovePointer(p as *u8, a as i64, a2 as i64, a3 as i64, a4 as i64, a5 as i64) as i32;
extern "libXext.so.6" fn XTestPressButton(p as *u8, a as i64, a2 as i64, a3 as i64, a4 as i64) as i32;
extern "libXext.so.6" fn XTestPressKey(p as *u8, a as i64, a2 as i64, a3 as i64, a4 as i64) as i32;
extern "libXext.so.6" fn XTestQueryInputSize(p as *u8, p2 as *u8) as i32;
extern "libXext.so.6" fn XTestReset(p as *u8) as i32;
extern "libXext.so.6" fn XTestStopInput(p as *u8) as i32;
