// window/x11/bind/xresource.cst — Xresource.h: where ~/.Xresources ends up.
//
// The X resource manager is a small hierarchical database of strings that
// clients read their defaults out of. It predates every configuration format in
// use today and it is still how a running X session answers one question this
// layer needs:
//
//     Xft.dpi
//
// which is the scaling factor a desktop environment sets and which
// XResourceManagerString delivers as text for XrmGetStringDatabase to parse.
// Without it a window layer has to infer scale from physical screen dimensions,
// and monitors lie about those.
//
// The rest — XrmPutResource, the option-table parser, the merge functions — is
// how an application would implement `-geometry` and `-display` the way X
// programs did in 1990. Bound for completeness, not because anything here calls
// it.

extern "libX11.so.6" fn Xpermalloc(size as u32) as *u8;
extern "libX11.so.6" fn XrmCombineDatabase(source_db as *u8, target_db as *u8, override as i32) as void;
extern "libX11.so.6" fn XrmCombineFileDatabase(filename as *u8, target as *u8, override as i32) as i32;
extern "libX11.so.6" fn XrmDestroyDatabase(database as *u8) as void;
extern "libX11.so.6" fn XrmEnumerateDatabase(db as *u8, name_prefix as *u8,
                                             class_prefix as *u8, mode as i32, db as *u8,
                                             bindings as *u8, quarks as *u8, type_ as *u8,
                                             value as *u8, closure as *u8, proc as *u8) as i32;
extern "libX11.so.6" fn XrmGetDatabase(display as *u8) as *u8;
extern "libX11.so.6" fn XrmGetFileDatabase(filename as *u8) as *u8;
extern "libX11.so.6" fn XrmGetResource(database as *u8, str_name as *u8, str_class as *u8,
                                       str_type_return as *u8, value_return as *u8) as i32;
extern "libX11.so.6" fn XrmGetStringDatabase(data as *u8) as *u8;
extern "libX11.so.6" fn XrmLocaleOfDatabase(database as *u8) as *u8;
extern "libX11.so.6" fn XrmMergeDatabases(source_db as *u8, target_db as *u8) as void;
extern "libX11.so.6" fn XrmParseCommand(database as *u8, table as *u8, table_count as i32,
                                        name as *u8, argc_in_out as *u8, argv_in_out as *u8) as void;
extern "libX11.so.6" fn XrmPermStringToQuark(string as *u8) as *u8;
extern "libX11.so.6" fn XrmPutFileDatabase(database as *u8, filename as *u8) as void;
extern "libX11.so.6" fn XrmPutLineResource(database as *u8, line as *u8) as void;
extern "libX11.so.6" fn XrmPutResource(database as *u8, specifier as *u8, type_ as *u8,
                                       value as *u8) as void;
extern "libX11.so.6" fn XrmPutStringResource(database as *u8, specifier as *u8, value as *u8) as void;
extern "libX11.so.6" fn XrmQGetResource(database as *u8, quark_name as *u8, quark_class as *u8,
                                        quark_type_return as *u8, value_return as *u8) as i32;
extern "libX11.so.6" fn XrmQGetSearchList(database as *u8, names as *u8, classes as *u8,
                                          list_return as *u8, list_length as i32) as i32;
extern "libX11.so.6" fn XrmQGetSearchResource(list as *u8, name as *u8, class as *u8,
                                              type_return as *u8, value_return as *u8) as i32;
extern "libX11.so.6" fn XrmQPutResource(database as *u8, bindings as *u8, quarks as *u8,
                                        type_ as *u8, value as *u8) as void;
extern "libX11.so.6" fn XrmQPutStringResource(database as *u8, bindings as *u8, quarks as *u8,
                                              value as *u8) as void;
extern "libX11.so.6" fn XrmQuarkToString(quark as *u8) as *u8;
extern "libX11.so.6" fn XrmSetDatabase(display as *u8, database as *u8) as void;
extern "libX11.so.6" fn XrmStringToBindingQuarkList(string as *u8, bindings_return as *u8,
                                                    quarks_return as *u8) as void;
extern "libX11.so.6" fn XrmStringToQuark(string as *u8) as *u8;
extern "libX11.so.6" fn XrmStringToQuarkList(string as *u8, quarks_return as *u8) as void;
extern "libX11.so.6" fn XrmUniqueQuark() as *u8;
