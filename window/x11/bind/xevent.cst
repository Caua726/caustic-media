// window/x11/bind/xevent.cst — the union Caustic does not have.
//
// XEvent is a C union of 33 event structs sharing a common header. Caustic has
// no unions, so the union is spelled as what it physically is: storage the size
// of the largest member, plus one pointer cast per member. The cast IS the
// union — no copy, no discriminated wrapper, no 33-way struct that would be the
// same bytes with more ceremony.
//
// Every struct here is byte-identical to its C counterpart. Caustic structs are
// packed and C structs are not, so wherever the C ABI inserts alignment padding
// there is an explicit _padN field. Those are not decoration. Drop the pad after
// XConfigureEvent.border_width and `above` lands at 68 instead of 72: a resize
// reads the wrong Window, and nothing says a word. That failure has no
// diagnostic and no crash — it is the same class as the interleaved banding
// recorded in ../../window.md, which took XGetImage on our own window to find
// after two wrong guesses.
//
// So the offsets in the comments are not counted by hand. tools/x11_layout.c
// asks the C compiler that built this machine's libX11, its output is committed
// as tools/layout.txt, and ../x11_layout_test.cst asserts every sizeof and every
// field position in this file against it. A wrong pad is a failed test rather
// than a corrupted frame.
//
// Why this file is separate from xlib.cst, when the rule elsewhere is one module
// per C header and these come from Xlib.h: not size, risk. This is the hardest
// thing in the whole binding, it is the file every consumer reads, and it is the
// one place a wrong byte stays silent.
//
// Two renames, and only two in the entire binding:
//   `type` -> `kind`     C's field name is a Caustic keyword.
//   `new`  -> `is_new`   Xlib itself renames it to c_new under __cplusplus, so
//                        there is no single spelling to be faithful to.
//
// This file declares no extern and imports nothing. It costs a binary nothing
// until a call site somewhere reaches libX11.

// --- The common header ---
//
// Every member below repeats these five fields rather than embedding a shared
// struct, because C repeats them too: the union overlays whole structs, not a
// header plus a tail. Embedding would be the same bytes and one more name to
// resolve at every use.

struct XAnyEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    window     as i64;    // 32
}                         // 40

// --- Pointer and keyboard ---

struct XKeyEvent {
    kind        as i32;   //  0
    _pad0       as i32;   //  4
    serial      as i64;   //  8
    send_event  as i32;   // 16
    _pad1       as i32;   // 20
    display     as *u8;   // 24
    window      as i64;   // 32
    root        as i64;   // 40
    subwindow   as i64;   // 48
    time        as i64;   // 56
    x           as i32;   // 64
    y           as i32;   // 68
    x_root      as i32;   // 72
    y_root      as i32;   // 76
    state       as u32;   // 80
    keycode     as u32;   // 84
    same_screen as i32;   // 88
    _pad2       as i32;   // 92
}                         // 96

// Identical to XKeyEvent except that the detail field is a button number. The
// two are separate structs in C and stay separate here, so `button` and
// `keycode` never get read through the wrong name.
struct XButtonEvent {
    kind        as i32;   //  0
    _pad0       as i32;   //  4
    serial      as i64;   //  8
    send_event  as i32;   // 16
    _pad1       as i32;   // 20
    display     as *u8;   // 24
    window      as i64;   // 32
    root        as i64;   // 40
    subwindow   as i64;   // 48
    time        as i64;   // 56
    x           as i32;   // 64
    y           as i32;   // 68
    x_root      as i32;   // 72
    y_root      as i32;   // 76
    state       as u32;   // 80
    button      as u32;   // 84
    same_screen as i32;   // 88
    _pad2       as i32;   // 92
}                         // 96

// is_hint is a `char` in C, not an int — the one member of this family that
// breaks the pattern, and the reason same_screen still lands at 88.
struct XMotionEvent {
    kind        as i32;    //  0
    _pad0       as i32;    //  4
    serial      as i64;    //  8
    send_event  as i32;    // 16
    _pad1       as i32;    // 20
    display     as *u8;    // 24
    window      as i64;    // 32
    root        as i64;    // 40
    subwindow   as i64;    // 48
    time        as i64;    // 56
    x           as i32;    // 64
    y           as i32;    // 68
    x_root      as i32;    // 72
    y_root      as i32;    // 76
    state       as u32;    // 80
    is_hint     as u8;     // 84
    _pad2       as [3]u8;  // 85
    same_screen as i32;    // 88
    _pad3       as i32;    // 92
}                          // 96

struct XCrossingEvent {
    kind        as i32;   //  0
    _pad0       as i32;   //  4
    serial      as i64;   //  8
    send_event  as i32;   // 16
    _pad1       as i32;   // 20
    display     as *u8;   // 24
    window      as i64;   // 32
    root        as i64;   // 40
    subwindow   as i64;   // 48
    time        as i64;   // 56
    x           as i32;   // 64
    y           as i32;   // 68
    x_root      as i32;   // 72
    y_root      as i32;   // 76
    mode        as i32;   // 80
    detail      as i32;   // 84
    same_screen as i32;   // 88
    focus       as i32;   // 92
    state       as u32;   // 96
    _pad2       as i32;   // 100
}                         // 104

struct XFocusChangeEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    window     as i64;    // 32
    mode       as i32;    // 40
    detail     as i32;    // 44
}                         // 48

// key_vector is a 32-byte bitmap, one bit per keycode: the whole keyboard state
// at the moment focus or the pointer entered.
struct XKeymapEvent {
    kind       as i32;     //  0
    _pad0      as i32;     //  4
    serial     as i64;     //  8
    send_event as i32;     // 16
    _pad1      as i32;     // 20
    display    as *u8;     // 24
    window     as i64;     // 32
    key_vector as [32]u8;  // 40
}                          // 72

// --- Exposure ---

struct XExposeEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    window     as i64;    // 32
    x          as i32;    // 40
    y          as i32;    // 44
    width      as i32;    // 48
    height     as i32;    // 52
    count      as i32;    // 56
    _pad2      as i32;    // 60
}                         // 64

struct XGraphicsExposeEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    drawable   as i64;    // 32
    x          as i32;    // 40
    y          as i32;    // 44
    width      as i32;    // 48
    height     as i32;    // 52
    count      as i32;    // 56
    major_code as i32;    // 60
    minor_code as i32;    // 64
    _pad2      as i32;    // 68
}                         // 72

struct XNoExposeEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    drawable   as i64;    // 32
    major_code as i32;    // 40
    minor_code as i32;    // 44
}                         // 48

struct XVisibilityEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    window     as i64;    // 32
    state      as i32;    // 40
    _pad2      as i32;    // 44
}                         // 48

// --- Structure notify ---

struct XCreateWindowEvent {
    kind              as i32;    //  0
    _pad0             as i32;    //  4
    serial            as i64;    //  8
    send_event        as i32;    // 16
    _pad1             as i32;    // 20
    display           as *u8;    // 24
    parent            as i64;    // 32
    window            as i64;    // 40
    x                 as i32;    // 48
    y                 as i32;    // 52
    width             as i32;    // 56
    height            as i32;    // 60
    border_width      as i32;    // 64
    override_redirect as i32;    // 68
}                                // 72

struct XDestroyWindowEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    event      as i64;    // 32
    window     as i64;    // 40
}                         // 48

struct XUnmapEvent {
    kind           as i32;    //  0
    _pad0          as i32;    //  4
    serial         as i64;    //  8
    send_event     as i32;    // 16
    _pad1          as i32;    // 20
    display        as *u8;    // 24
    event          as i64;    // 32
    window         as i64;    // 40
    from_configure as i32;    // 48
    _pad2          as i32;    // 52
}                             // 56

struct XMapEvent {
    kind              as i32;    //  0
    _pad0             as i32;    //  4
    serial            as i64;    //  8
    send_event        as i32;    // 16
    _pad1             as i32;    // 20
    display           as *u8;    // 24
    event             as i64;    // 32
    window            as i64;    // 40
    override_redirect as i32;    // 48
