}                                // 56

struct XMapRequestEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    parent     as i64;    // 32
    window     as i64;    // 40
}                         // 48

struct XReparentEvent {
    kind              as i32;    //  0
    _pad0             as i32;    //  4
    serial            as i64;    //  8
    send_event        as i32;    // 16
    _pad1             as i32;    // 20
    display           as *u8;    // 24
    event             as i64;    // 32
    window            as i64;    // 40
    parent            as i64;    // 48
    x                 as i32;    // 56
    y                 as i32;    // 60
    override_redirect as i32;    // 64
    _pad2             as i32;    // 68
}                                // 72

// The one the window layer lives on: width and height here are what a resize
// reads, and `above` at 72 is what _pad2 protects. Getting this wrong is how
// the backend used to write past the end of its own mapping every frame.
struct XConfigureEvent {
    kind              as i32;    //  0
    _pad0             as i32;    //  4
    serial            as i64;    //  8
    send_event        as i32;    // 16
    _pad1             as i32;    // 20
    display           as *u8;    // 24
    event             as i64;    // 32
    window            as i64;    // 40
    x                 as i32;    // 48
    y                 as i32;    // 52
    width             as i32;    // 56
    height            as i32;    // 60
    border_width      as i32;    // 64
    _pad2             as i32;    // 68
    above             as i64;    // 72
    override_redirect as i32;    // 80
    _pad3             as i32;    // 84
}                                // 88

struct XGravityEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    event      as i64;    // 32
    window     as i64;    // 40
    x          as i32;    // 48
    y          as i32;    // 52
}                         // 56

struct XResizeRequestEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    window     as i64;    // 32
    width      as i32;    // 40
    height     as i32;    // 44
}                         // 48

struct XConfigureRequestEvent {
    kind         as i32;    //  0
    _pad0        as i32;    //  4
    serial       as i64;    //  8
    send_event   as i32;    // 16
    _pad1        as i32;    // 20
    display      as *u8;    // 24
    parent       as i64;    // 32
    window       as i64;    // 40
    x            as i32;    // 48
    y            as i32;    // 52
    width        as i32;    // 56
    height       as i32;    // 60
    border_width as i32;    // 64
    _pad2        as i32;    // 68
    above        as i64;    // 72
    detail       as i32;    // 80
    _pad3        as i32;    // 84
    value_mask   as i64;    // 88
}                           // 96

struct XCirculateEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    event      as i64;    // 32
    window     as i64;    // 40
    place      as i32;    // 48
    _pad2      as i32;    // 52
}                         // 56

struct XCirculateRequestEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    parent     as i64;    // 32
    window     as i64;    // 40
    place      as i32;    // 48
    _pad2      as i32;    // 52
}                         // 56

// --- Properties and selections ---

struct XPropertyEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    window     as i64;    // 32
    atom       as i64;    // 40
    time       as i64;    // 48
    state      as i32;    // 56
    _pad2      as i32;    // 60
}                         // 64

struct XSelectionClearEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    window     as i64;    // 32
    selection  as i64;    // 40
    time       as i64;    // 48
}                         // 56

// The clipboard depends on every field of this being right. A SelectionRequest
// this program fails to answer hangs the client that sent it, not this one —
// which is why the pump services it before the ring ever sees it.
struct XSelectionRequestEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    owner      as i64;    // 32
    requestor  as i64;    // 40
    selection  as i64;    // 48
    target     as i64;    // 56
    property   as i64;    // 64
    time       as i64;    // 72
}                         // 80

struct XSelectionEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    requestor  as i64;    // 32
    selection  as i64;    // 40
    target     as i64;    // 48
    property   as i64;    // 56
    time       as i64;    // 64
}                         // 72

struct XColormapEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    window     as i64;    // 32
    colormap   as i64;    // 40
    is_new     as i32;    // 48   `new` in C
    state      as i32;    // 52
}                         // 56

// data is a union of char[20] / short[10] / long[5]. The long forces 8-byte
// alignment, so it occupies 40 bytes rather than the 20 the char array
// suggests. WM_DELETE_WINDOW arrives as an Atom in data[0].
struct XClientMessageEvent {
    kind         as i32;      //  0
    _pad0        as i32;      //  4
    serial       as i64;      //  8
    send_event   as i32;      // 16
    _pad1        as i32;      // 20
    display      as *u8;      // 24
    window       as i64;      // 32
    message_type as i64;      // 40
    format       as i32;      // 48
    _pad2        as i32;      // 52
    data         as [5]i64;   // 56
}                             // 96

struct XMappingEvent {
    kind          as i32;    //  0
    _pad0         as i32;    //  4
    serial        as i64;    //  8
    send_event    as i32;    // 16
    _pad1         as i32;    // 20
    display       as *u8;    // 24
    window        as i64;    // 32
    request       as i32;    // 40
    first_keycode as i32;    // 44
    count         as i32;    // 48
    _pad2         as i32;    // 52
}                            // 56

// The odd one out, and the reason the common header cannot be shared: no
// send_event, display comes second, and the three codes at the tail are
// unsigned chars rather than ints. Reading this one as an XAnyEvent gives
// nonsense for everything after `kind`.
struct XErrorEvent {
    kind         as i32;     //  0
    _pad0        as i32;     //  4
    display      as *u8;     //  8
    resourceid   as i64;     // 16
    serial       as i64;     // 24
    error_code   as u8;      // 32
    request_code as u8;      // 33
    minor_code   as u8;      // 34
    _pad1        as [5]u8;   // 35
}                            // 40

// --- Generic events, which is how every extension since XI2 arrives ---

struct XGenericEvent {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    extension  as i32;    // 32   major opcode of the extension
    evtype     as i32;    // 36
}                         // 40

// `data` points into libX11's own memory and XFreeEventData invalidates it.
// Storing this struct in a queue and reading the payload a frame later is a
// use-after-free, which is why the pump copies the payload into its own slot
// before the event reaches the ring.
struct XGenericEventCookie {
    kind       as i32;    //  0
    _pad0      as i32;    //  4
    serial     as i64;    //  8
    send_event as i32;    // 16
    _pad1      as i32;    // 20
    display    as *u8;    // 24
    extension  as i32;    // 32
    evtype     as i32;    // 36
    cookie     as u32;    // 40
    _pad2      as i32;    // 44
    data       as *u8;    // 48
}                         // 56

// --- The union's storage ---
//
// Xlib declares `long pad[24]` as the last member, so 192 bytes is what every
// XEvent-taking function expects whichever member is actually live. Declaring
// it as the array rather than as the largest struct is deliberate: it says
// "opaque storage of a fixed size", which is what it is, and it does not
// pretend one member is privileged.

struct XEvent { pad as [24]i64; }

// --- Reading it ---
//
// The discriminator first, then one view per member. Every view is a cast, so
// none of them copies and none of them can fail. Reading key(e).keycode on an
// event whose kind is not KeyPress or KeyRelease returns whatever the live
// member happens to have at offset 84 — exactly as it would in C. The kind
// check belongs to the caller, and every caller in this directory makes it.

fn kind(e as *XEvent) as i32 { return cast(*XAnyEvent, e).kind; }

fn any(e as *XEvent) as *XAnyEvent                             { return cast(*XAnyEvent, e); }
fn key(e as *XEvent) as *XKeyEvent                             { return cast(*XKeyEvent, e); }
fn button(e as *XEvent) as *XButtonEvent                       { return cast(*XButtonEvent, e); }
fn motion(e as *XEvent) as *XMotionEvent                       { return cast(*XMotionEvent, e); }
fn crossing(e as *XEvent) as *XCrossingEvent                   { return cast(*XCrossingEvent, e); }
fn focus(e as *XEvent) as *XFocusChangeEvent                   { return cast(*XFocusChangeEvent, e); }
fn keymap(e as *XEvent) as *XKeymapEvent                       { return cast(*XKeymapEvent, e); }
fn expose(e as *XEvent) as *XExposeEvent                       { return cast(*XExposeEvent, e); }
fn graphics_expose(e as *XEvent) as *XGraphicsExposeEvent      { return cast(*XGraphicsExposeEvent, e); }
fn no_expose(e as *XEvent) as *XNoExposeEvent                  { return cast(*XNoExposeEvent, e); }
fn visibility(e as *XEvent) as *XVisibilityEvent               { return cast(*XVisibilityEvent, e); }
fn create_window(e as *XEvent) as *XCreateWindowEvent          { return cast(*XCreateWindowEvent, e); }
fn destroy_window(e as *XEvent) as *XDestroyWindowEvent        { return cast(*XDestroyWindowEvent, e); }
fn unmap(e as *XEvent) as *XUnmapEvent                         { return cast(*XUnmapEvent, e); }
fn map(e as *XEvent) as *XMapEvent                             { return cast(*XMapEvent, e); }
fn map_request(e as *XEvent) as *XMapRequestEvent              { return cast(*XMapRequestEvent, e); }
fn reparent(e as *XEvent) as *XReparentEvent                   { return cast(*XReparentEvent, e); }
fn configure(e as *XEvent) as *XConfigureEvent                 { return cast(*XConfigureEvent, e); }
fn gravity(e as *XEvent) as *XGravityEvent                     { return cast(*XGravityEvent, e); }
fn resize_request(e as *XEvent) as *XResizeRequestEvent        { return cast(*XResizeRequestEvent, e); }
fn configure_request(e as *XEvent) as *XConfigureRequestEvent  { return cast(*XConfigureRequestEvent, e); }
fn circulate(e as *XEvent) as *XCirculateEvent                 { return cast(*XCirculateEvent, e); }
fn circulate_request(e as *XEvent) as *XCirculateRequestEvent  { return cast(*XCirculateRequestEvent, e); }
fn property(e as *XEvent) as *XPropertyEvent                   { return cast(*XPropertyEvent, e); }
fn selection_clear(e as *XEvent) as *XSelectionClearEvent      { return cast(*XSelectionClearEvent, e); }
fn selection_request(e as *XEvent) as *XSelectionRequestEvent  { return cast(*XSelectionRequestEvent, e); }
fn selection(e as *XEvent) as *XSelectionEvent                 { return cast(*XSelectionEvent, e); }
fn colormap(e as *XEvent) as *XColormapEvent                   { return cast(*XColormapEvent, e); }
fn client(e as *XEvent) as *XClientMessageEvent                { return cast(*XClientMessageEvent, e); }
fn mapping(e as *XEvent) as *XMappingEvent                     { return cast(*XMappingEvent, e); }
fn error(e as *XEvent) as *XErrorEvent                         { return cast(*XErrorEvent, e); }
fn generic(e as *XEvent) as *XGenericEvent                     { return cast(*XGenericEvent, e); }
fn cookie(e as *XEvent) as *XGenericEventCookie                { return cast(*XGenericEventCookie, e); }

// Zeroing one, for a program building an event to send rather than reading one
// it received. XSendEvent reads all 192 bytes whatever the type says, so the
// tail has to be clean or the server sees whatever was on the stack.
fn clear(e as *XEvent) as void {
    let is i64 as i with mut = 0;
    while (i < 24) { e.pad[i] = 0; i = i + 1; }
}
