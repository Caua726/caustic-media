// window/x11/bind/xcup.cst — XC-MISC colormap utilization.
//
// How many colormap entries the server has reserved, and a way to store colours
// into that reserved area. Relevant when a PseudoColor visual had 256 entries
// and everyone was fighting over them.

extern "libXext.so.6" fn XcupGetReservedColormapEntries(dpy as *u8, n as i32, p as *u8, p2 as *u8) as i32;
extern "libXext.so.6" fn XcupQueryVersion(dpy as *u8, p as *u8, p2 as *u8) as i32;
extern "libXext.so.6" fn XcupStoreColors(dpy as *u8, a as i64, p as *u8, n as i32) as i32;
