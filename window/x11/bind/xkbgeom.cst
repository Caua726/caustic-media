// window/x11/bind/xkbgeom.cst — XKBgeom.h: the shape of the keyboard.
//
// XKB's geometry describes the physical thing: sections, rows, keys, their
// outlines and positions in millimetres, the shapes and colours of the
// keycaps, doodads like the caps-lock LED. It is what lets a program draw a
// picture of the user's actual keyboard, and — more usefully here — what turns
// a keycode into a position rather than into a letter.
//
// That distinction is the reason to bind it. A game that binds WASD means four
// keys in a square on the left, and on an AZERTY keyboard those are ZQSD. A
// layout-independent binding is a geometry question, not a keysym question.
//
// The allocation functions dominate the list because an XkbGeometry is a tree
// the caller builds and frees piece by piece: XkbAllocGeomSections,
// XkbAddGeomRow, XkbFreeGeomKeys and their thirty siblings. None of them is
// called from this directory.

extern "libX11.so.6" fn XkbAddGeomColor(geom as *u8, spec as *u8, pixel as u32) as *u8;
extern "libX11.so.6" fn XkbAddGeomDoodad(geom as *u8, section as *u8, name as i64) as *u8;
extern "libX11.so.6" fn XkbAddGeomKey(row as *u8) as *u8;
extern "libX11.so.6" fn XkbAddGeomKeyAlias(geom as *u8, alias as *u8, real as *u8) as *u8;
extern "libX11.so.6" fn XkbAddGeomOutline(shape as *u8, sz_points as i32) as *u8;
extern "libX11.so.6" fn XkbAddGeomOverlay(section as *u8, name as i64, sz_rows as i32) as *u8;
extern "libX11.so.6" fn XkbAddGeomOverlayKey(overlay as *u8, row as *u8, over as *u8,
                                             under as *u8) as *u8;
extern "libX11.so.6" fn XkbAddGeomOverlayRow(overlay as *u8, row_under as i32, sz_keys as i32) as *u8;
extern "libX11.so.6" fn XkbAddGeomProperty(geom as *u8, name as *u8, value as *u8) as *u8;
extern "libX11.so.6" fn XkbAddGeomRow(section as *u8, sz_keys as i32) as *u8;
extern "libX11.so.6" fn XkbAddGeomSection(geom as *u8, name as i64, sz_rows as i32,
                                          sz_doodads as i32, sz_overlays as i32) as *u8;
extern "libX11.so.6" fn XkbAddGeomShape(geom as *u8, name as i64, sz_outlines as i32) as *u8;
extern "libX11.so.6" fn XkbAllocGeomColors(geom as *u8, nColors as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomDoodads(geom as *u8, nDoodads as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomKeyAliases(geom as *u8, nAliases as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomKeys(row as *u8, nKeys as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomOutlines(shape as *u8, nOL as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomOverlayKeys(row as *u8, num_needed as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomOverlayRows(overlay as *u8, num_needed as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomOverlays(section as *u8, num_needed as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomPoints(ol as *u8, nPts as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomProps(geom as *u8, nProps as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomRows(section as *u8, nRows as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomSectionDoodads(section as *u8, nDoodads as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomSections(geom as *u8, nSections as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeomShapes(geom as *u8, nShapes as i32) as i32;
extern "libX11.so.6" fn XkbAllocGeometry(xkb as *u8, sizes as *u8) as i32;
extern "libX11.so.6" fn XkbComputeRowBounds(geom as *u8, section as *u8, row as *u8) as i32;
extern "libX11.so.6" fn XkbComputeSectionBounds(geom as *u8, section as *u8) as i32;
extern "libX11.so.6" fn XkbComputeShapeBounds(shape as *u8) as i32;
extern "libX11.so.6" fn XkbComputeShapeTop(shape as *u8, bounds as *u8) as i32;
extern "libX11.so.6" fn XkbFindOverlayForKey(geom as *u8, wanted as *u8, under as *u8) as *u8;
extern "libX11.so.6" fn XkbFreeGeomColors(geom as *u8, first as i32, count as i32,
                                          freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomDoodads(doodads as *u8, nDoodads as i32, freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomKeyAliases(geom as *u8, first as i32, count as i32,
                                              freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomKeys(row as *u8, first as i32, count as i32, freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomOutlines(shape as *u8, first as i32, count as i32,
                                            freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomOverlayKeys(row as *u8, first as i32, count as i32,
                                               freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomOverlayRows(overlay as *u8, first as i32, count as i32,
                                               freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomOverlays(section as *u8, first as i32, count as i32,
                                            freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomPoints(outline as *u8, first as i32, count as i32,
                                          freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomProperties(geom as *u8, first as i32, count as i32,
                                              freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomRows(section as *u8, first as i32, count as i32,
                                        freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomSections(geom as *u8, first as i32, count as i32,
                                            freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeomShapes(geom as *u8, first as i32, count as i32,
                                          freeAll as i32) as void;
extern "libX11.so.6" fn XkbFreeGeometry(geom as *u8, which as u32, freeMap as i32) as void;
extern "libX11.so.6" fn XkbGetGeometry(dpy as *u8, xkb as *u8) as i32;
extern "libX11.so.6" fn XkbGetNamedGeometry(dpy as *u8, xkb as *u8, name as i64) as i32;
extern "libX11.so.6" fn XkbSetGeometry(dpy as *u8, deviceSpec as u32, geom as *u8) as i32;
