extern "libX11.so.6" fn XStoreBuffer(display as *u8, bytes as *u8, nbytes as i32, buffer as i32) as i32;
extern "libX11.so.6" fn XStoreBytes(display as *u8, bytes as *u8, nbytes as i32) as i32;
