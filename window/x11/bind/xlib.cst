// --- Locale and text conversion ---
//
// Multibyte and wide-character text, paired with the locale libX11 was told about
// by XSetLocaleModifiers.

extern "libX11.so.6" fn XSetLocaleModifiers(modifier_list as *u8) as *u8;
extern "libX11.so.6" fn XSupportsLocale() as i32;

// --- Extensions ---
//
// How every extension announces itself. XQueryExtension is what MIT-SHM, Xrandr,
// Xfixes and XInput2 each go through before their first real call.

extern "libX11.so.6" fn XAddExtension(display as *u8) as *u8;
extern "libX11.so.6" fn XAddToExtensionList(structure as *u8, ext_data as *u8) as i32;
extern "libX11.so.6" fn XEHeadOfExtensionList(object as *u8) as *u8;
extern "libX11.so.6" fn XFindOnExtensionList(structure as *u8, number as i32) as *u8;
extern "libX11.so.6" fn XFreeExtensionList(list as *u8) as i32;
extern "libX11.so.6" fn XInitExtension(display as *u8, name as *u8) as *u8;
extern "libX11.so.6" fn XListExtensions(display as *u8, nextensions_return as *u8) as *u8;
extern "libX11.so.6" fn XQueryExtension(display as *u8, name as *u8,
                                        major_opcode_return as *u8, first_event_return as *u8,
                                        first_error_return as *u8) as i32;

// --- Errors ---
//
// X errors are asynchronous: the call returns, and the error arrives later. A
// handler installed here plus XSync is the only way to attribute one to the call
// that caused it, which is exactly what the MIT-SHM probe does.

extern "libX11.so.6" fn XGetErrorDatabaseText(display as *u8, name as *u8, message as *u8,
                                              default_string as *u8, buffer_return as *u8,
                                              length as i32) as i32;
extern "libX11.so.6" fn XGetErrorText(display as *u8, code as i32, buffer_return as *u8,
                                      length as i32) as i32;
extern "libX11.so.6" fn XSetErrorHandler(handler as *u8) as *u8;
extern "libX11.so.6" fn XSetIOErrorExitHandler(display as *u8, handler as *u8, user_data as *u8) as void;
extern "libX11.so.6" fn XSetIOErrorHandler(handler as *u8) as *u8;

// --- Hosts and access control ---
//
// Which clients may connect. Not the modern mechanism — that is the
// MIT-MAGIC-COOKIE in ~/.Xauthority — but still part of the protocol.

extern "libX11.so.6" fn XAddHost(display as *u8, host as *u8) as i32;
extern "libX11.so.6" fn XAddHosts(display as *u8, hosts as *u8, num_hosts as i32) as i32;
extern "libX11.so.6" fn XDisableAccessControl(display as *u8) as i32;
extern "libX11.so.6" fn XEnableAccessControl(display as *u8) as i32;
extern "libX11.so.6" fn XListHosts(display as *u8, nhosts_return as *u8, state_return as *u8) as *u8;
extern "libX11.so.6" fn XRemoveHost(display as *u8, host as *u8) as i32;
extern "libX11.so.6" fn XRemoveHosts(display as *u8, hosts as *u8, num_hosts as i32) as i32;
extern "libX11.so.6" fn XSetAccessControl(display as *u8, mode as i32) as i32;

// --- Screen saver ---
//
// Blanking and DPMS-adjacent controls. A fullscreen program that does not want the
// screen to blank calls XResetScreenSaver, or better, sets the idle inhibit
// property the compositor understands.

extern "libX11.so.6" fn XActivateScreenSaver(display as *u8) as i32;
extern "libX11.so.6" fn XForceScreenSaver(display as *u8, mode as i32) as i32;
extern "libX11.so.6" fn XGetScreenSaver(display as *u8, timeout_return as *u8,
                                        interval_return as *u8, prefer_blanking_return as *u8,
                                        allow_exposures_return as *u8) as i32;
extern "libX11.so.6" fn XResetScreenSaver(display as *u8) as i32;
extern "libX11.so.6" fn XSetScreenSaver(display as *u8, timeout as i32, interval as i32,
                                        prefer_blanking as i32, allow_exposures as i32) as i32;

// --- Resource manager and misc ---
//
// WM hints, the buffer cut ring, and the X resource database that ~/.Xresources
// feeds. Xft.dpi comes out of here, which is where scale() gets its number.

extern "libX11.so.6" fn XFetchBuffer(display as *u8, nbytes_return as *u8, buffer as i32) as *u8;
extern "libX11.so.6" fn XFetchBytes(display as *u8, nbytes_return as *u8) as *u8;
extern "libX11.so.6" fn XFetchName(display as *u8, w as i64, window_name_return as *u8) as i32;
extern "libX11.so.6" fn XFreeThreads() as i32;
extern "libX11.so.6" fn XGeometry(display as *u8, screen as i32, position as *u8,
                                  default_position as *u8, bwidth as u32, fwidth as u32,
