// window/x11/bind/xlib.cst — all of Xlib.h, which is most of libX11.
//
// 407 of libX11's 774 public functions and the 52 structs they need, which is
// what makes the two-level design in ../../window.md real: a program that wants
// to drive X11 itself takes this file and never writes an `extern` by hand.
// The abstraction above calls x11.bind.xlib.XCreateWindow rather than a private
// declaration of its own.
//
// The remaining 367 are not missing, they are elsewhere. One module per C
// header is the rule, so Xutil.h, XKBlib.h, Xcms.h, Xresource.h and Xlibint.h
// each get their own file and their own share. The 33 event structs are the one
// exception to header-follows-file: they came out of Xlib.h into xevent.cst
// because they are the hardest part of the binding and the part every consumer
// reads.
//
// --- What costs a binary ---
//
// Nothing, until something is called. The compiler emits `.cstimport` at the
// call site rather than at the declaration (src/codegen/emit_inst.cst), and
// caustic-ld turns only those into DT_NEEDED. A program that opens a window and
// never touches fonts links no font code and names no font symbol. Holding 407
// declarations here is free, which is the entire reason binding all of them is
// a reasonable thing to do.
//
// --- Pointers are *u8, always ---
//
// Every pointer parameter is *u8, never a typed pointer. That keeps the binding
// files free of import edges between each other — xlib.cst would otherwise need
// xevent.cst, xutil.cst and xcms.cst — and it is what the hand-written backend
// this replaces already did.
//
// The cost is real and worth naming: nothing stops passing a *XVisualInfo where
// XWindowAttributes* was wanted, and the compiler will not say a word. Type
// safety lives one level up, in surface.cst and window.cst, which never hand a
// raw pointer to anything. At a call site the cast is one token:
//
//     let is xlib.XWindowAttributes as wa;
//     xlib.XGetWindowAttributes(d, win, cast(*u8, &wa));
//
// --- Types ---
//
//   int, Bool, Status            i32
//   unsigned int                 u32
//   short / unsigned short       i16 / u16
//   char / unsigned char         i8 / u8
//   long, unsigned long          i64   XID, Window, Atom, Time, Colormap,
//                                      Cursor, Font, Pixmap, KeySym, masks
//   any T*                       *u8
//
// XIDs are i64 rather than u64 because nothing in X approaches 2^63, the bit
// operations are identical either way, and one rule beats mixed signedness at
// four hundred call sites.
//
// Struct field types are not transcribed from the header text — they come from
// asking the C compiler for each field's size, class and signedness, and the
// offsets come from offsetof. tools/x11_layout.c holds both and
// ../x11_layout_test.cst asserts every one of them.
//
// --- Packing ---
//
// Caustic structs are packed and C structs are not, so every struct here has
// explicit _padN fields where the C ABI would have aligned. They are not
// decoration: without the pad at offset 52 in XImage, red_mask lands at 52
// instead of 56 and every colour the server reads is wrong. The trailing pads
// matter too, because sizeof is what walks an array libX11 allocated —
// XGetVisualInfo returns one, and a stride four bytes short reads every element
// after the first at the wrong offset.
//
// --- The eleven variadic functions ---
//
// XCreateIC, XCreateOC, XVaCreateNestedList and the Get/Set IC/OC/IM/OM Values
// family take NUL-terminated (name, value) lists. Caustic's extern has no
// variadic form, so each is declared at a fixed arity of 13 trailing *u8 and
// callers pass 0 for the tail: the callee stops at the first null and never
// reads past it, so an arity longer than any real call is correct for every
// call.
//
// Recorded so it is auditable rather than lucky: the ELF FFI path does not emit
// the AL register setup the SysV variadic convention asks for. That is harmless
// here because a callee's va_start prologue reads AL as a count of vector
// registers to spill, and no X function takes a float vararg. It would not be
// harmless for printf.
//
// --- Three exports that cannot be bound ---
//
// KeySymToUcs4, read_EncodingInfo and _Utf8GetConvByName are exported by
// libX11.so.6 without a leading _X, so tools/symbols.txt lists them, but no
// shipped header declares them. They are lcUniConv internals. Binding them
// would mean inventing a prototype, and a wrong one is silent corruption, so
// they are named here instead and left out.
//
// XSynchronize and XSetAfterFunction return a function pointer rather than a
// value, which has no Caustic spelling; both are declared as returning *u8.

// --- The structs ---
//
// Ordered so that a struct embedding another comes after it: XRectangle and
// XCharStruct are used by value inside XFontSetExtents and XFontStruct.

struct XRectangle {
    x      as i16;   //   0
    y      as i16;   //   2
    width  as u16;   //   4
    height as u16;   //   6
}   // 8

struct XCharStruct {
    lbearing   as i16;   //   0
    rbearing   as i16;   //   2
    width      as i16;   //   4
    ascent     as i16;   //   6
    descent    as i16;   //   8
    attributes as u16;   //  10
}   // 12

struct Depth {
    depth    as i32;   //   0
    nvisuals as i32;   //   4
    visuals  as *u8;   //   8
}   // 16

struct Screen {
    ext_data        as *u8;   //   0
    display         as *u8;   //   8
    root            as i64;   //  16
    width           as i32;   //  24
    height          as i32;   //  28
    mwidth          as i32;   //  32
    mheight         as i32;   //  36
    ndepths         as i32;   //  40
    _pad0           as i32;   //  44
    depths          as *u8;   //  48
    root_depth      as i32;   //  56
    _pad1           as i32;   //  60
    root_visual     as *u8;   //  64
    default_gc      as *u8;   //  72
    cmap            as i64;   //  80
    white_pixel     as i64;   //  88
    black_pixel     as i64;   //  96
    max_maps        as i32;   // 104
    min_maps        as i32;   // 108
    backing_store   as i32;   // 112
    save_unders     as i32;   // 116
    root_input_mask as i64;   // 120
}   // 128

struct ScreenFormat {
    ext_data       as *u8;   //   0
    depth          as i32;   //   8
    bits_per_pixel as i32;   //  12
    scanline_pad   as i32;   //  16
    _pad0          as i32;   //  20
}   // 24

struct Visual {
    ext_data     as *u8;   //   0
    visualid     as i64;   //   8
    class        as i32;   //  16
    _pad0        as i32;   //  20
    red_mask     as i64;   //  24
    green_mask   as i64;   //  32
    blue_mask    as i64;   //  40
    bits_per_rgb as i32;   //  48
    map_entries  as i32;   //  52
}   // 56

struct XArc {
    x      as i16;   //   0
    y      as i16;   //   2
    width  as u16;   //   4
    height as u16;   //   6
    angle1 as i16;   //   8
    angle2 as i16;   //  10
}   // 12

struct XChar2b {
    byte1 as u8;   //   0
    byte2 as u8;   //   1
}   // 2

struct XColor {
    pixel as i64;   //   0
    red   as u16;   //   8
    green as u16;   //  10
    blue  as u16;   //  12
    flags as i8 ;   //  14
    pad   as i8 ;   //  15
}   // 16

struct XExtCodes {
    extension    as i32;   //   0
    major_opcode as i32;   //   4
    first_event  as i32;   //   8
    first_error  as i32;   //  12
}   // 16

struct XExtData {
    number       as i32;   //   0
    _pad0        as i32;   //   4
    next         as *u8;   //   8
    free_private as *u8;   //  16
    private_data as *u8;   //  24
}   // 32

struct XFontProp {
    name   as i64;   //   0
    card32 as i64;   //   8
}   // 16

struct XFontSetExtents {
    max_ink_extent     as XRectangle;   //   0
    max_logical_extent as XRectangle;   //   8
}   // 16

struct XFontStruct {
    ext_data          as *u8        ;   //   0
    fid               as i64        ;   //   8
    direction         as u32        ;   //  16
    min_char_or_byte2 as u32        ;   //  20
    max_char_or_byte2 as u32        ;   //  24
    min_byte1         as u32        ;   //  28
    max_byte1         as u32        ;   //  32
    all_chars_exist   as i32        ;   //  36
    default_char      as u32        ;   //  40
    n_properties      as i32        ;   //  44
    properties        as *u8        ;   //  48
    min_bounds        as XCharStruct;   //  56
    max_bounds        as XCharStruct;   //  68
    per_char          as *u8        ;   //  80
    ascent            as i32        ;   //  88
    descent           as i32        ;   //  92
}   // 96

struct XGCValues {
    function           as i32  ;   //   0
    _pad0              as i32  ;   //   4
    plane_mask         as i64  ;   //   8
    foreground         as i64  ;   //  16
    background         as i64  ;   //  24
    line_width         as i32  ;   //  32
    line_style         as i32  ;   //  36
    cap_style          as i32  ;   //  40
    join_style         as i32  ;   //  44
    fill_style         as i32  ;   //  48
    fill_rule          as i32  ;   //  52
    arc_mode           as i32  ;   //  56
    _pad1              as i32  ;   //  60
    tile               as i64  ;   //  64
    stipple            as i64  ;   //  72
    ts_x_origin        as i32  ;   //  80
    ts_y_origin        as i32  ;   //  84
    font               as i64  ;   //  88
    subwindow_mode     as i32  ;   //  96
    graphics_exposures as i32  ;   // 100
    clip_x_origin      as i32  ;   // 104
    clip_y_origin      as i32  ;   // 108
    clip_mask          as i64  ;   // 112
    dash_offset        as i32  ;   // 120
    dashes             as i8   ;   // 124
    _pad2              as [3]u8;   // 125
}   // 128

struct XHostAddress {
    family  as i32;   //   0
    length  as i32;   //   4
    address as *u8;   //   8
}   // 16

struct XICCallback {
    client_data as *u8;   //   0
    callback    as *u8;   //   8
}   // 16

struct XIMCallback {
    client_data as *u8;   //   0
    callback    as *u8;   //   8
}   // 16

struct XIMStyles {
    count_styles     as u16  ;   //   0
    _pad0            as [6]u8;   //   2
    supported_styles as *u8  ;   //   8
}   // 16

struct XIMValuesList {
    count_values     as u16  ;   //   0
    _pad0            as [6]u8;   //   2
    supported_values as *u8  ;   //   8
}   // 16

struct XImage {
    width            as i32   ;   //   0
    height           as i32   ;   //   4
    xoffset          as i32   ;   //   8
    format           as i32   ;   //  12
    data             as *u8   ;   //  16
    byte_order       as i32   ;   //  24
    bitmap_unit      as i32   ;   //  28
    bitmap_bit_order as i32   ;   //  32
    bitmap_pad       as i32   ;   //  36
    depth            as i32   ;   //  40
    bytes_per_line   as i32   ;   //  44
    bits_per_pixel   as i32   ;   //  48
    _pad0            as i32   ;   //  52
    red_mask         as i64   ;   //  56
    green_mask       as i64   ;   //  64
    blue_mask        as i64   ;   //  72
    obdata           as *u8   ;   //  80
    f                as [6]i64;   //  88
}   // 136

struct XKeyboardControl {
    key_click_percent as i32;   //   0
    bell_percent      as i32;   //   4
    bell_pitch        as i32;   //   8
    bell_duration     as i32;   //  12
    led               as i32;   //  16
    led_mode          as i32;   //  20
    key               as i32;   //  24
    auto_repeat_mode  as i32;   //  28
}   // 32

struct XKeyboardState {
    key_click_percent  as i32   ;   //   0
    bell_percent       as i32   ;   //   4
    bell_pitch         as u32   ;   //   8
    bell_duration      as u32   ;   //  12
    led_mask           as i64   ;   //  16
