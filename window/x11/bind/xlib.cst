}   // 64

struct XModifierKeymap {
    max_keypermod as i32;   //   0
    _pad0         as i32;   //   4
    modifiermap   as *u8;   //   8
}   // 16

struct XOMCharSetList {
    charset_count as i32;   //   0
    _pad0         as i32;   //   4
