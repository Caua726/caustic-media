}   // 4

struct XSegment {
    x1 as i16;   //   0
    y1 as i16;   //   2
    x2 as i16;   //   4
    y2 as i16;   //   6
}   // 8

// C names the first field `type`, which is a Caustic keyword. It is `kind`
// here, the same rename xevent.cst makes for the same reason.
struct XServerInterpretedAddress {
    typelength  as i32;   //   0
    valuelength as i32;   //   4
    kind        as *u8;   //   8
    value       as *u8;   //  16
}   // 24

struct XSetWindowAttributes {
    background_pixmap     as i64;   //   0
    background_pixel      as i64;   //   8
    border_pixmap         as i64;   //  16
    border_pixel          as i64;   //  24
    bit_gravity           as i32;   //  32
    win_gravity           as i32;   //  36
    backing_store         as i32;   //  40
    _pad0                 as i32;   //  44
    backing_planes        as i64;   //  48
    backing_pixel         as i64;   //  56
    save_under            as i32;   //  64
    _pad1                 as i32;   //  68
    event_mask            as i64;   //  72
    do_not_propagate_mask as i64;   //  80
    override_redirect     as i32;   //  88
    _pad2                 as i32;   //  92
    colormap              as i64;   //  96
    cursor                as i64;   // 104
}   // 112

struct XTextItem {
    chars  as *u8;   //   0
    nchars as i32;   //   8
    delta  as i32;   //  12
    font   as i64;   //  16
}   // 24

struct XTextItem16 {
    chars  as *u8;   //   0
    nchars as i32;   //   8
    delta  as i32;   //  12
    font   as i64;   //  16
}   // 24

struct XTimeCoord {
    time  as i64;   //   0
    x     as i16;   //   8
    y     as i16;   //  10
    _pad0 as i32;   //  12
}   // 16

struct XWindowAttributes {
    x                     as i32;   //   0
    y                     as i32;   //   4
    width                 as i32;   //   8
    height                as i32;   //  12
    border_width          as i32;   //  16
    depth                 as i32;   //  20
    visual                as *u8;   //  24
    root                  as i64;   //  32
    class                 as i32;   //  40
    bit_gravity           as i32;   //  44
    win_gravity           as i32;   //  48
    backing_store         as i32;   //  52
    backing_planes        as i64;   //  56
    backing_pixel         as i64;   //  64
    save_under            as i32;   //  72
    _pad0                 as i32;   //  76
    colormap              as i64;   //  80
    map_installed         as i32;   //  88
    map_state             as i32;   //  92
    all_event_masks       as i64;   //  96
    your_event_mask       as i64;   // 104
    do_not_propagate_mask as i64;   // 112
    override_redirect     as i32;   // 120
    _pad1                 as i32;   // 124
    screen                as *u8;   // 128
}   // 136

struct XWindowChanges {
    x            as i32;   //   0
    y            as i32;   //   4
    width        as i32;   //   8
    height       as i32;   //  12
    border_width as i32;   //  16
    _pad0        as i32;   //  20
    sibling      as i64;   //  24
    stack_mode   as i32;   //  32
    _pad1        as i32;   //  36
}   // 40

struct XmbTextItem {
    chars    as *u8;   //   0
    nchars   as i32;   //   8
    delta    as i32;   //  12
    font_set as *u8;   //  16
}   // 24

struct XwcTextItem {
    chars    as *u8;   //   0
    nchars   as i32;   //   8
    delta    as i32;   //  12
    font_set as *u8;   //  16
}   // 24

// --- Input method types ---
//
// The XIM half of Xlib.h, which the header declares with named tags rather than
// anonymously. Four of them are plain enums, so they are constants here: Caustic
// has enums, but a C enum crossing FFI is an int and nothing more, and spelling
// it as an int is what keeps that visible.
//
// Two fields are C unions of two pointers — XIMText.string and
// XIMStatusDrawCallbackStruct.data. Both members are 8 bytes, so the union is a
// pointer and which one is live is told by a sibling field.

let is i32 as XIMForwardChar      with imut = 0;
let is i32 as XIMBackwardChar     with imut = 1;
let is i32 as XIMForwardWord      with imut = 2;
let is i32 as XIMBackwardWord     with imut = 3;
let is i32 as XIMCaretUp          with imut = 4;
let is i32 as XIMCaretDown        with imut = 5;
let is i32 as XIMNextLine         with imut = 6;
let is i32 as XIMPreviousLine     with imut = 7;
let is i32 as XIMLineStart        with imut = 8;
let is i32 as XIMLineEnd          with imut = 9;
let is i32 as XIMAbsolutePosition with imut = 10;
let is i32 as XIMDontChange       with imut = 11;

let is i32 as XIMIsInvisible with imut = 0;
let is i32 as XIMIsPrimary   with imut = 1;
let is i32 as XIMIsSecondary with imut = 2;

let is i32 as XIMTextType   with imut = 0;
let is i32 as XIMBitmapType with imut = 1;

let is i32 as XOMOrientation_LTR_TTB with imut = 0;
let is i32 as XOMOrientation_RTL_TTB with imut = 1;
let is i32 as XOMOrientation_TTB_LTR with imut = 2;
let is i32 as XOMOrientation_TTB_RTL with imut = 3;
let is i32 as XOMOrientation_Context with imut = 4;

// `string` is a union of char* and wchar_t*; encoding_is_wchar says which.
struct XIMText {
    length            as u16;      //   0
    _pad0             as [6]u8;    //   2
    feedback          as *u8;      //   8
    encoding_is_wchar as i32;      //  16
    _pad1             as i32;      //  20
    string            as *u8;      //  24
}                                  // 32

struct XIMStringConversionText {
    length            as u16;      //   0
    _pad0             as [6]u8;    //   2
    feedback          as *u8;      //   8
    encoding_is_wchar as i32;      //  16
    _pad1             as i32;      //  20
    string            as *u8;      //  24
}                                  // 32

struct XIMHotKeyTrigger {
    keysym        as i64;    //   0
    modifier      as i32;    //   8
    modifier_mask as i32;    //  12
}                            // 16

struct XIMHotKeyTriggers {
    num_hot_key as i32;    //   0
    _pad0       as i32;    //   4
    key         as *u8;    //   8
}                          // 16

struct XIMPreeditDrawCallbackStruct {
    caret      as i32;    //   0
    chg_first  as i32;    //   4
    chg_length as i32;    //   8
    _pad0      as i32;    //  12
    text       as *u8;    //  16
}                         // 24

struct XIMPreeditCaretCallbackStruct {
    position  as i32;    //   0
    direction as i32;    //   4
    style     as i32;    //   8
}                        // 12

struct XIMPreeditStateNotifyCallbackStruct {
    state as i64;    //   0
}                    // 8

// C names the first field `type`, which is a Caustic keyword. `kind` here, the
// same rename xevent.cst makes for the same reason. `data` is a union of
// XIMText* and XIMStatusDrawCallbackStruct's bitmap Pixmap.
struct XIMStatusDrawCallbackStruct {
    kind  as i32;    //   0
    _pad0 as i32;    //   4
    data  as *u8;    //   8
}                    // 16

struct XIMStringConversionCallbackStruct {
    position  as i16;      //   0
    _pad0     as [2]u8;    //   2
    direction as i32;      //   4
    operation as u16;      //   8
    factor    as u16;      //  10
    _pad1     as i32;      //  12
    text      as *u8;      //  16
}                          // 24

// --- Declarations gcc cannot describe ---
//
// Every other extern in this file was transcribed from a prototype the C
// compiler produced. These eight could not be, and the reason is worth writing
// down because the failure is silent.
//
// The XIfEvent family takes a PREDICATE — a function pointer — as its third
// argument, and `gcc -aux-info` flattens the pointed-to function's parameters
// into the outer signature: asked about XIfEvent it reports six parameters
// where there are four. An extern with the wrong arity compiles, links, and
// pushes the wrong number of registers at every call. So these were read from
// Xlib.h and written by hand.
//
// The four XImage accessors are macros in the header, expanding to a call
// through the image's own function table, but libX11 exports each as a real
// symbol as well — the same duality XDestroyImage has above.
//
// XSetAfterFunction returns a function pointer, which has no Caustic spelling
// and is *u8 here.

// Wait for, check for, or peek at an event a predicate accepts. The predicate
// is Bool (*)(Display*, XEvent*, XPointer) and `arg` is passed to it unchanged.
extern "libX11.so.6" fn XIfEvent(display as *u8, event_return as *u8,
                                 predicate as *u8, arg as *u8) as i32;
extern "libX11.so.6" fn XCheckIfEvent(display as *u8, event_return as *u8,
                                      predicate as *u8, arg as *u8) as i32;
extern "libX11.so.6" fn XPeekIfEvent(display as *u8, event_return as *u8,
                                     predicate as *u8, arg as *u8) as i32;

// Installs a hook libX11 calls after every protocol request, and returns the
// previous one. XSynchronize is this with the hook chosen for you.
extern "libX11.so.6" fn XSetAfterFunction(display as *u8, procedure as *u8) as *u8;

// The XImage accessors. get_pixel returns an unsigned long, which is why this
// one is i64 rather than the i32 the neighbours use.
extern "libX11.so.6" fn XGetPixel(ximage as *u8, x as i32, y as i32) as i64;
extern "libX11.so.6" fn XPutPixel(ximage as *u8, x as i32, y as i32, pixel as i64) as i32;
extern "libX11.so.6" fn XSubImage(ximage as *u8, x as i32, y as i32,
                                  subimage_width as u32, subimage_height as u32) as *u8;
extern "libX11.so.6" fn XAddPixel(ximage as *u8, value as i64) as i32;

// --- Connection and display ---
//
// Everything that is about the socket rather than about a window. XOpenDisplay(0)
// reads $DISPLAY; XFlush pushes buffered requests; XSync also waits for the server to
// finish, which is the only way to see an asynchronous error at a known point.

extern "libX11.so.6" fn XAddConnectionWatch(dpy as *u8, callback as *u8, client_data as *u8) as i32;
extern "libX11.so.6" fn XCloseDisplay(display as *u8) as i32;
extern "libX11.so.6" fn XConnectionNumber(display as *u8) as i32;
