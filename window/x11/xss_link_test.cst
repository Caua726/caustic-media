// window/x11/xss_link_test.cst — every libXss.so.1 symbol resolves, or this never runs.
//
// Eleven declarations, and the same harness the other link tests use: the
// calls sit behind a branch that is never taken, the imports are emitted
// anyway because the condition comes from argc, and DF_BIND_NOW makes the
// loader resolve every name at exec. One transposed letter and the process
// dies before main.
//
// Its own binary, one per shared object, for the reason xext_link_test.cst
// gives; the calls are in link/xss.cst, which all_link_test.cst also makes.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "link/xss.cst" as link;

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    link.touch(argc);
    io.printf("libXss.so.1: 11 symbols resolved at exec\n");
    return 0;
}
