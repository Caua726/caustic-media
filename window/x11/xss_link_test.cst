// window/x11/xss_link_test.cst — every libXss.so.1 symbol resolves, or this never runs.
//
// Eleven declarations, and the same harness the other five link tests use: the
// calls sit behind a branch that is never taken, the imports are emitted
// anyway because the condition comes from argc, and DF_BIND_NOW makes the
// loader resolve every name at exec. One transposed letter and the process
// dies before main.
//
// Its own binary, one per shared object, for the reason measured in
// xext_link_test.cst: a binary crossing roughly 256 imports across two sonames
// loses the DT_NEEDED of every soname but the first.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "bind/xscrnsaver.cst" as xss;

let is i64 as sink with mut = 0;

fn _touch() as void {
    if (sink != 7777) { return; }
    xss.XScreenSaverAllocInfo();
    xss.XScreenSaverGetRegistered(cast(*u8, 0), cast(i32, 0), cast(*u8, 0), cast(*u8, 0));
    xss.XScreenSaverQueryExtension(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xss.XScreenSaverQueryInfo(cast(*u8, 0), 0, cast(*u8, 0));
    xss.XScreenSaverQueryVersion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xss.XScreenSaverRegister(cast(*u8, 0), cast(i32, 0), 0, 0);
    xss.XScreenSaverSelectInput(cast(*u8, 0), 0, 0);
    xss.XScreenSaverSetAttributes(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(u32, 0), cast(u32, 0), cast(u32, 0), cast(i32, 0), cast(u32, 0), cast(*u8, 0), 0, cast(*u8, 0));
    xss.XScreenSaverSuspend(cast(*u8, 0), cast(i32, 0));
    xss.XScreenSaverUnregister(cast(*u8, 0), cast(i32, 0));
    xss.XScreenSaverUnsetAttributes(cast(*u8, 0), 0);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    sink = argc;
    if (sink == 7777) { _touch(); }
    io.printf("libXss.so.1: 11 symbols resolved at exec\n");
    return 0;
}
