// window/x11/xim_preedit_test.cst — what an on-the-spot input method draws,
// as text.cst keeps it and hands it out, the callbacks called as Xlib calls
// them: start, draw replacing chg_length characters from chg_first with text
// in the locale's multibyte encoding or in wide characters, its feedback
// marking the part being converted, the caret moved by direction, done.
// No display: the callbacks' arguments are built here.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "text.cst" as text;
use "bind/xlib.cst" as xlib;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

let is text.Input as in with mut;
let is [256]u8 as out;
let is i64 as cur with mut = 0;
let is i64 as hla with mut = 0;
let is i64 as hlb with mut = 0;

fn utf8() as i64 { return text.preedit_utf8(&in, &out[0], 256, &cur, &hla, &hlb); }

fn same(n as i64, b as *u8) as i32 {
    let is i64 as k with mut = 0;
    while (b[k] != 0) { k = k + 1; }
    if (n != k) { return 0; }
    return cast(i32, mem.memcmp(&out[0], b, n) == 0);
}

let is xlib.XIMText as xt;
let is xlib.XIMPreeditDrawCallbackStruct as draw;
let is [16]i64 as fb;

// Drawn: chg_length characters from chg_first replaced by s (UTF-8, n
// characters; null for none), the caret at caret, characters hl_from..hl_to
// of s marked reversed.
fn drawn(first as i32, gone as i32, s as *u8, n as i32, caret as i32, hl_from as i64, hl_to as i64) as void {
    mem.memzero(cast(*u8, &xt), sizeof(xlib.XIMText));
    mem.memzero(cast(*u8, &draw), sizeof(xlib.XIMPreeditDrawCallbackStruct));
    let is i64 as i with mut = 0;
    while (i < 16) {
        fb[i] = text.FEEDBACK_UNDERLINE;
        if (i >= hl_from && i < hl_to) { fb[i] = text.FEEDBACK_REVERSE; }
        i = i + 1;
    }
    xt.length = cast(u16, n);
    xt.feedback = cast(*u8, &fb[0]);
    xt.string = s;
    draw.caret = caret;
    draw.chg_first = first;
    draw.chg_length = gone;
    draw.text = cast(*u8, 0);
    if (cast(i64, s) != 0) { draw.text = cast(*u8, &xt); }
    text._on_draw(in.ic, cast(*u8, 0), &draw);
}

fn main() as i32 {
    text.init(&in);
    // A context as Xlib would give one: what the callbacks are called with.
    in.ic = cast(*u8, 4096);
    in.have_im = 1;
    text._note(&in);

    check("started: no limit asked", text._on_start(in.ic, cast(*u8, 0), cast(*u8, 0)) == 0 - 1);
    check("and nothing composed, said", text.preedit_changed(&in) == 1 && utf8() == 0 && text.preedit_changed(&in) == 0);

    drawn(0, 0, "かな", 2, 2, 0, 0);
    let is i64 as n with mut = utf8();
    check("drawn: its UTF-8, the caret at its end, nothing converted", same(n, "かな") == 1 && cur == 6 && hla == hlb);

    // The second character converted, the caret after the first.
    drawn(1, 1, "漢", 1, 1, 0, 1);
    n = utf8();
    check("one replaced: the rest kept, the converted part marked", same(n, "か漢") == 1 && cur == 3 && hla == 3 && hlb == 6);

    // Inserted before, nothing replaced: what followed moves along.
    drawn(0, 0, "x", 1, 0, 0, 0);
    n = utf8();
    check("inserted at the start", same(n, "xか漢") == 1 && cur == 0 && hla == 4 && hlb == 7);

    // Deleted: no text.
    drawn(1, 1, cast(*u8, 0), 0, 1, 0, 0);
    n = utf8();
    check("one deleted", same(n, "x漢") == 1 && cur == 1);

    // Out of range: held to what there is.
    drawn(9, 9, "y", 1, 99, 0, 0);
    n = utf8();
    check("past the end: appended, the caret held", same(n, "x漢y") == 1 && cur == 5);

    // Wide characters (encoding_is_wchar): UCS-4 on this system.
    let is [3]u32 as wide;
    wide[0] = cast(u32, 1046);    // Ж
    wide[1] = cast(u32, 128512);  // 😀
    mem.memzero(cast(*u8, &xt), sizeof(xlib.XIMText));
    xt.length = cast(u16, 2);
    xt.encoding_is_wchar = 1;
    xt.string = cast(*u8, &wide[0]);
    draw.caret = 2;
    draw.chg_first = 0;
    draw.chg_length = 3;
    draw.text = cast(*u8, &xt);
    text._on_draw(in.ic, cast(*u8, 0), &draw);
    n = utf8();
    check("wide characters: as UTF-8, beyond the BMP too", same(n, "Ж😀") == 1 && cur == 6);

    // The caret, by direction, told back.
    let is xlib.XIMPreeditCaretCallbackStruct as caret;
    caret.position = 0;
    caret.direction = text.CARET_BACKWARD;
    caret.style = 0;
    text._on_caret(in.ic, cast(*u8, 0), &caret);
    n = utf8();
    check("back one: between them, told back", cur == 2 && caret.position == 1);
    caret.direction = text.CARET_LINE_START;
    text._on_caret(in.ic, cast(*u8, 0), &caret);
    n = utf8();
    check("to the start", cur == 0 && caret.position == 0);
    caret.direction = text.CARET_ABSOLUTE;
    caret.position = 7;
    text._on_caret(in.ic, cast(*u8, 0), &caret);
    n = utf8();
    check("absolute, past it: at its end", cur == 6 && caret.position == 2);

    // Bytes that start no character: replaced, not trusted.
    let is [4]u8 as bad;
    bad[0] = cast(u8, 255); bad[1] = cast(u8, 97); bad[2] = cast(u8, 0);
    drawn(0, 2, cast(*u8, &bad[0]), 2, 2, 0, 0);
    n = utf8();
    check("a stray byte: U+FFFD, then what follows", same(n, "�a") == 1);

    // A context Xlib never gave: nothing of it touched.
    text._on_draw(cast(*u8, 8192), cast(*u8, 0), &draw);
    check("another context's drawing: not this one's", text.preedit_changed(&in) == 0);

    text._on_done(in.ic, cast(*u8, 0), cast(*u8, 0));
    n = utf8();
    check("done: nothing composed", n == 0 && cur == 0);

    // The method gone: the context with it, the first tier back.
    drawn(0, 0, "z", 1, 1, 0, 0);
    text._on_destroyed(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    check("destroyed: no context, the composition said empty", text.has_method(&in) == 0 &&
          text.preedit_changed(&in) == 1 && utf8() == 0);

    if (fails == 0) {
        io.printf("xim preedit: all checks passed\n");
        return 0;
    }
    io.printf("xim preedit: %d failures\n", fails);
    return 1;
}
