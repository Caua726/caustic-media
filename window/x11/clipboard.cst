// window/x11/clipboard.cst — there is no clipboard in X.
//
// There is an *owner*. A client says "I own the CLIPBOARD selection"; another
// client asks the server who that is and sends it a request; the owner answers
// by writing the data onto a property of the requestor's window and sending a
// SelectionNotify. The server stores nothing. Quit the program and the
// clipboard is empty, which is why desktops run a clipboard manager whose only
// job is to own selections on behalf of programs that exited.
//
// Two consequences shape this file:
//
// **Answering is not optional.** A SelectionRequest this program ignores leaves
// the client that sent it waiting — usually until a timeout, sometimes forever.
// So ../window.cst's pump services it before the event reaches the ring, and a
// program that never calls anything here still behaves correctly as an owner.
//
// **Asking is asynchronous.** request_text() sends a request and returns; the
// answer arrives as a SelectionNotify some frames later. A blocking form has to
// pump the queue while it waits, and it cannot be implemented by sleeping,
// because if the other client asks US for something in the meantime and we are
// asleep, both sides wait forever. get_text() pumps; it does not sleep.
//
// --- Two connections, not one ---
//
// A client cannot answer its own SelectionRequest while blocked waiting for the
// reply to its own ConvertSelection. That is not a limitation of this code, it
// is the protocol, and it is why the test for this opens a second Display in
// the same process rather than trying to be clever.
use "std/mem.cst" as mem;
use "bind/x.cst" as x;
use "bind/xlib.cst" as xlib;
use "bind/xevent.cst" as xev;

// Which selection. PRIMARY is the middle-click one that fills on every text
// selection; CLIPBOARD is the explicit ctrl-C one. They are genuinely separate
// and a program that conflates them breaks middle-click paste for everybody.
let is i32 as CLIPBOARD with imut = 0;
let is i32 as PRIMARY   with imut = 1;

let is i64 as MAX_TEXT with imut = 1048576;   // 1 MB, the point where INCR starts

struct Atoms {
    clipboard    as i64;
    primary      as i64;
    targets      as i64;
    utf8_string  as i64;
    string_atom  as i64;
    text         as i64;
    incr         as i64;
    // A property on OUR window that the answer gets written to. The name is
    // arbitrary and only has to be unique within this window.
    dest         as i64;
}

struct Selection {
    at      as Atoms;
    // What this program owns, if anything. Owned separately per selection
    // because a program can own CLIPBOARD without owning PRIMARY.
    own_clip as *u8;
    own_clip_len as i64;
    own_prim as *u8;
    own_prim_len as i64;
    own_bytes as i64;      // mapped size, for munmap

    // The answer to our own last request, once it arrives.
    got      as *u8;
    got_len  as i64;
    got_bytes as i64;
    pending  as i32;       // a request is out and unanswered
    ready    as i32;       // an answer is sitting in `got`
}

fn init(s as *Selection, d as *u8) as void {
    s.at.clipboard   = xlib.XInternAtom(d, "CLIPBOARD", 0);
    s.at.primary     = xlib.XInternAtom(d, "PRIMARY", 0);
    s.at.targets     = xlib.XInternAtom(d, "TARGETS", 0);
    s.at.utf8_string = xlib.XInternAtom(d, "UTF8_STRING", 0);
    s.at.string_atom = xlib.XInternAtom(d, "STRING", 0);
    s.at.text        = xlib.XInternAtom(d, "TEXT", 0);
    s.at.incr        = xlib.XInternAtom(d, "INCR", 0);
    s.at.dest        = xlib.XInternAtom(d, "CAUSTIC_SELECTION", 0);
    s.own_clip = cast(*u8, 0); s.own_clip_len = 0;
    s.own_prim = cast(*u8, 0); s.own_prim_len = 0;
    s.own_bytes = 0;
    s.got = cast(*u8, 0); s.got_len = 0; s.got_bytes = 0;
    s.pending = 0; s.ready = 0;
}

fn close(s as *Selection) as void {
    if (cast(i64, s.own_clip) != 0) { mem.core.munmap(s.own_clip, s.own_bytes); s.own_clip = cast(*u8, 0); }
    if (cast(i64, s.own_prim) != 0) { mem.core.munmap(s.own_prim, s.own_bytes); s.own_prim = cast(*u8, 0); }
    if (cast(i64, s.got) != 0) { mem.core.munmap(s.got, s.got_bytes); s.got = cast(*u8, 0); }
}

fn _sel_atom(s as *Selection, which as i32) as i64 {
    if (which == PRIMARY) { return s.at.primary; }
    return s.at.clipboard;
}

fn _round_up(n as i64) as i64 {
    let is i64 as p = 4096;
    return ((n + p - 1) / p) * p;
}

// --- Owning ---

fn set_text(s as *Selection, d as *u8, win as i64, which as i32,
            text as *u8, len as i64) as i32 {
    if (len < 0 || len > MAX_TEXT) { return 0; }

    let is i64 as bytes = _round_up(len + 1);
    let is *u8 as copy = mem.core.mmap_anon(bytes);
    if (cast(i64, copy) == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (i < len) { copy[i] = text[i]; i = i + 1; }
    copy[len] = cast(u8, 0);

    if (which == PRIMARY) {
        if (cast(i64, s.own_prim) != 0) { mem.core.munmap(s.own_prim, s.own_bytes); }
        s.own_prim = copy; s.own_prim_len = len;
    } else {
        if (cast(i64, s.own_clip) != 0) { mem.core.munmap(s.own_clip, s.own_bytes); }
        s.own_clip = copy; s.own_clip_len = len;
    }
    s.own_bytes = bytes;

    xlib.XSetSelectionOwner(d, _sel_atom(s, which), win, x.CurrentTime);
    xlib.XFlush(d);
    // The server is the authority on who owns it, so ask rather than assume:
    // a race with a clipboard manager is real and losing it silently is worse
    // than reporting it.
    if (xlib.XGetSelectionOwner(d, _sel_atom(s, which)) != win) { return 0; }
    return 1;
}

fn owns(s as *Selection, d as *u8, win as i64, which as i32) as i32 {
    if (xlib.XGetSelectionOwner(d, _sel_atom(s, which)) == win) { return 1; }
    return 0;
}

// --- Answering, from inside the pump ---
//
// Returns 1 when the event was ours to handle, so the pump can stop looking at
// it. Everything here is a reply the requestor is blocked waiting for, which is
// why none of these paths can be deferred to the program's frame loop.
fn answer(s as *Selection, d as *u8, win as i64, e as *xev.XEvent) as i32 {
    let is i32 as ty = xev.kind(e);

    // Somebody else took the selection. Drop what we were holding: keeping it
    // would mean answering requests for a selection we no longer own.
    if (ty == x.SelectionClear) {
        let is *xev.XSelectionClearEvent as sc = xev.selection_clear(e);
        if (sc.selection == s.at.clipboard && cast(i64, s.own_clip) != 0) {
            mem.core.munmap(s.own_clip, s.own_bytes);
            s.own_clip = cast(*u8, 0); s.own_clip_len = 0;
        }
        if (sc.selection == s.at.primary && cast(i64, s.own_prim) != 0) {
            mem.core.munmap(s.own_prim, s.own_bytes);
            s.own_prim = cast(*u8, 0); s.own_prim_len = 0;
        }
        return 1;
    }

    // Our own answer arriving.
    if (ty == x.SelectionNotify) {
        let is *xev.XSelectionEvent as sn = xev.selection(e);
        s.pending = 0;
        if (sn.property == x.None) { s.ready = 0; s.got_len = 0; return 1; }
        _receive(s, d, win);
        return 1;
    }

    if (ty != x.SelectionRequest) { return 0; }

    let is *xev.XSelectionRequestEvent as rq = xev.selection_request(e);

    let is *u8 as data with mut = cast(*u8, 0);
    let is i64 as len with mut = 0;
    if (rq.selection == s.at.primary) { data = s.own_prim; len = s.own_prim_len; }
    else if (rq.selection == s.at.clipboard) { data = s.own_clip; len = s.own_clip_len; }

    // Build the reply first; refusing is telling them property = None, never
    // silence.
    let is i64 as reply_prop with mut = rq.property;
    // A requestor from before ICCCM sends property = None meaning "use the
    // target atom as the property name".
    if (reply_prop == x.None) { reply_prop = rq.target; }

    let is i32 as ok with mut = 0;
    if (cast(i64, data) != 0) {
        if (rq.target == s.at.targets) {
            // What we can convert to. Ordered best first, which is what a
            // well-behaved requestor honours.
            let is [4]i64 as targets;
            targets[0] = s.at.targets;
            targets[1] = s.at.utf8_string;
            targets[2] = s.at.string_atom;
            targets[3] = s.at.text;
            xlib.XChangeProperty(d, rq.requestor, reply_prop, 4, 32, x.PropModeReplace,
                                 cast(*u8, &targets), 4);
            ok = 1;
        } else if (rq.target == s.at.utf8_string || rq.target == s.at.string_atom
                   || rq.target == s.at.text) {
            // Above 1 MB the protocol requires the INCR chunking dance, which
            // this does not implement. Refusing is correct; truncating would
            // hand somebody a silently shortened paste.
            if (len <= MAX_TEXT) {
                xlib.XChangeProperty(d, rq.requestor, reply_prop, rq.target, 8,
                                     x.PropModeReplace, data, cast(i32, len));
                ok = 1;
            }
        }
    }

    let is xev.XEvent as out;
    xev.clear(&out);
    let is *xev.XSelectionEvent as sn = xev.selection(&out);
    sn.kind = x.SelectionNotify;
    sn.display = d;
    sn.requestor = rq.requestor;
    sn.selection = rq.selection;
    sn.target = rq.target;
    sn.time = rq.time;
    if (ok == 1) { sn.property = reply_prop; } else { sn.property = x.None; }
    xlib.XSendEvent(d, rq.requestor, 0, 0, cast(*u8, &out));
    xlib.XFlush(d);
    return 1;
}

// --- Asking ---

fn request_text(s as *Selection, d as *u8, win as i64, which as i32) as i32 {
    if (s.pending == 1) { return 0; }
    s.ready = 0;
    s.got_len = 0;
    s.pending = 1;
    // UTF8_STRING, not STRING: STRING is Latin-1 by the letter of the protocol,
    // and asking for it gets mojibake from any modern client.
    xlib.XConvertSelection(d, _sel_atom(s, which), s.at.utf8_string, s.at.dest,
                           win, x.CurrentTime);
    xlib.XFlush(d);
    return 1;
}

// Reads the property the owner just wrote onto our window, then deletes it —
// deleting is what tells an INCR sender to continue, and is expected even when
// it is not one.
fn _receive(s as *Selection, d as *u8, win as i64) as void {
    let is i64 as ty with mut = 0;
    let is i32 as fmt with mut = 0;
    let is i64 as nitems with mut = 0;
    let is i64 as after with mut = 0;
    let is *u8 as data with mut = cast(*u8, 0);

    if (xlib.XGetWindowProperty(d, win, s.at.dest, 0, MAX_TEXT / 4, 0, 0,
                                &ty, &fmt, &nitems, &after, cast(*u8, &data)) != x.Success) {
        return;
    }
    if (cast(i64, data) == 0) { return; }
    // An INCR reply means the owner is about to send it in chunks over a series
    // of PropertyNotify events. Not implemented; saying so beats returning the
    // word "INCR" as if it were the text.
    if (ty == s.at.incr) { xlib.XFree(data); xlib.XDeleteProperty(d, win, s.at.dest); return; }

    let is i64 as len = nitems;
    let is i64 as bytes = _round_up(len + 1);
    let is *u8 as copy = mem.core.mmap_anon(bytes);
    if (cast(i64, copy) != 0) {
        let is i64 as i with mut = 0;
        while (i < len) { copy[i] = data[i]; i = i + 1; }
        copy[len] = cast(u8, 0);
        if (cast(i64, s.got) != 0) { mem.core.munmap(s.got, s.got_bytes); }
        s.got = copy;
        s.got_len = len;
        s.got_bytes = bytes;
        s.ready = 1;
    }
    xlib.XFree(data);
    xlib.XDeleteProperty(d, win, s.at.dest);
}

// The answer, if it has arrived. -1 means "not yet", which is different from 0
// meaning "the clipboard is empty" — a caller polling this needs to tell those
// apart.
fn text(s as *Selection, buf as *u8, cap as i64) as i64 {
    if (s.ready == 0) { return 0 - 1; }
    let is i64 as n with mut = s.got_len;
    if (n > cap - 1) { n = cap - 1; }
    if (n < 0) { n = 0; }
    let is i64 as i with mut = 0;
    while (i < n) { buf[i] = s.got[i]; i = i + 1; }
    buf[n] = cast(u8, 0);
    return n;
}

fn pending(s as *Selection) as i32 { return s.pending; }
fn ready(s as *Selection) as i32 { return s.ready; }
