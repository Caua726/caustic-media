// window/x11/clipboard.cst — there is no clipboard in X.
//
// There is an *owner*. A client says "I own the CLIPBOARD selection"; another
// client asks the server who that is and sends it a request; the owner answers
// by writing the data onto a property of the requestor's window and sending a
// SelectionNotify. The server stores nothing. Quit the program and the
// clipboard is empty, which is why desktops run a clipboard manager whose only
// job is to own selections on behalf of programs that exited.
//
// Three selections are served here: CLIPBOARD (Ctrl+C), PRIMARY (what is
// selected) and XdndSelection (what this program drags, dnd.cst's). Each owns
// a transfer.Offer — text, a PNG, files — answered by target: TARGETS;
// UTF8_STRING, text/plain;charset=utf-8, text/plain, TEXT and STRING
// (Latin-1, as ICCCM has it) for text; image/png; text/uri-list.
//
// **Answering is not optional.** A SelectionRequest this program ignores leaves
// the client that sent it waiting. So ../window.cst's pump services it before
// the event reaches the ring.
//
// **Large data goes INCR.** Above one request's worth, the owner writes the
// property type INCR and then a chunk each time the requestor deletes the
// property, a zero-length one last; a requestor does the reverse. Both ways
// are here: Outgoing transfers watch the requestor's window (its
// PropertyNotify comes to this connection — the pump hands events for windows
// of no one here to foreign()), incoming ones this window's property.
//
// **Asking is asynchronous.** request() sends a request and returns; the
// answer arrives with the events, into one of two slots: PASTE (the clipboard
// or the primary selection, asked for by the program) and DROP (a drop's
// data, asked for by dnd.cst). An answer that stops coming — an owner that
// died mid-INCR — is given up after TIMEOUT_MS: ready, empty.
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "bind/x.cst" as x;
use "bind/xlib.cst" as xlib;
use "bind/xevent.cst" as xev;
use "../transfer.cst" as transfer;

// Which selection.
let is i32 as CLIPBOARD with imut = 0;
let is i32 as PRIMARY   with imut = 1;
let is i32 as XDND      with imut = 2;

// Which answer slot.
let is i32 as PASTE with imut = 0;
let is i32 as DROP  with imut = 1;

let is i64 as TIMEOUT_MS with imut = 10000;
let is i32 as MAX_OUT with imut = 8;

// An incoming slot's state.
let is i32 as _IDLE    with imut = 0;
let is i32 as _WAITING with imut = 1;
let is i32 as _INCR    with imut = 2;
let is i32 as _READY   with imut = 3;

// The selection each slot last asked, for a refused text target's next try.
let is [2]i64 as _current_selection with mut;

struct Atoms {
    clipboard    as i64;
    primary      as i64;
    xdnd         as i64;   // XdndSelection
    targets      as i64;
    multiple     as i64;
    utf8_string  as i64;
    text_utf8    as i64;   // text/plain;charset=utf-8
    text_plain   as i64;   // text/plain
    string_atom  as i64;
    text         as i64;
    png          as i64;   // image/png
    uri_list     as i64;   // text/uri-list
    incr         as i64;
    atom         as i64;
    integer      as i64;
    paste_prop   as i64;   // where answers to PASTE land on our window
    drop_prop    as i64;   // and to DROP
}

// One answer asked for. A format asked for of the clipboard or the primary
// selection is looked for among the owner's TARGETS first (probing), its best
// target then asked for: an owner may answer a target it does not have with
// what it has (xclip does), so asking blind would hand text over as a PNG.
struct Incoming {
    state    as i32;
    format   as i32;      // what is asked: transfer.TEXT, PNG, FILES; 0 for TARGETS
    target   as i64;      // the target asked for now
    fallback as i32;      // TEXT asked blind: how many of the text targets were refused
    probing  as i32;      // TARGETS asked first, for format
    got      as i32;      // the format that arrived; 0 for none
    offered  as i32;      // TARGETS: the formats offered, bits
    data     as transfer.Bytes;
    last_ms  as i64;      // when it was asked or last progressed
}

// One INCR answer being sent.
struct Outgoing {
    active    as i32;
    _pad      as i32;
    requestor as i64;
    property  as i64;
    target    as i64;     // the type written
    data      as transfer.Bytes;   // its own copy: the offer may change meanwhile
    sent      as i64;
    prev_mask as i64;     // what this connection selected on the requestor before
    last_ms   as i64;
}

struct Selection {
    at    as Atoms;
    own   as [3]transfer.Offer;
    owned as [3]i32;
    in    as [2]Incoming;
    out   as [8]Outgoing;
    chunk as i64;         // the most bytes put in one property; more goes INCR
}

fn init(s as *Selection, d as *u8) as void {
    s.at.clipboard   = xlib.XInternAtom(d, "CLIPBOARD", 0);
    s.at.primary     = xlib.XInternAtom(d, "PRIMARY", 0);
    s.at.xdnd        = xlib.XInternAtom(d, "XdndSelection", 0);
    s.at.targets     = xlib.XInternAtom(d, "TARGETS", 0);
    s.at.multiple    = xlib.XInternAtom(d, "MULTIPLE", 0);
    s.at.utf8_string = xlib.XInternAtom(d, "UTF8_STRING", 0);
    s.at.text_utf8   = xlib.XInternAtom(d, transfer.MIME_UTF8, 0);
    s.at.text_plain  = xlib.XInternAtom(d, "text/plain", 0);
    s.at.string_atom = xlib.XInternAtom(d, "STRING", 0);
    s.at.text        = xlib.XInternAtom(d, "TEXT", 0);
    s.at.png         = xlib.XInternAtom(d, transfer.MIME_PNG, 0);
    s.at.uri_list    = xlib.XInternAtom(d, transfer.MIME_URIS, 0);
    s.at.incr        = xlib.XInternAtom(d, "INCR", 0);
    s.at.atom        = xlib.XInternAtom(d, "ATOM", 0);
    s.at.integer     = xlib.XInternAtom(d, "INTEGER", 0);
    s.at.paste_prop  = xlib.XInternAtom(d, "CAUSTIC_SELECTION", 0);
    s.at.drop_prop   = xlib.XInternAtom(d, "CAUSTIC_DND", 0);
    let is i32 as k with mut = 0;
    while (k < 3) { transfer.offer_init(&s.own[k]); s.owned[k] = 0; k = k + 1; }
    k = 0;
    while (k < 2) {
        mem.memzero(cast(*u8, &s.in[k]), sizeof(Incoming));
        transfer.bytes_init(&s.in[k].data);
        k = k + 1;
    }
    k = 0;
    while (k < MAX_OUT) {
        mem.memzero(cast(*u8, &s.out[k]), sizeof(Outgoing));
        transfer.bytes_init(&s.out[k].data);
        k = k + 1;
    }
    // A request's worth of bytes, less its header: XMaxRequestSize counts
    // 4-byte units. Capped, as other toolkits do, so that a large answer is
    // chunked rather than one huge request.
    let is i64 as most with mut = xlib.XMaxRequestSize(d) * 4 - 100;
    if (most > 262144) { most = 262144; }
    if (most < 4096) { most = 4096; }
    s.chunk = most;
}

fn close(s as *Selection, d as *u8) as void {
    let is i32 as k with mut = 0;
    while (k < 3) { transfer.offer_free(&s.own[k]); s.owned[k] = 0; k = k + 1; }
    k = 0;
    while (k < 2) { transfer.bytes_free(&s.in[k].data); s.in[k].state = _IDLE; k = k + 1; }
    k = 0;
    while (k < MAX_OUT) { _out_end(s, d, k); k = k + 1; }
}

fn _sel_atom(s as *Selection, which as i32) as i64 {
    if (which == PRIMARY) { return s.at.primary; }
    if (which == XDND) { return s.at.xdnd; }
    return s.at.clipboard;
}

fn _which(s as *Selection, atom as i64) as i32 {
    if (atom == s.at.clipboard) { return CLIPBOARD; }
    if (atom == s.at.primary) { return PRIMARY; }
    if (atom == s.at.xdnd) { return XDND; }
    return 0 - 1;
}

// --- Owning ---

// The selection which owned by win with what o offers (copied): 1, or 0 when
// the server says another owns it after all, or it could not be kept.
fn set(s as *Selection, d as *u8, win as i64, which as i32, o as *transfer.Offer, time_ms as i64) as i32 {
    if (which < 0 || which > 2) { return 0; }
    let is transfer.Offer as copy with mut;
    transfer.offer_init(&copy);
    if ((o.formats & transfer.TEXT) != 0 && transfer.offer_text(&copy, o.text.data, o.text.len) == 0) { transfer.offer_free(&copy); return 0; }
    if ((o.formats & transfer.PNG) != 0 && transfer.offer_png(&copy, o.png.data, o.png.len) == 0) { transfer.offer_free(&copy); return 0; }
    if ((o.formats & transfer.FILES) != 0 && transfer.offer_files(&copy, o.paths.data, o.count) == 0) { transfer.offer_free(&copy); return 0; }
    transfer.offer_free(&s.own[which]);
    s.own[which] = copy;
    s.owned[which] = 1;
    xlib.XSetSelectionOwner(d, _sel_atom(s, which), win, time_ms);
    // The server is the authority on who owns it, so ask rather than assume:
    // a race with a clipboard manager is real and losing it silently is worse
    // than reporting it.
    if (xlib.XGetSelectionOwner(d, _sel_atom(s, which)) != win) {
        transfer.offer_free(&s.own[which]);
        s.owned[which] = 0;
        return 0;
    }
    return 1;
}

fn owns(s as *Selection, d as *u8, win as i64, which as i32) as i32 {
    if (xlib.XGetSelectionOwner(d, _sel_atom(s, which)) == win) { return 1; }
    return 0;
}

// Let go of a selection owned.
fn disown(s as *Selection, d as *u8, win as i64, which as i32) as void {
    if (which < 0 || which > 2 || s.owned[which] == 0) { return; }
    if (xlib.XGetSelectionOwner(d, _sel_atom(s, which)) == win) {
        xlib.XSetSelectionOwner(d, _sel_atom(s, which), 0, x.CurrentTime);
    }
    transfer.offer_free(&s.own[which]);
    s.owned[which] = 0;
}

// --- Answering, from inside the pump ---

// The bytes for target out of offer o, with the type they are written as;
// 0 when the offer has nothing for it.
fn _convert(s as *Selection, o as *transfer.Offer, target as i64, out as *transfer.Bytes, type_out as *i64) as i32 {
    if (target == s.at.png && (o.formats & transfer.PNG) != 0) {
        *type_out = target;
        return transfer.bytes_set(out, o.png.data, o.png.len);
    }
    if (target == s.at.uri_list && (o.formats & transfer.FILES) != 0) {
        *type_out = target;
        return transfer.bytes_set(out, o.uris.data, o.uris.len);
    }
    if ((o.formats & transfer.TEXT) == 0) { return 0; }
    if (target == s.at.utf8_string || target == s.at.text_utf8 || target == s.at.text_plain) {
        *type_out = target;
        return transfer.bytes_set(out, o.text.data, o.text.len);
    }
    if (target == s.at.text) {
        // TEXT: the owner's choice of encoding, said in the type.
        *type_out = s.at.utf8_string;
        return transfer.bytes_set(out, o.text.data, o.text.len);
    }
    if (target == s.at.string_atom) {
        *type_out = target;
        return _latin1(o.text.data, o.text.len, out);
    }
    return 0;
}

// UTF-8 as ISO Latin-1, STRING's encoding: a character beyond it a '?'.
fn _latin1(p as *u8, n as i64, out as *transfer.Bytes) as i32 {
    transfer.bytes_clear(out);
    if (transfer.reserve(out, n) == 0) { return 0; }
    let is i64 as i with mut = 0;
    let is i64 as m with mut = 0;
    while (i < n) {
        let is i64 as c = cast(i64, p[i]) & 255;
        let is i64 as cp with mut = c;
        let is i64 as len with mut = 1;
        if (c >= 0xf0) { len = 4; cp = 256; }
        else if (c >= 0xe0) { len = 3; cp = 256; }
        else if (c >= 0xc0 && i + 1 < n) { len = 2; cp = ((c & 31) << 6) | (cast(i64, p[i + 1]) & 63); }
        if (cp > 255) { cp = 63; }
        out.data[m] = cast(u8, cp);
        m = m + 1;
        i = i + len;
    }
    out.len = m;
    out.data[m] = 0;
    return 1;
}

// The targets offer o can be had as, TARGETS first: into t, how many.
fn _targets(s as *Selection, o as *transfer.Offer, t as *i64) as i32 {
    let is i32 as n with mut = 0;
    t[n] = s.at.targets; n = n + 1;
    if ((o.formats & transfer.TEXT) != 0) {
        t[n] = s.at.utf8_string; n = n + 1;
        t[n] = s.at.text_utf8; n = n + 1;
        t[n] = s.at.text_plain; n = n + 1;
        t[n] = s.at.text; n = n + 1;
        t[n] = s.at.string_atom; n = n + 1;
    }
    if ((o.formats & transfer.PNG) != 0) { t[n] = s.at.png; n = n + 1; }
    if ((o.formats & transfer.FILES) != 0) { t[n] = s.at.uri_list; n = n + 1; }
    return n;
}

fn _notify(d as *u8, rq as *xev.XSelectionRequestEvent, property as i64) as void {
    let is xev.XEvent as out;
    xev.clear(&out);
    let is *xev.XSelectionEvent as sn = xev.selection(&out);
    sn.kind = x.SelectionNotify;
    sn.send_event = 1;
    sn.display = d;
    sn.requestor = rq.requestor;
    sn.selection = rq.selection;
    sn.target = rq.target;
    sn.time = rq.time;
    sn.property = property;
    xlib.XSendEvent(d, rq.requestor, 0, 0, cast(*u8, &out));
    xlib.XFlush(d);
}

// A SelectionRequest answered: written whole, or begun as INCR.
fn _serve(s as *Selection, d as *u8, rq as *xev.XSelectionRequestEvent) as void {
    let is i32 as which = _which(s, rq.selection);
    // A requestor from before ICCCM sends property = None meaning "use the
    // target atom as the property name".
    let is i64 as prop with mut = rq.property;
    if (prop == x.None) { prop = rq.target; }
    if (which < 0 || s.owned[which] == 0) { _notify(d, rq, x.None); return; }
    let is *transfer.Offer as o = &s.own[which];
    if (rq.target == s.at.targets) {
        let is [12]i64 as t;
        let is i32 as n = _targets(s, o, &t[0]);
        xlib.XChangeProperty(d, rq.requestor, prop, s.at.atom, 32, x.PropModeReplace, cast(*u8, &t[0]), n);
        _notify(d, rq, prop);
        return;
    }
    // A slot of its own: a copy of what is sent, written now or chunk by chunk.
    let is i32 as k = _out_slot(s, d);
    let is *Outgoing as og = &s.out[k];
    let is i64 as ptype with mut = 0;
    if (_convert(s, o, rq.target, &og.data, &ptype) == 0) { _notify(d, rq, x.None); return; }
    if (og.data.len <= s.chunk) {
        xlib.XChangeProperty(d, rq.requestor, prop, ptype, 8, x.PropModeReplace, og.data.data, cast(i32, og.data.len));
        transfer.bytes_clear(&og.data);
        _notify(d, rq, prop);
        return;
    }
    // INCR: the property says how much is coming; each delete of it by the
    // requestor asks for the next chunk. Its window's PropertyNotify is
    // selected first, what this connection had selected there kept.
    let is xlib.XWindowAttributes as wa;
    let is i64 as prev with mut = 0;
    if (xlib.XGetWindowAttributes(d, rq.requestor, cast(*u8, &wa)) != 0) { prev = wa.your_event_mask; }
    xlib.XSelectInput(d, rq.requestor, prev | x.PropertyChangeMask | x.StructureNotifyMask);
    og.active = 1;
    og.requestor = rq.requestor;
    og.property = prop;
    og.target = ptype;
    og.sent = 0;
    og.prev_mask = prev;
    og.last_ms = time.now_ms();
    let is i64 as size = og.data.len;
    xlib.XChangeProperty(d, rq.requestor, prop, s.at.incr, 32, x.PropModeReplace, cast(*u8, &size), 1);
    _notify(d, rq, prop);
}

// A free outgoing slot — or, all busy, the one waiting longest, ended.
fn _out_slot(s as *Selection, d as *u8) as i32 {
    let is i32 as k with mut = 0;
    let is i32 as oldest with mut = 0;
    while (k < MAX_OUT) {
        if (s.out[k].active == 0) { return k; }
        if (s.out[k].last_ms < s.out[oldest].last_ms) { oldest = k; }
        k = k + 1;
    }
    _out_end(s, d, oldest);
    return oldest;
}

fn _out_end(s as *Selection, d as *u8, k as i32) as void {
    let is *Outgoing as og = &s.out[k];
    if (og.active == 1) { xlib.XSelectInput(d, og.requestor, og.prev_mask); }
    og.active = 0;
    og.requestor = 0;
    // Sent in chunks: as large as INCR made it, not kept.
    transfer.bytes_free(&og.data);
}

// The requestor deleted the property: the next chunk, or the empty one that
// ends it.
fn _out_next(s as *Selection, d as *u8, k as i32) as void {
    let is *Outgoing as og = &s.out[k];
    let is i64 as n with mut = og.data.len - og.sent;
    if (n > s.chunk) { n = s.chunk; }
    if (n < 0) { n = 0; }
    xlib.XChangeProperty(d, og.requestor, og.property, og.target, 8, x.PropModeReplace,
                         cast(*u8, cast(i64, og.data.data) + og.sent), cast(i32, n));
    xlib.XFlush(d);
    og.last_ms = time.now_ms();
    if (n == 0) { _out_end(s, d, k); return; }
    og.sent = og.sent + n;
}

// An event on a requestor's window during an INCR answer — a window of no
// one here, or our own when we asked ourselves: its deleting the property
// asks for the next chunk; its destruction ends the answer. 1 when it was one
// of those.
fn foreign(s as *Selection, d as *u8, e as *xev.XEvent) as i32 {
    let is i32 as ty = xev.kind(e);
    if (ty != x.PropertyNotify && ty != x.DestroyNotify) { return 0; }
    let is i64 as target = xev.any(e).window;
    let is i32 as k with mut = 0;
    while (k < MAX_OUT) {
        let is *Outgoing as og = &s.out[k];
        if (og.active == 1 && og.requestor == target) {
            if (ty == x.DestroyNotify) { og.active = 0; _out_end(s, d, k); return 1; }
            let is *xev.XPropertyEvent as pe = xev.property(e);
            if (pe.atom == og.property && pe.state == x.PropertyDelete) { _out_next(s, d, k); return 1; }
        }
        k = k + 1;
    }
    return 0;
}

// Feeds one event of win's. 1 when it was the selections' and the program is
// not to see it; 2 when a DROP answer just came (dnd.cst finishes the drop).
fn answer(s as *Selection, d as *u8, win as i64, e as *xev.XEvent) as i32 {
    let is i32 as ty = xev.kind(e);

    // Somebody else took the selection. Drop what we were holding: keeping it
    // would mean answering requests for a selection we no longer own.
    if (ty == x.SelectionClear) {
        let is *xev.XSelectionClearEvent as sc = xev.selection_clear(e);
        let is i32 as which = _which(s, sc.selection);
        if (which >= 0) { transfer.offer_free(&s.own[which]); s.owned[which] = 0; }
        return 1;
    }
    if (ty == x.SelectionRequest) {
        _serve(s, d, xev.selection_request(e));
        return 1;
    }
    if (ty == x.SelectionNotify) {
        let is *xev.XSelectionEvent as sn = xev.selection(e);
        let is i32 as slot with mut = 0 - 1;
        if (sn.property == s.at.paste_prop || (sn.property == x.None && s.in[PASTE].state == _WAITING && sn.target == s.in[PASTE].target)) { slot = PASTE; }
        if (sn.property == s.at.drop_prop || (sn.property == x.None && s.in[DROP].state == _WAITING && sn.target == s.in[DROP].target)) { slot = DROP; }
        if (slot < 0) { return 0; }
        let is *Incoming as in = &s.in[slot];
        if (in.state != _WAITING || sn.target != in.target) { return 1; }   // an answer to an older question
        if (sn.property == x.None) {
            if (_fallback(s, d, win, slot) == 1) { return 1; }
            _done(in, 0);
            return _finished(slot);
        }
        return _receive(s, d, win, slot);
    }
    if (ty == x.PropertyNotify) {
        if (foreign(s, d, e) == 1) { return 1; }
        let is *xev.XPropertyEvent as pe = xev.property(e);
        if (pe.state != x.PropertyNewValue) { return 0; }
        let is i32 as slot with mut = 0 - 1;
        if (pe.atom == s.at.paste_prop) { slot = PASTE; }
        if (pe.atom == s.at.drop_prop) { slot = DROP; }
        if (slot < 0 || s.in[slot].state != _INCR) { return 0; }
        return _chunk(s, d, win, slot);
    }
    return 0;
}

fn _finished(slot as i32) as i32 {
    if (slot == DROP) { return 2; }
    return 1;
}

fn _prop_of(s as *Selection, slot as i32) as i64 {
    if (slot == DROP) { return s.at.drop_prop; }
    return s.at.paste_prop;
}

// The target asked for now: the selection's owner asked again.
fn _ask(s as *Selection, d as *u8, win as i64, slot as i32, target as i64) as void {
    let is *Incoming as in = &s.in[slot];
    in.target = target;
    in.state = _WAITING;
    in.last_ms = time.now_ms();
    xlib.XConvertSelection(d, _current_selection[slot], target, _prop_of(s, slot), win, x.CurrentTime);
    xlib.XFlush(d);
}

// A target refused. An owner without TARGETS: the format's own target asked
// for blind. A text target asked blind: the next one — UTF8_STRING, then
// text/plain;charset=utf-8, then STRING. 1 when another was asked for.
fn _fallback(s as *Selection, d as *u8, win as i64, slot as i32) as i32 {
    let is *Incoming as in = &s.in[slot];
    if (in.probing == 1) {
        in.probing = 0;
        if (in.format == 0) { return 0; }
        _ask(s, d, win, slot, _blind(s, in.format));
        return 1;
    }
    if (in.format != transfer.TEXT) { return 0; }
    in.fallback = in.fallback + 1;
    if (in.fallback == 1) { _ask(s, d, win, slot, s.at.text_utf8); return 1; }
    if (in.fallback == 2) { _ask(s, d, win, slot, s.at.string_atom); return 1; }
    if (in.fallback == 3) { _ask(s, d, win, slot, s.at.text_plain); return 1; }
    return 0;
}

// The target a format is asked for by without knowing the owner's.
fn _blind(s as *Selection, format as i32) as i64 {
    if (format == transfer.PNG) { return s.at.png; }
    if (format == transfer.FILES) { return s.at.uri_list; }
    return s.at.utf8_string;
}

fn _done(in as *Incoming, got as i32) as void {
    in.state = _READY;
    in.got = got;
    if (got == 0) { transfer.bytes_clear(&in.data); }
}

// The whole of a property on our window, appended to the slot's bytes, then
// deleted (which is what tells an INCR sender to go on): its type, -1 when
// it could not be read.
fn _read_prop(s as *Selection, d as *u8, win as i64, slot as i32, nitems_out as *i64) as i64 {
    let is *Incoming as in = &s.in[slot];
    let is i64 as prop = _prop_of(s, slot);
    let is i64 as offset with mut = 0;
    let is i64 as ptype with mut = 0 - 1;
    let is i64 as total with mut = 0;
    while (1 == 1) {
        let is i64 as ty with mut = 0;
        let is i32 as fmt with mut = 0;
        let is i64 as nitems with mut = 0;
        let is i64 as after with mut = 0;
        let is *u8 as data with mut = cast(*u8, 0);
        if (xlib.XGetWindowProperty(d, win, prop, offset, 65536, 0, 0, cast(*u8, &ty), cast(*u8, &fmt),
                                    cast(*u8, &nitems), cast(*u8, &after), cast(*u8, &data)) != x.Success) {
            break;
        }
        ptype = ty;
        if (cast(i64, data) != 0) {
            // Xlib hands a format-32 property as longs; ours are bytes or atoms.
            let is i64 as bytes with mut = nitems;
            if (fmt == 16) { bytes = nitems * 2; }
            if (fmt == 32) { bytes = nitems * 8; }
            if (ty != s.at.incr && transfer.append(&in.data, data, bytes) == 0) {
                xlib.XFree(data);
                xlib.XDeleteProperty(d, win, prop);
                *nitems_out = 0 - 1;
                return 0 - 1;
            }
            total = total + nitems;
            xlib.XFree(data);
            if (fmt == 8) { offset = offset + (nitems + 3) / 4; } else { offset = offset + nitems; }
        }
        if (after == 0 || cast(i64, data) == 0) { break; }
    }
    xlib.XDeleteProperty(d, win, prop);
    xlib.XFlush(d);
    *nitems_out = total;
    return ptype;
}

fn _receive(s as *Selection, d as *u8, win as i64, slot as i32) as i32 {
    let is *Incoming as in = &s.in[slot];
    transfer.bytes_clear(&in.data);
    let is i64 as n with mut = 0;
    let is i64 as ptype = _read_prop(s, d, win, slot, &n);
    if (ptype == s.at.incr) {
        // Chunks follow, one a PropertyNotify; the delete above asked for the
        // first.
        transfer.bytes_clear(&in.data);
        in.state = _INCR;
        in.last_ms = time.now_ms();
        return 1;
    }
    if (ptype < 0 || n < 0) { _done(in, 0); return _finished(slot); }
    if (_arrived(s, d, win, slot, ptype) == 0) { return 1; }
    return _finished(slot);
}

fn _chunk(s as *Selection, d as *u8, win as i64, slot as i32) as i32 {
    let is *Incoming as in = &s.in[slot];
    let is i64 as before = in.data.len;
    let is i64 as n with mut = 0;
    let is i64 as ptype = _read_prop(s, d, win, slot, &n);
    in.last_ms = time.now_ms();
    if (n < 0) { _done(in, 0); return _finished(slot); }
    if (in.data.len == before) {
        // The empty chunk: all of it has come.
        if (_arrived(s, d, win, slot, ptype) == 0) { return 1; }
        return _finished(slot);
    }
    return 1;
}

// What came, as what was asked for: TARGETS read as formats — and, probing
// for a format, its best target among them asked for next; STRING made
// UTF-8. 1 when the answer is complete, 0 when another was asked for.
fn _arrived(s as *Selection, d as *u8, win as i64, slot as i32, ptype as i64) as i32 {
    let is *Incoming as in = &s.in[slot];
    if (in.format == 0 || in.probing == 1) {
        in.offered = 0;
        let is i64 as text with mut = 0;   // the best text target offered
        let is i32 as rank with mut = 9;
        let is i64 as k with mut = 0;
        while (k + 8 <= in.data.len) {
            let is i64 as t = *cast(*i64, cast(i64, in.data.data) + k);
            if (t == s.at.png) { in.offered = in.offered | transfer.PNG; }
            if (t == s.at.uri_list) { in.offered = in.offered | transfer.FILES; }
            let is i32 as r = _text_rank(s, t);
            if (r < 9) { in.offered = in.offered | transfer.TEXT; }
            if (r < rank) { rank = r; text = t; }
            k = k + 8;
        }
        transfer.bytes_clear(&in.data);
        if (in.format == 0 || (in.offered & in.format) == 0) { _done(in, 0); return 1; }
        in.probing = 0;
        let is i64 as target with mut = text;
        if (in.format == transfer.PNG) { target = s.at.png; }
        if (in.format == transfer.FILES) { target = s.at.uri_list; }
        _ask(s, d, win, slot, target);
        return 0;
    }
    if (in.format == transfer.TEXT && ptype == s.at.string_atom) {
        // Latin-1: each byte its code point, made UTF-8.
        let is transfer.Bytes as u with mut;
        transfer.bytes_init(&u);
        let is i64 as i with mut = 0;
        let is i32 as ok with mut = 1;
        while (i < in.data.len && ok == 1) {
            let is i64 as c = cast(i64, in.data.data[i]) & 255;
            let is [2]u8 as e;
            if (c < 128) { e[0] = cast(u8, c); ok = transfer.append(&u, &e[0], 1); }
            else { e[0] = cast(u8, 192 | (c >> 6)); e[1] = cast(u8, 128 | (c & 63)); ok = transfer.append(&u, &e[0], 2); }
            i = i + 1;
        }
        transfer.bytes_free(&in.data);
        in.data = u;
        if (ok == 0) { _done(in, 0); return 1; }
    }
    _done(in, in.format);
    return 1;
}

// A text target's preference: UTF-8 by name first, STRING last; 9 for not
// text.
fn _text_rank(s as *Selection, t as i64) as i32 {
    if (t == s.at.utf8_string) { return 0; }
    if (t == s.at.text_utf8) { return 1; }
    if (t == s.at.text_plain) { return 2; }
    if (t == s.at.string_atom) { return 3; }
    return 9;
}

// --- Asking ---

// The selection which (CLIPBOARD, PRIMARY, XDND) asked for as format —
// transfer.TEXT, PNG, FILES, or 0 for which formats it offers — into slot,
// at time (CurrentTime, or the drop's). known: the target to ask by, when the
// owner's types are known already (a drop's, from its XdndEnter); 0 to look
// for the best among its TARGETS first. Whatever slot was waiting for is
// forgotten. 1 when asked.
fn request(s as *Selection, d as *u8, win as i64, slot as i32, which as i32, format as i32, known as i64, time_ms as i64) as i32 {
    if (slot < 0 || slot > 1 || which < 0 || which > 2) { return 0; }
    if (format != 0 && format != transfer.TEXT && format != transfer.PNG && format != transfer.FILES) { return 0; }
    let is *Incoming as in = &s.in[slot];
    let is i64 as target with mut = s.at.targets;
    in.probing = 0;
    if (format != 0) {
        if (known != 0) { target = known; } else { in.probing = 1; }
    }
    // A leftover INCR property from a request given up on: gone first.
    xlib.XDeleteProperty(d, win, _prop_of(s, slot));
    transfer.bytes_clear(&in.data);
    in.state = _WAITING;
    in.format = format;
    in.target = target;
    in.fallback = 0;
    in.got = 0;
    in.offered = 0;
    in.last_ms = time.now_ms();
    _current_selection[slot] = _sel_atom(s, which);
    xlib.XConvertSelection(d, _sel_atom(s, which), target, _prop_of(s, slot), win, time_ms);
    xlib.XFlush(d);
    return 1;
}

fn _expire(in as *Incoming) as void {
    if ((in.state == _WAITING || in.state == _INCR) && time.now_ms() - in.last_ms > TIMEOUT_MS) { _done(in, 0); }
}

// Answers whose requestor stopped asking for the next chunk, given up: their
// copies freed, its window's events as they were.
fn tick(s as *Selection, d as *u8) as void {
    let is i32 as k with mut = 0;
    while (k < MAX_OUT) {
        if (s.out[k].active == 1 && time.now_ms() - s.out[k].last_ms > TIMEOUT_MS) { _out_end(s, d, k); }
        k = k + 1;
    }
}

// Milliseconds until a request waiting on its answer, or an answer waiting on
// its requestor, is given up; -1 when none waits.
fn due(s as *Selection) as i64 {
    let is i64 as best with mut = 0 - 1;
    let is i32 as k with mut = 0;
    while (k < 2 + MAX_OUT) {
        let is i64 as since with mut = 0 - 1;
        if (k < 2) {
            if (s.in[k].state == _WAITING || s.in[k].state == _INCR) { since = s.in[k].last_ms; }
        } else if (s.out[k - 2].active == 1) { since = s.out[k - 2].last_ms; }
        if (since >= 0) {
            let is i64 as left with mut = TIMEOUT_MS + 1 - (time.now_ms() - since);
            if (left < 0) { left = 0; }
            if (best < 0 || left < best) { best = left; }
        }
        k = k + 1;
    }
    return best;
}

// Whether slot's answer came (then got/data/length/offered have it).
fn ready(s as *Selection, slot as i32) as i32 {
    _expire(&s.in[slot]);
    return cast(i32, s.in[slot].state == _READY);
}

// Whether slot's answer is still awaited.
fn pending(s as *Selection, slot as i32) as i32 {
    _expire(&s.in[slot]);
    return cast(i32, s.in[slot].state == _WAITING || s.in[slot].state == _INCR);
}

// The format that came: what was asked for, or 0 when none could be had.
fn got(s as *Selection, slot as i32) as i32 {
    if (s.in[slot].state != _READY) { return 0; }
    return s.in[slot].got;
}

fn data(s as *Selection, slot as i32) as *u8 {
    if (s.in[slot].state != _READY || s.in[slot].got == 0) { return cast(*u8, 0); }
    return s.in[slot].data.data;
}

fn length(s as *Selection, slot as i32) as i64 {
    if (s.in[slot].state != _READY || s.in[slot].got == 0) { return 0; }
    return s.in[slot].data.len;
}

// The formats offered, as a request of format 0 found them.
fn offered(s as *Selection, slot as i32) as i32 {
    if (s.in[slot].state != _READY) { return 0; }
    return s.in[slot].offered;
}

// The slot's answer, once read, let go: idle again.
fn forget(s as *Selection, slot as i32) as void {
    s.in[slot].state = _IDLE;
    s.in[slot].got = 0;
    transfer.bytes_clear(&s.in[slot].data);
}
