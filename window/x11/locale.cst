// window/x11/locale.cst — one libc call, kept on its own so it costs nothing.
//
// `setlocale` is the only function in this whole directory that is not libX11,
// and it exists here for one reason: XOpenIM consults the C locale, and in the
// default "C" locale it finds no input method however many are running.
//
// --- Why its own file ---
//
// An import is not free. This directory measured that already: cursor.cst and
// monitors.cst are deliberately NOT imported by window.cst, because importing a
// module that calls into a shared object makes that object reachable from main
// and puts it in DT_NEEDED — for every program, whether or not it ever calls.
//
// The same would happen here. text.cst is otherwise pure libX11 and safe to
// forward from the hub; folding setlocale into it would add libc.so.6 to the
// DT_NEEDED of every program that opens a window, and tools/check_needed.sh
// would stop reporting two entries for the cube.
//
// So the one libc call lives alone. A program that wants an input method to be
// findable calls this first, accepts the third DT_NEEDED entry, and everything
// else stays where it was:
//
//     use "…/window/x11/locale.cst" as locale;
//
//     locale.use_environment();          // now libc.so.6 is linked
//     text.open_method(&in, d, xid);     // and XOpenIM can find one
//
// --- What it costs, honestly ---
//
// Nothing that was not already there. libX11 links libc, so it is already
// mapped into the address space of any program using this backend — `ldd` on
// the cube example shows libc.so.6 arriving through libX11. Calling it here
// adds a DIRECT dependency, which is a line in the binary's DT_NEEDED rather
// than a library that was not going to be loaded anyway.

// The locale categories, from locale.h. Only LC_CTYPE matters to Xlib: it is
// the one that decides what a character is, and what multibyte input means.
let is i32 as LC_CTYPE   with imut = 0;
let is i32 as LC_NUMERIC with imut = 1;
let is i32 as LC_TIME    with imut = 2;
let is i32 as LC_COLLATE with imut = 3;
let is i32 as LC_MONETARY with imut = 4;
let is i32 as LC_MESSAGES with imut = 5;
let is i32 as LC_ALL     with imut = 6;

extern "libc.so.6" fn setlocale(category as i32, locale as *u8) as *u8;

// Whatever LANG and LC_* say, which is what every program that respects the
// user's settings does. Returns the locale name, or null if it could not be
// set — a machine with the locale uninstalled says so here rather than by an
// input method silently not appearing.
fn use_environment() as *u8 {
    return setlocale(LC_CTYPE, "");
}

// A specific one, for a program that wants to pin it.
fn use_name(name as *u8) as *u8 {
    return setlocale(LC_CTYPE, name);
}

// What is currently set, without changing it. Passing null as the locale is
// how setlocale is asked rather than told.
fn current() as *u8 {
    return setlocale(LC_CTYPE, cast(*u8, 0));
}
