// window/x11/xfixes_link_test.cst — every libXfixes.so.3 symbol resolves, or this never runs.
//
// 37 declarations transcribed by hand. The dominant failure mode is not a
// wrong type, it is a wrong NAME: one transposed letter produces a declaration
// that compiles, links against nothing, and fails the first time some program
// far from here calls it.
//
// This catches all of them at once, before main, on every CI run:
//
//   The compiler emits a library import at the CALL SITE, not at the
//   declaration, so a declaration nobody calls is invisible to the linker.
//   Every function therefore has to be called somewhere for this to mean
//   anything — ../tools/check_symbols.sh asserts that none was forgotten.
//
//   The calls sit behind `if (sink != 7777)`, and sink comes from argc. That is
//   not a constant, so the branch survives dead-code elimination and the call
//   sites are emitted — but the condition is never true, so libXfixes.so.3 is never
//   actually entered. Nothing here opens a display or touches the X server.
//
//   caustic-ld turns those imports into DT_NEEDED plus one PLT relocation each,
//   and sets DT_FLAGS = DF_BIND_NOW, so the loader resolves every name at exec.
//   A single misspelling and this process dies before main, which is the loud
//   failure a silent one deserves.
//
// So the assertion is the exit code itself: reaching main at all is the result.
//
// --- Why one binary per shared object ---
//
// Not tidiness. Measured against this toolchain: when a single binary imports
// more than roughly 256 distinct extern symbols, caustic-ld emits the PLT
// relocations for every soname but the DT_NEEDED entry for only the FIRST one.
// The binary then dies at exec with `undefined symbol`, naming a function whose
// library was never recorded.
//
// Bisected: 240 imports across two sonames links and runs; 280 does not. A
// binary with 770 imports and a SINGLE soname is fine, so the count alone is
// not the trigger — it is the count crossing that line with a second library
// present. The 1024-entry cstimport table is not it either; that one fails
// loudly and this is silent.
//
// Splitting by soname keeps each binary under the line and, when one does fail,
// says which library it was.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "bind/xfixes.cst" as xfixes;

// From argc, so the compiler cannot fold the guard away. Written once and never
// 7777, so no call below ever executes.
let is i64 as sink with mut = 0;

fn _touch_0() as void {
    if (sink != 7777) { return; }
    xfixes.XFixesChangeCursor(cast(*u8, 0), 0, 0);
    xfixes.XFixesChangeCursorByName(cast(*u8, 0), 0, cast(*u8, 0));
    xfixes.XFixesChangeSaveSet(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0));
    xfixes.XFixesCopyRegion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesCreatePointerBarrier(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0),
                                      cast(i32, 0), cast(i32, 0), cast(i32, 0), cast(*u8, 0));
    xfixes.XFixesCreateRegion(cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
    xfixes.XFixesCreateRegionFromBitmap(cast(*u8, 0), 0);
    xfixes.XFixesCreateRegionFromGC(cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesCreateRegionFromPicture(cast(*u8, 0), 0);
    xfixes.XFixesCreateRegionFromWindow(cast(*u8, 0), 0, cast(i32, 0));
    xfixes.XFixesDestroyPointerBarrier(cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesDestroyRegion(cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesExpandRegion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(u32, 0), cast(u32, 0),
                              cast(u32, 0), cast(u32, 0));
    xfixes.XFixesFetchRegion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesFetchRegionAndBounds(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesGetClientDisconnectMode(cast(*u8, 0));
    xfixes.XFixesGetCursorImage(cast(*u8, 0));
    xfixes.XFixesGetCursorName(cast(*u8, 0), 0, cast(*u8, 0));
    xfixes.XFixesHideCursor(cast(*u8, 0), 0);
    xfixes.XFixesIntersectRegion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesInvertRegion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesQueryExtension(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesQueryVersion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesRegionExtents(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesSelectCursorInput(cast(*u8, 0), 0, 0);
    xfixes.XFixesSelectSelectionInput(cast(*u8, 0), 0, 0, 0);
    xfixes.XFixesSetClientDisconnectMode(cast(*u8, 0), cast(i32, 0));
    xfixes.XFixesSetCursorName(cast(*u8, 0), 0, cast(*u8, 0));
    xfixes.XFixesSetGCClipRegion(cast(*u8, 0), cast(*u8, 0), cast(i32, 0), cast(i32, 0),
                                 cast(*u8, 0));
    xfixes.XFixesSetPictureClipRegion(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(*u8, 0));
    xfixes.XFixesSetRegion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
    xfixes.XFixesSetWindowShapeRegion(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0),
                                      cast(*u8, 0));
    xfixes.XFixesShowCursor(cast(*u8, 0), 0);
    xfixes.XFixesSubtractRegion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesTranslateRegion(cast(*u8, 0), cast(*u8, 0), cast(i32, 0), cast(i32, 0));
    xfixes.XFixesUnionRegion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xfixes.XFixesVersion();
}
fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    sink = argc;

    // Never true. The point is that the compiler cannot know that.
    if (sink == 7777) {
        _touch_0();
    }

    io.printf("libXfixes.so.3: 37 symbols resolved at exec\n");
    return 0;
}
