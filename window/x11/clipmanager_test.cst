// window/x11/clipmanager_test.cst — what the clipboard holds kept by the
// desktop's clipboard manager when the window that owns it closes (ICCCM's
// clipboard manager protocol), against a manager of our own making, under
// Xvfb:
//   sh window/x11/tools/run_headless.sh ./build/x11_clipmanager_test
// The program owns CLIPBOARD with text and text/html; a second run of this
// same program, as the manager, owns CLIPBOARD_MANAGER. The window closed, the
// manager is asked SAVE_TARGETS, asks for TARGETS and then for both formats at
// once (MULTIPLE), writes what it got to build/clipmanager_saved and says it
// has it. What it saved is what was offered; closing with no manager, nothing
// waits.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/process.cst" as process;
use "std/env.cst" as env;
use "std/os/linux.cst" as linux;
use "x11.cst" as x11;
use "clipboard.cst" as clipboard;
use "../transfer.cst" as transfer;
use "bind/x.cst" as x;
use "bind/xlib.cst" as xlib;
use "bind/xevent.cst" as xev;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("FAIL: %s\n", name); }
}

fn same(a as *u8, n as i64, b as *u8) as i32 {
    let is i64 as k with mut = 0;
    while (b[k] != 0) { k = k + 1; }
    return cast(i32, k == n && mem.memcmp(a, b, n) == 0);
}

// --- The manager: a second run of this program ---

let is [8192]u8 as saved with mut;
let is i64 as saved_n with mut = 0;

fn save(p as *u8, n as i64) as void {
    let is i64 as k with mut = 0;
    while (k < n && saved_n < 8000) { saved[saved_n] = p[k]; saved_n = saved_n + 1; k = k + 1; }
}

// The bytes of prop on w, appended to what is saved, the property deleted.
fn take(d as *u8, w as i64, prop as i64) as void {
    let is i64 as ty with mut = 0;
    let is i32 as fmt with mut = 0;
    let is i64 as n with mut = 0;
    let is i64 as after with mut = 0;
    let is *u8 as data with mut = cast(*u8, 0);
    xlib.XGetWindowProperty(d, w, prop, 0, 4096, 1, 0, cast(*u8, &ty), cast(*u8, &fmt), cast(*u8, &n), cast(*u8, &after),
                            cast(*u8, &data));
    if (cast(i64, data) != 0) {
        if (fmt == 8) { save(data, n); }
        xlib.XFree(data);
    }
}

// A SelectionNotify on w within 3 seconds: its property, None when refused
// or when none came.
fn notified(d as *u8, w as i64) as i64 {
    let is xev.XEvent as e;
    let is i64 as until = time.now_ms() + 3000;
    while (time.now_ms() < until) {
        if (xlib.XCheckTypedWindowEvent(d, w, x.SelectionNotify, cast(*u8, &e)) != 0) { return xev.selection(&e).property; }
        time.sleep_ms(5);
    }
    return x.None;
}

fn manager() as i32 {
    let is *u8 as d = xlib.XOpenDisplay(cast(*u8, 0));
    if (cast(i64, d) == 0) { return 2; }
    let is i64 as w = xlib.XCreateSimpleWindow(d, xlib.XDefaultRootWindow(d), 0, 0, cast(u32, 1), cast(u32, 1), cast(u32, 0), 0, 0);
    let is i64 as mgr = xlib.XInternAtom(d, "CLIPBOARD_MANAGER", 0);
    let is i64 as clip = xlib.XInternAtom(d, "CLIPBOARD", 0);
    let is i64 as save_targets = xlib.XInternAtom(d, "SAVE_TARGETS", 0);
    let is i64 as multiple = xlib.XInternAtom(d, "MULTIPLE", 0);
    let is i64 as utf8 = xlib.XInternAtom(d, "UTF8_STRING", 0);
    let is i64 as html = xlib.XInternAtom(d, "text/html", 0);
    let is i64 as p1 = xlib.XInternAtom(d, "MGR_P1", 0);
    let is i64 as p2 = xlib.XInternAtom(d, "MGR_P2", 0);
    let is i64 as pm = xlib.XInternAtom(d, "MGR_MULTI", 0);
    xlib.XSetSelectionOwner(d, mgr, w, x.CurrentTime);
    xlib.XFlush(d);
    // Waiting to be asked SAVE_TARGETS.
    let is xev.XEvent as e;
    let is i64 as until = time.now_ms() + 15000;
    while (time.now_ms() < until) {
        if (xlib.XCheckTypedEvent(d, x.SelectionRequest, cast(*u8, &e)) != 0) {
            let is xev.XSelectionRequestEvent as rq = *xev.selection_request(&e);
            if (rq.selection != mgr || rq.target != save_targets) { continue; }
            // What CLIPBOARD has: TARGETS, then both at once.
            xlib.XConvertSelection(d, clip, xlib.XInternAtom(d, "TARGETS", 0), p1, w, x.CurrentTime);
            xlib.XFlush(d);
            let is i32 as listed = cast(i32, notified(d, w) == p1);
            xlib.XDeleteProperty(d, w, p1);
            let is [4]i64 as pairs;
            pairs[0] = utf8; pairs[1] = p1; pairs[2] = html; pairs[3] = p2;
            xlib.XChangeProperty(d, w, pm, xlib.XInternAtom(d, "ATOM_PAIR", 0), 32, x.PropModeReplace, cast(*u8, &pairs[0]), 4);
            xlib.XConvertSelection(d, clip, multiple, pm, w, x.CurrentTime);
            xlib.XFlush(d);
            let is i32 as both = cast(i32, notified(d, w) == pm);
            take(d, w, p1);
            save("|", 1);
            take(d, w, p2);
            let is i64 as fd = linux.open("build/clipmanager_saved", linux.O_WRONLY | linux.O_CREAT | linux.O_TRUNC, 420);
            if (fd >= 0) {
                if (listed == 1 && both == 1) { linux.write(fd, &saved[0], saved_n); }
                linux.close(fd);
            }
            // Said had: SelectionNotify with the request's property.
            let is xev.XEvent as out;
            xev.clear(&out);
            let is *xev.XSelectionEvent as sn = xev.selection(&out);
            sn.kind = x.SelectionNotify;
            sn.send_event = 1;
            sn.display = d;
            sn.requestor = rq.requestor;
            sn.selection = rq.selection;
            sn.target = rq.target;
            sn.time = rq.time;
            sn.property = rq.property;
            xlib.XSendEvent(d, rq.requestor, 0, 0, cast(*u8, &out));
            xlib.XFlush(d);
            xlib.XCloseDisplay(d);
            return 0;
        }
        time.sleep_ms(5);
    }
    xlib.XCloseDisplay(d);
    return 1;
}

// --- The program ---

fn read_file(path as *u8, out as *u8, cap as i64) as i64 {
    let is i64 as fd = linux.open(path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    let is i64 as n = linux.read(fd, out, cap);
    linux.close(fd);
    return n;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (env.argc() > 1 && same(env.argv(1), 7, "manager") == 1) { return manager(); }
    linux.unlink("build/clipmanager_saved");

    // No manager: closing does not wait.
    let is x11.window.Window as lone with mut = x11.open("no manager", 120, 80);
    let is transfer.Offer as o with mut;
    transfer.offer_init(&o);
    transfer.offer_text(&o, "kept", 4);
    check("owned with no manager", x11.selection_set(&lone, clipboard.CLIPBOARD, &o) == 1);
    let is i64 as t0 = time.now_ms();
    x11.close(&lone);
    check("closed with no manager: at once", time.now_ms() - t0 < 1000);

    // A manager running.
    let is x11.window.Window as win with mut = x11.open("clipboard manager", 120, 80);
    transfer.offer_free(&o);
    transfer.offer_init(&o);
    transfer.offer_text(&o, "kept by the manager", 19);
    transfer.offer_named(&o, "text/html", 9, "<b>kept</b>", 11);
    check("owned with text and HTML", x11.selection_set(&win, clipboard.CLIPBOARD, &o) == 1);
    let is [4]i64 as args;
    args[0] = cast(i64, env.argv(0)); args[1] = cast(i64, "manager"); args[2] = 0;
    let is i64 as pid = process.spawnp(env.argv(0), cast(*u8, &args[0]));
    check("the manager started", pid > 0);
    // Until it owns CLIPBOARD_MANAGER.
    let is *u8 as d = x11.display(&win);
    let is i64 as mgr = xlib.XInternAtom(d, "CLIPBOARD_MANAGER", 0);
    let is i64 as until = time.now_ms() + 5000;
    while (xlib.XGetSelectionOwner(d, mgr) == x.None && time.now_ms() < until) {
        x11.pump(&win);
        time.sleep_ms(5);
    }
    check("the manager there", xlib.XGetSelectionOwner(d, mgr) != x.None);
    x11.close(&win);
    let is i32 as status with mut = 0;
    linux.wait4(pid, &status, 0, cast(*u8, 0));
    check("the manager done", process.exit_code_of(status) == 0);
    let is [256]u8 as got;
    let is i64 as n = read_file("build/clipmanager_saved", &got[0], 255);
    check("closed: the manager kept the text and the HTML, asked for at once", n > 0 &&
          same(&got[0], n, "kept by the manager|<b>kept</b>") == 1);
    transfer.offer_free(&o);
    if (fails == 0) {
        io.printf("x11 clipboard manager: all checks passed\n");
        return 0;
    }
    io.printf("x11 clipboard manager: %d failures\n", fails);
    return 1;
}
