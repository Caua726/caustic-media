// window/x11/startup.cst — startup notification, the launchee's side
// (freedesktop's startup-notification-spec): the program that started this
// one put an ID in DESKTOP_STARTUP_ID; the first window carries it in
// _NET_STARTUP_ID, and once that window is shown the launcher — a taskbar
// spinning a busy cursor — is told the start is over: "remove: ID=..." in
// _NET_STARTUP_INFO_BEGIN / _NET_STARTUP_INFO client messages on the root,
// twenty bytes a message. The ID is taken from the environment, so programs
// started from this one do not inherit it.
use "bind/x.cst" as x;
use "bind/xlib.cst" as xlib;
use "bind/xevent.cst" as xev;
use "../linux/launch.cst" as launch;

let is [256]u8 as _id with mut;
let is i64 as _id_len with mut = 0 - 1;   // -1: not taken yet

// The first window's: the ID taken, and set on xid before it is mapped. 1
// when there was one.
fn begin(d as *u8, xid as i64) as i32 {
    if (_id_len >= 0) { return 0; }
    _id_len = launch.take("DESKTOP_STARTUP_ID", &_id[0], 256);
    if (_id_len <= 0) { return 0; }
    let is i64 as utf8 = xlib.XInternAtom(d, "UTF8_STRING", 0);
    xlib.XChangeProperty(d, xid, xlib.XInternAtom(d, "_NET_STARTUP_ID", 0), utf8, 8, x.PropModeReplace,
                         &_id[0], cast(i32, _id_len));
    return 1;
}

// The window shown: the launcher told the start is over, once.
fn complete(d as *u8, xid as i64) as void {
    if (_id_len <= 0) { return; }
    _remove(d, xid, &_id[0], _id_len);
    _id_len = 0;
}

// Another start's sequence, its ID id (n bytes), over too: that start
// handed its work to this program's window, xid, and left
// (org.freedesktop.Application's desktop-startup-id).
fn finish(d as *u8, xid as i64, id as *u8, n as i64) as void {
    if (n > 0) { _remove(d, xid, id, n); }
}

// The X server time a startup ID says the start began at — the launcher's
// "_TIME<digits>" at its end — or 0 when it says none.
fn time_of(id as *u8, n as i64) as i64 {
    let is i64 as at with mut = n - 1;
    while (at >= 0 && id[at] >= 48 && id[at] <= 57) { at = at - 1; }
    if (at == n - 1 || at < 4) { return 0; }
    if (id[at - 4] != 95 || id[at - 3] != 84 || id[at - 2] != 73 || id[at - 1] != 77 || id[at] != 69) { return 0; }
    let is i64 as t with mut = 0;
    let is i64 as i with mut = at + 1;
    while (i < n) {
        t = t * 10 + cast(i64, id[i]) - 48;
        if (t > 4294967295) { return 0; }
        i = i + 1;
    }
    return t;
}

// The longest ID said: as long as one kept (launch.take's, a handed-over
// token's).
let is i64 as MAX_ID with imut = 255;

// "remove: ID=<id>" on the root, from xid, in twenty-byte pieces; nothing
// for an ID longer than MAX_ID.
fn _remove(d as *u8, xid as i64, id as *u8, id_len as i64) as void {
    if (id_len > MAX_ID) { return; }
    // The head, every byte escaped, the zero.
    let is [528]u8 as text with mut;
    let is *u8 as head = "remove: ID=";
    let is i64 as n with mut = 0;
    while (head[n] != 0) { text[n] = head[n]; n = n + 1; }
    // Spaces, quotes and backslashes escaped, as the spec quotes values.
    let is i64 as i with mut = 0;
    while (i < id_len) {
        let is u8 as c = id[i];
        if (c == 32 || c == 34 || c == 92) { text[n] = 92; n = n + 1; }
        text[n] = c;
        n = n + 1;
        i = i + 1;
    }
    text[n] = 0;
    n = n + 1;
    let is i64 as root = xlib.XDefaultRootWindow(d);
    let is i64 as begin_atom = xlib.XInternAtom(d, "_NET_STARTUP_INFO_BEGIN", 0);
    let is i64 as more_atom = xlib.XInternAtom(d, "_NET_STARTUP_INFO", 0);
    let is i64 as at with mut = 0;
    while (at < n) {
        let is xev.XEvent as e;
        xev.clear(&e);
        let is *xev.XClientMessageEvent as c = xev.client(&e);
        xev.any(&e).kind = x.ClientMessage;
        c.window = xid;
        c.format = 8;
        c.message_type = more_atom;
        if (at == 0) { c.message_type = begin_atom; }
        let is *u8 as bytes = cast(*u8, &c.data[0]);
        let is i64 as k with mut = 0;
        while (k < 20) {
            if (at + k < n) { bytes[k] = text[at + k]; } else { bytes[k] = 0; }
            k = k + 1;
        }
        xlib.XSendEvent(d, root, 0, x.PropertyChangeMask, cast(*u8, &e));
        at = at + 20;
    }
    xlib.XFlush(d);
}
