// window/x11/xidev_test.cst — what XInput 2 says of the devices behind the
// pointer, from the structs the server hands over, built here as it would
// fill them:
//   ./build/x11_xidev_test
// A device's scroll classes learned with its valuators' values as the
// baselines; a report's packed values read by the mask; notches as motion
// over the increment, whichever way the axis runs; a wheel's in 120ths with
// whole notches counted from the rest, a touchpad's continuous; a report
// after the pointer came back only a baseline; motion the server made up
// from buttons moving the baseline but said by no scroll; a device not yet
// known asked for; core buttons 4–7 at the moment smooth scrolling moved
// their axis the server's emulation of it. A pen known by its "Abs
// Pressure" valuator: its pressure over the valuator's range, its tilt in
// degrees, each as last said when a report leaves it out.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "bind/xinput2.cst" as xi2;
use "xidev.cst" as xidev;
use "../../input/event.cst" as ie;
use "window.cst" as window;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

// The pen a window's XI2 learns: pressure 0 to 2048 on valuator 2; any
// other device a mouse.
let is xi2.XIValuatorClassInfo as pen_pressure with mut;
let is [1]*u8 as pen_classes with mut;
fn learn_pen(d as *u8, id as i32) as void {
    let is *xidev.State as st = window.xi_state();
    if (id != 20) {
        xidev.learn(st, id, cast(**u8, 0), 0, 0);
        return;
    }
    xidev.set_labels(st, 501, 502, 503);
    mem.memzero(cast(*u8, &pen_pressure), sizeof(xi2.XIValuatorClassInfo));
    pen_pressure.kind = xi2.XIValuatorClass;
    pen_pressure.number = 2;
    pen_pressure.label = 501;
    pen_pressure.max = 2048.0;
    pen_classes[0] = cast(*u8, &pen_pressure);
    xidev.learn(st, id, cast(**u8, &pen_classes[0]), 1, 0);
}

// A device's classes: valuators 2 (vertical scroll) and 3 (horizontal), at
// v2 and v3 now, a notch every inc2 and inc3 of them.
let is xi2.XIValuatorClassInfo as val2 with mut;
let is xi2.XIValuatorClassInfo as val3 with mut;
let is xi2.XIScrollClassInfo as scroll2 with mut;
let is xi2.XIScrollClassInfo as scroll3 with mut;
let is [4]*u8 as classes with mut;

fn device(v2 as f64, v3 as f64, inc2 as f64, inc3 as f64) as **u8 {
    mem.memzero(cast(*u8, &val2), sizeof(xi2.XIValuatorClassInfo));
    mem.memzero(cast(*u8, &val3), sizeof(xi2.XIValuatorClassInfo));
    mem.memzero(cast(*u8, &scroll2), sizeof(xi2.XIScrollClassInfo));
    mem.memzero(cast(*u8, &scroll3), sizeof(xi2.XIScrollClassInfo));
    val2.kind = xi2.XIValuatorClass; val2.number = 2; val2.value = v2;
    val3.kind = xi2.XIValuatorClass; val3.number = 3; val3.value = v3;
    scroll2.kind = xi2.XIScrollClass; scroll2.number = 2; scroll2.scroll_type = xi2.XIScrollTypeVertical; scroll2.increment = inc2;
    scroll3.kind = xi2.XIScrollClass; scroll3.number = 3; scroll3.scroll_type = xi2.XIScrollTypeHorizontal; scroll3.increment = inc3;
    // Scroll classes first, valuators after: the order the server lists
    // them in is its own.
    classes[0] = cast(*u8, &scroll2);
    classes[1] = cast(*u8, &val2);
    classes[2] = cast(*u8, &scroll3);
    classes[3] = cast(*u8, &val3);
    return cast(**u8, &classes[0]);
}

// An XI_Motion report from device id at time: valuators 0 and 1 (x, y) and
// those of mask's bits 2 and 3 with the values given.
let is xi2.XIDeviceEvent as ev with mut;
let is [4]u8 as mask with mut;
let is [8]f64 as values with mut;

fn report(id as i32, time as u64, with2 as i32, v2 as f64, with3 as i32, v3 as f64) as *xi2.XIDeviceEvent {
    mem.memzero(cast(*u8, &ev), sizeof(xi2.XIDeviceEvent));
    ev.evtype = xi2.XI_Motion;
    ev.sourceid = id;
    ev.time = time;
    ev.event_x = 40.5;
    ev.event_y = 30.25;
    mask[0] = cast(u8, 3); mask[1] = cast(u8, 0); mask[2] = cast(u8, 0); mask[3] = cast(u8, 0);
    let is i64 as n with mut = 0;
    values[0] = 40.5; values[1] = 30.25; n = 2;
    if (with2 == 1) { mask[0] = cast(u8, cast(i64, mask[0]) | 4); values[n] = v2; n = n + 1; }
    if (with3 == 1) { mask[0] = cast(u8, cast(i64, mask[0]) | 8); values[n] = v3; n = n + 1; }
    ev.valuators.mask_len = 4;
    ev.valuators.mask = &mask[0];
    ev.valuators.values = &values[0];
    return &ev;
}

fn main() as i32 {
    let is xidev.State as s with mut;
    xidev.init(&s);
    let is ie.Event as e;

    // --- A wheel's scroll axes ---
    check("a device not yet known: asked for", xidev.motion(&s, report(9, 100, 1, 130.0, 0, 0.0), &e) == 0 - 1);
    xidev.learn(&s, 9, device(100.0, 0.0, 15.0, 15.0), 4, 0);
    check("learned", xidev.knows(&s, 9) == 1 && xidev.knows(&s, 8) == 0);
    ie.clear(&e);
    check("down two notches from where it stood: a wheel's, in 120ths, two steps",
          xidev.motion(&s, report(9, 101, 1, 130.0, 0, 0.0), &e) == 1 && e.kind == ie.SCROLL &&
          e.source == ie.SCROLL_WHEEL && e.dy == 2.0 && e.dx == 0.0 && e.value120_y == 240 && e.steps_y == 2 &&
          e.x == 40 && e.y == 30);
    ie.clear(&e);
    check("half a notch left: no whole step yet",
          xidev.motion(&s, report(9, 102, 0, 0.0, 1, 0.0 - 7.5), &e) == 1 && e.dx == 0.0 - 0.5 &&
          e.value120_x == 0 - 60 && e.steps_x == 0 && e.dy == 0.0);
    ie.clear(&e);
    check("the other half: a step", xidev.motion(&s, report(9, 103, 0, 0.0, 1, 0.0 - 15.0), &e) == 1 && e.steps_x == 0 - 1);
    ie.clear(&e);
    check("both at once, the packed values read by the mask",
          xidev.motion(&s, report(9, 104, 1, 115.0, 1, 0.0), &e) == 1 && e.dy == 0.0 - 1.0 && e.dx == 1.0);
    ie.clear(&e);
    check("only the pointer moved: no scroll", xidev.motion(&s, report(9, 105, 0, 0.0, 0, 0.0), &e) == 0);

    // --- The emulation: the same moment, the same axis ---
    ie.clear(&e);
    xidev.motion(&s, report(9, 200, 1, 130.0, 0, 0.0), &e);
    check("button 5 at the moment it moved down: emulated", xidev.emulated(&s, 200, 5) == 1 && xidev.emulated(&s, 200, 4) == 1);
    check("a tilt then: not emulated, nothing moved sideways", xidev.emulated(&s, 200, 7) == 0);
    check("another moment: a real button", xidev.emulated(&s, 201, 5) == 0);

    // --- Away and back: a baseline, not a jump ---
    xidev.rebase(&s);
    ie.clear(&e);
    check("the first report after: only where it stands", xidev.motion(&s, report(9, 300, 1, 900.0, 0, 0.0), &e) == 0);
    ie.clear(&e);
    check("then motion from there", xidev.motion(&s, report(9, 301, 1, 915.0, 0, 0.0), &e) == 1 && e.dy == 1.0);

    // --- An axis running the other way, a touchpad ---
    xidev.learn(&s, 9, device(0.0, 0.0, 0.0 - 15.0, 15.0), 4, 0);
    ie.clear(&e);
    check("a negative increment: the other way", xidev.motion(&s, report(9, 400, 1, 15.0, 0, 0.0), &e) == 1 && e.dy == 0.0 - 1.0);
    xidev.learn(&s, 12, device(50.0, 50.0, 10.0, 10.0), 4, 1);
    ie.clear(&e);
    check("a touchpad's fingers: continuous, no notches",
          xidev.motion(&s, report(12, 500, 1, 53.0, 1, 45.0), &e) == 1 && e.source == ie.SCROLL_CONTINUOUS &&
          e.dy == 0.3 && e.dx == 0.0 - 0.5 && e.steps_y == 0 && e.value120_y == 0);

    // --- Forgotten when its device changes ---
    xidev.forget(&s, 12);
    check("forgotten: asked for again", xidev.knows(&s, 12) == 0 &&
          xidev.motion(&s, report(12, 600, 1, 60.0, 0, 0.0), &e) == 0 - 1 && xidev.knows(&s, 9) == 1);
    // A class list with no scroll class: known, nothing to scroll.
    classes[0] = cast(*u8, &val2);
    xidev.learn(&s, 13, cast(**u8, &classes[0]), 1, 0);
    ie.clear(&e);
    check("no scroll classes: known, never a scroll", xidev.knows(&s, 13) == 1 &&
          xidev.motion(&s, report(13, 700, 1, 99.0, 0, 0.0), &e) == 0);

    // --- Motion the server made up from a device's buttons ---
    xidev.learn(&s, 9, device(100.0, 0.0, 15.0, 15.0), 4, 0);
    ie.clear(&e);
    let is *xi2.XIDeviceEvent as made = report(9, 800, 1, 115.0, 0, 0.0);
    made.flags = xi2.XIPointerEmulated;
    check("made up: no scroll, the button says it", xidev.motion(&s, made, &e) == 0 && xidev.emulated(&s, 800, 5) == 0);
    ie.clear(&e);
    check("and the baseline moved with it", xidev.motion(&s, report(9, 801, 1, 130.0, 0, 0.0), &e) == 1 && e.dy == 1.0);

    // --- A pen ---
    xidev.set_labels(&s, 501, 502, 503);
    let is xi2.XIValuatorClassInfo as pressure;
    let is xi2.XIValuatorClassInfo as tilt_x;
    let is xi2.XIValuatorClassInfo as tilt_y;
    mem.memzero(cast(*u8, &pressure), sizeof(xi2.XIValuatorClassInfo));
    mem.memzero(cast(*u8, &tilt_x), sizeof(xi2.XIValuatorClassInfo));
    mem.memzero(cast(*u8, &tilt_y), sizeof(xi2.XIValuatorClassInfo));
    pressure.kind = xi2.XIValuatorClass; pressure.number = 2; pressure.label = 501; pressure.min = 0.0; pressure.max = 2048.0;
    tilt_x.kind = xi2.XIValuatorClass; tilt_x.number = 3; tilt_x.label = 502; tilt_x.min = 0.0 - 64.0; tilt_x.max = 63.0;
    tilt_y.kind = xi2.XIValuatorClass; tilt_y.number = 4; tilt_y.label = 503; tilt_y.min = 0.0 - 64.0; tilt_y.max = 63.0;
    classes[0] = cast(*u8, &pressure);
    classes[1] = cast(*u8, &tilt_x);
    classes[2] = cast(*u8, &tilt_y);
    xidev.learn(&s, 20, cast(**u8, &classes[0]), 3, 0);
    check("a pressure valuator: a pen; a wheel is not", xidev.pen(&s, 20) == 1 && xidev.pen(&s, 9) == 0 &&
          xidev.pen(&s, 77) == 0);
    // Pressure 512 of 2048 and tilt 30, -10: valuators 2, 3, 4.
    let is *xi2.XIDeviceEvent as pe = report(20, 900, 1, 512.0, 1, 30.0);
    mask[0] = cast(u8, 3 | 4 | 8 | 16);
    values[4] = 0.0 - 10.0;
    ie.clear(&e);
    check("its readings: pressure over its range, tilt in degrees",
          xidev.pen_readings(&s, pe, &e) == 1 && e.pressure == 0.25 && e.tilt_x == 30.0 && e.tilt_y == 0.0 - 10.0);
    report(20, 901, 1, 2048.0, 0, 0.0);
    ie.clear(&e);
    check("a report of pressure alone: the tilt as last said",
          xidev.pen_readings(&s, pe, &e) == 1 && e.pressure == 1.0 && e.tilt_x == 30.0 && e.tilt_y == 0.0 - 10.0);
    report(20, 902, 1, 4096.0, 0, 0.0);
    ie.clear(&e);
    check("past its range: held to 1", xidev.pen_readings(&s, pe, &e) == 1 && e.pressure == 1.0);
    ie.clear(&e);
    check("a wheel's readings: none", xidev.pen_readings(&s, report(9, 903, 0, 0.0, 0, 0.0), &e) == 0 &&
          e.pressure == 0.0 - 1.0);

    // --- Through a window: what XI2's events become ---
    let is window.Window as w with mut;
    mem.memzero(cast(*u8, &w), sizeof(window.Window));
    w.input = ie.create();
    window.xi_enable(131, fn_ptr(learn_pen));
    // A pen's first report over it: in range, where, with its readings.
    let is *xi2.XIDeviceEvent as pm = report(20, 1000, 1, 1024.0, 0, 0.0);
    window._xi_motion(&w, pm);
    check("a pen's first report: in range, a pen, its pressure", ie.next(w.input, &e) == 1 && e.kind == ie.PEN_IN &&
          e.detail == ie.TOOL_PEN && e.contact == 20 && e.x == 40 && e.pressure == 0.5 && ie.next(w.input, &e) == 0);
    report(20, 1001, 1, 1536.0, 0, 0.0);
    pm.evtype = xi2.XI_ButtonPress;
    pm.detail = 1;
    window._xi_button(&w, pm, 1);
    check("its tip down: touching", ie.next(w.input, &e) == 1 && e.kind == ie.PEN_DOWN && e.pressure == 0.75);
    report(20, 1002, 0, 0.0, 0, 0.0);
    pm.detail = 2;
    window._xi_button(&w, pm, 1);
    window._xi_button(&w, pm, 0);
    check("its first barrel button pressed and let go",
          ie.next(w.input, &e) == 1 && e.kind == ie.PEN_BUTTON && e.button == 1 && e.detail == ie.PRESSED &&
          ie.next(w.input, &e) == 1 && e.kind == ie.PEN_BUTTON && e.detail == ie.RELEASED);
    pm.detail = 1;
    window._xi_button(&w, pm, 0);
    window._xi_motion(&w, pm);
    check("lifted, hovering", ie.next(w.input, &e) == 1 && e.kind == ie.PEN_UP &&
          ie.next(w.input, &e) == 1 && e.kind == ie.PEN_MOTION);
    window._pen_out(&w);
    check("the pointer leaving the window: out of range", ie.next(w.input, &e) == 1 && e.kind == ie.PEN_OUT &&
          e.contact == 20);
    // A button the server made up — from a touch, from scroll valuators —
    // says nothing; a real one does.
    let is *xi2.XIDeviceEvent as bm = report(30, 1100, 0, 0.0, 0, 0.0);
    bm.evtype = xi2.XI_ButtonPress;
    bm.detail = 1;
    bm.flags = xi2.XIPointerEmulated;
    window._xi_button(&w, bm, 1);
    check("a button made up: nothing", ie.next(w.input, &e) == 0);
    bm.flags = 0;
    window._xi_button(&w, bm, 1);
    check("a real one: pressed", ie.next(w.input, &e) == 1 && e.kind == ie.BUTTON_DOWN && e.button == 1);
    // A touchscreen's finger.
    let is *xi2.XIDeviceEvent as tm = report(40, 1200, 0, 0.0, 0, 0.0);
    tm.evtype = xi2.XI_TouchBegin;
    tm.detail = 7;
    window._xi_touch(&w, tm, xi2.XI_TouchBegin);
    window._xi_touch(&w, tm, xi2.XI_TouchUpdate);
    window._xi_touch(&w, tm, xi2.XI_TouchEnd);
    check("a finger: down, moved, up, by its touch id",
          ie.next(w.input, &e) == 1 && e.kind == ie.TOUCH_DOWN && e.contact == 7 && e.x == 40 && e.y == 30 &&
          ie.next(w.input, &e) == 1 && e.kind == ie.TOUCH_MOTION && ie.next(w.input, &e) == 1 && e.kind == ie.TOUCH_UP);
    // A pinch and a swipe (XI 2.4).
    let is xi2.XIGesturePinchEvent as gp;
    mem.memzero(cast(*u8, &gp), sizeof(xi2.XIGesturePinchEvent));
    gp.detail = 2; gp.event_x = 10.0; gp.event_y = 20.0; gp.delta_x = 3.0; gp.delta_y = 0.0 - 1.5;
    gp.scale = 1.25; gp.delta_angle = 4.0;
    window._xi_gesture(&w, cast(*u8, &gp), xi2.XI_GesturePinchBegin);
    window._xi_gesture(&w, cast(*u8, &gp), xi2.XI_GesturePinchUpdate);
    gp.flags = xi2.XIGesturePinchEventCancelled;
    window._xi_gesture(&w, cast(*u8, &gp), xi2.XI_GesturePinchEnd);
    check("a two-finger pinch: begun, its scale, rotation and motion, cancelled",
          ie.next(w.input, &e) == 1 && e.kind == ie.GESTURE_BEGIN && e.gesture == ie.PINCH && e.fingers == 2 &&
          ie.next(w.input, &e) == 1 && e.kind == ie.GESTURE_UPDATE && e.scale == 1.25 && e.rotation == 4.0 &&
          e.dx == 3.0 && e.dy == 0.0 - 1.5 && e.x == 10 &&
          ie.next(w.input, &e) == 1 && e.kind == ie.GESTURE_END && e.detail == ie.CANCELLED);
    let is xi2.XIGestureSwipeEvent as gs;
    mem.memzero(cast(*u8, &gs), sizeof(xi2.XIGestureSwipeEvent));
    gs.detail = 3; gs.delta_x = 0.0 - 6.0;
    window._xi_gesture(&w, cast(*u8, &gs), xi2.XI_GestureSwipeBegin);
    window._xi_gesture(&w, cast(*u8, &gs), xi2.XI_GestureSwipeUpdate);
    window._xi_gesture(&w, cast(*u8, &gs), xi2.XI_GestureSwipeEnd);
    check("a three-finger swipe: begun, moved, ended",
          ie.next(w.input, &e) == 1 && e.kind == ie.GESTURE_BEGIN && e.gesture == ie.SWIPE && e.fingers == 3 &&
          ie.next(w.input, &e) == 1 && e.kind == ie.GESTURE_UPDATE && e.dx == 0.0 - 6.0 &&
          ie.next(w.input, &e) == 1 && e.kind == ie.GESTURE_END && e.detail == 0);
    ie.destroy(w.input);

    if (fails != 0) {
        io.printf("x11 xidev: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("x11 xidev: all checks passed\n");
    return 0;
}
