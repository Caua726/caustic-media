// Xrm's callback is one function-pointer argument, not flattened parameters.
// The real library parses resources, filters prefixes and stops enumeration.
use "bind/xlib.cst" as xlib;
use "bind/xresource.cst" as xr;
use "std/io.cst" as io;

fn resource(db as *u8, bindings as *u8, quarks as *u8, representation as *u8,
            value as *u8, closure as *u8) as i32 {
    let is *i64 as state = cast(*i64, closure);
    if (cast(i64, db) == 0 || cast(i64, bindings) == 0 || cast(i64, quarks) == 0
        || cast(i64, representation) == 0 || cast(i64, value) == 0) {
        state[5] = 1; return 1;
    }
    if (cast(i64, *cast(**u8, db)) != state[0]) { state[5] = 2; return 1; }
    let is *i32 as names = cast(*i32, quarks);
    if (cast(i64, names[0]) != state[1] || names[2] != 0) { state[5] = 3; return 1; }
    if (cast(i64, names[1]) == state[2]) { state[4] = state[4] | 1; }
    else if (cast(i64, names[1]) == state[3]) { state[4] = state[4] | 2; }
    else { state[5] = 4; return 1; }
    return cast(i32, state[6]);
}

fn main() as i32 {
    xlib.XrmInitialize();
    let is *u8 as db = xr.XrmGetStringDatabase("Caustic.first: 11\nCaustic.second: 29\nOther.third: 97\n");
    if (cast(i64, db) == 0) { return 1; }
    let is [7]i64 as state;
    state[0] = cast(i64, db);
    let is [3]i32 as atoms;
    xr.XrmStringToQuarkList("Caustic.first", cast(*u8, &atoms));
    state[1] = cast(i64, atoms[0]); state[2] = cast(i64, atoms[1]);
    xr.XrmStringToQuarkList("Caustic.second", cast(*u8, &atoms));
    state[3] = cast(i64, atoms[1]);
    state[4] = 0; state[5] = 0; state[6] = 0;
    let is [2]i32 as names; names[0] = cast(i32, state[1]); names[1] = 0;
    let is [2]i32 as classes; classes[0] = names[0]; classes[1] = 0;
    let is i32 as result with mut = 0;
    let is i32 as complete = xr.XrmEnumerateDatabase(db, cast(*u8, &names), cast(*u8, &classes),
                                                     0, fn_ptr(resource), cast(*u8, &state));
    if (complete != 0 || state[4] != 3 || state[5] != 0) { result = 2; }
    state[4] = 0; state[5] = 0; state[6] = 1;
    let is i32 as stopped = xr.XrmEnumerateDatabase(db, cast(*u8, &names), cast(*u8, &classes),
                                                    0, fn_ptr(resource), cast(*u8, &state));
    if (stopped != 1 || (state[4] != 1 && state[4] != 2) || state[5] != 0) { result = 3; }
    xr.XrmStringToQuarkList("Missing", cast(*u8, &names));
    classes[0] = names[0]; state[4] = 0; state[5] = 0; state[6] = 0;
    let is i32 as empty = xr.XrmEnumerateDatabase(db, cast(*u8, &names), cast(*u8, &classes),
                                                  0, fn_ptr(resource), cast(*u8, &state));
    if (empty != 0 || state[4] != 0 || state[5] != 0) { result = 4; }
    xr.XrmDestroyDatabase(db);
    if (result == 0) { io.write_str(io.STDOUT, "Xresource: callback, prefix filtering and stop passed\n"); }
    return result;
}
