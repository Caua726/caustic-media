    xag.XagCreateAssociation(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xag.XagCreateEmbeddedApplicationGroup(cast(*u8, 0), 0, 0, 0, 0, cast(*u8, 0));
    xag.XagCreateNonembeddedApplicationGroup(cast(*u8, 0), cast(*u8, 0));
    xag.XagDestroyApplicationGroup(cast(*u8, 0), 0);
    xag.XagDestroyAssociation(cast(*u8, 0), 0);
    xag.XagGetApplicationGroupAttributes(cast(*u8, 0), 0, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xag.XagQueryApplicationGroup(cast(*u8, 0), 0, cast(*u8, 0));
    xag.XagQueryVersion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xcup.XcupGetReservedColormapEntries(cast(*u8, 0), cast(i32, 0), cast(*u8, 0), cast(*u8, 0));
    xcup.XcupQueryVersion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xcup.XcupStoreColors(cast(*u8, 0), 0, cast(*u8, 0), cast(i32, 0));
    xdbe.XdbeAllocateBackBufferName(cast(*u8, 0), 0, cast(u8, 0));
    xdbe.XdbeBeginIdiom(cast(*u8, 0));
    xdbe.XdbeDeallocateBackBufferName(cast(*u8, 0), 0);
    xdbe.XdbeEndIdiom(cast(*u8, 0));
    xdbe.XdbeFreeVisualInfo(cast(*u8, 0));
}
fn _touch_2() as void {
    if (sink != 7777) { return; }
    xdbe.XdbeGetBackBufferAttributes(cast(*u8, 0), 0);
    xdbe.XdbeGetVisualInfo(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xdbe.XdbeQueryExtension(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
