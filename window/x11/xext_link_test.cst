    xshape.XShapeQueryExtents(cast(*u8, 0), 0, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
