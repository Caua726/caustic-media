fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    sink = argc;

    // Never true. The point is that the compiler cannot know that.
    if (sink == 7777) {
        _touch_0();
        _touch_1();
        _touch_2();
        _touch_3();
        _touch_4();
        _touch_5();
        _touch_6();
        _touch_7();
        _touch_8();
    }

    io.printf("libXext.so.6: 132 symbols resolved at exec\n");
    return 0;
}
