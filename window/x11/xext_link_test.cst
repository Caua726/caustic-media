    xmultibuf.XmbufCreateStereoWindow(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(u32, 0), cast(u32, 0), cast(u32, 0), cast(i32, 0), cast(u32, 0), cast(*u8, 0), 0, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
