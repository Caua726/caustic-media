    if (sink != 7777) { return; }
    xshape.XShapeCombineMask(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0), 0, cast(i32, 0));
    xshape.XShapeCombineRectangles(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0), cast(*u8, 0), cast(i32, 0), cast(i32, 0), cast(i32, 0));
    xshape.XShapeCombineRegion(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0), cast(*u8, 0), cast(i32, 0));
    xshape.XShapeCombineShape(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0), 0, cast(i32, 0), cast(i32, 0));
    xshape.XShapeGetRectangles(cast(*u8, 0), 0, cast(i32, 0), cast(*u8, 0), cast(*u8, 0));
