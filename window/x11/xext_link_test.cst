    xlbx.XLbxQueryExtension(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xlbx.XLbxQueryVersion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xmitmisc.XMITMiscGetBugMode(cast(*u8, 0));
    xmitmisc.XMITMiscQueryExtension(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xmitmisc.XMITMiscSetBugMode(cast(*u8, 0), cast(i32, 0));
