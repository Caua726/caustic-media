    xmultibuf.XmbufQueryExtension(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xsecurity.XSecurityAllocXauth();
    xsecurity.XSecurityFreeXauth(cast(*u8, 0));
    xsecurity.XSecurityGenerateAuthorization(cast(*u8, 0), cast(*u8, 0), 0, cast(*u8, 0), cast(*u8, 0));
    xsecurity.XSecurityQueryExtension(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
