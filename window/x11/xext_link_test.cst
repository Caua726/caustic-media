fn _touch_8() as void {
    if (sink != 7777) { return; }
    xsync.XSyncValueSubtract(cast(*u8, 0), 0, 0, cast(*u8, 0));
    xtestext1.XTestFakeInput(cast(*u8, 0), cast(*u8, 0), 0, 0);
    xtestext1.XTestFlush(cast(*u8, 0));
    xtestext1.XTestGetInput(cast(*u8, 0), 0);
    xtestext1.XTestMovePointer(cast(*u8, 0), 0, 0, 0, 0, 0);
    xtestext1.XTestPressButton(cast(*u8, 0), 0, 0, 0, 0);
    xtestext1.XTestPressKey(cast(*u8, 0), 0, 0, 0, 0);
    xtestext1.XTestQueryInputSize(cast(*u8, 0), cast(*u8, 0));
