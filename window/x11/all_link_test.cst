// window/x11/all_link_test.cst — every library the bindings name, in one binary.
//
// The per-library link tests each prove that one shared object's names resolve.
// This makes all of their calls at once — libX11, libXss, libXext, libXrandr,
// libXcursor, libXfixes and libXi, 1161 imports — because that is the shape of
// a real program: several libraries, one binary.
//
// Reaching main proves every name resolved under BIND_NOW; check_needed.sh,
// run after it, proves all seven sonames were recorded rather than found by
// luck through another library's dependencies.
//
// It does not reproduce the assembler's old cap of 256 imports, though it was
// written for it. The cap was per object file and every link/ module is one,
// each calling a single library — measured against a compiler with the cap put
// back: this binary still records all seven, while one module calling 300 of
// libX11 and then libXext loses libXext and dies at exec. That test belongs to
// the toolchain.
//
// The two libXcursor 1.2.3 functions are left out: on an older library they
// would kill this binary at exec. xcursor_1_2_3_link_test.cst has them.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "link/x11.cst" as x11;
use "link/xss.cst" as xss;
use "link/xext.cst" as xext;
use "link/xrandr.cst" as xrandr;
use "link/xcursor.cst" as xcursor;
use "link/xfixes.cst" as xfixes;
use "link/xi.cst" as xi;

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    x11.touch(argc);
    xss.touch(argc);
    xext.touch(argc);
    xrandr.touch(argc);
    xcursor.touch(argc);
    xfixes.touch(argc);
    xi.touch(argc);
    io.printf("all seven libraries: 1161 symbols resolved at exec\n");
    return 0;
}
