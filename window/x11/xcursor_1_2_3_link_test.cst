// window/x11/xcursor_1_2_3_link_test.cst — the libXcursor 1.2.3 symbols resolve, or this never runs.
//
// The same check as xcursor_link_test.cst, for the two functions that arrived in
// libXcursor 1.2.3 (November 2024): XcursorGetResizable and XcursorSetResizable.
// Ubuntu 24.04 ships 1.2.1, and under BIND_NOW a single call to either kills the
// binary at exec there. In the main test that would take the other 59 down with
// them, so these two get a binary of their own.
//
// tools/run_since.sh runs it only where libXcursor exports them; on an older
// library it reports the skip instead. tools/symbols.txt is where the 1.2.3 is
// recorded, and check_symbols.sh still asserts that both are called here.
//
// The guard is the one xcursor_link_test.cst explains: sink comes from argc, so
// the call sites survive dead-code elimination, and it is never 7777, so
// libXcursor.so.1 is never actually entered.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "link/xcursor_1_2_3.cst" as link;

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    link.touch(argc);
    io.printf("libXcursor.so.1: 2 symbols since 1.2.3 resolved at exec\n");
    return 0;
}
