// window/x11/link/xrandr.cst — calls every libXrandr.so.2 function the bindings declare.
//
// Behind a branch that is never taken: touch() is handed argc, which the compiler
// cannot know, so every call site is emitted and becomes an import, and it is
// never 7777, so the library is never entered. xrandr_link_test.cst makes these
// calls on their own and all_link_test.cst together with every other library's;
// ../tools/check_symbols.sh reads link/ to assert that no declaration is left
// uncalled.
use "../bind/xrandr.cst" as xrandr;

// From argc, so the compiler cannot fold the guard away. Written once and never
// 7777, so no call below ever executes.
let is i64 as sink with mut = 0;

fn _touch_0() as void {
    if (sink != 7777) { return; }
    xrandr.XRRAddOutputMode(cast(*u8, 0), 0, 0);
    xrandr.XRRAllocGamma(cast(i32, 0));
    xrandr.XRRAllocModeInfo(cast(*u8, 0), cast(i32, 0));
    xrandr.XRRAllocateMonitor(cast(*u8, 0), cast(i32, 0));
    xrandr.XRRChangeOutputProperty(cast(*u8, 0), 0, 0, 0, cast(i32, 0), cast(i32, 0),
                                   cast(*u8, 0), cast(i32, 0));
    xrandr.XRRChangeProviderProperty(cast(*u8, 0), 0, 0, 0, cast(i32, 0), cast(i32, 0),
                                     cast(*u8, 0), cast(i32, 0));
    xrandr.XRRConfigCurrentConfiguration(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRConfigCurrentRate(cast(*u8, 0));
    xrandr.XRRConfigRates(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRConfigRotations(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRConfigSizes(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRConfigTimes(cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRConfigureOutputProperty(cast(*u8, 0), 0, 0, cast(i32, 0), cast(i32, 0),
                                      cast(i32, 0), cast(*u8, 0));
    xrandr.XRRConfigureProviderProperty(cast(*u8, 0), 0, 0, cast(i32, 0), cast(i32, 0),
                                        cast(i32, 0), cast(*u8, 0));
    xrandr.XRRCreateMode(cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRDeleteMonitor(cast(*u8, 0), 0, 0);
    xrandr.XRRDeleteOutputMode(cast(*u8, 0), 0, 0);
    xrandr.XRRDeleteOutputProperty(cast(*u8, 0), 0, 0);
    xrandr.XRRDeleteProviderProperty(cast(*u8, 0), 0, 0);
    xrandr.XRRDestroyMode(cast(*u8, 0), 0);
    xrandr.XRRFreeCrtcInfo(cast(*u8, 0));
    xrandr.XRRFreeGamma(cast(*u8, 0));
    xrandr.XRRFreeModeInfo(cast(*u8, 0));
    xrandr.XRRFreeMonitors(cast(*u8, 0));
    xrandr.XRRFreeOutputInfo(cast(*u8, 0));
    xrandr.XRRFreePanning(cast(*u8, 0));
    xrandr.XRRFreeProviderInfo(cast(*u8, 0));
    xrandr.XRRFreeProviderResources(cast(*u8, 0));
    xrandr.XRRFreeScreenConfigInfo(cast(*u8, 0));
    xrandr.XRRFreeScreenResources(cast(*u8, 0));
    xrandr.XRRGetCrtcGamma(cast(*u8, 0), 0);
    xrandr.XRRGetCrtcGammaSize(cast(*u8, 0), 0);
    xrandr.XRRGetCrtcInfo(cast(*u8, 0), cast(*u8, 0), 0);
    xrandr.XRRGetCrtcTransform(cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRGetMonitors(cast(*u8, 0), 0, cast(i32, 0), cast(*u8, 0));
    xrandr.XRRGetOutputInfo(cast(*u8, 0), cast(*u8, 0), 0);
    xrandr.XRRGetOutputPrimary(cast(*u8, 0), 0);
    xrandr.XRRGetOutputProperty(cast(*u8, 0), 0, 0, 0, 0, cast(i32, 0), cast(i32, 0), 0,
                                cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRGetPanning(cast(*u8, 0), cast(*u8, 0), 0);
    xrandr.XRRGetProviderInfo(cast(*u8, 0), cast(*u8, 0), 0);
}

fn _touch_1() as void {
    if (sink != 7777) { return; }
    xrandr.XRRGetProviderProperty(cast(*u8, 0), 0, 0, 0, 0, cast(i32, 0), cast(i32, 0),
                                  0, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0),
                                  cast(*u8, 0));
    xrandr.XRRGetProviderResources(cast(*u8, 0), 0);
    xrandr.XRRGetScreenInfo(cast(*u8, 0), 0);
    xrandr.XRRGetScreenResources(cast(*u8, 0), 0);
    xrandr.XRRGetScreenResourcesCurrent(cast(*u8, 0), 0);
    xrandr.XRRGetScreenSizeRange(cast(*u8, 0), 0, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0),
                                 cast(*u8, 0));
    xrandr.XRRListOutputProperties(cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRListProviderProperties(cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRQueryExtension(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRQueryOutputProperty(cast(*u8, 0), 0, 0);
    xrandr.XRRQueryProviderProperty(cast(*u8, 0), 0, 0);
    xrandr.XRRQueryVersion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xrandr.XRRRates(cast(*u8, 0), cast(i32, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRRootToScreen(cast(*u8, 0), 0);
    xrandr.XRRRotations(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRSelectInput(cast(*u8, 0), 0, cast(i32, 0));
    xrandr.XRRSetCrtcConfig(cast(*u8, 0), cast(*u8, 0), 0, 0, cast(i32, 0),
                            cast(i32, 0), 0, cast(u16, 0), cast(*u8, 0), cast(i32, 0));
    xrandr.XRRSetCrtcGamma(cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRSetCrtcTransform(cast(*u8, 0), 0, cast(*u8, 0), cast(*u8, 0),
                               cast(*u8, 0), cast(i32, 0));
    xrandr.XRRSetMonitor(cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRSetOutputPrimary(cast(*u8, 0), 0, 0);
    xrandr.XRRSetPanning(cast(*u8, 0), cast(*u8, 0), 0, cast(*u8, 0));
    xrandr.XRRSetProviderOffloadSink(cast(*u8, 0), 0, 0);
    xrandr.XRRSetProviderOutputSource(cast(*u8, 0), 0, 0);
    xrandr.XRRSetScreenConfig(cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0), cast(u16, 0), 0);
    xrandr.XRRSetScreenConfigAndRate(cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0), cast(u16, 0),
                                     cast(i16, 0), 0);
    xrandr.XRRSetScreenSize(cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0), cast(i32, 0));
    xrandr.XRRSizes(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRTimes(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xrandr.XRRUpdateConfiguration(cast(*u8, 0));
}

fn touch(s as i64) as void {
    sink = s;
    if (sink == 7777) {
        _touch_0();
        _touch_1();
    }
}
