// window/x11/link/xcursor_1_2_3.cst — calls every libXcursor.so.1 function the bindings declare since libXcursor 1.2.3.
//
// Behind a branch that is never taken: touch() is handed argc, which the compiler
// cannot know, so every call site is emitted and becomes an import, and it is
// never 7777, so the library is never entered. Only xcursor_1_2_3_link_test.cst
// makes these calls — all_link_test.cst leaves them out, since a library older
// than 1.2.3 would kill it at exec. ../tools/check_symbols.sh reads link/ to
// assert that no declaration is left uncalled.
use "../bind/xcursor.cst" as xcursor;

let is i64 as sink with mut = 0;

fn _touch() as void {
    if (sink != 7777) { return; }
    xcursor.XcursorGetResizable(cast(*u8, 0));
    xcursor.XcursorSetResizable(cast(*u8, 0), cast(i32, 0));
}

fn touch(s as i64) as void {
    sink = s;
    if (sink == 7777) {
        _touch();
    }
}
