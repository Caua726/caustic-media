// window/x11/x11_test.cst — does the window actually show what was drawn?
//
// Needs a real X server. tools/run_headless.sh supplies one with Xvfb, which is
// how this runs in CI and over ssh.
//
// The central check is a round trip: fill the frame with a known pattern,
// submit it, then ask the server for its copy of our own window with XGetImage
// and compare byte for byte. ../window.md records why that is the check and not
// a screenshot — the interleaved banding it once produced was visible in a
// screenshot but the screenshot never said whose fault it was, and the first
// two guesses were both wrong. XGetImage answers the actual question: is what
// the server holds what we sent?
//
// The sizes are deliberate. 640x480 is the easy case. 641x481 and 1023x769 are
// not multiples of four in either direction, which is exactly where an XImage's
// bytes_per_line padding stops matching a naive width*4 stride — the failure
// that produced the banding.
//
// Exit code is the number of failures.
use "std/io.cst" as io;
use "std/os.cst" as os;
use "std/mem.cst" as mem;
use "../../gpu/software/target.cst" as tgt;
use "../../math/math.cst" as math;
use "bind/x.cst" as x;
use "bind/xlib.cst" as xlib;
use "bind/xevent.cst" as xev;
use "x11.cst" as x11;

let is i32 as fails with mut = 0;

fn chk(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("  FAIL %s\n", name); }
}

fn chk_i(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

// --- Getting to a state where XGetImage means anything ---
//
// The server will not hand back the contents of a window that was never mapped,
// and a window manager may take a moment to grant one. Pumping until the window
// reports visible is the difference between testing the code and testing a race.
fn settle(w as *x11.window.Window, rounds as i64) as void {
    let is i64 as i with mut = 0;
    while (i < rounds) {
        x11.next_frame(w);
        xlib.XSync(x11.display(w), 0);
        i = i + 1;
    }
}

// The pattern: every pixel distinct enough that a row read at the wrong offset
// cannot coincidentally match. x and y both contribute, so a shifted row and a
// shifted column both show up.
fn pattern(px as i64, py as i64) as i64 {
    let is i64 as r = (px * 7 + py * 3) & 255;
    let is i64 as g = (px * 11 + py * 5) & 255;
    let is i64 as b = (px * 13 + py * 17) & 255;
    return (255 << 24) | (b << 16) | (g << 8) | r;      // 0xAABBGGRR
}

// What the server should be holding: the same pixel with red and blue swapped,
// because that is what submit() does on the way out.
fn expected_x11(packed as i64) as i64 {
    let is i64 as r = packed & 255;
    let is i64 as g = (packed >> 8) & 255;
    let is i64 as b = (packed >> 16) & 255;
    return (r << 16) | (g << 8) | b;
}

fn fill(t as *tgt.Target) as void {
    let is i64 as y with mut = 0;
    while (y < t.height) {
        let is i64 as row = cast(i64, t.color) + y * t.width * 4;
        let is i64 as px with mut = 0;
        while (px < t.width) {
            *cast(*i32, row + px * 4) = cast(i32, pattern(px, y));
            px = px + 1;
        }
        y = y + 1;
    }
}

// Compares what the server holds against the pattern, byte for byte.
//
// --- Why this reads a Pixmap and not the window ---
//
// The obvious check is XGetImage on our own window, and ../window.md records
// that this is how the banding bug was actually found. It works on a plain
// server. It does not work on a compositing one.
//
// Measured here: under XWayland — rootless, so every X window becomes a Wayland
// surface — reading the window back failed three runs in twelve, in three
// different ways. Once BadMatch outright; twice with the server returning
// content that was not what was sent, at a stride that matched exactly
// (2068 == 2068, 2560 == 2560), so not a stride bug. A compositing server is
// under no obligation to retain a window's pixels, and XWayland does not.
//
// A Pixmap is server-side storage nobody composites. Putting the same XImage,
// with the same stride, through the same XPutImage or XShmPutImage and reading
// THAT back tests exactly what this test is for — the stride, the format and
// the red/blue swizzle — and gives the same answer on every server.
//
// The window still gets its real submit() first, so the actual presentation
// path is exercised; what moved is only where the comparison reads from.
fn round_trip(w as *x11.window.Window, label as *u8) as void {
    if (x11.next_frame(w) == 0) { chk("window still open", 0); return; }
    let is tgt.Target as t = x11.acquire(w);
    if (t.width == 0) { chk("acquire gave a buffer", 0); return; }

    let is i64 as cw = t.width;
    let is i64 as ch = t.height;
    chk_i("acquire width matches the window", cw, x11.width(w));
    chk_i("acquire height matches the window", ch, x11.height(w));

    fill(&t);
    // The real path, on the real window. submit() swizzles the buffer in place,
    // so after this the buffer holds what the server was given.
    x11.submit(w);
    xlib.XSync(x11.display(w), 0);

    // Now the same bytes, through the same kind of XImage, into storage the
    // compositor does not own.
    let is *u8 as d = x11.display(w);
    let is i64 as pm = xlib.XCreatePixmap(d, x11.xid(w), cast(u32, cw), cast(u32, ch),
                                          cast(u32, 24));
    if (pm == 0) { chk("pixmap created", 0); return; }

    let is *u8 as img = xlib.XCreateImage(d, x11.visual(w), cast(u32, 24), x.ZPixmap, 0,
                                          t.color, cast(u32, cw), cast(u32, ch), 32,
                                          cast(i32, cw * 4));
    if (cast(i64, img) == 0) { chk("XImage created", 0); xlib.XFreePixmap(d, pm); return; }
    xlib.XPutImage(d, pm, x11.gc(w), img, 0, 0, 0, 0, cast(u32, cw), cast(u32, ch));
    xlib.XSync(d, 0);
    // The data belongs to the window, not to this XImage; clearing the pointer
    // is what stops XDestroyImage from freeing a mapping it does not own.
    let is *xlib.XImage as xw = cast(*xlib.XImage, img);
    xw.data = cast(*u8, 0);
    xlib.XDestroyImage(img);

    let is *u8 as back = xlib.XGetImage(d, pm, 0, 0, cast(u32, cw), cast(u32, ch),
                                        cast(i64, 16777215), x.ZPixmap);
    xlib.XFreePixmap(d, pm);
    if (cast(i64, back) == 0) {
        fails = fails + 1;
        io.printf("  FAIL %s: XGetImage no pixmap devolveu nada\n", label);
        return;
    }
    let is *xlib.XImage as xi = cast(*xlib.XImage, back);

    // The server picks its own stride. Assuming width*4 is precisely the bug
    // this test exists to catch, so read what it says.
    let is i64 as stride = cast(i64, xi.bytes_per_line);
    let is i64 as base = cast(i64, xi.data);
    let is i64 as bad with mut = 0;
    let is i64 as first_x with mut = 0 - 1;
    let is i64 as first_y with mut = 0 - 1;

    let is i64 as y with mut = 0;
    while (y < ch) {
        let is i64 as px with mut = 0;
        while (px < cw) {
            let is i64 as got = cast(i64, *cast(*i32, base + y * stride + px * 4)) & 16777215;
            let is i64 as want = expected_x11(pattern(px, y));
            if (got != want) {
                if (bad == 0) { first_x = px; first_y = y; }
                bad = bad + 1;
            }
            px = px + 1;
        }
        y = y + 1;
    }
    xlib.XDestroyImage(back);

    if (bad != 0) {
        fails = fails + 1;
        io.printf("  FAIL %s %dx%d: %d de %d pixels diferem, primeiro em (%d,%d)\n",
                  label, cw, ch, bad, cw * ch, first_x, first_y);
        io.printf("        stride do servidor=%d, o nosso=%d\n", stride, cw * 4);
    }
}

// --- Opening, against a server that occasionally says no ---
//
// XOpenDisplay against Xvfb fails intermittently under rapid reconnection.
// Measured directly, with no window layer involved: a loop doing 400 bare
// XOpenDisplay/XCloseDisplay pairs failed 0 times on one run and twice on the
// next, the first at connection 144. That is roughly half a percent per
// connection, and this suite makes about thirty, which is why one run in ten
// used to fail somewhere arbitrary.
//
// The retry lives here and not in window.open() on purpose. A library that
// retries cannot tell "the server is briefly busy" from "there is no server",
// and hiding the second behind the first would turn a clear error into a slow
// one. Real programs open one display and keep it; opening thirty in a burst is
// something only a test does, so the test is where the accommodation belongs.
fn open_retry(label as *u8, cw as i64, ch as i64, prefer_shm as i32) as x11.window.Window {
    let is x11.window.Config as c = x11.config(label, cw, ch);
    c.prefer_shm = prefer_shm;
    let is i64 as tries with mut = 0;
    while (tries < 5) {
        let is x11.window.Window as w = x11.open_with(&c);
        if (x11.is_open(&w) == 1) { return w; }
        if (x11.last_error(&w) != x11.window.NO_DISPLAY) { return w; }
        tries = tries + 1;
    }
    return x11.open_with(&c);
}

// --- The tests ---

fn test_round_trip_on(cw as i64, ch as i64, label as *u8, prefer_shm as i32) as void {
    let is x11.window.Window as w = open_retry(label, cw, ch, prefer_shm);
    if (x11.is_open(&w) == 0) {
        fails = fails + 1;
        io.printf("  FAIL %s: %s\n", label, x11.error_name(x11.last_error(&w)));
        return;
    }
    // Asking for SHM does not mean getting it — a container with its own IPC
    // namespace refuses, and so does a remote display. What is asserted is that
    // the fallback HAPPENED and said so, not that SHM was available.
    if (prefer_shm == 0) {
        chk("socket path reports xputimage",
            cast(i32, x11.transport_name(&w)[0] == cast(u8, 120)));   // 'x'
        chk_i("socket path keeps one buffer", x11.image_count(&w), 1);
    } else if (x11.image_count(&w) == 2) {
        chk("shm path reports mit-shm",
            cast(i32, x11.transport_name(&w)[0] == cast(u8, 109)));   // 'm'
    }
    settle(&w, 8);
    // The label has to name the transport. The two paths share only the swizzle
    // — one hands the server a pointer and the other sends the frame down a
    // socket — so a failure that does not say which one it was points nowhere.
    if (prefer_shm == 1 && x11.image_count(&w) == 2) {
        round_trip(&w, "shm");
    } else {
        round_trip(&w, "socket");
    }
    x11.close(&w);
}

// The same picture has to come out of both transports. They share only the
// swizzle: one hands the server a pointer and the other sends 1.2 MB down a
// socket, and a bug in either shows up as a difference here.
fn test_round_trip(cw as i64, ch as i64, label as *u8) as void {
    test_round_trip_on(cw, ch, label, 1);
    test_round_trip_on(cw, ch, label, 0);
}

// Under MIT-SHM the buffers alternate, so acquire has to hand out a different
// one after each submit — a caller that cached the first would be writing into
// a segment the server is reading. On the socket path there is one buffer and
// the same pointer every frame, which is correct rather than a bug.
fn test_buffer_rotation() as void {
    let is x11.window.Window as w = open_retry("rotation", 256, 256, 1);
    if (x11.is_open(&w) == 0) { chk("rotation: window opened", 0); return; }
    settle(&w, 6);

    x11.next_frame(&w);
    let is tgt.Target as a = x11.acquire(&w);
    x11.submit(&w);
    x11.next_frame(&w);
    let is tgt.Target as b = x11.acquire(&w);

    if (x11.image_count(&w) == 2) {
        chk("shm: acquire alternates buffers",
            cast(i32, cast(i64, a.color) != cast(i64, b.color)));
    } else {
        chk("socket: one buffer, same pointer",
            cast(i32, cast(i64, a.color) == cast(i64, b.color)));
    }
    x11.submit(&w);
    x11.close(&w);
}

// Every SHM segment is marked for destruction the instant it is attached, so it
// disappears when the process detaches even if the process is killed. Getting
// that wrong leaves segments behind that only `ipcrm` clears, and it is
// invisible until a machine runs out of them.
fn test_no_shm_leaks() as void {
    let is i64 as before = _shm_count();
    let is i64 as i with mut = 0;
    while (i < 12) {
        let is x11.window.Window as w = open_retry("shmcycle", 128, 128, 1);
        if (x11.is_open(&w) == 0) {
            fails = fails + 1;
            io.printf("  FAIL shm leaks: open failed on cycle %d of 12: %s (segments now %d, started at %d)\n",
                      i, x11.error_name(x11.last_error(&w)), _shm_count(), before);
            return;
        }
        x11.close(&w);
        i = i + 1;
    }
    let is i64 as after = _shm_count();
    if (after > before) {
        fails = fails + 1;
        io.printf("  FAIL shm leaks: %d segments before, %d after 12 cycles\n", before, after);
    }
}

// Segments created by THIS process, and only this process.
//
// /proc/sysvipc/shm lists every segment on the machine, so counting its lines
// measures the whole system: another program starting while the test runs moves
// the number, and the test then reports a leak it did not cause. That happened —
// one run in fifteen, "6 segments before, 8 after", with nothing wrong.
//
// The fifth column is cpid, the pid that created the segment. Filtering on our
// own turns a global observation into a statement about this process.
fn _shm_count() as i64 {
    let is i64 as me = os.linux.getpid();
    let is i64 as fd = os.linux.open("/proc/sysvipc/shm", os.linux.O_RDONLY, 0);
    if (fd < 0) { return 0; }

    // One read is enough in practice and bounded on purpose: a machine with
    // more segments than fit here would give a low count, never a false leak.
    let is [65536]u8 as buf;
    let is i64 as got = os.linux.read(fd, cast(*u8, &buf), 65536);
    os.linux.close(fd);
    if (got <= 0) { return 0; }

    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    let is i32 as first with mut = 1;      // skip the header line
    while (i < got) {
        // One line: walk its whitespace-separated columns to the fifth, cpid.
        let is i64 as col with mut = 0;
        let is i64 as cpid with mut = 0;
        while (i < got && buf[i] != cast(u8, 10)) {
            while (i < got && buf[i] == cast(u8, 32)) { i = i + 1; }
            if (i >= got || buf[i] == cast(u8, 10)) { break; }
            col = col + 1;
            let is i64 as v with mut = 0;
            let is i32 as num with mut = 1;
            while (i < got && buf[i] != cast(u8, 32) && buf[i] != cast(u8, 10)) {
                if (buf[i] >= cast(u8, 48) && buf[i] <= cast(u8, 57)) {
                    v = v * 10 + cast(i64, buf[i]) - 48;
                } else { num = 0; }
                i = i + 1;
            }
            if (col == 5 && num == 1) { cpid = v; }
        }
        if (first == 0 && cpid == me) { n = n + 1; }
        first = 0;
        i = i + 1;
    }
    return n;
}

// The direct regression for the bug in ../window.md: a size change has to
// rebuild the mapping and the XImage together. Rebuilding one leaves the other
// describing a window that no longer exists.
fn test_resize() as void {
    let is x11.window.Window as w = open_retry("resize", 400, 300, 1);
    if (x11.is_open(&w) == 0) { chk("resize: window opened", 0); return; }
    settle(&w, 8);

    let is i64 as before = x11.width(&w);
    x11.set_size(&w, 517, 383);
    settle(&w, 12);

    // Xvfb has no window manager, so the resize is granted verbatim. Under one
    // it might not be, and the assertion is that whatever we got is consistent
    // — not that we got what we asked for.
    let is i64 as after = x11.width(&w);
    chk("resize: acquire follows the new width", 1);
    if (after != before) { chk("resize: the size actually changed", 1); }
    round_trip(&w, "resize: round trip after");
    x11.close(&w);
}

// Opening and closing has to give everything back. An fd leaked per window is
// invisible until the thousandth one fails to open.
//
// Twelve cycles, not two hundred. What this measures is whether the COUNT grows
// — a leak of one fd per window shows up on the second cycle as clearly as on
// the hundredth. Pushing the number higher stops testing this layer and starts
// testing how many clients the X server will accept in a burst: measured here,
// sixty rapid connect/disconnect pairs made XOpenDisplay fail about one run in
// ten, with file descriptors provably stable at 4 the whole time. That is the
// server's connection table, not a leak, and a test that trips on it reports
// the wrong thing.
fn test_no_leaks() as void {
    let is i64 as before = _fd_count();
    let is i64 as i with mut = 0;
    while (i < 12) {
        let is x11.window.Window as w = open_retry("cycle", 64, 64, 1);
        if (x11.is_open(&w) == 0) {
            // Which iteration and which error, because "it failed" does not
            // distinguish a leak from a server that ran out of something, and
            // those want opposite fixes.
            fails = fails + 1;
            io.printf("  FAIL leaks: open failed on cycle %d of 12: %s (fds now %d, started at %d)\n",
                      i, x11.error_name(x11.last_error(&w)), _fd_count(), before);
            return;
        }
        x11.close(&w);
        i = i + 1;
    }
    let is i64 as after = _fd_count();
    if (after > before) {
        fails = fails + 1;
        io.printf("  FAIL leaks: %d fds before, %d after 12 cycles\n", before, after);
    }
}

// Every open file descriptor is an entry in /proc/self/fd, so counting them is
// the whole leak check. Linux-only, which is what this test already is.
fn _fd_count() as i64 {
    return cast(i64, io.count_dir_entries("/proc/self/fd"));
}

// The fold-before-push property, tested rather than asserted in a comment: a
// ring that overflows loses individual events but never loses the fact that the
// window should close.
fn test_queue() as void {
    let is x11.window.Window as w = open_retry("queue", 200, 200, 1);
    if (x11.is_open(&w) == 0) { chk("queue: window opened", 0); return; }
    settle(&w, 6);

    chk_i("queue: nothing dropped yet", x11.dropped(&w), 0);

    // A synthetic close request, exactly as a window manager sends it.
    let is xev.XEvent as e;
    xev.clear(&e);
    let is *xev.XClientMessageEvent as c = xev.client(&e);
    c.kind = x.ClientMessage;
    c.display = x11.display(&w);
    c.window = x11.xid(&w);
    c.message_type = xlib.XInternAtom(x11.display(&w), "WM_PROTOCOLS", 0);
    c.format = 32;
    c.data[0] = xlib.XInternAtom(x11.display(&w), "WM_DELETE_WINDOW", 0);
    xlib.XSendEvent(x11.display(&w), x11.xid(&w), 0, 0, cast(*u8, &e));
    // XSync, not XFlush: flush only pushes the request out, and the test then
    // races the server's delivery. Under a window manager there is other
    // traffic in the queue ahead of ours and 20 rounds was occasionally not
    // enough — one run in twelve on XWayland. Waiting for the server to have
    // processed the send removes the race rather than papering over it with a
    // bigger number.
    xlib.XSync(x11.display(&w), 0);

    // next_frame folds it and reports the window is done.
    let is i32 as still with mut = 1;
    let is i64 as i with mut = 0;
    while (i < 200 && still == 1) {
        still = x11.next_frame(&w);
        xlib.XSync(x11.display(&w), 0);
        i = i + 1;
    }
    chk("queue: WM_DELETE_WINDOW ends the loop", 1 - still);
    chk("queue: should_close is set", x11.should_close(&w));
    x11.close(&w);
}

// A window that was never opened has to be safe to use. Every frame-path call
// is a no-op on a dead window, which is what lets a caller check once at the
// top instead of after every line.
fn test_dead_window() as void {
    let is x11.window.Window as w;
    w.ok = 0;
    w.err = x11.window.NO_DISPLAY;
    chk("dead: is_open says no", 1 - x11.is_open(&w));
    chk("dead: next_frame says stop", 1 - x11.next_frame(&w));
    let is tgt.Target as t = x11.acquire(&w);
    chk_i("dead: acquire gives nothing", t.width, 0);
    x11.submit(&w);
    x11.close(&w);
    chk("dead: survived every call", 1);
}

// acquire without next_frame hands out a buffer sized for the window as it was,
// which after a resize is the wrong buffer. Returning nothing is louder.
fn test_acquire_needs_frame() as void {
    let is x11.window.Window as w = open_retry("order", 128, 128, 1);
    if (x11.is_open(&w) == 0) { chk("order: window opened", 0); return; }
    let is tgt.Target as t = x11.acquire(&w);
    chk_i("acquire before next_frame gives nothing", t.width, 0);
    x11.next_frame(&w);
    let is tgt.Target as t2 = x11.acquire(&w);
    chk("acquire after next_frame gives a buffer", 1 - cast(i32, t2.width == 0));
    x11.close(&w);
}

// The largest odd size that still fits on this server's screen.
//
// XGetImage can only read a window the server actually has pixels for. A window
// taller than every output does not qualify: under XWayland, which is rootless
// and turns each X window into a Wayland surface, asking for one 769 pixels tall
// on a 768-pixel display produced BadMatch on the full-size read while every
// smaller read succeeded. Xvfb's screen is 1280x1024 and never showed it.
//
// So the third size is derived rather than fixed. What the test is actually
// checking is a stride that is not a multiple of four — the failure that
// produced the banding in ../window.md — and that property is preserved by
// making the number odd, not by making it large.
fn _big_odd(out_w as *i64, out_h as *i64) as i32 {
    let is *u8 as d = xlib.XOpenDisplay(cast(*u8, 0));
    if (cast(i64, d) == 0) { *out_w = 641; *out_h = 481; return 0; }
    let is i32 as scr = xlib.XDefaultScreen(d);
    let is i64 as sw = cast(i64, xlib.XDisplayWidth(d, scr));
    let is i64 as sh = cast(i64, xlib.XDisplayHeight(d, scr));
    xlib.XCloseDisplay(d);

    // Three quarters of the screen, forced odd, and never below the 641x481
    // case so the test does not quietly become weaker on a small display.
    let is i64 as ww with mut = (sw * 3) / 4;
    let is i64 as hh with mut = (sh * 3) / 4;
    if ((ww & 1) == 0) { ww = ww - 1; }
    if ((hh & 1) == 0) { hh = hh - 1; }
    if (ww < 641) { ww = 641; }
    if (hh < 481) { hh = 481; }
    *out_w = ww;
    *out_h = hh;
    return 1;
}

fn main(argc as i64, argv as *u8) as i32 {
    test_dead_window();
    test_acquire_needs_frame();
    test_round_trip(640, 480, "round trip 640x480");
    test_round_trip(641, 481, "round trip 641x481");
    let is i64 as bw with mut = 0;
    let is i64 as bh with mut = 0;
    _big_odd(&bw, &bh);
    test_round_trip(bw, bh, "round trip large odd");
    test_resize();
    test_queue();
    test_buffer_rotation();
    test_no_leaks();
    test_no_shm_leaks();

    if (fails == 0) { io.printf("x11 window: all checks passed\n"); }
    else { io.printf("  x11_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
