// window/x11/framesync_test.cst — the sync counter, and the frame limiter.
//
// Two things that both live on the frame path and neither of which a program
// calls directly.
//
// The sync half can only be half-tested without a compositor: Xvfb has the
// SYNC extension, so the counter is created and the protocol advertised, but
// nothing ever sends a request. So what is asserted is that the machinery is
// in place and that a window with no requests answers none — and on a desktop
// that does send them, that the count moves.
//
// The limiter is testable anywhere, because it is a clock: ask for 20 frames a
// second, run 10 frames, and the wall clock has to have advanced by roughly
// half a second. That is the whole of what it promises, and asserting it
// loosely is deliberate — a sleep is a floor, not a guarantee.
//
// Exit code is the number of failures.
use "std/io.cst" as io;
use "std/time.cst" as time;
use "x11.cst" as x11;

let is i32 as fails with mut = 0;

fn chk(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("  FAIL %s\n", name); }
}

fn chk_i(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is x11.window.Window as w = x11.open("caustic-framesync-test", 240, 180);
    if (x11.is_open(&w) == 0) {
        io.printf("  FAIL open: %s\n", x11.error_name(x11.last_error(&w)));
        return 1;
    }

    // --- The counter ---

    let is i32 as have_sync = x11.frame_sync(&w);
    io.printf("  _NET_WM_SYNC_REQUEST in place: %d\n", cast(i64, have_sync));
    if (have_sync == 1) {
        chk_i("nothing answered before anything asked", x11.frames_synced(&w), 0);
    }

    // --- The limiter, off ---
    //
    // The default, and what X11 gives you: next_frame returns as soon as a
    // buffer is free. Ten frames must take almost no time, which is what makes
    // the limiter below meaningful rather than measuring an unrelated stall.
    chk_i("no limit by default", x11.frame_limit(&w), 0);

    let is i64 as t0 = time.now_ns();
    let is i64 as n with mut = 0;
    while (n < 10) {
        if (x11.next_frame(&w) == 0) { break; }
        n = n + 1;
    }
    let is i64 as unlimited_ms = (time.now_ns() - t0) / 1000000;
    chk("ten unlimited frames are fast", cast(i32, unlimited_ms < 100));

    // --- The limiter, on ---
    //
    // 20 fps is 50 ms a frame, so ten frames is about 450 ms of sleeping —
    // nine gaps, not ten, because the first frame sets the baseline rather
    // than waiting. The bound is loose on purpose: a sleep may overshoot and
    // this is a floor, not a promise about the display.
    x11.set_frame_limit(&w, 20);
    chk_i("the limit reads back", x11.frame_limit(&w), 20);

    let is i64 as t1 = time.now_ns();
    n = 0;
    while (n < 10) {
        if (x11.next_frame(&w) == 0) { break; }
        n = n + 1;
    }
    let is i64 as limited_ms = (time.now_ns() - t1) / 1000000;
    io.printf("  10 frames: %d ms unlimited, %d ms at 20 fps\n", unlimited_ms, limited_ms);
    chk("the limiter actually waits", cast(i32, limited_ms >= 350));
    chk("and does not overshoot wildly", cast(i32, limited_ms < 900));

    x11.set_frame_limit(&w, 0);
    chk_i("and can be turned off again", x11.frame_limit(&w), 0);

    x11.close(&w);

    if (fails == 0) { io.printf("x11 framesync: all checks passed\n"); }
    else { io.printf("  framesync_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
