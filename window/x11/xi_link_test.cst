// window/x11/xi_link_test.cst — every libXi.so.6 symbol resolves, or this never runs.
//
// 82 declarations transcribed by hand. The dominant failure mode is not a
// wrong type, it is a wrong NAME: one transposed letter produces a declaration
// that compiles, links against nothing, and fails the first time some program
// far from here calls it.
//
// This catches all of them at once, before main, on every CI run:
//
//   The compiler emits a library import at the CALL SITE, not at the
//   declaration, so a declaration nobody calls is invisible to the linker.
//   Every function therefore has to be called somewhere for this to mean
//   anything — ../tools/check_symbols.sh asserts that none was forgotten.
//
//   The calls sit behind `if (sink != 7777)`, and sink comes from argc. That is
//   not a constant, so the branch survives dead-code elimination and the call
//   sites are emitted — but the condition is never true, so libXi.so.6 is never
//   actually entered. Nothing here opens a display or touches the X server.
//
//   caustic-ld turns those imports into DT_NEEDED plus one PLT relocation each,
//   and sets DT_FLAGS = DF_BIND_NOW, so the loader resolves every name at exec.
//   A single misspelling and this process dies before main, which is the loud
//   failure a silent one deserves.
//
// So the assertion is the exit code itself: reaching main at all is the result.
//
// --- Why one binary per shared object ---
//
// Not tidiness. Measured against this toolchain: when a single binary imports
// more than roughly 256 distinct extern symbols, caustic-ld emits the PLT
// relocations for every soname but the DT_NEEDED entry for only the FIRST one.
// The binary then dies at exec with `undefined symbol`, naming a function whose
// library was never recorded.
//
// Bisected: 240 imports across two sonames links and runs; 280 does not. A
// binary with 770 imports and a SINGLE soname is fine, so the count alone is
// not the trigger — it is the count crossing that line with a second library
// present. The 1024-entry cstimport table is not it either; that one fails
// loudly and this is silent.
//
// Splitting by soname keeps each binary under the line and, when one does fail,
// says which library it was.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "bind/xinput.cst" as xinput;
use "bind/xinput2.cst" as xinput2;

// From argc, so the compiler cannot fold the guard away. Written once and never
// 7777, so no call below ever executes.
let is i64 as sink with mut = 0;

fn _touch_0() as void {
    if (sink != 7777) { return; }
    xinput.XAllowDeviceEvents(cast(*u8, 0), cast(*u8, 0), cast(i32, 0), 0);
    xinput.XChangeDeviceControl(cast(*u8, 0), cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput.XChangeDeviceDontPropagateList(cast(*u8, 0), 0, cast(i32, 0), cast(*u8, 0), cast(i32, 0));
    xinput.XChangeDeviceKeyMapping(cast(*u8, 0), cast(*u8, 0), cast(i32, 0), cast(i32, 0),
                                   cast(*u8, 0), cast(i32, 0));
    xinput.XChangeDeviceProperty(cast(*u8, 0), cast(*u8, 0), 0, 0, cast(i32, 0), cast(i32, 0),
                                 cast(*u8, 0), cast(i32, 0));
    xinput.XChangeFeedbackControl(cast(*u8, 0), cast(*u8, 0), 0, cast(*u8, 0));
    xinput.XChangeKeyboardDevice(cast(*u8, 0), cast(*u8, 0));
    xinput.XChangePointerDevice(cast(*u8, 0), cast(*u8, 0), cast(i32, 0), cast(i32, 0));
    xinput.XCloseDevice(cast(*u8, 0), cast(*u8, 0));
    xinput.XDeleteDeviceProperty(cast(*u8, 0), cast(*u8, 0), 0);
    xinput.XDeviceBell(cast(*u8, 0), cast(*u8, 0), 0, 0, cast(i32, 0));
    xinput.XFreeDeviceControl(cast(*u8, 0));
    xinput.XFreeDeviceList(cast(*u8, 0));
    xinput.XFreeDeviceMotionEvents(cast(*u8, 0));
    xinput.XFreeDeviceState(cast(*u8, 0));
    xinput.XFreeFeedbackList(cast(*u8, 0));
    xinput.XGetDeviceButtonMapping(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(u32, 0));
    xinput.XGetDeviceControl(cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
    xinput.XGetDeviceDontPropagateList(cast(*u8, 0), 0, cast(*u8, 0));
    xinput.XGetDeviceFocus(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xinput.XGetDeviceKeyMapping(cast(*u8, 0), cast(*u8, 0), cast(u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput.XGetDeviceModifierMapping(cast(*u8, 0), cast(*u8, 0));
    xinput.XGetDeviceMotionEvents(cast(*u8, 0), cast(*u8, 0), 0, 0, cast(*u8, 0), cast(*u8, 0),
                                  cast(*u8, 0));
    xinput.XGetDeviceProperty(cast(*u8, 0), cast(*u8, 0), 0, 0, 0, cast(i32, 0), 0, cast(*u8, 0),
                              cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xinput.XGetExtensionVersion(cast(*u8, 0), cast(*u8, 0));
    xinput.XGetFeedbackControl(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xinput.XGetSelectedExtensionEvents(cast(*u8, 0), 0, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0),
                                       cast(*u8, 0));
    xinput.XGrabDevice(cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0), cast(*u8, 0),
                       cast(i32, 0), cast(i32, 0), 0);
    xinput.XGrabDeviceButton(cast(*u8, 0), cast(*u8, 0), cast(u32, 0), cast(u32, 0), cast(*u8, 0),
                             0, cast(i32, 0), cast(u32, 0), cast(*u8, 0), cast(i32, 0), cast(i32, 0));
    xinput.XGrabDeviceKey(cast(*u8, 0), cast(*u8, 0), cast(u32, 0), cast(u32, 0), cast(*u8, 0), 0,
                          cast(i32, 0), cast(u32, 0), cast(*u8, 0), cast(i32, 0), cast(i32, 0));
    xinput.XListDeviceProperties(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xinput.XListInputDevices(cast(*u8, 0), cast(*u8, 0));
    xinput.XOpenDevice(cast(*u8, 0), 0);
    xinput.XQueryDeviceState(cast(*u8, 0), cast(*u8, 0));
    xinput.XSelectExtensionEvent(cast(*u8, 0), 0, cast(*u8, 0), cast(i32, 0));
    xinput.XSendExtensionEvent(cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0), cast(i32, 0),
                               cast(*u8, 0), cast(*u8, 0));
    xinput.XSetDeviceButtonMapping(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
    xinput.XSetDeviceFocus(cast(*u8, 0), cast(*u8, 0), 0, cast(i32, 0), 0);
    xinput.XSetDeviceMode(cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
    xinput.XSetDeviceModifierMapping(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
}

fn _touch_1() as void {
    if (sink != 7777) { return; }
    xinput.XSetDeviceValuators(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(i32, 0), cast(i32, 0));
    xinput.XUngrabDevice(cast(*u8, 0), cast(*u8, 0), 0);
    xinput.XUngrabDeviceButton(cast(*u8, 0), cast(*u8, 0), cast(u32, 0), cast(u32, 0),
                               cast(*u8, 0), 0);
    xinput.XUngrabDeviceKey(cast(*u8, 0), cast(*u8, 0), cast(u32, 0), cast(u32, 0), cast(*u8, 0), 0);
    xinput2.XIAllowEvents(cast(*u8, 0), cast(i32, 0), cast(i32, 0), 0);
    xinput2.XIAllowTouchEvents(cast(*u8, 0), cast(i32, 0), cast(u32, 0), 0, cast(i32, 0));
    xinput2.XIBarrierReleasePointer(cast(*u8, 0), cast(i32, 0), cast(*u8, 0), cast(*u8, 0));
    xinput2.XIBarrierReleasePointers(cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
    xinput2.XIChangeHierarchy(cast(*u8, 0), cast(*u8, 0), cast(i32, 0));
    xinput2.XIChangeProperty(cast(*u8, 0), cast(i32, 0), 0, 0, cast(i32, 0), cast(i32, 0),
                             cast(*u8, 0), cast(i32, 0));
    xinput2.XIDefineCursor(cast(*u8, 0), cast(i32, 0), 0, 0);
    xinput2.XIDeleteProperty(cast(*u8, 0), cast(i32, 0), 0);
    xinput2.XIFreeDeviceInfo(cast(*u8, 0));
    xinput2.XIGetClientPointer(cast(*u8, 0), 0, cast(*u8, 0));
    xinput2.XIGetFocus(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput2.XIGetProperty(cast(*u8, 0), cast(i32, 0), 0, 0, 0, cast(i32, 0), 0, cast(*u8, 0),
                          cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xinput2.XIGetSelectedEvents(cast(*u8, 0), 0, cast(*u8, 0));
    xinput2.XIGrabButton(cast(*u8, 0), cast(i32, 0), cast(i32, 0), 0, 0, cast(i32, 0),
                         cast(i32, 0), cast(i32, 0), cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput2.XIGrabDevice(cast(*u8, 0), cast(i32, 0), 0, 0, 0, cast(i32, 0), cast(i32, 0),
                         cast(i32, 0), cast(*u8, 0));
    xinput2.XIGrabEnter(cast(*u8, 0), cast(i32, 0), 0, 0, cast(i32, 0), cast(i32, 0), cast(i32, 0),
                        cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput2.XIGrabFocusIn(cast(*u8, 0), cast(i32, 0), 0, cast(i32, 0), cast(i32, 0), cast(i32, 0),
                          cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput2.XIGrabKeycode(cast(*u8, 0), cast(i32, 0), cast(i32, 0), 0, cast(i32, 0), cast(i32, 0),
                          cast(i32, 0), cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput2.XIGrabPinchGestureBegin(cast(*u8, 0), cast(i32, 0), 0, cast(i32, 0), cast(i32, 0),
                                    cast(i32, 0), cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput2.XIGrabSwipeGestureBegin(cast(*u8, 0), cast(i32, 0), 0, cast(i32, 0), cast(i32, 0),
                                    cast(i32, 0), cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput2.XIGrabTouchBegin(cast(*u8, 0), cast(i32, 0), 0, cast(i32, 0), cast(*u8, 0),
                             cast(i32, 0), cast(*u8, 0));
    xinput2.XIListProperties(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput2.XIQueryDevice(cast(*u8, 0), cast(i32, 0), cast(*u8, 0));
    xinput2.XIQueryPointer(cast(*u8, 0), cast(i32, 0), 0, cast(*u8, 0), cast(*u8, 0), cast(*u8, 0),
                           cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0), cast(*u8, 0),
                           cast(*u8, 0));
    xinput2.XIQueryVersion(cast(*u8, 0), cast(*u8, 0), cast(*u8, 0));
    xinput2.XISelectEvents(cast(*u8, 0), 0, cast(*u8, 0), cast(i32, 0));
    xinput2.XISetClientPointer(cast(*u8, 0), 0, cast(i32, 0));
    xinput2.XISetFocus(cast(*u8, 0), cast(i32, 0), 0, 0);
    xinput2.XIUndefineCursor(cast(*u8, 0), cast(i32, 0), 0);
    xinput2.XIUngrabButton(cast(*u8, 0), cast(i32, 0), cast(i32, 0), 0, cast(i32, 0), cast(*u8, 0));
    xinput2.XIUngrabDevice(cast(*u8, 0), cast(i32, 0), 0);
    xinput2.XIUngrabEnter(cast(*u8, 0), cast(i32, 0), 0, cast(i32, 0), cast(*u8, 0));
    xinput2.XIUngrabFocusIn(cast(*u8, 0), cast(i32, 0), 0, cast(i32, 0), cast(*u8, 0));
    xinput2.XIUngrabKeycode(cast(*u8, 0), cast(i32, 0), cast(i32, 0), 0, cast(i32, 0), cast(*u8, 0));
    xinput2.XIUngrabPinchGestureBegin(cast(*u8, 0), cast(i32, 0), 0, cast(i32, 0), cast(*u8, 0));
    xinput2.XIUngrabSwipeGestureBegin(cast(*u8, 0), cast(i32, 0), 0, cast(i32, 0), cast(*u8, 0));
}

fn _touch_2() as void {
    if (sink != 7777) { return; }
    xinput2.XIUngrabTouchBegin(cast(*u8, 0), cast(i32, 0), 0, cast(i32, 0), cast(*u8, 0));
    xinput2.XIWarpPointer(cast(*u8, 0), cast(i32, 0), 0, 0, 0.0, 0.0, cast(u32, 0), cast(u32, 0),
                          0.0, 0.0);
}
fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    sink = argc;

    // Never true. The point is that the compiler cannot know that.
    if (sink == 7777) {
        _touch_0();
        _touch_1();
        _touch_2();
    }

    io.printf("libXi.so.6: 82 symbols resolved at exec\n");
    return 0;
}
