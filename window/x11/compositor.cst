// window/x11/compositor.cst — a compositing manager starting or stopping,
// heard as it happens.
//
// What a window leaves transparent shows what is behind it only while a
// compositing manager owns _NET_WM_CM_S<screen> (frame.cst). XFixes tells a
// client when a selection changes hands, is let go, or its owner leaves — the
// way GTK follows it too; from then on each change arrives in a window's
// ring as a COMPOSITOR event (events.cst), and frame.composited says which
// way it went.
//
// Kept out of window.cst: this links libXfixes, which a window program that
// never asks need not have.
use "bind/xlib.cst" as xlib;
use "bind/xfixes.cst" as xfixes;
use "frame.cst" as frame;
use "window.cst" as window;

// XFixes' masks for a selection: set, its owner window destroyed, its owner's
// client gone.
let is i64 as _SELECTION_CHANGES with imut = 7;

// Follows the compositing manager of w's screen, for every window on w's
// connection — once a connection: the next one, after every window closed,
// is to be followed anew. 1 when followed, 0 when the server has no XFixes.
fn follow(w as *window.Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (window.following_compositor() == 1) { return 1; }
    let is i32 as event_base with mut = 0;
    let is i32 as error_base with mut = 0;
    if (xfixes.XFixesQueryExtension(w.display, cast(*u8, &event_base), cast(*u8, &error_base)) == 0) { return 0; }
    let is i64 as selection = frame.compositor_selection(w.display, w.screen);
    xfixes.XFixesSelectSelectionInput(w.display, xlib.XRootWindow(w.display, w.screen), selection, _SELECTION_CHANGES);
    xlib.XFlush(w.display);
    // XFixesSelectionNotify is the extension's first event.
    window.follow_compositor(event_base, selection);
    return 1;
}
