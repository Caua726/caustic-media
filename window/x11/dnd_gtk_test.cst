// window/x11/dnd_gtk_test.cst — drag and drop with another program, GTK 3
// (window/tools/gtk_dnd_peer.py), under Xvfb, the pointer and keys XTest's:
//   sh window/x11/tools/run_headless.sh ./build/x11_dnd_gtk_test
// Into this window: GTK's files (copied; moved with Shift held), and 3 MB of
// GTK's text, which comes through INCR. Out of it: files and text to GTK's
// window, copied, and moved with Shift held, what GTK received read back;
// cancelled by Escape, and let go over nothing — DRAG_DONE with no action
// and nothing received.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/env.cst" as env;
use "std/process.cst" as process;
use "std/os/linux.cst" as linux;
use "bind/xlib.cst" as xlib;
use "../../sys/linux.cst" as sys;
use "x11.cst" as x11;
use "events.cst" as events;
use "../../input/event.cst" as ie;
use "../transfer.cst" as transfer;

extern "libXtst.so.6" fn XTestFakeMotionEvent(display as *u8, screen as i32, x as i32, y as i32, delay as u64) as i32;
extern "libXtst.so.6" fn XTestFakeButtonEvent(display as *u8, button as u32, is_press as i32, delay as u64) as i32;
extern "libXtst.so.6" fn XTestFakeKeyEvent(display as *u8, keycode as u32, is_press as i32, delay as u64) as i32;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("FAIL: %s\n", name); }
}

let is x11.window.Window as win with mut;
let is *u8 as xd with mut;

// What the window heard of drags, as it came.
let is [64]events.Event as heard;
let is i32 as nheard with mut = 0;
let is i32 as taken with mut = 0;   // BUTTON_UP, taken by a drag

fn pump(ms as i64) as void {
    let is i64 as until = time.now_ms() + ms;
    while (time.now_ms() < until) {
        x11.pump(&win);
        let is events.Event as e;
        while (x11.poll_event(&win, &e) == 1) {
            if (((e.kind >= events.DND_ENTER && e.kind <= events.DND_DROP) || e.kind == events.DRAG_DONE) && nheard < 64) {
                heard[nheard] = e;
                nheard = nheard + 1;
            }
        }
        let is ie.Event as i;
        while (x11.poll_input(&win, &i) == 1) {
            if (i.kind == ie.BUTTON_UP && i.detail == ie.BUTTON_TAKEN) { taken = taken + 1; }
        }
        time.sleep_ms(2);
    }
}

// The last event of kind k heard: its index, -1 for none.
fn last(k as i32) as i32 {
    let is i32 as i with mut = nheard - 1;
    while (i >= 0) {
        if (heard[i].kind == k) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

fn until_heard(k as i32, ms as i64) as i32 {
    let is i64 as end = time.now_ms() + ms;
    while (time.now_ms() < end && last(k) < 0) { pump(10); }
    return last(k);
}

fn move_to(x as i64, y as i64) as void {
    XTestFakeMotionEvent(xd, 0 - 1, cast(i32, x), cast(i32, y), cast(u64, 0));
    xlib.XFlush(xd);
}

// The pointer from x0, y0 to x1, y1 in steps, both sides pumped between.
fn glide(x0 as i64, y0 as i64, x1 as i64, y1 as i64) as void {
    let is i64 as k with mut = 1;
    while (k <= 24) {
        move_to(x0 + (x1 - x0) * k / 24, y0 + (y1 - y0) * k / 24);
        pump(25);
        k = k + 1;
    }
}

fn button(down as i32) as void {
    XTestFakeButtonEvent(xd, cast(u32, 1), down, cast(u64, 0));
    xlib.XFlush(xd);
}

fn key(keysym as i64, down as i32) as void {
    XTestFakeKeyEvent(xd, cast(u32, xlib.XKeysymToKeycode(xd, keysym)), down, cast(u64, 0));
    xlib.XFlush(xd);
}

// --- The peer ---

let is i64 as peer with mut = 0;
let is transfer.Bytes as logb with mut;

fn start_peer(args as *u8) as i32 {
    let is [256]u8 as cmd with mut;
    let is *u8 as head = "rm -f build/dnd-peer.log.*; exec env NO_AT_BRIDGE=1 GTK_MODULES= XDG_CONFIG_HOME=/nonexistent python3 window/tools/gtk_dnd_peer.py ";
    let is i64 as n with mut = 0;
    while (head[n] != 0) { cmd[n] = head[n]; n = n + 1; }
    let is i64 as i with mut = 0;
    while (args[i] != 0 && n < 254) { cmd[n] = args[i]; n = n + 1; i = i + 1; }
    cmd[n] = 0;
    linux.unlink("build/dnd-peer.log");
    let is [4]i64 as argv;
    argv[0] = cast(i64, "sh"); argv[1] = cast(i64, "-c"); argv[2] = cast(i64, &cmd[0]); argv[3] = 0;
    peer = process.spawnp("sh", cast(*u8, &argv[0]));
    return cast(i32, peer > 0 && log_has("ready", 10000) == 1);
}

fn stop_peer() as void {
    if (peer > 0) {
        sys.kill(peer, 15);
        let is i32 as st with mut = 0;
        linux.wait4(peer, &st, 0, cast(*u8, 0));
        peer = 0;
    }
    pump(100);
}

fn read_file(path as *u8, out as *transfer.Bytes) as i32 {
    transfer.bytes_clear(out);
    let is i64 as fd = linux.open(path, linux.O_RDONLY, 0);
    if (fd < 0) { return 0; }
    let is [65536]u8 as buf with mut;
    while (1 == 1) {
        let is i64 as n = linux.read(fd, &buf[0], 65536);
        if (n <= 0) { break; }
        transfer.append(out, &buf[0], n);
    }
    linux.close(fd);
    return 1;
}

fn contains(b as *transfer.Bytes, s as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    let is i64 as i with mut = 0;
    while (i + n <= b.len) {
        if (mem.memcmp(cast(*u8, cast(i64, b.data) + i), s, n) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Whether the peer's log says line within ms, both sides pumped.
fn log_has(line as *u8, ms as i64) as i32 {
    let is i64 as end = time.now_ms() + ms;
    while (time.now_ms() < end) {
        pump(20);
        if (read_file("build/dnd-peer.log", &logb) == 1 && contains(&logb, line) == 1) { return 1; }
    }
    return 0;
}

fn same(b as *transfer.Bytes, p as *u8, n as i64) as i32 {
    if (b.len != n) { io.printf("  %d bytes, want %d\n", b.len, n); return 0; }
    return cast(i32, mem.memcmp(b.data, p, n) == 0);
}

fn str_same(a as *u8, b as *u8) as i32 {
    if (cast(i64, a) == 0) { return 0; }
    let is i64 as i with mut = 0;
    while (b[i] != 0 && a[i] == b[i]) { i = i + 1; }
    return cast(i32, a[i] == b[i]);
}

// GTK's 3 MB of text, as it makes it.
fn big_text(out as *transfer.Bytes) as void {
    transfer.bytes_clear(out);
    let is *u8 as line = "gtk ação — through INCR ✓ ";
    let is i64 as n with mut = 0;
    while (line[n] != 0) { n = n + 1; }
    while (out.len < 3145728) { transfer.append(out, line, n); }
    out.len = 3145728;
}

// A drag begun here: pressed at 150, 150 and handed to the platform with o.
fn begin_here(o as *transfer.Offer) as i32 {
    move_to(150, 150);
    pump(100);
    button(1);
    pump(150);
    taken = 0;
    return x11.drag_begin(&win, o, transfer.COPY | transfer.MOVE);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    transfer.bytes_init(&logb);
    xd = xlib.XOpenDisplay(cast(*u8, 0));
    if (cast(i64, xd) == 0) { io.printf("FAIL: no X display\n"); return 1; }
    win = x11.open("dnd", 300, 300);
    if (x11.is_open(&win) == 0) { io.printf("FAIL: no window\n"); return 1; }
    x11.move_to(&win, 0, 0);
    pump(300);
    let is transfer.Bytes as got with mut;
    transfer.bytes_init(&got);

    // --- In: GTK's files, copied ---
    check("a GTK source", start_peer("source build/dnd-peer.log files") == 1);
    move_to(750, 250);
    pump(100);
    button(1);
    pump(100);
    nheard = 0;
    glide(750, 250, 150, 150);
    button(0);
    let is i32 as dr with mut = until_heard(events.DND_DROP, 5000);
    let is i32 as en with mut = last(events.DND_ENTER);
    check("in: entered, files offered, copying allowed", en >= 0 && heard[en].drop == x11.DROP_FILES &&
          (heard[en].action & transfer.COPY) != 0);
    check("in: dropped, files, a copy", dr >= 0 && heard[dr].drop == x11.DROP_FILES && heard[dr].action == transfer.COPY);
    check("in: the paths", x11.dropped_files(&win) == 2 && str_same(x11.dropped_file(&win, 0), "/tmp/peer one.txt") == 1 &&
          str_same(x11.dropped_file(&win, 1), "/tmp/peer-two") == 1);
    check("in: GTK told it was copied", log_has("end copy", 3000) == 1);
    x11.clear_drop(&win);
    stop_peer();

    // --- In: moved, with Shift held ---
    check("a GTK source again", start_peer("source build/dnd-peer.log files") == 1);
    move_to(750, 250);
    pump(100);
    button(1);
    pump(100);
    key(65505, 1);   // Shift_L
    nheard = 0;
    glide(750, 250, 150, 150);
    button(0);
    dr = until_heard(events.DND_DROP, 5000);
    key(65505, 0);
    check("in, Shift held: dropped as a move", dr >= 0 && heard[dr].action == transfer.MOVE);
    check("in, Shift held: GTK told it was moved", log_has("end move", 3000) == 1);
    x11.clear_drop(&win);
    stop_peer();

    // --- In: 3 MB of text, through INCR ---
    let is transfer.Bytes as big with mut;
    transfer.bytes_init(&big);
    big_text(&big);
    check("a GTK source of 3 MB", start_peer("source build/dnd-peer.log bigtext") == 1);
    move_to(750, 250);
    pump(100);
    button(1);
    pump(100);
    nheard = 0;
    glide(750, 250, 150, 150);
    button(0);
    dr = until_heard(events.DND_DROP, 10000);
    check("in: 3 MB of text dropped", dr >= 0 && heard[dr].drop == x11.DROP_TEXT);
    transfer.bytes_set(&got, x11.dropped_text(&win), x11.dropped_text_length(&win));
    check("in: all 3 MB, as GTK made them", same(&got, big.data, big.len) == 1);
    x11.clear_drop(&win);
    stop_peer();

    // --- Out: files and text to GTK, copied ---
    let is transfer.Offer as o with mut;
    transfer.offer_init(&o);
    transfer.offer_files(&o, "/tmp/our one.txt\x00/tmp/ação\x00", 2);
    transfer.offer_text(&o, "our text", 8);
    check("a GTK target", start_peer("target build/dnd-peer.log") == 1);
    nheard = 0;
    check("out: begun", begin_here(&o) == 1);
    pump(50);
    check("out: the press taken by the drag", taken == 1);
    glide(150, 150, 750, 250);
    button(0);
    let is i32 as done with mut = until_heard(events.DRAG_DONE, 5000);
    check("out: done, a copy", done >= 0 && heard[done].action == transfer.COPY);
    check("out: GTK received the files, copied", log_has("drop text/uri-list copy", 3000) == 1 &&
          read_file("build/dnd-peer.log.1", &got) == 1 &&
          same(&got, "file:///tmp/our%20one.txt\r\nfile:///tmp/a%C3%A7%C3%A3o\r\n", 55) == 1);

    // --- Out: moved, with Shift held ---
    nheard = 0;
    check("out again: begun", begin_here(&o) == 1);
    key(65505, 1);
    glide(150, 150, 750, 250);
    button(0);
    done = until_heard(events.DRAG_DONE, 5000);
    key(65505, 0);
    check("out, Shift held: done, a move", done >= 0 && heard[done].action == transfer.MOVE);
    check("out, Shift held: GTK moved them", log_has("drop text/uri-list move", 3000) == 1);

    // --- Out: text only ---
    let is transfer.Offer as t with mut;
    transfer.offer_init(&t);
    transfer.offer_text(&t, "texto: ação ✓", 17);
    nheard = 0;
    check("out, text: begun", begin_here(&t) == 1);
    glide(150, 150, 750, 250);
    button(0);
    done = until_heard(events.DRAG_DONE, 5000);
    check("out, text: done, a copy", done >= 0 && heard[done].action == transfer.COPY);
    check("out, text: GTK received it", log_has("drop UTF8_STRING copy 17", 3000) == 1 &&
          read_file("build/dnd-peer.log.3", &got) == 1 && same(&got, "texto: ação ✓", 17) == 1);

    // --- Out: cancelled by Escape ---
    nheard = 0;
    check("out, cancelled: begun", begin_here(&o) == 1);
    glide(150, 150, 750, 250);
    key(65307, 1);
    key(65307, 0);
    done = until_heard(events.DRAG_DONE, 3000);
    button(0);
    pump(300);
    check("out, Escape: done, nothing", done >= 0 && heard[done].action == 0);
    check("out, Escape: GTK received nothing", log_has("drop", 300) == 1 && read_file("build/dnd-peer.log.4", &got) == 0);

    // --- Out: let go over nothing ---
    nheard = 0;
    check("out, over nothing: begun", begin_here(&o) == 1);
    glide(150, 150, 450, 700);
    button(0);
    done = until_heard(events.DRAG_DONE, 3000);
    check("out, over nothing: done, nothing", done >= 0 && heard[done].action == 0);
    stop_peer();

    x11.close(&win);
    xlib.XCloseDisplay(xd);
    if (fails == 0) { io.printf("x11 dnd with gtk: all checks passed\n"); return 0; }
    io.printf("x11 dnd with gtk: %d failures\n", fails);
    return 1;
}
