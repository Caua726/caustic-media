// window/x11/resources.cst — what the session's X resources say of the
// desktop's settings: RESOURCE_MANAGER on the first screen's root, which
// xrdb sets and every desktop loads at login (KDE writes its cursor theme
// and DPI there).
//
//   Xcursor.theme   the pointer's theme      K_CURSOR_THEME
//   Xcursor.size    its nominal size         K_CURSOR_SIZE
//   Xft.dpi         the logical DPI          K_DPI
//
// Read from the property each time, not XResourceManagerString, which keeps
// what the connection found when it opened; a change is a PropertyNotify on
// the root, which handle() says, so the window says SETTINGS again.
use "../settings.cst" as settings;
use "bind/x.cst" as x;
use "bind/xlib.cst" as xlib;
use "bind/xevent.cst" as xev;

struct Watch {
    display  as *u8;
    root     as i64;
    property as i64;   // RESOURCE_MANAGER
}

// Starts watching display's resources: the root's property changes added to
// whatever this client already asked of the root.
fn watch(w as *Watch, display as *u8) as void {
    w.display = display;
    w.root = xlib.XRootWindow(display, 0);
    w.property = xlib.XInternAtom(display, "RESOURCE_MANAGER", 0);
    let is xlib.XWindowAttributes as wa;
    xlib.XGetWindowAttributes(display, w.root, cast(*u8, &wa));
    xlib.XSelectInput(display, w.root, wa.your_event_mask | x.PropertyChangeMask);
}

// Whether e says the resources changed.
fn handle(w as *Watch, e as *xev.XEvent) as i32 {
    if (xev.kind(e) != x.PropertyNotify) { return 0; }
    let is *xev.XPropertyEvent as p = xev.property(e);
    return cast(i32, p.window == w.root && p.atom == w.property);
}

// The resources' settings into s; 1 when the property was there.
fn read(w as *Watch, s as *settings.Settings) as i32 {
    let is i64 as kind with mut = 0;
    let is i32 as format with mut = 0;
    let is i64 as nitems with mut = 0;
    let is i64 as after with mut = 0;
    let is *u8 as data with mut = cast(*u8, 0);
    // XA_STRING is 31; a property of another type comes back empty.
    xlib.XGetWindowProperty(w.display, w.root, w.property, 0, 1048576, 0, 31,
                            cast(*u8, &kind), cast(*u8, &format), cast(*u8, &nitems),
                            cast(*u8, &after), cast(*u8, &data));
    let is i32 as ok with mut = 0;
    if (format == 8 && cast(i64, data) != 0) {
        parse(data, nitems, s);
        ok = 1;
    }
    xlib.XFree(data);
    return ok;
}

// "name:\tvalue" lines, n bytes at p: the ones this reads into s.
fn parse(p as *u8, n as i64, s as *settings.Settings) as void {
    let is i64 as at with mut = 0;
    while (at < n) {
        let is i64 as end with mut = at;
        while (end < n && p[end] != 10) { end = end + 1; }
        _line(cast(*u8, cast(i64, p) + at), end - at, s);
        at = end + 1;
    }
}

fn _line(p as *u8, n as i64, s as *settings.Settings) as void {
    let is i64 as colon with mut = 0;
    while (colon < n && p[colon] != 58) { colon = colon + 1; }
    if (colon == n) { return; }
    let is i64 as v with mut = colon + 1;
    while (v < n && (p[v] == 32 || p[v] == 9)) { v = v + 1; }
    let is i64 as vend with mut = n;
    while (vend > v && (p[vend - 1] == 32 || p[vend - 1] == 9 || p[vend - 1] == 13)) { vend = vend - 1; }
    if (vend == v) { return; }
    let is *u8 as value = cast(*u8, cast(i64, p) + v);
    let is i64 as len = vend - v;
    if (_is(p, colon, "Xcursor.theme") == 1) {
        settings.set_text(cast(*u8, &s.cursor_theme), 64, value, len);
        s.known = s.known | settings.K_CURSOR_THEME;
    } else if (_is(p, colon, "Xcursor.size") == 1) {
        let is f64 as size = _number(value, len);
        if (size >= 1.0 && size <= 512.0) { s.cursor_size = cast(i64, size); s.known = s.known | settings.K_CURSOR_SIZE; }
    } else if (_is(p, colon, "Xft.dpi") == 1) {
        let is f64 as dpi = _number(value, len);
        if (dpi >= 24.0 && dpi <= 1536.0) { s.dpi = dpi; s.known = s.known | settings.K_DPI; }
    }
}

fn _is(p as *u8, n as i64, name as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < n && name[i] != 0 && p[i] == name[i]) { i = i + 1; }
    return cast(i32, i == n && name[i] == 0);
}

// A decimal number, n bytes at p; -1 for anything else.
fn _number(p as *u8, n as i64) as f64 {
    let is f64 as value with mut = 0.0;
    let is f64 as scale with mut = 0.0;
    let is i64 as i with mut = 0;
    if (n == 0) { return 0.0 - 1.0; }
    while (i < n) {
        let is u8 as ch = p[i];
        if (ch == 46 && scale == 0.0) { scale = 1.0; }
        else if (ch >= 48 && ch <= 57) {
            let is f64 as d = cast(f64, cast(i64, ch) - 48);
            if (scale > 0.0) { scale = scale / 10.0; value = value + d * scale; } else { value = value * 10.0 + d; }
        } else { return 0.0 - 1.0; }
        i = i + 1;
    }
    return value;
}
