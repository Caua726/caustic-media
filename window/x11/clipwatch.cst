// window/x11/clipwatch.cst — the clipboard and the primary selection heard
// changing hands: another program copying, this one taking it back.
//
// XFixes tells a client when a selection is set, its owner window goes or its
// owner's client leaves. From then on each change has what the selection now
// offers asked for (its TARGETS, clipboard.cst's WATCH slot), and the answer
// arrives in the window's ring as a CLIPBOARD_CHANGED event (events.cst):
// which selection, and the formats it offers.
//
// Kept out of window.cst, as compositor.cst is: this links libXfixes, which a
// window program that never asks need not have.
use "bind/xlib.cst" as xlib;
use "bind/xfixes.cst" as xfixes;
use "window.cst" as window;

// XFixes' masks for a selection: set, its owner window destroyed, its owner's
// client gone.
let is i64 as _SELECTION_CHANGES with imut = 7;

// Follows the clipboard and the primary selection for every window on w's
// connection — once a connection. 1 when followed, 0 when the server has no
// XFixes.
fn follow(w as *window.Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (window.following_clipboard() == 1) { return 1; }
    let is i32 as event_base with mut = 0;
    let is i32 as error_base with mut = 0;
    if (xfixes.XFixesQueryExtension(w.display, cast(*u8, &event_base), cast(*u8, &error_base)) == 0) { return 0; }
    let is i64 as clip = xlib.XInternAtom(w.display, "CLIPBOARD", 0);
    let is i64 as primary = xlib.XInternAtom(w.display, "PRIMARY", 0);
    let is i64 as root = xlib.XRootWindow(w.display, w.screen);
    xfixes.XFixesSelectSelectionInput(w.display, root, clip, _SELECTION_CHANGES);
    xfixes.XFixesSelectSelectionInput(w.display, root, primary, _SELECTION_CHANGES);
    xlib.XFlush(w.display);
    // XFixesSelectionNotify is the extension's first event.
    window.follow_clipboard(event_base, clip, primary);
    return 1;
}
