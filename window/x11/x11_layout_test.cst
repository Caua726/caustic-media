    test_XNoExposeEvent();
    test_XVisibilityEvent();
    test_XCreateWindowEvent();
    test_XDestroyWindowEvent();
    test_XUnmapEvent();
    test_XMapEvent();
    test_XMapRequestEvent();
    test_XReparentEvent();
    test_XConfigureEvent();
    test_XGravityEvent();
    test_XResizeRequestEvent();
    test_XConfigureRequestEvent();
    test_XCirculateEvent();
    test_XCirculateRequestEvent();
    test_XPropertyEvent();
    test_XSelectionClearEvent();
    test_XSelectionRequestEvent();
    test_XSelectionEvent();
    test_XColormapEvent();
    test_XClientMessageEvent();
    test_XMappingEvent();
    test_XErrorEvent();
    test_XGenericEvent();
    test_XGenericEventCookie();
    test_views();
    test_Depth();
    test_Screen();
    test_ScreenFormat();
    test_Visual();
    test_XArc();
    test_XChar2b();
    test_XCharStruct();
    test_XColor();
    test_XExtCodes();
    test_XExtData();
    test_XFontProp();
    test_XFontSetExtents();
    test_XFontStruct();
    test_XGCValues();
    test_XHostAddress();
    test_XICCallback();
    test_XIMCallback();
    test_XIMHotKeyTrigger();
    test_XIMHotKeyTriggers();
    test_XIMPreeditCaretCallbackStruct();
    test_XIMPreeditDrawCallbackStruct();
    test_XIMPreeditStateNotifyCallbackStruct();
    test_XIMStatusDrawCallbackStruct();
    test_XIMStringConversionCallbackStruct();
    test_XIMStringConversionText();
    test_XIMStyles();
    test_XIMText();
    test_XIMValuesList();
    test_XImage();
    test_XKeyboardControl();
    test_XKeyboardState();
    test_XModifierKeymap();
    test_XOMCharSetList();
    test_XOMFontInfo();
    test_XOMOrientation();
    test_XPixmapFormatValues();
    test_XPoint();
    test_XRectangle();
    test_XSegment();
    test_XServerInterpretedAddress();
    test_XSetWindowAttributes();
    test_XTextItem();
    test_XTextItem16();
    test_XTimeCoord();
    test_XWindowAttributes();
    test_XWindowChanges();
    test_XmbTextItem();
    test_XwcTextItem();
    test_XSizeHints();
    test_XShmSegmentInfo();
    test_XScreenSaverInfo();

    if (fails == 0) { io.printf("x11 layout: all checks passed\n"); }
    else { io.printf("  x11_layout_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
