    let is i64 as b = cast(i64, &e);
    chk_i("sizeof XSetWindowAttributes", sizeof(xlib.XSetWindowAttributes), 112);
    chk_i("XSetWindowAttributes.background_pixmap", off(b, cast(i64, &e.background_pixmap)), 0);
    chk_i("XSetWindowAttributes.background_pixel", off(b, cast(i64, &e.background_pixel)), 8);
    chk_i("XSetWindowAttributes.border_pixmap", off(b, cast(i64, &e.border_pixmap)), 16);
    chk_i("XSetWindowAttributes.border_pixel", off(b, cast(i64, &e.border_pixel)), 24);
    chk_i("XSetWindowAttributes.bit_gravity", off(b, cast(i64, &e.bit_gravity)), 32);
    chk_i("XSetWindowAttributes.win_gravity", off(b, cast(i64, &e.win_gravity)), 36);
    chk_i("XSetWindowAttributes.backing_store", off(b, cast(i64, &e.backing_store)), 40);
    chk_i("XSetWindowAttributes.backing_planes", off(b, cast(i64, &e.backing_planes)), 48);
    chk_i("XSetWindowAttributes.backing_pixel", off(b, cast(i64, &e.backing_pixel)), 56);
    chk_i("XSetWindowAttributes.save_under", off(b, cast(i64, &e.save_under)), 64);
    chk_i("XSetWindowAttributes.event_mask", off(b, cast(i64, &e.event_mask)), 72);
    chk_i("XSetWindowAttributes.do_not_propagate_mask", off(b, cast(i64, &e.do_not_propagate_mask)), 80);
    chk_i("XSetWindowAttributes.override_redirect", off(b, cast(i64, &e.override_redirect)), 88);
    chk_i("XSetWindowAttributes.colormap", off(b, cast(i64, &e.colormap)), 96);
    chk_i("XSetWindowAttributes.cursor", off(b, cast(i64, &e.cursor)), 104);
}

