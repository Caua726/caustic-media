// The one the whole window layer depends on. `above` at 72 rather than 68 is
// _pad2 doing its job; without it a resize reads a Window out of two halves of
// two different fields.
fn test_XConfigureEvent() as void {
    let is ev.XConfigureEvent as e;
    let is i64 as b = cast(i64, &e);
    chk_i("sizeof XConfigureEvent",            sizeof(ev.XConfigureEvent), 88);
    chk_i("XConfigureEvent.kind",              off(b, cast(i64, &e.kind)),               0);
    chk_i("XConfigureEvent.serial",            off(b, cast(i64, &e.serial)),             8);
    chk_i("XConfigureEvent.send_event",        off(b, cast(i64, &e.send_event)),        16);
    chk_i("XConfigureEvent.display",           off(b, cast(i64, &e.display)),           24);
    chk_i("XConfigureEvent.event",             off(b, cast(i64, &e.event)),             32);
    chk_i("XConfigureEvent.window",            off(b, cast(i64, &e.window)),            40);
    chk_i("XConfigureEvent.x",                 off(b, cast(i64, &e.x)),                 48);
    chk_i("XConfigureEvent.y",                 off(b, cast(i64, &e.y)),                 52);
    chk_i("XConfigureEvent.width",             off(b, cast(i64, &e.width)),             56);
    chk_i("XConfigureEvent.height",            off(b, cast(i64, &e.height)),            60);
    chk_i("XConfigureEvent.border_width",      off(b, cast(i64, &e.border_width)),      64);
    chk_i("XConfigureEvent.above",             off(b, cast(i64, &e.above)),             72);
    chk_i("XConfigureEvent.override_redirect", off(b, cast(i64, &e.override_redirect)), 80);
}

