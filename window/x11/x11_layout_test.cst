// --- The shared-memory extension ---
//
// The one struct whose ADDRESS matters as much as its layout. XShmCreateImage
// stores a pointer to it in the XImage and every XShmPutImage reads the
// segment id back out through that pointer, so it has to be laid out right and
// it has to stay put. surface.cst maps it for the second reason; this is the
// first.
fn test_XShmSegmentInfo() as void {
    let is xshm.XShmSegmentInfo as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof XShmSegmentInfo",   sizeof(xshm.XShmSegmentInfo), 32);
    chk_i("XShmSegmentInfo.shmseg",   off(b, cast(i64, &s.shmseg)),    0);
    chk_i("XShmSegmentInfo.shmid",    off(b, cast(i64, &s.shmid)),     8);
    chk_i("XShmSegmentInfo.shmaddr",  off(b, cast(i64, &s.shmaddr)),  16);
    chk_i("XShmSegmentInfo.readOnly", off(b, cast(i64, &s.readOnly)), 24);
}

// --- MIT-SCREEN-SAVER ---

fn test_XScreenSaverInfo() as void {
    let is xss.XScreenSaverInfo as i;
    let is i64 as b = cast(i64, &i);
    chk_i("sizeof XScreenSaverInfo",        sizeof(xss.XScreenSaverInfo), 40);
    chk_i("XScreenSaverInfo.window",        off(b, cast(i64, &i.window)),        0);
    chk_i("XScreenSaverInfo.state",         off(b, cast(i64, &i.state)),         8);
    chk_i("XScreenSaverInfo.kind",          off(b, cast(i64, &i.kind)),         12);
    chk_i("XScreenSaverInfo.til_or_since",  off(b, cast(i64, &i.til_or_since)), 16);
    chk_i("XScreenSaverInfo.idle",          off(b, cast(i64, &i.idle)),         24);
    chk_i("XScreenSaverInfo.eventMask",     off(b, cast(i64, &i.eventMask)),    32);
}

// --- Xutil.h ---
//
// The one struct here that is not Xlib.h's, and the only one in the bindings
// with a nested struct field. min_aspect at 48 and max_aspect at 56 are what
// pin that: an XAspect laid out wrong would put base_width where win_gravity
// belongs, and a window would ask for a size nobody meant.
fn test_XSizeHints() as void {
    let is xutil.XSizeHints as h;
    let is i64 as b = cast(i64, &h);
    chk_i("sizeof XSizeHints",         sizeof(xutil.XSizeHints), 80);
    chk_i("XSizeHints.flags",          off(b, cast(i64, &h.flags)),        0);
    chk_i("XSizeHints.x",              off(b, cast(i64, &h.x)),            8);
    chk_i("XSizeHints.y",              off(b, cast(i64, &h.y)),           12);
    chk_i("XSizeHints.width",          off(b, cast(i64, &h.width)),       16);
    chk_i("XSizeHints.height",         off(b, cast(i64, &h.height)),      20);
    chk_i("XSizeHints.min_width",      off(b, cast(i64, &h.min_width)),   24);
    chk_i("XSizeHints.min_height",     off(b, cast(i64, &h.min_height)),  28);
    chk_i("XSizeHints.max_width",      off(b, cast(i64, &h.max_width)),   32);
    chk_i("XSizeHints.max_height",     off(b, cast(i64, &h.max_height)),  36);
    chk_i("XSizeHints.width_inc",      off(b, cast(i64, &h.width_inc)),   40);
    chk_i("XSizeHints.height_inc",     off(b, cast(i64, &h.height_inc)),  44);
    chk_i("XSizeHints.min_aspect",     off(b, cast(i64, &h.min_aspect)),  48);
    chk_i("XSizeHints.max_aspect",     off(b, cast(i64, &h.max_aspect)),  56);
    chk_i("XSizeHints.base_width",     off(b, cast(i64, &h.base_width)),  64);
    chk_i("XSizeHints.base_height",    off(b, cast(i64, &h.base_height)), 68);
    chk_i("XSizeHints.win_gravity",    off(b, cast(i64, &h.win_gravity)), 72);
}

