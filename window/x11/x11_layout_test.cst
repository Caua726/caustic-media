// window/x11/x11_layout_test.cst — the pads are right, or this fails.
//
// Caustic structs are packed and C structs are not, so every struct in bind/
// carries explicit _padN fields wherever the C ABI would have aligned. A
// missing one is not a compile error and not a crash: it is a field read at the
// wrong offset, which is silent memory corruption. window.md records what that
// costs — interleaved banding that took XGetImage on our own window to explain,
// after two wrong guesses.
//
// This test is what turns that class of bug into a failed assertion. Every
// sizeof and every field position in bind/xevent.cst is checked against the
// numbers in tools/layout.txt, which came out of tools/x11_layout.c asking the
// C compiler that built this machine's libX11.
//
// It links nothing. No libX11, no DISPLAY, no X server — it only measures
// Caustic structs, which is why it belongs in the plain `test` script alongside
// math/ and gpu/ rather than in `test-x11`.
//
// The numbers are x86_64 Linux/glibc. On another architecture they would be
// different and this would fail loudly, which is the correct outcome: it means
// the bindings have not been checked there.
//
// Exit code is the number of failures.
use "std/io.cst" as io;
use "bind/xevent.cst" as ev;
use "bind/xlib.cst" as xlib;
use "bind/xutil.cst" as xutil;
use "bind/xshm.cst" as xshm;
use "bind/xscrnsaver.cst" as xss;

let is i32 as fails with mut = 0;

fn chk_i(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

// Offsets are measured rather than declared: the address of a field minus the
// address of the struct is what the compiler actually laid out, which is the
// only number worth checking.
fn off(base as i64, field as i64) as i64 { return field - base; }

// --- The union's storage ---

fn test_XEvent() as void {
    chk_i("sizeof XEvent", sizeof(ev.XEvent), 192);
}

// --- The common header, and the one member that does not share it ---

fn test_XAnyEvent() as void {
    let is ev.XAnyEvent as e;
    let is i64 as b = cast(i64, &e);
    chk_i("sizeof XAnyEvent",      sizeof(ev.XAnyEvent), 40);
    chk_i("XAnyEvent.kind",        off(b, cast(i64, &e.kind)),        0);
    chk_i("XAnyEvent.serial",      off(b, cast(i64, &e.serial)),      8);
    chk_i("XAnyEvent.send_event",  off(b, cast(i64, &e.send_event)), 16);
    chk_i("XAnyEvent.display",     off(b, cast(i64, &e.display)),    24);
    chk_i("XAnyEvent.window",      off(b, cast(i64, &e.window)),     32);
}

// --- Pointer and keyboard ---

fn test_XKeyEvent() as void {
    let is ev.XKeyEvent as e;
    let is i64 as b = cast(i64, &e);
    chk_i("sizeof XKeyEvent",       sizeof(ev.XKeyEvent), 96);
    chk_i("XKeyEvent.kind",         off(b, cast(i64, &e.kind)),         0);
    chk_i("XKeyEvent.serial",       off(b, cast(i64, &e.serial)),       8);
    chk_i("XKeyEvent.send_event",   off(b, cast(i64, &e.send_event)),  16);
    chk_i("XKeyEvent.display",      off(b, cast(i64, &e.display)),     24);
    chk_i("XKeyEvent.window",       off(b, cast(i64, &e.window)),      32);
    chk_i("XKeyEvent.root",         off(b, cast(i64, &e.root)),        40);
    chk_i("XKeyEvent.subwindow",    off(b, cast(i64, &e.subwindow)),   48);
    chk_i("XKeyEvent.time",         off(b, cast(i64, &e.time)),        56);
    chk_i("XKeyEvent.x",            off(b, cast(i64, &e.x)),           64);
    chk_i("XKeyEvent.y",            off(b, cast(i64, &e.y)),           68);
    chk_i("XKeyEvent.x_root",       off(b, cast(i64, &e.x_root)),      72);
    chk_i("XKeyEvent.y_root",       off(b, cast(i64, &e.y_root)),      76);
    chk_i("XKeyEvent.state",        off(b, cast(i64, &e.state)),       80);
    chk_i("XKeyEvent.keycode",      off(b, cast(i64, &e.keycode)),     84);
    chk_i("XKeyEvent.same_screen",  off(b, cast(i64, &e.same_screen)), 88);
}

