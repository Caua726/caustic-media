// is_hint is a char, so the three bytes after it are pad and same_screen still
// has to land on 88. This is the struct that proves [3]u8 padding works.
fn test_XMotionEvent() as void {
    let is ev.XMotionEvent as e;
    let is i64 as b = cast(i64, &e);
    chk_i("sizeof XMotionEvent",      sizeof(ev.XMotionEvent), 96);
    chk_i("XMotionEvent.kind",        off(b, cast(i64, &e.kind)),         0);
    chk_i("XMotionEvent.serial",      off(b, cast(i64, &e.serial)),       8);
    chk_i("XMotionEvent.send_event",  off(b, cast(i64, &e.send_event)),  16);
    chk_i("XMotionEvent.display",     off(b, cast(i64, &e.display)),     24);
    chk_i("XMotionEvent.window",      off(b, cast(i64, &e.window)),      32);
    chk_i("XMotionEvent.root",        off(b, cast(i64, &e.root)),        40);
    chk_i("XMotionEvent.subwindow",   off(b, cast(i64, &e.subwindow)),   48);
    chk_i("XMotionEvent.time",        off(b, cast(i64, &e.time)),        56);
    chk_i("XMotionEvent.x",           off(b, cast(i64, &e.x)),           64);
    chk_i("XMotionEvent.y",           off(b, cast(i64, &e.y)),           68);
    chk_i("XMotionEvent.x_root",      off(b, cast(i64, &e.x_root)),      72);
    chk_i("XMotionEvent.y_root",      off(b, cast(i64, &e.y_root)),      76);
    chk_i("XMotionEvent.state",       off(b, cast(i64, &e.state)),       80);
    chk_i("XMotionEvent.is_hint",     off(b, cast(i64, &e.is_hint)),     84);
    chk_i("XMotionEvent.same_screen", off(b, cast(i64, &e.same_screen)), 88);
}

