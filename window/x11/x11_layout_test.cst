// --- The views ---
//
// Sizes and offsets prove the structs match C. This proves the casts that stand
// in for the union agree with them: every member has to start where the storage
// starts, or reading the discriminator through one view and the payload through
// another lands in two different places.

fn test_views() as void {
    let is ev.XEvent as e;
    ev.clear(&e);
    let is i64 as b = cast(i64, &e);

    chk_i("view any",               cast(i64, ev.any(&e)),               b);
    chk_i("view key",               cast(i64, ev.key(&e)),               b);
    chk_i("view button",            cast(i64, ev.button(&e)),            b);
    chk_i("view motion",            cast(i64, ev.motion(&e)),            b);
    chk_i("view crossing",          cast(i64, ev.crossing(&e)),          b);
    chk_i("view focus",             cast(i64, ev.focus(&e)),             b);
    chk_i("view keymap",            cast(i64, ev.keymap(&e)),            b);
    chk_i("view expose",            cast(i64, ev.expose(&e)),            b);
    chk_i("view graphics_expose",   cast(i64, ev.graphics_expose(&e)),   b);
    chk_i("view no_expose",         cast(i64, ev.no_expose(&e)),         b);
    chk_i("view visibility",        cast(i64, ev.visibility(&e)),        b);
    chk_i("view create_window",     cast(i64, ev.create_window(&e)),     b);
    chk_i("view destroy_window",    cast(i64, ev.destroy_window(&e)),    b);
    chk_i("view unmap",             cast(i64, ev.unmap(&e)),             b);
    chk_i("view map",               cast(i64, ev.map(&e)),               b);
    chk_i("view map_request",       cast(i64, ev.map_request(&e)),       b);
    chk_i("view reparent",          cast(i64, ev.reparent(&e)),          b);
    chk_i("view configure",         cast(i64, ev.configure(&e)),         b);
    chk_i("view gravity",           cast(i64, ev.gravity(&e)),           b);
    chk_i("view resize_request",    cast(i64, ev.resize_request(&e)),    b);
    chk_i("view configure_request", cast(i64, ev.configure_request(&e)), b);
    chk_i("view circulate",         cast(i64, ev.circulate(&e)),         b);
    chk_i("view circulate_request", cast(i64, ev.circulate_request(&e)), b);
    chk_i("view property",          cast(i64, ev.property(&e)),          b);
    chk_i("view selection_clear",   cast(i64, ev.selection_clear(&e)),   b);
    chk_i("view selection_request", cast(i64, ev.selection_request(&e)), b);
    chk_i("view selection",         cast(i64, ev.selection(&e)),         b);
    chk_i("view colormap",          cast(i64, ev.colormap(&e)),          b);
    chk_i("view client",            cast(i64, ev.client(&e)),            b);
    chk_i("view mapping",           cast(i64, ev.mapping(&e)),           b);
    chk_i("view error",             cast(i64, ev.error(&e)),             b);
    chk_i("view generic",           cast(i64, ev.generic(&e)),           b);
    chk_i("view cookie",            cast(i64, ev.cookie(&e)),            b);

    // clear() has to reach all 192 bytes: XSendEvent transmits the whole union
    // whatever the type field says, so a dirty tail is stack contents on the
    // wire. Write the last word, clear, read it back.
    e.pad[23] = 0 - 1;
    ev.clear(&e);
    chk_i("clear reaches the last word", e.pad[23], 0);

    // The discriminator, read the way every consumer reads it: through a cast
    // rather than through a copy.
    e.pad[0] = 2;
    chk_i("kind reads the first int", cast(i64, ev.kind(&e)), 2);
}


// --- Xlib.h structs that are not events ---
//
// The same check as the events above, for the 48 structs in bind/xlib.cst.
// XImage is the one that carries the software path: a wrong pad before
// red_mask and every colour the server reads is wrong; a wrong sizeof and
// walking the array XGetVisualInfo returns reads every element but the
// first at the wrong offset.

fn test_Depth() as void {
    let is xlib.Depth as e;
    let is i64 as b = cast(i64, &e);
    chk_i("sizeof Depth", sizeof(xlib.Depth), 16);
    chk_i("Depth.depth", off(b, cast(i64, &e.depth)), 0);
    chk_i("Depth.nvisuals", off(b, cast(i64, &e.nvisuals)), 4);
    chk_i("Depth.visuals", off(b, cast(i64, &e.visuals)), 8);
}

