// window/settings.cst — what the desktop says about how things should look
// and behave: dark or light, high contrast, the accent colour, the interface
// and monospace fonts, text scaling, animations, double-click time and
// distance, how far a press moves before it drags, the caret's blink, the
// cursor theme, the title bar's buttons.
//
// One record, filled by whichever sources the platform has:
//
//   Linux     linux/gtk_ini.cst  ~/.config/gtk-3.0 and gtk-4.0 settings.ini
//             x11/xsettings.cst  XSETTINGS, from the settings daemon, on X11
//             linux/portal.cst   org.freedesktop.portal.Settings, over D-Bus
//   Windows   the registry and SystemParametersInfoW, with the Win32 backend
//
// Each source marks in known what it reported, and merge lays one record
// over another field by field, so the order of the sources is the order of
// trust: the files first, then XSETTINGS, then the portal, which is what
// GNOME, KDE and the others keep current. What no source reported keeps its
// default.
//
// Turning this into a theme and the toolkit's timings is ui/'s
// (ui/system.cst); this layer only reads.
use "std/mem.cst" as mem;

let is i64 as K_DARK            with imut = 1;
let is i64 as K_HIGH_CONTRAST   with imut = 2;
let is i64 as K_ANIMATIONS      with imut = 4;
let is i64 as K_BLINK           with imut = 8;
let is i64 as K_ACCENT          with imut = 16;
let is i64 as K_FONT            with imut = 32;
let is i64 as K_MONO            with imut = 64;
let is i64 as K_TEXT_SCALE      with imut = 128;
let is i64 as K_DPI             with imut = 256;
let is i64 as K_DOUBLE_CLICK_MS with imut = 512;
let is i64 as K_DOUBLE_CLICK_PX with imut = 1024;
let is i64 as K_BLINK_MS        with imut = 2048;
let is i64 as K_CURSOR_THEME    with imut = 4096;
let is i64 as K_CURSOR_SIZE     with imut = 8192;
let is i64 as K_BUTTON_LAYOUT   with imut = 16384;
let is i64 as K_DRAG           with imut = 32768;

struct Settings {
    known           as i64;   // K_* bits: what some source reported
    dark            as i32;
    high_contrast   as i32;
    animations      as i32;   // 0: the user asked for less motion
    blink           as i32;   // the text caret blinks
    accent_r        as f64;   // sRGB, 0 to 1
    accent_g        as f64;
    accent_b        as f64;
    font            as [128]u8;   // the interface font's family
    font_size       as f64;       // points
    mono            as [128]u8;
    mono_size       as f64;
    text_scale      as f64;   // 1 for none
    dpi             as f64;   // logical DPI, 96 for none
    double_click_ms as i64;
    double_click_px as i64;
    drag_px         as i64;   // how far a pressed pointer moves before it drags
    blink_ms        as i64;   // one whole on-and-off cycle
    cursor_theme    as [64]u8;
    cursor_size     as i64;
    button_layout   as [96]u8;    // GNOME's form: "appmenu:minimize,maximize,close"
}

fn defaults() as Settings {
    let is Settings as s;
    mem.memzero(cast(*u8, &s), sizeof(Settings));
    s.known = 0;
    s.dark = 0;
    s.high_contrast = 0;
    s.animations = 1;
    s.blink = 1;
    s.accent_r = 0.20784313725490197;   // #3584E4
    s.accent_g = 0.5176470588235295;
    s.accent_b = 0.8941176470588236;
    s.font_size = 0.0;
    s.mono_size = 0.0;
    s.text_scale = 1.0;
    s.dpi = 96.0;
    s.double_click_ms = 400;
    s.double_click_px = 5;
    s.drag_px = 8;
    s.blink_ms = 1200;
    s.cursor_size = 24;
    return s;
}

fn _at(s as *u8, i as i64) as u8 { return *cast(*u8, cast(i64, s) + i); }

// s, n bytes of it, into dst (cap bytes), zero-terminated and cut to fit.
fn set_text(dst as *u8, cap as i64, s as *u8, n as i64) as void {
    let is i64 as k with mut = n;
    if (k > cap - 1) { k = cap - 1; }
    if (k < 0) { k = 0; }
    mem.memcpy(dst, s, k);
    *cast(*u8, cast(i64, dst) + k) = 0;
}

// from laid over into: every field from reported.
fn merge(into as *Settings, from as *Settings) as void {
    let is i64 as k = from.known;
    if ((k & K_DARK) != 0) { into.dark = from.dark; }
    if ((k & K_HIGH_CONTRAST) != 0) { into.high_contrast = from.high_contrast; }
    if ((k & K_ANIMATIONS) != 0) { into.animations = from.animations; }
    if ((k & K_BLINK) != 0) { into.blink = from.blink; }
    if ((k & K_ACCENT) != 0) {
        into.accent_r = from.accent_r;
        into.accent_g = from.accent_g;
        into.accent_b = from.accent_b;
    }
    if ((k & K_FONT) != 0) {
        mem.memcpy(cast(*u8, &into.font), cast(*u8, &from.font), 128);
        into.font_size = from.font_size;
    }
    if ((k & K_MONO) != 0) {
        mem.memcpy(cast(*u8, &into.mono), cast(*u8, &from.mono), 128);
        into.mono_size = from.mono_size;
    }
    if ((k & K_TEXT_SCALE) != 0) { into.text_scale = from.text_scale; }
    if ((k & K_DPI) != 0) { into.dpi = from.dpi; }
    if ((k & K_DOUBLE_CLICK_MS) != 0) { into.double_click_ms = from.double_click_ms; }
    if ((k & K_DOUBLE_CLICK_PX) != 0) { into.double_click_px = from.double_click_px; }
    if ((k & K_DRAG) != 0) { into.drag_px = from.drag_px; }
    if ((k & K_BLINK_MS) != 0) { into.blink_ms = from.blink_ms; }
    if ((k & K_CURSOR_THEME) != 0) { mem.memcpy(cast(*u8, &into.cursor_theme), cast(*u8, &from.cursor_theme), 64); }
    if ((k & K_CURSOR_SIZE) != 0) { into.cursor_size = from.cursor_size; }
    if ((k & K_BUTTON_LAYOUT) != 0) { mem.memcpy(cast(*u8, &into.button_layout), cast(*u8, &from.button_layout), 96); }
    into.known = into.known | k;
}

// --- Theme names ---

fn _lower(c as u8) as u8 {
    if (c >= 65 && c <= 90) { return cast(u8, cast(i64, c) + 32); }
    return c;
}

// Whether s (n bytes) holds t, ignoring case.
fn _has(s as *u8, n as i64, t as *u8) as i32 {
    let is i64 as m with mut = 0;
    while (_at(t, m) != 0) { m = m + 1; }
    let is i64 as i with mut = 0;
    while (i + m <= n) {
        let is i64 as j with mut = 0;
        while (j < m && _lower(_at(s, i + j)) == _lower(_at(t, j))) { j = j + 1; }
        if (j == m) { return 1; }
        i = i + 1;
    }
    return 0;
}

// What a GTK theme's name says: "Adwaita-dark", "Breeze-Dark", "Adwaita:dark"
// are dark; "HighContrast" is high contrast, "HighContrastInverse" both.
fn theme_name(s as *Settings, name as *u8, n as i64) as void {
    if (_has(name, n, "-dark") == 1 || _has(name, n, ":dark") == 1 || _has(name, n, "inverse") == 1) {
        s.dark = 1;
        s.known = s.known | K_DARK;
    }
    if (_has(name, n, "highcontrast") == 1 || _has(name, n, "high-contrast") == 1) {
        s.high_contrast = 1;
        s.known = s.known | K_HIGH_CONTRAST;
    }
}

// --- Font descriptions ---
//
// Pango's form, which GTK, XSETTINGS and the GNOME settings use: families
// separated by commas, style words, a size in points — or in pixels with
// "px" — last: "Cantarell 11", "Noto Sans,  10", "Inter Variable Medium
// 10.5", "Source Code Pro Bold Italic 10". The first family is kept; the style
// words are the font matcher's to apply, and dropped here.

let is [24]*u8 as _styles with mut;
let is i32 as _styles_ready with mut = 0;

fn _style_words() as void {
    if (_styles_ready == 1) { return; }
    _styles[0] = "bold"; _styles[1] = "italic"; _styles[2] = "oblique"; _styles[3] = "light";
    _styles[4] = "medium"; _styles[5] = "regular"; _styles[6] = "book"; _styles[7] = "thin";
    _styles[8] = "heavy"; _styles[9] = "black"; _styles[10] = "semi-bold"; _styles[11] = "semibold";
    _styles[12] = "ultra-bold"; _styles[13] = "extra-bold"; _styles[14] = "ultra-light"; _styles[15] = "extra-light";
    _styles[16] = "condensed"; _styles[17] = "expanded"; _styles[18] = "normal"; _styles[19] = "small-caps";
    _styles[20] = "semi-light"; _styles[21] = "demi-bold"; _styles[22] = "roman"; _styles[23] = "ultra-heavy";
    _styles_ready = 1;
}

fn _is_style(s as *u8, n as i64) as i32 {
    _style_words();
    let is i64 as i with mut = 0;
    while (i < 24) {
        let is *u8 as w = _styles[i];
        let is i64 as m with mut = 0;
        while (_at(w, m) != 0) { m = m + 1; }
        if (m == n) {
            let is i64 as j with mut = 0;
            while (j < n && _lower(_at(s, j)) == _at(w, j)) { j = j + 1; }
            if (j == n) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

fn _space(c as u8) as i32 {
    if (c == 32 || c == 9 || c == 44) { return 1; }
    return 0;
}

// A number, digits and at most one point, from s[i] to s[j - 1]; -1 if not.
// Called on a word, never on nothing.
fn _number(s as *u8, i as i64, j as i64) as f64 {
    let is f64 as v with mut = 0.0;
    let is f64 as scale with mut = 0.0;
    let is i64 as k with mut = i;
    while (k < j) {
        let is u8 as c = _at(s, k);
        if (c == 46) {
            if (scale > 0.0) { return 0.0 - 1.0; }
            scale = 1.0;
        } else if (c >= 48 && c <= 57) {
            let is f64 as d = cast(f64, cast(i64, c) - 48);
            if (scale > 0.0) {
                scale = scale / 10.0;
                v = v + d * scale;
            } else {
                v = v * 10.0 + d;
            }
        } else {
            return 0.0 - 1.0;
        }
        k = k + 1;
    }
    return v;
}

// The family of desc (n bytes) into family (cap bytes), and its size in
// points into size — 0 when it gives none. 1 when there was a family.
fn parse_font(desc as *u8, n as i64, family as *u8, cap as i64, size as *f64) as i32 {
    *size = 0.0;
    let is i64 as end with mut = n;
    while (end > 0 && _space(_at(desc, end - 1)) == 1) { end = end - 1; }
    // The size: the last word, if it is a number.
    let is i64 as w with mut = end;
    while (w > 0 && _space(_at(desc, w - 1)) == 0) { w = w - 1; }
    let is i64 as numend with mut = end;
    let is i32 as px with mut = 0;
    if (end - w > 2 && _at(desc, end - 2) == 112 && _at(desc, end - 1) == 120) {   // "px"
        numend = end - 2;
        px = 1;
    }
    let is f64 as v = _number(desc, w, numend);
    if (v >= 0.0) {
        *size = v;
        if (px == 1) { *size = v * 72.0 / 96.0; }
        end = w;
    }
    // The first family: up to the first comma.
    let is i64 as comma with mut = 0;
    while (comma < end && _at(desc, comma) != 44) { comma = comma + 1; }
    if (comma < end) { end = comma; }
    // Style words off the end.
    let is i32 as more with mut = 1;
    while (more == 1) {
        while (end > 0 && _space(_at(desc, end - 1)) == 1) { end = end - 1; }
        let is i64 as ws with mut = end;
        while (ws > 0 && _space(_at(desc, ws - 1)) == 0) { ws = ws - 1; }
        more = 0;
        // Every word may be one: "Bold 12" names no family, as Pango reads it.
        if (_is_style(_at_ptr(desc, ws), end - ws) == 1) {
            end = ws;
            more = 1;
        }
    }
    let is i64 as start with mut = 0;
    while (start < end && _space(_at(desc, start)) == 1) { start = start + 1; }
    set_text(family, cap, _at_ptr(desc, start), end - start);
    if (end > start) { return 1; }
    return 0;
}

fn _at_ptr(s as *u8, i as i64) as *u8 { return cast(*u8, cast(i64, s) + i); }

// A font description into s's interface font, or with mono, its monospace one.
fn set_font(s as *Settings, desc as *u8, n as i64, mono as i32) as void {
    let is f64 as size with mut = 0.0;
    if (mono == 1) {
        if (parse_font(desc, n, cast(*u8, &s.mono), 128, &size) == 1) {
            s.mono_size = size;
            s.known = s.known | K_MONO;
        }
        return;
    }
    if (parse_font(desc, n, cast(*u8, &s.font), 128, &size) == 1) {
        s.font_size = size;
        s.known = s.known | K_FONT;
    }
}
