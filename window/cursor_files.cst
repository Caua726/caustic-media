// window/cursor_files.cst — Xcursor theme files as the cursor tests write
// them (xcursor_test, pointer_x11_test, wayland/cursor_test): images of one
// colour each, given one by one with image(), then saved as one file.
use "std/os/linux.cst" as linux;
use "xcursor.cst" as xcursor;

struct Image {
    nominal as i32;
    side    as i32;
    xhot    as i32;
    yhot    as i32;
    delay   as i32;
    argb    as u32;
}

let is [8]Image as _images with mut;
let is i32 as _count with mut = 0;
let is [131072]u8 as _file with mut;

fn _put32(off as i64, v as u32) as void {
    _file[off] = cast(u8, v & 255); _file[off + 1] = cast(u8, (v >> 8) & 255);
    _file[off + 2] = cast(u8, (v >> 16) & 255); _file[off + 3] = cast(u8, (v >> 24) & 255);
}

// The next image of the file: side by side pixels of argb (premultiplied),
// at nominal size nominal, its hot spot, its delay in ms.
fn image(nominal as i32, side as i32, xhot as i32, yhot as i32, delay as i32, argb as u32) as void {
    if (_count >= 8) { return; }
    let is *Image as m = &_images[_count];
    m.nominal = nominal; m.side = side; m.xhot = xhot; m.yhot = yhot; m.delay = delay; m.argb = argb;
    _count = _count + 1;
}

// The images given since the last save, in their order, as the cursor file
// at path: 1, or 0 when it could not be written.
fn save(path as *u8) as i32 {
    let is i64 as header = 16;
    let is i64 as at with mut = header + cast(i64, _count) * 12;
    _put32(0, xcursor.FILE_MAGIC); _put32(4, 16); _put32(8, 65536); _put32(12, cast(u32, _count));
    let is i32 as k with mut = 0;
    while (k < _count) {
        let is *Image as m = &_images[k];
        let is i64 as e = header + cast(i64, k) * 12;
        let is i64 as pixels = cast(i64, m.side) * cast(i64, m.side);
        if (at + 36 + pixels * 4 > 131072) { _count = 0; return 0; }
        _put32(e, xcursor.IMAGE_TYPE); _put32(e + 4, cast(u32, m.nominal)); _put32(e + 8, cast(u32, at));
        _put32(at, 36); _put32(at + 4, xcursor.IMAGE_TYPE); _put32(at + 8, cast(u32, m.nominal)); _put32(at + 12, 1);
        _put32(at + 16, cast(u32, m.side)); _put32(at + 20, cast(u32, m.side));
        _put32(at + 24, cast(u32, m.xhot)); _put32(at + 28, cast(u32, m.yhot)); _put32(at + 32, cast(u32, m.delay));
        at = at + 36;
        let is i64 as i with mut = 0;
        while (i < pixels) { _put32(at, m.argb); at = at + 4; i = i + 1; }
        k = k + 1;
    }
    _count = 0;
    return write_text_n(path, &_file[0], at);
}

fn write_text_n(path as *u8, bytes as *u8, n as i64) as i32 {
    let is i64 as fd = linux.open(path, 577, 420);
    if (fd < 0) { return 0; }
    let is i64 as wrote = linux.write(fd, bytes, n);
    linux.close(fd);
    return cast(i32, wrote == n);
}

fn write_text(path as *u8, text as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (text[n] != 0) { n = n + 1; }
    return write_text_n(path, text, n);
}

let is [1024]u8 as _path with mut;

// root/rel, in a buffer the next call writes over.
fn under(root as *u8, rel as *u8) as *u8 {
    let is i64 as n with mut = 0;
    while (root[n] != 0 && n < 500) { _path[n] = root[n]; n = n + 1; }
    _path[n] = 47; n = n + 1;
    let is i64 as i with mut = 0;
    while (rel[i] != 0 && n < 1023) { _path[n] = rel[i]; n = n + 1; i = i + 1; }
    _path[n] = 0;
    return &_path[0];
}

// The directory of theme under root, with its cursors/ directory.
fn theme_dirs(root as *u8, theme as *u8) as void {
    linux.mkdir(root, 493);
    linux.mkdir(under(root, theme), 493);
    let is [256]u8 as rel with mut;
    let is i64 as n with mut = 0;
    while (theme[n] != 0 && n < 240) { rel[n] = theme[n]; n = n + 1; }
    let is *u8 as tail = "/cursors";
    let is i64 as i with mut = 0;
    while (tail[i] != 0) { rel[n] = tail[i]; n = n + 1; i = i + 1; }
    rel[n] = 0;
    linux.mkdir(under(root, &rel[0]), 493);
}
