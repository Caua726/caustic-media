// window/event.cst — what happens to a window, across all backends: it is
// resized, exposed, focused, closed; the desktop's settings, its state, a
// drag from another program, a popup taken down, the compositor.
//
// What a person does with the keyboard and the pointer is input, not this:
// input/event.cst's events, from device.poll_input, in a queue of its own.
// The numbers here keep the places they had when both lived together.

let is i32 as NONE       with imut = 0;
// The keyboard's focus came to the window or left it: the window is the
// active one or not. Input that was held is let go by input's CANCEL.
let is i32 as FOCUS_IN   with imut = 9;
let is i32 as FOCUS_OUT  with imut = 10;
let is i32 as RESIZE     with imut = 11;
let is i32 as EXPOSE     with imut = 12;
let is i32 as CLOSE      with imut = 13;
let is i32 as OTHER      with imut = 14;
// The desktop's settings changed — dark mode, the accent, fonts, timings,
// the window's scale; read them again (settings.cst).
let is i32 as SETTINGS   with imut = 15;
// The window manager changed the window's state: maximized, full screen,
// minimized, a side against the screen's or another window's (state,
// STATE_* bits).
let is i32 as STATE      with imut = 16;
// Something dragged over the window from another program: it came in, with
// what it offers in drop (DROP_FILES, DROP_TEXT); it moved, to x, y; it left,
// or was let go where it was not taken; it was dropped at x, y and what drop
// says arrived (device.dropped_files, device.dropped_text).
let is i32 as DND_ENTER  with imut = 17;
let is i32 as DND_MOVE   with imut = 18;
let is i32 as DND_LEAVE  with imut = 19;
let is i32 as DND_DROP   with imut = 20;
// A popup taken down by the window system — a press outside the program's
// popups, the compositor's popup_done — which the program is to close.
let is i32 as POPUP_DONE with imut = 24;
// Whether what a window leaves transparent shows what is behind it changed —
// a compositing manager started or stopped: device.composited says which
// now, and a frame of the program's own is drawn flat or with its shadow.
let is i32 as COMPOSITOR with imut = 25;

// A window's state: bits.
let is i32 as STATE_MAXIMIZED    with imut = 1;
let is i32 as STATE_FULLSCREEN   with imut = 2;
// Minimized: not shown until it is restored. Wayland says it as suspended,
// which a compositor also says of a window on another workspace or wholly
// covered — not shown, all the same.
let is i32 as STATE_MINIMIZED    with imut = 4;
let is i32 as STATE_TILED_TOP    with imut = 16;
let is i32 as STATE_TILED_RIGHT  with imut = 32;
let is i32 as STATE_TILED_BOTTOM with imut = 64;
let is i32 as STATE_TILED_LEFT   with imut = 128;

// What a drag offers, what a program takes, what arrived: bits.
let is i32 as DROP_FILES with imut = 1;
let is i32 as DROP_TEXT  with imut = 2;

struct Event {
    kind      as i32;
    raw_kind  as i32;   // the platform's own event type
    x         as i64;   // DND_*: the pointer; EXPOSE: the area's corner
    y         as i64;
    width     as i64;   // RESIZE, EXPOSE
    height    as i64;
    drop      as i32;   // DND_ENTER: what is offered; DND_DROP: what arrived
    state     as i32;   // STATE: STATE_* bits
}

fn clear(e as *Event) as void {
    e.kind = NONE;
    e.raw_kind = 0;
    e.x = 0;
    e.y = 0;
    e.width = 0;
    e.height = 0;
    e.drop = 0;
    e.state = 0;
}
