// window/event.cst — portable event definition across all backends.

let is i32 as NONE       with imut = 0;
let is i32 as KEY_DOWN   with imut = 1;
let is i32 as KEY_UP     with imut = 2;
let is i32 as MOUSE_DOWN with imut = 3;
let is i32 as MOUSE_UP   with imut = 4;
let is i32 as MOUSE_MOVE with imut = 5;
let is i32 as WHEEL      with imut = 6;
let is i32 as ENTER      with imut = 7;
let is i32 as LEAVE      with imut = 8;
let is i32 as FOCUS_IN   with imut = 9;
let is i32 as FOCUS_OUT  with imut = 10;
let is i32 as RESIZE     with imut = 11;
let is i32 as EXPOSE     with imut = 12;
let is i32 as CLOSE      with imut = 13;
let is i32 as OTHER      with imut = 14;
// The desktop's settings changed — dark mode, the accent, fonts, timings;
// read them again (settings.cst).
let is i32 as SETTINGS   with imut = 15;
// The window manager changed the window's state: maximized, full screen, a
// side against the screen's or another window's (state, STATE_* bits).
let is i32 as STATE      with imut = 16;
// Something dragged over the window from another program: it came in, with
// what it offers in drop (DROP_FILES, DROP_TEXT); it moved, to x, y; it left,
// or was let go where it was not taken; it was dropped at x, y and what drop
// says arrived (device.dropped_files, device.dropped_text).
let is i32 as DND_ENTER  with imut = 17;
let is i32 as DND_MOVE   with imut = 18;
let is i32 as DND_LEAVE  with imut = 19;
let is i32 as DND_DROP   with imut = 20;

// A window's state: bits.
let is i32 as STATE_MAXIMIZED    with imut = 1;
let is i32 as STATE_FULLSCREEN   with imut = 2;
let is i32 as STATE_TILED_TOP    with imut = 16;
let is i32 as STATE_TILED_RIGHT  with imut = 32;
let is i32 as STATE_TILED_BOTTOM with imut = 64;
let is i32 as STATE_TILED_LEFT   with imut = 128;

// What a drag offers, what a program takes, what arrived: bits.
let is i32 as DROP_FILES with imut = 1;
let is i32 as DROP_TEXT  with imut = 2;

struct Event {
    kind      as i32;
    key       as i32;   // KEY_DOWN/UP: portable key ID from keys.cst
    keycode   as i32;   // physical keycode
    modifiers as i32;   // modifier flags
    button    as i32;   // MOUSE_DOWN/UP: 1 left, 2 middle, 3 right
    wheel     as i32;   // WHEEL: +1 up, -1 down
    x         as i64;   // pointer, window coordinates
    y         as i64;
    width     as i64;   // RESIZE width
    height    as i64;   // RESIZE height
    raw_kind  as i32;   // platform raw event type
    drop      as i32;   // DND_ENTER: what is offered; DND_DROP: what arrived
    state     as i32;   // STATE: STATE_* bits
    text      as *u8;   // KEY_DOWN: what the key typed, UTF-8, until the next event is read
    text_len  as i64;   //   0 for a key that types nothing
}

fn clear(e as *Event) as void {
    e.kind = NONE;
    e.key = 0;
    e.keycode = 0;
    e.modifiers = 0;
    e.button = 0;
    e.wheel = 0;
    e.x = 0;
    e.y = 0;
    e.width = 0;
    e.height = 0;
    e.raw_kind = 0;
    e.drop = 0;
    e.state = 0;
    e.text = "";
    e.text_len = 0;
}
