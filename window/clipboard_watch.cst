// window/clipboard_watch.cst — the clipboard and the primary selection
// followed: each change hands a window a CLIPBOARD_CHANGED event (event.cst),
// which selection and the formats it now offers.
//
// X11 through XFixes (x11/clipwatch.cst, which links libXfixes — kept out of
// device.cst so that a program that never asks need not have it), the
// formats asked of the selection's new owner; Wayland as the compositor names
// each new selection, always told; Windows through its clipboard format
// listener. Once a connection on X11, once a window on Windows.
use "std/os.cst" as os;
use "device.cst" as device;
use "x11/clipwatch.cst" as clipwatch;
use "win32/backend.cst" as win32;

// 1 when w's clipboard is followed from now on.
fn follow(w as *device.Window) as i32 {
    if (w.ok == 0) { return 0; }
    if (os.current() == os.OS_LINUX && w.backend == device.X11) { return clipwatch.follow(&w.x11_win); }
    if (os.current() == os.OS_LINUX && w.backend == device.WAYLAND) { return 1; }
    if (os.current() == os.OS_WINDOWS && w.backend == device.WIN32) { return win32.follow_clipboard(&w.win32_win); }
    return 0;
}
