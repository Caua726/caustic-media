// math/vec.cst — 2, 3 and 4 component vectors.
//
// Values, not handles: every operation takes and returns a whole vector, so
// nothing here allocates and nothing aliases. Caustic has no operator
// overloading, so `a + b` is v3_add(a, b) and a chain reads inside out —
// v3_add(v3_scale(d, t), p) rather than p + d*t.
//
// Depends only on std/math. No OS, no allocator, no external library.
use "std/math.cst" as fm;

struct Vec2 { x as f64; y as f64; }
struct Vec3 { x as f64; y as f64; z as f64; }
struct Vec4 { x as f64; y as f64; z as f64; w as f64; }

// --- Constructors ---

fn v2(x as f64, y as f64) as Vec2 {
    let is Vec2 as r; r.x = x; r.y = y; return r;
}

fn v3(x as f64, y as f64, z as f64) as Vec3 {
    let is Vec3 as r; r.x = x; r.y = y; r.z = z; return r;
}

fn v4(x as f64, y as f64, z as f64, w as f64) as Vec4 {
    let is Vec4 as r; r.x = x; r.y = y; r.z = z; r.w = w; return r;
}

fn v3_zero() as Vec3 { return v3(0.0, 0.0, 0.0); }
fn v3_one() as Vec3  { return v3(1.0, 1.0, 1.0); }

// Unit axes, in the right-handed convention this library uses throughout:
// +X right, +Y up, +Z toward the viewer, so the camera looks down -Z.
fn v3_right() as Vec3   { return v3(1.0, 0.0, 0.0); }
fn v3_up() as Vec3      { return v3(0.0, 1.0, 0.0); }
fn v3_forward() as Vec3 { return v3(0.0, 0.0, 0.0 - 1.0); }

// A point carries w = 1 so a translation applies to it; a direction carries
// w = 0 so translation leaves it alone. See mat.cst's transform helpers.
fn v4_point(p as Vec3) as Vec4  { return v4(p.x, p.y, p.z, 1.0); }
fn v4_dir(d as Vec3) as Vec4    { return v4(d.x, d.y, d.z, 0.0); }
fn v4_xyz(a as Vec4) as Vec3    { return v3(a.x, a.y, a.z); }

// Perspective divide: clip space to normalized device coordinates.
fn v4_dehomog(a as Vec4) as Vec3 {
    if (a.w == 0.0) { return v3(a.x, a.y, a.z); }
    let is f64 as inv = 1.0 / a.w;
    return v3(a.x * inv, a.y * inv, a.z * inv);
}

// --- Vec2 ---

fn v2_add(a as Vec2, b as Vec2) as Vec2   { return v2(a.x + b.x, a.y + b.y); }
fn v2_sub(a as Vec2, b as Vec2) as Vec2   { return v2(a.x - b.x, a.y - b.y); }
fn v2_mul(a as Vec2, b as Vec2) as Vec2   { return v2(a.x * b.x, a.y * b.y); }
fn v2_scale(a as Vec2, s as f64) as Vec2  { return v2(a.x * s, a.y * s); }
fn v2_neg(a as Vec2) as Vec2              { return v2(0.0 - a.x, 0.0 - a.y); }
fn v2_dot(a as Vec2, b as Vec2) as f64    { return a.x * b.x + a.y * b.y; }
fn v2_len_sq(a as Vec2) as f64            { return v2_dot(a, a); }
fn v2_len(a as Vec2) as f64               { return fm.sqrt(v2_dot(a, a)); }

// The 2D analogue of the cross product: the z of the 3D cross, i.e. the
// signed area of the parallelogram. Sign tells you which side b is on, which
// is what an edge function in a rasterizer needs.
fn v2_cross(a as Vec2, b as Vec2) as f64  { return a.x * b.y - a.y * b.x; }

fn v2_normalize(a as Vec2) as Vec2 {
    let is f64 as l = v2_len(a);
    if (l == 0.0) { return v2(0.0, 0.0); }
    return v2_scale(a, 1.0 / l);
}

fn v2_lerp(a as Vec2, b as Vec2, t as f64) as Vec2 {
    return v2(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t);
}

fn v2_dist(a as Vec2, b as Vec2) as f64 { return v2_len(v2_sub(a, b)); }

// --- Vec3 ---

fn v3_add(a as Vec3, b as Vec3) as Vec3   { return v3(a.x + b.x, a.y + b.y, a.z + b.z); }
fn v3_sub(a as Vec3, b as Vec3) as Vec3   { return v3(a.x - b.x, a.y - b.y, a.z - b.z); }
fn v3_mul(a as Vec3, b as Vec3) as Vec3   { return v3(a.x * b.x, a.y * b.y, a.z * b.z); }
fn v3_scale(a as Vec3, s as f64) as Vec3  { return v3(a.x * s, a.y * s, a.z * s); }
fn v3_neg(a as Vec3) as Vec3              { return v3(0.0 - a.x, 0.0 - a.y, 0.0 - a.z); }
fn v3_dot(a as Vec3, b as Vec3) as f64    { return a.x * b.x + a.y * b.y + a.z * b.z; }
fn v3_len_sq(a as Vec3) as f64            { return v3_dot(a, a); }
fn v3_len(a as Vec3) as f64               { return fm.sqrt(v3_dot(a, a)); }

fn v3_cross(a as Vec3, b as Vec3) as Vec3 {
    return v3(a.y * b.z - a.z * b.y,
              a.z * b.x - a.x * b.z,
              a.x * b.y - a.y * b.x);
}

// A zero vector has no direction to return, so it stays zero rather than
// producing infinities. Callers that care should test v3_len_sq first.
fn v3_normalize(a as Vec3) as Vec3 {
    let is f64 as l = v3_len(a);
    if (l == 0.0) { return v3_zero(); }
    return v3_scale(a, 1.0 / l);
}

fn v3_lerp(a as Vec3, b as Vec3, t as f64) as Vec3 {
    return v3(a.x + (b.x - a.x) * t,
              a.y + (b.y - a.y) * t,
              a.z + (b.z - a.z) * t);
}

fn v3_dist(a as Vec3, b as Vec3) as f64 { return v3_len(v3_sub(a, b)); }

fn v3_min(a as Vec3, b as Vec3) as Vec3 {
    return v3(fm.min_f64(a.x, b.x), fm.min_f64(a.y, b.y), fm.min_f64(a.z, b.z));
}

fn v3_max(a as Vec3, b as Vec3) as Vec3 {
    return v3(fm.max_f64(a.x, b.x), fm.max_f64(a.y, b.y), fm.max_f64(a.z, b.z));
}

// Mirror of v about the plane with unit normal n: v - 2(v·n)n.
fn v3_reflect(v as Vec3, n as Vec3) as Vec3 {
    return v3_sub(v, v3_scale(n, 2.0 * v3_dot(v, n)));
}

// Component of a along b, dropping the perpendicular part.
fn v3_project(a as Vec3, b as Vec3) as Vec3 {
    let is f64 as d = v3_dot(b, b);
    if (d == 0.0) { return v3_zero(); }
    return v3_scale(b, v3_dot(a, b) / d);
}

// Angle between two vectors, in radians, clamped so rounding in the dot
// product cannot push the cosine outside acos's domain.
fn v3_angle(a as Vec3, b as Vec3) as f64 {
    let is f64 as d = v3_len(a) * v3_len(b);
    if (d == 0.0) { return 0.0; }
    return fm.acos(fm.clamp_f64(v3_dot(a, b) / d, 0.0 - 1.0, 1.0));
}

// --- Vec4 ---

fn v4_add(a as Vec4, b as Vec4) as Vec4   { return v4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w); }
fn v4_sub(a as Vec4, b as Vec4) as Vec4   { return v4(a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w); }
fn v4_scale(a as Vec4, s as f64) as Vec4  { return v4(a.x * s, a.y * s, a.z * s, a.w * s); }
fn v4_dot(a as Vec4, b as Vec4) as f64    { return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w; }
fn v4_len(a as Vec4) as f64               { return fm.sqrt(v4_dot(a, a)); }

fn v4_lerp(a as Vec4, b as Vec4, t as f64) as Vec4 {
    return v4(a.x + (b.x - a.x) * t,
              a.y + (b.y - a.y) * t,
              a.z + (b.z - a.z) * t,
              a.w + (b.w - a.w) * t);
}

// --- Comparison ---
//
// Exact equality is rarely what you want after arithmetic; these compare
// within a tolerance the caller picks.

fn v3_approx(a as Vec3, b as Vec3, eps as f64) as i32 {
    if (fm.abs_f64(a.x - b.x) > eps) { return 0; }
    if (fm.abs_f64(a.y - b.y) > eps) { return 0; }
    if (fm.abs_f64(a.z - b.z) > eps) { return 0; }
    return 1;
}

fn v2_approx(a as Vec2, b as Vec2, eps as f64) as i32 {
    if (fm.abs_f64(a.x - b.x) > eps) { return 0; }
    if (fm.abs_f64(a.y - b.y) > eps) { return 0; }
    return 1;
}

fn v4_approx(a as Vec4, b as Vec4, eps as f64) as i32 {
    if (fm.abs_f64(a.x - b.x) > eps) { return 0; }
    if (fm.abs_f64(a.y - b.y) > eps) { return 0; }
    if (fm.abs_f64(a.z - b.z) > eps) { return 0; }
    if (fm.abs_f64(a.w - b.w) > eps) { return 0; }
    return 1;
}
