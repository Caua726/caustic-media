// math/rect.cst — axis-aligned 2D rectangles.
//
// Stored as position plus size rather than two corners: a UI lays out with
// origins and extents, and a negative size is then an obvious error rather
// than a silently inverted rectangle. Everything here treats the rect as
// half-open, [x, x+w) by [y, y+h), so tiling with adjacent rects covers each
// pixel exactly once.
use "std/math.cst" as fm;
use "vec.cst" as v;

struct Rect { x as f64; y as f64; w as f64; h as f64; }

fn rect(x as f64, y as f64, w as f64, h as f64) as Rect {
    let is Rect as r; r.x = x; r.y = y; r.w = w; r.h = h; return r;
}

fn rect_zero() as Rect { return rect(0.0, 0.0, 0.0, 0.0); }

fn rect_from_min_max(min as v.Vec2, max as v.Vec2) as Rect {
    return rect(min.x, min.y, max.x - min.x, max.y - min.y);
}

fn rect_from_center(center as v.Vec2, size as v.Vec2) as Rect {
    return rect(center.x - size.x * 0.5, center.y - size.y * 0.5, size.x, size.y);
}

// --- Queries ---

fn rect_min(r as Rect) as v.Vec2    { return v.v2(r.x, r.y); }
fn rect_max(r as Rect) as v.Vec2    { return v.v2(r.x + r.w, r.y + r.h); }
fn rect_size(r as Rect) as v.Vec2   { return v.v2(r.w, r.h); }
fn rect_center(r as Rect) as v.Vec2 { return v.v2(r.x + r.w * 0.5, r.y + r.h * 0.5); }
fn rect_area(r as Rect) as f64      { return r.w * r.h; }
fn rect_left(r as Rect) as f64      { return r.x; }
fn rect_right(r as Rect) as f64     { return r.x + r.w; }
fn rect_top(r as Rect) as f64       { return r.y; }
fn rect_bottom(r as Rect) as f64    { return r.y + r.h; }

fn rect_is_empty(r as Rect) as i32 {
    if (r.w <= 0.0 || r.h <= 0.0) { return 1; }
    return 0;
}

// Half-open on both axes: a point on the right or bottom edge belongs to the
// next rect over, not this one.
fn rect_contains(r as Rect, p as v.Vec2) as i32 {
    if (p.x < r.x || p.x >= r.x + r.w) { return 0; }
    if (p.y < r.y || p.y >= r.y + r.h) { return 0; }
    return 1;
}

fn rect_contains_rect(outer as Rect, inner as Rect) as i32 {
    if (inner.x < outer.x || inner.y < outer.y) { return 0; }
    if (inner.x + inner.w > outer.x + outer.w) { return 0; }
    if (inner.y + inner.h > outer.y + outer.h) { return 0; }
    return 1;
}

// Touching edges do not overlap, matching the half-open convention.
fn rect_overlaps(a as Rect, b as Rect) as i32 {
    if (a.x + a.w <= b.x || b.x + b.w <= a.x) { return 0; }
    if (a.y + a.h <= b.y || b.y + b.h <= a.y) { return 0; }
    return 1;
}

// --- Combination ---

// The overlapping part, or an empty rect at the origin when they miss. A
// scissor stack is exactly a fold of this.
fn rect_intersect(a as Rect, b as Rect) as Rect {
    let is f64 as x0 = fm.max_f64(a.x, b.x);
    let is f64 as y0 = fm.max_f64(a.y, b.y);
    let is f64 as x1 = fm.min_f64(a.x + a.w, b.x + b.w);
    let is f64 as y1 = fm.min_f64(a.y + a.h, b.y + b.h);
    if (x1 <= x0 || y1 <= y0) { return rect_zero(); }
    return rect(x0, y0, x1 - x0, y1 - y0);
}

// The smallest rect containing both. An empty input contributes nothing, so
// folding this over a list starting from rect_zero still needs the caller to
// seed with the first element.
fn rect_union(a as Rect, b as Rect) as Rect {
    if (rect_is_empty(a) == 1) { return b; }
    if (rect_is_empty(b) == 1) { return a; }
    let is f64 as x0 = fm.min_f64(a.x, b.x);
    let is f64 as y0 = fm.min_f64(a.y, b.y);
    let is f64 as x1 = fm.max_f64(a.x + a.w, b.x + b.w);
    let is f64 as y1 = fm.max_f64(a.y + a.h, b.y + b.h);
    return rect(x0, y0, x1 - x0, y1 - y0);
}

fn rect_encompass(r as Rect, p as v.Vec2) as Rect {
    return rect_union(r, rect(p.x, p.y, 0.0, 0.0));
}

// --- Adjustment ---

fn rect_translate(r as Rect, t as v.Vec2) as Rect {
    return rect(r.x + t.x, r.y + t.y, r.w, r.h);
}

// Grows on every side by `by` (shrinks when negative), clamping the result to
// a non-negative size so an over-shrunk rect collapses instead of inverting.
fn rect_expand(r as Rect, by as f64) as Rect {
    let is f64 as w = fm.max_f64(0.0, r.w + by * 2.0);
    let is f64 as h = fm.max_f64(0.0, r.h + by * 2.0);
    return rect(r.x - by, r.y - by, w, h);
}

fn rect_shrink(r as Rect, by as f64) as Rect { return rect_expand(r, 0.0 - by); }

fn rect_clamp_point(r as Rect, p as v.Vec2) as v.Vec2 {
    return v.v2(fm.clamp_f64(p.x, r.x, r.x + r.w),
                fm.clamp_f64(p.y, r.y, r.y + r.h));
}

// Position within the rect as 0..1 on each axis — a UV, or a slider's value.
fn rect_normalize_point(r as Rect, p as v.Vec2) as v.Vec2 {
    let is f64 as u with mut = 0.0;
    let is f64 as vv with mut = 0.0;
    if (r.w != 0.0) { u = (p.x - r.x) / r.w; }
    if (r.h != 0.0) { vv = (p.y - r.y) / r.h; }
    return v.v2(u, vv);
}

fn rect_lerp_point(r as Rect, uv as v.Vec2) as v.Vec2 {
    return v.v2(r.x + r.w * uv.x, r.y + r.h * uv.y);
}

// --- Splitting, for layout ---

// Takes `amount` off the left and returns the remainder; the caller reads the
// taken part with rect(r.x, r.y, amount, r.h). Repeated calls lay a row out
// left to right without arithmetic at each site.
fn rect_cut_left(r as Rect, amount as f64) as Rect {
    let is f64 as a = fm.clamp_f64(amount, 0.0, r.w);
    return rect(r.x + a, r.y, r.w - a, r.h);
}

fn rect_take_left(r as Rect, amount as f64) as Rect {
    return rect(r.x, r.y, fm.clamp_f64(amount, 0.0, r.w), r.h);
}

fn rect_cut_top(r as Rect, amount as f64) as Rect {
    let is f64 as a = fm.clamp_f64(amount, 0.0, r.h);
    return rect(r.x, r.y + a, r.w, r.h - a);
}

fn rect_take_top(r as Rect, amount as f64) as Rect {
    return rect(r.x, r.y, r.w, fm.clamp_f64(amount, 0.0, r.h));
}

fn rect_approx(a as Rect, b as Rect, eps as f64) as i32 {
    if (fm.abs_f64(a.x - b.x) > eps) { return 0; }
    if (fm.abs_f64(a.y - b.y) > eps) { return 0; }
    if (fm.abs_f64(a.w - b.w) > eps) { return 0; }
    if (fm.abs_f64(a.h - b.h) > eps) { return 0; }
    return 1;
}
