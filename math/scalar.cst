// math/scalar.cst — scalar helpers a renderer keeps reaching for.
//
// std/math has the general ones (abs, min, max, clamp, lerp, the
// transcendentals). These are the graphics-flavoured rest: remapping ranges,
// angle arithmetic that respects wrap-around, and comparisons that survive
// having been through a matrix.
use "std/math.cst" as fm;

// --- Conversions ---

fn radians(deg as f64) as f64 { return deg * fm.DEG2RAD; }
fn degrees(rad as f64) as f64 { return rad * fm.RAD2DEG; }

// --- Ranges ---

// Clamp to [0, 1] — the shader idiom, and the right thing before feeding a
// value to a colour channel or a texture coordinate.
fn saturate(x as f64) as f64 { return fm.clamp_f64(x, 0.0, 1.0); }

// Where x sits between a and b, as 0..1. The inverse of lerp; returns 0 for a
// degenerate range rather than dividing by zero.
fn inv_lerp(a as f64, b as f64, x as f64) as f64 {
    if (a == b) { return 0.0; }
    return (x - a) / (b - a);
}

// Move x from one range to another.
fn remap(x as f64, in_lo as f64, in_hi as f64, out_lo as f64, out_hi as f64) as f64 {
    return out_lo + (out_hi - out_lo) * inv_lerp(in_lo, in_hi, x);
}

// 0 below edge0, 1 above edge1, and a smooth Hermite ramp between — the
// cubic 3t^2-2t^3, whose derivative is zero at both ends, so a value ramped
// this way has no visible crease where it starts and stops moving.
fn smoothstep(edge0 as f64, edge1 as f64, x as f64) as f64 {
    let is f64 as t = saturate(inv_lerp(edge0, edge1, x));
    return t * t * (3.0 - 2.0 * t);
}

// The quintic variant, whose second derivative also vanishes at the ends.
// Worth the extra multiplies where the ramp drives something that would show
// a discontinuity in curvature — a normal, a displacement.
fn smootherstep(edge0 as f64, edge1 as f64, x as f64) as f64 {
    let is f64 as t = saturate(inv_lerp(edge0, edge1, x));
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

// 0 below edge, 1 at or above it.
fn step(edge as f64, x as f64) as f64 {
    if (x < edge) { return 0.0; }
    return 1.0;
}

// x wrapped into [lo, hi). Uses fmod rather than a subtraction loop, so it
// costs the same whether x is just outside the range or far outside it.
fn wrap(x as f64, lo as f64, hi as f64) as f64 {
    let is f64 as span = hi - lo;
    if (span == 0.0) { return lo; }
    let is f64 as r with mut = fm.fmod(x - lo, span);
    if (r < 0.0) { r = r + span; }
    return lo + r;
}

// Reflects at the boundaries instead of jumping, so a value driven past hi
// comes back down rather than snapping to lo.
fn ping_pong(x as f64, len as f64) as f64 {
    if (len == 0.0) { return 0.0; }
    let is f64 as t = wrap(x, 0.0, len * 2.0);
    if (t > len) { return len * 2.0 - t; }
    return t;
}

// --- Angles ---

// An angle folded into (-pi, pi].
fn wrap_angle(rad as f64) as f64 {
    return wrap(rad, 0.0 - fm.PI, fm.PI);
}

// Signed shortest way from a to b, which is what you want before scaling a
// turn: going from 350 to 10 degrees is +20, not -340.
fn angle_delta(a as f64, b as f64) as f64 {
    return wrap_angle(b - a);
}

// Interpolates the short way round, so a heading crossing the wrap point
// keeps turning instead of spinning back the long way. The result is wrapped
// into (-pi, pi] so it is canonical: halfway from 350 to 10 degrees comes
// back as 0, not as 360.
fn lerp_angle(a as f64, b as f64, t as f64) as f64 {
    return wrap_angle(a + angle_delta(a, b) * t);
}

// --- Comparison ---

// Absolute and relative tolerance together: the absolute term keeps the test
// meaningful near zero, where a relative one collapses, and the relative term
// keeps it meaningful for large values, where an absolute one is far below
// the spacing between representable numbers.
fn approx(a as f64, b as f64, eps as f64) as i32 {
    let is f64 as d = fm.abs_f64(a - b);
    if (d <= eps) { return 1; }
    let is f64 as scale = fm.max_f64(fm.abs_f64(a), fm.abs_f64(b));
    if (d <= eps * scale) { return 1; }
    return 0;
}

fn approx_zero(a as f64, eps as f64) as i32 {
    if (fm.abs_f64(a) <= eps) { return 1; }
    return 0;
}

// --- Powers of two ---

fn is_pow2_i64(n as i64) as i32 {
    if (n <= 0) { return 0; }
    if ((n & (n - 1)) == 0) { return 1; }
    return 0;
}

fn next_pow2_i64(n as i64) as i64 {
    if (n <= 1) { return 1; }
    let is i64 as r with mut = 1;
    while (r < n) { r = r * 2; }
    return r;
}
