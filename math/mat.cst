// math/mat.cst — 4x4 matrices for 3D transforms.
//
// Storage is COLUMN-MAJOR, the layout OpenGL and Vulkan expect, so a matrix
// can go to the GPU without transposing. Element (row r, column c) lives at
// m[c*4 + r]:
//
//     m[0] m[4] m[8]  m[12]
//     m[1] m[5] m[9]  m[13]
//     m[2] m[6] m[10] m[14]
//     m[3] m[7] m[11] m[15]
//
// The translation therefore sits in m[12..14], the last column.
//
// Vectors are columns and transforms compose right to left: m4_mul(a, b)
// applies b first. A model-view-projection is m4_mul(proj, m4_mul(view, model)).
//
// Conventions: right-handed world, camera looking down -Z, and a projection
// producing the OpenGL clip range z in [-1, 1]. m4_perspective_zo gives the
// [0, 1] range Vulkan and D3D want instead.
use "std/math.cst" as fm;
use "vec.cst" as v;

struct Mat4 { m as [16]f64; }

// --- Construction ---

fn m4_zero() as Mat4 {
    let is Mat4 as r;
    let is i32 as i with mut = 0;
    while (i < 16) { r.m[i] = 0.0; i = i + 1; }
    return r;
}

fn m4_identity() as Mat4 {
    let is Mat4 as r = m4_zero();
    r.m[0] = 1.0; r.m[5] = 1.0; r.m[10] = 1.0; r.m[15] = 1.0;
    return r;
}

fn m4_get(a as *Mat4, row as i32, col as i32) as f64 {
    return a.m[col * 4 + row];
}

fn m4_set(a as *Mat4, row as i32, col as i32, val as f64) as void {
    a.m[col * 4 + row] = val;
}

// --- Arithmetic ---

// Applies b first, then a.
fn m4_mul(a as Mat4, b as Mat4) as Mat4 {
    let is Mat4 as r = m4_zero();
    let is i32 as c with mut = 0;
    while (c < 4) {
        let is i32 as row with mut = 0;
        while (row < 4) {
            let is f64 as s with mut = 0.0;
            let is i32 as k with mut = 0;
            while (k < 4) {
                s = s + a.m[k * 4 + row] * b.m[c * 4 + k];
                k = k + 1;
            }
            r.m[c * 4 + row] = s;
            row = row + 1;
        }
        c = c + 1;
    }
    return r;
}

fn m4_transpose(a as Mat4) as Mat4 {
    let is Mat4 as r = m4_zero();
    let is i32 as c with mut = 0;
    while (c < 4) {
        let is i32 as row with mut = 0;
        while (row < 4) {
            r.m[row * 4 + c] = a.m[c * 4 + row];
            row = row + 1;
        }
        c = c + 1;
    }
    return r;
}

fn m4_scale_all(a as Mat4, s as f64) as Mat4 {
    let is Mat4 as r = a;
    let is i32 as i with mut = 0;
    while (i < 16) { r.m[i] = r.m[i] * s; i = i + 1; }
    return r;
}

// --- Applying a matrix ---

fn m4_mul_v4(a as Mat4, p as v.Vec4) as v.Vec4 {
    return v.v4(a.m[0] * p.x + a.m[4] * p.y + a.m[8]  * p.z + a.m[12] * p.w,
                a.m[1] * p.x + a.m[5] * p.y + a.m[9]  * p.z + a.m[13] * p.w,
                a.m[2] * p.x + a.m[6] * p.y + a.m[10] * p.z + a.m[14] * p.w,
                a.m[3] * p.x + a.m[7] * p.y + a.m[11] * p.z + a.m[15] * p.w);
}

// Transforms a position: w = 1, so translation applies.
fn m4_mul_point(a as Mat4, p as v.Vec3) as v.Vec3 {
    return v.v4_xyz(m4_mul_v4(a, v.v4_point(p)));
}

// Transforms a direction: w = 0, so translation does not.
fn m4_mul_dir(a as Mat4, d as v.Vec3) as v.Vec3 {
    return v.v4_xyz(m4_mul_v4(a, v.v4_dir(d)));
}

// Transforms a position through a projection, dividing by w.
fn m4_project_point(a as Mat4, p as v.Vec3) as v.Vec3 {
    return v.v4_dehomog(m4_mul_v4(a, v.v4_point(p)));
}

// --- Basic transforms ---

fn m4_translation(t as v.Vec3) as Mat4 {
    let is Mat4 as r = m4_identity();
    r.m[12] = t.x; r.m[13] = t.y; r.m[14] = t.z;
    return r;
}

fn m4_scaling(s as v.Vec3) as Mat4 {
    let is Mat4 as r = m4_zero();
    r.m[0] = s.x; r.m[5] = s.y; r.m[10] = s.z; r.m[15] = 1.0;
    return r;
}

fn m4_rotation_x(rad as f64) as Mat4 {
    let is f64 as c = fm.cos(rad);
    let is f64 as s = fm.sin(rad);
    let is Mat4 as r = m4_identity();
    r.m[5] = c;  r.m[9]  = 0.0 - s;
    r.m[6] = s;  r.m[10] = c;
    return r;
}

fn m4_rotation_y(rad as f64) as Mat4 {
    let is f64 as c = fm.cos(rad);
    let is f64 as s = fm.sin(rad);
    let is Mat4 as r = m4_identity();
    r.m[0] = c;        r.m[8]  = s;
    r.m[2] = 0.0 - s;  r.m[10] = c;
    return r;
}

fn m4_rotation_z(rad as f64) as Mat4 {
    let is f64 as c = fm.cos(rad);
    let is f64 as s = fm.sin(rad);
    let is Mat4 as r = m4_identity();
    r.m[0] = c;  r.m[4] = 0.0 - s;
    r.m[1] = s;  r.m[5] = c;
    return r;
}

// Rotation about an arbitrary unit axis (Rodrigues). The axis is normalized
// here so callers need not.
fn m4_rotation_axis(axis as v.Vec3, rad as f64) as Mat4 {
    let is v.Vec3 as a = v.v3_normalize(axis);
    let is f64 as c = fm.cos(rad);
    let is f64 as s = fm.sin(rad);
    let is f64 as t = 1.0 - c;
    let is Mat4 as r = m4_identity();
    r.m[0]  = t * a.x * a.x + c;
    r.m[1]  = t * a.x * a.y + s * a.z;
    r.m[2]  = t * a.x * a.z - s * a.y;
    r.m[4]  = t * a.x * a.y - s * a.z;
    r.m[5]  = t * a.y * a.y + c;
    r.m[6]  = t * a.y * a.z + s * a.x;
    r.m[8]  = t * a.x * a.z + s * a.y;
    r.m[9]  = t * a.y * a.z - s * a.x;
    r.m[10] = t * a.z * a.z + c;
    return r;
}

// --- Camera and projection ---

// Right-handed view matrix: the camera sits at eye and looks at target, with
// up giving the roll. Equivalent to the inverse of the camera's own transform,
// built directly from the orthonormal basis to avoid a general inverse.
fn m4_look_at(eye as v.Vec3, target as v.Vec3, up as v.Vec3) as Mat4 {
    let is v.Vec3 as f = v.v3_normalize(v.v3_sub(target, eye));   // forward, toward target
    let is v.Vec3 as s = v.v3_normalize(v.v3_cross(f, up));       // right
    let is v.Vec3 as u = v.v3_cross(s, f);                        // true up

    let is Mat4 as r = m4_identity();
    r.m[0] = s.x;  r.m[4] = s.y;  r.m[8]  = s.z;
    r.m[1] = u.x;  r.m[5] = u.y;  r.m[9]  = u.z;
    r.m[2] = 0.0 - f.x; r.m[6] = 0.0 - f.y; r.m[10] = 0.0 - f.z;
    r.m[12] = 0.0 - v.v3_dot(s, eye);
    r.m[13] = 0.0 - v.v3_dot(u, eye);
    r.m[14] = v.v3_dot(f, eye);
    return r;
}

// Perspective projection, vertical field of view in radians, clip z in
// [-1, 1] (the OpenGL convention).
fn m4_perspective(fovy as f64, aspect as f64, near as f64, far as f64) as Mat4 {
    let is f64 as t = fm.tan(fovy * 0.5);
    let is Mat4 as r = m4_zero();
    if (t == 0.0 || aspect == 0.0 || near == far) { return m4_identity(); }
    r.m[0]  = 1.0 / (aspect * t);
    r.m[5]  = 1.0 / t;
    r.m[10] = (far + near) / (near - far);
    r.m[11] = 0.0 - 1.0;
    r.m[14] = (2.0 * far * near) / (near - far);
    return r;
}

// Same, but clip z in [0, 1] — what Vulkan and D3D expect.
fn m4_perspective_zo(fovy as f64, aspect as f64, near as f64, far as f64) as Mat4 {
    let is f64 as t = fm.tan(fovy * 0.5);
    let is Mat4 as r = m4_zero();
    if (t == 0.0 || aspect == 0.0 || near == far) { return m4_identity(); }
    r.m[0]  = 1.0 / (aspect * t);
    r.m[5]  = 1.0 / t;
    r.m[10] = far / (near - far);
    r.m[11] = 0.0 - 1.0;
    r.m[14] = (far * near) / (near - far);
    return r;
}

// Orthographic projection, clip z in [-1, 1].
fn m4_ortho(left as f64, right as f64, bottom as f64, top as f64,
            near as f64, far as f64) as Mat4 {
    let is Mat4 as r = m4_identity();
    if (right == left || top == bottom || far == near) { return r; }
    r.m[0]  = 2.0 / (right - left);
    r.m[5]  = 2.0 / (top - bottom);
    r.m[10] = 0.0 - 2.0 / (far - near);
    r.m[12] = 0.0 - (right + left) / (right - left);
    r.m[13] = 0.0 - (top + bottom) / (top - bottom);
    r.m[14] = 0.0 - (far + near) / (far - near);
    return r;
}

// --- Inverse ---

fn m4_determinant(a as Mat4) as f64 {
    let is f64 as s0 = a.m[0] * a.m[5]  - a.m[1] * a.m[4];
    let is f64 as s1 = a.m[0] * a.m[9]  - a.m[1] * a.m[8];
    let is f64 as s2 = a.m[0] * a.m[13] - a.m[1] * a.m[12];
    let is f64 as s3 = a.m[4] * a.m[9]  - a.m[5] * a.m[8];
    let is f64 as s4 = a.m[4] * a.m[13] - a.m[5] * a.m[12];
    let is f64 as s5 = a.m[8] * a.m[13] - a.m[9] * a.m[12];

    let is f64 as c5 = a.m[10] * a.m[15] - a.m[11] * a.m[14];
    let is f64 as c4 = a.m[6]  * a.m[15] - a.m[7]  * a.m[14];
    let is f64 as c3 = a.m[6]  * a.m[11] - a.m[7]  * a.m[10];
    let is f64 as c2 = a.m[2]  * a.m[15] - a.m[3]  * a.m[14];
    let is f64 as c1 = a.m[2]  * a.m[11] - a.m[3]  * a.m[10];
    let is f64 as c0 = a.m[2]  * a.m[7]  - a.m[3]  * a.m[6];

    return s0 * c5 - s1 * c4 + s2 * c3 + s3 * c2 - s4 * c1 + s5 * c0;
}

// General inverse by cofactor expansion, reusing the 2x2 minors the
// determinant already needs. Returns the identity for a singular matrix
// rather than dividing by zero — check m4_determinant first if that matters.
fn m4_inverse(a as Mat4) as Mat4 {
    let is f64 as s0 = a.m[0] * a.m[5]  - a.m[1] * a.m[4];
    let is f64 as s1 = a.m[0] * a.m[9]  - a.m[1] * a.m[8];
    let is f64 as s2 = a.m[0] * a.m[13] - a.m[1] * a.m[12];
    let is f64 as s3 = a.m[4] * a.m[9]  - a.m[5] * a.m[8];
    let is f64 as s4 = a.m[4] * a.m[13] - a.m[5] * a.m[12];
    let is f64 as s5 = a.m[8] * a.m[13] - a.m[9] * a.m[12];

    let is f64 as c5 = a.m[10] * a.m[15] - a.m[11] * a.m[14];
    let is f64 as c4 = a.m[6]  * a.m[15] - a.m[7]  * a.m[14];
    let is f64 as c3 = a.m[6]  * a.m[11] - a.m[7]  * a.m[10];
    let is f64 as c2 = a.m[2]  * a.m[15] - a.m[3]  * a.m[14];
    let is f64 as c1 = a.m[2]  * a.m[11] - a.m[3]  * a.m[10];
    let is f64 as c0 = a.m[2]  * a.m[7]  - a.m[3]  * a.m[6];

    let is f64 as det = s0 * c5 - s1 * c4 + s2 * c3 + s3 * c2 - s4 * c1 + s5 * c0;
    if (det == 0.0) { return m4_identity(); }
    let is f64 as id = 1.0 / det;

    let is Mat4 as r = m4_zero();
    r.m[0]  = ( a.m[5]  * c5 - a.m[9]  * c4 + a.m[13] * c3) * id;
    r.m[1]  = (0.0 - a.m[1]  * c5 + a.m[9]  * c2 - a.m[13] * c1) * id;
    r.m[2]  = ( a.m[1]  * c4 - a.m[5]  * c2 + a.m[13] * c0) * id;
    r.m[3]  = (0.0 - a.m[1]  * c3 + a.m[5]  * c1 - a.m[9]  * c0) * id;

    r.m[4]  = (0.0 - a.m[4]  * c5 + a.m[8]  * c4 - a.m[12] * c3) * id;
    r.m[5]  = ( a.m[0]  * c5 - a.m[8]  * c2 + a.m[12] * c1) * id;
    r.m[6]  = (0.0 - a.m[0]  * c4 + a.m[4]  * c2 - a.m[12] * c0) * id;
    r.m[7]  = ( a.m[0]  * c3 - a.m[4]  * c1 + a.m[8]  * c0) * id;

    r.m[8]  = ( a.m[7]  * s5 - a.m[11] * s4 + a.m[15] * s3) * id;
    r.m[9]  = (0.0 - a.m[3]  * s5 + a.m[11] * s2 - a.m[15] * s1) * id;
    r.m[10] = ( a.m[3]  * s4 - a.m[7]  * s2 + a.m[15] * s0) * id;
    r.m[11] = (0.0 - a.m[3]  * s3 + a.m[7]  * s1 - a.m[11] * s0) * id;

    r.m[12] = (0.0 - a.m[6]  * s5 + a.m[10] * s4 - a.m[14] * s3) * id;
    r.m[13] = ( a.m[2]  * s5 - a.m[10] * s2 + a.m[14] * s1) * id;
    r.m[14] = (0.0 - a.m[2]  * s4 + a.m[6]  * s2 - a.m[14] * s0) * id;
    r.m[15] = ( a.m[2]  * s3 - a.m[6]  * s1 + a.m[10] * s0) * id;
    return r;
}

fn m4_approx(a as Mat4, b as Mat4, eps as f64) as i32 {
    let is i32 as i with mut = 0;
    while (i < 16) {
        if (fm.abs_f64(a.m[i] - b.m[i]) > eps) { return 0; }
        i = i + 1;
    }
    return 1;
}

// =======================================================
// Mat3
//
// Same column-major convention: element (row r, column c) is m[c*3 + r].
//
// Two jobs. As a 2D transform it is what Mat4 is in 3D, translation included,
// which is what the UI and the rasterizer want. In 3D it carries the rotation
// and scale of a Mat4 without the translation — and the inverse transpose of
// that is the matrix a normal has to be transformed by, because a non-uniform
// scale tilts a surface's normal the wrong way if you reuse the model matrix.
// =======================================================

struct Mat3 { m as [9]f64; }

fn m3_zero() as Mat3 {
    let is Mat3 as r;
    let is i32 as i with mut = 0;
    while (i < 9) { r.m[i] = 0.0; i = i + 1; }
    return r;
}

fn m3_identity() as Mat3 {
    let is Mat3 as r = m3_zero();
    r.m[0] = 1.0; r.m[4] = 1.0; r.m[8] = 1.0;
    return r;
}

fn m3_get(a as *Mat3, row as i32, col as i32) as f64 { return a.m[col * 3 + row]; }
fn m3_set(a as *Mat3, row as i32, col as i32, val as f64) as void { a.m[col * 3 + row] = val; }

fn m3_mul(a as Mat3, b as Mat3) as Mat3 {
    let is Mat3 as r = m3_zero();
    let is i32 as c with mut = 0;
    while (c < 3) {
        let is i32 as row with mut = 0;
        while (row < 3) {
            let is f64 as s with mut = 0.0;
            let is i32 as k with mut = 0;
            while (k < 3) {
                s = s + a.m[k * 3 + row] * b.m[c * 3 + k];
                k = k + 1;
            }
            r.m[c * 3 + row] = s;
            row = row + 1;
        }
        c = c + 1;
    }
    return r;
}

fn m3_transpose(a as Mat3) as Mat3 {
    let is Mat3 as r = m3_zero();
    let is i32 as c with mut = 0;
    while (c < 3) {
        let is i32 as row with mut = 0;
        while (row < 3) {
            r.m[row * 3 + c] = a.m[c * 3 + row];
            row = row + 1;
        }
        c = c + 1;
    }
    return r;
}

fn m3_mul_v3(a as Mat3, p as v.Vec3) as v.Vec3 {
    return v.v3(a.m[0] * p.x + a.m[3] * p.y + a.m[6] * p.z,
                a.m[1] * p.x + a.m[4] * p.y + a.m[7] * p.z,
                a.m[2] * p.x + a.m[5] * p.y + a.m[8] * p.z);
}

fn m3_determinant(a as Mat3) as f64 {
    return a.m[0] * (a.m[4] * a.m[8] - a.m[7] * a.m[5])
         - a.m[3] * (a.m[1] * a.m[8] - a.m[7] * a.m[2])
         + a.m[6] * (a.m[1] * a.m[5] - a.m[4] * a.m[2]);
}

// Returns the identity for a singular matrix rather than dividing by zero.
fn m3_inverse(a as Mat3) as Mat3 {
    let is f64 as det = m3_determinant(a);
    if (det == 0.0) { return m3_identity(); }
    let is f64 as id = 1.0 / det;
    let is Mat3 as r = m3_zero();
    r.m[0] = (a.m[4] * a.m[8] - a.m[7] * a.m[5]) * id;
    r.m[1] = (a.m[7] * a.m[2] - a.m[1] * a.m[8]) * id;
    r.m[2] = (a.m[1] * a.m[5] - a.m[4] * a.m[2]) * id;
    r.m[3] = (a.m[6] * a.m[5] - a.m[3] * a.m[8]) * id;
    r.m[4] = (a.m[0] * a.m[8] - a.m[6] * a.m[2]) * id;
    r.m[5] = (a.m[3] * a.m[2] - a.m[0] * a.m[5]) * id;
    r.m[6] = (a.m[3] * a.m[7] - a.m[6] * a.m[4]) * id;
    r.m[7] = (a.m[6] * a.m[1] - a.m[0] * a.m[7]) * id;
    r.m[8] = (a.m[0] * a.m[4] - a.m[3] * a.m[1]) * id;
    return r;
}

// The upper-left 3x3 of a Mat4: rotation and scale, translation dropped.
fn m3_from_m4(a as Mat4) as Mat3 {
    let is Mat3 as r = m3_zero();
    r.m[0] = a.m[0]; r.m[1] = a.m[1]; r.m[2] = a.m[2];
    r.m[3] = a.m[4]; r.m[4] = a.m[5]; r.m[5] = a.m[6];
    r.m[6] = a.m[8]; r.m[7] = a.m[9]; r.m[8] = a.m[10];
    return r;
}

fn m4_from_m3(a as Mat3) as Mat4 {
    let is Mat4 as r = m4_identity();
    r.m[0] = a.m[0]; r.m[1] = a.m[1]; r.m[2]  = a.m[2];
    r.m[4] = a.m[3]; r.m[5] = a.m[4]; r.m[6]  = a.m[5];
    r.m[8] = a.m[6]; r.m[9] = a.m[7]; r.m[10] = a.m[8];
    return r;
}

// The matrix to transform a normal by. Under a non-uniform scale the model
// matrix stretches a normal along with the surface, which leaves it no longer
// perpendicular; the inverse transpose undoes exactly that stretch. For a
// rotation alone it equals the rotation, so it is never wrong to use.
fn m3_normal_matrix(model as Mat4) as Mat3 {
    return m3_transpose(m3_inverse(m3_from_m4(model)));
}

// --- 2D affine transforms, packed into a Mat3 ---

fn m3_translation2(t as v.Vec2) as Mat3 {
    let is Mat3 as r = m3_identity();
    r.m[6] = t.x; r.m[7] = t.y;
    return r;
}

fn m3_scaling2(s as v.Vec2) as Mat3 {
    let is Mat3 as r = m3_zero();
    r.m[0] = s.x; r.m[4] = s.y; r.m[8] = 1.0;
    return r;
}

fn m3_rotation2(rad as f64) as Mat3 {
    let is f64 as c = fm.cos(rad);
    let is f64 as s = fm.sin(rad);
    let is Mat3 as r = m3_identity();
    r.m[0] = c; r.m[3] = 0.0 - s;
    r.m[1] = s; r.m[4] = c;
    return r;
}

// 2D point: z = 1, so the translation column applies.
fn m3_mul_point2(a as Mat3, p as v.Vec2) as v.Vec2 {
    return v.v2(a.m[0] * p.x + a.m[3] * p.y + a.m[6],
                a.m[1] * p.x + a.m[4] * p.y + a.m[7]);
}

// 2D direction: z = 0, so it does not.
fn m3_mul_dir2(a as Mat3, d as v.Vec2) as v.Vec2 {
    return v.v2(a.m[0] * d.x + a.m[3] * d.y,
                a.m[1] * d.x + a.m[4] * d.y);
}

fn m3_approx(a as Mat3, b as Mat3, eps as f64) as i32 {
    let is i32 as i with mut = 0;
    while (i < 9) {
        if (fm.abs_f64(a.m[i] - b.m[i]) > eps) { return 0; }
        i = i + 1;
    }
    return 1;
}
