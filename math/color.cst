// math/color.cst — colour as four floats, plus the conversions that make the
// difference between correct and merely plausible shading.
//
// Components are 0..1 and LINEAR unless a function says otherwise. This is the
// distinction that matters: an image file and a display are sRGB-encoded, where
// 0.5 means "half as bright as the display can show", not "half the light".
// Adding, multiplying or interpolating those encoded values is arithmetic on
// the wrong quantity — it is why naively blended gradients go muddy in the
// middle and why alpha-composited edges darken. Decode to linear on the way
// in, work there, encode on the way out.
use "std/math.cst" as fm;
use "scalar.cst" as s;

struct Color { r as f64; g as f64; b as f64; a as f64; }

fn rgba(r as f64, g as f64, b as f64, a as f64) as Color {
    let is Color as c; c.r = r; c.g = g; c.b = b; c.a = a; return c;
}

fn rgb(r as f64, g as f64, b as f64) as Color { return rgba(r, g, b, 1.0); }

fn gray(v as f64) as Color { return rgba(v, v, v, 1.0); }

// --- Named colours, linear ---

fn black() as Color   { return rgb(0.0, 0.0, 0.0); }
fn white() as Color   { return rgb(1.0, 1.0, 1.0); }
fn red() as Color     { return rgb(1.0, 0.0, 0.0); }
fn green() as Color   { return rgb(0.0, 1.0, 0.0); }
fn blue() as Color    { return rgb(0.0, 0.0, 1.0); }
fn yellow() as Color  { return rgb(1.0, 1.0, 0.0); }
fn cyan() as Color    { return rgb(0.0, 1.0, 1.0); }
fn magenta() as Color { return rgb(1.0, 0.0, 1.0); }
fn transparent() as Color { return rgba(0.0, 0.0, 0.0, 0.0); }

// --- sRGB transfer function ---
//
// The piecewise curve from the sRGB standard, not the 2.2 power law often
// used in its place: they diverge near black, which is exactly where banding
// shows.

fn srgb_to_linear_channel(c as f64) as f64 {
    if (c <= 0.04045) { return c / 12.92; }
    return fm.pow((c + 0.055) / 1.055, 2.4);
}

fn linear_to_srgb_channel(c as f64) as f64 {
    if (c <= 0.0031308) { return c * 12.92; }
    return 1.055 * fm.pow(c, 1.0 / 2.4) - 0.055;
}

// Alpha is a coverage fraction, not a light measurement, so it is never
// gamma-encoded and passes through both directions untouched.
fn srgb_to_linear(c as Color) as Color {
    return rgba(srgb_to_linear_channel(c.r),
                srgb_to_linear_channel(c.g),
                srgb_to_linear_channel(c.b),
                c.a);
}

fn linear_to_srgb(c as Color) as Color {
    return rgba(linear_to_srgb_channel(c.r),
                linear_to_srgb_channel(c.g),
                linear_to_srgb_channel(c.b),
                c.a);
}

// --- Packing ---
//
// The byte layout is 0xAABBGGRR — red in the low byte — which is what a
// little-endian framebuffer holding RGBA8 expects.

fn pack_rgba8(c as Color) as i64 {
    let is i64 as r = cast(i64, s.saturate(c.r) * 255.0 + 0.5);
    let is i64 as g = cast(i64, s.saturate(c.g) * 255.0 + 0.5);
    let is i64 as b = cast(i64, s.saturate(c.b) * 255.0 + 0.5);
    let is i64 as a = cast(i64, s.saturate(c.a) * 255.0 + 0.5);
    return (a << 24) | (b << 16) | (g << 8) | r;
}

fn unpack_rgba8(v as i64) as Color {
    return rgba(cast(f64, v & 255) / 255.0,
                cast(f64, (v >> 8) & 255) / 255.0,
                cast(f64, (v >> 16) & 255) / 255.0,
                cast(f64, (v >> 24) & 255) / 255.0);
}

// 0xAARRGGBB, the order a Windows GDI or XRGB framebuffer wants.
fn pack_argb8(c as Color) as i64 {
    let is i64 as r = cast(i64, s.saturate(c.r) * 255.0 + 0.5);
    let is i64 as g = cast(i64, s.saturate(c.g) * 255.0 + 0.5);
    let is i64 as b = cast(i64, s.saturate(c.b) * 255.0 + 0.5);
    let is i64 as a = cast(i64, s.saturate(c.a) * 255.0 + 0.5);
    return (a << 24) | (r << 16) | (g << 8) | b;
}

// Takes a colour written the way a designer would (0xRRGGBB, sRGB-encoded)
// and returns it linear and ready to work with.
fn from_hex(hex as i64) as Color {
    let is Color as enc = rgb(cast(f64, (hex >> 16) & 255) / 255.0,
                              cast(f64, (hex >> 8) & 255) / 255.0,
                              cast(f64, hex & 255) / 255.0);
    return srgb_to_linear(enc);
}

// --- Arithmetic ---

fn col_add(a as Color, b as Color) as Color {
    return rgba(a.r + b.r, a.g + b.g, a.b + b.b, a.a + b.a);
}

fn col_sub(a as Color, b as Color) as Color {
    return rgba(a.r - b.r, a.g - b.g, a.b - b.b, a.a - b.a);
}

fn col_mul(a as Color, b as Color) as Color {
    return rgba(a.r * b.r, a.g * b.g, a.b * b.b, a.a * b.a);
}

fn col_scale(a as Color, k as f64) as Color {
    return rgba(a.r * k, a.g * k, a.b * k, a.a * k);
}

fn col_saturate(a as Color) as Color {
    return rgba(s.saturate(a.r), s.saturate(a.g), s.saturate(a.b), s.saturate(a.a));
}

// Straight interpolation, correct only because these are linear values.
fn col_lerp(a as Color, b as Color, t as f64) as Color {
    return rgba(a.r + (b.r - a.r) * t,
                a.g + (b.g - a.g) * t,
                a.b + (b.b - a.b) * t,
                a.a + (b.a - a.a) * t);
}

// Source-over compositing, the usual "draw src on top of dst".
fn col_over(src as Color, dst as Color) as Color {
    let is f64 as ia = 1.0 - src.a;
    let is f64 as a = src.a + dst.a * ia;
    if (a == 0.0) { return transparent(); }
    return rgba((src.r * src.a + dst.r * dst.a * ia) / a,
                (src.g * src.a + dst.g * dst.a * ia) / a,
                (src.b * src.a + dst.b * dst.a * ia) / a,
                a);
}

// Multiplies the colour by its own alpha. A premultiplied colour composites
// with a plain add, and filtering it does not bleed the colour of fully
// transparent texels into the edges of what is visible.
fn col_premultiply(c as Color) as Color {
    return rgba(c.r * c.a, c.g * c.a, c.b * c.a, c.a);
}

fn col_unpremultiply(c as Color) as Color {
    if (c.a == 0.0) { return transparent(); }
    return rgba(c.r / c.a, c.g / c.a, c.b / c.a, c.a);
}

// Rec. 709 luminance — the weights matching how the eye responds, applied to
// linear values. Averaging the channels instead gives a grey that reads too
// dark for greens and too bright for blues.
fn luminance(c as Color) as f64 {
    return 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b;
}

fn col_grayscale(c as Color) as Color {
    let is f64 as l = luminance(c);
    return rgba(l, l, l, c.a);
}

// --- HSV ---
//
// Hue in degrees 0..360, saturation and value 0..1. HSV is defined on the
// encoded values a picker shows, so these convert to and from sRGB-encoded
// colour and the results come back linear, ready to use.

fn from_hsv(h as f64, sat as f64, val as f64) as Color {
    let is f64 as hh = s.wrap(h, 0.0, 360.0) / 60.0;
    let is f64 as c = val * sat;
    let is f64 as x = c * (1.0 - fm.abs_f64(fm.fmod(hh, 2.0) - 1.0));
    let is f64 as m = val - c;
    let is f64 as r with mut = 0.0;
    let is f64 as g with mut = 0.0;
    let is f64 as b with mut = 0.0;
    if (hh < 1.0)      { r = c; g = x; b = 0.0; }
    else if (hh < 2.0) { r = x; g = c; b = 0.0; }
    else if (hh < 3.0) { r = 0.0; g = c; b = x; }
    else if (hh < 4.0) { r = 0.0; g = x; b = c; }
    else if (hh < 5.0) { r = x; g = 0.0; b = c; }
    else               { r = c; g = 0.0; b = x; }
    return srgb_to_linear(rgb(r + m, g + m, b + m));
}

// Writes hue, saturation and value through the out pointers.
fn to_hsv(col as Color, h_out as *f64, s_out as *f64, v_out as *f64) as void {
    let is Color as e = linear_to_srgb(col);
    let is f64 as mx = fm.max_f64(e.r, fm.max_f64(e.g, e.b));
    let is f64 as mn = fm.min_f64(e.r, fm.min_f64(e.g, e.b));
    let is f64 as d = mx - mn;

    *v_out = mx;
    if (mx == 0.0) { *s_out = 0.0; } else { *s_out = d / mx; }

    if (d == 0.0) { *h_out = 0.0; return; }
    let is f64 as h with mut = 0.0;
    if (mx == e.r)      { h = 60.0 * fm.fmod((e.g - e.b) / d, 6.0); }
    else if (mx == e.g) { h = 60.0 * ((e.b - e.r) / d + 2.0); }
    else                { h = 60.0 * ((e.r - e.g) / d + 4.0); }
    *h_out = s.wrap(h, 0.0, 360.0);
}

fn col_approx(a as Color, b as Color, eps as f64) as i32 {
    if (fm.abs_f64(a.r - b.r) > eps) { return 0; }
    if (fm.abs_f64(a.g - b.g) > eps) { return 0; }
    if (fm.abs_f64(a.b - b.b) > eps) { return 0; }
    if (fm.abs_f64(a.a - b.a) > eps) { return 0; }
    return 1;
}
