// math/math.cst — hub for the math layer.
//
//   use "caustic-media/math/math.cst" as math;
//   let is math.vec.Vec3 as p = math.vec.v3(1.0, 2.0, 3.0);
//   let is math.mat.Mat4 as m = math.mat.m4_identity();
//   let is math.quat.Quat as q = math.quat.q_identity();
//
// This layer is pure: it imports std/math for the scalar transcendentals and
// nothing else. No allocator, no syscalls, no external library — it builds
// and runs on every Caustic target, including wasm and CausticOS.
use "vec.cst" as vec;
use "mat.cst" as mat;
use "quat.cst" as quat;
