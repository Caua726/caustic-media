// math/math.cst — hub for the math layer.
//
//   use "caustic-media/math/math.cst" as math;
//   let is math.vec.Vec3 as p  = math.vec.v3(1.0, 2.0, 3.0);
//   let is math.mat.Mat4 as m  = math.mat.m4_identity();
//   let is math.quat.Quat as q = math.quat.q_identity();
//   let is math.color.Color as c = math.color.from_hex(0x3366CC);
//
// Modules:
//   vec     Vec2, Vec3, Vec4
//   mat     Mat3 and Mat4, transforms, projections, normal matrix
//   quat    rotation, slerp, conversion to and from Mat4
//   scalar  remap, smoothstep, angle wrapping, tolerant comparison
//   rect    axis-aligned 2D rectangles, layout splitting
//   color   linear colour, sRGB transfer, packing, HSV, compositing
//   geom    ray, plane, AABB, sphere, triangle, frustum, intersection
//   curve   easing functions and splines
//
// This layer is pure: it imports std/math for the scalar transcendentals and
// nothing else. No allocator, no syscalls, no external library — it builds and
// runs on every Caustic target, including wasm and CausticOS.
use "vec.cst" as vec;
use "mat.cst" as mat;
use "quat.cst" as quat;
use "scalar.cst" as scalar;
use "rect.cst" as rect;
use "color.cst" as color;
use "geom.cst" as geom;
use "curve.cst" as curve;
