// math/math_test.cst — checks the math layer against identities rather than
// memorised numbers: a transform composed with its inverse is the identity,
// a rotation preserves length, slerp at t=0 and t=1 hits the endpoints, a
// quaternion and the matrix built from it rotate a vector the same way.
//
// Identities catch sign and convention errors that a table of expected
// outputs does not, because a consistently wrong convention still reproduces
// its own numbers.
//
// Exit code is the number of failures.
use "std/io.cst" as io;
use "std/math.cst" as fm;
use "math.cst" as math;

let is i32 as fails with mut = 0;
let is f64 as EPS = 0.000000001;

fn fail(name as *u8) as void {
    fails = fails + 1;
    io.printf("  FAIL %s\n", name);
}

fn chk(name as *u8, ok as i32) as void {
    if (ok == 0) { fail(name); }
}

fn chk_f(name as *u8, got as f64, want as f64) as void {
    if (fm.abs_f64(got - want) > EPS) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d (scaled 1e6)\n",
                  name, cast(i64, got * 1000000.0), cast(i64, want * 1000000.0));
    }
}

fn main() as i32 {
    // --- Vectors ---
    let is math.vec.Vec3 as a = math.vec.v3(1.0, 2.0, 3.0);
    let is math.vec.Vec3 as b = math.vec.v3(4.0, 5.0, 6.0);

    chk_f("v3_dot",    math.vec.v3_dot(a, b), 32.0);
    chk_f("v3_len",    math.vec.v3_len(math.vec.v3(3.0, 4.0, 0.0)), 5.0);
    chk_f("v3_dist",   math.vec.v3_dist(math.vec.v3(1.0,0.0,0.0), math.vec.v3(4.0,4.0,0.0)), 5.0);

    // x cross y is z in a right-handed basis — this is the sign check that
    // catches a flipped winding order later.
    chk("v3_cross rh", math.vec.v3_approx(
        math.vec.v3_cross(math.vec.v3_right(), math.vec.v3_up()),
        math.vec.v3(0.0, 0.0, 1.0), EPS));

    // A cross product is perpendicular to both inputs.
    let is math.vec.Vec3 as c = math.vec.v3_cross(a, b);
    chk_f("cross perp a", math.vec.v3_dot(c, a), 0.0);
    chk_f("cross perp b", math.vec.v3_dot(c, b), 0.0);

    chk_f("normalize len", math.vec.v3_len(math.vec.v3_normalize(a)), 1.0);
    chk("normalize zero", math.vec.v3_approx(
        math.vec.v3_normalize(math.vec.v3_zero()), math.vec.v3_zero(), EPS));

    // Reflecting off a plane flips only the component along the normal.
    chk("v3_reflect", math.vec.v3_approx(
        math.vec.v3_reflect(math.vec.v3(1.0, -1.0, 0.0), math.vec.v3(0.0, 1.0, 0.0)),
        math.vec.v3(1.0, 1.0, 0.0), EPS));

    chk_f("v3_angle 90", math.vec.v3_angle(math.vec.v3_right(), math.vec.v3_up()), fm.PI_2);
    chk_f("v2_cross",    math.vec.v2_cross(math.vec.v2(1.0,0.0), math.vec.v2(0.0,1.0)), 1.0);

    // --- Matrices ---
    let is math.mat.Mat4 as id = math.mat.m4_identity();
    chk("identity neutral", math.mat.m4_approx(math.mat.m4_mul(id, id), id, EPS));

    // Translation moves a point and leaves a direction alone: that is the
    // whole reason points carry w=1 and directions w=0.
    let is math.mat.Mat4 as t = math.mat.m4_translation(math.vec.v3(10.0, 0.0, 0.0));
    chk("translate point", math.vec.v3_approx(
        math.mat.m4_mul_point(t, math.vec.v3(1.0, 2.0, 3.0)),
        math.vec.v3(11.0, 2.0, 3.0), EPS));
    chk("translate dir", math.vec.v3_approx(
        math.mat.m4_mul_dir(t, math.vec.v3(1.0, 2.0, 3.0)),
        math.vec.v3(1.0, 2.0, 3.0), EPS));

    // A quarter turn about Z takes +X to +Y.
    let is math.mat.Mat4 as rz = math.mat.m4_rotation_z(fm.PI_2);
    chk("rot_z 90", math.vec.v3_approx(
        math.mat.m4_mul_point(rz, math.vec.v3_right()), math.vec.v3_up(), EPS));

    // Rotation about an arbitrary axis must agree with the dedicated one.
    chk("rot_axis == rot_z", math.mat.m4_approx(
        math.mat.m4_rotation_axis(math.vec.v3(0.0, 0.0, 1.0), 0.7),
        math.mat.m4_rotation_z(0.7), EPS));

    // Composition order: m4_mul(a, b) applies b first.
    let is math.mat.Mat4 as tr = math.mat.m4_mul(t, rz);
    chk("compose order", math.vec.v3_approx(
        math.mat.m4_mul_point(tr, math.vec.v3_right()),
        math.vec.v3(10.0, 1.0, 0.0), EPS));

    // Inverse round-trips, on a matrix with rotation, scale and translation.
    let is math.mat.Mat4 as mix = math.mat.m4_mul(
        math.mat.m4_mul(math.mat.m4_translation(math.vec.v3(3.0, -2.0, 7.0)),
                        math.mat.m4_rotation_axis(math.vec.v3(1.0, 2.0, 3.0), 0.9)),
        math.mat.m4_scaling(math.vec.v3(2.0, 3.0, 4.0)));
    chk("inverse round trip", math.mat.m4_approx(
        math.mat.m4_mul(mix, math.mat.m4_inverse(mix)), id, 0.000001));

    chk_f("det identity", math.mat.m4_determinant(id), 1.0);
    chk_f("det scaling",  math.mat.m4_determinant(
        math.mat.m4_scaling(math.vec.v3(2.0, 3.0, 4.0))), 24.0);

    // Transposing twice is a no-op.
    chk("transpose twice", math.mat.m4_approx(
        math.mat.m4_transpose(math.mat.m4_transpose(mix)), mix, EPS));

    // A camera at +Z looking at the origin puts the origin straight ahead on
    // the view axis, at distance 5 down -Z.
    let is math.mat.Mat4 as view = math.mat.m4_look_at(
        math.vec.v3(0.0, 0.0, 5.0), math.vec.v3_zero(), math.vec.v3_up());
    chk("look_at origin", math.vec.v3_approx(
        math.mat.m4_mul_point(view, math.vec.v3_zero()),
        math.vec.v3(0.0, 0.0, -5.0), EPS));

    // A point on the near plane lands at z = -1 in GL clip space, and at
    // z = 0 in the [0,1] convention.
    let is math.mat.Mat4 as proj = math.mat.m4_perspective(fm.PI_2, 1.0, 1.0, 100.0);
    let is math.vec.Vec3 as nearp = math.mat.m4_project_point(proj, math.vec.v3(0.0, 0.0, -1.0));
    chk_f("perspective near z", nearp.z, -1.0);
    let is math.mat.Mat4 as pzo = math.mat.m4_perspective_zo(fm.PI_2, 1.0, 1.0, 100.0);
    // Bound to a variable rather than reaching for .z on the call directly:
    // the IR generator cannot take the address of a returned struct.
    let is math.vec.Vec3 as nearzo = math.mat.m4_project_point(pzo, math.vec.v3(0.0, 0.0, -1.0));
    chk_f("perspective_zo near z", nearzo.z, 0.0);

    // Orthographic maps its box corners onto the cube corners.
    let is math.mat.Mat4 as ortho = math.mat.m4_ortho(-2.0, 2.0, -2.0, 2.0, 1.0, 3.0);
    chk("ortho corner", math.vec.v3_approx(
        math.mat.m4_project_point(ortho, math.vec.v3(2.0, 2.0, -1.0)),
        math.vec.v3(1.0, 1.0, -1.0), EPS));

    // --- Quaternions ---
    let is math.quat.Quat as qi = math.quat.q_identity();
    chk("q identity rotates nothing", math.vec.v3_approx(
        math.quat.q_rotate_v3(qi, a), a, EPS));

    let is math.quat.Quat as qz = math.quat.q_from_axis_angle(math.vec.v3(0.0,0.0,1.0), fm.PI_2);
    chk("q rot_z 90", math.vec.v3_approx(
        math.quat.q_rotate_v3(qz, math.vec.v3_right()), math.vec.v3_up(), EPS));

    // The quaternion and the matrix built from it must agree — this is the
    // check that catches a transposed conversion.
    chk("q_to_mat4 agrees", math.vec.v3_approx(
        math.mat.m4_mul_point(math.quat.q_to_mat4(qz), a),
        math.quat.q_rotate_v3(qz, a), EPS));

    // And the conversion round-trips.
    chk("q_from_mat4 round trip",
        math.quat.q_approx(math.quat.q_from_mat4(math.quat.q_to_mat4(qz)), qz, EPS));

    // Rotation is rigid: it preserves length.
    let is math.quat.Quat as qa = math.quat.q_from_axis_angle(math.vec.v3(1.0,2.0,3.0), 1.1);
    chk_f("q preserves length",
          math.vec.v3_len(math.quat.q_rotate_v3(qa, a)), math.vec.v3_len(a));

    // Composing with the inverse gives back the original vector.
    chk("q inverse", math.vec.v3_approx(
        math.quat.q_rotate_v3(math.quat.q_mul(math.quat.q_inverse(qa), qa), a), a, EPS));

    // Composition order matches the matrix convention.
    let is math.quat.Quat as qb = math.quat.q_from_axis_angle(math.vec.v3(0.0,1.0,0.0), 0.6);
    chk("q compose == mat compose", math.vec.v3_approx(
        math.quat.q_rotate_v3(math.quat.q_mul(qa, qb), a),
        math.mat.m4_mul_point(math.mat.m4_mul(math.quat.q_to_mat4(qa),
                                              math.quat.q_to_mat4(qb)), a), 0.000001));

    // slerp hits its endpoints and stays on the unit sphere in between.
    chk("slerp t=0", math.quat.q_approx(math.quat.q_slerp(qa, qb, 0.0), qa, EPS));
    chk("slerp t=1", math.quat.q_approx(math.quat.q_slerp(qa, qb, 1.0), qb, EPS));
    chk_f("slerp unit", math.quat.q_len(math.quat.q_slerp(qa, qb, 0.37)), 1.0);

    // --- Cubic Bezier timing ---
    // A Bezier whose x runs evenly is a polynomial in t: degree-elevated, t*t
    // and t*t*t are cubic Beziers, and so is the line.
    let is math.curve.CubicBezier as quad = math.curve.cubic_bezier(1.0 / 3.0, 0.0, 2.0 / 3.0, 1.0 / 3.0);
    let is math.curve.CubicBezier as cube = math.curve.cubic_bezier(1.0 / 3.0, 0.0, 2.0 / 3.0, 0.0);
    let is math.curve.CubicBezier as cube_out = math.curve.cubic_bezier(1.0 / 3.0, 1.0, 2.0 / 3.0, 1.0);
    let is math.curve.CubicBezier as line = math.curve.cubic_bezier(0.3, 0.3, 0.8, 0.8);
    let is f64 as x with mut = 0.0;
    let is i32 as same_quad with mut = 1;
    let is i32 as same_cube with mut = 1;
    let is i32 as same_line with mut = 1;
    let is i32 as mirrored with mut = 1;
    let is i32 as symmetric with mut = 1;
    let is i32 as rising with mut = 1;
    let is f64 as last with mut = 0.0;
    while (x <= 1.0) {
        if (fm.abs_f64(math.curve.ease_cubic_bezier(&quad, x) - math.curve.ease_in_quad(x)) > EPS) { same_quad = 0; }
        if (fm.abs_f64(math.curve.ease_cubic_bezier(&cube, x) - math.curve.ease_in_cubic(x)) > EPS) { same_cube = 0; }
        if (fm.abs_f64(math.curve.ease_cubic_bezier(&cube_out, x) - math.curve.ease_out_cubic(x)) > EPS) { same_cube = 0; }
        if (fm.abs_f64(math.curve.ease_cubic_bezier(&line, x) - x) > EPS) { same_line = 0; }
        // CSS's ease-out is its ease-in turned through the centre; its
        // ease-in-out is its own.
        if (fm.abs_f64(math.curve.ease(math.curve.EASE_CSS_OUT, x)
                       - (1.0 - math.curve.ease(math.curve.EASE_CSS_IN, 1.0 - x))) > EPS) { mirrored = 0; }
        if (fm.abs_f64(math.curve.ease(math.curve.EASE_CSS_IN_OUT, x)
                       + math.curve.ease(math.curve.EASE_CSS_IN_OUT, 1.0 - x) - 1.0) > EPS) { symmetric = 0; }
        // Fluent's decelerate is the flattest at the end: x barely moving
        // there, where Newton's method has least to go on.
        let is f64 as v = math.curve.ease(math.curve.EASE_FLUENT_DECELERATE, x);
        if (v < last) { rising = 0; }
        last = v;
        x = x + 0.0078125;
    }
    chk("bezier: t squared", same_quad);
    chk("bezier: t cubed, in and out", same_cube);
    chk("bezier: a line", same_line);
    chk("bezier: css ease-out mirrors ease-in", mirrored);
    chk("bezier: css ease-in-out is symmetric", symmetric);
    chk("bezier: never back", rising);
    // The value every browser agrees on.
    chk("bezier: css ease at a half", fm.abs_f64(math.curve.ease(math.curve.EASE_CSS, 0.5) - 0.8024033876) < 0.000001);
    chk_f("bezier: the start exactly", math.curve.ease(math.curve.EASE_CSS, 0.0), 0.0);
    chk("bezier: the end exactly", math.curve.ease(math.curve.EASE_FLUENT_POINT, 1.0) == 1.0
        && math.curve.ease(math.curve.EASE_CSS, 1.0) == 1.0);
    // One whose coefficients do not add up to 1 exactly in floating point.
    let is math.curve.CubicBezier as odd = math.curve.cubic_bezier(0.23, 1.39, 0.9, 0.0 - 0.44);
    chk("bezier: the end exactly, whatever the rounding", math.curve.ease_cubic_bezier(&odd, 1.0) == 1.0);
    chk("bezier: clamped outside", math.curve.ease(math.curve.EASE_CSS, 0.0 - 1.0) == 0.0
        && math.curve.ease(math.curve.EASE_CSS, 2.0) == 1.0);
    // y may leave 0..1, for an overshoot; x may not, which keeps one answer.
    let is math.curve.CubicBezier as over = math.curve.cubic_bezier(0.3, 1.6, 0.6, 1.0);
    chk("bezier: overshoot", math.curve.ease_cubic_bezier(&over, 0.5) > 1.0);
    let is math.curve.CubicBezier as wild = math.curve.cubic_bezier(0.0 - 2.0, 0.0, 3.0, 1.0);
    let is math.curve.CubicBezier as tame = math.curve.cubic_bezier(0.0, 0.0, 1.0, 1.0);
    chk_f("bezier: x kept within 0..1", math.curve.ease_cubic_bezier(&wild, 0.3), math.curve.ease_cubic_bezier(&tame, 0.3));

    // --- Easing by name ---
    chk_f("by name: linear", math.curve.ease(math.curve.EASE_LINEAR, 0.3), 0.3);
    chk_f("by name: in quad", math.curve.ease(math.curve.EASE_IN_QUAD, 0.3), math.curve.ease_in_quad(0.3));
    chk_f("by name: out quad", math.curve.ease(math.curve.EASE_OUT_QUAD, 0.3), math.curve.ease_out_quad(0.3));
    chk_f("by name: in-out quad", math.curve.ease(math.curve.EASE_IN_OUT_QUAD, 0.3), math.curve.ease_in_out_quad(0.3));
    chk_f("by name: in cubic", math.curve.ease(math.curve.EASE_IN_CUBIC, 0.3), math.curve.ease_in_cubic(0.3));
    chk_f("by name: out cubic", math.curve.ease(math.curve.EASE_OUT_CUBIC, 0.3), math.curve.ease_out_cubic(0.3));
    chk_f("by name: in-out cubic", math.curve.ease(math.curve.EASE_IN_OUT_CUBIC, 0.3), math.curve.ease_in_out_cubic(0.3));
    chk_f("by name: in sine", math.curve.ease(math.curve.EASE_IN_SINE, 0.3), math.curve.ease_in_sine(0.3));
    chk_f("by name: out sine", math.curve.ease(math.curve.EASE_OUT_SINE, 0.3), math.curve.ease_out_sine(0.3));
    chk_f("by name: in-out sine", math.curve.ease(math.curve.EASE_IN_OUT_SINE, 0.3), math.curve.ease_in_out_sine(0.3));
    chk_f("by name: in expo", math.curve.ease(math.curve.EASE_IN_EXPO, 0.3), math.curve.ease_in_expo(0.3));
    chk_f("by name: out expo", math.curve.ease(math.curve.EASE_OUT_EXPO, 0.3), math.curve.ease_out_expo(0.3));
    chk_f("by name: out back", math.curve.ease(math.curve.EASE_OUT_BACK, 0.3), math.curve.ease_out_back(0.3));
    chk_f("by name: out elastic", math.curve.ease(math.curve.EASE_OUT_ELASTIC, 0.3), math.curve.ease_out_elastic(0.3));
    chk_f("by name: out bounce", math.curve.ease(math.curve.EASE_OUT_BOUNCE, 0.3), math.curve.ease_out_bounce(0.3));
    chk_f("by name: in bounce", math.curve.ease(math.curve.EASE_IN_BOUNCE, 0.3), math.curve.ease_in_bounce(0.3));
    let is math.curve.CubicBezier as css_in = math.curve.cubic_bezier(0.42, 0.0, 1.0, 1.0);
    chk_f("by name: css ease-in", math.curve.ease(math.curve.EASE_CSS_IN, 0.3), math.curve.ease_cubic_bezier(&css_in, 0.3));
    let is math.curve.CubicBezier as css_io = math.curve.cubic_bezier(0.42, 0.0, 0.58, 1.0);
    chk_f("by name: css ease-in-out", math.curve.ease(math.curve.EASE_CSS_IN_OUT, 0.3), math.curve.ease_cubic_bezier(&css_io, 0.3));
    let is math.curve.CubicBezier as fd = math.curve.cubic_bezier(0.0, 0.0, 0.0, 1.0);
    chk_f("by name: fluent decelerate", math.curve.ease(math.curve.EASE_FLUENT_DECELERATE, 0.3), math.curve.ease_cubic_bezier(&fd, 0.3));
    let is math.curve.CubicBezier as fa = math.curve.cubic_bezier(1.0, 0.0, 1.0, 1.0);
    chk_f("by name: fluent accelerate", math.curve.ease(math.curve.EASE_FLUENT_ACCELERATE, 0.3), math.curve.ease_cubic_bezier(&fa, 0.3));
    let is math.curve.CubicBezier as fp = math.curve.cubic_bezier(0.55, 0.55, 0.0, 1.0);
    chk_f("by name: fluent point to point", math.curve.ease(math.curve.EASE_FLUENT_POINT, 0.3), math.curve.ease_cubic_bezier(&fp, 0.3));
    chk_f("by name: an unknown one is linear", math.curve.ease(999, 0.3), 0.3);

    if (fails == 0) { io.printf("math layer: all checks passed\n"); }
    else { io.printf("  math_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
