// math/geom_test.cst — scalar, rect, color, geom and curve.
//
// Same discipline as math_test: check properties and round-trips rather than
// remembered outputs. A ray hit is verified by putting t back into the ray and
// landing on the surface; a colour conversion by coming back to where it
// started; a frustum by what it accepts and rejects.
//
// Exit code is the number of failures.
use "std/io.cst" as io;
use "std/math.cst" as fm;
use "math.cst" as math;

let is i32 as fails with mut = 0;
let is f64 as EPS = 0.000000001;

fn chk(name as *u8, ok as i32) as void {
    if (ok == 0) { fails = fails + 1; io.printf("  FAIL %s\n", name); }
}

fn chk_f(name as *u8, got as f64, want as f64) as void {
    if (fm.abs_f64(got - want) > 0.000001) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d (scaled 1e6)\n",
                  name, cast(i64, got * 1000000.0), cast(i64, want * 1000000.0));
    }
}

fn test_scalar() as void {
    chk_f("saturate hi", math.scalar.saturate(2.0), 1.0);
    chk_f("saturate lo", math.scalar.saturate(0.0 - 2.0), 0.0);
    chk_f("inv_lerp",    math.scalar.inv_lerp(10.0, 20.0, 15.0), 0.5);
    chk_f("inv_lerp degenerate", math.scalar.inv_lerp(5.0, 5.0, 5.0), 0.0);
    chk_f("remap",       math.scalar.remap(15.0, 10.0, 20.0, 0.0, 100.0), 50.0);

    // A ramp is flat at both ends and exactly half way across at the middle.
    chk_f("smoothstep 0",   math.scalar.smoothstep(0.0, 1.0, 0.0), 0.0);
    chk_f("smoothstep 1",   math.scalar.smoothstep(0.0, 1.0, 1.0), 1.0);
    chk_f("smoothstep mid", math.scalar.smoothstep(0.0, 1.0, 0.5), 0.5);
    chk_f("smootherstep mid", math.scalar.smootherstep(0.0, 1.0, 0.5), 0.5);
    chk_f("step below", math.scalar.step(1.0, 0.5), 0.0);
    chk_f("step above", math.scalar.step(1.0, 1.5), 1.0);

    // Wrapping has to work in both directions, not just for values above the
    // range — a negative input is the case a naive fmod gets wrong.
    chk_f("wrap over",  math.scalar.wrap(370.0, 0.0, 360.0), 10.0);
    chk_f("wrap under", math.scalar.wrap(0.0 - 10.0, 0.0, 360.0), 350.0);
    chk_f("wrap inside", math.scalar.wrap(180.0, 0.0, 360.0), 180.0);
    chk_f("ping_pong",  math.scalar.ping_pong(1.5, 1.0), 0.5);

    // The shortest way from 350 to 10 degrees is +20, not -340. Getting this
    // wrong makes a turning object spin the long way round once per lap.
    chk_f("angle_delta wrap",
          math.scalar.angle_delta(math.scalar.radians(350.0), math.scalar.radians(10.0)),
          math.scalar.radians(20.0));
    chk_f("lerp_angle half",
          math.scalar.lerp_angle(math.scalar.radians(350.0), math.scalar.radians(10.0), 0.5),
          math.scalar.radians(0.0));

    chk_f("radians round trip", math.scalar.degrees(math.scalar.radians(123.0)), 123.0);
    chk("approx near zero", math.scalar.approx(0.0, 0.0000000001, 0.000001));
    chk("approx large", math.scalar.approx(1000000.0, 1000000.1, 0.000001));
    chk("approx rejects", cast(i32, 1 - math.scalar.approx(1.0, 2.0, 0.000001)));
    chk("is_pow2", math.scalar.is_pow2_i64(1024));
    chk("not pow2", cast(i32, 1 - math.scalar.is_pow2_i64(1000)));
    chk("next_pow2", cast(i32, math.scalar.next_pow2_i64(1000) == 1024));
}

fn test_rect() as void {
    let is math.rect.Rect as r = math.rect.rect(10.0, 20.0, 100.0, 50.0);
    chk_f("rect area", math.rect.rect_area(r), 5000.0);
    chk("rect center", math.vec.v2_approx(math.rect.rect_center(r), math.vec.v2(60.0, 45.0), EPS));

    // Half-open: the min corner is inside, the max corner belongs to the next
    // rect over. This is what lets adjacent rects tile without overlapping.
    chk("contains min", math.rect.rect_contains(r, math.vec.v2(10.0, 20.0)));
    chk("excludes max", cast(i32, 1 - math.rect.rect_contains(r, math.vec.v2(110.0, 70.0))));
    chk("contains inside", math.rect.rect_contains(r, math.vec.v2(50.0, 40.0)));

    // Touching edges do not overlap, for the same reason.
    chk("touching rects miss", cast(i32, 1 - math.rect.rect_overlaps(
        math.rect.rect(0.0, 0.0, 10.0, 10.0), math.rect.rect(10.0, 0.0, 10.0, 10.0))));
    chk("overlapping rects hit", math.rect.rect_overlaps(
        math.rect.rect(0.0, 0.0, 10.0, 10.0), math.rect.rect(5.0, 5.0, 10.0, 10.0)));

    chk("intersect", math.rect.rect_approx(
        math.rect.rect_intersect(math.rect.rect(0.0, 0.0, 10.0, 10.0),
                                 math.rect.rect(5.0, 5.0, 10.0, 10.0)),
        math.rect.rect(5.0, 5.0, 5.0, 5.0), EPS));
    chk("disjoint intersect is empty", math.rect.rect_is_empty(
        math.rect.rect_intersect(math.rect.rect(0.0, 0.0, 1.0, 1.0),
                                 math.rect.rect(5.0, 5.0, 1.0, 1.0))));
    chk("union", math.rect.rect_approx(
        math.rect.rect_union(math.rect.rect(0.0, 0.0, 5.0, 5.0),
                             math.rect.rect(10.0, 10.0, 5.0, 5.0)),
        math.rect.rect(0.0, 0.0, 15.0, 15.0), EPS));

    chk("expand then shrink", math.rect.rect_approx(
        math.rect.rect_shrink(math.rect.rect_expand(r, 5.0), 5.0), r, EPS));
    // Shrinking past nothing collapses rather than inverting.
    chk("over-shrink collapses", math.rect.rect_is_empty(
        math.rect.rect_shrink(math.rect.rect(0.0, 0.0, 4.0, 4.0), 10.0)));

    // Normalising a point and reading it back is the identity.
    let is math.vec.Vec2 as p = math.vec.v2(35.0, 30.0);
    chk("normalize/lerp round trip", math.vec.v2_approx(
        math.rect.rect_lerp_point(r, math.rect.rect_normalize_point(r, p)), p, EPS));

    // Taking a strip and cutting it leaves the rest, and the two are disjoint.
    let is math.rect.Rect as taken = math.rect.rect_take_left(r, 30.0);
    let is math.rect.Rect as rest  = math.rect.rect_cut_left(r, 30.0);
    chk_f("cut widths sum", taken.w + rest.w, r.w);
    chk("cut halves disjoint", cast(i32, 1 - math.rect.rect_overlaps(taken, rest)));
}

fn test_color() as void {
    // The transfer function has to invert itself, or every image round-tripped
    // through the renderer drifts.
    let is math.color.Color as c = math.color.rgb(0.2, 0.5, 0.8);
    chk("srgb round trip", math.color.col_approx(
        math.color.linear_to_srgb(math.color.srgb_to_linear(c)), c, 0.000001));

    // The curve pins both ends exactly.
    chk_f("srgb black", math.color.srgb_to_linear_channel(0.0), 0.0);
    chk_f("srgb white", math.color.srgb_to_linear_channel(1.0), 1.0);
    // And mid grey is darker in linear than its encoding suggests — the whole
    // reason the distinction matters.
    chk("mid grey darkens",
        cast(i32, math.color.srgb_to_linear_channel(0.5) < 0.25));

    chk("pack round trip", math.color.col_approx(
        math.color.unpack_rgba8(math.color.pack_rgba8(math.color.rgba(0.0, 0.2, 0.6, 1.0))),
        math.color.rgba(0.0, 0.2, 0.6, 1.0), 0.005));

    // Red in the low byte, alpha in the high one.
    chk("pack layout", cast(i32,
        math.color.pack_rgba8(math.color.rgba(1.0, 0.0, 0.0, 1.0)) == 4278190335));

    chk_f("luminance white", math.color.luminance(math.color.white()), 1.0);
    chk_f("luminance black", math.color.luminance(math.color.black()), 0.0);

    // Opaque source hides whatever is behind it.
    chk("over opaque", math.color.col_approx(
        math.color.col_over(math.color.red(), math.color.blue()), math.color.red(), EPS));
    // Fully transparent source leaves the destination alone.
    chk("over transparent", math.color.col_approx(
        math.color.col_over(math.color.transparent(), math.color.blue()),
        math.color.blue(), EPS));

    let is math.color.Color as half = math.color.rgba(0.4, 0.6, 0.8, 0.5);
    chk("premultiply round trip", math.color.col_approx(
        math.color.col_unpremultiply(math.color.col_premultiply(half)), half, EPS));

    // HSV goes out and comes back.
    let is f64 as h with mut = 0.0;
    let is f64 as s with mut = 0.0;
    let is f64 as vv with mut = 0.0;
    let is math.color.Color as orig = math.color.from_hsv(210.0, 0.75, 0.9);
    math.color.to_hsv(orig, &h, &s, &vv);
    chk_f("hsv hue", h, 210.0);
    chk_f("hsv sat", s, 0.75);
    chk_f("hsv val", vv, 0.9);

    // A hex literal is sRGB-encoded, so it must come back darker in linear.
    let is math.color.Color as hexc = math.color.from_hex(0x808080);
    chk("from_hex decodes", cast(i32, hexc.r < 0.3));
    chk_f("from_hex is grey", hexc.r, hexc.b);
}

fn test_geom() as void {
    // A ray straight down hits the ground plane at the height it started.
    let is math.geom.Ray as down = math.geom.ray(math.vec.v3(0.0, 5.0, 0.0),
                                                 math.vec.v3(0.0, -1.0, 0.0));
    let is math.geom.Plane as ground = math.geom.plane(math.vec.v3(0.0, 1.0, 0.0), 0.0);
    let is f64 as t with mut = 0.0;
    chk("ray_plane hits", math.geom.ray_plane(down, ground, &t));
    chk_f("ray_plane t", t, 5.0);
    // And the hit point is on the plane, which is the real check.
    chk_f("hit lies on plane",
          math.geom.plane_distance(ground, math.geom.ray_at(down, t)), 0.0);

    // A ray pointing away never hits, even though the plane is right there.
    let is math.geom.Ray as up = math.geom.ray(math.vec.v3(0.0, 5.0, 0.0),
                                               math.vec.v3(0.0, 1.0, 0.0));
    chk("ray_plane behind misses", cast(i32, 1 - math.geom.ray_plane(up, ground, &t)));

    // Sphere: the near surface first.
    let is math.geom.Sphere as sp = math.geom.sphere(math.vec.v3(0.0, 0.0, -10.0), 2.0);
    let is math.geom.Ray as fwd = math.geom.ray(math.vec.v3_zero(), math.vec.v3(0.0, 0.0, -1.0));
    chk("ray_sphere hits", math.geom.ray_sphere(fwd, sp, &t));
    chk_f("ray_sphere near t", t, 8.0);
    // From inside, the only hit in front is the far surface.
    let is math.geom.Ray as inside = math.geom.ray(math.vec.v3(0.0, 0.0, -10.0),
                                                   math.vec.v3(0.0, 0.0, -1.0));
    chk("ray_sphere from inside", math.geom.ray_sphere(inside, sp, &t));
    chk_f("ray_sphere inside t", t, 2.0);
    let is math.geom.Ray as off = math.geom.ray(math.vec.v3(10.0, 0.0, 0.0),
                                                math.vec.v3(0.0, 0.0, -1.0));
    chk("ray_sphere misses", cast(i32, 1 - math.geom.ray_sphere(off, sp, &t)));

    // Box, including a ray exactly parallel to two of the slabs, which is the
    // case that divides by zero if it is not handled.
    let is math.geom.AABB as box = math.geom.aabb(math.vec.v3(-1.0, -1.0, -11.0),
                                                  math.vec.v3(1.0, 1.0, -9.0));
    chk("ray_aabb hits", math.geom.ray_aabb(fwd, box, &t));
    chk_f("ray_aabb t", t, 9.0);
    chk("ray_aabb misses", cast(i32, 1 - math.geom.ray_aabb(off, box, &t)));
    // Origin inside the box reports t = 0 rather than the exit distance.
    let is math.geom.Ray as inbox = math.geom.ray(math.vec.v3(0.0, 0.0, -10.0),
                                                  math.vec.v3(1.0, 0.0, 0.0));
    chk("ray_aabb from inside", math.geom.ray_aabb(inbox, box, &t));
    chk_f("ray_aabb inside t", t, 0.0);

    // Triangle, with the barycentric weights checked by rebuilding the point.
    let is math.geom.Triangle as tri = math.geom.triangle(
        math.vec.v3(0.0, 0.0, -5.0), math.vec.v3(2.0, 0.0, -5.0), math.vec.v3(0.0, 2.0, -5.0));
    let is f64 as u with mut = 0.0;
    let is f64 as vb with mut = 0.0;
    let is math.geom.Ray as at_tri = math.geom.ray(math.vec.v3(0.5, 0.5, 0.0),
                                                   math.vec.v3(0.0, 0.0, -1.0));
    chk("ray_triangle hits", math.geom.ray_triangle(at_tri, tri, &t, &u, &vb));
    chk_f("ray_triangle t", t, 5.0);
    chk("hit inside triangle", cast(i32, u >= 0.0 && vb >= 0.0 && u + vb <= 1.0));
    // A ray through the same plane but outside the triangle must miss.
    let is math.geom.Ray as past_tri = math.geom.ray(math.vec.v3(5.0, 5.0, 0.0),
                                                     math.vec.v3(0.0, 0.0, -1.0));
    chk("ray_triangle misses", cast(i32,
        1 - math.geom.ray_triangle(past_tri, tri, &t, &u, &vb)));

    chk("tri_normal faces +z", math.vec.v3_approx(
        math.geom.tri_normal(tri), math.vec.v3(0.0, 0.0, 1.0), EPS));
    chk_f("tri_area", math.geom.tri_area(tri), 2.0);

    // Barycentric weights of a vertex are 1 at that vertex and 0 elsewhere.
    let is f64 as w with mut = 0.0;
    math.geom.tri_barycentric(tri, tri.b, &u, &vb, &w);
    chk_f("bary at b: u", u, 0.0);
    chk_f("bary at b: v", vb, 1.0);
    chk_f("bary at b: w", w, 0.0);

    // Box helpers.
    chk("aabb contains", math.geom.aabb_contains(box, math.vec.v3(0.0, 0.0, -10.0)));
    chk("aabb excludes", cast(i32, 1 - math.geom.aabb_contains(box, math.vec.v3(0.0, 0.0, 0.0))));
    chk("aabb overlaps sphere", math.geom.aabb_overlaps_sphere(box, sp));
    chk("aabb misses far sphere", cast(i32, 1 - math.geom.aabb_overlaps_sphere(
        box, math.geom.sphere(math.vec.v3(100.0, 0.0, 0.0), 1.0))));

    // An empty box grown by points ends up tight around them.
    let is math.geom.AABB as grown with mut = math.geom.aabb_empty();
    chk("aabb_empty is empty", math.geom.aabb_is_empty(grown));
    grown = math.geom.aabb_encompass(grown, math.vec.v3(1.0, 2.0, 3.0));
    grown = math.geom.aabb_encompass(grown, math.vec.v3(-1.0, 0.0, 5.0));
    chk("encompass min", math.vec.v3_approx(grown.min, math.vec.v3(-1.0, 0.0, 3.0), EPS));
    chk("encompass max", math.vec.v3_approx(grown.max, math.vec.v3(1.0, 2.0, 5.0), EPS));

    // Translating a box moves it and leaves its size alone.
    let is math.geom.AABB as moved = math.geom.aabb_transform(
        box, math.mat.m4_translation(math.vec.v3(10.0, 0.0, 0.0)));
    chk("transform moves box", math.vec.v3_approx(
        math.geom.aabb_center(moved),
        math.vec.v3_add(math.geom.aabb_center(box), math.vec.v3(10.0, 0.0, 0.0)), EPS));
    chk("transform keeps size", math.vec.v3_approx(
        math.geom.aabb_size(moved), math.geom.aabb_size(box), EPS));

    // Frustum: camera at the origin looking down -Z, near 1, far 100.
    let is math.mat.Mat4 as proj = math.mat.m4_perspective(fm.PI_2, 1.0, 1.0, 100.0);
    let is math.mat.Mat4 as view = math.mat.m4_look_at(
        math.vec.v3_zero(), math.vec.v3(0.0, 0.0, -1.0), math.vec.v3_up());
    let is math.geom.Frustum as fr = math.geom.frustum_from_matrix(math.mat.m4_mul(proj, view));

    chk("frustum contains ahead",  math.geom.frustum_contains_point(fr, math.vec.v3(0.0, 0.0, -10.0)));
    chk("frustum rejects behind",  cast(i32, 1 - math.geom.frustum_contains_point(fr, math.vec.v3(0.0, 0.0, 10.0))));
    chk("frustum rejects too near", cast(i32, 1 - math.geom.frustum_contains_point(fr, math.vec.v3(0.0, 0.0, -0.5))));
    chk("frustum rejects too far",  cast(i32, 1 - math.geom.frustum_contains_point(fr, math.vec.v3(0.0, 0.0, -1000.0))));
    chk("frustum rejects far off-axis", cast(i32, 1 - math.geom.frustum_contains_point(fr, math.vec.v3(1000.0, 0.0, -10.0))));

    chk("frustum sphere inside", math.geom.frustum_overlaps_sphere(
        fr, math.geom.sphere(math.vec.v3(0.0, 0.0, -10.0), 1.0)));
    // A sphere whose centre sits outside the near plane but whose radius
    // reaches past it still counts: centre at z = -0.5 is nearer than the
    // near plane at z = -1, but the sphere spans to z = -1.5.
    chk("frustum sphere grazing", math.geom.frustum_overlaps_sphere(
        fr, math.geom.sphere(math.vec.v3(0.0, 0.0, -0.5), 1.0)));
    // Whereas one that stops short of the near plane is correctly rejected.
    chk("frustum sphere short of near", cast(i32, 1 - math.geom.frustum_overlaps_sphere(
        fr, math.geom.sphere(math.vec.v3(0.0, 0.0, 0.5), 1.0))));
    chk("frustum sphere outside", cast(i32, 1 - math.geom.frustum_overlaps_sphere(
        fr, math.geom.sphere(math.vec.v3(0.0, 0.0, 1000.0), 1.0))));

    chk("frustum aabb inside", math.geom.frustum_overlaps_aabb(fr, box));
    chk("frustum aabb outside", cast(i32, 1 - math.geom.frustum_overlaps_aabb(
        fr, math.geom.aabb(math.vec.v3(0.0, 0.0, 500.0), math.vec.v3(1.0, 1.0, 501.0)))));
}

fn test_curve() as void {
    // Every easing function is pinned at both ends: only the pace between
    // them differs, which is the whole contract.
    chk_f("in_quad 0",  math.curve.ease_in_quad(0.0), 0.0);
    chk_f("in_quad 1",  math.curve.ease_in_quad(1.0), 1.0);
    chk_f("out_quad 0", math.curve.ease_out_quad(0.0), 0.0);
    chk_f("out_quad 1", math.curve.ease_out_quad(1.0), 1.0);
    chk_f("in_out_quad 0", math.curve.ease_in_out_quad(0.0), 0.0);
    chk_f("in_out_quad 1", math.curve.ease_in_out_quad(1.0), 1.0);
    chk_f("in_out_quad mid", math.curve.ease_in_out_quad(0.5), 0.5);
    chk_f("in_cubic 1",  math.curve.ease_in_cubic(1.0), 1.0);
    chk_f("out_cubic 1", math.curve.ease_out_cubic(1.0), 1.0);
    chk_f("in_out_cubic mid", math.curve.ease_in_out_cubic(0.5), 0.5);
    chk_f("in_sine 1",   math.curve.ease_in_sine(1.0), 1.0);
    chk_f("out_sine 1",  math.curve.ease_out_sine(1.0), 1.0);
    chk_f("in_out_sine mid", math.curve.ease_in_out_sine(0.5), 0.5);
    chk_f("in_expo 0",   math.curve.ease_in_expo(0.0), 0.0);
    chk_f("out_expo 1",  math.curve.ease_out_expo(1.0), 1.0);
    chk_f("out_bounce 1", math.curve.ease_out_bounce(1.0), 1.0);
    chk_f("in_bounce 0",  math.curve.ease_in_bounce(0.0), 0.0);
    chk_f("out_elastic 1", math.curve.ease_out_elastic(1.0), 1.0);

    // in_quad starts slower than linear, out_quad starts faster: the pair is
    // only useful if they actually differ in that direction.
    chk("in_quad below linear",  cast(i32, math.curve.ease_in_quad(0.25) < 0.25));
    chk("out_quad above linear", cast(i32, math.curve.ease_out_quad(0.25) > 0.25));

    // A Bezier passes through its first and last control point and not
    // through the middle two.
    let is math.vec.Vec3 as p0 = math.vec.v3(0.0, 0.0, 0.0);
    let is math.vec.Vec3 as p1 = math.vec.v3(0.0, 1.0, 0.0);
    let is math.vec.Vec3 as p2 = math.vec.v3(1.0, 1.0, 0.0);
    let is math.vec.Vec3 as p3 = math.vec.v3(1.0, 0.0, 0.0);
    chk("bezier3 start", math.vec.v3_approx(math.curve.bezier3(p0,p1,p2,p3, 0.0), p0, EPS));
    chk("bezier3 end",   math.vec.v3_approx(math.curve.bezier3(p0,p1,p2,p3, 1.0), p3, EPS));
    // Symmetric control points put the midpoint on the axis of symmetry.
    let is math.vec.Vec3 as bmid = math.curve.bezier3(p0, p1, p2, p3, 0.5);
    chk_f("bezier3 mid x", bmid.x, 0.5);
    // The tangent at the start points at the first control point.
    chk("bezier3 tangent", math.vec.v3_approx(
        math.vec.v3_normalize(math.curve.bezier3_tangent(p0,p1,p2,p3, 0.0)),
        math.vec.v3_normalize(math.vec.v3_sub(p1, p0)), EPS));

    chk("bezier2 start", math.vec.v3_approx(math.curve.bezier2(p0,p1,p2, 0.0), p0, EPS));
    chk("bezier2 end",   math.vec.v3_approx(math.curve.bezier2(p0,p1,p2, 1.0), p2, EPS));

    // Catmull-Rom does pass through its middle two points — that is the
    // difference from a Bezier, and the reason to use it for a placed path.
    chk("catmull start", math.vec.v3_approx(math.curve.catmull_rom(p0,p1,p2,p3, 0.0), p1, EPS));
    chk("catmull end",   math.vec.v3_approx(math.curve.catmull_rom(p0,p1,p2,p3, 1.0), p2, EPS));

    chk("hermite start", math.vec.v3_approx(math.curve.hermite(p0,p1,p2,p3, 0.0), p0, EPS));
    chk("hermite end",   math.vec.v3_approx(math.curve.hermite(p0,p1,p2,p3, 1.0), p2, EPS));
}

fn test_mat3() as void {
    let is math.mat.Mat3 as id = math.mat.m3_identity();
    chk("m3 identity neutral", math.mat.m3_approx(math.mat.m3_mul(id, id), id, EPS));
    chk_f("m3 det identity", math.mat.m3_determinant(id), 1.0);

    let is math.mat.Mat3 as r2 = math.mat.m3_rotation2(fm.PI_2);
    chk("m3 rot2 90", math.vec.v2_approx(
        math.mat.m3_mul_point2(r2, math.vec.v2(1.0, 0.0)), math.vec.v2(0.0, 1.0), EPS));

    // 2D translation moves a point and leaves a direction alone, same as 3D.
    let is math.mat.Mat3 as t2 = math.mat.m3_translation2(math.vec.v2(5.0, 0.0));
    chk("m3 translate point", math.vec.v2_approx(
        math.mat.m3_mul_point2(t2, math.vec.v2(1.0, 1.0)), math.vec.v2(6.0, 1.0), EPS));
    chk("m3 translate dir", math.vec.v2_approx(
        math.mat.m3_mul_dir2(t2, math.vec.v2(1.0, 1.0)), math.vec.v2(1.0, 1.0), EPS));

    let is math.mat.Mat3 as mix = math.mat.m3_mul(r2, math.mat.m3_scaling2(math.vec.v2(2.0, 3.0)));
    chk("m3 inverse round trip", math.mat.m3_approx(
        math.mat.m3_mul(mix, math.mat.m3_inverse(mix)), id, 0.000001));

    // A rotation's normal matrix is the rotation itself, since there is no
    // scale to correct for.
    let is math.mat.Mat4 as rot = math.mat.m4_rotation_y(0.7);
    chk("normal matrix of rotation", math.mat.m3_approx(
        math.mat.m3_normal_matrix(rot), math.mat.m3_from_m4(rot), 0.000001));

    // Under a non-uniform scale it is not, and that is the whole point: a
    // normal transformed by the model matrix would come out unnormalised and
    // tilted, so lighting would be wrong on a squashed mesh.
    let is math.mat.Mat4 as squash = math.mat.m4_scaling(math.vec.v3(1.0, 4.0, 1.0));
    let is math.mat.Mat3 as nm = math.mat.m3_normal_matrix(squash);
    chk("normal matrix differs under scale", cast(i32,
        1 - math.mat.m3_approx(nm, math.mat.m3_from_m4(squash), 0.001)));
    // A face lying in the XZ plane keeps its +Y normal under a Y squash.
    chk("normal stays perpendicular", math.vec.v3_approx(
        math.vec.v3_normalize(math.mat.m3_mul_v3(nm, math.vec.v3(0.0, 1.0, 0.0))),
        math.vec.v3(0.0, 1.0, 0.0), EPS));

    chk("m4/m3 round trip", math.mat.m3_approx(
        math.mat.m3_from_m4(math.mat.m4_from_m3(mix)), mix, EPS));
}

fn main() as i32 {
    test_scalar();
    test_rect();
    test_color();
    test_geom();
    test_curve();
    test_mat3();
    if (fails == 0) { io.printf("geom/scalar/rect/color/curve/mat3: all checks passed\n"); }
    else { io.printf("  geom_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
