// math/curve.cst — easing and splines.
//
// Two different jobs that both take a t and give back a shape. Easing
// functions remap 0..1 to 0..1 and are what an animation reaches for: the
// value still starts where it started and ends where it ended, only the pace
// changes. Splines take control points and give a path through space.
use "std/math.cst" as fm;
use "scalar.cst" as s;
use "vec.cst" as v;

// =======================================================
// Easing — all take and return 0..1, clamped on the way in.
//
// "in" starts slow, "out" ends slow, "in_out" does both. The out variant of
// each is the in variant mirrored through the centre, which is why they read
// as 1 - f(1 - t).
// =======================================================

fn ease_linear(t as f64) as f64 { return s.saturate(t); }

fn ease_in_quad(t as f64) as f64 {
    let is f64 as x = s.saturate(t);
    return x * x;
}

fn ease_out_quad(t as f64) as f64 {
    let is f64 as x = s.saturate(t);
    return 1.0 - (1.0 - x) * (1.0 - x);
}

fn ease_in_out_quad(t as f64) as f64 {
    let is f64 as x = s.saturate(t);
    if (x < 0.5) { return 2.0 * x * x; }
    let is f64 as y = 0.0 - 2.0 * x + 2.0;
    return 1.0 - y * y * 0.5;
}

fn ease_in_cubic(t as f64) as f64 {
    let is f64 as x = s.saturate(t);
    return x * x * x;
}

fn ease_out_cubic(t as f64) as f64 {
    let is f64 as x = 1.0 - s.saturate(t);
    return 1.0 - x * x * x;
}

fn ease_in_out_cubic(t as f64) as f64 {
    let is f64 as x = s.saturate(t);
    if (x < 0.5) { return 4.0 * x * x * x; }
    let is f64 as y = 0.0 - 2.0 * x + 2.0;
    return 1.0 - y * y * y * 0.5;
}

fn ease_in_sine(t as f64) as f64 {
    return 1.0 - fm.cos(s.saturate(t) * fm.PI_2);
}

fn ease_out_sine(t as f64) as f64 {
    return fm.sin(s.saturate(t) * fm.PI_2);
}

fn ease_in_out_sine(t as f64) as f64 {
    return 0.0 - (fm.cos(fm.PI * s.saturate(t)) - 1.0) * 0.5;
}

fn ease_in_expo(t as f64) as f64 {
    let is f64 as x = s.saturate(t);
    if (x == 0.0) { return 0.0; }
    return fm.pow(2.0, 10.0 * x - 10.0);
}

fn ease_out_expo(t as f64) as f64 {
    let is f64 as x = s.saturate(t);
    if (x == 1.0) { return 1.0; }
    return 1.0 - fm.pow(2.0, 0.0 - 10.0 * x);
}

// Overshoots past 1 before settling — the small wind-up that reads as weight.
// Leaves 0..1 on purpose; a caller wanting a strict range should not use it.
fn ease_out_back(t as f64) as f64 {
    let is f64 as c1 = 1.70158;
    let is f64 as c3 = c1 + 1.0;
    let is f64 as x = s.saturate(t) - 1.0;
    return 1.0 + c3 * x * x * x + c1 * x * x;
}

// A decaying oscillation about the target.
fn ease_out_elastic(t as f64) as f64 {
    let is f64 as x = s.saturate(t);
    if (x == 0.0) { return 0.0; }
    if (x == 1.0) { return 1.0; }
    let is f64 as c4 = fm.TAU / 3.0;
    return fm.pow(2.0, 0.0 - 10.0 * x) * fm.sin((x * 10.0 - 0.75) * c4) + 1.0;
}

// Successive bounces, each shorter and lower than the last.
fn ease_out_bounce(t as f64) as f64 {
    let is f64 as n1 = 7.5625;
    let is f64 as d1 = 2.75;
    let is f64 as x with mut = s.saturate(t);
    if (x < 1.0 / d1) { return n1 * x * x; }
    if (x < 2.0 / d1) { x = x - 1.5 / d1; return n1 * x * x + 0.75; }
    if (x < 2.5 / d1) { x = x - 2.25 / d1; return n1 * x * x + 0.9375; }
    x = x - 2.625 / d1;
    return n1 * x * x + 0.984375;
}

fn ease_in_bounce(t as f64) as f64 {
    return 1.0 - ease_out_bounce(1.0 - s.saturate(t));
}

// =======================================================
// Cubic Bezier timing — CSS's cubic-bezier(x1, y1, x2, y2).
//
// The curve runs from (0, 0) to (1, 1), pulled toward (x1, y1) and (x2, y2);
// x is time and y progress, so easing at t is finding where on the curve x
// is t and reading y there. x1 and x2 are kept within 0..1, which keeps x
// rising and that place single; y1 and y2 may leave it, for an overshoot.
// The polynomial's coefficients are kept rather than the points, so each
// sample is three multiply-adds.
// =======================================================

struct CubicBezier {
    ax as f64;
    bx as f64;
    cx as f64;
    ay as f64;
    by as f64;
    cy as f64;
}

fn cubic_bezier(x1 as f64, y1 as f64, x2 as f64, y2 as f64) as CubicBezier {
    let is CubicBezier as b;
    let is f64 as p1 = s.saturate(x1);
    let is f64 as p2 = s.saturate(x2);
    b.cx = 3.0 * p1;
    b.bx = 3.0 * (p2 - p1) - b.cx;
    b.ax = 1.0 - b.cx - b.bx;
    b.cy = 3.0 * y1;
    b.by = 3.0 * (y2 - y1) - b.cy;
    b.ay = 1.0 - b.cy - b.by;
    return b;
}

fn _bez_x(b as *CubicBezier, u as f64) as f64 { return ((b.ax * u + b.bx) * u + b.cx) * u; }
fn _bez_y(b as *CubicBezier, u as f64) as f64 { return ((b.ay * u + b.by) * u + b.cy) * u; }

// The curve's parameter where its x is x, by bisection: x rises with the
// parameter, and 60 halvings reach what an f64 holds. Newton's method would
// take fewer steps, but needs bisection behind it where the slope is too
// shallow to trust (Fluent's decelerate is nearly flat at its end), and an
// animation samples a curve once a frame.
fn _bez_solve(b as *CubicBezier, x as f64) as f64 {
    let is f64 as lo with mut = 0.0;
    let is f64 as hi with mut = 1.0;
    let is i64 as i with mut = 0;
    while (i < 60) {
        let is f64 as u = (lo + hi) * 0.5;
        if (_bez_x(b, u) < x) { lo = u; } else { hi = u; }
        i = i + 1;
    }
    return (lo + hi) * 0.5;
}

// Clamped on the way in like the rest, and exact at both ends: an animation
// ends on its target, not a rounding step short of it.
fn ease_cubic_bezier(b as *CubicBezier, t as f64) as f64 {
    if (t <= 0.0) { return 0.0; }
    if (t >= 1.0) { return 1.0; }
    return _bez_y(b, _bez_solve(b, t));
}

// =======================================================
// Easing by name — for what stores which one: a theme, an animation.
//
// The CSS names are CSS's timing functions; the Fluent ones are Windows 11's
// (WinUI's "fast out, slow in" for what arrives, "slow out, fast in" for what
// leaves, and point to point for what moves). GNOME's animations ease out
// cubically and KDE's mostly in and out quadratically, both already here.
// An id it does not know is linear.
// =======================================================

let is i64 as EASE_LINEAR            with imut = 0;
let is i64 as EASE_IN_QUAD           with imut = 1;
let is i64 as EASE_OUT_QUAD          with imut = 2;
let is i64 as EASE_IN_OUT_QUAD       with imut = 3;
let is i64 as EASE_IN_CUBIC          with imut = 4;
let is i64 as EASE_OUT_CUBIC         with imut = 5;
let is i64 as EASE_IN_OUT_CUBIC      with imut = 6;
let is i64 as EASE_IN_SINE           with imut = 7;
let is i64 as EASE_OUT_SINE          with imut = 8;
let is i64 as EASE_IN_OUT_SINE       with imut = 9;
let is i64 as EASE_IN_EXPO           with imut = 10;
let is i64 as EASE_OUT_EXPO          with imut = 11;
let is i64 as EASE_OUT_BACK          with imut = 12;
let is i64 as EASE_OUT_ELASTIC       with imut = 13;
let is i64 as EASE_OUT_BOUNCE        with imut = 14;
let is i64 as EASE_IN_BOUNCE         with imut = 15;
let is i64 as EASE_CSS               with imut = 16;   // ease: 0.25, 0.1, 0.25, 1
let is i64 as EASE_CSS_IN            with imut = 17;   // 0.42, 0, 1, 1
let is i64 as EASE_CSS_OUT           with imut = 18;   // 0, 0, 0.58, 1
let is i64 as EASE_CSS_IN_OUT        with imut = 19;   // 0.42, 0, 0.58, 1
let is i64 as EASE_FLUENT_DECELERATE with imut = 20;   // 0, 0, 0, 1
let is i64 as EASE_FLUENT_ACCELERATE with imut = 21;   // 1, 0, 1, 1
let is i64 as EASE_FLUENT_POINT      with imut = 22;   // 0.55, 0.55, 0, 1

fn _named_bezier(id as i64, t as f64) as f64 {
    let is CubicBezier as b with mut = cubic_bezier(0.25, 0.1, 0.25, 1.0);
    if (id == EASE_CSS_IN) { b = cubic_bezier(0.42, 0.0, 1.0, 1.0); }
    if (id == EASE_CSS_OUT) { b = cubic_bezier(0.0, 0.0, 0.58, 1.0); }
    if (id == EASE_CSS_IN_OUT) { b = cubic_bezier(0.42, 0.0, 0.58, 1.0); }
    if (id == EASE_FLUENT_DECELERATE) { b = cubic_bezier(0.0, 0.0, 0.0, 1.0); }
    if (id == EASE_FLUENT_ACCELERATE) { b = cubic_bezier(1.0, 0.0, 1.0, 1.0); }
    if (id == EASE_FLUENT_POINT) { b = cubic_bezier(0.55, 0.55, 0.0, 1.0); }
    return ease_cubic_bezier(&b, t);
}

fn ease(id as i64, t as f64) as f64 {
    if (id == EASE_IN_QUAD) { return ease_in_quad(t); }
    if (id == EASE_OUT_QUAD) { return ease_out_quad(t); }
    if (id == EASE_IN_OUT_QUAD) { return ease_in_out_quad(t); }
    if (id == EASE_IN_CUBIC) { return ease_in_cubic(t); }
    if (id == EASE_OUT_CUBIC) { return ease_out_cubic(t); }
    if (id == EASE_IN_OUT_CUBIC) { return ease_in_out_cubic(t); }
    if (id == EASE_IN_SINE) { return ease_in_sine(t); }
    if (id == EASE_OUT_SINE) { return ease_out_sine(t); }
    if (id == EASE_IN_OUT_SINE) { return ease_in_out_sine(t); }
    if (id == EASE_IN_EXPO) { return ease_in_expo(t); }
    if (id == EASE_OUT_EXPO) { return ease_out_expo(t); }
    if (id == EASE_OUT_BACK) { return ease_out_back(t); }
    if (id == EASE_OUT_ELASTIC) { return ease_out_elastic(t); }
    if (id == EASE_OUT_BOUNCE) { return ease_out_bounce(t); }
    if (id == EASE_IN_BOUNCE) { return ease_in_bounce(t); }
    if (id >= EASE_CSS && id <= EASE_FLUENT_POINT) { return _named_bezier(id, t); }
    return ease_linear(t);
}

// =======================================================
// Splines
// =======================================================

// Cubic Bezier through p0 and p3, pulled toward p1 and p2 without passing
// through them. Evaluated by the Bernstein form rather than de Casteljau:
// fewer operations, and the coefficients are visible.
fn bezier3(p0 as v.Vec3, p1 as v.Vec3, p2 as v.Vec3, p3 as v.Vec3, t as f64) as v.Vec3 {
    let is f64 as u = 1.0 - t;
    let is f64 as uu = u * u;
    let is f64 as tt = t * t;
    let is v.Vec3 as r with mut = v.v3_scale(p0, uu * u);
    r = v.v3_add(r, v.v3_scale(p1, 3.0 * uu * t));
    r = v.v3_add(r, v.v3_scale(p2, 3.0 * u * tt));
    r = v.v3_add(r, v.v3_scale(p3, tt * t));
    return r;
}

// The tangent, i.e. the derivative — the direction to orient something moving
// along the curve.
fn bezier3_tangent(p0 as v.Vec3, p1 as v.Vec3, p2 as v.Vec3, p3 as v.Vec3, t as f64) as v.Vec3 {
    let is f64 as u = 1.0 - t;
    let is v.Vec3 as r with mut = v.v3_scale(v.v3_sub(p1, p0), 3.0 * u * u);
    r = v.v3_add(r, v.v3_scale(v.v3_sub(p2, p1), 6.0 * u * t));
    r = v.v3_add(r, v.v3_scale(v.v3_sub(p3, p2), 3.0 * t * t));
    return r;
}

fn bezier2(p0 as v.Vec3, p1 as v.Vec3, p2 as v.Vec3, t as f64) as v.Vec3 {
    let is f64 as u = 1.0 - t;
    let is v.Vec3 as r with mut = v.v3_scale(p0, u * u);
    r = v.v3_add(r, v.v3_scale(p1, 2.0 * u * t));
    r = v.v3_add(r, v.v3_scale(p2, t * t));
    return r;
}

// Catmull-Rom: interpolates p1 to p2, using p0 and p3 only to set the
// tangents. Unlike a Bezier it passes through its control points, which is
// what you want for a path someone placed by hand.
fn catmull_rom(p0 as v.Vec3, p1 as v.Vec3, p2 as v.Vec3, p3 as v.Vec3, t as f64) as v.Vec3 {
    let is f64 as t2 = t * t;
    let is f64 as t3 = t2 * t;
    let is v.Vec3 as r with mut = v.v3_scale(p1, 2.0);
    r = v.v3_add(r, v.v3_scale(v.v3_sub(p2, p0), t));
    r = v.v3_add(r, v.v3_scale(
        v.v3_add(v.v3_sub(v.v3_scale(p0, 2.0), v.v3_scale(p1, 5.0)),
                 v.v3_sub(v.v3_scale(p2, 4.0), p3)), t2));
    r = v.v3_add(r, v.v3_scale(
        v.v3_add(v.v3_sub(v.v3_scale(p1, 3.0), p0),
                 v.v3_sub(p3, v.v3_scale(p2, 3.0))), t3));
    return v.v3_scale(r, 0.5);
}

// Hermite: endpoints with explicit tangents. Catmull-Rom is this with the
// tangents inferred from the neighbours.
fn hermite(p0 as v.Vec3, m0 as v.Vec3, p1 as v.Vec3, m1 as v.Vec3, t as f64) as v.Vec3 {
    let is f64 as t2 = t * t;
    let is f64 as t3 = t2 * t;
    let is v.Vec3 as r with mut = v.v3_scale(p0, 2.0 * t3 - 3.0 * t2 + 1.0);
    r = v.v3_add(r, v.v3_scale(m0, t3 - 2.0 * t2 + t));
    r = v.v3_add(r, v.v3_scale(p1, 0.0 - 2.0 * t3 + 3.0 * t2));
    r = v.v3_add(r, v.v3_scale(m1, t3 - t2));
    return r;
}
