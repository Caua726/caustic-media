// sys/linux_test.cst — Unix sockets and descriptor passing.
use "std/io.cst" as io;
use "std/os/linux.cst" as linux;
use "std/mem.cst" as mem;
use "linux.cst" as sys;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

// A listener on path (or the abstract name), for connect_unix to reach.
fn listen_unix(path as *u8, len as i64, abstract as i32) as i64 {
    let is sys.SockaddrUn as a;
    mem.memzero(cast(*u8, &a), sizeof(sys.SockaddrUn));
    a.family = cast(u16, sys.AF_UNIX);
    let is i64 as at with mut = 0;
    if (abstract == 1) { at = 1; }
    mem.memcpy(cast(*u8, cast(i64, &a.path) + at), path, len);
    let is i64 as alen with mut = 2 + len + 1;
    if (abstract == 1) { alen = 2 + 1 + len; }
    let is i64 as fd = sys.socket(sys.AF_UNIX, sys.SOCK_STREAM, 0);
    if (linux.bind(fd, cast(*u8, &a), alen) < 0) { return 0 - 1; }
    if (linux.listen(fd, 4) < 0) { return 0 - 1; }
    return fd;
}

fn main() as i32 {
    check("a uid", sys.getuid() >= 0);

    // --- A descriptor over a socket pair ---
    let is [2]i32 as pair;
    check("socketpair", sys.socketpair(sys.AF_UNIX, sys.SOCK_STREAM, 0, cast(*i32, &pair)) == 0);
    let is i64 as a = cast(i64, pair[0]);
    let is i64 as b = cast(i64, pair[1]);
    let is i64 as mf = sys.memfd_create("sys_test", 0);
    check("memfd", mf >= 0);
    linux.write(mf, "carried", 7);
    let is [1]i32 as out_fds;
    out_fds[0] = cast(i32, mf);
    check("sent with a descriptor", sys.send_fds(a, "hello", 5, cast(*i32, &out_fds), 1) == 5);
    let is [64]u8 as buf;
    let is [16]i32 as in_fds;
    let is i64 as n with mut = 0;
    let is i64 as got = sys.recv_fds(b, cast(*u8, &buf), 64, cast(*i32, &in_fds), &n, 1);
    check("received the bytes", got == 5 && mem.memcmp(cast(*u8, &buf), "hello", 5) == 0);
    check("received one descriptor", n == 1);
    check("a new descriptor, not the same number", cast(i64, in_fds[0]) != mf && in_fds[0] >= 0);
    // It is the same file: what was written through one reads through the other.
    linux.lseek(cast(i64, in_fds[0]), 0, 0);
    let is [16]u8 as content;
    check("the same file", linux.read(cast(i64, in_fds[0]), cast(*u8, &content), 16) == 7
          && mem.memcmp(cast(*u8, &content), "carried", 7) == 0);
    // Close-on-exec, as asked for: F_GETFD is 1, FD_CLOEXEC 1.
    check("close-on-exec", (linux.fcntl(cast(i64, in_fds[0]), 1, 0) & 1) == 1);
    check("no descriptors without them", sys.send_fds(a, "x", 1, cast(*i32, 0), 0) == 1
          && sys.recv_fds(b, cast(*u8, &buf), 64, cast(*i32, &in_fds), &n, 1) == 1 && n == 0);
    check("too many descriptors", sys.send_fds(a, "x", 1, cast(*i32, &out_fds), 17) < 0);
    check("nothing there, not waiting", sys.recv_fds(b, cast(*u8, &buf), 64, cast(*i32, &in_fds), &n, 0) == 0 - sys.EAGAIN);
    check("not readable yet", sys.wait_readable(b, 0) == 0);
    sys.send_fds(a, "y", 1, cast(*i32, 0), 0);
    check("readable", sys.wait_readable(b, 1000) == 1);
    sys.close(a);
    check("the peer closed", sys.recv_fds(b, cast(*u8, &buf), 64, cast(*i32, &in_fds), &n, 1) == 1
          && sys.recv_fds(b, cast(*u8, &buf), 64, cast(*i32, &in_fds), &n, 1) == 0);
    sys.close(b);
    sys.close(mf);
    sys.close(cast(i64, in_fds[0]));

    // --- Connecting, by path and by abstract name ---
    linux.unlink("/tmp/caustic_sys_test.sock");

    // An event counter: written, readable, read back as the sum; empty,
    // not readable — a wake-up another thread can give.
    let is i64 as ev = sys.eventfd(0, sys.EFD_NONBLOCK | sys.EFD_CLOEXEC);
    check("an event counter", ev >= 0 && (linux.fcntl(ev, 1, 0) & 1) == 1);
    check("nothing yet", sys.wait_readable(ev, 0) == 0);
    check("added to", sys.event_add(ev, 2) == 1 && sys.event_add(ev, 3) == 1);
    check("readable then", sys.wait_readable(ev, 0) == 1);
    check("read: the sum, and empty again", sys.event_take(ev) == 5 && sys.wait_readable(ev, 0) == 0);
    check("empty: nothing taken", sys.event_take(ev) == 0);
    sys.close(ev);
    let is i64 as l1 = listen_unix("/tmp/caustic_sys_test.sock", 26, 0);
    check("a listener on a path", l1 >= 0);
    let is i64 as c1 = sys.connect_unix("/tmp/caustic_sys_test.sock", 26, 0);
    check("connected by path", c1 >= 0);
    let is i64 as s1 = linux.accept(l1, cast(*u8, 0), cast(*u32, 0));
    sys.send_fds(c1, "p", 1, cast(*i32, 0), 0);
    check("and it is that listener", linux.read(s1, cast(*u8, &buf), 1) == 1 && buf[0] == 112);
    let is i64 as l2 = listen_unix("caustic-sys-test-abstract", 25, 1);
    check("a listener on an abstract name", l2 >= 0);
    let is i64 as c2 = sys.connect_unix("caustic-sys-test-abstract", 25, 1);
    check("connected by abstract name", c2 >= 0);
    let is i64 as s2 = linux.accept(l2, cast(*u8, 0), cast(*u32, 0));
    sys.send_fds(c2, "q", 1, cast(*i32, 0), 0);
    check("and it is that listener", linux.read(s2, cast(*u8, &buf), 1) == 1 && buf[0] == 113);
    check("an abstract name is not a path", sys.connect_unix("caustic-sys-test-abstract", 25, 0) < 0);
    check("nobody there", sys.connect_unix("/tmp/caustic_sys_test_none.sock", 31, 0) < 0);
    check("a path too long", sys.connect_unix("/tmp/x", 108, 0) == 0 - 36);
    check("an abstract name too long", sys.connect_unix("x", 107, 1) == 0 - 36);
    check("an empty name", sys.connect_unix("x", 0, 0) == 0 - 36);
    sys.close(c1); sys.close(s1); sys.close(l1);
    sys.close(c2); sys.close(s2); sys.close(l2);
    linux.unlink("/tmp/caustic_sys_test.sock");

    if (fails > 0) {
        io.printf("sys: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("sys: all checks passed\n");
    return 0;
}
