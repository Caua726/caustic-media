// sys/file_test.cst — files and folders by UTF-8 path, the same on Linux and
// on Windows (under Wine in test-win32): written whole and read back, written
// over, folders made, listed with what each entry is, renamed, removed, and
// the current folder said with '/' between its parts.
use "std/io.cst" as io;
use "std/os.cst" as os;
use "std/mem.cst" as mem;
use "file.cst" as file;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn _len(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

let is [512]u8 as root with mut;
let is i64 as root_n with mut = 0;
let is [512]u8 as joined with mut;

// root, '/', rel, into joined.
fn at(rel as *u8) as *u8 {
    let is i64 as k = _len(rel);
    mem.memcpy(cast(*u8, &joined), cast(*u8, &root), root_n);
    joined[root_n] = cast(u8, 47);
    mem.memcpy(cast(*u8, cast(i64, &joined) + root_n + 1), rel, k + 1);
    return cast(*u8, &joined);
}

fn same(a as *u8, an as i64, b as *u8) as i32 {
    return cast(i32, an == _len(b) && mem.memcmp(a, b, an) == 0);
}

fn main() as i32 {
    // The folder the test works in: build/, under the current one.
    let is [512]u8 as here;
    let is i64 as hn = file.cwd(cast(*u8, &here), 512);
    check("the current folder said", hn > 0 && here[hn] == cast(u8, 0));
    let is i64 as i with mut = 0;
    let is i32 as backslash with mut = 0;
    while (i < hn) {
        if (here[i] == cast(u8, 92)) { backslash = 1; }
        i = i + 1;
    }
    check("the current folder with '/' between its parts", backslash == 0);
    if (os.current() == os.OS_LINUX) { check("absolute on Linux", here[0] == cast(u8, 47)); }
    if (os.current() == os.OS_WINDOWS) { check("a drive on Windows", hn >= 3 && here[1] == cast(u8, 58) && here[2] == cast(u8, 47)); }
    check("too small a buffer: nothing", file.cwd(cast(*u8, &here), 2) == 0);

    // An absolute path's top: "/" everywhere, a lettered drive's on Windows.
    check("the top of /: 1", file.root("/usr", 4) == 1 && file.root("/", 1) == 1);
    check("relative: no top", file.root("build/x", 7) == 0 && file.root("", 0) == 0);
    if (os.current() == os.OS_WINDOWS) {
        check("a drive's top: 3", file.root("C:/Users", 8) == 3 && file.root("d:/", 3) == 3 && file.root("C:\\x", 4) == 3);
        check("a drive without its '/': relative to it, no top", file.root("C:x", 3) == 0 && file.root("C:", 2) == 0);
        check("the top of the current drive: 1", file.root("\\x", 2) == 1);
    } else {
        check("Linux: \"C:/\" is a folder named C:", file.root("C:/Users", 8) == 0);
    }
    file.make_dir("build", 0);
    root_n = io.sprintf(cast(*u8, &root), 512, "build/file_test.%d", os.pid());
    check("a folder made", file.make_dir(cast(*u8, &root), 1) == 1);
    check("made again: there already", file.make_dir(cast(*u8, &root), 1) == 1);
    let is file.Info as info;
    check("a folder is a folder", file.stat(cast(*u8, &root), &info) == 1 && info.kind == file.DIR);

    // Written whole, read back; written over with less.
    let is *u8 as name = at("olá.txt");
    check("written", file.write_atomic(name, "first line\nsecond", 17, 0) == 1);
    let is [64]u8 as buf;
    check("read back", file.read(name, cast(*u8, &buf), 64) == 17 && mem.memcmp(cast(*u8, &buf), "first line\nsecond", 17) == 0);
    check("a file is a file, its size", file.stat(name, &info) == 1 && info.kind == file.FILE && info.size == 17);
    check("changed lately (seconds since 1970)", info.mtime > 1700000000);
    check("read into less room: as much as fits", file.read(name, cast(*u8, &buf), 5) == 5 && mem.memcmp(cast(*u8, &buf), "first", 5) == 0);
    check("written over", file.write_atomic(name, "two", 3, 1) == 1);
    check("written over: the new bytes only", file.read(name, cast(*u8, &buf), 64) == 3 && mem.memcmp(cast(*u8, &buf), "two", 3) == 0);
    check("an empty file", file.write_atomic(at("empty"), "", 0, 0) == 1 && file.read(at("empty"), cast(*u8, &buf), 64) == 0);

    check("a missing file read: -1", file.read(at("missing"), cast(*u8, &buf), 64) == 0 - 1);
    check("a missing path: none", file.stat(at("missing"), &info) == 0 && info.kind == file.NONE);
    check("into a missing folder: not written", file.write_atomic(at("no/such"), "x", 1, 0) == 0);

    check("a folder inside", file.make_dir(at("sub"), 0) == 1);
    check("hidden on Linux by its dot", file.write_atomic(at(".dot"), "d", 1, 0) == 1);

    // Listed: the three files and the folder, not "." nor "..", each as it is.
    let is file.Lister as l;
    check("listed", file.open_dir(&l, cast(*u8, &root)) == 1);
    let is [256]u8 as nm;
    let is i32 as seen with mut = 0;
    let is i32 as other with mut = 0;
    let is i64 as k with mut = file.next(&l, cast(*u8, &nm), 256, &info);
    while (k >= 0) {
        if (same(cast(*u8, &nm), k, "olá.txt") == 1 && info.kind == file.FILE && info.size == 3) {
            seen = seen | 1;
        } else if (same(cast(*u8, &nm), k, "empty") == 1 && info.kind == file.FILE && info.size == 0) {
            seen = seen | 2;
        } else if (same(cast(*u8, &nm), k, "sub") == 1 && info.kind == file.DIR) {
            seen = seen | 4;
        } else if (same(cast(*u8, &nm), k, ".dot") == 1 && info.kind == file.FILE) {
            seen = seen | 8;
        } else {
            other = other + 1;
        }
        check("the name NUL-ended", nm[k] == cast(u8, 0));
        k = file.next(&l, cast(*u8, &nm), 256, &info);
    }
    file.close_dir(&l);
    check("listed: olá.txt, empty, sub, .dot, each as it is", seen == 15);
    check("listed: nothing else (no . or ..)", other == 0);
    check("a missing folder not listed", file.open_dir(&l, at("missing")) == 0);

    // Renamed over another; removed.
    // at() says its path in one buffer: the first copied before the second.
    let is [512]u8 as from;
    let is *u8 as e = at("empty");
    mem.memcpy(cast(*u8, &from), e, _len(e) + 1);
    check("renamed over another", file.rename(cast(*u8, &from), at("olá.txt")) == 1);
    check("renamed: the old name gone", file.stat(at("empty"), &info) == 0);
    check("renamed: the bytes under the new", file.read(at("olá.txt"), cast(*u8, &buf), 64) == 0);
    check("a file removed", file.remove(at("olá.txt")) == 1 && file.stat(at("olá.txt"), &info) == 0);
    check("a missing file not removed", file.remove(at("olá.txt")) == 0);
    file.remove(at(".dot"));
    check("an empty folder removed", file.remove(at("sub")) == 1);
    check("the test's folder removed", file.remove(cast(*u8, &root)) == 1);

    if (fails != 0) {
        io.printf("file: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("file: all checks passed\n");
    return 0;
}
