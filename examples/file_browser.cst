// examples/file_browser.cst — a file browser, on the toolkit.
//
//   caustic -q examples/file_browser.cst -o build/file_browser --path .caustic/deps
//   ./build/file_browser [folder]
//   sh window/x11/tools/run_headless.sh ./build/file_browser --check
//   sh window/x11/tools/run_headless.sh env WESTON_BACKEND=x11 \
//       sh window/wayland/tools/run_wayland.sh ./build/file_browser --check
//   sh tools/run_wine_desktop.sh build/file_browser.exe --check
//
// Folders on one side as a tree, opened as they are asked for; the folder
// chosen on the other as a table — name, size, when it changed; above them,
// buttons and the path, which can be typed. What it shows:
//
//   - a tree model of the program's own, its branches read only when opened
//     (model.cst's tree entries, flatten.cst through treeview);
//   - a table over a folder (dirmodel.cst), its rows activated to go in or
//     to open a file in the desktop's program for it (open_uri.cst);
//   - a splitter between them, a toolbar, an entry, a status bar;
//   - menus with a check item (hidden files shown or not) and the window's
//     shortcuts: Alt+Up, Ctrl+L, Ctrl+H;
//   - a message box when a folder cannot be read, the about dialog;
//   - its rows dragged out as files, for a file manager to take, the row or
//     all that are selected with it; files dragged in from one copied here.
//
// --check drives it over a folder made in build/, the file it opens handed
// to a stand-in xdg-open (ui/testdata/bin, first on the path) — on Windows
// to the shell, the program it opens in closed again.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/os.cst" as os;
use "../sys/file.cst" as file;
use "../window/folders.cst" as folders;
use "../window/event.cst" as wevent;
use "../input/keys.cst" as keys;
use "../math/math.cst" as math;
use "../window/device.cst" as device;
use "../ui/ui.cst" as ui;
use "user_input.cst" as xin;

let is *u8 as NAME with imut = "Files";

// The menus' items.
let is i64 as OPEN_ITEM with imut = 1;
let is i64 as QUIT      with imut = 2;
let is i64 as UP        with imut = 3;
let is i64 as HOME      with imut = 4;
let is i64 as HIDDEN    with imut = 5;
let is i64 as ABOUT     with imut = 6;

// --- The folders, as a tree model of the program's own ---
//
// A node a folder: its path in the pool, its parent, and its children —
// read when it is first opened, made nodes one after another, so a child's
// place among them is its id less the first's.

let is i64 as MAX_NODES with imut = 16384;
let is i64 as POOL      with imut = 4194304;

struct Node {
    off    as i64;   // its path in the pool
    len    as i64;
    parent as i64;   // 0 for the root
    first  as i64;   // its first child's id
    n      as i64;   // how many children
    loaded as i32;   // its children read
    _pad   as i32;
}

struct Folders {
    nodes as *Node;   // ids from 1
    count as i64;
    pool  as *u8;
    used  as i64;
    m     as ui.model.Model;
}

let is Folders as fo with mut;

fn _node(id as i64) as *Node { return cast(*Node, cast(i64, fo.nodes) + id * sizeof(Node)); }

fn _same(a as *u8, n as i64, b as *u8) as i32 {
    if (n != ui.len(b)) { return 0; }
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

// A node for the folder at p (n bytes) under parent: its id, 0 with no room.
fn _new_node(parent as i64, p as *u8, n as i64) as i64 {
    if (fo.count + 1 >= MAX_NODES || fo.used + n > POOL) { return 0; }
    fo.count = fo.count + 1;
    let is *Node as d = _node(fo.count);
    mem.memcpy(cast(*u8, cast(i64, fo.pool) + fo.used), p, n);
    d.off = fo.used;
    d.len = n;
    fo.used = fo.used + n;
    d.parent = parent;
    d.first = 0;
    d.n = 0;
    d.loaded = 0;
    return fo.count;
}

fn _path_of(id as i64) as *u8 { return cast(*u8, cast(i64, fo.pool) + _node(id).off); }

// A folder's children read, its folders alone, hidden ones too.
fn _load(id as i64) as void {
    let is *Node as d = _node(id);
    if (d.loaded == 1) { return; }
    d.loaded = 1;
    let is *ui.dirmodel.Dir as dir = ui.dirmodel.open(_path_of(id), d.len);
    if (cast(i64, dir) == 0) { return; }
    ui.dirmodel.set_folders_only(dir, 1);
    ui.dirmodel.reload(dir);
    let is i64 as k with mut = 0;
    while (k < ui.dirmodel.count(dir)) {
        let is [4096]u8 as p;
        let is i64 as pn = ui.dirmodel.full_path(dir, k, cast(*u8, &p), 4096);
        let is i64 as c = _new_node(id, cast(*u8, &p), pn);
        if (c == 0) { k = ui.dirmodel.count(dir); } else {
            if (_node(id).n == 0) { _node(id).first = c; }
            _node(id).n = _node(id).n + 1;
            k = k + 1;
        }
    }
    ui.dirmodel.close(dir);
}

fn f_count(self as *u8, parent as i64) as i64 {
    if (parent == 0) { return cast(i64, fo.count > 0); }
    if (parent < 1 || parent > fo.count) { return 0; }
    _load(parent);
    return _node(parent).n;
}

fn f_row_id(self as *u8, parent as i64, index as i64) as i64 {
    if (parent == 0) {
        if (index == 0 && fo.count > 0) { return 1; }
        return 0;
    }
    if (parent > fo.count || index < 0 || index >= f_count(self, parent)) { return 0; }
    return _node(parent).first + index;
}

fn f_cell(self as *u8, id as i64, column as i64, role as i32, out as *ui.model.Value) as i64 {
    if (id < 1 || id > fo.count || column != 0 || role != ui.model.TEXT) { return 0; }
    let is *Node as d = _node(id);
    let is *u8 as p = _path_of(id);
    if (d.parent == 0) {
        *out = ui.model.text(p, d.len);
        return 1;
    }
    // Its own name: the path's last part.
    let is i64 as k with mut = d.len;
    while (k > 0 && p[k - 1] != 47) { k = k - 1; }
    *out = ui.model.text(cast(*u8, cast(i64, p) + k), d.len - k);
    return 1;
}

fn f_parent_of(self as *u8, id as i64) as i64 {
    if (id < 1 || id > fo.count) { return 0; }
    return _node(id).parent;
}

fn f_index_of(self as *u8, id as i64) as i64 {
    if (id < 1 || id > fo.count) { return 0 - 1; }
    let is i64 as parent = _node(id).parent;
    if (parent == 0) { return 0; }
    return id - _node(parent).first;
}

// Whether it may have children: yes until they are read.
fn f_has_children(self as *u8, id as i64) as i64 {
    if (id < 1 || id > fo.count) { return 0; }
    if (_node(id).loaded == 0) { return 1; }
    return cast(i64, _node(id).n > 0);
}

// --- The window ---

struct Browser {
    a       as *ui.app.App;
    hs      as *ui.host.Host;
    win     as i64;
    t       as *ui.tree.Tree;
    r       as *ui.router.Router;
    dir     as *ui.dirmodel.Dir;
    folders as i64;   // the tree view
    table   as i64;
    list    as i64;   // the table's list
    path    as i64;   // the entry
    status  as i64;
    hidden_item as i64;
    hidden  as i32;
    _pad    as i32;
    problem as ui.dialog.Ref;
    about   as ui.dialog.Ref;
    opened  as i64;   // files handed to the desktop
}

let is ui.program.Program as prog with mut;
let is Browser as br with mut;
let is ui.open_uri.Request as link with mut;

fn _digits(v as i64, to as *u8) as i64 {
    let is [24]u8 as r;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    if (x <= 0) {
        r[0] = cast(u8, 48);
        n = 1;
    }
    while (x > 0) {
        r[n] = cast(u8, 48 + x % 10);
        x = x / 10;
        n = n + 1;
    }
    let is i64 as k with mut = 0;
    while (k < n) {
        to[k] = r[n - 1 - k];
        k = k + 1;
    }
    return n;
}

// What is shown of the folder: its path in the entry and the title, how many
// in the status bar.
fn _shown() as void {
    let is *u8 as p = ui.dirmodel.path(br.dir);
    let is i64 as n = ui.dirmodel.path_length(br.dir);
    ui.entry.set_text(br.t, br.path, p, n);
    let is [512]u8 as title;
    let is i64 as k with mut = n;
    while (k > 1 && p[k - 1] != 47) { k = k - 1; }
    let is i64 as m with mut = n - k;
    if (m <= 0) {
        k = 0;
        m = n;
    }
    if (m > 400) { m = 400; }
    mem.memcpy(cast(*u8, &title), cast(*u8, cast(i64, p) + k), m);
    mem.memcpy(cast(*u8, cast(i64, &title) + m), " \xe2\x80\x94 Files", 10);
    ui.app.set_title(br.a, br.win, cast(*u8, &title), m + 10);
    let is [64]u8 as s;
    let is i64 as c = ui.dirmodel.count(br.dir);
    let is i64 as sn with mut = _digits(c, cast(*u8, &s));
    if (c == 1) {
        mem.memcpy(cast(*u8, cast(i64, &s) + sn), " item", 5);
        sn = sn + 5;
    } else {
        mem.memcpy(cast(*u8, cast(i64, &s) + sn), " items", 6);
        sn = sn + 6;
    }
    ui.statusbar.pop(br.t, br.status, 1);
    ui.statusbar.push(br.t, br.status, 1, cast(*u8, &s), sn);
}

fn tell(title as *u8, say as *u8) as void {
    if (ui.dialog.ref_valid(&br.problem) == 1) { ui.dialog.dispose(&br.problem); }
    let is *ui.tree.Tree as dt = ui.dialog.window_tree(br.t);
    let is i64 as w = ui.dialog.message(dt, ui.dialog.ERROR, title, ui.len(title), say, ui.len(say), ui.dialog.OK_ONLY);
    br.problem = ui.dialog.ref(dt, w);
    ui.dialog.show(dt, ui.router.of(dt), w, 1);
}

// The folder at p (n bytes) shown: 1, or 0 — told so — when it cannot be read.
fn go(p as *u8, n as i64) as i32 {
    let is [4097]u8 as z;
    if (n <= 0 || n > 4096) { return 0; }
    mem.memcpy(cast(*u8, &z), p, n);
    z[n] = cast(u8, 0);
    let is file.Lister as l;
    if (file.open_dir(&l, cast(*u8, &z)) == 0) {
        tell("This folder cannot be opened", "It is not there, or it is not yours to read.");
        _shown();
        return 0;
    }
    file.close_dir(&l);
    if (ui.dirmodel.set_path(br.dir, p, n) == 0) { return 0; }
    _shown();
    return 1;
}

fn up() as void {
    if (ui.dirmodel.up(br.dir) == 1) { _shown(); }
}

// Home's path into out (4096 bytes): HOME, or on Windows the profile; its
// length, 0 for none.
fn home_path(out as *u8) as i64 {
    if (os.current() == os.OS_WINDOWS) { return folders.path(folders.PROFILE, out, 4096); }
    let is *u8 as h = env.getenv("HOME");
    if (cast(i64, h) == 0) { return 0; }
    let is i64 as n with mut = ui.len(h);
    if (n > 4095) { n = 4095; }
    mem.memcpy(out, h, n);
    return n;
}

fn home() as void {
    let is [4096]u8 as h;
    let is i64 as n = home_path(cast(*u8, &h));
    if (n > 0) { go(cast(*u8, &h), n); }
}

fn set_hidden(on as i32) as void {
    br.hidden = on;
    ui.dirmodel.set_hidden(br.dir, on);
    ui.dirmodel.reload(br.dir);
    ui.menu.set_checked(br.t, br.hidden_item, on);
    _shown();
}

// Row i of the table: a folder gone into; a file opened by the desktop.
fn activate(i as i64) as void {
    if (i < 0 || i >= ui.dirmodel.count(br.dir)) { return; }
    let is [4096]u8 as p;
    let is i64 as n = ui.dirmodel.full_path(br.dir, i, cast(*u8, &p), 4096);
    if (ui.dirmodel.is_dir(br.dir, i) == 1) {
        go(cast(*u8, &p), n);
        return;
    }
    // As a file link, its bytes escaped where a URI needs them; a drive's
    // path (Windows: "C:/…") after one more '/', "file:///C:/…".
    let is [8200]u8 as uri;
    mem.memcpy(cast(*u8, &uri), "file://", 7);
    let is i64 as k with mut = 7;
    if (n > 0 && p[0] != 47) {
        uri[7] = cast(u8, 47);
        k = 8;
    }
    let is *u8 as hex = "0123456789ABCDEF";
    let is i64 as j with mut = 0;
    while (j < n) {
        let is u8 as c = p[j];
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 47 || c == 45 || c == 46 || c == 95 ||
            c == 126 || c == 58) {
            uri[k] = c;
            k = k + 1;
        } else {
            uri[k] = cast(u8, 37);
            uri[k + 1] = hex[cast(i64, c) / 16];
            uri[k + 2] = hex[cast(i64, c) % 16];
            k = k + 3;
        }
        j = j + 1;
    }
    // The desktop puts what it shows above the browser's window.
    let is [200]u8 as parent;
    let is i64 as pn = ui.host.parent_handle(br.hs, br.win, &parent[0], 200);
    if (ui.open_uri.open(&link, ui.program.conn(&prog), cast(*u8, &uri), k, &parent[0], pn) == 1) { br.opened = br.opened + 1; }
}

fn _row_activated(t as *ui.tree.Tree, l as i64, arg as *u8, user as *u8) as void { activate(ui.listview.cursor(t, l)); }

// --- Dragged out, dragged in ---

let is i64 as DRAG_PATHS with imut = 262144;
let is [262144]u8 as drag_paths with mut;

// What a row dragged out is: its file, and those of the others selected when
// it is one of them.
fn _row_files(t as *ui.tree.Tree, l as i64, row as i64, c as *ui.clip.Content, user as *u8) as i32 {
    let is i32 as many = ui.listview.is_selected(t, l, row);
    let is i64 as at with mut = 0;
    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    while (i < ui.dirmodel.count(br.dir)) {
        if (i == row || (many == 1 && ui.listview.is_selected(t, l, i) == 1)) {
            if (DRAG_PATHS - at < 4097) { break; }
            let is i64 as k = ui.dirmodel.full_path(br.dir, i, &drag_paths[at], 4096);
            if (k > 0) {
                drag_paths[at + k] = cast(u8, 0);
                at = at + k + 1;
                n = n + 1;
            }
        }
        i = i + 1;
    }
    if (n == 0) { return 0; }
    return ui.clip.add_files(c, &drag_paths[0], n);
}

// The file at from copied into the folder shown, by its name: 1 when it was.
// A folder, or a file already here, stays where it is.
fn _copy_in(from as *u8) as i32 {
    let is file.Info as info;
    if (file.stat(from, &info) == 0 || info.kind != file.FILE) { return 0; }
    let is i64 as n = ui.len(from);
    let is i64 as base with mut = n;
    while (base > 0 && from[base - 1] != 47 && from[base - 1] != 92) { base = base - 1; }
    let is [4096]u8 as to;
    let is i64 as dn = ui.dirmodel.path_length(br.dir);
    if (dn + 1 + n - base >= 4096) { return 0; }
    mem.memcpy(&to[0], ui.dirmodel.path(br.dir), dn);
    to[dn] = cast(u8, 47);
    mem.memcpy(&to[dn + 1], cast(*u8, cast(i64, from) + base), n - base);
    let is i64 as tn = dn + 1 + n - base;
    to[tn] = cast(u8, 0);
    if (tn == n && mem.memcmp(&to[0], from, n) == 0) { return 0; }
    let is i64 as cap = info.size + 1;
    let is *u8 as buf = mem.core.mmap_anon(cap);
    if (cast(i64, buf) == 0) { return 0; }
    let is i64 as got = file.read(from, buf, cap);
    let is i32 as ok with mut = 0;
    if (got >= 0) { ok = file.write_atomic(&to[0], buf, got, 0); }
    mem.core.munmap(buf, cap);
    return ok;
}

// Files let go over the table: copied here, and shown.
fn _files_dropped(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    let is *ui.dnd.Payload as p = cast(*ui.dnd.Payload, arg);
    let is i64 as copied with mut = 0;
    let is i64 as i with mut = 0;
    while (i < p.files_n) {
        copied = copied + cast(i64, _copy_in(ui.dnd.file_at(p, i)));
        i = i + 1;
    }
    if (copied > 0) {
        ui.dirmodel.reload(br.dir);
        _shown();
    }
}

// A folder chosen in the tree: shown in the table.
fn _folder_chosen(t as *ui.tree.Tree, l as i64, arg as *u8, user as *u8) as void {
    let is i64 as i = ui.listview.cursor(t, l);
    if (i < 0) { return; }
    let is *ui.flatten.Flat as f = ui.treeview.flat(t, br.folders);
    let is i64 as id = ui.model.row_id(ui.flatten.model_of(f), 0, i);
    if (id < 1 || id > fo.count) { return; }
    go(_path_of(id), _node(id).len);
}

fn _path_typed(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    go(ui.entry.text(t, br.path), ui.entry.length(t, br.path));
}

fn show_about() as void {
    if (ui.dialog.ref_valid(&br.about) == 0) {
        let is *ui.tree.Tree as dt = ui.dialog.window_tree(br.t);
        let is i64 as ab = ui.about.create(dt, NAME, 5);
        ui.about.set_version(dt, ab, "1.0", 3);
        ui.about.set_comments(dt, ab, "Folders and files, on the caustic-media toolkit.", 48);
        br.about = ui.dialog.ref(dt, ab);
    }
    ui.dialog.show(br.about.t, ui.router.of(br.about.t), br.about.w, 0);
}

fn act(id as i64) as void {
    if (id == OPEN_ITEM) { activate(ui.listview.cursor(br.t, br.list)); }
    if (id == QUIT) { ui.app.window_close(br.a, br.win); }
    if (id == UP) { up(); }
    if (id == HOME) { home(); }
    if (id == HIDDEN) { set_hidden(1 - br.hidden); }
    if (id == ABOUT) { show_about(); }
}

fn _menu_chosen(t as *ui.tree.Tree, m as i64, arg as *u8, user as *u8) as void {
    let is i64 as id = *cast(*i64, arg);
    // The check item turned over already: shown as it now says.
    if (id == HIDDEN) {
        set_hidden(ui.menu.checked(t, br.hidden_item));
        return;
    }
    act(id);
}

fn _up_clicked(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void { up(); }
fn _home_clicked(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void { home(); }
fn _key_up(user as *u8) as void { up(); }
fn _key_hidden(user as *u8) as void { set_hidden(1 - br.hidden); }
fn _key_location(user as *u8) as void {
    ui.router.focus(br.t, br.r, br.path, 1);
}
fn _key_quit(user as *u8) as void { act(QUIT); }

fn _item(m as i64, s as *u8, id as i64, k as i32, mods as i32) as i64 {
    let is i64 as it = ui.menu_item(br.t, m, s, id);
    if (k != 0) { ui.menu.set_accel(br.t, it, k, mods); }
    return it;
}

fn build(start as *u8, n as i64) as void {
    let is *ui.tree.Tree as t = br.t;
    let is i64 as col = ui.box.create(t, ui.tree.root(t), ui.box.COLUMN);
    let is i64 as bar = ui.menubar.create(t, col);
    let is i64 as file_m = ui.menu.create(t);
    _item(file_m, "_Open", OPEN_ITEM, 0, 0);
    ui.menu.add_separator(t, file_m);
    _item(file_m, "_Quit", QUIT, keys.Q, keys.MOD_CONTROL);
    let is i64 as view_m = ui.menu.create(t);
    _item(view_m, "_Up", UP, keys.UP, keys.MOD_ALT);
    _item(view_m, "_Home", HOME, keys.HOME, keys.MOD_ALT);
    ui.menu.add_separator(t, view_m);
    br.hidden_item = ui.menu_check(t, view_m, "Show _hidden files", HIDDEN, 0);
    ui.menu.set_accel(t, br.hidden_item, keys.H, keys.MOD_CONTROL);
    let is i64 as help_m = ui.menu.create(t);
    _item(help_m, "_About", ABOUT, 0, 0);
    ui.menu_title(t, bar, "_File", file_m);
    ui.menu_title(t, bar, "_View", view_m);
    ui.menu_title(t, bar, "_Help", help_m);
    ui.menubar.bind(t, br.r, bar);
    ui.on(t, file_m, ui.signal.ACTIVATED, fn_ptr(_menu_chosen));
    ui.on(t, view_m, ui.signal.ACTIVATED, fn_ptr(_menu_chosen));
    ui.on(t, help_m, ui.signal.ACTIVATED, fn_ptr(_menu_chosen));

    let is i64 as tools = ui.box.create(t, col, ui.box.ROW);
    ui.box.set_spacing(t, tools, 6.0);
    ui.layout.set_margin(t, tools, 6.0, 4.0, 6.0, 4.0);
    let is i64 as tb = ui.toolbar.create(t, tools);
    let is i64 as up_b = ui.tool_button(t, tb, "Up");
    let is i64 as home_b = ui.tool_button(t, tb, "Home");
    ui.on(t, up_b, ui.signal.CLICKED, fn_ptr(_up_clicked));
    ui.on(t, home_b, ui.signal.CLICKED, fn_ptr(_home_clicked));
    br.path = ui.entry.create(t, tools);
    ui.layout.set_stretch(t, br.path, 1.0, 0.0);
    ui.on(t, br.path, ui.signal.ACTIVATED, fn_ptr(_path_typed));

    let is i64 as split = ui.splitter.create(t, col, ui.splitter.ROW);
    ui.layout.set_stretch(t, split, 1.0, 1.0);
    fo.m = ui.model.make(cast(*u8, 0), fn_ptr(f_count), fn_ptr(f_row_id), fn_ptr(f_cell));
    fo.m.parent_of = fn_ptr(f_parent_of);
    fo.m.index_of = fn_ptr(f_index_of);
    fo.m.has_children = fn_ptr(f_has_children);
    _new_node(0, start, n);
    br.folders = ui.treeview.create(t, split, &fo.m);
    ui.layout.set_min_size(t, br.folders, 180.0, 0.0);
    let is i64 as tl = ui.treeview.list(t, br.folders);
    ui.listview.set_single_click(t, tl, 1);
    ui.on(t, tl, ui.signal.ACTIVATED, fn_ptr(_folder_chosen));
    br.table = ui.tableview.create(t, split, ui.dirmodel.model_of(br.dir));
    ui.column(t, br.table, "Name", 260.0);
    ui.column(t, br.table, "Size", 90.0);
    ui.column(t, br.table, "Modified", 150.0);
    br.list = ui.tableview.list(t, br.table);
    ui.on(t, br.list, ui.signal.ACTIVATED, fn_ptr(_row_activated));
    // Its rows go out as files; files come in on it.
    ui.tableview.set_drag_content(t, br.table, fn_ptr(_row_files), ui.dnd.COPY, cast(*u8, 0));
    ui.router.add_drop_target(br.r, br.table, ui.dnd.FILES);
    ui.on(t, br.table, ui.signal.DROPPED, fn_ptr(_files_dropped));
    ui.splitter.set_position(t, split, 0, 200.0);

    br.status = ui.statusbar.create(t, col);
    ui.router.add_shortcut(br.r, keys.UP, keys.MOD_ALT, fn_ptr(_key_up), cast(*u8, 0));
    ui.router.add_shortcut(br.r, keys.H, keys.MOD_CONTROL, fn_ptr(_key_hidden), cast(*u8, 0));
    ui.router.add_shortcut(br.r, keys.L, keys.MOD_CONTROL, fn_ptr(_key_location), cast(*u8, 0));
    ui.router.add_shortcut(br.r, keys.Q, keys.MOD_CONTROL, fn_ptr(_key_quit), cast(*u8, 0));
    ui.router.focus(t, br.r, br.list, 0);
}

// --- Driven, as a user would ---

let is i32 as fails with mut = 0;

fn expect(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

fn rounds(n as i64) as void {
    let is i64 as k with mut = 0;
    while (k < n) {
        ui.host.step(br.hs, 20);
        k = k + 1;
    }
}

// Keys as a user's come: sent through the system to the window (user_input.cst), read
// back the whole way.
let is xin.Sender as xs with mut;

fn key(k as i32, mods as i32) as void {
    xin.key(&xs, cast(i64, k), mods);
    rounds(1);
}

fn type_in(s as *u8) as void {
    xin.type_text(&xs, s);
    rounds(1);
}

fn ends_with(s as *u8, n as i64, tail as *u8) as i32 {
    let is i64 as k = ui.len(tail);
    if (n < k) { return 0; }
    return cast(i32, mem.memcmp(cast(*u8, cast(i64, s) + n - k), tail, k) == 0);
}

fn at_folder(tail as *u8) as i32 { return ends_with(ui.dirmodel.path(br.dir), ui.dirmodel.path_length(br.dir), tail); }

fn status_is(s as *u8) as i32 { return _same(ui.statusbar.message(br.t, br.status), ui.statusbar.message_length(br.t, br.status), s); }

// The row named s in the table, -1 for none.
fn row_named(s as *u8) as i64 { return ui.dirmodel.index_of_name(br.dir, s, ui.len(s)); }

fn mk(p as *u8) as void { file.make_dir(p, 0); }

fn touch(p as *u8) as void { file.write_atomic(p, "", 0, 0); }

// What the desktop was handed ends as the file's link should: the stand-in
// xdg-open's record of it; on Windows, where the shell opened it, the link
// itself. 1, 0 when not as it should, -1 when nothing was said.
fn opened_said() as i64 {
    if (os.current() == os.OS_WINDOWS) {
        if (ui.open_uri.how(&link) != ui.open_uri.SHELL) { return 0 - 1; }
        return cast(i64, ends_with(cast(*u8, &link.uri), link.n, "/browser_check/b%20c.txt"));
    }
    let is *u8 as path = env.getenv("CAUSTIC_XDG_OPEN_OUT");
    if (cast(i64, path) == 0) { return 0 - 1; }
    let is i64 as until = time.now_ms() + 2000;
    let is [512]u8 as b;
    let is i64 as n with mut = 0 - 1;
    while (n < 0 && time.now_ms() < until) {
        n = file.read(path, cast(*u8, &b), 512);
        if (n < 0) { rounds(1); }
    }
    if (n <= 0) { return 0 - 1; }
    return cast(i64, ends_with(cast(*u8, &b), n, "/browser_check/b%20c.txt"));
}

// The lowest edge of what is up in a popup of its own, window coordinates;
// -1 for none up.
fn _popup_bottom(t as *ui.tree.Tree) as f64 {
    let is f64 as most with mut = 0.0 - 1.0;
    let is i64 as s with mut = 0;
    while (s < ui.tree.MAX_SURFACES) {
        if (ui.tree.surface_widget(t, s) != 0) {
            let is math.rect.Rect as r = ui.tree.surface_rect(t, s);
            if (r.y + r.h > most) { most = r.y + r.h; }
        }
        s = s + 1;
    }
    return most;
}

// On Wayland: whether the window has the pointer, and where (physical
// pixels), the loop run a little first — what locate asks.
fn _heard(user as *u8, px as *i64, py as *i64) as i32 {
    rounds(1);
    let is *ui.router.Router as hr = ui.app.router(br.a, br.win);
    if (hr.pointer_in == 0) { return 0; }
    let is f64 as hsc = ui.app.scale(br.a, br.win);
    *px = cast(i64, hr.pointer_x * hsc + 0.5);
    *py = cast(i64, hr.pointer_y * hsc + 0.5);
    return 1;
}

// A window made small — no smaller than its content lets it, as a window
// manager keeps it — and the menu of a field low in it opened by the right
// button: in a popup of its own, past the window's bottom; Escape closes it.
fn small_window_menu(field as i64) as void {
    let is *device.Window as nw = ui.host.native(br.hs, br.win);
    let is i64 as was_w = device.width(nw);
    let is i64 as was_h = device.height(nw);
    let is f64 as sc = ui.app.scale(br.a, br.win);
    let is ui.geom.Size as least;
    ui.layout.min_size(br.t, &least);
    let is i64 as sw with mut = cast(i64, 420.0 * sc);
    let is i64 as sh with mut = cast(i64, 150.0 * sc);
    if (sw < cast(i64, least.min_w * sc) + 1) { sw = cast(i64, least.min_w * sc) + 1; }
    if (sh < cast(i64, least.min_h * sc) + 1) { sh = cast(i64, least.min_h * sc) + 1; }
    device.set_size(nw, sw, sh);
    rounds(6);
    let is math.rect.Rect as fr = ui.layout.window_rect(br.t, field);
    let is i64 as x = cast(i64, (fr.x + 8.0) * sc);
    let is f64 as down with mut = fr.h / 2.0;
    if (down > 12.0) { down = 12.0; }
    let is i64 as y = cast(i64, (fr.y + down) * sc);
    xin.move(&xs, x, y);
    xin.button(&xs, cast(u32, 3), x, y, 0);
    rounds(4);
    expect("a small window: a field's menu in a popup of its own, past the window's bottom",
           _popup_bottom(br.t) > ui.app.height(br.a, br.win));
    xin.key(&xs, cast(i64, keys.ESCAPE), 0);
    rounds(3);
    expect("closed by Escape: no popup up", _popup_bottom(br.t) < 0.0);
    device.set_size(nw, was_w, was_h);
    rounds(6);
}

fn drive() as void {
    rounds(6);
    expect("on the screen", ui.host.shown(br.hs) == 1);
    xs = xin.open(ui.host.native(br.hs, br.win));
    expect("its window found to send to", xin.locate(&xs, fn_ptr(_heard), cast(*u8, 0)) == 1);
    expect("the folder: its two, the hidden one not", ui.dirmodel.count(br.dir) == 2 && row_named("a") >= 0 &&
           row_named("b c.txt") >= 0 && row_named(".hidden") < 0);
    expect("said in the status bar, the title its name", status_is("2 items") == 1 &&
           _same(ui.app.title(br.a, br.win), ui.app.title_length(br.a, br.win), "browser_check \xe2\x80\x94 Files") == 1);
    // A folder activated: gone into.
    ui.router.focus(br.t, br.r, br.list, 1);
    ui.listview.set_cursor(br.t, br.list, row_named("a"));
    key(keys.RETURN, 0);
    expect("a folder activated: in it", at_folder("/browser_check/a") == 1 && row_named("inner") >= 0 && status_is("1 item") == 1);
    key(keys.UP, keys.MOD_ALT);
    expect("Alt+Up: back up", at_folder("/browser_check") == 1);
    key(keys.H, keys.MOD_CONTROL);
    expect("Ctrl+H: the hidden one too, the menu's item checked", ui.dirmodel.count(br.dir) == 3 && row_named(".hidden") >= 0 &&
           ui.menu.checked(br.t, br.hidden_item) == 1);
    act(HIDDEN);
    expect("from the menu: hidden again", ui.dirmodel.count(br.dir) == 2 && ui.menu.checked(br.t, br.hidden_item) == 0);
    // The path typed.
    key(keys.L, keys.MOD_CONTROL);
    expect("Ctrl+L: to the path", ui.router.focused(br.t, br.r) == br.path);
    ui.entry.select(br.t, br.path, ui.entry.length(br.t, br.path), ui.entry.length(br.t, br.path));
    type_in("/a/inner");
    key(keys.RETURN, 0);
    expect("a path typed: gone there", at_folder("/browser_check/a/inner") == 1 && status_is("0 items") == 1);
    // A folder that cannot be read: told, and still where it was.
    ui.entry.set_text(br.t, br.path, "/nonexistent-caustic-media-folder", 33);
    ui.router.focus(br.t, br.r, br.path, 1);
    key(keys.RETURN, 0);
    rounds(2);
    expect("not there: told, still where it was", ui.dialog.ref_valid(&br.problem) == 1 &&
           ui.dialog.is_shown(br.problem.t, br.problem.w) == 1 && at_folder("/browser_check/a/inner") == 1);
    ui.dialog.respond(br.problem.t, br.problem.w, ui.dialog.OK);
    rounds(2);
    // The tree: its root, opened, a branch chosen.
    let is *ui.flatten.Flat as f = ui.treeview.flat(br.t, br.folders);
    expect("the tree: its root alone at first", ui.flatten.count(f) == 1);
    ui.treeview.expand(br.t, br.folders, 0);
    rounds(1);
    expect("opened: its folders read, and only those", ui.flatten.count(f) == 2);
    let is i64 as tl = ui.treeview.list(br.t, br.folders);
    ui.listview.set_cursor(br.t, tl, 1);
    ui.signal.emit(br.t, tl, ui.signal.ACTIVATED, cast(*u8, 0));
    rounds(1);
    expect("a branch chosen: shown in the table", at_folder("/browser_check/a") == 1);
    // A file activated: opened by the desktop — here, the stand-in.
    up();
    ui.router.focus(br.t, br.r, br.list, 1);
    ui.listview.set_cursor(br.t, br.list, row_named("b c.txt"));
    key(keys.RETURN, 0);
    expect("a file activated: handed to the desktop as a link, escaped", br.opened == 1 && opened_said() == 1);
    // On Windows the shell opened it in a program of its own, which comes up
    // in front: the user closes it to go back to the browser before typing.
    if (os.current() == os.OS_WINDOWS) {
        let is i64 as until with mut = time.now_ms() + 5000;
        while (xin.in_front(&xs) == 1 && time.now_ms() < until) { rounds(1); }
        xin.close_front(&xs);
        until = time.now_ms() + 5000;
        while (xin.in_front(&xs) == 0 && time.now_ms() < until) { rounds(1); }
        expect("the program it opened in closed: the browser in front again", xin.in_front(&xs) == 1);
    }
    // A row dragged out: its file, as a file manager takes it.
    let is ui.clip.Content as out with mut;
    ui.clip.init(&out);
    let is i64 as dragged = row_named("b c.txt");
    expect("a row dragged out: its file", _row_files(br.t, br.list, dragged, &out, cast(*u8, 0)) == 1 &&
           ui.clip.has(&out, ui.clip.FILES) == 1 && out.offer.count == 1 &&
           ends_with(cast(*u8, &drag_paths), ui.len(cast(*u8, &drag_paths)), "/b c.txt") == 1 &&
           ends_with(out.offer.uris.data, out.offer.uris.len, "/b%20c.txt\r\n") == 1);
    ui.clip.free(&out);
    // A file dragged in from elsewhere: taken over the table, copied here.
    let is [4096]u8 as from;
    let is i64 as fn0 = ui.dirmodel.path_length(br.dir);
    mem.memcpy(&from[0], ui.dirmodel.path(br.dir), fn0);
    mem.memcpy(&from[fn0], "/a/inner/from outside.txt\x00", 26);
    file.write_atomic(&from[0], "dropped", 7, 0);
    let is ui.dnd.Payload as in = ui.dnd.files(&from[0], 1);
    let is math.rect.Rect as tr = ui.layout.window_rect(br.t, br.table);
    let is i32 as over = ui.router.drag_enter(br.t, br.r, &in, tr.x + tr.w / 2.0, tr.y + tr.h / 2.0, time.now_ms());
    expect("files dragged over the table: taken", over == ui.dnd.FILES);
    expect("let go: a copy", ui.router.drag_drop(br.t, br.r, tr.x + tr.w / 2.0, tr.y + tr.h / 2.0, time.now_ms()) == ui.dnd.COPY);
    rounds(2);
    expect("the file copied here, and shown", row_named("from outside.txt") >= 0);
    let is [64]u8 as back;
    let is [4096]u8 as here;
    mem.memcpy(&here[0], ui.dirmodel.path(br.dir), fn0);
    mem.memcpy(&here[fn0], "/from outside.txt\x00", 18);
    expect("what it holds what it held", file.read(&here[0], &back[0], 64) == 7 && mem.memcmp(&back[0], "dropped", 7) == 0);
    file.remove(&here[0]);
    file.remove(&from[0]);
    ui.dirmodel.reload(br.dir);
    rounds(1);
    show_about();
    rounds(2);
    expect("its about dialog", ui.dialog.ref_valid(&br.about) == 1 && ui.dialog.is_shown(br.about.t, br.about.w) == 1);
    ui.dialog.respond(br.about.t, br.about.w, ui.dialog.CLOSE);
    rounds(1);
    small_window_menu(br.path);
    key(keys.Q, keys.MOD_CONTROL);
    rounds(2);
    expect("Ctrl+Q: closed", ui.host.shown(br.hs) == 0);
    xin.close(&xs);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i32 as checking = cast(i32, env.argc() > 1 && _same(env.argv(1), ui.len(env.argv(1)), "--check") == 1);
    if (ui.program.open(&prog, cast(*u8, 0)) == 0) {
        io.printf("file browser: no fonts on this system\n");
        return 1;
    }
    fo.nodes = cast(*Node, mem.core.mmap_anon(MAX_NODES * sizeof(Node)));
    fo.pool = mem.core.mmap_anon(POOL);
    let is [4096]u8 as start;
    let is i64 as sn with mut = 0;
    if (checking == 1) {
        let is *u8 as out = env.getenv("CAUSTIC_XDG_OPEN_OUT");
        if (cast(i64, out) != 0) { file.remove(out); }
        sn = file.cwd(cast(*u8, &start), 3900);
        mem.memcpy(cast(*u8, cast(i64, &start) + sn), "/build/browser_check", 21);
        sn = sn + 20;
        mk(cast(*u8, &start));
        let is [4096]u8 as p;
        mem.memcpy(cast(*u8, &p), cast(*u8, &start), sn);
        mem.memcpy(cast(*u8, cast(i64, &p) + sn), "/a", 3);
        mk(cast(*u8, &p));
        mem.memcpy(cast(*u8, cast(i64, &p) + sn), "/a/inner", 9);
        mk(cast(*u8, &p));
        mem.memcpy(cast(*u8, cast(i64, &p) + sn), "/b c.txt", 9);
        touch(cast(*u8, &p));
        mem.memcpy(cast(*u8, cast(i64, &p) + sn), "/.hidden", 9);
        touch(cast(*u8, &p));
    } else if (env.argc() > 1) {
        sn = ui.len(env.argv(1));
        if (sn > 4000) { sn = 4000; }
        mem.memcpy(cast(*u8, &start), env.argv(1), sn);
    } else {
        sn = home_path(cast(*u8, &start));
        if (sn == 0) {
            start[0] = cast(u8, 47);
            sn = 1;
        }
    }
    br.dir = ui.dirmodel.open(cast(*u8, &start), sn);
    if (cast(i64, br.dir) == 0) {
        io.printf("file browser: no such folder\n");
        ui.program.close(&prog);
        return 1;
    }
    br.a = ui.program.app(&prog);
    br.hs = ui.program.host(&prog);
    br.win = ui.app.window_open(br.a, 800.0, 500.0);
    br.t = ui.app.tree(br.a, br.win);
    br.r = ui.app.router(br.a, br.win);
    ui.dirmodel.set_language(br.dir, ui.tree.language(br.t));
    build(cast(*u8, &start), sn);
    _shown();
    if (checking == 1) {
        drive();
    } else {
        ui.program.run(&prog);
    }
    // The windows first, and the table over the folder with them: then the
    // folder's model they read.
    ui.program.close(&prog);
    ui.dirmodel.close(br.dir);
    if (checking == 0) { return 0; }
    if (fails == 0) {
        io.printf("file browser: all checks passed\n");
        return 0;
    }
    io.printf("file browser: %d failures\n", fails);
    return 1;
}
