// examples/audio_tone.cst — generates and plays a pure 440 Hz (Concert A) sine wave tone.
//
// Direct Linux ALSA PCM playback over kernel ioctls — no external C libraries.
//
// Usage:
//   ./build/audio_tone           # plays 1.0s tone
//   ./build/audio_tone --check   # runs brief headless/audio test and exits

use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/math.cst" as fm;
use "std/mem.cst" as mem;
use "../audio/audio.cst" as audio;
use "../audio/convert.cst" as conv;

fn main(argc as i64, argv as **u8) as i32 {
    env.init(argc, argv);
    let is i32 as check_only with mut = 0;
    if (env.argc() > 1) {
        let is *u8 as arg = env.argv(1);
        if (arg[0] == 45 && arg[1] == 45 && arg[2] == 99 && arg[3] == 104) {
            check_only = 1;
        }
    }

    let is audio.device.Config as cfg = audio.config_default();
    let is audio.device.Device as dev = audio.open(&cfg);

    if (audio.is_open(&dev) == 0) {
        if (check_only == 1) {
            io.printf("audio_tone: no physical audio output found (skipped)\n");
            return 0;
        }
        io.printf("audio_tone: could not open ALSA playback device\n");
        return 1;
    }

    let is i32 as rate = dev.sample_rate;
    let is f64 as duration with mut = 1.0;
    if (check_only == 1) {
        duration = 0.1;
    }

    let is i64 as total_frames = cast(i64, cast(f64, rate) * duration);
    let is i64 as chunk_frames = 512;
    let is i64 as channels = cast(i64, dev.channels);
    let is [1024]i16 as pcm_buf;

    let is f64 as freq = 440.0; // Concert A
    let is f64 as two_pi = 6.283185307179586;

    let is i64 as frame_idx with mut = 0;
    while (frame_idx < total_frames) {
        let is i64 as frames_this_chunk with mut = chunk_frames;
        if (frame_idx + frames_this_chunk > total_frames) {
            frames_this_chunk = total_frames - frame_idx;
        }

        let is i64 as i with mut = 0;
        while (i < frames_this_chunk) {
            let is f64 as t = cast(f64, frame_idx + i) / cast(f64, rate);
            let is f64 as sample_f = fm.sin(two_pi * freq * t);

            // Envelope: fade in first 50ms, fade out last 50ms to prevent click
            let is f64 as amp with mut = 0.5;
            let is f64 as fade_time = 0.05;
            if (t < fade_time) {
                amp = amp * (t / fade_time);
            }
            let is f64 as time_remaining = duration - t;
            if (time_remaining < fade_time && time_remaining >= 0.0) {
                amp = amp * (time_remaining / fade_time);
            }

            let is i16 as sample_i = cast(i16, cast(i32, sample_f * amp * 32767.0));

            let is i64 as ch with mut = 0;
            while (ch < channels) {
                pcm_buf[i * channels + ch] = sample_i;
                ch = ch + 1;
            }
            i = i + 1;
        }

        let is i64 as written = audio.write_s16(&dev, pcm_buf, frames_this_chunk);
        if (written <= 0) {
            // Stream underrun or error
            audio.device.prepare(&dev);
        }

        frame_idx = frame_idx + frames_this_chunk;
    }

    audio.close(&dev);

    io.printf("audio_tone: successfully generated and streamed 440Hz tone (%d frames)\n",
              cast(i32, total_frames));
    return 0;
}
