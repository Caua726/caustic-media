// examples/user_input.cst — a user's keys, buttons and wheel, sent through
// the system.
//
// The examples' --check mostly drive the program by calling it, or hand the
// host events already in the toolkit's terms; what the system says on the
// way — the keycode looked up, the modifiers' bits, the wheel as buttons 4
// and 5 — was never read, and a key's Control could arrive as something else
// unseen. These go the whole way: the system, window/device.cst,
// ui/host.cst, the router.
//
// On X they are sent through the X server to the program's own window, from
// a connection of their own (XSendEvent) — only libX11, which every example
// links already. On Windows they are SendInput's, a keyboard's and a mouse's
// as Windows takes them from the devices, the pointer placed over the window
// in the screen's coordinates. Modifiers are named as the toolkit names them
// (input/keys.cst) and sent as each system's.
use "std/os.cst" as os;
use "std/mem.cst" as mem;
use "../window/device.cst" as device;
use "../input/keys.cst" as keys;
use "../window/x11/x11.cst" as x11;
use "../window/x11/bind/xlib.cst" as xlib;
use "../window/x11/bind/x.cst" as x;
use "../window/x11/bind/xevent.cst" as xev;
use "../window/win32/backend.cst" as win32;
use "../window/win32/bind/types.cst" as t;
use "../window/win32/bind/user32.cst" as u;

// The wheel's buttons.
let is u32 as WHEEL_UP   with imut = 4;
let is u32 as WHEEL_DOWN with imut = 5;

struct Sender {
    d    as *u8;   // X: a connection of its own, as another client's
    xid  as i64;   // the program's window
    hwnd as i64;   // Windows: the program's window, 0 when there is none
}

// What sends to w, the program's window: nothing is sent when its system
// could not be reached.
fn open(w as *device.Window) as Sender {
    let is Sender as s;
    s.d = cast(*u8, 0);
    s.xid = 0;
    s.hwnd = 0;
    if (os.current() == os.OS_WINDOWS) {
        s.hwnd = win32.hwnd(&w.win32_win);
        // SendInput goes where the keyboard is: to it.
        u.SetForegroundWindow(s.hwnd);
        return s;
    }
    if (os.current() == os.OS_LINUX) {
        s.d = xlib.XOpenDisplay(cast(*u8, 0));
        s.xid = x11.xid(&w.x11_win);
    }
    return s;
}

fn close(s as *Sender) as void {
    if (os.current() == os.OS_LINUX && cast(i64, s.d) != 0) { xlib.XCloseDisplay(s.d); }
    s.d = cast(*u8, 0);
    s.hwnd = 0;
}

// --- Windows ---

fn _send_key(vk as i64, scan as i64, flags as i64) as void {
    let is t.INPUT as in;
    mem.memzero(cast(*u8, &in), sizeof(t.INPUT));
    in.c_type = cast(u32, t.INPUT_KEYBOARD);
    let is *t.KEYBDINPUT as k = cast(*t.KEYBDINPUT, &in._anon1);
    k.wVk = cast(u16, vk);
    k.wScan = cast(u16, scan);
    k.dwFlags = cast(u32, flags);
    u.SendInput(1, &in, cast(i32, sizeof(t.INPUT)));
}

fn _extended(vk as i64) as i32 {
    return cast(i32, vk == t.VK_LEFT || vk == t.VK_RIGHT || vk == t.VK_UP || vk == t.VK_DOWN || vk == t.VK_HOME ||
                     vk == t.VK_END || vk == t.VK_PRIOR || vk == t.VK_NEXT || vk == t.VK_INSERT || vk == t.VK_DELETE);
}

// A key down or up, as its scan code says too.
fn _vk(vk as i64, up as i32) as void {
    let is i64 as flags with mut = 0;
    if (up == 1) { flags = flags | t.KEYEVENTF_KEYUP; }
    if (_extended(vk) == 1) { flags = flags | t.KEYEVENTF_EXTENDEDKEY; }
    _send_key(vk, cast(i64, u.MapVirtualKeyW(cast(u32, vk), cast(u32, t.MAPVK_VK_TO_VSC))), flags);
}

fn _mods(mods as i32, up as i32) as void {
    if ((mods & keys.MOD_CONTROL) != 0) { _vk(t.VK_CONTROL, up); }
    if ((mods & keys.MOD_SHIFT) != 0) { _vk(t.VK_SHIFT, up); }
    if ((mods & keys.MOD_ALT) != 0) { _vk(t.VK_MENU, up); }
    if ((mods & keys.MOD_SUPER) != 0) { _vk(t.VK_LWIN, up); }
}

// The virtual key of the toolkit's key (an X keysym), 0 for one not here:
// letters and digits are their ASCII capitals and digits.
fn _vk_of(key as i64) as i64 {
    if (key >= cast(i64, keys.A) && key <= cast(i64, keys.A) + 25) { return 65 + key - cast(i64, keys.A); }
    if (key >= cast(i64, keys.NUM_0) && key <= cast(i64, keys.NUM_0) + 9) { return 48 + key - cast(i64, keys.NUM_0); }
    if (key >= cast(i64, keys.F1) && key <= cast(i64, keys.F1) + 11) { return t.VK_F1 + key - cast(i64, keys.F1); }
    if (key == cast(i64, keys.SPACE)) { return t.VK_SPACE; }
    if (key == cast(i64, keys.BACKSPACE)) { return t.VK_BACK; }
    if (key == cast(i64, keys.TAB)) { return t.VK_TAB; }
    if (key == cast(i64, keys.RETURN)) { return t.VK_RETURN; }
    if (key == cast(i64, keys.ESCAPE)) { return t.VK_ESCAPE; }
    if (key == cast(i64, keys.PAGE_UP)) { return t.VK_PRIOR; }
    if (key == cast(i64, keys.PAGE_DOWN)) { return t.VK_NEXT; }
    if (key == cast(i64, keys.END)) { return t.VK_END; }
    if (key == cast(i64, keys.HOME)) { return t.VK_HOME; }
    if (key == cast(i64, keys.LEFT)) { return t.VK_LEFT; }
    if (key == cast(i64, keys.UP)) { return t.VK_UP; }
    if (key == cast(i64, keys.RIGHT)) { return t.VK_RIGHT; }
    if (key == cast(i64, keys.DOWN)) { return t.VK_DOWN; }
    if (key == cast(i64, keys.INSERT)) { return t.VK_INSERT; }
    if (key == cast(i64, keys.DELETE)) { return t.VK_DELETE; }
    if (key == cast(i64, keys.MENU)) { return t.VK_APPS; }
    if (key == cast(i64, keys.COMMA)) { return t.VK_OEM_COMMA; }
    if (key == cast(i64, keys.PERIOD)) { return t.VK_OEM_PERIOD; }
    if (key == cast(i64, keys.MINUS)) { return t.VK_OEM_MINUS; }
    if (key == cast(i64, keys.EQUAL)) { return t.VK_OEM_PLUS; }
    if (key == cast(i64, keys.SLASH)) { return t.VK_OEM_2; }
    return 0;
}

// A character of the US keyboard Windows (and Wine's X keymap) types it with:
// its virtual key, Shift added as 256; 0 for one typed as text instead.
fn _vk_of_char(c as i64) as i64 {
    if (c >= 97 && c <= 122) { return c - 32; }
    if (c >= 65 && c <= 90) { return c + 256; }
    if (c >= 48 && c <= 57) { return c; }
    if (c == 32) { return t.VK_SPACE; }
    if (c == 10) { return t.VK_RETURN; }
    if (c == 46) { return t.VK_OEM_PERIOD; }
    if (c == 44) { return t.VK_OEM_COMMA; }
    if (c == 45) { return t.VK_OEM_MINUS; }
    if (c == 95) { return t.VK_OEM_MINUS + 256; }
    if (c == 47) { return t.VK_OEM_2; }
    if (c == 126) { return t.VK_OEM_3 + 256; }
    if (c == 58) { return t.VK_OEM_1 + 256; }
    return 0;
}

// The pointer over x, y of the window (physical pixels), in SendInput's
// 0–65535 over the virtual screen.
fn _place(s as *Sender, px as i64, py as i64) as void {
    let is t.POINT as p;
    p.x = cast(i32, px);
    p.y = cast(i32, py);
    u.ClientToScreen(s.hwnd, &p);
    let is i64 as vx = cast(i64, u.GetSystemMetrics(cast(i32, t.SM_XVIRTUALSCREEN)));
    let is i64 as vy = cast(i64, u.GetSystemMetrics(cast(i32, t.SM_YVIRTUALSCREEN)));
    let is i64 as vw with mut = cast(i64, u.GetSystemMetrics(cast(i32, t.SM_CXVIRTUALSCREEN)));
    let is i64 as vh with mut = cast(i64, u.GetSystemMetrics(cast(i32, t.SM_CYVIRTUALSCREEN)));
    if (vw <= 1) { vw = 2; }
    if (vh <= 1) { vh = 2; }
    _mouse(((cast(i64, p.x) - vx) * 65535 + (vw - 1) / 2) / (vw - 1), ((cast(i64, p.y) - vy) * 65535 + (vh - 1) / 2) / (vh - 1),
           0, t.MOUSEEVENTF_MOVE | t.MOUSEEVENTF_ABSOLUTE | t.MOUSEEVENTF_VIRTUALDESK);
}

fn _mouse(dx as i64, dy as i64, data as i64, flags as i64) as void {
    let is t.INPUT as in;
    mem.memzero(cast(*u8, &in), sizeof(t.INPUT));
    in.c_type = cast(u32, t.INPUT_MOUSE);
    let is *t.MOUSEINPUT as m = cast(*t.MOUSEINPUT, &in._anon1);
    m.dx = cast(i32, dx);
    m.dy = cast(i32, dy);
    m.mouseData = cast(u32, data);
    m.dwFlags = cast(u32, flags);
    u.SendInput(1, &in, cast(i32, sizeof(t.INPUT)));
}

// --- X ---

// The modifiers mods (keys.MOD_*) as X's state bits.
fn _state(mods as i32) as u32 {
    let is i32 as st with mut = 0;
    if ((mods & keys.MOD_SHIFT) != 0) { st = st | x.ShiftMask; }
    if ((mods & keys.MOD_LOCK) != 0) { st = st | x.LockMask; }
    if ((mods & keys.MOD_CONTROL) != 0) { st = st | x.ControlMask; }
    if ((mods & keys.MOD_ALT) != 0) { st = st | x.Mod1Mask; }
    if ((mods & keys.MOD_SUPER) != 0) { st = st | x.Mod4Mask; }
    return cast(u32, st);
}

// The key of keysym (the toolkit's keys.* are X's keysyms) pressed and let
// go, with mods held.
fn key(s as *Sender, keysym as i64, mods as i32) as void {
    if (os.current() == os.OS_WINDOWS) {
        let is i64 as vk = _vk_of(keysym);
        if (s.hwnd == 0 || vk == 0) { return; }
        _mods(mods, 0);
        _vk(vk, 0);
        _vk(vk, 1);
        _mods(mods, 1);
        return;
    }
    if (os.current() == os.OS_LINUX) { _key(s, keysym, _state(mods)); }
}

fn _key(s as *Sender, keysym as i64, state as u32) as void {
    if (cast(i64, s.d) == 0) { return; }
    let is xev.XEvent as m;
    xev.clear(&m);
    let is *xev.XKeyEvent as k = xev.key(&m);
    k.kind = x.KeyPress;
    k.display = s.d;
    k.window = s.xid;
    k.root = xlib.XDefaultRootWindow(s.d);
    k.x = 1;
    k.y = 1;
    k.state = state;
    k.keycode = cast(u32, xlib.XKeysymToKeycode(s.d, keysym));
    k.same_screen = 1;
    xlib.XSendEvent(s.d, s.xid, 0, x.KeyPressMask, cast(*u8, &m));
    k.kind = x.KeyRelease;
    xlib.XSendEvent(s.d, s.xid, 0, x.KeyReleaseMask, cast(*u8, &m));
    // Done by the server: the program reads it in its next round.
    xlib.XSync(s.d, 0);
}

// Text typed key by key, ASCII only: each byte as the key that types it,
// Shift held where the keyboard's map has it on the key's second level; a
// line feed is Return. On Windows a character no US key types comes as
// text (KEYEVENTF_UNICODE).
fn type_text(s as *Sender, text as *u8) as void {
    if (os.current() == os.OS_WINDOWS) {
        if (s.hwnd == 0) { return; }
        let is i64 as i with mut = 0;
        while (text[i] != 0) {
            let is i64 as v = _vk_of_char(cast(i64, text[i]));
            if (v == 0) {
                _send_key(0, cast(i64, text[i]), t.KEYEVENTF_UNICODE);
                _send_key(0, cast(i64, text[i]), t.KEYEVENTF_UNICODE | t.KEYEVENTF_KEYUP);
            } else {
                if (v >= 256) { _vk(t.VK_SHIFT, 0); }
                _vk(v & 255, 0);
                _vk(v & 255, 1);
                if (v >= 256) { _vk(t.VK_SHIFT, 1); }
            }
            i = i + 1;
        }
        return;
    }
    if (cast(i64, s.d) == 0) { return; }
    let is i64 as i with mut = 0;
    while (text[i] != 0) {
        let is i64 as ks with mut = cast(i64, text[i]);
        if (ks == 10) { ks = cast(i64, keys.RETURN); }
        let is u8 as kc = xlib.XKeysymToKeycode(s.d, ks);
        let is u32 as st with mut = 0;
        if (xlib.XKeycodeToKeysym(s.d, kc, 0) != ks) { st = cast(u32, x.ShiftMask); }
        _key(s, ks, st);
        i = i + 1;
    }
}

// The pointer moved to x, y of the window (physical pixels).
fn move(s as *Sender, px as i64, py as i64) as void {
    if (os.current() == os.OS_WINDOWS) {
        if (s.hwnd != 0) { _place(s, px, py); }
        return;
    }
    if (cast(i64, s.d) == 0) { return; }
    let is xev.XEvent as m;
    xev.clear(&m);
    let is *xev.XMotionEvent as e = xev.motion(&m);
    e.kind = x.MotionNotify;
    e.display = s.d;
    e.window = s.xid;
    e.root = xlib.XDefaultRootWindow(s.d);
    e.x = cast(i32, px);
    e.y = cast(i32, py);
    e.same_screen = 1;
    xlib.XSendEvent(s.d, s.xid, 0, x.PointerMotionMask, cast(*u8, &m));
    xlib.XSync(s.d, 0);
}

// Button pressed and let go at x, y of the window (physical pixels), with
// mods held: 1 the left, 3 the right, WHEEL_UP and WHEEL_DOWN a notch.
fn button(s as *Sender, b as u32, px as i64, py as i64, mods as i32) as void {
    if (os.current() == os.OS_WINDOWS) {
        if (s.hwnd == 0) { return; }
        _place(s, px, py);
        _mods(mods, 0);
        if (b == WHEEL_UP) { _mouse(0, 0, 120, t.MOUSEEVENTF_WHEEL); }
        if (b == WHEEL_DOWN) { _mouse(0, 0, 0 - 120, t.MOUSEEVENTF_WHEEL); }
        if (b == cast(u32, 1)) {
            _mouse(0, 0, 0, t.MOUSEEVENTF_LEFTDOWN);
            _mouse(0, 0, 0, t.MOUSEEVENTF_LEFTUP);
        }
        if (b == cast(u32, 3)) {
            _mouse(0, 0, 0, t.MOUSEEVENTF_RIGHTDOWN);
            _mouse(0, 0, 0, t.MOUSEEVENTF_RIGHTUP);
        }
        _mods(mods, 1);
        return;
    }
    if (cast(i64, s.d) == 0) { return; }
    let is xev.XEvent as m;
    xev.clear(&m);
    let is *xev.XButtonEvent as e = xev.button(&m);
    e.kind = x.ButtonPress;
    e.display = s.d;
    e.window = s.xid;
    e.root = xlib.XDefaultRootWindow(s.d);
    e.x = cast(i32, px);
    e.y = cast(i32, py);
    e.state = _state(mods);
    e.button = b;
    e.same_screen = 1;
    xlib.XSendEvent(s.d, s.xid, 0, x.ButtonPressMask, cast(*u8, &m));
    e.kind = x.ButtonRelease;
    xlib.XSendEvent(s.d, s.xid, 0, x.ButtonReleaseMask, cast(*u8, &m));
    xlib.XSync(s.d, 0);
}
