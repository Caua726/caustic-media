// examples/text_editor.cst — a text editor, on the toolkit.
//
//   caustic -q examples/text_editor.cst -o build/text_editor --path .caustic/deps
//   ./build/text_editor [file]
//   sh window/x11/tools/run_headless.sh ./build/text_editor --check
//
// A program a user would keep open all day: a menu bar, the text, a status
// bar saying where the caret is. What it shows:
//
//   - one instance: started again with a file, it hands the file to the one
//     running and leaves (instance.cst);
//   - menus with their accelerators shown, the program's shortcuts bound,
//     Edit's items enabled as the text says they can be done (textview.can)
//     and done through it (textview.act);
//   - files read and written whole, the title saying which and whether it
//     changed since;
//   - the file chooser, to open and to save as;
//   - a question before closing over changes not saved: save them, lose
//     them, or stay;
//   - the about dialog, its website opened by the desktop (open_uri.cst);
//   - the window's size kept between runs (winstate.cst).
//
// --check drives it — keys and clicks through the loop, the dialogs' answers
// given directly — on a file in build/.
use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/os.cst" as os;
use "../sys/file.cst" as file;
use "../window/folders.cst" as folders;
use "../math/math.cst" as math;
use "../window/event.cst" as wevent;
use "../input/keys.cst" as keys;
use "../window/device.cst" as device;
use "../ui/ui.cst" as ui;
use "../window/settings.cst" as wsettings;
use "user_input.cst" as xin;

let is *u8 as ID with imut = "org.caustic.TextEditor";
let is *u8 as NAME with imut = "Text Editor";

// The File and Help menus' items; Edit's are textedit's own ids.
let is i64 as NEW     with imut = 101;
let is i64 as OPEN    with imut = 102;
let is i64 as SAVE    with imut = 103;
let is i64 as SAVE_AS with imut = 104;
let is i64 as QUIT    with imut = 105;
let is i64 as ABOUT   with imut = 201;
let is i64 as PREFS   with imut = 202;

// The answers to the question asked before closing over changes.
let is i64 as KEEP    with imut = 1;
let is i64 as DISCARD with imut = 2;
let is i64 as STAY    with imut = 3;

// The longest file it opens.
let is i64 as MAX_FILE with imut = 16777216;

struct Editor {
    a          as *ui.app.App;
    hs         as *ui.host.Host;
    win        as i64;
    t          as *ui.tree.Tree;
    r          as *ui.router.Router;
    tv         as i64;
    area       as i64;        // the scroll area the text is in
    status     as i64;
    edit_items as [8]i64;     // by textedit's ids
    path       as [4096]u8;   // "" while untitled
    path_n     as i64;
    changed    as i32;        // since it was read or written
    loading    as i32;        // the text set from a file: not a change
    closing    as i32;        // asked to close: once saved, closed
    _pad       as i32;
    question   as ui.dialog.Ref; // each dialog in a window of its own
    asking     as i32;
    _pad2      as i32;
    chooser    as ui.dialog.Ref;
    chooser_of as i64;        // the mode it was made for
    choosing   as i64;        // OPEN or SAVE_AS while it is shown
    about      as ui.dialog.Ref;
    prefs      as ui.dialog.Ref; // the preferences, in a window of their own
    pf_ui      as i64;        // their fields
    pf_mono    as i64;
    pf_size    as i64;
    pf_wrap    as i64;
    pf_follow  as i64;
    pf_light   as i64;
    pf_dark    as i64;
    filling    as i64;        // the fields set from what is kept: not a change
    shown_line as i64;        // what the status bar says
    shown_col  as i64;
    saves      as i64;
}

let is ui.program.Program as prog with mut;
let is Editor as ed with mut;
let is ui.instance.Instance as one with mut;
let is ui.open_uri.Request as link with mut;
let is *u8 as buf with mut = cast(*u8, 0);

fn _same(a as *u8, n as i64, b as *u8) as i32 {
    if (n != ui.len(b)) { return 0; }
    return cast(i32, mem.memcmp(a, b, n) == 0);
}

// --- The title, the status ---

fn _title() as void {
    let is [512]u8 as s;
    let is i64 as n with mut = 0;
    if (ed.changed == 1) {
        s[0] = cast(u8, 42);
        n = 1;
    }
    if (ed.path_n == 0) {
        mem.memcpy(cast(*u8, cast(i64, &s) + n), "Untitled", 8);
        n = n + 8;
    } else {
        // Its name, the last part of its path.
        let is i64 as k with mut = ed.path_n;
        while (k > 0 && ed.path[k - 1] != 47) { k = k - 1; }
        let is i64 as m with mut = ed.path_n - k;
        if (m > 400) { m = 400; }
        mem.memcpy(cast(*u8, cast(i64, &s) + n), cast(*u8, cast(i64, &ed.path) + k), m);
        n = n + m;
    }
    mem.memcpy(cast(*u8, cast(i64, &s) + n), " \xe2\x80\x94 ", 5);
    n = n + 5;
    mem.memcpy(cast(*u8, cast(i64, &s) + n), NAME, 11);
    n = n + 11;
    ui.app.set_title(ed.a, ed.win, cast(*u8, &s), n);
}

fn _digits(v as i64, to as *u8) as i64 {
    let is [24]u8 as r;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    if (x <= 0) {
        r[0] = cast(u8, 48);
        n = 1;
    }
    while (x > 0) {
        r[n] = cast(u8, 48 + x % 10);
        x = x / 10;
        n = n + 1;
    }
    let is i64 as k with mut = 0;
    while (k < n) {
        to[k] = r[n - 1 - k];
        k = k + 1;
    }
    return n;
}

// The caret's line and column, counted from 1, a column a character.
fn _where(line as *i64, col as *i64) as void {
    let is *u8 as s = ui.textview.text(ed.t, ed.tv);
    let is i64 as at = ui.textview.caret(ed.t, ed.tv);
    *line = ui.textview.paragraph_of(ed.t, ed.tv, at) + 1;
    let is i64 as k with mut = at;
    while (k > 0 && s[k - 1] != 10) { k = k - 1; }
    let is i64 as c with mut = 1;
    while (k < at) {
        k = k + ui.textedit.seq(cast(i64, s[k]));
        c = c + 1;
    }
    *col = c;
}

// Once a round: what the status bar and the Edit menu say, as the text is.
fn _round(user as *u8) as void {
    if (ui.tree.is_valid(ed.t, ed.tv) == 0) { return; }
    let is i64 as line with mut = 0;
    let is i64 as col with mut = 0;
    _where(&line, &col);
    if (line != ed.shown_line || col != ed.shown_col) {
        ed.shown_line = line;
        ed.shown_col = col;
        let is [64]u8 as s;
        mem.memcpy(cast(*u8, &s), "Line ", 5);
        let is i64 as n with mut = 5 + _digits(line, cast(*u8, cast(i64, &s) + 5));
        mem.memcpy(cast(*u8, cast(i64, &s) + n), ", Column ", 9);
        n = n + 9;
        n = n + _digits(col, cast(*u8, cast(i64, &s) + n));
        ui.statusbar.pop(ed.t, ed.status, 1);
        ui.statusbar.push(ed.t, ed.status, 1, cast(*u8, &s), n);
    }
    let is i64 as id with mut = ui.textedit.UNDO;
    while (id <= ui.textedit.SELECT_ALL) {
        let is i32 as on = ui.textview.can(ed.t, ed.tv, id);
        if (ed.edit_items[id] != 0 && ui.tree.is_enabled(ed.t, ed.edit_items[id]) != on) { ui.tree.set_enabled(ed.t, ed.edit_items[id], on); }
        id = id + 1;
    }
}

// --- Files ---

// path (n bytes) read into the text: 1, or 0 when it could not be.
fn read_file(path as *u8, n as i64) as i32 {
    if (n <= 0 || n > 4095) { return 0; }
    let is [4096]u8 as p;
    mem.memcpy(cast(*u8, &p), path, n);
    p[n] = cast(u8, 0);
    let is i64 as got = file.read(cast(*u8, &p), buf, MAX_FILE);
    if (got < 0) { return 0; }
    ed.loading = 1;
    ui.textview.set_text(ed.t, ed.tv, buf, got);
    ed.loading = 0;
    ui.textview.select(ed.t, ed.tv, 0, 0);
    mem.memcpy(cast(*u8, &ed.path), path, n);
    ed.path_n = n;
    ed.changed = 0;
    _title();
    return 1;
}

// The text written to the file at its path, whole under another name and
// moved over it: 1, or 0 when it could not be.
fn write_file() as i32 {
    if (ed.path_n == 0 || ed.path_n > 4090) { return 0; }
    let is [4096]u8 as p;
    mem.memcpy(cast(*u8, &p), cast(*u8, &ed.path), ed.path_n);
    p[ed.path_n] = cast(u8, 0);
    if (file.write_atomic(cast(*u8, &p), ui.textview.text(ed.t, ed.tv), ui.textview.length(ed.t, ed.tv), 0) == 0) { return 0; }
    ed.changed = 0;
    ed.saves = ed.saves + 1;
    _title();
    return 1;
}

fn _edited(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    if (ed.loading == 1 || ed.changed == 1) { return; }
    ed.changed = 1;
    _title();
}

// --- The chooser, the question, the about dialog ---

fn _chosen(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    let is i64 as answer = *cast(*i64, arg);
    let is i64 as was = ed.choosing;
    ed.choosing = 0;
    if (answer != ui.dialog.OK) {
        ed.closing = 0;
        return;
    }
    let is [4096]u8 as p;
    let is i64 as n = ui.filechooser.chosen(t, w, cast(*u8, &p), 4095);
    if (n == 0) { return; }
    if (was == OPEN) {
        read_file(cast(*u8, &p), n);
        return;
    }
    mem.memcpy(cast(*u8, &ed.path), cast(*u8, &p), n);
    ed.path_n = n;
    if (write_file() == 1 && ed.closing == 1) { ui.app.window_close(ed.a, ed.win); }
}

// The chooser shown, to open or to save as; one of the other mode let go.
fn choose(what as i64) as void {
    if (ui.dialog.ref_valid(&ed.chooser) == 1 && ed.chooser_of != what) { ui.dialog.dispose(&ed.chooser); }
    if (ui.dialog.ref_valid(&ed.chooser) == 0) {
        let is *ui.tree.Tree as dt = ui.dialog.window_tree(ed.t);
        let is i32 as mode with mut = ui.filechooser.OPEN;
        let is *u8 as title with mut = "Open";
        if (what == SAVE_AS) {
            mode = ui.filechooser.SAVE;
            title = "Save As";
        }
        let is i64 as fc = ui.file_chooser(dt, mode, title);
        ui.file_filter(dt, fc, "Text files", "*.txt;*.md;*.cst");
        ui.file_filter(dt, fc, "All files", "*");
        ui.on(dt, fc, ui.signal.ACTIVATED, fn_ptr(_chosen));
        ed.chooser = ui.dialog.ref(dt, fc);
        ed.chooser_of = what;
    }
    ed.choosing = what;
    ui.dialog.show(ed.chooser.t, cast(*ui.router.Router, ui.tree.router(ed.chooser.t)), ed.chooser.w, 1);
}

fn save() as void {
    if (ed.path_n == 0) {
        choose(SAVE_AS);
        return;
    }
    write_file();
}

fn _answered(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    let is i64 as answer = *cast(*i64, arg);
    ed.asking = 0;
    if (answer == KEEP) {
        ed.closing = 1;
        save();
        if (ed.changed == 0) { ui.app.window_close(ed.a, ed.win); }
        return;
    }
    if (answer == DISCARD) { ui.app.window_close(ed.a, ed.win); }
}

// Asked to close: at once with nothing to lose; else asked first.
fn on_close(user as *u8, h as i64) as i32 {
    if (h != ed.win || ed.changed == 0) { return 1; }
    if (ed.asking == 1) { return 0; }
    if (ui.dialog.ref_valid(&ed.question) == 0) {
        let is *ui.tree.Tree as dt = ui.dialog.window_tree(ed.t);
        let is *u8 as say = "Changes not saved are lost.";
        let is i64 as q = ui.message(dt, ui.dialog.QUESTION, "Save the changes before closing?", say, ui.dialog.CLOSE_ONLY);
        let is i64 as close_b = ui.dialog.button_for(dt, q, ui.dialog.CLOSE);
        if (close_b != 0) { ui.tree.destroy(dt, close_b); }
        ui.dialog_button(dt, q, "Close _without saving", DISCARD);
        ui.dialog_button(dt, q, "_Cancel", STAY);
        ui.dialog_button(dt, q, "_Save", KEEP);
        ui.dialog.set_default_response(dt, q, KEEP);
        ui.on(dt, q, ui.signal.ACTIVATED, fn_ptr(_answered));
        ed.question = ui.dialog.ref(dt, q);
    }
    ed.asking = 1;
    ui.dialog.show(ed.question.t, cast(*ui.router.Router, ui.tree.router(ed.question.t)), ed.question.w, 1);
    return 0;
}

fn _website(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    let is *u8 as uri = arg;
    // The desktop puts what it shows above the window the link is in.
    let is [200]u8 as parent;
    let is i64 as pn = ui.host.parent_handle(ed.hs, ui.app.window_of(ed.a, t), &parent[0], 200);
    ui.open_uri.open(&link, ui.program.conn(&prog), uri, ui.len(uri), &parent[0], pn);
}

// --- Preferences: the text's font and size, wrapping, the look ---

struct Prefs {
    mono as i64;   // 1: a monospace font; 0: the interface's
    size as i64;   // logical pixels; 0 for the theme's
    wrap as i64;   // 1: long lines wrapped at the window's width
    look as i64;   // 0 the desktop's, 1 light, 2 dark
}

let is Prefs as pr with mut;
let is [512]u8 as prefs_path with mut;
let is [512]u8 as prefs_buf with mut;
let is i64 as prefs_n with mut = 0;

fn prefs_defaults() as void {
    pr.mono = 0;
    pr.size = 0;
    pr.wrap = 1;
    pr.look = 0;
}

// s after the first n bytes of to, zero-terminated: the length now.
fn _put(to as *u8, n as i64, s as *u8) as i64 {
    let is i64 as k = ui.len(s);
    if (n + k >= 511) { return n; }
    mem.memcpy(cast(*u8, cast(i64, to) + n), s, k);
    to[n + k] = cast(u8, 0);
    return n + k;
}

// Where they are kept: $XDG_CONFIG_HOME, else ~/.config, under the
// examples' directory, made when missing; in build/ when checking.
fn find_prefs(checking as i32) as void {
    if (checking == 1) {
        _put(cast(*u8, &prefs_path), 0, "build/editor_prefs.conf");
        return;
    }
    let is *u8 as base with mut = env.getenv("XDG_CONFIG_HOME");
    let is i64 as n with mut = 0;
    if (os.current() == os.OS_WINDOWS) {
        // The roaming application data: settings that follow the user.
        n = folders.path(folders.ROAMING_DATA, cast(*u8, &prefs_path), 400);
        if (n == 0) { n = _put(cast(*u8, &prefs_path), 0, "."); }
    } else if (cast(i64, base) != 0 && base[0] == 47) {
        n = _put(cast(*u8, &prefs_path), 0, base);
    } else {
        let is *u8 as home with mut = env.getenv("HOME");
        if (cast(i64, home) == 0) { home = "/tmp"; }
        n = _put(cast(*u8, &prefs_path), 0, home);
        n = _put(cast(*u8, &prefs_path), n, "/.config");
    }
    file.make_dir(cast(*u8, &prefs_path), 1);
    n = _put(cast(*u8, &prefs_path), n, "/caustic-media-examples");
    file.make_dir(cast(*u8, &prefs_path), 1);
    _put(cast(*u8, &prefs_path), n, "/text-editor.conf");
}

fn _pref_line(key as *u8, v as i64) as void {
    let is i64 as k = ui.len(key);
    if (prefs_n + k + 24 > 512) { return; }
    mem.memcpy(cast(*u8, cast(i64, &prefs_buf) + prefs_n), key, k);
    prefs_n = prefs_n + k;
    prefs_buf[prefs_n] = cast(u8, 61);
    prefs_n = prefs_n + 1;
    let is [24]u8 as r;
    let is i64 as rn with mut = 0;
    let is i64 as x with mut = v;
    if (x <= 0) {
        r[0] = cast(u8, 48);
        rn = 1;
        x = 0;
    }
    while (x > 0) {
        r[rn] = cast(u8, 48 + x % 10);
        x = x / 10;
        rn = rn + 1;
    }
    while (rn > 0) {
        rn = rn - 1;
        prefs_buf[prefs_n] = r[rn];
        prefs_n = prefs_n + 1;
    }
    prefs_buf[prefs_n] = cast(u8, 10);
    prefs_n = prefs_n + 1;
}

// Written whole under another name, then moved over the old: never half.
fn save_prefs() as i32 {
    prefs_n = 0;
    _pref_line("mono", pr.mono);
    _pref_line("size", pr.size);
    _pref_line("wrap", pr.wrap);
    _pref_line("look", pr.look);
    return file.write_atomic(cast(*u8, &prefs_path), cast(*u8, &prefs_buf), prefs_n, 1);
}

// The digits at s, n bytes, between lo and hi; dflt otherwise.
fn _int(s as *u8, n as i64, lo as i64, hi as i64, dflt as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    if (n == 0 || n > 9) { return dflt; }
    while (i < n) {
        if (s[i] < 48 || s[i] > 57) { return dflt; }
        v = v * 10 + cast(i64, s[i]) - 48;
        i = i + 1;
    }
    if (v < lo || v > hi) { return dflt; }
    return v;
}

// What the file says, line by line; what it does not, the defaults'.
fn load_prefs() as void {
    prefs_defaults();
    let is i64 as n = file.read(cast(*u8, &prefs_path), cast(*u8, &prefs_buf), 512);
    if (n < 0) { return; }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as e with mut = i;
        while (e < n && prefs_buf[e] != 10) { e = e + 1; }
        let is i64 as q with mut = i;
        while (q < e && prefs_buf[q] != 61) { q = q + 1; }
        if (q < e) {
            let is *u8 as key = cast(*u8, cast(i64, &prefs_buf) + i);
            let is *u8 as val = cast(*u8, cast(i64, &prefs_buf) + q + 1);
            let is i64 as kn = q - i;
            let is i64 as vn = e - q - 1;
            if (_same(key, kn, "mono") == 1) { pr.mono = _int(val, vn, 0, 1, 0); }
            if (_same(key, kn, "size") == 1) { pr.size = _int(val, vn, 0, 72, 0); }
            if (_same(key, kn, "wrap") == 1) { pr.wrap = _int(val, vn, 0, 1, 1); }
            if (_same(key, kn, "look") == 1) { pr.look = _int(val, vn, 0, 2, 0); }
        }
        i = e + 1;
    }
}

// The text, its view and the window's look as they say.
fn apply_prefs() as void {
    let is *u8 as family with mut = cast(*u8, 0);
    if (pr.mono == 1) { family = "monospace"; }
    ui.textview.set_font(ed.t, ed.tv, family, cast(f64, pr.size));
    if (pr.wrap == 1) {
        ui.textview.set_wrap(ed.t, ed.tv, ui.textview.WRAP_WORD);
    } else {
        ui.textview.set_wrap(ed.t, ed.tv, ui.textview.WRAP_NONE);
    }
    let is wsettings.Settings as s with mut = *ui.host.settings(ed.hs);
    if (pr.look == 1) { s.dark = 0; }
    if (pr.look == 2) { s.dark = 1; }
    ui.app.set_system(ed.a, &s);
}

// A field changed: what they say now, applied and kept.
fn _pref_edited(t as *ui.tree.Tree, w as i64, arg as *u8, user as *u8) as void {
    if (ed.filling == 1) { return; }
    let is *ui.tree.Tree as dt = ed.prefs.t;
    pr.mono = cast(i64, ui.check.state(dt, ed.pf_mono) == ui.check.ON);
    pr.size = cast(i64, ui.spin.value(dt, ed.pf_size) + 0.5);
    pr.wrap = cast(i64, ui.check.state(dt, ed.pf_wrap) == ui.check.ON);
    pr.look = 0;
    if (ui.check.state(dt, ed.pf_light) == ui.check.ON) { pr.look = 1; }
    if (ui.check.state(dt, ed.pf_dark) == ui.check.ON) { pr.look = 2; }
    apply_prefs();
    save_prefs();
}

fn _fill_prefs() as void {
    let is *ui.tree.Tree as dt = ed.prefs.t;
    ed.filling = 1;
    if (pr.mono == 1) { ui.check.set_state(dt, ed.pf_mono, ui.check.ON); } else { ui.check.set_state(dt, ed.pf_ui, ui.check.ON); }
    let is f64 as size with mut = cast(f64, pr.size);
    if (pr.size == 0) { size = ui.tree.theme(ed.t).fonts.body.size; }
    ui.spin.set_value(dt, ed.pf_size, size);
    ui.check.set_state(dt, ed.pf_wrap, cast(i32, pr.wrap));
    if (pr.look == 1) {
        ui.check.set_state(dt, ed.pf_light, ui.check.ON);
    } else if (pr.look == 2) {
        ui.check.set_state(dt, ed.pf_dark, ui.check.ON);
    } else {
        ui.check.set_state(dt, ed.pf_follow, ui.check.ON);
    }
    ed.filling = 0;
}

fn show_prefs() as void {
    if (ui.dialog.ref_valid(&ed.prefs) == 0) {
        let is *ui.tree.Tree as dt = ui.dialog.window_tree(ed.t);
        let is *ui.router.Router as dr = cast(*ui.router.Router, ui.tree.router(dt));
        let is i64 as dw = ui.dialog(dt, "Preferences");
        let is i64 as page = ui.box.create(dt, ui.dialog.content(dt, dw), ui.box.COLUMN);
        ui.box.set_spacing(dt, page, 12.0);
        let is i64 as fg = ui.group(dt, page, "Font");
        let is i64 as fc = ui.box.create(dt, fg, ui.box.COLUMN);
        ui.box.set_spacing(dt, fc, 6.0);
        ed.pf_ui = ui.radio(dt, fc, "The _interface's", 0);
        ed.pf_mono = ui.radio(dt, fc, "_Monospace", ed.pf_ui);
        let is i64 as sr = ui.box.create(dt, fc, ui.box.ROW);
        ui.box.set_spacing(dt, sr, 12.0);
        ui.label(dt, sr, "Size");
        ed.pf_size = ui.spin.create(dt, sr, 6.0, 72.0, 1.0);
        ed.pf_wrap = ui.check(dt, page, "_Wrap long lines");
        let is i64 as lg = ui.group(dt, page, "Appearance");
        let is i64 as lc = ui.box.create(dt, lg, ui.box.COLUMN);
        ui.box.set_spacing(dt, lc, 6.0);
        ed.pf_follow = ui.radio(dt, lc, "_Follow the desktop", 0);
        ed.pf_light = ui.radio(dt, lc, "_Light", ed.pf_follow);
        ed.pf_dark = ui.radio(dt, lc, "_Dark", ed.pf_follow);
        ui.dialog_button(dt, dw, "_Close", ui.dialog.CLOSE);
        ui.dialog.set_default_response(dt, dw, ui.dialog.CLOSE);
        ui.on(dt, ed.pf_ui, ui.signal.TOGGLED, fn_ptr(_pref_edited));
        ui.on(dt, ed.pf_mono, ui.signal.TOGGLED, fn_ptr(_pref_edited));
        ui.on(dt, ed.pf_size, ui.signal.VALUE_CHANGED, fn_ptr(_pref_edited));
        ui.on(dt, ed.pf_wrap, ui.signal.TOGGLED, fn_ptr(_pref_edited));
        ui.on(dt, ed.pf_follow, ui.signal.TOGGLED, fn_ptr(_pref_edited));
        ui.on(dt, ed.pf_light, ui.signal.TOGGLED, fn_ptr(_pref_edited));
        ui.on(dt, ed.pf_dark, ui.signal.TOGGLED, fn_ptr(_pref_edited));
        ed.prefs = ui.dialog.ref(dt, dw);
    }
    _fill_prefs();
    ui.dialog.show(ed.prefs.t, cast(*ui.router.Router, ui.tree.router(ed.prefs.t)), ed.prefs.w, 0);
}

fn show_about() as void {
    if (ui.dialog.ref_valid(&ed.about) == 0) {
        let is *ui.tree.Tree as dt = ui.dialog.window_tree(ed.t);
        let is i64 as ab = ui.about.create(dt, NAME, 11);
        ui.about.set_version(dt, ab, "1.0", 3);
        ui.about.set_comments(dt, ab, "Plain text, on the caustic-media toolkit.", 41);
        ui.about.set_website(dt, ab, "https://github.com/Caua726/caustic-media", "caustic-media", 13);
        ui.about.set_copyright(dt, ab, "The caustic-media authors", 25);
        ui.on(dt, ui.about.website_link(dt, ab), ui.signal.ACTIVATED, fn_ptr(_website));
        ed.about = ui.dialog.ref(dt, ab);
    }
    ui.dialog.show(ed.about.t, cast(*ui.router.Router, ui.tree.router(ed.about.t)), ed.about.w, 0);
}

// --- The menus and the shortcuts ---

fn act(id as i64) as void {
    if (id == NEW) {
        ed.loading = 1;
        ui.textview.set_text(ed.t, ed.tv, "", 0);
        ed.loading = 0;
        ed.path_n = 0;
        ed.changed = 0;
        _title();
    } else if (id == OPEN) {
        choose(OPEN);
    } else if (id == SAVE) {
        save();
    } else if (id == SAVE_AS) {
        choose(SAVE_AS);
    } else if (id == QUIT) {
        if (on_close(cast(*u8, 0), ed.win) == 1) { ui.app.window_close(ed.a, ed.win); }
    } else if (id == ABOUT) {
        show_about();
    } else if (id == PREFS) {
        show_prefs();
    } else {
        ui.textview.act(ed.t, ed.tv, id);
    }
}

fn _menu_chosen(t as *ui.tree.Tree, m as i64, arg as *u8, user as *u8) as void { act(*cast(*i64, arg)); }

fn _key_new(user as *u8) as void { act(NEW); }
fn _key_open(user as *u8) as void { act(OPEN); }
fn _key_save(user as *u8) as void { act(SAVE); }
fn _key_save_as(user as *u8) as void { act(SAVE_AS); }
fn _key_quit(user as *u8) as void { act(QUIT); }
fn _key_prefs(user as *u8) as void { act(PREFS); }

fn _item(m as i64, s as *u8, id as i64, k as i32, mods as i32) as i64 {
    let is i64 as it = ui.menu_item(ed.t, m, s, id);
    if (k != 0) { ui.menu.set_accel(ed.t, it, k, mods); }
    return it;
}

fn build() as void {
    let is *ui.tree.Tree as t = ed.t;
    let is i64 as col = ui.box.create(t, ui.tree.root(t), ui.box.COLUMN);
    let is i64 as bar = ui.menubar.create(t, col);
    let is i64 as file_m = ui.menu.create(t);
    _item(file_m, "_New", NEW, keys.N, keys.MOD_CONTROL);
    _item(file_m, "_Open\xe2\x80\xa6", OPEN, keys.O, keys.MOD_CONTROL);
    _item(file_m, "_Save", SAVE, keys.S, keys.MOD_CONTROL);
    _item(file_m, "Save _As\xe2\x80\xa6", SAVE_AS, keys.S, keys.MOD_CONTROL | keys.MOD_SHIFT);
    ui.menu.add_separator(t, file_m);
    _item(file_m, "_Quit", QUIT, keys.Q, keys.MOD_CONTROL);
    let is i64 as edit_m = ui.menu.create(t);
    ed.edit_items[ui.textedit.UNDO] = _item(edit_m, "_Undo", ui.textedit.UNDO, keys.Z, keys.MOD_CONTROL);
    ed.edit_items[ui.textedit.REDO] = _item(edit_m, "_Redo", ui.textedit.REDO, keys.Z, keys.MOD_CONTROL | keys.MOD_SHIFT);
    ui.menu.add_separator(t, edit_m);
    ed.edit_items[ui.textedit.CUT] = _item(edit_m, "Cu_t", ui.textedit.CUT, keys.X, keys.MOD_CONTROL);
    ed.edit_items[ui.textedit.COPY] = _item(edit_m, "_Copy", ui.textedit.COPY, keys.C, keys.MOD_CONTROL);
    ed.edit_items[ui.textedit.PASTE] = _item(edit_m, "_Paste", ui.textedit.PASTE, keys.V, keys.MOD_CONTROL);
    ed.edit_items[ui.textedit.DELETE] = _item(edit_m, "_Delete", ui.textedit.DELETE, 0, 0);
    ui.menu.add_separator(t, edit_m);
    ed.edit_items[ui.textedit.SELECT_ALL] = _item(edit_m, "Select _All", ui.textedit.SELECT_ALL, keys.A, keys.MOD_CONTROL);
    ui.menu.add_separator(t, edit_m);
    _item(edit_m, "Pr_eferences\xe2\x80\xa6", PREFS, keys.COMMA, keys.MOD_CONTROL);
    let is i64 as help_m = ui.menu.create(t);
    _item(help_m, "_About", ABOUT, 0, 0);
    ui.menu_title(t, bar, "_File", file_m);
    ui.menu_title(t, bar, "_Edit", edit_m);
    ui.menu_title(t, bar, "_Help", help_m);
    ui.menubar.bind(t, ed.r, bar);
    ui.on(t, file_m, ui.signal.ACTIVATED, fn_ptr(_menu_chosen));
    ui.on(t, edit_m, ui.signal.ACTIVATED, fn_ptr(_menu_chosen));
    ui.on(t, help_m, ui.signal.ACTIVATED, fn_ptr(_menu_chosen));
    // The text in a scroll area, as a text view is meant to be: the wheel
    // scrolls it, the caret kept in view, the status bar under it.
    ed.area = ui.scroll.create(t, col);
    ui.layout.set_stretch(t, ed.area, 1.0, 1.0);
    ed.tv = ui.textview.create(t, ed.area);
    ui.textview.set_accepts_tab(t, ed.tv, 1);
    ui.on(t, ed.tv, ui.signal.CHANGED, fn_ptr(_edited));
    ed.status = ui.statusbar.create(t, col);
    ui.router.add_shortcut(ed.r, keys.N, keys.MOD_CONTROL, fn_ptr(_key_new), cast(*u8, 0));
    ui.router.add_shortcut(ed.r, keys.O, keys.MOD_CONTROL, fn_ptr(_key_open), cast(*u8, 0));
    ui.router.add_shortcut(ed.r, keys.S, keys.MOD_CONTROL, fn_ptr(_key_save), cast(*u8, 0));
    ui.router.add_shortcut(ed.r, keys.S, keys.MOD_CONTROL | keys.MOD_SHIFT, fn_ptr(_key_save_as), cast(*u8, 0));
    ui.router.add_shortcut(ed.r, keys.Q, keys.MOD_CONTROL, fn_ptr(_key_quit), cast(*u8, 0));
    ui.router.add_shortcut(ed.r, keys.COMMA, keys.MOD_CONTROL, fn_ptr(_key_prefs), cast(*u8, 0));
    ui.router.focus(t, ed.r, ed.tv, 0);
}

// --- Another start's ---

// Brought forward with the token the later start came with, so the desktop
// takes it as the user's doing.
fn _activated(user as *u8) as void { ui.host.present(ed.hs, ed.win, ui.instance.token(&one), ui.instance.token_length(&one)); }

// Files another start was asked to open: the first, when nothing would be
// lost; the window brought forward either way.
fn _opened(user as *u8, s as *u8, n as i64, count as i64) as void {
    ui.host.present(ed.hs, ed.win, ui.instance.token(&one), ui.instance.token_length(&one));
    if (count < 1 || ed.changed == 1) { return; }
    let is i64 as k with mut = 0;
    while (k < n && s[k] != 0) { k = k + 1; }
    let is [4097]u8 as p;
    let is i64 as pn = ui.open_uri.local_path(s, k, cast(*u8, &p));
    if (pn > 0) { read_file(cast(*u8, &p), pn); }
}

// A path given on the command line as a file URI: its length in out. A
// relative one is the current folder's; on Windows its '\\' are '/' and a
// drive's path is "file:///C:/…".
fn _as_uri(path as *u8, out as *u8) as i64 {
    let is i64 as n = ui.len(path);
    let is [3200]u8 as whole;
    let is i64 as w with mut = 0;
    if (n > 0 && file.root(path, n) == 0) {
        w = file.cwd(cast(*u8, &whole), 3000);
        if (w > 0) {
            whole[w] = cast(u8, 47);
            w = w + 1;
        }
    }
    let is i64 as i with mut = 0;
    while (i < n && w < 3199) {
        let is u8 as c with mut = path[i];
        if (os.current() == os.OS_WINDOWS && c == 92) { c = cast(u8, 47); }
        whole[w] = c;
        w = w + 1;
        i = i + 1;
    }
    let is i64 as k with mut = 7;
    mem.memcpy(out, "file://", 7);
    // A drive's path after one more '/', a Linux one has its own.
    if (w > 0 && whole[0] != 47) {
        out[7] = cast(u8, 47);
        k = 8;
    }
    let is *u8 as hex = "0123456789ABCDEF";
    i = 0;
    while (i < w && k < 4090) {
        let is u8 as c = whole[i];
        let is i32 as plain = cast(i32, (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 47 ||
                                       c == 45 || c == 46 || c == 95 || c == 126 || c == 58);
        if (plain == 1) {
            out[k] = c;
            k = k + 1;
        } else {
            out[k] = cast(u8, 37);
            out[k + 1] = hex[cast(i64, c) / 16];
            out[k + 2] = hex[cast(i64, c) % 16];
            k = k + 3;
        }
        i = i + 1;
    }
    return k;
}

// --- Driven, as a user would ---

let is i32 as fails with mut = 0;

fn expect(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

// Rounds for ms milliseconds: an animation over by then.
fn for_ms(ms as i64) as void {
    let is i64 as until = time.now_ms() + ms;
    while (time.now_ms() < until) { ui.host.step(ed.hs, 10); }
}

fn rounds(n as i64) as void {
    let is i64 as k with mut = 0;
    while (k < n) {
        ui.host.step(ed.hs, 20);
        k = k + 1;
    }
}

// Keys and the wheel as a user's come: sent through the system to the window
// (user_input.cst), read back the whole way.
let is xin.Sender as xs with mut;

fn key(k as i32, mods as i32) as void {
    xin.key(&xs, cast(i64, k), mods);
    rounds(1);
}

fn type_in(s as *u8) as void {
    xin.type_text(&xs, s);
    rounds(1);
}

fn holds(s as *u8) as i32 { return _same(ui.textview.text(ed.t, ed.tv), ui.textview.length(ed.t, ed.tv), s); }

fn title_is(s as *u8) as i32 { return _same(ui.app.title(ed.a, ed.win), ui.app.title_length(ed.a, ed.win), s); }

fn file_is(path as *u8, s as *u8) as i32 {
    let is [256]u8 as b;
    let is i64 as n = file.read(path, cast(*u8, &b), 256);
    if (n < 0) { return 0; }
    return _same(cast(*u8, &b), n, s);
}

fn status_is(s as *u8) as i32 {
    return _same(ui.statusbar.message(ed.t, ed.status), ui.statusbar.message_length(ed.t, ed.status), s);
}

fn drive() as void {
    rounds(6);
    expect("on the screen", ui.host.shown(ed.hs) == 1);
    xs = xin.open(ui.host.native(ed.hs, ed.win));
    expect("the file read, its name the title's", holds("first line\nsecond") == 1 &&
           title_is("editor_check.txt \xe2\x80\x94 Text Editor") == 1);
    expect("the caret at the start", status_is("Line 1, Column 1") == 1);
    type_in("Hi ");
    expect("typed: changed, the title says so", holds("Hi first line\nsecond") == 1 &&
           title_is("*editor_check.txt \xe2\x80\x94 Text Editor") == 1);
    rounds(1);
    expect("the caret's place said", status_is("Line 1, Column 4") == 1);
    expect("Edit: undo, no cut with nothing chosen", ui.tree.is_enabled(ed.t, ed.edit_items[ui.textedit.UNDO]) == 1 &&
           ui.tree.is_enabled(ed.t, ed.edit_items[ui.textedit.CUT]) == 0);
    act(ui.textedit.UNDO);
    expect("undone through the menu's action", holds("first line\nsecond") == 1);
    act(ui.textedit.REDO);
    expect("redone", holds("Hi first line\nsecond") == 1);
    act(ui.textedit.SELECT_ALL);
    rounds(1);
    expect("all chosen: cut and copy can be", ui.tree.is_enabled(ed.t, ed.edit_items[ui.textedit.CUT]) == 1 &&
           ui.tree.is_enabled(ed.t, ed.edit_items[ui.textedit.COPY]) == 1);
    ui.textview.select(ed.t, ed.tv, 3, 3);
    key(keys.S, keys.MOD_CONTROL);
    expect("Ctrl+S: written, no longer changed", ed.saves == 1 && file_is("build/editor_check.txt", "Hi first line\nsecond") == 1 &&
           title_is("editor_check.txt \xe2\x80\x94 Text Editor") == 1);
    key(keys.RETURN, 0);
    rounds(1);
    expect("a line more: where the caret is", status_is("Line 2, Column 1") == 1);
    // Save As: the chooser in its own window, where to save typed there
    // with the keys — Ctrl+L, a path from the folder shown, Enter.
    act(SAVE_AS);
    rounds(2);
    expect("save as: the chooser shown", ui.dialog.ref_valid(&ed.chooser) == 1 && ui.dialog.is_shown(ed.chooser.t, ed.chooser.w) == 1);
    let is [4096]u8 as cwd;
    let is i64 as cn = file.cwd(cast(*u8, &cwd), 4000);
    ui.filechooser.set_folder(ed.chooser.t, ed.chooser.w, cast(*u8, &cwd), cn);
    file.remove("build/editor_check_as.txt");
    let is *device.Window as cw = ui.host.native(ed.hs, ui.app.window_of(ed.a, ed.chooser.t));
    expect("the chooser a window of its own", cast(i64, cw) != 0);
    if (cast(i64, cw) != 0) {
        let is xin.Sender as cs with mut = xin.open(cw);
        xin.key(&cs, cast(i64, keys.L), keys.MOD_CONTROL);
        rounds(1);
        let is *ui.router.Router as cr = cast(*ui.router.Router, ui.tree.router(ed.chooser.t));
        expect("Ctrl+L in the chooser: where it is, to type over",
               ui.router.focused(ed.chooser.t, cr) == ui.filechooser.location(ed.chooser.t, ed.chooser.w));
        xin.type_text(&cs, "build/editor_check_as.txt\n");
        rounds(2);
        xin.close(&cs);
    }
    expect("saved as another: written there, the title its name", ed.saves == 2 &&
           file_is("build/editor_check_as.txt", "Hi \nfirst line\nsecond") == 1 &&
           title_is("editor_check_as.txt \xe2\x80\x94 Text Editor") == 1);
    show_about();
    rounds(2);
    expect("its about dialog", ui.dialog.ref_valid(&ed.about) == 1 && ui.dialog.is_shown(ed.about.t, ed.about.w) == 1);
    ui.dialog.respond(ed.about.t, ed.about.w, ui.dialog.CLOSE);
    rounds(2);
    // Ctrl+A, and a letter typed over what it chose.
    ui.textview.select(ed.t, ed.tv, 0, 0);
    key(keys.A, keys.MOD_CONTROL);
    let is i64 as sa with mut = 0;
    let is i64 as sb with mut = 0;
    ui.textview.selection(ed.t, ed.tv, &sa, &sb);
    let is i64 as all = ui.textview.length(ed.t, ed.tv);
    expect("Ctrl+A from the keyboard: all of it chosen, nothing typed", holds("Hi \nfirst line\nsecond") == 1 &&
           ((sa == 0 && sb == all) || (sb == 0 && sa == all)));
    type_in("b");
    expect("a key from the keyboard: typed over it", holds("b") == 1);
    // A text taller than the window: the status bar stays in it, and the
    // wheel scrolls the text.
    let is [2000]u8 as tall;
    let is i64 as tn with mut = 0;
    while (tn < 2000) {
        tall[tn] = cast(u8, 120);
        tall[tn + 1] = cast(u8, 10);
        tn = tn + 2;
    }
    ui.textview.set_text(ed.t, ed.tv, cast(*u8, &tall), 2000);
    rounds(3);
    let is math.rect.Rect as sr = ui.layout.window_rect(ed.t, ed.status);
    expect("the status bar in the window", sr.h > 0.0 && sr.y + sr.h <= ui.app.height(ed.a, ed.win) + 0.5);
    let is math.rect.Rect as ar = ui.layout.window_rect(ed.t, ed.area);
    let is f64 as sc = ui.app.scale(ed.a, ed.win);
    let is i64 as wx = cast(i64, (ar.x + ar.w / 2.0) * sc);
    let is i64 as wy = cast(i64, (ar.y + ar.h / 2.0) * sc);
    xin.button(&xs, xin.WHEEL_DOWN, wx, wy, 0);
    xin.button(&xs, xin.WHEEL_DOWN, wx, wy, 0);
    xin.button(&xs, xin.WHEEL_DOWN, wx, wy, 0);
    for_ms(600);
    let is f64 as down = ui.scroll.offset_y(ed.t, ed.area);
    expect("the wheel: scrolled down", down > 0.0);
    xin.button(&xs, xin.WHEEL_UP, wx, wy, 0);
    xin.button(&xs, xin.WHEEL_UP, wx, wy, 0);
    xin.button(&xs, xin.WHEEL_UP, wx, wy, 0);
    for_ms(600);
    expect("and back up", ui.scroll.offset_y(ed.t, ed.area) < down);
    // Its preferences: Ctrl+, from the keyboard, each applied as it changes
    // and kept.
    key(keys.COMMA, keys.MOD_CONTROL);
    rounds(2);
    expect("Ctrl+,: its preferences shown", ui.dialog.ref_valid(&ed.prefs) == 1 && ui.dialog.is_shown(ed.prefs.t, ed.prefs.w) == 1);
    let is f64 as line_was = ui.textview.caret_rect(ed.t, ed.tv).h;
    let is *ui.tree.Tree as pt = ed.prefs.t;
    ui.check.set_state(pt, ed.pf_mono, ui.check.ON);
    ui.spin.set_value(pt, ed.pf_size, 24.0);
    rounds(2);
    expect("a bigger monospace: the text in it", pr.mono == 1 && pr.size == 24 && ui.textview.caret_rect(ed.t, ed.tv).h > line_was * 1.3);
    ui.check.set_state(pt, ed.pf_wrap, ui.check.OFF);
    ui.check.set_state(pt, ed.pf_dark, ui.check.ON);
    rounds(2);
    let is math.color.Color as bg = ui.app.theme(ed.a).palette.window_bg;
    expect("not wrapped, and dark", pr.wrap == 0 && pr.look == 2 && 0.2126 * bg.r + 0.7152 * bg.g + 0.0722 * bg.b < 0.5);
    prefs_defaults();
    load_prefs();
    expect("kept: read back as they were", pr.mono == 1 && pr.size == 24 && pr.wrap == 0 && pr.look == 2);
    ui.check.set_state(pt, ed.pf_follow, ui.check.ON);
    ui.check.set_state(pt, ed.pf_ui, ui.check.ON);
    rounds(2);
    ui.dialog.respond(ed.prefs.t, ed.prefs.w, ui.dialog.CLOSE);
    rounds(2);
    expect("closed", ui.dialog.is_shown(ed.prefs.t, ed.prefs.w) == 0);
    // Closed over a change: asked; told to stay, then to lose it.
    type_in("x");
    let is wevent.Event as e;
    wevent.clear(&e);
    e.kind = wevent.CLOSE;
    ui.host.feed(ed.hs, ed.win, &e, time.now_ms());
    rounds(2);
    expect("closed over a change: asked", ed.asking == 1 && ui.dialog.is_shown(ed.question.t, ed.question.w) == 1);
    ui.dialog.respond(ed.question.t, ed.question.w, STAY);
    rounds(2);
    expect("told to stay: still there", ui.app.window_valid(ed.a, ed.win) == 1 && ed.asking == 0);
    act(QUIT);
    rounds(2);
    expect("quit over a change: asked again", ed.asking == 1 && ui.dialog.is_shown(ed.question.t, ed.question.w) == 1);
    ui.dialog.respond(ed.question.t, ed.question.w, DISCARD);
    rounds(4);
    expect("told to lose it: closed, the file as it was", ui.host.shown(ed.hs) == 0 &&
           file_is("build/editor_check_as.txt", "Hi \nfirst line\nsecond") == 1);
    xin.close(&xs);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i32 as checking = cast(i32, env.argc() > 1 && _same(env.argv(1), ui.len(env.argv(1)), "--check") == 1);
    if (ui.program.open(&prog, cast(*u8, 0)) == 0) {
        io.printf("text editor: no fonts on this system\n");
        return 1;
    }
    let is *u8 as opening with mut = cast(*u8, 0);
    if (checking == 1) {
        file.write_atomic("build/editor_check.txt", "first line\nsecond", 17, 0);
        opening = "build/editor_check.txt";
    } else if (env.argc() > 1) {
        opening = env.argv(1);
    }
    // One instance: another running is handed the file, and this one leaves.
    if (checking == 0 && cast(i64, ui.program.conn(&prog)) != 0) {
        if (ui.instance.claim(&one, ui.program.conn(&prog), ID, ui.len(ID), fn_ptr(_activated), fn_ptr(_opened),
                           cast(ui.instance.ActionFn, 0), cast(*u8, 0)) == 0) {
            if (cast(i64, opening) != 0) {
                let is [4096]u8 as uri;
                let is i64 as un = _as_uri(opening, cast(*u8, &uri));
                ui.instance.open_remote(ui.program.conn(&prog), ID, ui.len(ID), cast(*u8, &uri), un, 1);
            } else {
                ui.instance.activate_remote(ui.program.conn(&prog), ID, ui.len(ID));
            }
            ui.program.close(&prog);
            return 0;
        }
    }
    buf = mem.core.mmap_anon(MAX_FILE);
    ed.a = ui.program.app(&prog);
    ed.hs = ui.program.host(&prog);
    let is ui.winstate.State as st with mut = ui.winstate.state(720.0, 480.0);
    if (checking == 0) { ui.winstate.load("caustic-text-editor", 19, "main", 4, &st); }
    ed.win = ui.app.window_open(ed.a, st.width, st.height);
    ed.t = ui.app.tree(ed.a, ed.win);
    ed.r = ui.app.router(ed.a, ed.win);
    build();
    find_prefs(checking);
    if (checking == 1) { file.remove(cast(*u8, &prefs_path)); }
    load_prefs();
    apply_prefs();
    _title();
    if (cast(i64, opening) != 0) { read_file(opening, ui.len(opening)); }
    ui.host.set_on_close(ed.hs, fn_ptr(on_close), cast(*u8, 0));
    ui.host.every_round(ed.hs, fn_ptr(_round), cast(*u8, 0));
    if (checking == 1) {
        drive();
    } else {
        ui.program.run(&prog);
        st.width = ui.app.width(ed.a, ed.win);
        st.height = ui.app.height(ed.a, ed.win);
        ui.winstate.save("caustic-text-editor", 19, "main", 4, &st);
    }
    ui.instance.release(&one);
    ui.program.close(&prog);
    if (checking == 0) { return 0; }
    if (fails == 0) {
        io.printf("text editor: all checks passed\n");
        return 0;
    }
    io.printf("text editor: %d failures\n", fails);
    return 1;
}
