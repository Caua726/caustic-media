// examples/cube.cst — a shaded cube turning in a window.
//
// The whole stack in one file: math builds the transforms, the software
// rasterizer fills the triangles with a depth buffer, and the X11 backend
// carries the finished pixels to the screen. Nothing between them is a GPU.
//
//   caustic -q examples/cube.cst -o build/cube && ./build/cube
//   ./build/cube 120        # stop after 120 frames, for a scripted run
//
// Escape or the window's close button ends it.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "std/time.cst" as time;
use "std/env.cst" as env;
use "../math/math.cst" as math;
use "../gpu/software/software.cst" as soft;
use "../window/x11.cst" as x11;

let is i64 as WIDTH  = 640;
let is i64 as HEIGHT = 480;

// The eight corners of a cube centred on the origin.
fn corner(i as i32) as math.vec.Vec3 {
    let is f64 as x with mut = -1.0;
    let is f64 as y with mut = -1.0;
    let is f64 as z with mut = -1.0;
    if ((i & 1) != 0) { x = 1.0; }
    if ((i & 2) != 0) { y = 1.0; }
    if ((i & 4) != 0) { z = 1.0; }
    return math.vec.v3(x, y, z);
}

// One face as two triangles, wound counter-clockwise seen from outside so
// back-face culling keeps the front and drops the back.
fn face(t as *soft.target.Target, mvp as math.mat.Mat4,
        a as i32, b as i32, c as i32, d as i32, col as math.color.Color) as void {
    // Shade the far triangle of each face slightly darker, so the geometry
    // reads even with no lighting model.
    let is math.color.Color as dim = math.color.col_scale(col, 0.75);
    soft.raster.triangle(t, mvp,
        soft.raster.vertex(corner(a), col),
        soft.raster.vertex(corner(b), col),
        soft.raster.vertex(corner(c), dim),
        soft.raster.CULL_BACK);
    soft.raster.triangle(t, mvp,
        soft.raster.vertex(corner(a), col),
        soft.raster.vertex(corner(c), dim),
        soft.raster.vertex(corner(d), dim),
        soft.raster.CULL_BACK);
}

fn draw_cube(t as *soft.target.Target, mvp as math.mat.Mat4) as void {
    // Corner index bits are x=1, y=2, z=4.
    face(t, mvp, 4, 5, 7, 6, math.color.from_hex(0xE8453C));   // +z  front
    face(t, mvp, 1, 0, 2, 3, math.color.from_hex(0x3B78E7));   // -z  back
    face(t, mvp, 5, 1, 3, 7, math.color.from_hex(0x4CAF50));   // +x  right
    face(t, mvp, 0, 4, 6, 2, math.color.from_hex(0xF4B400));   // -x  left
    face(t, mvp, 2, 6, 7, 3, math.color.from_hex(0x9C27B0));   // +y  top
    face(t, mvp, 0, 1, 5, 4, math.color.from_hex(0x00ACC1));   // -y  bottom
}

// The transform for a given angle: spin about Y, tilt about X, viewed from
// four units back.
fn cube_mvp(angle as f64, aspect as f64) as math.mat.Mat4 {
    let is math.mat.Mat4 as model = math.mat.m4_mul(
        math.mat.m4_rotation_y(angle),
        math.mat.m4_rotation_x(angle * 0.5));
    let is math.mat.Mat4 as view = math.mat.m4_look_at(
        math.vec.v3(0.0, 0.0, 4.0), math.vec.v3_zero(), math.vec.v3_up());
    let is math.mat.Mat4 as proj = math.mat.m4_perspective(
        math.scalar.radians(60.0), aspect, 0.1, 100.0);
    return math.mat.m4_mul(proj, math.mat.m4_mul(view, model));
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);

    // An optional frame limit keeps the example runnable from a script.
    let is i64 as max_frames with mut = 0;
    if (env.argc() > 1) {
        let is *u8 as a = env.argv(1);
        let is i64 as n with mut = 0;
        let is i64 as i with mut = 0;
        while (a[i] >= 48 && a[i] <= 57) { n = n * 10 + cast(i64, a[i]) - 48; i = i + 1; }
        max_frames = n;
    }

    let is *u8 as color_buf = mem.core.mmap_anon(soft.target.color_bytes(WIDTH, HEIGHT));
    let is *u8 as depth_buf = mem.core.mmap_anon(soft.target.depth_bytes(WIDTH, HEIGHT));
    if (cast(i64, color_buf) == 0 || cast(i64, depth_buf) == 0) {
        io.printf("out of memory\n");
        return 1;
    }
    let is soft.target.Target as t = soft.target.target(color_buf, depth_buf, WIDTH, HEIGHT);

    let is x11.Window as w = x11.open("caustic-media — cube", WIDTH, HEIGHT);
    if (w.ok == 0) {
        io.printf("could not open a window (is DISPLAY set?)\n");
        return 1;
    }

    let is math.color.Color as bg = math.color.from_hex(0x101018);
    let is f64 as aspect = cast(f64, WIDTH) / cast(f64, HEIGHT);
    let is i64 as start = time.now_ns();
    let is i64 as frames with mut = 0;

    while (x11.poll(&w) == 1) {
        // Drive the angle from the clock, not the frame counter, so the cube
        // turns at the same rate whatever the frame rate turns out to be.
        let is f64 as elapsed = cast(f64, time.now_ns() - start) / 1000000000.0;
        soft.target.clear(&t, bg);
        draw_cube(&t, cube_mvp(elapsed, aspect));
        x11.present(&w, &t);
        frames = frames + 1;
        if (max_frames > 0 && frames >= max_frames) { break; }
    }

    let is i64 as total_ns = time.now_ns() - start;
    x11.close(&w);

    if (total_ns > 0) {
        io.printf("%d frames in %d ms\n", frames, total_ns / 1000000);
    }
    return 0;
}
