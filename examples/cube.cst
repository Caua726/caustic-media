// examples/cube.cst — a shaded cube turning in a window, drawn through the
// device abstraction.
//
// The whole stack in one file, and the point of this version is what is NOT
// in it: nothing below names the software rasterizer. The cube is a vertex
// buffer, a pipeline and a draw, submitted to a gpu.Device that happens to be
// software today. Compile Vulkan in and change AUTO to VULKAN and this file
// does not move.
//
// It is also the one place the two halves are glued: gpu/ never imports
// window/, so it is this program that hands the device a Surface carrying the
// window's native handles and a function that puts pixels on it.
//
//   caustic -q examples/cube.cst -o build/cube && ./build/cube
//   ./build/cube 120        # stop after 120 frames, for a scripted run
//
// Escape or the window's close button ends it.
use "std/io.cst" as io;
use "std/time.cst" as time;
use "std/env.cst" as env;
use "../math/math.cst" as math;
use "../gpu/gpu.cst" as gpu;
use "../gpu/software/target.cst" as tgt;
use "../window/x11/x11.cst" as x11;

let is i64 as WIDTH  = 640;
let is i64 as HEIGHT = 480;

// A vertex, laid out exactly as pipeline.layout_pos_color() declares it:
// three f64 of position, then four of colour.
struct Vtx {
    x as f64; y as f64; z as f64;
    r as f64; g as f64; b as f64; a as f64;
}

// 6 faces * 2 triangles * 3 vertices.
let is [36]Vtx as cube_verts;

fn vtx(p as math.vec.Vec3, c as math.color.Color) as Vtx {
    let is Vtx as v;
    v.x = p.x; v.y = p.y; v.z = p.z;
    v.r = c.r; v.g = c.g; v.b = c.b; v.a = c.a;
    return v;
}

// The eight corners of a cube centred on the origin.
fn corner(i as i32) as math.vec.Vec3 {
    let is f64 as x with mut = -1.0;
    let is f64 as y with mut = -1.0;
    let is f64 as z with mut = -1.0;
    if ((i & 1) != 0) { x = 1.0; }
    if ((i & 2) != 0) { y = 1.0; }
    if ((i & 4) != 0) { z = 1.0; }
    return math.vec.v3(x, y, z);
}

// One face as two triangles, wound counter-clockwise seen from outside so
// back-face culling keeps the front and drops the back. The far triangle of
// each face is shaded slightly darker, so the geometry reads with no lighting
// model.
fn face(at as i64, a as i32, b as i32, c as i32, d as i32, col as math.color.Color) as i64 {
    let is math.color.Color as dim = math.color.col_scale(col, 0.75);
    cube_verts[at + 0] = vtx(corner(a), col);
    cube_verts[at + 1] = vtx(corner(b), col);
    cube_verts[at + 2] = vtx(corner(c), dim);
    cube_verts[at + 3] = vtx(corner(a), col);
    cube_verts[at + 4] = vtx(corner(c), dim);
    cube_verts[at + 5] = vtx(corner(d), dim);
    return at + 6;
}

fn build_cube() as void {
    // Corner index bits are x=1, y=2, z=4.
    let is i64 as at with mut = 0;
    at = face(at, 4, 5, 7, 6, math.color.from_hex(0xE8453C));   // +z  front
    at = face(at, 1, 0, 2, 3, math.color.from_hex(0x3B78E7));   // -z  back
    at = face(at, 5, 1, 3, 7, math.color.from_hex(0x4CAF50));   // +x  right
    at = face(at, 0, 4, 6, 2, math.color.from_hex(0xF4B400));   // -x  left
    at = face(at, 2, 6, 7, 3, math.color.from_hex(0x9C27B0));   // +y  top
    at = face(at, 0, 1, 5, 4, math.color.from_hex(0x00ACC1));   // -y  bottom
}

// The transform for a given angle: spin about Y, tilt about X, viewed from
// four units back.
fn cube_mvp(angle as f64, aspect as f64) as math.mat.Mat4 {
    let is math.mat.Mat4 as model = math.mat.m4_mul(
        math.mat.m4_rotation_y(angle),
        math.mat.m4_rotation_x(angle * 0.5));
    let is math.mat.Mat4 as view = math.mat.m4_look_at(
        math.vec.v3(0.0, 0.0, 4.0), math.vec.v3_zero(), math.vec.v3_up());
    let is math.mat.Mat4 as proj = math.mat.m4_perspective(
        math.scalar.radians(60.0), aspect, 0.1, 100.0);
    return math.mat.m4_mul(proj, math.mat.m4_mul(view, model));
}

// --- The seam between the two layers ---
//
// gpu/ never imports window/, so it is this program that puts the two together.
// It hands the device a Surface carrying the window's native handles, and the
// window supplies both halves of the presentation path.
//
// There is nothing here to write any more. The earlier version of this file had
// a present_to_window() that copied the finished framebuffer into the window's
// buffer — a whole frame every frame, 1.17 MB at this size. The swapchain now
// draws into the window's buffer directly, so the copy is gone and so is the
// function that did it.
//
// A Vulkan backend would ignore both callbacks and present through
// vkQueuePresentKHR, which is why they are fields on the Surface rather than a
// requirement of it.

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);

    // An optional frame limit keeps the example runnable from a script.
    let is i64 as max_frames with mut = 0;
    if (env.argc() > 1) {
        let is *u8 as a = env.argv(1);
        let is i64 as n with mut = 0;
        let is i64 as i with mut = 0;
        while (a[i] >= 48 && a[i] <= 57) { n = n * 10 + cast(i64, a[i]) - 48; i = i + 1; }
        max_frames = n;
    }

    build_cube();

    let is x11.window.Window as win = x11.open("caustic-media — cube", WIDTH, HEIGHT);
    if (x11.is_open(&win) == 0) {
        io.printf("could not open a window: %s\n", x11.error_name(x11.last_error(&win)));
        return 1;
    }

    // The native handles are public contract in window/, which is what lets
    // this line exist without gpu/ ever importing window/.
    let is gpu.swapchain.Surface as surf = x11.surface_for_gpu_shared(&win);

    let is gpu.device.Device as d = gpu.open(&surf, gpu.AUTO);
    if (gpu.device.is_open(&d) == 0) {
        io.printf("could not open a device: %s\n", gpu.error_name(gpu.last_error(&d)));
        x11.close(&win);
        return 1;
    }
    io.printf("device: %s\n", gpu.caps(&d).name);

    // One swapchain image, however many the window keeps: the swapchain does
    // not own storage on this path, it borrows whichever buffer the window
    // hands out at acquire. x11.image_count(&win) says how many that is.
    let is i64 as sc = gpu.swapchain.create(&d, &surf, WIDTH, HEIGHT, 1);
    let is gpu.texture.Desc as dtd with mut = gpu.texture.desc(WIDTH, HEIGHT, gpu.texture.DEPTH,
                                                               gpu.texture.RENDER_TARGET);
    let is i64 as depth with mut = gpu.texture.create(&d, &dtd);

    let is i64 as vb = gpu.buffer.create(&d, sizeof(Vtx) * 36, gpu.buffer.VERTEX);
    gpu.buffer.upload(&d, vb, 0, cast(*u8, &cube_verts), sizeof(Vtx) * 36);

    let is i64 as sh = gpu.shader.builtin(&d, gpu.shader.UNLIT_COLOR);
    let is gpu.pipeline.Desc as pd = gpu.pipeline.desc_opaque(sh, gpu.pipeline.layout_pos_color());
    let is i64 as pl = gpu.pipeline.create(&d, &pd);
    let is i64 as cb = gpu.command.create(&d);

    if (sc == 0 || depth == 0 || vb == 0 || sh == 0 || pl == 0 || cb == 0) {
        io.printf("setup failed: %s\n", gpu.error_name(gpu.last_error(&d)));
        gpu.close(&d);
        x11.close(&win);
        return 1;
    }

    let is math.color.Color as bg = math.color.from_hex(0x101018);
    let is i64 as start = time.now_ns();
    let is i64 as frames with mut = 0;

    while (x11.next_frame(&win) == 1) {
        // A window manager decides how big a window is, and it is under no
        // obligation to grant what was asked for — a tiling compositor may
        // hand back 1366x768 for a 640x480 request, immediately. Following it
        // means remaking the swapchain and the depth buffer, since both were
        // sized for the window we did not get.
        if (x11.resized(&win) == 1) {
            if (gpu.swapchain.resize(&d, sc, x11.width(&win), x11.height(&win)) == 0) { break; }
            gpu.texture.destroy(&d, depth);
            dtd = gpu.texture.desc(x11.width(&win), x11.height(&win), gpu.texture.DEPTH,
                                   gpu.texture.RENDER_TARGET);
            depth = gpu.texture.create(&d, &dtd);
            if (depth == 0) { break; }
        }
        let is f64 as aspect = cast(f64, x11.width(&win)) / cast(f64, x11.height(&win));

        // Drive the angle from the clock, not the frame counter, so the cube
        // turns at the same rate whatever the frame rate turns out to be.
        let is f64 as elapsed = cast(f64, time.now_ns() - start) / 1000000000.0;

        let is i64 as img = gpu.swapchain.acquire(&d, sc);
        if (img < 0) { break; }
        let is i64 as color = gpu.swapchain.image(&d, sc, img);

        let is gpu.shader.BuiltinUniforms as un = gpu.shader.uniforms_mvp(cube_mvp(elapsed, aspect));

        gpu.command.begin(&d, cb);
        let is gpu.command.Pass as ps = gpu.command.pass(color, depth, bg);
        gpu.command.begin_pass(&d, cb, &ps);
        gpu.command.bind_pipeline(&d, cb, pl);
        gpu.command.bind_vertex_buffer(&d, cb, vb);
        gpu.command.set_uniforms(&d, cb, cast(*u8, &un), sizeof(gpu.shader.BuiltinUniforms));
        gpu.command.draw(&d, cb, 0, 36);
        gpu.command.end_pass(&d, cb);
        gpu.command.end(&d, cb);
        gpu.command.submit(&d, cb);

        gpu.swapchain.present(&d, sc);

        frames = frames + 1;
        if (max_frames > 0 && frames >= max_frames) { break; }
    }

    let is i64 as total_ns = time.now_ns() - start;

    gpu.command.destroy(&d, cb);
    gpu.pipeline.destroy(&d, pl);
    gpu.shader.destroy(&d, sh);
    gpu.buffer.destroy(&d, vb);
    gpu.texture.destroy(&d, depth);
    gpu.swapchain.destroy(&d, sc);
    gpu.close(&d);
    x11.close(&win);

    if (total_ns > 0) {
        io.printf("%d frames in %d ms\n", frames, total_ns / 1000000);
    }
    return 0;
}
