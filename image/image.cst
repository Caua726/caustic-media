// image/image.cst — hub for the image layer.
//
// Pixels on the CPU. An Image is memory the program owns, in a known format,
// that it can transform, generate, pack and hand to a GPU texture.

use "../math/color.cst" as color;
use "buffer.cst" as buffer;
use "generate.cst" as generate;
use "transform.cst" as transform;
use "atlas.cst" as atlas;

// --- Formats ---

let is i32 as RGBA8 with imut = 0;
let is i32 as RGB8  with imut = 1;
let is i32 as R8    with imut = 2;

fn bytes_per_pixel(format as i32) as i64 { return buffer.bytes_per_pixel(format); }

// --- Lifecycle ---

fn create(width as i64, height as i64, format as i32) as buffer.Image {
    return buffer.create(width, height, format);
}

fn from_memory(pixels as *u8, width as i64, height as i64, format as i32) as buffer.Image {
    return buffer.from_memory(pixels, width, height, format);
}

fn destroy(img as *buffer.Image) as void {
    buffer.destroy(img);
}

fn clone(src as *buffer.Image) as buffer.Image {
    return buffer.clone(src);
}

fn pixel_at(img as *buffer.Image, x as i64, y as i64) as *u8 {
    return buffer.pixel_at(img, x, y);
}

fn byte_count(img as *buffer.Image) as i64 {
    return buffer.byte_count(img);
}

// --- Procedural Generation ---

fn solid(width as i64, height as i64, c as color.Color) as buffer.Image {
    return generate.solid(width, height, c);
}

fn checkerboard(width as i64, height as i64, cell_size as i64,
                c1 as color.Color, c2 as color.Color) as buffer.Image {
    return generate.checkerboard(width, height, cell_size, c1, c2);
}

fn gradient_horizontal(width as i64, height as i64,
                       c1 as color.Color, c2 as color.Color) as buffer.Image {
    return generate.gradient_horizontal(width, height, c1, c2);
}

fn gradient_vertical(width as i64, height as i64,
                     c1 as color.Color, c2 as color.Color) as buffer.Image {
    return generate.gradient_vertical(width, height, c1, c2);
}

// --- Transformations ---

fn crop(src as *buffer.Image, x as i64, y as i64, w as i64, h as i64) as buffer.Image {
    return transform.crop(src, x, y, w, h);
}

fn flip_vertical(img as *buffer.Image) as void {
    transform.flip_vertical(img);
}

fn flip_horizontal(img as *buffer.Image) as void {
    transform.flip_horizontal(img);
}

fn resize_nearest(src as *buffer.Image, new_w as i64, new_h as i64) as buffer.Image {
    return transform.resize_nearest(src, new_w, new_h);
}

// --- Alpha and copying ---

fn premultiply(img as *buffer.Image) as i32 { return transform.premultiply(img); }
fn unpremultiply(img as *buffer.Image) as i32 { return transform.unpremultiply(img); }

fn copy(dst as *buffer.Image, dx as i64, dy as i64, src as *buffer.Image, sx as i64, sy as i64,
        w as i64, h as i64) as i32 {
    return transform.copy(dst, dx, dy, src, sx, sy, w, h);
}
