// image/image_test.cst — tests for the image layer.

use "std/io.cst" as io;
use "image.cst" as img;
use "../math/color.cst" as color;

fn main() as i32 {
    io.printf("testing image layer...\n");

    // 1. Creation and dimensions
    let is img.buffer.Image as im = img.create(100, 50, img.RGBA8);
    if (im.width != 100 || im.height != 50 || im.stride != 400) {
        io.printf("FAIL: create dimensions mismatch\n");
        return 1;
    }
    if (img.byte_count(&im) != 20000) {
        io.printf("FAIL: byte_count mismatch\n");
        return 2;
    }
    img.destroy(&im);
    if (cast(i64, im.pixels) != 0) {
        io.printf("FAIL: destroy did not clear pixels\n");
        return 3;
    }

    // 2. Solid image
    let is color.Color as red = color.rgb(1.0, 0.0, 0.0);
    let is img.buffer.Image as solid_im = img.solid(10, 10, red);
    let is *u8 as p0 = img.pixel_at(&solid_im, 0, 0);
    // In RGBA8: R=255, G=0, B=0, A=255
    if (p0[0] != 255 || p0[1] != 0 || p0[2] != 0 || p0[3] != 255) {
        io.printf("FAIL: solid pixel mismatch: got (%d,%d,%d,%d)\n",
                  cast(i64, p0[0]), cast(i64, p0[1]), cast(i64, p0[2]), cast(i64, p0[3]));
        img.destroy(&solid_im);
        return 4;
    }
    img.destroy(&solid_im);

    // 3. Checkerboard
    let is color.Color as black = color.rgb(0.0, 0.0, 0.0);
    let is color.Color as white = color.rgb(1.0, 1.0, 1.0);
    let is img.buffer.Image as chk = img.checkerboard(32, 32, 16, black, white);
    let is *u8 as top_left = img.pixel_at(&chk, 0, 0);
    let is *u8 as top_right = img.pixel_at(&chk, 20, 0);
    if (top_left[0] != 0 || top_right[0] != 255) {
        io.printf("FAIL: checkerboard cell colors wrong\n");
        img.destroy(&chk);
        return 5;
    }

    // 4. Crop
    let is img.buffer.Image as cropped = img.crop(&chk, 16, 0, 16, 16);
    if (cropped.width != 16 || cropped.height != 16) {
        io.printf("FAIL: crop dimensions wrong\n");
        img.destroy(&chk);
        img.destroy(&cropped);
        return 6;
    }
    let is *u8 as cp = img.pixel_at(&cropped, 0, 0);
    if (cp[0] != 255) {
        io.printf("FAIL: cropped content mismatch\n");
        img.destroy(&chk);
        img.destroy(&cropped);
        return 7;
    }
    img.destroy(&cropped);
    img.destroy(&chk);

    // 5. Resize nearest
    let is img.buffer.Image as sm = img.create(2, 2, img.RGBA8);
    *cast(*i32, img.pixel_at(&sm, 0, 0)) = 1111;
    *cast(*i32, img.pixel_at(&sm, 1, 0)) = 2222;
    *cast(*i32, img.pixel_at(&sm, 0, 1)) = 3333;
    *cast(*i32, img.pixel_at(&sm, 1, 1)) = 4444;

    let is img.buffer.Image as scaled = img.resize_nearest(&sm, 4, 4);
    if (scaled.width != 4 || scaled.height != 4) {
        io.printf("FAIL: resize_nearest dimensions\n");
        return 8;
    }
    if (*cast(*i32, img.pixel_at(&scaled, 0, 0)) != 1111 ||
        *cast(*i32, img.pixel_at(&scaled, 3, 3)) != 4444) {
        io.printf("FAIL: resize_nearest values mismatch\n");
        return 9;
    }
    img.destroy(&sm);
    img.destroy(&scaled);

    io.printf("image layer: all checks passed\n");
    return 0;
}
