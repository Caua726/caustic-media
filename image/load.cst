// image/load.cst — images decoded from files or memory, through
// caustic-image: PNG, JPEG, GIF, BMP, WebP, TIFF, ICO, QOI and PNM, by their
// content rather than their names.
//
// Opt-in, as image.md decides: the hub does not import this module, so a
// program that only makes or transforms images links no decoder. One that
// does is built with caustic-image and caustic-compact on its module path —
// caustic-mk fetches both, at their tags, for any target of this repository.
//
// An image comes back in the format here nearest to the file's: gray as R8,
// colour as RGB8, anything with transparency — gray and alpha, a palette with
// a transparent entry, RGBA — as RGBA8; 16-bit channels by their high byte,
// as caustic-image converts them. A failure is an Image with no pixels, and
// last_error() says why: caustic-image's negative code, or ERR_FILE.
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "caustic-image/decode.cst" as cdecode;
use "caustic-image/core/image.cst" as cimage;
use "caustic-image/core/pixfmt.cst" as pixfmt;
use "caustic-image/ops/ops.cst" as ops;
use "buffer.cst" as buffer;

// The file could not be opened or read.
let is i64 as ERR_FILE with imut = 0 - 1000;

let is i64 as _last with mut = 0;

// Why the last load failed, or 0 when it did not.
fn last_error() as i64 { return _last; }

fn _none(code as i64) as buffer.Image {
    _last = code;
    let is buffer.Image as im;
    im.pixels = cast(*u8, 0);
    im.width = 0;
    im.height = 0;
    im.stride = 0;
    im.format = buffer.RGBA8;
    im.borrowed = 0;
    return im;
}

// The decoded image in the nearest format here, copied into an Image of its
// own. Its size was checked as it was decoded, so it converts.
fn _adopt(src as *cimage.Image) as buffer.Image {
    let is i64 as ch = pixfmt.fmt_channels(src.fmt);
    let is i64 as want with mut = pixfmt.FMT_RGBA8;
    let is i32 as format with mut = buffer.RGBA8;
    if (ch == 1) { want = pixfmt.FMT_GRAY8; format = buffer.R8; }
    if (ch == 3) { want = pixfmt.FMT_RGB8; format = buffer.RGB8; }
    let is cimage.Image as conv;
    let is *cimage.Image as from with mut = src;
    if (src.fmt != want) {
        ops.op_convert(src, want, &conv);
        from = &conv;
    }
    let is buffer.Image as im = buffer.create(from.width, from.height, format);
    let is i64 as y with mut = 0;
    while (y < im.height) {
        mem.core.memcpy(cast(*u8, cast(i64, im.pixels) + y * im.stride),
                        cast(*u8, cast(i64, from.pixels) + y * from.stride), im.stride);
        y = y + 1;
    }
    if (src.fmt != want) { cimage.image_free(&conv); }
    _last = 0;
    return im;
}

// An image from len bytes at data.
fn bytes(data as *u8, len as i64) as buffer.Image {
    let is cimage.Image as decoded;
    let is i64 as rc = cdecode.decode(data, len, &decoded);
    if (rc < 0) { return _none(rc); }
    let is buffer.Image as im = _adopt(&decoded);
    cimage.image_free(&decoded);
    return im;
}

// An image from the file at path. What can be read of it is decoded: an
// empty file, or one cut short, is not an image.
fn file(path as *u8) as buffer.Image {
    let is i64 as fd = linux.open(path, 0, 0);
    if (fd < 0) { return _none(ERR_FILE); }
    let is [144]u8 as st;
    linux.fstat(fd, cast(*u8, &st));
    let is i64 as size = *cast(*i64, cast(i64, &st) + 48);
    let is *u8 as data = mem.core.mmap_anon(size);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < size) {
        r = linux.read(fd, cast(*u8, cast(i64, data) + n), size - n);
        if (r > 0) { n = n + r; }
    }
    linux.close(fd);
    let is buffer.Image as im = bytes(data, n);
    mem.core.munmap(data, size);
    return im;
}
