// image/transform_test.cst — colours times their alpha and back, and a
// rectangle of one image copied into another, cut to both.
use "std/io.cst" as io;
use "image.cst" as img;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn set4(im as *img.buffer.Image, x as i64, y as i64, r as i64, g as i64, b as i64, a as i64) as void {
    let is *u8 as p = img.pixel_at(im, x, y);
    p[0] = cast(u8, r);
    p[1] = cast(u8, g);
    p[2] = cast(u8, b);
    p[3] = cast(u8, a);
}

fn is4(im as *img.buffer.Image, x as i64, y as i64, r as i64, g as i64, b as i64, a as i64) as i32 {
    let is *u8 as p = img.pixel_at(im, x, y);
    if (cast(i64, p[0]) == r && cast(i64, p[1]) == g && cast(i64, p[2]) == b && cast(i64, p[3]) == a) { return 1; }
    io.printf("  (%d, %d, %d, %d)\n", cast(i64, p[0]), cast(i64, p[1]), cast(i64, p[2]), cast(i64, p[3]));
    return 0;
}

fn premultiplied() as void {
    let is img.buffer.Image as im = img.create(4, 2, img.RGBA8);
    set4(&im, 0, 0, 255, 128, 0, 128);
    set4(&im, 1, 0, 200, 100, 50, 0);
    set4(&im, 2, 0, 10, 20, 30, 255);
    set4(&im, 3, 0, 255, 255, 255, 1);
    set4(&im, 0, 1, 3, 2, 1, 2);
    set4(&im, 1, 1, 2, 0, 0, 192);
    check("premultiplied", img.premultiply(&im) == 1);
    // c a / 255, rounded.
    check("half", is4(&im, 0, 0, 128, 64, 0, 128) == 1);
    check("none", is4(&im, 1, 0, 0, 0, 0, 0) == 1);
    check("whole", is4(&im, 2, 0, 10, 20, 30, 255) == 1);
    check("the least", is4(&im, 3, 0, 1, 1, 1, 1) == 1);
    check("rounded down", is4(&im, 0, 1, 0, 0, 0, 2) == 1);
    check("rounded up", is4(&im, 1, 1, 2, 0, 0, 192) == 1);
    check("and back", img.unpremultiply(&im) == 1);
    // c 255 / a, rounded, no more than 255; nothing where alpha is 0.
    check("half, back", is4(&im, 0, 0, 255, 128, 0, 128) == 1);
    check("none, back", is4(&im, 1, 0, 0, 0, 0, 0) == 1);
    check("whole, back", is4(&im, 2, 0, 10, 20, 30, 255) == 1);
    check("the least, back", is4(&im, 3, 0, 255, 255, 255, 1) == 1);
    set4(&im, 0, 1, 200, 101, 0, 100);
    set4(&im, 1, 1, 5, 6, 7, 0);
    img.unpremultiply(&im);
    check("more than the alpha: 255", is4(&im, 0, 1, 255, 255, 0, 100) == 1);
    check("colour under no alpha: gone", is4(&im, 1, 1, 0, 0, 0, 0) == 1);
    img.destroy(&im);
    // Formats with no alpha are left as they are.
    let is img.buffer.Image as gray = img.create(2, 2, img.R8);
    *img.pixel_at(&gray, 0, 0) = 77;
    check("R8: not premultiplied", img.premultiply(&gray) == 0 && *img.pixel_at(&gray, 0, 0) == 77);
    check("R8: not unpremultiplied", img.unpremultiply(&gray) == 0 && *img.pixel_at(&gray, 0, 0) == 77);
    img.destroy(&gray);
}

fn copied() as void {
    let is img.buffer.Image as src = img.create(4, 4, img.RGBA8);
    let is i64 as y with mut = 0;
    while (y < 4) {
        let is i64 as x with mut = 0;
        while (x < 4) {
            set4(&src, x, y, x, y, 9, 255);
            x = x + 1;
        }
        y = y + 1;
    }
    let is img.buffer.Image as dst with mut = img.create(6, 6, img.RGBA8);
    // Wholly inside.
    check("copied", img.copy(&dst, 1, 2, &src, 1, 1, 2, 3) == 1);
    check("its first", is4(&dst, 1, 2, 1, 1, 9, 255) == 1);
    check("its last", is4(&dst, 2, 4, 2, 3, 9, 255) == 1);
    check("beside it, untouched", is4(&dst, 3, 2, 0, 0, 0, 0) == 1 && is4(&dst, 0, 2, 0, 0, 0, 0) == 1);
    check("below it", is4(&dst, 1, 5, 0, 0, 0, 0) == 1 && is4(&dst, 1, 1, 0, 0, 0, 0) == 1);
    img.destroy(&dst);
    // Past the destination's right and bottom: cut.
    dst = img.create(6, 6, img.RGBA8);
    img.copy(&dst, 4, 5, &src, 0, 0, 4, 4);
    check("cut at the right", is4(&dst, 5, 5, 1, 0, 9, 255) == 1 && is4(&dst, 4, 5, 0, 0, 9, 255) == 1);
    // Before its left and top: cut, and the source moved along with it.
    img.destroy(&dst);
    dst = img.create(6, 6, img.RGBA8);
    img.copy(&dst, 0 - 1, 0 - 2, &src, 0, 0, 4, 4);
    check("cut at the left and top", is4(&dst, 0, 0, 1, 2, 9, 255) == 1 && is4(&dst, 2, 1, 3, 3, 9, 255) == 1
          && is4(&dst, 3, 0, 0, 0, 0, 0) == 1 && is4(&dst, 0, 2, 0, 0, 0, 0) == 1);
    // Past the source: cut too.
    img.destroy(&dst);
    dst = img.create(6, 6, img.RGBA8);
    img.copy(&dst, 0, 0, &src, 2, 3, 5, 5);
    check("cut at the source's edge", is4(&dst, 1, 0, 3, 3, 9, 255) == 1 && is4(&dst, 2, 0, 0, 0, 0, 0) == 1
          && is4(&dst, 0, 1, 0, 0, 0, 0) == 1);
    img.destroy(&dst);
    dst = img.create(6, 6, img.RGBA8);
    img.copy(&dst, 0, 0, &src, 0 - 2, 0 - 1, 4, 4);
    check("from before the source", is4(&dst, 2, 1, 0, 0, 9, 255) == 1 && is4(&dst, 1, 1, 0, 0, 0, 0) == 1
          && is4(&dst, 2, 0, 0, 0, 0, 0) == 1 && is4(&dst, 3, 3, 1, 2, 9, 255) == 1);
    img.destroy(&dst);
    // Each cut the one that binds: from an image larger than the copy, into
    // a view of the first rows of a larger one, so that a row too many lands
    // where it shows.
    let is img.buffer.Image as big = img.create(8, 8, img.RGBA8);
    y = 0;
    while (y < 8) {
        let is i64 as x with mut = 0;
        while (x < 8) {
            set4(&big, x, y, x, y, 7, 255);
            x = x + 1;
        }
        y = y + 1;
    }
    let is img.buffer.Image as under with mut = img.create(6, 7, img.RGBA8);
    let is img.buffer.Image as view with mut = img.from_memory(under.pixels, 6, 6, img.RGBA8);
    img.copy(&view, 4, 1, &big, 0, 0, 4, 2);
    check("cut at the destination's right", is4(&under, 5, 1, 1, 0, 7, 255) == 1 && is4(&under, 0, 2, 0, 0, 0, 0) == 1);
    img.copy(&view, 0, 5, &big, 0, 0, 2, 4);
    check("cut at its bottom", is4(&under, 1, 5, 1, 0, 7, 255) == 1 && is4(&under, 0, 6, 0, 0, 0, 0) == 1);
    img.destroy(&under);
    under = img.create(6, 7, img.RGBA8);
    view = img.from_memory(under.pixels, 6, 6, img.RGBA8);
    img.copy(&view, 0, 0 - 2, &big, 0, 0, 1, 6);
    check("cut at its top", is4(&under, 0, 0, 0, 2, 7, 255) == 1 && is4(&under, 0, 3, 0, 5, 7, 255) == 1
          && is4(&under, 0, 4, 0, 0, 0, 0) == 1);
    img.copy(&view, 3, 0, &big, 0, 0 - 2, 1, 4);
    check("from before the source's top", is4(&under, 3, 2, 0, 0, 7, 255) == 1 && is4(&under, 3, 3, 0, 1, 7, 255) == 1
          && is4(&under, 3, 4, 0, 0, 0, 0) == 1 && is4(&under, 3, 1, 0, 0, 0, 0) == 1);
    img.destroy(&under);
    // A view of the first rows and columns of the source.
    let is img.buffer.Image as part with mut = img.from_memory(big.pixels, 4, 5, img.RGBA8);
    part.stride = big.stride;
    under = img.create(6, 7, img.RGBA8);
    img.copy(&under, 0, 0, &part, 2, 0, 4, 1);
    check("cut at the source's right", is4(&under, 1, 0, 3, 0, 7, 255) == 1 && is4(&under, 2, 0, 0, 0, 0, 0) == 1);
    img.copy(&under, 0, 2, &part, 0, 3, 1, 4);
    check("cut at its bottom too", is4(&under, 0, 3, 0, 4, 7, 255) == 1 && is4(&under, 0, 4, 0, 0, 0, 0) == 1);
    img.destroy(&under);
    img.destroy(&big);
    dst = img.create(6, 6, img.RGBA8);
    // Nothing to copy, or not alike.
    check("nothing", img.copy(&dst, 0, 0, &src, 0, 0, 0, 3) == 1);
    let is img.buffer.Image as gray = img.create(4, 4, img.R8);
    check("formats unlike", img.copy(&gray, 0, 0, &src, 0, 0, 2, 2) == 0 && *img.pixel_at(&gray, 0, 0) == 0);
    // One byte a pixel.
    *img.pixel_at(&gray, 3, 3) = 200;
    let is img.buffer.Image as g2 = img.create(2, 2, img.R8);
    check("R8", img.copy(&g2, 1, 1, &gray, 3, 3, 1, 1) == 1 && *img.pixel_at(&g2, 1, 1) == 200
          && *img.pixel_at(&g2, 0, 1) == 0);
    img.destroy(&g2);
    img.destroy(&gray);
    img.destroy(&dst);
    img.destroy(&src);
}

fn main() as i32 {
    premultiplied();
    copied();
    if (fails > 0) {
        io.printf("image transform: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("image transform: all checks passed\n");
    return 0;
}
