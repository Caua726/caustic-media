// image/generate.cst — procedural image generators.
//
// Procedural generation requires no disk access or codec, providing an immediate
// way to produce textures, test patterns and gradients.

use "../math/color.cst" as color;
use "buffer.cst" as buf;

fn solid(width as i64, height as i64, c as color.Color) as buf.Image {
    let is buf.Image as img = buf.create(width, height, buf.RGBA8);
    if (cast(i64, img.pixels) == 0) { return img; }

    let is i64 as packed = color.pack_rgba8(c);
    let is i32 as p32 = cast(i32, packed);

    let is i64 as total_pixels = width * height;
    let is *i32 as dst = cast(*i32, img.pixels);
    let is i64 as i with mut = 0;
    while (i < total_pixels) {
        dst[i] = p32;
        i = i + 1;
    }
    return img;
}

fn checkerboard(width as i64, height as i64, cell_size as i64,
                c1 as color.Color, c2 as color.Color) as buf.Image {
    let is buf.Image as img = buf.create(width, height, buf.RGBA8);
    if (cast(i64, img.pixels) == 0) { return img; }

    let is i64 as p1 = color.pack_rgba8(c1);
    let is i64 as p2 = color.pack_rgba8(c2);
    let is i32 as p1_32 = cast(i32, p1);
    let is i32 as p2_32 = cast(i32, p2);

    let is i64 as sz with mut = cell_size;
    if (sz <= 0) { sz = 16; }

    let is i64 as y with mut = 0;
    while (y < height) {
        let is i64 as row_cell = y / sz;
        let is *i32 as row = cast(*i32, cast(i64, img.pixels) + y * img.stride);
        let is i64 as x with mut = 0;
        while (x < width) {
            let is i64 as col_cell = x / sz;
            if (((row_cell + col_cell) & 1) == 0) {
                row[x] = p1_32;
            } else {
                row[x] = p2_32;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return img;
}

fn gradient_horizontal(width as i64, height as i64,
                       c1 as color.Color, c2 as color.Color) as buf.Image {
    let is buf.Image as img = buf.create(width, height, buf.RGBA8);
    if (cast(i64, img.pixels) == 0 || width <= 0) { return img; }

    let is i64 as x with mut = 0;
    while (x < width) {
        let is f64 as t = cast(f64, x) / cast(f64, width - 1);
        let is color.Color as c = color.col_lerp(c1, c2, t);
        let is i32 as p32 = cast(i32, color.pack_rgba8(c));

        let is i64 as y with mut = 0;
        while (y < height) {
            let is *i32 as row = cast(*i32, cast(i64, img.pixels) + y * img.stride);
            row[x] = p32;
            y = y + 1;
        }
        x = x + 1;
    }
    return img;
}

fn gradient_vertical(width as i64, height as i64,
                     c1 as color.Color, c2 as color.Color) as buf.Image {
    let is buf.Image as img = buf.create(width, height, buf.RGBA8);
    if (cast(i64, img.pixels) == 0 || height <= 0) { return img; }

    let is i64 as y with mut = 0;
    while (y < height) {
        let is f64 as t = cast(f64, y) / cast(f64, height - 1);
        let is color.Color as c = color.col_lerp(c1, c2, t);
        let is i32 as p32 = cast(i32, color.pack_rgba8(c));

        let is *i32 as row = cast(*i32, cast(i64, img.pixels) + y * img.stride);
        let is i64 as x with mut = 0;
        while (x < width) {
            row[x] = p32;
            x = x + 1;
        }
        y = y + 1;
    }
    return img;
}
