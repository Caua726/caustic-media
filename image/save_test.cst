// image/save_test.cst — images written as PNG (save.cst) and read back
// (load.cst): every pixel as it was, RGBA, RGB and grey; an image of no
// pixels refused. The RGBA one is left at build/save_test.png for another
// reader to check (image/tools/png_read.py, Pillow's).
use "std/io.cst" as io;
use "std/os/linux.cst" as linux;
use "caustic-compact/core/bytes.cst" as cb;
use "buffer.cst" as buffer;
use "load.cst" as load;
use "save.cst" as save;

let is i32 as fails with mut = 0;

fn check(what as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", what);
        fails = fails + 1;
    }
}

// A w by h image of format, each byte a function of where it is.
fn pattern(w as i64, h as i64, format as i32) as buffer.Image {
    let is buffer.Image as im = buffer.create(w, h, format);
    let is i64 as bpp = buffer.bytes_per_pixel(format);
    let is i64 as y with mut = 0;
    while (y < h) {
        let is i64 as x with mut = 0;
        while (x < w * bpp) {
            im.pixels[y * im.stride + x] = cast(u8, (x * 37 + y * 101 + x * y) % 256);
            x = x + 1;
        }
        y = y + 1;
    }
    return im;
}

// Whether a and b hold the same pixels.
fn same(a as *buffer.Image, b as *buffer.Image) as i32 {
    if (a.width != b.width || a.height != b.height || a.format != b.format) { return 0; }
    let is i64 as row = a.width * buffer.bytes_per_pixel(a.format);
    let is i64 as y with mut = 0;
    while (y < a.height) {
        let is i64 as x with mut = 0;
        while (x < row) {
            if (a.pixels[y * a.stride + x] != b.pixels[y * b.stride + x]) { return 0; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 1;
}

fn round_trip(format as i32, what as *u8) as void {
    let is buffer.Image as im = pattern(37, 23, format);
    let is cb.Bytes as out with mut = save.new_bytes();
    let is i64 as n = save.png(&im, &out);
    let is buffer.Image as back = load.bytes(out.ptr, out.len);
    check(what, n > 8 && out.ptr[1] == cast(u8, 80) && out.ptr[2] == cast(u8, 78) && out.ptr[3] == cast(u8, 71) &&
          same(&im, &back) == 1);
    if (format == buffer.RGBA8) {
        let is i64 as fd = linux.open("build/save_test.png", linux.O_WRONLY | linux.O_CREAT | linux.O_TRUNC, 420);
        if (fd >= 0) { linux.write(fd, out.ptr, out.len); linux.close(fd); }
    }
    save.free_bytes(&out);
    buffer.destroy(&back);
    buffer.destroy(&im);
}

fn main() as i32 {
    round_trip(buffer.RGBA8, "RGBA: written as a PNG, read back pixel for pixel");
    round_trip(buffer.RGB8, "RGB: the same");
    round_trip(buffer.R8, "grey: the same");
    let is buffer.Image as none = buffer.create(0, 0, buffer.RGBA8);
    let is cb.Bytes as out with mut = save.new_bytes();
    check("no pixels: refused", save.png(&none, &out) == save.ERR_EMPTY);
    save.free_bytes(&out);
    if (fails == 0) {
        io.printf("image save: all checks passed\n");
        return 0;
    }
    io.printf("image save: %d failures\n", fails);
    return 1;
}
