// image/transform.cst — pixel transformations: crop, flip, resize.

use "std/mem.cst" as mem;
use "buffer.cst" as buf;

fn crop(src as *buf.Image, x as i64, y as i64, w as i64, h as i64) as buf.Image {
    if (w <= 0 || h <= 0 || x < 0 || y < 0 || x + w > src.width || y + h > src.height) {
        let is buf.Image as empty;
        empty.pixels = cast(*u8, 0);
        empty.width = 0; empty.height = 0; empty.stride = 0;
        empty.format = src.format; empty.borrowed = 0;
        return empty;
    }

    let is buf.Image as dst = buf.create(w, h, src.format);
    let is i64 as bpp = buf.bytes_per_pixel(src.format);
    let is i64 as copy_bytes = w * bpp;

    let is i64 as row with mut = 0;
    while (row < h) {
        let is *u8 as s_ptr = cast(*u8, cast(i64, src.pixels) + (y + row) * src.stride + x * bpp);
        let is *u8 as d_ptr = cast(*u8, cast(i64, dst.pixels) + row * dst.stride);
        mem.core.memcpy(d_ptr, s_ptr, copy_bytes);
        row = row + 1;
    }
    return dst;
}

fn flip_vertical(img as *buf.Image) as void {
    if (cast(i64, img.pixels) == 0 || img.height <= 1) { return; }

    let is *u8 as temp = mem.core.mmap_anon(img.stride);
    let is i64 as top with mut = 0;
    let is i64 as bottom with mut = img.height - 1;

    while (top < bottom) {
        let is *u8 as p_top = cast(*u8, cast(i64, img.pixels) + top * img.stride);
        let is *u8 as p_bot = cast(*u8, cast(i64, img.pixels) + bottom * img.stride);

        mem.core.memcpy(temp, p_top, img.stride);
        mem.core.memcpy(p_top, p_bot, img.stride);
        mem.core.memcpy(p_bot, temp, img.stride);

        top = top + 1;
        bottom = bottom - 1;
    }
    mem.core.munmap(temp, img.stride);
}

fn flip_horizontal(img as *buf.Image) as void {
    if (cast(i64, img.pixels) == 0 || img.width <= 1) { return; }
    let is i64 as bpp = buf.bytes_per_pixel(img.format);

    let is i64 as y with mut = 0;
    while (y < img.height) {
        let is i64 as row_base = cast(i64, img.pixels) + y * img.stride;
        let is i64 as left with mut = 0;
        let is i64 as right with mut = img.width - 1;

        while (left < right) {
            let is i64 as p_left = row_base + left * bpp;
            let is i64 as p_right = row_base + right * bpp;

            if (bpp == 4) {
                let is i32 as tmp = *cast(*i32, p_left);
                *cast(*i32, p_left) = *cast(*i32, p_right);
                *cast(*i32, p_right) = tmp;
            } else {
                let is i64 as b with mut = 0;
                while (b < bpp) {
                    let is u8 as tb = *cast(*u8, p_left + b);
                    *cast(*u8, p_left + b) = *cast(*u8, p_right + b);
                    *cast(*u8, p_right + b) = tb;
                    b = b + 1;
                }
            }

            left = left + 1;
            right = right - 1;
        }
        y = y + 1;
    }
}

fn resize_nearest(src as *buf.Image, new_w as i64, new_h as i64) as buf.Image {
    if (new_w <= 0 || new_h <= 0 || src.width <= 0 || src.height <= 0) {
        let is buf.Image as empty;
        empty.pixels = cast(*u8, 0);
        empty.width = 0; empty.height = 0; empty.stride = 0;
        empty.format = src.format; empty.borrowed = 0;
        return empty;
    }

    let is buf.Image as dst = buf.create(new_w, new_h, src.format);
    let is i64 as bpp = buf.bytes_per_pixel(src.format);

    let is i64 as dy with mut = 0;
    while (dy < new_h) {
        let is i64 as sy = (dy * src.height) / new_h;
        let is i64 as dst_row = cast(i64, dst.pixels) + dy * dst.stride;
        let is i64 as src_row = cast(i64, src.pixels) + sy * src.stride;

        let is i64 as dx with mut = 0;
        while (dx < new_w) {
            let is i64 as sx = (dx * src.width) / new_w;
            let is *u8 as sp = cast(*u8, src_row + sx * bpp);
            let is *u8 as dp = cast(*u8, dst_row + dx * bpp);

            if (bpp == 4) {
                *cast(*i32, dp) = *cast(*i32, sp);
            } else {
                let is i64 as b with mut = 0;
                while (b < bpp) {
                    dp[b] = sp[b];
                    b = b + 1;
                }
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return dst;
}

// --- Alpha ---

// Each colour of an RGBA8 image times its alpha, c a / 255 rounded: what a
// premultiplied blend and filtering without dark fringes want. 1, or 0 for a
// format with no alpha, left as it is.
fn premultiply(img as *buf.Image) as i32 {
    if (img.format != buf.RGBA8) { return 0; }
    let is i64 as y with mut = 0;
    while (y < img.height) {
        let is i64 as row = cast(i64, img.pixels) + y * img.stride;
        let is i64 as x with mut = 0;
        while (x < img.width) {
            let is *u8 as p = cast(*u8, row + x * 4);
            let is i64 as a = cast(i64, p[3]);
            p[0] = cast(u8, (cast(i64, p[0]) * a + 127) / 255);
            p[1] = cast(u8, (cast(i64, p[1]) * a + 127) / 255);
            p[2] = cast(u8, (cast(i64, p[2]) * a + 127) / 255);
            x = x + 1;
        }
        y = y + 1;
    }
    return 1;
}

fn _unmul(c as i64, a as i64) as u8 {
    let is i64 as v = (c * 255 + a / 2) / a;
    if (v > 255) { return cast(u8, 255); }
    return cast(u8, v);
}

// The other way: each colour divided by its alpha, c 255 / a rounded and no
// more than 255; a pixel of no alpha is all 0, its colour gone. 1, or 0 for a
// format with no alpha.
fn unpremultiply(img as *buf.Image) as i32 {
    if (img.format != buf.RGBA8) { return 0; }
    let is i64 as y with mut = 0;
    while (y < img.height) {
        let is i64 as row = cast(i64, img.pixels) + y * img.stride;
        let is i64 as x with mut = 0;
        while (x < img.width) {
            let is *u8 as p = cast(*u8, row + x * 4);
            let is i64 as a = cast(i64, p[3]);
            if (a == 0) {
                p[0] = 0;
                p[1] = 0;
                p[2] = 0;
            } else {
                p[0] = _unmul(cast(i64, p[0]), a);
                p[1] = _unmul(cast(i64, p[1]), a);
                p[2] = _unmul(cast(i64, p[2]), a);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return 1;
}

// --- Copying ---

// The w by h rectangle of src at (sx, sy) copied into dst at (dx, dy), what
// falls outside either image left out. 1, or 0 when the two are of different
// formats, with nothing copied.
fn copy(dst as *buf.Image, dx as i64, dy as i64, src as *buf.Image, sx as i64, sy as i64,
        w as i64, h as i64) as i32 {
    if (dst.format != src.format) { return 0; }
    let is i64 as x0 with mut = dx;
    let is i64 as y0 with mut = dy;
    let is i64 as u0 with mut = sx;
    let is i64 as v0 with mut = sy;
    let is i64 as cw with mut = w;
    let is i64 as ch with mut = h;
    // Cut at both images' left and top, moving the other corner along.
    if (x0 < 0) { u0 = u0 - x0; cw = cw + x0; x0 = 0; }
    if (y0 < 0) { v0 = v0 - y0; ch = ch + y0; y0 = 0; }
    if (u0 < 0) { x0 = x0 - u0; cw = cw + u0; u0 = 0; }
    if (v0 < 0) { y0 = y0 - v0; ch = ch + v0; v0 = 0; }
    // And at their right and bottom.
    if (x0 + cw > dst.width) { cw = dst.width - x0; }
    if (y0 + ch > dst.height) { ch = dst.height - y0; }
    if (u0 + cw > src.width) { cw = src.width - u0; }
    if (v0 + ch > src.height) { ch = src.height - v0; }
    if (cw <= 0 || ch <= 0) { return 1; }   // nothing, or less
    let is i64 as bpp = buf.bytes_per_pixel(src.format);
    let is i64 as row with mut = 0;
    while (row < ch) {
        mem.core.memcpy(cast(*u8, cast(i64, dst.pixels) + (y0 + row) * dst.stride + x0 * bpp),
                        cast(*u8, cast(i64, src.pixels) + (v0 + row) * src.stride + u0 * bpp), cw * bpp);
        row = row + 1;
    }
    return 1;
}
