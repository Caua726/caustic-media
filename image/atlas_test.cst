// image/atlas_test.cst — rectangles packed into pages: where each lands,
// that none overlaps another or leaves its page, pages opened as they fill and
// reused whole, least recently used first, when the last is full — and the
// rectangles that cannot be placed said so, never dropped.
use "std/io.cst" as io;
use "std/mem.cst" as mem;
use "image.cst" as img;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn at(s as *img.atlas.Slot, page as i64, x as i64, y as i64) as i32 {
    if (s.page == page && s.x == x && s.y == y) { return 1; }
    io.printf("  landed on page %d at %d,%d\n", s.page, s.x, s.y);
    return 0;
}

// Bottom-left: lowest first, then leftmost.
fn placement() as void {
    let is img.atlas.Atlas as a with mut = img.atlas.open(16, 16, img.R8, 1);
    check("an atlas", img.atlas.ok(&a) == 1);
    let is img.atlas.Slot as s;
    check("8x4", img.atlas.alloc(&a, 8, 4, &s) == img.atlas.PLACED && at(&s, 0, 0, 0) == 1);
    check("8x6 beside it", img.atlas.alloc(&a, 8, 6, &s) == img.atlas.PLACED && at(&s, 0, 8, 0) == 1);
    check("4x4 on the lower", img.atlas.alloc(&a, 4, 4, &s) == img.atlas.PLACED && at(&s, 0, 0, 4) == 1);
    check("4x2 beside it", img.atlas.alloc(&a, 4, 2, &s) == img.atlas.PLACED && at(&s, 0, 4, 4) == 1);
    // The skyline is now 0-4 at 8, 4-8 at 6, 8-16 at 6: twelve wide at 6.
    check("12x3 across two", img.atlas.alloc(&a, 12, 3, &s) == img.atlas.PLACED && at(&s, 0, 4, 6) == 1);
    check("16 wide: above all", img.atlas.alloc(&a, 16, 2, &s) == img.atlas.PLACED && at(&s, 0, 0, 9) == 1);
    check("the rest", img.atlas.alloc(&a, 16, 5, &s) == img.atlas.PLACED && at(&s, 0, 0, 11) == 1);
    check("full", img.atlas.alloc(&a, 1, 1, &s) == img.atlas.NO_ROOM);
    check("larger than a page", img.atlas.alloc(&a, 17, 1, &s) == img.atlas.NEVER);
    check("taller", img.atlas.alloc(&a, 1, 17, &s) == img.atlas.NEVER);
    check("no width", img.atlas.alloc(&a, 0, 1, &s) == img.atlas.NEVER);
    check("no height", img.atlas.alloc(&a, 1, 0, &s) == img.atlas.NEVER);
    check("negative", img.atlas.alloc(&a, 0 - 3, 1, &s) == img.atlas.NEVER);
    img.atlas.close(&a);
    // A rectangle as large as the page.
    a = img.atlas.open(16, 16, img.R8, 1);
    check("a whole page", img.atlas.alloc(&a, 16, 16, &s) == img.atlas.PLACED && at(&s, 0, 0, 0) == 1);
    img.atlas.close(&a);
    // Lower beats leftmost: a gap on the right lower than the left.
    a = img.atlas.open(16, 16, img.R8, 1);
    img.atlas.alloc(&a, 6, 5, &s);
    img.atlas.alloc(&a, 6, 3, &s);
    img.atlas.alloc(&a, 4, 1, &s);
    check("the lowest place, though to the right", img.atlas.alloc(&a, 4, 2, &s) == img.atlas.PLACED && at(&s, 0, 12, 1) == 1);
    check("then the next lowest", img.atlas.alloc(&a, 6, 2, &s) == img.atlas.PLACED && at(&s, 0, 6, 3) == 1);
    img.atlas.close(&a);
    // Of two places equally low, the leftmost: the skyline 0-4 at 2, 4-8 at
    // 5, 8-16 at 2.
    a = img.atlas.open(16, 16, img.R8, 1);
    img.atlas.alloc(&a, 4, 2, &s);
    img.atlas.alloc(&a, 4, 5, &s);
    check("the right-hand low", img.atlas.alloc(&a, 8, 2, &s) == img.atlas.PLACED && at(&s, 0, 8, 0) == 1);
    check("equally low: leftmost", img.atlas.alloc(&a, 2, 1, &s) == img.atlas.PLACED && at(&s, 0, 0, 2) == 1);
    img.atlas.close(&a);
}

// Pages, as they fill; and reused, least recently used first.
fn pages() as void {
    let is img.atlas.Atlas as a with mut = img.atlas.open(8, 8, img.RGBA8, 3);
    let is img.atlas.Slot as s;
    let is img.atlas.Slot as first;
    check("first page", img.atlas.alloc(&a, 8, 8, &first) == img.atlas.PLACED && at(&first, 0, 0, 0) == 1);
    check("a second", img.atlas.alloc(&a, 8, 4, &s) == img.atlas.PLACED && at(&s, 1, 0, 0) == 1);
    check("and its rest", img.atlas.alloc(&a, 8, 4, &s) == img.atlas.PLACED && at(&s, 1, 0, 4) == 1);
    let is img.atlas.Slot as second = s;
    check("a third", img.atlas.alloc(&a, 5, 5, &s) == img.atlas.PLACED && at(&s, 2, 0, 0) == 1);
    let is img.atlas.Slot as third = s;
    check("its image", img.atlas.page(&a, 2).width == 8 && img.atlas.page(&a, 2).format == img.RGBA8);
    check("pages", img.atlas.pages(&a) == 3);
    // Every page used this frame: no room, and nothing taken.
    check("all in use", img.atlas.alloc(&a, 8, 8, &s) == img.atlas.NO_ROOM);
    check("still valid", img.atlas.valid(&a, &first) == 1 && img.atlas.valid(&a, &second) == 1);
    // Frame 1: page 0 used again. Pages 1 and 2 were last used in frame 0
    // alike: the first of them is taken.
    img.atlas.next_frame(&a);
    img.atlas.touch(&a, &first);
    let is img.atlas.Slot as again;
    check("page 1 reused", img.atlas.alloc(&a, 8, 8, &again) == img.atlas.PLACED && at(&again, 1, 0, 0) == 1);
    check("what was on it, gone", img.atlas.valid(&a, &second) == 0);
    check("what was elsewhere, not", img.atlas.valid(&a, &first) == 1 && img.atlas.valid(&a, &third) == 1);
    check("a slot of the new", img.atlas.valid(&a, &again) == 1);
    // Frame 2: page 1 used. Of page 0, used in frame 1, and page 2, in
    // frame 0, page 2 is the least recent — though it comes after.
    img.atlas.next_frame(&a);
    img.atlas.touch(&a, &again);
    check("the least recent", img.atlas.alloc(&a, 8, 8, &s) == img.atlas.PLACED && at(&s, 2, 0, 0) == 1);
    check("page 2's gone", img.atlas.valid(&a, &third) == 0 && img.atlas.valid(&a, &first) == 1);
    check("then page 0", img.atlas.alloc(&a, 8, 8, &s) == img.atlas.PLACED && at(&s, 0, 0, 0) == 1);
    check("page 0's gone", img.atlas.valid(&a, &first) == 0);
    check("then none: all used this frame", img.atlas.alloc(&a, 1, 1, &s) == img.atlas.NO_ROOM);
    // A slot past the pages, or of a page not made.
    let is img.atlas.Slot as bogus = first;
    bogus.page = 7;
    check("a page not made", img.atlas.valid(&a, &bogus) == 0);
    bogus.page = 0 - 1;
    check("a page before the first", img.atlas.valid(&a, &bogus) == 0);
    img.atlas.touch(&a, &bogus);
    img.atlas.close(&a);
    // A touch of a slot that is gone does not keep its page: two pages, the
    // first taken in frame 1, touched by its old slot in frame 2 — and still
    // the first taken, the two having been used in frame 1 alike.
    a = img.atlas.open(8, 8, img.R8, 2);
    let is img.atlas.Slot as old;
    let is img.atlas.Slot as other;
    img.atlas.alloc(&a, 8, 8, &old);
    img.atlas.alloc(&a, 8, 8, &other);
    img.atlas.next_frame(&a);
    img.atlas.touch(&a, &other);
    check("page 0 taken", img.atlas.alloc(&a, 8, 8, &s) == img.atlas.PLACED && at(&s, 0, 0, 0) == 1);
    img.atlas.next_frame(&a);
    img.atlas.touch(&a, &old);
    check("taken again, the old slot's touch notwithstanding",
          img.atlas.alloc(&a, 8, 8, &s) == img.atlas.PLACED && at(&s, 0, 0, 0) == 1 && img.atlas.valid(&a, &other) == 1);
    img.atlas.close(&a);
    // A page before the first reads as none, whatever lies before the
    // records: here, page 0's era, 2.
    let is img.atlas.Region as r;
    check("dirty: a page before the first", img.atlas.dirty(&a, 0 - 1, &r) == 0);
    img.atlas.close(&a);
    a = img.atlas.open(8, 8, img.R8, 2);
    img.atlas.alloc(&a, 8, 8, &old);
    let is img.atlas.Slot as before = old;
    before.page = 0 - 1;
    check("valid: a page before the first", img.atlas.valid(&a, &before) == 0);
    img.atlas.close(&a);
    // An atlas of no pages, or of pages of no size.
    let is img.atlas.Atlas as none with mut = img.atlas.open(8, 8, img.R8, 0);
    check("no pages: none", img.atlas.ok(&none) == 0);
    check("no pages: nothing placed", img.atlas.alloc(&none, 1, 1, &s) == img.atlas.NO_ROOM);
    img.atlas.close(&none);
    none = img.atlas.open(0, 8, img.R8, 2);
    check("pages of no width: none", img.atlas.ok(&none) == 0);
    img.atlas.close(&none);
    none = img.atlas.open(8, 0, img.R8, 2);
    check("pages of no height: none", img.atlas.ok(&none) == 0);
    img.atlas.close(&none);
}

// What changed since the page was last uploaded.
fn dirty() as void {
    let is img.atlas.Atlas as a with mut = img.atlas.open(32, 32, img.R8, 2);
    let is img.atlas.Slot as s;
    let is img.atlas.Region as r;
    check("clean at first", img.atlas.dirty(&a, 0, &r) == 0);
    img.atlas.alloc(&a, 4, 3, &s);
    img.atlas.alloc(&a, 6, 5, &s);
    check("dirty", img.atlas.dirty(&a, 0, &r) == 1 && r.x == 0 && r.y == 0 && r.w == 10 && r.h == 5);
    img.atlas.clean(&a, 0);
    check("cleaned", img.atlas.dirty(&a, 0, &r) == 0);
    img.atlas.alloc(&a, 7, 2, &s);
    check("only what came after", img.atlas.dirty(&a, 0, &r) == 1 && r.x == 10 && r.y == 0 && r.w == 7 && r.h == 2);
    img.atlas.alloc(&a, 2, 9, &s);
    check("grown to hold both", img.atlas.dirty(&a, 0, &r) == 1 && r.x == 10 && r.y == 0 && r.w == 9 && r.h == 9);
    check("another page: clean", img.atlas.dirty(&a, 1, &r) == 0 && img.atlas.dirty(&a, 5, &r) == 0);
    img.atlas.close(&a);
    // Grown upward: the first placed after cleaning lies below the next.
    a = img.atlas.open(16, 16, img.R8, 1);
    img.atlas.alloc(&a, 12, 5, &s);
    img.atlas.clean(&a, 0);
    img.atlas.alloc(&a, 8, 1, &s);
    check("at 0,5", s.x == 0 && s.y == 5 && img.atlas.dirty(&a, 0, &r) == 1 && r.y == 5);
    img.atlas.alloc(&a, 4, 1, &s);
    check("grown up to 12,0", s.x == 12 && s.y == 0 && img.atlas.dirty(&a, 0, &r) == 1
          && r.x == 0 && r.y == 0 && r.w == 16 && r.h == 6);
    // And leftward.
    img.atlas.clean(&a, 0);
    img.atlas.alloc(&a, 4, 3, &s);
    img.atlas.alloc(&a, 4, 1, &s);
    check("at 12,4", s.x == 12 && s.y == 4);
    img.atlas.alloc(&a, 4, 1, &s);
    check("grown left to 8,5", s.x == 8 && s.y == 5 && img.atlas.dirty(&a, 0, &r) == 1
          && r.x == 8 && r.y == 1 && r.w == 8 && r.h == 5);
    img.atlas.close(&a);
}

// Many rectangles of many sizes: none overlapping, none outside its page,
// and as many placed as fit.
let is u64 as seed with mut = 12345;
fn rnd(n as i64) as i64 {
    seed = seed * 6364136223846793005 + 1442695040888963407;
    return cast(i64, (seed >> 33) % cast(u64, n));
}

fn many() as void {
    let is img.atlas.Atlas as a with mut = img.atlas.open(128, 128, img.R8, 4);
    let is *u8 as owner = mem.core.mmap_anon(4 * 128 * 128);
    let is img.atlas.Slot as s;
    let is i64 as placed with mut = 0;
    let is i64 as area with mut = 0;
    let is i32 as ok with mut = 1;
    let is i64 as k with mut = 0;
    while (k < 3000) {
        let is i64 as w = 1 + rnd(24);
        let is i64 as h = 1 + rnd(24);
        let is i32 as r = img.atlas.alloc(&a, w, h, &s);
        if (r == img.atlas.PLACED) {
            if (s.x < 0 || s.y < 0 || s.x + w > 128 || s.y + h > 128 || s.page < 0 || s.page >= 4) { ok = 0; }
            let is i64 as y with mut = 0;
            while (y < h && ok == 1) {
                let is i64 as x with mut = 0;
                while (x < w) {
                    let is *u8 as cell = cast(*u8, cast(i64, owner) + s.page * 16384 + (s.y + y) * 128 + s.x + x);
                    if (*cell != 0) { ok = 0; }
                    *cell = 1;
                    x = x + 1;
                }
                y = y + 1;
            }
            placed = placed + 1;
            area = area + w * h;
        }
        k = k + 1;
    }
    check("none overlapping, none outside", ok);
    // Four pages of 16384 pixels; the skyline leaves gaps under what it
    // places, but not a sixth of them.
    check("most of the pages used", area > 4 * 16384 * 85 / 100);
    check("and then no room", placed < 3000);
    io.printf("  %d placed, %d of %d pixels\n", placed, area, 4 * 16384);
    img.atlas.close(&a);
}

fn main() as i32 {
    placement();
    pages();
    dirty();
    many();
    if (fails > 0) {
        io.printf("atlas: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("atlas: all checks passed\n");
    return 0;
}
