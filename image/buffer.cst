// image/buffer.cst — Image struct, pixel buffer ownership and formats.
//
// An Image represents pixel data in CPU memory. It can own its storage
// (allocated via anonymous mmap) or borrow it (wrapping memory supplied by
// the caller or mapped from another resource).

use "std/mem.cst" as mem;

// --- Formats ---

let is i32 as RGBA8 with imut = 0;   // 4 bytes per pixel: R, G, B, A (32-bit)
let is i32 as RGB8  with imut = 1;   // 3 bytes per pixel: R, G, B
let is i32 as R8    with imut = 2;   // 1 byte per pixel (monochrome / alpha)

fn bytes_per_pixel(format as i32) as i64 {
    if (format == RGBA8) { return 4; }
    if (format == RGB8)  { return 3; }
    if (format == R8)    { return 1; }
    return 4;
}

// --- Image Struct ---

struct Image {
    pixels   as *u8;
    width    as i64;
    height   as i64;
    stride   as i64;
    format   as i32;
    borrowed as i32;
}

fn byte_count(img as *Image) as i64 {
    return img.stride * img.height;
}

// Allocates owned memory for an Image.
fn create(width as i64, height as i64, format as i32) as Image {
    let is Image as img;
    img.width = width;
    img.height = height;
    img.format = format;
    img.stride = width * bytes_per_pixel(format);
    img.borrowed = 0;

    let is i64 as total = img.stride * height;
    if (total <= 0) {
        img.pixels = cast(*u8, 0);
        return img;
    }

    img.pixels = mem.core.mmap_anon(total);
    mem.core.memzero(img.pixels, total);
    return img;
}

// Wraps existing memory without copying.
fn from_memory(pixels as *u8, width as i64, height as i64, format as i32) as Image {
    let is Image as img;
    img.pixels = pixels;
    img.width = width;
    img.height = height;
    img.format = format;
    img.stride = width * bytes_per_pixel(format);
    img.borrowed = 1;
    return img;
}

// Frees owned memory. Borrowed images are left untouched.
fn destroy(img as *Image) as void {
    if (img.borrowed == 0 && cast(i64, img.pixels) != 0) {
        let is i64 as total = byte_count(img);
        if (total > 0) {
            mem.core.munmap(img.pixels, total);
        }
    }
    img.pixels = cast(*u8, 0);
    img.width = 0;
    img.height = 0;
    img.stride = 0;
}

fn pixel_at(img as *Image, x as i64, y as i64) as *u8 {
    if (x < 0 || x >= img.width || y < 0 || y >= img.height) {
        return cast(*u8, 0);
    }
    let is i64 as bpp = bytes_per_pixel(img.format);
    return cast(*u8, cast(i64, img.pixels) + y * img.stride + x * bpp);
}

fn clone(src as *Image) as Image {
    let is Image as dst = create(src.width, src.height, src.format);
    if (cast(i64, dst.pixels) != 0 && cast(i64, src.pixels) != 0) {
        let is i64 as total = byte_count(src);
        mem.core.memcpy(dst.pixels, src.pixels, total);
    }
    return dst;
}
