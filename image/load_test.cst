// image/load_test.cst — images decoded through caustic-image, into this
// layer's Image: each PNG colour type of image/testdata (written by
// image/tools/make_pngs.py, pixels known to the byte) in the nearest format
// here, 16-bit channels by their high byte; and what is not an image refused.
//
// Built by caustic-mk (target load_test), which fetches caustic-image and
// caustic-compact at their tags. Run from the repository's root.
use "std/io.cst" as io;
use "image.cst" as img;
use "load.cst" as load;
use "std/mem.cst" as mem;
use "std/os/linux.cst" as linux;
use "caustic-image/encode.cst" as cencode;
use "caustic-image/core/image.cst" as cimage;
use "caustic-image/core/pixfmt.cst" as pixfmt;
use "caustic-image/core/sniff.cst" as sniff;
use "caustic-compact/core/bytes.cst" as cb;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn px(im as *img.buffer.Image, x as i64, y as i64, c as i64) as i64 {
    return cast(i64, *cast(*u8, cast(i64, img.pixel_at(im, x, y)) + c));
}

fn rgba(im as *img.buffer.Image, x as i64, y as i64, r as i64, g as i64, b as i64, a as i64) as i32 {
    if (px(im, x, y, 0) == r && px(im, x, y, 1) == g && px(im, x, y, 2) == b && px(im, x, y, 3) == a) { return 1; }
    io.printf("  at %d,%d: (%d, %d, %d, %d)\n", x, y, px(im, x, y, 0), px(im, x, y, 1), px(im, x, y, 2), px(im, x, y, 3));
    return 0;
}

fn rgb(im as *img.buffer.Image, x as i64, y as i64, r as i64, g as i64, b as i64) as i32 {
    if (px(im, x, y, 0) == r && px(im, x, y, 1) == g && px(im, x, y, 2) == b) { return 1; }
    return 0;
}

fn sized(im as *img.buffer.Image, format as i32) as i32 {
    if (cast(i64, im.pixels) != 0 && im.width == 3 && im.height == 2 && im.format == format
        && im.stride == 3 * img.bytes_per_pixel(format) && im.borrowed == 0) { return 1; }
    return 0;
}

// The file's bytes, in memory of their own (*len set), or 0.
fn slurp(path as *u8, len as *i64) as *u8 {
    let is i64 as fd = linux.open(path, 0, 0);
    if (fd < 0) { return cast(*u8, 0); }
    let is *u8 as data = mem.core.mmap_anon(65536);
    let is i64 as n = linux.read(fd, data, 65536);
    linux.close(fd);
    *len = n;
    return data;
}

fn same(a as *img.buffer.Image, b as *img.buffer.Image) as i32 {
    if (a.width != b.width || a.height != b.height || a.format != b.format || a.stride != b.stride) { return 0; }
    if (cast(i64, a.pixels) == 0 || cast(i64, b.pixels) == 0) { return 0; }
    return cast(i32, mem.core.memcmp(a.pixels, b.pixels, a.stride * a.height) == 0);
}

// In the background: what bytes() gives, several at a time; the bytes the
// caller's again as soon as start returns; refused and cancelled ones.
fn jobs() as void {
    let is [4]*u8 as names;
    names[0] = "image/testdata/gray.png";
    names[1] = "image/testdata/rgb.png";
    names[2] = "image/testdata/rgba16.png";
    names[3] = "image/testdata/palette.png";
    let is [4]load.Job as js;
    let is [4]img.buffer.Image as want;
    let is i32 as k with mut = 0;
    while (k < 4) {
        let is i64 as n with mut = 0;
        let is *u8 as data = slurp(names[k], &n);
        want[k] = load.bytes(data, n);
        check("started", load.start(&js[k], data, n) == 1);
        // Its bytes overwritten at once: the Job decodes its own copy.
        mem.core.memset(data, 0, n);
        mem.core.munmap(data, 65536);
        k = k + 1;
    }
    k = 0;
    while (k < 4) {
        let is img.buffer.Image as got with mut = load.take(&js[k]);
        check("in the background: as bytes() decodes it", same(&got, &want[k]) == 1 && load.error(&js[k]) == 0);
        check("taken: not done till started again", load.done(&js[k]) == 0);
        img.buffer.destroy(&got);
        img.buffer.destroy(&want[k]);
        k = k + 1;
    }
    let is load.Job as bad with mut;
    load.start(&bad, cast(*u8, "not an image at all"), 19);
    let is img.buffer.Image as none with mut = load.take(&bad);
    check("refused: no pixels, and why", cast(i64, none.pixels) == 0 && load.error(&bad) < 0);
    load.start(&bad, cast(*u8, "GIF89a"), 0);
    none = load.take(&bad);
    check("no bytes: refused", cast(i64, none.pixels) == 0 && load.error(&bad) < 0);
    let is i64 as n2 with mut = 0;
    let is *u8 as d2 = slurp("image/testdata/rgba.png", &n2);
    load.start(&bad, d2, n2);
    load.cancel(&bad);
    check("cancelled: nothing left, may start again", load.done(&bad) == 0 && cast(i64, bad.result.pixels) == 0);
    load.start(&bad, d2, n2);
    while (load.done(&bad) == 0) { }
    let is img.buffer.Image as late = load.take(&bad);
    check("done, then taken without waiting", sized(&late, img.RGBA8) == 1);
    img.buffer.destroy(&late);
    mem.core.munmap(d2, 65536);
}

// A 192 x 192 picture, seeded, as a JPEG into out.
fn jpeg(seed as i64, out as *cb.Bytes) as void {
    let is img.buffer.Image as im = img.buffer.create(192, 192, img.RGB8);
    let is i64 as y with mut = 0;
    while (y < 192) {
        let is i64 as x with mut = 0;
        while (x < 192) {
            let is *u8 as px = cast(*u8, cast(i64, im.pixels) + y * im.stride + x * 3);
            px[0] = cast(u8, (x * seed + y) & 255);
            px[1] = cast(u8, (y * seed * 3 + x * x) & 255);
            px[2] = cast(u8, ((x ^ y) * seed) & 255);
            x = x + 1;
        }
        y = y + 1;
    }
    let is cimage.Image as view;
    view.pixels = im.pixels;
    view.width = im.width;
    view.height = im.height;
    view.stride = im.stride;
    view.fmt = pixfmt.FMT_RGB8;
    view.owned = 0;
    out.len = 0;
    cencode.encode(&view, sniff.SNIFF_JPEG, out);
    img.buffer.destroy(&im);
}

// JPEGs, whose decoder keeps its tables in module variables, eight at once:
// each as it decodes alone — the lock keeps them one at a time.
fn jpegs() as void {
    let is [2]cb.Bytes as files;
    let is [2]img.buffer.Image as want;
    let is i32 as k with mut = 0;
    while (k < 2) {
        files[k] = cb.bytes_new(0);
        jpeg(cast(i64, k * 5 + 3), &files[k]);
        want[k] = load.bytes(files[k].ptr, files[k].len);
        check("a JPEG made and read", want[k].width == 192 && load.last_error() == 0);
        k = k + 1;
    }
    check("two pictures apart", same(&want[0], &want[1]) == 0);
    let is [8]load.Job as js;
    k = 0;
    while (k < 8) { load.start(&js[k], files[k & 1].ptr, files[k & 1].len); k = k + 1; }
    let is i32 as alike with mut = 0;
    k = 0;
    while (k < 8) {
        let is img.buffer.Image as got with mut = load.take(&js[k]);
        alike = alike + same(&got, &want[k & 1]);
        img.buffer.destroy(&got);
        k = k + 1;
    }
    if (alike != 8) { io.printf("  %d of 8 alike\n", alike); }
    check("eight JPEGs at once: each as decoded alone", alike == 8);
    // Cut short — at a half, at its header — and cut to random bytes: no
    // pixels, a reason, nothing read past what was given.
    let is load.Job as cut with mut;
    load.start(&cut, files[0].ptr, files[0].len / 2);
    let is img.buffer.Image as half with mut = load.take(&cut);
    check("a JPEG cut in half: no pixels and why, or the part it holds", (cast(i64, half.pixels) == 0 && load.error(&cut) < 0) ||
          (half.width == 192 && load.error(&cut) == 0));
    img.buffer.destroy(&half);
    load.start(&cut, files[1].ptr, 20);
    half = load.take(&cut);
    check("a JPEG cut at its header: no pixels and why", cast(i64, half.pixels) == 0 && load.error(&cut) < 0);
    let is [600]u8 as noise;
    let is i64 as ni with mut = 0;
    while (ni < 600) { noise[ni] = cast(u8, (ni * 131 + 7) & 255); ni = ni + 1; }
    noise[0] = cast(u8, 0xFF); noise[1] = cast(u8, 0xD8); noise[2] = cast(u8, 0xFF);
    load.start(&cut, cast(*u8, &noise), 600);
    half = load.take(&cut);
    check("a JPEG's first bytes, then noise: refused", cast(i64, half.pixels) == 0 && load.error(&cut) < 0);
    // Cancelled while others decode: it waits its turn or its decode, and
    // leaves nothing; the rest are as decoded alone.
    let is [4]load.Job as more;
    k = 0;
    while (k < 4) { load.start(&more[k], files[k & 1].ptr, files[k & 1].len); k = k + 1; }
    load.cancel(&more[1]);
    load.cancel(&more[2]);
    let is img.buffer.Image as m0 with mut = load.take(&more[0]);
    let is img.buffer.Image as m3 with mut = load.take(&more[3]);
    check("two of four cancelled: the others as decoded alone", same(&m0, &want[0]) == 1 && same(&m3, &want[1]) == 1 &&
          cast(i64, more[1].result.pixels) == 0 && cast(i64, more[2].result.pixels) == 0);
    img.buffer.destroy(&m0);
    img.buffer.destroy(&m3);
    k = 0;
    while (k < 2) { img.buffer.destroy(&want[k]); cb.bytes_free(&files[k]); k = k + 1; }
}

fn main() as i32 {
    let is img.buffer.Image as g with mut = load.file("image/testdata/gray.png");
    check("gray: R8", sized(&g, img.R8) == 1 && load.last_error() == 0);
    check("gray's pixels", px(&g, 0, 0, 0) == 0 && px(&g, 1, 0, 0) == 64 && px(&g, 2, 0, 0) == 128
          && px(&g, 0, 1, 0) == 192 && px(&g, 1, 1, 0) == 255 && px(&g, 2, 1, 0) == 7);
    img.destroy(&g);
    g = load.file("image/testdata/gray_alpha.png");
    check("gray and alpha: RGBA8", sized(&g, img.RGBA8) == 1);
    check("its gray in each colour", rgba(&g, 0, 0, 10, 10, 10, 255) == 1 && rgba(&g, 1, 0, 20, 20, 20, 128) == 1
          && rgba(&g, 2, 1, 60, 60, 60, 3) == 1);
    img.destroy(&g);
    g = load.file("image/testdata/rgb.png");
    check("RGB: RGB8", sized(&g, img.RGB8) == 1);
    check("its pixels", rgb(&g, 0, 0, 255, 0, 0) == 1 && rgb(&g, 2, 0, 0, 0, 255) == 1 && rgb(&g, 1, 1, 4, 5, 6) == 1);
    img.destroy(&g);
    g = load.file("image/testdata/rgba.png");
    check("RGBA: RGBA8", sized(&g, img.RGBA8) == 1);
    check("its pixels, as written", rgba(&g, 1, 0, 0, 255, 0, 128) == 1 && rgba(&g, 2, 0, 0, 0, 255, 0) == 1
          && rgba(&g, 2, 1, 9, 10, 11, 12) == 1);
    img.destroy(&g);
    g = load.file("image/testdata/rgba16.png");
    check("16-bit RGBA: RGBA8", sized(&g, img.RGBA8) == 1);
    check("by the high byte", rgba(&g, 0, 0, 255, 0, 18, 255) == 1 && rgba(&g, 1, 0, 0, 0, 0, 0) == 1
          && rgba(&g, 2, 0, 128, 127, 0, 255) == 1 && rgba(&g, 1, 1, 64, 64, 64, 64) == 1);
    img.destroy(&g);
    g = load.file("image/testdata/palette.png");
    check("a palette with transparency: RGBA8", sized(&g, img.RGBA8) == 1);
    check("its colours", rgba(&g, 0, 0, 200, 100, 50, 255) == 1 && rgba(&g, 1, 0, 0, 0, 0, 128) == 1
          && rgba(&g, 2, 0, 9, 8, 7, 255) == 1 && rgba(&g, 0, 1, 9, 8, 7, 255) == 1);
    img.destroy(&g);
    // Refused: not an image, no file, nothing at all.
    g = load.file("image/testdata/not.png");
    check("not an image", cast(i64, g.pixels) == 0 && g.width == 0 && load.last_error() < 0);
    g = load.file("image/testdata/no such file.png");
    check("no file", cast(i64, g.pixels) == 0 && load.last_error() == load.ERR_FILE);
    g = load.file("image/testdata/empty.png");
    check("an empty file", cast(i64, g.pixels) == 0 && load.last_error() < 0 && load.last_error() != load.ERR_FILE);
    g = load.bytes(cast(*u8, "GIF89a"), 0);
    check("no bytes", cast(i64, g.pixels) == 0 && load.last_error() < 0);
    // And from memory, after a failure: the error cleared.
    jobs();
    jpegs();
    let is img.buffer.Image as again = load.file("image/testdata/rgb.png");
    check("after a failure, read", sized(&again, img.RGB8) == 1 && load.last_error() == 0);
    img.destroy(&again);
    if (fails > 0) {
        io.printf("image load: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("image load: all checks passed\n");
    return 0;
}
