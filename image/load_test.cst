// image/load_test.cst — images decoded through caustic-image, into this
// layer's Image: each PNG colour type of image/testdata (written by
// image/tools/make_pngs.py, pixels known to the byte) in the nearest format
// here, 16-bit channels by their high byte; and what is not an image refused.
//
// Built by caustic-mk (target load_test), which fetches caustic-image and
// caustic-compact at their tags. Run from the repository's root.
use "std/io.cst" as io;
use "image.cst" as img;
use "load.cst" as load;

let is i32 as fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 0) {
        io.printf("FAIL: %s\n", name);
        fails = fails + 1;
    }
}

fn px(im as *img.buffer.Image, x as i64, y as i64, c as i64) as i64 {
    return cast(i64, *cast(*u8, cast(i64, img.pixel_at(im, x, y)) + c));
}

fn rgba(im as *img.buffer.Image, x as i64, y as i64, r as i64, g as i64, b as i64, a as i64) as i32 {
    if (px(im, x, y, 0) == r && px(im, x, y, 1) == g && px(im, x, y, 2) == b && px(im, x, y, 3) == a) { return 1; }
    io.printf("  at %d,%d: (%d, %d, %d, %d)\n", x, y, px(im, x, y, 0), px(im, x, y, 1), px(im, x, y, 2), px(im, x, y, 3));
    return 0;
}

fn rgb(im as *img.buffer.Image, x as i64, y as i64, r as i64, g as i64, b as i64) as i32 {
    if (px(im, x, y, 0) == r && px(im, x, y, 1) == g && px(im, x, y, 2) == b) { return 1; }
    return 0;
}

fn sized(im as *img.buffer.Image, format as i32) as i32 {
    if (cast(i64, im.pixels) != 0 && im.width == 3 && im.height == 2 && im.format == format
        && im.stride == 3 * img.bytes_per_pixel(format) && im.borrowed == 0) { return 1; }
    return 0;
}

fn main() as i32 {
    let is img.buffer.Image as g with mut = load.file("image/testdata/gray.png");
    check("gray: R8", sized(&g, img.R8) == 1 && load.last_error() == 0);
    check("gray's pixels", px(&g, 0, 0, 0) == 0 && px(&g, 1, 0, 0) == 64 && px(&g, 2, 0, 0) == 128
          && px(&g, 0, 1, 0) == 192 && px(&g, 1, 1, 0) == 255 && px(&g, 2, 1, 0) == 7);
    img.destroy(&g);
    g = load.file("image/testdata/gray_alpha.png");
    check("gray and alpha: RGBA8", sized(&g, img.RGBA8) == 1);
    check("its gray in each colour", rgba(&g, 0, 0, 10, 10, 10, 255) == 1 && rgba(&g, 1, 0, 20, 20, 20, 128) == 1
          && rgba(&g, 2, 1, 60, 60, 60, 3) == 1);
    img.destroy(&g);
    g = load.file("image/testdata/rgb.png");
    check("RGB: RGB8", sized(&g, img.RGB8) == 1);
    check("its pixels", rgb(&g, 0, 0, 255, 0, 0) == 1 && rgb(&g, 2, 0, 0, 0, 255) == 1 && rgb(&g, 1, 1, 4, 5, 6) == 1);
    img.destroy(&g);
    g = load.file("image/testdata/rgba.png");
    check("RGBA: RGBA8", sized(&g, img.RGBA8) == 1);
    check("its pixels, as written", rgba(&g, 1, 0, 0, 255, 0, 128) == 1 && rgba(&g, 2, 0, 0, 0, 255, 0) == 1
          && rgba(&g, 2, 1, 9, 10, 11, 12) == 1);
    img.destroy(&g);
    g = load.file("image/testdata/rgba16.png");
    check("16-bit RGBA: RGBA8", sized(&g, img.RGBA8) == 1);
    check("by the high byte", rgba(&g, 0, 0, 255, 0, 18, 255) == 1 && rgba(&g, 1, 0, 0, 0, 0, 0) == 1
          && rgba(&g, 2, 0, 128, 127, 0, 255) == 1 && rgba(&g, 1, 1, 64, 64, 64, 64) == 1);
    img.destroy(&g);
    g = load.file("image/testdata/palette.png");
    check("a palette with transparency: RGBA8", sized(&g, img.RGBA8) == 1);
    check("its colours", rgba(&g, 0, 0, 200, 100, 50, 255) == 1 && rgba(&g, 1, 0, 0, 0, 0, 128) == 1
          && rgba(&g, 2, 0, 9, 8, 7, 255) == 1 && rgba(&g, 0, 1, 9, 8, 7, 255) == 1);
    img.destroy(&g);
    // Refused: not an image, no file, nothing at all.
    g = load.file("image/testdata/not.png");
    check("not an image", cast(i64, g.pixels) == 0 && g.width == 0 && load.last_error() < 0);
    g = load.file("image/testdata/no such file.png");
    check("no file", cast(i64, g.pixels) == 0 && load.last_error() == load.ERR_FILE);
    g = load.file("image/testdata/empty.png");
    check("an empty file", cast(i64, g.pixels) == 0 && load.last_error() < 0 && load.last_error() != load.ERR_FILE);
    g = load.bytes(cast(*u8, "GIF89a"), 0);
    check("no bytes", cast(i64, g.pixels) == 0 && load.last_error() < 0);
    // And from memory, after a failure: the error cleared.
    let is img.buffer.Image as again = load.file("image/testdata/rgb.png");
    check("after a failure, read", sized(&again, img.RGB8) == 1 && load.last_error() == 0);
    img.destroy(&again);
    if (fails > 0) {
        io.printf("image load: %d failures\n", cast(i64, fails));
        return 1;
    }
    io.printf("image load: all checks passed\n");
    return 0;
}
