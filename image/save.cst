// image/save.cst — an image written as a file's bytes: PNG, by
// caustic-image's encoder (its zlib caustic-compact's deflate), as the
// clipboard and a drag carry an image (window/transfer.cst's PNG).
//
// The image's own rows are handed over as they are — RGBA8 as RGBA, RGB8 as
// RGB, R8 as grey — nothing copied first; the bytes come back in a
// caustic-compact Bytes, a mapping of its own, let go with free_bytes. Like
// load.cst, what uses it is built with caustic-image and caustic-compact on
// its module path.
use "caustic-image/encode.cst" as cencode;
use "caustic-image/core/image.cst" as cimage;
use "caustic-image/core/pixfmt.cst" as pixfmt;
use "caustic-image/core/sniff.cst" as sniff;
use "caustic-compact/core/bytes.cst" as cb;
use "buffer.cst" as buffer;

// No pixels to write.
let is i64 as ERR_EMPTY with imut = 0 - 1001;

// What caustic-image calls the image's format; 0 for one it has no name for.
fn _cformat(format as i32) as i64 {
    if (format == buffer.RGBA8) { return pixfmt.FMT_RGBA8; }
    if (format == buffer.RGB8) { return pixfmt.FMT_RGB8; }
    if (format == buffer.R8) { return pixfmt.FMT_GRAY8; }
    return 0;
}

// img as a PNG into out (emptied first): its length, or a negative error —
// ERR_EMPTY for no pixels, caustic-image's own for the rest.
fn png(img as *buffer.Image, out as *cb.Bytes) as i64 {
    if (cast(i64, img.pixels) == 0 || img.width <= 0 || img.height <= 0) { return ERR_EMPTY; }
    let is i64 as fmt = _cformat(img.format);
    if (fmt == 0) { return ERR_EMPTY; }
    // The rows borrowed: owned 0, so nothing of them is let go here.
    let is cimage.Image as view;
    view.pixels = img.pixels;
    view.width = img.width;
    view.height = img.height;
    view.stride = img.stride;
    view.fmt = fmt;
    view.owned = 0;
    out.len = 0;
    return cencode.encode(&view, sniff.SNIFF_PNG, out);
}

// An empty Bytes to write into.
fn new_bytes() as cb.Bytes { return cb.bytes_new(0); }

// What png wrote, let go.
fn free_bytes(b as *cb.Bytes) as void { cb.bytes_free(b); }
