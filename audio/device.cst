// audio/device.cst — portable audio device definition and dispatch.

use "alsa/backend.cst" as alsa;
use "convert.cst" as conv;

struct Config {
    sample_rate as i32;  // e.g. 48000 or 44100
    channels    as i32;  // e.g. 2 for stereo
    period_size as i32;  // frames per period (e.g. 512)
    buffer_size as i32;  // total buffer frames (e.g. 2048)
    card        as i32;  // -1 for auto
    device      as i32;  // -1 for auto
}

fn config_default() as Config {
    let is Config as c;
    c.sample_rate = 48000;
    c.channels = 2;
    c.period_size = 512;
    c.buffer_size = 2048;
    c.card = cast(i32, 0 - 1);
    c.device = cast(i32, 0 - 1);
    return c;
}

struct Device {
    fd          as i64;
    ok          as i32;
    sample_rate as i32;
    channels    as i32;
    period_size as i64;
    buffer_size as i64;
}

fn open(cfg as *Config) as Device {
    return alsa.open(cfg);
}

fn is_open(d as *Device) as i32 {
    if (d.ok == 1 && d.fd >= 0) { return 1; }
    return 0;
}

// Writes signed 16-bit interleaved PCM frames.
// Returns the number of frames written.
fn write_s16(d as *Device, frames as *i16, frame_count as i64) as i64 {
    return alsa.write_frames(d, cast(*u8, frames), frame_count);
}

// Writes raw byte frames.
fn write_raw(d as *Device, bytes as *u8, frame_count as i64) as i64 {
    return alsa.write_frames(d, bytes, frame_count);
}

// Prepares the device stream if underrun or suspended.
fn prepare(d as *Device) as i32 {
    return alsa.prepare(d);
}

// Closes the device.
fn close(d as *Device) as void {
    alsa.close(d);
}
