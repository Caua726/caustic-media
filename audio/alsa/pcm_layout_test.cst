// audio/alsa/pcm_layout_test.cst — verify ALSA struct sizes and field offsets against C ABI.
//
// Matches audio/alsa/tools/layout.txt.

use "std/io.cst" as io;
use "pcm.cst" as pcm;

let is i32 as fails with mut = 0;

fn chk_i(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

fn off(base as i64, field as i64) as i64 {
    return field - base;
}

fn test_snd_interval() as void {
    let is pcm.SndInterval as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof snd_interval", sizeof(pcm.SndInterval), 12);
    chk_i("snd_interval.min", off(b, cast(i64, &s.min)), 0);
    chk_i("snd_interval.max", off(b, cast(i64, &s.max)), 4);
}

fn test_snd_mask() as void {
    let is pcm.SndMask as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof snd_mask", sizeof(pcm.SndMask), 32);
    chk_i("snd_mask.bits", off(b, cast(i64, &s.bits)), 0);
}

fn test_snd_pcm_hw_params() as void {
    let is pcm.SndPcmHwParams as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof snd_pcm_hw_params", sizeof(pcm.SndPcmHwParams), 608);
    chk_i("snd_pcm_hw_params.flags", off(b, cast(i64, &s.flags)), 0);
    chk_i("snd_pcm_hw_params.masks", off(b, cast(i64, &s.masks)), 4);
    chk_i("snd_pcm_hw_params.mres", off(b, cast(i64, &s.mres)), 100);
    chk_i("snd_pcm_hw_params.intervals", off(b, cast(i64, &s.intervals)), 260);
    chk_i("snd_pcm_hw_params.ires", off(b, cast(i64, &s.ires)), 404);
    chk_i("snd_pcm_hw_params.rmask", off(b, cast(i64, &s.rmask)), 512);
    chk_i("snd_pcm_hw_params.cmask", off(b, cast(i64, &s.cmask)), 516);
    chk_i("snd_pcm_hw_params.info", off(b, cast(i64, &s.info)), 520);
    chk_i("snd_pcm_hw_params.msbits", off(b, cast(i64, &s.msbits)), 524);
    chk_i("snd_pcm_hw_params.rate_num", off(b, cast(i64, &s.rate_num)), 528);
    chk_i("snd_pcm_hw_params.rate_den", off(b, cast(i64, &s.rate_den)), 532);
    chk_i("snd_pcm_hw_params.fifo_size", off(b, cast(i64, &s.fifo_size)), 536);
    chk_i("snd_pcm_hw_params.sync", off(b, cast(i64, &s.sync)), 544);
    chk_i("snd_pcm_hw_params.reserved", off(b, cast(i64, &s.reserved)), 560);
}

fn test_snd_pcm_sw_params() as void {
    let is pcm.SndPcmSwParams as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof snd_pcm_sw_params", sizeof(pcm.SndPcmSwParams), 136);
    chk_i("snd_pcm_sw_params.tstamp_mode", off(b, cast(i64, &s.tstamp_mode)), 0);
    chk_i("snd_pcm_sw_params.period_step", off(b, cast(i64, &s.period_step)), 4);
    chk_i("snd_pcm_sw_params.sleep_min", off(b, cast(i64, &s.sleep_min)), 8);
    chk_i("snd_pcm_sw_params.avail_min", off(b, cast(i64, &s.avail_min)), 16);
    chk_i("snd_pcm_sw_params.xfer_align", off(b, cast(i64, &s.xfer_align)), 24);
    chk_i("snd_pcm_sw_params.start_threshold", off(b, cast(i64, &s.start_threshold)), 32);
    chk_i("snd_pcm_sw_params.stop_threshold", off(b, cast(i64, &s.stop_threshold)), 40);
    chk_i("snd_pcm_sw_params.silence_threshold", off(b, cast(i64, &s.silence_threshold)), 48);
    chk_i("snd_pcm_sw_params.silence_size", off(b, cast(i64, &s.silence_size)), 56);
    chk_i("snd_pcm_sw_params.boundary", off(b, cast(i64, &s.boundary)), 64);
}

fn test_snd_xferi() as void {
    let is pcm.SndXferi as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof snd_xferi", sizeof(pcm.SndXferi), 24);
    chk_i("snd_xferi.result", off(b, cast(i64, &s.result)), 0);
    chk_i("snd_xferi.buf", off(b, cast(i64, &s.buf)), 8);
    chk_i("snd_xferi.frames", off(b, cast(i64, &s.frames)), 16);
}

fn test_snd_pcm_info() as void {
    let is pcm.SndPcmInfo as s;
    let is i64 as b = cast(i64, &s);
    chk_i("sizeof snd_pcm_info", sizeof(pcm.SndPcmInfo), 288);
    chk_i("snd_pcm_info.device", off(b, cast(i64, &s.device)), 0);
    chk_i("snd_pcm_info.subdevice", off(b, cast(i64, &s.subdevice)), 4);
    chk_i("snd_pcm_info.id", off(b, cast(i64, &s.id)), 16);
    chk_i("snd_pcm_info.name", off(b, cast(i64, &s.name)), 80);
    chk_i("snd_pcm_info.subname", off(b, cast(i64, &s.subname)), 160);
    chk_i("snd_pcm_info.dev_class", off(b, cast(i64, &s.dev_class)), 192);
    chk_i("snd_pcm_info.dev_subclass", off(b, cast(i64, &s.dev_subclass)), 196);
    chk_i("snd_pcm_info.subdevices_count", off(b, cast(i64, &s.subdevices_count)), 200);
    chk_i("snd_pcm_info.subdevices_avail", off(b, cast(i64, &s.subdevices_avail)), 204);
}

fn main() as i32 {
    test_snd_interval();
    test_snd_mask();
    test_snd_pcm_hw_params();
    test_snd_pcm_sw_params();
    test_snd_xferi();
    test_snd_pcm_info();

    if (fails != 0) {
        io.printf("pcm layout: %d checks FAILED\n", fails);
        return 1;
    }
    io.printf("pcm layout: all checks passed\n");
    return 0;
}
