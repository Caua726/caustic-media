// audio/alsa/pcm.cst — direct Linux ALSA PCM kernel interface via ioctls.
//
// Zero dependency: operates directly on /dev/snd/pcmC*D*p file descriptors
// using standard Linux kernel ioctls. No libasound required.

use "std/os/linux.cst" as os;

// --- Ioctl commands ---
let is i64 as SNDRV_PCM_IOCTL_PVERSION      with imut = 0x80044100;
let is i64 as SNDRV_PCM_IOCTL_INFO          with imut = 0x81204101;
let is i64 as SNDRV_PCM_IOCTL_HW_REFINE     with imut = 0xc2604110;
let is i64 as SNDRV_PCM_IOCTL_HW_PARAMS     with imut = 0xc2604111;
let is i64 as SNDRV_PCM_IOCTL_HW_FREE       with imut = 0x4112;
let is i64 as SNDRV_PCM_IOCTL_SW_PARAMS     with imut = 0xc0884113;
let is i64 as SNDRV_PCM_IOCTL_STATUS        with imut = 0x80984120;
let is i64 as SNDRV_PCM_IOCTL_PREPARE       with imut = 0x4140;
let is i64 as SNDRV_PCM_IOCTL_RESET         with imut = 0x4141;
let is i64 as SNDRV_PCM_IOCTL_START         with imut = 0x4142;
let is i64 as SNDRV_PCM_IOCTL_DROP          with imut = 0x4143;
let is i64 as SNDRV_PCM_IOCTL_DRAIN         with imut = 0x4144;
let is i64 as SNDRV_PCM_IOCTL_PAUSE         with imut = 0x40044145;
let is i64 as SNDRV_PCM_IOCTL_RESUME        with imut = 0x4147;
let is i64 as SNDRV_PCM_IOCTL_WRITEI_FRAMES with imut = 0x40184150;
let is i64 as SNDRV_PCM_IOCTL_READI_FRAMES  with imut = 0x80184151;

// --- Formats ---
let is i32 as FORMAT_S8       with imut = 0;
let is i32 as FORMAT_U8       with imut = 1;
let is i32 as FORMAT_S16_LE   with imut = 2;
let is i32 as FORMAT_S16_BE   with imut = 3;
let is i32 as FORMAT_U16_LE   with imut = 4;
let is i32 as FORMAT_U16_BE   with imut = 5;
let is i32 as FORMAT_S24_LE   with imut = 6;
let is i32 as FORMAT_S32_LE   with imut = 10;
let is i32 as FORMAT_FLOAT_LE with imut = 14;

// --- Access ---
let is i32 as ACCESS_MMAP_INTERLEAVED    with imut = 0;
let is i32 as ACCESS_MMAP_NONINTERLEAVED with imut = 1;
let is i32 as ACCESS_MMAP_COMPLEX        with imut = 2;
let is i32 as ACCESS_RW_INTERLEAVED      with imut = 3;
let is i32 as ACCESS_RW_NONINTERLEAVED   with imut = 4;

// --- HW Param types ---
let is i32 as HW_PARAM_ACCESS       with imut = 0;
let is i32 as HW_PARAM_FORMAT       with imut = 1;
let is i32 as HW_PARAM_SUBFORMAT    with imut = 2;
let is i32 as HW_PARAM_FIRST_MASK   with imut = 0;
let is i32 as HW_PARAM_LAST_MASK    with imut = 2;

let is i32 as HW_PARAM_SAMPLE_BITS    with imut = 8;
let is i32 as HW_PARAM_FRAME_BITS     with imut = 9;
let is i32 as HW_PARAM_CHANNELS       with imut = 10;
let is i32 as HW_PARAM_RATE           with imut = 11;
let is i32 as HW_PARAM_PERIOD_TIME    with imut = 12;
let is i32 as HW_PARAM_PERIOD_SIZE    with imut = 13;
let is i32 as HW_PARAM_PERIOD_BYTES   with imut = 14;
let is i32 as HW_PARAM_PERIODS        with imut = 15;
let is i32 as HW_PARAM_BUFFER_TIME    with imut = 16;
let is i32 as HW_PARAM_BUFFER_SIZE    with imut = 17;
let is i32 as HW_PARAM_BUFFER_BYTES   with imut = 18;
let is i32 as HW_PARAM_TICK_TIME      with imut = 19;
let is i32 as HW_PARAM_FIRST_INTERVAL with imut = 8;
let is i32 as HW_PARAM_LAST_INTERVAL  with imut = 19;

// --- States ---
let is i32 as STATE_OPEN         with imut = 0;
let is i32 as STATE_SETUP        with imut = 1;
let is i32 as STATE_PREPARED     with imut = 2;
let is i32 as STATE_RUNNING      with imut = 3;
let is i32 as STATE_XRUN         with imut = 4;
let is i32 as STATE_DRAINING     with imut = 5;
let is i32 as STATE_PAUSED       with imut = 6;
let is i32 as STATE_SUSPENDED    with imut = 7;
let is i32 as STATE_DISCONNECTED with imut = 8;

// --- Structs matching kernel memory layout exactly ---

struct SndInterval {
    min   as u32;
    max   as u32;
    flags as u32; // openmin:1, openmax:1, integer:1, empty:1
}

struct SndMask {
    bits as [8]u32;
}

struct SndPcmHwParams {
    flags     as u32;
    masks     as [3]SndMask;
    mres      as [5]SndMask;
    intervals as [12]SndInterval;
    ires      as [9]SndInterval;
    rmask     as u32;
    cmask     as u32;
    info      as u32;
    msbits    as u32;
    rate_num  as u32;
    rate_den  as u32;
    fifo_size as u64;
    sync      as [16]u8;
    reserved  as [48]u8;
}

struct SndPcmSwParams {
    tstamp_mode       as i32;
    period_step       as u32;
    sleep_min         as u32;
    _pad0             as u32;
    avail_min         as u64;
    xfer_align        as u64;
    start_threshold   as u64;
    stop_threshold    as u64;
    silence_threshold as u64;
    silence_size      as u64;
    boundary          as u64;
    reserved          as [64]u8;
}

struct SndXferi {
    result as i64;
    buf    as *u8;
    frames as u64;
}

struct SndPcmInfo {
    device           as u32;
    subdevice        as u32;
    _pad0            as [8]u8;
    id               as [64]u8;
    name             as [80]u8;
    subname          as [32]u8;
    dev_class        as i32;
    dev_subclass     as i32;
    subdevices_count as u32;
    subdevices_avail as u32;
    sync             as [16]u8;
    reserved         as [64]u8;
}

// --- Helpers for param initialization ---

fn init_hw_params(p as *SndPcmHwParams) as void {
    let is *u8 as ptr = cast(*u8, p);
    let is i64 as i with mut = 0;
    while (i < sizeof(SndPcmHwParams)) {
        ptr[i] = 0;
        i = i + 1;
    }
    // Set all mask bits to 1 (any)
    i = 0;
    while (i < 3) {
        let is i64 as b with mut = 0;
        while (b < 8) {
            p.masks[i].bits[b] = 0xffffffff;
            b = b + 1;
        }
        i = i + 1;
    }
    // Set all intervals to [0, 0xffffffff] (any)
    i = 0;
    while (i < 12) {
        p.intervals[i].min = 0;
        p.intervals[i].max = 0xffffffff;
        p.intervals[i].flags = 0;
        i = i + 1;
    }
}

fn mask_set(m as *SndMask, val as i32) as void {
    let is i64 as i with mut = 0;
    while (i < 8) {
        m.bits[i] = 0;
        i = i + 1;
    }
    let is i64 as idx = cast(i64, val) / 32;
    let is i64 as shift = cast(i64, val) % 32;
    let is u32 as one = 1;
    m.bits[idx] = one << cast(u32, shift);
}

fn interval_set(iv as *SndInterval, val as u32) as void {
    iv.min = val;
    iv.max = val;
    iv.flags = 4; // integer = 1 (bit 2)
}

// --- Ioctl wrappers ---

fn ioctl_hw_refine(fd as i64, p as *SndPcmHwParams) as i64 {
    return os.ioctl(fd, SNDRV_PCM_IOCTL_HW_REFINE, cast(*u8, p));
}

fn ioctl_hw_params(fd as i64, p as *SndPcmHwParams) as i64 {
    return os.ioctl(fd, SNDRV_PCM_IOCTL_HW_PARAMS, cast(*u8, p));
}

fn ioctl_sw_params(fd as i64, p as *SndPcmSwParams) as i64 {
    return os.ioctl(fd, SNDRV_PCM_IOCTL_SW_PARAMS, cast(*u8, p));
}

fn ioctl_prepare(fd as i64) as i64 {
    return os.ioctl(fd, SNDRV_PCM_IOCTL_PREPARE, cast(*u8, 0));
}

fn ioctl_reset(fd as i64) as i64 {
    return os.ioctl(fd, SNDRV_PCM_IOCTL_RESET, cast(*u8, 0));
}

fn ioctl_start(fd as i64) as i64 {
    return os.ioctl(fd, SNDRV_PCM_IOCTL_START, cast(*u8, 0));
}

fn ioctl_drop(fd as i64) as i64 {
    return os.ioctl(fd, SNDRV_PCM_IOCTL_DROP, cast(*u8, 0));
}

fn ioctl_drain(fd as i64) as i64 {
    return os.ioctl(fd, SNDRV_PCM_IOCTL_DRAIN, cast(*u8, 0));
}

fn ioctl_writei(fd as i64, xferi as *SndXferi) as i64 {
    return os.ioctl(fd, SNDRV_PCM_IOCTL_WRITEI_FRAMES, cast(*u8, xferi));
}
