// audio/convert.cst — audio sample format conversions and channel utilities.

fn clamp_f32(v as f32, min as f32, max as f32) as f32 {
    if (v < min) { return min; }
    if (v > max) { return max; }
    return v;
}

// Converts float samples in [-1.0, 1.0] to signed 16-bit integers with scaling and clamping.
fn f32_to_s16(src as *f32, dst as *i16, count as i64, volume as f32) as void {
    let is i64 as i with mut = 0;
    while (i < count) {
        let is f32 as s = clamp_f32(src[i] * volume, 0.0 - 1.0, 1.0);
        let is f32 as scaled = s * 32767.0;
        dst[i] = cast(i16, cast(i32, scaled));
        i = i + 1;
    }
}

// Converts signed 16-bit integer samples to float in [-1.0, 1.0].
fn s16_to_f32(src as *i16, dst as *f32, count as i64) as void {
    let is i64 as i with mut = 0;
    while (i < count) {
        dst[i] = cast(f32, src[i]) / 32768.0;
        i = i + 1;
    }
}

// Interleaves separate left and right float channels into an interleaved stereo buffer.
fn interleave_stereo_f32(left as *f32, right as *f32, dst as *f32, frames as i64) as void {
    let is i64 as i with mut = 0;
    while (i < frames) {
        dst[i * 2 + 0] = left[i];
        dst[i * 2 + 1] = right[i];
        i = i + 1;
    }
}
