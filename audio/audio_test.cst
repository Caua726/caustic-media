// audio/audio_test.cst — unit and integration tests for audio layer.

use "std/io.cst" as io;
use "std/os/linux.cst" as os;
use "std/time.cst" as time;
use "audio.cst" as audio;
use "convert.cst" as conv;
use "alsa/pcm.cst" as pcm;
use "alsa/backend.cst" as backend;

// Finds a playback device nothing holds and opens it non-blocking, which is
// enough to make it busy for everyone else. Returns the fd, or -1 when this
// machine has none free; card and device come back through the pointers.
fn hold_free_device(card as *i32, dev_num as *i32) as i64 {
    let is [32]u8 as path;
    let is i32 as c with mut = 0;
    while (c < 4) {
        let is i32 as dn with mut = 0;
        while (dn < 32) {
            backend.format_pcm_path(cast(*u8, &path), c, dn);
            let is i64 as fd = os.open(cast(*u8, &path), os.O_RDWR | os.O_NONBLOCK, 0);
            if (fd >= 0) {
                *card = c;
                *dev_num = dn;
                return fd;
            }
            dn = dn + 1;
        }
        c = c + 1;
    }
    return 0 - 1;
}

fn main() as i32 {
    io.printf("testing audio layer...\n");

    // 1. Conversion tests
    let is f32 as clamped with mut = conv.clamp_f32(1.5, 0.0 - 1.0, 1.0);
    if (clamped != 1.0) {
        io.printf("FAIL: clamp_f32 max failed\n");
        return 1;
    }
    clamped = conv.clamp_f32(0.0 - 2.0, 0.0 - 1.0, 1.0);
    if (clamped != (0.0 - 1.0)) {
        io.printf("FAIL: clamp_f32 min failed\n");
        return 2;
    }

    let is [4]f32 as f_in;
    f_in[0] = 0.0;
    f_in[1] = 0.5;
    f_in[2] = 1.0;
    f_in[3] = 0.0 - 1.0;

    let is [4]i16 as s_out;
    conv.f32_to_s16(cast(*f32, &f_in), cast(*i16, &s_out), 4, 1.0);
    if (s_out[0] != 0 || s_out[2] != 32767 || s_out[3] != (0 - 32767)) {
        io.printf("FAIL: f32_to_s16 mapping failed (s0=%d, s2=%d, s3=%d)\n",
                  cast(i32, s_out[0]), cast(i32, s_out[2]), cast(i32, s_out[3]));
        return 3;
    }

    // 2. Test format_pcm_path
    let is [32]u8 as p_buf;
    backend.format_pcm_path(cast(*u8, &p_buf), 0, 3);
    // Expect "/dev/snd/pcmC0D3p" (index 13='0', 14='D', 15='3', 16='p', 17=0)
    if (p_buf[13] != 48 || p_buf[14] != 68 || p_buf[15] != 51 || p_buf[16] != 112 || p_buf[17] != 0) {
        io.printf("FAIL: format_pcm_path failed for C0D3p\n");
        return 4;
    }
    backend.format_pcm_path(cast(*u8, &p_buf), 1, 12);
    // Expect "/dev/snd/pcmC1D12p" (index 13='1', 14='D', 15='1', 16='2', 17='p', 18=0)
    if (p_buf[13] != 49 || p_buf[14] != 68 || p_buf[15] != 49 || p_buf[16] != 50 || p_buf[17] != 112 || p_buf[18] != 0) {
        io.printf("FAIL: format_pcm_path failed for C1D12p\n");
        return 5;
    }

    // 3. Test pcm init_hw_params
    let is pcm.SndPcmHwParams as p;
    pcm.init_hw_params(&p);
    if (p.masks[0].bits[0] != 0xffffffff || p.intervals[0].max != 0xffffffff) {
        io.printf("FAIL: init_hw_params did not set all any\n");
        return 6;
    }

    // 4. Test mask_set & interval_set
    pcm.mask_set(&p.masks[0], 3); // bit 3
    if (p.masks[0].bits[0] != 8) { // 1 << 3 = 8
        io.printf("FAIL: mask_set failed\n");
        return 7;
    }
    pcm.interval_set(&p.intervals[0], 48000);
    if (p.intervals[0].min != 48000 || p.intervals[0].max != 48000 || p.intervals[0].flags != 4) {
        io.printf("FAIL: interval_set failed\n");
        return 8;
    }

    // 5. Hardware open check
    let is audio.device.Config as cfg = audio.config_default();
    let is audio.device.Device as d = audio.open(&cfg);
    if (audio.is_open(&d) == 1) {
        io.printf("audio hardware detected: rate=%d, channels=%d, period=%d, buffer=%d\n",
                  d.sample_rate, d.channels, cast(i32, d.period_size), cast(i32, d.buffer_size));

        // The sizes the Config asks for are the sizes the device gets. Left to
        // itself the kernel picks the smallest period the hardware allows — 32
        // frames, two thirds of a millisecond, on the machine this was found on.
        // 512 and 2048 are the defaults and every PCM in common use takes them.
        if (d.period_size != cast(i64, cfg.period_size) || d.buffer_size != cast(i64, cfg.buffer_size)) {
            io.printf("FAIL: asked for period=%d buffer=%d, got period=%d buffer=%d\n",
                      cfg.period_size, cfg.buffer_size,
                      cast(i32, d.period_size), cast(i32, d.buffer_size));
            audio.close(&d);
            return 11;
        }

        // Write a small buffer of silence
        let is [1024]i16 as silence;
        let is i64 as si with mut = 0;
        while (si < 1024) { silence[si] = 0; si = si + 1; }
        let is i64 as written = audio.write_s16(&d, cast(*i16, &silence), 512);
        if (written <= 0) {
            io.printf("FAIL: audio write returned %d\n", cast(i32, written));
            audio.close(&d);
            return 9;
        }
        audio.close(&d);

        // A size no hardware takes still opens, with what the kernel chose:
        // the Config is a request, and failing to open over a period size
        // would be worse than the period it gets.
        let is audio.device.Config as odd = audio.config_default();
        odd.period_size = 3;
        odd.buffer_size = 5;
        let is audio.device.Device as od = audio.open(&odd);
        let is i32 as odd_open = audio.is_open(&od);
        audio.close(&od);
        if (odd_open == 0) {
            io.printf("FAIL: period=3 buffer=5 refused to open instead of falling back\n");
            return 12;
        }

        // close() plays out what was written instead of discarding it. With the
        // buffer full, a DROP returns at once and the last ~40 ms never reach
        // the speaker; a DRAIN waits for them. When writei returns, at least
        // buffer minus one period is still queued — 32 ms at 48 kHz — so a
        // close of a full buffer that takes under half of that dropped it.
        let is audio.device.Device as dd = audio.open(&cfg);
        if (audio.is_open(&dd) == 1) {
            let is [4096]i16 as quiet;
            let is i64 as qi with mut = 0;
            while (qi < 4096) { quiet[qi] = 0; qi = qi + 1; }
            let is i64 as frames with mut = dd.buffer_size;
            if (frames > 2048) { frames = 2048; }
            audio.write_s16(&dd, cast(*i16, &quiet), frames);
            let is i64 as t0 = time.now_ns();
            audio.close(&dd);
            let is i64 as close_ms = time.elapsed_ms(t0);
            if (close_ms < 16) {
                io.printf("FAIL: close of a full buffer took %d ms — the queued audio was dropped\n",
                          cast(i32, close_ms));
                return 13;
            }
        }
    } else {
        io.printf("note: no physical audio output accessible in this environment (skipped)\n");
    }

    // 6. A device something else holds is reported as not open, not waited for.
    //
    // The kernel's PCM open sleeps until a busy device is released unless the
    // file is opened O_NONBLOCK — so with PipeWire or another program playing,
    // audio.open() never returned. Hold a device and ask for exactly that one.
    let is i32 as busy_card with mut = 0;
    let is i32 as busy_dev with mut = 0;
    let is i64 as held = hold_free_device(&busy_card, &busy_dev);
    if (held >= 0) {
        let is audio.device.Config as bcfg = audio.config_default();
        bcfg.card = busy_card;
        bcfg.device = busy_dev;
        let is audio.device.Device as bd = audio.open(&bcfg);
        let is i32 as opened = audio.is_open(&bd);
        audio.close(&bd);
        os.close(held);
        if (opened == 1) {
            io.printf("FAIL: opened pcmC%dD%dp while another fd held it\n", busy_card, busy_dev);
            return 10;
        }
    }

    io.printf("audio layer: all checks passed\n");
    return 0;
}
