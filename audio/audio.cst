// audio/audio.cst — hub for the audio layer.
//
//   use "caustic-media/audio/audio.cst" as audio;
//
//   let is audio.device.Config as cfg = audio.config_default();
//   let is audio.device.Device as dev = audio.open(&cfg);
//   audio.write_s16(&dev, buffer, frame_count);
//   audio.close(&dev);

use "device.cst" as device;
use "convert.cst" as convert;
use "alsa/pcm.cst" as pcm;

fn config_default() as device.Config {
    return device.config_default();
}

fn open(cfg as *device.Config) as device.Device {
    return device.open(cfg);
}

fn open_simple(rate as i32, channels as i32) as device.Device {
    let is device.Config as cfg = device.config_default();
    cfg.sample_rate = rate;
    cfg.channels = channels;
    return device.open(&cfg);
}

fn is_open(d as *device.Device) as i32 {
    return device.is_open(d);
}

fn write_s16(d as *device.Device, frames as *i16, count as i64) as i64 {
    return device.write_s16(d, frames, count);
}

fn close(d as *device.Device) as void {
    device.close(d);
}
